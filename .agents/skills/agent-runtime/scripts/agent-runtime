#!/usr/bin/env bash
# Run the agent-runtime binary that matches the shipped sources beside this
# script. Every argument goes to the binary; its --help is the contract.
#
# The binary is <cache>/bin/agent-runtime-<key>, the one scripts/setup placed
# for these sources (lib/key.sh; <cache> as setup resolves it). When it is
# absent and cargo is on PATH, this wrapper runs that setup first, every line
# of it on stderr so stdout stays the binary's, then runs the binary; a build
# that fails leaves the setup's refusal the last line on stderr and exits 69.
# Two calls that find the key unbuilt at once each run the setup, and cargo's
# lock on the build folder (its .cargo-lock there) has the later one wait and
# find the build done. With no cargo, or with AGENT_RUNTIME_NO_BUILD set by a
# caller that must answer at once, such as a harness hook, it builds nothing:
# it prints
#   agent-runtime: setup-required key=<key> run=<path to scripts/setup>
# on stderr and exits 69, and that caller starts the build with
# `setup --detach`.
set -euo pipefail

here="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)"

refuse() { # KEY FIELD=VALUE...
  local key="$1"
  shift
  printf 'agent-runtime: %s%s\n' "$key" "${*:+ $*}" >&2
  exit 1
}

# shellcheck source=lib/key.sh
. "$here/lib/key.sh"

runtime="$(cd -- "$here/../runtime" 2>/dev/null && pwd -P)" || refuse runtime-missing "runtime=$here/../runtime"
cache="$(agent_runtime_cache)"
key="$(agent_runtime_key "$runtime")"
binary="$cache/bin/agent-runtime-$key"
if [ ! -x "$binary" ] && [ -z "${AGENT_RUNTIME_NO_BUILD:-}" ] && command -v cargo >/dev/null 2>&1; then
  "$here/setup" </dev/null >&2 || exit 69
fi
if [ ! -x "$binary" ]; then
  printf 'agent-runtime: setup-required key=%s run=%s\n' "$key" "$here/setup" >&2
  exit 69
fi
exec "$binary" "$@"
