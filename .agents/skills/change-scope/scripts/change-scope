#!/usr/bin/env bash
# change-scope — what kind of change is this diff?
#
# Usage:
#   change-scope --event EVENT [--base REF] [--head REF] [--repo DIR]
#                [--paths-output FILE]
#   change-scope launch [--production N] [--body FILE] [--floor CLASS]...
#                [--path PATH]... [--base REF --head REF] [--repo DIR]
#
# The launch arm classifies a work item before its branch exists, from the
# inputs that name a class: the widest wins, in change_scope_rank's order,
# and the first input naming it is the cause. --production is an estimate of
# added production lines against micro_max_production and
# small_max_production in references/narrow-change.conf; --body reads its
# Expected delta (lib/branch-growth.sh's grammar), which floors the estimate,
# and a body with neither a valid delta nor an estimate is standard; --floor
# is a class already held, at or above micro; --path is classified by the
# shared path rules' launch phase, no render proved, and an unmatched path
# changes nothing; --base and --head classify the range's changed paths: a
# range containing only kendex.settings.toml or .kendex/settings.toml
# within micro_max_production can clear configuration-source when both
# endpoints prove edits to ordinary assignments in existing regular files.
# HARNESS_CI_*, ORCH_SIZE_* and is_source_catalog are protected. A range
# editing one line of kendex.toml or kendex-local.toml can also take micro
# if that line is a plain string entry in [skill-instructions] and all
# multiline content stays byte-identical. A Location keeps its own
# class. A names-only inventory change under rendered roots is left to the classifier,
# which answers standard for a range that adds a catalog source (its render
# proof owns no catalog source) and reads a removal by its size, while a
# changed lock is standard whatever the classifier answers; a range that
# removes test protection, read as the size path below reads it, small with
# cause=protection-removed (standard, measured=false,
# cause=protection-unreadable where that read fails); and the range itself at
# the class this script's classifier answers for it through
# change_scope_read, its production lines included, render and trivial read
# as micro: cause=branch-class class=C rule=R, R the classifier's cause and
# fields, measured=false where the classifier's answer was, and standard,
# measured=false, cause=branch-class-unreadable with the classifier's stderr
# repeated where it could not be read.
# HARNESS_CI_STANDARD_PATHS comes from the main checkout of --repo
# (default .), never from a linked worktree's own settings. A list, ceiling
# or settings file the arm cannot read answers standard, measured=false.
# A malformed Expected delta prints one `launch-warning: cause=invalid-delta`
# line and reads as no delta. stdout is `change_class=micro|small|standard`;
# stderr ends with `class: class=CLASS measured=true|false delta=N|-
# cause=CAUSE[ DETAIL]`. Exit 2 is a wiring error, `wiring-error: cause=`
# naming it, with no class.
#
# The shared change classifier: one classification for CI's lane selection
# (harness-ci's change-class), package review depth (reviewer's review-depth)
# and orch's tier admission, each keeping its own mapping from the class.
# This command selects no lane, writes no CI output and reads no workflow
# state, mailbox or tracker: it needs git, this package and, for the render
# class alone, the `kendex` on PATH.
#
# Flags carry the meanings `harness-only --help` gives them, except --mode,
# which this script does not take. --paths-output writes the changed paths
# harness-only read for the judged range, one per line, before any rule is
# applied: the set a caller judging the same diff on other rules reads. Every
# read of a diff range is harness-only's, beside this script, or the branch
# measurement in lib/branch-growth.sh, the revisions both ends of the range
# resolve to included. The git this script runs on the judged checkout itself
# reads and never writes: where its object store is, its remote and
# partial-clone settings, the commit the base endpoint names, and which
# settings files that commit holds and their bytes. The render proof weighs a
# private checkout of the head revision, never the judged checkout's working
# tree.
# stdout carries change_class=render|trivial|micro|small|standard and nothing
# else, stderr the changed paths and the reason, and exit 2 a wiring error
# that carries no verdict. The stderr `class:` line also carries `measured=`,
# which says whether a rule earned this class or this script fell back to
# `standard` because something could not be read. Only `standard` is ever
# measured=false, and only this script can tell the two apart: the cause alone
# does not, so a consumer that must not treat a fallback as a class reads the
# marker rather than a list of causes of its own.
# Every verdict prints `quick-proof: proved=true|false` on stderr just before
# its `class:` line. It is true only on --event pull_request, for a trivial
# answer with HARNESS_CI_TRIVIAL_PATHS unset or empty, where every changed
# path is a settings file the admission below admitted or a .md or .markdown
# file of the docs set. A caller that skips a review on it acts on the literal
# true alone: a wiring error prints no such line, and an absent line proves
# nothing.
# The render proof runs `kendex verify --scope
# project --json` in the head revision's private checkout, with `--base` set to the base-rev:
# line harness-only printed and `--at-record` beside it, and reads its
# document. Where verify's help advertises `--bot-instructions-from`, that
# option licenses the trusted sibling checker's comparison of bot files;
# the judged package supplies doctrine data only.
# The classes, first match winning:
#
#   render   every surviving changed path has trusted render ownership, `kendex verify`
#            reports files checked and none failed. Each surviving path needs a
#            passing verifier position or the caller proof below. A position
#            owns a file whole, a tree whole, or keys inside a shared file whose
#            rest that run says did not move since the range's base.
#            A removed path needs base inventory membership, absence from the
#            verified head inventory, and trusted base whole-file ownership:
#            the document's `base_owned`, the whole files and trees the base
#            revision's install record names, naming the path as a `file`
#            or holding it under a `tree`. A retirement it does not name, or
#            a document without the field, answers standard with
#            cause=render-retirement-unproved. That answer comes after every
#            other changed path is read, and any of them that is refused
#            answers in its place. It is a rule, marked measured=true like
#            cause=base-inventory-absent: every read behind it succeeded, and
#            the proof it lacks is one the verify document does not give:
#            base_owned does not name the path, or the document carries no
#            base_owned. A recorded shared refresh caller first takes ownership
#            from a passing verifier position. Without verifier ownership, the
#            release fallback follows the caller ownership contract:
#            ../SKILL.md § Shared refresh caller ownership.
#            Any other
#            changed path answers standard with cause=render-path-unowned,
#            and a shared file whose rest the run cannot vouch for answers
#            cause=render-path-partial. Both are rule verdicts, marked
#            measured=true: the classifier read a passing verify document
#            but lacks whole ownership proof, including foreign=unknown.
#            That verdict
#            is that every installed file equals a fresh render of its
#            declared source. Under `--at-record` a package that follows
#            its source is rendered at the commit the install record names,
#            which kendex holds to the history of the revision the local
#            mirror resolves that source to and to no older than the commit
#            the base's record names, so a render the catalog has moved
#            past since it was pushed is weighed on its own terms and
#            printed as one `render-stale:` line per source commit it
#            trails. The two files kendex keeps about itself are as it
#            writes them, and that
#            every recorded entry is one the declarations back. Provenance
#            for surviving positions is proved by rendering, never by trusting
#            the head inventory or install record, which the branch can rewrite;
#            those two files are owned like any other rendered position,
#            from the row `kendex verify` prints for each, and by name to
#            nobody. The proof reads that program's `--json` document,
#            version 1, and never its human rows; a kendex that prints no
#            such document, or another version of it, answers standard.
#   trivial  every changed path is in the `harness-only --mode docs` set and
#            the change is within HARNESS_CI_TRIVIAL_MAX_LINES (default 20).
#            Where HARNESS_CI_TRIVIAL_PATHS names the repository's own
#            allowlist as blank-separated globs, it replaces that set, within
#            the same ceiling. A changed kendex.settings.toml or
#            .kendex/settings.toml joins the set where the base commit's
#            the settings admission below admits it; a diff of
#            admitted settings files alone has no ceiling.
#   micro   production additions within the micro ceiling.
#   small    one subsystem, production additions within the small ceiling. A
#            path's subsystem is its first directory, with a leading render
#            root removed first so a source and the render mirroring it agree.
#            A path the measurement counts as a test or fixture, by its
#            built-in rule or ORCH_SIZE_TEST_PATHS, belongs to no subsystem.
#            A path in harness-only's docs set also belongs to no subsystem;
#            its lines still count toward the production ceiling.
#            A dependency lock paired by references/narrow-change.conf adds
#            no subsystem and its lines are reported separately. A paired
#            change goes through the small class's size and subsystem checks.
#            An agent instruction file, an `instruction` line of this
#            package's references/narrow-change.conf (AGENTS.md, SKILL.md), that earns trivial or
#            micro answers small instead, cause=instruction-file: it changes
#            how every agent behaves, and small is the lowest class the
#            default review policy gives a bot review round. A diff that
#            removes test protection and earns trivial or micro answers small
#            too, cause=protection-removed kind=case|suite|skip|selection
#            path=P removed=N added=M measured-class=C, by the `case`,
#            `skip` and `selection` lines of that list, counted net over the
#            whole range; an instruction file keeps its cause. A diff whose
#            protection read fails answers standard,
#            cause=protection-unreadable, measured=false.
#   standard everything else, and every diff this script cannot prove into a
#            narrower class. A size is measured only where harness-only read
#            every changed path against an inventory it could read: that file
#            is what generated ownership is read from, so every rule below
#            stands on it. Every other refusal it reports — the inventory at
#            an endpoint, the inventory's shape, a changed path, a path
#            lookup, the diff, the endpoints, the event, and any refusal it
#            adds later — answers standard carrying that cause, named here or
#            not. Fail-closed: standard buys a diff nothing. A base that
#            holds no inventory at all (cause=base-inventory-absent) takes
#            standard as a fixed rule ahead of the size rules, with
#            measured=true: a reading, not a refusal, though no size was
#            measured. The same diff on a base with an inventory can earn a
#            narrower class. An inventory the base holds and harness-only
#            cannot read or parse stays a refusal.
#
# A changed kendex configuration file refuses every narrow class, not only
# render: those files decide what is rendered and what each judgement below
# reads. harness-only removes a byte-exact top-level kendex.toml schema step first.
# The settings admission admits a changed kendex.settings.toml or
# .kendex/settings.toml to the trivial set, on --event pull_request or
# merge_group, where every [env] key it changes is admitted. A key is light
# by default where all of these hold at the commit --base names, the one
# the allowlist below is read from, never the merge base, so the branch
# under judgement writes none of it and a branch forked before a mark was
# dropped keeps none:
#   - an [env] declaration in a kendex.settings.toml.example that
#     commit's inventory lists, with an inventoried SKILL.md in its
#     directory, has
#     the exact trimmed line `# ci: unread` in its comment block, the block
#     directly above the assignment that a blank line, a table header or
#     another assignment ends. The mark is the declaring package's word that
#     no CI job reads the key and that a change to it needs no review;
#   - every kendex.settings.toml.example that commit tracks that declares
#     the key, in any table, inventoried or not, marks it;
#   - the key starts with the namespace of every package that declares it:
#     the example's directory name in upper snake case and an underscore,
#     SLACK_ for .../slack/kendex.settings.toml.example, where a name
#     outside kebab case gives none;
#   - a package that declares it owns the longest namespace that starts the
#     key among every directory that commit tracks holding a SKILL.md or an
#     example, so a package whose name starts another's, github beside
#     github-repository-settings, marks none of the longer one's keys;
#   - no `# keys:` family line in any tracked example matches the key, each
#     item an anchored whole key with <NAME> read as [A-Za-z0-9_]+;
#   - that commit's kendex.toml has no line starting with the key
#     is_source_catalog.
# HARNESS_CI_TRIVIAL_SETTINGS, blank-separated globs of [env] key names read
# from the settings of the commit --base names alone, adjusts that default:
# an entry starting with `!` removes the keys its remainder names, and any
# other entry adds keys, both matched as the same extglob patterns. The
# admitted set is the
# default and the additions, less the removals and the floor: a key in the
# settings this script reads from the base, or any HARNESS_CI_* key, never
# qualifies, whatever the globs say, so a change to the allowlist itself is
# refused. Admission needs every changed configuration source to be one of
# those two files, each a regular file at every endpoint that holds it, an
# endpoint without it read as an empty file, loaded there by lib/kendex-env.sh, holding no byte that reader's line loop drops (a NUL), no
# multiline string delimiter, and changed only in comment lines, blank lines
# and [env] assignments of admitted keys. A diff that changes only comments
# and blank lines is admitted. A diff of admitted settings files alone is
# trivial at any line count. Beside any other path, the trivial rule
# judges those paths and the ceiling, over the whole diff, as it does for any
# diff, with no agent instruction file beside it. It answers
# `cause=declared-unread-settings settings=<file>[,<file>]
# keys=<key>[,<key>]|- lines=<n>`, keys naming those whose loaded value
# differs, or `cause=allowlisted-settings` with the same fields where one of
# those keys is outside the default. harness-only's
# refusals, cause=base-inventory-absent and an empty path list answer ahead
# of the configuration-source rule and print no admission line. Once that rule
# holds the change, every other answer, whatever its class or cause, is
# that refusal, measured, and prints one `settings-admission:
# admitted=false cause=<c> [<field>=<value>]...` line. Its cause is the
# admission rule that refused: unsupported-event, base-settings-unreadable,
# configuration-file, declarations-unreadable, settings-unreadable,
# settings-not-regular, settings-bytes-dropped, multiline-string,
# settings-unparsed or unadmitted-change. declarations-unreadable carries
# step=inventory where harness-only's base inventory list could not be
# read, step=manifest where the base kendex.toml is not a regular file or
# could not be read, and
# step=example, with path= where one is named, where an example could not
# be listed or read, holds a multiline string delimiter or the reader
# refuses it; it refuses even where the allowlist alone would admit the
# change. After admission it is
# class-<class> rule=<cause>, the class and cause a later rule would have
# answered.
# A hand edit counts the same as the engine's: that line decides no render or
# classifier input. The render path still verifies the head. Product paths
# use the existing size rules without render verification.
# A consumer's kendex.toml, on --event pull_request or merge_group, where it
# is the only changed path, a regular file at every endpoint that holds it,
# no line at either endpoint starts with the key is_source_catalog, and
# bot-instructions renders at each endpoint the outputs that endpoint
# commits, leaves only the configuration-source refusal behind. That render
# is `check --staged` over an index read from the endpoint, run by the base
# commit's installed .agents/skills/bot-instructions out of a private
# checkout of that commit, as the queue selector is, with that copy as
# --spec: a change to the manifest alone leaves the copy byte-identical, so
# it is the checker a lane's bot-instructions check runs. Both endpoints
# are asked, one without the manifest included, which that check reports
# as a finding, so a diff that adds or deletes the manifest keeps the
# refusal; passing at both against the same committed outputs, the edit
# changes nothing a lane's bot-instructions check renders. Every later rule judges it,
# HARNESS_CI_STANDARD_PATHS included, and the size rules with a floor of
# small: trivial, micro and small answer `small cause=consumer-manifest
# lines=<n>`, and past the small ceiling it is standard. That answer also
# prints one `light-ci: kind=manifest` line before the class line, which
# harness-ci reads to stand lanes down. A refused candidate prints one `manifest-admission:
# admitted=false cause=<c>` line: unsupported-event, or, with
# side=base|head, manifest-not-regular, manifest-unreadable, source-catalog,
# bot-instructions-render, where that check reported findings, or
# bot-instructions-unread, where it could not answer, with
# detail=checkout-failed, detail=checker-absent, detail=checker-unreadable
# or detail=checker-unusable where the base's copy could not be run.
# A harness's own registry files refuse every narrow class but
# render, the files it executes as configuration: its hooks, its permissions,
# and the MCP servers it may run. kendex writes keys in those and never the
# file, so a re-rendered one reaches render only where the row owning it says
# the rest of the file did not move. The paths trivial, micro and small all
# refuse are this package's references/narrow-change.conf; the
# ceilings in that file are micro's and small's alone. The render inventory
# on that list is read against it only where its change is more than names.
# In the size path, where harness-only prints `inventory-change: names-only`
# and each named root is one of the measurement's render roots, the inventory
# unlists only paths the diff deletes, a render effect, and it leaves the
# path set that list and the subsystem rule read.
#
# THE CLASS IS NEVER READ FROM A LABEL, A BRANCH NAME, A PULL REQUEST TITLE or
# any other author-writable field, and no flag carries one: the author of the
# diff being judged writes all of them, so trusting one fails open on exactly
# the diffs that most want to pass. For the same reason the judged tree's own
# configuration decides nothing here, and no script out of that tree is run.
# ORCH_SIZE_RENDER_ROOTS, ORCH_SIZE_TEST_PATHS, HARNESS_CI_TRIVIAL_MAX_LINES
# and HARNESS_CI_TRIVIAL_PATHS come from this process's environment, else
# from the [env] tables of kendex.settings.toml and .kendex/settings.toml, the
# second winning, as the base endpoint's commit holds them.
# HARNESS_CI_STANDARD_PATHS (additional exclusions before render and size
# classes, blank-separated, unset or empty adds none) and
# HARNESS_CI_TRIVIAL_SETTINGS come from those tables alone, never from the
# environment. The private env file is never read.
# A caller that acts on the verdict without review runs the DEFAULT BRANCH's
# copy of this script against the pull request's tree; the branch can change
# this file too.
#
# The render proof runs the `kendex` on PATH, save for one diff: where the only
# changed path is `.kendex-lock.json`, the install record, and this process's
# environment sets HARNESS_CI_LOCK_KENDEX, it runs the executable that names.
# The record is written by a kendex built from the recording tree, so a
# registration shape newer than the release on PATH reads to that release as
# drift. The variable is read from the
# environment alone, never from a settings file: it names a binary on the
# machine running this script. A path that is not executable answers standard
# with cause=no-verifier. The `render-verifier:` line names the verifier that
# ran, `path` or `lock`, and the version its `--version` printed, and a
# verify-refused cause carries both, so a refusal reads as the verifier's age.
#
# A verify refusal carrying `verb=source operation=refresh` reads
# cause=source-mirror-missing with those remedy fields. It grants no class
# until the caller refreshes the mirror and the proof passes.
#
# Only the render class reads kendex state. The caller prepares the judged
# checkout's sources. The render proof can also own the adopted refresh caller
# under ../SKILL.md § Shared refresh caller ownership.
#
# A measured class needs --event pull_request or --event merge_group; any
# other event answers render or standard and never a size class.
set -euo pipefail
# The narrow-change list's globs are bash patterns with extglob on.
shopt -s extglob

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HARNESS_ONLY="$SCRIPT_DIR/harness-only"
# The trusted sibling checker the render proof hands `kendex verify`; absent,
# verify refuses the option and the proof answers standard.
BOT_INSTRUCTIONS_DIR="$SCRIPT_DIR/../../bot-instructions"
NARROW_CONF="$SCRIPT_DIR/../references/narrow-change.conf"
# shellcheck source=lib/change-scope.sh
. "$SCRIPT_DIR/lib/change-scope.sh"
# The micro-tier measurement's boundary as this script reaches it: every file
# it reads or runs whose edit changes the range measured, the settings the
# measurement reads, or the ceilings it compares against. This package's
# narrow-change.conf refuses the narrow classes on each, and
# https://github.com/vanillagreencom/kendex/blob/main/skills/change-scope/tests/narrow-boundary.test.sh
# holds that file's boundary group to this list and the source lines of every
# file it names.
# measures-with: skills/change-scope/scripts/change-scope
# measures-with: skills/change-scope/scripts/harness-only
# measures-with: skills/change-scope/scripts/lib/change-scope.sh
# measures-with: skills/change-scope/scripts/lib/branch-growth.sh
# measures-with: skills/change-scope/scripts/lib/kendex-env.sh
# measures-with: skills/change-scope/references/narrow-change.conf
# measures-with: skills/bot-instructions/scripts/bot-instructions
# measures-with: skills/bot-instructions/scripts/lib/__init__.py
# measures-with: skills/bot-instructions/scripts/lib/cli.py
# measures-with: skills/bot-instructions/scripts/lib/config.py
# measures-with: skills/bot-instructions/scripts/lib/constants.py
# measures-with: skills/bot-instructions/scripts/lib/errors.py
# measures-with: skills/bot-instructions/scripts/lib/fsutil.py
# measures-with: skills/bot-instructions/scripts/lib/globs.py
# measures-with: skills/bot-instructions/scripts/lib/jsonschema.py
# measures-with: skills/bot-instructions/scripts/lib/main.py
# measures-with: skills/bot-instructions/scripts/lib/manifest.py
# measures-with: skills/bot-instructions/scripts/lib/markdown.py
# measures-with: skills/bot-instructions/scripts/lib/marker.py
# measures-with: skills/bot-instructions/scripts/lib/model.py
# measures-with: skills/bot-instructions/scripts/lib/refusals.py
# measures-with: skills/bot-instructions/scripts/lib/render.py
# measures-with: skills/bot-instructions/scripts/lib/render_coderabbit.py
# measures-with: skills/bot-instructions/scripts/lib/render_markdown.py
# measures-with: skills/bot-instructions/scripts/lib/render_qodo.py
# measures-with: skills/bot-instructions/scripts/lib/repo_toml.py
# measures-with: skills/bot-instructions/scripts/lib/run.py
# measures-with: skills/bot-instructions/scripts/lib/spec.py
# measures-with: skills/bot-instructions/scripts/lib/tree.py
# measures-with: skills/bot-instructions/scripts/lib/validators_bytes.py
# measures-with: skills/bot-instructions/scripts/lib/validators_repo.py
# measures-with: skills/bot-instructions/scripts/lib/verbs.py
# measures-with: skills/bot-instructions/scripts/lib/writer.py
# measures-with: skills/bot-instructions/scripts/lib/yamlemit.py
# measures-with: skills/bot-instructions/schemas/repo-toml.md
# The one version of `kendex verify --json` this script reads. The document
# is the render proof's whole contract with kendex: a kendex printing another
# version, or none, answers standard rather than being read by guesswork.
VERIFY_DOCUMENT_VERSION=1

event=""
base=""
head="HEAD"
repo="."
paths_output=""
changed=""
# A settings change admitted by the base declarations and allowlist: its class-line
# fields, its files, the refusal it keeps, and the keys one file changed.
SETTINGS_ADMITTED=""
MANIFEST_ADMITTED=""
SETTINGS_FILES=""
SETTINGS_REFUSAL=""
SETTINGS_FILE_KEYS=""
BASE_SETTINGS_KEYS='ORCH_SIZE_RENDER_ROOTS ORCH_SIZE_TEST_PATHS HARNESS_CI_TRIVIAL_MAX_LINES HARNESS_CI_TRIVIAL_PATHS HARNESS_CI_STANDARD_PATHS HARNESS_CI_TRIVIAL_SETTINGS'

usage() { sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

die() { # FIELDS MESSAGE — a wiring error, never a verdict
  printf 'wiring-error: %s\n' "$1" >&2
  echo "change-scope: $2" >&2
  exit 2
}

need_value() { # FLAG REMAINING NEXT
  [ "$2" -ge 2 ] || die "cause=missing-value option=$1" "$1 needs a value"
  case "$3" in
    -?*) die "cause=flag-used-as-value option=$1 value=$3" \
      "$1 needs a value, got the flag '$3'" ;;
  esac
}

configuration_unread() { printf 'configuration-unreadable: %s\n' "$1" >&2; }
settings_note() {
  printf 'settings-admission: admitted=false %s\n' "$1" >&2
  [ "${2:-}" != unreadable ] || configuration_unread "$1"
}

launch_key_admitted() { # KEY
  local LC_ALL=C grammar='^[a-zA-Z_][a-zA-Z0-9_]*$'
  case "$1" in HARNESS_CI_* | ORCH_SIZE_* | is_source_catalog) return 1 ;; esac
  [[ "$1" =~ $grammar ]]
}

# FILE without its admitted assignments at RESIDUE. For settings, comment
# and blank lines also drop, each admitted key goes to stdout and the
# settings value reader validates headers on the same bytes.
# Returns 2 where the lines read are not FILE's bytes: Bash drops a NUL,
# and git counts a file holding one as binary.
settings_scan() { # FILE RESIDUE [launch|manifest]
  (
    local LC_ALL=C
    exec 3>&1 1>&2
    # shellcheck source=lib/kendex-env.sh
    . "$SCRIPT_DIR/lib/kendex-env.sh" || exit 1
    : >"$2" && : >"$2.read" || exit 1
    section="" seen=" " delimiter=""
    while :; do
      newline=$'\n'
      IFS= read -r line || { [ -n "$line" ] || break; newline=""; }
      printf '%s%s' "$line" "$newline" >>"$2.read" || exit 1
      kendex_trim trimmed "${line%$'\r'}"
      content="$trimmed"
      if [ -z "$delimiter" ]; then
        case "$trimmed" in
          '' | '#'*) [ "${3:-}" = manifest ] || continue ;;
          '['*) section="$trimmed" ;;
          *=*)
            kendex_trim key "${trimmed%%=*}"
            if [ "${3:-}" = manifest ]; then
              kendex_trim content "${trimmed#*=}"
              case "$content" in
                '"""'* | "'''"*)
                  delimiter="${content:0:3}"
                  content="${content:3}" ;;
              esac
              if [ "$section" = '[skill-instructions]' ]; then
                # Quoted or dotted keys can alias a bare key.
                [[ "$key" =~ ^[A-Za-z0-9_-]+$ && "$seen" != *" $key "* ]] || exit 3
                seen="$seen$key "
                if [ -z "$delimiter" ]; then
                  kendex_decode_value value "$content" || exit 3
                  continue
                fi
              fi
            elif [ "$section" = '[env]' ] &&
              { { [ "$#" -eq 2 ] && settings_key_admitted "$key"; } ||
                { [ "${3:-}" = launch ] && launch_key_admitted "$key"; }; }; then
              printf '%s\n' "$key" >&3
              continue
            fi ;;
        esac
        if [ "${3:-}" = manifest ] && [ -z "$delimiter" ]; then
          case "$trimmed" in '' | '#'*) ;; *'"""'* | *"'''"*) exit 3 ;; esac
        fi
      fi
      if [ -n "$delimiter" ] && [[ "$content" == *"$delimiter"* ]]; then
        # Resume only at a proven closing delimiter. In a basic string a
        # backslash can make a quote content, so refuse that boundary.
        if [ "$delimiter" = '"""' ] && [[ "${content%%"$delimiter"*}" == *\\ ]]; then
          exit 3
        fi
        closing_quote="${delimiter:0:1}"
        tail="${content#*"$delimiter"}"
        tail="${tail#"$closing_quote"}"
        kendex_trim tail "${tail#"$closing_quote"}"
        case "$tail" in '' | '#'*) delimiter="" ;; *) exit 3 ;; esac
      fi
      [ "${3:-}" = manifest ] || newline=$'\n'
      printf '%s%s' "$line" "$newline" >>"$2" || exit 1
    done <"$1"
    [ -z "$delimiter" ] || exit 3
    status=0
    cmp -s -- "$1" "$2.read" || status=$?
    case "$status" in
      0) ;;
      1) exit 2 ;;
      *) exit 1 ;;
    esac
  )
}

# KEY=value for each KEY the reader loads from FILE. Returns 1 where it
# refuses FILE. The keys arrive as arguments, which no loaded key can
# overwrite.
settings_values() { # FILE KEY...
  (
    exec 3>&1 1>&2
    # shellcheck source=lib/kendex-env.sh
    . "$SCRIPT_DIR/lib/kendex-env.sh" || exit 1
    for key in "${@:2}"; do unset "$key" || exit 1; done
    kendex_load_settings_file "$1" -- "${@:2}" || exit 1
    for key in "${@:2}"; do
      [ -z "${!key+x}" ] || printf '%s=%s\n' "$key" "${!key}" >&3
    done
  )
}

# The keys whose value differs between the range's endpoints of PATH, as
# SETTINGS_FILE_KEYS. Returns 1, with the admission line, where admission
# refuses the file. A settings file with a multiline string delimiter is
# outside the settings reader's grammar.
settings_file_admitted() { # PATH [launch|manifest]
  local side rev status mode=""
  if ! : >"$work/settings-keys"; then
    settings_note "cause=settings-unreadable path=$1" unreadable
    return 1
  fi
  for side in base head; do
    rev="$base_rev"
    [ "$side" = base ] || rev="$head_rev"
    status=0
    rev_file "$rev" "$1" "$work/settings-$side" || status=$?
    case "$status" in
      0) ;;
      2) [ "$#" -eq 1 ] || return 1; : >"$work/settings-$side" || status=1 ;;
      3)
        settings_note "cause=settings-not-regular path=$1 side=$side"
        return 1 ;;
    esac
    [ "$status" = 0 ] || [ "$status" = 2 ] || {
      settings_note "cause=settings-unreadable path=$1 side=$side rev=${rev:-unresolved}" unreadable
      return 1
    }
    [ "$#" -eq 1 ] || [ "$side" = base ] || [ "$mode" = "$REV_FILE_MODE" ] || return 1
    mode="$REV_FILE_MODE"
    if [ "${2:-}" != manifest ]; then
      status=0
      grep -qE "\"\"\"|'''" -- "$work/settings-$side" || status=$?
      case "$status" in
        0)
          settings_note "cause=multiline-string path=$1 side=$side"
          return 1 ;;
        1) ;;
        *)
          settings_note "cause=settings-unreadable path=$1 side=$side" unreadable
          return 1 ;;
      esac
    fi
    status=0
    settings_scan "$work/settings-$side" "$work/settings-residue-$side" "${@:2}" \
      >>"$work/settings-keys" || status=$?
    case "$status" in
      0) ;;
      2)
        settings_note "cause=settings-bytes-dropped path=$1 side=$side" unreadable
        return 1 ;;
      3)
        settings_note "cause=unadmitted-change path=$1 side=$side"
        return 1 ;;
      *)
        settings_note "cause=settings-unreadable path=$1 side=$side" unreadable
        return 1 ;;
    esac
  done
  if cmp -s -- "$work/settings-residue-base" "$work/settings-residue-head"; then
    status=0
  else
    status=$?
  fi
  if [ "${2:-}" != manifest ]; then
    settings_changed_values "$1" || return 1
  fi
  case "$status" in
    0) ;;
    1) settings_note "cause=unadmitted-change path=$1"; return 1 ;;
    *) settings_note "cause=unadmitted-change path=$1"; configuration_unread "cause=settings-unreadable path=$1"; return 1 ;;
  esac
}

settings_changed_values() { # PATH
  local keys base_values head_values key line base_value head_value
  if ! keys="$(LC_ALL=C sort -u "$work/settings-keys")"; then
    settings_note "cause=settings-unreadable path=$1" unreadable
    return 1
  fi
  # shellcheck disable=SC2086
  if ! base_values="$(settings_values "$work/settings-base" $keys)"; then
    settings_note "cause=settings-unparsed path=$1 side=base" unreadable
    return 1
  fi
  # shellcheck disable=SC2086
  if ! head_values="$(settings_values "$work/settings-head" $keys)"; then
    settings_note "cause=settings-unparsed path=$1 side=head" unreadable
    return 1
  fi
  SETTINGS_FILE_KEYS=""
  for key in $keys; do
    base_value="" head_value=""
    while IFS= read -r line; do
      case "$line" in "$key="*) base_value="=${line#*=}" ;; esac
    done <<<"$base_values"
    while IFS= read -r line; do
      case "$line" in "$key="*) head_value="=${line#*=}" ;; esac
    done <<<"$head_values"
    [ "$base_value" = "$head_value" ] || SETTINGS_FILE_KEYS="$SETTINGS_FILE_KEYS,$key"
  done
}

# The launch arm's choice so far: the first input naming the widest class.
LAUNCH_CLASS=""
LAUNCH_RANK=-1
LAUNCH_CAUSE=""
LAUNCH_MEASURED=""
launch_consider() { # CLASS CAUSE [unmeasured]
  change_scope_rank "$1" || die "cause=class-unranked class=$1" "no rank for class '$1'"
  if [ "$CHANGE_SCOPE_RANK" -gt "$LAUNCH_RANK" ]; then
    LAUNCH_CLASS="$1"
    LAUNCH_RANK="$CHANGE_SCOPE_RANK"
    LAUNCH_CAUSE="$2"
    LAUNCH_MEASURED=true
    [ "${3:-}" != unmeasured ] || LAUNCH_MEASURED=false
  fi
}

# One ceiling of the narrow-change list, the last line naming it.
ceiling() { # KEY
  sed -n "s/^$1=\([0123456789][0123456789]*\)\$/\1/p" "$NARROW_CONF" | tail -1
}

# Reuse the classifier's regular-file and changed-key proof for launch.
# The PR's base tip owns its exclusions even when its merge base is older.
launch_settings_range() ( # BASE HEAD REPO WORK
  local base="$1" head="$2" repo="$3" work="$4" path limit numstat added removed lines=0 hunks
  local base_rev head_rev="$2" changed="" mode=launch settings_paths="${BASE_SETTINGS_FILES// /$'\n'}"
  settings_paths+=$'\nkendex.toml\nkendex-local.toml'
  while IFS= read -r -d '' path; do
    change_class_path_match "$path" "$settings_paths" || return 1
    changed="${changed:+$changed$'\n'}$path"
  done <"$work/paths"
  [ -n "$changed" ] || return 1
  case "$changed" in
    kendex.toml | kendex-local.toml) mode=manifest ;;
    *kendex.toml* | *kendex-local.toml*) return 1 ;;
  esac
  unset HARNESS_CI_STANDARD_PATHS HARNESS_CI_TRIVIAL_SETTINGS
  base_settings || { configuration_unread "$MEASURE_CAUSE"; return 1; }
  set_globs "${HARNESS_CI_STANDARD_PATHS:-}"
  path_matches any && return 1
  if ! base_rev="$(git -C "$repo" merge-base "$base" "$head" 2>/dev/null)"; then
    configuration_unread "cause=settings-base-unreadable base=$base head=$head"
    return 1
  fi
  while IFS= read -r path; do
    settings_file_admitted "$path" "$mode" || return 1
  done <<<"$changed"
  if ! limit="$(ceiling micro_max_production)" || [ -z "$limit" ]; then
    configuration_unread "cause=settings-ceiling-unreadable"
    return 1
  fi
  if ! branch_size_numstat "$repo" "" "$head" numstat "$base"; then
    configuration_unread "cause=settings-size-unreadable detail=$BRANCH_GROWTH_ERROR"
    return 1
  fi
  while IFS=$'\t' read -r added removed path; do
    [[ "$added" =~ ^[0-9]+$ && "$removed" =~ ^[0-9]+$ ]] || return 1
    [ "$mode" != manifest ] || { [ "$added" -le 1 ] && [ "$removed" -le 1 ]; } || return 1
    lines=$((lines + added))
  done <<<"$numstat"
  if [ "$mode" = manifest ]; then
    if ! hunks="$(git -C "$repo" diff --no-color --unified=0 --inter-hunk-context=0 --no-ext-diff \
        --no-textconv --no-renames "$base_rev" "$head_rev" -- "$changed" |
        awk '/^@@ / { count++ } END { print count+0 }')"; then
      configuration_unread "cause=settings-hunks-unreadable path=$changed"
      return 1
    fi
    [ "$hunks" -eq 1 ] || return 1
  fi
  [ "$lines" -le "$limit" ]
)

launch_unread_configuration() { # STDERR_FILE
  local failure
  if ! failure="$(sed -n 's/^configuration-unreadable: //p' "$1")"; then
    launch_consider standard "configuration-evidence-unreadable" unmeasured
  elif [ -n "$failure" ]; then
    failure="${failure%%$'\n'*}"
    launch_consider standard "${failure#cause=}" unmeasured
  else
    return 1
  fi
}

# The range's class as this script's own classifier reads it, the reading
# review depth takes through the same reader, so the range's production lines
# decide its cycle as they decide its review. A work item runs at micro or
# wider, so a ranked class below micro reads as micro; an unranked one reaches
# launch_consider, which refuses it.
launch_range_class() { # BASE HEAD REPO STDERR_FILE SETTINGS_RANGE
  local class rule refusal
  if ! change_scope_read "$1" "$2" "$3" "$4"; then
    # The classifier's own cause, which the detail cannot carry.
    [ ! -s "$4" ] || cat -- "$4" >&2
    launch_consider standard "branch-class-unreadable detail=$CHANGE_SCOPE_CAUSE" unmeasured
    return 0
  fi
  rule="branch-class class=$CHANGE_SCOPE_CLASS rule=${CHANGE_SCOPE_RULE#cause=}"
  class="$CHANGE_SCOPE_CLASS"
  if [ "$5" = true ] && [ "$CHANGE_SCOPE_MEASURED" = true ] &&
    [[ "$CHANGE_SCOPE_RULE" = cause=configuration-source\ * ||
      "$CHANGE_SCOPE_RULE" = cause=consumer-manifest\ * ]]; then
    if launch_unread_configuration "$4"; then
      return 0
    fi
    if ! refusal="$(sed -n 's/^manifest-admission: admitted=false cause=//p' "$4")"; then
      launch_consider standard configuration-evidence-unreadable unmeasured
    else
      case "$refusal" in
        '' | 'bot-instructions-unread side=base detail=checker-absent')
          launch_consider micro settings-only ;;
        *)
          sed '/^class: /d; /^quick-proof: /d' "$4" >&2
          case "$refusal" in
            bot-instructions-unread\ * | manifest-unreadable\ *)
              launch_consider standard "$refusal" unmeasured ;;
            *) launch_consider standard "$refusal" ;;
          esac ;;
      esac
    fi
    return 0
  fi
  if change_scope_rank "$class" && ! change_scope_floor "$class"; then
    class=micro
  fi
  if [ "$CHANGE_SCOPE_MEASURED" = true ]; then
    launch_consider "$class" "$rule"
  else
    launch_consider standard "$rule" unmeasured
  fi
}

launch_class() { # ARG...
  local production="" body="" base="" head="" repo=. body_text delta="" path floor
  local micro_max small_max paths=() floors=() launch_work settings_range=false
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --production) need_value "$1" "$#" "${2:-}"; production="$2"; shift 2 ;;
      --body) need_value "$1" "$#" "${2:-}"; body="$2"; shift 2 ;;
      --floor) need_value "$1" "$#" "${2:-}"; floors=("${floors[@]+"${floors[@]}"}" "$2"); shift 2 ;;
      --path) need_value "$1" "$#" "${2:-}"; paths=("${paths[@]+"${paths[@]}"}" "$2"); shift 2 ;;
      --base) need_value "$1" "$#" "${2:-}"; base="$2"; shift 2 ;;
      --head) need_value "$1" "$#" "${2:-}"; head="$2"; shift 2 ;;
      --repo) need_value "$1" "$#" "${2:-}"; repo="$2"; shift 2 ;;
      -h | --help) usage; exit 0 ;;
      *) die "cause=unknown-argument argument=$1" "unknown argument '$1'" ;;
    esac
  done
  case "$production" in
    '') ;;
    *[!0123456789]*) die "cause=invalid-production value=$production" "--production must be a whole number" ;;
  esac
  for floor in "${floors[@]+"${floors[@]}"}"; do
    change_scope_floor "$floor" ||
      die "cause=invalid-floor floor=$floor" "--floor must be a class at or above micro"
  done
  if { [ -n "$base" ] && [ -z "$head" ]; } || { [ -z "$base" ] && [ -n "$head" ]; }; then
    die "cause=range-incomplete" "--base and --head are given together"
  fi
  [ -n "$production" ] || [ -n "$body" ] || [ "${#floors[@]}" -gt 0 ] || [ -n "$base" ] ||
    die "cause=no-input" "name --production, --body, --floor or --base"
  # shellcheck source=lib/branch-growth.sh
  . "$SCRIPT_DIR/lib/branch-growth.sh" ||
    die "cause=measurement-library-unreadable" "lib/branch-growth.sh could not be loaded"

  if [ -n "$body" ]; then
    body_text="$(cat -- "$body")" || die "cause=body-unreadable path=$body" "cannot read --body '$body'"
    if ! expected_delta_read "$body_text"; then
      printf 'launch-warning: cause=invalid-delta line=[%s] accepted=[N lines] [N lines, M test lines] (1 line, 1 test line singular; 0 a stated zero); read as no delta\n' \
        "$EXPECTED_DELTA_LINE" >&2
      EXPECTED_DELTA_PRODUCTION=""
    fi
    delta="$EXPECTED_DELTA_PRODUCTION"
    if [ -n "$delta" ] && { [ -z "$production" ] || [ "$delta" -gt "$production" ]; }; then
      production="$delta"
    fi
    [ -n "$production" ] || launch_consider standard body-without-tier-inputs
  fi

  if [ -n "$production" ]; then
    if [ ! -r "$NARROW_CONF" ] || ! micro_max="$(ceiling micro_max_production)" ||
      ! small_max="$(ceiling small_max_production)"; then
      launch_consider standard narrow-change-unreadable unmeasured
    elif [ -z "$micro_max" ] || [ -z "$small_max" ]; then
      launch_consider standard narrow-change-ceilings-missing unmeasured
    elif [ "$production" -le "$micro_max" ]; then
      launch_consider micro "estimate-within-micro production=$production"
    elif [ "$production" -le "$small_max" ]; then
      launch_consider small "estimate-within-small production=$production"
    else
      launch_consider standard "estimate-past-small production=$production"
    fi
  fi

  if [ "${#paths[@]}" -gt 0 ]; then
    if change_scope_location_load "$repo"; then
      for path in "${paths[@]}"; do
        change_class_path "$path" launch
        [ -z "$CHANGE_CLASS_PATH" ] || launch_consider "$CHANGE_CLASS_PATH" "$CHANGE_CLASS_PATH_CAUSE"
      done
    else
      launch_consider standard "$CHANGE_CLASS_CAUSE" unmeasured
    fi
  fi

  for floor in "${floors[@]+"${floors[@]}"}"; do
    launch_consider "$floor" "floor class=$floor"
  done

  if [ -n "$base" ]; then
    LAUNCH_WORK="$(mktemp -d 2>/dev/null)" || LAUNCH_WORK=""
    [ -n "$LAUNCH_WORK" ] && [ -d "$LAUNCH_WORK" ] ||
      die "cause=scratch-unavailable" "a scratch directory could not be created"
    trap 'rm -rf -- "${LAUNCH_WORK:?}"' EXIT
    launch_work="$LAUNCH_WORK"
    if ! base="$(git -C "$repo" rev-parse --verify "$base^{commit}" 2>/dev/null)" ||
      ! head="$(git -C "$repo" rev-parse --verify "$head^{commit}" 2>/dev/null)" ||
      ! git -C "$repo" diff --no-color --name-only -z --no-ext-diff --no-renames "$base...$head" -- \
      >"$launch_work/paths" 2>/dev/null; then
      launch_consider standard branch-paths-unreadable unmeasured
    elif ! change_scope_location_load "$repo"; then
      launch_consider standard "$CHANGE_CLASS_CAUSE" unmeasured
    else
      if launch_settings_range "$base" "$head" "$repo" "$launch_work" 2>"$launch_work/settings-err"; then
        settings_range=true
      else
        launch_unread_configuration "$launch_work/settings-err" || true
      fi
      while IFS= read -r -d '' path; do
        change_class_path "$path" launch
        if [ "$settings_range" = true ] && [[ "$CHANGE_CLASS_PATH_CAUSE" = configuration-source\ * ]]; then
          continue
        fi
        if [ "$path" = .kendex-generated.json ] && [[ "$CHANGE_CLASS_PATH_CAUSE" = excluded-path\ * ]] &&
          change_scope_inventory_rendered "$base" "$head" "$repo" "$launch_work/inventory-err"; then
          continue
        fi
        [ -z "$CHANGE_CLASS_PATH" ] || launch_consider "$CHANGE_CLASS_PATH" "$CHANGE_CLASS_PATH_CAUSE"
      done <"$launch_work/paths"
      if ! branch_protection_removed "$repo" "$base" "$head" "$NARROW_CONF"; then
        launch_consider standard protection-unreadable unmeasured
      elif [ -n "$BRANCH_PROTECTION_KIND" ]; then
        launch_consider small "protection-removed kind=$BRANCH_PROTECTION_KIND path=$BRANCH_PROTECTION_PATH removed=$BRANCH_PROTECTION_REMOVED added=$BRANCH_PROTECTION_ADDED"
      fi
      launch_range_class "$base" "$head" "$repo" "$launch_work/class-err" "$settings_range"
    fi
  fi

  printf 'class: class=%s measured=%s delta=%s cause=%s\n' \
    "$LAUNCH_CLASS" "$LAUNCH_MEASURED" "${delta:--}" "$LAUNCH_CAUSE" >&2
  printf 'change_class=%s\n' "$LAUNCH_CLASS"
  exit 0
}

if [ "${1:-}" = launch ]; then
  shift
  launch_class "$@"
fi

while [ "$#" -gt 0 ]; do
  case "$1" in
    --event) need_value "$1" "$#" "${2:-}"; event="$2"; shift 2 ;;
    --base) need_value "$1" "$#" "${2:-}"; base="$2"; shift 2 ;;
    --head) need_value "$1" "$#" "${2:-}"; head="$2"; shift 2 ;;
    --repo) need_value "$1" "$#" "${2:-}"; repo="$2"; shift 2 ;;
    --paths-output) need_value "$1" "$#" "${2:-}"; paths_output="$2"; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) die "cause=unknown-argument argument=$1" "unknown argument '$1'" ;;
  esac
done

[ -n "$event" ] || die "cause=missing-event option=--event" "--event is required"

work="$(mktemp -d 2>/dev/null)" || work=""
[ -n "$work" ] && [ -d "$work" ] ||
  die "cause=scratch-unavailable" "a scratch directory could not be created"
trap 'rm -rf -- "${work:?}"' EXIT
paths_file="$work/paths"
harness_err="$work/harness-stderr"

# `measured=` on the class line says which kind of answer this is, and it is
# the ONE place that distinction is made. Every class but `standard` is earned
# by a rule, so it is measured. `standard` is BOTH: a rule's verdict at the
# handful of sites that pass `measured` (a base with no inventory, an unproved
# render ownership gap, a path rule, a size rule), and this script's fallback
# everywhere something could not be read — a diff, an inventory, a render
# proof, the branch-size measurer, the narrow-change list. A consumer cannot
# tell those apart from the cause, and enumerating causes outside this script
# has failed three times, so the default for `standard` is REFUSED and a site
# that measured one says so. An `answer standard` added later is refused until
# its author decides otherwise, which is the way round that cannot hand a
# waiver to a diff nothing read. stdout is unchanged: one `change_class=` line.
#
# The quick proof the header states, for the class answer() prints. A trivial
# answer with no repository allowlist holds every changed path in the docs set
# or among the admitted settings files, so each path is judged here only for
# being one of those files or Markdown: the docs set also takes a template or
# a script under docs/.
quick_proof() { # CLASS
  local path
  [ "$1" = trivial ] || return 1
  [ "$event" = pull_request ] || return 1
  [ -z "${HARNESS_CI_TRIVIAL_PATHS:-}" ] || return 1
  while IFS= read -r path; do
    case $'\n'"$SETTINGS_FILES"$'\n' in *$'\n'"$path"$'\n'*) continue ;; esac
    case "$path" in *.md | *.markdown) ;; *) return 1 ;; esac
  done <<<"$changed"
}

# The configuration-source rule holding an admitted settings change read its
# paths alone, so every answer for that change but trivial, a later read
# failure included, is that refusal, measured, with the answer it replaced
# on the admission line that settings_note, with the admission below, prints.
answer() { # CLASS FIELDS [measured]
  local rule quick=false
  if [ -n "$SETTINGS_ADMITTED" ] && [ "$1" != trivial ]; then
    rule="${2%% *}"
    if [ "$1" = standard ] && [ "${3:-}" != measured ]; then
      configuration_unread "$2"
    fi
    settings_note "cause=class-$1 rule=${rule#cause=}"
    set -- standard "$SETTINGS_REFUSAL" measured
  fi
  if [ -n "$MANIFEST_ADMITTED" ]; then
    case "$1" in
      trivial | micro | small)
        set -- small "cause=consumer-manifest lines=$total"
        printf 'light-ci: kind=manifest\n' >&2 ;;
    esac
  fi
  measured=true
  [ "$1" != standard ] || measured=false
  [ "${3:-}" != measured ] || measured=true
  ! quick_proof "$1" || quick=true
  printf 'quick-proof: proved=%s\n' "$quick" >&2
  printf 'class: class=%s measured=%s %s\n' "$1" "$measured" "$2" >&2
  printf 'change_class=%s\n' "$1"
  exit 0
}

# harness-only owns the diff range for every event, its endpoint refusals, the
# revisions both ends of that range resolve to, and the generated-path
# ownership rules the render class needs. Its changed-path, base-rev and
# head-rev lines are repeated as they stand, and the cause inside its verdict
# notice is repeated as a note: it is the only account of why a path set is
# empty, where it becomes this script's cause, the only account of an
# inventory this script cannot stand on, where it becomes this script's cause
# too, and the only account of why the render class was out of reach on a
# diff of generated files, where the class a size earns would otherwise be
# the whole log.
harness_args=(--event "$event" --head "$head" --repo "$repo")
[ -z "$base" ] || harness_args=("${harness_args[@]}" --base "$base")
if ! harness_verdict="$("$HARNESS_ONLY" --mode harness "${harness_args[@]}" \
  --paths-output "$paths_file" --base-inventory-output "$work/base-inventory" --output /dev/null 2>"$harness_err")"; then
  cat "$harness_err" >&2
  die "cause=harness-only-failed event=$event" \
    "the shipped harness-only classifier refused this call"
fi
# The changed paths, as harness-only read them, for a caller judging the same
# diff on rules of its own: written before any rule below, so an early answer
# still leaves them.
if [ -n "$paths_output" ]; then
  if [ -s "$paths_file" ]; then
    cp -- "$paths_file" "$paths_output" 2>/dev/null ||
      die "cause=paths-output-write-failed path=$paths_output" \
        "could not write the changed paths to '$paths_output'"
  else
    : >"$paths_output" 2>/dev/null ||
      die "cause=paths-output-write-failed path=$paths_output" \
        "could not write the changed paths to '$paths_output'"
  fi
fi
sed -n '/^changed-path: /p' "$harness_err" >&2
sed -n '/^schema-bump: /p' "$harness_err" >&2
sed -n '/^base-rev: /p' "$harness_err" >&2
sed -n '/^head-rev: /p' "$harness_err" >&2
sed -n 's/^fallback: /harness-note: /p' "$harness_err" >&2
if ! harness_note="$(sed -n 's/^fallback: //p' "$harness_err" | tail -1)"; then
  harness_note=""
fi
# The revisions the range's two ends resolved to, read off the lines
# harness-only printed for them and resolved nowhere else: the render proof
# checks the head out and hands the base to `kendex verify --base`.
if ! base_rev="$(sed -n 's/^base-rev: //p' "$harness_err" | tail -1)"; then
  base_rev=""
fi
if ! head_rev="$(sed -n 's/^head-rev: //p' "$harness_err" | tail -1)"; then
  head_rev=""
fi
# harness-only's judgement of the inventory's own change, repeated as it
# stands. An absent or unreadable line leaves the inventory on the diff.
sed -n '/^inventory-change: /p' "$harness_err" >&2
if ! inventory_change="$(sed -n 's/^inventory-change: //p' "$harness_err" | tail -1)"; then
  inventory_change=""
fi

# The shared path rule, applied to the branch's paths at the phase where
# that rule belongs. The registry and pointer phases follow the render proof;
# the names-only inventory leaves the path set before the narrow phase.
path_class_matches() { # PHASE CLASS
  local path
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    change_class_path "$path" "$1"
    [ "$CHANGE_CLASS_PATH" != "$2" ] || return 0
  done <<<"$changed"
  return 1
}

# The measurement settings, read from the [env] tables of the settings files
# the base endpoint's commit holds, through the shared reader in the library:
# a branch cannot choose the ceilings or the roots its own size is scored
# against. A key this process's environment carries keeps that value, save
# the standard paths and the settings allowlist: a caller's environment is
# its own checkout's settings, which github.sh's router exports from the
# working tree, so those are dropped and the base's alone decide.
unset HARNESS_CI_STANDARD_PATHS HARNESS_CI_TRIVIAL_SETTINGS

# The changed paths harness-only read, ahead of every refusal below.
[ ! -s "$paths_file" ] || changed="$(cat -- "$paths_file")"

# The committed inventory is the file every rule below is judged by: generated
# ownership is read from it, so the render branch and the size rules both
# stand on that read. A `false` verdict from harness-only can record either
# a finding about ownership or a failed read. Two causes record a finding
# after the inventories validate: a path missing at an endpoint where it
# exists, and an ownership gain. A render class must prove ownership of
# every changed path.
# They keep their `harness-note:` line. Every other cause is a
# refusal to read something: the inventory at an endpoint, the inventory's
# shape, a changed path, a path lookup, the diff, the endpoints, the event.
# A refusal is not a product diff, so it answers standard here with the cause
# as it stands, ahead of every path and size rule. A cause harness-only adds
# later is refused by that default rather than measured until someone names
# it, which is the way round that cannot hand a narrow class to a diff whose
# ownership was never read.
#
# One cause is a reading, not a refusal: a base that holds no inventory at
# all, older than the render that first wrote one, which is a long-lived
# branch's normal state. Ownership at that end is not recorded, so the diff
# takes standard as a fixed rule ahead of every path and size rule below,
# marked measured=true because the absence is what was read; no size is
# measured. The same diff on a base with an inventory can earn a narrower
# class. An inventory the base holds and harness-only cannot read or parse
# keeps its own cause and stays refused.
case "$harness_note" in
  '') ;;
  cause=not-render-owned | cause=not-render-owned\ * | \
    cause=generated-ownership-gain | cause=generated-ownership-gain\ *) ;;
  cause=base-inventory-absent | cause=base-inventory-absent\ *)
    answer standard "$harness_note" measured ;;
  *) answer standard "$harness_note" ;;
esac

if [ ! -s "$paths_file" ] && [ "$harness_verdict" != harness_only=true ]; then
  answer standard "${harness_note:-cause=no-changed-paths}"
fi

# The settings admission the header states. A key no CI job reads decides no
# render or classifier input, the reason a configuration source is refused.
# A table other than [env] counts as a change: the reader ignores it and
# other tools may read it. The trivial rule below reads the ceiling where
# any other path is beside the admitted files, and answer() turns any other
# class an admitted change reaches into the refusal.
# The keys a merge-group run reads from the base never qualify, the
# allowlist itself included: their breakage stops the queue that would merge
# the repair.
settings_key_admitted() { # KEY
  local glob admitted=false
  case "$1" in
    '' | [0123456789]* | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_]*) return 1 ;;
    HARNESS_CI_*) return 1 ;;
  esac
  case " $BASE_SETTINGS_KEYS " in *" $1 "*) return 1 ;; esac
  case " $SETTINGS_DEFAULT_KEYS " in *" $1 "*) admitted=true ;; esac
  set -f
  for glob in ${HARNESS_CI_TRIVIAL_SETTINGS:-}; do
    case "$glob" in
      '!'*)
        # shellcheck disable=SC2254
        case "$1" in ${glob#!}) set +f; return 1 ;; esac ;;
      *)
        # shellcheck disable=SC2254
        case "$1" in $glob) admitted=true ;; esac ;;
    esac
  done
  set +f
  [ "$admitted" = true ]
}

# A directory's package namespace, as NAMESPACE: its name in upper snake
# case and an underscore, empty for a name outside kebab case.
NAMESPACE=""
package_namespace() { # DIR
  local name="${1##*/}"
  NAMESPACE=""
  case "$name" in
    '' | -* | *[!abcdefghijklmnopqrstuvwxyz0123456789-]*) ;;
    *) NAMESPACE="$(printf '%s' "${name//-/_}" | tr abcdefghijklmnopqrstuvwxyz ABCDEFGHIJKLMNOPQRSTUVWXYZ)_" ;;
  esac
}

# The [env] keys light by default, as SETTINGS_DEFAULT_KEYS, read from the
# declarations at the commit --base names alone, the one base_settings reads
# the allowlist from: the branch under judgement writes no mark, inventory
# entry or manifest key this reads, and the merge base, which the author
# picks by choosing where to fork, never speaks for a mark the base end has
# since dropped. harness-only writes that commit's validated inventory. The
# header states the rule. Every kendex.settings.toml.example the base tracks
# is read, an in-place or hand-written one included, since any of them can
# veto a key; only one the base inventory lists beside an inventoried
# SKILL.md, a skill's installed template, can admit one. Every tracked
# directory holding a SKILL.md or an example names a namespace a key's owner
# is chosen from. A source catalog's CI runs every package's own tests over
# the repository's settings, so it has no default. Returns 1, with the
# admission line, where a declaration could not be read, even where the
# allowlist alone would admit the change: one rule costs a full run, never a
# waiver. Called after base_settings, which resolves BASE_REV.
SETTINGS_DEFAULT_KEYS=""
settings_declarations() {
  local inventoried status path dir namespace admittable n=0 catalog=false owners=" "
  local rev="$BASE_REV" args=() refused="cause=declarations-unreadable step"
  if ! inventoried="$(cat -- "$work/base-inventory" 2>/dev/null)"; then
    settings_note "$refused=inventory" unreadable
    return 1
  fi
  inventoried=$'\n'"$inventoried"$'\n'
  status=0
  source_catalog_at "$rev" "$work/declarations-manifest" || status=$?
  case "$status" in
    0) ;;
    1) catalog=true ;;
    *) settings_note "$refused=manifest" unreadable; return 1 ;;
  esac
  if [ -z "$rev" ] || ! git -C "$repo" ls-tree -r -z --name-only --full-tree \
    "$rev" >"$work/declarations-tree" 2>/dev/null; then
    settings_note "$refused=example" unreadable
    return 1
  fi
  while IFS= read -r -d '' path; do
    dir=""
    case "$path" in */*) dir="${path%/*}" ;; esac
    case "$path" in
      SKILL.md | */SKILL.md | kendex.settings.toml.example | */kendex.settings.toml.example)
        package_namespace "$dir"
        namespace="$NAMESPACE"
        case "$owners" in *" $namespace "*) ;; *) owners="$owners$namespace " ;; esac ;;
    esac
    case "$path" in
      kendex.settings.toml.example | */kendex.settings.toml.example) ;;
      *) continue ;;
    esac
    n=$((n + 1))
    status=0
    rev_file "$rev" "$path" "$work/declaration-$n" || status=$?
    [ "$status" = 0 ] || { settings_note "$refused=example path=$path" unreadable; return 1; }
    # The line scan below cannot tell a comment from a line inside a
    # multiline string.
    status=0
    grep -qE "\"\"\"|'''" -- "$work/declaration-$n" || status=$?
    [ "$status" = 1 ] || { settings_note "$refused=example path=$path" unreadable; return 1; }
    settings_values "$work/declaration-$n" >/dev/null ||
      { settings_note "$refused=example path=$path" unreadable; return 1; }
    admittable=1
    case "$inventoried" in *$'\n'"$path"$'\n'*) ;; *) admittable=0 ;; esac
    case "$inventoried" in *$'\n'"$dir/SKILL.md"$'\n'*) ;; *) admittable=0 ;; esac
    args=("${args[@]+"${args[@]}"}" "ns=$namespace" "adm=$admittable" "$work/declaration-$n")
  done <"$work/declarations-tree"
  if [ "$catalog" = true ]; then return 0; fi
  [ "$n" -gt 0 ] || return 0
  # One comment block per assignment, as the template grammar reads it: a
  # blank line, a table header or an assignment ends it, so a mark speaks for
  # the one key below it. A `# keys:` line names a family one code path
  # builds every member of at run time, a member a consumer adds included,
  # so a mark on one declared member cannot speak for that reader. The
  # longest namespace that starts a key names its owner, which has to be a
  # package declaring it.
  if ! SETTINGS_DEFAULT_KEYS="$(awk -v owners="$owners" '
    BEGIN { split(owners, owned, " ") }
    FNR == 1 { section = ""; marked = 0 }
    {
      line = $0
      sub(/^[ \t\r\n]+/, "", line)
      sub(/[ \t\r\n]+$/, "", line)
    }
    line == "" { marked = 0; next }
    line ~ /^#/ {
      if (line == "# ci: unread") marked = 1
      if (match(line, /^#[ \t]*keys:/)) {
        count = split(substr(line, RLENGTH + 1), items, /[ \t,]+/)
        for (i = 1; i <= count; i++) {
          if (items[i] !~ /^[A-Za-z_<][A-Za-z0-9_<>]*$/) continue
          pattern = items[i]
          gsub(/<NAME>/, "[A-Za-z0-9_]+", pattern)
          family[++families] = "^" pattern "$"
        }
      }
      next
    }
    line ~ /^\[/ { section = substr(line, 2, length(line) - 2); marked = 0; next }
    index(line, "=") {
      was_marked = marked; marked = 0
      key = substr(line, 1, index(line, "=") - 1)
      sub(/[ \t]+$/, "", key)
      if (!was_marked) veto[key] = 1
      if (ns == "") veto[key] = 1
      if (index(key, ns) != 1) veto[key] = 1
      if (ns != "" && index(key, ns) == 1) declarer[key, ns] = 1
      if (was_marked && adm && section == "env" && key ~ /^[A-Za-z_][A-Za-z0-9_]*$/) light[key] = 1
    }
    END {
      for (key in light) {
        if (key in veto) continue
        owner = ""
        for (o in owned) if (index(key, owned[o]) == 1 && length(owned[o]) > length(owner)) owner = owned[o]
        if (!((key, owner) in declarer)) continue
        for (i = 1; i <= families; i++) if (key ~ family[i]) break
        if (i <= families) continue
        print key
      }
    }
  ' "${args[@]}")"; then
    settings_note "$refused=example" unreadable
    return 1
  fi
  SETTINGS_DEFAULT_KEYS="${SETTINGS_DEFAULT_KEYS//$'\n'/ }"
}

# SETTINGS_FILES, the admitted files one per line in byte order, and
# SETTINGS_ADMITTED, their class-line fields. Returns 1, with the admission
# line, where admission refuses the change. Another event defines no range
# the size rules read; unreadable base settings refuse admission.
settings_admission() {
  local path files="" file key keys=""
  case "$event" in
    pull_request | merge_group) ;;
    *)
      settings_note "cause=unsupported-event event=$event"
      return 1 ;;
  esac
  base_settings || {
    settings_note "$MEASURE_CAUSE" unreadable
    return 1
  }
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    change_class_path "$path" before-render
    [ "$CHANGE_CLASS_PATH" = standard ] || continue
    case " $BASE_SETTINGS_FILES " in
      *" $path "*) files="$files$path"$'\n' ;;
      *) settings_note "cause=configuration-file path=$path"; return 1 ;;
    esac
  done <<<"$changed"
  if ! files="$(printf '%s' "$files" | LC_ALL=C sort -u)"; then
    settings_note "cause=settings-unreadable" unreadable
    return 1
  fi
  settings_declarations || return 1
  while IFS= read -r file; do
    settings_file_admitted "$file" || return 1
    for key in ${SETTINGS_FILE_KEYS//,/ }; do
      case ",$keys," in *",$key,"*) ;; *) keys="$keys,$key" ;; esac
    done
  done <<<"$files"
  keys="${keys#,}"
  SETTINGS_CAUSE=cause=declared-unread-settings
  for key in ${keys//,/ }; do
    case " $SETTINGS_DEFAULT_KEYS " in
      *" $key "*) ;;
      *) SETTINGS_CAUSE=cause=allowlisted-settings ;;
    esac
  done
  SETTINGS_FILES="$files"
  SETTINGS_ADMITTED="settings=${files//$'\n'/,} keys=${keys:--}"
}

# Whether the kendex.toml commit REV holds starts a line with the key
# is_source_catalog, its bytes at OUT: 0 where no line does or REV holds no
# manifest, 1 where one does, 3 where the manifest is not a regular file and
# 4 where it could not be read.
source_catalog_at() { # REV OUT
  local status=0
  rev_file "$1" kendex.toml "$2" || status=$?
  case "$status" in
    0) ;;
    2) return 0 ;;
    3) return 3 ;;
    *) return 4 ;;
  esac
  status=0
  grep -qE -- "^[[:space:]]*[\"']?is_source_catalog" "$2" || status=$?
  case "$status" in
    0) return 1 ;;
    1) return 0 ;;
    *) return 4 ;;
  esac
}

# The manifest admission the header states, which owns the rule. Returns 1,
# with the admission line, where it refuses the change.
manifest_note() { printf 'manifest-admission: admitted=false %s\n' "$1" >&2; }
# The checker the header names, at MANIFEST_CHECKER: the base commit's
# installed bot-instructions, out of a private checkout of that commit, as
# a branch cannot choose the code that judges its manifest.
MANIFEST_CHECKER=""
manifest_checker() {
  local tree="$work/manifest-checker" log="$work/manifest-checker-log" status=0 installed
  local package=.agents/skills/bot-instructions
  rev_file "$base_rev" "$package/scripts/bot-instructions" "$work/checker-blob" || status=$?
  if [ "$status" -eq 2 ]; then
    # A missing executable within a tracked package is an incomplete install.
    if ! installed="$(git -C "$repo" ls-tree "$base_rev" -- "$package")"; then
      status=1
    elif [ -z "$installed" ]; then
      manifest_note "cause=bot-instructions-unread side=base detail=checker-absent"
      return 1
    fi
  fi
  if [ "$status" -eq 1 ]; then
    manifest_note "cause=bot-instructions-unread side=base detail=checker-unreadable"
    return 1
  fi
  if [ "$status" -ne 0 ] || [ "$REV_FILE_MODE" != 100755 ]; then
    manifest_note "cause=bot-instructions-unread side=base detail=checker-unusable"
    return 1
  fi
  if [ -z "$base_rev" ] || ! private_checkout "$tree" "$base_rev" "$log"; then
    cat -- "$log" >&2 2>/dev/null || true
    manifest_note "cause=bot-instructions-unread side=base detail=checkout-failed"
    return 1
  fi
  MANIFEST_CHECKER="$tree/$package"
  if [ ! -f "$MANIFEST_CHECKER/scripts/bot-instructions" ] ||
    [ ! -x "$MANIFEST_CHECKER/scripts/bot-instructions" ]; then
    manifest_note "cause=bot-instructions-unread side=base detail=checker-unusable"
    return 1
  fi
}
# Whether bot-instructions renders, from REV's tree, the outputs REV commits:
# MANIFEST_CHECKER's own `check --staged` over an index read from REV, with
# the environment queue_selection gives the base's command.
manifest_render_check() { # SIDE REV
  local index="$work/manifest-index-$1" status=0
  GIT_INDEX_FILE="$index" git -C "$repo" read-tree "$2" >/dev/null 2>&1 || status=2
  [ "$status" -ne 0 ] ||
    env -i PATH="$PATH" HOME="${HOME:-}" GIT_INDEX_FILE="$index" \
      "$MANIFEST_CHECKER/scripts/bot-instructions" --repo "$repo" --spec "$MANIFEST_CHECKER" \
      --staged check >"$work/manifest-check-$1" 2>&1 </dev/null || status=$?
  case "$status" in
    0) return 0 ;;
    1) cat -- "$work/manifest-check-$1" >&2; manifest_note "cause=bot-instructions-render side=$1" ;;
    *)
      [ ! -s "$work/manifest-check-$1" ] || cat -- "$work/manifest-check-$1" >&2
      manifest_note "cause=bot-instructions-unread side=$1" ;;
  esac
  return 1
}
manifest_admission() {
  local side rev status
  case "$event" in
    pull_request | merge_group) ;;
    *) manifest_note "cause=unsupported-event event=$event"; return 1 ;;
  esac
  for side in base head; do
    rev="$base_rev"
    [ "$side" = base ] || rev="$head_rev"
    status=0
    # An endpoint without the manifest holds no catalog key; the render
    # check below still asks it.
    source_catalog_at "$rev" "$work/manifest-$side" || status=$?
    case "$status" in
      0) ;;
      1) manifest_note "cause=source-catalog side=$side"; return 1 ;;
      3) manifest_note "cause=manifest-not-regular side=$side"; return 1 ;;
      *) manifest_note "cause=manifest-unreadable side=$side rev=${rev:-unresolved}"; return 1 ;;
    esac
  done
  manifest_checker || return 1
  manifest_render_check base "$base_rev" || return 1
  manifest_render_check head "$head_rev" || return 1
  MANIFEST_ADMITTED=true
}

if path_class_matches before-render standard; then
  SETTINGS_REFUSAL="cause=$CHANGE_CLASS_PATH_CAUSE"
  if [ "$changed" = kendex.toml ]; then
    manifest_admission || answer standard "$SETTINGS_REFUSAL" measured
  else
    settings_admission || answer standard "$SETTINGS_REFUSAL" measured
  fi
fi

# Repository exclusions add to the shared list and precede every render and
# size class. The base alone declares them so the change cannot select its
# own review class, even when generated ownership is proved.
base_settings || answer standard "$MEASURE_CAUSE"
set_globs "${HARNESS_CI_STANDARD_PATHS:-}"
if path_matches any; then
  answer standard "cause=repository-standard-path $PATH_MATCH_HIT" measured
fi

# The render proof weighs the tree at the range's head and no other: the
# commit harness-only resolved --head to, checked out into a directory of this
# script's own. The judged checkout's working tree is never weighed. Anything
# uncommitted there, such as a file an earlier step wrote back or an untracked
# render standing in for one the branch deleted, would be weighed in place of
# what the pull request would merge. And the commit it sits at is not always
# --head: Shape 4 in harness-ci's references/wiring.md checks the subject out at the pull
# request's merge ref, and a local caller's checkout can sit anywhere. The
# checkout is private_checkout's, above.
proof_tree="$work/proof"
checkout_head() { private_checkout "$proof_tree" "$head_rev" "$work/proof-stderr"; }

# `kendex verify` weighs the manifest and render bytes of every installed
# package, holds the two files kendex keeps about itself to what it would
# write, and fails a recorded entry nothing declares. A clean exit alone is
# not the proof: it also closes a run that checked nothing, in a checkout
# holding the committed inventory and no install record. The counts in its
# document are the evidence, and the class is granted only where it checked
# something and nothing failed.
#
# The base revision handed to `kendex verify --base` is the one harness-only
# resolved for the range the changed paths came from, read off its base-rev:
# line and never derived here a second time: it is what a shared file's rest
# is compared against, so a registry file changed only where kendex writes
# keys can be owned from the row. Without that line no shared file is
# proved, which refuses the class on such a file rather than granting it.
RENDER_REFUSAL=""
# `measured` where the refusal is a rule's verdict rather than a failed read.
RENDER_MEASURED=""
VERIFY_JSON=""
RENDER_BOT_INSTRUCTIONS=false
renders_match() {
  local verify_args verify_help counts checked failed version verifier=kendex kind=path verifier_version
  if [ "$changed" = .kendex-lock.json ] && [ -n "${HARNESS_CI_LOCK_KENDEX:-}" ]; then
    verifier="$HARNESS_CI_LOCK_KENDEX"
    kind=lock
  fi
  if ! command -v "$verifier" >/dev/null 2>&1; then
    RENDER_REFUSAL="cause=no-verifier verifier=$kind"
    return 1
  fi
  # The version names the verifier on the log and in a refusal, and decides
  # nothing: one that cannot be read is named as such.
  if ! verifier_version="$("$verifier" --version 2>/dev/null </dev/null)"; then
    verifier_version=""
  fi
  verifier_version="${verifier_version%%$'\n'*}"
  verifier_version="${verifier_version##* }"
  case "$verifier_version" in
    '' | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.+_-]*)
      verifier_version=unreadable ;;
  esac
  printf 'render-verifier: verifier=%s version=%s\n' "$kind" "$verifier_version" >&2
  # harness-only prints head-rev: on every verdict it reaches after resolving
  # both ends, harness_only=true included, so an absent line is a
  # harness-only that broke that promise.
  if [ -z "$head_rev" ]; then
    RENDER_REFUSAL="cause=head-rev-missing"
    return 1
  fi
  if ! checkout_head; then
    cat "$work/proof-stderr" >&2
    RENDER_REFUSAL="cause=head-checkout-failed head=$head_rev"
    return 1
  fi
  verify_args=(verify --scope project --json)
  RENDER_BOT_INSTRUCTIONS=false
  # Released kendex 1.12.1 lacks this option; post-tag builds can share its
  # version, so help decides support. Keep the legacy proof until the next
  # major release permits removing compatibility with 1.12.1.
  if verify_help="$("$verifier" verify --help 2>/dev/null </dev/null)" &&
    grep -Eq -- '(^|[[:space:]])--bot-instructions-from([[:space:]=]|$)' <<<"$verify_help"; then
    RENDER_BOT_INSTRUCTIONS=true
    verify_args=("${verify_args[@]}" --bot-instructions-from "$BOT_INSTRUCTIONS_DIR")
  fi
  if [ -n "$base_rev" ]; then
    # `--at-record` weighs each package at the commit the install record
    # names, and goes only beside `--base`: the base's record is the floor
    # that stops a branch rewriting its own record back to an older catalog
    # commit.
    verify_args=("${verify_args[@]}" --base "$base_rev" --at-record)
  fi
  if ! VERIFY_JSON="$( (cd -- "$proof_tree" && "$verifier" "${verify_args[@]}") 2>"$work/verify-stderr" )"; then
    cat "$work/verify-stderr" >&2
    RENDER_REFUSAL="cause=verify-refused verifier=$kind version=$verifier_version"
    # Offline verify's keyed source remedy names an absent recorded commit.
    # Its prose cannot distinguish an old mirror from a false record.
    if grep -Eq '(^|[[:space:];])verb=source operation=refresh([[:space:];]|$)' "$work/verify-stderr"; then
      RENDER_REFUSAL="cause=source-mirror-missing verb=source operation=refresh verifier=$kind version=$verifier_version"
    fi
    return 1
  fi
  # The document is the contract, its version first: a kendex printing
  # another shape under this flag, or none, is refused rather than read.
  if ! version="$(jq -r 'if type == "object" then (.version // "none" | tostring) else "none" end' \
    <<<"$VERIFY_JSON" 2>/dev/null)"; then
    version="none"
  fi
  if [ "$version" != "$VERIFY_DOCUMENT_VERSION" ]; then
    cat "$work/verify-stderr" >&2
    RENDER_REFUSAL="cause=verify-document-unreadable version=$version"
    return 1
  fi
  if ! counts="$(jq -r 'if ((.checked | type) == "number" and (.failed | type) == "number")
      then "\(.checked) \(.failed)" else empty end' <<<"$VERIFY_JSON" 2>/dev/null)" ||
    [ -z "$counts" ]; then
    cat "$work/verify-stderr" >&2
    RENDER_REFUSAL="cause=verify-document-unreadable version=$version"
    return 1
  fi
  checked="${counts%% *}"
  failed="${counts##* }"
  if [ "$checked" -eq 0 ]; then
    cat "$work/verify-stderr" >&2
    RENDER_REFUSAL="cause=verify-counted-nothing"
    return 1
  fi
  if [ "$failed" -ne 0 ]; then
    RENDER_REFUSAL="cause=verify-not-clean checked=$checked failed=$failed"
    return 1
  fi
  printf 'render-proof: checked=%s failed=%s\n' "$checked" "$failed" >&2
  # Each source commit the record trails, as the document names it. The
  # render was weighed at the record's commits, so this is the render's age,
  # never a refusal.
  if ! jq -r '.stale // [] | .[] | "render-stale: source=\(.source) recorded=\(.recorded) resolved=\(.resolved)"' \
    <<<"$VERIFY_JSON" >&2 2>/dev/null; then
    RENDER_REFUSAL="cause=verify-document-unreadable version=$version"
    return 1
  fi
}

# The counts say a run passed; the positions its passing rows printed say
# what it weighed. Each changed path has to be owned by one of them, read
# from the document and never from the row's kind or name: a file position
# owns exactly that path, a tree position owns every path under it, and a
# keys position — a shared registry file kendex writes entries in — owns the
# path only where the same row says the rest of that file is as the range's
# base held it. That last judgement is kendex's, made against its own edits;
# nothing here parses a settings file. The two bookkeeping files reach here
# like every other position, from the record and inventory rows, so no file
# the branch writes about itself is owned by name.
#
# Ownership is read only off rows in state ok. A failing row, a gap row, or
# a keys position without the foreign judgement owns nothing, and a changed
# path nothing owns refuses the class carrying the path.
#
# A deleted path has no row to be owned from: the head no longer renders it.
# Its owner is the base revision's install record, which kendex reads at that
# revision and prints as `base_owned`, whole files and trees only, so a shared
# registry file never appears there. The branch cannot rewrite that record.
# Whether PATH is a `file` there, or under a `tree`: exit 0 yes, 1 no or no
# field, any other status an unreadable document.
base_owned() { jq -e --arg path "$1" '(.base_owned // []) | any(.[]; .path as $owned | (.owns == "file" and $owned == $path) or (.owns == "tree" and ($owned == $path or ($path | startswith($owned + "/")))))' <<<"$VERIFY_JSON" >/dev/null 2>&1; }
#
# Every position a passing row printed, one per line: what it owns, the
# foreign judgement or `-`, and the path.
named_positions() { jq -r '.rows[] | select(.state == "ok") | .positions[] | [.owns, (.foreign // "-"), .path] | @tsv' <<<"$VERIFY_JSON"; }
# Without verifier ownership, the shared refresh caller needs release proof.
# Adoption accepts older shipped copies for replacement; this fallback judges
# the pinned release under ../SKILL.md § Shared refresh caller ownership.
RENDER_WORKFLOW_CHECKED=false
released_workflow_owned() { # PATH
  local pin history="$work/release-history" template=refresh/kendex-refresh.yml
  [ "$1" = "$HARNESS_CI_REFRESH_CALLER" ] || return 1
  RENDER_WORKFLOW_CHECKED=true
  [ -f "$proof_tree/$1" ] && [ ! -L "$proof_tree/$1" ] || return 1
  pin="$(sed -n 's|^    uses: vanillagreencom/kendex/\.github/workflows/refresh-consumer\.yml@\([^[:space:]]*\)$|\1|p' "$proof_tree/$1")" || return 1
  # Adoption ships version tags. A commit pin proves no release: the public
  # repository also serves commits from pull requests.
  grep -Eq '^v[0-9]+(\.[0-9]+){0,2}$' <<<"$pin" || return 1
  mkdir -p "$work/release-home" || return 1
  env -i PATH="$PATH" HOME="$work/release-home" SystemRoot="${SystemRoot:-}" \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 \
    git init -q --bare "$history" >"$work/release-stderr" 2>&1 || return 1
  env -i PATH="$PATH" HOME="$work/release-home" SystemRoot="${SystemRoot:-}" \
    GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_TERMINAL_PROMPT=0 \
    git -C "$history" fetch -q --depth=1 --no-tags \
      https://github.com/vanillagreencom/kendex.git "refs/tags/$pin" >>"$work/release-stderr" 2>&1 || {
        cat "$work/release-stderr" >&2; return 1;
      }
  git -C "$history" show "FETCH_HEAD:$template" >"$work/release-template" \
    2>>"$work/release-stderr" || return 1
  command -v python3 >/dev/null 2>&1 || return 1
  git -C "$history" show FETCH_HEAD:refresh/lib/caller.py >"$work/release-caller.py" \
    2>>"$work/release-stderr" || return 1
  python3 -I - "$work/release-caller.py" "$proof_tree/$1" "$work/release-template" <<'PY'
import importlib.util
import sys
from pathlib import Path

spec = importlib.util.spec_from_file_location("released_caller", sys.argv[1])
caller = importlib.util.module_from_spec(spec)
spec.loader.exec_module(caller)
head, template = (Path(path).read_bytes() for path in sys.argv[2:])
try:
    caller.configuration(head)
    sys.exit(0 if caller.normalized(head) == caller.normalized(template) else 1)
except caller.InvalidCaller:
    sys.exit(1)
PY
}
render_paths_covered() { # [narrow]
  local path owns foreign position owned partial head_entry inventory_status owned_status retired=""
  if ! named_positions >"$work/render-named" 2>/dev/null; then
    RENDER_REFUSAL="cause=verify-document-unreadable version=$VERIFY_DOCUMENT_VERSION"
    return 1
  fi
  # The count goes out ahead of the pass, so a refused run still says what
  # it weighed.
  printf 'render-coverage: named=%s\n' "$(grep -c '' "$work/render-named")" >&2
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    # Legacy verify can own engine positions, but cannot lift exclusions
    # outside the inventory. Release proof owns only the adopted caller.
    if [ "${1:-}" = narrow ] && [ "$RENDER_BOT_INSTRUCTIONS" = false ]; then
      change_class_path "$path" narrow
      if [ "$CHANGE_CLASS_PATH" = standard ]; then
        released_workflow_owned "$path" && continue
        render_refused_at "$path"
        RENDER_REFUSAL="cause=render-path-unowned path=$path"; RENDER_MEASURED=measured
        return 1
      fi
    fi
    if ! head_entry=$(git -C "$proof_tree" ls-tree --full-tree "$head_rev" -- "$path" 2>/dev/null); then
      RENDER_REFUSAL="cause=file-lookup-failed path=$path"
      return 1
    fi
    if [ -z "$head_entry" ]; then
      # harness-only already required this deleted file in the base's
      # inventory. Never use the branch's record to grant that ownership.
      # Head inventory absence is necessary, but does not prove the base
      # owned the whole file: its inventory includes shared keys and regions.
      # The base record's whole positions do.
      inventory_status=0
      jq -e --arg path "$path" \
        'all(.[]; (if type == "string" then . else .path end) != $path)' \
        "$proof_tree/.kendex-generated.json" >/dev/null 2>&1 || inventory_status=$?
      case "$inventory_status" in
        0)
          owned_status=0
          base_owned "$path" || owned_status=$?
          case "$owned_status" in
            0) continue ;;
            1) ;;
            *) RENDER_REFUSAL="cause=verify-document-unreadable version=$VERIFY_DOCUMENT_VERSION"; return 1 ;;
          esac
          # A retirement the base record does not name refuses the render
          # class once every later path is read: a refusal among them
          # answers instead.
          [ -n "$retired" ] || retired="cause=render-retirement-unproved path=$path"
          continue ;;
        1) ;;
        *) RENDER_REFUSAL="cause=unreadable-head-inventory head=$head_rev"; return 1 ;;
      esac
      render_refused_at "$path"
      RENDER_REFUSAL="cause=render-path-unowned path=$path"; RENDER_MEASURED=measured
      return 1
    fi
    owned=false
    partial=""
    while IFS="$TAB" read -r owns foreign position; do
      case "$owns" in
        file) [ "$path" = "$position" ] || continue; owned=true ;;
        tree) case "$path" in "$position" | "$position"/*) owned=true ;; *) continue ;; esac ;;
        keys)
          [ "$path" = "$position" ] || continue
          case "$foreign" in
            unchanged) owned=true ;;
            *) partial="$foreign" ;;
          esac ;;
        *) continue ;;
      esac
      [ "$owned" = false ] || break
    done <"$work/render-named"
    if [ "$owned" = true ]; then
      continue
    fi
    released_workflow_owned "$path" && continue
    render_refused_at "$path"
    if [ -n "$partial" ]; then
      RENDER_REFUSAL="cause=render-path-partial path=$path foreign=$partial"; RENDER_MEASURED=measured
      return 1
    fi
    RENDER_REFUSAL="cause=render-path-unowned path=$path"; RENDER_MEASURED=measured
    return 1
  done <<<"$changed"
  [ -n "$retired" ] || return 0
  # Every changed path read and none refused, so the retirement is standard
  # by rule.
  RENDER_REFUSAL="$retired"
  RENDER_MEASURED=measured
  return 1
}

# What the run said around a refused path, for the operator reading the
# log: verify's own rows, which a passing verify would otherwise leave in
# the scratch directory the exit trap removes, and every position printed
# under the refused path's top-level directory, one line each.
render_refused_at() { # PATH
  local top="${1%%/*}"
  cat "$work/verify-stderr" >&2
  awk -F "$TAB" -v top="$top" '
    $3 == top || index($3, top "/") == 1 {
      printf "render-position: owns=%s foreign=%s path=%s\n", $1, $2, $3
    }' "$work/render-named" >&2
}

# An ownership gain needs the same proof as existing generated files: the
# head inventory cannot grant the render class. Every changed path, gained
# paths included, must be owned by a passing verify row. A failed proof stays
# standard rather than reaching a size class.
if [ "$harness_verdict" = "harness_only=true" ] || [ "$harness_note" = "cause=generated-ownership-gain" ]; then
  renders_match && render_paths_covered &&
    answer render "cause=renders-match-their-sources"
  answer standard "$RENDER_REFUSAL" "$RENDER_MEASURED"
fi

! path_class_matches registry standard ||
  answer standard "cause=$CHANGE_CLASS_PATH_CAUSE" measured
! path_class_matches pointer standard ||
  answer standard "cause=$CHANGE_CLASS_PATH_CAUSE" measured

# The measurement's library, beside this script, and the render roots it
# pairs a mirror against. MEASURE_CAUSE names a failure. The library ships
# in this package at this script's own revision, so no contract number is
# checked here; its BRANCH_GROWTH_CONTRACT is for the callers in other
# packages that source it.
load_measurement() {
  if [ ! -r "$SCRIPT_DIR/lib/branch-growth.sh" ]; then
    MEASURE_CAUSE="cause=measurement-library-unreadable path=$SCRIPT_DIR/lib/branch-growth.sh"
    return 1
  fi
  # shellcheck source=lib/branch-growth.sh
  if ! . "$SCRIPT_DIR/lib/branch-growth.sh"; then
    MEASURE_CAUSE="cause=measurement-library-unreadable path=$SCRIPT_DIR/lib/branch-growth.sh"
    return 1
  fi
  base_settings || return 1
  branch_growth_render_roots_from_env
}

# In the size path, a names-only inventory change unlists only paths the diff
# deletes, which are measured themselves; the inventory leaves the path set
# before the list and the subsystem rule read it. A root outside
# the measurement's render roots, or roots this script cannot load, keep the
# inventory on the diff, where the list below refuses it. Any other change to
# it, a changed entry or an entry for a path that stays, keeps it there too.
case "$inventory_change" in
  names-only\ *\ roots=*)
    if names_only_roots_rendered "${inventory_change##* roots=}" load_measurement; then
      changed="$(awk '$0 != ".kendex-generated.json"' <<<"$changed")" ||
        answer standard "cause=path-set-unreadable"
    fi ;;
esac

change_class_path_load "$NARROW_CONF" || answer standard "cause=$CHANGE_CLASS_PATH_CAUSE"
if path_class_matches narrow standard; then
  narrow_refusal="$CHANGE_CLASS_PATH_CAUSE"
  # Package outputs outside the engine inventory can still be proved by
  # their trusted checker. Without full ownership the path rule stands.
  renders_match && render_paths_covered narrow &&
    answer render "cause=renders-match-their-sources"
  [ "$RENDER_WORKFLOW_CHECKED" = false ] || answer standard "$RENDER_REFUSAL" "$RENDER_MEASURED"
  answer standard "cause=$narrow_refusal" measured
fi

# Every measured class shares the branch growth reader in lib/, which owns
# the production/test split and the render-mirror and lock pairing.
# It is handed the base endpoint this call named, so the lines are counted
# over the range the paths came from.
production=""
total=""
measure() {
  # The two events that define a range these rules can be read over. A pull
  # request's base end is the merge base harness-only resolved; a merge
  # group's base is an ancestor of its head by construction, so the
  # three-dot range the size reader takes below is the same commits as the
  # two-dot one either way. Every other event names no such range and is
  # refused here rather than measured over one nobody defined.
  case "$event" in
    pull_request | merge_group) ;;
    *)
      MEASURE_CAUSE="cause=unsupported-event event=$event"
      return 1 ;;
  esac
  load_measurement || return 1
  # The base endpoint is this call's own and is non-empty here: harness-only
  # refuses a call without one before it reads a diff, and the empty-paths
  # branch above repeats that refusal as this script's answer. So the
  # base-branch resolver is never reached and no path to one is passed.
  if ! branch_size_classified "$repo" "" \
    "$head" "${ORCH_SIZE_TEST_PATHS:-}" "$base"; then
    MEASURE_CAUSE="cause=size-measurement-failed detail=$BRANCH_GROWTH_ERROR"
    return 1
  fi
  production="$BRANCH_SIZE_PRODUCTION"
  total="$BRANCH_SIZE_BASELINE"
}
measure || answer standard "$MEASURE_CAUSE"
if [ -n "$BRANCH_SIZE_PAIRED_LOCK_FILES" ]; then
  printf 'size: production=%s paired-lock=%s\n' "$production" "$BRANCH_SIZE_PAIRED_LOCK" >&2
fi

# harness-only owns the docs set. Use its non-doc paths for the subsystem
# rule as well as its verdict for trivial, without changing the measured size
# or the paths the refusal lists read.
docs_outside="$work/docs-outside"
docs_verdict="$("$HARNESS_ONLY" --mode docs "${harness_args[@]}" \
  --outside-output "$docs_outside" --output /dev/null 2>/dev/null)" || docs_verdict=unreadable
case "$docs_verdict" in
  docs_only=true | docs_only=false) ;;
  *) docs_verdict=unreadable ;;
esac

# An agent instruction file, an `instruction` line of the list, changes
# how every agent behaves, so it never answers below small, the lowest class
# the default review policy gives a bot round; CLAUDE.md is refused above by
# name. A diff that removes test protection, read by the measurement
# library's branch_protection_removed against the list's markers, never
# answers below small either: deleted lines cost nothing in the size rules,
# so its size alone would leave it unreviewed. That read is fail-closed, as
# the measurement is. Every trivial and micro answer goes through here.
instruction_file=""
! path_class_matches narrow small || instruction_file="$PATH_MATCH_HIT"
answer_narrow() { # CLASS FIELDS
  [ -z "$instruction_file" ] || answer small "cause=instruction-file $instruction_file measured-class=$1"
  branch_protection_removed "$repo" "$base" "$head" "$NARROW_CONF" ||
    answer standard "cause=protection-unreadable detail=$BRANCH_GROWTH_ERROR"
  [ -z "$BRANCH_PROTECTION_KIND" ] ||
    answer small "cause=protection-removed kind=$BRANCH_PROTECTION_KIND path=$BRANCH_PROTECTION_PATH removed=$BRANCH_PROTECTION_REMOVED added=$BRANCH_PROTECTION_ADDED measured-class=$1"
  answer "$1" "$2"
}

trivial_max="${HARNESS_CI_TRIVIAL_MAX_LINES:-20}"
case "$trivial_max" in
  '' | *[!0123456789]*)
    die "cause=invalid-setting setting=HARNESS_CI_TRIVIAL_MAX_LINES" \
      "HARNESS_CI_TRIVIAL_MAX_LINES must be a whole number" ;;
esac
# An admitted settings file is a member of the trivial set, and the rule
# below judges every other changed path. In the docs set, harness-only lists
# each admitted file outside it, which also shows its list was read.
# The ceiling bounds what a trivial diff can change unreviewed, and a
# documentation path can still be one the product reads — compiled into a
# binary, shipped as a template. Admitted settings bytes are only keys no CI
# job or gate reads, comments and blanks, so a diff of those files alone
# holds at any size; beside any other path the whole diff keeps the ceiling.
trivial_paths="$changed"
within_trivial=false
[ "$total" -gt "$trivial_max" ] || within_trivial=true
docs_trivial=false
[ "$docs_verdict" != "docs_only=true" ] || docs_trivial=true
settings_cause=""
if [ -n "$SETTINGS_ADMITTED" ]; then
  trivial_paths=""
  while IFS= read -r path; do
    case $'\n'"$SETTINGS_FILES"$'\n' in
      *$'\n'"$path"$'\n'*) ;;
      *) trivial_paths="$trivial_paths$path"$'\n' ;;
    esac
  done <<<"$changed"
  [ -n "$trivial_paths" ] || within_trivial=true
  if [ "$docs_verdict" = docs_only=false ] &&
    outside="$(LC_ALL=C sort -u -- "$docs_outside")" && [ "$outside" = "$SETTINGS_FILES" ]; then
    docs_trivial=true
  fi
  settings_cause="$SETTINGS_CAUSE $SETTINGS_ADMITTED"
fi
[ -z "$BRANCH_SIZE_PAIRED_LOCK_FILES" ] || within_trivial=false
if [ -n "${HARNESS_CI_TRIVIAL_PATHS:-}" ]; then
  if [ "$within_trivial" = true ]; then
    set_globs "$HARNESS_CI_TRIVIAL_PATHS"
    path_matches every "$trivial_paths" &&
      answer_narrow trivial "${settings_cause:-cause=allowlisted-paths} lines=$total"
  fi
else
  # The shipped allowlist is that mode's own path set, read from its verdict.
  if [ "$docs_trivial" = true ] && [ "$within_trivial" = true ]; then
    answer_narrow trivial "${settings_cause:-cause=documentation-paths} lines=$total"
  fi
fi

micro_max=""
small_max=""
if ! { micro_max="$(ceiling micro_max_production)" &&
  small_max="$(ceiling small_max_production)" &&
  [ -n "$micro_max" ] && [ -n "$small_max" ]; }; then
  answer standard "cause=narrow-change-ceilings-missing"
fi

if [ -z "$BRANCH_SIZE_PAIRED_LOCK_FILES" ] && [ "$production" -le "$micro_max" ]; then
  answer_narrow micro "cause=production-within-micro production=$production"
fi

# Micro needs only the independent size proof above, not docs membership.
# Small needs completed docs discovery. harness-only emits false with an
# empty outside list on a read failure, not only on a valid path judgement.
case "$docs_verdict" in
  docs_only=true | docs_only=false) ;;
  *) answer standard "cause=documentation-paths-unreadable" ;;
esac
non_docs="$(cat -- "$docs_outside")" || answer standard "cause=documentation-paths-unreadable"
if [ "$docs_verdict" = docs_only=false ] && [ -z "$non_docs" ]; then
  answer standard "cause=documentation-paths-unreadable"
fi
non_docs=$'\n'"$non_docs"$'\n'

# The render roots are the measurement's own list, so a source and the render
# mirroring it reduce to one subsystem. A path the measurement counted as a
# test or paired lock is left out using the measurement's path lists.
# Documentation is left out using harness-only's set, not another path rule.
set_globs "$BRANCH_GROWTH_RENDER_ROOTS"
render_roots=("${GLOB_LIST[@]}")
subsystem=""
one_subsystem=true
excluded_files=$'\n'"$BRANCH_SIZE_TEST_FILES"$'\n'"$BRANCH_SIZE_PAIRED_LOCK_FILES"$'\n'
while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$non_docs" in *$'\n'"$path"$'\n'*) ;; *) continue ;; esac
  case "$excluded_files" in *$'\n'"$path"$'\n'*) continue ;; esac
  for root in ${render_roots[@]+"${render_roots[@]}"}; do
    case "$path" in "$root"/*) path="${path#"$root"/}"; break ;; esac
  done
  top="${path%%/*}"
  if [ -z "$subsystem" ]; then
    subsystem="$top"
  elif [ "$subsystem" != "$top" ]; then
    one_subsystem=false
    break
  fi
done <<<"$changed"

[ "$one_subsystem" = true ] ||
  answer standard "cause=several-subsystems production=$production" measured
[ "$production" -gt "$small_max" ] ||
  answer small "cause=production-within-small subsystem=$subsystem"
answer standard "cause=production-past-small production=$production" measured
