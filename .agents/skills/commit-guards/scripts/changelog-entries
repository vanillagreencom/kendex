#!/usr/bin/env bash
# changelog-entries — validates changelog fragments and combines them at release.
#
# FRAGMENTS (COMMIT_GUARDS_CHANGELOG_PATHS, default changelog.d/*/*.md). One
# entry per file, so two branches never write the same line. Each matched
# path must be a real text file (a symlink, a gitlink or a binary blob is
# refused, not skipped), sit directly under a Keep a Changelog section
# directory and hold exactly one Markdown list item. The shape is the whole
# rule: an entry has no character, line or byte limit, so one that states its
# outcome passes however long it runs or however it is wrapped.
#
# Ordinary checks judge fragments, configured JSON version bumps and package
# versions. Which fragments and record sections are a bump's release
# entries, in each mode, and what each bump level refuses among them is
# ../CHECKS.md § Version bumps; this file implements that rule rather than
# restating it.
#
# --collate is that write, and the release commit is its only caller: on a
# clean verdict it folds the fragments this run just accepted into the
# record's [Unreleased] section and deletes them (lib/changelog-collate.sh).
# In this process, off this run's answers, so the sections, the fragment set
# and the record's boundaries have one spelling rather than a collator's
# second one that agrees until it does not.
#
# Content comes from the index, like the other scans. Text that is not valid
# UTF-8 is a collection error naming the line, never a fragment the collator
# folds into the record: git calls such a blob text whenever it carries no
# NUL. Configured paths matching no tracked file are a clean pass: a
# repository with no changelog has nothing to judge.
#
# Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
set -euo pipefail
# Pathname expansion off: the configured paths are globs, and splitting them
# into words would otherwise expand each against the work tree — matching
# whatever happens to be checked out instead of the tracked paths the scan
# judges, and matching nothing at all in a sparse or bare checkout.
set -f

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The trailing newline from `pwd` terminates its output; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="changelog-entries"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"
# shellcheck source=lib/changelog-grammar.sh
source "$SCRIPT_DIR/lib/changelog-grammar.sh"
# shellcheck source=lib/changelog-record-scope.sh
source "$SCRIPT_DIR/lib/changelog-record-scope.sh"
# shellcheck source=lib/changelog-collate.sh
source "$SCRIPT_DIR/lib/changelog-collate.sh"
# A package file's version is its SKILL.md frontmatter's.
# shellcheck source=lib/skill-roots.sh
source "$SCRIPT_DIR/lib/skill-roots.sh"
# A staged run compares against the commit's parent, which an amend moves.
# shellcheck source=lib/commit-parent.sh
source "$SCRIPT_DIR/lib/commit-parent.sh"
# The --collate lane rewrites the record in place.
# shellcheck source=lib/atomic-install.sh
source "$SCRIPT_DIR/lib/atomic-install.sh"

# The sections a fragment's directory may name, and the test for membership
# in them, are lib/changelog-grammar.sh's GG_SECTIONS and gg_is_section: the
# collator writes each fragment beneath the heading its directory names, and
# has nowhere to put one that names no section.

usage() {
  gg_message usage changelog-entries 'Available options follow.'
  cat <<'EOF'
usage: changelog-entries [--collate | --staged | --base REF | --against REF]
       changelog-entries --classify PATH...

Checks changelog fragments. --collate also validates its destination.

Fragments (COMMIT_GUARDS_CHANGELOG_PATHS): every matched tracked path must
be a real text file, sit directly under a section directory (added, changed,
deprecated, removed, fixed, security) and hold exactly one Markdown list item:
the first non-blank line opens with a hyphen and a space and says something,
and every later line indents under it. An entry has no length limit. A
symlink, a submodule gitlink or a binary blob at a configured path is refused.

Ordinary runs read the record only as evidence for a configured version bump.
COMMIT_GUARDS_CHANGELOG_VERSION_PATHS selects JSON files with a string version,
and each increased version is judged against its release's entries. Which
fragments and record sections count as those entries in each mode, and what a
major, minor or patch increase refuses among them, is the commit-guards
skill's CHECKS.md, section Version bumps. A minor or patch refusal names the
first offending entry.
COMMIT_GUARDS_CHANGELOG_PACKAGE_PATHS selects package files, each at its
glob's own depth and one per name: a SKILL.md names its directory and
versions it by its frontmatter metadata.version; any other file names itself,
less its extension, and carries no version. A fragment a pattern places through its package slot, <root>/*/<section>/<name>,
is that package's entry and never the program's, and must name a declared
package. A change under a versioned package's directory must raise its
version, judged against the package fragments the same change adds.
The default compares the commit's parent to the index, the parent CHECKS.md,
section Version bumps, defines; --base compares HEAD's merge base with REF to
the index; --against compares REF itself to the index. Fragments always come
from the index. A first version has no prior version to increase.

A tracked path under a fragment root that the globs do not cover is refused
too — it is a fragment nothing would ever fold in. A root is a pattern's
leading run of glob-free directories (changelog.d/*/*.md roots at
changelog.d); a pattern carrying no glob at all names one file and roots
nowhere, and a README.md directly under a root documents the format rather
than being an entry.

--collate judges, and on a clean verdict folds every accepted fragment into
the record's [Unreleased] section under the heading its own section names, a
package's under its own heading in the section's Packages part, then deletes
the fragment files and the section directory each leaves empty.
The release caller must set COMMIT_GUARDS_CHANGELOG_COLLATE=1. It refuses,
writing nothing, when the index or working tree has staged, unstaged or non-ignored untracked changes.
Collate before changing release files; commit or restore pending edits first.
The record is replaced whole or not at all.

Tracked content is read from the index; text that is not valid UTF-8 is a
collection error. Paths matching no tracked file are a clean pass.

Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  COMMIT_GUARDS_CHANGELOG_PATHS   space-separated shell globs against the
                                  full repo-relative path, '*' crossing
                                  '/' as in the excludes lists
                                  (default changelog.d/*/*.md)
  COMMIT_GUARDS_CHANGELOG_RECORD  the collated record file
                                  (default CHANGELOG.md; empty = no record
                                  scope)
  COMMIT_GUARDS_CHANGELOG_VERSION_PATHS  JSON version-file globs
                                  (default empty = no version check)
  COMMIT_GUARDS_CHANGELOG_PACKAGE_PATHS  package-file globs
                                  (default empty = no package check)

COMMIT_GUARDS_CHANGELOG_COLLATE=1 authorizes --collate and lets commit-msg
count the release record as its required changelog change. Ordinary fragment
validation does not require it.

--classify judges nothing and reads no fragment: it prints, for each PATH in
argument order, one line of what these settings make it, a tab, then the path:
  record    the configured record, or the CHANGELOG.md a package.json version
            file reads its entries from
  fragment  a path COMMIT_GUARDS_CHANGELOG_PATHS matches
  version   a JSON version file COMMIT_GUARDS_CHANGELOG_VERSION_PATHS selects
  package   a package file COMMIT_GUARDS_CHANGELOG_PACKAGE_PATHS declares
  render    a path the staged render inventory, .kendex-generated.json, lists
  none      anything else
The first that applies wins. orch's restack-skip asks it which lines of a
conflicted file are version lines and changelog entries.

Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
EOF
}

COLLATE=0
CLASSIFY=0
CLASSIFY_PATHS=()
MODE=staged
BASE_REF=""
SCOPE_FLAGS=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --collate) COLLATE=1 ;;
    --classify)
      shift
      [ $# -ge 1 ] || gg_fail argument-missing --classify "--classify requires at least one path"
      CLASSIFY=1
      CLASSIFY_PATHS=("$@")
      break
      ;;
    --staged) MODE=staged; SCOPE_FLAGS=$((SCOPE_FLAGS + 1)) ;;
    --base | --against)
      [ $# -ge 2 ] || gg_fail argument-missing "$1" "$1 requires a ref"
      MODE="${1#--}"
      shift
      BASE_REF="$1"
      SCOPE_FLAGS=$((SCOPE_FLAGS + 1))
      ;;
    *) gg_fail argument "$(gg_shown "$1")" "unknown argument $(gg_shown "$1") (see --help)" ;;
  esac
  shift
done
[ "$SCOPE_FLAGS" -le 1 ] && { [ "$COLLATE" -eq 0 ] || [ "$SCOPE_FLAGS" -eq 0 ]; } \
  && { [ "$CLASSIFY" -eq 0 ] || [ $((SCOPE_FLAGS + COLLATE)) -eq 0 ]; } \
  || gg_fail scope-conflict "$SCOPE_FLAGS:$COLLATE:$CLASSIFY" "Use one scope, --collate or --classify, not two."

gg_repo_root_cd

# Both scopes, resolved by the library the commit-msg lane reads too — which
# loads the fragment globs through lib/configured-paths.sh, the same way
# every lane scoped by a path list does.
gg_changelog_scopes || exit 2
PATTERNS="$GG_CHANGELOG_PATTERNS"
PATTERNS_SHOWN="$GG_CHANGELOG_SHOWN"
RECORD="$GG_CHANGELOG_RECORD"

# Release manifests already expose their version through jq. Opt-in discovery
# keeps this catalog lane independent of any repo layout.
version_paths="$(gg_setting COMMIT_GUARDS_CHANGELOG_VERSION_PATHS "")" || exit 2
version_paths="$(gg_config_path_list "$version_paths" changelog-version)" || exit 2

version_selected() { # PATH — 0 when COMMIT_GUARDS_CHANGELOG_VERSION_PATHS selects it
  local pattern
  for pattern in $version_paths; do
    # shellcheck disable=SC2254 # the configured glob is the pattern
    case "$1" in $pattern) return 0 ;; esac
  done
  return 1
}

# A package.json beside the configured record is the app's version file,
# judged like any other; elsewhere it is a package with its own record.
package_record_of() { # VERSION_FILE — that package's CHANGELOG.md on stdout; 1 where it reads the configured record
  local version_dir=. record_dir=.
  case "$1" in */*) version_dir="${1%/*}" ;; esac
  case "$RECORD" in */*) record_dir="${RECORD%/*}" ;; esac
  [ "${1##*/}" = package.json ] && { [ -z "$RECORD" ] || [ "$version_dir" != "$record_dir" ]; } || return 1
  printf '%s' "${1%package.json}CHANGELOG.md"
}

if [ "$CLASSIFY" -eq 1 ]; then
  gg_load_render_inventory
  for f in "${CLASSIFY_PATHS[@]}"; do
    kind=none
    package_json="${f%CHANGELOG.md}package.json"
    # shellcheck disable=SC2086 # the configured package globs are the patterns
    if [ -n "$RECORD" ] && [ "$f" = "$RECORD" ]; then
      kind=record
    elif [ "${f##*/}" = CHANGELOG.md ] && version_selected "$package_json" \
      && package_record="$(package_record_of "$package_json")" && [ "$package_record" = "$f" ]; then
      kind=record
    elif gg_matches_path_glob "$f"; then
      kind=fragment
    elif version_selected "$f"; then
      kind=version
    elif gg_path_placer "$f" $GG_CHANGELOG_PACKAGES; then
      kind=package
    elif generated_path_contains "$f"; then
      kind=render
    fi
    printf '%s\t%s\n' "$kind" "$f"
  done
  exit 0
fi

gg_tmpdir
# Every accepted fragment in index order, four NUL-terminated fields a row:
# its section, its package (empty for a program entry), its blob and its
# path. What --collate folds in and what it guards against an unstaged edit.
# A file and not a variable, because a shell variable cannot hold the NUL that
# lets a path carrying a newline survive.
: >"$GG_TMP/frags.z"

checked=0
violations=0
RECORD_SHA=""
RECORD_MODE=""
# The accepted fragments' release entries, "KIND<TAB>first line" rows from
# GG_UNRELEASED_AWK's entry query, in index order.
: >"$GG_TMP/fragment-entries"

refuse() { # KEY VALUE EXPLANATION [REMEDY]
  gg_message "$1" "$2" "$3"
  [ $# -lt 4 ] || printf '  %s\n' "$4"
  violations=$((violations + 1))
}

# The records and the glob match are the family's walk in spirit, but not its
# shape: lib/configured-paths.sh counts a symlink, a gitlink or a binary blob
# as unmeasured and reads on, and a fragment tree cannot afford that — a path
# nothing measures is one the collator would fold in verbatim. Every one of
# them is a violation here.
# ls-files -s emits one record per STAGE for an unmerged path, so the walk
# below would read rival blobs as separate files.
gg_require_merged_index
git ls-files -sz >"$GG_TMP/files.z" 2>"$GG_TMP/dependency.err" \
  || gg_fail_cause index-read "$?" "$GG_TMP/dependency.err" "git ls-files failed"
gg_package_files

while IFS= read -r -d '' rec; do
  # Record shape: "<mode> <sha> <stage>\t<path>".
  f="${rec#*"$GG_TAB"}"
  mode="${rec%% *}"
  rest="${rec#* }"
  sha="${rest%% *}"
  if [ -n "$RECORD" ] && [ "$f" = "$RECORD" ]; then
    RECORD_SHA="$sha"
    RECORD_MODE="$mode"
  fi
  # What is NOT a fragment is settled before anything asks whether a pattern
  # reaches it, or the answer turns on which pattern shape produced the root.
  # A README directly under a root documents the format; the configured
  # record is the file fragments are folded INTO, and a root drawn around it
  # does not make it a stray in its own tree. Neither is judged as a fragment
  # and neither is swept.
  exempt=0
  if [ -n "$RECORD" ] && [ "$f" = "$RECORD" ]; then
    exempt=1
  else
    for root in $GG_PATH_ROOTS; do
      case "$f" in
        "$root"/README.md)
          exempt=1
          break
          ;;
      esac
    done
  fi
  [ "$exempt" -eq 0 ] || continue

  if ! gg_matches_path_glob "$f"; then
    under=0
    for root in $GG_PATH_ROOTS; do
      case "$f" in
        "$root"/*)
          under=1
          break
          ;;
      esac
    done
    [ "$under" -eq 1 ] || continue
    refuse fragment-stray "$(gg_shown "$f")" "is in the fragment tree but is not a fragment" "a fragment matches one of: $PATTERNS_SHOWN"
    continue
  fi
  case "$mode" in
    120000)
      refuse fragment-symlink "$(gg_shown "$f")" "is tracked as a symlink" "a fragment is a file of its own"
      continue
      ;;
    160000)
      refuse fragment-gitlink "$(gg_shown "$f")" "is tracked as a submodule gitlink" "a fragment is a file of its own"
      continue
      ;;
  esac
  # Which section a fragment belongs to is the configured pattern's answer,
  # in lib/configured-paths.sh: the pattern's own last two segments say where
  # the section sits, so a path at another depth is not one that pattern
  # places. Deriving a depth here as well is how a rule and a root come to
  # disagree.
  gg_path_glob_section "$f"
  sec="$GG_PATH_SECTION"
  if [ -z "$sec" ] || ! gg_is_section "$sec"; then
    refuse fragment-section "$(gg_shown "$f")" "names no section" "a fragment sits where its pattern places it, <section>/<name> at that pattern's own depth — section one of: $GG_SECTIONS"
    continue
  fi
  # The one path into a changelog blob, in lib/changelog-grammar.sh: it reads
  # the bytes and proves them text this family can fold. Binary is the only
  # answer left to phrase, and a fragment nothing can read is refused.
  if ! gg_changelog_blob "$sha" "$f"; then
    refuse fragment-binary "$(gg_shown "$f")" "holds binary content" "a fragment is the Markdown list item it becomes"
    continue
  fi
  shape="$(LC_ALL=C awk "$GG_SHAPE_AWK" <"$GG_TMP/blob")" \
    || gg_fail fragment-shape-read "$(gg_shown "$f")" "could not read the shape of $(gg_shown "$f")"
  if [ -n "$shape" ]; then
    case "$shape" in
      empty) refuse fragment-empty "$(gg_shown "$f")" "A fragment must contain a list item with text." ;;
      marker) refuse fragment-marker "$(gg_shown "$f")" "A fragment must open with a hyphen and a space." ;;
      continuation) refuse fragment-continuation "$(gg_shown "$f")" "Every line after the first must indent under the list item." ;;
      *) gg_fail fragment-shape "$(gg_shown "$f"):$shape" "The fragment grammar returned an unknown shape." ;;
    esac
    continue
  fi
  # A package's entry is its own release's, judged against its own version
  # below; the program's version reads the program's entries alone.
  gg_fragment_package "$f"
  if [ -n "$GG_FRAGMENT_PACKAGE" ] && ! gg_package_row "$GG_FRAGMENT_PACKAGE"; then
    refuse fragment-package "$(gg_shown "${f%/*/*}")" "names no package" "a package fragment's directory is the name of a package file's package: $(gg_scrubbed "$GG_CHANGELOG_PACKAGES")"
    continue
  fi
  checked=$((checked + 1))
  printf '%s\0%s\0%s\0%s\0' "$sec" "$GG_FRAGMENT_PACKAGE" "$sha" "$f" >>"$GG_TMP/frags.z"
  [ -z "$GG_FRAGMENT_PACKAGE" ] || continue
  LC_ALL=C awk -v entry_query=1 -v whole_entry=1 -v entry_section="$sec" "$GG_UNRELEASED_AWK" <"$GG_TMP/blob" >>"$GG_TMP/fragment-entries" \
    || gg_fail breaking-read "$(gg_shown "$f")" "Could not read the release entry."
done <"$GG_TMP/files.z"

read_version() { # SHA PATH -> version, refusing unreadable or malformed manifests
  gg_read_blob "$1" "$2" version
  jq -er --arg re "$GG_VERSION_RE" '.version | select(type == "string") | select(test($re))' \
    "$GG_TMP/blob" 2>"$GG_TMP/dependency.err" \
    || gg_fail_cause version-read "$(gg_shown "$2")" "$GG_TMP/dependency.err" "Expected a JSON string version in major.minor.patch form."
}

record_entries() { # PATH LEVEL VERSION — adds the release's entry rows to $GG_TMP/evidence
  local path="$1" level="$2" version="$3" rec mode rest sha status=0 kind
  # Reuse the completed index discovery; an absent record is no evidence,
  # whereas a record that cannot be read is a collection error.
  while IFS= read -r -d '' rec; do
    [ "${rec#*"$GG_TAB"}" = "$path" ] || continue
    mode="${rec%% *}"; rest="${rec#* }"; sha="${rest%% *}"
    gg_mode_is_regular "$mode" || gg_fail version-record-mode "$(gg_shown "$path"):$mode" "Release evidence must be a regular text file."
    gg_changelog_blob "$sha" "$path" || gg_fail version-record-binary "$(gg_shown "$path")" "Release evidence must be text."
    LC_ALL=C awk -v entry_query=1 -v release_level="$level" -v release_version="$version" -v release_alone="$RELEASE_ALONE" \
      -v packages_part="$GG_PACKAGES_PART" "$GG_UNRELEASED_AWK" <"$GG_TMP/blob" >"$GG_TMP/record-entries" || status=$?
    [ "$status" -ne 3 ] || gg_fail version-record-fence "$(gg_shown "$path")" "An unclosed code fence prevents reading the release section."
    [ "$status" -eq 0 ] || gg_fail breaking-read "$(gg_shown "$path"):$status" "The changelog grammar failed (awk exit $status)."
    # A released row is the release's own section answering alone: the
    # pending fragments gathered before it wait for the next release.
    IFS="$GG_TAB" read -r kind _ <"$GG_TMP/record-entries" || kind=""
    if [ "$kind" = released ]; then
      mv -- "$GG_TMP/record-entries" "$GG_TMP/evidence"
    else
      cat -- "$GG_TMP/record-entries" >>"$GG_TMP/evidence"
    fi \
      || gg_fail evidence-copy "$(gg_shown "$path")" "Could not collect the record entries."
    return 0
  done <"$GG_TMP/files.z"
}

first_entry() { # KIND — the first evidence row of KIND on stdout; 1 when none
  local kind text
  while IFS="$GG_TAB" read -r kind text; do
    [ "$kind" = "$1" ] || continue
    printf '%s' "$text"
    return 0
  done <"$GG_TMP/evidence"
  return 1
}

refuse_entry() { # KIND KEY VALUE EXPLANATION REMEDY — refuses when the evidence holds a KIND entry
  local entry
  entry="$(first_entry "$1")" || return 0
  gg_message "$2" "$3" "$4"
  gg_message entry-preview "$entry" "The first such entry in this release."
  printf '  %s\n' "$5"
  violations=$((violations + 1))
}

# Sets BUMP to the increase from OLD to NEW, major, minor, patch or none;
# 0 when the release standard judges it, whose compatibility rules start at
# 1.0.
release_bump() { # OLD NEW PATH
  # Decimal strings avoid shell integer overflow and jq number rounding;
  # the suffixes come off first, so a suffix change alone is no increase.
  if ! BUMP="$(jq -nr --arg old "$1" --arg new "$2" '
    def nums: sub("[-+].*$"; "") | split(".") | map([length, .]);
    ($old | nums) as $o | ($new | nums) as $n
    | first(range(3) | select($n[.] != $o[.]) | if $n[.] > $o[.] then ["major", "minor", "patch"][.] else "none" end) // "none"
  ' 2>"$GG_TMP/dependency.err")"; then
    gg_fail_cause version-compare "$(gg_shown "$3")" "$GG_TMP/dependency.err" "Could not compare the versions."
  fi
  case "$BUMP" in
    major) ;;
    minor | patch) [ "${1%%.*}" != 0 ] ;;
    none) return 1 ;;
    *) gg_fail version-compare "$(gg_shown "$3"):$BUMP" "The version comparison returned an unknown increase." ;;
  esac
}

judge_release() { # VALUE — refuses what BUMP's level forbids among $GG_TMP/evidence
  case "$BUMP" in
    major)
      first_entry breaking >/dev/null || refuse major-breaking "$1" \
        "A major increase needs a Breaking entry naming the break." \
        "Write - **Breaking:** with the break and migration note in this release's changelog."
      ;;
    minor)
      refuse_entry breaking minor-breaking "$1" "A minor release holds no Breaking entry." "$breaking_remedy"
      ;;
    patch)
      refuse_entry added patch-added "$1" "A patch release adds no new capability, and this one adds." "Release the addition as a minor."
      refuse_entry breaking patch-breaking "$1" "A patch release breaks nothing, and this one breaks." "$breaking_remedy"
      ;;
  esac
}

# A package's release entries: the accepted fragments naming it that this
# diff adds, since the package releases with the change itself; a fragment
# an earlier change added was that release's.
package_entries() { # NAME — fills $GG_TMP/evidence
  local sec pkg sha f meta g
  : >"$GG_TMP/evidence"
  while IFS= read -r -d '' sec && IFS= read -r -d '' pkg && IFS= read -r -d '' sha && IFS= read -r -d '' f; do
    [ "$pkg" = "$1" ] || continue
    while IFS= read -r -d '' meta && IFS= read -r -d '' g; do
      [ "$g" = "$f" ] || continue
      [ "${meta##* }" = A ] || break
      { gg_changelog_blob "$sha" "$f" \
        && LC_ALL=C awk -v entry_query=1 -v whole_entry=1 -v entry_section="$sec" "$GG_UNRELEASED_AWK" <"$GG_TMP/blob" >>"$GG_TMP/evidence"; } \
        || gg_fail breaking-read "$(gg_shown "$f")" "Could not read the release entry."
      break
    done <"$GG_TMP/changes.z"
  done <"$GG_TMP/frags.z"
}

breaking_remedy="Release the break as a major, or keep the old form working and hold the Breaking entry for a later major."
if [ -n "$version_paths" ] || [ -n "$GG_CHANGELOG_PACKAGES" ]; then
  diff_args=(--cached)
  # --against REF can name a branch's tip from before a restack past a
  # release, so that release's bump reaches the comparison beside the
  # branch's pending fragments. Its own record section alone judges it there.
  RELEASE_ALONE=0
  case "$MODE" in
    staged)
      gg_commit_base
      [ -z "$GG_COMMIT_BASE" ] || diff_args+=("$GG_COMMIT_BASE")
      ;;
    base)
      base="$(git merge-base -- "$BASE_REF" HEAD 2>"$GG_TMP/dependency.err")" \
        || gg_fail_cause version-base "$(gg_shown "$BASE_REF")" "$GG_TMP/dependency.err" "Could not find the version comparison's merge base."
      diff_args+=("$base")
      ;;
    against)
      base="$(git rev-parse --verify --end-of-options "$BASE_REF^{commit}" 2>"$GG_TMP/dependency.err")" \
        || gg_fail_cause version-base "$(gg_shown "$BASE_REF")" "$GG_TMP/dependency.err" "The version comparison ref must name a commit."
      diff_args+=("$base")
      RELEASE_ALONE=1
      ;;
  esac
  git diff "${diff_args[@]}" --raw --no-abbrev -z --no-renames -- >"$GG_TMP/changes.z" 2>"$GG_TMP/dependency.err" \
    || gg_fail_cause version-diff "$?" "$GG_TMP/dependency.err" "Could not collect version changes."
fi

if [ -n "$version_paths" ]; then
  while IFS= read -r -d '' meta && IFS= read -r -d '' f; do
    version_selected "$f" || continue
    # --raw emits srcmode dstmode srcsha dstsha status, followed by the path.
    read -r srcmode dstmode srcsha dstsha status <<<"${meta#:}"
    [ "$status" != D ] || continue
    gg_mode_is_regular "$dstmode" || gg_fail version-mode "$(gg_shown "$f"):$dstmode" "A configured version file must be a regular JSON file."
    new="$(read_version "$dstsha" "$f")" || exit 2
    [ "$srcmode" != 000000 ] || continue
    gg_mode_is_regular "$srcmode" || gg_fail version-mode "$(gg_shown "$f"):$srcmode" "The prior version file must be regular JSON."
    old="$(read_version "$srcsha" "$f")" || exit 2
    release_bump "$old" "$new" "$f" || continue
    if package_record="$(package_record_of "$f")"; then
      : >"$GG_TMP/evidence"
      record_entries "$package_record" 3 "$new"
    else
      cp -- "$GG_TMP/fragment-entries" "$GG_TMP/evidence" \
        || gg_fail evidence-copy "$(gg_shown "$f")" "Could not collect the fragment entries."
      if [ -n "$RECORD" ] && { [ "$BUMP" != major ] || ! first_entry breaking >/dev/null; }; then
        record_entries "$RECORD" 2 "$new"
      fi
    fi
    judge_release "$(gg_shown "$f"):$old:$new"
  done <"$GG_TMP/changes.z"
fi

# Each change to a versioned package's directory raises the version its
# package file states, by the same rule against the package's own entries.
if [ -n "$GG_CHANGELOG_PACKAGES" ]; then
  while IFS= read -r -d '' name && IFS= read -r -d '' dir && IFS= read -r -d '' mode \
    && IFS= read -r -d '' sha && IFS= read -r -d '' pf; do
    [ -n "$dir" ] || continue
    changed=0
    pf_meta=""
    while IFS= read -r -d '' meta && IFS= read -r -d '' f; do
      case "$f" in "$dir"*) changed=1 ;; *) continue ;; esac
      [ "$f" != "$pf" ] || pf_meta="$meta"
    done <"$GG_TMP/changes.z"
    [ "$changed" -eq 1 ] || continue
    new="$(gg_package_version "$mode" "$sha" "$pf")" || exit 2
    old="$new"
    if [ -n "$pf_meta" ]; then
      read -r srcmode _ srcsha _ <<<"${pf_meta#:}"
      # A new package has no prior version to raise.
      [ "$srcmode" != 000000 ] || continue
      old="$(gg_package_version "$srcmode" "$srcsha" "$pf")" || exit 2
    fi
    if ! release_bump "$old" "$new" "$pf"; then
      [ "$BUMP" != none ] || refuse package-unbumped "$(gg_shown "$pf"):$old" "A change to this package must raise its version." \
        "Raise metadata.version by the release-version rule: a Breaking entry is a major, a new capability or setting a minor, anything else a patch."
      continue
    fi
    package_entries "$name"
    judge_release "$(gg_shown "$pf"):$old:$new"
  done <"$GG_TMP/packages.z"
fi

# The release operation reads the destination only when it has entries to fold.
if [ "$COLLATE" -eq 1 ] && [ "$checked" -gt 0 ]; then
  gg_changelog_record_scope
fi

if [ "$violations" -gt 0 ]; then
  gg_message violations "$violations:$checked" "Violations and accepted fragments."
  exit 1
fi
# Only past the verdict: the fold must never publish a set this run was still
# going to refuse something from. Its own line is the verdict a release
# reads — what was folded in and where — so it stands in for the checked
# report below rather than following it.
if [ "$COLLATE" -eq 1 ]; then
  gg_changelog_collate
  exit 0
fi
if [ "$checked" -eq 0 ]; then
  gg_message no-matches "$PATTERNS_SHOWN" "No tracked file matches COMMIT_GUARDS_CHANGELOG_PATHS."
  exit 0
fi
gg_message checked "$checked" "Every fragment is one list item under a section."
