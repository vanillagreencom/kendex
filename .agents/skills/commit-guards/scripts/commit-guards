#!/usr/bin/env bash
# commit-guards — dispatcher for the check family:
#
#   commit-guards [all]            run every check named by COMMIT_GUARDS_CHECKS
#                                  over the whole tree
#   commit-guards [all] --staged   the same batch at commit scope
#   commit-guards [all] --base REF the same batch over the changes since REF
#   commit-guards [all] --against REF   the same batch over what those changes
#                                  would do to REF's own tree
#   commit-guards CHECK [ARGS..]   run one check, flags passed through
#
# --skip-unscoped withholds the checks the run's scope leaves nothing for,
# rather than folding a clean count over content they never opened. A check is
# that only when this run hands it no scope AND its own bare default would
# open no file: a lane given --base or --against has a scope and runs.
#
# commit-msg reads a message, so it never runs in the batch — the commit-msg
# hook invokes it directly. Batch aggregation fails closed: exit 2 if ANY
# check could not complete, else 1 if any found violations, else 0.
set -euo pipefail

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The trailing newline from `pwd` terminates its output; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="commit-guards"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"
# The owner of COMMIT_GUARDS_MD_SCOPE's meaning, for --skip-unscoped below.
# Sourcing it defines gg_md_bare_scope and two constants and does nothing
# else; the selecting helpers it also defines go unused here.
# shellcheck source=lib/md-scope.sh
source "$SCRIPT_DIR/lib/md-scope.sh"

KNOWN_CHECKS="todo-ban byte-ceiling suppression-ban conflict-markers changelog-entries prose md-format md-refs comments commit-msg"
BATCH_DEFAULT="todo-ban byte-ceiling suppression-ban conflict-markers changelog-entries prose md-format md-refs"
# The checks the batch hands --staged when it is asked for commit scope.
# todo-ban and comments default to the whole index, which is a CI subject:
# at commit each judges what the commit adds. md-format judges touched
# documents; md-refs checks every configured document for broken incoming
# references. The rest read the index by design.
STAGED_SCOPED_CHECKS="todo-ban byte-ceiling md-format md-refs comments"
# byte-ceiling is the one batch lane whose bare default is the commit scope,
# so the full batch names its scope outright: --all with no flag. A batch
# summary that listed it clean over a scope it never read would be a verdict
# about nothing.
FULL_SCOPED_CHECKS="byte-ceiling"
# The lanes a ref-range scope reaches. byte-ceiling is scoped to a range by
# design and takes one under every setting: it is ratcheted, so a range is the
# question it was written to answer. A markdown lane takes one only where its
# configured scope is `touched`, which selects from the staged diff and so
# opens no file at a caller that stages nothing; the range is what gives it a
# document a replay carried in. Under COMMIT_GUARDS_MD_SCOPE=all its
# configured scope is the whole-tree sweep, which is WIDER than any range, and
# scope_for hands it that sweep instead — a range there would answer a smaller
# question under the setting's name.
RANGE_SCOPED_CHECKS="byte-ceiling md-format md-refs"

usage() {
  gg_message usage "$GG_CHECK" "Command usage follows."
  cat <<EOF
usage: commit-guards [all] [--staged | --base REF | --against REF]
                     [--skip-unscoped] | CHECK [ARGS...]

Checks: $KNOWN_CHECKS

With no argument (or 'all'), runs every check named by
COMMIT_GUARDS_CHECKS (default: $BATCH_DEFAULT) over the whole tree:
$FULL_SCOPED_CHECKS gets --all, the rest read the index by design.
--base REF hands $RANGE_SCOPED_CHECKS --base REF instead (CI on a PR), and
--against REF hands them --against REF (what the change does to REF's tree).
--staged is passed to: $STAGED_SCOPED_CHECKS.
--skip-unscoped is for a caller whose scope stages nothing: it withholds every
check that would then open no file, naming each one. That is a check this run
hands no scope whose configured scope selects from the staged diff; one given
a range, and one configured to sweep the tree, opens files and runs. It is a
contradiction under --staged, which is the scope those checks read.
Those checks apply their own commit scope. md-refs checks all configured
documents for broken references, including unchanged callers.
commit-msg reads a message file/stdin and only runs by name.

Exit codes: 0 clean; 1 violations; 2 usage/config/collection error, or
any check that could not complete.
EOF
}

SCOPE_MODE="all"
BASE_REF=""
SKIP_UNSCOPED=0
if [ $# -ge 1 ]; then
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    all | --staged | --base | --base=* | --against | --against=* | --skip-unscoped) ;;
    *)
      CHECK="$1"
      shift
      case " $KNOWN_CHECKS " in
        *" $CHECK "*) exec "$SCRIPT_DIR/$CHECK" "$@" ;;
      esac
      gg_fail check-unknown "$CHECK" "unknown check '$CHECK' (known: $KNOWN_CHECKS)"
      ;;
  esac
fi

if [ "${1-}" = all ]; then shift; fi
SCOPE_FLAGS=0
while [ $# -gt 0 ]; do
  case "$1" in
    # Not a scope: it says which checks the scope can reach, so it does not
    # count toward the one-scope rule below.
    --skip-unscoped)
      SKIP_UNSCOPED=1
      shift
      continue
      ;;
    --staged) SCOPE_MODE="staged" ;;
    --base)
      [ $# -ge 2 ] || gg_fail argument-missing "--base" "--base requires a ref"
      shift
      SCOPE_MODE="base"
      BASE_REF="$1"
      ;;
    --base=*)
      SCOPE_MODE="base"
      BASE_REF="${1#--base=}"
      ;;
    --against)
      [ $# -ge 2 ] || gg_fail argument-missing "--against" "--against requires a ref"
      shift
      SCOPE_MODE="against"
      BASE_REF="$1"
      ;;
    --against=*)
      SCOPE_MODE="against"
      BASE_REF="${1#--against=}"
      ;;
    *) gg_fail argument-unknown "$1" "'all' takes only --staged, --base REF, --against REF or --skip-unscoped; invoke a single check to pass flags" ;;
  esac
  SCOPE_FLAGS=$((SCOPE_FLAGS + 1))
  shift
done
[ "$SCOPE_FLAGS" -le 1 ] || gg_fail scope-conflict "$SCOPE_FLAGS" "--staged, --base and --against name different scopes; pass one"
[ "$SKIP_UNSCOPED" -eq 0 ] || [ "$SCOPE_MODE" != "staged" ] \
  || gg_fail scope-contradiction "--staged,--skip-unscoped" "--staged IS the scope those checks read, so nothing is unscoped under it"

gg_repo_root_cd
CHECKS="$(gg_setting COMMIT_GUARDS_CHECKS "$BATCH_DEFAULT")" || exit 2
case "$CHECKS" in
  *[!\ ]*) ;;
  *) gg_fail checks-empty "COMMIT_GUARDS_CHECKS" "COMMIT_GUARDS_CHECKS resolved empty — name at least one check or unset it" ;;
esac
for c in $CHECKS; do
  case "$c" in
    commit-msg) gg_fail check-interactive "commit-msg" "commit-msg reads a message and cannot run in the batch; wire 'commit-guards commit-msg \"\$1\"' into the commit-msg hook instead" ;;
  esac
  case " $KNOWN_CHECKS " in
    *" $c "*) ;;
    *) gg_fail check-unknown "$c" "COMMIT_GUARDS_CHECKS names unknown check '$c' (known: $KNOWN_CHECKS)" ;;
  esac
done

# A check whose CONFIGURED scope selects from the staged diff reads nothing
# at all under a caller that stages nothing: it reports a count of zero and a
# clean verdict over content it never opened, which is the verdict about
# nothing this dispatcher exists not to give. A caller that knows its scope
# stages nothing asks for those to be withheld; each is named here, and the
# verdict record below lists only the checks that ran.
#
# Two questions, and neither answers the other. WHICH checks take their bare
# scope from the shared markdown selector is asked of each check's own script,
# rather than listed here, so a lane that starts deferring to it later cannot
# slip past either decision below in silence. WHAT that selector would resolve
# to is asked of the selector itself, because deferring to it says where the
# answer comes from and not what it is.
#
# Both decisions read both answers. A lane is withheld only where its bare
# scope opens no file, and handed a RANGE only where a range is not narrower
# than the scope the project configured — under `all` it is, and the sweep
# wins.
MD_SELECTOR="lib/md-scope.sh"

defers_to_md_selector() { # CHECK — 0 when the check takes its bare scope from the selector
  local status=0
  grep -q -- "$MD_SELECTOR" "$SCRIPT_DIR/$1" || status=$?
  [ "$status" -le 1 ] \
    || gg_fail selector-read "$1:$status" "could not read $1 to see how it resolves its scope; refusing to guess"
  return "$status"
}

# What a bare run of such a lane resolves to, resolved once on FIRST NEED and
# kept, so both decisions below read one value and cannot disagree.
#
# Lazily, and that is the point rather than an optimization: gg_md_bare_scope
# refuses an invalid COMMIT_GUARDS_MD_SCOPE, and a run that never needed the
# answer must not start refusing on a setting it would never have read. A
# --staged batch is exactly that — those lanes are handed --staged and
# gg_md_scope returns before it reaches the setting — so resolving here
# unconditionally would make a bad value block commits that pass today.
# gg_md_bare_scope answers touched or all and exits otherwise, so an empty
# value is unasked and nothing else.
MD_BARE_SCOPE=""
md_bare_scope() { # -> the answer in MD_BARE_SCOPE
  [ -z "$MD_BARE_SCOPE" ] || return 0
  gg_md_bare_scope MD_BARE_SCOPE
}

# The scope this run hands ONE check, in SCOPE. Read by the withholding pass
# and by the run loop, so the two cannot disagree about what a check was
# given. Bash 3.2: an empty array expands guarded at every use.
SCOPE=()
scope_for() { # CHECK
  SCOPE=()
  case "$SCOPE_MODE" in
    staged)
      case " $STAGED_SCOPED_CHECKS " in *" $1 "*) SCOPE=(--staged) ;; esac
      return 0
      ;;
    all)
      case " $FULL_SCOPED_CHECKS " in *" $1 "*) SCOPE=(--all) ;; esac
      return 0
      ;;
  esac
  case " $RANGE_SCOPED_CHECKS " in
    *" $1 "*) ;;
    *) return 0 ;;
  esac
  # A range is NARROWER than the whole-tree sweep. A lane whose CONFIGURED
  # scope is that sweep must therefore never be handed one: the project chose
  # an absolute scope, and answering a smaller question under its name is a
  # refusal turning into a pass — a document already over the format rules,
  # untouched by the range, reads clean. The sweep is handed over explicitly
  # rather than left for the lane's own default to rediscover, so the batch's
  # step line names the scope the lane actually read and this function stays
  # an honest answer to what the run gives a check.
  #
  # byte-ceiling is unaffected either way: it does not defer to the selector,
  # it is ratcheted, and a range is the question it was written to answer.
  if defers_to_md_selector "$1"; then
    md_bare_scope
    if [ "$MD_BARE_SCOPE" = all ]; then
      SCOPE=(--all)
      return 0
    fi
  fi
  case "$SCOPE_MODE" in
    base) SCOPE=(--base "$BASE_REF") ;;
    against) SCOPE=(--against "$BASE_REF") ;;
  esac
}

if [ "$SKIP_UNSCOPED" -eq 1 ]; then
  # Resolved up front under this flag, rather than left to first need: an
  # invalid value is refused in the selector, and withholding a lane before it
  # runs means its own validation never fires. Under `all` the lane sweeps the
  # tree and needs nothing staged, so this caller reaches it perfectly well
  # and withholding it would drop a check the project explicitly asked for.
  md_bare_scope
fi
if [ "$SKIP_UNSCOPED" -eq 1 ] && [ "$MD_BARE_SCOPE" = touched ]; then
  KEPT=""
  WITHHELD=""
  for c in $CHECKS; do
    scope_for "$c"
    if [ "${#SCOPE[@]}" -ne 0 ]; then
      KEPT="${KEPT:+$KEPT }$c"
      continue
    fi
    if defers_to_md_selector "$c"; then
      WITHHELD="${WITHHELD:+$WITHHELD }$c"
      gg_message unscoped "$c" "This check selects its files from the staged diff under the configured scope, and this run was told nothing is staged, so it would open no file. Withheld rather than counted clean."
      continue
    fi
    KEPT="${KEPT:+$KEPT }$c"
  done
  CHECKS="$KEPT"
  case "$CHECKS" in
    *[!\ ]*) ;;
    *)
      gg_message withheld-all "$WITHHELD" "Every enabled check selects its files from the staged diff under the configured scope, so this run has nothing for any of them to open."
      exit 0
      ;;
  esac
fi

had_violations=0
had_errors=0
for c in $CHECKS; do
  scope_desc=""
  scope_for "$c"
  [ "${#SCOPE[@]}" -eq 0 ] || scope_desc=" ${SCOPE[*]}"
  gg_message step "$c$scope_desc" "Run the configured check."
  check_status=0
  "$SCRIPT_DIR/$c" ${SCOPE[@]+"${SCOPE[@]}"} || check_status=$?
  case "$check_status" in
    0) ;;
    1) had_violations=1 ;;
    *)
      had_errors=1
      gg_message incomplete "$c:$check_status" "The check did not complete."
      ;;
  esac
done

if [ "$had_errors" -eq 1 ]; then
  gg_message result 2 "Could not complete every check. Fix the errors above."
  exit 2
fi
if [ "$had_violations" -eq 1 ]; then
  gg_message result 1 "Violations found. See the failures above."
  exit 1
fi
gg_message result "0:$CHECKS" "Enabled checks are clean."
