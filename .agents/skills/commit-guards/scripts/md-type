#!/usr/bin/env bash
# md-type — fails a Markdown file the block parser cannot end, and classifies
# a path by docs-writing's route table for the reminder hook and docs-audit.
#
# The lane parses every selected file with lib/md-blocks.awk, the grammar
# md-refs and md-reflow read by, and fails one that leaves a fence, front
# matter, an HTML block or a prompt-section block open. A reader cannot read
# such a file past that line:
#
#   - CommonMark 0.31.2 § 4.5 and § 4.6 run an unclosed fence or HTML block
#     to the end of the document: a renderer shows the rest as code, and a
#     browser hides the rest behind an unclosed `<!--`.
#   - md-refs judges no reference in a file the parser cannot end and names
#     it unjudged, leaving this lane as the gate, so a dead reference past
#     the construct goes unreported.
#
# The lane reads no docs-writing file. --route and --as read the route table
# in docs-writing's SKILL.md as data: it classifies a path and names its
# type's reference and example. --as prints a file's words beside its type's
# example document, a signal that never changes the exit status.
#
#   md-type [--staged | --base REF | --against REF | --all]   the lane
#   md-type --route PATH                 classify PATH for the reminder hook
#   md-type [--root REPO] --as PATH FILE...   size FILE as PATH, for docs-audit
#
# Exit codes: 0 clean; 1 an unended file; 2 usage, collection error, or a
# rules gap under --as or --route.
set -euo pipefail
# Pathname expansion off: path globs are matched against repository paths,
# never against the work tree.
set -f

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The trailing newline from `pwd` terminates its output; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="md-type"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"
# shellcheck source=lib/md-scope.sh
source "$SCRIPT_DIR/lib/md-scope.sh"
# shellcheck source=lib/siblings.sh
source "$SCRIPT_DIR/lib/siblings.sh"

PATHS_DEFAULT="*.md"
BLOCKS_AWK="$SCRIPT_DIR/lib/md-blocks.awk"
SHAPES_AWK="$SCRIPT_DIR/lib/md-shapes.awk"
TYPE_AWK="$SCRIPT_DIR/lib/md-type.awk"

usage() {
  gg_message usage md-type "Command usage follows."
  cat <<EOF
usage: md-type [--staged | --base REF | --against REF | --all]
       md-type --route PATH
       md-type [--root REPO] --as PATH FILE [--as PATH FILE]...

Parses each selected Markdown file and fails one the block parser cannot
end: a fence, front matter, an HTML block or a prompt-section block left
open, which a renderer and md-refs cannot read past.

--staged, --base REF, --against REF and --all select the files in
COMMIT_GUARDS_MD_PATHS minus COMMIT_GUARDS_MD_EXCLUDES; with none of them
COMMIT_GUARDS_MD_SCOPE decides. These modes read no docs-writing file.
--route PATH prints the type, reference and example the route table in
docs-writing's SKILL.md gives PATH, or route=ignored, route=outside-repo or
route=unclassified.
--as PATH FILE parses FILE, - for stdin, as repository path PATH and prints
its words beside its type's example document as a signal; each --as pair is
read in order with the route table read once, and judged=N follows the lines
of the Nth. --root names the repository whose installed docs-writing to read
first.

Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  COMMIT_GUARDS_MD_PATHS      space-separated shell globs against the full
                              repo-relative path (default $PATHS_DEFAULT)
  COMMIT_GUARDS_MD_EXCLUDES   exclusion list, pattern<TAB>reason per line
                              (default $GG_MD_EXCLUDES_DEFAULT)
  COMMIT_GUARDS_MD_SCOPE      touched | all (default $GG_MD_SCOPE_DEFAULT)

Exit codes: 0 clean; 1 an unended file; 2 usage, collection error, or a
rules gap under --as or --route.
EOF
}

MODE=lane
GG_MD_MODE=""
STAGED=0
ALL=0
ROUTE_PATH=""
AS_PATHS=()
AS_FILES=()
AS_ROOT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --staged)
      gg_md_name_scope --staged
      STAGED=1
      ;;
    --all)
      gg_md_name_scope --all
      ALL=1
      ;;
    --base)
      [ $# -ge 2 ] || gg_fail argument-missing "--base" "--base requires a ref"
      shift
      gg_md_name_range base "$1"
      ;;
    --base=*) gg_md_name_range base "${1#--base=}" ;;
    --against)
      [ $# -ge 2 ] || gg_fail argument-missing "--against" "--against requires a ref"
      shift
      gg_md_name_range against "$1"
      ;;
    --against=*) gg_md_name_range against "${1#--against=}" ;;
    --route)
      [ $# -ge 2 ] || gg_fail argument-missing "--route" "--route requires a path"
      shift
      MODE=route
      ROUTE_PATH="$1"
      ;;
    --as)
      [ $# -ge 3 ] || gg_fail argument-missing "--as" "--as takes a repository path and a file, - for stdin."
      MODE=as
      AS_PATHS+=("$2")
      AS_FILES+=("$3")
      shift 2
      ;;
    --root)
      [ $# -ge 2 ] || gg_fail argument-missing "--root" "--root requires a directory"
      shift
      AS_ROOT="$1"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) gg_fail argument "$1" "Unknown argument. See --help." ;;
  esac
  shift
done

if [ "$MODE" != lane ]; then
  [ -z "$GG_MD_NAMED" ] || gg_fail mode-conflict "$MODE" "--route and --as take no scope flag."
  [ -n "$ROUTE_PATH" ] && [ "${#AS_PATHS[@]}" -gt 0 ] && gg_fail mode-conflict "route,as" "Pass --route or --as, not both."
fi
[ "$MODE" = as ] || [ -z "$AS_ROOT" ] || gg_fail argument "--root" "--root belongs to --as."

for program in "$BLOCKS_AWK" "$SHAPES_AWK" "$TYPE_AWK"; do
  [ -r "$program" ] || gg_fail dependency "$program" "Reinstall the commit-guards skill to restore this file."
done

# The route table, loaded once by load_rules. RULES is ok, missing or
# unreadable; a gap carries RULES_DETECTOR and RULES_FILE. Rows are parallel
# arrays in route-table order, first match wins.
RULES=missing
RULES_DETECTOR=""
RULES_FILE=""
RULES_RETIRED=""
DW=""
ROW_TYPE=()
ROW_GLOBS=()
ROW_REF=()
ROW_EXAMPLE=()
ROW_EXAMPLE_WORDS=()

normalize() { # SRC DST — CRLF line ends normalized, not judged
  LC_ALL=C awk '{ sub(/\r$/, ""); print }' "$1" >"$2" 2>"$GG_TMP/normalize.err" \
    || gg_fail_cause normalize "$1" "$GG_TMP/normalize.err" "Could not read the file."
}

rules_gap() { # DETECTOR FILE
  RULES=unreadable
  RULES_DETECTOR="$1"
  RULES_FILE="$2"
}

load_rules() { # DOCS-WRITING-DIR, or empty when none was found
  local kind line type globs ref example n=0 i readme=0 linked=0
  if [ -z "$1" ] || [ ! -f "$1/SKILL.md" ]; then
    RULES=missing
    return 0
  fi
  # Physical, so a copy found beside this script is named without `..`.
  DW="$(cd -- "$1" && pwd -P; printf x)" || gg_fail docs-writing-resolve "$1" "The docs-writing directory cannot be resolved."
  DW="${DW%x}"
  DW="${DW%$'\n'}"
  normalize "$DW/SKILL.md" "$GG_TMP/skill.md"
  md_lines "$GG_TMP/skill.md" SKILL.md "$GG_TMP/skill.lines" quiet || { rules_gap unended SKILL.md; return 0; }
  LC_ALL=C awk -f "$SHAPES_AWK" -f "$TYPE_AWK" -v mode=rules -- "$GG_TMP/skill.lines" >"$GG_TMP/rules.tsv" 2>"$GG_TMP/rules.err" \
    || gg_fail_cause rules-parse "$DW/SKILL.md" "$GG_TMP/rules.err" "The route table reader failed."
  while IFS="$GG_TAB" read -r kind line type globs ref example; do
    case "$kind" in
      U)
        rules_gap "$line" SKILL.md
        return 0
        ;;
      R) ;;
      W)
        RULES_RETIRED="$line"
        continue
        ;;
      *) gg_fail rules-record "$kind" "The route table reader returned an unknown record." ;;
    esac
    # An empty cell arrives as "-": a tab IFS merges adjacent tabs.
    [ "$globs" != - ] || globs=""
    [ "$ref" != - ] || ref=""
    [ "$example" != - ] || example=""
    ROW_TYPE[n]="$type"
    ROW_GLOBS[n]="$globs"
    ROW_REF[n]="$ref"
    ROW_EXAMPLE[n]="$example"
    ROW_EXAMPLE_WORDS[n]=""
    n=$((n + 1))
  done <"$GG_TMP/rules.tsv"
  i=0
  while [ "$i" -lt "$n" ]; do
    for ref in "${ROW_REF[i]}" "${ROW_EXAMPLE[i]}"; do
      [ -z "$ref" ] || [ -f "$DW/$ref" ] || { rules_gap link "$ref"; return 0; }
    done
    if [ -n "${ROW_REF[i]}" ] && [ -n "${ROW_EXAMPLE[i]}" ]; then linked=1; fi
    i=$((i + 1))
  done
  # The discovery floor: a table that classifies no README, or routes no type
  # to both a reference and an example, is a broken read, never an empty one.
  classify README.md && readme=1
  [ "$readme" -eq 1 ] && [ "$linked" -eq 1 ] || { rules_gap floor SKILL.md; return 0; }
  RULES=ok
  # The retired route table with a Shape column still reads until the next
  # major release, under kendex's release compatibility standard: a repository
  # whose docs-writing render predates the three-column table keeps its route
  # and its size signal. On stderr, so --route's stdout carries only the
  # route lines CHECKS.md documents.
  [ -z "$RULES_RETIRED" ] \
    || gg_message warning "route-table-shape path=$DW/SKILL.md:$RULES_RETIRED" "The route table's Shape column is retired and not read. The table is Path | Section | Example; refresh docs-writing." >&2
}

# The words of DOC, counted from its LINES stream, into WORDS.
WORDS=""
count_words() { # DOC LINES
  WORDS="$(LC_ALL=C awk -f "$SHAPES_AWK" -f "$TYPE_AWK" -v mode=words -- "$1" "$2" 2>"$GG_TMP/words.err")" \
    || gg_fail_cause words "$1" "$GG_TMP/words.err" "The word counter failed."
}

# The words of row ROW's example document, read once per row on the first
# file of that type; 1 after recording the gap when the parser cannot end it.
example_words() {
  [ -z "${ROW_EXAMPLE_WORDS[ROW]}" ] || return 0
  normalize "$DW/${ROW_EXAMPLE[ROW]}" "$GG_TMP/example.md"
  LC_ALL=C awk -f "$SHAPES_AWK" -f "$TYPE_AWK" -v mode=example -- "$GG_TMP/example.md" >"$GG_TMP/example-doc.md" \
    || gg_fail example-read "${ROW_EXAMPLE[ROW]}" "The example reader failed."
  # The example's words are counted the way a sized file's are: from the
  # lines stream of its document.
  if ! md_lines "$GG_TMP/example-doc.md" "${ROW_EXAMPLE[ROW]}" "$GG_TMP/example.lines" quiet; then
    rules_gap example "${ROW_EXAMPLE[ROW]}"
    return 1
  fi
  count_words "$MD_DOC" "$GG_TMP/example.lines"
  ROW_EXAMPLE_WORDS[ROW]="$WORDS"
}

# The first route row whose glob matches PATH, `*` crossing `/`. Sets ROW.
ROW=-1
classify() { # PATH — 1 when no row matches
  local i=0 glob
  while [ "$i" -lt "${#ROW_TYPE[@]}" ]; do
    for glob in ${ROW_GLOBS[i]}; do
      # shellcheck disable=SC2254 # the route glob is the pattern
      case "$1" in $glob)
        ROW="$i"
        return 0
        ;;
      esac
    done
    i=$((i + 1))
  done
  ROW=-1
  return 1
}

shown_rule() { # ROOT FILE — a docs-writing file as the reader finds it
  local root="$1"
  case "$DW/$2" in
    "$root"/*) printf '%s' "${DW#"$root"/}/$2" ;;
    *) printf '%s' "$DW/$2" ;;
  esac
}

# md-blocks' line stream for DOC into OUT, and the document it read in
# MD_DOC. CRLF line ends are normalized, not judged: a CRLF refusal reruns
# the parser over an LF copy beside DOC, which is always under $GG_TMP. 1,
# after naming the construct, when the parser cannot end the file; QUIET
# names nothing.
MD_DOC=""
md_lines() { # DOC PATH OUT [quiet]
  local status=0 refusal="" row
  MD_DOC="$1"
  while :; do
    status=0
    LC_ALL=C awk -f "$SHAPES_AWK" -f "$BLOCKS_AWK" -v mode=lines -- "$MD_DOC" >"$3" 2>"$GG_TMP/lines.err" || status=$?
    [ "$status" -ne 0 ] || return 0
    refusal=""
    while IFS= read -r row; do
      case "$row" in R"$GG_TAB"*) refusal="$row"; break ;; esac
    done <"$3"
    [ -n "$refusal" ] \
      || gg_fail_cause block-exit "$2:$status" "$GG_TMP/lines.err" "The Markdown parser exited without a refusal record."
    refusal="${refusal#R"$GG_TAB"}"
    case "$refusal" in
      *"$GG_TAB"crlf)
        if [ "$MD_DOC" = "$1" ]; then
          normalize "$1" "$1.lf"
          MD_DOC="$1.lf"
          continue
        fi
        ;;
    esac
    break
  done
  [ "${4-}" != quiet ] || return 1
  gg_md_block_message "${refusal#*"$GG_TAB"}" "$2" "${refusal%%"$GG_TAB"*}"
  gg_message "$GG_MD_RULE" "$GG_MD_DETAIL" "$GG_MD_EXPLANATION The rest of the file cannot be read."
  return 1
}

# The docs-writing that classifies repository ROOT: the sibling every lane
# resolves, asked from ROOT, so ROOT's own install outranks this copy's. Run
# in gg_path's subshell, which keeps the cd.
docs_writing_from() { # ROOT
  cd -- "$1" && gg_resolve_sibling "$SCRIPT_DIR" docs-writing
}

# The work tree holding DIR into VAR; 1 when DIR is in no repository. Outside
# one only where no .git entry stands above DIR: a repository git refuses to
# read, or a git that cannot run, fails with git's message, never reads as no
# repository.
repo_top() { # VAR DIR
  local at="$2"
  gg_path "$1" git -C "$2" -c core.fsmonitor=false rev-parse --show-toplevel 2>"$GG_TMP/top.err" && return 0
  while :; do
    [ ! -e "$at/.git" ] || gg_fail_cause route-repo "$at" "$GG_TMP/top.err" "Git could not read the repository holding this path."
    [ "$at" != / ] || return 1
    at="${at%/*}"
    [ -n "$at" ] || at=/
  done
}

# --- --route ------------------------------------------------------------------
if [ "$MODE" = route ]; then
  gg_tmpdir
  case "$ROUTE_PATH" in /*) target="$ROUTE_PATH" ;; *) target="$PWD/$ROUTE_PATH" ;; esac
  name="${target##*/}"
  parent="${target%/*}"
  [ -n "$parent" ] || parent=/
  tail=""
  while [ ! -d "$parent" ]; do
    tail="/${parent##*/}$tail"
    parent="${parent%/*}"
    [ -n "$parent" ] || parent=/
  done
  parent="$(cd -- "$parent" && pwd -P; printf x)" || gg_fail route-path "$ROUTE_PATH" "The path's directory cannot be resolved."
  parent="${parent%x}"
  parent="${parent%$'\n'}"
  top=""
  if ! repo_top top "$parent"; then
    printf 'md-type: route=outside-repo\n'
    exit 0
  fi
  physical="${parent%/}$tail/$name"
  case "$physical" in
    "$top"/*) rel="${physical#"$top"/}" ;;
    *)
      printf 'md-type: route=outside-repo\n'
      exit 0
      ;;
  esac
  status=0
  git -C "$top" -c core.fsmonitor=false check-ignore -q -- "$rel" 2>"$GG_TMP/ignore.err" || status=$?
  case "$status" in
    0)
      printf 'md-type: route=ignored\n'
      exit 0
      ;;
    1) ;;
    *) gg_fail_cause route-ignore "$rel" "$GG_TMP/ignore.err" "git check-ignore could not answer." ;;
  esac
  gg_path found docs_writing_from "$top" || found=""
  load_rules "$found"
  case "$RULES" in
    missing)
      printf 'md-type: gap=docs-writing-missing\n'
      exit 2
      ;;
    unreadable)
      printf 'md-type: rules=unreadable detector=%s path=%s\n' "$RULES_DETECTOR" "$DW/$RULES_FILE"
      exit 2
      ;;
  esac
  if ! classify "$rel"; then
    printf 'md-type: route=unclassified\nmd-type: skill=%s\n' "$DW/SKILL.md"
    exit 0
  fi
  printf 'md-type: type=%s\n' "${ROW_TYPE[ROW]}"
  if [ -n "${ROW_REF[ROW]}" ]; then
    printf 'md-type: reference=%s\n' "$DW/${ROW_REF[ROW]}"
  else
    printf 'md-type: reference=%s\n' "$DW/SKILL.md"
  fi
  [ -z "${ROW_EXAMPLE[ROW]}" ] || printf 'md-type: example=%s\n' "$DW/${ROW_EXAMPLE[ROW]}"
  exit 0
fi

# --- --as ---------------------------------------------------------------------
if [ "$MODE" = as ]; then
  gg_tmpdir
  root="$AS_ROOT"
  if [ -z "$root" ]; then
    repo_top root "$PWD" || root="$PWD"
  fi
  gg_path found docs_writing_from "$root" || found=""
  load_rules "$found"
  case "$RULES" in
    missing)
      gg_message gap docs-writing-missing "No installed docs-writing skill holds the route table, so the file was not sized."
      exit 2
      ;;
    unreadable)
      gg_message rules "unreadable detector=$RULES_DETECTOR path=$DW/$RULES_FILE" "The installed docs-writing does not meet the route-table contract, so the file was not sized."
      exit 2
      ;;
  esac
  unended=0
  stdin_read=0
  i=0
  while [ "$i" -lt "${#AS_PATHS[@]}" ]; do
    path="${AS_PATHS[i]}"
    file="${AS_FILES[i]}"
    i=$((i + 1))
    # A copy under $GG_TMP, so the CRLF rerun's LF copy never lands beside
    # the caller's file.
    if [ "$file" = - ]; then
      [ "$stdin_read" -eq 0 ] || gg_fail argument "-" "Only one --as file can be stdin."
      stdin_read=1
      cat >"$GG_TMP/as.md" || gg_fail stdin-read "-" "Could not read the file from stdin."
    else
      cat -- "$file" >"$GG_TMP/as.md" 2>"$GG_TMP/as.err" || gg_fail_cause as-read "$file" "$GG_TMP/as.err" "Could not read the file."
    fi
    if md_lines "$GG_TMP/as.md" "$path" "$GG_TMP/lines"; then
      if classify "$path" && [ -n "${ROW_EXAMPLE[ROW]}" ]; then
        doc="$MD_DOC"
        if ! example_words; then
          gg_message rules "unreadable detector=$RULES_DETECTOR path=$DW/$RULES_FILE" "The installed docs-writing does not meet the route-table contract, so the file was not sized."
          exit 2
        fi
        count_words "$doc" "$GG_TMP/lines"
        gg_message signal "size path=$path type=${ROW_TYPE[ROW]} words=$WORDS example_words=${ROW_EXAMPLE_WORDS[ROW]} example=$(shown_rule "$root" "${ROW_EXAMPLE[ROW]}")" "The file's words beside its type's example document: a signal, never a verdict."
      fi
    else
      unended=$((unended + 1))
    fi
    # docs-audit reads this line to tell one document's lines from the next.
    gg_message judged "$i" "The lines above belong to --as pair $i."
  done
  [ "$unended" -eq 0 ] || exit 1
  exit 0
fi

# --- the lane -----------------------------------------------------------------
gg_repo_root_cd
gg_md_load_paths md-type COMMIT_GUARDS_MD_PATHS "$PATHS_DEFAULT"
# Every move is parsed at its new path, an unchanged move included: a file
# moved unedited from outside COMMIT_GUARDS_MD_PATHS arrives as Markdown no
# lane has parsed, and the exact walk drops that move.
GG_MD_RENAMES=off
gg_md_scope md-type "$STAGED" "$ALL"
[ "$GG_MD_MODE" != none ] || exit 0

# A render is not judged: its source is, and a local edit to a render is
# overwritten. The inventory is read at the first path a walk selects.
GG_RENDER_INVENTORY=deferred
gg_tmpdir
gg_md_select markdown
skipped="$GG_WALK_SKIPPED"

if [ "$GG_MD_COUNT" -eq 0 ]; then
  if [ "$skipped" -eq 0 ]; then
    gg_message no-match "$GG_MD_MODE:$GG_PATH_GLOBS_SHOWN" "No selected Markdown files match the configured paths."
  else
    gg_message unmeasured-count "$skipped" "No selected paths could be measured."
  fi
  exit 0
fi

unended=0
while IFS= read -r -d '' sha && IFS= read -r -d '' f && IFS= read -r -d '' _source; do
  gg_read_blob "$sha" "$f" "markdown file"
  md_lines "$GG_TMP/blob" "$f" "$GG_TMP/lines" || unended=$((unended + 1))
done <"$GG_TMP/md-files.z"

gg_message summary "unended=$unended files=$GG_MD_COUNT scope=$GG_MD_MODE skipped=$skipped" "The Markdown parse is complete."
gg_inventory_verdict "$unended"
