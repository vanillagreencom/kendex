#!/usr/bin/env bash
# suppression-ban — two gates over lint suppression in tracked files:
#
# 1. BLANKET suppressions fail flat (no baseline): the file- or module-wide
#    pragmas that turn a linter off wholesale. A PER-LINE suppression that
#    names its lint and states its reason stays legal.
# 2. BARE ALLOW RATCHET (rust): reasonless dead_code/unused allow attributes
#    are counted per file against a tighten-only baseline TSV
#    (path<TAB>count). Rows only go down or away; --update lowers and removes
#    but never adds or raises, so growth is a visible hand-edit in review.
#
# Scans INDEX content, language-scoped by pathspec, so documentation and
# scripts that QUOTE these pragmas never fire. Exit codes: 0 clean;
# 1 violations; 2 usage/config/collection error.
set -euo pipefail

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The trailing newline from `pwd` terminates its output; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="suppression-ban"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"
# The --update lane rewrites the baseline in place.
# shellcheck source=lib/atomic-install.sh
source "$SCRIPT_DIR/lib/atomic-install.sh"

usage() {
  gg_message usage "$GG_CHECK" "Command usage follows."
  cat <<'EOF'
usage: suppression-ban [--update] [--baseline FILE] [--excludes FILE]

Blanket lint suppressions (module-wide rust allow, file-level noqa, bare
eslint-disable, bare/`all` nolint, biome-ignore-all, unscoped
biome-ignore-start, and rule-less `biome-ignore lint` forms) fail flat. Bare rust allow(dead_code)/
allow(unused*) attributes are counted per file against a tighten-only
baseline; --update lowers/removes rows to current reality (never adds,
never raises) and then re-checks.

Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  COMMIT_GUARDS_SUPPRESSION_BASELINE   baseline path        (default tools/suppression-baseline.tsv)
  COMMIT_GUARDS_SUPPRESSION_EXCLUDES   exclusion-list path  (default tools/suppression-ban-excludes)
Flags override both for the path settings.
Generated files are excluded by exact path from .kendex-generated.json.
The inventory is required and reads from the index when tracked.

Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
EOF
}

MODE="check"
BASELINE_OPT=""
EXCLUDES_OPT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --update) MODE="update" ;;
    --baseline)
      [ $# -ge 2 ] || gg_fail argument-missing "--baseline" "--baseline requires a path"
      shift
      BASELINE_OPT="$1"
      ;;
    --baseline=*) BASELINE_OPT="${1#--baseline=}" ;;
    --excludes)
      [ $# -ge 2 ] || gg_fail argument-missing "--excludes" "--excludes requires a path"
      shift
      EXCLUDES_OPT="$1"
      ;;
    --excludes=*) EXCLUDES_OPT="${1#--excludes=}" ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) gg_fail argument-unknown "$1" "unknown argument '$1' (see --help)" ;;
  esac
  shift
done

gg_repo_root_cd

BASELINE_FILE="$(gg_resolve_path "$BASELINE_OPT" COMMIT_GUARDS_SUPPRESSION_BASELINE "tools/suppression-baseline.tsv" baseline)" || exit 2
EXCLUDES_FILE="$(gg_resolve_path "$EXCLUDES_OPT" COMMIT_GUARDS_SUPPRESSION_EXCLUDES "tools/suppression-ban-excludes" excludes)" || exit 2
gg_load_excludes "$EXCLUDES_FILE"

# The read discipline gg_load_excludes uses: status 1 is the answer "the
# commit has no such file", anything else is a measurement that already named
# itself. A commit with no inventory is a project whose items are all
# in-place, which has no renders to record; the empty inventory excludes
# nothing, so every tracked file stays scanned. A present inventory that does
# not parse still refuses below.
inventory_status=0
inventory="$(gg_policy_content .kendex-generated.json)" || inventory_status=$?
case "$inventory_status" in
  0) ;;
  1) inventory='[]' ;;
  *) gg_fail inventory-read "$inventory_status" "refusing to run on an unread render inventory: .kendex-generated.json (exit $inventory_status, cause above)" ;;
esac
generated_paths_load "$inventory" || exit 2

gg_tmpdir

# --- gate 1: blanket suppressions, flat fail ---------------------------------
gg_grep_lane "module-wide rust allow" \
  '^[[:space:]]*#!\[allow\(' \
  "delete the module-wide attribute and fix the findings, or annotate the surviving sites per line with a stated reason; vendored trees belong in $EXCLUDES_FILE with a reason" \
  '*.rs'

gg_grep_lane "file-level noqa" \
  '^[[:space:]]*#[[:space:]]*(ruff|flake8):[[:space:]]*noqa' \
  "drop the file-level directive; a per-line noqa naming its specific codes stays legal" \
  '*.py'

gg_grep_lane "blanket eslint-disable" \
  '/\*[[:space:]]*eslint-disable[[:space:]]*\*/' \
  "name the rules being disabled (and why), or fix the findings; the bare block form turns the linter off wholesale" \
  '*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' '*.mts' '*.cts' '*.vue' '*.svelte'

gg_grep_lane "blanket nolint" \
  '//[[:space:]]*nolint([[:space:]]*$|:[[:space:]]*all([^a-z]|$))' \
  "name the linter per line (nolint:lintname with the reason alongside), or fix the finding" \
  '*.go'

# Biome scans its own languages (JS/TS family plus CSS and JSONC). Legal is
# the fully qualified per-line or region form — lint/<group>/<rule> with a
# stated reason; file scope, unscoped regions, and category- or group-wide
# forms fail flat.
# The languages biome lints: the eslint lane's JS family plus CSS and JSONC.
BIOME_LANGS=('*.js' '*.jsx' '*.ts' '*.tsx' '*.mjs' '*.cjs' '*.mts' '*.cts' '*.vue' '*.svelte' '*.css' '*.jsonc')

gg_grep_lane "file-wide biome-ignore-all" \
  '(//|/\*+)[[:space:]]*biome-ignore-all([^A-Za-z0-9-]|$)' \
  "delete the file-wide directive and suppress per line with the full rule path and a reason (biome-ignore lint/<group>/<rule>: why), or fix the findings" \
  "${BIOME_LANGS[@]}"

gg_grep_lane "unscoped biome-ignore-start" \
  '(//|/\*+)[[:space:]]*biome-ignore-start([[:space:]]*(\*/.*)?$|[[:space:]]+lint(/[A-Za-z0-9_-]+)?[[:space:]]*:)' \
  "scope the region to one rule (biome-ignore-start lint/<group>/<rule>: why, closed by biome-ignore-end), or fix the findings; a start without a full rule path suppresses everything until the end marker" \
  "${BIOME_LANGS[@]}"

gg_grep_lane "blanket biome-ignore" \
  '(//|/\*+)[[:space:]]*biome-ignore[[:space:]]+lint(/[A-Za-z0-9_-]+)?[[:space:]]*:' \
  "name the full rule path (biome-ignore lint/<group>/<rule>: why); the bare lint or group form silences every rule beneath it" \
  "${BIOME_LANGS[@]}"

BLANKET_VIOLATIONS="$GG_VIOLATIONS"

# --- gate 2: bare-allow ratchet (rust) ---------------------------------------
# The whole parenthesized span must be lint names (paths like `clippy::x`
# included), commas, and spaces — a `reason = "…"` component carries `=`
# and quotes, which keeps the attribute out of the bare count.
BARE_ERE='#\[allow\([[:space:]]*([a-z_:]+[[:space:]]*,[[:space:]]*)*(dead_code|unused(_[a-z_]+)?)([[:space:]]*,[[:space:]]*[a-z_:]+)*[[:space:]]*\)\]'

# Tracked *.rs paths carrying a tab or newline cannot be represented in the
# line- and tab-oriented records below; refuse loudly (exclude the path to
# skip the gate) rather than silently splitting into garbage rows.
NL='
'
git ls-files -z -- '*.rs' >"$GG_TMP/rs.z" 2>"$GG_TMP/dependency.err" \
  || gg_fail_cause rust-paths "$?" "$GG_TMP/dependency.err" "git ls-files failed enumerating *.rs"
while IFS= read -r -d '' f; do
  case "$f" in
    *"$NL"*) gg_fail path-newline "$f" "tracked path contains a newline, unrepresentable in line-oriented records; rename the file: '$f'" ;;
    *"$GG_TAB"*) gg_fail path-tab "$f" "tracked path contains a tab, unrepresentable in the baseline TSV; rename the file: '$f'" ;;
  esac
done <"$GG_TMP/rs.z"

# Content governs the ratchet's scan the way it governs the blanket lanes:
# the carriers are listed with text forced and each is sniffed on its own
# bytes, so no attributes row can drop a bare allow out of the count — a
# count file that came back empty would read as "no bare allows anywhere",
# and the printed remedy for the stale rows that follow would talk the
# operator into erasing the ratchet. The count is then taken per surviving
# path, so it costs one re-scan per carrier and none per clean tracked file.
gg_content_carriers "$GG_TMP/bare.z" "bare allow" "$BARE_ERE" '*.rs'

: >"$GG_TMP/counts.raw"
while IFS= read -r -d '' f; do
  cnt_status=0
  LC_ALL=C git grep --cached -acE "$BARE_ERE" -- ":(literal)$f" >"$GG_TMP/bare.count" 2>"$GG_TMP/bare.err" || cnt_status=$?
  gg_grep_guard "$cnt_status" "$GG_TMP/bare.err" "counting the bare allows in '$f'"
  # This path just listed as a carrier; anything but a clean re-scan means the
  # measurement is broken, and a count that never arrived must not read as 0.
  [ "$cnt_status" -eq 0 ] || gg_fail allow-count "$f:$cnt_status" "git grep could not count the bare allows in '$f' (exit $cnt_status)"
  row=""
  # `read`, not a capture: the count file is one line, and an empty file
  # must reach the parse guard below rather than aborting the run.
  IFS= read -r row <"$GG_TMP/bare.count" || true
  cnt="${row##*:}"
  case "$cnt" in
    "" | *[!0-9]* | 0) gg_fail allow-count-row "$row" "unparseable count row from git grep: '$row'" ;;
  esac
  printf '%s\t%s\n' "$f" "$cnt" >>"$GG_TMP/counts.raw"
done <"$GG_TMP/bare.z"
LC_ALL=C sort "$GG_TMP/counts.raw" >"$GG_TMP/counts.tsv"

# Baseline load + hygiene (gg_validate_baseline): worktree file first; a
# tracked-but-absent baseline (sparse checkout) is read from the index so it
# cannot degrade to empty; otherwise the baseline is empty.
#
# The scan is index-scoped, so the baseline it is judged against is the index
# copy too: an unstaged row bump must not authorize growth the commit does not
# carry. Only a never-tracked baseline, and --update (which rewrites the
# worktree copy), read from disk.
BASELINE_FROM_INDEX=0
if [ "$MODE" = "update" ] && [ -f "$BASELINE_FILE" ]; then
  gg_validate_baseline "$BASELINE_FILE" "$BASELINE_FILE"
  cp -- "$BASELINE_FILE" "$GG_TMP/baseline.tsv"
else
  baseline_status=0
  gg_policy_content "$BASELINE_FILE" >"$GG_TMP/baseline.tsv" || baseline_status=$?
  case "$baseline_status" in
    0)
      # A readable policy with no worktree file came from the index.
      [ -f "$BASELINE_FILE" ] || BASELINE_FROM_INDEX=1
      gg_validate_baseline "$GG_TMP/baseline.tsv" "$BASELINE_FILE"
      ;;
    1) : >"$GG_TMP/baseline.tsv" ;;
    *) gg_fail baseline-read "$BASELINE_FILE:$baseline_status" "could not read the baseline $BASELINE_FILE (exit $baseline_status, cause above)" ;;
  esac
fi

evaluate() { # BASELINE-TSV — violations on stdout, one per line, tab-separated
  awk -F'\t' -v OFS='\t' -v basefile="$1" '
    FILENAME == basefile { base[$1] = $2 + 0; border[++bn] = $1; next }
    {
      p = $1; n = $2 + 0; seen[p] = 1
      if (!(p in base))      print "NEW",   p, n, "-"
      else if (n > base[p])  print "GROW",  p, n, base[p]
      else if (n < base[p])  print "LOOSE", p, n, base[p]
    }
    END {
      for (i = 1; i <= bn; i++) {
        p = border[i]
        if (p in seen) continue
        # "-" placeholder, never an empty field: the report loop reads these
        # rows with tab-IFS, which must not see two tabs in a row.
        print "STALE", p, "-", base[p]
      }
    }
  ' "$1" "$GG_TMP/counts.tsv"
}

# --- --update: tighten only ---------------------------------------------------
if [ "$MODE" = "update" ]; then
  awk -F'\t' -v OFS='\t' -v basefile="$GG_TMP/baseline.tsv" '
    FILENAME == basefile { base[$1] = $2 + 0; border[++bn] = $1; next }
    { act[$1] = $2 + 0 }
    END {
      for (i = 1; i <= bn; i++) {
        p = border[i]; b = base[p]
        if (!(p in act)) {
          printf "suppression-ban: baseline-removed=%s:%d\n  Removed a stale baseline row.\n", p, b > "/dev/stderr"
          continue
        }
        if (act[p] < b) {
          printf "suppression-ban: baseline-tightened=%s:%d:%d\n  Tightened the baseline row.\n", p, b, act[p] > "/dev/stderr"
          print p, act[p]
        } else {
          if (act[p] > b) printf "suppression-ban: baseline-kept=%s:%d:%d\n  Growth needs a hand edit.\n", p, act[p], b > "/dev/stderr"
          print p, b
        }
      }
    }
  ' "$GG_TMP/baseline.tsv" "$GG_TMP/counts.tsv" | LC_ALL=C sort >"$GG_TMP/baseline.new"
  if [ "$BASELINE_FROM_INDEX" = "1" ]; then
    BASELINE_QUOTED="$(printf '%q' "$BASELINE_FILE")"
    gg_fail baseline-sparse "$BASELINE_FILE" "--update cannot rewrite an index-only baseline (sparse checkout omits $BASELINE_FILE); materialize it with: git update-index --no-skip-worktree -- $BASELINE_QUOTED && git checkout-index -- $BASELINE_QUOTED, then rerun"
  fi
  if [ -f "$BASELINE_FILE" ]; then
    # The replace is the last step: a failure before it leaves the reviewed
    # baseline byte-identical.
    rows="$(gg_count_nonempty_lines "$GG_TMP/baseline.new")"
    gg_install_file "$GG_TMP/baseline.new" "$BASELINE_FILE" "the baseline"
    cp -- "$BASELINE_FILE" "$GG_TMP/baseline.tsv" || gg_fail baseline-recheck "$BASELINE_FILE" "could not re-read the replaced baseline at $BASELINE_FILE (cp failed) — the baseline WAS replaced; rerun suppression-ban to verify it"
    gg_message baseline-updated "$BASELINE_FILE:$rows" "Baseline tightened."
  else
    gg_message baseline-absent "$BASELINE_FILE" "Update never adds rows; nothing written."
  fi
fi

# --- ratchet verdict ----------------------------------------------------------
evaluate "$GG_TMP/baseline.tsv" >"$GG_TMP/violations.tsv"
ratchet_violations="$(gg_count_nonempty_lines "$GG_TMP/violations.tsv")"

while IFS="$GG_TAB" read -r kind path n b; do
  case "$kind" in
    NEW)
      gg_message allow-new "$path:$n" "Reasonless allow attributes have no baseline row."
      echo "  remedies: state a reason on each attribute or fix the code; freezing a legacy count is a hand-added baseline row in this diff with justification"
      ;;
    GROW)
      gg_message allow-growth "$path:$n:$b" "Bare allow attributes exceed the baseline."
      echo "  remedies: state a reason on each new attribute or fix the code; raising the row is a hand-edit in this diff with justification"
      ;;
    LOOSE)
      gg_message baseline-loose "$path:$b:$n" "Baseline exceeds the actual count; tighten it."
      echo "  remedy: run suppression-ban --update to tighten the row"
      ;;
    STALE)
      gg_message baseline-stale "$path:$b" "No bare allow attributes remain; remove the row."
      echo "  remedy: run suppression-ban --update to drop the row"
      ;;
  esac
done <"$GG_TMP/violations.tsv"

# A carrier the scans could not decode is named as unmeasured, never folded
# into a clean total: an OK that covers content nothing read is the silent
# pass this family refuses.
UNMEASURED=""
[ "$GG_WALK_SKIPPED" -eq 0 ] || UNMEASURED="; $GG_WALK_SKIPPED matched path(s) not measured"

total=$((BLANKET_VIOLATIONS + ratchet_violations))
if [ "$total" -gt 0 ]; then
  gg_message result "$total:$BLANKET_VIOLATIONS:$ratchet_violations:$BASELINE_FILE:$GG_WALK_SKIPPED:$EXCLUDES_FILE" "Suppression violations found$UNMEASURED"
  exit 1
fi
gg_message result "0:0:0:$BASELINE_FILE:$GG_WALK_SKIPPED:$EXCLUDES_FILE" "No blanket suppressions; bare allows meet the baseline$UNMEASURED"
