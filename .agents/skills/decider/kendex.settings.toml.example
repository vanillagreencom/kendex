[env]

# DECIDER — where this project keeps its decision records (decider skill).
# Nothing below is marked `# required`, so installing this skill writes
# nothing into <project>/kendex.settings.toml. What an install writes, and
# when, is kendex's docs/authoring/settings.md. Full reference: decider
# README.md.

# Directory holding the decision documents and their INDEX.md. Empty =
# auto-discovery, walking up for a `docs/decisions`, `decisions`,
# `doc/decisions`, or `adr` directory that has an INDEX.md; set it where the
# tree is somewhere else.
DECISIONS_DIR = ""
