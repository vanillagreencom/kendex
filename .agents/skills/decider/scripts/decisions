#!/usr/bin/env bash
# Decision lookup tool — search and query architectural decision documents.
# Run `decisions help` for usage.
#
# search, list and check treat an absent decisions directory as "no decisions
# recorded": empty JSON array or no finding, note on stderr, exit 0. Commands
# that feed the creation workflow (next-id, get) require an initialized
# directory. next-id and check fetch the base branch, which updates its
# remote-tracking ref.
# Diagnostic protocol: a refusal starts with `error=KEY` and one or more
# `FIELD=VALUE` pairs; a notice starts with `notice=KEY` and the same field
# form. English guidance follows on later lines.
set -euo pipefail

emit_error() { # KEY FIELD=VALUE EXPLANATION
  local key="$1" field="$2"
  shift 2
  printf 'error=%s %s\n' "$key" "$field" >&2
  printf '%s\n' "$*" >&2
}

emit_notice() { # KEY FIELD=VALUE EXPLANATION
  local key="$1" field="$2"
  shift 2
  printf 'notice=%s %s\n' "$key" "$field" >&2
  printf '%s\n' "$*" >&2
}

# Help is answered before project configuration is read: sourcing a repo's
# .env.local under --help would execute repository-controlled shell code.
show_help() {
  cat << 'EOF'
Decision Lookup Tool

Usage: decisions <action> [options]

Actions:
  search <query>       Ranked search (multi-word = AND, scored). Matches the
                       INDEX summary columns (decision, rationale, id) AND the
                       linked decision document bodies; summary matches outrank
                       body-only matches. A query containing | ( ) or \ switches
                       to regex mode (no scoring).
  search --issue ID    Decisions linked to an issue (Research column, exact
                       match; bodies are not scanned)
  list                 Active decisions
  next-id              Next decision ID, scheme inferred from the ID column.
                       The maximum is taken over this INDEX.md and the base
                       branch's copy of it, so a number the base holds is
                       skipped (see DECISIONS_BASE_REF for when the base
                       cannot be read)
  get <DECISION_ID>    Decision details (status, date, path). An ID on more
                       than one INDEX row is refused, naming every row
  check                Refuse duplicate decision IDs: an ID on more than one
                       INDEX row, an ID on an INDEX row that matches more
                       than one <ID>-*.md file in the decisions directory,
                       and an ID this INDEX.md records for a different
                       document than the base branch's INDEX.md does. The
                       base is read at its fetched tip, not at the merge
                       base. How a base that could not be read is judged:
                       DECISIONS_BASE_REF. Exits 0 with no finding; a
                       notice= line may still print on stderr

Options:
  --limit N            Max search results (default: 5)

Output (JSON):
  search:  [{id, decision, path}] (keyword mode adds score)
  list:    [{id, decision, path}]
  get:     {id, decision, status, date, path}
  check:   nothing on stdout; each finding is an error= record on
           stderr, exit 1; a notice= record (base-unverified,
           decisions-dir-absent) leaves exit 0

Scoring per term: decision 3, id 3, rationale 1, body 0.5.

Environment:
  DECISIONS_DIR        Decision documents directory (default: the nearest
                       ancestor holding docs/decisions/, decisions/,
                       doc/decisions/, or adr/ with an INDEX.md). Set shared
                       values in kendex.settings.toml under [env];
                       .env.local overrides locally. When absent, search/list
                       emit [] and exit 0 (note on stderr); next-id/get
                       error. A configured path that exists but is not a
                       directory is a hard error.
  DECISION_ID_PREFIX   ID prefix for next-id (default: inferred from the
                       last populated ID-column value, else D)
  DECISION_ID_WIDTH    Zero-padding width for next-id (default: inferred
                       from that same value, else 3)
  DECISIONS_BASE_REF   The base branch next-id and check read beside the
                       working tree (default: origin/HEAD, else origin/main,
                       else main). A <remote>/HEAD ref is the branch that
                       remote's HEAD names now, or the one this clone last
                       recorded when the remote does not answer. A
                       <remote>/<branch> ref is fetched first, and one the
                       remote lacks is skipped for the next candidate; a
                       local branch is read as it stands. A base that cannot
                       be fetched or read prints base-unverified with a
                       reason: not-a-repository, unresolved, fetch-failed
                       (the local copy was read), index-absent or
                       unreadable. check exits 0 only when it fetched and
                       read the base now and read both indexes whole: it
                       refuses every reason but index-absent and
                       not-a-repository, and a skipped INDEX row is an
                       error=index-row-invalid, exit 1. Elsewhere each is a
                       notice, and next-id answers from what it could read,
                       exit 0

Examples:
  decisions search "FFI error handling"
  decisions search "seqlock|mmap"
  decisions search --issue PROJ-189
  decisions search "FFI" --limit 3
  decisions list
  decisions next-id
  decisions get D017
  decisions check
EOF
}

case "${1:-help}" in
  help|--help|-h) show_help; exit 0 ;;
  search)
    if [[ -z "${2:-}" ]]; then
      show_help
      exit 0
    fi
    ;;
esac
# The help scan covers every argv position — enumerating positions is how
# this class leaks — but skips the value an option consumes (--limit N,
# --issue ID; their = forms consume nothing).
_want_help=""
_skip_value=""
for _arg in "$@"; do
  if [[ -n "$_skip_value" ]]; then
    _skip_value=""
    continue
  fi
  case "$_arg" in
    --help|-h) _want_help=1; break ;;
    --limit|--issue) _skip_value=1 ;;
  esac
done
if [[ -n "$_want_help" ]]; then
  show_help
  exit 0
fi
unset _want_help _skip_value _arg

# Load optional project config before DECISIONS_DIR auto-discovery.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$PROJECT_ROOT"

if ! command -v jq &>/dev/null; then
  emit_error dependency-missing command=jq "jq is required but is not installed."
  exit 1
fi

# --- Configuration -----------------------------------------------------------

if [[ -z "${DECISIONS_DIR:-}" ]]; then
  _dir="$(pwd)"
  while [[ "$_dir" != "/" ]]; do
    for _candidate in "docs/decisions" "decisions" "doc/decisions" "adr"; do
      if [[ -d "$_dir/$_candidate" && -f "$_dir/$_candidate/INDEX.md" ]]; then
        DECISIONS_DIR="$_dir/$_candidate"
        break 2
      fi
    done
    _dir="$(dirname "$_dir")"
  done
  unset _dir _candidate
fi

# An absent directory (unset and undiscovered, or a configured path that does
# not exist) is not an error by itself. A configured path that exists but is
# not a directory always is.
DECISIONS_DIR_ABSENT=0

if [[ -z "${DECISIONS_DIR:-}" ]]; then
  DECISIONS_DIR=""
  DECISIONS_DIR_ABSENT=1
elif [[ ! -e "$DECISIONS_DIR" ]]; then
  DECISIONS_DIR_ABSENT=1
elif [[ ! -d "$DECISIONS_DIR" ]]; then
  emit_error decisions-dir-type "path=$DECISIONS_DIR" "DECISIONS_DIR is not a directory."
  exit 1
fi

INDEX_FILE=""
if [[ "$DECISIONS_DIR_ABSENT" -eq 0 ]]; then
  INDEX_FILE="$DECISIONS_DIR/INDEX.md"
  if [[ ! -f "$INDEX_FILE" ]]; then
    emit_error index-missing "path=$INDEX_FILE" "The decisions directory has no INDEX.md file."
    exit 1
  fi
fi

require_decisions_dir() {
  [[ "$DECISIONS_DIR_ABSENT" -eq 1 ]] || return 0
  if [[ -n "$DECISIONS_DIR" ]]; then
    emit_error decisions-dir-absent "path=$DECISIONS_DIR" "DECISIONS_DIR does not exist."
  else
    emit_error decisions-dir-absent path=auto "No decisions directory was found. Set DECISIONS_DIR or create docs/decisions/INDEX.md."
  fi
  exit 1
}

note_missing_decisions_dir() {
  if [[ -n "$DECISIONS_DIR" ]]; then
    emit_notice decisions-dir-absent "path=$DECISIONS_DIR" "The decisions directory is absent, so no decisions are recorded."
  else
    emit_notice decisions-dir-absent path=auto "No decisions directory was found, so no decisions are recorded."
  fi
}

# --- Helpers ------------------------------------------------------------------

PARSED_ID_PREFIX=""
PARSED_ID_NUM=""

split_decision_id() {
  local value="$1"
  PARSED_ID_PREFIX=""
  PARSED_ID_NUM=""

  if [[ "$value" =~ ^(.*[^0-9])?([0-9]+)$ ]]; then
    PARSED_ID_PREFIX="${BASH_REMATCH[1]}"
    PARSED_ID_NUM="${BASH_REMATCH[2]}"
    return 0
  fi

  return 1
}

regex_valid() { # REGEX
  jq -n --arg regex "$1" '"" | test($regex)' >/dev/null 2>&1
}

# Parse the INDEX.md table into JSON, one jq pass over the whole file.
#
# Column order is a machine contract: a row is a line starting `| YYYY-` and
# its eight cells are read positionally (date, id, research, decision,
# rationale, revisit, status, link). The link cell yields the decision
# document's path — preferred as a markdown link target, falling back to a
# backticked or bare `.md` filename so an index written from an older row
# template still resolves its documents instead of silently reporting none.
#
# Each row also carries its INDEX line number and its link cell as written,
# which the duplicate and base checks name and compare. The link, not the whole
# row, is a record's identity across branches: a status edit on a branch keeps
# the record it edits.
parse_index() {
  if [[ -z "$INDEX_FILE" || ! -f "$INDEX_FILE" ]]; then
    echo '[]'
    return
  fi
  parse_rows "$(<"$INDEX_FILE")" "$INDEX_FILE" "$DECISIONS_DIR/"
}

# ROW_INVALID_KIND is notice, or error under check, which may pass only an
# INDEX it read whole; parse_rows then returns 1 when it skipped a row.
ROW_INVALID_KIND=notice
parse_rows() { # TEXT LABEL PATH_PREFIX — LABEL names the INDEX in records
  local text="$1" label="$2" prefix="$3" invalid parsed
  # A row that opens `| YYYY-` but misses the eight-cell contract is dropped
  # from the results. Dropped silently it reads downstream as a decision nobody
  # ever recorded, so every such row is named on stderr. stdout still carries
  # exactly the rows that parse.
  invalid="$(jq -R -s -r --arg f "$label" --arg kind "$ROW_INVALID_KIND" '
    def cells:
      split("|")
      | if .[0] == "" then .[1:] else . end
      | if .[-1] == "" then .[:-1] else . end;
    split("\n")
    | to_entries[]
    | select(.value | test("^\\| [0-9]{4}-"))
    | select((.value | cells | length) < 8)
    | "\($kind)=index-row-invalid path=\($f) line=\(.key + 1) cells=\(.value | cells | length)\nINDEX row needs at least 8 columns and was skipped: \(.value)"
  ' <<<"$text")" || return 1
  if [[ -n "$invalid" ]]; then
    printf '%s\n' "$invalid" >&2
  fi
  # Each jq status is checked here: callers run this inside a command
  # substitution, where errexit does not reach.
  parsed="$(jq -R -s -c --arg prefix "$prefix" '
    def cells:
      split("|")
      | if .[0] == "" then .[1:] else . end
      | if .[-1] == "" then .[:-1] else . end;
    def cell_path:
      . as $cell
      | ( [ $cell | scan("\\(([^)]+)\\)") ]
        + [ $cell | scan("`([^`]+\\.md)`") ]
        + [ $cell | scan("([A-Za-z0-9][A-Za-z0-9._/-]*\\.md)") ] )
      | if length > 0 then .[0][0] else "" end;
    [ split("\n")
      | to_entries[]
      | select(.value | test("^\\| [0-9]{4}-"))
      | (.key + 1) as $line
      | .value
      | cells
      | select(length >= 8)
      | map(sub("^\\s+"; "") | sub("\\s+$"; ""))
      | { id: .[1], research: .[2], decision: .[3], rationale: .[4],
          status: .[6], link: (.[7] | cell_path), line: $line }
      | .path = (if .link == "" then "" else $prefix + .link end)
    ]' <<<"$text")" || return 1
  printf '%s\n' "$parsed"
  [[ -z "$invalid" || "$ROW_INVALID_KIND" == notice ]]
}

# The base branch's INDEX.md, parsed into BASE_ROWS. Nothing is printed here:
# the outcome is left in BASE_REASON (empty when the base was fetched and read
# whole), and report_base turns it into a record, because next-id and check
# judge the same outcome differently. BASE_ROWS keeps what could be read:
# nothing, or the local copy of a ref whose fetch failed.
BASE_ROWS='[]'
BASE_REF=""
BASE_PATH=""
BASE_REASON=""
BASE_ROWS_SKIPPED=0
read_base_index() {
  local prefix cand short remote branch remotes r text line listing found fetch_failed=0
  local candidates=()

  if ! prefix="$(git -C "$DECISIONS_DIR" rev-parse --show-prefix 2>/dev/null)"; then
    BASE_REF=none
    BASE_REASON=not-a-repository
    return 0
  fi

  if [[ -n "${DECISIONS_BASE_REF:-}" ]]; then
    candidates=("$DECISIONS_BASE_REF")
  else
    candidates=(origin/HEAD origin/main main)
  fi

  remotes="$(git -C "$DECISIONS_DIR" remote)" || remotes=""
  for cand in "${candidates[@]}"; do
    short="${cand#refs/remotes/}"
    remote=""
    while IFS= read -r r; do
      if [[ -n "$r" && "$short" == "$r/"* ]]; then
        remote="$r"
        break
      fi
    done <<<"$remotes"
    if [[ -n "$remote" ]]; then
      branch="${short#"$remote/"}"
      # One listing says whether the remote answers, which branch its HEAD
      # names now, and whether the named branch exists. A branch the remote
      # lacks is skipped: a local ref of that name is stale for good, so it is
      # never read in place of the next candidate. No prompt: a credential or
      # passphrase request would hang the caller instead of degrading to a
      # reported outcome.
      if listing="$(GIT_TERMINAL_PROMPT=0 git -C "$DECISIONS_DIR" ls-remote --symref "$remote" HEAD "refs/heads/$branch" </dev/null 2>/dev/null)"; then
        found=""
        while IFS= read -r line; do
          case "$line" in
            "ref: refs/heads/"*$'\t'HEAD) [[ "$branch" != HEAD ]] || found="${line#ref: refs/heads/}" ;;
            *$'\t'"refs/heads/$branch") found="$branch" ;;
          esac
        done <<<"$listing"
        found="${found%$'\t'HEAD}"
        [[ -n "$found" ]] || continue
        cand="$remote/$found"
        if ! GIT_TERMINAL_PROMPT=0 git -C "$DECISIONS_DIR" fetch --quiet --no-tags "$remote" "+refs/heads/$found:refs/remotes/$remote/$found" </dev/null >/dev/null 2>&1; then
          fetch_failed=1
        fi
      else
        # The remote did not answer. That stays recorded for every later
        # candidate, which may be a stale local branch; a <remote>/HEAD falls
        # back to the default branch this clone last recorded.
        fetch_failed=1
        if [[ "$branch" == HEAD ]]; then
          cand="$(git -C "$DECISIONS_DIR" symbolic-ref --quiet --short "refs/remotes/$remote/HEAD")" || continue
        fi
      fi
    fi
    if git -C "$DECISIONS_DIR" rev-parse --verify --quiet "$cand^{commit}" >/dev/null; then
      BASE_REF="$cand"
      break
    fi
  done

  if [[ -z "$BASE_REF" ]]; then
    BASE_REF="$(IFS=,; printf '%s' "${candidates[*]}")"
    BASE_REASON=unresolved
    return 0
  fi

  # Presence is read from the tree, which a blob-filtered clone holds locally;
  # only the read below needs the blob, and may fetch it.
  BASE_PATH="${prefix}INDEX.md"
  if ! git -C "$DECISIONS_DIR" rev-parse --verify --quiet "$BASE_REF:$BASE_PATH" >/dev/null; then
    BASE_REASON=index-absent
    return 0
  fi
  if ! text="$(GIT_TERMINAL_PROMPT=0 git -C "$DECISIONS_DIR" show "$BASE_REF:$BASE_PATH" </dev/null 2>/dev/null)"; then
    BASE_REASON=unreadable
    return 0
  fi
  BASE_ROWS="$(parse_rows "$text" "$BASE_REF:$BASE_PATH" "$BASE_REF:$prefix")" || BASE_ROWS_SKIPPED=1
  if [[ "$fetch_failed" -eq 1 ]]; then
    BASE_REASON=fetch-failed
  fi
}

# Print the outcome of read_base_index as one base-unverified record. The
# refuse column is the whole check policy: check refuses every base it did not
# fetch and read now, except one with no INDEX.md or no repository, which holds
# no number. next-id never refuses. Returns 1 when a refusal was printed.
report_base() { # MODE — next-id or check
  local mode="$1" refuse=0 text
  case "$BASE_REASON" in
    "") return 0 ;;
    not-a-repository) text="The decisions directory is not inside a git repository, so no base branch was read." ;;
    unresolved) refuse=1; text="None of these resolved to a commit, so no base branch was read. Set DECISIONS_BASE_REF to the base branch, or correct its value." ;;
    fetch-failed) refuse=1; text="The base branch could not be fetched, so its local copy was read and may be behind the remote." ;;
    index-absent) text="The base branch has no $BASE_PATH, so it holds no decision number." ;;
    unreadable) refuse=1; text="The base branch's $BASE_PATH exists but could not be read, so no base number was read." ;;
  esac
  if [[ "$mode" == check && "$refuse" -eq 1 ]]; then
    emit_error base-unverified "ref=$BASE_REF reason=$BASE_REASON" "$text"
    return 1
  fi
  emit_notice base-unverified "ref=$BASE_REF reason=$BASE_REASON" "$text"
}


# Which indexed decision BODIES match each term.
#
# One grep per TERM over only the files the index links, so cost scales with
# query length rather than corpus size, and unindexed or stray files in the
# directory cannot influence results. Emits {path: [terms...]}.
body_term_hits() {
  local rows_json="$1"; shift
  local paths=() path term matched hits=""

  while IFS= read -r path; do
    if [[ -n "$path" ]]; then
      paths+=("$path")
    fi
  done < <(printf '%s' "$rows_json" | jq -r '.[] | select(.path != null and .path != "") | .path')

  if [[ "${#paths[@]}" -eq 0 ]]; then
    echo '{}'
    return 0
  fi

  for term in "$@"; do
    if [[ -z "$term" ]]; then
      continue
    fi
    # -l lists matching files. Unreadable or absent files are not matches, and
    # a term that matches nothing is not an error.
    # No -r: it is a GNU extension, its only job is to skip a run on empty
    # input, and the array is already proven non-empty above. Dropping it is
    # what keeps this line off the differences between xargs implementations
    # rather than resting on any one of them accepting the flag.
    matched=$(printf '%s\0' "${paths[@]}" | xargs -0 grep -ilE -e "$term" -- 2>/dev/null || true)
    if [[ -n "$matched" ]]; then
      while IFS= read -r path; do
        hits+="$path"$'\t'"$term"$'\n'
      done <<< "$matched"
    fi
  done

  printf '%s' "$hits" | jq -R -s -c '
    split("\n") | map(select(length > 0) | split("\t") | {path: .[0], term: .[1]})
    | group_by(.path) | map({key: .[0].path, value: [.[].term]}) | from_entries
  '
}

# --- Commands -----------------------------------------------------------------

search_decisions() {
  local query=""
  local issue=""
  local limit=5

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue)
        if [[ $# -lt 2 ]]; then
          emit_error argument-value-missing option=--issue "--issue requires an ID."
          return 1
        fi
        issue="$2"; shift 2
        ;;
      --issue=*)
        issue="${1#--issue=}"
        if [[ -z "$issue" ]]; then
          emit_error argument-value-missing option=--issue "--issue requires an ID."
          return 1
        fi
        shift
        ;;
      --limit)
        if [[ $# -lt 2 ]]; then
          emit_error argument-value-missing option=--limit "--limit requires a number."
          return 1
        fi
        limit="$2"; shift 2
        ;;
      --limit=*)
        limit="${1#--limit=}"
        if [[ -z "$limit" ]]; then
          emit_error argument-value-missing option=--limit "--limit requires a number."
          return 1
        fi
        shift
        ;;
      *) query="$1"; shift ;;
    esac
  done

  if [[ ! "$limit" =~ ^[0-9]+$ ]]; then
    emit_error limit-invalid "value=$limit" "--limit must be a non-negative integer."
    return 1
  fi

  if [[ -z "$issue" && -z "$query" ]]; then
    emit_error search-input-missing value=query-or-issue "Provide a search query or --issue ID."
    return 1
  fi

  if [[ "$DECISIONS_DIR_ABSENT" -eq 1 ]]; then
    note_missing_decisions_dir
    echo '[]'
    return 0
  fi

  local all
  all=$(parse_index)

  if [[ -n "$issue" ]]; then
    # Negative lookahead prevents PROJ-18 matching PROJ-189.
    if ! regex_valid "$issue(?![0-9])"; then
      emit_error regex-invalid "value=$issue" "The issue value is not a valid regular expression."
      return 1
    fi
    echo "$all" | jq --arg issue "$issue" '[
      .[] | select(.research | test($issue + "(?![0-9])"; "i")) |
      {id, decision, path}
    ]'
    return 0
  fi

  if echo "$query" | grep -qE '[|()\\]'; then
    if ! regex_valid "$query"; then
      emit_error regex-invalid "value=$query" "The search query is not a valid regular expression."
      return 1
    fi
    local rx_bodies
    rx_bodies=$(body_term_hits "$all" "$query")
    echo "$all" | jq --arg q "$query" --argjson limit "$limit" --argjson bodies "$rx_bodies" '[
      .[] | select(
        (.decision | test($q; "i")) or
        (.rationale | test($q; "i")) or
        (.id | test($q; "i")) or
        (($bodies[.path] // []) | length > 0)
      ) | {id, decision, path}
    ] | .[:$limit]'
    return 0
  fi

  local terms_arr kw_bodies
  # Same split jq performs below, so grep and jq agree on term boundaries.
  read -r -a terms_arr <<< "$(echo "$query" | tr '[:upper:]' '[:lower:]')"
  kw_bodies=$(body_term_hits "$all" "${terms_arr[@]}")
  echo "$all" | jq --arg q "$query" --argjson limit "$limit" --argjson bodies "$kw_bodies" '
    ($q | ascii_downcase | split(" ") | map(select(length > 0))) as $terms |

    [.[] |
      # A term counts if it is in the summary columns OR in the decision
      # document body, so AND can be satisfied across both — one term in the
      # title, another in prose.
      . as $row |
      ($row.decision + " " + $row.rationale + " " + $row.id | ascii_downcase) as $all_text |
      (($bodies[$row.path] // []) | map(ascii_downcase)) as $body_terms |
      if ($terms | all(. as $t | ($all_text | test($t)) or ($body_terms | index($t) != null))) then
        # Body scores below rationale, so a body-only hit always sorts under
        # every summary match rather than displacing one.
        ($row.decision | ascii_downcase) as $title |
        ($row.id | ascii_downcase) as $did |
        ($row.rationale | ascii_downcase) as $rat |
        ([$terms[] | . as $t |
          (if ($title | test($t)) then 3 else 0 end) +
          (if ($did | test($t)) then 3 else 0 end) +
          (if ($rat | test($t)) then 1 else 0 end) +
          (if ($body_terms | index($t) != null) then 0.5 else 0 end)
        ] | add) as $score |
        {id: $row.id, decision: $row.decision, path: $row.path, score: $score}
      else empty end
    ] | sort_by(-.score) | .[:$limit]
  '
}

list_decisions() {
  if [[ "$DECISIONS_DIR_ABSENT" -eq 1 ]]; then
    note_missing_decisions_dir
    echo '[]'
    return 0
  fi

  parse_index | jq '[.[] | select(.status | startswith("Active")) | {id, decision, path}]'
}

cmd_next_id() {
  local ids=() base_ids=() id id_list
  id_list="$(parse_index | jq -r '.[].id // empty')"
  while IFS= read -r id; do
    if [[ -n "$id" ]]; then
      ids+=("$id")
    fi
  done <<<"$id_list"

  local prefix="D"
  local width=3
  local prefix_configured=0
  local width_configured=0

  if [[ "${DECISION_ID_PREFIX+x}" == "x" ]]; then
    prefix="$DECISION_ID_PREFIX"
    prefix_configured=1
  fi

  if [[ "${DECISION_ID_WIDTH+x}" == "x" ]]; then
    if [[ ! "$DECISION_ID_WIDTH" =~ ^[1-9][0-9]*$ ]]; then
      emit_error id-width-invalid "value=$DECISION_ID_WIDTH" "DECISION_ID_WIDTH must be a positive integer."
      return 1
    fi
    width="$DECISION_ID_WIDTH"
    width_configured=1
  fi

  read_base_index
  report_base next-id
  id_list="$(jq -r '.[].id // empty' <<<"$BASE_ROWS")"
  while IFS= read -r id; do
    if [[ -n "$id" ]]; then
      base_ids+=("$id")
    fi
  done <<<"$id_list"

  if [[ "$prefix_configured" -eq 0 ]]; then
    # Infer the scheme from the last populated ID-column value: the working
    # tree's, else the base's. If it is not incrementable, fail loudly instead
    # of falling back to an older row and returning a plausible but wrong ID.
    local last_id=""
    if [[ "${#ids[@]}" -gt 0 ]]; then
      last_id="${ids[${#ids[@]} - 1]}"
    elif [[ "${#base_ids[@]}" -gt 0 ]]; then
      last_id="${base_ids[${#base_ids[@]} - 1]}"
    fi
    if [[ -n "$last_id" ]]; then
      if ! split_decision_id "$last_id"; then
        emit_error id-suffix-missing "value=$last_id" "The last decision ID in INDEX.md has no numeric suffix. Set DECISION_ID_PREFIX and DECISION_ID_WIDTH to select a scheme explicitly."
        return 1
      fi
      prefix="$PARSED_ID_PREFIX"
      if [[ "$width_configured" -eq 0 ]]; then
        width="${#PARSED_ID_NUM}"
      fi
    fi
  elif [[ "$width_configured" -eq 0 ]]; then
    # A configured prefix selects the scheme; infer padding from matching rows.
    for id in ${base_ids[@]+"${base_ids[@]}"} ${ids[@]+"${ids[@]}"}; do
      if split_decision_id "$id" && [[ "$PARSED_ID_PREFIX" == "$prefix" ]]; then
        width="${#PARSED_ID_NUM}"
      fi
    done
  fi

  # The maximum spans both sides: a number the base already holds is taken
  # even where this branch has not seen it.
  local max_num=0 decimal
  for id in ${ids[@]+"${ids[@]}"} ${base_ids[@]+"${base_ids[@]}"}; do
    if ! split_decision_id "$id"; then
      continue
    fi
    if [[ "$PARSED_ID_PREFIX" != "$prefix" ]]; then
      continue
    fi
    # Force base-10 (leading zeros would otherwise read as octal).
    decimal=$((10#$PARSED_ID_NUM))
    if [[ "$decimal" -gt "$max_num" ]]; then
      max_num="$decimal"
    fi
  done

  printf "%s%0*d\n" "$prefix" "$width" $((max_num + 1))
}

cmd_get() {
  if [[ $# -lt 1 || -z "$1" ]]; then
    emit_error argument-value-missing action=get "decisions get requires a decision ID."
    return 1
  fi
  local id="$1"

  local matches count match fields
  matches=$(parse_index | jq -c --arg id "$id" '[.[] | select(.id == $id)]')
  # jq's own diagnostic names a failed count.
  if ! count=$(jq 'length' <<<"$matches"); then
    return 1
  fi

  if [[ "$count" -eq 0 ]]; then
    emit_error decision-not-found "id=$id" "The decision was not found."
    exit 1
  fi
  # Answering with one of several rows would let the older record stand in
  # for every record sharing its ID.
  if [[ "$count" -gt 1 ]]; then
    fields="$(row_fields "$matches")"
    emit_error id-ambiguous "id=$id $fields" "More than one INDEX row carries this ID. Renumber all but one (workflows/create-decision.md § Renumber a record)."
    exit 1
  fi
  match=$(jq 'first | del(.line, .link)' <<<"$matches")

  local path date="unknown" parsed
  path=$(printf '%s' "$match" | jq -r '.path')
  if [[ -n "$path" && -f "$path" ]]; then
    parsed=$(awk '/^\*\*Date\*\*:/ { sub(/^\*\*Date\*\*:[[:space:]]*/, ""); print; exit }' < "$path")
    if [[ -n "$parsed" ]]; then
      date="$parsed"
    fi
  fi

  printf '%s' "$match" | jq --arg date "$date" '. + {date: $date}'
}

row_fields() { # ROWS_JSON — the rows= and paths= fields naming each row
  jq -r '"rows=\(map(.line | tostring) | join(",")) paths=\(map(.path) | join(","))"' <<<"$1"
}

cmd_check() {
  if [[ "$DECISIONS_DIR_ABSENT" -eq 1 ]]; then
    note_missing_decisions_dir
    return 0
  fi

  local rows dups dup ids id f files fields file_count found=0
  ROW_INVALID_KIND=error
  rows="$(parse_index)" || found=1

  dups="$(jq -c 'group_by(.id) | map(select(length > 1)) | .[]' <<<"$rows")"
  while IFS= read -r dup; do
    [[ -n "$dup" ]] || continue
    id="$(jq -r '.[0].id' <<<"$dup")"
    fields="$(row_fields "$dup")"
    emit_error id-duplicate-row "id=$id $fields" "More than one row of $INDEX_FILE carries this ID. Renumber all but one (workflows/create-decision.md § Renumber a record)."
    found=1
  done <<<"$dups"

  ids="$(jq -r 'map(.id) | unique | .[]' <<<"$rows")"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    files=""
    file_count=0
    for f in "$DECISIONS_DIR/$id"-*.md; do
      [[ -e "$f" ]] || continue
      files="${files:+$files,}$f"
      file_count=$((file_count + 1))
    done
    if [[ "$file_count" -gt 1 ]]; then
      emit_error id-duplicate-file "id=$id paths=$files" "More than one decision document carries this ID. Renumber all but one (workflows/create-decision.md § Renumber a record)."
      found=1
    fi
  done <<<"$ids"

  # A row the base records under the same link is the same record, edited or
  # not. The same ID under another link is a second decision.
  read_base_index
  report_base check || found=1
  [[ "$BASE_ROWS_SKIPPED" -eq 0 ]] || found=1
  local collisions collision
  collisions="$(jq -c --argjson base "$BASE_ROWS" '
    .[] | . as $row
    | [$base[] | select(.id == $row.id)] as $held
    | select(($held | length) > 0 and ($held | map(.link) | index($row.link)) == null)
    | {id: $row.id, path: $row.path, base: ($held | map(.path) | join(","))}
  ' <<<"$rows")"
  while IFS= read -r collision; do
    [[ -n "$collision" ]] || continue
    fields="$(jq -r '"id=\(.id) path=\(.path) base=\(.base)"' <<<"$collision")"
    emit_error id-collision "$fields" "The base branch already records this ID for another decision. The base keeps the number; renumber this branch's record (workflows/create-decision.md § Renumber a record)."
    found=1
  done <<<"$collisions"

  [[ "$found" -eq 0 ]]
}

# --- Main ---------------------------------------------------------------------

action="${1:-help}"
shift || true

case "$action" in
  search)
    search_decisions "$@"
    ;;
  list)
    list_decisions
    ;;
  next-id)
    require_decisions_dir
    cmd_next_id
    ;;
  get)
    require_decisions_dir
    cmd_get "$@"
    ;;
  check)
    cmd_check
    ;;
  issue|issues)
    emit_error action-unknown "action=$action hint=search--issue" "Use decisions search --issue <ISSUE_ID> for issue lookup."
    exit 1
    ;;
  *)
    emit_error action-unknown "action=$action" "The action is not supported."
    show_help
    exit 1
    ;;
esac
