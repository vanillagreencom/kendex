#!/usr/bin/env bash
# Diagnostic protocol: command refusals start error=KEY FIELD=VALUE; settings
# refusals start doc-limits-error=KEY value=VALUE; notices start
# notice=KEY FIELD=VALUE. English detail follows on the next line. Each
# notice=document-over-limit or notice=document-near-limit is followed, after
# its remedy, by one notice=document-rule rule=docs-writing/SKILL.md#ANCHOR
# for its class.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh" || exit 2
# shellcheck source=../../commit-guards/scripts/lib/generated-paths.sh
source "$SCRIPT_DIR/../../commit-guards/scripts/lib/generated-paths.sh"
TAB="$(printf '\t')"
NL='
'
# One row per shipped class: its pattern=Nk entry, a tab, and the anchor in
# docs-writing SKILL.md of the rule that decides which remedy a document of
# that class admits. The anchors are kept by hand in step with that file's
# § Per file type; the *.md catch-all names the section as a whole. The row
# order is the match order.
SHIPPED_CLASS_ROWS='docs/architecture/overview.md=12k	docsarchitectureoverviewmd
docs/architecture/*.md=16k	docsarchitecturetopicmd
AGENTS.md=8k	agentsmd
CLAUDE.md=24k	claudemd
*/AGENTS.md=6k	agentsmd
*/CLAUDE.md=24k	claudemd
*/SKILL.md=24k	skillmd-workflowsmd-agentsmd
*/workflows/*.md=40k	skillmd-workflowsmd-agentsmd
README.md=16k	readmemd
*/README.md=12k	readmemd
docs/*.html=64k	documentation-html
*.md=64k	per-file-type'
STAGED=0
usage() {
  cat <<'EOF'
usage: doc-limits [--staged] [--against REF] [--excludes FILE]
Check byte ceilings for tracked Markdown and docs/*.html documents. The first
matching class sets the limit. Other files are outside this check.
--staged reads document sizes and tracked policy from the index.
The default reads worktree files, falling back to the index for missing files.
--against REF also fails a document whose index copy is larger than its copy
in REF's own tree and whose measured size is within the margin under its
limit; a document absent from REF counts as grown. Growth compares stored
blob sizes, so checkout conversion (eol=crlf, autocrlf) adds none, and an
edit counts as growth once staged. REF is the tree the change is measured
from: HEAD^1 of a pull request merge commit, or $(git merge-base HEAD BASE)
for a branch checkout. A base branch tip that moved after the branch point
charges its own edits to the change. Which CI events to run it on:
references/policy.md § Growth margin.
No mode writes files or changes the index.
Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  DOC_LIMITS_CLASSES          repo classes, pattern=Nk separated by ;
  DOC_LIMITS_DEFAULT_CLASSES  shipped classes, same syntax
  DOC_LIMITS_EXCLUDES         reasoned exclusion-list path
                               (default tools/doc-limits-excludes)
  DOC_LIMITS_MARGIN_PCT       --against margin, percent of each limit,
                               0-99, no leading zeros (default 2)
  DOC_LIMITS_SETTINGS_FILE    alternate settings file; /dev/null for defaults
The k suffix means 1024 bytes. Bare line thresholds are not supported.
--excludes overrides the configured path. Each exclusion is pattern<TAB>reason.
Generated files are excluded by exact path from .kendex-generated.json.
The inventory is required; --staged reads its tracked index copy.
Class selection and exclusions: references/policy.md.
Exit codes: 0 clean; 1 over-limit or grown near-limit documents;
2 usage/config/collection error.
EOF
}
diagnostic() {
  local level="$1" key="$2" field="$3" value="$4" text="$5"
  printf '%s=%s %s=%q\n' "$level" "$key" "$field" "$value" >&2
  printf '::error::doc-limits: %s\n' "$text" >&2
}
config_error() {
  diagnostic error "$1" "$2" "$3" "$4"
  exit 2
}
collection_error() {
  diagnostic error "$1" "$2" "$3" "$4"
  exit 2
}
notice() {
  local key="$1" field="$2" value="$3" text="$4"
  printf 'notice=%s %s=%q\n' "$key" "$field" "$value"
  printf '%s\n' "$text"
}
# A maintainer adding a class row writes its rule anchor in the same row; a
# row with an empty rule refuses before any document is read.
SHIPPED_CLASSES=""
while IFS="$TAB" read -r entry rule; do
  [ -n "$rule" ] || config_error class-rule-missing value "$entry" "shipped class '$entry' names no docs-writing rule; add its anchor to SHIPPED_CLASS_ROWS"
  SHIPPED_CLASSES="${SHIPPED_CLASSES:+$SHIPPED_CLASSES;}$entry"
done <<EOF
$SHIPPED_CLASS_ROWS
EOF
class_rule() { # PATTERN: the shipped row's anchor, else the whole § Per file type
  local entry rule
  CR=per-file-type
  while IFS="$TAB" read -r entry rule; do
    if [ "${entry%=*}" = "$1" ]; then
      CR="$rule"
      return 0
    fi
  done <<EOF
$SHIPPED_CLASS_ROWS
EOF
}
EXCLUDES_OPT=""
EXCLUDES_SET=0
AGAINST_REF=""
AGAINST_SET=0
while [ $# -gt 0 ]; do
  case "$1" in
    --excludes)
      [ $# -ge 2 ] || config_error argument-value-missing option --excludes "--excludes requires a path"
      shift
      EXCLUDES_OPT="$1"
      EXCLUDES_SET=1
      ;;
    --excludes=*) EXCLUDES_OPT="${1#--excludes=}"; EXCLUDES_SET=1 ;;
    --against)
      [ $# -ge 2 ] || config_error argument-value-missing option --against "--against requires a ref"
      shift
      AGAINST_REF="$1"
      AGAINST_SET=1
      ;;
    --against=*) AGAINST_REF="${1#--against=}"; AGAINST_SET=1 ;;
    -h | --help) usage; exit 0 ;;
    --staged) STAGED=1 ;;
    *) config_error argument-unknown argument "$1" "unknown argument '$1' (see --help)" ;;
  esac
  shift
done
REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || config_error repository-root-missing path "$PWD" "not inside a git repository"
cd "$REPO_ROOT" 2>/dev/null || config_error repository-root-unreadable path "$REPO_ROOT" "could not enter the repository root $REPO_ROOT"
TMP="$(mktemp -d "${TMPDIR:-/tmp}/doc-limits.XXXXXX" 2>/dev/null)" || config_error temp-create-failed path "${TMPDIR:-/tmp}" "could not create a temporary directory"
trap 'rm -rf -- "${TMP:?}"' EXIT
AGAINST_OID=""
if [ "$AGAINST_SET" = "1" ]; then
  [ -n "$AGAINST_REF" ] || config_error against-ref-empty ref "$AGAINST_REF" "--against was given an empty ref"
  AGAINST_OID="$(git rev-parse --verify --quiet "$AGAINST_REF^{commit}" 2>/dev/null)" \
    || config_error against-ref-invalid ref "$AGAINST_REF" "--against ref '$AGAINST_REF' does not name a commit (a shallow checkout may lack it)"
fi
if [ "$STAGED" -eq 1 ]; then
  SR_SETTINGS_FROM_INDEX=1
  SR_SETTINGS_INDEX_DIR="$TMP"
  export SR_SETTINGS_FROM_INDEX SR_SETTINGS_INDEX_DIR
fi
CLASS_PATTERNS=()
CLASS_THRESHOLDS=()
CLASS_COUNT=0
parse_classes() { # SETTING-NAME VALUE — appends entries
  local name="$1" rest="$2" pair cpat cthr craw
  while [ -n "$rest" ]; do
    case "$rest" in
      *";"*)
        pair="${rest%%;*}"
        rest="${rest#*;}"
        ;;
      *)
        pair="$rest"
        rest=""
        ;;
    esac
    pair="${pair#"${pair%%[![:space:]]*}"}"
    pair="${pair%"${pair##*[![:space:]]}"}"
    [ -n "$pair" ] || continue
    case "$pair" in
      *"="*) ;;
      *) config_error class-entry-invalid value "$pair" "$name: entry '$pair' is not 'pattern=threshold'" ;;
    esac
    cpat="${pair%=*}"
    craw="${pair##*=}"
    cpat="${cpat%"${cpat##*[![:space:]]}"}"
    craw="${craw#"${craw%%[![:space:]]*}"}"
    [ -n "$cpat" ] || config_error class-pattern-empty value "$pair" "$name: entry '$pair' has an empty pattern"
    case "$cpat" in
      *"$TAB"* | *"$NL"*) config_error class-pattern-invalid setting "$name" "$name: entry '$pair' has a tab or newline in its pattern; the mapping is one line" ;;
    esac
    case "$craw" in
      *k) cthr="${craw%k}" ;;
      *) config_error class-threshold-invalid value "$craw" "$name: entry '$pair' needs a positive integer with the 'k' byte suffix" ;;
    esac
    case "$cthr" in
      "" | *[!0-9]* | 0*[0-9] | 0) config_error class-threshold-invalid value "$craw" "$name: entry '$pair' needs a positive integer with the 'k' byte suffix" ;;
    esac
    cthr=$((cthr * 1024))
    CLASS_PATTERNS+=("$cpat")
    CLASS_THRESHOLDS+=("$cthr")
    CLASS_COUNT=$((CLASS_COUNT + 1))
  done
}
CLASSES="$(sr_setting DOC_LIMITS_CLASSES "")" || exit 2
parse_classes DOC_LIMITS_CLASSES "$CLASSES"
DEFAULT_CLASSES="$(sr_setting DOC_LIMITS_DEFAULT_CLASSES "$SHIPPED_CLASSES")" || exit 2
parse_classes DOC_LIMITS_DEFAULT_CLASSES "$DEFAULT_CLASSES"
MARGIN_PCT=0
if [ -n "$AGAINST_OID" ]; then
  MARGIN_PCT="$(sr_setting DOC_LIMITS_MARGIN_PCT 2)" || exit 2
  case "$MARGIN_PCT" in
    "" | *[!0-9]* | 0?* | ???*) config_error margin-pct-invalid value "$MARGIN_PCT" "DOC_LIMITS_MARGIN_PCT must be a decimal integer percent from 0 to 99 without leading zeros, got '$MARGIN_PCT'" ;;
  esac
fi
if [ "$EXCLUDES_SET" = "1" ]; then
  [ -n "$EXCLUDES_OPT" ] || config_error excludes-path-empty path "$EXCLUDES_OPT" "--excludes was given an empty path; pass a real path or omit the flag to use the configured default"
  EXCLUDES_FILE="$EXCLUDES_OPT"
else
  EXCLUDES_FILE="$(sr_setting DOC_LIMITS_EXCLUDES "tools/doc-limits-excludes")" || exit 2
fi
normalize_rel_path() { # PATH -> normalized on stdout; nonzero if it escapes
  local input="$1" out="" seg rest
  rest="$input"
  while [ -n "$rest" ]; do
    seg="${rest%%/*}"
    if [ "$seg" = "$rest" ]; then rest=""; else rest="${rest#*/}"; fi
    case "$seg" in
      "" | ".") ;;
      "..")
        case "$out" in
          "") return 1 ;;
          */*) out="${out%/*}" ;;
          *) out="" ;;
        esac
        ;;
      *) out="${out:+$out/}$seg" ;;
    esac
  done
  [ -n "$out" ] || return 1
  printf '%s' "$out"
}
case "$EXCLUDES_FILE" in /*) config_error excludes-path-absolute path "$EXCLUDES_FILE" "excludes path must be repo-root-relative, got absolute: $EXCLUDES_FILE" ;; esac
raw_excludes_file="$EXCLUDES_FILE"
EXCLUDES_FILE="$(normalize_rel_path "$EXCLUDES_FILE")" || config_error excludes-path-invalid path "$raw_excludes_file" "excludes path escapes the repository or normalizes empty"
[ -n "$EXCLUDES_FILE" ] || config_error excludes-path-empty path "$raw_excludes_file" "excludes path resolved empty"
case "$EXCLUDES_FILE" in -*) config_error excludes-path-option path "$EXCLUDES_FILE" "excludes path must not begin with '-': $EXCLUDES_FILE" ;; /*) config_error excludes-path-absolute path "$EXCLUDES_FILE" "excludes path must be repo-root-relative, got absolute: $EXCLUDES_FILE" ;; esac
staged_policy_state() { # PATH
  [ "$STAGED" -eq 1 ] || return 1
  read_index_file_mode "$1"
  [ -z "$INDEX_FILE_MODE" ] || return 0
  read_head_file_mode "$1"
  [ -z "$HEAD_FILE_MODE" ] || return 2
  return 1
}
INDEX_FILE_MODE=""
read_index_file_mode() { # PATH — sets INDEX_FILE_MODE ("" when untracked)
  local entry status=0
  entry="$(git ls-files -s -- ":(literal)$1" 2>/dev/null)" || status=$?
  [ "$status" -eq 0 ] || collection_error index-query-failed exit "$status" "could not query the index for $1 (git ls-files exit $status) — refusing to treat it as absent"
  INDEX_FILE_MODE="${entry%% *}"
  [ -n "$entry" ] || INDEX_FILE_MODE=""
}
HEAD_FILE_MODE=""
HEAD_EXISTS=0
read_head_file_mode() { # PATH — sets HEAD_FILE_MODE ("" when HEAD carries no such path)
  local entry status=0 head_status=0
  HEAD_FILE_MODE=""
  HEAD_EXISTS=0
  git rev-parse --verify --quiet HEAD >/dev/null 2>&1 || head_status=$?
  case "$head_status" in
    0) HEAD_EXISTS=1 ;;
    1) return 0 ;;
    *) collection_error head-query-failed exit "$head_status" "could not resolve HEAD while probing for $1 (git rev-parse exit $head_status) — refusing to treat it as absent" ;;
  esac
  entry="$(git ls-tree HEAD -- ":(literal)$1" 2>/dev/null)" || status=$?
  [ "$status" -eq 0 ] || collection_error head-tree-query-failed exit "$status" "could not query HEAD for $1 (git ls-tree exit $status) — refusing to treat it as absent"
  HEAD_FILE_MODE="${entry%% *}"
  [ -n "$entry" ] || HEAD_FILE_MODE=""
}
read_policy_from_index() { # PATH — stages the index copy of the list at $TMP/excludes
  case "$INDEX_FILE_MODE" in
    100*) ;;
    *) config_error excludes-mode-invalid mode "$INDEX_FILE_MODE" "$1 is tracked but is not a regular file in the index (mode $INDEX_FILE_MODE); it cannot be read as an exclusion list" ;;
  esac
  git show ":$1" >"$TMP/excludes" 2>/dev/null \
    || collection_error excludes-index-read-failed path "$1" "could not read the tracked exclusion list from the index: $1 — refusing to run with zero exclusions"
}
EXCLUDES_SOURCE="$EXCLUDES_FILE"
EXCLUDES_LABEL="$EXCLUDES_FILE"
excludes_state=0
staged_policy_state "$EXCLUDES_FILE" || excludes_state=$?
case "$excludes_state" in
  0)
    read_policy_from_index "$EXCLUDES_FILE"
    EXCLUDES_SOURCE="$TMP/excludes"
    EXCLUDES_LABEL="$EXCLUDES_FILE (index copy)"
    ;;
  1)
    if [ ! -f "$EXCLUDES_FILE" ]; then
      read_index_file_mode "$EXCLUDES_FILE"
      if [ -n "$INDEX_FILE_MODE" ]; then
        read_policy_from_index "$EXCLUDES_FILE"
        EXCLUDES_SOURCE="$TMP/excludes"
        EXCLUDES_LABEL="$EXCLUDES_FILE (index copy)"
      fi
    fi
    ;;
  2)
    : >"$TMP/excludes" || collection_error excludes-scratch-failed path "$TMP/excludes" "could not initialize the excludes scratch file"
    EXCLUDES_SOURCE="$TMP/excludes"
    ;;
esac
EXCLUDE_PATTERNS=()
CARVE_PATTERNS=()
if [ -f "$EXCLUDES_SOURCE" ]; then
  [ -r "$EXCLUDES_SOURCE" ] || config_error excludes-unreadable path "$EXCLUDES_LABEL" "$EXCLUDES_LABEL: exists but cannot be read"
  lineno=0
  while IFS= read -r line || [ -n "$line" ]; do
    lineno=$((lineno + 1))
    case "$line" in
      "" | "#"*) continue ;;
    esac
    pat="${line%%"$TAB"*}"
    reason="${line#*"$TAB"}"
    if [ "$pat" = "$line" ] || [ -z "$pat" ] || [ -z "$reason" ]; then
      config_error excludes-row-invalid line "$lineno" "$EXCLUDES_LABEL:$lineno: expected 'pattern<TAB>reason' (every exclusion carries its justification)"
    fi
    # A `!` pattern CARVES its matches back into the measured set, the only
    # way to govern documents living inside an excluded render tree
    # (../references/policy.md § Exclusion list). A row naming a path that begins with `!`
    # escapes it as `\!foo`, which stays an exclusion.
    case "$pat" in
      "!"*)
        carve="${pat#!}"
        [ -n "$carve" ] \
          || config_error excludes-carve-empty line "$lineno" "$EXCLUDES_LABEL:$lineno: '!' carves matching paths back into the measured set and needs a pattern after it"
        CARVE_PATTERNS+=("$carve")
        ;;
      *) EXCLUDE_PATTERNS+=("$pat") ;;
    esac
  done <"$EXCLUDES_SOURCE"
fi
glob_match() { # PATH PATTERN... — 0 when some pattern matches the whole path
  local path="$1" pat
  shift
  for pat in "$@"; do
    case "$path" in
      $pat) return 0 ;;
    esac
  done
  return 1
}
INVENTORY_SOURCE="$(sr_settings_source .kendex-generated.json)" || exit 2
if [ "$STAGED" -eq 0 ] && [ ! -f "$INVENTORY_SOURCE" ]; then
  read_index_file_mode .kendex-generated.json
  if [ -n "$INDEX_FILE_MODE" ]; then
    git show :0:.kendex-generated.json >"$TMP/generated.json" 2>/dev/null \
      || collection_error inventory-index-read-failed path .kendex-generated.json 'cannot read .kendex-generated.json from the index; install or refresh kendex at the Git repository root in the main checkout and stage the inventory with the renders'
    INVENTORY_SOURCE="$TMP/generated.json"
  fi
fi
# An ABSENT inventory is an empty one: a project whose items are all in-place
# has no renders to record, so the writer produces no file. Excluding nothing
# is the fail-closed read — every tracked document stays measured. A source
# that exists as something else, or that cannot be read, still refuses, and so
# does a present inventory that does not parse.
if [ ! -e "$INVENTORY_SOURCE" ] && [ ! -L "$INVENTORY_SOURCE" ]; then
  inventory='[]'
else
  inventory="$(cat -- "$INVENTORY_SOURCE" 2>/dev/null)" \
    || collection_error inventory-read-failed path "$INVENTORY_SOURCE" 'cannot read .kendex-generated.json; install or refresh kendex at the Git repository root in the main checkout and stage the inventory with the renders'
fi
# The loader's refusal names the status, the jq that read it, the cause and
# the fix; it follows this script's stable first line.
GG_CHECK=doc-limits generated_paths_load "$inventory" 2>"$TMP/inventory-status" || {
  diagnostic error inventory-invalid path .kendex-generated.json 'cannot read .kendex-generated.json; install or refresh kendex at the Git repository root in the main checkout and stage the inventory with the renders'
  cat -- "$TMP/inventory-status" >&2 || :
  exit 2
}
is_excluded() { # PATH — inclusion rows override both exclusion sources
  generated_path_contains "$1" \
    || glob_match "$1" ${EXCLUDE_PATTERNS[@]+"${EXCLUDE_PATTERNS[@]}"} || return 1
  ! glob_match "$1" ${CARVE_PATTERNS[@]+"${CARVE_PATTERNS[@]}"}
}
path_threshold() { # PATH: first matching class, or no limit
  local i=0
  PT="" PC=""
  while [ "$i" -lt "$CLASS_COUNT" ]; do
    if glob_match "$1" "${CLASS_PATTERNS[$i]}"; then
      PT="${CLASS_THRESHOLDS[$i]}"
      PC="${CLASS_PATTERNS[$i]}"
      return 0
    fi
    i=$((i + 1))
  done
}
# The index supplies both the tracked set and blob IDs. A single batch reads
# their sizes, so staged checks do not materialize every document.
git ls-files -s -z >"$TMP/files.z" 2>/dev/null || collection_error documents-enumeration-failed exit "$?" "could not enumerate tracked documents"
: >"$TMP/documents.tsv"
while IFS= read -r -d '' rec; do
  mode="${rec%% *}"
  f="${rec#*"$TAB"}"
  case "$f" in *.md | docs/*.html) ;; *) continue ;; esac
  case "$mode" in 120000 | 160000) continue ;; esac
  case "$f" in
    *"$NL"* | *"$TAB"*) config_error document-path-invalid path "$f" "tracked document path contains a tab or newline: '$f'" ;;
  esac
  is_excluded "$f" && continue
  path_threshold "$f"
  [ -n "$PT" ] || continue
  entry="${rec%%"$TAB"*}"
  [ "${entry##* }" = 0 ] || collection_error document-unmerged path "$f" "tracked document is unmerged: $f"
  oid="${entry#* }"
  oid="${oid%% *}"
  printf '%s\t%s\t%s\t%s\n' "$oid" "$f" "$PT" "$PC" >>"$TMP/documents.tsv"
done <"$TMP/files.z"
cut -f1 "$TMP/documents.tsv" 2>/dev/null | git cat-file --batch-check >"$TMP/sizes" 2>/dev/null \
  || collection_error blob-sizes-read-failed exit "$?" "could not read document blob sizes"
: >"$TMP/against-sizes"
if [ -n "$AGAINST_OID" ]; then
  while IFS="$TAB" read -r _ f _ _; do
    printf '%s:%s\n' "$AGAINST_OID" "$f"
  done <"$TMP/documents.tsv" >"$TMP/against-names"
  git cat-file --batch-check='%(objecttype) %(objectsize)' <"$TMP/against-names" >"$TMP/against-sizes" 2>/dev/null \
    || collection_error against-sizes-read-failed exit "$?" "could not read document sizes in $AGAINST_REF"
fi
remedy() { # CLASS: the remedy, then the docs-writing rule for CLASS
  printf '  remedy: split the document at a natural seam, move detail to a linked reference, or delete content the code or another document already states; a document that must stay whole gets a row in %s with its reason\n' "$EXCLUDES_FILE"
  class_rule "$1"
  notice document-rule rule "docs-writing/SKILL.md#$CR" "  the docs-writing rule at that anchor decides which of these remedies the document admits"
}
checked=0 violations=0
while IFS="$TAB" read -r oid f limit class; do
  IFS=' ' read -r actual_oid kind n <&3 || collection_error blob-size-response-incomplete path "$f" "document size response is incomplete: $f"
  [ "$actual_oid" = "$oid" ] && [ "$kind" = blob ] \
    || collection_error document-blob-read-failed path "$f" "could not read document blob: $f"
  case "$n" in "" | *[!0-9]*) collection_error document-byte-count-invalid path "$f" "invalid blob size for tracked document: $f" ;; esac
  # Growth compares the index blob with REF's blob, one byte form: the
  # worktree size below carries checkout conversion REF's blob size lacks.
  stored="$n"
  if [ "$STAGED" -eq 0 ] && [ -f "$f" ] && [ ! -L "$f" ]; then
    n="$(wc -c 2>/dev/null <"$f")" || collection_error document-measure-failed path "$f" "could not measure tracked document: $f"
    n="${n#"${n%%[![:space:]]*}"}"
  fi
  case "$n" in "" | *[!0-9]*) collection_error document-byte-count-invalid path "$f" "invalid byte count for tracked document: $f" ;; esac
  prior=0
  if [ -n "$AGAINST_OID" ]; then
    IFS= read -r against_rec <&4 || collection_error against-size-response-incomplete path "$f" "document size response for $AGAINST_REF is incomplete: $f"
    # REF holding no document at the path makes every byte growth, a rename
    # included: the check pairs documents by path alone.
    case "$against_rec" in
      "blob "*) prior="${against_rec#blob }" ;;
      "$AGAINST_OID:$f missing" | "tree "* | "commit "*) prior=0 ;;
      *) collection_error against-size-invalid path "$f" "unexpected size response for $f in $AGAINST_REF: $against_rec" ;;
    esac
    case "$prior" in "" | *[!0-9]*) collection_error against-byte-count-invalid path "$f" "invalid byte count for $f in $AGAINST_REF" ;; esac
  fi
  margin=$((limit * MARGIN_PCT / 100))
  if [ "$n" -gt "$limit" ]; then
    notice document-over-limit path "$f" "doc-limits FAIL: $f: $n bytes > $limit bytes (class $class)"
    remedy "$class"
    violations=$((violations + 1))
  elif [ -n "$AGAINST_OID" ] && [ "$stored" -gt "$prior" ] && [ "$n" -gt "$((limit - margin))" ]; then
    notice document-near-limit path "$f" "doc-limits FAIL: $f: stored size grown from $prior to $stored bytes; its $n bytes are within the $margin-byte margin under $limit bytes (class $class)"
    printf '  without this margin, this change and another landing beside it could each pass alone yet together carry this document past the limit\n'
    remedy "$class"
    violations=$((violations + 1))
  fi
  checked=$((checked + 1))
done <"$TMP/documents.tsv" 3<"$TMP/sizes" 4<"$TMP/against-sizes"
if [ "$violations" -gt 0 ]; then
  notice documents-over-limit count "$violations" "doc-limits: $violations over-limit or grown near-limit document(s), $checked checked"
  exit 1
fi
notice documents-checked count "$checked" "doc-limits: OK: $checked document(s) checked"
