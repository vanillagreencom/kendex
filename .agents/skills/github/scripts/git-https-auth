#!/usr/bin/env bash
# Git wrapper giving GitHub remotes gh's per-process HTTPS credentials.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/gh-auth.sh
source "$SCRIPT_DIR/lib/gh-auth.sh"

show_help() {
  cat <<'EOF'
Usage: git-https-auth [-C <path>] <git arguments...>

Runs git normally, but when the target repository or explicit URL uses a
GitHub SSH remote and gh auth is valid, the command gets temporary config:

  credential.helper = !gh auth git-credential
  url.https://github.com/.insteadOf = git@github.com:
  url.https://github.com/.insteadOf = ssh://git@github.com/

Set KENDEX_GITHUB_GIT_HTTPS_FALLBACK=never to disable this SSH fallback, or
=always to force it for GitHub operations.

When ORCH_GH_READ_TOKEN_FILE is set and the target repository or explicit URL
uses an HTTPS github.com remote, the command also gets, whatever the fallback
mode and without probing gh auth:

  credential.helper = !gh auth git-credential
  http.https://github.com/.extraheader = (empty, dropping inherited headers)

The config is per-process only and does not mutate repository or global git
config.
EOF
}

case "${1:-}" in
  ""|--help|-h)
    show_help
    exit 0
    ;;
esac

WORK_DIR="$(kendex_github_git_work_dir_from_args "$@")"
ENV_ROOT="$(cd "$WORK_DIR" 2>/dev/null && git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "$ENV_ROOT" ]]; then
  kendex_github_load_project_env_preserving_caller "$ENV_ROOT"
fi

kendex_github_git "$@"
