[env]

# GROWTH GUARDS — repo growth checks (growth-guards skill). Nothing below
# is marked `# required`, so installing this skill writes nothing into
# <project>/kendex.settings.toml. What an install writes, and when, is
# kendex's docs/authoring/settings.md. Every GROWTH_GUARDS_* key, and the
# default it ships, is in the skill's SKILL.md.

# Which checks the batch runs, space separated. The full list and what each
# one bans is in CHECKS.md; naming a subset is how a project takes the
# family a lane at a time.
GROWTH_GUARDS_CHECKS = "todo-ban byte-ceiling suppression-ban conflict-markers changelog-entries prose md-format md-refs"

# Kilobytes a single tracked file may reach before byte-ceiling refuses it.
# Declared asset trees are exempted through GROWTH_GUARDS_BYTE_EXCLUDES
# rather than by raising this.
GROWTH_GUARDS_BYTE_CEILING_KB = "200"

# The changelog-entries fragment tree: a space-separated list of shell globs
# against the full repo-relative path (`*` crosses `/`). Each match must be
# one Markdown list item under a Keep a Changelog section directory, within
# GROWTH_GUARDS_CHANGELOG_CAP characters. Paths matching no tracked file are
# a clean pass, so a project with no fragments needs no change here.
GROWTH_GUARDS_CHANGELOG_PATHS = "changelog.d/*/*.md"

# The collated record the same check's other scope judges: a line this commit
# adds under its `## [Unreleased]` heading is refused, because entries are
# written as fragments and folded in at release. Empty = no record scope.
GROWTH_GUARDS_CHANGELOG_RECORD = "CHANGELOG.md"

# Paths whose change obliges a changelog entry, checked by the commit-msg
# lane over the staged file list: a commit touching one must also write a
# fragment, or the record under GROWTH_GUARDS_CHANGELOG_COLLATE=1 (the
# release commit collating them), or carry [no-changelog] in its subject.
# Empty = rule off.
GROWTH_GUARDS_CHANGELOG_REQUIRED_PATHS = ""

# What md-format and md-refs judge with neither --staged nor --all: "touched"
# is the markdown files a commit touches, and nothing when nothing is staged;
# "all" is every tracked file the path globs name. Set "all" once the
# repository's markdown is reflowed (scripts/md-reflow --all), so CI judges
# the whole tree.
GROWTH_GUARDS_MD_SCOPE = "touched"

# The markdown md-format and md-reflow take under --all, and the markdown
# md-refs judges: space-separated shell globs against the full repo-relative
# path. GROWTH_GUARDS_MD_EXCLUDES (default tools/md-excludes, pattern<TAB>reason
# rows) drops vendored or generated markdown from both.
GROWTH_GUARDS_MD_PATHS = "*.md"

# The markdown md-refs judges under --all: the agent-loaded files and the
# architecture docs, space-separated shell globs against the full
# repo-relative path.
GROWTH_GUARDS_MD_REFS_PATHS = "AGENTS.md */AGENTS.md CLAUDE.md */CLAUDE.md SKILL.md */SKILL.md workflows/*.md */workflows/*.md agents/*.md */agents/*.md docs/architecture/*.md"

# The source files the comments lane reads, a space-separated list of shell
# globs against the full repo-relative path (`*` crosses `/`), replacing the
# default extension list in CHECKS.md § comments. Add the shapes an
# extension cannot name (`hooks/* */scripts/*`): a file with no extension
# takes the grammar its shebang names. The lane is opt-in: name `comments`
# in GROWTH_GUARDS_CHECKS to run it, and set GH_ISSUE_PATTERN (the github
# skill's key) to the tracker's own key shape.
# GROWTH_GUARDS_COMMENT_PATHS = ""

# The comments lane's exclusion list, pattern<TAB>reason rows naming the
# generated and vendored trees whose comments are not this repository's.
GROWTH_GUARDS_COMMENT_EXCLUDES = "tools/comments-excludes"

# Reference classes the comments lane checks. Empty disables references while
# GROWTH_GUARDS_COMMENT_REVISION_WORDS can keep revision narration enabled.
GROWTH_GUARDS_COMMENT_REFERENCE_TYPES = "issue-id issue-number date"

# POSIX ERE alternatives for revision narration in comments. Empty disables
# narration while GROWTH_GUARDS_COMMENT_REFERENCE_TYPES can keep references.
GROWTH_GUARDS_COMMENT_REVISION_WORDS = "previously|used to|no longer|reverted|an earlier|earlier round|incident|historically|originally|at the time|existing code"

# POSIX ERE alternatives for past-state words in agent-loaded prose. Empty
# disables the word class while dates and issue numbers stay enabled.
GROWTH_GUARDS_PROSE_REVISION_WORDS = "previously|used to|no longer|reverted|an earlier|earlier round|incident|historically|originally|at the time"

# Repo-local check the pre-commit shim runs LAST: a repo-root-relative
# executable following the family exit contract (0 clean, 1 violations,
# else "could not complete"); any nonzero blocks the commit, and so does a
# missing or non-executable value. Empty = no repo-local check.
GROWTH_GUARDS_PRE_COMMIT_LOCAL = ""
