#!/usr/bin/env bash
# prose — instruction markdown states the rule that holds now. A history
# reference in a file an agent loads (SKILL.md, workflows/*.md, agents/*.md,
# AGENTS.md, CLAUDE.md) fails: a calendar date, a three- or four-digit issue
# number, or a word naming a past state. An agent acts on the rule, and a
# rule wrapped in the story of how it got there costs every reader the same
# paragraph to discard. The story belongs in the commit that made the change.
#
# Scope is the whole rule: only the configured paths are scanned, so a
# reference doc, a changelog and a design record keep their history intact.
# GROWTH_GUARDS_PROSE_PATHS replaces the path list.
#
# Content comes from the index, like every scan in this family, and a
# configured path that is not readable markdown — a symlink, a submodule
# gitlink, binary content — is named as unmeasured rather than folded into
# the clean count. Matching is case-insensitive: the banned strings are
# words, and a sentence-initial capital is the same word.
#
# Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
set -euo pipefail
# Pathname expansion off: the configured paths are globs, and splitting them
# into words would otherwise expand each against the work tree — matching
# whatever happens to be checked out instead of the tracked paths the scan
# judges, and matching nothing at all in a sparse or bare checkout.
set -f

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The one newline `pwd` added; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="prose"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"

# The file names an agent harness loads on its own: a skill's entry point and
# its workflows, an agent definition, and the repo-level instruction files.
# Each name is spelled twice — at the repository root and anywhere below it —
# because `*` crosses `/` but never stands in for the separator itself, and
# the second spelling is also what reaches a rendered copy under `.claude/`
# or `.agents/`.
PATHS_DEFAULT="SKILL.md */SKILL.md AGENTS.md */AGENTS.md CLAUDE.md */CLAUDE.md workflows/*.md */workflows/*.md agents/*.md */agents/*.md"

usage() {
  cat <<EOF
usage: prose

A history reference in agent-loaded markdown fails: a calendar date
(20YY-MM-DD), a three- or four-digit issue number after '#', or a word
naming a past state. Matching is case-insensitive and reads index content.
Only the configured paths are scanned; a reference doc, a changelog and a
design record are out of scope by not being named. A configured path git
tracks as a symlink or a submodule, or whose content is binary, is named as
unmeasured.

Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  GROWTH_GUARDS_PROSE_PATHS   space-separated shell globs against the full
                              repo-relative path, '*' crossing '/' as in the
                              excludes lists
                              (default $PATHS_DEFAULT)

Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
EOF
}

if [ $# -gt 0 ]; then
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *) gg_config_error "unknown argument '$1' (see --help)" ;;
  esac
fi

gg_repo_root_cd

PATHS_RAW="$(gg_setting GROWTH_GUARDS_PROSE_PATHS "$PATHS_DEFAULT")" || exit 2

# The path list, its validation and its matcher are the family's, shared with
# the sibling lane scoped the same way: lib/common.sh § configured path globs.
gg_load_path_globs "$PATHS_RAW" prose GROWTH_GUARDS_PROSE_PATHS || exit 2

# History, and only history. The word list is the drift this catches in
# practice: a rule that reaches for one of them is narrating a change rather
# than stating what holds. Word boundaries are spelled as non-word characters
# rather than \< and \>, which are a GNU extension the regex engines behind
# `git grep` do not all carry. The issue-number shape takes no leading
# boundary — a reference glued to a filename ('spec.md#1204') is the same
# reference — and its trailing class excludes the hex digits, so neither a
# longer digit run nor a CSS colour ('#1234ab', '#0088cc') reads as one.
WORD='previously|used to|no longer|reverted|an earlier|earlier round|incident|historically|originally|at the time'
PROSE_ERE="20[0-9]{2}-[0-9]{2}-[0-9]{2}|#[0-9]{3,4}([^0-9A-Fa-f]|\$)|(^|[^[:alnum:]_])($WORD)([^[:alnum:]_]|\$)"

gg_tmpdir
# `ls-files -s` emits one record per STAGE for an unmerged path, so the walk
# below would read rival blobs as separate files.
gg_require_merged_index
git ls-files -sz >"$GG_TMP/files.z" || gg_collection_error "git ls-files failed"

skipped=0
note_skip() { # PATH REASON — a matched path this scan cannot measure
  echo "prose: not measured: $(gg_shown "$1") — $2"
  skipped=$((skipped + 1))
}

# Literal pathspecs, built from the walk rather than handing the configured
# globs to git: the family's glob contract is the shell's, and git's pathspec
# matching is a near neighbour, not the same rule. Building the list here is
# also what makes "nothing matched" visible — an empty pathspec list means
# EVERY tracked file to git, so a lane that passed it through would scan the
# whole repository the moment its configuration matched nothing.
#
# The mode is read for the same reason the sibling lane reads it: `git grep
# --cached` over a tracked symlink greps the TARGET PATH its blob holds, not
# the markdown a harness loads through it, and it does so with no status and
# no stderr — so the lane would print a clean verdict over a file it never
# read. A gitlink and a binary blob disappear the same silent way.
MATCHED_SPECS=()
matched=0
while IFS= read -r -d '' rec; do
  # Record shape: "<mode> <sha> <stage>\t<path>".
  f="${rec#*"$GG_TAB"}"
  gg_matches_path_glob "$f" || continue
  mode="${rec%% *}"
  case "$mode" in
    120000)
      note_skip "$f" "tracked as a symlink, not markdown"
      continue
      ;;
    160000)
      note_skip "$f" "tracked as a submodule gitlink, not markdown"
      continue
      ;;
  esac
  rest="${rec#* }"
  sha="${rest%% *}"
  git cat-file blob "$sha" >"$GG_TMP/blob" 2>"$GG_TMP/blob.err" \
    || { [ ! -s "$GG_TMP/blob.err" ] || cat -- "$GG_TMP/blob.err" >&2
      gg_collection_error "cannot read blob $sha for $(gg_shown "$f") — refusing to skip an unread file"; }
  if gg_blob_is_binary "$GG_TMP/blob" "$f"; then
    note_skip "$f" "binary content, not markdown"
    continue
  fi
  MATCHED_SPECS+=(":(literal)$f")
  matched=$((matched + 1))
done <"$GG_TMP/files.z"

UNMEASURED=""
[ "$skipped" -eq 0 ] || UNMEASURED="; $skipped matched path(s) not measured"

if [ "$matched" -eq 0 ]; then
  # Only when NOTHING was scanned: a path that matched and was skipped is
  # reported as skipped above, and telling its reader that no file matched
  # would send them to widen a glob that was already right.
  if [ "$skipped" -eq 0 ]; then
    echo "prose: OK — no tracked file matches GROWTH_GUARDS_PROSE_PATHS ($GG_PATH_GLOBS_SHOWN)"
  else
    echo "prose: OK — nothing measurable to scan$UNMEASURED"
  fi
  exit 0
fi

# The banned strings are words, so the same word opening a sentence is the
# same violation.
GG_GREP_LANE_FLAGS=(-i)
gg_grep_lane "history reference" "$PROSE_ERE" \
  "state the rule that holds now and delete the story; the date, the issue number and the past state belong in the commit that made the change" \
  "${MATCHED_SPECS[@]}"

if [ "$GG_VIOLATIONS" -gt 0 ]; then
  echo "prose: $GG_VIOLATIONS history reference(s) in $matched scanned file(s) — paths $GG_PATH_GLOBS_SHOWN$UNMEASURED"
  exit 1
fi
echo "prose: OK — no history references in $matched scanned file(s)$UNMEASURED"
