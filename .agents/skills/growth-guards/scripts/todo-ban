#!/usr/bin/env bash
# todo-ban — flat ban on work markers (TODO, FIXME, HACK, XXX in
# comment-marker shapes) in tracked files. Two scopes: the staged diff at
# commit (--staged), the whole index everywhere else. No baseline; vendored,
# generated and asset trees are excluded with a reason.
#
# Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
set -euo pipefail

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The one newline `pwd` added; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="todo-ban"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"
# shellcheck source=lib/staged-lines.sh
source "$SCRIPT_DIR/lib/staged-lines.sh"

usage() {
  cat <<'EOF'
usage: todo-ban [--staged] [--excludes FILE]

Flat ban on work markers (the words TODO, FIXME, HACK, XXX in
comment-marker shapes). Prose that quotes or names a marker word does not
fire.

  (default)   every tracked file, scanned from the index (CI scope)
  --staged    only the lines the staged diff ADDS (pre-commit scope)

Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  GROWTH_GUARDS_TODO_EXCLUDES   exclusion-list path (default tools/todo-ban-excludes)
Flag --excludes overrides the path setting.

Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
EOF
}

EXCLUDES_OPT=""
MODE="index"
while [ $# -gt 0 ]; do
  case "$1" in
    --staged) MODE="staged" ;;
    --excludes)
      [ $# -ge 2 ] || gg_config_error "--excludes requires a path"
      shift
      EXCLUDES_OPT="$1"
      ;;
    --excludes=*) EXCLUDES_OPT="${1#--excludes=}" ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) gg_config_error "unknown argument '$1' (see --help)" ;;
  esac
  shift
done

gg_repo_root_cd

EXCLUDES_FILE="$(gg_resolve_path "$EXCLUDES_OPT" GROWTH_GUARDS_TODO_EXCLUDES "tools/todo-ban-excludes" excludes)" || exit 2
gg_load_excludes "$EXCLUDES_FILE"
gg_tmpdir

# Marker shapes: the word at line start, after whitespace, or after a comment
# leader, immediately followed by ':' or '(' — and the bare word directly
# after a comment leader. A leader counts only at line start or after
# whitespace, so the `//` inside a URL or a path segment is never one, and a
# marker preceded by a backtick, a quote, or joined text matches neither
# shape. Case-sensitive: lowercase uses of the words are prose.
MARKER_ERE='(^|[[:space:]])(TODO|FIXME|HACK|XXX)[:(]|(^|[[:space:]])(//|#|;|<!--|/\*)[[:space:]]*(TODO|FIXME|HACK|XXX)([:(]|[[:space:]]|$)'
REMEDY="do the work now, or move it to the tracker and delete the marker; vendored/generated trees belong in $EXCLUDES_FILE with a reason"

# The pre-filter's pathspecs travel as argv, so a large change set is split
# rather than risking ARG_MAX. 256 paths is far inside every platform's
# limit even at the longest paths a repository can hold.
CARRIER_CHUNK=256

carriers_chunk() { # PATHSPEC... — append the carriers among them to the list
  local status=0
  # No -I: without it git grep matches in every blob, whatever an attributes
  # rule calls that blob, and -I would put the bypass the per-path read is
  # pinned against back in the fast path — where a skipped file reads as
  # clean. -a says the same intent outright; -l already pins the output form
  # to a path per line. What this scan lists is judged on CONTENT by the
  # family's shared sniff below, never on an attribute.
  LC_ALL=C git grep --cached -alzE "$MARKER_ERE" -- "$@" \
    >>"$GG_TMP/staged-carriers.z" 2>"$GG_TMP/staged-carriers.err" || status=$?
  gg_grep_guard "$status" "$GG_TMP/staged-carriers.err" "listing the staged files that carry a work marker"
}

staged_lane() { # numbered violations on stdout, counted in GG_VIOLATIONS
  local meta f dstmode dstsha rec carrier carrier_set grep_status
  local -a cand_records chunk
  gg_require_merged_index
  # A, M and T, with rename detection held to EXACT content for the reason
  # byte-ceiling holds it there: at 100% a pure move pairs as R and is
  # dropped — it adds no line — while a file that moved AND changed arrives
  # as an addition and is read whole.
  git -c diff.renames=true diff --cached --raw --no-abbrev -z --find-renames=100% \
    --diff-filter=AMT >"$GG_TMP/raw.z" \
    || gg_collection_error "could not collect the staged changes (git diff --cached --raw failed)"
  # List, then detail — the shape gg_grep_lane uses, with the list SCOPED to
  # the change set. The scan names every file whose staged content carries a
  # marker at all, and the per-file diff below is reached only for those, so
  # a commit touching hundreds of clean files spawns nothing per file. The
  # scope is what keeps the cost proportional to the commit: an unreadable
  # or not-yet-fetched blob the commit never touched cannot reach this
  # verdict, and a blobless partial clone does not fetch the whole
  # repository to make its first commit. It drops no true positive — a line
  # this commit ADDS is in the index blob this scan reads.
  cand_records=()
  chunk=()
  : >"$GG_TMP/staged-carriers.z"
  while IFS= read -r -d '' meta && IFS= read -r -d '' f; do
    # Record shape: ":srcmode dstmode srcsha dstsha status". Only A, M and T
    # survive the filter, none of which renames a path, so each carries one.
    set -- $meta
    dstmode="$2"
    dstsha="$4"
    case "$dstmode" in
      120000 | 160000) continue ;; # symlink / submodule gitlink — no lines to read
    esac
    gg_is_excluded "$f" && continue
    # The sha leads and the split takes the FIRST tab: a sha never holds one,
    # so a path that does still round-trips whole.
    cand_records+=("$dstsha$GG_TAB$f")
    chunk+=(":(literal)$f")
    if [ "${#chunk[@]}" -ge "$CARRIER_CHUNK" ]; then
      carriers_chunk "${chunk[@]}"
      chunk=()
    fi
  done <"$GG_TMP/raw.z"
  [ "${#chunk[@]}" -eq 0 ] || carriers_chunk "${chunk[@]}"
  # Membership is one newline-delimited set matched by `case`, not a loop per
  # staged path: that loop cost O(staged x carriers) and overtook the code it
  # replaced on a marker-dense tree. Bash 3.2 has no associative array, so the
  # set is a string and the search is the shell's own substring match. A path
  # holding a newline can only match spuriously, which costs one extra diff
  # and can hide no marker.
  carrier_set=$'\n'
  while IFS= read -r -d '' carrier; do
    carrier_set="$carrier_set$carrier"$'\n'
  done <"$GG_TMP/staged-carriers.z"
  for rec in ${cand_records[@]+"${cand_records[@]}"}; do
    dstsha="${rec%%"$GG_TAB"*}"
    f="${rec#*"$GG_TAB"}"
    # Only a path the scoped scan named can have an added line that matches.
    case "$carrier_set" in
      *$'\n'"$f"$'\n'*) ;;
      *) continue ;;
    esac
    # Carriers only, so the sniff is O(carriers) — not a cat-file per staged
    # file — and a genuinely binary blob never reaches the diff or the parser.
    # The judgement is the family's single content rule, in lib: a NUL in the
    # blob's leading bytes, git's own test. A text file under a '-diff' rule
    # is still read, while an asset whose bytes happen to spell a marker is
    # NAMED as unmeasured rather than decoded into a record of raw bytes.
    gg_read_blob "$dstsha" "$f" "work marker"
    if gg_blob_is_binary "$GG_TMP/blob" "$f"; then
      gg_note_skip "$f" "binary content, not text"
      continue
    fi
    gg_staged_added_lines "$f" >"$GG_TMP/added"
    grep_status=0
    # -a: a NUL past git's own binary sniff would otherwise make grep answer
    # with a one-line "binary file matches" summary, which this loop would
    # read as a violation record with no line number in it.
    LC_ALL=C grep -aE -- "$MARKER_ERE" "$GG_TMP/added" >"$GG_TMP/hits" || grep_status=$?
    # 1 is "this file's additions carry no marker"; anything above it is a
    # scan that did not happen, which must never read as clean.
    [ "$grep_status" -le 1 ] \
      || gg_collection_error "could not scan the staged additions in '$f' (grep exit $grep_status)"
    [ "$grep_status" -eq 0 ] || continue
    while IFS= read -r rec; do
      echo "$GG_CHECK FAIL work marker: $f:${rec%%"$GG_TAB"*}:${rec#*"$GG_TAB"}"
      echo "  remedies: $REMEDY"
      GG_VIOLATIONS=$((GG_VIOLATIONS + 1))
    done <"$GG_TMP/hits"
  done
}

# A carrier neither lane could decode is named as unmeasured and carried into
# the verdict, so an unread match cannot ride inside a plain OK.
unmeasured() { # the qualifier for this run, empty when everything matched was read
  [ "$GG_WALK_SKIPPED" -eq 0 ] || printf '; %s matched path(s) not measured' "$GG_WALK_SKIPPED"
}

if [ "$MODE" = "staged" ]; then
  staged_lane
  if [ "$GG_VIOLATIONS" -gt 0 ]; then
    echo "todo-ban: $GG_VIOLATIONS work marker(s) added by the staged diff — excludes $EXCLUDES_FILE$(unmeasured)"
    exit 1
  fi
  echo "todo-ban: OK — the staged diff adds no work markers$(unmeasured)"
  exit 0
fi

gg_grep_lane "work marker" "$MARKER_ERE" "$REMEDY" .

if [ "$GG_VIOLATIONS" -gt 0 ]; then
  echo "todo-ban: $GG_VIOLATIONS work marker(s) — excludes $EXCLUDES_FILE$(unmeasured)"
  exit 1
fi
echo "todo-ban: OK — no work markers in tracked files$(unmeasured)"
