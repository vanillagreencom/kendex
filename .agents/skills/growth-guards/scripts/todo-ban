#!/usr/bin/env bash
# todo-ban — flat ban on work markers (TODO, FIXME, HACK, XXX in
# comment-marker shapes) in tracked files. Two scopes: the staged diff at
# commit (--staged), the whole index everywhere else. No baseline; vendored,
# generated and asset trees are excluded with a reason.
#
# Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
set -euo pipefail

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The one newline `pwd` added; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="todo-ban"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"

usage() {
  cat <<'EOF'
usage: todo-ban [--staged] [--excludes FILE]

Flat ban on work markers (the words TODO, FIXME, HACK, XXX in
comment-marker shapes). Prose that quotes or names a marker word does not
fire.

  (default)   every tracked file, scanned from the index (CI scope)
  --staged    only the lines the staged diff ADDS (pre-commit scope)

Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  GROWTH_GUARDS_TODO_EXCLUDES   exclusion-list path (default tools/todo-ban-excludes)
Flag --excludes overrides the path setting.

Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
EOF
}

EXCLUDES_OPT=""
MODE="index"
while [ $# -gt 0 ]; do
  case "$1" in
    --staged) MODE="staged" ;;
    --excludes)
      [ $# -ge 2 ] || gg_config_error "--excludes requires a path"
      shift
      EXCLUDES_OPT="$1"
      ;;
    --excludes=*) EXCLUDES_OPT="${1#--excludes=}" ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) gg_config_error "unknown argument '$1' (see --help)" ;;
  esac
  shift
done

gg_repo_root_cd

EXCLUDES_FILE="$(gg_resolve_path "$EXCLUDES_OPT" GROWTH_GUARDS_TODO_EXCLUDES "tools/todo-ban-excludes" excludes)" || exit 2
gg_load_excludes "$EXCLUDES_FILE"
gg_tmpdir

# Marker shapes: the word at line start, after whitespace, or after a comment
# leader, immediately followed by ':' or '(' — and the bare word directly
# after a comment leader. A leader counts only at line start or after
# whitespace, so the `//` inside a URL or a path segment is never one, and a
# marker preceded by a backtick, a quote, or joined text matches neither
# shape. Case-sensitive: lowercase uses of the words are prose.
MARKER_ERE='(^|[[:space:]])(TODO|FIXME|HACK|XXX)[:(]|(^|[[:space:]])(//|#|;|<!--|/\*)[[:space:]]*(TODO|FIXME|HACK|XXX)([:(]|[[:space:]]|$)'
REMEDY="do the work now, or move it to the tracker and delete the marker; vendored/generated trees belong in $EXCLUDES_FILE with a reason"

added_lines() { # PATH — one "line<TAB>content" record per line this commit ADDS
  local f="$1" status=0 awk_status=0
  # Pinned diff configuration: an external differ or a textconv filter would
  # hand this lane content the commit does not carry, and colour would put
  # escape sequences in front of the leading '+'. One file per invocation,
  # named by a literal pathspec, so no patch header is ever parsed for a
  # path — a path git would have had to quote cannot be misread here.
  git -c core.quotePath=false diff --cached --no-ext-diff --no-textconv --no-color \
    -U0 -- ":(literal)$f" \
    >"$GG_TMP/patch" 2>"$GG_TMP/patch.err" || status=$?
  if [ "$status" -ne 0 ]; then
    [ ! -s "$GG_TMP/patch.err" ] || cat -- "$GG_TMP/patch.err" >&2
    gg_collection_error "could not read the staged additions in '$f' (git diff exit $status)"
  fi
  # Line numbers come from the hunk headers ('@@ -a,b +c,d @@'), and only
  # lines inside a hunk count — every 'diff --git' closes the hunk before
  # it, so a file header is never read as one. A type change emits TWO
  # sections for one path, and without that reset the second section's
  # '+++' line would print as an added line at the first section's
  # numbering. A binary file has no hunks and contributes nothing.
  awk '
    /^diff --git / { hunk = 0; next }
    /^@@/ {
      h = $3
      sub(/^\+/, "", h)
      i = index(h, ",")
      ln = (i > 0 ? substr(h, 1, i - 1) : h) + 0
      hunk = 1
      next
    }
    hunk && /^\+/ { print ln "\t" substr($0, 2); ln++; next }
    hunk && /^ / { ln++; next }
  ' "$GG_TMP/patch" || awk_status=$?
  [ "$awk_status" -eq 0 ] \
    || gg_collection_error "could not parse the staged additions in '$f' (awk exit $awk_status)"
}

staged_lane() { # numbered violations on stdout, counted in GG_VIOLATIONS
  local meta f dstmode grep_status rec carrier carries filter_status=0
  local -a carriers_list
  gg_require_merged_index
  # List, then detail — the shape gg_grep_lane uses. One flat index scan
  # names every file whose staged content carries a marker at all, and the
  # per-file diff below is reached only for those, so a commit touching
  # hundreds of clean files spawns nothing per file. It cannot drop a true
  # positive: a line this commit ADDS is in the index blob this scan reads.
  LC_ALL=C git grep --cached -lIzE "$MARKER_ERE" >"$GG_TMP/carriers.z" 2>"$GG_TMP/carriers.err" \
    || filter_status=$?
  gg_grep_guard "$filter_status" "$GG_TMP/carriers.err" "listing the staged files that carry a work marker"
  carriers_list=()
  while IFS= read -r -d '' carrier; do carriers_list+=("$carrier"); done <"$GG_TMP/carriers.z"
  # A, M and T, with rename detection held to EXACT content for the reason
  # byte-ceiling holds it there: at 100% a pure move pairs as R and is
  # dropped — it adds no line — while a file that moved AND changed arrives
  # as an addition and is read whole.
  git -c diff.renames=true diff --cached --raw --no-abbrev -z --find-renames=100% \
    --diff-filter=AMT >"$GG_TMP/raw.z" \
    || gg_collection_error "could not collect the staged changes (git diff --cached --raw failed)"
  while IFS= read -r -d '' meta && IFS= read -r -d '' f; do
    # Record shape: ":srcmode dstmode srcsha dstsha status". Only A, M and T
    # survive the filter, none of which renames a path, so each carries one.
    set -- $meta
    dstmode="$2"
    case "$dstmode" in
      120000 | 160000) continue ;; # symlink / submodule gitlink — no lines to read
    esac
    gg_is_excluded "$f" && continue
    # Only a path the index scan named can have an added line that matches.
    carries=0
    for carrier in ${carriers_list[@]+"${carriers_list[@]}"}; do
      if [ "$carrier" = "$f" ]; then
        carries=1
        break
      fi
    done
    [ "$carries" -eq 1 ] || continue
    added_lines "$f" >"$GG_TMP/added"
    grep_status=0
    # -a: a NUL past git's own binary sniff would otherwise make grep answer
    # with a one-line "binary file matches" summary, which this loop would
    # read as a violation record with no line number in it.
    LC_ALL=C grep -aE -- "$MARKER_ERE" "$GG_TMP/added" >"$GG_TMP/hits" || grep_status=$?
    # 1 is "this file's additions carry no marker"; anything above it is a
    # scan that did not happen, which must never read as clean.
    [ "$grep_status" -le 1 ] \
      || gg_collection_error "could not scan the staged additions in '$f' (grep exit $grep_status)"
    [ "$grep_status" -eq 0 ] || continue
    while IFS= read -r rec; do
      echo "$GG_CHECK FAIL work marker: $f:${rec%%"$GG_TAB"*}:${rec#*"$GG_TAB"}"
      echo "  remedies: $REMEDY"
      GG_VIOLATIONS=$((GG_VIOLATIONS + 1))
    done <"$GG_TMP/hits"
  done <"$GG_TMP/raw.z"
}

if [ "$MODE" = "staged" ]; then
  staged_lane
  if [ "$GG_VIOLATIONS" -gt 0 ]; then
    echo "todo-ban: $GG_VIOLATIONS work marker(s) added by the staged diff — excludes $EXCLUDES_FILE"
    exit 1
  fi
  echo "todo-ban: OK — the staged diff adds no work markers"
  exit 0
fi

gg_grep_lane "work marker" "$MARKER_ERE" "$REMEDY" .

if [ "$GG_VIOLATIONS" -gt 0 ]; then
  echo "todo-ban: $GG_VIOLATIONS work marker(s) — excludes $EXCLUDES_FILE"
  exit 1
fi
echo "todo-ban: OK — no work markers in tracked files"
