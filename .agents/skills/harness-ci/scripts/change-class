#!/usr/bin/env bash
# change-class — what kind of change is this diff?
#
# Usage:
#   change-class --event EVENT [--base REF] [--head REF] [--repo DIR]
#                [--output FILE] [--paths-output FILE]
#
# Flags carry the meanings `harness-only --help` gives them; this script hands
# them to that shipped classifier, which stays the one reader of a diff range.
# stdout carries change_class=render|trivial|micro|small|standard and nothing
# else, stderr the changed paths and the reason, and exit 2 a wiring error
# that carries no verdict. The classes, first match winning:
#
#   render   every changed path is a file kendex generated, no configuration
#            or instruction source among them, and `kendex verify` confirms
#            that re-rendering at the lock's recorded source commits produces
#            no difference. Provenance is proved by rendering, never by
#            trusting .kendex-generated.json, which the branch can rewrite.
#   trivial  every changed path is on HARNESS_CI_TRIVIAL_PATHS, blank-separated
#            globs defaulting to the `harness-only --mode docs` set, and the
#            change is within HARNESS_CI_TRIVIAL_MAX_LINES (default 20).
#   micro    production additions within the micro ceiling, no excluded path.
#   small    one subsystem, production additions within the small ceiling, no
#            excluded path. Those two ceilings and that path list are orch's
#            references/narrow-change.conf, beside this package.
#   standard everything else, and every diff this script cannot prove into a
#            narrower class. Fail-closed: standard buys a diff nothing.
#
# THE CLASS IS NEVER READ FROM A LABEL, A BRANCH NAME, A PULL REQUEST TITLE or
# any other author-writable field, and no flag carries one: the author of the
# diff being judged writes all of them, so trusting one fails open on exactly
# the diffs that most want to pass. A caller that acts on the verdict without
# review runs the DEFAULT BRANCH's copy of this script against the pull
# request's tree; the branch can change this file too.
#
# Measuring a size needs orch installed and the merge-base range of an open
# pull request, so any other --event, and a checkout without orch, answer
# render or standard and never a measured class.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HARNESS_ONLY="$SCRIPT_DIR/harness-only"
ORCH_DIR="$SCRIPT_DIR/../../orch"
NARROW_CONF="$ORCH_DIR/references/narrow-change.conf"

event=""
base=""
head="HEAD"
repo="."
output="${GITHUB_OUTPUT:-}"
paths_output=""
changed=""

usage() { sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

die() { # FIELDS MESSAGE — a wiring error, never a verdict
  printf 'wiring-error: %s\n' "$1" >&2
  echo "change-class: $2" >&2
  exit 2
}

need_value() { # FLAG REMAINING NEXT
  [ "$2" -ge 2 ] || die "cause=missing-value option=$1" "$1 needs a value"
  case "$3" in
    -?*) die "cause=flag-used-as-value option=$1 value=$3" \
      "$1 needs a value, got the flag '$3'" ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --event) need_value "$1" "$#" "${2:-}"; event="$2"; shift 2 ;;
    --base) need_value "$1" "$#" "${2:-}"; base="$2"; shift 2 ;;
    --head) need_value "$1" "$#" "${2:-}"; head="$2"; shift 2 ;;
    --repo) need_value "$1" "$#" "${2:-}"; repo="$2"; shift 2 ;;
    --output) need_value "$1" "$#" "${2:-}"; output="$2"; shift 2 ;;
    --paths-output) need_value "$1" "$#" "${2:-}"; paths_output="$2"; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) die "cause=unknown-argument argument=$1" "unknown argument '$1'" ;;
  esac
done

[ -n "$event" ] || die "cause=missing-event option=--event" "--event is required"

work="$(mktemp -d 2>/dev/null)" || work=""
[ -n "$work" ] && [ -d "$work" ] ||
  die "cause=scratch-unavailable" "a scratch directory could not be created"
trap 'rm -rf "$work"' EXIT
paths_file="$work/paths"

# The output FILE is written before stdout, as harness-only writes its own: a
# verdict printed first would already have been read when the append died.
answer() { # CLASS FIELDS
  if [ -n "$paths_output" ]; then
    if ! { printf '%s\n' "$changed" >"$paths_output"; } 2>/dev/null; then
      die "cause=paths-output-write-failed" \
        "could not write the changed paths to '$paths_output'"
    fi
  fi
  if [ -n "$output" ]; then
    if ! { printf 'change_class=%s\n' "$1" >>"$output"; } 2>/dev/null; then
      die "cause=output-write-failed" \
        "could not append the verdict to '$output'"
    fi
  fi
  printf 'class: class=%s %s\n' "$1" "$2" >&2
  printf 'change_class=%s\n' "$1"
  exit 0
}

# harness-only owns the diff range for every event, its endpoint refusals, and
# the generated-path ownership rules the render class needs. Nothing here
# reads a range a second time. Its own notices are held back and only its
# `changed-path:` lines repeated: the rest answers a different question.
# The flags travel as an array, so a value holding a space stays one word.
harness_args=(--event "$event" --head "$head" --repo "$repo")
[ -z "$base" ] || harness_args=("${harness_args[@]}" --base "$base")
if ! harness_verdict="$("$HARNESS_ONLY" --mode harness "${harness_args[@]}" \
  --paths-output "$paths_file" --output /dev/null 2>"$work/harness-stderr")"; then
  cat "$work/harness-stderr" >&2
  die "cause=harness-only-failed event=$event" \
    "the shipped harness-only classifier refused this call"
fi
sed -n '/^changed-path: /p' "$work/harness-stderr" >&2

[ -s "$paths_file" ] || answer standard "cause=no-changed-paths"
changed="$(cat -- "$paths_file")"

# Splitting a blank-separated list leaves each word open to pathname
# expansion, and a glob naming a real directory would be replaced by the files
# under the caller's working directory. Expansion is off for the split alone.
GLOB_LIST=()
set_globs() { # GLOBS
  set -f
  # shellcheck disable=SC2206
  GLOB_LIST=($1)
  set +f
}

# One matcher and one glob grammar for the allowlist and the refusal list.
PATH_MATCH_HIT=""
path_matches() { # MODE(every|any) — against GLOB_LIST
  local path glob hit
  PATH_MATCH_HIT=""
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    hit=false
    for glob in ${GLOB_LIST[@]+"${GLOB_LIST[@]}"}; do
      # shellcheck disable=SC2254
      case "$path" in
        $glob) hit=true; PATH_MATCH_HIT="path=$path glob=$glob"; break ;;
      esac
    done
    if [ "$1" = any ]; then
      [ "$hit" = false ] || return 0
    else
      [ "$hit" = true ] || return 1
    fi
  done <<<"$changed"
  [ "$1" = every ]
}

# `kendex verify` weighs the manifest and render bytes the lock records, so a
# clean run proves a refresh at those source commits produces no difference.
# It reads the tree as data and executes nothing from it, and the
# configuration it renders through is the base branch's, because the rule
# above refuses a diff that touches one. A missing binary, or any non-zero
# verdict, leaves render unproven.
renders_match() {
  command -v kendex >/dev/null 2>&1 || return 1
  (cd -- "$repo" && kendex verify --scope project) >/dev/null 2>&1
}

if [ "$harness_verdict" = "harness_only=true" ]; then
  set_globs 'kendex.toml kendex.settings.toml kendex-local.toml
    .kendex/settings.toml AGENTS.md */AGENTS.md'
  if path_matches any; then
    printf 'class-note: cause=configuration-source\n' >&2
  elif renders_match; then
    answer render "cause=renders-match-their-sources"
  else
    printf 'class-note: cause=render-unverified\n' >&2
  fi
fi

# Every measured class shares orch's branch growth reader, which owns the
# production/test split and the render-mirror pairing branch-size-check judges
# an allowance by. It measures the branch against its base branch, the range
# harness-only reads for a pull_request and for no other event.
production=""
total=""
measure() {
  [ "$event" = pull_request ] || return 1
  [ -r "$ORCH_DIR/scripts/lib/branch-growth.sh" ] || return 1
  [ -x "$ORCH_DIR/scripts/resolve-base-branch" ] || return 1
  # shellcheck source=../../orch/scripts/lib/branch-growth.sh
  . "$ORCH_DIR/scripts/lib/branch-growth.sh" || return 1
  branch_size_classified "$repo" "$ORCH_DIR/scripts/resolve-base-branch" \
    "$head" "${ORCH_SIZE_TEST_PATHS:-}" || return 1
  production="$BRANCH_SIZE_PRODUCTION"
  total="$BRANCH_SIZE_BASELINE"
}
measure || answer standard "cause=size-unmeasured event=$event"

trivial_max="${HARNESS_CI_TRIVIAL_MAX_LINES:-20}"
case "$trivial_max" in
  '' | *[!0123456789]*)
    die "cause=invalid-setting setting=HARNESS_CI_TRIVIAL_MAX_LINES" \
      "HARNESS_CI_TRIVIAL_MAX_LINES must be a whole number" ;;
esac
if [ "$total" -le "$trivial_max" ]; then
  if [ -n "${HARNESS_CI_TRIVIAL_PATHS:-}" ]; then
    set_globs "$HARNESS_CI_TRIVIAL_PATHS"
    path_matches every &&
      answer trivial "cause=allowlisted-paths lines=$total"
  else
    # The shipped allowlist is that mode's own path set, read from its verdict.
    if docs_verdict="$("$HARNESS_ONLY" --mode docs "${harness_args[@]}" \
      --output /dev/null 2>/dev/null)" &&
      [ "$docs_verdict" = "docs_only=true" ]; then
      answer trivial "cause=documentation-paths lines=$total"
    fi
  fi
fi

[ -r "$NARROW_CONF" ] || answer standard "cause=narrow-change-list-unreadable"
excluded="$(sed -n 's/^path //p' "$NARROW_CONF" | tr '\n' ' ')" ||
  answer standard "cause=narrow-change-list-unreadable"
set_globs "$excluded"
if path_matches any; then
  answer standard "cause=excluded-path $PATH_MATCH_HIT"
fi

ceiling() { sed -n "s/^$1=\([0123456789][0123456789]*\)\$/\1/p" "$NARROW_CONF" | tail -1; }
micro_max=""
small_max=""
if ! { micro_max="$(ceiling micro_max_production)" &&
  small_max="$(ceiling small_max_production)" &&
  [ -n "$micro_max" ] && [ -n "$small_max" ]; }; then
  answer standard "cause=narrow-change-ceilings-missing"
fi

[ "$production" -gt "$micro_max" ] ||
  answer micro "cause=production-within-micro production=$production"

# One subsystem: every changed path shares a top directory, read past a
# leading dot-directory so a source and the render root mirroring it agree.
subsystem=""
one_subsystem=true
while IFS= read -r path; do
  [ -n "$path" ] || continue
  top="${path%%/*}"
  case "$top" in
    .?*) rest="${path#*/}"; top="${rest%%/*}" ;;
  esac
  if [ -z "$subsystem" ]; then
    subsystem="$top"
  elif [ "$subsystem" != "$top" ]; then
    one_subsystem=false
    break
  fi
done <<<"$changed"

[ "$one_subsystem" = true ] ||
  answer standard "cause=several-subsystems production=$production"
[ "$production" -gt "$small_max" ] ||
  answer small "cause=production-within-small subsystem=$subsystem"
answer standard "cause=production-past-small production=$production"
