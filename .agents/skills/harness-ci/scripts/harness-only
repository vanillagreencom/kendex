#!/usr/bin/env bash
# harness-only — may this diff skip a configured family of CI checks?
#
# One reader of a diff's changed-file set, answering the one question CI asks
# about it: may the heavy lanes stand down? By default, the engine records its
# rendered files in .kendex-generated.json. Carrier packages and in-place
# sources stay outside that inventory and always run product checks.
# `--mode docs` instead accepts docs/, changelog.d/, and root Markdown files.
# `--mode render-candidate` permits new head-owned paths and the adopted refresh
# caller without an inventory entry to gate render-proof prerequisites. It
# never authorizes a CI skip.
# Caller contract: ../SKILL.md § Shared refresh caller ownership.
#
# Usage:
#   harness-only [--mode harness|docs|render-candidate] --event EVENT [--base REF] [--head REF]
#                [--repo DIR] [--output FILE] [--paths-output FILE]
#                [--outside-output FILE]
#
#   --mode    harness (default) | docs | render-candidate.
#   --event   pull_request | merge_group | push. Any other event answers false.
#   --base    the base endpoint: the PR base sha, the merge group's base sha,
#             or a push's `before` sha.
#   --head    the head endpoint. Default HEAD.
#   --repo    classify this checkout instead of the working directory.
#   --output  append the verdict line to this file. Default $GITHUB_OUTPUT.
#   --paths-output  overwrite this file with the changed paths used by the
#             classifier, one path per line. Default: do not write a file.
#   --outside-output  docs mode: overwrite this file with every changed path
#             outside the docs set, one path per line, empty on a true
#             verdict, on a false one reached before any path was read,
#             and in harness mode, which reads no docs set.
#             The change-class action reads it to tell an unclaimed path
#             the docs set holds from one it does not. Default: do not
#             write a file.
#
# stdout carries the selected verdict line and nothing else:
# harness_only=true|false, docs_only=true|false, or render_candidate=true|false.
# A stderr refusal starts with `wiring-error: cause=...`. A false-verdict
# notice starts with `fallback: cause=...`. The English explanation follows
# that stable key/value line in the job log.
#
# stderr also carries `changed-path: path=<q>` per changed path and, in
# harness mode once the range's base end is resolved, one `base-rev: <rev>`
# line naming the revision the diff was taken from — the merge base on a
# pull request, the commit the base endpoint resolved to on the others — and
# one `head-rev: <rev>` line naming the commit the head endpoint resolved to.
# A caller that must read the same range's committed state reads those lines
# rather than resolving either endpoint a second time. Where the diff changes
# .kendex-generated.json, every entry it gains names a render mirror the same
# diff adds beside its source, and every entry it loses a path the same diff
# deletes, one `inventory-change: names-only added=<n> removed=<n>
# roots=<root>[,<root>...]|-` line says so; change-class reads it.
#
# Exit 0 on any verdict. Exit 2 on a WIRING error — an unknown flag, a missing
# --event, a flag where a value belongs, an unwritable --output. Those are
# never transient, so they must not be absorbed as a classification: the step
# goes red and the caller sees it.
#
# Fail-closed everywhere. An unknown event, a missing or unresolvable
# endpoint, an unreadable diff and an empty diff all answer false, which runs
# every lane.
#
# Strict mode throughout. Every failure a verdict can be read from is handled
# on the spot with an explicit `||`; anything left over is a defect in this
# script, and a red step is the honest report of one.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# shellcheck source=lib/change-class.sh
. "$SCRIPT_DIR/lib/change-class.sh"

event=""
base=""
head="HEAD"
repo="."
output="${GITHUB_OUTPUT:-}"
paths_output=""
outside_output=""
changed=""
outside=""
base_rev=""
head_rev=""
inventory_change=""
classification="harness"
verdict_key="harness_only"
tool_name="harness-only"

usage() {
  cat <<'USAGE'
Usage: harness-only [--mode harness|docs|render-candidate] --event EVENT [--base REF] [--head REF]
                    [--repo DIR] [--output FILE] [--paths-output FILE]
                    [--outside-output FILE]

  --mode    harness (default): accept generated harness files.
            docs: accept docs/, changelog.d/, and root .md or .markdown files.
            render-candidate: permit new head-owned paths and the adopted
            refresh caller without an inventory entry for prerequisites only.
            No CI skip is authorized; change-class must prove render.
            Caller contract: ../SKILL.md, Shared refresh caller ownership.
  --event   pull_request | merge_group | push. Any other event answers false.
  --base    the base endpoint: the PR base sha, the merge group's base sha,
            or a push's `before` sha.
  --head    the head endpoint. Default HEAD.
  --repo    classify this checkout instead of the working directory.
  --output  append the verdict line to this file. Default $GITHUB_OUTPUT.
  --paths-output  overwrite this file with the changed paths used by the
            classifier, one path per line.
  --outside-output  docs mode: overwrite this file with the changed paths
            outside the docs set, one path per line.

Prints harness_only=true|false, docs_only=true|false, or render_candidate=true|false.
Exit 2 on a wiring error.
USAGE
}

stable_value() { # VALUE
  printf '%q' "$1"
}

die() { # FIELDS MESSAGE — a wiring error, never a verdict
  printf 'wiring-error: %s\n' "$1" >&2
  echo "$tool_name: $2" >&2
  exit 2
}

report_changed_paths() {
  local changed_path
  while IFS= read -r changed_path; do
    [ -n "$changed_path" ] || continue
    printf 'changed-path: path=%q\n' "$changed_path" >&2
  done <<<"${changed:-}"
}

# `shift 2` past the end of "$@" returns non-zero and shifts nothing. Every
# value-taking flag proves its value is there first, rather than leaving the
# argument loop to exit on a shift.
#
# A flag-shaped value is the same wiring error one step later: `--event --base`
# would take `--base` as the event, classify it as unrecognised, and hand back
# a verdict for a call that named no event at all. No option here takes a value
# that starts with a dash; a path that does is reachable as `./-name`.
need_value() { # FLAG REMAINING NEXT
  [ "$2" -ge 2 ] || die \
    "cause=missing-value option=$(stable_value "$1")" \
    "$1 needs a value"
  case "$3" in
    -?*) die \
      "cause=flag-used-as-value option=$(stable_value "$1") value=$(stable_value "$3")" \
      "$1 needs a value, got the flag '$3'" ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --event) need_value "$1" "$#" "${2:-}"; event="$2"; shift 2 ;;
    --base) need_value "$1" "$#" "${2:-}"; base="$2"; shift 2 ;;
    --head) need_value "$1" "$#" "${2:-}"; head="$2"; shift 2 ;;
    --repo) need_value "$1" "$#" "${2:-}"; repo="$2"; shift 2 ;;
    --output) need_value "$1" "$#" "${2:-}"; output="$2"; shift 2 ;;
    --paths-output) need_value "$1" "$#" "${2:-}"; paths_output="$2"; shift 2 ;;
    --outside-output) need_value "$1" "$#" "${2:-}"; outside_output="$2"; shift 2 ;;
    --mode)
      need_value "$1" "$#" "${2:-}"
      case "$2" in
        harness)
          classification="harness"
          verdict_key="harness_only"
          tool_name="harness-only"
          ;;
        docs)
          classification="docs"
          verdict_key="docs_only"
          tool_name="docs-only"
          ;;
        render-candidate)
          classification="render-candidate"
          verdict_key="render_candidate"
          tool_name="render-candidate"
          ;;
        *) die "cause=unknown-mode mode=$(stable_value "$2")" \
          "unknown classification mode '$2'" ;;
      esac
      shift 2
      ;;
    -h | --help) usage; exit 0 ;;
    *) die "cause=unknown-argument argument=$(stable_value "$1")" \
      "unknown argument '$1'" ;;
  esac
done

[ -n "$event" ] || die "cause=missing-event option=--event" \
  "--event is required"
[ -n "$head" ] || die "cause=empty-value option=--head" \
  "--head cannot be empty"


# The output FILE is written before stdout, never after. A zero-length probe
# proves only that the file opens — /dev/full and a full filesystem both accept
# it and fail the real write — so a verdict printed first would already be on
# stdout when the append died, and exit 2 is documented to carry no verdict.
write_paths() { # FILE LIST CAUSE — overwrite FILE with LIST, one per line
  if ! { if [ -n "$2" ]; then
    printf '%s\n' "$2" >"$1"
  else
    : >"$1"
  fi; } 2>/dev/null; then
    die "cause=$3" "could not write the changed paths to '$1'"
  fi
}

verdict() { # true|false [FIELDS REASON]
  [ -z "$paths_output" ] ||
    write_paths "$paths_output" "$changed" paths-output-write-failed
  [ -z "$outside_output" ] ||
    write_paths "$outside_output" "$outside" outside-output-write-failed
  if [ -n "$output" ]; then
    if ! { printf '%s=%s\n' "$verdict_key" "$1" >>"$output"; } 2>/dev/null; then
      die "cause=output-write-failed" \
        "could not append the verdict to '$output'"
    fi
  fi
  if [ "$#" -gt 1 ]; then
    printf 'fallback: %s\n' "$2" >&2
    echo "$tool_name: $3; running every lane" >&2
  fi
  report_changed_paths
  [ -z "$base_rev" ] || printf 'base-rev: %s\n' "$base_rev" >&2
  [ -z "$head_rev" ] || printf 'head-rev: %s\n' "$head_rev" >&2
  [ -z "$inventory_change" ] || printf 'inventory-change: %s\n' "$inventory_change" >&2
  printf '%s=%s\n' "$verdict_key" "$1"
  exit 0
}

# core.quotePath=false keeps non-ASCII paths raw instead of C-quoted. git still
# quotes a path holding a newline or a double quote, and a quoted path starts
# with `"`, matches no harness prefix, and answers false — fail-closed, which is
# the right answer for a path this line-oriented reader cannot represent.
git_repo() { git -C "$repo" -c core.quotePath=false "$@"; }

# Three-dot on pull_request: the base branch moves under an open PR, and only
# the merge base isolates what the PR itself changed.
#
# Two endpoints, no dots, on push and merge_group. A force-push leaves the
# `before` sha off HEAD's history, and three-dot would then measure from a
# merge base where the product files the push discarded never existed, reading
# the whole push as render-only. A merge group's base is an ancestor of its
# head by construction, so the two forms agree there; the endpoint form is
# what stays correct if that ever stops holding.
case "$event" in
  pull_request) range_style=merge_base ;;
  merge_group | push) range_style=endpoints ;;
  *) verdict false \
    "cause=unsupported-event event=$(stable_value "$event")" \
    "no diff endpoints are defined for event '$event'" ;;
esac

[ -n "$base" ] || verdict false \
  "cause=missing-base event=$(stable_value "$event")" \
  "no base endpoint was given for event '$event'"

for endpoint in "$base" "$head"; do
  git_repo cat-file -e "${endpoint}^{commit}" 2>/dev/null ||
    verdict false \
      "cause=unresolved-endpoint endpoint=$(stable_value "$endpoint")" \
      "endpoint '$endpoint' does not resolve to a commit"
done

if [ "$range_style" = merge_base ]; then
  range="$base...$head"
  changed="$(git_repo diff --name-only --no-renames "$range" 2>/dev/null)" ||
    verdict false \
      "cause=unreadable-diff range=$(stable_value "$range")" \
      "the diff '$range' is unreadable"
else
  changed="$(git_repo diff --name-only --no-renames "$base" "$head" 2>/dev/null)" ||
    verdict false \
      "cause=unreadable-diff base=$(stable_value "$base") head=$(stable_value "$head")" \
      "the diff '$base' '$head' is unreadable"
fi

# An empty list is not "nothing to run": it is also what a diff that silently
# read nothing looks like, and neither answer is worth a waiver.
[ -n "$changed" ] ||
  verdict false \
    "cause=empty-diff base=$(stable_value "$base") head=$(stable_value "$head")" \
    "the diff between '$base' and '$head' is empty"

# Every changed path is read, not only up to the first outside the set, so
# --outside-output lists them all; the verdict names the first.
if [ "$classification" = docs ]; then
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    case "$path" in
      docs/* | changelog.d/*) continue ;;
      */*) ;;
      *.md | *.markdown) continue ;;
    esac
    outside="${outside:+$outside
}$path"
  done <<<"$changed"
  [ -z "$outside" ] || {
    first="${outside%%
*}"
    verdict false \
      "cause=path-outside-docs-only path=$(stable_value "$first")" \
      "changed path '$first' is outside the docs-only set"
  }
  verdict true
fi

# Read the writer's exact output paths at both selected endpoints. A missing
# inventory runs product checks, including the commit that first installs it.
if [ "$range_style" = merge_base ]; then
  base="$(git_repo merge-base "$base" "$head")" || verdict false \
    "cause=unreadable-merge-base" "merge base is unreadable"
else
  named_base="$base"
  base="$(git_repo rev-parse --verify --quiet "${base}^{commit}")" || verdict false \
    "cause=unresolved-endpoint endpoint=$(stable_value "$named_base")" \
    "endpoint '$named_base' does not resolve to a commit"
fi
# Both ends of the range, resolved. Published on every verdict from here on,
# so a caller reading the same range's committed state takes these revisions
# instead of resolving an endpoint itself and disagreeing about the range.
head_rev="$(git_repo rev-parse --verify --quiet "${head}^{commit}")" || verdict false \
  "cause=unresolved-endpoint endpoint=$(stable_value "$head")" \
  "endpoint '$head' does not resolve to a commit"
base_rev="$base"
# A base older than the render that first wrote the inventory holds none,
# which is a long-lived branch's normal state rather than a failed read:
# generated ownership at that end is not recorded, so the diff runs product
# checks. Its own cause says so, and change-class answers it standard as a
# fixed rule. An inventory the base does hold and git cannot read, or one
# that does not parse below, stays unreadable.
base_entry="$(git_repo ls-tree --full-tree "$base" -- .kendex-generated.json 2>/dev/null)" ||
  verdict false \
    "cause=unreadable-base-inventory base=$(stable_value "$base")" \
    "base generated paths are unreadable"
[ -n "$base_entry" ] || verdict false \
  "cause=base-inventory-absent base=$(stable_value "$base")" \
  "the base holds no generated-path inventory, so ownership there is not recorded"
base_inventory="$(git_repo show "$base:.kendex-generated.json" 2>/dev/null)" || verdict false \
  "cause=unreadable-base-inventory base=$(stable_value "$base")" \
  "base generated paths are unreadable"
head_inventory="$(git_repo show "$head:.kendex-generated.json" 2>/dev/null)" || verdict false \
  "cause=unreadable-head-inventory head=$(stable_value "$head")" \
  "head generated paths are absent or unreadable"
# The array contains files, never folder prefixes. A file must be generated
# at each endpoint where it exists, so adopting a render as source runs checks.
inventory_paths() { # JSON — validate writer entries and retain only their paths
  jq -ecs '
    def path_string: type == "string" and length > 0
      and (contains("\n") or contains("\u0000") | not);
    def entry: if type == "string" then path_string
      elif type == "object" then
        keys == ["path", "template", "templateHash"]
        and (.path | path_string) and (.template | path_string)
        and (.templateHash | type == "string" and length == 71 and test("^sha256:[0-9a-f]{64}$"))
      else false end;
    if length == 1 and (.[0] | type == "array" and all(.[]; entry))
    then .[0] | map(if type == "string" then . else .path end)
    else "" | halt_error(21) end
  ' <<<"$1"
}
base_document="$base_inventory"
head_document="$head_inventory"
base_inventory="$(inventory_paths "$base_inventory" 2>/dev/null)" \
  || verdict false "cause=invalid-generated-paths" "generated paths are invalid"
head_inventory="$(inventory_paths "$head_inventory" 2>/dev/null)" \
  || verdict false "cause=invalid-generated-paths" "generated paths are invalid"

# The inventory's own change, for change-class: `names-only` where every entry
# the inventory gains names a render mirror this diff adds, ROOT/SOURCE with
# SOURCE added by the same diff, and every entry it loses a path this diff
# deletes. `roots=` lists each ROOT, `-` for none, and change-class holds them
# to the measurement's render roots, which this script does not read. The
# pairing is exact, narrower than the measurement's stem pairing, so a render
# that changes its extension keeps the inventory on the diff. A changed entry
# for a path listed at both endpoints, an entry for a path that stays or has
# no source beside it, an edit that moves no entry, or a lookup that fails
# leaves the line out, and the inventory stays on the diff.
inventory_delta() { # BASE_DOCUMENT HEAD_DOCUMENT -> one `KIND PATH` per entry
  printf '%s\n%s\n' "$1" "$2" | jq -ers '
    def entry_path: if type == "string" then . else .path end;
    .[0] as $base | .[1] as $head
    | ($base | map(entry_path)) as $base_paths
    | ($head | map(entry_path)) as $head_paths
    | [(($head - $base)[] | entry_path
        | . as $path | if ($base_paths | index($path)) == null
          then "added \($path)" else "changed \($path)" end),
       (($base - $head)[] | entry_path
        | . as $path | if ($head_paths | index($path)) == null
          then "removed \($path)" else "changed \($path)" end)]
    | if length == 0 then "unmoved -" else .[] end
  '
}
# Whether this diff changes PATH from its state at the base to its state at
# the head, each `present` or `absent`. A failed lookup is neither.
diff_moves() { # PATH BASE_STATE HEAD_STATE
  local at_base at_head
  grep -qxF -- "$1" <<<"$changed" || return 1
  at_base="$(git_repo ls-tree "$base" -- "$1")" || return 1
  at_head="$(git_repo ls-tree "$head_rev" -- "$1")" || return 1
  [ "$2" = "$([ -n "$at_base" ] && echo present || echo absent)" ] &&
    [ "$3" = "$([ -n "$at_head" ] && echo present || echo absent)" ]
}
names_only_change() { # -> prints `names-only added=N removed=M roots=R,...`, or fails
  local delta kind path root roots="" added=0 removed=0
  delta="$(inventory_delta "$base_document" "$head_document" 2>/dev/null)" || return 1
  while IFS=' ' read -r kind path; do
    case "$kind" in
      added)
        case "$path" in */*) ;; *) return 1 ;; esac
        diff_moves "$path" absent present || return 1
        diff_moves "${path#*/}" absent present || return 1
        root="${path%%/*}"
        case ",$roots," in *",$root,"*) ;; *) roots="${roots:+$roots,}$root" ;; esac
        added=$((added + 1)) ;;
      removed)
        diff_moves "$path" present absent || return 1
        removed=$((removed + 1)) ;;
      *) return 1 ;;
    esac
  done <<<"$delta"
  printf 'names-only added=%s removed=%s roots=%s' "$added" "$removed" "${roots:--}"
}
if grep -qxF .kendex-generated.json <<<"$changed"; then
  inventory_change="$(names_only_change)" || inventory_change=""
fi
# Candidacy grants installation only. The normal harness verdict still refuses
# gains; change-class must prove ownership under ../SKILL.md's render contract.
if [ "$classification" != render-candidate ]; then
  printf '%s\n%s\n' "$base_inventory" "$head_inventory" | jq -es '
    .[0] as $base | .[1] | all(.[]; . as $path | ($base | index($path)) != null)
  ' >/dev/null 2>&1 || verdict false "cause=generated-ownership-gain" \
    "generated ownership gains paths and requires product checks"
fi
while IFS= read -r path; do
  [ -n "$path" ] || continue
  if [ "$classification" = render-candidate ] && [ "$path" = "$HARNESS_CI_REFRESH_CALLER" ]; then
    continue
  fi
  seen=false
  for endpoint in "$base" "$head"; do
    entry="$(git_repo ls-tree "$endpoint" -- "$path")" || verdict false \
      "cause=file-lookup-failed path=$(stable_value "$path")" \
      "file lookup failed"
    [ -n "$entry" ] || continue
    seen=true
    inventory="$base_inventory"
    [ "$endpoint" != "$head" ] || inventory="$head_inventory"
    jq -e --arg path "$path" 'index($path) != null' <<<"$inventory" >/dev/null 2>&1 \
      || verdict false \
        "cause=product-source-or-unreadable-ownership path=$(stable_value "$path")" \
        "a changed file is product source or its ownership is unreadable"
  done
  [ "$seen" = true ] || verdict false \
    "cause=unreadable-changed-path path=$(stable_value "$path")" \
    "a changed path could not be read"
done <<<"$changed"
verdict true
