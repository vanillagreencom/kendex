#!/usr/bin/env python3
# Platform: Linux Wayland with Python 3; ydotool, wtype and grim per operation.
"""Send authorized desktop input. Read typed text from stdin without logging it."""
import argparse
import os
from pathlib import Path
import shutil
import subprocess
import sys


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog=(
        "Platform: Linux Wayland. move/click require ydotool and its configured daemon; "
        "type/key require wtype and compositor virtual-keyboard support; shot requires grim. "
        "type reads its text from stdin and prints nothing, so human-input type < FILE types a mode-600 file "
        "without the text reaching argv or output. "
        "shot creates an absolute output file with mode 600 and refuses replacement."))
    verbs = parser.add_subparsers(dest="verb", required=True)
    move = verbs.add_parser("move")
    move.add_argument("x", type=int)
    move.add_argument("y", type=int)
    click = verbs.add_parser("click")
    click.add_argument("button", choices=("left", "right", "middle"), default="left", nargs="?")
    typing = verbs.add_parser("type", help="type stdin, for example human-input type < FILE")
    typing.add_argument("--delay", type=int, default=70, metavar="MS",
                        help="delay between keystrokes in milliseconds (default: %(default)s)")
    key = verbs.add_parser("key")
    key.add_argument("keysym")
    shot = verbs.add_parser("shot")
    shot.add_argument("output", type=Path)
    shot.add_argument("--rectangle", metavar="X,Y WIDTHxHEIGHT",
                      help="capture this rectangle in layout coordinates; omit to capture all outputs")
    args = parser.parse_args()
    if sys.platform != "linux" or not os.environ.get("WAYLAND_DISPLAY"):
        parser.exit(2, "human-input: platform=linux-wayland-required\n")
    commands = {
        "move": ["ydotool", "mousemove", "--absolute", "-x", str(getattr(args, "x", 0)), "-y", str(getattr(args, "y", 0))],
        "click": ["ydotool", "click", {"left": "0xC0", "right": "0xC1", "middle": "0xC2"}[getattr(args, "button", "left")]],
        "type": ["wtype", "-d", str(getattr(args, "delay", 70)), "-"],
        "key": ["wtype", "-k", getattr(args, "keysym", "")],
        "shot": ["grim", *(["-g", args.rectangle] if getattr(args, "rectangle", None) is not None else []), "-"],
    }
    argv = commands[args.verb]
    command = shutil.which(argv[0])
    if command is None:
        parser.exit(2, "human-input: optional-dependency=" + argv[0] + "\nInstall the tool for this desktop operation.\n")
    argv[0] = command
    if args.verb == "shot":
        if not args.output.is_absolute():
            parser.exit(2, "human-input: output=absolute-path-required\n")
        fd = os.open(args.output, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
        complete = False
        try:
            with os.fdopen(fd, "wb") as stream:
                result = subprocess.run(argv, stdout=stream, stderr=subprocess.DEVNULL, timeout=30)
            complete = result.returncode == 0
        finally:
            if not complete:
                args.output.unlink()
    else:
        # Keyboard and pointer tools need the caller's active desktop environment.
        # Typing duration depends on stdin length and the selected per-key delay.
        result = subprocess.run(argv, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                timeout=None if args.verb == "type" else 30)
    if result.returncode:
        parser.exit(1, "human-input: operation=failed\n")


if __name__ == "__main__":
    try:
        main()
    except (OSError, subprocess.TimeoutExpired):
        sys.exit("human-input: operation=failed")
