#!/usr/bin/env python3
"""Read one rule or memory section without relying on its line numbers."""
import argparse
import json
from pathlib import Path
import sys

sys.path.insert(0, str(Path(__file__).resolve().parent / "lib"))
from sections import section  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description="Print an ATX Markdown heading and its section, including child sections.")
    parser.add_argument("file", type=Path)
    parser.add_argument("heading", help="Exact heading text, without the leading # marks")
    args = parser.parse_args()
    try:
        lines = args.file.read_bytes().decode("utf-8").splitlines(keepends=True)
    except (OSError, UnicodeError) as error:
        print("jarvis-section: " + json.dumps({"error": "read-failed", "file": str(args.file), "cause": str(error)}), file=sys.stderr)
        return 1

    try:
        start, end = section(lines, args.heading)
    except LookupError as error:
        key, candidates = error.args
        print("jarvis-section: " + json.dumps({
            "error": key, "heading": args.heading,
            "candidates": [{"heading": title, "line": index + 1} for index, _, title in candidates],
        }), file=sys.stderr)
        return 2
    sys.stdout.buffer.write("".join(lines[start:end]).encode("utf-8"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
