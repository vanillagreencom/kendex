REPLACES=""
REPLACES_FIELD='[]'
IDENTITY_FIELD='null'
POSTED_LINE=""

need_val() { [ "$#" -ge 2 ] && [ -n "${2:-}" ] || refuse missing-value "$1"; }

while [ "$#" -gt 0 ]; do
  # The spelling, not the value: a valued option shifts past its own, so this
  # collects exactly the options the caller typed, in the words it typed them.
  OPTS_GIVEN="$OPTS_GIVEN$1$NL"
  case "$1" in
    --item) need_val "$@"; ITEM="$2"; shift 2 ;;
    --issue) need_val "$@"; ISSUE="$2"; shift 2 ;;
    --do) [ "$#" -ge 2 ] || refuse owner-action-missing --do; OWNER_DO="$2"; shift 2 ;;
    --replaces) need_val "$@"; REPLACES="$2"; shift 2 ;;
    --file | --text)
      need_val "$@"; FILE_GIVEN="$2"; FILE="$2"
      case "$FILE" in
        /*) ;;
        *) FILE="$(pwd -P)/$FILE" || refuse root-unresolved . ;;
      esac
      shift 2 ;;
    --options) need_val "$@"; OPTIONS="$2"; shift 2 ;;
    --root) need_val "$@"; ROOT="$2"; shift 2 ;;
    --repo) need_val "$@"; REPO="$2"; shift 2 ;;
    --after) need_val "$@"; AFTER="$2"; shift 2 ;;
    --box) need_val "$@"; EVENT_BOX="$2"; shift 2 ;;
    --mark-read) MARK_READ=1; shift ;;
    --id) need_val "$@"; MSGID="$2"; shift 2 ;;
    --re) need_val "$@"; MSGID="$2"; shift 2 ;;
    --timeout) need_val "$@"; TIMEOUT="$2"; shift 2 ;;
    --interval) need_val "$@"; INTERVAL="$2"; shift 2 ;;
    --host) HOST=1; shift ;;
    --directive) DIRECTIVE=1; shift ;;
    --data) need_val "$@"; DATA_SOURCE="$2"; shift 2 ;;
    --require-reader) REQUIRE_READER=1; shift ;;
    --halt) DIRECTIVE=1; HALT=1; shift ;;
    --peek) PEEK=1; shift ;;
    --receipts) RECEIPTS=1; shift ;;
    --ack) need_val "$@"; ACK="$2"; shift 2 ;;
    --to) need_val "$@"; TO="$2"; shift 2 ;;
    --purpose) need_val "$@"; PURPOSE="$2"; shift 2 ;;
    --open) need_val "$@"; OPEN="$2"; shift 2 ;;
    --ref) need_val "$@"; REF="$2"; shift 2 ;;
    --progress) PROGRESS=1; shift ;;
    --attach)
      need_val "$@"
      [ -z "$ATTACH" ] || refuse attach-repeated --attach
      ATTACH="$2"; shift 2 ;;
    --recommend) need_val "$@"; RECOMMEND="$2"; shift 2 ;;
    --effect) need_val "$@"; EFFECT="$2"; shift 2 ;;
    --wait) need_val "$@"; WAIT="$2"; WAIT_GIVEN=1; shift 2 ;;
    --draft) need_val "$@"; DRAFT="$2"; shift 2 ;;
    --reserved) RESERVED=1; shift ;;
    --due) DUE=1; shift ;;
    --default) DEFAULT=1; shift ;;
    --delivery-id) need_val "$@"; DELIVERY_ID="$2"; shift 2 ;;
    --thread-ts) need_val "$@"; THREAD_TS="$2"; shift 2 ;;
    --parent) need_val "$@"; PARENT="$2"; shift 2 ;;
    --once) ONCE=1; shift ;;
    # A route carries a lane record's fields as they stand: an empty one is
    # judged below as an unrecorded session, not as a missing option value.
    --session) [ "$#" -ge 2 ] || refuse missing-value --session; SESSION="$2"; SESSION_GIVEN=1; shift 2 ;;
    --account) [ "$#" -ge 2 ] || refuse missing-value --account; ACCOUNT="$2"; shift 2 ;;
    --help | -h) usage; exit 0 ;;
    *) refuse option-unknown "$1" ;;
  esac
done

if [ "$VERB" = compact ] || [ "$VERB" = owner-answers ]; then
  for given in $OPTS_GIVEN; do
    case "$given" in --item | --root) ;; *) refuse option-unknown "$given" ;; esac
  done
fi
if [ "$VERB" = reserve ]; then
  for given in $OPTS_GIVEN; do
    case "$given" in --item | --id) ;; *) refuse option-unknown "$given" ;; esac
  done
fi
if [ "$VERB" = replace ]; then
  for given in $OPTS_GIVEN; do
    case "$given" in --item | --id | --root) ;; *) refuse option-unknown "$given" ;; esac
  done
fi
if [ "$VERB" = attach-check ]; then
  for given in $OPTS_GIVEN; do
    case "$given" in --attach) ;; *) refuse option-unknown "$given" ;; esac
  done
  [ -n "$ATTACH" ] || refuse option-required --attach
fi
# The batch names its lanes and roots in its request file alone.
if [ "$VERB" = drain-many ]; then
  for given in $OPTS_GIVEN; do
    case "$given" in
      --file) ;;
      --host) [ -n "${LANE_HOST_READ_DIR:-}" ] || refuse option-unknown "$given" ;;
      *) refuse option-unknown "$given" ;;
    esac
  done
fi

# A peer verb addresses a repository, not a lane, and writes that repository's
# overseer mailbox. One rule rather than a list of rejects: these are the
# options a peer verb takes, and every other spelling the parser accepted is a
# lane option, refused rather than dropped so a caller is never told a choice
# landed that never did. The refusal names the spelling typed, so a `--id` on
# a peer ask does not send its reader to `--re`.
[ "$RECEIPTS" -eq 0 ] || [ "$VERB" = drain ] || refuse option-unknown --receipts
if [ "$VERB" = peer ]; then
  [ -n "$REPO" ] || refuse option-required --repo
  for given in $OPTS_GIVEN; do
    case "$given" in
      --repo | --file | --host) ;;
      --options) [ "$PEER_VERB" = ask ] || refuse option-unknown --options ;;
      --re) [ "$PEER_VERB" = send ] || refuse option-unknown --re ;;
      *) refuse option-unknown "$given" ;;
    esac
  done
  ITEM=overseer
  # A peer ask is addressed by the verb: the record it leaves carries the
  # audience field pending filters on, written here and never typed.
  [ "$PEER_VERB" != ask ] || TO=peer
elif [ -n "$REPO" ]; then
  refuse option-unknown --repo
fi

# The owner-channel options belong to the overseer mailbox, and each to one
# verb of it; typed anywhere else they are refused rather than dropped, as
# --options on a notice is, so no caller is told a field landed that never
# did. --to is the one that reaches two verbs, and a value outside the two
# audiences is a field nothing reads. --after belongs to drain, and to events
# with --box, since each mailbox file has its own logical line numbers.
for given in $OPTS_GIVEN; do
  case "$given" in
    --purpose)
      [ "$VERB:$ITEM:$TO" = ask:overseer:owner ] || refuse option-unknown --purpose
      [ "$PURPOSE" = memory ] || refuse purpose-invalid "$PURPOSE" ;;
    --open) [ "$VERB:$ITEM:$TO" = notice:overseer:owner ] || refuse option-unknown --open ;;
    --to)
      case "$TO" in owner | peer) ;; *) refuse to-invalid "$TO" ;; esac
      case "$VERB:$ITEM:$TO" in
        ask:overseer:owner | notice:overseer:owner | pending:*:*) ;;
        ask:overseer:peer | notice:overseer:peer) refuse to-invalid "$TO" ;;
        *) refuse option-unknown --to ;;
      esac ;;
    --issue) [ "$VERB:$ITEM:$TO" = ask:overseer:owner ] || refuse option-unknown --issue ;;
    --do) [ "$VERB:$ITEM:$TO" = ask:overseer:owner ] && [ -n "$ISSUE" ] || refuse option-unknown --do ;;
    --replaces) [ "$VERB:$ITEM:$TO" = ask:overseer:owner ] || refuse option-unknown --replaces ;;
    --ref) case "$VERB:$ITEM" in ask:overseer | notice:overseer) ;; *) refuse option-unknown --ref ;; esac ;;
    --progress)
      [ "$VERB:$ITEM:$TO" = notice:overseer:owner ] || refuse option-unknown --progress
      [ -n "$REF" ] || refuse progress-needs-ref --progress ;;
    --attach) case "$VERB:$ITEM" in notice:overseer | attach-check:) ;; *) refuse option-unknown --attach ;; esac ;;
    --recommend | --effect | --wait | --draft | --reserved) [ "$VERB:$ITEM" = ask:overseer ] || refuse option-unknown "$given" ;;
    --due) [ "$VERB" = pending ] || refuse option-unknown --due ;;
    --after)
      case "$VERB" in
        drain) ;;
        events) [ -n "$EVENT_BOX" ] || refuse option-required --box ;;
        *) refuse option-unknown --after ;;
      esac ;;
    --box)
      [ "$VERB" = events ] || refuse option-unknown --box
      case "$EVENT_BOX" in to-lane | to-overseer) ;; *) refuse box-invalid "$EVENT_BOX" ;; esac ;;
    --mark-read)
      [ "$VERB:$ITEM:$EVENT_BOX:$HOST" = events:overseer:to-overseer:0 ] || refuse option-unknown --mark-read
      ;;
    --text | --default) [ "$VERB" = resolve ] || refuse option-unknown "$given" ;;
    --delivery-id)
      # An owner notice is judged on its text for a day, which a key would
      # replace; the overseer's own notice takes none.
      case "$VERB:$ITEM" in
        ask:* | send:* | resolve:*) ;;
        notice:overseer) refuse option-unknown --delivery-id ;;
        notice:*) ;;
        *) refuse option-unknown --delivery-id ;;
      esac ;;
    --require-reader)
      [ "$VERB:$ITEM:$DIRECTIVE:$HOST" = send:overseer:1:0 ] || refuse option-unknown "$given" ;;
    # The watch reports the source as one field of a whitespace-separated
    # event line, so a space or a control character would split that line.
    --data)
      [ "$VERB:$ITEM" = send:overseer ] || refuse option-unknown --data
      # \A and \z anchor the whole value: jq's `$` also matches before a
      # final newline, which would split the watch's one-line event.
      jq -en --arg source "$DATA_SOURCE" '$source | test("\\A[!-~]+\\z")' >/dev/null || refuse source-invalid "$DATA_SOURCE" ;;
    --thread-ts | --parent)
      [ "$VERB:$ITEM:$DIRECTIVE" = send:overseer:1 ] || refuse option-unknown "$given" ;;
    --once) [ "$VERB" = watch ] || refuse option-unknown --once ;;
    --session) [ "$VERB" = send ] && [ "$ITEM" != overseer ] || refuse option-unknown --session ;;
    --account) [ "$SESSION_GIVEN" -eq 1 ] || refuse option-unknown --account ;;
  esac
done
[ "$SESSION_GIVEN" -eq 0 ] || [ "$HOST" -eq 0 ] || refuse option-conflict '--session,--host'

# An item ask supplies the short action the owner sees before the engineering body.
if [ "$VERB:$ITEM:$TO" = ask:overseer:owner ] && [ -n "$ISSUE" ]; then
  jq -en --arg action "$OWNER_DO" '$action | test("\\S")' >/dev/null || refuse owner-action-missing --do
fi

# Judged before it reaches a path: a `/`, a NUL or a dotted name would
# otherwise select a directory of the caller's choosing.
case "$ITEM" in
  '') case "$VERB" in drain-many | attach-check) ;; *) refuse option-required --item ;; esac ;;
  . | ..) refuse item-invalid "$ITEM" ;;
esac
case "$ITEM" in
  *[!A-Za-z0-9._-]*) refuse item-invalid "$ITEM" ;;
esac

for dependency in jq awk cat date mkdir mv tail tr; do
  command -v "$dependency" >/dev/null 2>&1 || refuse command-missing "$dependency"
done

# Fleet's owner-notice reader opens this exact URL. Reject whitespace before
# urlsplit, which otherwise silently strips some control characters.
if [ -n "$OPEN" ]; then
  command -v python3 >/dev/null 2>&1 || refuse command-missing python3
  python3 -c '
import sys
from urllib.parse import urlsplit
value = sys.argv[1]
try:
    url = urlsplit(value)
    url.port  # Reading it rejects malformed or out-of-range ports.
    valid = (not any(c.isspace() or ord(c) < 32 or ord(c) == 127 for c in value)
             and url.scheme == "https" and bool(url.hostname))
except ValueError:
    valid = False
sys.exit(0 if valid else 1)
' "$OPEN" || refuse open-invalid --open
fi

# Slack's relay produces both pointer fields together on threaded directives.
if [ -n "$THREAD_TS$PARENT" ]; then
  [ -n "$THREAD_TS" ] && [ -n "$PARENT" ] || refuse option-conflict '--thread-ts,--parent'
  PARENT_JSON="$(jq -ce --arg ts "$THREAD_TS" '
    select(type == "object" and .ts == $ts and (.author == "owner" or .author == "bot")
      and (.excerpt | type == "string" and length <= 300)
      and (if has("envelope") then (.envelope | type == "string") else true end))
    ' -- "$PARENT" 2>/dev/null)" || refuse file-unreadable "$PARENT"
fi

SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
case "$SCRIPT_DIR" in /*) ;; *) SCRIPT_DIR="$PWD/$SCRIPT_DIR" ;; esac
ORCH_SCRIPTS="$SCRIPT_DIR/../../orch/scripts"
AGENT_RUNTIME_SCRIPTS="$SCRIPT_DIR/../../agent-runtime/scripts"
# shellcheck source=lib/file-lock.sh
. "$SCRIPT_DIR/lib/file-lock.sh"
# shellcheck source=lib/mailbox-append.sh
. "$SCRIPT_DIR/lib/mailbox-append.sh"
# shellcheck source=lib/common-root.sh
. "$SCRIPT_DIR/lib/common-root.sh"

# Lane records, remote hosts and archives belong to the optional orch package.
lm_require_orch() { # FILE...
  local file
  for file in "$@"; do
    [ -f "$ORCH_SCRIPTS/$file" ] || refuse orch-missing "$ORCH_SCRIPTS/$file"
  done
}
[ "$HOST" -eq 0 ] || lm_require_orch orch-runtime
if [ "$VERB" = compact ]; then
  lm_require_orch orch-env orch-runtime
fi
[ -z "$ATTACH" ] || lm_require_orch orch-env

# Nested subshells keep each mutex's lifetime separate on hosts without flock.
# A reader can hold the cursor lock while taking a mailbox snapshot.
lm_locked() ( # FD PATH COMMAND...
  local fd="$1" path="$2" open_err="${WORK_DIR:-/dev}/open.err" locked_err="${WORK_DIR:-/dev}/locked.err"
  [ -n "${WORK_DIR:-}" ] || { open_err=/dev/null; locked_err=/dev/null; }
  shift 2
  ORCH_LOCK_MUTEX_DIR=""
  if [ "$VERB" = compact ] && [ "$fd" -ne 7 ]; then
    eval "exec $fd<>\"\$path\"" 2>"$open_err" ||
      refuse write-failed "$path" "$(<"$open_err")"
  else
    eval "exec $fd<\"\$path\"" 2>"$open_err" ||
      refuse file-unreadable "$path" "$(<"$open_err")"
  fi
  orch_take_lock "$fd" "$path" 30 2>"$locked_err" ||
    refuse lock-failed "$path" "$(<"$locked_err")"
  trap orch_release_lock EXIT
  "$@"
)

# Missing mail files have no rows to rewrite. Do not create a cursor lock on
# an unread mailbox: pending treats that lock without a cursor as a missed read.
lm_existing_lock() { # FD PATH COMMAND...
  local fd="$1" path="$2"
  shift 2
  if [ -f "$path" ]; then
    lm_locked "$fd" "$path" "$@"
  else
    eval "exec $fd</dev/null" || refuse file-unreadable /dev/null
    "$@"
  fi
}

# flock locks belong to the inherited descriptors, so one read scope can hold
# the pair. The directory-mutex fallback retains its separate cleanup scopes.
lm_read_pair() { # OVERSEER_FILE LANE_FILE COMMAND...
  local over="$1" lane="$2" fd path result key value
  shift 2
  if ! command -v flock >/dev/null 2>&1; then
    [ "$VERB" = inbox ] || lm_plain
    lm_existing_lock 8 "$over" lm_existing_lock 9 "$lane" "$@"
    return
  fi
  for fd in 8 9; do
    path="$over"; [ "$fd" -ne 9 ] || path="$lane"
    if [ -f "$path" ]; then
      eval "exec $fd<\"\$path\"" 2>/dev/null || { lm_plain; refuse file-unreadable "$path"; }
    else
      eval "exec $fd</dev/null" || refuse file-unreadable /dev/null
    fi
  done
  result="$(python3 "$SCRIPT_DIR/lib/lane-mail-store.py" plain-lock "$BOX" "$over" "$lane")" || refuse file-unreadable "$BOX"
  if [ -n "$result" ]; then
    IFS=$'\x1f' read -r key value <<<"$result"
    refuse "$key" "$value"
  fi
  "$@"
}

lm_store() {
  command -v python3 >/dev/null 2>&1 || refuse command-missing python3
  python3 "$SCRIPT_DIR/lib/lane-mail-store.py" "$@" 2>"$WORK_DIR/store.err" ||
    refuse file-unreadable "$BOX" "$(cat -- "$WORK_DIR/store.err")"
}

# The template names TMPDIR outright: a
# bare `mktemp` reads it only on GNU, and BSD mktemp, the one macOS ships,
# allocates under its own per-user directory instead. The trailing slash macOS
# sets comes off, and a relative root takes `./` so it cannot read as an option.
TMP_ROOT="${TMPDIR:-/tmp}"
TMP_ROOT="${TMP_ROOT%/}"
case "$TMP_ROOT" in
  "") TMP_ROOT="/" ;;
  /*) ;;
  *) TMP_ROOT="./$TMP_ROOT" ;;
esac
WORK_DIR=""
FAST_READ=0
case "$HOST:$VERB" in *:drain | *:drain-many | *:pending | 0:inbox) FAST_READ=1 ;; esac
CACHED_READ=0
if [ "$HOST:$FAST_READ" = 1:1 ] && [ -n "${LANE_HOST_READ_DIR:-}" ]; then
  CACHED_READ=1
fi
if [ "$FAST_READ" -eq 0 ] || { [ "$HOST" -eq 1 ] && [ "$CACHED_READ" -eq 0 ]; }; then
  WORK_DIR="$(mktemp -d "$TMP_ROOT/lane-mail.XXXXXX")" || refuse write-failed "$TMP_ROOT"
fi
# orch_take_lock's mutex arm arms its own EXIT trap, so every caller below
# re-arms this one after it returns; both halves run either way.
lm_cleanup() { orch_release_lock; [ -z "$WORK_DIR" ] || rm -rf -- "$WORK_DIR"; }
trap lm_cleanup EXIT

TRACKER_QUOTA_JQ='select(type == "object") |
  select(.status == "future" or .status == "elapsed" or .status == "missing" or .status == "invalid") |
  select(.limit == "requests" or .limit == "complexity" or .limit == "endpoint" or .limit == "unknown") |
  select(.reset | type == "string") |
  select(if .status == "future" or .status == "elapsed" then
    (.reset_epoch | type == "number" and . >= 0 and . == floor) and .reset == (.reset_epoch | todateiso8601)
    else .reset_epoch == null and .reset == "unavailable" end)'

tracker_quota_line() {
  local now
  now="$(date -u +%s)" || return 1
  jq -r --argjson now "$now" '
    if .status == "future" and .reset_epoch <= $now then .status="elapsed" else . end |
    "tracker-quota status=\(.status) reset=\(.reset) limit=\(.limit)"' <<<"$1"
}

# A standalone pass returns the transport refusal to its caller; the fleet
# caller owns persistence and stopping its remaining tracker work.
tracker_quota_refusal() { # STDERR_FILE
  local receipt line
  receipt="$(jq -Rrnc '[inputs | fromjson? | objects | select(.code == "RATELIMITED") | .quota | objects] | last // empty' <"$1")" || return 1
  [[ -n "$receipt" ]] || return 1
  receipt="$(jq -ce "$TRACKER_QUOTA_JQ" <<<"$receipt")" || return 1
  OWNER_TRACKER_READ=unread
  OWNER_TRACKER_QUOTA=1
  line="$(tracker_quota_line "$receipt")" || return 1
  cat -- "$1" >&2
  printf 'EVENT %s\n' "$line"
}
owner_answers() {
  OWNER_TRACKER_READ=disabled
  OWNER_TRACKER_QUOTA=0
  owner_tracker_settings "$SCRIPT_DIR" || return 0
  OWNER_TRACKER_READ=unread
  local items questions extra issue ask comment id rc repair description labels label cause current variables missing replacing ids=()
  if ! "$LANE_MAIL" pending --item "$ITEM" --root "$ROOT" --to owner >"$WORK_DIR/tracker-asks" 2>"$WORK_DIR/tracker.err"; then
    echo 'KEN-3624-unread cause=asks' >&2; return 0
  fi
  # A replacement left incomplete is retried first, on the comment ids its
  # ask recorded, so an ask the retry closes reads as closed below. The
  # replacing ask can have closed since, by an answer or its deadline, while
  # an ask it replaced stands open: the whole box is read, closed asks too.
  if ! "$LANE_MAIL" events --item "$ITEM" --root "$ROOT" >"$WORK_DIR/tracker-events" 2>"$WORK_DIR/tracker.err"; then
    echo 'KEN-3624-unread cause=asks' >&2; return 0
  fi
  if ! replacing="$(jq -r "$OWNER_REPLACING_JQ"' select(.box == "to-overseer" and .kind == "ask" and .to == "owner"
      and .replacement == "incomplete" and owner_replacing) | .id' "$WORK_DIR/tracker-events" 2>"$WORK_DIR/tracker.err")"; then
    echo 'KEN-3624-unread cause=asks-format' >&2; return 0
  fi
  if [[ -n "$replacing" ]]; then
    while IFS= read -r ask; do
      "$LANE_MAIL" replace --item "$ITEM" --root "$ROOT" --id "$ask" </dev/null >/dev/null 2>"$WORK_DIR/replace.err" || :
      cat -- "$WORK_DIR/replace.err" >&2
    done <<<"$replacing"
    if ! "$LANE_MAIL" pending --item "$ITEM" --root "$ROOT" --to owner >"$WORK_DIR/tracker-asks" 2>"$WORK_DIR/tracker.err"; then
      echo 'KEN-3624-unread cause=asks' >&2; return 0
    fi
  fi
  # With no open question, no owner comment reaches an ask. A question a
  # chat ask replaced stands open with no posted ask beside it.
  if ! questions="$(jq -cs "$OWNER_QUESTION_JQ"' owner_questions' "$WORK_DIR/tracker-asks" 2>"$WORK_DIR/tracker.err")"; then
    echo 'KEN-3624-unread cause=asks-format' >&2; return 0
  fi
  [[ "$questions" != '[]' ]] || { OWNER_TRACKER_READ=read; return 0; }
  if ! labels="$(jq -rs --arg label "$OWNER_TRACKER_LABEL" '
    map(select(.tracker_posted == true) | .tracker_label // $label) | unique[]' \
    "$WORK_DIR/tracker-asks" 2>"$WORK_DIR/tracker.err")"; then
    echo 'KEN-3624-unread cause=asks-format' >&2; return 0
  fi
  : >"$WORK_DIR/tracker-item-lists"
  while IFS= read -r label; do
    [[ -n "$label" ]] || continue
    if ! items="$("$TRACKER" issues list --assignee "$OWNER_TRACKER_EMAIL" --label "$label" --max --format=safe 2>"$WORK_DIR/tracker.err")"; then
      tracker_quota_refusal "$WORK_DIR/tracker.err" && return 0
      echo 'KEN-3624-unread cause=issues' >&2; return 0
    fi
    if ! jq -sce '
      if length == 1 and (.[0] | type == "array") then .[0] else error("owner-items-invalid") end
      | if all(.[]; type == "object" and (.id | type == "string")
          and (if has("assignee") then .assignee | type == "string" else true end)
          and (.description == null or (.description | type == "string")))
        then . else error("owner-items-invalid") end' \
      <<<"$items" >>"$WORK_DIR/tracker-item-lists" 2>"$WORK_DIR/tracker.err"; then
      echo 'KEN-3624-unread cause=issues-format' >&2; return 0
    fi
  done <<<"$labels"
  if ! items="$(jq -cs 'add // [] | unique_by(.id)' "$WORK_DIR/tracker-item-lists" 2>"$WORK_DIR/tracker.err")"; then
    echo 'KEN-3624-unread cause=issues-format' >&2; return 0
  fi
  # An ask is on a listed item where their tracker identities agree; an ask
  # recorded before asks carried one is matched by its item ref as written.
  if ! jq -c --slurpfile asks "$WORK_DIR/tracker-asks" "$OWNER_ACTION_JQ"'
    def owner_item($item): if (.identity.uuid | type) == "string" then .identity.uuid == $item.uuid else .issue == $item.id end;
    .[] | . as $item
    | ([$asks[] | select(.tracker_posted == true and owner_item($item) and (.do // "") != "")] | last) as $ask
    | select($ask != null)
    | {id, ask: $ask.id, description: (if ((.description // "") | test("^\\*\\*[^*\\r\\n]+, what you do:\\*\\* "))
        then null
        elif (($item.assignee // "") | test("\\S")) then ((.description // "") | owner_action_line($item.assignee; $ask.do))
        else error("owner-assignee-unavailable") end)}' \
    <<<"$items" >"$WORK_DIR/tracker-repairs" 2>"$WORK_DIR/tracker.err"; then
    echo 'KEN-3624-unread cause=issues-format' >&2; return 0
  fi
  while IFS= read -r repair; do
    issue="$(jq -r '.id' <<<"$repair")" || return 1
    ask="$(jq -r '.ask' <<<"$repair")" || return 1
    cause=""
    if jq -e '.description != null' <<<"$repair" >/dev/null; then
      description="$(jq -r '.description + "."' <<<"$repair")" || return 1
      description="${description%.}"
      if ! "$TRACKER" issues update "$issue" --description "$description" >"$WORK_DIR/tracker.out" 2>"$WORK_DIR/tracker.err"; then
        tracker_quota_refusal "$WORK_DIR/tracker.err" && return 0
      fi
      # A write receipt cannot prove the description landed.
      variables="$(jq -cn --arg id "$issue" '{id: $id}')" || return 1
      if current="$("$TRACKER" graphql --query 'query OwnerItem($id: String!) { issue(id: $id) { identifier description } }' \
          --variables "$variables" 2>"$WORK_DIR/tracker.err")"; then
        if ! jq -e '(.issue.identifier | type == "string") and (.issue.description == null or (.issue.description | type == "string"))' <<<"$current" >/dev/null 2>&1; then
          cause=tracker-list-invalid
        elif ! jq -e --arg id "$issue" --arg description "$description" \
            '.issue.identifier == $id and .issue.description == $description' <<<"$current" >/dev/null 2>&1; then
          cause=unlanded
        fi
      else
        tracker_quota_refusal "$WORK_DIR/tracker.err" && return 0
        cause=tracker-list-failed
      fi
    fi
    jq -cn --arg ask "$ask" --arg issue "$issue" --arg cause "$cause" \
      '{kind: "line", ask: $ask, issue: $issue, cause: (if $cause == "" then null else $cause end)}' || return 1
  done <"$WORK_DIR/tracker-repairs"
  # Every open question's item is read, listed or not: the watch clears the
  # label and assignee of a replaced ask's item where the replacing ask is in
  # chat or on another item, and the replaced question still takes replies.
  # A question on a listed item, by its identifier or UUID, is read there.
  # `comments bulk-list` takes identifiers alone and refuses the whole read
  # for any other ref (linear_issue_refs), so an unlisted item known only by
  # another ref, a UUID an ask recorded before asks carried an identity, is
  # named on stderr and left unread, and the other items are read.
  if ! extra="$(jq -rn --argjson listed "$items" --argjson questions "$questions" '
      [$questions[].item | objects | select((.ref | type) == "string")
        | . as $item | select(all($listed[]; (.id | ascii_upcase) != ($item.ref | ascii_upcase) and .uuid != $item.ref
            and (($item.uuid | type) != "string" or .uuid != $item.uuid)))
        | .ref] | unique[]
      | if test("\\A[A-Za-z0-9]+-[0-9]+\\z") then . else "skip " + . end' 2>"$WORK_DIR/tracker.err")"; then
    echo 'KEN-3624-unread cause=asks-format' >&2; return 0
  fi
  while IFS= read -r issue; do
    [[ "$issue" != skip\ * ]] || printf 'owner-answers: item-unreadable issue=%s cause=ref-form\n' "${issue#skip }" >&2
  done <<<"$extra"
  extra="$(grep -v '^skip ' <<<"$extra")" || extra=""
  if ! items="$(jq -r '.[].id' <<<"$items" 2>"$WORK_DIR/tracker.err")"; then
    echo 'KEN-3624-unread cause=issues-format' >&2; return 0
  fi
  [[ -z "$extra" ]] || items="$items"$'\n'"$extra"
  while IFS= read -r issue; do [[ -z "$issue" ]] || ids+=("$issue"); done <<<"$items"
  [[ ${#ids[@]} -gt 0 ]] || { OWNER_TRACKER_READ=read; return 0; }
  if ! "$TRACKER" comments bulk-list "${ids[@]}" --format=safe >"$WORK_DIR/tracker-comments" 2>"$WORK_DIR/tracker.err"; then
    tracker_quota_refusal "$WORK_DIR/tracker.err" && return 0
    # Linear's answer that it holds no such issue is definitive: that item
    # holds no comment to read, and the others are read again. Any other
    # failure leaves the pass unread.
    if ! missing="$(owner_tracker_missing "$WORK_DIR/tracker.err" "${ids[@]}")"; then
      echo 'KEN-3624-unread cause=comments' >&2; return 0
    fi
    while IFS= read -r issue; do printf 'owner-answers: item-missing issue=%s\n' "$issue" >&2; done <<<"$missing"
    items="$(grep -Fxv -- "$missing" <<<"$items")" || items=""
    ids=()
    while IFS= read -r issue; do [[ -z "$issue" ]] || ids+=("$issue"); done <<<"$items"
    if [[ ${#ids[@]} -eq 0 ]]; then
      printf '{}\n' >"$WORK_DIR/tracker-comments"
    elif ! "$TRACKER" comments bulk-list "${ids[@]}" --format=safe >"$WORK_DIR/tracker-comments" 2>"$WORK_DIR/tracker.err"; then
      tracker_quota_refusal "$WORK_DIR/tracker.err" && return 0
      echo 'KEN-3624-unread cause=comments' >&2; return 0
    fi
  fi
  if ! jq -se 'length == 1 and (.[0] | type == "object" and
      all(.[]; type == "array" and all(.[]; type == "object" and
        all(.id, .body, .user_email, .created_at; type == "string"))))' \
      "$WORK_DIR/tracker-comments" >/dev/null 2>"$WORK_DIR/tracker.err"; then
    echo 'KEN-3624-unread cause=comments-format' >&2; return 0
  fi
  # The delivery rule usage() states: each owner comment reaches the ask of
  # the open question its thread ends at, or, at the top level, the ask of
  # the item's latest open question before it, and no ask otherwise.
  if ! jq -cn --slurpfile comments "$WORK_DIR/tracker-comments" --arg email "$OWNER_TRACKER_EMAIL" \
    --slurpfile asks "$WORK_DIR/tracker-asks" "$OWNER_QUESTION_JQ"'
      def owned: (.user_email | ascii_downcase) == ($email | ascii_downcase);
      $comments[0] as $items
      | [$items | to_entries[] | .key as $issue | .value[] | {issue: $issue, row: .}] as $all
      # Each open question placed at its comment: by its exact id wherever
      # it stands, or, on a record with no comment id, by the ask= line on
      # its item.
      | [$asks | owner_questions[] | . as $q
          | (first($all[] | select(if $q.comment != null then .row.id == $q.comment
              else .issue == $q.issue and (.row.body | split("\n") | index("ask=" + $q.ask)) != null end)) // null) as $at
          | select($at != null) | $q + {id: $at.row.id, issue: $at.issue, at: $at.row.created_at}] as $open
      | $items | to_entries[] | .key as $issue | (.value | sort_by(.created_at)) as $rows
      # The open question a comment answers: the one its thread reaches,
      # parent by parent through earlier comments, so the walk ends.
      | def question:
          . as $row | ($row.parent_id // "") as $parent
          | if $parent == "" then [$open[] | select(.issue == $issue and .at < $row.created_at)] | max_by(.at)
            else (first($open[] | select(.id == $parent)) // null) as $under
            | if $under != null then $under
              else (first($rows[] | select(.id == $parent and .created_at < $row.created_at)) // null)
              | if . == null or (.parent_id // "") == "" then null else question end end end;
      $rows[] | select(owned) | . as $row | select(all($open[]; .id != $row.id))
      | question as $q | select($q != null)
      | {ask: $q.ask, issue: $issue, comment: $row, replaced: $q.replaced, under: (($row.parent_id // "") != "")}' \
    >"$WORK_DIR/tracker-answers" 2>"$WORK_DIR/tracker.err"; then
    echo 'KEN-3624-unread cause=comments-format' >&2; return 0
  fi
  while IFS= read -r comment; do
    ask="$(jq -r '.ask' <<<"$comment")" || return 1
    id="$(jq -r '.comment.id' <<<"$comment")" || return 1
    jq -r 'if .replaced == null then empty
      elif .under then "Reply under the replaced question of ask \(.replaced); the open question is ask \(.ask).", ""
      else "Comment on the item after the replaced question of ask \(.replaced); the open question is ask \(.ask).", "" end,
      .comment.body' <<<"$comment" >"$WORK_DIR/tracker-answer" || return 1
    rc=0
    "$LANE_MAIL" send --item "$ITEM" --root "$ROOT" --re "$ask" --delivery-id "linear:$id" \
      --file "$WORK_DIR/tracker-answer" >"$WORK_DIR/tracker.out" 2>"$WORK_DIR/tracker.err" || rc=$?
    if [[ "$rc" -ne 0 && "$(head -n 1 "$WORK_DIR/tracker.err")" != lane-mail:\ delivery-repeated=* ]]; then
      echo 'KEN-3624-unread cause=delivery' >&2; return 0
    fi
    if [[ "$rc" -eq 0 ]]; then
      jq -cn --arg ask "$ask" --arg issue "$(jq -r '.issue' <<<"$comment")" --arg comment "$id" \
        '{kind: "delivered", ask: $ask, issue: $issue, comment: $comment}' || return 1
    fi
  done <"$WORK_DIR/tracker-answers"
  OWNER_TRACKER_READ=read
}

if [ "$VERB" = owner-answers ]; then
  TRACKER="$SCRIPT_DIR/../../linear/scripts/linear.sh"
  TRACKER="${OVERSEE_WATCH_TRACKER:-$TRACKER}"
  if [ ! -x "$TRACKER" ]; then
    printf 'owner-answers: tracker=absent\n'
    exit 0
  fi
fi

# The cause readings a stalled cloud lane's close carries into the fleet log:
# this send's result (sent, archived or failed) and the CLI's words, and the
# account's cloud credit as agent-runtime's account roster reads it now, this
# machine's own reading of the record's Claude account alone. A send is the one
# per-session call kendex makes, and no read of a session's own state exists
# (Claude Code 2.1.295 documents none), so these are the only causes it can
# name. A credit read that fails, or a reading with no credit body, records
# "unread", never an empty credit. The readings are printed on stderr as a
# keyed receipt line for the orch runtime, whose `send` verb records them on
# the lane; the mailbox writes no fleet record.
lm_send_record() { # RESULT CAUSE
  local credit
  credit="$(AGENT_RUNTIME_ACCOUNT_DIRS="$account" "$AGENT_RUNTIME_SCRIPTS/agent-runtime" accounts roster 2>/dev/null |
    jq -c --arg dir "$account" '[.result.rows[]? | select(.harness == "claude" and .config_dir == $dir)
      | .record.credits | objects | {remaining_dollars, locked_reason}] | first // "unread"')" ||
    credit='"unread"'
  jq -rn --arg item "$ITEM" --arg result "$1" --arg text "$2" --argjson credit "$credit" \
    '"lane-mail: directive-send item=\($item) record=" + ({result: $result, text: ($text | .[0:300]), credit: $credit} | tojson)' >&2 ||
    refuse write-failed /dev/stderr
}

# A standalone checkout may have no fleet. An unreadable record cannot
# authorize writing to a local mailbox that the lane may never read.
lm_refuse_hosted_local_send() {
  local path dir host
  path="$(lm_overseer_path full "$OWN_ROOT")" ||
    refuse state-unreadable "$ITEM" "$(cat -- "$WORK_DIR/reader.err")"
  dir="${path%/*}"
  while [ ! -e "$dir" ] && [ ! -L "$dir" ]; do
    dir="${dir%/*}"
    [ -n "$dir" ] || dir=/
  done
  [ -d "$dir" ] && [ -x "$dir" ] || refuse state-unreadable "$ITEM" "$path"
  [ -e "$path" ] || [ -L "$path" ] || return 0
  [ -f "$path" ] || refuse state-unreadable "$ITEM" "$path"
  host="$(jq -ers --arg item "$ITEM" '
    if length != 1 or (.[0] | type) != "object" then error("invalid fleet record") else .[0] end
    | (if .lanes == null then [] else .lanes end) as $lanes
    | if ($lanes | type) != "array" or any($lanes[]; (.item | type) != "string")
      then error("invalid fleet lanes") else [$lanes[] | select(.item == $item)] end
    | if length > 1 then error("ambiguous fleet route") else .[0] end
    | (.host // null) as $host
    | if (.host != null and (.host | type) != "string") or (.kind != null and (.kind | type) != "string")
      then error("invalid fleet route")
      elif .kind == "claude-cloud" or $host == "claude-cloud" or $host == "local" then ""
      else $host // "" end
    ' <"$path" 2>"$WORK_DIR/reader.err")" ||
    refuse state-unreadable "$ITEM" "$(cat -- "$WORK_DIR/reader.err")"
  [ -z "$host" ] || refuse host-root-required "$host"
}

# A send to a lane goes where its caller's route names.
# A hosted mailbox is the one at --root on the provider the
# caller's ORCH_LANE_HOST names: the settings' provider is no route, since it
# would land the line in a mailbox the lane never reads. A session route is a
# Claude cloud session of this repository, its --root judged as a mailbox
# send's root is: a directive is queued into the session through the Claude
# CLI under the route's account, which answers {ok, session_id, url}. Such a
# lane never asks, so an answer has nothing to reach, and no hook enforces a
# halt there.
lm_send_channel() {
  local rc=0 account="$ACCOUNT" session="$SESSION" out answer cause
  if [ "$SESSION_GIVEN" -eq 0 ]; then
    if [ "$HOST" -eq 0 ]; then
      lm_refuse_hosted_local_send
    else
      [ -n "${ORCH_LANE_HOST:-}" ] || refuse host-route-missing "$ITEM"
    fi
    return 0
  fi
  [ -z "$MSGID" ] || refuse channel-session --re
  [ "$HALT" -eq 0 ] || refuse channel-session --halt
  { [ -n "$account" ] && [ -n "$session" ]; } || refuse session-unrecorded "$ITEM"
  rc=0
  # The send is the Claude CLI's, so the account rides in Claude's variable:
  # a session kind launches a Claude lane alone. The create signed in by the
  # account's stored login with every credential Claude ranks above it
  # cleared, so the send clears the same names, mirrored from agent-runtime's
  # `launch::CLAUDE_OUTRANKING`: a credential the caller inherited would send
  # as its own account, which cannot reach this account's session.
  out="$(env -u CLAUDE_CODE_USE_BEDROCK -u CLAUDE_CODE_USE_VERTEX -u CLAUDE_CODE_USE_FOUNDRY \
    -u CLAUDE_CODE_USE_ANTHROPIC_AWS -u CLAUDE_CODE_USE_ANTHROPIC_GOOGLE_CLOUD -u CLAUDE_CODE_USE_MANTLE \
    -u ANTHROPIC_AUTH_TOKEN -u ANTHROPIC_API_KEY -u CLAUDE_CODE_OAUTH_TOKEN -u ANTHROPIC_PROFILE \
    -u ANTHROPIC_FEDERATION_RULE_ID -u ANTHROPIC_ORGANIZATION_ID -u ANTHROPIC_BASE_URL \
    "CLAUDE_CONFIG_DIR=$account" claude -p --cloud "$session" --output-format json <"$FILE" 2>"$WORK_DIR/claude.err")" || rc=$?
  # The CLI's own error words decide an archived session; any other answer
  # that is no {ok: true} is a send that failed, carried with those words.
  answer="$(jq -r 'if .ok == true then "sent" elif (.error // "" | tostring | test("archived"; "i")) then "archived" else "failed" end' <<<"$out" 2>/dev/null)" || answer=failed
  cause="$(jq -r '.error // empty | tostring' <<<"$out" 2>/dev/null || true) $(cat -- "$WORK_DIR/claude.err")"
  [ "$rc" -eq 0 ] || [ "$answer" = archived ] || answer=failed
  # stdout is the `sent` receipt alone; the record goes to stderr whatever
  # the result, after a refusal's keyed line so that line stays stderr's
  # first, as `refuse` would print it less the exit.
  key=""
  if [ "$answer" = archived ]; then
    key=session-archived; detail="$cause"
  elif [ "$rc" -ne 0 ] || [ "$answer" != sent ]; then
    key=session-send-failed; detail="exit=$rc $cause"
  else
    printf 'lane-mail: sent item=%s channel=session session=%s\n' "$ITEM" "$session"
  fi
  [ -z "$key" ] || { lm_message "$key" "$session" >&2; printf '%s\n' "$detail" >&2; }
  lm_send_record "$answer" "$cause"
  [ -z "$key" ] || exit 2
  exit 0
}

# The caller's own repository: the main checkout behind this shell, whatever
# worktree it sits in. It names the sender, places a peer named as a bare name,
# and decides which lanes are this overseer's to write.
OWN_ROOT=""
case "$VERB" in
  ask | notice | send | resolve | reserve | replace | peer | compact | attach-check)
    OWN_ROOT="$(mailbox_common_root . 2>/dev/null)" || OWN_ROOT="" ;;
esac

# The attachment, judged where it stands: a regular file, not itself a
# symlink, whose directory resolves physically to the progress-report
# directory ORCH_PROGRESS_REPORT_DIR names, a relative one under the main
# checkout, which is one rule at the one point the relay would otherwise carry
# any path it was handed. ATTACH is rewritten to the physical path so the
# relay opens what was judged.
lm_attach_confined() {
  local reports dir base
  reports="$("$ORCH_SCRIPTS/orch-env" ORCH_PROGRESS_REPORT_DIR tmp/progress-reports 2>"$WORK_DIR/reports.err")" ||
    refuse attach-outside "$ATTACH" "$(cat -- "$WORK_DIR/reports.err")"
  case "$reports" in
    /*) ;;
    *) reports="${OWN_ROOT:-$PWD}/$reports" ;;
  esac
  reports="$(cd -- "$reports" 2>/dev/null && pwd -P)" || refuse attach-outside "$ATTACH"
  { [ ! -L "$ATTACH" ] && [ -f "$ATTACH" ]; } || refuse attach-outside "$ATTACH"
  case "$ATTACH" in
    */*) dir="${ATTACH%/*}"; base="${ATTACH##*/}" ;;
    *) dir=.; base="$ATTACH" ;;
  esac
  dir="$(cd -- "$dir" 2>/dev/null && pwd -P)" || refuse attach-outside "$ATTACH"
  [ "$dir" = "$reports" ] || refuse attach-outside "$ATTACH"
  ATTACH="$dir/$base"
}

# A caller that carries a file beside its own message asks this rule rather
# than a copy of it: the answer is the physical path a notice would attach.
if [ "$VERB" = attach-check ]; then
  lm_attach_confined
  printf 'lane-mail: attach=%s\n' "$ATTACH"
  exit 0
fi
# A peer verb writes the caller's own record and places a bare --repo name
# beside the caller's checkout. With no own root there is nowhere correct for
# either, so it is refused here: before a name is composed, before the peer
# root is judged, and before any envelope is written.
[ "$VERB" != peer ] || [ -n "$OWN_ROOT" ] || refuse root-unresolved .

# The caller's repository name: what its kendex.toml publishes, else the last
# segment of its origin URL, else the checkout's own directory name.
lm_repository() {
  local root name="" url=""
  root="$OWN_ROOT"
  [ -n "$root" ] || root="$(pwd -P)" || refuse root-unresolved .
  if [ -f "$root/kendex.toml" ]; then
    # A basic string and a literal string are the two TOML spellings of a
    # name. The quote arrives as a variable rather than an escape, so the
    # program reads the same under every awk. Any value this cannot read
    # prints nothing and falls through to the origin URL below, rather than
    # being mangled into the identity every peer message carries: a basic
    # string processes escapes and this does not decode them, so one holding a
    # backslash is such a value. A literal string processes none, so a
    # backslash there is a character like any other and is read as written.
    name="$(awk -v q="'" '
      /^[[:space:]]*\[/ { table = ($0 ~ /^[[:space:]]*\[marketplace\][[:space:]]*$/); next }
      table && /^[[:space:]]*name[[:space:]]*=/ {
        value = $0
        sub(/^[[:space:]]*name[[:space:]]*=[[:space:]]*/, "", value)
        mark = substr(value, 1, 1)
        if (mark != "\"" && mark != q) exit
        value = substr(value, 2)
        close_at = index(value, mark)
        if (close_at < 2) exit
        value = substr(value, 1, close_at - 1)
        if (mark == "\"" && index(value, "\\") > 0) exit
        print value
        exit
      }' <"$root/kendex.toml")" || refuse file-unreadable "$root/kendex.toml"
  fi
  if [ -z "$name" ]; then
    url="$(git -C "$root" remote get-url origin 2>/dev/null)" || url=""
    url="${url%/}"
    name="${url##*/}"
    name="${name%.git}"
  fi
  [ -n "$name" ] || name="${root##*/}"
  # The name reaches a whitespace-separated watch record, so it carries the
  # item alphabet: a directory name holding a space would split that record.
  printf '%s\n' "${name//[!A-Za-z0-9._-]/-}"
}

# Who sent it, never typed: a lane writes its own item, a note into the
# overseer's own mailbox is the owner's, and every other overseer write
# carries the repository it was sent from. A data notice keeps `owner` here:
# its kind, not its sender, makes it data, and its source names the program.
FROM=""
case "$VERB:$ITEM:$DEFAULT" in
  ask:* | notice:*) FROM="$ITEM" ;;
  send:overseer:*) FROM=owner ;;
  resolve:*:0) FROM=owner; [ -n "$FILE" ] || FROM="overseer:$(lm_repository)" ;;
  send:* | peer:* | resolve:* | reserve:* | replace:*) FROM="overseer:$(lm_repository)" ;;
esac

# A lane verb is rooted at its own worktree; the overseer's verbs take --root.
if [ "$VERB" = peer ]; then
  # A hosted peer root is a path on its own host, so it is taken as given.
  if [ "$HOST" -eq 1 ]; then
    ROOT="$REPO"
  else
    case "$REPO" in
      */*) PEER_ROOT="$REPO" ;;
      *) PEER_ROOT="${OWN_ROOT%/*}/$REPO" ;;
    esac
    # A peer's overseer mailbox sits at its main checkout, so the value goes
    # through the same judge the lane gate uses: a path that is no checkout is
    # refused rather than written into, and one inside a peer resolves to its
    # root instead of opening a second mailbox no watch reads.
    ROOT="$(mailbox_common_root "$PEER_ROOT" 2>/dev/null)" || ROOT=""
    [ -n "$ROOT" ] || refuse repo-unresolved "$PEER_ROOT"
    # A peer is another repository. Resolved to this one, `peer ask` would put
    # both sides of an exchange in one mailbox: the watch would report this
    # repository as its own peer, and the overseer could answer its own ask.
    # Judged on the resolved roots rather than the typed value, so every
    # spelling that names this checkout meets it here, beside the test that
    # says what a peer target may be at all.
    [ "$ROOT" != "$OWN_ROOT" ] || refuse repo-self "$ROOT"
  fi
elif [ "$HOST" -eq 1 ] && [ -z "$ROOT" ] && [ "$VERB" != drain-many ]; then
  refuse option-required --root
fi
# A batch resolves no root of its own: each request line carries its lane's.
if [ -z "$ROOT" ] && [ "$VERB" != drain-many ]; then
  case "$ITEM:$VERB" in
    # One overseer mailbox per project: a shell in any checkout, main or a lane
    # worktree, and the watch in the overseer's meet at the main checkout.
    overseer:*)
      ROOT="$(mailbox_common_root . 2>/dev/null)" || ROOT=""
      ;;
    *:send | *:drain | *:pending | *:events | *:compact | *:owner-answers)
      WORKTREE="$SCRIPT_DIR/../../worktree/scripts/worktree"
      if [ -x "$WORKTREE" ]; then
        ROOT="$(exec "$WORKTREE" path --checkout-fallback "$ITEM" 2>/dev/null)" || ROOT=""
        # The path owner also returns the caller checkout when the selected
        # item directory is absent. Keep that fallback in the same lookup.
        [ -n "$ROOT" ] && [ -d "$ROOT" ] || ROOT=""
      fi
      ;;
  esac
  if [ -z "$ROOT" ]; then
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT=""
  fi
  [ -n "$ROOT" ] || refuse root-unresolved "$ITEM"
fi

if [ "$VERB" = owner-answers ]; then
  LANE_MAIL="$SCRIPT_DIR/lane-mail"
  owner_answers
  [ "$OWNER_TRACKER_QUOTA" -eq 1 ] || printf 'owner-answers: read=%s\n' "$OWNER_TRACKER_READ"
  exit 0
fi

# A send writes a mailbox of the caller's own repository, never one another
# repository owns: its own lanes, and its own overseer mailbox from any of its
# checkouts. The overseer item is judged with the rest, because a --root into
# another repository's overseer mailbox is the cross-repository write `peer`
# exists to be. A root that resolves to no common root at all is refused with
# them, so an unreadable checkout is no way in. A hosted mailbox root is a path
# on its host. A session route's root holds no mailbox, so it is judged on its
# repository alone, which a path inside a checkout names too.
lm_root_own() { # ROOT own|checkout
  local top canonical
  if [ "$2" = checkout ]; then
    # Compaction retains existing rows and delivers no new envelope. Cursor
    # and liveness records belong to reads. Validate only envelope appends.
    case "$VERB" in
      ask | notice | send | resolve | peer)
        top="$(git -C "$1" rev-parse --show-toplevel 2>/dev/null)" || top=""
        canonical="$(cd -P -- "$1" 2>/dev/null && pwd -P)" || canonical=""
        [ -z "$top" ] || top="$(cd -P -- "$top" 2>/dev/null && pwd -P)" || top=""
        if [ -z "$top" ] || [ "$canonical" != "$top" ]; then
          printf 'lane-mail: root-not-checkout=%s top=%s\n' "$1" "$top" >&2
          exit 2
        fi
        ;;
    esac
  fi
  if [ "$2" = own ] || [ "$VERB" = send ] || [ "$VERB" = resolve ] || [ "$VERB" = reserve ] || [ "$VERB" = replace ]; then
    LANE_ROOT="$(mailbox_common_root "$1" 2>/dev/null)" || LANE_ROOT=""
    { [ -n "$LANE_ROOT" ] && [ "$LANE_ROOT" = "$OWN_ROOT" ]; } || refuse lane-foreign "$1"
  fi
}
if [ "$HOST" -eq 0 ]; then
  if [ "$VERB" = peer ] || { [[ "$OPTS_GIVEN" == *"--root$NL"* ]] && [ "$SESSION_GIVEN" -eq 0 ]; }; then
    lm_root_own "$ROOT" checkout
  elif [ "$VERB" = send ] || [ "$VERB" = resolve ] || [ "$VERB" = reserve ] || [ "$VERB" = replace ]; then
    lm_root_own "$ROOT" own
  fi
fi
if [ "$VERB" = peer ]; then
  # Either peer route can append to the sender's local delivery record.
  lm_root_own "$OWN_ROOT" checkout
fi

# The mailbox a verb reads or writes. A peer exchange moves it once: the same
# envelope lands in the peer's mailbox and then in the caller's own record.
lm_box() { # ROOT
  MAIL_ROOT="$1"
  BOX="$MAIL_ROOT/tmp/lane-mail/$ITEM"
  TO_OVERSEER="$BOX/to-overseer.jsonl"
  TO_LANE="$BOX/to-lane.jsonl"
  CURSOR="$BOX/to-lane.cursor"
  WATCH_FILE="$BOX/to-lane.watch"
}
lm_box "$ROOT"

# A mailbox component that is a symlink, or not the kind of file it names,
# would carry a read or an append somewhere the lane never wrote, and a
# checkout can commit one. Judged once, before any verb reads or writes, from
# tmp/lane-mail down: tmp itself may be a link a worktree setup makes. A hosted
# mailbox is judged by its provider behind `orch-runtime host cat` and `append`.
lm_plain() {
  local unsafe
  command -v python3 >/dev/null 2>&1 || refuse command-missing python3
  unsafe="$(python3 "$SCRIPT_DIR/lib/lane-mail-store.py" plain "$BOX")" || refuse file-unreadable "$BOX"
  [ -z "$unsafe" ] || refuse mailbox-unsafe "$unsafe"
}
# The read-only fast path validates in the same helper that takes its inode
# locks. Inbox still validates before creating or opening its cursor lock.
if [ "$HOST" -eq 0 ]; then
  if [ "$FAST_READ" -ne 1 ] || [ "$VERB" = inbox ]; then
    lm_plain
  fi
fi

# Two directories for one lane differing only in case are two mailboxes on a
# case-sensitive disk: the lane's asks are never seen and the overseer's
# directives are never read, in silence. Refused only where the verb would open
# the second one, so a verb on a mailbox already there reads and writes it and a
# pair an earlier launcher left is drained through each spelling and removed. On
# a case-folding disk the named mailbox and the variant are one directory, so the
# return below fires and nothing is refused. A hosted mailbox is on its
# provider's disk, out of reach.
lm_one_spelling() {
  local entry name lower
  [ ! -d "$BOX" ] || return 0
  lower="$(printf '%s' "$ITEM" | tr '[:upper:]' '[:lower:]')"
  for entry in "$MAIL_ROOT"/tmp/lane-mail/*; do
    [ -d "$entry" ] || continue
    name="${entry##*/}"
    # A sibling writer can create the item's own directory between the return
    # above and this scan, and that exact spelling is never a variant of itself.
    [ "$name" != "$ITEM" ] || continue
    [ "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" != "$lower" ] ||
      refuse item-case-variant "$ITEM" "Existing mailbox: $entry"
  done
}
[ "$HOST" -eq 1 ] || [ "$VERB" = drain-many ] || lm_one_spelling

# A single transport call that failed is a host out of reach or a provider
# that answered and declined, and only the probe tells them apart. The dispatcher
# refuses a host it cannot use with the same 2 as an absent file. An unreachable
# host is refused here, carrying the state an
# operator acts on; a host that answers returns, and the caller names what its
# own verb could not do. A successful read or probe also proves later missing
# files in this invocation; a non-2 single-read failure takes a fresh probe.
# Cached batch reads prove absence or refuse failed rows without this probe.
LM_HOST_ANSWERED=0
lm_host_answers() {
  local probe_rc=0
  "$ORCH_SCRIPTS/orch-runtime" host touch --item "$ITEM" >/dev/null 2>"$WORK_DIR/probe.err" || probe_rc=$?
  [ "$probe_rc" -ne 0 ] || { LM_HOST_ANSWERED=1; return 0; }
  lm_host_busy "$probe_rc" "$WORK_DIR/probe.err"
  REFUSE_EXTRA="state=$(lm_host_state)"
  refuse host-unreachable "$ITEM" "$(cat -- "$WORK_DIR/probe.err")"
}

# A call the runtime refused at its per-home bound ran no provider, so it says
# nothing about the host and is never probed: the probe would wait for a slot
# in turn. The runtime names it by its first line's key; this script exits 69
# for it, which its callers read as busy.
lm_host_busy() { # STATUS ERR_FILE
  [ "$1" -ne 0 ] || return 0
  case "$(head -n 1 -- "$2" 2>/dev/null)" in
    'orch-runtime: host-busy '*) refuse host-busy "$ITEM" "$(cat -- "$2")" 69 ;;
  esac
}

# Fetch REMOTE_PATH into DEST, empty when the mailbox does not exist yet. A
# failed single read probes the host before accepting absence.
LM_FETCH_ABSENT=0
lm_fetch() { # REMOTE_PATH DEST — LM_FETCH_ABSENT 1 where the file was not there
  local rc=0
  LM_FETCH_ABSENT=0
  : >"$2" || refuse write-failed "$2"
  if [ "$HOST" -eq 0 ]; then
    [ -f "$1" ] || { LM_FETCH_ABSENT=1; return 0; }
    case "$1" in
      "$TO_LANE" | "$TO_OVERSEER")
        if [ "${LM_HELD_PATH:-}" = "$1" ]; then
          lm_store snapshot 9 "$1" "$2"
        else
          lm_locked 8 "$1" lm_store snapshot 8 "$1" "$2"
        fi
        return ;;
    esac
    cat -- "$1" >"$2" 2>"$WORK_DIR/read.err" \
      || refuse file-unreadable "$1" "$(cat -- "$WORK_DIR/read.err")"
    return 0
  fi
  "$ORCH_SCRIPTS/orch-runtime" host cat --item "$ITEM" "$1" >"$2" 2>"$WORK_DIR/host.err" || rc=$?
  if [ "$rc" -eq 0 ]; then
    LM_HOST_ANSWERED=1
    case "$1" in
      "$TO_LANE" | "$TO_OVERSEER")
        lm_fetch "$1.numbering" "$2.numbering"
        [ "$LM_FETCH_ABSENT" -eq 0 ] || rm -f -- "$2.numbering"
        if [ "${LM_RAW_FETCH:-0}" -eq 1 ]; then LM_FETCH_ABSENT=0; return 0; fi
        (exec 8<"$2"; lm_store snapshot 8 "$2" "$2") ;;
    esac
    LM_FETCH_ABSENT=0
    return 0
  fi
  lm_host_busy "$rc" "$WORK_DIR/host.err"
  if [ "$rc" -ne 2 ] || [ "$LM_HOST_ANSWERED" -eq 0 ]; then lm_host_answers; fi
  [ "$rc" -eq 2 ] || refuse mail-read-failed "$ITEM" "$(cat -- "$WORK_DIR/host.err")"
  # The host answers and the file is not there: a lane that has not opened its
  # mailbox. The failed read wrote whatever it managed; start from nothing.
  LM_FETCH_ABSENT=1
  : >"$2" || refuse write-failed "$2"
}

# The lane's state as the provider lists it, so an operator knows whether to
# start the host or relaunch it. `unknown` when the listing has no row for it.
lm_host_state() {
  local listing=""
  listing="$("$ORCH_SCRIPTS/orch-runtime" host list 2>"$WORK_DIR/list.err")" || listing=""
  awk -F'\t' -v item="/$ITEM" 'NF >= 2 && substr($1, length($1) - length(item) + 1) == item { print $2; found = 1; exit }
    END { if (!found) print "unknown" }' <<<"$listing"
}

# The newline-terminated prefix of SRC, written to DEST. A partial last line is
# a writer still appending; it is left for the next read. Where the last line
# ends is `mailbox_line_complete`, the one owner both sides of a mailbox ask,
# so the reader and the writer cannot come apart on it.
lm_terminated() { # SRC DEST
  local complete=0
  : >"$2" || refuse write-failed "$2"
  if [ -f "$1.index" ]; then
    cp -- "$1.index" "$2.index" && cp -- "$1.header" "$2.header" || refuse write-failed "$2"
  else
    awk '{ print NR }' <"$1" >"$2.index" || refuse file-unreadable "$1"
  fi
  [ -s "$1" ] || return 0
  [ -r "$1" ] || refuse file-unreadable "$1"
  mailbox_line_complete "$1" || complete=$?
  [ "$complete" -ne 2 ] || refuse file-unreadable "$1"
  if [ "$complete" -eq 0 ]; then
    cat -- "$1" >"$2" 2>"$WORK_DIR/read.err" \
      || refuse file-unreadable "$1" "$(cat -- "$WORK_DIR/read.err")"
  else
    awk 'NR > 1 { print prev } { prev = $0 }' <"$1" >"$2" 2>"$WORK_DIR/read.err" \
      || refuse file-unreadable "$1" "$(cat -- "$WORK_DIR/read.err")"
    # Raw snapshots reserve the next logical number for the fragment. Only
    # this terminated-prefix decision makes that number readable.
    awk 'NR > 1 { print prev } { prev = $0 }' <"$1.index" >"$2.index" || refuse file-unreadable "$1"
    if [ -f "$1.header" ]; then
      awk '{ sub(/^count=/, "", $1); printf "count=%d %s\n", $1 - 1, $2 }' <"$1.header" >"$2.header" || refuse file-unreadable "$1"
    fi
  fi
}

lm_count() { # FILE — logical complete lines, parsing or not
  if [ -f "$1.header" ]; then
    awk '{ sub(/^count=/, "", $1); print $1 }' <"$1.header"
    return
  fi
  awk 'END { print NR + 0 }' <"$1"
}

# Filter a snapshot by logical number, not by its compacted physical offset.
lm_after_file() { # FILE SEEN DEST [BEFORE]
  awk -v seen="$2" -v before="${4:-}" 'FILENAME == ARGV[1] { line[FNR] = $0; next }
    line[FNR] > seen && (before == "" || line[FNR] < before)' "$1.index" "$1" >"$3" || refuse file-unreadable "$1"
}

# The line a cursor reader saves: the count, and the id its first line carries,
# empty when that line is no envelope or its id is outside the item alphabet.
# A replacement mailbox opens with another envelope, so a reader holding the
# old count can tell the file it was taken on from one that has as many lines.
lm_header() { # FILE
  local first
  if [ -f "$1.header" ]; then
    cat -- "$1.header" || refuse file-unreadable "$1.header"
    return
  fi
  first="$(awk 'NR == 1 { print; exit }' <"$1" |
    jq -r -R '(fromjson? // empty) | objects | .id | strings | select(test("^[A-Za-z0-9._-]+$"))')" \
    || refuse file-unreadable "$1"
  printf 'count=%s first=%s\n' "$(lm_count "$1")" "$first"
}

# The parsing JSON objects among FILE's lines. A terminated line that does not
# parse is dropped here and counted above. Events name BOX to carry logical
# line numbers before that filtering, aligned with the Jarvis session's seen count.
lm_objects() { # FILE [BOX [AFTER]]
  local count=0 numbers=/dev/null snapshot=false now=0
  [ "$ITEM" != overseer ] || mailbox_warn_legacy "$1" || return 2
  if [ -n "${2:-}${3:-}" ]; then
    count="$(lm_count "$1")" || return 1
    numbers="$1.index"
  fi
  if [ "$VERB" = events ] && [ -z "${3:-}" ]; then
    snapshot=true
    now="$(date -u +%s)" || return 1
  fi
  # Posting evidence and a reservation land after the immutable ask. Fold them
  # before cursor selection, while keeping the ask's original logical position.
  jq -c -R -n --arg box "${2:-}" --arg after "${3:-}" --argjson count "$count" \
    --argjson snapshot "$snapshot" --argjson now "$now" \
    --slurpfile numbers "$numbers" "$MAILBOX_TIME_JQ$MAILBOX_CLASS_JQ$OWNER_TRACKER_JQ"'
    [inputs | input_line_number as $physical | (fromjson? // empty) | objects
      | {physical: $physical, envelope: .}] as $rows
    | [$rows[].envelope | select(owner_private)] as $private
    | $rows[] | .physical as $physical | .envelope
    | owner_tracker_public
    | owner_tracker_record($private)
    | owner_ask_reserved($private)
    # Snapshot consumers reread every ask; cursor consumers must retain pending
    # asks at their original line. The bound releases interrupted tracker writes.
    | if $snapshot then owner_tracker_snapshot($now) else . end
    | select($after == "" or $numbers[$physical - 1] > ($after | tonumber))
    | if $box == "" then . else . + {box: $box, line: $numbers[$physical - 1], count: $count}
        + (if $box == "to-lane" then {mail_class: overseer_mail_class} else {} end)
      end' <"$1"
}

# The receipt's measured fields, read before the append so that nothing able
# to fail sits between the append and the line reporting it: a send that
# landed always prints its receipt, and a caller reads silence as a send that
# did not.
lm_receipt_fields() { # LINE — sets SENT_ID, SENT_BYTES and SENT_MONITOR
  SENT_BYTES="$(jq -r '.text | utf8bytelength' <<<"$1")" || refuse write-failed "$TO_LANE"
  SENT_ID="$(cat -- "$WORK_DIR/id")" || refuse file-unreadable "$WORK_DIR/id"
  SENT_MONITOR="$(lm_monitor)" || exit "$?"
}

# `live` where the mailbox's watch record is fresh, `none` otherwise: absent,
# stale, or not the shape `watch` writes. Read through lm_fetch, so a hosted
# lane's record is read on the host that holds it and a host out of reach is
# refused rather than reported as no monitor.
lm_monitor() {
  local now=""
  now="$(date -u +%s)" || refuse write-failed "$BOX"
  lm_fetch "$WATCH_FILE" "$WORK_DIR/watch.rec"
  awk -v now="$now" '
    NR == 1 && $1 ~ /^at=[0-9]+$/ && $2 ~ /^interval=[0-9]+$/ {
      at = substr($1, 4) + 0; interval = substr($2, 10) + 0
      if (now - at >= 0 && now - at <= 2 * interval + 5) live = 1
    }
    END { print (live ? "live" : "none") }' <"$WORK_DIR/watch.rec" || refuse file-unreadable "$WATCH_FILE"
}

# The receipt itself: the item the send reached, the id of the envelope it
# appended, the bytes of message text that envelope carries, and whether a
# monitor stands on the mailbox.
lm_sent() {
  if [ "$VERB" = notice ]; then
    printf 'lane-mail: sent item=%s id=%s bytes=%s to=%s ref=%s' "$ITEM" "$SENT_ID" "$SENT_BYTES" "$TO" "$REF"
    [ "$PROGRESS" -eq 0 ] || printf ' progress=1'
    printf '\n'
  else
    printf 'lane-mail: sent item=%s id=%s bytes=%s monitor=%s\n' "$ITEM" "$SENT_ID" "$SENT_BYTES" "$SENT_MONITOR"
  fi
}

# Whether the checkout's overseer mailbox has a reader. Peer delivery reports
# this after landing; --require-reader refuses before an owner directive. The
# reader is the one session the checkout's fleet record names under
# `.controller`: the lane-mail-check hooks hand the mailbox to that session
# alone, and a live watch there reads it itself. Whether it still runs is
# agent-runtime's controller status, which lm_require_overseer read for this
# root: `live: false` is nobody to read it, and its `controller-unreadable`
# refusal is a read that failed, reported with its own cause. A hosted
# peer's record and tmux server sit on its own host, out of this shell's
# reach.
lm_peer_reader() {
  if [ "$HOST" -eq 1 ]; then
    lm_reader_report reader-unjudged "$ROOT" cause=hosted
  elif [ -n "$LM_READER_CAUSE" ]; then
    lm_reader_report reader-unjudged "$ROOT" "cause=$LM_READER_CAUSE" "$(cat -- "$WORK_DIR/status.err")"
  elif [ "$LM_READER_LIVE" != true ]; then
    lm_reader_report no-reader "$ROOT" live=false
  fi
  return 0
}

lm_reader_report() { # KEY ROOT CAUSE [DETAIL]
  if [ "$REQUIRE_READER" -eq 1 ]; then
    REFUSE_EXTRA="$3"
    refuse "$1" "$2" "${4:-}"
  fi
  lm_notice "$1" "$2" "$3" "${4:-}"
}

# Owner sends use full resolution; peer asks and replies share data-only
# resolution, so the caller cannot accept a record its replying peer misses.
lm_overseer_path() { # full|data ROOT
  if [ "$1" = data ]; then
    (unset ORCH_STATE_DIR; mailbox_fleet_record data "$2") 2>"$WORK_DIR/reader.err"
  else
    mailbox_fleet_record full "$2" 2>"$WORK_DIR/reader.err"
  fi
}

# `orch-runtime register --fleet` and the runtime's controller start or transfer
# (`orch-runtime op --fleet`) write the checkout-local fleet record.
# A missing record requires registration in the session that reads this
# checkout's mail. Remote overseers send from their host's checkout because
# this shell cannot read that host's fleet state.
lm_overseer_absent() { # ROOT
    printf 'lane-mail: overseer-absent=%s no overseer is recorded here; run orch-runtime register --fleet in the session that should read this checkout\x27s mail; for an overseer on another host, send from that host\x27s checkout\n' "$1" >&2
}
# The record at ROOT read through agent-runtime's controller status: no
# document or no controller in it is overseer-absent; a status that answers
# leaves `live` for lm_peer_reader, and its controller-unreadable refusal
# leaves the cause; any other answer is overseer-unreadable with its words.
LM_READER_LIVE=""
LM_READER_CAUSE=""
lm_require_overseer() { # full|data ROOT
  local scope="$1" root="$2" path reply answer
  LM_READER_LIVE="" LM_READER_CAUSE=""
  if [ ! -x "$AGENT_RUNTIME_SCRIPTS/agent-runtime" ]; then
    lm_overseer_absent "$root"
    printf '%s\n' 'agent-runtime is not installed beside this package, so no session reads this mailbox.' >&2
    exit 2
  fi
  if ! path="$(lm_overseer_path "$scope" "$root")"; then
    refuse overseer-unreadable "$root" "$(cat -- "$WORK_DIR/reader.err")"
  fi
  [ -n "$path" ] || refuse overseer-unreadable "$root"
  reply="$("$AGENT_RUNTIME_SCRIPTS/agent-runtime" controller status --record "$path" 2>"$WORK_DIR/status.err")" || :
  answer="$(jq -r 'if .ok then [(.result.recorded != null), .result.live]
    else ["refused", .refusal.key, ([.refusal.fields[] | select(.[0] == "cause") | .[1]] | first // "")] end
    | map(tostring) | join(" ")' <<<"$reply" 2>/dev/null)" || answer=""
  case "$answer" in
    'true true' | 'true false') LM_READER_LIVE="${answer#true }" ;;
    'false false' | 'refused record-missing '*) lm_overseer_absent "$root"; exit 2 ;;
    'refused controller-unreadable '?*) LM_READER_CAUSE="${answer#refused controller-unreadable }" ;;
    *) refuse overseer-unreadable "$root" "$(cat -- "$WORK_DIR/status.err")" ;;
  esac
}

# A notice on stderr that ends nothing: the keyed line closed by FIELD, the
# English, then the words of the command that could not answer, where any.
lm_notice() { # KEY VALUE FIELD [CAUSE]
  REFUSE_EXTRA="$3"
  lm_message "$1" "$2" >&2
  REFUSE_EXTRA=""
  [ -z "${4:-}" ] || printf '%s\n' "$4" >&2
}

# Runs in a command substitution: a refusal exits that subshell after writing
# its keyed line, and errexit carries the status out. jq's words are captured
# at the site and replayed under the key, never ahead of it.
# One clock read stamps the id, `at` and the deadline, so the three cannot
# straddle a second; jq's todate spells the same UTC form `date` did. Every
# owner-channel field rides the variable its option set, the draft the file
# lm_draft wrote, and is written only where set, so an envelope with none is
# byte-for-byte what it was before.
lm_envelope() { # KIND [RE] — prints the line; the id lands in WORK_DIR/id
  local id now line
  now="$(date -u +%s)" || refuse write-failed "$BOX"
  id="$now-$$-$RANDOM"
  printf '%s\n' "$id" >"$WORK_DIR/id" || refuse write-failed "$WORK_DIR/id"
  printf '%s\n' "$PARENT_JSON" >"$WORK_DIR/parent.json" || refuse write-failed "$WORK_DIR/parent.json"
  line="$(jq -cn --arg id "$id" --arg kind "$1" --argjson now "$now" --arg re "${2:-}" \
    --arg from "$FROM" --arg halt "$HALT" --arg options "$OPTIONS" \
    --arg to "$TO" --arg ref "$REF" --arg progress "$PROGRESS" --arg attach "$ATTACH" --arg recommend "$RECOMMEND" \
    --arg purpose "$PURPOSE" --arg open "$OPEN" --arg reserved "$RESERVED" --arg issue "$ISSUE" --arg action "$OWNER_DO" \
    --arg wait "$WAIT" --arg delivery "$DELIVERY_ID" --arg re_delivery "$RE_DELIVERY_ID" --arg by "$BY" --arg verb "$VERB" \
    --arg thread "$THREAD_TS" --arg source "$DATA_SOURCE" --slurpfile parent "$WORK_DIR/parent.json" \
    --argjson replaces "$REPLACES_FIELD" --argjson identity "$IDENTITY_FIELD" \
    --slurpfile draft "$DRAFT_RECORD" --rawfile text "$FILE" '
      $parent[0] as $parent |
      {id: $id, kind: $kind, at: ($now | todate), from: $from}
      + (if $re == "" then {} else {re: $re} end)
      + (if $source == "" then {} else {source: $source} end)
      + (if $halt == "1" then {halt: true} else {} end)
      + (if $to == "" then {} else {to: $to} end)
      + (if $issue == "" then {} else {issue: $issue} end)
      + (if $issue == "" then {} else {do: $action} end)
      + (if $identity == null then {} else {identity: $identity} end)
      + (if $replaces == [] then {} else {replaces: $replaces} end)
      + (if $ref == "" then {} else {ref: $ref} end)
      + (if $progress == "1" then {progress: true} else {} end)
      + (if $attach == "" then {} else {attach: $attach} end)
      + (if $open == "" then {} else {open: $open} end)
      + (if $purpose == "" then {} else {purpose: $purpose} end)
      + (if $recommend == "" then {} else {recommend: $recommend} end)
      + (if $reserved == "1" then {reserved: true} else {} end)
      + (if $wait == "" then {} else {wait: ($wait | tonumber), deadline: (($now + ($wait | tonumber) * 60) | todate)} end)
      + (if $delivery == "" then {} else {delivery_id: $delivery} end)
      + (if $thread == "" then {} else {thread_ts: $thread, parent: $parent} end)
      + (if $re_delivery == "" then {} else {re_delivery_id: $re_delivery} end)
      + (if $by == "" then {} else {by: $by} end)
      + (if $kind == "answer" and $by != "" then {closes: false, answer_source: $verb} else {} end)
      + (if $draft == [] then {} else {draft: $draft[0]} end)
      + {text: ($text | sub("\n$"; ""))}
      + (if $options == "" then {} else {options: ($options | split(","))} end)' \
    2>"$WORK_DIR/jq.err")" || refuse write-failed "$BOX" "$(cat -- "$WORK_DIR/jq.err")"
  printf '%s\n' "$line"
}
BY=""
RE_DELIVERY_ID=""

# Serialized on the file itself; to-overseer.jsonl has many writers, to-lane
# one. The lock, the created file and the closing of an unterminated last line
# are `lib/mailbox-append.sh`, the one owner a hosted append obeys too, so the
# two paths cannot drift apart. The here-string carries the line with the
# trailing newline a mailbox line ends on.
# GUARD, where given, is the check the library runs under the lock before the
# append; only an expected guard refusal returns 4 for the verb to name.
# Operational failures keep their diagnostics and never become a refusal
# based on an incomplete scan.
lm_append_local() { # FILE LINE [GUARD]
  local rc=0 candidate="" report=""
  mkdir -p -- "$BOX" || refuse write-failed "$BOX"
  if [ "$VERB" != resolve ] && [ -z "$DELIVERY_ID" ] && [ "${3:-}" != : ]; then
    candidate="$WORK_DIR/sent.json"
    printf '%s\n' "$2" >"$candidate" || refuse write-failed "$candidate"
  fi
  # The library opens the file itself, so a mailbox the lane cannot write is
  # the shell's own message on its stderr. Captured here and replayed under
  # the key, like every other failing command this script runs, so the keyed
  # line stays first and a reader is never met by a library path instead.
  mailbox_append_locked "$1" 30 "${3:-}" "$candidate" <<<"$2" 2>"$WORK_DIR/local.err" || rc=$?
  trap lm_cleanup EXIT
  if [ "$rc" -eq 4 ]; then
    report="$(cat -- "$WORK_DIR/local.err")" || refuse file-unreadable "$WORK_DIR/local.err"
    [ "${report#duplicate id=}" != "$report" ] || return 4
    refuse duplicate "${report#duplicate id=}"
  fi
  [ "$rc" -ne 5 ] || refuse mail-read-failed "$ITEM" "$(cat -- "$WORK_DIR/local.err")"
  [ "$rc" -ne 3 ] || refuse lock-failed "$1" "$(cat -- "$WORK_DIR/local.err")"
  [ "$rc" -eq 0 ] || refuse write-failed "$1" "$(cat -- "$WORK_DIR/local.err")"
  cat -- "$WORK_DIR/local.err" >&2
}

# Puts the replacement ASK_JSON makes in force over ENTRIES_JSON, the asks it
# replaces that are still open, in its `replaces` shape: each one's question
# comment is marked replaced, then the ask is closed as `resolve --id` closes
# it, by that verb itself. A comment Linear holds no longer closes its ask
# with no edit. A mark or a close that does not land leaves that ask open,
# printed as replace-unclosed, and the outcome incomplete: owner-answers
# retries it through `replace`, on the same comment ids. ACTOR is the acting
# identity a mark compares authors with, or empty with ACTOR_CAUSE naming why
# none reads. A changed outcome is appended; every line goes to stderr but the
# outcome line, which is printed last on stdout.
lm_replace_step() { # ASK_JSON ENTRIES_JSON ACTOR ACTOR_CAUSE
  local ask="$1" ask_id new_comment entry id cause key outcome=in-force before line now rc
  ask_id="$(jq -r '.id' <<<"$ask")" || refuse file-unreadable "$TO_OVERSEER"
  new_comment="$(jq -r '.tracker_comment // ""' <<<"$ask")" || refuse file-unreadable "$TO_OVERSEER"
  jq -c '.[]' <<<"$2" >"$WORK_DIR/replace-entries" || refuse file-unreadable "$TO_OVERSEER"
  while IFS= read -r entry; do
    [ -n "$entry" ] || continue
    id="$(jq -r '.id' <<<"$entry")" || refuse file-unreadable "$TO_OVERSEER"
    cause=""
    if [ "$(jq -r '.tracker_comment != null' <<<"$entry")" = true ]; then
      if [ -z "$3" ]; then
        cause="$4"
      else
        owner_tracker_replaced_comment "$SCRIPT_DIR/../../linear/scripts/linear.sh" "$WORK_DIR" "$entry" "$3" mark \
          "$new_comment" </dev/null
        case "$OWNER_REPLACE_STATE" in
          marked | absent) ;;
          foreign) cause=comment-foreign ;;
          unread) cause=comments-read ;;
          *) cause=comment-update ;;
        esac
      fi
    fi
    if [ -z "$cause" ]; then
      rc=0
      "$SCRIPT_DIR/lane-mail" resolve --item overseer --root "$ROOT" --id "$id" \
        </dev/null >"$WORK_DIR/replace.out" 2>"$WORK_DIR/replace.err" || rc=$?
      if [ "$rc" -eq 0 ]; then
        cat -- "$WORK_DIR/replace.out" >&2
      else
        key="$(head -n 1 -- "$WORK_DIR/replace.err")" || key=""
        key="${key#lane-mail: }"
        key="${key%%=*}"
        [ "$key" = resolved-already ] || cause="${key:-resolve}"
      fi
    fi
    if [ -n "$cause" ]; then
      printf 'lane-mail: replace-unclosed id=%s cause=%s\n' "$id" "$cause" >&2
      outcome=incomplete
    fi
  done <"$WORK_DIR/replace-entries"
  before="$(jq -r '.replacement // ""' <<<"$ask")" || refuse file-unreadable "$TO_OVERSEER"
  if [ "$outcome" != "$before" ]; then
    now="$(date -u +%s)" || refuse write-failed "$BOX"
    line="$(jq -c --arg outcome "$outcome" --arg from "$FROM" --argjson now "$now" '{id: (.id + "-replacement-" + $outcome),
      kind: "replacement", at: ($now | todate), from: $from, re: .id, outcome: $outcome, text: ""}' <<<"$ask")" ||
      refuse write-failed "$TO_OVERSEER"
    lm_append_local "$TO_OVERSEER" "$line" >&2
  fi
  printf 'lane-mail: replacement id=%s outcome=%s\n' "$ask_id" "$outcome"
}

# The guards the library runs under the lock. Each reads the file the line
# would join, complete lines only, since the writer holding the lock has
# closed any fragment, and leaves what it found in the work directory for the
# verb's refusal to name.

# The envelope already carrying this delivery id, its id into
# WORK_DIR/delivery.earlier; refuses where one stands.
lm_guard_delivery() { # FILE
  jq -r -R --arg key "$DELIVERY_ID" '(fromjson? // empty) | objects
    | select(.delivery_id == $key) | .id | strings' <"$1" >"$WORK_DIR/delivery.earlier" || return 2
  [ ! -s "$WORK_DIR/delivery.earlier" ]
}

# The latest owner notice carrying this send's text and stamped within the 24
# hours before it, its id into WORK_DIR/notice.earlier; refuses where one
# stands. The text alone is judged: a report re-sent with another attachment,
# reference or minute is words the owner already holds. The candidate is the
# file lm_append_local wrote, since a message can exceed one argument.
lm_guard_owner_notice() { # FILE
  jq -n -r -R --rawfile sent "$WORK_DIR/sent.json" "$MAILBOX_TIME_JQ"'
    ($sent | fromjson) as $candidate
    | ($candidate.at | at_epoch) as $now
    | [inputs | (fromjson? // empty) | objects
      | select(.kind == "notice" and .to == "owner" and .text == $candidate.text)
      | (.at | at_epoch) as $at
      | select($now != null and $at != null and ($now - $at) >= 0 and ($now - $at) <= 86400)
      | .id | strings]
    | last // empty' <"$1" >"$WORK_DIR/notice.earlier" || return 2
  [ ! -s "$WORK_DIR/notice.earlier" ]
}

# The record already closing this ask, into WORK_DIR/resolved.earlier as
# `<id> <by> <delivery_id>`; refuses where one stands.
lm_guard_resolve() { # FILE
  mailbox_warn_legacy "$1" || return 2
  jq -r -R --arg re "$MSGID" "$MAILBOX_CLASS_JQ"' (fromjson? // empty) | objects
    | select(overseer_mail_class == "close" and .re == $re)
    | "\(.id) \(.by) \(.delivery_id // "")"' <"$1" >"$WORK_DIR/resolved.earlier" || return 2
  [ ! -s "$WORK_DIR/resolved.earlier" ]
}

# Slack answers and closes share this file's lock. A retry is judged before
# the close, so a delivery that landed before closing still names its answer.
lm_guard_owner_answer() { # FILE
  [ -z "$DELIVERY_ID" ] || lm_guard_delivery "$1" || return $?
  lm_guard_resolve "$1"
}

# A default supplies words only where the owner supplied none. Test and
# append under the close's lock so a reply racing its deadline wins if it
# landed first. The close record follows these optional answer bytes.
lm_guard_close() { # FILE
  local reserved
  lm_guard_resolve "$1" || return $?
  if [ "$BY" = default ]; then
    # A reservation that landed after this ask was read is judged here, under
    # the close's lock, which reserve takes after its own append to judge the
    # close: however the two interleave, no default closes a reserved ask.
    # While this lock is held, compaction cannot be rewriting the ask's file.
    reserved="$(lm_objects "$TO_OVERSEER" |
      jq -r --arg id "$MSGID" 'select(.kind == "ask" and .id == $id) | .reserved == true')" || return 2
    if [ "$reserved" = true ]; then
      : >"$WORK_DIR/reserved.earlier" || return 3
      return 1
    fi
    jq -r -R --arg re "$MSGID" '(fromjson? // empty) | objects
      | select(.kind == "answer" and .re == $re) | .id' <"$1" >"$WORK_DIR/owner.answers" || return 2
    [ ! -s "$WORK_DIR/owner.answers" ] || return 0
  fi
  [ -z "$ANSWER_LINE" ] || printf '%s\n' "$ANSWER_LINE" >&9 || return 3
}

# The ask in to-overseer.jsonl with that id, into ASK_JSON, read through
# lm_fetch as every read of this mailbox is: the one judge of what an ask is,
# for the resolve that closes one and the reply that names one. In the
# overseer mailbox resolve accepts any ask; replies require an owner ask.
# In a lane's mailbox, it is the lane's own ask, which
# names no audience. Returns 1 with ASK_JSON empty where no such ask stands.
ASK_JSON=""
lm_ask_find() { # ID
  local to=""
  [ "$ITEM" != overseer ] || to=owner
  lm_fetch "$TO_OVERSEER" "$WORK_DIR/ask.raw"
  lm_terminated "$WORK_DIR/ask.raw" "$WORK_DIR/ask.jsonl"
  if ! ASK_JSON="$(lm_objects "$WORK_DIR/ask.jsonl" |
    jq -c --arg id "$1" --arg to "$to" --arg verb "$VERB" 'select(.kind == "ask" and ($verb == "resolve" or (.to // "") == $to) and .id == $id)' | awk 'NR == 1')"; then
    refuse file-unreadable "$TO_OVERSEER"
  fi
  [ -n "$ASK_JSON" ]
}

# The host worker delivers owner requests with send --delivery-id. Read each
# possible reference under the lock its writers take, then copy the delivery
# id before releasing it. Take only one file lock at a time; the ask's or
# notice's append takes its own lock after this read. The id matches a line of
# CLASS in TO_LANE, the box's to-lane.jsonl, or an owner ask in TO_OVERSEER
# where one is named.
lm_ref_find() { # ID CLASS TO_LANE [TO_OVERSEER]
  local id="$1" class="$2" lane="$3" path ref_json
  shift 2
  for path in "$@"; do
    [ -f "$path" ] || continue
    exec 9<"$path" || refuse file-unreadable "$path"
    orch_take_lock 9 "$path" 30 || { trap lm_cleanup EXIT; refuse lock-failed "$path"; }
    trap lm_cleanup EXIT
    LM_HELD_PATH="$path"
    if [ "$path" = "$lane" ]; then
      lm_fetch "$path" "$WORK_DIR/lane.raw"
      lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
      ref_json="$(lm_objects "$WORK_DIR/lane.jsonl" |
        jq -c --arg id "$id" --arg class "$class" "$MAILBOX_CLASS_JQ"' select(.id == $id and overseer_mail_class == $class)' |
        awk 'NR == 1')" || refuse file-unreadable "$path"
    else
      lm_ask_find "$id" || ASK_JSON=""
      ref_json="$ASK_JSON"
    fi
    if [ -n "$ref_json" ]; then
      RE_DELIVERY_ID="$(jq -r '.delivery_id // empty' <<<"$ref_json")" || refuse file-unreadable "$path"
    fi
    LM_HELD_PATH=""
    exec 9<&-
    orch_release_lock
    [ -z "$ref_json" ] || return 0
  done
  refuse ref-unknown "$id"
}

# Refuses `resolved-already` where a close of MSGID stands in to-lane.jsonl.
# reserve asks before its append, so a closed ask gains no record, and again
# after it under the lock the close's writer takes: a resolve --default that
# read the ask before the reservation landed has either closed it by then or
# reads the reservation under that lock. The first read takes no lock, since
# a close it misses is the second read's.
lm_reserve_unclosed() { # [locked]
  [ -f "$TO_LANE" ] || return 0
  if [ "${1:-}" = locked ]; then
    lm_locked 7 "$TO_LANE" lm_reserve_closes
  else
    lm_reserve_closes
  fi
}
lm_reserve_closes() {
  local rc=0
  lm_guard_resolve "$TO_LANE" 2>"$WORK_DIR/unclosed.err" || rc=$?
  [ "$rc" -ne 2 ] || refuse mail-read-failed "$ITEM" "$(cat -- "$WORK_DIR/unclosed.err")"
  [ "$rc" -eq 0 ] || {
    REFUSE_EXTRA="id=$(awk 'NR == 1 { print $1 }' <"$WORK_DIR/resolved.earlier")" ||
      refuse file-unreadable "$WORK_DIR/resolved.earlier"
    refuse resolved-already "$MSGID" "$(cat -- "$WORK_DIR/unclosed.err")"
  }
  cat -- "$WORK_DIR/unclosed.err" >&2
}

# The ask ID closes or answers, refused where none stands.
lm_ask() { # ID
  lm_ask_find "$1" || refuse ask-unknown "$1"
}

# The line resolve prints, once per resolution however many times it is asked.
lm_resolved() { # ASK_ID BY ANSWER_ID
  printf 'lane-mail: resolved id=%s by=%s answer=%s\n' "$1" "$2" "$3"
}

# An owner ask's deadline: --wait as given, else ORCH_ASK_WAIT_MINUTES from
# the kendex settings ladder, else 120. Read only for an owner ask, whose
# deadline the owner-channel ask help gives its meaning, and the ladder is
# loaded here for the deadline. Record reads use lm_overseer_path, with the
# peer's settings read as data, never sourcing a file of the peer's.
lm_wait_minutes() {
  if [ "$WAIT_GIVEN" -eq 1 ]; then
    case "$WAIT" in
      '' | *[!0-9]*) refuse minutes-invalid --wait ;;
    esac
    return 0
  fi
  # shellcheck source=lib/kendex-env.sh
  . "$SCRIPT_DIR/lib/kendex-env.sh"
  kendex_load_project_env "$OWN_ROOT" -- ORCH_ASK_WAIT_MINUTES 2>"$WORK_DIR/env.err" ||
    refuse file-unreadable "$OWN_ROOT/kendex.settings.toml" "$(cat -- "$WORK_DIR/env.err")"
  WAIT="${ORCH_ASK_WAIT_MINUTES-120}"
  case "$WAIT" in
    '' | *[!0-9]*) refuse minutes-invalid "ORCH_ASK_WAIT_MINUTES=$WAIT" ;;
  esac
}

# An owner ask's draft, the message the owner approves before it is sent as
# the owner: exactly recipient, medium and text, each a string holding a
# non-blank character, the medium one the relay delivers. text_hash is taken
# here over the decoded text the record carries, never read from the file, so
# `jq -j .draft.text | sha256sum` on the record reproduces it and an approval
# binds those exact bytes. The record reaches the envelope through
# WORK_DIR/draft.json, never argv.
lm_draft() {
  local verdict key value hasher hash draft_copy="$WORK_DIR/draft.input.json"
  { [ -f "$DRAFT" ] && [ -r "$DRAFT" ]; } || refuse file-unreadable "$DRAFT"
  cat -- "$DRAFT" >"$draft_copy" || refuse file-unreadable "$DRAFT"
  verdict="$(jq -rs '
    if length != 1 or (.[0] | type) != "object" then error("a draft is one JSON object") else .[0] end
    | ((["recipient", "medium", "text"] - keys) + (keys - ["recipient", "medium", "text"])
       + [to_entries[] | select((.value | type) != "string" or (.value | test("^\\s*$"))) | .key]) as $bad
    | if $bad != [] then ["draft-field", $bad[0]]
      elif (.medium | IN("slack-channel", "slack-thread", "email")) then ["ok", ""]
      else ["draft-medium", .medium] end
    | @tsv' -- "$draft_copy" 2>"$WORK_DIR/jq.err")" ||
    refuse file-unreadable "$DRAFT" "$(cat -- "$WORK_DIR/jq.err")"
  IFS=$'\t' read -r key value <<<"$verdict"
  [ "$key" = ok ] || refuse "$key" "$value"
  if command -v sha256sum >/dev/null 2>&1; then
    hasher="sha256sum"
  elif command -v shasum >/dev/null 2>&1; then
    hasher="shasum -a 256"
  else
    refuse command-missing sha256sum,shasum
  fi
  jq -j .text -- "$draft_copy" >"$WORK_DIR/draft.text" 2>"$WORK_DIR/jq.err" ||
    refuse file-unreadable "$DRAFT" "$(cat -- "$WORK_DIR/jq.err")"
  # shellcheck disable=SC2086  # hasher is a command and its own arguments.
  hash="$($hasher <"$WORK_DIR/draft.text" 2>"$WORK_DIR/hash.err")" ||
    refuse file-unreadable "$WORK_DIR/draft.text" "$(cat -- "$WORK_DIR/hash.err")"
  DRAFT_RECORD="$WORK_DIR/draft.json"
  jq -c --arg hash "${hash%% *}" '{recipient, medium, text, text_hash: $hash}' -- "$draft_copy" \
    >"$DRAFT_RECORD" 2>"$WORK_DIR/jq.err" || refuse file-unreadable "$DRAFT" "$(cat -- "$WORK_DIR/jq.err")"
}

# The line alone crosses the transport, and the provider adds it under a lock
# on the host that holds the file. No lock here would be the recipient's: a
# sender reading the mailbox, adding its line and putting the file back locks
# its own disk, so two senders on different machines both read the same file
# and the second put drops the first one's line with no error. A failed append
# is probed like a failed read, so a host out of reach keeps its own key and
# the state an operator acts on, and `host-append` is a host that answered.
lm_append_host() { # FILE LINE
  local rc=0 report=""
  printf '%s\n' "$2" >"$WORK_DIR/send.line" || refuse write-failed "$WORK_DIR/send.line"
  "$ORCH_SCRIPTS/orch-runtime" host append --item "$ITEM" "$1" <"$WORK_DIR/send.line" \
    >/dev/null 2>"$WORK_DIR/append.err" || rc=$?
  [ "$rc" -ne 0 ] || return 0
  if [ "$rc" -eq 4 ]; then
    report="$(cat -- "$WORK_DIR/append.err")" || refuse file-unreadable "$WORK_DIR/append.err"
    case "$report" in
      'duplicate id='*) refuse duplicate "${report#duplicate id=}" ;;
    esac
  fi
  lm_host_busy "$rc" "$WORK_DIR/append.err"
  lm_host_answers
  refuse host-append "$ITEM" "$(cat -- "$WORK_DIR/append.err")"
}

lm_read_file() {
  [ -n "$FILE" ] || refuse option-required --file
  { [ -f "$FILE" ] && [ -r "$FILE" ]; } ||
    REFUSE_EXTRA="resolved=$FILE" refuse file-unreadable "$FILE_GIVEN"
}

lm_after() { # VALUE
  case "$1" in
    '' | *[!0-9]*) refuse after-invalid "${1:-<unset>}" ;;
  esac
}

# FILE holds lines past the read cursor. Answers to notices have no `wait`,
# so inbox and watch must include them. A `wait` advances the same cursor
# past the answer it returns to keep that answer out of the next inbox read.
lm_inbox_objects() { # FILE
  lm_objects "$1"
}

# Replaced by rename, so a reader never meets a half-written count.
# lm_cursor_put answers with its status alone, for the --peek reads, which
# must not refuse; lm_cursor_write refuses where it fails.
lm_cursor_put() { # COUNT
  printf '%s\n' "$1" >"$WORK_DIR/cursor" && mv -- "$WORK_DIR/cursor" "$CURSOR"
}
lm_cursor_write() { # COUNT
  lm_cursor_put "$1" || refuse write-failed "$CURSOR"
}

# The count to-lane.cursor holds, as SEEN, read through the route every other
# read of this mailbox takes; a cursor that is not there counts 0, and
# CURSOR_ABSENT says it was not there, and CURSOR_COUNTED 0 says it held no
# count at all, absent or empty. inbox calls it under its lock; the readers
# that move no cursor take none, since the rename above never shows them half
# a count.
SEEN=0
CURSOR_ABSENT=0
CURSOR_COUNTED=1
lm_cursor_read() {
  lm_fetch "$CURSOR" "$WORK_DIR/cursor.read"
  CURSOR_ABSENT="$LM_FETCH_ABSENT"
  CURSOR_COUNTED=1
  SEEN="$(awk 'NR == 1 { print; exit }' <"$WORK_DIR/cursor.read")" || refuse file-unreadable "$CURSOR"
  case "$SEEN" in
    '') SEEN=0; CURSOR_COUNTED=0 ;;
    *[!0-9]*) refuse cursor-invalid "$CURSOR" ;;
  esac
}

lm_seconds() { # OPTION VALUE
  case "$2" in
    '' | *[!0-9]*) refuse seconds-invalid "$1" ;;
  esac
}

# Cursor, outbound, inbound: inbox takes the same cursor-before-mail order.
# Both mailbox locks span the exchange classification and the rewrite.
lm_compact_locked() {
  local counts root total archive
  lm_cursor_read
  lm_store plan "$BOX" "$WORK_DIR" "$COMPACT_CUTOFF" "$SEEN" "$MAILBOX_TIME_JQ$MAILBOX_CLASS_JQ"
  counts="$(cat -- "$WORK_DIR/counts.json")" || refuse file-unreadable "$BOX"
  total="$(jq '.["to-lane"] + .["to-overseer"]' <<<"$counts")" || refuse file-unreadable "$BOX"
  if [ "$total" -gt 0 ]; then
    root="$OWN_ROOT"
    [ -n "$root" ] || root="$ROOT"
    # The runtime judges the archive root against this mailbox and the state
    # directory, then files the dropped rows; a refusal keeps every row. With
    # no root placed it answers null, and the rows leave with no copy.
    archive="$("$ORCH_SCRIPTS/orch-runtime" archive write --project "$root" --removal-root "$BOX" \
      --stem "compact-$ITEM-$COMPACT_NOW" "$WORK_DIR/to-lane.jsonl" "$WORK_DIR/to-overseer.jsonl" \
      2>"$WORK_DIR/archive.err" | jq -er '.result.archive | if . == null then "" else strings end' 2>/dev/null)" ||
      refuse archive-failed "$BOX" "$(cat -- "$WORK_DIR/archive.err")"
    REFUSE_EXTRA="kept=${archive:-none}"
    lm_store rewrite "$BOX" "$WORK_DIR"
    REFUSE_EXTRA=""
    [ -z "$archive" ] || lm_message archived "$archive" >&2
  fi
  jq -r --arg item "$ITEM" '"compacted item=\($item) to-lane=\(.["to-lane"]) to-overseer=\(.["to-overseer"])"' <<<"$counts"
}

# The locks keep the existing cursor-before-outbound-before-inbound order.
# One helper consumes the pair while both inode locks are still held. It also
# replaces an inbox cursor under the cursor lock, without a second shell read.
if [ "$FAST_READ" -eq 1 ]; then
  command -v python3 >/dev/null 2>&1 || refuse command-missing python3
  case "$VERB" in
    drain) lm_after "$AFTER" ;;
    inbox)
      case "${ACK:+k}$PEEK" in 0 | k0 | 1) ;; *) refuse option-conflict '--peek,--ack' ;; esac
      [ -z "$ACK" ] || lm_after "$ACK"
      [ -d "$BOX" ] || mkdir -p -- "$BOX" || refuse write-failed "$BOX"
      : >>"$CURSOR.lock" || refuse write-failed "$CURSOR.lock"
      exec 7>>"$CURSOR.lock"
      orch_take_lock 7 "$CURSOR.lock" 30 || { trap lm_cleanup EXIT; refuse lock-failed "$CURSOR.lock"; }
      trap lm_cleanup EXIT ;;
  esac
  # These functions are defined below for the other verbs. The fast path does
  # not use their scratch files or per-file filters.
  READ_DELIVER=0
  if [ "$VERB:$PEEK:$ACK" = inbox:0: ]; then
    # Keep plain delivery outside READ_OUT so the locked helper can flush the
    # caller's output before it advances the cursor.
    exec 6>&1
    READ_DELIVER=1
  fi
  # The verb the helper reads as: a batch reads each lane as `drain
  # --receipts` does.
  READ_VERB="$VERB"
  READ_RECEIPTS="$RECEIPTS"
  if [ "$VERB" = drain-many ]; then READ_VERB=drain; READ_RECEIPTS=1; fi
fi
# One mailbox read on the fast path, printed as its verb prints it: ITEM,
# AFTER and the lm_box paths name the mailbox. A refusal ends the process.
lm_fast_read() {
  READ_BOX="$BOX"
  READ_ARGS=("$ITEM" "$READ_VERB" "$AFTER" "$READ_RECEIPTS" "$TO" "$DUE" "$PEEK" "$ACK" "$MAILBOX_TIME_JQ$MAILBOX_CLASS_JQ$OWNER_TRACKER_JQ" "$READ_DELIVER")
  if [ "$CACHED_READ" -eq 1 ]; then
    # A failed batch says nothing of any file it asked for, whatever status
    # it stored: refused here, never read past and never asked again.
    if [ -s "$LANE_HOST_READ_DIR/failed" ]; then
      lm_host_busy 1 "$LANE_HOST_READ_DIR/error"
      refuse mail-read-failed "$ITEM" "$(cat -- "$LANE_HOST_READ_DIR/error" 2>/dev/null)"
    fi
    READ_OUT="$(exec python3 "$SCRIPT_DIR/lib/lane-mail-store.py" read-cached "$LANE_HOST_READ_DIR" "$BOX" "${READ_ARGS[@]}")" || exit "$?"
  elif [ "$HOST" -eq 1 ]; then
    # read-many already fetched the host's files once. Copy its raw pair and
    # numbering into this helper's world, without starting a snapshot per file.
    LM_RAW_FETCH=1
    lm_fetch "$TO_LANE" "$WORK_DIR/to-lane.jsonl"
    lm_fetch "$TO_OVERSEER" "$WORK_DIR/to-overseer.jsonl"
    if [ "$RECEIPTS" -eq 1 ] || { [ "$VERB" = pending ] && [ -z "$TO" ] && [ "$DUE" -eq 0 ]; }; then
      lm_fetch "$CURSOR" "$WORK_DIR/to-lane.cursor"
      if [ "$LM_FETCH_ABSENT" -eq 1 ]; then
        rm -f -- "$WORK_DIR/to-lane.cursor"
        lm_fetch "$CURSOR.lock" "$WORK_DIR/to-lane.cursor.lock"
        [ "$LM_FETCH_ABSENT" -eq 0 ] || rm -f -- "$WORK_DIR/to-lane.cursor.lock"
      fi
    fi
    READ_BOX="$WORK_DIR"
    READ_OUT="$(exec 8<"$WORK_DIR/to-overseer.jsonl" 9<"$WORK_DIR/to-lane.jsonl"; \
      python3 "$SCRIPT_DIR/lib/lane-mail-store.py" read "$READ_BOX" "${READ_ARGS[@]}")" || exit "$?"
  else
    READ_OVER_LOCK="$TO_OVERSEER"
    [ "$VERB" != inbox ] || READ_OVER_LOCK=/dev/null
    READ_OUT="$(lm_read_pair "$READ_OVER_LOCK" "$TO_LANE" \
      python3 "$SCRIPT_DIR/lib/lane-mail-store.py" read "$READ_BOX" "${READ_ARGS[@]}")" || exit "$?"
  fi
  READ_HEADER="${READ_OUT%%$'\n'*}"
  if [[ "$READ_OUT" == *$'\n'* ]]; then READ_OUT="${READ_OUT#*$'\n'}"; else READ_OUT=""; fi
  IFS=$'\x1f' read -r READ_STATUS READ_KEY READ_VALUE READ_EXTRA READ_ASKED <<<"$READ_HEADER"
  if [ "$READ_STATUS" = error ]; then
    if [ "$HOST" -eq 1 ] && [[ "$READ_VALUE" == "$READ_BOX"/* ]]; then
      READ_VALUE="$BOX${READ_VALUE#"$READ_BOX"}"
    fi
    REFUSE_EXTRA="$READ_EXTRA"
    refuse "$READ_KEY" "$READ_VALUE" "$READ_OUT"
  fi
  [ -z "$READ_EXTRA" ] || lm_notice ack-clamped "$READ_EXTRA" "asked=$READ_ASKED"
  [ -z "$READ_KEY" ] || lm_notice cursor-lowered "$READ_KEY" "was=$READ_VALUE"
  while [ "${READ_OUT%%$'\n'*}" != output ]; do
    READ_HEADER="${READ_OUT%%$'\n'*}"
    READ_OUT="${READ_OUT#*$'\n'}"
    mailbox_legacy_notice "${READ_HEADER#*$'\x1f'}"
  done
  READ_OUT="${READ_OUT#output}"
  READ_OUT="${READ_OUT#$'\n'}"
  # A batch names each lane once its read answered, so a refused lane
  # leaves no half section.
  [ "$VERB" != drain-many ] || printf 'item=%s\n' "$ITEM"
  [ -z "$READ_OUT" ] || printf '%s\n' "$READ_OUT"
}
# Every lane of the request, in its order, each read as `drain --receipts`
# reads it, under its mailbox locks locally or from this host's snapshot,
# and printed under its `item=` line. A
# line short of its three fields, an item outside the alphabet or a cursor
# that is no count refuses as the single verb refuses it, naming the lane;
# the lanes already printed stand.
lm_drain_many() {
  local line item after root
  while IFS= read -r line || [ -n "$line" ]; do
    [ -n "$line" ] || continue
    item="${line%% *}"
    [ "$item" != "$line" ] || refuse root-unresolved "$item"
    line="${line#* }"
    after="${line%% *}"
    [ "$after" != "$line" ] || refuse root-unresolved "$item"
    root="${line#* }"
    case "$item" in
      . | .. | *[!A-Za-z0-9._-]*) refuse item-invalid "$item" ;;
    esac
    case "$after" in '' | *[!0-9]*) REFUSE_EXTRA="item=$item"; refuse after-invalid "$after" ;; esac
    [ "$HOST" -eq 0 ] || [ -n "$root" ] || refuse missing-value --root
    ITEM="$item"
    AFTER="$after"
    lm_box "$root"
    lm_fast_read
  done <"$FILE"
}
if [ "$FAST_READ" -eq 1 ]; then
  if [ "$VERB" = drain-many ]; then
    lm_read_file
    lm_drain_many
  else
    lm_fast_read
  fi
  exit 0
fi


case "$VERB" in
  compact)
    # Retention reads settings here, not on the hooks' reader path.
    COMPACT_DAYS="$("$ORCH_SCRIPTS/orch-env" ORCH_RECORD_RETENTION_DAYS 5)" || refuse retention-invalid ORCH_RECORD_RETENTION_DAYS
    # The relay's settings.py uses seven days when the setting is absent.
    THREAD_DAYS="$("$ORCH_SCRIPTS/orch-env" SLACK_THREAD_DAYS 7)" || refuse retention-invalid SLACK_THREAD_DAYS
    case "$COMPACT_DAYS:$THREAD_DAYS" in *[!0-9:]*) refuse retention-invalid "$COMPACT_DAYS:$THREAD_DAYS" ;; esac
    [ "$COMPACT_DAYS" -gt 0 ] && [ "$THREAD_DAYS" -gt 0 ] || refuse retention-invalid "$COMPACT_DAYS:$THREAD_DAYS"
    [ "$COMPACT_DAYS" -ge "$THREAD_DAYS" ] || COMPACT_DAYS="$THREAD_DAYS"
    COMPACT_NOW="$(date -u +%s)" || refuse write-failed "$BOX"
    COMPACT_CUTOFF="$((COMPACT_NOW - COMPACT_DAYS * 86400))"
    if [ ! -d "$BOX" ]; then
      printf 'compacted item=%s to-lane=0 to-overseer=0\n' "$ITEM"
    else
      lm_existing_lock 7 "$CURSOR.lock" lm_existing_lock 8 "$TO_OVERSEER" lm_existing_lock 9 "$TO_LANE" lm_compact_locked
    fi
    ;;

  ask | notice)
    lm_read_file
    # Talk stores the proposal's envelope text as UTF-8, capped at 256 bytes.
    # Match the envelope's removal of one final newline before counting bytes.
    if [ "$PURPOSE" = memory ]; then
      jq -en --rawfile text "$FILE" '$text | sub("\n$"; "") | utf8bytelength <= 256' >/dev/null ||
        refuse memory-too-long --file
    fi
    if [ "$VERB" = notice ] && [ -n "$OPTIONS" ]; then
      refuse option-unknown --options
    fi
    # The overseer's own ask or notice names its audience, the field the
    # relay, the report and pending all read; one with none reaches nobody.
    [ "$ITEM" != overseer ] || [ -n "$TO" ] || refuse option-required --to
    # An owner ask names what its deadline does, by its form (the
    # owner-channel ask help states each); one naming no form (--recommend,
    # --reserved or --draft) says nothing, so it is refused. `ask:overseer` is
    # always an owner ask, the audience check above having refused every
    # other.
    if [ "$VERB:$ITEM" = ask:overseer ]; then
      # A reserved decision has no option safe to stand at its deadline, so
      # it names none. A draft's choices are fixed so its deadline never
      # approves a send made as the owner; the checks below then run on them.
      if [ "$RESERVED" -eq 1 ]; then
        [ -z "$RECOMMEND" ] || refuse option-conflict '--reserved,--recommend'
        [ -z "$DRAFT" ] || refuse option-conflict '--reserved,--draft'
      elif [ -n "$DRAFT" ]; then
        [ -z "$OPTIONS" ] || refuse option-conflict '--draft,--options'
        [ -z "$RECOMMEND" ] || refuse option-conflict '--draft,--recommend'
        OPTIONS=approve,deny
        RECOMMEND=deny
        lm_draft
      fi
      # A recommendation stands when nobody answers, so silence must never
      # authorize an owner-reserved action through it: its sender names what
      # it does, and a reserved effect takes --reserved, the approval route.
      case "$EFFECT" in
        '' | none | irreversible | spend | commitment | as-owner | release) ;;
        *) refuse effect-required "$EFFECT" ;;
      esac
      if [ "$RESERVED" -eq 0 ] && [ -z "$DRAFT" ]; then
        case "$EFFECT" in
          none) ;;
          '') [ -z "$RECOMMEND" ] || refuse effect-required --effect ;;
          *) refuse ask-reserved-effect "$EFFECT" ;;
        esac
      fi
      [ -n "$RECOMMEND" ] || [ "$RESERVED" -eq 1 ] || refuse recommend-required "$TO"
      [ -n "$OPTIONS" ] || refuse option-required --options
      # The envelope records --options split on commas, so a value holding a
      # comma spans two choices and is none of them; without one, a match
      # between the delimiters is exactly one of those choices.
      if [ -n "$RECOMMEND" ]; then
        case "$RECOMMEND" in
          *,*) refuse recommend-invalid "$RECOMMEND" ;;
        esac
        case ",$OPTIONS," in
          *",$RECOMMEND,"*) ;;
          *) refuse recommend-invalid "$RECOMMEND" ;;
        esac
      fi
      lm_wait_minutes
    fi
    if [ -n "$REF" ]; then
      case "$REF" in
        *[!A-Za-z0-9._-]*) refuse ref-invalid "$REF" ;;
      esac
      # The envelope answered is an owner note in to-lane.jsonl or an owner
      # ask in to-overseer.jsonl, the two things the owner reads a reply to;
      # a notice of this overseer's own, a peer's line and a resolution
      # answer nothing the owner wrote. The note is judged by the class the
      # watch reports it under, so a line the watch calls a peer's is never
      # the owner's here.
      lm_ref_find "$REF" owner-note "$TO_LANE" "$TO_OVERSEER"
    fi
    [ -z "$ATTACH" ] || lm_attach_confined
    OWNER_TRACKER_ACTIVE=0
    if [ "$VERB:$ITEM:$TO" = ask:overseer:owner ] && [ -n "$ISSUE" ]; then
      # An ask without --issue needs no tracker. One with it is refused here,
      # before the append, where the settings cannot carry it to the item: a
      # chat-only ask would leave the asker pointing the owner at an item
      # that holds no question.
      if ! owner_tracker_settings "$SCRIPT_DIR"; then
        REFUSE_EXTRA="cause=$OWNER_TRACKER_SETTINGS_CAUSE${OWNER_TRACKER_UNSET:+ unset=$OWNER_TRACKER_UNSET}"
        refuse item-ask-unconfigured "$ISSUE"
      fi
      OWNER_TRACKER_ACTIVE=1
      # Named before the append, so a refused read leaves no ask pending.
      OWNER_TRACKER_ASKER="the $(lm_repository) overseer" || exit
    fi
    # The open asks this one replaces, read before the append so the new ask
    # is none of them and a refused one appends nothing: the one --replaces
    # names, and for an item ask each open owner ask, posted or not, whose
    # item has the same tracker identity. One identity read covers the new
    # item and every open ask's item, so a lower-case ref, a UUID or a moved
    # issue's former identifier names the item it is. The envelope's
    # `replaces` carries on the `replaces` of each ask it replaces that
    # reached the owner, so a reply under any question of the chain reaches
    # the one ask left open.
    REPLACE_OPEN='[]'
    REPLACE_ACTOR=""
    if [ "$VERB:$ITEM:$TO" = ask:overseer:owner ] && { [ -n "$ISSUE" ] || [ -n "$REPLACES" ]; }; then
      if [ -n "$REPLACES" ]; then
        lm_ask "$REPLACES"
        MSGID="$REPLACES"
        lm_reserve_unclosed
        MSGID=""
      fi
      "$SCRIPT_DIR/lane-mail" pending --item overseer --root "$ROOT" --to owner \
        >"$WORK_DIR/replace-open" 2>"$WORK_DIR/replace.err" ||
        refuse mail-read-failed "$ITEM" "$(cat -- "$WORK_DIR/replace.err")"
      { jq -r --arg issue "$ISSUE" --arg id "$REPLACES" '
          select(.kind == "ask" and (.issue | type) == "string" and ($issue != "" or .id == $id)) | .issue' \
          "$WORK_DIR/replace-open" && { [ -z "$ISSUE" ] || printf '%s\n' "$ISSUE"; }; } |
        sort -u >"$WORK_DIR/replace-refs" || refuse file-unreadable "$WORK_DIR/replace-open"
      REPLACE_REFS=()
      while IFS= read -r ref; do REPLACE_REFS+=("$ref"); done <"$WORK_DIR/replace-refs"
      IDENTITIES='{}'
      if [ "${#REPLACE_REFS[@]}" -gt 0 ]; then
        IDENTITIES="$(owner_tracker_identity "$SCRIPT_DIR/../../linear/scripts/linear.sh" "$WORK_DIR" \
          "${REPLACE_REFS[@]}" </dev/null)" ||
          refuse issue-unread "${ISSUE:-${REPLACE_REFS[0]}}" "$(cat -- "$WORK_DIR/identity.err")"
      fi
      [ -z "$ISSUE" ] || IDENTITY_FIELD="$(jq -c --arg issue "$ISSUE" '.[$issue] // null' <<<"$IDENTITIES")" ||
        refuse file-unreadable "$WORK_DIR/identity.err"
      REPLACE_OPEN="$(jq -cs --argjson identities "$IDENTITIES" --argjson new "$IDENTITY_FIELD" --arg id "$REPLACES" '
        map(select(.kind == "ask")
          | if (.issue | type) == "string" and (.issue as $ref | $identities | has($ref)) then .identity = $identities[.issue] else . end
          | select(.id == $id or ($new != null and .identity.uuid == $new.uuid)))' "$WORK_DIR/replace-open")" ||
        refuse file-unreadable "$WORK_DIR/replace-open"
      REPLACES_FIELD="$(jq -c "$OWNER_REPLACING_JQ"' map({id} + (if .tracker_comment != null then {tracker_comment} else {} end)
          + (if .identity != null then {identity} else {} end), (select(owner_replacing) | .replaces // [])[])
        | unique_by(.id)' <<<"$REPLACE_OPEN")" || refuse file-unreadable "$WORK_DIR/replace-open"
      # A mark known to be refused refuses the ask whole, before the append,
      # so no second question is posted beside one it cannot mark: a home
      # whose Linear package edits no comment, an acting identity that does
      # not read, and a question comment another identity wrote.
      if jq -e 'any(.[]; .tracker_comment != null)' <<<"$REPLACE_OPEN" >/dev/null; then
        REFUSE_EXTRA="id=$(jq -r 'map(select(.tracker_comment != null)) | first | .id' <<<"$REPLACE_OPEN")" ||
          refuse file-unreadable "$WORK_DIR/replace-open"
        if ! owner_tracker_replace_actor "$SCRIPT_DIR/../../linear/scripts/linear.sh" "$WORK_DIR" </dev/null; then
          case "$OWNER_REPLACE_CAUSE" in
            team-*) REFUSE_EXTRA=""; refuse replace-unconfigured "$OWNER_REPLACE_CAUSE" "$(cat -- "$WORK_DIR/replace-auth.err")" ;;
            *) refuse replace-unmarkable "$OWNER_REPLACE_CAUSE" "$(cat -- "$WORK_DIR/replace-auth.err")" ;;
          esac
        fi
        REPLACE_ACTOR="$OWNER_REPLACE_ACTOR"
        jq -c '.[] | select(.tracker_comment != null)' <<<"$REPLACE_OPEN" >"$WORK_DIR/replace-check" ||
          refuse file-unreadable "$WORK_DIR/replace-open"
        while IFS= read -r replaced; do
          REFUSE_EXTRA="id=$(jq -r '.id' <<<"$replaced")" || refuse file-unreadable "$WORK_DIR/replace-open"
          owner_tracker_replaced_comment "$SCRIPT_DIR/../../linear/scripts/linear.sh" "$WORK_DIR" "$replaced" \
            "$REPLACE_ACTOR" check </dev/null
          case "$OWNER_REPLACE_STATE" in
            foreign) refuse replace-unmarkable comment-foreign ;;
            unread) refuse replace-unmarkable comments-read "$(cat -- "$WORK_DIR/replace.err")" ;;
          esac
        done <"$WORK_DIR/replace-check"
        REFUSE_EXTRA=""
      fi
    fi
    LINE="$(lm_envelope "$VERB")"
    ASK_ID="$(cat -- "$WORK_DIR/id")" || refuse file-unreadable "$WORK_DIR/id"
    if [ "$OWNER_TRACKER_ACTIVE" -eq 1 ]; then
      LINE="$(jq -c '.tracker_pending = true' <<<"$LINE")" || refuse write-failed "$TO_OVERSEER"
    fi
    [ "$VERB" != notice ] || lm_receipt_fields "$LINE"
    # An owner notice is judged on its text for a day, under the lock after
    # the minute check, so a retry inside the minute keeps its `duplicate`.
    if [ "$VERB:$TO" = notice:owner ]; then
      lm_append_local "$TO_OVERSEER" "$LINE" lm_guard_owner_notice || {
        REFUSE_EXTRA="id=$(cat -- "$WORK_DIR/notice.earlier")"
        refuse owner-notice-repeated "$ITEM"
      }
    elif [ -n "$DELIVERY_ID" ]; then
      # A restarted asker uses send's existing key guard so the relay sees
      # no new ask, and the original tracker deadline and outcome stay intact.
      lm_append_local "$TO_OVERSEER" "$LINE" lm_guard_delivery || {
        REFUSE_EXTRA="id=$(cat -- "$WORK_DIR/delivery.earlier")"
        refuse delivery-repeated "$DELIVERY_ID"
      }
    else
      lm_append_local "$TO_OVERSEER" "$LINE"
    fi
    if [ "$OWNER_TRACKER_ACTIVE" -eq 1 ]; then
      if ! owner_tracker_ask "$SCRIPT_DIR/../../linear/scripts/linear.sh" "$LINE" "$WORK_DIR" "$OWNER_TRACKER_ASKER"; then
        owner_tracker_unwritten "$ISSUE" "$OWNER_TRACKER_CAUSE"
      fi
      if [ "$OWNER_TRACKER_POSTED" -eq 1 ]; then
        POSTED_LINE="$(jq -c --arg label "$OWNER_TRACKER_LABEL" --arg comment "$OWNER_TRACKER_COMMENT" '{id: (.id + "-tracker"),
          kind: "tracker-posted", at, from, re: .id, issue, tracker_label: $label}
          + (if $comment == "" then {} else {tracker_comment: $comment} end) + {text: ""}' <<<"$LINE")" ||
          refuse write-failed "$TO_OVERSEER"
      else
        POSTED_LINE="$(jq -c --arg cause "$OWNER_TRACKER_CAUSE" '{id: (.id + "-tracker"), kind: "tracker-failed", at, from,
          re: .id, issue, cause: $cause, text: ""}' <<<"$LINE")" || refuse write-failed "$TO_OVERSEER"
      fi
      lm_append_local "$TO_OVERSEER" "$POSTED_LINE"
    fi
    # The replacement takes effect where the new ask, folded with its
    # tracker outcome as owner-answers reads it, reached the owner. One whose
    # question did not reach the item replaces nothing, so the earlier
    # question stays the one the owner can answer. Every line goes to
    # stderr: stdout is the id.
    if [ "$REPLACE_OPEN" != '[]' ]; then
      REPLACE_ASK="$(jq -c --argjson outcome "${POSTED_LINE:-null}" "$OWNER_TRACKER_JQ"' owner_tracker_record([$outcome | values])' \
        <<<"$LINE")" || refuse file-unreadable "$TO_OVERSEER"
      if jq -e "$OWNER_REPLACING_JQ"' owner_replacing' <<<"$REPLACE_ASK" >/dev/null; then
        REPLACE_ENTRIES="$(jq -c --argjson open "$REPLACE_OPEN" '[.[] | select(.id as $id | any($open[]; .id == $id))]' \
          <<<"$REPLACES_FIELD")" || refuse file-unreadable "$WORK_DIR/replace-open"
        lm_replace_step "$REPLACE_ASK" "$REPLACE_ENTRIES" "$REPLACE_ACTOR" "" >&2
      else
        jq -r '.[] | "lane-mail: replace-unclosed id=\(.id) cause=tracker-unwritten"' <<<"$REPLACE_OPEN" >&2 ||
          refuse file-unreadable "$WORK_DIR/replace-open"
      fi
    fi
    if [ "$VERB" = ask ]; then
      printf 'id=%s\n' "$ASK_ID"
    else
      lm_sent
    fi
    ;;

  send)
    lm_read_file
    [ "$ITEM" = overseer ] || lm_send_channel
    if [ "$DIRECTIVE" -eq 1 ] && [ -n "$MSGID" ]; then
      [ "$HALT" -eq 0 ] || refuse option-conflict '--re,--halt'
      refuse option-conflict '--re,--directive'
    fi
    if [ -n "$DATA_SOURCE" ]; then
      [ "$HALT" -eq 0 ] || refuse option-conflict '--halt,--data'
      [ "$DIRECTIVE" -eq 0 ] || refuse option-conflict '--directive,--data'
      [ -z "$MSGID" ] || refuse option-conflict '--re,--data'
    fi
    if [ "$DIRECTIVE" -eq 0 ] && [ -z "$MSGID" ] && [ -z "$DATA_SOURCE" ]; then
      refuse option-required --re
    fi
    [ "$HALT" -eq 0 ] || [ "$ITEM" != overseer ] || refuse option-conflict '--item=overseer,--halt'
    if [ -n "$MSGID" ] && [ "$ITEM" = overseer ]; then
      lm_ask "$MSGID"
      BY=text
    fi
    # Owner replies are consumed by owner-channel readers without a fleet.
    if [ "$ITEM" = overseer ] && [ "$HOST" -eq 0 ] &&
       { [ -z "$MSGID" ] || [ "$(jq -r '.to // ""' <<<"$ASK_JSON")" != owner ]; }; then
      lm_require_overseer full "$ROOT"
    fi
    # Succession publishes the opened successor before stopping its predecessor.
    # The current record (not its pending command) therefore still names a pane
    # while neither session is taking a turn. No timer can make a dead pane read.
    [ "$REQUIRE_READER" -eq 0 ] || lm_peer_reader
    # The delivery-id check runs under the lock on the disk that holds the
    # file; a provider's append takes no guard, so a hosted send carries none.
    [ -z "$DELIVERY_ID" ] || [ "$HOST" -eq 0 ] || refuse option-conflict '--host,--delivery-id'
    # The provider's append makes the mailbox's directories, the root among
    # them, so a hosted lane root is judged first by the `.git` file git writes
    # into a linked worktree it registers: every hosted lane runs in one.
    if [ "$HOST" -eq 1 ] && [ "$ITEM" != overseer ]; then
      lm_fetch "$ROOT/.git" "$WORK_DIR/root.git"
      [ "$LM_FETCH_ABSENT" -eq 0 ] || REFUSE_EXTRA="root=$ROOT" refuse worktree-absent "$ITEM"
    fi
    # The envelope is built first and judged whole; lm_envelope writes the id
    # into the work directory and prints the line, so a refusal below leaves
    # nothing in any mailbox.
    if [ "$DIRECTIVE" -eq 1 ]; then
      LINE="$(lm_envelope directive)"
    elif [ -n "$DATA_SOURCE" ]; then
      LINE="$(lm_envelope data)"
    else
      LINE="$(lm_envelope answer "$MSGID")"
    fi
    # A send naming its delivery uses that key's guard under the append lock.
    # Other local sends and hosts with the repeat guard use the shared minute
    # check there. Older host libraries can append the same envelope again.
    lm_receipt_fields "$LINE"
    if [ "$HOST" -eq 1 ]; then
      lm_append_host "$TO_LANE" "$LINE"
    elif [ -n "$MSGID" ] && [ "$ITEM" = overseer ]; then
      if ! lm_append_local "$TO_LANE" "$LINE" lm_guard_owner_answer; then
        if [ -s "$WORK_DIR/delivery.earlier" ]; then
          REFUSE_EXTRA="id=$(cat -- "$WORK_DIR/delivery.earlier")"
          refuse delivery-repeated "$DELIVERY_ID"
        fi
        REFUSE_EXTRA="id=$(awk '{ print $1 }' <"$WORK_DIR/resolved.earlier")" ||
          refuse file-unreadable "$WORK_DIR/resolved.earlier"
        refuse resolved-already "$MSGID" "$(cat -- "$WORK_DIR/local.err")"
      fi
    elif [ -n "$DELIVERY_ID" ]; then
      lm_append_local "$TO_LANE" "$LINE" lm_guard_delivery || {
        REFUSE_EXTRA="id=$(cat -- "$WORK_DIR/delivery.earlier")"
        refuse delivery-repeated "$DELIVERY_ID"
      }
    else
      lm_append_local "$TO_LANE" "$LINE"
    fi
    lm_sent
    ;;

  resolve)
    [ "$ITEM" = overseer ] || refuse overseer-only "$ITEM"
    [ "$HOST" -eq 0 ] || refuse option-unknown --host
    [ -n "$MSGID" ] || refuse option-required --id
    if [ "$DEFAULT" -eq 1 ]; then
      [ -z "$FILE" ] || refuse option-conflict '--text,--default'
    elif [ -n "$FILE" ]; then
      lm_read_file
    fi
    lm_ask "$MSGID"
    if [ "$DEFAULT" -eq 1 ] || [ -n "$FILE" ]; then
      ASK_TO="$(jq -r '.to // empty' <<<"$ASK_JSON")" || refuse file-unreadable "$TO_OVERSEER"
      [ "$ASK_TO" = owner ] || refuse option-conflict "$MSGID"
    fi
    if [ "$DEFAULT" -eq 1 ]; then
      BY=default
      RESERVED_ASK="$(jq -r '.reserved == true' <<<"$ASK_JSON")" || refuse file-unreadable "$TO_OVERSEER"
      [ "$RESERVED_ASK" = false ] || refuse ask-reserved "$MSGID"
      # The recommendation is the answer's text, crossing the file every
      # text crosses: nothing here builds an envelope from an argument.
      jq -r '.recommend // empty' <<<"$ASK_JSON" >"$WORK_DIR/default.txt" ||
        refuse file-unreadable "$TO_OVERSEER"
      [ -s "$WORK_DIR/default.txt" ] || refuse recommend-missing "$MSGID"
      FILE="$WORK_DIR/default.txt"
    elif [ -n "$FILE" ]; then
      BY=text
    else
      BY=explicit
    fi
    ANSWER_LINE=""
    [ "$BY" = explicit ] || ANSWER_LINE="$(lm_envelope answer "$MSGID")"
    : >"$WORK_DIR/close.txt" || refuse write-failed "$BOX"
    FILE="$WORK_DIR/close.txt"
    LINE="$(lm_envelope resolution "$MSGID")"
    CLOSE_ID="$(cat -- "$WORK_DIR/id")" || refuse file-unreadable "$WORK_DIR/id"
    if lm_append_local "$TO_LANE" "$LINE" lm_guard_close; then
      lm_resolved "$MSGID" "$BY" "$CLOSE_ID"
    else
      [ ! -e "$WORK_DIR/reserved.earlier" ] || refuse ask-reserved "$MSGID"
      read -r EARLIER_ID EARLIER_BY EARLIER_KEY <"$WORK_DIR/resolved.earlier" ||
        refuse file-unreadable "$WORK_DIR/resolved.earlier"
      # The same delivery asking again gets the same close and no second
      # envelope: a relay that resolved and crashed before its mark cannot
      # turn the reply it holds into a directive.
      if [ -n "$DELIVERY_ID" ] && [ "$DELIVERY_ID" = "$EARLIER_KEY" ]; then
        lm_resolved "$MSGID" "$EARLIER_BY" "$EARLIER_ID"
      else
        REFUSE_EXTRA="id=$EARLIER_ID"
        refuse resolved-already "$MSGID" "$(cat -- "$WORK_DIR/local.err")"
      fi
    fi
    ;;

  reserve)
    [ "$ITEM" = overseer ] || refuse overseer-only "$ITEM"
    [ -n "$MSGID" ] || refuse option-required --id
    if ! lm_ask_find "$MSGID"; then
      # The id names no owner ask: say what it does name, where anything does.
      lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
      lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
      KIND="$(jq -r -R --arg id "$MSGID" '(fromjson? // empty) | objects | select(.id == $id) | .kind | strings' \
        "$WORK_DIR/ask.jsonl" "$WORK_DIR/lane.jsonl")" || refuse file-unreadable "$BOX"
      [ -n "$KIND" ] || refuse ask-unknown "$MSGID"
      REFUSE_EXTRA="kind=${KIND%%"$NL"*}"
      refuse not-owner-ask "$MSGID"
    fi
    lm_reserve_unclosed
    RESERVED_BEFORE="$(jq -r '.reserved == true' <<<"$ASK_JSON")" || refuse file-unreadable "$TO_OVERSEER"
    if [ "$RESERVED_BEFORE" = false ]; then
      : >"$WORK_DIR/reservation.txt" || refuse write-failed "$BOX"
      FILE="$WORK_DIR/reservation.txt"
      LINE="$(lm_envelope reservation "$MSGID")"
      lm_append_local "$TO_OVERSEER" "$LINE"
      lm_reserve_unclosed locked
    fi
    printf 'lane-mail: reserved id=%s\n' "$MSGID"
    ;;

  replace)
    [ "$ITEM" = overseer ] || refuse overseer-only "$ITEM"
    [ -n "$MSGID" ] || refuse option-required --id
    # The replacing ask, open or closed: an ask it replaced stays open until
    # the replacement lands, whatever closed the ask that replaced it.
    lm_ask "$MSGID"
    REPLACE_ASK="$ASK_JSON"
    if ! jq -e "$OWNER_REPLACING_JQ"' owner_replacing and (.replaces // []) != []' <<<"$REPLACE_ASK" >/dev/null; then
      printf 'lane-mail: replacement id=%s outcome=none\n' "$MSGID"
    else
      "$SCRIPT_DIR/lane-mail" pending --item overseer --root "$ROOT" --to owner \
        >"$WORK_DIR/replace-open" 2>"$WORK_DIR/replace.err" ||
        refuse mail-read-failed "$ITEM" "$(cat -- "$WORK_DIR/replace.err")"
      # The asks of its `replaces` still open, by the ids and comment ids
      # the ask recorded.
      REPLACE_ENTRIES="$(jq -c --slurpfile open "$WORK_DIR/replace-open" '
        [(.replaces // [])[] | select(.id as $id | any($open[]; .id == $id))]' <<<"$REPLACE_ASK")" ||
        refuse file-unreadable "$WORK_DIR/replace-open"
      REPLACE_ACTOR=""
      REPLACE_CAUSE=""
      if jq -e 'any(.[]; .tracker_comment != null)' <<<"$REPLACE_ENTRIES" >/dev/null; then
        if owner_tracker_replace_actor "$SCRIPT_DIR/../../linear/scripts/linear.sh" "$WORK_DIR" </dev/null; then
          REPLACE_ACTOR="$OWNER_REPLACE_ACTOR"
        else
          REPLACE_CAUSE="$OWNER_REPLACE_CAUSE"
        fi
      fi
      lm_replace_step "$REPLACE_ASK" "$REPLACE_ENTRIES" "$REPLACE_ACTOR" "$REPLACE_CAUSE"
    fi
    ;;

  events)
    if [ -n "$EVENT_BOX" ]; then
      AFTER="${AFTER:-0}"
      lm_after "$AFTER"
      case "$EVENT_BOX" in to-lane) EVENT_FILE="$TO_LANE" ;; to-overseer) EVENT_FILE="$TO_OVERSEER" ;; esac
      lm_fetch "$EVENT_FILE" "$WORK_DIR/events.raw"
      lm_terminated "$WORK_DIR/events.raw" "$WORK_DIR/events.jsonl"
      lm_header "$WORK_DIR/events.jsonl"
      lm_objects "$WORK_DIR/events.jsonl" "$EVENT_BOX" "$AFTER" || refuse file-unreadable "$EVENT_FILE"
      if [ "$MARK_READ" -eq 1 ]; then
        COUNT="$(lm_count "$WORK_DIR/events.jsonl")" || refuse file-unreadable "$EVENT_FILE"
        mkdir -p -- "$BOX" || refuse write-failed "$BOX"
        python3 "$SCRIPT_DIR/lib/lane-mail-store.py" cursor-put "$BOX/to-overseer.seen" "$COUNT" 2>"$WORK_DIR/store.err" ||
          refuse write-failed "$BOX/to-overseer.seen" "$(cat -- "$WORK_DIR/store.err")"
      fi
      exit 0
    fi
    lm_fetch "$TO_OVERSEER" "$WORK_DIR/over.raw"
    lm_terminated "$WORK_DIR/over.raw" "$WORK_DIR/over.jsonl"
    lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
    lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
    lm_objects "$WORK_DIR/over.jsonl" to-overseer || refuse file-unreadable "$TO_OVERSEER"
    lm_objects "$WORK_DIR/lane.jsonl" to-lane || refuse file-unreadable "$TO_LANE"
    ;;

  peer)
    lm_read_file
    # A peer's reply needs the caller's record too. Refuse the ask before
    # either append rather than delivering a question nobody can answer.
    [ "$PEER_VERB" != ask ] || lm_require_overseer data "$OWN_ROOT"
    [ "$HOST" -eq 1 ] || lm_require_overseer data "$ROOT"
    # An answer joins its ask only through the exact id, so one naming no
    # peer line this overseer received is refused before either append. That
    # line is in this repository's own mailbox, local even when REPO's is
    # hosted.
    if [ -n "$MSGID" ]; then
      PEER_HOST="$HOST"
      HOST=0
      lm_box "$OWN_ROOT"
      lm_plain
      lm_ref_find "$MSGID" peer "$TO_LANE"
      HOST="$PEER_HOST"
      lm_box "$ROOT"
    fi
    if [ "$PEER_VERB" = ask ]; then
      LINE="$(lm_envelope ask)"
    elif [ -n "$MSGID" ]; then
      LINE="$(lm_envelope answer "$MSGID")"
    else
      LINE="$(lm_envelope directive)"
    fi
    if [ "$PEER_VERB" = send ]; then
      lm_receipt_fields "$LINE"
    fi
    if [ "$HOST" -eq 1 ]; then
      lm_append_host "$TO_LANE" "$LINE"
    else
      lm_append_local "$TO_LANE" "$LINE"
    fi
    # An answer is read by the asker's `wait --item overseer --id`, which
    # reads to-lane.jsonl itself, so no named session is owed for it.
    if [ "$PEER_VERB" = send ]; then
      lm_sent
      [ -n "$MSGID" ] || lm_peer_reader
    fi
    # Record both directions locally for retention, only after delivery:
    # an undelivered ask must owe no answer, and an undelivered answer must
    # leave its inbound ask open. The id or receipt precedes the record so a
    # local write failure still tells the caller what the peer received.
    if [ "$PEER_VERB" = ask ]; then
      printf 'id=%s\n' "$(cat -- "$WORK_DIR/id")"
      lm_peer_reader
    fi
    if [ "$PEER_VERB" = ask ] || [ -n "$MSGID" ]; then
      lm_box "$OWN_ROOT"
      lm_plain
      lm_one_spelling
      lm_append_local "$TO_OVERSEER" "$LINE" :
    fi
    ;;

  wait)
    [ -n "$MSGID" ] || refuse option-required --id
    lm_seconds --timeout "$TIMEOUT"
    lm_seconds --interval "$INTERVAL"
    START="$(date -u +%s)"
    while :; do
      lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
      lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
      lm_objects "$WORK_DIR/lane.jsonl" |
        jq -c --arg re "$MSGID" 'select(.kind == "answer" and .re == $re)'>"$WORK_DIR/match"
      if [ -s "$WORK_DIR/match" ]; then
        : >>"$CURSOR.lock" || refuse write-failed "$CURSOR.lock"
        exec 9>>"$CURSOR.lock"
        orch_take_lock 9 "$CURSOR.lock" 30 || { trap lm_cleanup EXIT; refuse lock-failed "$CURSOR.lock"; }
        trap lm_cleanup EXIT
        lm_cursor_read
        ANSWER_ID="$(awk 'NR == 1' <"$WORK_DIR/match" | jq -r '.id')"
        jq -rR '(fromjson? // null) | if type == "object" then .id // "" else "" end' <"$WORK_DIR/lane.jsonl" >"$WORK_DIR/ids"
        ANSWER_AT="$(awk -v id="$ANSWER_ID" 'FILENAME == ARGV[1] { line[FNR] = $0; next }
          $0 == id { print line[FNR]; exit }' "$WORK_DIR/lane.jsonl.index" "$WORK_DIR/ids")"
        lm_after_file "$WORK_DIR/lane.jsonl" "$SEEN" "$WORK_DIR/unread" "$ANSWER_AT"
        lm_inbox_objects "$WORK_DIR/unread" >&2
        [ "$SEEN" -ge "$ANSWER_AT" ] || lm_cursor_write "$ANSWER_AT"
        awk 'NR == 1' <"$WORK_DIR/match" | jq -r '.text'
        exit 0
      fi
      NAP="$INTERVAL"
      if [ "$TIMEOUT" -gt 0 ]; then
        NOW="$(date -u +%s)"
        LEFT="$((TIMEOUT - (NOW - START)))"
        [ "$LEFT" -gt 0 ] || refuse timeout "$MSGID" "" 124
        # --timeout is a deadline, so a nap never runs past it: one shorter
        # than --interval would otherwise wait the whole interval, and one
        # that is not a multiple of it would overshoot by the remainder.
        [ "$LEFT" -ge "$NAP" ] || NAP="$LEFT"
      fi
      sleep "$NAP"
    done
    ;;

  inbox)
    case "${ACK:+k}$PEEK" in
      0 | k0 | 1) ;;
      *) refuse option-conflict '--peek,--ack' ;;
    esac
    [ -z "$ACK" ] || lm_after "$ACK"
    mkdir -p -- "$BOX" || refuse write-failed "$BOX"
    # One lock across the read and the rewrite, so the Stop hook and a
    # workflow wait point never hand the same line over twice. The lock is its
    # own file because a rename replaces the cursor, and a lock on the cursor
    # would be a lock on an inode the next reader no longer opens.
    : >>"$CURSOR.lock" || refuse write-failed "$CURSOR.lock"
    exec 9>>"$CURSOR.lock"
    orch_take_lock 9 "$CURSOR.lock" 30 || { trap lm_cleanup EXIT; refuse lock-failed "$CURSOR.lock"; }
    trap lm_cleanup EXIT
    lm_cursor_read
    # A mailbox read before its first line still leaves a count behind: the
    # fleet's state sync reads this file outside this script and takes one
    # numeric line, which an empty file is not. An empty cursor an earlier
    # inbox left is given its count the same way. Written under the lock, so a
    # first read racing another never renames 0 over a count it advanced.
    # A peek writes the same 0 but never refuses on it: the hooks peek before
    # every tool call, and a write that cannot land there would refuse each
    # one, the call that frees the disk included. Where the count cannot land
    # the peek still leaves a cursor, empty, as pending needs one beside the
    # lock to tell a lane that has read from a read that missed.
    if [ "$CURSOR_COUNTED" -eq 0 ]; then
      if [ "$PEEK" -eq 0 ]; then
        lm_cursor_write 0
      else
        lm_cursor_put 0 2>/dev/null || { : >>"$CURSOR"; } 2>/dev/null || :
      fi
    fi
    # One snapshot of the mailbox and its complete-line count, which the
    # --ack branch and the read below both take the cursor from.
    lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
    lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
    COUNT="$(lm_count "$WORK_DIR/lane.jsonl")"
    if [ -n "$ACK" ]; then
      # The count stops at the complete lines present: a cursor past them
      # marks read a line not yet written, which no watch then announces and
      # no inbox then prints.
      ASKED="$ACK"
      [ "$ACK" -le "$COUNT" ] || ACK="$COUNT"
      # The count stops at the line before
      # the first unread halt, whatever a hook that showed it acknowledges.
      jq -r -R '(fromjson? // null) | if type == "object" and .halt == true then "halt" else "-" end' \
        <"$WORK_DIR/lane.jsonl" >"$WORK_DIR/kinds" || refuse file-unreadable "$TO_LANE"
      HALT_AT="$(awk -v seen="$SEEN" 'FILENAME == ARGV[1] { line[FNR] = $0; next }
        line[FNR] > seen && $0 == "halt" { print line[FNR] - 1; exit }' "$WORK_DIR/lane.jsonl.index" "$WORK_DIR/kinds")" ||
        refuse file-unreadable "$TO_LANE"
      [ -z "$HALT_AT" ] || [ "$ACK" -le "$HALT_AT" ] || ACK="$HALT_AT"
      [ "$ASKED" -le "$COUNT" ] || lm_notice ack-clamped "$ACK" "asked=$ASKED"
      if [ "$SEEN" -gt "$COUNT" ]; then
        # A cursor still past the lines present, one an --ack wrote before the
        # clamp above that no peek could lower, comes down to the count acknowledged, never to the
        # line count: a line that landed after the peek this count came from
        # is not one the lane was shown.
        lm_notice cursor-lowered "$ACK" "was=$SEEN"
      elif [ "$ACK" -le "$SEEN" ]; then
        # Forward only: a Stop hook that peeked before a workflow wait point
        # handed more over acknowledges a count the cursor has already passed.
        exit 0
      fi
      lm_cursor_write "$ACK"
      exit 0
    fi
    # A peek brings a cursor already past the lines present down to them, as a
    # plain read does: the hooks --ack only after a peek that printed a line,
    # and a peek over such a cursor prints none, so no --ack would ever lower
    # it and the next line written would be marked read. Like the first-read
    # 0 above, a write that cannot land never refuses the peek.
    if [ "$PEEK" -eq 1 ] && [ "$SEEN" -gt "$COUNT" ] && lm_cursor_put "$COUNT" 2>/dev/null; then
      lm_notice cursor-lowered "$COUNT" "was=$SEEN"
    fi
    [ "$PEEK" -eq 0 ] || lm_header "$WORK_DIR/lane.jsonl"
    lm_after_file "$WORK_DIR/lane.jsonl" "$SEEN" "$WORK_DIR/unread"
    lm_inbox_objects "$WORK_DIR/unread"
    # Rewritten only when it moves, so a read that found nothing new leaves
    # the file as it was.
    [ "$PEEK" -eq 1 ] || [ "$COUNT" = "$SEEN" ] || lm_cursor_write "$COUNT"
    exec 9>&-
    orch_release_lock
    ;;

  watch)
    lm_seconds --interval "$INTERVAL"
    # The mailbox a launch created. A watch of any other directory would poll
    # an empty mailbox forever and read as armed, and one whose mailbox is
    # removed under it, its worktree gone, has no lane left to wake.
    [ -d "$BOX" ] || refuse mailbox-missing "$BOX"
    # The command the woken turn runs, always naming the root this watch
    # resolved: the turn may run it from another checkout, where a read with
    # no root would open that checkout's mailbox instead.
    printf -v WATCH_READ '%q inbox --item %q --root %q' "$SCRIPT_DIR/lane-mail" "$ITEM" "$ROOT"
    # Bash defers a trapped signal during any foreground external command,
    # including the heartbeat's date and mv. One job owns the whole iteration;
    # this shell only waits and reads its completed result. Job control gives
    # that job a group, so stopping it also stops a child that could republish
    # the record after the EXIT trap withdraws it. The jobspec holds ownership
    # without signalling a saved process number after it could be reused.
    trap 'rm -f -- "$WATCH_FILE"; lm_cleanup' EXIT
    lm_watch_stop() {
      trap '' HUP INT TERM
      # The mkdir lock fallback needs TERM to run its release trap.
      kill -TERM %+ 2>/dev/null || :
      wait %+ 2>/dev/null || :
      exit "$1"
    }
    trap 'lm_watch_stop 129' HUP
    trap 'lm_watch_stop 130' INT
    trap 'lm_watch_stop 143' TERM
    # Lines up to here are announced, or read before this watch started; the
    # cursor the lane's own `inbox` moves raises it, so mail already read is
    # never announced, and a fresh watch announces what stands unread.
    ANNOUNCED=0
    set -m
    while :; do
      {
        set +m
        trap - EXIT
        [ -d "$BOX" ] || refuse mailbox-missing "$BOX"
        printf 'at=%s interval=%s\n' "$(date -u +%s)" "$INTERVAL" >"$WORK_DIR/watch.rec" &&
          mv -- "$WORK_DIR/watch.rec" "$WATCH_FILE" || refuse write-failed "$WATCH_FILE"
        lm_cursor_read
        [ "$ANNOUNCED" -ge "$SEEN" ] || ANNOUNCED="$SEEN"
        lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
        lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
        lm_after_file "$WORK_DIR/lane.jsonl" "$ANNOUNCED" "$WORK_DIR/unread"
        NEW="$(lm_inbox_objects "$WORK_DIR/unread" | awk 'END { print NR + 0 }')" ||
          refuse file-unreadable "$TO_LANE"
        if [ "$NEW" -ne 0 ]; then
          REFUSE_EXTRA="new=$NEW" lm_message mail "$ITEM"
          printf '%s\n' "$WATCH_READ"
        fi
        ANNOUNCED="$(lm_count "$WORK_DIR/lane.jsonl")"
        # The copies of the mailbox this poll read go before the wait, so a
        # watch killed there leaves none of the lane's messages behind.
        rm -f -- "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl" "$WORK_DIR/unread"
        printf '%s %s\n' "$ANNOUNCED" "$NEW" >"$WORK_DIR/poll" || refuse write-failed "$WORK_DIR/poll"
        if [ "$ONCE" -eq 0 ] || [ "$NEW" -eq 0 ]; then sleep "$INTERVAL"; fi
      } &
      wait "$!"
      read -r ANNOUNCED NEW <"$WORK_DIR/poll"
      # The exit is the wake, and the EXIT trap withdraws the record until
      # the lane re-arms its monitor.
      [ "$ONCE" -eq 0 ] || [ "$NEW" -eq 0 ] || exit 0
    done
    ;;


esac
