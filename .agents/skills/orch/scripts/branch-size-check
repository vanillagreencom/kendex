#!/usr/bin/env bash
# branch-size-check measures a branch's added lines against its issue allowance.
#
# Usage:
#   branch-size-check --worktree PATH --issue ID [--state-dir DIR] [--json]
#     [--cut-from-round PATH]
#
# --issue is the workflow-state key whose issue states this branch's allowance
# in its `**Expected delta**` line: `issue-N` for GitHub, the tracker
# identifier (KEN-123) otherwise. The repository-local `pr-N` fallback that
# ci-fix, merge-pr and review-pr-comments use for a branch carrying no issue id
# names no issue, so no tracker is read, the branch is measured, and the
# verdict is allowance_missing. A key that does name an issue the tracker
# cannot read stays an environment failure: its allowance is unknown, not
# absent.
#
# State directory resolution is defined by `workflow-state --help`.
#
# Added lines only are counted, from `git diff --numstat --find-renames`
# against the base branch: a pure move costs nothing and a rewrite costs what
# it adds. They are shown in three parts — production; test, a path under
# test/, tests/ or __tests__/ or named tests.rs, *test_util.rs, *.test.* or
# *.spec.*, or matching a glob in ORCH_SIZE_TEST_PATHS; render mirror, a path
# under ORCH_SIZE_RENDER_ROOTS whose source changed in the same diff — and
# only the first two are judged. The split is by path: a test module inside a
# source file counts with its file.
#
# ORCH_SIZE_TEST_PATHS only adds to that rule, never takes from it. A glob
# matches the whole repository-relative path, with `*` any run of characters
# including `/`, `?` any single character, and everything else literal. Left
# empty, or matching nothing, every line stays where the built-in rule put it,
# which for a path that rule does not name is production and the stricter
# allowance.
#
# The allowance is the issue's own `**Expected delta**` line and nothing else,
# in one of two forms (use singular for count=1, plural for count≥2):
#   **Expected delta**: 1 line
#   **Expected delta**: 250 lines
#   **Expected delta**: 1 line, 1 test line
#   **Expected delta**: 250 lines, 120 test lines
# Production additions past the first count report over, as do test additions
# past the second. With no test count the test lines are shown and not judged.
# Nothing is judged when no allowance was read at all: the verdict is
# allowance_missing, the counts are reported for the reviewer, and the exit is
# 0. Its two causes are named apart in the reason — an issue that was read and
# states no line, and a key that names no issue to read. A line in any other
# shape is a usage failure fixed on the issue.
#
# The verdict is recorded as workflow state pr.size_check, bound to the base
# and head SHAs it measured, except during a cut comparison.
#
# --cut-from-round uses the round's cut_comparison and leaves pr.size_check
# unchanged. An unsized comparison uses its recorded production and test
# counts. Cut acceptance and retry delegation supply this path.
#
# Exit codes: 0 for every measured verdict; 2 a usage or environment failure;
# 3 a malformed Expected delta line.
#
# ORCH_SIZE_RENDER_ROOTS   render-mirror roots, blank separated, read by every
#                          branch measurement (default ".agents .claude .codex .pi")
# ORCH_SIZE_TEST_PATHS     extra test-path globs, blank separated, added to
#                          the built-in test rule (default empty)

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

print_usage() {
  sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'
}

# `.env.local` is sourced as shell by the settings loader, so a help request is
# answered before any project configuration is read.
for _arg in "$@"; do
  case "$_arg" in
  --help | -h | help) print_usage; exit 0 ;;
  esac
done
unset _arg

# shellcheck source=lib/branch-growth.sh
source "$SCRIPT_DIR/lib/branch-growth.sh"

ID_GRAMMAR='^[A-Za-z0-9._-]+$'
NO_ISSUE_KEY_GRAMMAR='^pr-[0-9]+$'
DELTA_GRAMMAR='^(1 line|[2-9] lines|[1-9][0-9]+ lines)(, (1 test line|[2-9] test lines|[1-9][0-9]+ test lines))?$'

# Callers preserve positional values for this diagnostic catalog.
message() {
  local _message_key="$1"
  shift
  case "$_message_key" in
    worktree-value)
      printf 'branch-size-check: worktree-value option=%s\n' "--worktree"
      printf '%s\n' "--worktree requires a value"
      ;;
    issue-value)
      printf 'branch-size-check: issue-value option=%s\n' "--issue"
      printf '%s\n' "--issue requires a value"
      ;;
    state-dir-value)
      printf 'branch-size-check: state-dir-value option=%s\n' "--state-dir"
      printf '%s\n' "--state-dir requires a path"
      ;;
    unknown-argument)
      printf 'branch-size-check: unknown-argument arg1=%s\n' "$1"
      printf '%s\n' "unknown argument: $1"
      ;;
    missing-worktree)
      printf 'branch-size-check: missing-worktree option=%s\n' "--worktree"
      printf '%s\n' "--worktree is required"
      ;;
    not-directory)
      printf 'branch-size-check: not-directory worktree=%s\n' "$worktree"
      printf '%s\n' "--worktree path '$worktree' is not a directory"
      ;;
    missing-issue)
      printf 'branch-size-check: missing-issue option=%s\n' "--issue"
      printf '%s\n' "--issue is required (the workflow-state key whose issue states the branch's allowance)"
      ;;
    invalid-issue)
      printf 'branch-size-check: invalid-issue issue=%s\n' "$issue"
      printf '%s\n' "--issue '$issue' must match ${ID_GRAMMAR} with no '..'"
      ;;
    missing-jq)
      printf 'branch-size-check: missing-jq exit=%s\n' "2"
      printf '%s\n' "jq is required"
      ;;
    not-repository)
      printf 'branch-size-check: not-repository worktree=%s\n' "$worktree"
      printf '%s\n' "--worktree path '$worktree' is not inside a git repository"
      ;;
    missing-gh)
      printf 'branch-size-check: missing-gh issue=%s\n' "$issue"
      printf '%s\n' "gh is required to read GitHub issue '$issue'"
      ;;
    github-read)
      printf 'branch-size-check: github-read issue=%s\n' "$issue"
      printf '%s\n' "GitHub issue '$issue' could not be read"
      ;;
    missing-linear)
      printf 'branch-size-check: missing-linear issue=%s\n' "$issue"
      printf '%s\n' "the linear skill is required to read '$issue'"
      ;;
    linear-read)
      printf 'branch-size-check: linear-read issue=%s\n' "$issue"
      printf '%s\n' "issue '$issue' could not be read from the Linear cache"
      ;;
    invalid-delta)
      printf 'branch-size-check: invalid-delta issue=%s delta-line=%s\n' "$issue" "$delta_line"
      printf '%s\n' "the expected delta stated by '$issue' does not parse: '$delta_line' — use singular forms for count=1 (1 line, 1 test line) and plural for count≥2 (250 lines, 120 test lines)"
      ;;
    invalid-round)
      printf 'branch-size-check: invalid-round path=%s\n' "$cut_from_round"
      printf 'The cut round has no readable size comparison.\n'
      ;;
    measurement-failed)
      printf 'branch-size-check: measurement-failed worktree=%s\n' "$worktree"
      printf '%s\n' "$BRANCH_GROWTH_ERROR"
      ;;
    base-missing)
      printf 'branch-size-check: base-missing BRANCH-GROWTH-BASE-REF=%s worktree=%s\n' "$BRANCH_GROWTH_BASE_REF" "$worktree"
      printf '%s\n' "base ref '$BRANCH_GROWTH_BASE_REF' names no commit in '$worktree'"
      ;;
    head-missing)
      printf 'branch-size-check: head-missing worktree=%s\n' "$worktree"
      printf '%s\n' "HEAD names no commit in '$worktree'"
      ;;
    state-write)
      printf 'branch-size-check: state-write verdict=%s issue=%s\n' "$verdict" "$issue"
      printf '%s\n' "the $verdict verdict for '$issue' could not be recorded in workflow state"
      ;;
    result)
      printf 'branch-size-check: %s production=%s tests=%s mirror=%s allowance=%s test-allowance=%s\n' \
        "$verdict" "$production_lines" "$test_lines" "$mirror_lines" "${allowance:-none}" "${test_allowance:-none}"
      case "$verdict" in
        pass) printf 'The branch is within its stated allowance.\n' ;;
        allowance_missing)
          if [[ "$no_issue" == true ]]; then
            printf 'The key names no issue, so no allowance was read. Report the measured counts for review.\n'
          else
            printf 'No allowance was stated. Report the measured counts for review.\n'
          fi
          ;;
        over) printf 'The branch exceeds its stated allowance. Report the counts for review.\n' ;;
      esac
      ;;
  esac
}

die() {
  message "$@" >&2
  [[ "$1" != invalid-delta ]] || exit 3
  exit 2
}

worktree=""
issue=""
state_dir=""
as_json=false
cut_from_round=""
while (( $# > 0 )); do
  case "$1" in
    --worktree)  [[ $# -ge 2 ]] || die worktree-value "$@";  worktree="$2";  shift 2 ;;
    --issue)     [[ $# -ge 2 ]] || die issue-value "$@";     issue="$2";     shift 2 ;;
    --state-dir) [[ $# -ge 2 ]] || die state-dir-value "$@";  state_dir="$2"; shift 2 ;;
    --json)      as_json=true; shift ;;
    --cut-from-round) [[ $# -ge 2 ]] || die invalid-round; cut_from_round="$2"; shift 2 ;;
    *) die unknown-argument "$@" ;;
  esac
done

[[ -n "$worktree" ]] || die missing-worktree "$@"
[[ -d "$worktree" ]] || die not-directory "$@"
[[ -n "$issue" ]] || die missing-issue "$@"
[[ "$issue" =~ $ID_GRAMMAR && "$issue" != *..* ]] \
  || die invalid-issue "$@"
command -v jq >/dev/null 2>&1 || die missing-jq "$@"

state_flags=()
[[ -z "$state_dir" ]] || state_flags=(--state-dir "$state_dir")

REPO_ROOT="$(git -C "$worktree" rev-parse --show-toplevel 2>/dev/null)" \
  || die not-repository "$@"
export PROJECT_ROOT="$REPO_ROOT"
export SCRIPT_DIR
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
# The private env file is sourced here, and anything it prints would precede
# the --json record on stdout.
kendex_load_project_env "$REPO_ROOT" >&2

test_paths="${ORCH_SIZE_TEST_PATHS:-}"

# --- The issue's own text is the one source of the allowance ----------------
# A tracker that cannot be read leaves no allowance to judge by and no way to
# say the issue states none, so it is an environment failure, never a verdict.
issue_body=""
# Set where the key names no issue to read, so the allowance_missing verdict
# reports that cause rather than an issue that was read and states no line.
no_issue=false
if [[ -n "$cut_from_round" ]]; then
  jq -e --arg issue "$issue" '
    .issue == $issue and .cut == true and
    (.cut_comparison | type == "object" and
      (.production_lines | type == "number") and (.test_lines | type == "number") and
      (.production_allowance == null or (.production_allowance | type == "number")) and
      (.test_allowance == null or (.test_allowance | type == "number")))
  ' "$cut_from_round" >/dev/null 2>&1 || die invalid-round
elif [[ "$issue" =~ $NO_ISSUE_KEY_GRAMMAR ]]; then
  no_issue=true
elif [[ "$issue" == issue-* ]]; then
  command -v gh >/dev/null 2>&1 || die missing-gh "$@"
  # gh and the Linear CLI both resolve their repository from the working
  # directory, which is the caller's, not the worktree's. The subshell scopes
  # the move; PROJECT_ROOT is dropped so the Linear cache honors the caller's
  # own LINEAR_CACHE_ROOT redirect.
  issue_body="$( (cd "$REPO_ROOT" && gh issue view "${issue#issue-}" --json body --jq '.body // ""') 2>/dev/null)" \
    || die github-read "$@"
else
  [[ -x "$SCRIPT_DIR/../../linear/scripts/linear.sh" ]] \
    || die missing-linear "$@"
  # The CLI answers on stderr when it has no issue to give, so both streams are
  # read: a JSON object naming no issue is the cache answering that it holds
  # none, and anything else is a read that did not happen at all.
  raw="$( (cd "$REPO_ROOT" && env -u PROJECT_ROOT "$SCRIPT_DIR/../../linear/scripts/linear.sh" \
    cache issues get "$issue" --format=raw) 2>&1 || true)"
  jq -e 'type == "object" and has("issue")' <<<"$raw" >/dev/null 2>&1 \
    || die linear-read "$@"
  issue_body="$(jq -r '.issue.description // ""' <<<"$raw")"
fi

# Read from the template's own header line and nowhere else: a sentence
# elsewhere in the body is prose, not a declared allowance.
delta_line="$(
  printf '%s\n' "$issue_body" \
    | sed -n 's/^[[:space:]]*[*_]*[Ee]xpected delta[*_]*[[:space:]]*:[[:space:]]*//p' \
    | head -n 1 | sed 's/[[:space:]]*$//'
)"
allowance=""
test_allowance=""
if [[ -n "$cut_from_round" ]]; then
  allowance="$(jq -r '.cut_comparison | .production_allowance // .production_lines' "$cut_from_round")" \
    || die invalid-round
  test_allowance="$(jq -r '.cut_comparison | if .production_allowance == null then .test_lines else .test_allowance // empty end' "$cut_from_round")" \
    || die invalid-round
elif [[ -n "$delta_line" ]]; then
  [[ "$delta_line" =~ $DELTA_GRAMMAR ]] \
    || die invalid-delta "$@"
  # Extract numeric values from captured strings like "1 line" or "2 lines"
  allowance="${BASH_REMATCH[1]%% *}"
  test_allowance="${BASH_REMATCH[3]%% *}"
fi

# --- Measure ----------------------------------------------------------------
if ! branch_size_classified "$worktree" "$SCRIPT_DIR/resolve-base-branch" HEAD \
  "$test_paths"; then
  die measurement-failed "$@"
fi
production_lines="$BRANCH_SIZE_PRODUCTION"
test_lines="$BRANCH_SIZE_TEST"
mirror_lines="$BRANCH_SIZE_MIRROR"
base_sha="$(git -C "$worktree" rev-parse --verify "$BRANCH_GROWTH_BASE_REF^{commit}")" \
  || die base-missing "$@"
head_sha="$(git -C "$worktree" rev-parse --verify 'HEAD^{commit}')" \
  || die head-missing "$@"

verdict="pass"
reason=""
if [[ -z "$allowance" ]]; then
  verdict="allowance_missing"
  if [[ "$no_issue" == true ]]; then
    reason="'$issue' names no issue, so no allowance was read"
  else
    reason="'$issue' states no **Expected delta** line"
  fi
  reason="$reason; $production_lines production, $test_lines test and $mirror_lines render-mirror lines added, none judged"
elif (( production_lines > allowance )); then
  verdict="over"
  reason="$production_lines production lines added; the comparison allows $allowance"
elif [[ -n "$test_allowance" ]] && (( test_lines > test_allowance )); then
  verdict="over"
  reason="$test_lines test lines added; the comparison allows $test_allowance"
fi

record="$(jq -n \
  --arg base_sha "$base_sha" \
  --arg head_sha "$head_sha" \
  --argjson production "$production_lines" \
  --argjson tests "$test_lines" \
  --argjson mirror "$mirror_lines" \
  --argjson allowance "${allowance:-null}" \
  --argjson test_allowance "${test_allowance:-null}" \
  --arg verdict "$verdict" \
  --arg reason "$reason" \
  '{base_sha: $base_sha, head_sha: $head_sha,
    production_lines: $production, test_lines: $tests, mirror_lines: $mirror,
    production_allowance: $allowance, test_allowance: $test_allowance,
    verdict: $verdict, reason: $reason}')"

if [[ -z "$cut_from_round" ]]; then
  "$SCRIPT_DIR/workflow-state" ${state_flags[@]+"${state_flags[@]}"} update "$issue" \
    --argjson size_check "$record" '.pr.size_check = $size_check' >/dev/null \
    || die state-write "$@"
fi

[[ "$as_json" != "true" ]] || printf '%s\n' "$record"

case "$verdict" in
  pass)
    [[ "$as_json" == "true" ]] || message result
    exit 0 ;;
  allowance_missing)
    message result >&2
    exit 0 ;;
esac

message result >&2
exit 0
