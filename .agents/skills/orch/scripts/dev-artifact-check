#!/usr/bin/env bash
# Deterministically validate a dev agent's on-disk completion artifact for
# dev-start / dev-fix / review-pr-comments acceptance. The live return message can
# be lost when a long tools/validate-class command exceeds the harness Bash tool
# timeout mid-tail and ends the turn (kendex#770), so the artifact — written after
# commit/labels/summary via `dev-return-write` — is the durable completion record.
#
# IDENTITY IS BY ROUND ID, NOT MTIME (kendex#776). Each delegation stamps a unique
# round token (`workflow-state new-round-id [ISSUE] dev_round_id`) that is embedded
# in the delegation. `dev-return-write` names its file
# [WORKTREE]/tmp/dev-return-[ISSUE_ID]-[ROUND_ID].json and writes "round_id":
# ROUND_ID inside. This check resolves that exact path and requires the internal
# `.round_id` to equal the expected token — clock-independent, and immune to the
# same-second re-stamp / late-rewriting-old-round / cross-group / cross-workflow
# receipt confusion that an `mtime >= delegated_at` heuristic at a single reused
# path allowed. The mtime freshness gate is gone entirely.
#
# Artifact schema (written by `dev-return-write`; canonical:
# skills/orch/schemas/dev-return.md):
#   { "schema_version": 1, "round_id": "…", "kind": "implement"|"fix",
#     "issue": "…", "branch": "…", "commit": "…", "validate": "pass"|"FAILING: …",
#     "baseline_lines": 138 (implement only),
#     "validate_note": "…"|null (optional free-text qualifier — kendex#884),
#     "qa_labels": […], "summary_posted": bool, "summary": "…"|null,
#     "bundled": bool, "items": [{"n": <number>, "decision": "Applied"|"Skipped"|"Blocked", "reasoning": "…"}] }

#
# The scalars prove the agent finished its tail; the items gates prove a fix or
# bundled artifact carries its per-item results. In round mode, when the
# worktree is a git repo and the artifact carries a .commit, the recorded SHA is
# additionally checked against that repo (kendex#994): a SHA that names no
# object fails with reason=commit_unresolvable (a hand-fabricated SHA — same
# short prefix as HEAD, invented tail — passes every schema gate yet proves
# nothing), and a commit that resolves but is not an ancestor of HEAD is
# surfaced as the NON-FATAL warning=commit_unreachable (a legitimate rebase
# orphans the SHAs of previously accepted rounds, so this is a signal for the
# orchestrator, not a failure). Exact-commit binding (.commit == the observed
# HEAD) and tracker corroboration stay in the orch workflow.
#
# The same rebase orphans the round record's base_sha, and there the answer is
# to stop: the protected-additions gate does not run, says so on stderr, and
# names no file (kendex#944).

set -euo pipefail

PROG="dev-artifact-check"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/branch-growth.sh
source "$SCRIPT_DIR/lib/branch-growth.sh"
# Path-safe token grammar for --issue / --round-id (no '/', '..', whitespace).
ID_GRAMMAR='^[A-Za-z0-9._-]+$'
# --expect-items is a comma-separated list of item numbers.
EXPECT_GRAMMAR='^[0-9]+(,[0-9]+)*$'
scratch_files=()

cleanup_scratch() {
  if (( ${#scratch_files[@]} > 0 )); then
    rm -f -- "${scratch_files[@]}"
  fi
}
trap cleanup_scratch EXIT

# The per-harness backgrounding paragraph under --wait is an intentional twin
# of review-artifact-check's: each --help is self-contained, so edit both.
usage() {
  cat << 'EOF'
Usage:
  dev-artifact-check --worktree WT --issue ISSUE --round-id RID \
    [--expect-items-from-round] [--wait SECS] [--interval SECS]
  dev-artifact-check --file <json_path> [--round-id RID] [--expect-items N,N,...] \
    [--wait SECS] [--interval SECS]

--wait SECS: blocking mode — poll every --interval seconds (default 5) until the
verdict leaves "wait" (an artifact landed: accept or retry) or SECS elapse (the
last result, verdict "wait", is printed). Run it as the armed round watchdog: it
returns the moment the receipt is written, independent of any return-message
delivery, and a deadline return is the escalation trigger. Backgrounding per
harness: Claude Code runs it as a background shell (the exit wake IS the
event); Pi runs it under bg_task, which emits no exit wake, so pair it with
the per-wake check; Codex and OpenCode run it via scheduled re-entry, or fall
back to the per-wake check alone.

Round mode (the production path): resolves WT/tmp/dev-return-ISSUE-RID.json,
requires it exists, its internal .round_id == RID, then the scalar/kind, commit
object (against WT's git repo, kendex#994), and items gates. A kind fix receipt
additionally REQUIRES --expect-items-from-round and exits 2 without it: its
delegated set and authorized additions live in the round record, and omitting
the flag would check neither. Implement rounds write no round record and stay
flagless.
An accepted round-mode implement receipt sets workflow state pr.baseline_lines
only when that field is null. File mode: validates one explicit JSON file (round_id checked only when --round-id
is supplied). It is a test/parity affordance — round-trip checks and known-path
artifacts — with no production caller; the orch workflows always use round mode.
There is one identity model (round id); the mtime freshness gate and the old
legacy positional mode are gone (kendex#776).

--expect-items (--file mode only): the delegated review-item NUMBERS as a comma-
separated set (e.g. 1,2,3,4,5,6) — never a count. items[] must cover
EXACTLY that set — each expected n present once, no unknown/duplicate n, every
decision ∈ {Applied,Skipped,Blocked}, every reasoning non-empty. Without it, a
fix/bundled artifact only needs a non-empty, well-formed items[].

--expect-items-from-round (round mode only; excludes --expect-items): derive
the expected set and the authorized protected additions from the round record
WT/tmp/dev-round-ISSUE-RID.json that dev-round-write stamped at delegation
time. Missing, symlinked, mismatched, or malformed records refuse with exit 2 —
including a base_sha outside 40 lowercase hex, which reaches `git diff` as a
revision argument and would otherwise let an option-shaped value empty the
additions probe, and an adds[] path beginning with '-' or carrying a space,
tab, newline, carriage return, form feed or vertical tab. Never recreate the
record after delegation and never downgrade to --expect-items; mint a fresh
round.
A record carrying "cut": true was written by dev-round-write --cut, the round
that runs while the branch is over its size tripwire. Its receipt is accepted
only when the branch came back to twice workflow state pr.baseline_lines: over
that cap is reason=cut_not_shrunk, and a cap that cannot be measured at all is
reason=cut_unmeasurable. Every other gate applies unchanged.
Protected-addition scope, and what the gate does once a rebase orphans base_sha:
skills/orch/schemas/dev-round.md § Protected additions.

Prints JSON: {ok: bool, verdict: "accept"|"wait"|"retry", path: string|null,
              reason: "valid"|"missing"|"invalid"|"commit_unresolvable"|
                      "comparison_failed"|"classifier_failed"|
                      "unapproved_additions"|"additions_unattributable"|
                      "cut_not_shrunk"|"cut_unmeasurable"|"incomplete",
              warning: "commit_unreachable"|null,
              hint: usage diagnosis (count-vs-set --expect-items misuse)|null,
              files: [repo-relative paths]}

Gates ordered: missing → (round_id mismatch → invalid) → scalars → invalid →
commit object → commit_unresolvable → additions probe → comparison_failed or
classifier_failed or unapproved_additions or additions_unattributable → cut
size (declared cuts only) → cut_not_shrunk or cut_unmeasurable → items →
incomplete → valid.

Exit status reflects artifact validity only: a valid artifact whose recorded
validation is failing exits 0 with verdict "retry". Acceptance keys on the
verdict field, never the exit code.

reason meanings when ok=false:
  missing     artifact file does not exist at the resolved path
  invalid     round_id != expected, OR not parseable JSON, OR a required field is
              wrong-typed/empty: .kind ∈ {implement,fix}; .issue/.branch
              non-empty strings; .round_id non-empty string; .schema_version a
              number; .commit/.validate non-empty strings; implement requires
              integer .baseline_lines >= 1, and fix forbids that field
  commit_unresolvable
              the artifact's .commit names no object in the worktree's repo
              (kendex#994) — e.g. a hand-reconstructed SHA with a fabricated
              tail. Round mode only, and only when the worktree is a git repo;
              --file mode has no repo to check against and skips this gate.
  unapproved_additions
              a fix round added a protected file since the round record's
              base_sha without naming that exact file in adds. The files field
              names every refused path. Renames and moves do not count. This
              gate runs only while base_sha is an ancestor of HEAD.
  additions_unattributable
              a rebase moved base_sha off the branch, so the additions gate
              could not run and no file was classified either way; files is
              empty, because naming one would accuse the round of an addition
              the comparison cannot honestly attribute (kendex#944). This
              refuses rather than accepts: the next round's base_sha is stamped
              at the rebased HEAD, which already contains anything this round
              added, so an accepted skip loses the gate rather than deferring
              it.
  comparison_failed
              Git could not compare the round record's base_sha to HEAD. No file
              classification is inferred from a failed comparison.
  classifier_failed
              the protected-addition classifier produced no valid JSON array.
  cut_not_shrunk
              the round record declares a cut ("cut": true) but the branch is
              still above twice workflow state pr.baseline_lines. A cut is the
              one round allowed to start over that cap, so this is where it is
              held to bringing the branch back under it (KEN-1165).
  cut_unmeasurable
              a declared cut whose cap could not be measured — an unreadable or
              invalid pr.baseline_lines, or a branch git could not diff against
              its base. A cut is never accepted on an unmeasured branch.
  incomplete  items[] fails the applicable rule — exact-set (with --expect-items)
              or non-empty-well-formed (kind fix OR bundled==true). kind implement
              without bundled keeps allowing items: [].

warning=commit_unreachable (NON-FATAL, ok stays true): the .commit resolves as a
commit object but is not an ancestor of the current HEAD — the signature of a
receipt orphaned by a later rebase (kendex#994). Expected after a legitimate
rebase; the orchestrator decides what it means for the round.

Exit 0 when a valid artifact was found, 1 otherwise, 2 on usage error.
EOF
}

die() {
  printf '%s: %s\n' "$PROG" "$1" >&2
  exit 2
}

need() {
  # $1 = flag name, $2 = current argc ($#). A value option needs at least 2 args.
  (( $2 >= 2 )) || die "$1 requires a value"
}

# Validate a path-forming token (--issue / --round-id): non-empty, matches the
# path-safe grammar, and contains no '..'. Shared verbatim with dev-return-write.
check_id_token() {
  # $1 = flag name, $2 = value.
  [[ -n "$2" ]] || die "$1 is required (non-empty)"
  [[ "$2" =~ $ID_GRAMMAR && "$2" != *..* ]] \
    || die "$1 '$2' must match ${ID_GRAMMAR} with no '..' (path-safe: no '/' or whitespace)"
}

# `validate` and `validate_note` are surfaced here, not just stored in the file:
# this output IS what the orchestrator reads to accept a completion, so a
# qualified result recorded in the artifact and never echoed would be as lost as
# one that was never recorded (kendex#884). Both are null when the artifact is
# missing or unparseable.
emit() {
  local ok="$1" path="$2" reason="$3" warning="${4:-}" hint="${5:-}" files="${6:-[]}" validate=null validate_note=null
  if [[ -n "$path" && -f "$path" ]]; then
    validate="$(jq -c 'if (.validate? | type) == "string" then .validate else null end' "$path" 2>/dev/null || printf 'null')"
    validate_note="$(jq -c 'if (.validate_note? | type) == "string" then .validate_note else null end' "$path" 2>/dev/null || printf 'null')"
  fi
  # verdict is the one-word acceptance answer the orchestrator acts on:
  #   accept — artifact valid for this round (warnings ride along)
  #   wait   — no artifact for this round yet; the round is still running
  #   retry  — an artifact exists but is not accepted
  # A validate value other than "pass" downgrades accept to retry: the agent
  # finished its tail but the round's validation is failing.
  local verdict
  if [[ "$ok" == "true" ]]; then
    verdict="accept"
    if [[ "$validate" != null && "$validate" != '"pass"' ]]; then verdict="retry"; fi
  elif [[ "$reason" == "missing" ]]; then
    verdict="wait"
  else
    verdict="retry"
  fi
  jq -n --argjson ok "$ok" --arg path "$path" --arg reason "$reason" --arg warning "$warning" \
    --arg hint "$hint" --arg verdict "$verdict" \
    --argjson files "$files" --argjson validate "${validate:-null}" --argjson validate_note "${validate_note:-null}" \
    '{ok: $ok, verdict: $verdict, path: (if $path == "" then null else $path end), reason: $reason,
      warning: (if $warning == "" then null else $warning end),
      hint: (if $hint == "" then null else $hint end),
      files: $files,
      validate: $validate, validate_note: $validate_note}'
}

# The artifact's internal round_id must equal the expected token. Guards against
# a copied/renamed file dropped at the round-scoped path.
round_id_matches() {
  jq -e --arg want "$2" '
    ((.round_id? | type) == "string") and (.round_id == $want)
  ' "$1" >/dev/null 2>&1
}

# Type-strict required scalars: .kind ∈ {implement,fix}; .issue/.branch
# non-empty STRINGS (arrays/objects/bools/numbers fail, not just ""); .round_id a
# non-empty string; .schema_version a number; .commit/.validate non-empty
# strings. A truncated or half-written receipt fails this gate → reason=invalid.
has_required_fields() {
  jq -e '
    (.kind? // "") as $k
    | ($k == "implement" or $k == "fix")
      and ((.issue? | type) == "string") and (.issue != "")
      and ((.branch? | type) == "string") and (.branch != "")
      and ((.round_id? | type) == "string") and (.round_id != "")
      and ((.schema_version? | type) == "number")
      and ((.commit? | type) == "string") and (.commit != "")
      and ((.validate? | type) == "string") and (.validate != "")
      and ((.validate_note? | type) as $t | $t == "null" or $t == null
           or ($t == "string" and (.validate_note != "")))
      and (if $k == "implement"
           then ((.baseline_lines? | type) == "number")
             and (.baseline_lines == (.baseline_lines | floor))
             and (.baseline_lines >= 1)
           else (has("baseline_lines") | not)
           end)
  ' "$1" >/dev/null 2>&1
}

# kendex#678 parity fallback (no --expect-items): an artifact of kind "fix" OR with
# bundled == true must carry a non-empty .items array whose every element is an
# object with a numeric .n, a decision ∈ {Applied,Skipped,Blocked}, and a non-empty
# .reasoning. kind "implement" without bundled is unaffected (items: [] allowed).
# Returns 0 (true) when fix/bundled-shaped but items are missing/empty/malformed.
fix_or_bundled_incomplete() {
  jq -e '
    ((((.kind? // "") == "fix") or (.bundled? == true))) as $needs_items
    | $needs_items
      and (((.items? | type) != "array")
           or ((.items | length) == 0)
           or (any(.items[];
                 (type != "object")
                 or ((.n? | type) != "number")
                 or ((.decision? | type) != "string")
                 or ((.decision as $d | ["Applied","Skipped","Blocked"] | index($d)) == null)
                 or ((.reasoning? | type) != "string")
                 or (.reasoning == ""))))
  ' "$1" >/dev/null 2>&1
}

# Exact item-set completeness for a fix round (--expect-items N,N,...). items[] must
# cover EXACTLY the expected set: every element well-formed, and the multiset of
# .n equals the expected set (each present once, no unknown/duplicate). A 1-item
# artifact must not satisfy a 10-item delegation. Returns 0 (true) when items[]
# covers the set exactly.
items_exact_ok() {
  jq -e --arg expect "$2" '
    ($expect | split(",") | map(tonumber)) as $want
    | ((.items? | type) == "array")
      and (all(.items[];
            (type == "object")
            and ((.n | type) == "number")
            and ((.decision as $d | ["Applied","Skipped","Blocked"] | index($d)) != null)
            and ((.reasoning | type) == "string") and (.reasoning != "")))
      and (([ .items[].n ] | sort) == ($want | sort))
  ' "$1" >/dev/null 2>&1
}

is_protected_addition() {
  local path="$1" basename stem remaining component in_test_path=false
  case "$path" in
    *test-helper*|*test_helper*|*test-util*|*test_util*) return 0 ;;
  esac
  case "$path" in
    crates/*|tools/*|skills/*/scripts/*|.agents/skills/*/scripts/*|\
    src/test/*|*/src/test/*|\
    helper/*|helpers/*|*/helper/*|*/helpers/*|\
    test-helper/*|test-helpers/*|test_helper/*|test_helpers/*|\
    test-util/*|test-utils/*|test_util/*|test_utils/*|\
    */test-helper/*|*/test-helpers/*|*/test_helper/*|*/test_helpers/*|\
    */test-util/*|*/test-utils/*|*/test_util/*|*/test_utils/*)
      return 0
      ;;
  esac
  remaining="$path"
  while [[ "$remaining" == */* ]]; do
    component="${remaining%%/*}"
    remaining="${remaining#*/}"
    if [[ "$in_test_path" == "true" ]]; then
      case "$component" in
        helper|helpers|support|lib|util|utils) return 0 ;;
      esac
    fi
    case "$component" in
      test|tests|__tests__) in_test_path=true ;;
    esac
  done
  basename="${path##*/}"
  while [[ "$basename" == .* ]]; do basename="${basename#.}"; done
  stem="${basename%%.*}"
  if [[ "$in_test_path" == "true" ]]; then
    case "$stem" in
      *helper*|*test-util*|*test_util*) return 0 ;;
    esac
  fi
  return 1
}

# base_sha reaches `git diff` as a revision argument, so the schema arm above
# constrains it to 40 hex before it gets here: a value git parses as an OPTION
# never reaches revision parsing, and git would exit 0 over an empty probe with
# the gate reporting valid. A `--` separator cannot stand in for that grammar:
# git does stop option parsing there, but everything after `--` is a pathspec,
# so the separator cannot carry the base_sha HEAD revision pair at all and the
# probe would compare nothing — fail-open in the same direction.
#
# base_sha is HEAD at delegation, and a rebase orphans it exactly as it orphans
# the artifact's .commit (kendex#944). The orphaned sha still resolves, so the
# comparison succeeds across the base branch's whole advance and names files
# another author merged as this round's additions. No comparison recovers the
# round's real starting tree once it is off the branch, so the gate does not
# run: it says that on stderr and names no file. Three approximations of "did
# this round add this path" were tried and each excused something real.
collect_unapproved_additions() {
  local repo="$1" round_record="$2" result="$3" base_sha path probe
  local additions=()
  base_sha="$(jq -r '.base_sha' "$round_record")"
  # 40 hex naming no object here is not an orphaned base, it is a base this
  # repository cannot answer for: refuse the comparison rather than take the
  # stop below, which would clear the round on a record nobody can check.
  if [[ "$(git -C "$repo" cat-file -t "$base_sha" 2>/dev/null)" != "commit" ]]; then
    return 2
  fi
  if ! git -C "$repo" merge-base --is-ancestor "$base_sha" HEAD >/dev/null 2>&1; then
    printf '%s: round base %s is not an ancestor of HEAD in %s (orphaned by a rebase?); no comparison can attribute an addition to this round once its base is off the branch\n' \
      "$PROG" "$base_sha" "$repo" >&2
    printf '[]\n' > "$result" || return 3
    # 4, not 0: a gate that did not run and a gate that cleared the round are
    # the same empty file, and only the caller can refuse on the difference.
    return 4
  fi
  probe="$(mktemp "$repo/tmp/.dev-artifact-additions.XXXXXX")" \
    || return 3
  scratch_files+=("$probe")
  if ! git -C "$repo" diff --find-renames --diff-filter=A --name-only -z "$base_sha" HEAD > "$probe"; then
    rm -f -- "$probe"
    return 2
  fi
  while IFS= read -r -d '' path; do
    if is_protected_addition "$path" \
      && ! jq -e --arg path "$path" '.adds | index($path) != null' "$round_record" >/dev/null; then
      additions+=("$path")
    fi
  done < "$probe"
  if (( ${#additions[@]} > 0 )); then
    # These are branch paths the dev agent chose, with no grammar in front of
    # them, so they travel as NUL-delimited data rather than as arguments: a
    # path that looks like an option would otherwise decide how it is read.
    if ! printf '%s\0' "${additions[@]}" | jq -Rsc 'split("\u0000")[:-1]' > "$result"; then
      rm -f -- "$probe"
      return 3
    fi
  else
    if ! printf '[]\n' > "$result"; then
      rm -f -- "$probe"
      return 3
    fi
  fi
  rm -f -- "$probe"
  [[ -s "$result" ]] \
    && jq -e '(type == "array") and all(.[]; type == "string")' "$result" >/dev/null 2>&1
}

# Shared gate. `--help` § "Gates ordered" is the single statement of the order
# these run in; keep the two in step when a gate is added or moved. Emits
# {ok, path, reason, warning}, returns 0 iff valid.
# want_round "" skips the round_id match (--file mode without --round-id).
# expect_items "" uses the fix/bundled fallback instead of the exact-set rule.
# round_record "" skips both record-derived gates — protected additions (no
# delegated adds set) and the declared-cut size check.
# repo "" skips the commit checks (--file mode); so does a worktree that is not
# a git repo — production worktrees always are, and a check that cannot run
# proves nothing either way.
validate_artifact() {
  local file="$1" want_round="$2" expect_items="$3" repo="${4:-}" round_record="${5:-}" warning=""
  if [[ ! -f "$file" ]]; then
    emit false "" "missing"
    return 1
  fi
  if [[ -n "$want_round" ]] && ! round_id_matches "$file" "$want_round"; then
    emit false "$file" "invalid"
    return 1
  fi
  if ! has_required_fields "$file"; then
    emit false "$file" "invalid"
    return 1
  fi
  # kendex#994: a .commit that passed the scalar gate must name a real commit
  # object in the worktree's repo — a fabricated SHA (same short prefix as HEAD,
  # invented tail) reads as evidence while proving nothing. Resolvable but not
  # an ancestor of HEAD is the orphaned-by-rebase signature: non-fatal warning,
  # because a legitimate rebase produces it on every previously accepted round.
  local commit=""
  if [[ -n "$repo" ]] && git -C "$repo" rev-parse --git-dir >/dev/null 2>&1; then
    commit="$(jq -r 'if (.commit? | type) == "string" then .commit else "" end' "$file" 2>/dev/null || true)"
  fi
  if [[ -n "$commit" ]]; then
    if [[ "$(git -C "$repo" cat-file -t "$commit" 2>/dev/null)" != "commit" ]]; then
      printf '%s: artifact commit %s: no such object in the repo at %s\n' "$PROG" "$commit" "$repo" >&2
      emit false "$file" "commit_unresolvable"
      return 1
    fi
    if ! git -C "$repo" merge-base --is-ancestor "$commit" HEAD >/dev/null 2>&1; then
      warning="commit_unreachable"
      printf '%s: artifact commit %s resolves but is not an ancestor of HEAD in %s (orphaned by a rebase?)\n' "$PROG" "$commit" "$repo" >&2
    fi
  fi
  if [[ -n "$round_record" ]]; then
    local refused_additions refused_file additions_rc=0
    refused_file="$(mktemp "$repo/tmp/.dev-artifact-refused.XXXXXX")" \
      || additions_rc=3
    if (( additions_rc == 0 )); then
      scratch_files+=("$refused_file")
      collect_unapproved_additions "$repo" "$round_record" "$refused_file" \
        || additions_rc=$?
    fi
    # 4 is the orphaned-base stop. Accepting it would not defer the gate, it
    # would lose it: dev-round-write stamps the next round's base_sha at the
    # rebased HEAD, which already contains whatever this round added, so no
    # later round can ever see it as an addition. Gate code fails closed, so
    # this refuses and names no file.
    if (( additions_rc == 4 )); then
      [[ -n "$refused_file" ]] && rm -f -- "$refused_file"
      emit false "$file" "additions_unattributable"
      return 1
    fi
    if (( additions_rc == 2 )); then
      [[ -n "$refused_file" ]] && rm -f -- "$refused_file"
      printf '%s: could not compare fix-round base to HEAD in %s\n' "$PROG" "$repo" >&2
      emit false "$file" "comparison_failed"
      return 1
    fi
    if (( additions_rc != 0 )); then
      [[ -n "$refused_file" ]] && rm -f -- "$refused_file"
      printf '%s: protected-addition classifier produced no valid result in %s\n' "$PROG" "$repo" >&2
      emit false "$file" "classifier_failed"
      return 1
    fi
    if ! refused_additions="$(jq -c '.' "$refused_file")"; then
      rm -f -- "$refused_file"
      emit false "$file" "classifier_failed"
      return 1
    fi
    rm -f -- "$refused_file"
    if [[ "$refused_additions" != "[]" ]]; then
      printf '%s: fix round added files absent from its Adds line: %s\n' \
        "$PROG" "$(jq -r 'join(", ")' <<<"$refused_additions")" >&2
      emit false "$file" "unapproved_additions" "" "" "$refused_additions"
      return 1
    fi
    # A cut round (dev-round-write --cut) is the one round dev-round-write lets
    # start over the size tripwire, because the branch being oversized is what
    # it was delegated to fix. The tripwire moves here rather than being
    # dropped: the cut's receipt is accepted only if the branch actually came
    # back to the cap, so declaring a round a cut is a way to run one, never a
    # way to grow the branch past the limit unchecked (KEN-1165).
    if jq -e '.cut? == true' "$round_record" >/dev/null 2>&1; then
      if ! measure_size_tripwire "$repo" "${issue:-}" "$SCRIPT_DIR"; then
        printf '%s: cut round: %s\n' "$PROG" "$BRANCH_GROWTH_ERROR" >&2
        emit false "$file" "cut_unmeasurable"
        return 1
      fi
      if (( BRANCH_GROWTH_CURRENT > BRANCH_GROWTH_LIMIT )); then
        printf '%s: cut round did not shrink the branch: diffstat is %s lines against a cap of %s (baseline %s)\n' \
          "$PROG" "$BRANCH_GROWTH_CURRENT" "$BRANCH_GROWTH_LIMIT" "$BRANCH_GROWTH_BASELINE" >&2
        emit false "$file" "cut_not_shrunk"
        return 1
      fi
    fi
  fi
  if [[ -n "$expect_items" ]]; then
    if ! items_exact_ok "$file" "$expect_items"; then
      # Count-vs-set misuse reads as "the dev agent skipped items" and points
      # at the wrong party. The unambiguous signature: a bare integer N > 1
      # while the artifact's item numbers are EXACTLY 1..N — a legitimate
      # singleton re-fix (--expect-items 2) or a shifted set never matches.
      # The hint rides in its own field; `warning` keeps its documented
      # commit_unreachable|null contract. It diagnoses a TYPED count only: a
      # set derived from the round record (--expect-items-from-round) cannot
      # be that misuse, so it never hints even when the shapes coincide.
      if [[ "$expect_from_round" != "true" && "$expect_items" =~ ^[0-9]+$ ]] && [ "$expect_items" -gt 1 ] \
        && jq -e --argjson n "$expect_items" \
          '((.items? | type) == "array")
             and (all(.items[];
                   (type == "object")
                   and ((.n | type) == "number")
                   and ((.decision as $d | ["Applied","Skipped","Blocked"] | index($d)) != null)
                   and ((.reasoning | type) == "string") and (.reasoning != "")))
             and (([ .items[].n ] | sort) == [range(1; $n + 1)])' \
          "$file" >/dev/null 2>&1; then
        emit false "$file" "incomplete" "" \
          "if this delegation covered $expect_items items, then '$expect_items' was a COUNT — --expect-items takes the delegated item NUMBERS (e.g. 1,2,...,$expect_items); if it genuinely delegated only item #$expect_items, the artifact carries extra items 1..$expect_items"
        return 1
      fi
      emit false "$file" "incomplete"
      return 1
    fi
  elif fix_or_bundled_incomplete "$file"; then
    emit false "$file" "incomplete"
    return 1
  fi
  emit true "$file" "valid" "$warning"
  return 0
}

# --- Mode dispatch: --file (explicit path) or round mode (--worktree/--issue/
# --round-id). Each sets `file`, `want_round`, and `expect_items`; the shared tail
# validates --expect-items once and runs the check. -h/--help prints usage. ---
if [[ "${1:-}" == "-h" || "${1:-}" == "--help" ]]; then
  usage
  exit 0
fi

file=""
want_round=""
expect_items=""
expect_from_round=false
round_record=""
repo=""
round_mode=false
wait_secs=0
interval=5

if [[ "${1:-}" == "--file" ]]; then
  shift
  file="${1:-}"
  [[ -n "$file" && "$file" != --* ]] || die "--file requires a non-empty path"
  shift
  while (( $# > 0 )); do
    case "$1" in
      --round-id)     need "$1" $#; want_round="$2"; shift 2 ;;
      --expect-items) need "$1" $#; expect_items="$2"; shift 2 ;;
      --expect-items-from-round)
        die "--expect-items-from-round requires round mode (there is no worktree/issue/round to resolve a round record from)" ;;
      --wait)         need "$1" $#; wait_secs="$2"; shift 2 ;;
      --interval)     need "$1" $#; interval="$2"; shift 2 ;;
      *) die "unknown --file argument: $1" ;;
    esac
  done
elif [[ "${1:-}" == --* ]]; then
  round_mode=true
  worktree=""
  issue=""
  round_id=""
  while (( $# > 0 )); do
    case "$1" in
      --worktree)     need "$1" $#; worktree="$2"; shift 2 ;;
      --issue)        need "$1" $#; issue="$2"; shift 2 ;;
      --round-id)     need "$1" $#; round_id="$2"; shift 2 ;;
      --expect-items) need "$1" $#; expect_items="$2"; shift 2 ;;
      --expect-items-from-round) expect_from_round=true; shift ;;
      --wait)         need "$1" $#; wait_secs="$2"; shift 2 ;;
      --interval)     need "$1" $#; interval="$2"; shift 2 ;;
      *) die "unknown argument: $1" ;;
    esac
  done
  [[ -n "$worktree" ]] || die "--worktree is required"
  [[ -d "$worktree" ]] || die "--worktree path '$worktree' is not a directory"
  [[ -z "$expect_items" ]] \
    || die "--expect-items is only allowed with --file; round mode requires --expect-items-from-round so the delegated set and its protected additions cannot be bypassed"
  check_id_token --issue "$issue"
  check_id_token --round-id "$round_id"
  want_round="$round_id"
  repo="$worktree"
  file="$worktree/tmp/dev-return-$issue-$round_id.json"

  # Derive the expected item set from the persisted round record (kendex#1230).
  # A record that cannot supply the set — missing, unparseable, wrong internal
  # token, or malformed items — is a usage/environment failure (exit 2), never
  # a silent downgrade to the weaker fix/bundled fallback gate.
  if [[ "$expect_from_round" == "true" ]]; then
    [[ -z "$expect_items" ]] \
      || die "--expect-items and --expect-items-from-round are mutually exclusive: one expected-set source"
    round_record="$worktree/tmp/dev-round-$issue-$round_id.json"
    [[ -f "$round_record" && ! -L "$round_record" ]] \
      || die "round record $round_record not found — was dev-round-write run when the round was stamped?"
    jq empty "$round_record" >/dev/null 2>&1 \
      || die "round record $round_record is not parseable JSON"
    jq -e --arg want "$round_id" '
      ((.round_id? | type) == "string") and (.round_id == $want)
    ' "$round_record" >/dev/null 2>&1 \
      || die "round record $round_record does not carry internal round_id '$round_id' — not this round's record"
    # Full record schema, not just the token: a record dev-round-write could
    # not have written (wrong issue, missing schema_version, ill-typed or
    # empty items/text) is no source of truth for the expected set.
    jq -e --arg issue "$issue" '
      (.schema_version? == 2)
      and ((.issue? | type) == "string") and (.issue == $issue)
      and ((.base_sha? | type) == "string")
      and (.base_sha | test("\\A[0-9a-f]{40}\\z"))
      and ((.adds? | type) == "array")
      and all(.adds[];
            (type == "string") and (. != "") and (startswith("/") | not)
            and (startswith("-") | not)
            and ((explode | any(. == 9 or . == 10 or . == 11 or . == 12
                                or . == 13 or . == 32)) | not)
            and (split("/") | all(. != "" and . != "." and . != "..")))
      and ((.adds | length) == (.adds | unique | length))
      and ((.cut? | type) as $t | $t == "null" or $t == "boolean")
      and ((.items? | type) == "array") and ((.items | length) > 0)
      and all(.items[];
            (type == "object")
            and ((.n? | type) == "number") and (.n == (.n | floor)) and (.n >= 0)
            and ((.text? | type) == "string")
            and ((.text | gsub("[[:space:]]"; "")) != ""))
      and (([.items[].n] | length) == ([.items[].n] | unique | length))
    ' "$round_record" >/dev/null 2>&1 \
      || die "round record $round_record fails the dev-round schema (schema_version 2, issue '$issue', base_sha of exactly 40 lowercase hex, unique repository-relative adds[] whose paths carry no ASCII whitespace and do not begin with '-', a cut that is missing, null or boolean, non-empty items[] of unique integer n + non-empty text) — see skills/orch/schemas/dev-round.md"
    expect_items="$(jq -r '[.items[].n | tostring] | join(",")' "$round_record")"
  fi
else
  # Neither --file nor round mode → usage error. One identity model (round id);
  # the legacy positional mode was removed with its only caller.
  usage >&2
  exit 2
fi

# Round mode checks a fix receipt against its round record or not at all.
# Without --expect-items-from-round there is no delegated set and no authorized
# additions list, so validate_artifact would fall back to the weak
# non-empty-items rule and skip the protected-additions gate entirely — a
# bypass reachable by omitting a flag. Implement rounds write no round record
# and stay flagless. This replaces the re-exec that used to
# silently upgrade the invocation: refusing keeps the caller's command honest.
require_round_record_flag() {
  [[ "$round_mode" == "true" && "$expect_from_round" != "true" && -f "$file" ]] || return 0
  if jq -e '(.kind? // "") == "fix"' "$file" >/dev/null 2>&1; then
    die "round-mode receipt $file is kind fix: pass --expect-items-from-round so the delegated item set and its protected additions are checked"
  fi
}

check_once() {
  local out rc=0 verdict kind
  require_round_record_flag
  out="$(validate_artifact "$file" "$want_round" "$expect_items" "$repo" "$round_record")" || rc=$?
  if (( rc == 0 )); then
    verdict="$(jq -r '.verdict' <<<"$out")" || {
      printf '%s: could not read the emitted artifact verdict\n' "$PROG" >&2
      return 2
    }
    kind="$(jq -r '.kind' "$file")"
    if [[ "$verdict" == "accept" && "$round_mode" == "true" && "$kind" == "implement" ]]; then
      if ! "$SCRIPT_DIR/workflow-state" update "$issue" --slurpfile receipt "$file" '
        .pr = (.pr // {})
        | if (.pr.baseline_lines // null) == null
          then .pr.baseline_lines = $receipt[0].baseline_lines else . end
      '; then
        out="$(emit false "$file" invalid)"
        rc=1
      fi
    fi
  fi
  printf '%s\n' "$out"
  return "$rc"
}

# Shared tail: --expect-items grammar (both modes), then validate — once, or,
# with --wait, repeatedly until the verdict leaves "wait" or the deadline lands.
if [[ -n "$expect_items" && ! "$expect_items" =~ $EXPECT_GRAMMAR ]]; then
  die "--expect-items must be comma-separated item numbers, got '$expect_items'"
fi
[[ "$wait_secs" =~ ^[0-9]+$ ]] || die "--wait must be a non-negative integer (seconds), got '$wait_secs'"
[[ "$interval" =~ ^[1-9][0-9]*$ ]] || die "--interval must be a positive integer (seconds), got '$interval'"
if (( wait_secs > 0 )); then
  # Blocking watchdog: only "wait" (no artifact yet) keeps polling; the first
  # accept/retry verdict returns immediately, so an armed background invocation
  # wakes the orchestrator the moment the receipt lands instead of at a fixed
  # deadline — and never depends on the agent's return message being delivered.
  deadline=$(( $(date +%s) + wait_secs ))
  while :; do
    rc=0
    out="$(check_once)" || rc=$?
    (( rc != 2 )) || exit 2
    verdict="$(jq -r '.verdict // "wait"' <<<"$out" 2>/dev/null || printf 'wait')"
    if [[ "$verdict" != "wait" ]] || (( $(date +%s) >= deadline )); then
      printf '%s\n' "$out"
      exit "$rc"
    fi
    remaining=$(( deadline - $(date +%s) ))
    sleep_for="$interval"
    if (( remaining < interval )); then sleep_for="$remaining"; fi
    if (( sleep_for < 1 )); then sleep_for=1; fi
    sleep "$sleep_for"
  done
fi
rc=0
check_once || rc=$?
exit "$rc"
