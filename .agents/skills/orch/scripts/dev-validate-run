#!/usr/bin/env bash
# dev-validate-run — run DEV_VALIDATE_CMD under one bound and leave its verdict
# on disk, so a dev agent's wait ends when the guard ends rather than when the
# agent's own poll cap runs out.
#
# The failure this removes: the agent chose the guard's time limit and its own
# polling cap by hand, and the two were never the same number. A cap shorter
# than the guard left the agent idle with the round's work uncommitted.
#
# One setting is the bound. DEV_VALIDATE_TIMEOUT_SECS (default 3600) limits the
# command, and the wait's cap is that value plus the kill grace plus one poll
# interval. Neither is chosen at the call site.
#
# The runner hands the command what the shipped change classifier says about
# the diff from the base branch to the worktree as it stands, committed or not,
# or for a range request from its --base commit, recorded then as the
# class-base= line of start, read through lib/change-class.sh, which owns that
# call:
#   DEV_VALIDATE_CLASS      the class: render, trivial, micro, small or standard
#   DEV_VALIDATE_DOCS_ONLY  the docs verdict for the same range: true or false
#   DEV_VALIDATE_PATHS      a file of the changed paths that verdict read, one
#                           per line
# A command that reads them can stand down the lanes the class does not need;
# which lanes those are is the command's to decide, and the verdict is its exit
# status whatever it runs. No flag and no inherited value asserts a class. A
# class that cannot be read, for any cause, is standard with docs-only false
# and an empty paths file, and the started line names the cause as
# class-fallback=CAUSE: base-unresolved, worktree-unrecorded, or a cause
# lib/change-class.sh names. change-class proves render in a private checkout
# of the range's head, which here is the worktree's snapshot commit, so a run
# over uncommitted render edits is weighed with those edits, and a kendex
# arming record in the worktree's git directories does not refuse it.
#
# lib/job-unit.sh starts the child, as a transient systemd user unit named for
# validate-<worktree directory> (for a lane, its item in lower case) where a
# user manager answers, lingering or not, and under setsid elsewhere, and ends
# it. In a unit no
# process the run starts outlives it; under setsid what the run leaves in its
# process group ends with it, and ../references/job-units.md § Runner line names
# what escapes. That file is also the name shape and the stop rule. The unit's
# RuntimeMaxSec is the cap, a backstop above the bound that still leaves the
# bound to produce the verdict. Under --attached it starts the child as the
# caller's own, leading its own process group, and ends that group as under
# setsid. The log's first line is the runner line.
#
# Usage:
#   dev-validate-run --worktree PATH [--poll SECS] [--validate-mode full|range|ci] [--base REF] [--attached] [--fresh]
#       Start the run detached, then block until it ends. Prints the run
#       directory first and the verdict last. Harness launch and resume routes:
#       ../../dev/SKILL.md § Long-Running Validation.
#       One run at a time per worktree: while a run directory there has no
#       verdict and its child, the process its pid file names with that run's
#       --child argv, still runs, a start is refused as run-live, naming that
#       directory, before anything is recorded. A pid that still runs but
#       whose argv cannot be read is refused the same way. A second battery beside the
#       first shares the host's CPU and fails the slower one on load timeouts
#       in files the change never touched. Wait for that run with --wait, or
#       end it with --stop, then start again.
#       --attached runs the same child in the caller's foreground instead,
#       through lib/job-unit.sh attach: a child of this process that leads its
#       own process group in the caller's session, under the same bound, class
#       and run directory, and with the same sentinel and record. A host whose
#       agent warden kills detached jobs needs it. The started line comes
#       before the run rather than after the launch, and the log's runner line
#       is runner=attached. Give the call a harness timeout above the printed
#       cap-secs; the route fits only a harness whose call can outlast it. A
#       harness that cuts the call off kills only this parent, and on a warden
#       host the warden reaps the orphaned child before its verdict: the run
#       ends as state=lost, a failed validation. The --wait resume holds only
#       on a host without such a warden. What the command leaves in the
#       child's group ends with the run, and a process that starts its own
#       session escapes, as under setsid. --stop ends an attached run by its
#       group. The child forks through the github skill's group-leader
#       prefix: an install without that skill beside orch is refused as
#       group-leader-missing, and a host without perl, which that prefix
#       runs, as missing-command commands=perl, both before the run starts.
#   dev-validate-run --wait --run-dir PATH [--budget SECS]
#       Poll a run the start path already launched, repeated while it exits
#       3: a foreground call on Claude Code, an exec_command call on Codex,
#       polled with write_stdin while it returns a session_id
#       (../references/codex-runtime.md § Validation wait). Every harness's
#       route: ../../dev/SKILL.md § Long-Running Validation.
#   dev-validate-run --stop --worktree PATH
#       End every run that worktree's run directories record with no verdict:
#       a unit by the exact name its runner record names, a setsid run by its
#       process group. lane-close calls it for a local lane. Prints one line naming how
#       many of each were still running:
#         state=stopped units=N groups=N
#   dev-validate-run --record --run-dir PATH
#       Print the run's record, read-only: the mode it ran under, its verdict,
#       the HEAD and epoch second it started at, any base a rebase left off
#       the branch, the base the class was read from where it was not the
#       base branch and, for a finished run, its wall time. The one reader of
#       the run directory for anything outside this script; dev-return-write
#       takes a receipt's mode, class base and wall time from it, a receipt's
#       pass needs its pass and its no-verdict its no-verdict. Fix-round
#       binding belongs to dev-return-write, per schemas/dev-return.md.
#   dev-validate-run --resolve-mode --worktree PATH [--base REF]
#       Print a range request's mode, read-only and starting nothing. Without
#       --base it resolves the local command: range, or full without a range
#       command. dev-artifact-check uses that fallback mode and admits ci
#       separately for an open pull request. With --base it also previews
#       selection and applies the same ci resolution as a real range start.
#   dev-validate-run --last-pass --worktree PATH
#       Print the newest run in that worktree that ran a full or range command
#       to a pass and whose start records both the HEAD and the tree it
#       validated, read-only. restack-skip compares a restacked head with
#       that tree. A ci run ran nothing and is never one. Exit 1 where the
#       worktree has none, or where a later full or range run did not pass,
#       an unfinished one included: that run is named as red. A later run the
#       bound ended whose log holds no finding line is neither: it refuted
#       nothing, so the pass before it still stands.
#   dev-validate-run --live --worktree PATH
#       Print the run still going in that worktree, read-only and starting
#       nothing: the run a start there would refuse as run-live, judged the
#       same way. Exit 1 where none is. The dev-stop-check hook holds a
#       subagent's stop on it.
#   dev-validate-run --child --run-dir PATH
#       Internal. The detached process the start path launches.
#
# The run directory holds cmd (the command text), start (the run's bounds and
# class, the mode it ran under, the HEAD it started at and the tree of the
# worktree contents it validated), runner
# (lib/job-unit.sh's record of how the child runs), class.log (the stderr of the base-branch lookup and the
# classifier), ci.log (for a ci request, the stderr of its base-branch lookup
# and its two rule reads), paths (DEV_VALIDATE_PATHS), pid (the detached child's process
# id), log (the runner line, then the command's output), own-exit (present
# once the command returned by itself), timing (the command's wall time) and
# exit (the sentinel).
#
# timing holds three lines, written whole by write_verdict just before the
# sentinel, so a run with a sentinel has one:
#   started-at=TIME   when the command started, UTC
#   ended-at=TIME     when it ended, the sentinel's own at= value
#   seconds=N         ended-at less started-at
#
# Validation modes, --validate-mode, recorded as the validate-mode= line of
# start:
#   full   DEV_VALIDATE_CMD, the project's whole battery. The default.
#   range  DEV_VALIDATE_RANGE_CMD, which validates the changes since --base REF
#          and nothing else; a fix round's run, and a restack's run, as
#          merge-pr-restack.md sets out. The command reads the base as
#          DEV_VALIDATE_BASE, the commit REF resolved to when the run started,
#          also recorded as the validate-base= line of start. A project that
#          sets no DEV_VALIDATE_RANGE_CMD runs DEV_VALIDATE_CMD instead, and the
#          run records full, the mode that ran. A REF a rebase left off the
#          branch is recorded as the validate-base-orphaned= line of start in
#          either mode, and a range run then runs from the merge base of HEAD
#          with the origin base branch. In either mode a range request hands
#          the command the class, docs verdict and paths of the changes since
#          its base, a fix round's own, recorded as the class-base= line of
#          start, or for an orphaned base those of the whole branch, with no
#          class-base= line. A full run with a class base therefore ran only
#          the lanes the round's changes need, and stands for the round, never
#          for the branch, unless its command reports selection=battery: every
#          lane it has, none stood down for that class.
#   ci     a post-open fix round's run, which the pull request's CI on the
#          pushed head validates. It runs no command and passes at once, with
#          a zero-second wall time, only where the project names the status
#          check context that runs its validation in DEV_VALIDATE_CI_CONTEXT
#          and the base branch of the worktree branch's open pull request
#          requires that context, through its rulesets or its classic branch
#          protection, as GitHub reports them for the repository gh resolves
#          (GH_REPO, else the worktree). The base is the pull request's own,
#          which a stacked pull request sets to a branch other than the
#          default.
#          Anywhere else it runs the command a range request runs, records
#          the mode that ran, and names why as the ci-fallback= line of start.
#          Without a repository selector it hands that command the class,
#          docs verdict and paths of the whole branch, with no class-base=
#          line, where a range request hands those since its base. A configured
#          selector supplies the round's evidence before CI can skip its work.
#          The causes:
#            setting-empty       DEV_VALIDATE_CI_CONTEXT is empty, the default
#            pr-not-open         no pull request, or its state is CLOSED or
#                                MERGED, confirmed by pr-view-json
#            base-unresolved     the pull request lookup, response or base
#                                encoding failed
#            rules-unread        a rule read failed and neither read that
#                                answered names the context
#            context-unrequired  both reads answered and neither names it
#            class-uncovered     a class other than micro, small or
#                                standard, a docs-only diff, failed class
#                                evidence, or an unmeasured narrow class,
#                                since harness-ci may stand CI's checks down
#                                for it
#            selection-unread    the selector or the round evidence failed
#
# Full and range starts may also resolve to ci before launching their command.
# DEV_VALIDATE_SELECTION_CMD, optional, previews the command's own selection
# with one selection=all or selection=subset line. It receives the same class,
# docs verdict, paths and base as validation, plus DEV_VALIDATE_MODE, the
# requested mode. All attempts the existing ci route. A range subset also
# attempts it: the selector reports no cost, so a subset can exceed the local
# time target. Full subsets keep local execution. Unset, failed or
# unreported selection keeps full and range requests local. For an explicit
# ci request, an unset selector preserves the existing CI route. A configured
# selector must report all or subset before CI can skip local work.
# Its evidence is the current round from
# --base, including uncommitted edits, rather than the whole pull request.
# The whole branch still determines whether CI covers the change class.
# Failed evidence keeps local validation with a conservative class and paths.
# With no pull request or an older CLOSED/MERGED pull request confirmed, an
# eligible all selection runs that selector
# with DEV_VALIDATE_SCOPED=true: the selector executes its changed-file suites
# and reports the usual validate: line with selection=subset. start and
# --record carry scoped=true. A scoped full run records the branch merge base
# as class-base, so submit cannot reuse it as a whole-branch battery pass.
#
# A start reads the worktree's earlier runs before it runs anything. An
# earlier full or range run counts as evidence when all of these hold:
#   - its command ran and the bound ended it: no bound-run= line in its start;
#   - it ran the exact command text this run would run, so a changed
#     DEV_VALIDATE_CMD or DEV_VALIDATE_RANGE_CMD is new work;
#   - it handed its command the class and docs verdict this run hands it,
#     which a command may select its lanes by, and the same DEV_VALIDATE_BASE,
#     its validate-base= line, which a range command validates from;
#   - its log holds no finding line;
#   - its recorded finding prefix equals the current setting;
#   - its bound was at least this one's;
#   - this run reads every changed path it read.
# Such a run says this run would end at the bound as well: the project's
# command chooses its own suites, and a run over no fewer paths chooses no
# fewer. A full or range run, a ci request's fallback included, then starts
# nothing: start records the newest such run as the bound-run= line, the
# sentinel carries that run's guard-exit and verdict=no-verdict, the log names
# it, and the wall time is zero. The caller takes the route a no-verdict run
# takes, the scoped suites. A ci run is never one, since its route is the
# caller's to request. --fresh ignores the evidence and runs the command: the
# runner cannot see a setting the command reads beyond its own text, such as
# a workload switch, so a caller who changed one asks for a fresh run.
# A finding line is the one
# ../references/artifact-checks.md § Validation command output
# names: a line of the log, past its runner line, that starts with the prefix
# DEV_VALIDATE_FINDING_PREFIX names, the one the project's commands print each
# finding with, which start records as the finding-prefix= line. The runner
# never guesses it: a run whose start records none, the setting being empty
# by default, and a log that cannot be read each count as holding one, so
# such a run is never evidence and --last-pass names it red.
#
# Every mode records the worktree's HEAD when the run started as the head= line
# of start, empty where the worktree has no commit, beside the start= epoch
# second. dev-return-write binds those fields to the delegated round, per
# schemas/dev-return.md. The tree= line is the tree of the worktree contents
# the class was read from, committed or not, so what a run validated is known
# even where the round commits it only after the run; it is absent where the
# class fell back before its snapshot, on an unresolved base branch or a
# snapshot that could not be written.
#
# Output protocol — the agent reads these lines and the tests pin them:
#   state=started run-dir=… log=… sentinel=… timeout-secs=N poll-secs=N cap-secs=N class=… docs-only=… [class-fallback=…]
#   state=done guard-exit=N at=TIME validate=pass|FAILING|no-verdict run-dir=… log=…
#   state=running elapsed-secs=N cap-secs=N run-dir=…
#   state=timeout elapsed-secs=N cap-secs=N validate=FAILING run-dir=… [log=…]
#   state=lost elapsed-secs=N cap-secs=N validate=FAILING run-dir=… [log=…]
#   validate-mode=full|range|ci [lanes=NAMES] selection=all|subset|battery|unreported verdict=pass|FAILING|no-verdict|unfinished head=SHA| start=EPOCH [validate-base-orphaned=SHA] [class-base=SHA] [seconds=N started-at=TIME ended-at=TIME] [ci-fallback=CAUSE]   (--record)
#   validate-mode=full|range|ci                                               (--resolve-mode)
#   run-dir=… head=SHA tree=SHA                                               (--last-pass)
#   last-pass=none | last-pass=red run-dir=…                                 (--last-pass, exit 1)
#   run-dir=… pid=N                                                           (--live)
#   live=none                                                                 (--live, exit 1)
#
# --record's verdict is pass only for a sentinel of guard-exit=0, no-verdict
# for a sentinel carrying verdict=no-verdict, FAILING for any other exit, and
# unfinished where no sentinel exists: a run still going, past its cap or lost.
# Only pass is a passing validation. The timing fields follow every verdict a
# sentinel carries, a no-verdict run's included, since the bound's end is
# still an end, and never an unfinished one, which has none; a sentinel with
# no readable timing file is refused as timing-unreadable.
#
# A run the bound ended is no verdict, neither pass nor FAILING: the command
# was cut off, not refuted. The child records verdict=no-verdict only for
# timeout's own exit, 124 or 137, with no own-exit marker: the command writes
# that marker when it returns by itself, so a command that exits 124 or 137 on
# its own is a failing command.
#
# state=lost is the detached child gone with no verdict recorded: a host or
# low-memory kill, an agent warden's reap
# (../references/job-units.md § Agent warden), or a launch that never ran. It is
# a failed validation, and it
# is reported as soon as the child's process id is gone rather than at the cap,
# so a lost run costs a poll interval and not the whole hour. log= is printed
# only where that file exists, so no reader is sent to a path nothing created.
#
# The sentinel file holds exactly one line, `guard-exit=N at=TIME`, with
# ` verdict=no-verdict` after it for a run the bound ended, written by the
# detached child, or for a ci run, or a run an earlier run's bound ended, by
# the start path. A harness that kills the
# launching shell or drops its completion notice changes neither the verdict
# nor where it is recorded.
#
# Exit: 0 the command passed, a ci run left its validation to the pull request
# CI, --stop left nothing running, --live found a run going, or --last-pass
# found a pass; 1 it failed, the bound ended it, it was lost, or the cap elapsed
# with no verdict, a --stop could not end a run, --live found no run going, or
# --last-pass found no pass that still speaks for the worktree; 2 usage or
# configuration error, or a start refused as
# run-live; 3 --wait's budget elapsed while the run was still going, so poll
# again.

set -euo pipefail

PROG="dev-validate-run"
SCRIPT_PATH="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(dirname "$SCRIPT_PATH")"
# shellcheck source=lib/change-class.sh
source "$SCRIPT_DIR/lib/change-class.sh"
# shellcheck source=lib/job-unit.sh
source "$SCRIPT_DIR/lib/job-unit.sh"

# The poll granularity, and with it the slack the cap carries over the command's
# own limit: a command killed at its limit still has one interval in which to
# record the sentinel before the waiter reports the cap elapsed.
POLL_DEFAULT=30
# The gap between the SIGTERM the bound sends and the SIGKILL behind it. Without
# one the bound is a single signal, which a command that ignores SIGTERM simply
# outlives. It is the job-unit library's grace, so the bound, a unit's stop and
# a setsid group's end give a process the same time. The cap carries it, so the
# sentinel still lands inside a wait.
KILL_GRACE="$JOB_UNIT_KILL_GRACE"
# One --wait call returns within this many seconds whatever the run is doing, so
# the poll reports `state=running` instead of being cut off by the harness's own
# foreground ceiling with nothing said. The run's total cap is unaffected.
BUDGET_DEFAULT=540

die() {
  local reason="$1"
  shift
  {
    printf '%s: %s' "$PROG" "$reason"
    printf ' %s' "$@"
    printf '\n'
    case "$reason" in
      missing-value) printf 'The option requires a value.\n' ;;
      required) printf 'The required option is absent or empty.\n' ;;
      unknown-argument) printf 'The argument is not supported.\n' ;;
      mode-conflict) printf 'Use one of --worktree, --wait, --stop, --record, --resolve-mode, --last-pass, --live or --child.\n' ;;
      record-unreadable) printf 'The start record names no validation mode of full, range or ci.\n' ;;
      option-unused) printf 'The option has no meaning in this mode and would be silently dropped.\n' ;;
      repeated) printf 'The option was given twice, and one of its values would be silently dropped.\n' ;;
      not-directory) printf 'The path is not a directory.\n' ;;
      empty-validate-cmd) printf 'Set it in kendex.settings.toml [env] to the project full test, lint and typecheck command.\n' ;;
      invalid-mode) printf 'The validation mode must be full, range or ci.\n' ;;
      invalid-base) printf 'The base does not name a commit in the worktree.\n' ;;
      orphaned-base-unresolved) printf 'The base is not on the branch, and no merge base with the origin base branch could replace it.\n' ;;
      ancestry-unreadable) printf 'Git could not say whether the base is on the branch.\n' ;;
      unreadable-setting) printf 'The setting could not be read.\n' ;;
      invalid-seconds) printf 'The value must be a whole number of seconds above zero.\n' ;;
      missing-command) printf 'Install it: the run needs it, so no run was started.\n' ;;
      group-leader-missing) printf 'Install the github skill beside orch: --attached starts its run through that skill'\''s process-group leader prefix.\n' ;;
      no-run) printf 'Start a run with --worktree before polling it.\n' ;;
      sentinel-unreadable) printf 'The sentinel does not carry a guard-exit value.\n' ;;
      timing-unreadable) printf 'The run has a verdict but no started-at, ended-at and seconds record of its wall time.\n' ;;
      scratch-unavailable) printf 'A scratch directory for reading the change class could not be created.\n' ;;
      runner-unrecorded) printf 'The record of how the run is started could not be written, so no run was started.\n' ;;
      launch-failed) printf 'The run could not be started, so there is no verdict to wait for.\n' ;;
      run-live) printf 'Another validation run in this worktree is still going, so none was started beside it. Wait for its verdict with --wait --run-dir, or end it with --stop --worktree, then start again.\n' ;;
      job-end-failed) printf 'The verdict is recorded; what the command left in its process group may still run.\n' ;;
    esac
  } >&2
  exit 2
}

# A --stop that could not end a run: status 1, since the arguments were sound.
stop_failed() { # FIELD...
  {
    printf '%s: stop-failed' "$PROG"
    printf ' %s' "$@"
    printf '\nA validation run in this worktree may still be running.\n'
  } >&2
  exit 1
}

usage() {
  sed -n '2,/^set -/p' < "$SCRIPT_PATH" | sed '$d; s/^# \{0,1\}//'
}

need() { # FLAG ARGC VALUE
  (( $2 >= 2 )) || die missing-value "option=$1"
  case "$3" in
    --*) die missing-value "option=$1" "value=$3" ;;
  esac
}

check_seconds() { # LABEL VALUE
  [[ "$2" =~ ^[0-9]+$ ]] && (( 10#$2 > 0 )) || die invalid-seconds "$1" "value=$2"
}

start_field() { # FILE KEY
  sed -n "s/^$2=\\(.*\\)\$/\\1/p" < "$1"
}

# The argv of a run directory's child ends in that directory, so a pid with
# any other argv is not that run's child but a process that reused its id.
child_glob() { # RUN_DIR
  printf '* --child --run-dir */tmp/%s' "${1##*/}"
}

# The first run directory of the worktree with no verdict whose child still
# runs, in LIVE_RUN_DIR and LIVE_RUN_PID; both empty where there is none. A
# pid that still runs but whose argv cannot be read counts as that child: a
# start is refused rather than run beside a battery it could not rule out.
LIVE_RUN_DIR=""
LIVE_RUN_PID=""
find_live_run() { # WORKTREE
  local pid_file dir pid is
  LIVE_RUN_DIR="" LIVE_RUN_PID=""
  for pid_file in "$1"/tmp/dev-validate-*/pid; do
    [[ -f "$pid_file" ]] || continue
    dir="${pid_file%/pid}"
    [[ ! -s "$dir/exit" ]] || continue
    pid="$(cat "$pid_file" 2>/dev/null || true)"
    [[ "$pid" =~ ^[0-9]+$ ]] || continue
    is=0
    job_unit_pid_is "$pid" "$(child_glob "$dir")" || is=$?
    [[ "$is" != 1 ]] || continue
    LIVE_RUN_DIR="$dir" LIVE_RUN_PID="$pid"
    return 0
  done
}

# The run's wall time, then its sentinel, in the run directory. The wall time
# lands first, so every verdict has one. Both are written whole or not at all:
# a poll that caught a half-written sentinel would read a verdict that is not
# one. The child and the ci route both write through here.
write_verdict() { # STARTED-AT ENDED-AT SECONDS SENTINEL-LINE
  printf 'started-at=%s\nended-at=%s\nseconds=%s\n' "$1" "$2" "$3" > "$run_dir/timing.part"
  mv "$run_dir/timing.part" "$run_dir/timing"
  printf '%s\n' "$4" > "$run_dir/exit.part"
  mv "$run_dir/exit.part" "$run_dir/exit"
}

# 0 where the run's log holds a finding line, --help's: a line past the
# runner line starting with the finding-prefix= its start records. A run that
# records none, or whose log cannot be read, holds one.
run_has_finding() { # RUN_DIR
  local prefix rc=0
  prefix="$(start_field "$1/start" finding-prefix 2>/dev/null)" || return 0
  [[ -n "$prefix" ]] || return 0
  LC_ALL=C awk -v p="$prefix" 'NR > 1 && index($0, p) == 1 { found = 1; exit } END { exit !found }' \
    "$1/log" 2>/dev/null || rc=$?
  (( rc != 1 ))
}

# The newest earlier full or range run of the worktree that says a run of CMD
# over PATHS_FILE under TIMEOUT_SECS, handed CLASS, DOCS_ONLY and BASE, would
# end at the bound, as --help states it, in BOUND_RUN_DIR and its sentinel's exit in BOUND_RUN_EXIT; both empty
# where there is none.
BOUND_RUN_DIR=""
BOUND_RUN_EXIT=""
find_bound_run() { # WORKTREE TIMEOUT_SECS PATHS_FILE CMD CLASS DOCS_ONLY BASE FINDING_PREFIX
  local start_file dir secs line rc guard_exit ran
  BOUND_RUN_DIR="" BOUND_RUN_EXIT=""
  for start_file in "$1"/tmp/dev-validate-*/start; do
    [[ -f "$start_file" ]] || continue
    dir="${start_file%/start}"
    case "$(start_field "$start_file" validate-mode)" in
      full|range) ;;
      *) continue ;;
    esac
    # A run this rule answered ran nothing, so it is no evidence of its own.
    [[ -z "$(start_field "$start_file" bound-run)" ]] || continue
    ran="$(cat "$dir/cmd" 2>/dev/null)" && [[ "$ran" == "$4" ]] || continue
    [[ "$(start_field "$start_file" class)" == "$5" ]] || continue
    [[ "$(start_field "$start_file" docs-only)" == "$6" ]] || continue
    [[ "$(start_field "$start_file" validate-base)" == "$7" ]] || continue
    [[ "$(start_field "$start_file" finding-prefix)" == "$8" ]] || continue
    line="$(cat "$dir/exit" 2>/dev/null)" || continue
    [[ "$line" =~ ^guard-exit=([0-9]+)\ at=[^\ ]+\ verdict=no-verdict$ ]] || continue
    guard_exit="${BASH_REMATCH[1]}"
    secs="$(start_field "$start_file" timeout-secs)"
    [[ "$secs" =~ ^[0-9]+$ ]] && (( 10#$secs >= 10#$2 )) || continue
    [[ -s "$dir/paths" ]] || continue
    rc=0
    grep -Fxvq -f "$3" -- "$dir/paths" 2>/dev/null || rc=$?
    (( rc == 1 )) || continue
    ! run_has_finding "$dir" || continue
    BOUND_RUN_DIR="$dir" BOUND_RUN_EXIT="$guard_exit"
  done
}

# The worktree's diff against the base branch, or against the round's base
# commit where the caller names one, read once by lib/change-class.sh
# for everything the command is handed: class, docs_only (the docs verdict for
# the same range) and the changed paths in class_scratch/paths. Where any of
# them cannot be read, class is standard, docs_only false, the paths file is
# empty, and class_fallback names the cause. The worktree is judged as it
# stands: dev-implement validates before it commits, so HEAD alone would be a
# diff missing the round's own edit. Its contents are written to one
# unreferenced commit through a copy of the index, so HEAD, the index and the
# tree are left as they were. The copy keeps the index's modification time:
# git re-reads only an entry whose file is not older than its index, so a copy
# stamped now reads a same-second, same-size rewrite of a staged file as
# unchanged. Every object that commit needs is written to the
# scratch directory, the repository's own store serving as an alternate for
# what it already holds: an untracked or unstaged file never becomes a loose
# object in the shared store, where the umask, not the file's own mode, would
# decide who can read it. The scratch store is exported for the snapshot and
# the two classifier reads of it, and removed from the environment before
# anything else runs. A narrow class on no evidence would skip lanes the diff
# needs, so a failure never guesses one.
class=standard
docs_only=false
class_fallback=""
class_scratch=""
snapshot_tree=""
classify() { # [ROUND_BASE] — a commit; the origin base branch where empty
  local base="${1:-}" index objects
  if [[ -z "$class_scratch" ]]; then
    class_scratch="$(mktemp -d)" || die scratch-unavailable
    trap 'rm -rf -- "$class_scratch"' EXIT
    : > "$class_scratch/class.log"
  fi
  class=standard docs_only=false class_fallback="" snapshot_tree=""
  : > "$class_scratch/paths"
  if [[ -z "$base" ]]; then
    base="$("$SCRIPT_DIR/resolve-base-branch" "$worktree" 2>>"$class_scratch/class.log")" \
      || { class_fallback=base-unresolved; return 0; }
    base="origin/$base"
  fi
  index="$(git -C "$worktree" rev-parse --path-format=absolute --git-path index 2>/dev/null)" \
    && objects="$(git -C "$worktree" rev-parse --path-format=absolute --git-path objects 2>/dev/null)" \
    && mkdir -p -- "$class_scratch/objects" \
    || { class_fallback=worktree-unrecorded; return 0; }
  [[ ! -f "$index" ]] || cp -p -- "$index" "$class_scratch/index" \
    || { class_fallback=worktree-unrecorded; return 0; }
  export GIT_OBJECT_DIRECTORY="$class_scratch/objects" GIT_ALTERNATE_OBJECT_DIRECTORIES="$objects"
  classify_snapshot "$base"
  unset GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES
}
classify_snapshot() { # BASE — the snapshot and its two reads, in the scratch store
  local log="$class_scratch/class.log" tree head
  if ! tree="$(GIT_INDEX_FILE="$class_scratch/index" git -C "$worktree" add -A 2>/dev/null \
      && GIT_INDEX_FILE="$class_scratch/index" git -C "$worktree" write-tree 2>/dev/null)" \
    || ! head="$(GIT_AUTHOR_NAME="$PROG" GIT_AUTHOR_EMAIL="$PROG@localhost" \
      GIT_COMMITTER_NAME="$PROG" GIT_COMMITTER_EMAIL="$PROG@localhost" \
      git -C "$worktree" commit-tree "$tree" -p HEAD -m "$PROG: worktree" 2>/dev/null)"; then
    class_fallback=worktree-unrecorded
    return 0
  fi
  snapshot_tree="$tree"
  if ! change_class_read "$1" "$head" "$worktree" "$log" \
    || ! change_class_docs "$1" "$head" "$worktree" "$class_scratch/paths" "$log"; then
    class_fallback="$CHANGE_CLASS_CAUSE"
    : > "$class_scratch/paths"
    return 0
  fi
  class="$CHANGE_CLASS"
  docs_only="$CHANGE_CLASS_DOCS_ONLY"
}

worktree=""
run_dir=""
mode=""
poll="$POLL_DEFAULT"
budget="$BUDGET_DEFAULT"
worktree_given=false
validate_mode=full
base=""
run_dir_given=false
poll_given=false
budget_given=false
validate_mode_given=false
base_given=false
attached=false
fresh=false

set_mode() { # FLAG NEW
  [[ -z "$mode" ]] || die mode-conflict "option=$1" "mode=$mode"
  mode="$2"
}

once() { # FLAG GIVEN
  [[ "$2" == false ]] || die repeated "option=$1"
}

while (( $# > 0 )); do
  case "$1" in
    --worktree) need "$1" $# "${2:-}"; once "$1" "$worktree_given"; worktree_given=true; worktree="$2"; shift 2 ;;
    --wait)     set_mode "$1" wait; shift ;;
    --stop)     set_mode "$1" stop; shift ;;
    --child)    set_mode "$1" child; shift ;;
    --record)   set_mode "$1" record; shift ;;
    --resolve-mode) set_mode "$1" resolve; shift ;;
    --last-pass) set_mode "$1" last-pass; shift ;;
    --live)     set_mode "$1" live; shift ;;
    --run-dir)  need "$1" $# "${2:-}"; once "$1" "$run_dir_given"; run_dir_given=true; run_dir="$2"; shift 2 ;;
    --poll)     need "$1" $# "${2:-}"; once "$1" "$poll_given"; poll_given=true; poll="$2"; shift 2 ;;
    --budget)   need "$1" $# "${2:-}"; once "$1" "$budget_given"; budget_given=true; budget="$2"; shift 2 ;;
    --validate-mode) need "$1" $# "${2:-}"; once "$1" "$validate_mode_given"; validate_mode_given=true; validate_mode="$2"; shift 2 ;;
    --base)     need "$1" $# "${2:-}"; once "$1" "$base_given"; base_given=true; base="$2"; shift 2 ;;
    --attached) once "$1" "$attached"; attached=true; shift ;;
    --fresh)    once "$1" "$fresh"; fresh=true; shift ;;
    -h|--help)  usage; exit 0 ;;
    *)          die unknown-argument "argument=$1" ;;
  esac
done

# --worktree alone is the start path; with --stop it names what to stop, with
# --resolve-mode the project whose settings are read, and with --last-pass or
# --live the worktree whose runs are read.
[[ -n "$mode" || "$worktree_given" == false ]] || mode=start

# Every option belongs to one mode. A flag the mode cannot use is refused rather
# than dropped, so no caller believes it set a bound this script then ignores.
[[ "$attached" == false || -z "$mode" || "$mode" == start ]] || die option-unused "option=--attached" "mode=$mode"
[[ "$fresh" == false || -z "$mode" || "$mode" == start ]] || die option-unused "option=--fresh" "mode=$mode"
case "$mode" in
  start|stop|resolve|last-pass|live)
    [[ "$run_dir_given" == false ]] || die option-unused "option=--run-dir" "mode=$mode"
    [[ "$budget_given" == false ]] || die option-unused "option=--budget" "mode=$mode"
    [[ "$mode" == start || "$poll_given" == false ]] || die option-unused "option=--poll" "mode=$mode"
    [[ -n "$worktree" ]] || die required option=--worktree
    [[ -d "$worktree" ]] || die not-directory "path=$worktree"
    check_seconds option=--poll "$poll"
    if [[ "$mode" != start ]]; then
      [[ "$validate_mode_given" == false ]] || die option-unused "option=--validate-mode" "mode=$mode"
      [[ "$base_given" == false || "$mode" == resolve ]] || die option-unused "option=--base" "mode=$mode"
    else
      case "$validate_mode" in
        full) [[ "$base_given" == false ]] || die option-unused "option=--base" "validate-mode=$validate_mode" ;;
        range|ci) [[ -n "$base" ]] || die required "option=--base" "validate-mode=$validate_mode" ;;
        *) die invalid-mode "option=--validate-mode" "value=$validate_mode" ;;
      esac
    fi
    ;;
  wait|child|record)
    [[ "$worktree_given" == false ]] || die mode-conflict "option=--worktree" "mode=$mode"
    [[ "$poll_given" == false ]] || die option-unused "option=--poll" "mode=$mode"
    [[ "$validate_mode_given" == false ]] || die option-unused "option=--validate-mode" "mode=$mode"
    [[ "$base_given" == false ]] || die option-unused "option=--base" "mode=$mode"
    [[ "$mode" == wait || "$budget_given" == false ]] || die option-unused "option=--budget" "mode=$mode"
    [[ -n "$run_dir" ]] || die required option=--run-dir
    [[ -d "$run_dir" ]] || die not-directory "path=$run_dir"
    [[ "$mode" != wait ]] || check_seconds option=--budget "$budget"
    ;;
  *) die required options=--worktree,--wait,--stop,--record,--resolve-mode,--last-pass,--live,--child ;;
esac

# Sets validate_mode, and cmd for a range run, to what a range request runs
# under in the current directory's project. Unset is a project with no range
# command, not a failure: it validates a fix round the way it always has, and
# the record says so.
resolve_range_mode() {
  if ! cmd="$("$SCRIPT_DIR/orch-env" DEV_VALIDATE_RANGE_CMD "")"; then
    die unreadable-setting setting=DEV_VALIDATE_RANGE_CMD
  fi
  if [[ -z "${cmd//[[:space:]]/}" ]]; then
    validate_mode=full
  else
    validate_mode=range
  fi
}

# The repository entry point owns path selection for both local and CI
# requests. A failed or ambiguous preview grants no permission to skip it.
preview_selection() {
  selection=""
  selection="$(DEV_VALIDATE_CLASS="$class" DEV_VALIDATE_DOCS_ONLY="$docs_only" \
      DEV_VALIDATE_PATHS="$class_scratch/paths" DEV_VALIDATE_BASE="$base_sha" \
      DEV_VALIDATE_MODE="$requested_mode" DEV_VALIDATE_SCOPED=false \
      "$BASH" -c "$selection_cmd" 2>"$class_scratch/selection.log")" \
    && selection="$(sed -n '/^selection=/p' <<<"$selection")"
}

# The contexts the base branch requires, one per line: those its rulesets'
# required_status_checks rules name, and those its classic branch protection
# names. GitHub omits the branch payload's protection key from a caller
# without push access, so a payload with none is an unread protection, never
# an empty one.
CI_RULES_JQ='.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[]?.context'
CI_CLASSIC_JQ='if has("protection") then .protection.required_status_checks | ((.contexts // []) + [(.checks // [])[] | .context]) | .[] else error("protection unreadable") end'

# Both requested CI and automatic selection resolution use the same coverage
# rule: CI may stand checks down for render or docs-only changes. A standard
# fallback runs CI's conservative lanes, so it does not need a measured size.
# This is a local coverage check, not a change to the classifier's policy.
ci_class_covered() {
  [[ -z "$class_fallback" && "$docs_only" == false ]] || return 1
  case "$class" in
    standard) return 0 ;;
    micro|small) [[ "$CHANGE_CLASS_MEASURED" == true ]]; return $? ;;
  esac
  return 1
}

# Whether the pull request CI validates the change, as --help's ci mode states
# it: the current directory's project names the context, and the base branch
# of the current branch's open pull request requires it. Where it does not, sets ci_fallback to the cause --help names.
# A read that fails is no proof, and the run validates locally; its stderr
# goes to ci.log in the class scratch directory, which the run directory
# keeps.
ci_fallback=""
ci_runs_validation() {
  local context base_branch uri rules classic pr_json pr_state unread=false log="$class_scratch/ci.log"
  context="$("$SCRIPT_DIR/orch-env" DEV_VALIDATE_CI_CONTEXT "")" \
    || die unreadable-setting setting=DEV_VALIDATE_CI_CONTEXT
  if [[ -z "$context" ]]; then
    ci_fallback=setting-empty
    return 1
  fi
  if ! pr_json="$("$SCRIPT_DIR/pr-view-json" "$worktree" --json baseRefName,state 2>>"$log")"; then
    ci_fallback=base-unresolved
    return 1
  fi
  if ! pr_state="$(jq -er 'if .status == "no_pr" then "NO_PR" else .state | select(. == "OPEN" or . == "CLOSED" or . == "MERGED") end' <<<"$pr_json" 2>>"$log")"; then
    ci_fallback=base-unresolved
    return 1
  fi
  case "$pr_state" in
    NO_PR|CLOSED|MERGED) ci_fallback=pr-not-open; return 1 ;;
  esac
  if ! base_branch="$(jq -er '.baseRefName | select(type == "string" and length > 0)' <<<"$pr_json" 2>>"$log")" \
    || ! uri="$(jq -rn --arg v "$base_branch" '$v | @uri' 2>>"$log")"; then
    ci_fallback=base-unresolved
    return 1
  fi
  if ! rules="$(gh api "repos/{owner}/{repo}/rules/branches/$uri" --paginate --jq "$CI_RULES_JQ" 2>>"$log")"; then
    rules=""
    unread=true
  fi
  if ! classic="$(gh api "repos/{owner}/{repo}/branches/$uri" --jq "$CI_CLASSIC_JQ" 2>>"$log")"; then
    classic=""
    unread=true
  fi
  if grep -Fxq -- "$context" <<<"$rules"$'\n'"$classic"; then
    ci_fallback=""
    return 0
  fi
  if [[ "$unread" == true ]]; then
    ci_fallback=rules-unread
  else
    ci_fallback=context-unrequired
  fi
  return 1
}

# --- Resolve: the mode a range run records here, read-only -------------------
if [[ "$mode" == resolve && "$base_given" == false ]]; then
  cd "$worktree"
  resolve_range_mode
  printf 'validate-mode=%s\n' "$validate_mode"
  exit 0
fi

# --- Start: resolve the bound, record it, launch the run detached ------------
if [[ "$mode" == start || "$mode" == resolve ]]; then
  [[ "$mode" != resolve ]] || validate_mode=range
  worktree="$(cd "$worktree" && pwd)"
  # orch-env resolves the project from the working directory, so the settings
  # read is the worktree's own.
  cd "$worktree"
  # A range run takes its base as one commit, fixed when it starts, so a
  # branch name that moves while the run goes cannot change what it judged.
  base_sha=""
  orphaned_sha=""
  cmd=""
  requested_mode="$validate_mode"
  selection_previewed=false
  selection_cmd="$("$SCRIPT_DIR/orch-env" DEV_VALIDATE_SELECTION_CMD "")" \
    || die unreadable-setting setting=DEV_VALIDATE_SELECTION_CMD
  if [[ "$validate_mode" != full ]]; then
    base_sha="$(git rev-parse --verify -q "$base^{commit}")" || die invalid-base "base=$base"
    # A base a rebase left off the branch is recorded whichever mode runs: a
    # fix round's receipt names the run through it once the round's base is no
    # longer in HEAD.
    ancestor_rc=0
    git merge-base --is-ancestor "$base_sha" HEAD || ancestor_rc=$?
    (( ancestor_rc <= 1 )) || die ancestry-unreadable "base=$base_sha"
    (( ancestor_rc == 0 )) || orphaned_sha="$base_sha"
  fi
  # Read before the run directory exists, since that directory sits inside the
  # worktree the class judges. A range request is judged from its base, so a
  # fix round's command reads the round's changes even where the project's
  # range command is unset and the run is full; a ci request is judged over
  # the whole branch, as the pull request CI judges it. start records that
  # base as class-base=, so submit takes such a full pass for the branch's
  # only where its command reports the whole battery.
  class_base=""
  [[ "$validate_mode" != range || -n "$orphaned_sha" ]] || class_base="$base_sha"
  classify "$class_base"
  # A ci request runs as range where CI may not run the checks for the change;
  # --help's ci mode names when.
  if [[ "$validate_mode" == ci ]]; then
    validate_mode=range
    ci_fallback=class-uncovered
    if ci_class_covered && ci_runs_validation; then
      if [[ -z "${selection_cmd//[[:space:]]/}" ]]; then
        validate_mode=ci
      else
        selection_previewed=true
        ci_fallback=selection-unread
        # CI eligibility uses the branch. The repository's local bound uses
        # the fix round, which --base names, before CI can bypass its checks.
        if [[ -z "$orphaned_sha" ]]; then
          class_base="$base_sha"
          classify "$class_base"
          if [[ -z "$class_fallback" ]] && preview_selection; then
            case "$selection" in
              selection=all|selection=subset) validate_mode=ci; class_base="" ;;
            esac
          fi
        fi
      fi
    fi
  fi
  if [[ "$validate_mode" != full ]]; then
    [[ "$validate_mode" == ci ]] || resolve_range_mode
    if [[ "$validate_mode" == full ]]; then
      base_sha=""
    elif [[ "$validate_mode" == range && -n "$orphaned_sha" ]]; then
      # A range from the orphaned base spans every commit the base branch
      # gained; the branch's fork point holds only its own changes.
      base_branch="$("$SCRIPT_DIR/resolve-base-branch" "$worktree")" \
        && base_sha="$(git merge-base HEAD "refs/remotes/origin/$base_branch")" \
        || die orphaned-base-unresolved "base=$orphaned_sha"
    fi
  fi
  if [[ "$validate_mode" == full ]]; then
    if ! cmd="$("$SCRIPT_DIR/orch-env" DEV_VALIDATE_CMD "")"; then
      die unreadable-setting setting=DEV_VALIDATE_CMD
    fi
    [[ -n "${cmd//[[:space:]]/}" ]] || die empty-validate-cmd setting=DEV_VALIDATE_CMD
  fi
  scoped=false
  if [[ "$validate_mode" != ci && "$selection_previewed" == false ]]; then
    if [[ -n "${selection_cmd//[[:space:]]/}" ]]; then
      if preview_selection && { [[ "$selection" == selection=all ]] \
          || [[ "$requested_mode" == range && "$selection" == selection=subset ]]; }; then
        ci_fallback=class-uncovered
        if ci_class_covered && ci_runs_validation; then
          validate_mode=ci
          class_base=""
        elif [[ "$ci_fallback" == pr-not-open && "$selection" == selection=all ]]; then
          # The selector owns scoped execution too; no second suite map
          # or project-specific command lives in this runner.
          scoped=true
          cmd="$selection_cmd"
          if [[ -z "$class_base" ]]; then
            scoped_base="$("$SCRIPT_DIR/resolve-base-branch" "$worktree")" \
              && class_base="$(git merge-base HEAD "origin/$scoped_base")" \
              || die scoped-base-unresolved
          fi
        fi
      fi
    fi
  fi
  if [[ "$mode" == resolve ]]; then
    printf 'validate-mode=%s\n' "$validate_mode"
    exit 0
  fi
  # Read against an empty default, never 3600: orch-env replaces a non-numeric
  # effective value with a numeric default of its own, so a setting of 90m would
  # arrive here as 3600 and the refusal below could never fire. The default is
  # applied here instead, leaving check_seconds to judge what was actually set.
  if ! timeout_secs="$("$SCRIPT_DIR/orch-env" DEV_VALIDATE_TIMEOUT_SECS "")"; then
    die unreadable-setting setting=DEV_VALIDATE_TIMEOUT_SECS
  fi
  [[ -n "$timeout_secs" ]] || timeout_secs=3600
  check_seconds setting=DEV_VALIDATE_TIMEOUT_SECS "$timeout_secs"
  if ! finding_prefix="$("$SCRIPT_DIR/orch-env" DEV_VALIDATE_FINDING_PREFIX "")"; then
    die unreadable-setting setting=DEV_VALIDATE_FINDING_PREFIX
  fi
  # An earlier run of this command that the bound ended over no more paths
  # than this one reads answers it: --help states which run counts.
  bound_ended=false
  if [[ "$validate_mode" != ci && "$fresh" == false && -z "$class_fallback" ]]; then
    find_bound_run "$worktree" "$timeout_secs" "$class_scratch/paths" "$cmd" "$class" "$docs_only" "$base_sha" "$finding_prefix"
    [[ -z "$BOUND_RUN_DIR" ]] || bound_ended=true
  fi

  # Without a timeout command the run carries no bound, which is the unbounded
  # wait this script exists to end. Refuse rather than run it unbounded.
  timeout_bin=""
  for candidate in timeout gtimeout; do
    if command -v "$candidate" >/dev/null 2>&1; then
      timeout_bin="$candidate"
      break
    fi
  done
  [[ -n "$timeout_bin" ]] || die missing-command commands=timeout,gtimeout
  # A worktree with no commit has no HEAD to record; the empty value binds the
  # run to no round.
  head_sha="$(git rev-parse --verify -q 'HEAD^{commit}')" || head_sha=""

  # Judged just before this run's directory is made: two starts that both
  # pass it must each reach the check inside the other's launch, a window of
  # the launch alone rather than of the class read above.
  find_live_run "$worktree"
  [[ -z "$LIVE_RUN_DIR" ]] || die run-live "run-dir=$LIVE_RUN_DIR" "pid=$LIVE_RUN_PID"

  # A fresh directory per start, so a poll can never read the previous round's
  # verdict as this one's.
  run_id="$(date -u +%Y%m%dT%H%M%SZ)-$$"
  run_dir="$worktree/tmp/dev-validate-$run_id"
  mkdir -p "$run_dir"
  mv -- "$class_scratch/class.log" "$run_dir/class.log"
  [[ ! -f "$class_scratch/selection.log" ]] || mv -- "$class_scratch/selection.log" "$run_dir/selection.log"
  [[ ! -f "$class_scratch/ci.log" ]] || mv -- "$class_scratch/ci.log" "$run_dir/ci.log"
  mv -- "$class_scratch/paths" "$run_dir/paths"
  printf '%s' "$cmd" > "$run_dir/cmd"
  cap_secs=$(( 10#$timeout_secs + KILL_GRACE + 10#$poll ))
  {
    printf 'worktree=%s\n' "$worktree"
    printf 'timeout-bin=%s\n' "$timeout_bin"
    printf 'start=%s\n' "$(date +%s)"
    printf 'timeout-secs=%s\n' "$timeout_secs"
    printf 'poll-secs=%s\n' "$poll"
    printf 'cap-secs=%s\n' "$cap_secs"
    printf 'class=%s\n' "$class"
    printf 'docs-only=%s\n' "$docs_only"
    printf 'validate-mode=%s\n' "$validate_mode"
    [[ "$scoped" == false ]] || printf 'scoped=true\n'
    printf 'validate-base=%s\n' "$base_sha"
    [[ -z "$orphaned_sha" ]] || printf 'validate-base-orphaned=%s\n' "$orphaned_sha"
    [[ "$validate_mode" == ci || -z "$ci_fallback" ]] || printf 'ci-fallback=%s\n' "$ci_fallback"
    [[ -z "$class_base" ]] || printf 'class-base=%s\n' "$class_base"
    [[ "$bound_ended" == false ]] || printf 'bound-run=%s\n' "$BOUND_RUN_DIR"
    [[ -z "$finding_prefix" || "$finding_prefix" == *$'\n'* ]] || printf 'finding-prefix=%s\n' "$finding_prefix"
    printf 'head=%s\n' "$head_sha"
    [[ -z "$snapshot_tree" ]] || printf 'tree=%s\n' "$snapshot_tree"
  } > "$run_dir/start"

  started_line() {
    printf 'state=started run-dir=%s log=%s sentinel=%s timeout-secs=%s poll-secs=%s cap-secs=%s class=%s docs-only=%s%s\n' \
      "$run_dir" "$run_dir/log" "$run_dir/exit" "$timeout_secs" "$poll" "$cap_secs" \
      "$class" "$docs_only" "${class_fallback:+ class-fallback=$class_fallback}"
  }
  launch_rc=0
  if [[ "$validate_mode" == ci ]]; then
    # A ci run starts nothing: the pull request CI on the pushed head is its
    # validation, so it passes here, through the writer the child uses.
    ci_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf 'runner=none class=%s: the pull request CI on the pushed head validates this change\n' "$class" > "$run_dir/log"
    write_verdict "$ci_at" "$ci_at" 0 "guard-exit=0 at=$ci_at"
  elif [[ "$bound_ended" == true ]]; then
    # An earlier run already reached the bound over every path this one
    # reads, so this one starts nothing and records no verdict.
    bound_at="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    printf 'runner=none bound-run=%s: that run reached the %ss bound over every path this run reads\n' \
      "$BOUND_RUN_DIR" "$timeout_secs" > "$run_dir/log"
    write_verdict "$bound_at" "$bound_at" 0 "guard-exit=$BOUND_RUN_EXIT at=$bound_at verdict=no-verdict"
  elif [[ "$attached" == true ]]; then
    # Printed first, since the call below returns only once the run has ended:
    # a harness that cuts the call off has already been told the directory.
    started_line
    job_unit_attach "$run_dir/runner" -- "$SCRIPT_PATH" --child --run-dir "$run_dir" || launch_rc=$?
  else
    # The run has to outlive the shell that launched it, because that shell is
    # what a harness kills; a job unit does.
    job_unit_launch "validate-${worktree##*/}" "$run_dir/runner" --cap "$cap_secs" \
      -- "$SCRIPT_PATH" --child --run-dir "$run_dir" || launch_rc=$?
  fi
  case "$launch_rc" in
    0) ;;
    1) die runner-unrecorded "path=$run_dir/runner" ;;
    2) die "$JOB_UNIT_ERROR_KEY" "$JOB_UNIT_ERROR" ;;
    4) die launch-failed "$JOB_UNIT_ERROR" ;;
    *) die launch-failed "status=$launch_rc" ;;
  esac
  [[ "$attached" == true && "$validate_mode" != ci && "$bound_ended" == false ]] || started_line
  # Blocking form: the same poll --wait runs, with no per-call budget, so a
  # foreground caller returns only with the verdict.
  mode=wait
  budget="$cap_secs"
fi

# --- Stop: end what a worktree's runs left running ---------------------------
# Every run the worktree's run directories record with no verdict. A unit is
# stopped by the exact name its runner record carries, never by a pattern (two
# repositories' lanes for one item share every prefix); a unit the manager no
# longer has ended on its own, and is not counted. A manager that cannot answer
# is a failure, never a unit found stopped. A setsid run is ended by its
# process group, the child having led one since setsid -f started it, and only
# while its pid is still the child of that run directory: a pid the system has
# since reused for anything else is left alone.
if [[ "$mode" == stop ]]; then
  worktree="$(cd "$worktree" && pwd)"
  units=0
  groups=0
  for runner_file in "$worktree"/tmp/dev-validate-*/runner; do
    [[ -f "$runner_file" ]] || continue
    dir="${runner_file%/runner}"
    [[ ! -s "$dir/exit" ]] || continue
    pid="$(cat "$dir/pid" 2>/dev/null || true)"
    stop_rc=0
    job_unit_stop_job "$runner_file" "$pid" "$(child_glob "$dir")" || stop_rc=$?
    case "$stop_rc" in
      0) if [[ "$JOB_UNIT_RUNNER" == systemd ]]; then units=$(( units + 1 )); else groups=$(( groups + 1 )); fi ;;
      1) ;;
      *) stop_failed "run-dir=$dir" "$JOB_UNIT_ERROR" ;;
    esac
  done
  printf 'state=stopped units=%s groups=%s\n' "$units" "$groups"
  exit 0
fi

# --- Child: run the command under the bound, then record the verdict ---------
if [[ "$mode" == child ]]; then
  if ! child_worktree="$(start_field "$run_dir/start" worktree)" \
    || ! child_timeout_bin="$(start_field "$run_dir/start" timeout-bin)" \
    || ! child_timeout_secs="$(start_field "$run_dir/start" timeout-secs)" \
    || ! child_class="$(start_field "$run_dir/start" class)" \
    || ! child_docs_only="$(start_field "$run_dir/start" docs-only)"; then
    die no-run "path=$run_dir/start"
  fi
  [[ -n "$child_worktree" && -n "$child_timeout_bin" && -n "$child_timeout_secs" && -n "$child_class" && -n "$child_docs_only" ]] \
    || die no-run "path=$run_dir/start"
  job_unit_read "$run_dir/runner" || die no-run "path=$run_dir/runner"
  child_cmd="$(cat "$run_dir/cmd")"
  child_base="$(start_field "$run_dir/start" validate-base)" || die no-run "path=$run_dir/start"
  child_scoped="$(start_field "$run_dir/start" scoped)" || die no-run "path=$run_dir/start"
  [[ -z "$child_base" ]] || export DEV_VALIDATE_BASE="$child_base"
  # Recorded before the command starts, so a waiter that finds no sentinel can
  # tell a run still going from one the host killed. Written whole, like the
  # sentinel. A process id the system has since handed to something else only
  # makes the waiter keep waiting; it never calls a live run lost.
  printf '%s\n' "$$" > "$run_dir/pid.part"
  mv "$run_dir/pid.part" "$run_dir/pid"
  status=0
  cd "$child_worktree"
  # The first log line names what contains the run. A log that cannot be
  # written loses that line and never the verdict, as it loses the command's
  # output below.
  printf '%s\n' "$JOB_UNIT_LINE" 2>/dev/null > "$run_dir/log" || :
  # Epoch and UTC time from one date call, so the two cannot straddle a second.
  started="$(date -u '+%s %Y-%m-%dT%H:%M:%SZ')"
  # bash, not sh: DEV_VALIDATE_CMD is written for the harness's own shell, and
  # on Debian and Ubuntu sh is dash, where source, [[ ]] and set -o pipefail are
  # errors that would record a false failing verdict. post-merge and
  # open-terminal run a configured command the same way. -k turns the bound from
  # one ignorable signal into one the wrapper below cannot survive. --foreground keeps
  # the command in this process's group rather than a group of timeout's own,
  # so the group this child kills below is every process the command started
  # that did not leave it. The class and its companions are set over whatever
  # the launching shell exported.
  #
  # The command runs under a wrapper that writes own-exit once it returns by
  # itself, which is how the bound's 124 or 137 is told from the command's
  # own. The bound's TERM therefore ends the wrapper, not the command: the
  # command, still in this group or unit, is ended by the teardown below,
  # TERM first and KILL a grace later, once the verdict is on disk.
  DEV_VALIDATE_CLASS="$child_class" DEV_VALIDATE_DOCS_ONLY="$child_docs_only" \
    DEV_VALIDATE_SCOPED="${child_scoped:-false}" \
    DEV_VALIDATE_PATHS="$run_dir/paths" "$child_timeout_bin" --foreground -k "$KILL_GRACE" "$child_timeout_secs" \
    bash -c 'bash -c "$1"; rc=$?; : > "$2"; exit "$rc"' _ "$child_cmd" "$run_dir/own-exit" >> "$run_dir/log" 2>&1 || status=$?
  ended="$(date -u '+%s %Y-%m-%dT%H:%M:%SZ')"
  ended_by=""
  if [[ ( "$status" == 124 || "$status" == 137 ) && ! -e "$run_dir/own-exit" ]]; then
    ended_by=" verdict=no-verdict"
  fi
  write_verdict "${started#* }" "${ended#* }" "$(( ${ended%% *} - ${started%% *} ))" \
    "guard-exit=$status at=${ended#* }$ended_by"
  # The verdict is on disk, so nothing the command left behind is still owed a
  # run. Under setsid, setsid -f made this process its group's leader, and the
  # call tears down what else the group holds before this process exits. In a
  # unit the call does nothing: systemd ends what remains once this process
  # exits.
  job_unit_end "$run_dir/runner" "$$" || die job-end-failed "$JOB_UNIT_ERROR"
  exit 0
fi

# The exit status the sentinel records, in SENTINEL_EXIT, its time in
# SENTINEL_AT, and what it decided, pass, FAILING or no-verdict, in
# SENTINEL_VERDICT. Every reader of the sentinel goes through here, so it has
# one parse, and a refusal here ends the script rather than a subshell.
SENTINEL_EXIT=""
SENTINEL_AT=""
SENTINEL_VERDICT=""
read_sentinel() {
  local line
  line="$(cat "$run_dir/exit")"
  SENTINEL_EXIT="${line#guard-exit=}"
  SENTINEL_EXIT="${SENTINEL_EXIT%% *}"
  [[ "$SENTINEL_EXIT" =~ ^[0-9]+$ ]] || die sentinel-unreadable "path=$run_dir/exit" "line=$line"
  SENTINEL_AT="${line#* at=}"
  SENTINEL_AT="${SENTINEL_AT%% *}"
  case "$line" in
    *" verdict=no-verdict") SENTINEL_VERDICT=no-verdict ;;
    "guard-exit=0 "*) SENTINEL_VERDICT=pass ;;
    *) SENTINEL_VERDICT=FAILING ;;
  esac
}

# --- Live: the run a start would refuse as run-live, read-only ---------------
if [[ "$mode" == live ]]; then
  worktree="$(cd "$worktree" && pwd)"
  find_live_run "$worktree"
  if [[ -z "$LIVE_RUN_DIR" ]]; then
    echo live=none
    exit 1
  fi
  printf 'run-dir=%s pid=%s\n' "$LIVE_RUN_DIR" "$LIVE_RUN_PID"
  exit 0
fi

# --- Last pass: the newest run that validated a known tree, read-only --------
# Run directories are named for the UTC second they started, so the last match
# in name order is the newest. A full or range run after that pass that did
# not pass, one unfinished or whose sentinel cannot be read included, is red:
# the newest pass no longer speaks for the worktree. A no-verdict run whose
# log holds no finding line is passed over.
if [[ "$mode" == last-pass ]]; then
  worktree="$(cd "$worktree" && pwd)"
  found=""
  red=""
  for start_file in "$worktree"/tmp/dev-validate-*/start; do
    [[ -f "$start_file" ]] || continue
    run_dir="${start_file%/start}"
    case "$(start_field "$start_file" validate-mode)" in
      full|range) ;;
      *) continue ;;
    esac
    verdict=unfinished
    if [[ -s "$run_dir/exit" ]]; then
      verdict="$(read_sentinel 2>/dev/null; printf '%s' "$SENTINEL_VERDICT")" || verdict=unreadable
    fi
    # A run the bound ended with no finding refuted nothing.
    if [[ "$verdict" == no-verdict ]] && ! run_has_finding "$run_dir"; then
      continue
    fi
    if [[ "$verdict" != pass ]]; then
      red="$run_dir"
      continue
    fi
    pass_head="" pass_tree=""
    if ! pass_head="$(start_field "$start_file" head)" || ! pass_tree="$(start_field "$start_file" tree)" \
      || [[ -z "$pass_head" || -z "$pass_tree" ]]; then
      continue
    fi
    found="run-dir=$run_dir head=$pass_head tree=$pass_tree"
    red=""
  done
  if [[ -n "$red" ]]; then
    echo "last-pass=red run-dir=$red"
    exit 1
  fi
  if [[ -z "$found" ]]; then
    echo last-pass=none
    exit 1
  fi
  printf '%s\n' "$found"
  exit 0
fi

[[ -f "$run_dir/start" ]] || die no-run "path=$run_dir/start"

# --- Record: the run's mode and verdict, read-only ---------------------------
if [[ "$mode" == record ]]; then
  # DEV_VALIDATE_CMD and DEV_VALIDATE_RANGE_CMD may report their lanes through
  # references/artifact-checks.md's Validation command output contract.
  # The last candidate owns the result, even when it is malformed.
  record_selection='selection=unreported'
  if [[ -e "$run_dir/log" ]]; then
    record_selection="$(LC_ALL=C awk '
      /^validate:/ { last = $0 }
      END {
        if (last ~ /^validate: lanes=[[:alnum:]_.-]+(,[[:alnum:]_.-]+)* selection=(all|subset|battery)$/) {
          split(last, fields, " "); print fields[2] " " fields[3]
        } else print "selection=unreported"
      }' "$run_dir/log")" || die record-unreadable "path=$run_dir/log"
  fi
  record_mode="$(start_field "$run_dir/start" validate-mode)"
  case "$record_mode" in
    full|range|ci) ;;
    *) die record-unreadable "path=$run_dir/start" "validate-mode=$record_mode" ;;
  esac
  record_verdict=unfinished
  record_timing=""
  if [[ -s "$run_dir/exit" ]]; then
    read_sentinel
    record_verdict="$SENTINEL_VERDICT"
    [[ -f "$run_dir/timing" ]] || die timing-unreadable "path=$run_dir/timing"
    timing_started="$(start_field "$run_dir/timing" started-at)"
    timing_ended="$(start_field "$run_dir/timing" ended-at)"
    timing_seconds="$(start_field "$run_dir/timing" seconds)"
    utc='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
    [[ "$timing_started" =~ $utc && "$timing_ended" =~ $utc && "$timing_seconds" =~ ^[0-9]+$ ]] \
      || die timing-unreadable "path=$run_dir/timing"
    record_timing=" seconds=$timing_seconds started-at=$timing_started ended-at=$timing_ended"
  fi
  record_orphaned="$(start_field "$run_dir/start" validate-base-orphaned)"
  record_class_base="$(start_field "$run_dir/start" class-base)"
  record_scoped="$(start_field "$run_dir/start" scoped)"
  record_ci_fallback="$(start_field "$run_dir/start" ci-fallback)"
  printf 'validate-mode=%s %s verdict=%s head=%s start=%s%s%s%s%s%s\n' "$record_mode" "$record_selection" "$record_verdict" \
    "$(start_field "$run_dir/start" head)" "$(start_field "$run_dir/start" start)" \
    "${record_orphaned:+ validate-base-orphaned=$record_orphaned}" "${record_class_base:+ class-base=$record_class_base}" "$record_timing" \
    "${record_scoped:+ scoped=$record_scoped}" "${record_ci_fallback:+ ci-fallback=$record_ci_fallback}"
  exit 0
fi

# --- Wait: poll the sentinel, report the verdict it carries ------------------
if ! run_start="$(start_field "$run_dir/start" start)" \
  || ! cap_secs="$(start_field "$run_dir/start" cap-secs)" \
  || ! poll="$(start_field "$run_dir/start" poll-secs)"; then
  die no-run "path=$run_dir/start"
fi
[[ -n "$run_start" && -n "$cap_secs" && -n "$poll" ]] || die no-run "path=$run_dir/start"

# A child needs time to fork, exec and record its process id, and under that the
# id's absence says nothing. Ten seconds is the floor, so a one-second poll
# interval never reads a launch still in flight as a launch that never happened.
launch_grace=$(( 10#$poll > 10 ? 10#$poll : 10 ))

# Printed only where the file exists: a run whose child never reached its first
# redirection has no log, and naming one would send the agent to a missing path.
log_field() {
  [[ -f "$run_dir/log" ]] || return 0
  printf ' log=%s' "$run_dir/log"
}

# True when the detached child is gone with no verdict recorded.
child_lost() { # ELAPSED
  local elapsed="$1" pid
  if [[ ! -f "$run_dir/pid" ]]; then
    if (( elapsed >= launch_grace )); then return 0; fi
    return 1
  fi
  pid="$(cat "$run_dir/pid")"
  if [[ ! "$pid" =~ ^[0-9]+$ ]] || kill -0 "$pid" 2>/dev/null; then
    return 1
  fi
  # Read the sentinel again: the child can record its verdict and exit between
  # the check at the top of the loop and this one, and that run is done, not
  # lost.
  if [[ -s "$run_dir/exit" ]]; then return 1; fi
  return 0
}

call_deadline=$(( $(date +%s) + 10#$budget ))
run_deadline=$(( 10#$run_start + 10#$cap_secs ))
while :; do
  if [[ -s "$run_dir/exit" ]]; then
    read_sentinel
    printf 'state=done guard-exit=%s at=%s validate=%s run-dir=%s log=%s\n' \
      "$SENTINEL_EXIT" "$SENTINEL_AT" "$SENTINEL_VERDICT" "$run_dir" "$run_dir/log"
    [[ "$SENTINEL_VERDICT" == pass ]] || exit 1
    exit 0
  fi
  now="$(date +%s)"
  elapsed=$(( now - 10#$run_start ))
  # The cap is judged before the child is, so a run whose bounds long ago
  # elapsed is reported as the timeout it is rather than as a lost launch.
  if (( now >= run_deadline )); then
    printf 'state=timeout elapsed-secs=%s cap-secs=%s validate=FAILING run-dir=%s%s\n' \
      "$elapsed" "$cap_secs" "$run_dir" "$(log_field)"
    exit 1
  fi
  if child_lost "$elapsed"; then
    printf 'state=lost elapsed-secs=%s cap-secs=%s validate=FAILING run-dir=%s%s\n' \
      "$elapsed" "$cap_secs" "$run_dir" "$(log_field)"
    exit 1
  fi
  if (( now >= call_deadline )); then
    printf 'state=running elapsed-secs=%s cap-secs=%s run-dir=%s\n' "$elapsed" "$cap_secs" "$run_dir"
    exit 3
  fi
  # Never sleep past a deadline: the next check lands on the call budget or the
  # cap rather than a whole poll interval beyond it, so one --wait call returns
  # inside its budget and the cap is judged when it is reached.
  nap=$(( 10#$poll ))
  (( nap <= run_deadline - now )) || nap=$(( run_deadline - now ))
  (( nap <= call_deadline - now )) || nap=$(( call_deadline - now ))
  sleep "$nap"
done
