#!/usr/bin/env bash
# Close one recorded tmux lane, its hosted sandbox, and its fleet record, or
# park a hosted lane's clean merge wait: end its harness and stop its sandbox
# while the PR waits for the queue, its disk and record kept for the resume.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
WORKFLOW_STATE="$SCRIPT_DIR/workflow-state"
LANE_HOST="$SCRIPT_DIR/lane-host"
LANE_MAIL="$SCRIPT_DIR/lane-mail"
DEV_VALIDATE_RUN="$SCRIPT_DIR/dev-validate-run"
LINEAR="$SCRIPT_DIR/../../linear/scripts/linear.sh"
WORKTREE="$SCRIPT_DIR/../../worktree/scripts/worktree"
LANES="$SCRIPT_DIR/lanes"
source "$SCRIPT_DIR/lib/lane-state.sh"
source "$SCRIPT_DIR/lib/lane-host-slots.sh"
source "$SCRIPT_DIR/lib/date-ladder.sh"
source "$SCRIPT_DIR/lib/usage-reset.sh"
source "$SCRIPT_DIR/lib/lane-capabilities.sh"
source "$SCRIPT_DIR/lib/lane-gitfile.sh"
source "$SCRIPT_DIR/lib/tmux-server.sh"

message() { # REASON FIELD=VALUE...
  local reason="$1" field
  shift
  printf 'lane-close: %s' "$reason"
  for field in "$@"; do printf ' %s' "$field"; done
  printf '\n'
  case "$reason" in
    argument-count) printf '%s\n' 'Specify one lane item.' ;;
    missing-value) printf '%s\n' 'The option requires a value.' ;;
    record-missing) printf '%s\n' 'No fleet lane record names this item.' ;;
    record-invalid) printf '%s\n' 'The lane record lacks a value required for safe close-out, or an option contradicts one it carries.' ;;
    pane-missing)
      printf '%s\n' 'No tmux pane carries the recorded window name.' \
        'cause=renamed is a local record whose launch pane, pane=, the tmux server its launch recorded still lists though no pane carries window=: that window or its session was renamed, or the window was moved to another session, and the lane may still run there.' \
        'First confirm pane= is the lane'"'"'s: it sits in the lane'"'"'s worktree or runs its harness. A tmux server started since, handed the recorded pid, lists panes of its own under the same ids.' \
        'Where it is the lane'"'"'s, restore window= as recorded, session name included where it names one, and close again. Where it is not, clear the record'"'"'s launch through workflow-state update oversee and close again.' ;;
    pane-ambiguous) printf '%s\n' 'More than one tmux pane carries the recorded window name.' ;;
    pane-read-failed)
      printf '%s\n' 'The lane pane could not be read.' \
        'server= is the tmux server a local record'"'"'s launch names, which runs a tmux this close does not reach, or whose pane list could not be read.' ;;
    lane-live)
      printf '%s\n' 'The lane is not finished. Close-out changed nothing.' \
        'state=walled is a limit banner below the lane'"'"'s last turn that its account reading did not lift. account= is that reading, taken for the model the record names, or over the whole account where it names none, and run under the record'"'"'s host, so a hosted lane'"'"'s reading is the provider'"'"'s where its accounts row carries one:' \
        '  room            lanes pick --lane read room, and the banner names a reset still ahead in resets=,' \
        '                  or resets=unresolved: a reset clause this host could not resolve, such as one in a zone it has no zoneinfo for.' \
        '  walled          lanes pick --lane read the account at or above ORCH_LANE_MAX_PCT.' \
        '  unmeasured      lanes pick --lane measured nothing for the account; its words are on the lines above.' \
        '  unlisted        the recorded account is no configured lane of the harness.' \
        '  read-failed     lanes pick --lane failed; its words are on the lines above.' \
        '  none            the record names no account, or its harness is not one lanes measures.' ;;
    item-open) printf '%s\n' 'The tracker holds this item open. The conditional close changed nothing.' ;;
    tracker-read-failed)
      printf '%s\n' \
        'The tracker state could not be read. Close-out changed nothing. cause names which read did not answer:' \
        '  key-ambiguous   the item key issue-N is what a github lane and a linear lane are both keyed by, so it names no tracker. Pass --tracker linear|github, and --repo OWNER/REPO with github.' \
        '  key-not-issue   the item key is not issue-N, so it carries no github issue number. Close it under its own tracker.' \
        '  repo-missing    the github lane has no repository. Pass --repo OWNER/REPO.' \
        '  read-failed     the tracker CLI failed. Its own words are on the lines above this one.' \
        '  cli-missing     the linear CLI is not executable beside this script.' \
        '  payload-unparsed  the linear CLI answered something that is not JSON.' \
        '  no-state-type   the linear payload carried no state_type, so it answered nothing.' \
        '  parked-record-invalid  the parked record carried no pull request or repository.' \
        '  pr-read-failed  the parked pull request could not be read.' \
        '  pr-state-invalid  the parked pull request carried no known state.' \
        '  checklist-missing  the linear checklist parser is not installed beside this script.' \
        '  checklist-unparsed  the completed item carried no description, or its checklist could not be read.' \
        '  tracker-unknown  tracker is neither linear nor github. Pass --tracker linear|github.' \
        'source=derived is a tracker read from the item key rather than from the record or --tracker, and source=given is one of those two.' ;;
    harness-unsupported) printf '%s\n' 'The recorded harness has no close-out path. harness=unknown is a record that carries none: pass --harness claude|codex|pi|copilot.' ;;
    ask-unanswered) printf '%s\n' 'The lane asked the overseer a question and is waiting for the answer. Closing it would end the session that answer would reach. Answer the ask, then close the lane.' ;;
    mail-read-failed) printf '%s\n' 'The lane mailbox could not be read, so nothing here says whether the lane asked anything. Close-out changed nothing.' ;;
    worktree-read-failed) printf '%s\n' "lane-host could not say whether the hosted lane's worktree, root=, still stands, so nothing here says the merge its record names was the lane's last work. Close-out changed nothing. cause=read-failed is a cat or touch of its .git that failed, lane-host's own words on the lines above this one; cause=scratch-unmade a mktemp that could not make the directory the read lands in." ;;
    lane-host-busy) printf '%s\n' 'lane-host refused the provider call step names at its per-home cap on provider calls; its own line is above and the provider ran nothing. The window and the fleet record are unchanged: run lane-close again. The exit status is lane-host'"'"'s own 69.' ;;
    tmux-failed) printf '%s\n' 'A tmux operation failed. Close-out stopped.' ;;
    stop-failed)
      printf '%s\n' \
        'The harness could not be stopped by signal. Close-out stopped. cause names the step:' \
        '  provider          the lane host stop verb exited with status; its own words are on the lines above this one.' \
        '                    status=4 beside its stop-worktree-removed item=ID line, under --keep-sandbox, is an item whose worktree is gone; only a full close skips that stop.' \
        '                    status=4 without that line is the provider'"'"'s own 4, such as a sandbox it stopped, which its line above names: start the sandbox, then close again.' \
        '  stderr-unsaved    mktemp could not make the file the lane host stop verb'"'"'s stderr is read from; its own words are above this one.' \
        '  answer-unparsed   the lane host stop verb succeeded without its stopped item=ID processes=COUNT line.' \
        '  identity-unread   the record names no launch identity and no process named for the harness runs under the pane.' \
        '  identity-stale    the record names a harness that has exited, or whose pid= a later process now holds, and no process named for the harness runs under the pane.' \
        '  process-read-failed  the process read under the pane failed, or the table read at the identity the stop signals by.' \
        '  any other value   the local stop step lib/lane-state.sh lane_stop_local names, pid= the process it failed on.' \
        'target=wake is the turn a wake started, stopped by the identity the record'"'"'s wake names before the record reads done or stopped.' ;;
    stop-skipped) printf '%s\n' "The lane host answered that the item's worktree is gone, so no harness process can be found by its directory. The host close below ends the harness where the provider's close ends the sandbox; otherwise the window close hangs up the lane's ssh session, which ends it. A static host's close ends no process." ;;
    exit-timeout) printf '%s\n' 'The pane did not read exited before the close timeout. processes= is how many harness processes the stop signalled and saw exit. A local lane'"'"'s identity= is the launch identity it signalled them by: recorded, the record'"'"'s launch, or pane, one read off the pane because the record named none or named a harness that had exited or whose pid a later process held. processes=0 is a process that identity named which exited before its signal, or, under recorded, no process named for the harness at or below it. Close-out stopped.' ;;
    state-write-failed) printf '%s\n' 'The lane closed, but its fleet record could not be updated.' ;;
    prepare-stop-failed) printf '%s\n' 'The background launch job the record names could not be stopped. Close-out changed nothing else.' ;;
    validate-stop-failed) printf '%s\n' "A validation run in the lane's worktree could not be ended. The window and record are unchanged; dev-validate-run's own words are on the lines above this one." ;;
    item-files-failed) printf '%s\n' "The item's files in the state directory could not all be removed. The host, window and record are unchanged, and a second close retries the removal. workflow-state's own words are on the lines above this one." ;;
    item-files-kept) printf '%s\n' "The item is not finished, or its tracker did not answer, so its files in the state directory stay for a relaunch. cause is open for an item the tracker holds open, and otherwise names the read that did not answer, as tracker-read-failed does. How long they stay is the prune's keep list, as workflow-state prune --help states." ;;
    merged-unjudged) printf '%s\n' "The record carries no cycle of a merge, and worktree merged could not say whether the item's pull request merged. status is its exit, its own words on the lines above this one; cause=worktree-missing is a worktree skill not installed beside this one, and cause=stderr-unsaved a mktemp that could not make the file its words are read from. The host close goes on without --merged, so the provider keeps the whole archive." ;;
    helper-missing) printf '%s\n' 'The required helper is not executable. Close-out changed nothing.' ;;
    park-refused)
      printf '%s\n' \
        'The lane was not parked and nothing changed. reason names the condition it stopped on:' \
        '  local             the record carries no host, so there is no sandbox to stop.' \
        '  repo-unresolved   the record names no repository and gh repo view could not answer for this checkout; pass --repo OWNER/REPO.' \
        '  pr-read-failed    gh pr view could not read the pull request; its own words are on the lines above this one.' \
        '  pr-branch-mismatch  the pull request'"'"'s head branch is not the item'"'"'s branch, so --pr names another lane'"'"'s pull request.' \
        '  pr-not-open       the pull request is merged or closed: a merged lane takes the full close, never a park.' \
        '  provider-unsupported  the lane host answered stop-sandbox --check with the status or cause named, so the sandbox could not be brought back once stopped: exit=2 is the absent-verb status of a provider without the stop-sandbox and start pair, lane-host-ssh among them; cause=answer-unparsed a check that succeeded without its sandbox-stoppable item=ID line.' \
        '  queue-read-failed the merge queue could not be asked whether it holds the pull request; gh api graphql'"'"'s own words are on the lines above this one.' \
        '  not-armed         the pull request is neither in the merge queue nor auto-merge armed, so nothing will merge it while the lane is away.' \
        '  merge-state       the pull request is armed and not queued, and GitHub reports the state named: only CLEAN, every required check green on the head and nothing else blocking, admits a park there. A push after the arm, a running check or a red one all read otherwise. A queued pull request is admitted on the queue'"'"'s own judgement and this state is not read for it.' \
        '  reducer-missing   the review-gate reducer pr-watch.sh is not installed beside this skill, and the review and thread reading is its alone.' \
        '  attention         the reducer prints attention for this pull request, kinds= naming what: an open thread, a standing objection, an approval that has not come. The lane is still needed.' \
        '  reducer-failed    the reducer could not evaluate the pull request; its own words are on the lines above this one.' ;;
    park-failed)
      printf '%s\n' \
        'The harness was ended and its window closed, but the sandbox could not be stopped, so the record reads stopped, the kept sandbox still billing. cause names the step:' \
        '  provider          the lane host stop-sandbox verb exited with status; its own words are on the lines above this one. A provider without the verb answers 2.' \
        '  answer-unparsed   the verb succeeded without its sandbox-stopped item=ID line, so nothing here confirms the sandbox is down.' \
        'A stopped record is what --keep-sandbox leaves: a relaunch recovers it, and lane-close --park --pr N on it retries the stop from the record alone.' ;;
    parked) printf '%s\n' 'The lane window closed, its harness ended and its sandbox stopped with its disk kept. The record reads parked and names the pull request and head it was judged on; the watch keeps an open pull request parked and hands an open item or a Done item with an unchecked Done-when box to the overseer as parked-merged after merge.' ;;
    stopped) printf '%s\n' 'The lane window closed and its sandbox was kept.' ;;
    host-absent) printf '%s\n' "The lane mailbox could not be read, mail-status= being lane-mail's exit, and the provider's list names no sandbox for this terminal item, so no session holds an ask. The record closes with no provider stop or close; its files and window go as in any full close." ;;
    fleet-log-failed) printf '%s\n' "The lane closed and its record reads done, but the fleet-log row naming the cause of its directive_send could not be written: cause=scratch-unmade a mktemp that failed, cause=append workflow-state's append-file, its own words above. The record keeps directive_send; write the close row by hand from it." ;;
    host-kept) printf '%s\n' 'The host kind has no stop: the session runs on until the operator archives it from the claude.ai sidebar. The record reads done and the local worktree is removed.' ;;
    host-capabilities-unread) printf '%s\n' 'lane-host could not declare the capability line of the host the record names, or declared a stop this close has no arm for; lane-host'"'"'s own words are above this line. Nothing was stopped and the record is unchanged.' ;;
    worktree-remove-failed) printf '%s\n' "The item's worktree on this machine could not be removed; worktree remove names the cause above this line. The record is unchanged, and a second close retries the removal." ;;
    closed) printf '%s\n' 'The lane, sandbox and fleet record closed.' ;;
  esac
}

usage() {
  cat <<'EOF'
Usage: lane-close [--state-dir PATH] [--keep-sandbox | --park --pr N]
                  [--harness claude|codex|pi|copilot] [--tracker linear|github]
                  [--repo OWNER/REPO] ITEM

Close one lane recorded in the oversee workflow state. The command refuses a
live lane. It accepts an exited lane, an idle lane whose tracker item is
terminal, or whose record carries the cycle oversee-cycle writes at its pull
request's merge and whose worktree, the record's mail_root, is gone, in a full
close a record whose window no pane carries on a terminal item, or a record
whose host kind declares stop=none, in any state, which the close ends on this
machine alone (the stop=none paragraph below).
The lane's own close-out removes its worktree, so its idle lane closes
as finished work. If a later failed check reopens the item, its files stay,
and the host close passes no --merged, as for any item the tracker holds open.
A record keeps its cycle across a relaunch, and a lane relaunched for more
work on the item, or
one still inside its merge close-out, has its worktree standing, so that lane
refuses as lane-live state=idle. A local lane's worktree is read on this disk;
a hosted lane's .git through lane-host cat, as oversee-watch reads it before
its own close of a merged hosted lane, and a read that fails refuses as
worktree-read-failed.
A limit banner below the lane's last turn is passed over only where
`lanes pick --lane`, run under the record's host, so a hosted lane is read
through the provider's copy, reads the account the record names as room, for
the model the record names or over the whole account where it names none, and
the banner names no dated reset still ahead and no reset this host cannot
resolve; the lane is then judged by the rest of its screen. Every other
reading keeps the lane walled.
An idle lane's harness is ended by SIGTERM, never by typing into its pane:
through lane-host stop for a record carrying host, and for a local lane by the
same stop against the launch identity the record's launch names, the harness
pid and its start time open-terminal read once the launch was confirmed. A
record naming none, or naming a harness that has exited or whose pid a later
process holds, as for a harness restarted by hand in its pane, takes that
identity off the pane now, the harness process under the pane's own; with no
harness there either it refuses as stop-failed cause=identity-unread or
cause=identity-stale. No directory is read, so a lane whose worktree its own
close-out removed, or one recreated at the same path, stops all the same. The
close then waits up to ORCH_LANE_CLOSE_SECS (default 15) for the pane to read
exited.
A hosted stop answering status 4 beside a stop-worktree-removed item=ITEM line
on its stderr, from a provider that finds the harness by the item's worktree,
which its own close-out already removed, prints
stop-skipped cause=worktree-removed and goes straight to the host close and
window kill. The host close ends the harness where the provider's close ends
the sandbox; otherwise the window kill hangs up the lane's ssh session, which
ends it, as a static host's close ends no process.
Under --keep-sandbox, where no host close follows, that answer refuses as
stop-failed. A status 4 without that line, a provider's own answer such as a
sandbox it stopped, refuses as stop-failed cause=provider status=4.
The local stop signals nothing at a recorded pid that has exited or now
started at another time, a later process handed the same pid. The processes
it signals are the ones at or below the pid it stops by named for the
harness, and for copilot also MainThread, the name the Copilot CLI binary
carries on Linux.
A turn open-terminal --wake started runs outside the pane's process tree, so
the pane's stop never reaches it: a local close stops it by the identity the
record's wake names before the record reads done or stopped, every close of a
local lane, an exited one included, an idle one's in the same stop as its
harness, and refuses as stop-failed target=wake where it does not end. A wake identity whose process has exited or whose pid a later
process holds is a turn already over.
A record already marked stopped can close its kept sandbox without a pane.
On a full close of a terminal item it reads no mailbox: the item needs no
resumed session to answer an ask. Open items keep the ask check.
A full close of a record whose window no pane carries, on an item its
tracker answers terminal, closes with no lane state read and no exit wait: a
hosted harness is stopped through lane-host stop and the host closed, and a
local one by the launch identity the record names where that process still
runs; with no pane to read an identity off, a record naming none, or a stale
one, has no harness left to stop. A local record whose launch pane the tmux
server its launch recorded still lists refuses as pane-missing cause=renamed:
its window or session was renamed, or the window moved, and the lane may still
run there. A server started since and handed the recorded pid lists panes of
its own under the same ids, so confirm the pane is the lane's before restoring
the recorded window, and where it is not, clear the record's launch. One whose
recorded server runs a tmux this close does not reach, or whose pane list
cannot be read, refuses as pane-read-failed with server=.
A record whose host kind declares stop=none (lane-host capabilities), a Claude
cloud session, has no harness or sandbox this machine can stop: the close
removes the item's files as below, then kills the record's window where a
pane carries it, the session's local client, then removes its worktree on
this machine, the record's mail_root, through worktree remove, records it done and prints
host-kept kind=KIND session=ID, the session the operator archives from the
claude.ai sidebar. Where the record carries the directive_send lane-mail
wrote, one fleet-log close row names its result, the CLI's words and the
account credit read at the send; one that cannot be written refuses as
fleet-log-failed with the record done. --park refuses on its stop-sandbox --check read.
Before harness start, close stops the recorded preparation job and closes
its window. A saved selection continuation uses the started harness's close
checks. --keep-sandbox ends the harness, closes its window and
records stopped without closing the lane host.
A local lane's close also ends every validation run its worktree, the record's
mail_root, holds with no verdict, through dev-validate-run --stop; a hosted
lane's runs end with its sandbox. A close that is not --keep-sandbox, of an
item whose tracker answers terminal, removes the item's files from the state
directory through workflow-state remove before the host close, printing its
removed path= lines and its removed kept= line, which names the archive
workflow-state wrote of those files before removing them; a removal or an
archive that fails refuses as item-files-failed with the host, window and
record unchanged. An exited or stopped lane, or preparation before harness
start, reads its tracker for that alone: an item it holds open, or a read that does not
answer, keeps the files and prints item-files-kept with the cause, and the
close goes on.
That hosted close of a completed item passes --merged to lane-host close where
the item's pull request merged: the record carries the cycle oversee-cycle
writes at a merge, or worktree merged ITEM, asked from this checkout, exits 0.
Completed is a Linear state_type of completed, or a GitHub issue closed with
the reason COMPLETED. The flag lets the provider cut the item's archive to one
evidence file, or to none, so it is never passed for an item the tracker holds
open or canceled: a record keeps its cycle across a relaunch, and the lane's
later work may not have merged. A canceled item, a Linear state_type of
canceled or a GitHub issue closed with any other reason or none, still has its
files removed, and its host close keeps the whole archive.
worktree merged answers only where this checkout holds the item's branch; an
exit other than 0 or 1 prints merged-unjudged and the close goes on without the
flag, which keeps the whole archive.

--park --pr N parks a hosted lane's clean merge wait: the lane sits in its
queue wait doing nothing while its pull request N waits for the merge queue,
and the sandbox bills for it. The park is admitted by one reading, made before
anything is signalled and refused as park-refused with the condition it stopped
on: the record's lane host answers stop-sandbox --check --item ID with its
sandbox-stoppable line, so the sandbox it stops can be started again, which a
provider without the stop-sandbox and start pair, lane-host-ssh among them,
refuses with the absent-verb status 2; the pull request is open and is the
item's own branch; the merge queue holds it, read through gh api graphql as
isInMergeQueue or a mergeQueueEntry, or, outside the queue, auto-merge is
armed on it and it reads mergeStateStatus CLEAN, which is GitHub reporting
every required check green on the current head and nothing else blocking; and
it gets no attention line from the review-gate reducer pr-watch.sh, whose
silence means no open thread, no objection and no disarmed or stale-review
line; pr-watch.sh --help holds the exact condition. The silence is no proof of
approval, since an unapproved PR inside its quiet period is silent too: the
approval the base requires is proved by CLEAN for an armed PR, as GitHub reads
a missing required review as BLOCKED, and by the queue for a queued one.
A queued pull request is admitted on the queue's own judgement, since GitHub
admits nothing to the queue before every required check is green and every
required approval given on its head, and its arm has converted to the queue
entry by then, so autoMergeRequest is null for the whole wait; the merge state is read for the armed, unqueued case
alone. A lane still inside a CI or gate wait after a push is neither queued
nor CLEAN, or gets an attention line, and is never parked. The reducer is the
one OVERSEE_WATCH_PR_WATCH names, as it is for oversee-watch, and the
review-gate skill beside this one otherwise. Admitted, the park ends the
harness by signal as a close does,
whatever the lane is doing, waits for its pane to read exited, closes the
window, then stops the sandbox through lane-host stop-sandbox and requires its
sandbox-stopped item=ID line. The record then reads parked and carries
{pr, head, repo, at}, the pull request and head it was judged on. An open or
queued recorded pull request stays parked, whatever the tracker state. After
merge, oversee-watch records its cycle before closing a Canceled item or a
Done item whose Done-when boxes are all checked. An open item or a Done item
with an unchecked box gets parked-merged, and the overseer's relaunch
resumes the lane to finish its post-merge work. A stop the
provider refuses, or answers without that line, leaves the record stopped,
what --keep-sandbox leaves, and refuses as park-failed: the harness is gone
and the sandbox still up, which that status says. --park on a stopped record
judges the pull request again and stops the sandbox from the record alone; on
a parked record it changes nothing. A local record has no sandbox and refuses.
The record's worktree must stand: a removed-worktree answer to the stop
refuses as stop-failed, as it does under --keep-sandbox.

A parked record's full close runs the provider's close alone: the sandbox is
stopped, so its mailbox cannot be read, and no session has run in it since the
park read that mailbox, so no ask can have been added. --keep-sandbox on a
parked record changes nothing. open-terminal --relaunch on a parked record
starts the sandbox through lane-host start before its create --relaunch.

A lane holding an ask nobody has answered refuses as ask-unanswered, under
--keep-sandbox and on a stopped record alike: the answer would reach a session
this is about to end. An exited lane takes no such refusal, its session being
gone already. A kept sandbox can be relaunched into a session that reads the
reply, which is why the two differ: --keep-sandbox on an exited lane records
stopped and refuses nothing, and the full close of that stopped record refuses
until the ask is answered or the tracker item is terminal. A stopped record
on a terminal item takes no mailbox read on a full close. Other mailbox reads
that fail refuse as mail-read-failed.
A hosted mailbox that cannot be read, on a full close of an item the tracker
answers terminal, is weighed against lane-host list instead: where no row's
first field ends in /ITEM, in any case, the provider holds no sandbox for the
item, as its close --force leaves it, so no session holds an ask. The close
prints host-absent with mail-status=, lane-mail's exit, and closes the record
done with no provider stop or close, the item's files and window going as in
any full close. A list that fails or names the item keeps mail-read-failed.

The recorded window resolves in either form tmux accepts: a bare window name
on this server, or SESSION:WINDOW, whose session name must match exactly.

--terminal-state reads the tracker through the recorded identity. A parked
record with an open recorded pull request reads open. A parked or stopped
completed Linear item with an unchecked Done-when box also reads open.
It prints open, completed or canceled
and exits 0. A failed tracker, pull request or checklist read exits 2.
--if-terminal closes only if that judge answers terminal. An open item exits
4 with an item-open line and no changes. Neither option accepts --keep-sandbox
or --park.

--harness, --tracker and --repo supply a lane identity for a record written
before the launcher recorded one. Each fills only a field the record leaves
null or absent; the record wins where it carries a value, and an option that
contradicts one refuses as record-invalid. An exited lane closes without any
of them, but its files leave the state directory only where its tracker
answers, so a record carrying no tracker or repository takes --tracker or
--repo on that close; otherwise the files stay for as long as the prune holds
the item live.

A field neither the record nor an option carries is read from the lane where
the lane answers it: tracker from the item key, linear for a tracker
identifier, and harness from the pane's own foreground command. repo is read
from nothing, so a github lane whose record carries none still needs --repo. A
derived value never beats a recorded or a supplied one, and a pane running a
wrapper rather than the harness itself leaves harness underived.

An issue-N key derives nothing. It is what a github lane is keyed by and what
a linear lane is keyed by wherever GH_ISSUE_PATTERN accepts that spelling, so
a record under that key carrying no tracker refuses as key-ambiguous and takes
--tracker linear|github, plus --repo for a github lane. Where the key does
answer, --tracker only pins what it says; a value that disagrees with the key
reaches a tracker read that cannot answer, and refuses naming that cause. The
identity a caller still supplies is --tracker for an issue-N record that
carries none, --repo for a github lane and --harness for a lane whose pane
runs a wrapper.
EOF
}

need_value() {
  [[ $# -ge 2 && -n "${2:-}" ]] || { message missing-value "option=$1" >&2; exit 2; }
}

STATE_DIR=""
KEEP_SANDBOX=false
TERMINAL_MODE=close
PARK=false
PARK_PR=""
OPT_HARNESS=""
OPT_TRACKER=""
OPT_REPO=""
ITEM=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --state-dir) need_value "$@"; STATE_DIR="$2"; shift 2 ;;
    --state-dir=*) STATE_DIR="${1#--state-dir=}"; need_value --state-dir "$STATE_DIR"; shift ;;
    --harness) need_value "$@"; OPT_HARNESS="$2"; shift 2 ;;
    --harness=*) OPT_HARNESS="${1#--harness=}"; need_value --harness "$OPT_HARNESS"; shift ;;
    --tracker) need_value "$@"; OPT_TRACKER="$2"; shift 2 ;;
    --tracker=*) OPT_TRACKER="${1#--tracker=}"; need_value --tracker "$OPT_TRACKER"; shift ;;
    --repo) need_value "$@"; OPT_REPO="$2"; shift 2 ;;
    --repo=*) OPT_REPO="${1#--repo=}"; need_value --repo "$OPT_REPO"; shift ;;
    --keep-sandbox) KEEP_SANDBOX=true; shift ;;
    --terminal-state) TERMINAL_MODE=state; shift ;;
    --if-terminal) TERMINAL_MODE=if; shift ;;
    --park) PARK=true; shift ;;
    --pr) need_value "$@"; PARK_PR="$2"; shift 2 ;;
    --pr=*) PARK_PR="${1#--pr=}"; need_value --pr "$PARK_PR"; shift ;;
    --help|-h) usage; exit 0 ;;
    --*) message argument-count "value=$1" >&2; usage >&2; exit 2 ;;
    *)
      [[ -z "$ITEM" ]] || { message argument-count "count=2" >&2; usage >&2; exit 2; }
      ITEM="$1"
      shift ;;
  esac
done
[[ -n "$ITEM" ]] || { message argument-count "count=0" >&2; usage >&2; exit 2; }
# The two flags name two end states of one lane, so a call carrying both asks
# for neither; a park with no pull request has nothing to judge, and a pull
# request with no park is an option nothing reads.
if [[ "$PARK" == true && "$KEEP_SANDBOX" == true ]]; then
  message argument-count "value=--park" "conflict=--keep-sandbox" >&2; usage >&2; exit 2
fi
if [[ "$PARK" == true && -z "$PARK_PR" || "$PARK" == false && -n "$PARK_PR" ]]; then
  message missing-value "option=--park" "requires=--pr" >&2; usage >&2; exit 2
fi
[[ -z "$PARK_PR" || "$PARK_PR" =~ ^[1-9][0-9]*$ ]] || { message missing-value "option=--pr" "value=$PARK_PR" >&2; exit 2; }
if [[ "$TERMINAL_MODE" != close ]]; then
  [[ "$KEEP_SANDBOX" == false && "$PARK" == false ]] \
    || { message argument-count "value=terminal" "conflict=keep-or-park" >&2; exit 2; }
fi

STATE_ARGS=()
[[ -z "$STATE_DIR" ]] || STATE_ARGS=(--state-dir "$STATE_DIR")
command -v jq >/dev/null 2>&1 || { message record-invalid "item=$ITEM" "field=jq" >&2; exit 1; }
[[ -x "$WORKFLOW_STATE" ]] || { message record-invalid "item=$ITEM" "field=workflow-state" >&2; exit 1; }

records="$($WORKFLOW_STATE ${STATE_ARGS[@]+"${STATE_ARGS[@]}"} get oversee '.lanes // []')" \
  || { message record-missing "item=$ITEM" >&2; exit 1; }
if ! count="$(jq -r --arg item "$ITEM" '[.[] | select(.item == $item)] | length' <<<"$records")"; then
  message record-invalid "item=$ITEM" "field=record" >&2
  exit 1
fi
[[ "$count" == 1 ]] || { message record-missing "item=$ITEM" "count=$count" >&2; exit 1; }
record="$(jq -c --arg item "$ITEM" '.[] | select(.item == $item)' <<<"$records")" \
  || { message record-invalid "item=$ITEM" "field=record" >&2; exit 1; }

record_field() { jq -r --arg field "$1" '.[$field] // empty' <<<"$record"; }

# The lane identity this close-out needs, taken from the record and, where the
# record has none, from the launch options. A record the launcher wrote before
# it recorded tracker, repo and harness leaves those null, and its idle lane
# would otherwise have no close-out at all. The RECORD wins wherever it carries
# a value: an option that would repoint a recorded lane at another harness,
# tracker or repository refuses instead, because the operator supplying it and
# the record disagree about which lane this is.
resolve_identity() { # OUT_VAR FIELD RECORDED SUPPLIED
  local recorded="$3" supplied="$4"
  if [[ -n "$recorded" && -n "$supplied" && "$recorded" != "$supplied" ]]; then
    message record-invalid "item=$ITEM" "field=$2" "recorded=$recorded" "option=$supplied" >&2
    exit 1
  fi
  printf -v "$1" '%s' "${recorded:-$supplied}"
}

# What the lane itself answers for a field the record and the options both
# leave empty. It fills only an empty field, so the precedence above stands
# whole: recorded, then supplied, then this. A derivation that cannot answer
# leaves the field empty and its existing refusal reached.
#
# The outcome is published rather than returned: a refusal naming where a value
# came from reads it, and every other call site is a plain statement whose
# status errexit would act on.
DERIVE_IDENTITY_FILLED=0
derive_identity() { # OUT_VAR DERIVED
  DERIVE_IDENTITY_FILLED=0
  [[ -z "${!1}" ]] || return 0
  printf -v "$1" '%s' "$2"
  DERIVE_IDENTITY_FILLED=1
}

status="$(record_field status)"
prepare_step="$(jq -r '.prepare.step // empty' <<<"$record")"
window_name="$(record_field window)"
mail_root="$(record_field mail_root)"
host="$(record_field host)"
resolve_identity tracker tracker "$(record_field tracker)" "$OPT_TRACKER"
resolve_identity repo repo "$(record_field repo)" "$OPT_REPO"
resolve_identity harness harness "$(record_field harness)" "$OPT_HARNESS"
# The item key answers the tracker for one of its two shapes and not the other,
# by lib/lane-state.sh's rule; the repository stays --repo's alone.
derive_identity tracker "$(lane_key_tracker "$ITEM")"
tracker_source=given
[[ "$DERIVE_IDENTITY_FILLED" -eq 0 ]] || tracker_source=derived

case "$status" in
  done)
    if [[ "$TERMINAL_MODE" != state ]]; then
      message closed "item=$ITEM" "status=done"
      exit 0
    fi ;;
  running|stopped|preparing|parked) ;;
  *) message record-invalid "item=$ITEM" "field=status" >&2; exit 1 ;;
esac
[[ -n "$mail_root" ]] || { message record-invalid "item=$ITEM" "field=mail_root" >&2; exit 1; }

update_status() { # STATUS
  "$WORKFLOW_STATE" ${STATE_ARGS[@]+"${STATE_ARGS[@]}"} update oversee \
    --arg item "$ITEM" --arg status "$1" \
    'if any(.lanes[]; .item == $item) then (.lanes[] | select(.item == $item) | .status) = $status else error("lane record disappeared") end' \
    >/dev/null
}

# A lane that stops to ask the overseer something waits for the answer inside
# the session this close-out ends. Closing it takes the question with the
# session: the overseer answers into a mailbox nobody reads again, and the
# question the lane stopped to ask is never answered. The mailbox is the only
# record of that, so a read that fails refuses too — one this cannot read is
# not a lane with nothing to say.
refuse_unanswered_ask() {
  local out rc=0 summary ask_count ask_id epoch now age=unknown args
  [[ -x "$LANE_MAIL" ]] || { message record-invalid "item=$ITEM" "field=lane-mail" >&2; exit 1; }
  args=(pending --item "$ITEM" --root "$mail_root")
  [[ -z "$host" ]] || args+=(--host)
  out="$(ORCH_LANE_HOST="$host" "$LANE_MAIL" "${args[@]}")" || rc=$?
  [[ "$rc" -ne "$LANE_HOST_BUSY_EXIT" ]] \
    || { message lane-host-busy "item=$ITEM" step=mail-read >&2; exit "$rc"; }
  [[ "$rc" -eq 0 ]] || close_absent_record "$rc"
  [[ -n "$out" ]] || return 0
  # `pending` lists the lane's unread directives too, which the lane owes
  # nothing to the overseer for; only an ask is waiting on an answer.
  summary="$(jq -r -R -s 'split("\n") | map(fromjson? | objects | select(.kind == "ask")) | "\(length)\t\(.[0].id // "")"' <<<"$out")" \
    || { message mail-read-failed "item=$ITEM" "root=$mail_root" "status=parse" >&2; exit 1; }
  IFS=$'\t' read -r ask_count ask_id <<<"$summary"
  [[ "$ask_count" -gt 0 ]] || return 0
  # lane-mail mints an ask id as <epoch>-<pid>-<random>, so the oldest ask
  # carries the second it was asked and how long the lane has waited needs no
  # date parser here. An id outside that grammar still refuses, with the wait
  # unmeasured rather than guessed.
  epoch="${ask_id%%-*}"
  if [[ "$epoch" =~ ^[0-9]+$ ]] && now="$(date -u +%s)"; then age="$((now - epoch))s"; fi
  message ask-unanswered "item=$ITEM" "ask=$ask_id" "age=$age" "count=$ask_count" >&2
  exit 1
}

# A hosted mailbox read that fails on a full close of a terminal item, where
# the provider's own list names no sandbox for the item: one its close --force
# or a hand close removed. That item has no session an ask could reach, no
# harness to stop and nothing to close, yet a provider may refuse every item
# verb for it rather than answer the protocol's empty match, so the record
# closes alone. The list is read rather than the provider's words, and a row
# naming the item outside an available row, a list that fails, or any other
# close keeps the mail-read-failed refusal.
HOST_ABSENT=false
close_absent_record() { # MAIL_STATUS
  local listing rc=0 tracker_rc=0
  if [[ -n "$host" && "$KEEP_SANDBOX" == false && "$PARK" == false ]]; then
    [[ -x "$LANE_HOST" ]] || { message record-invalid "item=$ITEM" "field=lane-host" >&2; exit 1; }
    [[ -n "$ITEM_END" ]] || tracker_terminal || tracker_rc=$?
    if [[ "$tracker_rc" -eq 0 ]]; then
      listing="$(ORCH_LANE_HOST="$host" "$LANE_HOST" list)" || rc=$?
      [[ "$rc" -ne "$LANE_HOST_BUSY_EXIT" ]] || { message lane-host-busy "item=$ITEM" step=list >&2; exit "$rc"; }
      if [[ "$rc" -eq 0 ]] && ! awk -F'\t' -v item="/$(printf '%s' "$ITEM" | tr '[:upper:]' '[:lower:]')" '
          $2 == "available" { next }
          { name = tolower($1) }
          length(name) >= length(item) && substr(name, length(name) - length(item) + 1) == item { found = 1 }
          END { exit !found }' <<<"$listing"; then
        message host-absent "item=$ITEM" "host=$host" "mail-status=$1"
        HOST_ABSENT=true
        finish_close
      fi
    fi
  fi
  message mail-read-failed "item=$ITEM" "root=$mail_root" "status=$1" >&2
  exit 1
}

# Whether the record carries the cycle oversee-cycle writes at the merge of the
# item's pull request.
record_merged() { jq -e '.cycle.pr? | numbers' <<<"$record" >/dev/null 2>&1; }

# Whether the lane's worktree, the record's mail_root, is gone, which is what
# says a recorded merge was the lane's last work: the record keeps its cycle
# across a relaunch, and only the lane's own merge close-out
# (../workflows/merge-pr.md § 5) removes the worktree a relaunch recreates. A
# hosted one is read through the probe oversee-watch reads it by before its
# own close of a merged hosted lane (lib/lane-gitfile.sh lane_hosted_clone),
# whose 3, a .git naming no linked worktree, is still a worktree standing.
worktree_gone() {
  local scratch rc=0
  if [[ -z "$host" ]]; then
    [[ ! -e "$mail_root" && ! -L "$mail_root" ]]
    return
  fi
  [[ -x "$LANE_HOST" ]] || { message record-invalid "item=$ITEM" "field=lane-host" >&2; exit 1; }
  scratch="$(mktemp -d)" || { message worktree-read-failed "item=$ITEM" "root=$mail_root" "cause=scratch-unmade" >&2; exit 1; }
  ORCH_LANE_HOST="$host" lane_hosted_clone "$LANE_HOST" "$ITEM" "$mail_root" "$scratch/gitfile" "$scratch/err" || rc=$?
  [[ "$rc" -ne 2 && "$rc" -ne 4 ]] || cat -- "$scratch/err" >&2
  rm -rf -- "${scratch:?}"
  case "$rc" in
    0 | 3) return 1 ;;
    1) return 0 ;;
    4) message lane-host-busy "item=$ITEM" step=worktree-read >&2; exit "$LANE_HOST_BUSY_EXIT" ;;
    *) message worktree-read-failed "item=$ITEM" "root=$mail_root" "cause=read-failed" >&2; exit 1 ;;
  esac
}

# Whether the item's pull request merged, which a full close of a completed
# item tells the provider through close --merged. Two readings, in order: the
# record's cycle, which oversee-cycle writes at the merge and which is the
# usual evidence for a hosted lane, whose branch this checkout does not hold;
# then worktree merged, the one judge of a branch's merge, which proves it by
# the branch tip this checkout holds. Status 0 merged, 1 not shown merged.
# worktree merged's exit 1 is the ordinary answer and its record stays
# quiet; any other exit is a lookup that did not answer, whose words are
# relayed with the notice naming it.
item_merged() {
  local err rc=0
  record_merged && return 0
  [[ -x "$WORKTREE" ]] || { message merged-unjudged "item=$ITEM" "cause=worktree-missing"; return 1; }
  err="$(mktemp)" || { message merged-unjudged "item=$ITEM" "cause=stderr-unsaved"; return 1; }
  "$WORKTREE" merged "$ITEM" >/dev/null 2>"$err" || rc=$?
  [[ "$rc" -eq 0 || "$rc" -eq 1 ]] || cat -- "$err" >&2
  rm -f -- "${err:?}"
  case "$rc" in
    0) return 0 ;;
    1) return 1 ;;
    *) message merged-unjudged "item=$ITEM" "status=$rc"; return 1 ;;
  esac
}

close_host() {
  local rc=0 out err args=(close --item "$ITEM")
  [[ -n "$host" && "$HOST_ABSENT" == false ]] || return 0
  [[ -x "$LANE_HOST" ]] || { message record-invalid "item=$ITEM" "field=lane-host" >&2; return 1; }
  if [[ "$ITEM_END" == completed ]] && item_merged; then args+=(--merged); fi
  out="$(mktemp)" || return 1
  err="$(mktemp)" || { rm -f -- "$out"; return 1; }
  ORCH_LANE_HOST="$host" "$LANE_HOST" "${args[@]}" >"$out" 2>"$err" || rc=$?
  cat -- "$out"
  cat -- "$err" >&2
  # A host that no longer holds the item answers closed=absent and ran no
  # archive pass, so no kept=none follows it (lane-host.md `close`).
  if [[ "$rc" -eq 0 ]] && ! grep -q '^kept=' "$out" && ! grep -qxF "closed=absent item=$ITEM" "$out"; then printf 'kept=none\n'; fi
  [[ "$rc" -ne "$LANE_HOST_BUSY_EXIT" ]] || message lane-host-busy "item=$ITEM" step=close >&2
  rm -f -- "$out" "$err"
  return "$rc"
}

# One tracker CLI call, its own words kept for the refusal and dropped on
# success: a close that works stays quiet, and one that does not says what the
# CLI said rather than swallowing it. Status 0 with OUT_VAR set, or 1 with that
# stderr already relayed.
tracker_read() { # OUT_VAR COMMAND...
  local _tr_out _tr_err _tr_rc=0
  _tr_err="$(mktemp)" || return 1
  _tr_out="$("${@:2}" 2>"$_tr_err")" || _tr_rc=$?
  [[ "$_tr_rc" -eq 0 ]] || cat -- "$_tr_err" >&2
  rm -f -- "${_tr_err:?}"
  [[ "$_tr_rc" -eq 0 ]] || return 1
  printf -v "$1" '%s' "$_tr_out"
}

# Whether the work item is finished and, where that is not an answer, WHY. The
# several ways this read fails to answer are one status to the caller and
# distinct words to the operator, so the refusal names the cause rather than
# asserting one of them. TRACKER_CAUSE carries it on every status 2, and
# ITEM_END the terminal state on status 0.
TRACKER_CAUSE=""
ITEM_END=""
tracker_terminal() {
  local value number state reason pr_repo pr_number description checklist
  TRACKER_CAUSE=""
  if [[ "$status" == parked && "$TERMINAL_MODE" != close ]]; then
    # Tracker integration can close the item before its queued PR merges.
    pr_repo="$(jq -er '.parked.repo | strings | select(length > 0)' <<<"$record")" \
      || { TRACKER_CAUSE=parked-record-invalid; return 2; }
    pr_number="$(jq -er '.parked.pr | numbers | select(. > 0)' <<<"$record")" \
      || { TRACKER_CAUSE=parked-record-invalid; return 2; }
    tracker_read state env -u GH_REPO -u GITHUB_REPOSITORY gh pr view "$pr_number" --repo "$pr_repo" --json state --jq '.state' \
      || { TRACKER_CAUSE=pr-read-failed; return 2; }
    case "$state" in
      OPEN) return 1 ;;
      MERGED|CLOSED) ;;
      *) TRACKER_CAUSE=pr-state-invalid; return 2 ;;
    esac
  fi
  case "$tracker" in
    linear)
      [[ -x "$LINEAR" ]] || { TRACKER_CAUSE=cli-missing; return 2; }
      tracker_read value "$LINEAR" issues get "$ITEM" --format=safe \
        || { TRACKER_CAUSE=read-failed; return 2; }
      # Terminality is the stable state_type, never the display name: a team
      # renames Done or Canceled freely, and a renamed terminal state read by
      # name would hold a finished lane open. A payload carrying no state_type
      # answered nothing, so it reads as a failed tracker read, not as work
      # still running.
      state="$(jq -r '.state_type // empty' <<<"$value")" || { TRACKER_CAUSE=payload-unparsed; return 2; }
      [[ -n "$state" ]] || { TRACKER_CAUSE=no-state-type; return 2; }
      case "$state" in
        completed)
          if [[ "$TERMINAL_MODE" != close && ( "$status" == parked || "$status" == stopped ) ]]; then
            # GitHub integration marks Done at merge before lane close-out
            # ticks branch proof or schedules an open post-merge box.
            # open-terminal unpark writes stopped before create --relaunch;
            # a failed create must retain the same unfinished close-out.
            [[ -r "$SCRIPT_DIR/../../linear/scripts/lib/issue-validation.sh" ]] \
              || { TRACKER_CAUSE=checklist-missing; return 2; }
            # shellcheck source=../../../linear/scripts/lib/issue-validation.sh
            source "$SCRIPT_DIR/../../linear/scripts/lib/issue-validation.sh"
            description="$(jq -er '.description | strings | . + "."' <<<"$value")" \
              || { TRACKER_CAUSE=checklist-unparsed; return 2; }
            checklist="$(done_when_parse "${description%.}" '[]')" \
              || { TRACKER_CAUSE=checklist-unparsed; return 2; }
            jq -e 'all(.boxes[]; .checked)' <<<"$checklist" >/dev/null || return 1
          fi
          ITEM_END=completed ;;
        canceled) ITEM_END=canceled ;;
        *) return 1 ;;
      esac ;;
    github)
      # The key is read before the repository: an item whose key is not issue-N
      # carries no issue number at all, which no repository supplies.
      [[ "$ITEM" == issue-* ]] || { TRACKER_CAUSE=key-not-issue; return 2; }
      [[ -n "$repo" ]] || { TRACKER_CAUSE=repo-missing; return 2; }
      number="${ITEM#issue-}"
      tracker_read value gh issue view "$number" --repo "$repo" --json state,stateReason \
        --jq '.state + " " + (.stateReason // "")' \
        || { TRACKER_CAUSE=read-failed; return 2; }
      read -r state reason <<<"$value"
      [[ "$state" == CLOSED ]] || return 1
      # Only COMPLETED says the work shipped. NOT_PLANNED, DUPLICATE and an
      # issue closed before GitHub recorded a reason all end it unshipped.
      if [[ "$reason" == COMPLETED ]]; then ITEM_END=completed; else ITEM_END=canceled; fi ;;
    # An empty tracker under an issue-N key is the derivation declining, not an
    # unrecognised value: both trackers spell a key that way, so the caller is
    # asked which one rather than told the tracker is unknown.
    *)
      TRACKER_CAUSE=tracker-unknown
      [[ -n "$tracker" || "$ITEM" != issue-* ]] || TRACKER_CAUSE=key-ambiguous
      return 2 ;;
  esac
}

# The watch reads the same judge before offering a stopped record for close.
# The actual close checks again: the tracker can reopen the item between calls.
if [[ "$TERMINAL_MODE" != close ]]; then
  tracker_rc=0
  tracker_terminal || tracker_rc=$?
  case "$tracker_rc" in
    0) [[ "$TERMINAL_MODE" != state ]] || { printf '%s\n' "$ITEM_END"; exit 0; } ;;
    1)
      [[ "$TERMINAL_MODE" != state ]] || { printf 'open\n'; exit 0; }
      message item-open "item=$ITEM"
      exit 4 ;;
    *) message tracker-read-failed "item=$ITEM" "tracker=$tracker" "source=$tracker_source" "cause=$TRACKER_CAUSE" >&2; exit 2 ;;
  esac
fi

# The park guard: the one reading that admits a merge-wait park, made before
# anything is signalled. It delegates to the three judges that already own the
# questions: the provider, asked without effect whether it can stop a sandbox
# it will later be asked to start, which a provider without the pair refuses
# with the protocol's absent-verb status; GitHub's merge queue and auto-merge,
# which say whether anything will merge the pull request while the lane is
# away, the queue's own membership standing for every required check green
# since nothing enters it otherwise, and mergeStateStatus CLEAN saying the
# same for an armed pull request outside the queue, and both standing for the
# approval the base requires; and the review-gate reducer, whose silence means no open thread, no
# objection and no disarmed or stale-review line (pr-watch.sh --help holds the
# exact condition), never an approval. Nothing here counts a check or a thread
# itself. Each refusal names the
# condition it stopped on and changes nothing.
# PARK_HEAD and PARK_REPO carry what the record will hold.
PR_WATCH="${OVERSEE_WATCH_PR_WATCH:-$SCRIPT_DIR/../../review-gate/scripts/pr-watch.sh}"
PARK_QUEUE_QUERY='query($owner: String!, $repo: String!, $number: Int!) { repository(owner: $owner, name: $repo) { pullRequest(number: $number) { isInMergeQueue mergeQueueEntry { position } } } }'
# The queue answer as a word: a payload without the boolean is unparsed.
PARK_QUEUE_JQ='.data.repository.pullRequest | if (.isInMergeQueue | type) != "boolean" then error("queue-field field=isInMergeQueue") elif .isInMergeQueue or .mergeQueueEntry != null then "yes" else "no" end'
PARK_CHECK_LINE_RE='^sandbox-stoppable item=[^ ]+$'
PARK_HEAD=""
PARK_REPO=""
park_judge() {
  local err view fields pr_state pr_head pr_branch armed merge_state queue queued out rc=0 kinds
  [[ -n "$host" ]] || { message park-refused "item=$ITEM" "reason=local" >&2; exit 1; }
  [[ -x "$LANE_HOST" ]] || { message record-invalid "item=$ITEM" "field=lane-host" >&2; exit 1; }
  err="$(mktemp)" || { message park-refused "item=$ITEM" "reason=provider-unsupported" "cause=stderr-unsaved" >&2; exit 1; }
  out="$(ORCH_LANE_HOST="$host" "$LANE_HOST" stop-sandbox --check --item "$ITEM" 2>"$err")" || rc=$?
  [[ "$rc" -eq 0 ]] || cat -- "$err" >&2
  rm -f -- "${err:?}"
  [[ "$rc" -ne "$LANE_HOST_BUSY_EXIT" ]] || { message lane-host-busy "item=$ITEM" "pr=$PARK_PR" step=stop-sandbox-check >&2; exit "$rc"; }
  [[ "$rc" -eq 0 ]] || { message park-refused "item=$ITEM" "reason=provider-unsupported" "host=$host" "exit=$rc" >&2; exit 1; }
  [[ "$out" =~ $PARK_CHECK_LINE_RE && "$out" == *"item=$ITEM" ]] \
    || { message park-refused "item=$ITEM" "reason=provider-unsupported" "host=$host" "cause=answer-unparsed" >&2; exit 1; }
  PARK_REPO="$repo"
  if [[ -z "$PARK_REPO" ]]; then
    tracker_read PARK_REPO env -u GH_REPO -u GITHUB_REPOSITORY gh repo view --json nameWithOwner --jq .nameWithOwner \
      || { message park-refused "item=$ITEM" "reason=repo-unresolved" >&2; exit 1; }
  fi
  tracker_read view env -u GH_REPO -u GITHUB_REPOSITORY gh pr view "$PARK_PR" --repo "$PARK_REPO" \
      --json state,headRefOid,headRefName,autoMergeRequest,mergeStateStatus \
    || { message park-refused "item=$ITEM" "reason=pr-read-failed" "pr=$PARK_PR" "repo=$PARK_REPO" >&2; exit 1; }
  # One tab-separated line, the arm read as a word: a null autoMergeRequest is
  # a pull request nothing will merge unless the queue holds it.
  fields="$(jq -r '[.state, .headRefOid, .headRefName, (if .autoMergeRequest == null then "no" else "yes" end), .mergeStateStatus] | @tsv' <<<"$view" 2>/dev/null)" \
    || { message park-refused "item=$ITEM" "reason=pr-read-failed" "pr=$PARK_PR" "cause=payload-unparsed" >&2; exit 1; }
  IFS=$'\t' read -r pr_state pr_head pr_branch armed merge_state <<<"$fields"
  [[ "$(printf '%s' "$pr_branch" | tr '[:upper:]' '[:lower:]')" == "$(printf '%s' "$ITEM" | tr '[:upper:]' '[:lower:]')" ]] \
    || { message park-refused "item=$ITEM" "reason=pr-branch-mismatch" "pr=$PARK_PR" "branch=$pr_branch" >&2; exit 1; }
  [[ "$pr_state" == OPEN ]] || { message park-refused "item=$ITEM" "reason=pr-not-open" "pr=$PARK_PR" "state=$pr_state" >&2; exit 1; }
  # Queue membership is GraphQL's alone: gh pr view exposes no field for it,
  # and on a queue base the arm converts to the entry once the checks are
  # green, so the entry is the wait's whole evidence.
  tracker_read queue env -u GH_REPO -u GITHUB_REPOSITORY gh api graphql -f query="$PARK_QUEUE_QUERY" \
      -F owner="${PARK_REPO%%/*}" -F repo="${PARK_REPO#*/}" -F number="$PARK_PR" \
    || { message park-refused "item=$ITEM" "reason=queue-read-failed" "pr=$PARK_PR" "repo=$PARK_REPO" >&2; exit 1; }
  if ! queued="$(jq -r "$PARK_QUEUE_JQ" <<<"$queue" 2>/dev/null)"; then
    message park-refused "item=$ITEM" "reason=queue-read-failed" "pr=$PARK_PR" "cause=payload-unparsed" >&2; exit 1
  fi
  if [[ "$queued" == no ]]; then
    [[ "$armed" == yes ]] || { message park-refused "item=$ITEM" "reason=not-armed" "pr=$PARK_PR" "head=$pr_head" >&2; exit 1; }
    [[ "$merge_state" == CLEAN ]] || { message park-refused "item=$ITEM" "reason=merge-state" "pr=$PARK_PR" "state=$merge_state" >&2; exit 1; }
  fi
  [[ -x "$PR_WATCH" ]] || { message park-refused "item=$ITEM" "reason=reducer-missing" "path=$PR_WATCH" >&2; exit 1; }
  err="$(mktemp)" || { message park-refused "item=$ITEM" "reason=reducer-failed" "cause=stderr-unsaved" >&2; exit 1; }
  out="$(GH_REPO="$PARK_REPO" "$PR_WATCH" "$PARK_PR" 2>"$err")" || rc=$?
  [[ "$rc" -eq 0 ]] || cat -- "$err" >&2
  rm -f -- "${err:?}"
  case "$rc" in
    0) ;;
    1)
      # The reducer's lines are pr, head, kind, detail; the kinds for this
      # pull request are the refusal's reading.
      kinds="$(awk -F'\t' -v pr="$PARK_PR" '$1 == pr { printf "%s%s", sep, $3; sep = "," }' <<<"$out")"
      message park-refused "item=$ITEM" "reason=attention" "pr=$PARK_PR" "kinds=${kinds:-unlisted}" >&2
      exit 1 ;;
    *) message park-refused "item=$ITEM" "reason=reducer-failed" "pr=$PARK_PR" "exit=$rc" >&2; exit 1 ;;
  esac
  PARK_HEAD="$pr_head"
}

# The sandbox stop and the record it earns, from a lane whose harness is gone
# and whose window is closed: the state a stopped record already names. So a
# stop that fails, or answers without the protocol's line, records stopped,
# which is true, and refuses; only the confirmed line records parked.
PARK_LINE_RE='^sandbox-stopped item=[^ ]+$'
park_sandbox() {
  local out err rc=0 at fields=("item=$ITEM" "pr=$PARK_PR")
  err="$(mktemp)" || { message park-failed "${fields[@]}" "cause=stderr-unsaved" >&2; exit 1; }
  out="$(ORCH_LANE_HOST="$host" "$LANE_HOST" stop-sandbox --item "$ITEM" 2>"$err")" || rc=$?
  cat -- "$err" >&2
  rm -f -- "${err:?}"
  if [[ "$rc" -ne 0 || ! "$out" =~ $PARK_LINE_RE || "$out" != *"item=$ITEM" ]]; then
    [[ "$status" == stopped ]] || update_status stopped \
      || { message state-write-failed "item=$ITEM" "status=stopped" >&2; exit 1; }
    [[ "$rc" -ne "$LANE_HOST_BUSY_EXIT" ]] || { message lane-host-busy "${fields[@]}" step=stop-sandbox >&2; exit "$rc"; }
    if [[ "$rc" -ne 0 ]]; then message park-failed "${fields[@]}" "cause=provider" "status=$rc" >&2
    else message park-failed "${fields[@]}" "cause=answer-unparsed" >&2; fi
    exit 1
  fi
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  "$WORKFLOW_STATE" ${STATE_ARGS[@]+"${STATE_ARGS[@]}"} update oversee \
    --arg item "$ITEM" --arg pr "$PARK_PR" --arg head "$PARK_HEAD" --arg repo "$PARK_REPO" --arg at "$at" \
    'if any(.lanes[]; .item == $item) then (.lanes[] | select(.item == $item)) |= (.status = "parked" | .parked = {pr: ($pr | tonumber), head: $head, repo: $repo, at: $at}) else error("lane record disappeared") end' \
    >/dev/null || { message state-write-failed "item=$ITEM" "status=parked" >&2; exit 1; }
  message parked "${fields[@]}" "head=$PARK_HEAD" "status=parked"
  exit 0
}

# A validation the lane started goes on after its session ends, and nothing
# would ever read its verdict. A local lane's mail_root is its worktree, as
# open-terminal records it; one that is no directory on this disk holds no run
# this could stop.
stop_validations() {
  local rc=0
  [[ -d "$mail_root" ]] || return 0
  [[ -x "$DEV_VALIDATE_RUN" ]] || { message helper-missing "item=$ITEM" "path=$DEV_VALIDATE_RUN" >&2; exit 1; }
  "$DEV_VALIDATE_RUN" --stop --worktree "$mail_root" >/dev/null || rc=$?
  [[ "$rc" -eq 0 ]] \
    || { message validate-stop-failed "item=$ITEM" "worktree=$mail_root" "status=$rc" >&2; exit 1; }
}

# The item's close-out under tmp/: every file the state directory holds named
# for it, through workflow-state remove, the one owner of that removal and of
# the archive it writes of those files first. Only a
# full close of a finished item reaches it, one whose tracker answers terminal,
# whether the idle check already read it or the read happens here: a lane
# closed before its work ended, or under a --keep-sandbox close, is relaunched
# into those files, so they stay and the line saying so names why. It runs
# before the host close, so a close that fails before the host close retries
# whole, the removal included, which an idempotent remove allows. A host close
# repeated after one that succeeded meets a host answering closed=absent.
# ITEM_END is the terminal state the tracker answered, empty until a read
# answers terminal: completed for shipped work, canceled for any other end.
# Both remove the files; only completed lets the host close pass --merged.
remove_item_files() {
  local rc=0
  if [[ -z "$ITEM_END" ]]; then
    tracker_terminal || rc=$?
    case "$rc" in
      0) ;;
      1) message item-files-kept "item=$ITEM" "cause=open"; return 0 ;;
      *) message item-files-kept "item=$ITEM" "cause=$TRACKER_CAUSE"; return 0 ;;
    esac
  fi
  "$WORKFLOW_STATE" ${STATE_ARGS[@]+"${STATE_ARGS[@]}"} remove "$ITEM" || rc=$?
  [[ "$rc" -eq 0 ]] || { message item-files-failed "item=$ITEM" "status=$rc" >&2; exit 1; }
}

pane_still_exists() {
  local listed
  listed="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null)" || return 2
  awk -v pane="$pane_id" '$0 == pane { found=1 } END { exit !found }' <<<"$listed"
}

# A record's identity FIELD, launch or wake, as pid and start into RECORD_PID
# and RECORD_START, each empty where the record names none.
RECORD_PID=""
RECORD_START=""
record_identity() { # FIELD
  RECORD_PID="$(jq -r --arg f "$1" '.[$f].pid // empty' <<<"$record")" \
    && RECORD_START="$(jq -r --arg f "$1" '.[$f].start // empty' <<<"$record")" \
    || { message record-invalid "item=$ITEM" "field=$1" >&2; exit 1; }
}
# STOP_IDENTITY is the identity a local stop signalled by, which the exit wait
# names where the pane outlives it; empty for a hosted lane and for a local
# lane whose harness stop did not run.
STOP_IDENTITY=""
# The turn a wake started, for a local lane whose harness stop did not run:
# an idle lane's stop ends it with the harness (lib/lane-state.sh
# lane_stop_local), and an exited lane's harness is already gone.
stop_wake() {
  local fields=("item=$ITEM" "harness=$harness" "target=wake")
  record_identity wake
  [[ -n "$RECORD_PID$RECORD_START" ]] || return 0
  case "$harness" in
    claude|codex|pi|copilot) ;;
    *) message harness-unsupported "item=$ITEM" "harness=${harness:-unknown}" >&2; exit 1 ;;
  esac
  if ! lane_stop_wake "$RECORD_PID" "$RECORD_START" "$harness"; then
    [[ -z "$LANE_STOP_PID" ]] || fields+=("pid=$LANE_STOP_PID")
    message stop-failed "${fields[@]}" "cause=$LANE_STOP_CAUSE" >&2
    exit 1
  fi
}

# The end of every close-out: a local lane's wake and validations ended, the item's
# files removed and the host closed unless --keep-sandbox, the window closed where
# pane_id names one tmux still lists, then the record and the line naming the
# outcome, pane= carried where the close had a pane.
pane_id=""
finish_close() {
  local next_status=done pane_rc=0 fields=("item=$ITEM")
  [[ -n "$host" ]] || { [[ -n "$STOP_IDENTITY" ]] || stop_wake; stop_validations; }
  if [[ "$KEEP_SANDBOX" == true ]]; then next_status=stopped; else remove_item_files; close_host || exit $?; fi
  if [[ -n "$pane_id" ]]; then
    pane_still_exists || pane_rc=$?
    case "$pane_rc" in
      0) tmux kill-window -t "$pane_id" \
           || { message tmux-failed "item=$ITEM" "operation=kill-window" "pane=$pane_id" >&2; exit 1; } ;;
      1) ;;
      *) message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1 ;;
    esac
    fields+=("pane=$pane_id")
  fi
  update_status "$next_status" \
    || { message state-write-failed "item=$ITEM" "status=$next_status" >&2; exit 1; }
  if [[ "$next_status" == stopped ]]; then message stopped "${fields[@]}" "status=stopped"
  else message closed "${fields[@]}" "status=done"; fi
  exit 0
}

# The recorded window resolves through the shared owner, which accepts the
# bare and SESSION:WINDOW forms alike and reports which silence it met. A read
# that fails and a name two panes carry refuse; RESOLVED_PANE is the one pane,
# empty where no pane carries the name.
RESOLVED_PANE=""
resolve_window() {
  local rc=0
  lane_pane_resolve "$window_name" || rc=$?
  [[ "$rc" -ne 2 ]] \
    || { message pane-read-failed "item=$ITEM" "window=$window_name" >&2; exit 1; }
  case "$LANE_PANE_COUNT" in
    0) ;;
    1) RESOLVED_PANE="$LANE_PANE_ID" ;;
    *) message pane-ambiguous "item=$ITEM" "window=$window_name" "count=$LANE_PANE_COUNT" >&2; exit 1 ;;
  esac
}

# A window name no pane carries does not prove the pane gone: pi-qol renames a
# Pi lane's window to its session name, and an operator may rename one by hand.
# Where the tmux server the launch recorded still lists the record's launch
# pane, the lane may run there unread, so the close refuses. Records keep no
# server start, so that pane is never adopted for the state read and the stop:
# a later server handed the same pid and pane id would have its own harness
# stopped as the lane's.
refuse_listed_launch_pane() {
  local pane server rc=0
  pane="$(jq -r '.launch.pane // empty' <<<"$record")" \
    && server="$(jq -r '.launch.server // empty' <<<"$record")" \
    || { message record-invalid "item=$ITEM" "field=launch" >&2; exit 1; }
  [[ -n "$pane" && -n "$server" ]] || return 0
  tmux_pane_live "$server" "" "$pane" || rc=$?
  case "$rc" in
    0) message pane-missing "item=$ITEM" "window=$window_name" "pane=$pane" "cause=renamed" >&2; exit 1 ;;
    1) ;;
    *) message pane-read-failed "item=$ITEM" "pane=$pane" "server=$server" >&2; exit 1 ;;
  esac
}

# A cloud lane closed after a directive carries that send's cause readings,
# the record's directive_send lane-mail wrote, into one fleet-log close row,
# so the relaunch decision names them: the send's result and the CLI's words,
# and the account's cloud credit at the send. A record with none logs nothing.
# The record already reads done and keeps directive_send, so a row that cannot
# be written refuses as fleet-log-failed with nothing else to undo.
log_send_cause() {
  local row file
  row="$(jq -c --arg item "$ITEM" '.directive_send | objects
    | {kind: "close", item: $item, text: ("cloud lane closed; its last directive send=\(.result) "
        + (.credit | if type == "object" then "credit=\(.remaining_dollars // "none") locked=\(.locked_reason // "none")" else "credit=unread" end)
        + " cli=\(.text | gsub("\\s+"; " ") | .[0:300])")}' <<<"$record")" \
    || { message record-invalid "item=$ITEM" "field=directive_send" >&2; exit 1; }
  [[ -n "$row" ]] || return 0
  file="$(mktemp)" || { message fleet-log-failed "item=$ITEM" "cause=scratch-unmade" >&2; exit 1; }
  printf '%s\n' "$row" > "$file"
  "$WORKFLOW_STATE" ${STATE_ARGS[@]+"${STATE_ARGS[@]}"} append-file oversee fleet_log "$file" >/dev/null \
    || { rm -f -- "$file"; message fleet-log-failed "item=$ITEM" "cause=append" >&2; exit 1; }
  rm -f -- "$file"
}

# The record's host kind declares whether this machine can stop its lane. A
# stop=none kind, a Claude cloud session, has no harness or sandbox to reach
# and no mailbox to ask: the close removes the item's files, then closes the
# window its launch opened, where a pane still carries it, which ends the
# session's local client and retires its lane claim, then removes its
# worktree on this machine and closes the record, and the session stays the
# operator's to archive. The window outlives a removal that refuses, as
# item-files-failed says. A park keeps its stop-sandbox --check read, which
# the kind refuses.
lane_capabilities_read "$LANE_HOST" "${host:-local}" || { message host-capabilities-unread "item=$ITEM" "host=${host:-local}" >&2; exit 1; }
lane_capability host_stop stop
case "$host_stop" in
  window | verb) ;;
  none)
    [[ "$PARK" != true ]] || park_judge
    [[ -z "$window_name" ]] || resolve_window
    remove_item_files
    if [[ -n "$RESOLVED_PANE" ]]; then
      tmux kill-window -t "$RESOLVED_PANE" \
        || { message tmux-failed "item=$ITEM" "operation=kill-window" "pane=$RESOLVED_PANE" >&2; exit 1; }
    fi
    [[ -x "$WORKTREE" ]] || { message helper-missing "item=$ITEM" "path=$WORKTREE" >&2; exit 1; }
    "$WORKTREE" remove "$mail_root" >&2 || { message worktree-remove-failed "item=$ITEM" "path=$mail_root" >&2; exit 1; }
    update_status done || { message state-write-failed "item=$ITEM" "status=done" >&2; exit 1; }
    log_send_cause
    lane_capability host_kind kind
    message host-kept "kind=$host_kind" "session=$(record_field session_id)"
    exit 0 ;;
  *) message host-capabilities-unread "item=$ITEM" "host=${host:-local}" "stop=$host_stop" >&2; exit 1 ;;
esac

# A stopped record means an earlier --keep-sandbox call already exited the
# harness and removed its window. Only the kept sandbox and the record remain.
if [[ "$status" == stopped ]]; then
  # Only an open item still needs the session that can answer its ask.
  tracker_rc=1
  if [[ "$KEEP_SANDBOX" == false && "$PARK" == false ]]; then
    tracker_rc=0
    [[ -n "$ITEM_END" ]] || tracker_terminal || tracker_rc=$?
  fi
  [[ "$tracker_rc" -eq 0 ]] || refuse_unanswered_ask
  if [[ "$PARK" == true ]]; then
    park_judge
    park_sandbox
  fi
  if [[ "$KEEP_SANDBOX" == true ]]; then
    message stopped "item=$ITEM" "status=stopped"
    exit 0
  fi
  finish_close
fi

# A parked record's sandbox is stopped, so its mailbox cannot be read, and no
# session has run in it since the park read that mailbox: the ask check was
# made then. The provider's close completes on a stopped sandbox by protocol.
if [[ "$status" == parked ]]; then
  if [[ "$PARK" == true || "$KEEP_SANDBOX" == true ]]; then
    message parked "item=$ITEM" "pr=$(jq -r '.parked.pr // empty' <<<"$record")" "head=$(jq -r '.parked.head // empty' <<<"$record")" "status=parked"
    exit 0
  fi
  finish_close
fi

# The selection continuation keeps the started harness's pane, so its close
# must reach the same checks and stop as a running record. Earlier steps may
# have no mailbox yet. Stop only a recorded job still running open-terminal.
if [[ "$status" == preparing && "$prepare_step" != selection ]]; then
  [[ "$PARK" == false ]] || { message record-invalid "item=$ITEM" "field=status" "value=preparing" >&2; exit 1; }
  [[ -z "$window_name" ]] || resolve_window
  job="$(jq -r '.prepare.pid // empty' <<<"$record")"
  if [[ "$job" =~ ^[1-9][0-9]*$ ]] && job_cmd="$(ps -o command= -p "$job")" && [[ "$job_cmd" == *open-terminal* ]]; then
    kill -TERM -- "-$job" || { message prepare-stop-failed "item=$ITEM" "pid=$job" >&2; exit 1; }
  fi
  pane_id="$RESOLVED_PANE"
  finish_close
fi

[[ -n "$window_name" ]] || { message record-invalid "item=$ITEM" "field=window" >&2; exit 1; }

resolve_window
pane_id="$LANE_PANE_ID"
pane_pid="$LANE_PANE_PID"
pane_cmd="$LANE_PANE_CMD"
# The harness is the pane's own foreground command wherever the pane runs it
# directly. A lane started by typing a wrapper at an interactive prompt keeps
# that shell as the pane process and the harness as its child, so this answers
# for the direct launches and leaves the rest to --harness.
case "$pane_cmd" in
  claude|codex|pi|copilot) derive_identity harness "$pane_cmd" ;;
esac
if [[ -n "$pane_id" ]]; then
  pane_screen="$(tmux capture-pane -pJ -t "$pane_id" 2>/dev/null)" \
    || { message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1; }
  lane_state state listed "$pane_cmd" "$pane_pid" "$pane_screen" \
    || { message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1; }
else
  # A window gone with its work finished, a tmux restart or a reboot among the
  # causes, closes all the same: a hosted lane through its provider, a local
  # one by its record's launch identity alone, no pane being left to read one
  # off. A park or a kept sandbox is a lane still wanted, and reads as open.
  tracker_rc=0; [[ "$PARK" == false && "$KEEP_SANDBOX" == false ]] && tracker_terminal || tracker_rc=$?
  case "$tracker_rc" in
    0) [[ -n "$host" ]] || refuse_listed_launch_pane; state=windowless ;;
    1) message pane-missing "item=$ITEM" "window=$window_name" >&2; exit 1 ;;
    *) message tracker-read-failed "item=$ITEM" "tracker=$tracker" "source=$tracker_source" "cause=$TRACKER_CAUSE" >&2; exit 1 ;;
  esac
fi

# usage-reset.sh's one import: a reset clause the banner scan could not read.
die() { message pane-read-failed "item=$ITEM" "pane=$pane_id" "cause=$1" >&2; exit 1; }

# A limit banner stays on a lane's screen after the window it reports resets,
# since the lane it parked takes no turn to scroll it away. So a `walled`
# screen is weighed against the account the record names, and it stops
# answering only where that account reads room and the banner names no reset
# still ahead. WALL_ACCOUNT is the lane-live message's account= word, and
# WALL_RESETS a dated reset the banner names still ahead, or `unresolved` for a
# reset clause that resolved to no time, empty otherwise. A clock or weekday
# reset names no day, and with no sighting to pin one to it leaves the account
# reading to answer alone.
WALL_ACCOUNT=none
WALL_RESETS=""
read_wall() {
  local rc=0 account model model_args=() slice banner key at now clause_rc=0
  if ! account="$(record_field account)"; then message record-invalid "item=$ITEM" "field=account" >&2; exit 1; fi
  if ! model="$(record_field model)"; then message record-invalid "item=$ITEM" "field=model" >&2; exit 1; fi
  case "$harness" in claude|codex) ;; *) return 0 ;; esac
  [[ -n "$account" ]] || return 0
  [[ -x "$LANES" ]] || { message helper-missing "item=$ITEM" "path=$LANES" >&2; exit 1; }
  # The model the launch gate judged this account on, so close reads the wall
  # launch read. A record naming none, open-terminal's launch whose --cmd names
  # no model, is read over the whole account: that binding bucket is the widest
  # reading, so it lifts no wall the model's own would keep.
  [[ -z "$model" ]] || model_args=(--model "$model")
  # Under the record's own host, empty for a local lane, so a hosted lane's
  # account is read through the copy it runs on, as open-terminal judged it.
  ORCH_LANE_HOST="$host" "$LANES" pick --lane "$account" --harness "$harness" ${model_args[@]+"${model_args[@]}"} >/dev/null || rc=$?
  case "$rc" in
    0) WALL_ACCOUNT=room ;;
    3) WALL_ACCOUNT=walled ;;
    4) WALL_ACCOUNT=unlisted ;;
    5) WALL_ACCOUNT=unmeasured ;;
    *) WALL_ACCOUNT=read-failed ;;
  esac
  [[ "$WALL_ACCOUNT" == room ]] || return 0
  # The reset is read from the banner because no record carries it: the lanes
  # usage record holds resets only for the windows it measures, so a wall
  # outside them is known from the banner alone.
  slice="$(pane_below_last_turn "$pane_screen")" \
    || { message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1; }
  banner="$(lane_limit_banner "$slice")" \
    || { message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1; }
  # die has already named the failed scan when this substitution fails.
  key="$(usage_reset_key "$banner")" || exit 1
  # No key is either a banner naming no reset, which the account answers
  # alone, or a clause the grammar matched and could not key, such as a zone
  # this host has no zoneinfo for, which keeps the wall.
  if [[ -z "$key" ]]; then
    grep -Eq -- "$USAGE_RESET_ANY_RE" <<<"$banner" || clause_rc=$?
    case "$clause_rc" in
      0) WALL_RESETS=unresolved ;;
      1) ;;
      *) message pane-read-failed "item=$ITEM" "pane=$pane_id" "cause=reset" >&2; exit 1 ;;
    esac
    return 0
  fi
  [[ "$key" == dated'|'* ]] || return 0
  now="$(date -u +%s)" || { message pane-read-failed "item=$ITEM" "pane=$pane_id" "cause=clock" >&2; exit 1; }
  # A dated clause date rejects, `resets Feb 30, 4pm` among them, resolves to
  # no time, which is no evidence the reset is behind.
  if ! at="$(usage_reset_epoch "$key" "$now")" || [[ -z "$at" ]]; then
    WALL_RESETS=unresolved
    return 0
  fi
  [[ "$at" -gt "$now" ]] || return 0
  WALL_RESETS="$(from_epoch "$at" '%Y-%m-%dT%H:%M:%SZ')" || WALL_RESETS="$at"
}
# A park is admitted by the pull request alone, whatever the lane is doing: the
# lane it ends is one sitting in its queue wait, which reads as working, and
# its tracker item is open until the merge. Every other close keeps the guard.
if [[ "$PARK" == true ]]; then
  park_judge
else
if [[ "$state" == walled ]]; then
  read_wall
  if [[ "$WALL_ACCOUNT" == room && -z "$WALL_RESETS" ]]; then
    lane_state state listed "$pane_cmd" "$pane_pid" "$pane_screen" "" room \
      || { message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1; }
  fi
fi

case "$state" in
  exited | windowless) ;;
  idle)
    tracker_rc=0
    tracker_terminal || tracker_rc=$?
    case "$tracker_rc" in
      0) ;;
      # The overseer's record of the merge, with the worktree the lane's
      # close-out removes gone, says the lane's work is done: an item held
      # open for a box the overseer checks itself leaves the lane idle on
      # nothing, a hosted one's sandbox billing until the box is checked.
      1) { record_merged && worktree_gone; } || { message lane-live "item=$ITEM" "state=idle" "pane=$pane_id" >&2; exit 1; } ;;
      *) message tracker-read-failed "item=$ITEM" "tracker=$tracker" "source=$tracker_source" "cause=$TRACKER_CAUSE" >&2; exit 1 ;;
    esac ;;
  walled)
    message lane-live "item=$ITEM" "state=walled" "pane=$pane_id" "account=$WALL_ACCOUNT" ${WALL_RESETS:+"resets=$WALL_RESETS"} >&2
    exit 1 ;;
  *) message lane-live "item=$ITEM" "state=$state" "pane=$pane_id" >&2; exit 1 ;;
esac
fi

pane_now_exited() {
  local screen current_state rc=0
  lane_pane_by_id "$pane_id" || rc=$?
  case "$rc" in
    0) ;;
    1) return 0 ;;
    *) return 2 ;;
  esac
  screen="$(tmux capture-pane -pJ -t "$pane_id" 2>/dev/null)" || return 2
  lane_state current_state listed "$LANE_PANE_CMD" "$LANE_PANE_PID" "$screen" || return 2
  [[ "$current_state" == exited ]]
}

# The harness is ended by signal to its own process, never by keystrokes into
# its pane. A hosted lane is signalled by its provider, which alone reaches the
# host's process table; a local lane by the same library stop against the
# launch identity its record names, or one read off its pane where it names
# none or a stale one, then the turn its record's wake names (lib/lane-state.sh
# lane_stop_local). STOPPED_COUNT is how
# many processes the stop signalled, which the exit wait below names where the
# pane outlives it.
STOPPED_COUNT=""
STOP_SKIPPED=false
STOP_WORKTREE_REMOVED=4
STOP_LINE_RE='^stopped item=[^ ]+ processes=([0-9]+)$'
# Whether the stop's stderr holds the removed-worktree line for this item. A
# provider may answer 4 on any verb for a state of its own, a sandbox it
# stopped among them, so the status alone does not say the worktree is gone.
stop_answered_worktree_removed() { # STDERR_FILE
  awk -v item="item=$ITEM" '
    { for (i = 1; i < NF; i++) if ($i == "stop-worktree-removed" && $(i + 1) == item) found = 1 }
    END { exit !found }' "$1"
}
stop_harness() {
  local out err rc=0 removed=false wake_pid wake_start fields=("item=$ITEM" "harness=$harness")
  if [[ -n "$host" ]]; then
    [[ -x "$LANE_HOST" ]] || { message record-invalid "item=$ITEM" "field=lane-host" >&2; exit 1; }
    err="$(mktemp)" || { message stop-failed "${fields[@]}" "cause=stderr-unsaved" >&2; exit 1; }
    out="$(ORCH_LANE_HOST="$host" "$LANE_HOST" stop --item "$ITEM" --harness "$harness" 2>"$err")" || rc=$?
    cat -- "$err" >&2
    if [[ "$rc" -eq "$STOP_WORKTREE_REMOVED" ]] && stop_answered_worktree_removed "$err"; then removed=true; fi
    rm -f -- "$err"
    [[ "$rc" -ne "$LANE_HOST_BUSY_EXIT" ]] || { message lane-host-busy "${fields[@]}" step=stop >&2; exit "$rc"; }
    # A merged lane's own close-out removes its worktree before the lane goes
    # idle, so a provider that finds the harness by that directory has nothing
    # to find it by; lane-host-ssh stops by launch identity instead. Only an
    # idle lane on a terminal item, or with a merged cycle and its worktree
    # gone, or the windowless close of a hosted record on a terminal item,
    # reaches this stop, and what follows ends the
    # harness, so the stop is skipped rather than refused: the host close where
    # the provider's close ends the sandbox, otherwise the window kill, which
    # hangs up the lane's ssh session, as a static host's close ends no
    # process. Under --keep-sandbox no host close follows.
    if [[ "$removed" == true && "$KEEP_SANDBOX" == false && "$PARK" == false ]]; then
      message stop-skipped "${fields[@]}" "cause=worktree-removed"
      STOP_SKIPPED=true
      return 0
    fi
    [[ "$rc" -eq 0 ]] || { message stop-failed "${fields[@]}" "cause=provider" "status=$rc" >&2; exit 1; }
    if [[ "$out" =~ $STOP_LINE_RE ]]; then
      STOPPED_COUNT="${BASH_REMATCH[1]}"
    else
      message stop-failed "${fields[@]}" "cause=answer-unparsed" >&2
      exit 1
    fi
  else
    record_identity wake
    wake_pid="$RECORD_PID" wake_start="$RECORD_START"
    record_identity launch
    if ! lane_stop_local "$pane_pid" "$RECORD_PID" "$RECORD_START" "$wake_pid" "$wake_start" "$harness"; then
      [[ "$LANE_STOP_TARGET" != wake ]] || fields+=("target=wake")
      [[ -z "$LANE_STOP_PID" ]] || fields+=("pid=$LANE_STOP_PID")
      message stop-failed "${fields[@]}" "cause=$LANE_STOP_CAUSE" >&2
      exit 1
    fi
    STOPPED_COUNT="$LANE_STOP_COUNT"
    STOP_IDENTITY="$LANE_STOP_IDENTITY"
  fi
}

# End the harness by signal and wait for its pane to read exited, for an idle
# lane's close and for a park alike; a park's lane is working, and the
# signal is the same. A skipped stop, or no pane to wait on, ends the close-out.
stop_and_await_exit() {
  case "$harness" in
    claude|codex|pi|copilot) ;;
    *) message harness-unsupported "item=$ITEM" "harness=${harness:-unknown}" >&2; exit 1 ;;
  esac
  refuse_unanswered_ask
  close_secs="${ORCH_LANE_CLOSE_SECS:-15}"
  [[ "$close_secs" =~ ^[1-9][0-9]*$ ]] \
    || { message record-invalid "item=$ITEM" "field=ORCH_LANE_CLOSE_SECS" >&2; exit 1; }
  stop_harness
  [[ "$STOP_SKIPPED" == false && -n "$pane_id" ]] || finish_close
  passes=$((close_secs * 5))
  while :; do
    rc=0
    pane_now_exited || rc=$?
    case "$rc" in
      0) break ;;
      1) ;;
      *) message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1 ;;
    esac
    passes=$((passes - 1))
    (( passes > 0 )) \
      || { message exit-timeout "item=$ITEM" "harness=$harness" "pane=$pane_id" "processes=$STOPPED_COUNT" ${STOP_IDENTITY:+"identity=$STOP_IDENTITY"} >&2; exit 1; }
    sleep 0.2
  done
}

# The window is closed as a close closes it, then the sandbox is stopped; an
# exited lane's harness is already gone and takes no signal.
if [[ "$PARK" == true ]]; then
  [[ "$state" == exited ]] || stop_and_await_exit
  pane_rc=0
  pane_still_exists || pane_rc=$?
  case "$pane_rc" in
    0) tmux kill-window -t "$pane_id" \
         || { message tmux-failed "item=$ITEM" "operation=kill-window" "pane=$pane_id" >&2; exit 1; } ;;
    1) ;;
    *) message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1 ;;
  esac
  park_sandbox
fi

[[ "$state" != idle && "$state" != windowless ]] || stop_and_await_exit

finish_close
