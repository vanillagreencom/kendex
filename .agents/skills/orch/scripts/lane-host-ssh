#!/usr/bin/env python3
"""Static SSH lane hosts. Use --help for configuration and the command contract."""

import argparse
import base64
import io
from contextlib import contextmanager
import json
import os
from pathlib import Path
import shlex
import shutil
import subprocess
import sys
import tarfile
import tempfile
import time

# The record of the process group a lane's prefix makes, under the clone it
# owns, beside the item marker: agent-runtime's `process lead` writes its
# leader there, and status and stop read that group by it alone.
IDENTITY_FILE = "/.git/lane-host-pid"
# The clone's own runtimes, each built by create for the clone's sources.
AGENT_RUNTIME = "/.agents/skills/agent-runtime/scripts/agent-runtime"
ORCH_RUNTIME = "/.agents/skills/orch/scripts/orch-runtime"
# The static host kind's capability line. lane-host answers it for a provider
# that predates the verb, so this is its one spelling.
CAPABILITIES = "\t".join(("kind=ssh", "launch=ssh", "channel=mailbox", "files=verb", "status=verb", "stop=verb",
                          "relaunch=resume", "park=none", "accounts=none", "pool=plan", "land=lane", "pane=local"))


def notice(key, **values):
    """Print a stable diagnostic without file contents or credentials."""
    print("lane-host-ssh: " + key + "".join(f" {k}={v}" for k, v in values.items()), file=sys.stderr)


def remote_command(row, script, *args):
    """Build the SSH command for a request or a lifecycle session."""
    control_dir = Path.home() / ".cache" / "kendex-ssh"
    control_dir.mkdir(mode=0o700, parents=True, exist_ok=True)
    control_dir.chmod(0o700)
    command = shlex.join(["bash", "-c", "set -euo pipefail\n" + script, "lane-host-ssh", *args])
    # Keep the master past the mail interval; OpenSSH reconnects if it is gone.
    return ["ssh", "-T", "-o", "BatchMode=yes", "-o", "ControlMaster=auto",
            "-o", "ControlPersist=60", "-o", f"ControlPath={control_dir}/%C",
            "--", row["target"], command]


def remote(row, script, *args, data=None, accept=(), capture_error=False):
    """Run Bash through SSH; accept=None returns every transport status."""
    if "session" in row:
        result = row["session"].request(script, args, data or b"")
    else:
        result = subprocess.run(remote_command(row, script, *args),
                                input=data if data is not None else b"", stdout=subprocess.PIPE,
                                stderr=subprocess.PIPE if capture_error else None)
    if accept is not None and result.returncode != 0 and result.returncode not in accept:
        notice("remote-failed", target=row["target"], exit=result.returncode)
        raise SystemExit(result.returncode if result.returncode > 0 else 1)
    return result


class LifecycleSession:
    """One SSH channel owns the lock and executes every lifecycle step.

    OpenSSH ChannelTimeout can close one idle session while other sessions
    continue. Executing the work on the lock's channel removes that split.
    Requests and replies count bytes so credentials and tar archives keep
    their binary contents, and a truncated request executes nothing.
    """

    def __init__(self, row):
        self.row = row
        self.output = bytearray()
        library = Path(__file__).parent.joinpath("../../mailbox/scripts/lib/file-lock.sh").read_text()
        script = library + '\n' + '''mkdir -p -- "$(dirname -- "$1")"
exec 9>>"$1"
orch_take_lock 9 "$1" 0 || exit 75
umask 077
session=$(mktemp -d) || exit 1
trap 'rm -rf -- "${session:?}"; orch_release_lock' EXIT
# sshd can send HUP when ChannelTimeout closes this channel. Bash defers a
# trapped signal until its foreground operation ends, keeping the mutex too.
trap 'exit 129' HUP
printf 'owned\\n'
while read -r command_size input_size; do
  dd bs=1 count="$command_size" of="$session/command" 2>/dev/null
  arrived=$(wc -c < "$session/command")
  test "$((arrived + 0))" -eq "$command_size" || exit 1
  dd bs=1 count="$input_size" of="$session/input" 2>/dev/null
  arrived=$(wc -c < "$session/input")
  test "$((arrived + 0))" -eq "$input_size" || exit 1
  code=0
  # The command is exclusively shlex.join output from this provider.
  bash "$session/command" < "$session/input" > "$session/output" || code=$?
  size=$(wc -c < "$session/output")
  printf '%s %s\\n' "$code" "$((size + 0))"
  cat -- "$session/output"
done
'''
        self.process = subprocess.Popen(remote_command(row, script, row["clone"] + ".lane-host.lock"),
                                        stdin=subprocess.PIPE, stdout=subprocess.PIPE,
                                        env=dict(os.environ))

    def request(self, script, args, data):
        command = shlex.join(["bash", "-c", "set -euo pipefail\n" + script, "lane-host-ssh", *args]).encode()
        try:
            self.process.stdin.write(f"{len(command)} {len(data)}\n".encode() + command + data)
            self.process.stdin.flush()
            header = self.process.stdout.readline().split()
            if len(header) != 2 or not all(word.isdigit() for word in header):
                raise EOFError
            code, size = map(int, header)
            output = self.process.stdout.read(size)
            if len(output) != size:
                raise EOFError
        except (BrokenPipeError, EOFError):
            notice("ownership-channel-failed", target=self.row["target"], clone=self.row["clone"])
            raise SystemExit(1) from None
        return subprocess.CompletedProcess(command, code, output)

    def close(self):
        """Bound an SSH client stalled in the remote EOF exchange."""
        try:
            try:
                self.process.stdin.close()
            except BrokenPipeError:
                # The channel already closed; wait still reaps the SSH client.
                pass
            # No operation remains after EOF. Give the SSH exchange a grace
            # interval, then signal only the process handle this owner holds.
            try:
                return self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                notice("ownership-shutdown-timeout", target=self.row["target"])
            self.process.terminate()
            try:
                self.process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.process.kill()
                try:
                    self.process.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    notice("ownership-reap-timeout", target=self.row["target"])
            return 1
        finally:
            self.process.stdout.close()


@contextmanager
def ownership_lock(row):
    """Execute lifecycle work on its lock owner and confirm that owner exited."""
    session = LifecycleSession(row)
    ready = False
    try:
        ready = session.process.stdout.readline() == b"owned\n"
        if not ready:
            return
        yield {**row, "session": session}
    finally:
        error = sys.exc_info()[1]
        code = session.close()
        if not ready and code == 0:
            code = 1
        if code:
            notice("ownership-busy" if code == 75 else "ownership-lock-failed",
                   target=row["target"], clone=row["clone"], exit=code)
        if error is None or isinstance(error, SystemExit) and error.code == 0:
            if code:
                raise SystemExit(code if code > 0 else 1)
            sys.stdout.buffer.write(session.output)


def lifecycle_output(row, data):
    """Publish lifecycle success only after the owning SSH channel completes."""
    if "session" in row:
        row["session"].output.extend(data)
    else:
        sys.stdout.buffer.write(data)


# Run first by `read`, which `cat` and the Claude state merge use, and by
# `put` and `append`. A lane mailbox path whose tmp/lane-mail or item
# directory, or the file
# itself, is a symlink or not the kind it names exits 3, never 2, so a caller
# refuses rather than reads an empty mailbox. Every other path, an account file
# or a symlinked tmp, is untouched. The last tmp/lane-mail segment is the
# mailbox, since a lane root may itself contain one.
MAILBOX_GUARD = '''case "$1" in
*/tmp/lane-mail/*)
  mail="${1%/tmp/lane-mail/*}/tmp/lane-mail"
  rest="${1##*/tmp/lane-mail/}"
  for component in "$mail" "$mail/${rest%%/*}" "$1"; do
    kind=-d
    if test "$component" = "$1"; then kind=-f; fi
    if test -L "$component" || { test -e "$component" && ! test "$kind" "$component"; }; then
      printf 'lane-host-ssh: mailbox-component path=%s\\n' "$component" >&2
      exit 3
    fi
  done ;;
esac
'''


# The transfer `put` and `append` share. The bytes land in a temporary file
# beside the target and are counted against what the sender declared, because a
# local process that dies mid-feed closes the stream and the remote `cat` reads
# that as an ordinary end of input, so the count is what tells a whole transfer
# from a truncated one. Neither verb lets a short transfer reach the target,
# and the EXIT trap removes the staged file however the script ends, which is
# a no-op once `put` has renamed it into place.
#
# A staged data write that fails is `<verb>-failed path=... reason=...`, the
# failing command's own report below it, as is append's library call; the
# steps around them fail through `set -e` with their own report alone.
# `no-space` is a full disk, freed on the host rather than chased through SSH;
# `write-failed` is every other cause. The C locale is what holds that report
# to the wording `write_cause` matches.
# Arguments: `$1` target, `$2` declared count, `$3` remote clone, `$4` staging
# suffix, `$5` the verb opening each diagnostic key. The staged path is left in
# `$staged`.
STAGE_AND_COUNT = '''umask 077
export LC_ALL=C
write_cause() { # REPORT
  case "$1" in *'No space left on device'*) printf no-space ;; *) printf write-failed ;; esac
}
failed() { # VERB PATH REASON REPORT
  printf 'lane-host-ssh: %s-failed path=%s reason=%s\\n' "$1" "$2" "$3" >&2
  if [ -n "$4" ]; then printf '%s\\n' "$4" >&2; fi
  exit 1
}
mkdir -p -- "$(dirname -- "$1")"
staged=$(mktemp -- "$1.$4.XXXXXX")
trap 'rm -f -- "${staged:?}"' EXIT
staging=0
report=$(cat 2>&1 > "$staged") || staging=$?
if [ "$staging" -ne 0 ]; then failed "$5" "$1" "$(write_cause "$report")" "$report"; fi
arrived=$(wc -c < "$staged")
if [ "$((arrived + 0))" -ne "$2" ]; then
  printf 'lane-host-ssh: %s-short expected=%s arrived=%s\\n' "$5" "$2" "$((arrived + 0))" >&2
  exit 1
fi
'''


# The rules the append obeys come from the clone on the host, which updates
# apart from the control machine shipping this script: a host created before
# the verb has no library and every send to it would otherwise refuse through
# the remote shell's own no-such-file line. Read before the transfer, so a
# refusal stages nothing. `$3` is that clone. Each library is checked and
# sourced in one pass, so the set is named once: a second list is how one
# library reaches the source line without reaching the check. Neither library
# defines `lib` or `library`. A library without the repeat guard still delivers;
# the warning names the missing check without duplicating the library's rule.
APPEND_LIBRARIES = '''lib="$3/.agents/skills/mailbox/scripts/lib"
for library in file-lock.sh mailbox-append.sh; do
  if [ ! -r "$lib/$library" ]; then
    printf 'lane-host-ssh: append-library-missing path=%s\\n' "$lib/$library" >&2
    printf 'the host clone predates the append verb; refresh it to a build carrying that library\\n' >&2
    exit 1
  fi
  . "$lib/$library"
done
if ! declare -F mailbox_duplicate_id >/dev/null; then
  printf 'lane-host-ssh: append-library-outdated path=%s repeat-check=skipped\\n' "$lib/mailbox-append.sh" >&2
fi
'''


def put(row, path, data):
    """Replace a remote file with the bytes on stdin, at private permissions.

    The staged bytes are renamed over the target once the whole transfer has
    arrived, so a transfer that fails leaves the previous file standing and no
    reader ever meets a half-written one.
    """
    remote(row, MAILBOX_GUARD + STAGE_AND_COUNT + '''case "$staged" in /*) permission_path="$staged" ;; *) permission_path="./$staged" ;; esac
chmod 600 "$permission_path"
mv -f -- "$staged" "$1"''', path, str(len(data)), row["clone"], "kendex-put", "put", data=data)


def append(row, path, data):
    """Add stdin's bytes to a remote file under a lock taken on that host.

    A mailbox several machines write cannot be read, changed and put back:
    each writer would lock its own disk and the later put would drop the
    other's line. The lock, the created file and the closing of an
    unterminated last line are the installed package's own `mailbox-append.sh`
    rather than a second spelling of them, so the hosted path and the lane's
    own local one cannot drift apart. `umask 077` above is what makes a
    mailbox this creates private.

    The library runs in a command substitution, which captures its report
    for the keyed line and keeps the EXIT trap its lock arms where flock is
    absent from replacing the one that removes the staged file.
    """
    result = remote(row, MAILBOX_GUARD + APPEND_LIBRARIES + STAGE_AND_COUNT + '''appended=0
report=$(mailbox_append_locked "$1" 30 "" "$staged" < "$staged" 2>&1) || appended=$?
case "$appended" in
  0) ;;
  3) failed append "$1" lock-timeout "$report" ;;
  4) printf '%s\\n' "$report" >&2; exit 4 ;;
  *) failed append "$1" "$(write_cause "$report")" "$report" ;;
esac''', path, str(len(data)), row["clone"], "kendex-append", "append", data=data, accept=(4,))
    if result.returncode == 4:
        raise SystemExit(4)


READ_FILE = MAILBOX_GUARD + 'test -e "$1" || exit 2\ncat -- "$1"'

def read(row, path):
    """Return a remote file's bytes, or None for a path that is not there.

    A file that is not there exits 2, which is the caller's one reading of
    "the lane has not written this yet"; every other read failure keeps its
    own status so the caller refuses rather than reads empty.
    """
    result = remote(row, READ_FILE, path, accept=(2,))
    return None if result.returncode == 2 else result.stdout


def read_many(rows, requests):
    """Read each target in one SSH session; frame exact bytes before encoding.

    Batching changes transport only. The same mailbox guard as cat rejects
    unsafe components, and each failed file keeps a non-missing status.
    """
    if not isinstance(requests, list) or any(
            not isinstance(r, dict) or set(r) != {"item", "path"}
            or any(not isinstance(r[k], str) or not r[k]
                   or any(c in r[k] for c in "\x00\t\r\n") for k in ("item", "path"))
            for r in requests):
        raise ValueError("invalid read-many request")
    if len({(r["item"], r["path"]) for r in requests}) != len(requests):
        raise ValueError("duplicate read-many request")
    inventory = {r["item"]: r for r in rows}
    groups = {}
    replies = {}
    for request in requests:
        if request["item"] not in inventory:
            replies[(request["item"], request["path"])] = {
                **request, "status": 1, "data": "",
                "error": f"lane-host-ssh: item-unconfigured item={request['item']}"}
            continue
        row = inventory[request["item"]]
        groups.setdefault(row["target"], []).append(request)
    for target, group in groups.items():
        # Stage each file before declaring its byte count. A failed read's
        # partial bytes must never become a successful or missing file.
        script = 'read_file() (\n' + READ_FILE + '\n)\n' + '''staged=$(mktemp -d) || exit 1
trap 'rm -rf -- "${staged:?}"' EXIT
for path in "$@"; do
  rc=0
  read_file "$path" >"$staged/data" 2>"$staged/error" || rc=$?
  if test "$rc" -ne 0; then : >"$staged/data"; fi
  count=$(wc -c <"$staged/data") || exit 1
  errors=$(wc -c <"$staged/error") || exit 1
  printf '%s %s %s\\n' "$rc" "$((count + 0))" "$((errors + 0))"
  cat -- "$staged/data" "$staged/error" || exit 1
done'''
        result = remote(inventory[group[0]["item"]], script, *(r["path"] for r in group),
                        accept=None, capture_error=True)
        if result.returncode != 0:
            # SSH failures must not hide mail on another configured target.
            status = result.returncode if 0 < result.returncode <= 255 and result.returncode not in (2, 69) else 1
            error = (f"lane-host-ssh: remote-failed target={target} exit={result.returncode}\n"
                     + result.stderr.decode("utf-8", errors="replace"))
            for request in group:
                replies[(request["item"], request["path"])] = {
                    **request, "status": status, "data": "", "error": error}
            continue
        stream = io.BytesIO(result.stdout)
        for request in group:
            header = stream.readline().split()
            if len(header) != 3 or any(not n.isdigit() for n in header):
                raise ValueError("invalid read-many frame")
            status, size, error_size = map(int, header)
            data = stream.read(size)
            error = stream.read(error_size)
            if len(data) != size or len(error) != error_size or (status != 0 and size != 0):
                raise ValueError("truncated read-many frame")
            replies[(request["item"], request["path"])] = {
                **request, "status": status, "data": base64.b64encode(data).decode("ascii"),
                "error": error.decode("utf-8", errors="replace")}
        if stream.read():
            raise ValueError("extra read-many frame")
    print(json.dumps([replies[(r["item"], r["path"])] for r in requests]))


def claude_state(current, snapshot):
    """Set the snapshot's top-level keys and merge its project entries key by key."""
    projects = dict(current.get("projects", {}))
    for path, entry in snapshot.get("projects", {}).items():
        projects[path] = {**projects.get(path, {}), **entry}
    return {**current, **snapshot, "projects": projects}


def worktree(row, *args, preliminary=False):
    """Keep path resolution and ownership in the installed worktree command."""
    command = 'cd -- "$1"; shift; exec .agents/skills/worktree/scripts/worktree "$@"'
    if preliminary:
        command = 'export WORKTREE_SETUP_CMD=\n' + command
    return remote(row, command,
                  row["clone"], *args, accept=(75, REUSE_UNREBASED) if args[0] == "create" else ())


# The worktree command's exit for a reuse that handed the tree back, set up, on
# a head that does not contain the base.
REUSE_UNREBASED = 76
# A standing tree is reused with the item's work kept: a tree the reuse cannot
# rebase stays as it stands rather than failing the create.
REUSE_KEEPING = ["--reuse", "--keep-on-conflict"]


def create_worktree(row, item, flags, preliminary=False):
    """Create the item's tree at the hosted lane path, identical in every lane
    of the repository, so a build there hits compile-cache entries another
    lane or the warm snapshot keyed by the same source path. True where the
    tree stands unrebased on the item's own head."""
    made = worktree(row, "create", item, "--hosted", *flags, preliminary=preliminary)
    if made.returncode not in (0, REUSE_UNREBASED):
        raise SystemExit(made.returncode)
    return made.returncode == REUSE_UNREBASED


# What stop, status and close answer for an item the clone holds nothing of:
# the answer the protocol states for each verb on an item the provider holds
# no sandbox for, so a caller needs no branch of its own for it
# (../schemas/lane-host.md § Provider protocol).
ABSENT_ANSWERS = {"stop": "stopped item={} processes=0", "status": "exited", "close": "closed=absent item={}"}


def owned(row, item, verb):
    """Exit 75 unless the clone marker names the item as its owner.

    A standing clone whose marker is gone or names another item, with no
    worktree for this item, holds nothing of it: a finished close left it so,
    and a create for another item may have followed. The verb gives its absent
    answer and exits 0, touching nothing of the other item. A worktree for the
    item beside no marker naming it is a create that failed after making it,
    which still refuses as unowned. A clone that is not there took the marker
    and the process record with it: close gives its absent answer and removes
    nothing, since a worktree left beside it lost its history with the clone;
    stop and status refuse as unowned, since no record says nothing runs."""
    owner = remote(row, '''test -d "$1/.git" || exit 0
if test -f "$1/.git/lane-host-item"; then
  owner=$(cat -- "$1/.git/lane-host-item") || exit 1
  if test "$owner" = "$2"; then printf owned; exit 0; fi
fi
printf other''', row["clone"], item).stdout
    if owner == b"owned":
        return
    if not owner and verb == "close" or owner == b"other" and not worktree_exists(row, item):
        lifecycle_output(row, (ABSENT_ANSWERS[verb].format(item) + "\n").encode())
        raise SystemExit(0)
    notice(verb + "-unowned", item=item)
    raise SystemExit(75)


def owned_worktree(row, item, verb):
    """Resolve the item only after the clone marker confirms its owner."""
    owned(row, item, verb)
    path = worktree(row, "path", item).stdout.decode().strip()
    if not path or "\n" in path or "\t" in path:
        notice("worktree-path-invalid", item=item)
        raise SystemExit(1)
    return path


def worktree_exists(row, item):
    """Ask the installed worktree owner whether the item's tree stands."""
    present = worktree(row, "exists", item).stdout
    if present in (b"true\n", b"false\n"):
        return present == b"true\n"
    notice("worktree-exists-invalid", item=item)
    raise SystemExit(1)


def create_flags(row, item, reuse_requested):
    """Reuse a standing tree or open the item branch a cloud lane pushed."""
    if not reuse_requested:
        return []
    if worktree_exists(row, item):
        return REUSE_KEEPING
    branch = item.lower()
    existing = remote(row, '"$1/.agents/skills/github/scripts/git-https-auth" -C "$1" ls-remote --exit-code --heads origin "$2"',
                      row["clone"], "refs/heads/" + branch, accept=(2,))
    return ["--base", branch] if existing.returncode == 0 else []


def require_render(row):
    """Refuse a clone whose checkout carries no committed render.

    create renders nothing: the lane's tree is a worktree of the base branch,
    and the scripts every later step runs are the render that branch commits.
    A clone of a repository that commits none, or one whose checkout predates
    the commit that added it, is named here rather than failing later as
    bash's 127. A fetch does not repair the second: this check runs before
    sync-base, which is itself part of the render, so the checkout has to be
    fast-forwarded by hand or the clone removed for create to clone afresh.
    A script present but not committed at HEAD is the render an earlier
    create's refresh left untracked in a clone of a repository that committed
    none; git never updates it, and a pull collides with it, so only removing
    it or the clone repairs that clone.
    """
    remote(row, '''for script in orch/scripts/sync-base worktree/scripts/worktree; do
  if ! test -x "$1/.agents/skills/$script"; then
    printf 'lane-host-ssh: render-missing path=%s\\n' "$1/.agents/skills/$script" >&2
    printf 'create renders nothing; fast-forward this checkout past the commit that added the render (git -C CLONE pull --ff-only), or remove the clone so create clones it afresh\\n' >&2
    exit 1
  fi
  committed=$(git -C "$1" ls-tree --name-only HEAD -- ".agents/skills/$script") || exit 1
  if test -z "$committed"; then
    printf 'lane-host-ssh: render-untracked path=%s\\n' "$1/.agents/skills/$script" >&2
    printf 'this render is not committed at HEAD and git never updates it; remove the clone, or delete its untracked .agents render, before create runs again\\n' >&2
    exit 1
  fi
done''', row["clone"])


def install_dependencies(row, item):
    """Install each node_modules a WORKTREE_SYMLINKS entry links, in the clone.

    The clone is the main checkout, the one place worktree --help lets an
    install run; a worktree links its node_modules from here. The settings
    come through the clone's own loader, so this reads what the worktree
    command reads, in a subshell: npm ci and the dependencies' install scripts
    run with the SSH session's environment. The selected private env files and
    .env.local are moved out of the clone and the current item's standing worktree after
    settings resolution and restored when this call exits, so install scripts
    cannot read those paths or provisioned copies.
    npm ci empties node_modules first, so the marker of the
    committed lockfile blob it was installed from lives inside it and survives
    only a finished install: an unchanged lockfile installs nothing. Where
    the item's tree already stands, the lockfile is the one that tree commits
    at its head, so the dependencies its own work added are installed. An entry
    climbing out of the clone is the worktree command's to refuse, never a
    directory to install in.
    """
    remote(row, '''loader="$1/.agents/skills/worktree/scripts/lib/kendex-env.sh"
load_copy_support() {
  local support="${loader%/*}" library helper
  unset -f worktree_message strip_trailing_slashes normalize_worktree_config_path split_worktree_config_words || return 1
  for library in "$support/messages.sh" "$support/links.sh"; do
    if ! test -r "$library"; then
      printf 'lane-host-ssh: copy-support-unavailable path=%s cause=unreadable\\n' "$library" >&2
      return 1
    fi
    . "$library" || return 1
  done
  for helper in worktree_message strip_trailing_slashes normalize_worktree_config_path split_worktree_config_words; do
    if ! declare -F "$helper" >/dev/null; then
      case "$helper" in
        worktree_message) library="$support/messages.sh" ;;
        *) library="$support/links.sh" ;;
      esac
      printf 'lane-host-ssh: copy-support-unavailable path=%s cause=missing-helper helper=%s\\n' "$library" "$helper" >&2
      return 1
    fi
  done
}
load_copy_support || exit 1
load_install_settings() {
  local selected_private
  unset -f kendex_project_env_supports || return 1
  . "$loader" || return 1
  if ! declare -F kendex_project_env_supports >/dev/null ||
     ! kendex_project_env_supports selected-private-path; then
    printf 'lane-host-ssh: loader-private-path-missing path=%s output=selected-private-path\\n' "$loader" >&2
    return 1
  fi
  kendex_load_project_env "$1" selected_private -- WORKTREE_SYMLINKS WORKTREE_COPIES >&2 || return 1
  printf '%q ' "${WORKTREE_SYMLINKS:-}" "$selected_private" "${WORKTREE_COPIES:-}"
}
settings=$(load_install_settings "$1") || exit 1
# Only printf %q's shell-quoted values enter eval, including paths with spaces.
eval "settings=($settings)"
symlinks=${settings[0]}
private_names=(.env.local "${settings[1]}")
copy_settings=("${settings[2]}")
roots=("$1")
declared="$1"
tree=$(cd -- "$1" && .agents/skills/worktree/scripts/worktree path "$2") || exit 1
if test -d "$tree"; then
  declared="$tree"
  selected=$(load_install_settings "$tree") || exit 1
  eval "selected=($selected)"
  private_names+=("${selected[1]}")
  copy_settings+=("${selected[2]}")
  roots+=("$tree")
fi
private_paths=()
private_copies=()
for copies in "${copy_settings[@]}"; do
  split_worktree_config_words "$copies" || exit 1
  for entry in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    copy=$(normalize_worktree_config_path WORKTREE_COPIES "$entry") || exit 1
    private_copies+=("$copy")
  done
done
for ((index = 0; index < ${#roots[@]}; index++)); do
  roots[$index]=$(cd -P -- "${roots[$index]}" && pwd -P) || exit 1
done
protect_private_path() {
  local path="$1" at target root relative prior contained copy copy_root
  local chain=() names=()
  while test -e "$path" || test -L "$path"; do
    at=$(cd -P -- "${path%/*}" && pwd -P) || return 1
    path="$at/${path##*/}"
    contained=false
    for root in "${roots[@]}"; do
      case "$path" in
        "$root"/*)
          contained=true
          relative=${path#"$root"/}
          names=("$relative")
          break ;;
      esac
    done
    if test "$contained" != true; then
      printf 'lane-host-ssh: private-protection-unsafe path=%s cause=outside-roots\\n' "$path" >&2
      return 1
    fi
    # WORKTREE_COPIES can reach the same source through a directory alias.
    # Its destination is a separate file under that configured relative name.
    for copy in ${private_copies[@]+"${private_copies[@]}"}; do
      for copy_root in "${roots[@]}"; do
        if test "$copy_root/$copy" -ef "$path"; then
          names+=("$copy")
          break
        fi
      done
    done
    for relative in "${names[@]}"; do
      for prior in "${private_names[@]}"; do
        if test "$prior" = "$relative"; then break; fi
      done
      if test "$prior" != "$relative"; then private_names+=("$relative"); fi
    done
    for prior in ${chain[@]+"${chain[@]}"}; do
      if test "$prior" = "$path"; then
        printf 'lane-host-ssh: private-protection-unsafe path=%s cause=link-cycle\\n' "$path" >&2
        return 1
      fi
    done
    chain+=("$path")
    prior=""
    for prior in ${private_paths[@]+"${private_paths[@]}"}; do
      if test "$prior" = "$path"; then break; fi
    done
    if test "${prior:-}" != "$path"; then private_paths+=("$path"); fi
    if test -L "$path"; then
      target=$(readlink -- "$path") || return 1
      case "$target" in /*) path="$target" ;; *) path="${path%/*}/$target" ;; esac
      if ! test -e "$path" && ! test -L "$path"; then
        printf 'lane-host-ssh: private-protection-unsafe path=%s cause=unresolved-link\\n' "$path" >&2
        return 1
      fi
    elif test -f "$path"; then
      return 0
    else
      printf 'lane-host-ssh: private-protection-unsafe path=%s cause=not-file\\n' "$path" >&2
      return 1
    fi
  done
}
# Worktree setup can copy a target under a name different from its relative link.
# Discover that name before moving anything, then protect it in both checkouts.
for ((index = 0; index < ${#private_names[@]}; index++)); do
  for root in "${roots[@]}"; do
    protect_private_path "$root/${private_names[$index]}" || exit 1
  done
done
# A reused clone already holds the private file, so delaying its upload alone
# would still expose it and worktree copies to dependency lifecycle scripts.
private=$(mktemp -d) || exit 1
saved_paths=()
placed=()
clone="$1"
# The clone's own committed pair back where the item's was placed for npm ci.
restore_placed() {
  local status=0 path
  for path in ${placed[@]+"${placed[@]}"}; do
    if git -C "$clone" cat-file -e "HEAD:$path" 2>/dev/null; then
      git -C "$clone" checkout -q HEAD -- "$path" || status=1
    else
      rm -f -- "$clone/$path" || status=1
    fi
  done
  placed=()
  return "$status"
}
restore_private() {
  local status=$? index path
  restore_placed || status=1
  for ((index = ${#saved_paths[@]} - 1; index >= 0; index--)); do
    path=${saved_paths[$index]}
    mv -- "$private/$index" "$path" || status=1
  done
  rmdir -- "$private" || status=1
  return "$status"
}
trap restore_private EXIT
for path in ${private_paths[@]+"${private_paths[@]}"}; do
  if test -e "$path" || test -L "$path"; then
    mv -- "$path" "$private/${#saved_paths[@]}"
    saved_paths+=("$path")
  fi
done
read -r -a entries <<<"$symlinks"
for entry in ${entries[@]+"${entries[@]}"}; do
  case "/$entry/" in */../*|*/./*|//*) continue ;; esac
  strip_trailing_slashes "$entry" entry
  case "$entry" in node_modules|*/node_modules) ;; *) continue ;; esac
  lockfile=${entry%node_modules}package-lock.json
  if ! blob=$(git -C "$declared" rev-parse -q --verify "HEAD:$lockfile"); then
    printf 'lane-host-ssh: dependency-install-skipped path=%s cause=no-committed-lockfile\\n' "$lockfile" >&2
    continue
  fi
  marker="$1/$entry/.lane-host-install"
  installed=""
  if test -f "$marker"; then installed=$(cat -- "$marker") || exit 1; fi
  if test "$installed" = "$blob"; then continue; fi
  printf 'lane-host-ssh: dependency-install path=%s\\n' "$lockfile" >&2
  # npm ci reads the manifest pair beside node_modules and, run in the tree,
  # replaces the tree's link with a directory of its own, so the standing
  # tree's committed pair is placed in the clone for the install.
  if test "$declared" != "$1"; then
    manifest=${entry%node_modules}package.json
    placed=("$lockfile" "$manifest")
    git -C "$declared" show "HEAD:$lockfile" >"$1/$lockfile"
    if git -C "$declared" cat-file -e "HEAD:$manifest" 2>/dev/null; then
      git -C "$declared" show "HEAD:$manifest" >"$1/$manifest"
    fi
  fi
  (cd -- "$1/${entry%node_modules}" && npm ci --no-audit --no-fund) >&2
  restore_placed
  printf '%s\\n' "$blob" >"$marker"
done''', row["clone"], item)


def built(row, package, refusal):
    """The binary the clone's own setup of PACKAGE builds from the clone's
    sources, keyed on them, so a lane never meets setup-required at its first
    turn; a host that already holds it builds nothing. A clone without the
    setup, or a setup that names no binary, refuses before any window."""
    return remote(row, '''setup="$1/.agents/skills/$2/scripts/setup"
if [ ! -x "$setup" ]; then
  printf 'lane-host-ssh: %s-setup-missing path=%s\\n' "$3" "$setup" >&2
  exit 1
fi
line=$("$setup") || exit 1
case "$line" in
  *" binary=/"*) printf '%s\\n' "${line##* binary=}" ;;
  *) printf 'lane-host-ssh: %s-unbuilt output=%s\\n' "$3" "$line" >&2; exit 1 ;;
esac''', row["clone"], package, refusal).stdout.decode().strip()


def create(row, args, source):
    """Prepare the clone and account, then acquire the worktree through its owner."""
    result = remote(row, '''if test -f "$1/.git/lane-host-item"; then
  owner=$(cat -- "$1/.git/lane-host-item") || exit 1
  if test "$owner" != "$3"; then exit 75; fi
fi
if test -d "$1/.git"; then
  origin=$(git -C "$1" remote get-url origin) || exit 1
  actual=$(gh repo view "$origin" --json nameWithOwner --jq .nameWithOwner) || exit 1
  if test "$actual" != "$2"; then
    printf 'lane-host-ssh: origin-mismatch expected=%s actual=%s\n' "$2" "$actual" >&2
    exit 1
  fi
  printf existing
else
  gh repo clone "$2" "$1" >&2
  printf new
fi''', row["clone"], args.repo, args.item)
    require_render(row)
    if result.stdout == b"existing":
        remote(row, '''test -x "$1/.agents/skills/worktree/scripts/worktree"
exec "$1/.agents/skills/orch/scripts/sync-base" "$1" >&2''', row["clone"])
    # Claim ownership first; the consumer setup command needs private-file
    # delivery. A relaunch's tree stands before the install reads its lockfile.
    prepared = result.stdout == b"existing" or args.relaunch
    if prepared:
        create_worktree(row, args.item, create_flags(row, args.item, args.relaunch or args.reuse), preliminary=True)
    env_file = source / ".env.local"
    put(row, row["clone"] + "/.env.local", env_file.read_bytes() if env_file.exists() else b"")
    account = Path(args.account)
    remote_account = row["account"]
    # The command the prefix's group leader becomes, with the launcher's line
    # appended as its last argument.
    if args.harness == "claude":
        put(row, remote_account + "/setup-token", (account / "setup-token").read_bytes())
        names = []
        command = ["bash", "-c", 'CLAUDE_CODE_OAUTH_TOKEN=$(< "$1") && export CLAUDE_CODE_OAUTH_TOKEN && exec bash -lc "$2"',
                   "lane-host", remote_account + "/setup-token"]
    else:
        # A copilot lane's identity is the login its host account already
        # holds, so nothing is copied; the rest of its launch policy rides in
        # the command the launcher hands (agent-runtime's runtime/src/launch.rs).
        if args.harness != "copilot":
            put(row, remote_account + "/auth.json", (account / "auth.json").read_bytes())
        name = {"codex": "CODEX_HOME", "copilot": "COPILOT_HOME"}.get(args.harness, "PI_CODING_AGENT_DIR")
        names = [name + "=" + remote_account]
        command = ["bash", "-lc"]
    # The caller's folder trust and hook approval land where each harness reads
    # them; Claude's relative path resolves in the SSH session's remote home.
    # A copilot lane places no file: its prefix sets COPILOT_HOME, and its
    # folder trust is the COPILOT_ALLOW_ALL=true its start command carries where
    # it names --allow-all or --yolo (agent-runtime's runtime/src/launch.rs).
    approval = {"claude": ".claude.json", "codex": "config.toml", "pi": "trust.json"}.get(args.harness)
    approval = account / "lane-host" / approval if approval else None
    if approval is not None and approval.exists():
        data = approval.read_bytes()
        if args.harness == "claude":
            # Every Claude lane and the host user share the one ~/.claude.json.
            existing = read(row, approval.name)
            data = json.dumps(claude_state({} if existing is None else json.loads(existing), json.loads(data)), indent=2).encode()
        put(row, approval.name if args.harness == "claude" else remote_account + "/" + approval.name, data)
    # An existing clone acquires ownership before shared files change. Run
    # setup again after preparation so its links, copies and identity are current.
    # The install changes the shared node_modules, so it waits for that
    # ownership too, and precedes the final setup pass that links it.
    flags = REUSE_KEEPING if prepared else create_flags(row, args.item, args.relaunch or args.reuse)
    install_dependencies(row, args.item)
    unrebased = create_worktree(row, args.item, flags)
    path = worktree(row, "path", args.item).stdout.decode().strip()
    if not path or "\n" in path or "\t" in path:
        notice("worktree-path-invalid", item=args.item)
        raise SystemExit(1)
    # The orch runtime the lane's own workflow runs on this host, its path in
    # the launch record for the launcher to read before it opens a window.
    runtime = built(row, "orch", "runtime")
    # The prefix's group leader: agent-runtime makes the lane's process group
    # in place, records its leader beside the item marker and becomes the
    # harness command, or refuses by name on the pane with the harness
    # unstarted. The group is never the SSH server's: a server can run every
    # session's command in one group of its own, which a stop must not reach.
    lead = built(row, "agent-runtime", "agent-runtime")
    prefix = "exec env " + shlex.join(["ORCH_STATE_DIR=" + path + "/tmp", *names, lead, "process", "lead",
                                       "--file", row["clone"] + IDENTITY_FILE, "--", *command])
    # The item marker is local to this clone; it is not part of the install record.
    remote(row, 'printf "%s\\n" "$2" > "$1/.git/lane-host-item"', row["clone"], args.item)
    # The launch record lane-mail-check reads, written by its one owner out of
    # the tree that was just made, the way the sync-base call above reaches the
    # clone's own scripts. That script states the containment and the marker
    # shape; nothing here restates them. A clone whose kendex install predates
    # it is named, because by now create has made the worktree and written
    # .git/lane-host-item, and bash's 127 would leave a half-created hosted
    # lane with nothing naming what is missing.
    remote(row, '''marker="$1/.agents/skills/orch/scripts/lane-marker"
if [ ! -x "$marker" ]; then
  printf 'lane-host-ssh: marker-script-missing path=%s\\n' "$marker" >&2
  printf 'the host clone predates the launch record writer; refresh it to a build carrying that script\\n' >&2
  exit 1
fi
exec "$marker" --launch-record "$4" "$2" "$3"''', row["clone"], path, args.item,
           json.dumps({"identity_file": row["clone"] + IDENTITY_FILE, "runtime": runtime}))
    pi_root = f"\tpi-root={remote_account}" if args.harness == "pi" else ""
    tree = "\ttree=unrebased" if unrebased else ""
    lifecycle_output(row, f"ssh-target={row['target']}\tpath={path}\tremote-prefix={prefix}{pi_root}{tree}\n".encode())


def archive_tmp(row, item, worktree_path):
    """Preserve remaining lane records locally before close removes their worktree.

    The item's workflow state goes with them: the launch environment puts it
    in the worktree's tmp, and older launches can keep it in the directory
    their checkout's ORCH_STATE_DIR names, read by the clone's own settings
    loader with no runtime on the host. The archive's
    `lane-host-state` member names that file's member, or is an empty line
    when no live state remains. With an empty marker, the `lane-host-saved`
    member lists the clone's saved cycle copies, and a reader takes only the
    listed copy of the merge it records. A resolution
    that fails stops close, the sandbox and its state kept: an archive
    without the state loses it."""
    data = remote(row, '''paths=() names=()
for base in "$1" "$2"; do
  candidate="$base/tmp"
  if test -e "$candidate" || test -L "$candidate"; then
    paths+=("${candidate#/}")
  fi
done
state="" member="" from="$2"
test -d "$from" || from="$1"
loader="$1/.agents/skills/orch/scripts/lib/kendex-env.sh"
if test -r "$loader"; then
  state="$2/tmp/workflow-state-$3.json"
  if ! test -f "$state"; then
    # ORCH_STATE_DIR as the checkout's settings and private env file set it,
    # else tmp; a relative value joins the clone.
    if ! dir=$(cd "$from" && . "$loader" && kendex_load_project_env "$(git rev-parse --show-toplevel 2>/dev/null || pwd)" "" -- ORCH_STATE_DIR && printf '%s\\n' "${ORCH_STATE_DIR:-tmp}"); then
      printf 'lane-host-ssh: state-unresolved item=%s\\n' "$3" >&2
      exit 1
    fi
    case "$dir" in /*) ;; *) dir="$1/$dir" ;; esac
    state="$dir/workflow-state-$3.json"
  fi
  names=(lane-host-state)
  if test -f "$state"; then
    # A relative setting such as ../lane-state joins the clone as given,
    # and tar cuts a member name at its last .. component, so the record names
    # the file's physical path: the one test -f found, a symlink before ..
    # followed as the filesystem follows it, and the root directory kept.
    dir=$(cd -P -- "$(dirname -- "$state")" && pwd -P)
    state="${dir%/}/$(basename -- "$state")"
    member="${state#/}"
    case "$state" in
      "$1/tmp/"* | "$2/tmp/"*) ;;
      *) paths+=("$member") ;;
    esac
  fi
fi
if test "${#paths[@]}" -eq 0; then exit 0; fi
manifest=$(mktemp -d)
trap 'rm -rf -- "${manifest:?}"' EXIT
printf '%s\\n' "$member" > "$manifest/lane-host-state"
if test "${#names[@]}" -gt 0 && test -z "$member"; then
  for saved in "$1"/tmp/cycle-state/workflow-state-pr-*.json; do
    if test -f "$saved"; then printf '%s\\n' "${saved#/}"; fi
  done > "$manifest/lane-host-saved"
  names+=(lane-host-saved)
fi
tar -chzf - -C "$manifest" ${names[@]+"${names[@]}"} -C / "${paths[@]}"''', row["clone"], worktree_path, item).stdout
    if not data:
        return
    # The local runtime owns this setting's default, its settings precedence
    # and the refusal of a root a removal would take; its entry is Bash.
    bash = shutil.which("bash")
    if bash is None:
        raise FileNotFoundError(2, "Bash is required to read archive settings", "bash")
    suffix = row["repo"].rsplit("/", 1)[-1] + "/" + item
    root = subprocess.run([bash, str(Path(__file__).resolve().parent / "orch-runtime"),
                           "archive", "root", "--suffix", suffix], stdout=subprocess.PIPE)
    if root.returncode != 0:
        raise SystemExit(root.returncode if root.returncode > 0 else 1)
    placed = json.loads(root.stdout)["result"]["root"]
    if placed is None:
        return
    directory = Path(placed) / suffix
    try:
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(prefix=f"tmp-{time.time_ns()}-", suffix=".tgz", dir=directory, delete=False) as archive:
            archive.write(data)
            archive.flush()
            os.fsync(archive.fileno())
            kept = archive.name
    except OSError as error:
        notice("archive-write-failed", path=directory, cause=type(error).__name__)
        raise SystemExit(1) from None
    print(f"kept={kept}", flush=True)


def runtime_result(answer):
    """The `result` of an agent-runtime reply on stdout, empty where none parses."""
    try:
        reply = json.loads(answer.stdout)
    except ValueError:
        return {}
    return reply.get("result") or {} if isinstance(reply, dict) else {}


def status(row, item):
    """Read the lane's recorded process group without signalling any process:
    running while a member lives, exited once none does or nothing was
    recorded. It reads no directory, so a lane whose worktree its own
    close-out removed still reads running."""
    owned(row, item, "status")
    answer = remote(row, 'exec "$1$2" process group --file "$1$3"', row["clone"], AGENT_RUNTIME, IDENTITY_FILE,
                    accept=None)
    word = {"live": "running", "gone": "exited"}.get(runtime_result(answer).get("reading"))
    if answer.returncode != 0 or word is None:
        notice("status-read-failed", item=item, exit=answer.returncode)
        raise SystemExit(1)
    lifecycle_output(row, (word + "\n").encode())


def stop_lane(row, item, path, verb, failed):
    """End the lane's processes on the host and return how many of its group
    were signalled: first the validation runs of its worktree, which lead
    groups of their own, through the clone's own runtime, the owner of a
    lane's validation stop, under the state directory the prefix exports; a
    worktree that no longer stands holds none. Then the process group the
    prefix made, by its recorded leader alone. A failure of either refuses
    with the cause the runtime printed above it."""
    validations = remote(row, '''test -d "$2" || exit 0
cd -- "$2"
ORCH_STATE_DIR="$2/tmp" exec "$1$3" validate entry --stop --worktree "$2"''',
                         row["clone"], path, ORCH_RUNTIME, accept=None)
    if validations.returncode != 0:
        notice(verb + "-validations-failed", item=item, exit=validations.returncode)
        raise SystemExit(1)
    answer = remote(row, 'exec "$1$2" process stop --file "$1$3"', row["clone"], AGENT_RUNTIME, IDENTITY_FILE,
                    accept=None)
    stopped = runtime_result(answer).get("stop") or {}
    if answer.returncode == 0 and stopped.get("outcome") in ("stopped", "already-gone"):
        return stopped.get("signaled", 0)
    notice(failed, item=item, outcome=stopped.get("outcome", "refused"), exit=answer.returncode)
    raise SystemExit(1)


def stop(row, item):
    """Stop the item's lane by the group its prefix made. Nothing here reads
    the worktree's processes, so an item whose worktree its own close-out
    already removed stops all the same."""
    path = owned_worktree(row, item, "stop")
    signalled = stop_lane(row, item, path, "stop", "stop-failed")
    lifecycle_output(row, f"stopped item={item} processes={signalled}\n".encode())


def main():
    """Dispatch the provider protocol against an explicit per-item inventory."""
    parser = argparse.ArgumentParser(description="""One static SSH host and clone per item.
LANE_HOST_SSH_INVENTORY names a JSON array for this repository. Each row has string fields:
repo (OWNER/REPO), item, target (SSH destination), clone (absolute remote clone
path), account (absolute remote harness config directory). Each target/clone
pair and each item occurs once. SSH keys and host verification use your SSH config.
LANE_HOST_SSH_SOURCE names the local source clone (default: current directory).
create copies its .env.local.
Dependency installation temporarily removes .env.local and the loader-selected
private files from the clone and the current item's standing worktree after resolving settings.
It restores each file or link on success or failure.
An existing clone must have an origin for the configured repository. Its base
branch is fast-forwarded before setup; local changes or divergence stop create.
create renders nothing and installs no Pi package: the worktree carries the
render its base branch commits. A clone whose checkout lacks that render exits
1 with render-missing, and one whose render is not committed at HEAD exits 1
with render-untracked.
For each WORKTREE_SYMLINKS entry naming a node_modules, create runs npm ci in
the clone, the lane's main checkout, beside that entry's committed
package-lock.json once it holds the item, before the final setup pass links
it. Where the item's tree already stands, the package.json and
package-lock.json are the pair that tree commits at its head, placed in the
clone for the install and put back after it.
node_modules/.lane-host-install records the lockfile blob installed, so an
unchanged lockfile installs nothing; a failed install fails create. An entry
with no committed package-lock.json installs nothing and prints
dependency-install-skipped. On an existing clone or a relaunch the first setup pass, which
takes the item, runs before that install and can print the worktree's
dependency-source-missing warning; the --reuse setup that follows links it.
Claude reads ACCOUNT/setup-token; Codex and Pi read ACCOUNT/auth.json. Copilot
copies nothing: it runs under COPILOT_HOME at the row's account, which holds its
own stored login. When present,
ACCOUNT/lane-host/.claude.json merges into the remote home's .claude.json (its
top-level keys set, its project entries merged key by key), and
ACCOUNT/lane-host/config.toml (Codex) or ACCOUNT/lane-host/trust.json (Pi) in the
remote account directory, so folder trust and hook approval precede the first turn. Bytes
travel on stdin. read-many reads a JSON array of item/path requests from stdin
and returns item/path/status/base64-data rows, in request order, with one SSH
call per target. Missing files have status 2; other failed files keep their
nonzero status and no bytes. cat exits 2 for a path that is not there. put stages beside
the target and renames only once the byte count the sender declared has
arrived, so a transfer cut short replaces nothing and exits 1. Neither verb
leaves its staged file behind. A failed write of the staged bytes, or of
append's library call, exits 1 as put-failed or append-failed, with
reason=no-space for a full disk. append stages
and counts the same way, then hands the bytes to the clone's own
lib/mailbox-append.sh, which adds them under a lock taken on the host, so
writers on several machines each keep their line; it creates the file with
private permissions and closes an unterminated last line first. A repeated
mail envelope is judged under that same lock and exits 4 with duplicate id=FIRST
on stderr, appending nothing. A clone without the repeat guard delivers with
append-library-outdated path=LIBRARY repeat-check=skipped on stderr. A clone
without that library predates the verb and append exits 1 naming it, so
refresh a host created before the verb shipped. Prepare the
host with Git, gh, Bash, kendex and the harness first, and npm where a linked
node_modules has a committed package-lock.json. A Pi lane runs with the
row's remote account directory as PI_CODING_AGENT_DIR, so install its Pi
packages once on the host at that root:
PI_CODING_AGENT_DIR=<row account> kendex update-pi --scope global.
The control machine requires Python 3.8 or later.
create returns ssh-target, path and remote-prefix as tab-separated key=value
fields, and pi-root, the row's account directory, for a Pi lane. Existing
ownership exits 75; --reuse and --relaunch pass --reuse --keep-on-conflict to
the worktree command when the target exists: a tree that command hands back
without the base (a conflicting rebase aborted, uncommitted work, a detached
head, a head at its published head) is kept on the item's own head, and the
line adds tree=unrebased. Without a target, an origin item branch uses
--base; no origin item branch uses plain create.
Every create passes --hosted, so the item's worktree sits at the clone's one
hosted lane path (worktree path --hosted), and path= names it.
create builds the clone's orch runtime and agent-runtime through their own
setups (runtime-setup-missing, runtime-unbuilt, agent-runtime-setup-missing,
agent-runtime-unbuilt). Every create's remote-prefix runs agent-runtime's
process lead, which makes the lane's process group in place, records its
leader's pid and start in clone/.git/lane-host-pid and becomes the harness
command; a refusal ends the prefix on the pane with the harness unstarted.
create, status, stop and close hold one exclusive remote lock beside the clone
for the whole call. An overlapping lifecycle call exits 75 as ownership-busy,
so unfinished creation cannot be reported as an absent sandbox.
stop --item ID --harness claude|codex|pi|copilot, after confirming the clone's
item owner, stops the item worktree's validation runs through the clone's
orch runtime (validate entry --stop), then every member of the recorded group
by its own identity, TERM then KILL, and prints stopped item=ID
processes=COUNT, the group's members signalled (0 where none ran or nothing
was recorded). It reads no directory's processes, so an item whose worktree
its own close-out removed stops all the same. A failed validation stop exits 1
with stop-validations-failed, a failed group stop with stop-failed, each below
the runtime's own line. status takes the same arguments and reads the
recorded group without signalling it: running while a member lives, exited
otherwise. A failed ownership or group read exits nonzero and reports no
status. A clone holding neither a marker naming the item nor
the item's worktree, as a finished close leaves it whether or not a create for
another item followed, holds nothing of the item: stop answers stopped item=ID
processes=0, status answers exited and close answers closed=absent item=ID,
each with exit 0 and touching nothing. A missing or other item's marker beside
the item's standing worktree refuses stop, status and close with exit 75
before worktree path lookup. close first stops the lane as stop does, refusing
close-validations-failed or close-stop-failed with nothing removed, and
removes the group's record with the item marker last. close preserves render-only drift as a binary patch under clone/tmp, restores
the generated paths, refreshes the clone, and then closes. An untracked render,
a skill symlink a post-launch kendex apply added among them, enters the patch
through a temporary index rather than a working-tree comparison, so a link to a
directory is recorded as a link instead of being dropped. close reads the patch
back and refuses unless the patch carries every path it is about to restore or
remove; that refusal, and an untracked render the temporary index cannot read,
exit 3 and keep the static host. Any path outside the
clone's generated inventory refuses close with exit 3 and keeps the static host.
Before worktree removal, close archives remaining clone/tmp
and worktree/tmp directories, and the item's workflow state, falling back to
an older launch's settings when needed, with a lane-host-state member naming that
state's member, under ORCH_ARCHIVE_ROOT/REPO/ITEM/tmp-STAMP.tgz
and prints kept=PATH; with no root set it keeps no archive and prints no kept line.
A configured root requires a readable Git worktree list on this host. A failed archive stops
close, as does a state directory the clone's workflow-state cannot resolve,
reported as state-unresolved. An already removed worktree's tmp cannot be recovered. No remaining tmp
and no workflow state outside it means no archive and no kept line. Archives contain paths relative to / and
follow symlinks, so linked records remain in the archive after their target is gone.
close --merged, the caller's word that the item's pull request merged, is
accepted and changes nothing: a static host keeps the whole archive.
list prints repo/item, state, age, name as tab-separated fields. Age is '-' for
static hosts. touch probes SSH; static hosts have no idle expiry.
capabilities prints the static ssh host kind's one capability line
(schemas/lane-host.md § Host kinds) and reads no inventory.
""", formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="verb", required=True)
    make = sub.add_parser("create")
    for field in ("item", "repo", "account"):
        make.add_argument("--" + field, required=True)
    make.add_argument("--harness", required=True, choices=("claude", "codex", "pi", "copilot"))
    make.add_argument("--relaunch", action="store_true")
    make.add_argument("--reuse", action="store_true")
    for verb in ("cat", "put", "append", "touch", "close"):
        action = sub.add_parser(verb)
        action.add_argument("--item", required=True)
        if verb in ("cat", "put", "append"):
            action.add_argument("path")
        if verb == "close":
            action.add_argument("--merged", action="store_true")
    for verb in ("stop", "status"):
        stopping = sub.add_parser(verb)
        stopping.add_argument("--item", required=True)
        stopping.add_argument("--harness", required=True, choices=("claude", "codex", "pi", "copilot"))
    sub.add_parser("read-many")
    sub.add_parser("list")
    sub.add_parser("capabilities")
    args = parser.parse_args()
    if args.verb == "capabilities":
        print(CAPABILITIES)
        return
    inventory = os.environ.get("LANE_HOST_SSH_INVENTORY", "")
    if not inventory:
        notice("inventory-required", variable="LANE_HOST_SSH_INVENTORY")
        raise SystemExit(2)
    with open(inventory, encoding="utf-8") as stream:
        rows = json.load(stream)
    fields = ("repo", "item", "target", "clone", "account")
    if not isinstance(rows, list) or any(
        not isinstance(row, dict) or any(not isinstance(row.get(k), str) or not row[k]
        or any(c in row[k] for c in "\t\r\n") for k in fields) for row in rows
    ):
        notice("inventory-fields", path=inventory)
        raise SystemExit(2)
    if len({r["item"] for r in rows}) != len(rows) or len({(r["target"], r["clone"]) for r in rows}) != len(rows):
        notice("inventory-duplicate", path=inventory)
        raise SystemExit(2)
    if any(not r["clone"].startswith("/") or not r["account"].startswith("/") for r in rows):
        notice("inventory-path", path=inventory)
        raise SystemExit(2)
    if len({r["repo"] for r in rows}) > 1:
        notice("inventory-repo", path=inventory)
        raise SystemExit(2)
    if args.verb == "read-many":
        read_many(rows, json.load(sys.stdin))
        return
    if args.verb == "list":
        for row in rows:
            state = remote(row, 'if test -f "$1/.git/lane-host-item"; then printf hosted; else printf available; fi', row["clone"])
            print(f"{row['repo']}/{row['item']}\t{state.stdout.decode()}\t-\t{row['target']}")
        return
    matches = [row for row in rows if row["item"] == args.item]
    if not matches:
        notice("item-unconfigured", item=args.item)
        raise SystemExit(2)
    row = matches[0]
    if args.verb in ("create", "status", "stop", "close"):
        with ownership_lock(row) as locked:
            dispatch(locked, args)
    else:
        dispatch(row, args)


def dispatch(row, args):
    if args.verb == "create":
        if row["repo"] != args.repo:
            notice("repo-mismatch", item=args.item, repo=args.repo)
            raise SystemExit(2)
        create(row, args, Path(os.environ.get("LANE_HOST_SSH_SOURCE", os.getcwd())))
    elif args.verb == "cat":
        data = read(row, args.path)
        if data is None:
            raise SystemExit(2)
        sys.stdout.buffer.write(data)
    elif args.verb == "put":
        put(row, args.path, sys.stdin.buffer.read())
    elif args.verb == "append":
        append(row, args.path, sys.stdin.buffer.read())
    elif args.verb == "touch":
        remote(row, "true")
    elif args.verb == "stop":
        stop(row, args.item)
    elif args.verb == "status":
        status(row, args.item)
    elif args.verb == "close":
        path = owned_worktree(row, args.item, "close")
        # Nothing of the lane outlives its record: a lane whose SSH session
        # held no terminal gets no hang-up when its window closes.
        stop_lane(row, args.item, path, "close", "close-stop-failed")
        result = remote(row, '''drop_render_scratch() { rm -f -- "$owned" "$status" "$index" "$carried"; }
clean_render_drift() {
  dir="$1"; clone="$2"; item="$3"; label="$4"
  owned="$clone/tmp/render-owned-$label-$$.json"
  status="$clone/tmp/render-status-$label-$$"
  index="$clone/tmp/render-index-$label-$$"
  carried="$clone/tmp/render-carried-$label-$$"
  mkdir -p -- "$clone/tmp" || exit 1
  git -C "$dir" status --porcelain=v1 -z --untracked-files=all >"$status" || exit 1
  if ! test -s "$status"; then drop_render_scratch; return 0; fi
  (cd -- "$dir" && kendex generated-paths) >"$owned" || { drop_render_scratch; return 1; }
  jq -e 'type == "array" and all(.[]; type == "string")' "$owned" >/dev/null || {
    drop_render_scratch; return 1;
  }
  paths=(); tracked=(); untracked=()
  while IFS= read -r -d '' entry; do
    code="${entry:0:2}"
    path="${entry:3}"
    case "$code" in *R*|*C*) drop_render_scratch; return 3 ;; esac
    jq -e --arg path "$path" 'index($path) != null' "$owned" >/dev/null || {
      drop_render_scratch; return 3;
    }
    paths+=("$path")
    if git -C "$dir" ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
      tracked+=("$path")
    elif test -f "$dir/$path" || test -L "$dir/$path"; then
      untracked+=("$path")
    else
      drop_render_scratch; return 3
    fi
  done <"$status"
  test "${#paths[@]}" -gt 0 || { drop_render_scratch; return 3; }
  stamp=$(date -u +%Y%m%dT%H%M%SZ) || exit 1
  patch="$clone/tmp/render-drift-$item-$label-$stamp.patch"
  git -C "$dir" diff --binary HEAD -- "${paths[@]}" >"$patch" || exit 1
  if test "${#untracked[@]}" -gt 0; then
    empty=$(git -C "$dir" hash-object -t tree /dev/null) || exit 1
    (export GIT_INDEX_FILE="$index"; git -C "$dir" add --force -- "${untracked[@]}") || {
      drop_render_scratch; return 3;
    }
    (export GIT_INDEX_FILE="$index"; git -C "$dir" diff --binary --cached "$empty" -- "${untracked[@]}") >>"$patch" || exit 1
  fi
  git -C "$dir" -c core.quotePath=false apply --numstat -- "$patch" >"$carried" || {
    drop_render_scratch; return 3;
  }
  for path in "${paths[@]}"; do
    awk -F'\t' -v want="$path" '$3 == want { found = 1 } END { exit !found }' "$carried" || {
      drop_render_scratch; return 3;
    }
  done
  drop_render_scratch
  if test "${#tracked[@]}" -gt 0; then
    git -C "$dir" restore --staged --worktree -- "${tracked[@]}" || exit 1
  fi
  for path in ${untracked[@]+"${untracked[@]}"}; do rm -f -- "$dir/$path" || exit 1; done
  dirty=$(git -C "$dir" status --porcelain) || exit 1
  test -z "$dirty" || exit 1
}
for dir in "$1" "$2"; do
  if test "$dir" = "$2" && ! test -e "$dir" && ! test -L "$dir"; then continue; fi
  dirty=$(git -C "$dir" status --porcelain) || exit 1
  if test -n "$dirty"; then
    label=clone
    test "$dir" = "$1" || label=worktree
    clean_render_drift "$dir" "$1" "$3" "$label" || {
      rc=$?; test "$rc" -eq 3 || exit "$rc"; printf '%s\\n' "$dir"; exit 3;
    }
  fi
done
exec "$1/.agents/skills/orch/scripts/sync-base" "$1" >&2''', row["clone"], path, args.item, accept=(3,))
        if result.returncode == 3:
            notice("close-refused", path=result.stdout.decode().strip())
            raise SystemExit(3)
        result = remote(row, 'if test -e "$1" || test -L "$1"; then printf present; else printf absent; fi', path)
        archive_tmp(row, args.item, path)
        if result.stdout == b"present":
            worktree(row, "remove", args.item)
        remote(row, 'rm -f -- "$1/.git/lane-host-item" "$1$2"', row["clone"], IDENTITY_FILE)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, tarfile.TarError) as error:
        notice("operation-failed", cause=type(error).__name__, path=getattr(error, "filename", None))
        raise SystemExit(1) from None
