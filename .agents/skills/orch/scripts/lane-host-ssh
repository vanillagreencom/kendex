#!/usr/bin/env python3
"""Static SSH lane hosts. Use --help for configuration and the command contract."""

import argparse
import io
import json
import os
from pathlib import Path
import shlex
import subprocess
import sys
import tarfile
import tempfile
import time


def notice(key, **values):
    """Print a stable diagnostic without file contents or credentials."""
    print("lane-host-ssh: " + key + "".join(f" {k}={v}" for k, v in values.items()), file=sys.stderr)


def remote(row, script, *args, data=None, accept=()):
    """Run Bash through SSH; quote every argument for the remote login shell."""
    command = shlex.join(["bash", "-c", "set -euo pipefail\n" + script, "lane-host-ssh", *args])
    result = subprocess.run(["ssh", "-T", "-o", "BatchMode=yes", "--", row["target"], command],
                            input=data if data is not None else b"", stdout=subprocess.PIPE)
    if result.returncode != 0 and result.returncode not in accept:
        notice("remote-failed", target=row["target"], exit=result.returncode)
        raise SystemExit(result.returncode if result.returncode > 0 else 1)
    return result


# Run first by `read`, which `cat` and the Claude state merge use, and by
# `put` and `append`. A lane mailbox path whose tmp/lane-mail or item
# directory, or the file
# itself, is a symlink or not the kind it names exits 3, never 2, so a caller
# refuses rather than reads an empty mailbox. Every other path, an account file
# or a symlinked tmp, is untouched. The last tmp/lane-mail segment is the
# mailbox, since a lane root may itself contain one.
MAILBOX_GUARD = '''case "$1" in
*/tmp/lane-mail/*)
  mail="${1%/tmp/lane-mail/*}/tmp/lane-mail"
  rest="${1##*/tmp/lane-mail/}"
  for component in "$mail" "$mail/${rest%%/*}" "$1"; do
    kind=-d
    if test "$component" = "$1"; then kind=-f; fi
    if test -L "$component" || { test -e "$component" && ! test "$kind" "$component"; }; then
      printf 'lane-host-ssh: mailbox-component path=%s\\n' "$component" >&2
      exit 3
    fi
  done ;;
esac
'''


# The transfer `put` and `append` share. The bytes land in a temporary file
# beside the target and are counted against what the sender declared, because a
# local process that dies mid-feed closes the stream and the remote `cat` reads
# that as an ordinary end of input, so the count is what tells a whole transfer
# from a truncated one. Neither verb lets a short transfer reach the target,
# and the EXIT trap removes the staged file however the script ends, which is
# a no-op once `put` has renamed it into place.
#
# A staged data write that fails is `<verb>-failed path=... reason=...`, the
# failing command's own report below it, as is append's library call; the
# steps around them fail through `set -e` with their own report alone.
# `no-space` is a full disk, freed on the host rather than chased through SSH;
# `write-failed` is every other cause. The C locale is what holds that report
# to the wording `write_cause` matches.
# Arguments: `$1` target, `$2` declared count, `$3` remote clone, `$4` staging
# suffix, `$5` the verb opening each diagnostic key. The staged path is left in
# `$staged`.
STAGE_AND_COUNT = '''umask 077
export LC_ALL=C
write_cause() { # REPORT
  case "$1" in *'No space left on device'*) printf no-space ;; *) printf write-failed ;; esac
}
failed() { # VERB PATH REASON REPORT
  printf 'lane-host-ssh: %s-failed path=%s reason=%s\\n' "$1" "$2" "$3" >&2
  if [ -n "$4" ]; then printf '%s\\n' "$4" >&2; fi
  exit 1
}
mkdir -p -- "$(dirname -- "$1")"
staged=$(mktemp -- "$1.$4.XXXXXX")
trap 'rm -f -- "${staged:?}"' EXIT
staging=0
report=$(cat 2>&1 > "$staged") || staging=$?
if [ "$staging" -ne 0 ]; then failed "$5" "$1" "$(write_cause "$report")" "$report"; fi
arrived=$(wc -c < "$staged")
if [ "$((arrived + 0))" -ne "$2" ]; then
  printf 'lane-host-ssh: %s-short expected=%s arrived=%s\\n' "$5" "$2" "$((arrived + 0))" >&2
  exit 1
fi
'''


# The rules the append obeys come from the clone on the host, which updates
# apart from the control machine shipping this script: a host created before
# the verb has no library and every send to it would otherwise refuse through
# the remote shell's own no-such-file line. Read before the transfer, so a
# refusal stages nothing. `$3` is that clone. Each library is checked and
# sourced in one pass, so the set is named once: a second list is how one
# library reaches the source line without reaching the check. Neither library
# defines `lib` or `library`.
APPEND_LIBRARIES = '''lib="$3/.agents/skills/orch/scripts/lib"
for library in file-lock.sh mailbox-append.sh; do
  if [ ! -r "$lib/$library" ]; then
    printf 'lane-host-ssh: append-library-missing path=%s\\n' "$lib/$library" >&2
    printf 'the host clone predates the append verb; refresh it to a build carrying that library\\n' >&2
    exit 1
  fi
  . "$lib/$library"
done
'''


def put(row, path, data):
    """Replace a remote file with the bytes on stdin, at private permissions.

    The staged bytes are renamed over the target once the whole transfer has
    arrived, so a transfer that fails leaves the previous file standing and no
    reader ever meets a half-written one.
    """
    remote(row, MAILBOX_GUARD + STAGE_AND_COUNT + '''case "$staged" in /*) permission_path="$staged" ;; *) permission_path="./$staged" ;; esac
chmod 600 "$permission_path"
mv -f -- "$staged" "$1"''', path, str(len(data)), row["clone"], "kendex-put", "put", data=data)


def append(row, path, data):
    """Add stdin's bytes to a remote file under a lock taken on that host.

    A mailbox several machines write cannot be read, changed and put back:
    each writer would lock its own disk and the later put would drop the
    other's line. The lock, the created file and the closing of an
    unterminated last line are the installed package's own `mailbox-append.sh`
    rather than a second spelling of them, so the hosted path and the lane's
    own local one cannot drift apart. `umask 077` above is what makes a
    mailbox this creates private.

    The library runs in a command substitution, which captures its report
    for the keyed line and keeps the EXIT trap its lock arms where flock is
    absent from replacing the one that removes the staged file.
    """
    remote(row, MAILBOX_GUARD + APPEND_LIBRARIES + STAGE_AND_COUNT + '''appended=0
report=$(mailbox_append_locked "$1" 30 < "$staged" 2>&1) || appended=$?
case "$appended" in
  0) ;;
  3) failed append "$1" lock-timeout "$report" ;;
  *) failed append "$1" "$(write_cause "$report")" "$report" ;;
esac''', path, str(len(data)), row["clone"], "kendex-append", "append", data=data)


def read(row, path):
    """Return a remote file's bytes, or None for a path that is not there.

    A file that is not there exits 2, which is the caller's one reading of
    "the lane has not written this yet"; every other read failure keeps its
    own status so the caller refuses rather than reads empty.
    """
    result = remote(row, MAILBOX_GUARD + 'test -e "$1" || exit 2\ncat -- "$1"', path, accept=(2,))
    return None if result.returncode == 2 else result.stdout


def claude_state(current, snapshot):
    """Set the snapshot's top-level keys and merge its project entries key by key."""
    projects = dict(current.get("projects", {}))
    for path, entry in snapshot.get("projects", {}).items():
        projects[path] = {**projects.get(path, {}), **entry}
    return {**current, **snapshot, "projects": projects}


def worktree(row, *args):
    """Keep path resolution and ownership in the installed worktree command."""
    return remote(row, 'cd -- "$1"; shift; exec .agents/skills/worktree/scripts/worktree "$@"',
                  row["clone"], *args, accept=(75,) if args[0] == "create" else ())


def create_worktree(row, item, flags):
    """Create the item's tree at the hosted lane path, identical in every lane
    of the repository, so a build there hits compile-cache entries another
    lane or the warm snapshot keyed by the same source path."""
    made = worktree(row, "create", item, "--hosted", *flags)
    if made.returncode:
        raise SystemExit(made.returncode)


def owned_worktree(row, item, verb):
    """Resolve the item only after the clone marker confirms its owner."""
    owned = remote(row, '''if ! test -f "$1/.git/lane-host-item"; then exit 75; fi
owner=$(cat -- "$1/.git/lane-host-item") || exit 1
if test "$owner" != "$2"; then exit 75; fi''', row["clone"], item, accept=(75,))
    if owned.returncode == 75:
        notice(verb + "-unowned", item=item)
        raise SystemExit(75)
    path = worktree(row, "path", item).stdout.decode().strip()
    if not path or "\n" in path or "\t" in path:
        notice("worktree-path-invalid", item=item)
        raise SystemExit(1)
    return path


def create_flags(row, item, reuse_requested):
    """Ask the installed worktree owner whether reuse has a target."""
    if not reuse_requested:
        return []
    present = worktree(row, "exists", item).stdout
    if present == b"true\n":
        return ["--reuse"]
    if present == b"false\n":
        return []
    notice("worktree-exists-invalid", item=item)
    raise SystemExit(1)


def require_render(row):
    """Refuse a clone whose checkout carries no committed render.

    create renders nothing: the lane's tree is a worktree of the base branch,
    and the scripts every later step runs are the render that branch commits.
    A clone of a repository that commits none, or one whose checkout predates
    the commit that added it, is named here rather than failing later as
    bash's 127. A fetch does not repair the second: this check runs before
    sync-base, which is itself part of the render, so the checkout has to be
    fast-forwarded by hand or the clone removed for create to clone afresh.
    A script present but not committed at HEAD is the render an earlier
    create's refresh left untracked in a clone of a repository that committed
    none; git never updates it, and a pull collides with it, so only removing
    it or the clone repairs that clone.
    """
    remote(row, '''for script in orch/scripts/sync-base worktree/scripts/worktree; do
  if ! test -x "$1/.agents/skills/$script"; then
    printf 'lane-host-ssh: render-missing path=%s\\n' "$1/.agents/skills/$script" >&2
    printf 'create renders nothing; fast-forward this checkout past the commit that added the render (git -C CLONE pull --ff-only), or remove the clone so create clones it afresh\\n' >&2
    exit 1
  fi
  committed=$(git -C "$1" ls-tree --name-only HEAD -- ".agents/skills/$script") || exit 1
  if test -z "$committed"; then
    printf 'lane-host-ssh: render-untracked path=%s\\n' "$1/.agents/skills/$script" >&2
    printf 'this render is not committed at HEAD and git never updates it; remove the clone, or delete its untracked .agents render, before create runs again\\n' >&2
    exit 1
  fi
done''', row["clone"])


def create(row, args, source):
    """Prepare the clone and account, then acquire the worktree through its owner."""
    result = remote(row, '''if test -f "$1/.git/lane-host-item"; then
  owner=$(cat -- "$1/.git/lane-host-item") || exit 1
  if test "$owner" != "$3"; then exit 75; fi
fi
if test -d "$1/.git"; then
  origin=$(git -C "$1" remote get-url origin) || exit 1
  actual=$(gh repo view "$origin" --json nameWithOwner --jq .nameWithOwner) || exit 1
  if test "$actual" != "$2"; then
    printf 'lane-host-ssh: origin-mismatch expected=%s actual=%s\n' "$2" "$actual" >&2
    exit 1
  fi
  printf existing
else
  gh repo clone "$2" "$1" >&2
  printf new
fi''', row["clone"], args.repo, args.item)
    require_render(row)
    if result.stdout == b"existing":
        remote(row, '''test -x "$1/.agents/skills/worktree/scripts/worktree"
exec "$1/.agents/skills/orch/scripts/sync-base" "$1" >&2''', row["clone"])
        create_worktree(row, args.item, create_flags(row, args.item, args.relaunch or args.reuse))
    env_file = source / ".env.local"
    put(row, row["clone"] + "/.env.local", env_file.read_bytes() if env_file.exists() else b"")
    cache = source / ".cache/linear"
    if result.stdout == b"new" and cache.is_dir():
        archive = io.BytesIO()
        with tarfile.open(fileobj=archive, mode="w:gz", dereference=True) as tar:
            # Linear owns these cache files; locks are local to each machine.
            def unlocked(info):
                return None if info.name.endswith(".lock") else info
            tar.add(cache, arcname="linear", filter=unlocked)
        remote(row, 'mkdir -p -- "$1/.cache"; tar -xzf - -C "$1/.cache"',
               row["clone"], data=archive.getvalue())
    account = Path(args.account)
    remote_account = row["account"]
    if args.harness == "claude":
        put(row, remote_account + "/setup-token", (account / "setup-token").read_bytes())
        prefix = "exec " + shlex.join(["bash", "-c",
            'CLAUDE_CODE_OAUTH_TOKEN=$(< "$1") && export CLAUDE_CODE_OAUTH_TOKEN && exec bash -lc "$2"',
            "lane-host", remote_account + "/setup-token"])
    else:
        put(row, remote_account + "/auth.json", (account / "auth.json").read_bytes())
        name = "CODEX_HOME" if args.harness == "codex" else "PI_CODING_AGENT_DIR"
        prefix = "exec env " + shlex.quote(name + "=" + remote_account) + " bash -lc"
    # The caller's folder trust and hook approval land where each harness reads
    # them; Claude's relative path resolves in the SSH session's remote home.
    approval = account / "lane-host" / {"claude": ".claude.json", "codex": "config.toml", "pi": "trust.json"}[args.harness]
    if approval.exists():
        data = approval.read_bytes()
        if args.harness == "claude":
            # Every Claude lane and the host user share the one ~/.claude.json.
            existing = read(row, approval.name)
            data = json.dumps(claude_state({} if existing is None else json.loads(existing), json.loads(data)), indent=2).encode()
        put(row, approval.name if args.harness == "claude" else remote_account + "/" + approval.name, data)
    # An existing clone acquires ownership before shared files change. Run
    # setup again after preparation so its links, copies and identity are current.
    flags = ["--reuse"] if result.stdout == b"existing" else create_flags(row, args.item, args.relaunch or args.reuse)
    create_worktree(row, args.item, flags)
    path = worktree(row, "path", args.item).stdout.decode().strip()
    if not path or "\n" in path or "\t" in path:
        notice("worktree-path-invalid", item=args.item)
        raise SystemExit(1)
    # The item marker is local to this clone; it is not part of the install record.
    remote(row, 'printf "%s\\n" "$2" > "$1/.git/lane-host-item"', row["clone"], args.item)
    # The launch record lane-mail-check reads, written by its one owner out of
    # the tree that was just made, the way the sync-base call above reaches the
    # clone's own scripts. That script states the containment and the marker
    # shape; nothing here restates them. A clone whose kendex install predates
    # it is named, because by now create has made the worktree and written
    # .git/lane-host-item, and bash's 127 would leave a half-created hosted
    # lane with nothing naming what is missing.
    remote(row, '''marker="$1/.agents/skills/orch/scripts/lane-marker"
if [ ! -x "$marker" ]; then
  printf 'lane-host-ssh: marker-script-missing path=%s\\n' "$marker" >&2
  printf 'the host clone predates the launch record writer; refresh it to a build carrying that script\\n' >&2
  exit 1
fi
exec "$marker" "$2" "$3"''', row["clone"], path, args.item)
    print(f"ssh-target={row['target']}\tpath={path}\tremote-prefix={prefix}")


def archive_tmp(row, item, worktree_path):
    """Preserve remaining lane records locally before close removes their worktree."""
    data = remote(row, '''paths=()
for base in "$1" "$2"; do
  candidate="$base/tmp"
  if test -e "$candidate" || test -L "$candidate"; then
    paths+=("${candidate#/}")
  fi
done
if test "${#paths[@]}" -eq 0; then exit 0; fi
exec tar -chzf - -C / -- "${paths[@]}"''', row["clone"], worktree_path).stdout
    if not data:
        return
    fleet = Path(os.environ.get("FLEET_DIR") or str(Path.home() / ".fleet")).expanduser()
    directory = fleet / "archive" / row["repo"].rsplit("/", 1)[-1] / item
    try:
        directory.mkdir(mode=0o700, parents=True, exist_ok=True)
        with tempfile.NamedTemporaryFile(prefix=f"tmp-{time.time_ns()}-", suffix=".tgz", dir=directory, delete=False) as archive:
            archive.write(data)
            archive.flush()
            os.fsync(archive.fileno())
            kept = archive.name
    except OSError as error:
        notice("archive-write-failed", path=directory, cause=type(error).__name__)
        raise SystemExit(1) from None
    print(f"kept={kept}", flush=True)


def stop(row, item, harness):
    """Stop the named harness only when its process belongs to the item worktree.

    An item whose worktree its own close-out already removed exits 4: no
    process can be matched to a directory that is gone, and lane-close reads
    that status as a stop its host close makes unnecessary."""
    path = owned_worktree(row, item, "stop")
    result = remote(row, '''if ! test -d "$1"; then
  printf 'lane-host-ssh: stop-worktree-removed item=%s\n' "$4" >&2
  exit 4
fi
lib="$3/.agents/skills/orch/scripts/lib/lane-state.sh"
if ! test -r "$lib"; then
  printf 'lane-host-ssh: stop-library-missing path=%s\n' "$lib" >&2
  exit 1
fi
. "$lib"
if ! declare -F lane_stop_owned >/dev/null; then
  printf 'lane-host-ssh: stop-operation-missing path=%s\n' "$lib" >&2
  exit 1
fi
lane_stop_owned "$1" "$2" || {
  printf 'lane-host-ssh: stop-%s item=%s%s\n' "$LANE_STOP_CAUSE" "$4" "${LANE_STOP_PID:+ pid=$LANE_STOP_PID}" >&2
  exit 1
}
printf 'stopped item=%s processes=%s\n' "$4" "$LANE_STOP_COUNT"''', path, harness, row["clone"], item, accept=(4,))
    if result.returncode == 4:
        raise SystemExit(4)
    sys.stdout.buffer.write(result.stdout)


def main():
    """Dispatch the provider protocol against an explicit per-item inventory."""
    parser = argparse.ArgumentParser(description="""One static SSH host and clone per item.
LANE_HOST_SSH_INVENTORY names a JSON array for this repository. Each row has string fields:
repo (OWNER/REPO), item, target (SSH destination), clone (absolute remote clone
path), account (absolute remote harness config directory). Each target/clone
pair and each item occurs once. SSH keys and host verification use your SSH config.
LANE_HOST_SSH_SOURCE names the local source clone (default: current directory).
create copies its .env.local and, for a fresh clone, .cache/linear without locks.
An existing clone must have an origin for the configured repository. Its base
branch is fast-forwarded before setup; local changes or divergence stop create.
create renders nothing and installs no Pi package: the worktree carries the
render its base branch commits. A clone whose checkout lacks that render exits
1 with render-missing, and one whose render is not committed at HEAD exits 1
with render-untracked.
Claude reads ACCOUNT/setup-token; Codex and Pi read ACCOUNT/auth.json. When present,
ACCOUNT/lane-host/.claude.json merges into the remote home's .claude.json (its
top-level keys set, its project entries merged key by key), and
ACCOUNT/lane-host/config.toml (Codex) or ACCOUNT/lane-host/trust.json (Pi) in the
remote account directory, so folder trust and hook approval precede the first turn. Bytes
travel on stdin. cat exits 2 for a path that is not there. put stages beside
the target and renames only once the byte count the sender declared has
arrived, so a transfer cut short replaces nothing and exits 1. Neither verb
leaves its staged file behind. A failed write of the staged bytes, or of
append's library call, exits 1 as put-failed or append-failed, with
reason=no-space for a full disk. append stages
and counts the same way, then hands the bytes to the clone's own
lib/mailbox-append.sh, which adds them under a lock taken on the host, so
writers on several machines each keep their line; it creates the file with
private permissions and closes an unterminated last line first. A clone
without that library predates the verb and append exits 1 naming it, so
refresh a host created before the verb shipped. Prepare the
host with Git, gh, Bash, kendex and the harness first. A Pi lane runs with the
row's remote account directory as PI_CODING_AGENT_DIR, so install its Pi
packages once on the host at that root:
PI_CODING_AGENT_DIR=<row account> kendex update-pi --scope global.
The control machine requires Python 3.8 or later.
create returns ssh-target, path and remote-prefix as tab-separated key=value
fields. Existing ownership exits 75; --reuse and --relaunch pass --reuse to the
worktree command when the target exists; a missing target uses plain create.
Every create passes --hosted, so the item's worktree sits at the clone's one
hosted lane path (worktree path --hosted), and path= names it.
stop --item ID --harness claude|codex|pi resolves the owned worktree through
the installed worktree command, signals only matching harness processes whose
current directory is that worktree, waits for them to exit, and prints
stopped item=ID processes=COUNT. A worktree that is no longer a directory exits
4 with stop-worktree-removed and signals nothing. close preserves render-only drift as a binary patch under clone/tmp, restores
the generated paths, refreshes the clone, and then closes. An untracked render,
a skill symlink a post-launch kendex apply added among them, enters the patch
through a temporary index rather than a working-tree comparison, so a link to a
directory is recorded as a link instead of being dropped. close reads the patch
back and refuses unless the patch carries every path it is about to restore or
remove; that refusal, and an untracked render the temporary index cannot read,
exit 3 and keep the static host. Any path outside the
clone's generated inventory refuses close with exit 3 and keeps the static host.
An absent or different item marker refuses close with exit 75
before worktree lookup. Before worktree removal, close archives remaining clone/tmp
and worktree/tmp directories under FLEET_DIR/archive/REPO/ITEM/tmp-STAMP.tgz
(FLEET_DIR defaults to ~/.fleet) and prints kept=PATH. A failed archive stops
close. An already removed worktree's tmp cannot be recovered. No remaining tmp
means no archive and no kept line. Archives contain paths relative to / and
follow symlinks, so linked records remain in the archive after their target is gone.
list prints repo/item, state, age, name as tab-separated fields. Age is '-' for
static hosts. touch probes SSH; static hosts have no idle expiry.
""", formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="verb", required=True)
    make = sub.add_parser("create")
    for field in ("item", "repo", "account"):
        make.add_argument("--" + field, required=True)
    make.add_argument("--harness", required=True, choices=("claude", "codex", "pi"))
    make.add_argument("--relaunch", action="store_true")
    make.add_argument("--reuse", action="store_true")
    for verb in ("cat", "put", "append", "touch", "close"):
        action = sub.add_parser(verb)
        action.add_argument("--item", required=True)
        if verb in ("cat", "put", "append"):
            action.add_argument("path")
    stopping = sub.add_parser("stop")
    stopping.add_argument("--item", required=True)
    stopping.add_argument("--harness", required=True, choices=("claude", "codex", "pi"))
    sub.add_parser("list")
    args = parser.parse_args()
    inventory = os.environ.get("LANE_HOST_SSH_INVENTORY", "")
    if not inventory:
        notice("inventory-required", variable="LANE_HOST_SSH_INVENTORY")
        raise SystemExit(2)
    with open(inventory, encoding="utf-8") as stream:
        rows = json.load(stream)
    fields = ("repo", "item", "target", "clone", "account")
    if not isinstance(rows, list) or any(
        not isinstance(row, dict) or any(not isinstance(row.get(k), str) or not row[k]
        or any(c in row[k] for c in "\t\r\n") for k in fields) for row in rows
    ):
        notice("inventory-fields", path=inventory)
        raise SystemExit(2)
    if len({r["item"] for r in rows}) != len(rows) or len({(r["target"], r["clone"]) for r in rows}) != len(rows):
        notice("inventory-duplicate", path=inventory)
        raise SystemExit(2)
    if any(not r["clone"].startswith("/") or not r["account"].startswith("/") for r in rows):
        notice("inventory-path", path=inventory)
        raise SystemExit(2)
    if len({r["repo"] for r in rows}) > 1:
        notice("inventory-repo", path=inventory)
        raise SystemExit(2)
    if args.verb == "list":
        for row in rows:
            state = remote(row, 'if test -f "$1/.git/lane-host-item"; then printf hosted; else printf available; fi', row["clone"])
            print(f"{row['repo']}/{row['item']}\t{state.stdout.decode()}\t-\t{row['target']}")
        return
    matches = [row for row in rows if row["item"] == args.item]
    if not matches:
        notice("item-unconfigured", item=args.item)
        raise SystemExit(2)
    row = matches[0]
    if args.verb == "create":
        if row["repo"] != args.repo:
            notice("repo-mismatch", item=args.item, repo=args.repo)
            raise SystemExit(2)
        create(row, args, Path(os.environ.get("LANE_HOST_SSH_SOURCE", os.getcwd())))
    elif args.verb == "cat":
        data = read(row, args.path)
        if data is None:
            raise SystemExit(2)
        sys.stdout.buffer.write(data)
    elif args.verb == "put":
        put(row, args.path, sys.stdin.buffer.read())
    elif args.verb == "append":
        append(row, args.path, sys.stdin.buffer.read())
    elif args.verb == "touch":
        remote(row, "true")
    elif args.verb == "stop":
        stop(row, args.item, args.harness)
    elif args.verb == "close":
        path = owned_worktree(row, args.item, "close")
        result = remote(row, '''drop_render_scratch() { rm -f -- "$owned" "$status" "$index" "$carried"; }
clean_render_drift() {
  dir="$1"; clone="$2"; item="$3"; label="$4"
  owned="$clone/tmp/render-owned-$label-$$.json"
  status="$clone/tmp/render-status-$label-$$"
  index="$clone/tmp/render-index-$label-$$"
  carried="$clone/tmp/render-carried-$label-$$"
  mkdir -p -- "$clone/tmp" || exit 1
  git -C "$dir" status --porcelain=v1 -z --untracked-files=all >"$status" || exit 1
  if ! test -s "$status"; then drop_render_scratch; return 0; fi
  (cd -- "$dir" && kendex generated-paths) >"$owned" || { drop_render_scratch; return 1; }
  jq -e 'type == "array" and all(.[]; type == "string")' "$owned" >/dev/null || {
    drop_render_scratch; return 1;
  }
  paths=(); tracked=(); untracked=()
  while IFS= read -r -d '' entry; do
    code="${entry:0:2}"
    path="${entry:3}"
    case "$code" in *R*|*C*) drop_render_scratch; return 3 ;; esac
    jq -e --arg path "$path" 'index($path) != null' "$owned" >/dev/null || {
      drop_render_scratch; return 3;
    }
    paths+=("$path")
    if git -C "$dir" ls-files --error-unmatch -- "$path" >/dev/null 2>&1; then
      tracked+=("$path")
    elif test -f "$dir/$path" || test -L "$dir/$path"; then
      untracked+=("$path")
    else
      drop_render_scratch; return 3
    fi
  done <"$status"
  test "${#paths[@]}" -gt 0 || { drop_render_scratch; return 3; }
  stamp=$(date -u +%Y%m%dT%H%M%SZ) || exit 1
  patch="$clone/tmp/render-drift-$item-$label-$stamp.patch"
  git -C "$dir" diff --binary HEAD -- "${paths[@]}" >"$patch" || exit 1
  if test "${#untracked[@]}" -gt 0; then
    empty=$(git -C "$dir" hash-object -t tree /dev/null) || exit 1
    (export GIT_INDEX_FILE="$index"; git -C "$dir" add --force -- "${untracked[@]}") || {
      drop_render_scratch; return 3;
    }
    (export GIT_INDEX_FILE="$index"; git -C "$dir" diff --binary --cached "$empty" -- "${untracked[@]}") >>"$patch" || exit 1
  fi
  git -C "$dir" -c core.quotePath=false apply --numstat -- "$patch" >"$carried" || {
    drop_render_scratch; return 3;
  }
  for path in "${paths[@]}"; do
    awk -F'\t' -v want="$path" '$3 == want { found = 1 } END { exit !found }' "$carried" || {
      drop_render_scratch; return 3;
    }
  done
  drop_render_scratch
  if test "${#tracked[@]}" -gt 0; then
    git -C "$dir" restore --staged --worktree -- "${tracked[@]}" || exit 1
  fi
  for path in ${untracked[@]+"${untracked[@]}"}; do rm -f -- "$dir/$path" || exit 1; done
  dirty=$(git -C "$dir" status --porcelain) || exit 1
  test -z "$dirty" || exit 1
}
for dir in "$1" "$2"; do
  if test "$dir" = "$2" && ! test -e "$dir" && ! test -L "$dir"; then continue; fi
  dirty=$(git -C "$dir" status --porcelain) || exit 1
  if test -n "$dirty"; then
    label=clone
    test "$dir" = "$1" || label=worktree
    clean_render_drift "$dir" "$1" "$3" "$label" || {
      rc=$?; test "$rc" -eq 3 || exit "$rc"; printf '%s\\n' "$dir"; exit 3;
    }
  fi
done
exec "$1/.agents/skills/orch/scripts/sync-base" "$1" >&2''', row["clone"], path, args.item, accept=(3,))
        if result.returncode == 3:
            notice("close-refused", path=result.stdout.decode().strip())
            raise SystemExit(3)
        result = remote(row, 'if test -e "$1" || test -L "$1"; then printf present; else printf absent; fi', path)
        archive_tmp(row, args.item, path)
        if result.stdout == b"present":
            worktree(row, "remove", args.item)
        remote(row, 'rm -f -- "$1/.git/lane-host-item"', row["clone"])


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError, tarfile.TarError) as error:
        notice("operation-failed", cause=type(error).__name__, path=getattr(error, "filename", None))
        raise SystemExit(1) from None
