#!/usr/bin/env bash
# The launch record a lane needs before anything writes to it, and the one
# owner of both halves of it. Usage, containment and exit statuses: --help.
#
# Both launchers called this before a copy of the rule each, and both copies
# read the containment differently from the mailbox's own owner. The rule kept
# here is lane-mail's, whose lm_plain allows a linked `tmp` because
# skills/worktree ships WORKTREE_SYMLINKS to make one, and a checkout can
# commit any of the components below it.
set -euo pipefail

# The item alphabet below is a byte range and the lower-casing is a byte map,
# so the locale decides what each one matches.
export LC_ALL=C

# Every line this script writes, and the only place its text lives: a stable
# key for the condition and the value acted on, then the English under it, then
# what a command this script ran wrote.
message() { # KEY VALUE [CAUSE]
  {
    printf 'lane-marker: %s=%s\n' "$1" "$2"
    case "$1" in
      args)
        echo "lane-marker takes WORKTREE ITEM with an optional resumed HARNESS SESSION pair, or --marker-path COMMON_GIT_DIR ITEM"
        ;;
      item)
        echo "the item is not spelled in the alphabet a work item is spelled in, ASCII letters, digits, dot, underscore and hyphen, and is never . or ..; refusing rather than composing a path it does not name"
        ;;
      git)
        echo "git $2 failed in that worktree, so the lane's root and the common git directory its marker belongs under are unknown:"
        ;;
      unsafe)
        echo "$2 is a symlink, or is not the kind of file it names. A launch that wrote through it would leave the lane's marker or its mailbox somewhere the lane never reads, so nothing is written. Remove it, or launch into a tree that does not carry it."
        ;;
      write)
        echo "$2 could not be written, so this lane has no launch record and would be handed no mail:"
        ;;
      read)
        echo "$2 could not be read to identify its session, so the launch cannot decide whether to keep its context reading:"
        ;;
    esac
    [ -z "${3:-}" ] || printf '%s\n' "$3"
  } >&2
}

refuse() { # KEY VALUE [CAUSE]
  message "$@"
  exit 2
}

usage() {
  cat << 'EOF'
Usage: lane-marker WORKTREE ITEM
       lane-marker WORKTREE ITEM HARNESS SESSION
       lane-marker --marker-path COMMON_GIT_DIR ITEM

Write a lane's launch record, both halves of it:

  <common git dir>/lane-mail/<item in lower case>   holds the lane's root
  <WORKTREE root>/tmp/lane-mail/<ITEM>              the lane's own mailbox

`lane-mail-check` reads the first to know a session is a launched lane and
resolves the item by the second, so a launch writes both or the lane is never
handed its mail and never judged on its handoff marks. A root the first half
binds with no `tmp/lane-mail` directory is refused as `lane-mail-check:
mailbox-missing=<path>` before every tool call and at every turn end until
that directory stands. Each launcher calls this: `open-terminal` locally,
`lane-host create` over its transport. The mailbox keeps `context.json` only
when HARNESS and the non-empty SESSION match its recorded identity. A launch
without that matching resumed identity clears the predecessor reading.
`--marker-path` writes
nothing, so a launcher using it empties that record over its own transport.

`--marker-path` prints the marker half's path under the common git directory
it is given and writes nothing. A launcher whose lane is on another machine
cannot run this script where the record belongs, and a path it composed for
itself would be a second spelling of the one this script writes.

Containment: four components must be plain, never a symlink and never another
kind of file. Under the common git directory, `lane-mail` and the marker in it;
under the worktree, `tmp/lane-mail` and the item's own directory in it. `tmp`
itself is left alone, because a worktree setup may link it. A component outside
that rule would put the marker or the mailbox somewhere the lane never reads,
and the refusal names the one that broke it.

Exit status:
  0  both halves stand, or `--marker-path` printed the path
  2  a component is not what it names, the item is outside the alphabet a work
     item is spelled in, a git or context read failed, or a write failed; the cause is one
     `lane-marker: <key>=<value>` line on stderr with the English under it
EOF
}

# The same alphabet lane-mail-check reads an item in, judged before the item
# reaches a path: the two compose the same directory names and a name outside
# it would name another one.
check_item() { # ITEM
  case "$1" in
    '' | . | ..) refuse item invalid ;;
    *[!A-Za-z0-9._-]*) refuse item invalid ;;
  esac
}

# Where the marker half belongs, composed here and nowhere else: the write
# below and the path a remote launcher asks for take the same answer, so a
# launcher writing over a transport cannot land its record beside the one the
# hook reads.
marker_path() { # COMMON_GIT_DIR ITEM
  local lower
  lower=$(printf '%s' "$2" | tr 'A-Z' 'a-z')
  printf '%s/lane-mail/%s\n' "$1" "$lower"
}

[ "${1:-}" != --help ] || { usage; exit 0; }

if [ "${1:-}" = --marker-path ]; then
  [ "$#" -eq 3 ] || refuse args "$#"
  check_item "$3"
  marker_path "$2" "$3"
  exit 0
fi

{ [ "$#" -eq 2 ] || [ "$#" -eq 4 ]; } || refuse args "$#"
WT="$1"
ITEM="$2"
HARNESS="${3:-}"
SESSION="${4:-}"
check_item "$ITEM"

COMMON_RC=0
COMMON=$(git -C "$WT" rev-parse --path-format=absolute --git-common-dir 2>&1) || COMMON_RC=$?
[ "$COMMON_RC" -eq 0 ] || refuse git 'rev-parse --git-common-dir' "$COMMON"
ROOT_RC=0
ROOT=$(git -C "$WT" rev-parse --show-toplevel 2>&1) || ROOT_RC=$?
[ "$ROOT_RC" -eq 0 ] || refuse git 'rev-parse --show-toplevel' "$ROOT"
MARKER=$(marker_path "$COMMON" "$ITEM")
BOX="$ROOT/tmp/lane-mail/$ITEM"

# Judged before anything is created, so a refusal leaves the tree as it was.
for path in "$COMMON/lane-mail" "$ROOT/tmp/lane-mail" "$BOX"; do
  { [ ! -L "$path" ] && { [ ! -e "$path" ] || [ -d "$path" ]; }; } || refuse unsafe "$path"
done
{ [ ! -L "$MARKER" ] && { [ ! -e "$MARKER" ] || [ -f "$MARKER" ]; }; } || refuse unsafe "$MARKER"

MADE=$(mkdir -p -- "$COMMON/lane-mail" "$BOX" 2>&1) || refuse write "$BOX" "$MADE"

# A resumed session keeps its context. The launcher supplies the selected
# identity; a fresh or different session cannot inherit this reading.
# The file's name is lib/lane-context.sh's, the one owner of that record.
# shellcheck source=lib/lane-context.sh
source "${BASH_SOURCE[0]%/*}/lib/lane-context.sh"
KEEP_CONTEXT=false
if [ -n "$SESSION" ] && [ -f "$BOX/$LANE_CONTEXT_RECORD" ] && [ ! -L "$BOX/$LANE_CONTEXT_RECORD" ]; then
  MATCH_RC=0
  MATCH=$(jq -e --arg harness "$HARNESS" --arg session "$SESSION" \
    'type == "object" and .harness == $harness and .session_id == $session' \
    "$BOX/$LANE_CONTEXT_RECORD" 2>&1) || MATCH_RC=$?
  case "$MATCH_RC" in
    0) KEEP_CONTEXT=true ;;
    1) ;;
    *) refuse read "$BOX/$LANE_CONTEXT_RECORD" "$MATCH" ;;
  esac
fi
if [ "$KEEP_CONTEXT" != true ]; then
  CLEARED=$(rm -f -- "${BOX:?}/$LANE_CONTEXT_RECORD" 2>&1) || refuse write "$BOX/$LANE_CONTEXT_RECORD" "$CLEARED"
fi

# The root lands through a temporary file renamed over the marker, so the write
# never follows a link a peer put there between the check above and here.
STAGED=$(mktemp "${MARKER%/*}/.${MARKER##*/}.XXXXXX" 2>&1) || refuse write "$MARKER" "$STAGED"
# A launch reaped between the write and the rename would leave that file beside
# the marker for ever, where the next launcher's mktemp has to step around it.
# The rename consumes it, so this removes nothing on the path that worked.
trap 'rm -f -- "${STAGED:?}"' EXIT
WROTE=$({ printf '%s\n' "$ROOT" > "$STAGED" && mv -f -- "$STAGED" "$MARKER"; } 2>&1) ||
  refuse write "$MARKER" "$WROTE"
