#!/usr/bin/env bash
# lanes — enumerate the harness auth "lanes" on this machine and measure each
# one's live usage, so a fleet launch can pick the account with real headroom
# instead of relying on supervisor memory.
#
# One account can back several sessions, so an account-level limit can stall
# several workers at once.
#
# SCOPE: mechanism only — inventory, measurement, and a default chooser.
# Policy (which model/effort tier, per-lane preferences, reserve thresholds)
# belongs in each consumer's own wrapper, because it is the part that differs
# per project. This deliberately exposes the numbers rather than deciding with
# them.
#
# Usage:
#   lanes list [--harness claude|codex|all] [--local] [--no-cache] [--json]
#   lanes pick [--harness claude|codex] [--max-pct N | --min-headroom-pct N]
#              [--model NAME] [--binding-floor] [--exclude-lane DIR]
#              [--no-cache] [--json]
#   lanes pick --lane <config-dir> [--harness claude|codex]
#              [--max-pct N | --min-headroom-pct N] [--model NAME]
#              [--binding-floor] [--no-cache] [--json]
#   lanes host-accounts [--harness claude|codex|all] [--no-cache] [--json]
#   lanes context [--json]
#   lanes check <config-dir|name>
#   lanes state <item> [--json]
#
#   list  Print every lane found, measured, with its live claim count and the
#         age of its usage figure. A lane whose access token has expired is
#         RENEWED first and then measured like any other, its record marked
#         `refreshable`; one that cannot be renewed reports the status its
#         refusal took, with the cause. Table by default, --json for the
#         structured record. Each --json record carries `verdict`: `room`,
#         `walled` or `unmeasured`, its binding bucket judged against
#         ORCH_LANE_MAX_PCT by the rule `pick` with no --model refuses on, so
#         a reader of the listing never holds a second copy of that threshold
#         or its default.
#         The STATUS words are `ok`; `rate_limited`, an endpoint that answered
#         HTTP 429; `unreachable`, one that answered 5xx or that nothing could
#         be read from at all, or a renewal another tool's credentials lock kept
#         from being tried; `expired`, a login proven dead; `no_credentials`;
#         `no_usage_data`, authenticated with no window to measure; `retired`;
#         and `error`, a step this machine failed on its own, a renewal's
#         included. A lane whose usage REFRESH met a 429 while the host still
#         holds a figure for it younger than the 5-hour session window reports
#         `rate_limited` ON that figure, with its age in the AGE column, and is
#         judged on it; with no such figure it carries no window. Only `ok`
#         and a `rate_limited` lane carrying a figure are pickable. The split
#         matters because
#         `expired` is the one word an operator answers by logging in again —
#         `open-terminal` turns it into exactly that remedy line — so a refusal
#         the account will survive never takes it, and every refusal an endpoint
#         answered names its HTTP code in the record's `detail`.
#         Where ORCH_LANE_HOST names a provider that implements the OPTIONAL
#         `accounts` verb, its answer is merged in: one further row per account
#         the PROVIDER holds a credential for, carrying the windows read
#         through that credential. A provider without the verb answers exit 2,
#         which is no answer rather than a failure, and the listing is then the
#         local reading alone with nothing on stderr.
#         Every row says which credential measured it, in `measured_through`
#         (the THROUGH column): `local` for this machine's config dir, `host`
#         for the provider's own copy. The two readings of one account can
#         disagree — a local copy that can no longer be renewed reads
#         `expired` while the host's keeps working — and a launch on that
#         provider runs under the host's. A fleet with no provider lists the
#         local config dirs alone, as before.
#   host-accounts  Print the accounts the CONFIGURED PROVIDER reports holding a
#         credential for, one validated row per account, as `list` reads them:
#         the same field rules, the same account-and-harness requirement and the
#         same dropped row for a field nothing can parse. This is the only
#         reader of the `accounts` protocol, so a caller asking whether the host
#         holds an account inherits that validation instead of matching the
#         provider's bytes for itself. Tab-separated `config-dir` and `harness`
#         by default, `@tsv`-escaped, so a value carrying a tab, newline or
#         backslash is printed escaped; --json prints the whole records, each
#         marked `measured_through: "host"`, and is the exact form a caller
#         comparing a config dir reads. Exit 0 is an answer, rows or none; 2 is a
#         provider that does not implement the optional verb, with nothing on
#         stderr; 1 is the verb failing, the provider's own message first and
#         this script's keyed line under it. ORCH_LANE_HOST must name a
#         provider: `local` is refused rather than answered as an absent verb.
#         The answer is cached under ORCH_LANES_USAGE_TTL and time-bounded by
#         ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S; --no-cache asks the provider now,
#         which is what a caller deciding a launch gate passes, and is refused
#         as `host-accounts-unbounded` on a machine with no timeout command to
#         bound that wait with.
#   pick  Print the launch env prefix for the lane to launch on (e.g.
#         `CLAUDE_CONFIG_DIR=/home/me/.eclaude`): among the lanes under
#         --max-pct, the one with the fewest launches already in flight, the
#         room under that same threshold breaking the tie. --json prints that
#         lane's whole record, which carries headroom_pct, binding_bucket
#         (session, weekly or model), the matching binding_resets_at, and
#         qualifying_count from that same judgement. With
#         --model those fields name the most-consumed
#         bucket among the shared 5-hour window, the all-model weekly window,
#         and the named model's scoped weekly window. Exit 3 when no lane
#         qualifies, so a caller can fail closed rather than launch into a
#         wall; its keyed line on stderr says how many candidates were WALLED
#         at or above --max-pct and how many measured nothing for the launch,
#         and `no-candidate-unmeasured` is every candidate unmeasured, which is
#         a read to fix rather than an allowance to wait out. Under --json
#         that exit also prints `{"walled":N,"unmeasured":N}` on stdout, the
#         same two counts, so a caller walking several picks can report what
#         each sweep found instead of parsing the message written for a person.
#
#         With --lane <config-dir> it judges that ONE account instead of
#         choosing among the fleet, measuring only that directory. A launcher
#         that was handed a lane asks this rather than rebuilding the rule.
#         Exit 0 has room and prints the env prefix, or the lane's record under
#         --json; 3 is a wall at or above --max-pct; 5 is a lane nothing
#         measured for this launch, whether no window names --model or the
#         account's usage could not be read at all, and under --json its record
#         is printed too, whose `status` says which; 4 is a directory that is no
#         configured lane of this harness, which a launcher reads as nothing to
#         judge rather than as a refusal; 1 is the judge itself failing, on a
#         measurement or on a --max-pct this parser refused. Every exit but 0
#         puts its keyed line on stderr. A claim store that could not be read is
#         a NOTICE on stderr and no exit of its own: this form judges the wall,
#         which no claim count enters, and the record's `claims` is null. The
#         record printed on 3 under --json carries `wall`, the percentage
#         judged, so a caller names what it refused on.
#   context  Print each LIVE WORK LANE's context use, as its own turn-end
#         hook recorded it: the tokens the last response left in the
#         context, read from the transcript by the harness adapter
#         (lib/lane-context.sh), and the window its model has. No pane is
#         read. A lane's reading is in its own mailbox, which the running
#         lane record of the fleet state (`workflow-state get oversee`)
#         places, read through its host where that record names one; the
#         caller's own row with no lane record is the overseer, read from
#         the overseer mailbox and only where the reading names this pane.
#         CONTEXT_USED_PCT is the share of that window CONSUMED, and a row
#         with no reading is `unrecorded`, never empty. HANDOFF is
#         `required` at or past ORCH_HANDOFF_CONTEXT_PCT of the window
#         (default 90), the judge the hook uses, or at a HEADROOM at or
#         below ORCH_HANDOFF_HEADROOM_PCT (default 3).
#         --json carries `binding_resets_at` beside it, the time the account's
#         binding bucket frees up, as whole-second UTC with a Z for either
#         harness, so a caller refusing on headroom can say when the account
#         comes back. It also carries `server`, the tmux server the row's
#         `pane` belongs to, since pane ids restart at %0 on every server.
#         The caller's OWN pane is reported too, claim or no claim, so an
#         overseer started by hand sees its own figure rather than an empty
#         fleet, and that row alone carries `caller: true` — the report says
#         which row is the reader's session so no reader has to work it out.
#   state  Print what the lane for <item> is doing, as the one word
#          lib/lane-state.sh judges it to be: working, idle, asking, walled,
#          exited or unjudged. <item> is the lane's tmux window name, which is
#          the tracker id (TEAM-N) or gh-N; the SESSION:WINDOW form a lane
#          record's `window` carries is accepted too, and names that window
#          under exactly that session. Pass the record's `window` as it stands:
#          the whole name selects the pane, and its window part alone is the
#          item the hosted probe below names. The lane's pane on this tmux server
#          is the whole reading, so this answers exactly as oversee-watch does
#          about the same lane. A name no pane on this server carries is
#          `unjudged`: a window that closed and a name two windows share are
#          the same silence from here. `gone` is the judge's answer for a
#          window a caller has already found absent, which this verb never
#          asserts, so it is not among the words printed here. Where
#          ORCH_LANE_HOST names a provider, `lane-host touch` then says whether
#          the HOST answers; a failed probe prints `lanes: host-unreachable`
#          on stderr with the provider's own message, one lane-host refused at
#          its per-home cap `lanes: lane-host-busy`, and either leaves the state
#          alone. --json prints {"item":..,"state":..}. Exit 1 when a scan
#          failed rather than answered.
#   check  Exit 0 when no lane setting excludes or retires <config-dir>, or the
#         lane a bare name or alias names; exit 4 with `lanes: lane-excluded`
#         or `lanes: lane-retired` when one does, so a caller can tell a
#         covered lane from a failure (exit 1). Nothing inside the directory is
#         read. `open-terminal` asks it for every named --lane.
#
# Options:
#   --harness NAME   claude, codex, or all (default: all for list, claude for pick)
#   --max-pct N      pick: refuse a lane whose binding bucket is at or above N
#                    percent used (default: 95, or $ORCH_LANE_MAX_PCT). The
#                    setting is read through the kendex settings ladder below,
#                    so the launch gate and a pick typed by hand hold one
#                    threshold; the flag still overrides it.
#   --min-headroom-pct N  pick: the same bound in the record's own unit, the
#                    `headroom_pct` every row carries: keep only a lane with
#                    MORE than N percent headroom, so one sitting exactly at N
#                    is refused. It is converted to --max-pct once, so both
#                    spellings reach the one comparison and the last one passed
#                    wins.
#   --lane DIR       pick: judge that one config dir instead of choosing among
#                    the fleet; no other lane is measured
#   --model NAME     pick: judge the bound against the bucket that walls a
#                    launch on NAME — the 5-hour session window, the plan-wide
#                    weekly window, and the model-scoped weekly window whose
#                    label names NAME — instead of the binding bucket. A lane
#                    whose windows answer nothing for NAME is never picked.
#                    The scoped model window alone is not enough because either
#                    shared window can wall every model on the account.
#   --binding-floor  pick: hold the account's own binding bucket to the same
#                    bound as well, so a lane is room only where BOTH clear it.
#                    With --model the two can differ: an account whose binding
#                    bucket is a model this launch will not pass has room for
#                    the launch and none of its own. Pass it for a caller whose
#                    launched session will be judged on the binding bucket
#                    rather than on --model — every codex session, which
#                    lib/lane-context.sh judges on its binding bucket. A session that
#                    WILL be judged on --model is already held to the reading
#                    it takes, and the flag would then refuse it an account
#                    over a window neither judgement reads. Without --model the
#                    binding bucket is the judged wall, so the flag asks for
#                    what is judged anyway.
#   --exclude-lane DIR  pick: omit this config dir before the chooser judges
#                    the remaining accounts. Used when the caller needs a
#                    different account rather than capacity on its own.
#   --local          list: this machine's config dirs alone. The provider is
#                    not asked, so a caller looking a config dir up by alias
#                    costs no round trip and meets no hosted row.
#   --no-cache       Fetch every lane's usage afresh instead of reusing a
#                    cached figure; the fresh figure still refreshes the cache.
#                    A RECORDED REFUSAL is not a cached figure and is not
#                    bypassed: an operator asking for a fresh reading must not
#                    be the one caller on the host that posts again what the
#                    endpoint has already refused. A lane the usage endpoint
#                    refuses with 429, on record or on this run's own fetch,
#                    is still answered from the last figure the host holds,
#                    as `rate_limited` with its age in the AGE column. It
#                    still takes the host-wide refresh lock.
#   --max-age SECS   Serve a cached usage figure up to SECS old, for a caller
#                    naming its own pass interval. It WIDENS
#                    ORCH_LANES_USAGE_TTL and never narrows it, so a caller
#                    passing nothing, or less than the TTL, keeps the TTL. A
#                    TTL of 0 is never widened: every run still fetches.
#                    ORCH_LANES_USAGE_MAX_AGE is the same value as a setting.
#   --json           Machine-readable output
#
# The lane INVENTORY is always discovered, never hand-maintained: config is an
# overlay on top of it, so adding an account needs no edit anywhere. Discovery
# is `~/.claude` plus every `~/.*claude*` directory, and `~/.codex` plus every
# `~/.*codex*` directory plus $CODEX_HOME when it is set; a discovered directory
# with no config marker (claude `.claude.json` or `.credentials.json`, codex
# `auth.json` or `config.toml`) is skipped. A setting names a lane
# by its directory name, with or without the leading dot, or by its alias; a
# name carrying `/` or `~` is a path, names no lane, and is refused.
#   ORCH_LANE_ALIASES  Comma-separated `<config-dir-name>=<alias>` pairs giving
#                      lanes meaningful names (`eclaude=work,mclaude=overflow`).
#                      A directory with no mapping keeps its discovered name.
#   ORCH_LANE_DIRS     Colon-separated config dirs, for a layout discovery does
#                      not reach. An entry holding auth.json and no
#                      .credentials.json is a Codex lane; any other entry is a
#                      Claude lane. A harness's entries replace its discovery;
#                      a harness with no entry is still discovered. An excluded
#                      or retired entry is never probed: a name holding `codex`
#                      is a Codex entry, any other a Claude one, and it still
#                      turns that harness's discovery off.
#   ORCH_LANE_EXCLUDE  Comma-separated lane names (`sclaude,claude`) that are
#                      never listed, measured or picked: nothing inside an
#                      excluded directory is read, not even to tell its harness.
#   ORCH_LANE_RETIRE   Comma-separated `<name>=<YYYY-MM-DD>` pairs
#                      (`nclaude=YYYY-MM-DD`). The lane is picked until that
#                      UTC date; from it on, `list` shows it as `retired` and
#                      nothing inside it is read. A malformed pair, or a date
#                      naming no calendar day, is refused.
#                      Both reach an account a lane host reports as well as a
#                      config dir on this machine: the setting says the account
#                      is not this fleet's to use, which a copy of it on another
#                      machine does not change.
#   ORCH_LANE_MAX_PCT  The default of --max-pct (default 95), read against the
#                      binding bucket or, with --model, against the window that
#                      walls that model, and never compared with
#                      ORCH_HANDOFF_HEADROOM_PCT. Refused, before any lane is
#                      measured, when it is not an integer 0-100.
#   ORCH_LANES_USAGE_TTL  Seconds a cached usage figure is reused (default 300;
#                      0 fetches every run). Keep it at least the longest watch
#                      interval on the host — `oversee-watch --interval`
#                      defaults to 240 — because a TTL under that interval has
#                      every pass find the figure expired and fetch again. The
#                      provider's `accounts` answer is cached under the same
#                      TTL.
#   ORCH_LANES_USAGE_MAX_AGE  The default of --max-age (default 0, which is the
#                      TTL alone): the caller's own pass interval, in seconds.
#                      A pass longer than the TTL serves its last figure rather
#                      than fetching on every pass.
#   ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S  Seconds the provider's `accounts` verb
#                      may take (default 10; 0 asks for no bound). Applied
#                      where `timeout` or `gtimeout` is installed. A bound
#                      reached is the verb failing, reported as
#                      `host-accounts-unreadable`. A bounded call waits for a
#                      lane-host slot for less than the bound, so a full
#                      ORCH_LANE_HOST_MAX_CALLS cap reads as `lane-host-busy`
#                      rather than as the bound. Where neither spelling is
#                      installed, a CACHED read runs unbounded and the cache
#                      holds its cost to one call per TTL, while a `--no-cache`
#                      read is refused as `host-accounts-unbounded` rather than
#                      waiting: the cache covers a listing, not a read that
#                      asked to ask the provider now.
#   ORCH_LANES_CLAUDE_CLIENT_ID  The OAuth client id the renewal posts with.
#                      Required for it: with this unset every Claude account
#                      whose access token has expired reads `error` with the
#                      cause `no OAuth client id is configured`, and `pick`
#                      refuses every one of them. Set it once per host.
# All read through the kendex settings ladder (process env > .env.local >
# .kendex/settings.toml / kendex.settings.toml [env]).
#
# USAGE CACHE: each fetched usage body is written to $OVERSEE_WATCH_STATE_DIR/
# usage/<harness>-<config dir checksum>.json (else <project root>/tmp/
# oversee-watch/usage, beside the claim store) and reused while younger than
# ORCH_LANES_USAGE_TTL, or than --max-age where that is longer, so every
# overseer sharing that directory polls an account at most once per window.
# `usage_age_s` (the AGE column) is how old the figure is. Credentials are
# still read every run: an expired token is renewed or reports its refusal,
# whatever the cache holds. A fresh write keeps the displaced figure as
# `prior`; lane records expose the binding bucket's rate and projected wall
# after samples at least a minute apart.
#
# The refresh itself is HOST-WIDE SERIALIZED: a lane its record cannot answer
# takes one lock, `.usage-refresh.lock` in that same directory, over its
# refresh and re-reads the record inside it. Two readers arriving together are
# therefore one refresh of each account, not two, which is what the TTL alone
# cannot do: without the lock every caller's fetch lands in the same second at
# TTL expiry. A lane the record can answer, with a figure or a live refusal,
# never takes the lock and never waits. A lock that does not come free within
# 10 seconds is a keyed notice and the lane is refreshed anyway, because
# refusing it on contention is the same wall that serving a stale figure exists
# to prevent.
#
# A caller with no OVERSEE_WATCH_STATE_DIR falls back to <project root>/tmp/
# oversee-watch, so two callers run from DIFFERENT CHECKOUTS with that variable
# unset share neither the cache nor the lock and each pays the full burst. Set
# it once per host to be inside the bound.
#
# A fetch that could not be RUN is never cached, but one an endpoint REFUSED is:
# the record then holds a short negative entry — the status the refusal took,
# its HTTP code, the cause, and the instant the window closes — and while that
# window is open no caller on the host posts to that endpoint for that lane
# again. The window is the answer's own Retry-After where it named one in
# seconds, and USAGE_REFUSAL_WINDOW_S where it did not. Re-posting is what
# sustains a rate limit, so every watch pass on the host reads the record
# instead of asking again. The last figure the record held stays beside the
# refusal, so a usage 429 is answered from it: the lane reports `rate_limited`
# on that figure while it is younger than the 5-hour session window. With no
# such figure, the first such lane in a run retries once, after the window or
# 5 seconds whichever is shorter, so that retry is the one request posted
# inside a recorded window; a later cold lane in the same run reports its
# refusal at once. The record returns to a figure alone the moment the
# endpoint answers again.
# The lane host's `accounts` answer shares that cache and TTL, under
# `host-accounts-<provider path checksum>.json`: one record per provider rather
# than per account, since one answer covers every account it names. The
# absent-verb answer is cached too, so a provider that will never implement the
# verb stops paying a fork per invocation; a FAILED verb is never cached.
# `--no-cache` refreshes it, and `host-accounts` passes that flag from
# `open-terminal`, whose read decides a launch gate rather than reporting a
# figure. Such a read is refused where nothing can bound it, since the cache it
# declined is what covers an unbounded call everywhere else.
#
# CLAIMS are the launches already in flight on a lane: `open-terminal` records
# one per tmux lane it launches under a resolved lane, and a claim is live
# while its pane is (stored under $OVERSEE_WATCH_STATE_DIR/claims, else
# <project root>/tmp/oversee-watch/claims; a claim whose pane is gone is
# pruned on read). Usage numbers lag a launch by minutes, so `pick` called
# twice in a row would hand the same account both lanes; the claim count is
# the correction, and it orders `pick` ahead of headroom.
#
# LAUNCHERS decide how a picked lane reaches the harness. A command named for
# the lane's config directory — its basename without the leading dot, so
# `1claude` for `~/.1claude` — selects the account itself, and where PATH holds
# one the launch goes through it and sets no environment variable at all. Every
# launcher asks one judge, `lib/lane-launch.sh`, so `open-terminal` and
# `oversee-succeed` build the same command for the same lane. The name must
# carry the harness word without being it: `~/.claude` and
# `~/.codex` name the harness binary, which is the thing being configured rather
# than a configurator, and a codex lane launched under `--harness claude` names
# the wrong binary entirely; both take the variable instead.
#
# Such a wrapper exports CLAUDE_CONFIG_DIR or CODEX_HOME for its OWN name, which
# is why it cannot be combined with a variable: in front of it the variable is
# overwritten and the lane silently runs on another account. The variable is the
# form used only where no such command exists.
#
# Where the platform reports a process environment, the launcher then reads the
# launched harness's environment and closes a window whose account disagrees
# with the pick. Where it does not, it says so by name and the launch stands, so
# the launcher rule is the whole defence.
#
# Headroom is `100 - max(session_5h, weekly, model_weekly)`: the BINDING
# constraint, not an average. An account at 5% session but 95% weekly has 5%
# headroom, and averaging would have called it 50% and sent the fleet into it.
#
# MODEL-SCOPED windows are per model, and an account can carry several. Headroom
# takes the most-consumed one, which is the right answer for a launch whose
# model is not yet decided; a launch that HAS a model asks `pick --model` for
# the window scoped to it, since the account with weekly room can still have
# none left for that one model and the launch's first turn is a usage banner.
#
# Why the renewal names itself:
#   platform.claude.com answers HTTP 429 `rate_limit_error` to a token POST
#   carrying no User-Agent, whatever the rate, and matches on the `claude-cli/`
#   prefix without parsing the version. Claude Code sends
#   `claude-cli/<version> (external, cli)`, which is why an interactive launch
#   renews an account this script could not. The version is read from the
#   installed `claude` once per measuring shell, with a fallback where PATH
#   holds none, since the endpoint does not read it.
#
# Why the renewal is unconditional:
#   Refreshing rotates the refresh token in the credentials file, which other
#   tools on the machine share (a Waybar usage widget doing the same thing is
#   the reference case), so the write takes the same lock the reference
#   implementation uses and re-reads the credentials under it. Leaving the
#   renewal opt-in instead left every idle account reading `expired` and `pick`
#   choosing nothing, which is the failure it exists to prevent.
#
# Credentials never reach argv: `ps` and journald can read /proc/<pid>/cmdline,
# which on Linux is world-readable while /proc/<pid>/environ is not. Bearer
# tokens go to curl over stdin via `-K -`, and the refresh and access tokens
# reach jq through the environment rather than `--arg`.
#
# Testing: ORCH_LANES_FETCH_CMD takes `<harness> <config_dir>` on argv;
# ORCH_LANES_TOKEN_CMD takes the token request body on stdin and reads the
# User-Agent the POST would have carried from LANES_USER_AGENT in its
# environment. Both print what their network call prints: the HTTP status and
# any Retry-After on the FIRST line, separated by a space, and the response body
# under it. A command that exits non-zero is the call failing outright, which
# names no status at all. The network layer is the only impure part; everything
# else is pure parsing.

set -uo pipefail

PROG="lanes"
# Exported so the loader cannot reassign it: it snapshots exported names before
# reading any project file and re-asserts them after, which is how a script says
# a name is its own and not a setting. A parsed settings [env] key redirecting
# SCRIPT_DIR would otherwise choose which lib this sources.
export PROG

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

print_lanes_usage() {
	sed -n '/^# Usage:/,/^# Headroom/p' "$0" | sed 's/^# \{0,1\}//'
}

print_lanes_index() {
	sed -n '/^# Usage:/,/^# Options:/p' "$0" | sed 's/^# \{0,1\}//'
}

# Callers preserve positional values for this diagnostic catalog.
message() {
  local _message_key="$1"
  shift
  case "$_message_key" in
    missing-jq)
      printf 'lanes: missing-jq exit=%s\n' "1"
      printf '%s\n' "jq is required"
      ;;
    pick-claims)
      printf 'lanes: pick-claims exit=%s\n' "1"
      printf '%s\n' "in-flight lane claims could not be read; refusing to pick (fix the claims directory, or set OVERSEE_WATCH_STATE_DIR)"
      ;;
    refusal-unrecorded)
      printf 'lanes: refusal-unrecorded dir=%s\n' "$1"
      printf '%s\n' "an endpoint's refusal could not be recorded, so every caller on this host posts to it again until one can (fix the state directory, or set OVERSEE_WATCH_STATE_DIR)"
      ;;
    pick-lane-claims)
      printf 'lanes: pick-lane-claims claims=%s\n' "null"
      printf '%s\n' "in-flight lane claims could not be read; this lane's claims field is null and its wall verdict stands (fix the claims directory, or set OVERSEE_WATCH_STATE_DIR)"
      ;;
    missing-value)
      printf 'lanes: missing-value arg1=%s\n' "$1"
      printf '%s\n' "$1 requires a value"
      ;;
    unknown-option)
      printf 'lanes: unknown-option arg1=%s\n' "$1"
      printf '%s\n' "unknown option: $1"
      ;;
    invalid-percent)
      printf 'lanes: invalid-percent option=%s\n' "$1"
      printf '%s\n' "$1 must be an integer 0-100"
      ;;
    pick-lane-walled)
      printf 'lanes: pick-lane-walled lane=%s wall=%s bucket=%s max-pct=%s\n' "$1" "$2" "$3" "$4"
      printf '%s\n' "that account's window for this model is at or above the threshold; launching it would open on a usage banner"
      ;;
    pick-lane-unmeasured)
      printf 'lanes: pick-lane-unmeasured lane=%s model=%s\n' "$1" "$2"
      printf '%s\n' "no window of that account measures this model, and an unmeasured window is not an empty one"
      ;;
    pick-lane-unlisted)
      printf 'lanes: pick-lane-unlisted lane=%s harness=%s\n' "$1" "$2"
      printf '%s\n' "that directory is no configured lane of this harness, so this script holds no record to judge it by"
      ;;
    pick-lane-failed)
      printf 'lanes: pick-lane-failed lane=%s step=%s\n' "$1" "$2"
      printf '%s\n' "that lane could not be measured; an unread window is never read as an empty one"
      ;;
    invalid-harness)
      printf 'lanes: invalid-harness option=%s\n' "--harness"
      printf '%s\n' "--harness must be claude, codex, or all"
      ;;
    invalid-pick-harness)
      printf 'lanes: invalid-pick-harness option=%s\n' "--harness"
      printf '%s\n' "pick --harness must be claude or codex"
      ;;
    invalid-retire)
      printf 'lanes: invalid-retire entry=%s\n' "$1"
      printf '%s\n' "ORCH_LANE_RETIRE entries must be <name>=<YYYY-MM-DD>; a lane whose retirement cannot be read is not picked on a guess"
      ;;
    lane-scan-failed)
      printf 'lanes: lane-scan-failed item=%s\n' "$1"
      printf '%s\n' "the lane's pane could not be searched; its state is unknown, not idle"
      ;;
    host-accounts-unreadable)
      printf 'lanes: host-accounts-unreadable host=%s exit=%s\n' "$1" "$2"
      printf '%s\n' "the provider failed the accounts verb it implements, so nothing here says which accounts the host holds and a listing carries only the credentials on this machine; whatever the provider wrote is above this line, and exit 124 is the ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S bound, which leaves nothing there. The verb is optional: a provider that does not implement it exits 2 and is reported nowhere"
      ;;
    host-accounts-unbounded)
      printf 'lanes: host-accounts-unbounded host=%s bound-s=%s\n' "$1" "$2"
      printf '%s\n' "the accounts verb was asked for without the cache, and neither timeout nor gtimeout is installed to bound it; a provider that never answered would hold this read open, so it was not asked. Install coreutils, or set ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S=0 to accept an unbounded wait"
      ;;
    host-accounts-local)
      printf 'lanes: host-accounts-local host=%s\n' "local"
      printf '%s\n' "ORCH_LANE_HOST names no provider, so there is no host copy of any account to report; a provider that does not implement the accounts verb exits 2 instead, which is a different answer"
      ;;
    host-accounts-render-failed)
      printf 'lanes: host-accounts-render-failed host=%s exit=%s\n' "$1" "$2"
      printf '%s\n' "the provider's rows were read but could not be rendered, so no account is printed rather than some of them; this is jq failing, not the provider"
      ;;
    host-accounts-merge-failed)
      printf 'lanes: host-accounts-merge-failed host=%s exit=%s\n' "$1" "$2"
      printf '%s\n' "the provider's rows were read but could not be folded into this listing, which therefore carries only the credentials on this machine; this is the merge failing, not the provider"
      ;;
    host-account-invalid)
      printf 'lanes: host-account-invalid account=%s field=%s\n' "$1" "$2"
      printf '%s\n' "the provider's accounts row carries a field this script cannot read, so the row is left out rather than listed on a guess"
      ;;
    lane-host-busy)
      printf 'lanes: lane-host-busy step=%s item=%s\n' "$1" "$2"
      printf '%s\n' "lane-host refused the provider call at its per-home cap on provider calls, and its own line is above; the provider ran nothing, so this says nothing about the host. Ask again"
      ;;
    host-unreachable)
      printf 'lanes: host-unreachable item=%s state=%s\n' "$1" "$2"
      printf '%s\n' "the host provider did not answer the touch probe; the state names what this machine could read of the lane and says nothing about the host, and the provider's own message follows"
      [ -z "$3" ] || printf '%s\n' "$3"
      ;;
    invalid-usage-ttl)
      printf 'lanes: invalid-usage-ttl value=%s\n' "$1"
      printf '%s\n' "ORCH_LANES_USAGE_TTL must be a whole number of seconds"
      ;;
    invalid-accounts-timeout)
      printf 'lanes: invalid-accounts-timeout value=%s\n' "$1"
      printf '%s\n' "ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S must be a whole number of seconds; 0 asks for no bound"
      ;;
    invalid-usage-max-age)
      printf 'lanes: invalid-usage-max-age value=%s\n' "$1"
      printf '%s\n' "--max-age and ORCH_LANES_USAGE_MAX_AGE must be a whole number of seconds; it widens ORCH_LANES_USAGE_TTL for this caller and never narrows it"
      ;;
    usage-lock-timeout)
      printf 'lanes: usage-lock-timeout lock-file=%s wait-s=%s\n' "$1" "$2"
      if [[ -d "$1.d" ]]; then
        printf '%s\n' "the host-wide usage refresh lock is held by another reader and did not come free, so this run refreshed the account without it and the usage endpoint may see two requests for it. If no lane reader is running, remove it: rmdir '$1.d'"
      else
        printf '%s\n' "the host-wide usage refresh lock is held by another lane reader and did not come free, so this run refreshed the account without it and the usage endpoint may see two requests for it. The lock frees when that reader exits"
      fi
      ;;
    usage-lock-unopenable)
      printf 'lanes: usage-lock-unopenable lock-file=%s\n' "$1"
      printf '%s\n' "the host-wide usage refresh lock file could not be opened, so this run measured without it and the usage endpoint may see two refreshes of the same accounts; check the usage cache directory, or set OVERSEE_WATCH_STATE_DIR"
      ;;
    invalid-handoff-headroom) printf 'lanes: invalid-handoff-headroom value=%s\nORCH_HANDOFF_HEADROOM_PCT must be an integer 0-100\n' "$1" ;;
    invalid-lane-max-pct) printf 'lanes: invalid-lane-max-pct value=%s\nORCH_LANE_MAX_PCT must be an integer 0-100\n' "$1" ;;
    time-failed)
      printf 'lanes: time-failed clock=%s\n' "UTC"
      printf '%s\n' "the current UTC date could not be read; no retirement can be judged without it"
      ;;
    invalid-exclude)
      printf 'lanes: invalid-exclude entry=%s\n' "$1"
      printf '%s\n' "ORCH_LANE_EXCLUDE entries are lane names or aliases; a path names no lane, so the account it meant to exclude would be read"
      ;;
    lane-excluded)
      printf 'lanes: lane-excluded dir=%s\n' "$1"
      printf '%s\n' "ORCH_LANE_EXCLUDE names this lane; nothing launches under it"
      ;;
    lane-retired)
      printf 'lanes: lane-retired dir=%s date=%s\n' "$1" "$2"
      printf '%s\n' "ORCH_LANE_RETIRE retired this lane; nothing launches under it"
      ;;
    context-claims)
      printf 'lanes: context-claims exit=%s\n' "1"
      printf '%s\n' "in-flight lane claims could not be read; refusing to report context (fix the claims directory, or set OVERSEE_WATCH_STATE_DIR)"
      ;;
    invalid-handoff-context)
      printf 'lanes: invalid-handoff-context value=%s\n' "$1"
      printf '%s\n' "ORCH_HANDOFF_CONTEXT_PCT must be a whole number of percent from 1 to 100"
      ;;
    context-fleet)
      printf 'lanes: context-fleet item=%s\n' "$1"
      printf '%s\n' "the fleet state's lane records could not be read, so no lane's mailbox, where its turn-end hook records its context, can be found; refusing to report context rather than report every lane unrecorded"
      ;;
    unknown-subcommand)
      printf 'lanes: unknown-subcommand SUB=%s\n' "$SUB"
      printf '%s\n' "unknown subcommand: $SUB (expected list, pick, host-accounts, check, context, or state)"
      ;;
    settings-rejected)
      printf 'lanes: settings-rejected path=%s\n' "$PROJECT_ROOT"
      printf 'The settings load failed. No lane can be selected from partial settings.\n'
      ;;
    no-candidate)
      printf 'lanes: no-candidate harness=%s max-pct=%s model=%s walled=%s unmeasured=%s\n' "$1" "$2" "$3" "$4" "$5"
      printf 'No lane has room for this launch. Lanes considered:\n'
      ;;
    no-candidate-unmeasured)
      printf 'lanes: no-candidate-unmeasured harness=%s model=%s unmeasured=%s\n' "$1" "$2" "$3"
      printf 'No window of these accounts measures this model, and an unmeasured window is not an empty one. Lanes considered:\n'
      ;;
  esac
}

die() {
  message "$@" >&2
  exit 1
}

need_jq() { command -v jq >/dev/null 2>&1 || die missing-jq; }

# ── Enumeration ──────────────────────────────────────────────────────────────
#
# A lane is a config directory holding harness credentials. Claude keeps them in
# `<dir>/.credentials.json`, Codex in `<dir>/auth.json`.
#
# Discovery is by convention — `~/.claude` plus any `~/.*claude*` directory, and
# the same for codex — because that is how multi-account setups on this machine
# are actually laid out (a per-account config dir plus a shell alias that
# exports CLAUDE_CONFIG_DIR or CODEX_HOME). ORCH_LANE_DIRS overrides discovery
# for each harness it holds an entry of, for a setup that does not follow it.
#
# Exclusion is applied where a directory is first named, and retirement before
# anything looks inside it: an excluded account is one agents must not touch,
# and even the credentials-file probe that tells an ORCH_LANE_DIRS entry's
# harness is a look.
#
# A discovered directory is a lane only when it holds its harness's config
# marker (claude `.claude.json` or `.credentials.json`, codex `auth.json` or
# `config.toml`): a shared session store or a backup matches the glob too. A
# marked directory WITHOUT credentials is still listed, with
# status=no_credentials, so a mis-set config dir stays visible. ORCH_LANE_DIRS
# entries and $CODEX_HOME are named on purpose and skip the marker check.

# Trim the surrounding whitespace a comma-separated list invites.
trim() {
	local s="$1"
	s="${s#"${s%%[![:space:]]*}"}"
	printf '%s' "${s%"${s##*[![:space:]]}"}"
}

# The non-empty, trimmed items of a comma-separated setting, one per line.
# Split without word-splitting or globbing: a value may carry `*` or spaces.
setting_items() {
	local rest="$1," item
	while [[ -n "$rest" ]]; do
		item="$(trim "${rest%%,*}")"
		rest="${rest#*,}"
		[[ -z "$item" ]] || printf '%s\n' "$item"
	done
}

# Whether setting key KEY names the lane at DIR: its directory name, with or
# without the leading dot.
lane_named() {
	local base
	base="$(basename -- "$2")"
	[[ "$1" == "$base" || "$1" == "${base#.}" ]]
}

# Whether exclusion or retirement key KEY names the lane at DIR: a directory
# name lane_named accepts, or the alias lane_alias_for gives it. Neither reads
# inside DIR.
lane_matches() {
	lane_named "$1" "$2" || [[ "$1" == "$(lane_alias_for "$2")" ]]
}

lane_excluded() {
	local name
	while IFS= read -r name; do
		lane_matches "$name" "$1" && return 0
	done < <(setting_items "${ORCH_LANE_EXCLUDE:-}")
	return 1
}

# The UTC date ORCH_LANE_RETIRE sets for DIR, empty when none. Entries were
# validated at startup (validate_lane_settings).
lane_retire_date() {
	local pair
	while IFS= read -r pair; do
		lane_matches "$(trim "${pair%%=*}")" "$1" || continue
		trim "${pair#*=}"
		return 0
	done < <(setting_items "${ORCH_LANE_RETIRE:-}")
}

# Prints DIR's retirement date and succeeds when that UTC date is today or
# earlier; fails for a lane with no retirement or one still ahead.
lane_retired() {
	local date
	date="$(lane_retire_date "$1")"
	[[ -n "$date" && ! "$TODAY" < "$date" ]] || return 1
	printf '%s' "$date"
}

# ORCH_LANE_DIRS entries of harness $1, excluded ones included: whether a
# harness is configured is decided before exclusion drops an entry, or excluding
# every entry would turn its discovery back on. An excluded or retired entry is
# never probed; its name decides, as discovery's glob does. Any other entry is
# codex when it holds auth.json and no .credentials.json.
configured_lane_dirs() {
	local rest="$ORCH_LANE_DIRS:" entry kind
	while [[ -n "$rest" ]]; do
		entry="${rest%%:*}"
		rest="${rest#*:}"
		[[ -n "$entry" ]] || continue
		kind=claude
		if lane_excluded "$entry" || lane_retired "$entry" >/dev/null; then
			[[ "$(basename -- "$entry")" != *codex* ]] || kind=codex
		elif [[ -f "$entry/auth.json" && ! -f "$entry/.credentials.json" ]]; then
			kind=codex
		fi
		[[ "$kind" != "$1" ]] || printf '%s\n' "$entry"
	done
}

# Dirs of harness $1 (`claude` or `codex`), excluded ones dropped. The
# ORCH_LANE_DIRS entries of that harness replace its discovery; with none, it
# is discovered. A set CODEX_HOME joins the codex inventory either way, since
# the codex CLI reads it wherever it points — as the ACCOUNT it names, because
# a codex launch that had to make its own folder-trust record sets it to a
# private home built under one (lib/lane-home.sh). Listed raw, that home is a
# second lane for an account already in this list, and the headroom of one
# account is counted and claimed twice.
lane_dirs() {
	local configured="" home="${LANES_HOME:-$HOME}" d
	[[ -z "${ORCH_LANE_DIRS:-}" ]] || configured="$(configured_lane_dirs "$1")"
	{
		if [[ -n "$configured" ]]; then
			printf '%s\n' "$configured"
		else
			local markers=(.claude.json .credentials.json)
			[[ "$1" != codex ]] || markers=(auth.json config.toml)
			for d in "$home/.$1" "$home"/.*"$1"*; do
				[[ -d "$d" ]] || continue
				lane_excluded "$d" || lane_retired "$d" >/dev/null ||
					[[ -f "$d/${markers[0]}" || -f "$d/${markers[1]}" ]] || continue
				printf '%s\n' "$d"
			done
		fi
		[[ "$1" != codex || -z "${CODEX_HOME:-}" ]] || lane_launch_home_account "$CODEX_HOME"
	} 2>/dev/null | awk '!seen[$0]++' | while IFS= read -r d; do
		lane_excluded "$d" || printf '%s\n' "$d"
	done
}

# The discovered alias is the config dir's own name, which is also the command
# name a shell wrapper would conventionally use for it (`~/.eclaude` ->
# `eclaude`). It is purely a label: launching emits the config-dir env var,
# which works whether or not such a wrapper exists, so nothing probes PATH.
#
# ORCH_LANE_ALIASES overlays user-chosen names onto that discovery, keyed by
# the discovered name, so the inventory stays automatic while the labels stay
# the operator's. An entry naming a directory that does not exist is inert.
lane_alias_for() {
	local base key val
	base="$(basename -- "$1")"
	while IFS=$'\t' read -r key val; do
		lane_named "$key" "$1" || continue
		printf '%s' "$val"
		return
	done < <(alias_pairs)
	printf '%s' "${base#.}"
}

# The ORCH_LANE_ALIASES pairs with a name and an alias, as trimmed
# `<name>\t<alias>` lines.
alias_pairs() {
	local pair key val
	while IFS= read -r pair; do
		[[ "$pair" == *=* ]] || continue
		key="$(trim "${pair%%=*}")"
		val="$(trim "${pair#*=}")"
		[[ -n "$key" && -n "$val" ]] || continue
		printf '%s\t%s\n' "$key" "$val"
	done < <(setting_items "${ORCH_LANE_ALIASES:-}")
}

# ── Usage fetch (the only impure layer) ──────────────────────────────────────
#
# Both network calls, and both of the commands the suite injects in their place,
# answer in ONE shape: the HTTP status and any Retry-After on the first line,
# the response body under it. A caller that read only the body could not tell a
# rate limit from a dead login, which is the whole defect this shape closes.

# Turn a `curl -D - -w '\n%{http_code}'` capture into that shape. The headers
# reach stdout ahead of the body, so the body starts after the LAST header
# block: a 1xx interim response is a block of its own, and a split at the first
# blank line would hand the real headers back as the body. Each block starts
# its own header read, so a Retry-After an interim or redirect block carried is
# never read as the refusal's own.
http_answer() { # CAPTURE
	local capture code
	capture="$(printf '%s' "$1" | tr -d '\r')"
	code="${capture##*$'\n'}"
	printf '%s' "${capture%$'\n'"$code"}" | awk -v code="$code" '
		BEGIN { inhdr = 1; blank = 0; retry = "" }
		inhdr && blank && /^HTTP\// { blank = 0; retry = ""; next }
		inhdr && blank { inhdr = 0; printf "%s %s\n", code, retry }
		inhdr && /^$/ { blank = 1; next }
		inhdr && tolower($1) == "retry-after:" { retry = $2; next }
		inhdr { next }
		{ print }
		END { if (inhdr) printf "%s %s\n", code, retry }
	'
}

# Read that shape into HTTP_CODE, HTTP_RETRY and HTTP_BODY. A field the answer
# does not name is empty, and so is a code that is not three digits. HTTP_RETRY
# is passed on as the answer wrote it: `write_usage_refusal` is the one judge of
# whether it names seconds to wait out.
split_http_answer() { # ANSWER
	local head="${1%%$'\n'*}"
	HTTP_BODY="${1#*$'\n'}"
	[[ "$1" == *$'\n'* ]] || HTTP_BODY=""
	HTTP_CODE="${head%% *}"
	HTTP_RETRY="${head#* }"
	[[ "$head" == *' '* ]] || HTTP_RETRY=""
	[[ "$HTTP_CODE" =~ ^[0-9]{3}$ ]] || HTTP_CODE=""
}

# What an HTTP refusal of a lane's own request means for the lane, with the
# caller's own reading of every other code as $2. `expired` is read downstream
# as a proven-dead login — `open-terminal` turns it into a remedy line telling
# the operator to log in again on this machine — so a refusal the account will
# survive must never take it.
http_refusal_status() { # CODE DEFAULT
	case "$1" in
		429) printf 'rate_limited' ;;
		5??) printf 'unreachable' ;;
		*) printf '%s' "$2" ;;
	esac
}

fetch_usage() {
	local harness="$1" dir="$2" token="$3" account_id="${4:-}"
	if [[ -n "${ORCH_LANES_FETCH_CMD:-}" ]]; then
		"$ORCH_LANES_FETCH_CMD" "$harness" "$dir"
		return $?
	fi
	command -v curl >/dev/null 2>&1 || return 1
	local resp
	if [[ "$harness" == "claude" ]]; then
		resp=$(curl -s --max-time 10 -D - -w '\n%{http_code}' "$CLAUDE_USAGE_URL" \
			-H "anthropic-beta: $CLAUDE_OAUTH_BETA" -K - <<-CURLCFG
			header = "Authorization: Bearer ${token}"
		CURLCFG
		) || return 1
	else
		local args=(-s --max-time 10 -D - -w $'\n%{http_code}' "$CODEX_USAGE_URL")
		[[ -n "$account_id" ]] && args+=(-H "chatgpt-account-id: $account_id")
		resp=$(curl "${args[@]}" -K - <<-CURLCFG
			header = "Authorization: Bearer ${token}"
		CURLCFG
		) || return 1
	fi
	http_answer "$resp"
}

# ── Parsing ──────────────────────────────────────────────────────────────────
#
# Claude: `.five_hour` and `.seven_day` carry utilization/resets_at directly.
# The model-scoped weekly window moved out of the legacy seven_day_sonnet /
# seven_day_opus fields into `limits[]` entries with kind=="weekly_scoped";
# the legacy fields stand in where an older response carries no entries, so an
# older response still parses, and a response carrying both keeps both. The
# label is whatever the API says, never hard-coded.
#
# EVERY scoped window is kept in model_buckets, not just the most-consumed one:
# the MODEL column reports the largest, while a launch on a named model is
# walled by the window scoped to THAT model, which on an account with several
# is a different entry. lib/lane-model.sh is the reader.
#
# A bucket's label is the API's own display name and NOTHING where the response
# omits it — never the MODEL column's "weekly (model)" filler. A window nobody
# can name is a window that might wall any model, and lane-model.sh counts it
# for all of them; a filler string there would be a name matching no model, and
# naming a model would then be more permissive than not naming one.

parse_claude_usage() {
	jq -c '
		def pct($p): (($p | numbers) // 0) | round | (if (. > 1e12 or . < 0) then 0 else . end);
		(.five_hour  // null) as $s
		| (.seven_day // null) as $w
		# The parentheses around the whole `//` are LOAD-BEARING, not style.
		# jq 1.7 and jq 1.8 disagree on `A // B as $x | C`: 1.7 binds it as
		# `A // (B as $x | C)`, so a non-null A short-circuits and emits A itself
		# instead of ever reaching C. That produced a silent empty parse under the
		# jq on CI while passing locally on 1.8. Never rely on the relative
		# precedence of `//` and `as`.
		| ([.limits[]? | select(type == "object")
		    | select(.kind == "weekly_scoped" or (.group == "weekly" and .scope != null))]) as $live
		# Each legacy field is appended on its own, never as one branch of an
		# if/elif: a response carrying both would otherwise keep the first and
		# drop the second, and the dropped window walls the launch its model
		# names. Appending is a no-op where only one field is present.
		| ((if .seven_day_sonnet != null then
		      [{percent: .seven_day_sonnet.utilization, resets_at: .seven_day_sonnet.resets_at,
		        scope: {model: {display_name: "Sonnet"}}}]
		    else [] end)
		   + (if .seven_day_opus != null then
		        [{percent: .seven_day_opus.utilization, resets_at: .seven_day_opus.resets_at,
		          scope: {model: {display_name: "Opus"}}}]
		      else [] end)) as $legacy
		| (if ($live | length) > 0 then $live else $legacy end) as $scoped
		| (($scoped | max_by(.percent // 0)) // null) as $m
		| {
		    session_5h_pct:  (if $s then pct($s.utilization) else null end),
		    weekly_pct:      (if $w then pct($w.utilization) else null end),
		    model_pct:       (if $m then pct($m.percent) else null end),
		    model_label:     (if $m then ($m.scope.model.display_name // "weekly (model)") else null end),
		    model_buckets:   [$scoped[] | {label: .scope.model.display_name,
		                                   pct: pct(.percent),
		                                   resets_at: (.resets_at // null)}],
		    resets: {
		      session: (if $s then ($s.resets_at // null) else null end),
		      weekly:  (if $w then ($w.resets_at // null) else null end),
		      model:   (if $m then ($m.resets_at // null) else null end)
		    }
		  }
	'
}

# Codex: primary/secondary windows do NOT map to session/weekly by position.
# Their DURATIONS vary by account and shift over time — a weekly-only account
# reports its 7-day limit as the *primary* window with a null secondary, and
# routing by position then labels a 7-day window "5h" and invents a 0% weekly.
# Route each window by its own limit_window_seconds instead.
parse_codex_usage() {
	local session_window="$1"
	jq -c --argjson sw "$session_window" '
		def pct($p): (($p | numbers) // 0) | floor | (if (. > 1e12 or . < 0) then 0 else . end);
		# The reset is rendered as an ISO timestamp here; emit_lane gives it,
		# and every other reset, the one spelling utc_resets in
		# lib/lane-model.sh names, so no reader has to know which harness
		# measured the lane.
		def win($w): {
			pct: pct($w.used_percent),
			resets_at: (($w.reset_at | numbers | todate?) // null),
			window_s: ((($w.limit_window_seconds | numbers) // 0) | floor)
		};
		[ (.rate_limit.primary_window   // null),
		  (.rate_limit.secondary_window // null) ]
		| map(select(. != null) | win(.))
		# Within 50% of the 5h window counts as the session bucket; anything
		# materially longer (daily, weekly, monthly) is the long window.
		| ((map(select(.window_s > 0 and .window_s <= ($sw * 3 / 2))) | first) // null) as $s
		| ((map(select(.window_s == 0 or .window_s > ($sw * 3 / 2))) | first) // null) as $w
		| {
		    session_5h_pct: (if $s then $s.pct else null end),
		    weekly_pct:     (if $w then $w.pct else null end),
		    model_pct:      null,
		    model_label:    null,
		    resets: {
		      session: (if $s then $s.resets_at else null end),
		      weekly:  (if $w then $w.resets_at else null end),
		      model:   null
		    }
		  }
	'
}

# ── Per-lane measurement ─────────────────────────────────────────────────────

# Report a lane from a refusal the cache holds, which is how a lane inside a
# refusal window is answered: the recorded status and cause, and the record's
# own age in place of a usage figure's, so a reader sees how long ago the
# endpoint refused and that this run posted nothing.
emit_refusal() { # ALIAS HARNESS DIR PLAN RECORD
	local status detail age
	IFS=$'\t' read -r status detail age < <(
		jq -r '[.refusal.status, .refusal.detail, (.age | tostring)] | @tsv' <<<"$5"
	)
	emit_lane "$1" "$2" "$3" "$status" "$detail" "$4" '{}' "$age"
}

# Emit one lane record. Never fails the whole run for one bad lane: an
# unreadable or unauthenticated lane is reported with a status and skipped by
# `pick`, because a fleet launch must still see the lanes that DO work.
measure_lane() {
	local harness="$1" dir="$2"
	local alias creds status="ok" detail="" plan="" token="" account_id="" expires_ms=0 now_s
	local refreshed=false refresh_out
	alias="$(lane_alias_for "$dir")"
	now_s=$(date +%s)

	# Before the credentials path is even composed: a retired account is read
	# no more than an excluded one.
	local retire
	if retire="$(lane_retired "$dir")"; then
		emit_lane "$alias" "$harness" "$dir" "retired" "retired on $retire (ORCH_LANE_RETIRE)" "" '{}'
		return
	fi

	if [[ "$harness" == "claude" ]]; then creds="$dir/.credentials.json"; else creds="$dir/auth.json"; fi

	if [[ ! -f "$creds" ]]; then
		emit_lane "$alias" "$harness" "$dir" "no_credentials" "no credential file at $creds" "" '{}'
		return
	fi
	if ! jq -e . "$creds" >/dev/null 2>&1; then
		emit_lane "$alias" "$harness" "$dir" "error" "credential file is not valid JSON" "" '{}'
		return
	fi

	if [[ "$harness" == "claude" ]]; then
		token=$(jq -r 'try (.claudeAiOauth.accessToken // empty) catch empty' "$creds")
		plan=$(jq -r 'try (.claudeAiOauth.subscriptionType // empty) catch empty' "$creds")
		expires_ms=$(jq -r 'try (.claudeAiOauth.expiresAt // 0) catch 0' "$creds")
		expires_ms="${expires_ms%%.*}"
		[[ "$expires_ms" =~ ^[0-9]+$ ]] || expires_ms=0
	else
		token=$(jq -r 'try (.tokens.access_token // .OPENAI_API_KEY // empty) catch empty' "$creds")
		account_id=$(jq -r 'try (.tokens.account_id // empty) catch empty' "$creds")
	fi

	if [[ -z "$token" ]]; then
		emit_lane "$alias" "$harness" "$dir" "no_credentials" "no access token in $creds" "$plan" '{}'
		return
	fi

	# An expired access token is renewed here, so the lane `pick` prints is one
	# whose token is live — see the header. A renewal that cannot happen fails
	# closed with the status `refresh_claude_token` judged, naming its cause, and
	# is never measured as `ok`.
	local refusal
	if claude_token_expired "$expires_ms" "$now_s"; then
		if refusal="$(read_usage_refusal "$harness" "$dir" "$now_s" token)"; then
			emit_refusal "$alias" "$harness" "$dir" "$plan" "$refusal"
			return
		fi
		# At most one `claude --version` per measuring shell, and none at all on a
		# run whose lanes all carry live tokens.
		[[ -n "$CLAUDE_TOKEN_UA" ]] || CLAUDE_TOKEN_UA="$(claude_token_ua)"
		if ! refresh_out="$(refresh_claude_token "$dir" "$creds")"; then
			local head code retry
			head="${refresh_out%%$'\n'*}"
			read -r status code retry <<<"$head"
			[[ "$code" != "-" ]] || code=""
			[[ "$retry" != "-" ]] || retry=""
			detail="access token expired and could not be renewed: ${refresh_out#*$'\n'}"
			# Recorded only where the endpoint answered: a refusal this machine
			# raised on its own posted nothing, so there is nothing to stop a
			# later caller from posting.
			[[ -z "$code" ]] ||
				write_usage_refusal "$harness" "$dir" "$now_s" token "$status" "$code" "$detail" "$retry" || true
			emit_lane "$alias" "$harness" "$dir" "$status" "$detail" "$plan" '{}'
			return
		fi
		token="$refresh_out"
		refreshed=true
	fi

	# Read BEFORE the host-wide lock, so a lane its record can answer never
	# waits behind another caller's refresh: `pick --lane` runs under a caller's
	# own ceiling, and a warm figure or a live refusal has nothing to wait for.
	# Only a lane the record cannot answer takes the lock, and
	# refresh_lane_usage reads the record again inside it. The clock is read
	# again first: a renewal above can have waited on the credentials lock while
	# the peer holding it measured this lane, and the record that peer wrote
	# would read as stamped in the future against the clock this function
	# started with.
	local raw="" buckets age=null current_at="" prior_at="" prior_raw="" prior_buckets='{}' elapsed="null"
	now_s="$(date +%s)"
	if ! usage_from_record "$now_s"; then
		usage_lock_take
		refresh_lane_usage
		usage_lock_release
	fi
	# An empty `raw` is a lane no figure answers, whose status, detail and age
	# the record or the refresh set: it reports no windows.
	if [[ -z "$raw" ]]; then
		emit_lane "$alias" "$harness" "$dir" "$status" "$detail" "$plan" '{}' "$age" "$refreshed"
		return
	fi
	if [[ "$harness" == "claude" ]]; then
		buckets="$(parse_claude_usage <<<"$raw")"
	else
		buckets="$(parse_codex_usage "$SESSION_WINDOW_S" <<<"$raw")"
	fi
	if [[ "$prior_at" =~ ^[0-9]+$ && -n "$prior_raw" ]]; then
		elapsed=$((10#$current_at - 10#$prior_at))
		if [[ "$harness" == "claude" ]]; then
			prior_buckets="$(parse_claude_usage <<<"$prior_raw")"
		else
			prior_buckets="$(parse_codex_usage "$SESSION_WINDOW_S" <<<"$prior_raw")"
		fi
	fi
	[[ -n "$buckets" ]] || buckets='{}'
	[[ -n "$prior_buckets" ]] || prior_buckets='{}'
	emit_lane "$alias" "$harness" "$dir" "$status" "$detail" "$plan" "$buckets" "$age" "$refreshed" local "$prior_buckets" "$elapsed"
}

# Answers the lane from its usage record without posting anything, into
# measure_lane's own `raw`, `age`, `status` and `detail`, and the sample
# fields take_cached_usage sets: a figure young
# enough to serve, else a live refusal of the usage endpoint. A 429 on record is
# answered from the last figure beside it while serve_refused_usage finds one;
# any other refusal, and a 429 with no such figure, is reported as the record
# states it with no windows. Returns 1 where the record answers neither, the
# one case that posts. It reads measure_lane's `harness` and `dir`.
#
# The refusal is honoured whatever --no-cache says: that flag declines a cached
# FIGURE it could refresh, not the record of a request the endpoint already
# refused, nor the last figure a 429 is answered from. The flag is the path
# most able to multiply a burst, since declining the cache is what puts every
# caller back on the endpoint at once.
usage_from_record() { # NOW
	local cached refusal
	if [[ "$USE_CACHE" == "true" ]] && cached="$(read_usage_cache "$harness" "$dir" "$1" "$(usage_serve_max_age)")"; then
		take_cached_usage "$cached"
		return 0
	fi
	refusal="$(read_usage_refusal "$harness" "$dir" "$1" usage)" || return 1
	IFS=$'\t' read -r status detail age < <(
		jq -r '[.refusal.status, .refusal.detail, (.age | tostring)] | @tsv' <<<"$refusal"
	)
	[[ "$status" != "rate_limited" ]] ||
		serve_refused_usage "$harness" "$dir" "$1" "$detail; these are the last figures it gave" || true
	return 0
}

# The fetch half of measure_lane, run with the host-wide usage lock held. It
# assigns measure_lane's own `raw`, `age`, `status` and `detail`, and on an
# answer `current_at`, `prior_at` and `prior_raw`, the way
# serve_refused_usage does and for the same reason, and reads its `harness`,
# `dir`, `token` and `account_id`. An empty `raw` on return is a lane no figure
# answers.
#
# The clock is read afresh here and after each answer, never taken from
# measure_lane: a caller that waited for the lock would otherwise judge the
# holder's new record as stamped in the future, and a window counted from
# before a slow request can have closed by the time that request's refusal
# arrives.
refresh_lane_usage() {
	local answer window at
	# The second read, inside the lock: a caller that waited takes the figure or
	# the refusal the holder brought back instead of posting its own request.
	usage_from_record "$(date +%s)" && return
	if ! answer="$(fetch_usage "$harness" "$dir" "$token" "$account_id")"; then
		status="unreachable"
		detail="usage query could not be run"
		return
	fi
	split_http_answer "$answer"
	if [[ "$HTTP_CODE" == "429" ]]; then
		# The refusal is recorded FIRST, so it stands whichever way this lane
		# resolves: the row served below is one caller's answer, and the record
		# is what keeps every other caller on this host off the endpoint until
		# the window passes.
		record_usage_refusal "$(date +%s)"
		# A cached figure seconds old is a better answer than no answer, and no
		# rate limit is a reason to wall a launch on an account the host has a
		# reading of.
		serve_refused_usage "$harness" "$dir" "$(date +%s)" "$detail; these are the last figures it gave" && return
		# Nothing usable is cached, so there is no figure to stand in. One
		# retry, because a first refusal with nothing behind it leaves every
		# caller with nothing to decide on. It waits the window or
		# USAGE_RETRY_WAIT_MAX_S, whichever is shorter, so it is the one request
		# posted inside a window this host recorded. One per RUN: a later cold
		# lane reports its refusal at once.
		[[ "$USAGE_RETRY_SPENT" == "false" ]] || return
		USAGE_RETRY_SPENT=true
		window="$(usage_refusal_window "$HTTP_RETRY")"
		sleep "$(( window < USAGE_RETRY_WAIT_MAX_S ? window : USAGE_RETRY_WAIT_MAX_S ))"
		if ! answer="$(fetch_usage "$harness" "$dir" "$token" "$account_id")"; then
			detail="$detail, and the one retry could not be run"
			return
		fi
		split_http_answer "$answer"
	fi
	# The usage endpoint refusing says nothing about the login, so every code
	# it answers that is not a rate limit stays `unreachable`.
	if [[ -n "$HTTP_CODE" && "$HTTP_CODE" != 2?? ]]; then
		record_usage_refusal "$(date +%s)"
		return
	fi
	if [[ -z "$HTTP_BODY" ]]; then
		status="unreachable"
		detail="usage query answered HTTP $HTTP_CODE with no body"
		return
	fi
	if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$HTTP_BODY"; then
		status="error"
		detail="usage response was not a JSON object"
		return
	fi
	# An answer, so the lane is measured whatever a first refusal above set.
	raw="$HTTP_BODY"
	age=0
	status="ok"
	detail=""
	# A cache that cannot be written costs the next run a fetch, never a wrong
	# figure, so this run reports what it measured either way. The write
	# replaces the whole record, so a refusal on record is spent the moment the
	# endpoint answers again. The figure it displaces is this sample's prior.
	at="$(date +%s)"
	current_at="$at"
	write_usage_cache "$harness" "$dir" "$at" "$raw" || true
	prior_at="${USAGE_PRIOR_AT:-}"; prior_raw="${USAGE_PRIOR_RAW:-}"
}

# Records the refusal the last split_http_answer read, at epoch $1, and sets
# measure_lane's `status` and `detail` to it. Every usage refusal goes through
# here, a cold lane's retry included, so one line judges what each code means
# and the window each is recorded for.
record_usage_refusal() { # NOW
	status="$(http_refusal_status "$HTTP_CODE" unreachable)"
	detail="usage query refused with HTTP $HTTP_CODE"
	write_usage_refusal "$harness" "$dir" "$1" usage "$status" "$HTTP_CODE" "$detail" "$HTTP_RETRY" || true
}

# Serves the last figure the host holds for a rate-limited lane, into
# measure_lane's own `raw`, `age`, `status` and `detail`, while it is younger
# than SESSION_WINDOW_S. A figure older than the shortest window it reports
# cannot say what that window holds now, and a refusal the endpoint keeps
# giving never replaces the figure, so without the bound one frozen figure
# would stand in for an account indefinitely and `pick` would launch on it.
# It returns 1 where nothing that young is held, and the caller then reports
# the refusal with no windows.
#
# It assigns its caller's locals rather than printing, because several values
# cannot come back through one substitution and the caller goes on to parse
# them. usage_from_record and refresh_lane_usage are its callers, and the values
# are measure_lane's locals, reached through their frames by bash's dynamic
# scope: neither may declare them, or the writes stop at its frame.
serve_refused_usage() { # HARNESS DIR NOW DETAIL
	local cached
	cached="$(read_usage_cache "$1" "$2" "$3" "$SESSION_WINDOW_S")" || return 1
	take_cached_usage "$cached"
	status="rate_limited"
	detail="$4"
}

# Assigns measure_lane's `age`, `raw`, `current_at`, `prior_at` and
# `prior_raw` from one read_usage_cache answer, in one jq pass, the way
# serve_refused_usage assigns them and for the same reason. A figure kept
# beside a refusal carries no prior, so a rate-limited lane reports its rate
# unmeasured.
take_cached_usage() { # CACHED
	{ IFS= read -r age; IFS= read -r current_at; IFS= read -r raw
	  IFS= read -r prior_at; IFS= read -r prior_raw; } < <(jq -r '
		.age, .fetched_at, (.usage | tojson), (.prior.fetched_at // ""),
		(if (.prior.usage | type) == "object" then (.prior.usage | tojson) else "" end)' <<<"$1")
}

# ── Usage cache ──────────────────────────────────────────────────────────────
#
# One file per lane, named by its harness and a checksum of its whole config dir,
# so lanes sharing a directory name keep separate records and no name can leave
# the cache directory. The record still carries harness and config dir, and a
# record naming another lane (a checksum collision) is a miss.
#
# A lane's record holds a usage figure, a refusal, or a refusal with the last
# figure kept beside it. `fetched_at` is when the record's own answer arrived:
# the figure's, or the refusal's where there is one, and a figure kept beside a
# refusal keeps its own stamp in `usage_fetched_at`. The figure is kept because
# a usage 429 is answered from it: a refused REFRESH leaves the host's last
# reading of the account true for its age, and that age is always the figure's
# own, never the refusal's, so no reader can take a refused refresh for a fresh
# figure. The two readers select on the key they need, so a record with no
# figure is a miss for the figure reader and one with no refusal a miss for the
# refusal reader. The refusal names which endpoint refused, because the token
# endpoint and the usage endpoint are different hosts under different limits.

usage_cache_file() {
	local sum
	sum="$(printf '%s' "$2" | cksum)" || return 1
	printf '%s/%s-%s.json' "$USAGE_CACHE_DIR" "$1" "${sum// /-}"
}

# Prints `{fetched_at, age, usage, prior}` for a cached body of harness $1 and
# dir $2 at epoch $3 whose age is under $4 seconds; an EMPTY $4 accepts any
# age. `fetched_at` and `age` are the figure's own. Fails on a miss: an
# unreadable or malformed record, one naming another lane, one holding no
# figure, and one stamped in the future.
#
# The bound is the caller's argument and not $USAGE_TTL, because the two
# questions this cache answers take different ones: a measurement asks for a
# figure fresh enough to report, and a refused fetch asks for the last figure
# there is. Whether --no-cache forbids the read is likewise the caller's: it
# declines a figure it could refresh, not the figure that stands in for one the
# endpoint refused.
read_usage_cache() { # HARNESS DIR NOW MAX_AGE_S
	local file
	file="$(usage_cache_file "$1" "$2")" || return 1
	[[ -f "$file" ]] || return 1
	jq -ce --arg h "$1" --arg d "$2" --argjson now "$3" --argjson max "${4:-null}" '
		(.usage_fetched_at // .fetched_at) as $at
		| select(.harness == $h and .config_dir == $d
		       and ($at | type) == "number" and (.usage | type) == "object")
		| ($now - $at) as $age
		| select($age >= 0 and ($max == null or $age < $max))
		| {fetched_at: $at, age: $age, usage: .usage, prior: (.prior // null)}' "$file" 2>/dev/null
}

# The age a cached figure is served within: the TTL, or the caller's own pass
# interval where that is longer. It only ever WIDENS the TTL. A watch whose
# pass is longer than the TTL would otherwise fetch on every pass — the figure
# is always past the TTL by the time it comes round — which is the burst; a
# caller with a short pass still gets the TTL it configured. A TTL of 0 is an
# operator asking for a fetch on every run, and no caller's interval widens it.
usage_serve_max_age() {
	if [[ "$USAGE_TTL" -eq 0 ]]; then
		printf 0
	elif [[ "$USAGE_MAX_AGE" -gt "$USAGE_TTL" ]]; then
		printf '%s' "$USAGE_MAX_AGE"
	else
		printf '%s' "$USAGE_TTL"
	fi
}

# Renamed into place only once complete, so a concurrent reader never parses
# half a record.
write_usage_cache() {
	local file tmp prior=null
	file="$(usage_cache_file "$1" "$2")" || return 1
	USAGE_PRIOR_AT=""; USAGE_PRIOR_RAW=""
	if [[ -f "$file" ]]; then
		prior="$(jq -ce --arg h "$1" --arg d "$2" '
			(.usage_fetched_at // .fetched_at) as $at
			| select(.harness == $h and .config_dir == $d
			       and ($at | type) == "number" and (.usage | type) == "object")
			| {fetched_at: $at, usage}' "$file" 2>/dev/null)" || prior=null
	fi
	if [[ "$prior" != null ]]; then
		USAGE_PRIOR_AT="$(jq -r '.fetched_at' <<<"$prior")"
		USAGE_PRIOR_RAW="$(jq -c '.usage' <<<"$prior")"
	fi
	mkdir -p -- "$USAGE_CACHE_DIR" 2>/dev/null || return 1
	tmp="$(mktemp -- "$USAGE_CACHE_DIR/.usage.XXXXXX" 2>/dev/null)" || return 1
	if jq -nc --arg h "$1" --arg d "$2" --argjson now "$3" --argjson u "$4" --argjson p "$prior" \
		'{harness: $h, config_dir: $d, fetched_at: $now, usage: $u, prior: $p}' >"$tmp" \
		&& mv -f -- "$tmp" "$file"; then
		return 0
	fi
	rm -f -- "$tmp"
	return 1
}

# Prints `{age, refusal}` for a live recorded refusal of endpoint $4 on the lane
# of harness $1 and dir $2 at epoch $3; fails on a miss, a refusal of the other
# endpoint, a malformed record and one stamped in the future.
#
# --no-cache does NOT reach this. It declines a cached FIGURE, and an operator
# asking for a fresh reading must not be the one caller on the host that posts
# again what the endpoint has already refused.
read_usage_refusal() {
	local file
	file="$(usage_cache_file "$1" "$2")" || return 1
	[[ -f "$file" ]] || return 1
	jq -ce --arg h "$1" --arg d "$2" --argjson now "$3" --arg ep "$4" '
		select(.harness == $h and .config_dir == $d
		       and (.fetched_at | type) == "number"
		       and (.refusal | type) == "object"
		       and .refusal.endpoint == $ep
		       and (.refusal.expires_at | type) == "number"
		       and .refusal.expires_at > $now)
		| ($now - .fetched_at) as $age
		| select($age >= 0)
		| {age: $age, refusal: .refusal}' "$file" 2>/dev/null
}

# Record a refusal the endpoint answered, so every caller sharing this state
# directory reads it instead of posting the same request again. Its window is
# the answer's own Retry-After where it named one in seconds, and
# USAGE_REFUSAL_WINDOW_S where it did not: a Retry-After written as an HTTP date
# names no seconds this can wait out, and a window nobody can read must not
# become a window of zero.
#
# A record that could not be written leaves every caller on the host posting
# again each pass, which is what the window exists to stop, so that failure is a
# `refusal-unrecorded` notice on stderr. The lane is still reported.
write_usage_refusal() { # HARNESS DIR NOW ENDPOINT STATUS CODE DETAIL [RETRY_AFTER]
	store_usage_refusal "$@" && return 0
	message refusal-unrecorded "$USAGE_CACHE_DIR" >&2
	return 1
}

# Writes the refusal over the lane's record, keeping the figure the record held
# for this lane, under its own stamp, beside it: `kept` is that figure as
# `{usage, usage_fetched_at}`, or `{}` where there is none.
store_usage_refusal() { # HARNESS DIR NOW ENDPOINT STATUS CODE DETAIL [RETRY_AFTER]
	local file tmp window kept=""
	window="$(usage_refusal_window "${8:-}")"
	file="$(usage_cache_file "$1" "$2")" || return 1
	mkdir -p -- "$USAGE_CACHE_DIR" 2>/dev/null || return 1
	[[ ! -f "$file" ]] || kept="$(jq -c --arg h "$1" --arg d "$2" '
		(.usage_fetched_at // .fetched_at) as $at
		| select(.harness == $h and .config_dir == $d
		       and ($at | type) == "number" and (.usage | type) == "object")
		| {usage: .usage, usage_fetched_at: $at}' "$file" 2>/dev/null)"
	[[ -n "$kept" ]] || kept='{}'
	tmp="$(mktemp -- "$USAGE_CACHE_DIR/.usage.XXXXXX" 2>/dev/null)" || return 1
	if jq -nc --arg h "$1" --arg d "$2" --argjson now "$3" --arg ep "$4" \
		--arg status "$5" --arg code "$6" --arg detail "$7" \
		--argjson until "$(( $3 + window ))" --argjson kept "$kept" \
		'$kept + {harness: $h, config_dir: $d, fetched_at: $now,
		  refusal: {endpoint: $ep, status: $status,
		            code: (if $code == "" then null else $code end),
		            detail: $detail, expires_at: $until}}' >"$tmp" \
		&& mv -f -- "$tmp" "$file"; then
		return 0
	fi
	rm -f -- "${tmp:?}"
	return 1
}

# The seconds a refusal naming Retry-After $1 is recorded for: that many where
# it names a positive whole number, USAGE_REFUSAL_WINDOW_S where it does not.
# The one judge of the window, so the cold-lane retry waits inside the same
# window the record holds.
usage_refusal_window() { # RETRY_AFTER
	local window="${1:-}"
	[[ "$window" =~ ^[0-9]+$ && "$window" -gt 0 ]] || window="$USAGE_REFUSAL_WINDOW_S"
	printf '%s' "$window"
}

# ── Host-wide usage refresh lock ─────────────────────────────────────────────
#
# One host-wide lock over each lane's REFRESH, so N callers times M lanes is
# one request per lane per window instead of one per caller. The kendex watch,
# the fleet watch, each `oversee-succeed --check-marks` and each `pick` sweep
# the same accounts, and nothing else serializes them. measure_lane takes it
# only for a lane its own record read could not answer, and refresh_lane_usage
# reads the record again inside it, so the second caller through takes the
# first caller's figure or refusal instead of posting its own request. That is
# the pattern refresh_claude_token uses on the credentials file, for the same
# reason. A lane with a fresh figure or a live refusal never waits.
#
# A lock this run could NOT take is a keyed notice and the refresh still
# runs. This lock collapses concurrent refreshes; it does not authorize a read.
# Refusing the lane on contention would report it unmeasured, which is the
# wall on every launch decision that serving a stale figure exists to prevent,
# and a peer legitimately holding the lock would reach it. The notice is what
# keeps a doubled request from being silent.
#
# The take arms orch_take_lock's EXIT trap in this shell, so measure_lane only
# ever runs in a subshell: a pipeline stage in collect_lanes and a command
# substitution in cmd_pick_lane.
usage_lock_take() {
	local lock="$USAGE_CACHE_DIR/.usage-refresh.lock"
	mkdir -p -- "$USAGE_CACHE_DIR" 2>/dev/null
	if ! exec 8>"$lock"; then
		message usage-lock-unopenable "$lock" >&2
		return 0
	fi
	if ! orch_take_lock 8 "$lock" "$USAGE_LOCK_WAIT_S"; then
		message usage-lock-timeout "$lock" "$USAGE_LOCK_WAIT_S" >&2
		exec 8>&-
	fi
}

# Closing the descriptor releases a flock; orch_release_lock removes the mkdir
# mutex where flock is absent and is a no-op where this run holds none.
usage_lock_release() {
	exec 8>&-
	orch_release_lock
}

# Whether an OAuth expiresAt in milliseconds has passed at epoch seconds $2.
# A zero or unparseable stamp is NOT expired: the file states no expiry, and
# refusing on it would disable a lane that works.
claude_token_expired() {
	local exp="${1%%.*}"
	[[ "$exp" =~ ^[0-9]+$ ]] || return 1
	[[ "$exp" -gt 0 ]] && (( exp / 1000 <= $2 ))
}

# The User-Agent the renewal posts with. platform.claude.com answers HTTP 429
# `rate_limit_error` to a token POST carrying none, whatever the rate, which is
# why an interactive `claude` launch renews an account this script could not.
# The endpoint matches the `claude-cli/` prefix and does not parse the version,
# so a host with no `claude` on PATH sends the fallback rather than nothing.
CLAUDE_CLI_UA_FALLBACK="2.1.278"
claude_token_ua() {
	local version=""
	version="$(claude --version 2>/dev/null)" && version="${version%% *}"
	[[ "$version" =~ ^[0-9][0-9A-Za-z.+-]*$ ]] || version="$CLAUDE_CLI_UA_FALLBACK"
	printf 'claude-cli/%s (external, cli)' "$version"
}

# The failure form every refusal below takes: a first line the caller reads the
# classification off — `<status> <code> <retry-after>`, `-` for a field the
# answer named none of — and the cause under it. The classification travels with
# the cause because this function is the only judge of why a renewal did not
# happen, and a caller re-deriving it from the sentence would be a second judge.
token_refusal() { # STATUS CODE RETRY_AFTER CAUSE
	printf '%s %s %s\n%s' "$1" "${2:--}" "${3:--}" "$4"
}

# The endpoint's own error object, as a suffix for the cause, so an operator
# reads what the endpoint said rather than only that it said no. Empty where the
# answer carries none.
token_error_suffix() { # BODY
	local type message
	type="$(jq -r 'try (.error.type // empty) catch empty' <<<"$1")"
	message="$(jq -r 'try (.error.message // empty) catch empty' <<<"$1")"
	[[ -n "$type" || -n "$message" ]] || return 0
	if [[ -n "$type" && -n "$message" ]]; then printf ' (%s: %s)' "$type" "$message"
	else printf ' (%s%s)' "$type" "$message"; fi
}

# Refresh under a lock on the credentials file, re-reading inside the lock:
# a peer tool may have rotated the refresh token between our first read and
# this attempt, and refreshing with the stale one fails while the credentials
# are actually fine. lib/file-lock.sh carries the lock on a host with no
# flock, where the bare `flock -w 30 9` this used to run resolved to nothing
# and every refresh on that host returned failure instead of a token.
# Prints the new access token on stdout and returns 0; on failure prints a
# `token_refusal` there instead and returns 1, so this stays the only judge of
# why a renewal did not happen and of what the lane's status becomes. Only a
# login this renewal proved dead takes `expired`: a step this machine failed on
# its own is `error`, and a POST that never reached the endpoint, or one a held
# lock kept from being tried, is `unreachable`. None of those carries a code, so
# none is recorded as a refusal window.
refresh_claude_token() {
	local dir="$1" creds="$2" rt client_id body resp new_at lock suffix
	# Composed after the declaration, never inside it: bash expands every word
	# on a `local` line in the ENCLOSING scope before the builtin creates any
	# local, so a `lock` built there reads whatever `dir` the CALLER has rather
	# than this one's `$1`, and in a scope with no `dir` of its own it yields
	# the filesystem root. The leak is what hides it: `measure_lane` happens to
	# hold a `dir` of the same value, so the one-line form answered correctly
	# there and would answer the root at the next caller to be added.
	lock="$dir/.lanes-refresh.lock"
	client_id="${ORCH_LANES_CLAUDE_CLIENT_ID:-}"
	[[ -n "$client_id" ]] || { token_refusal error '' '' 'no OAuth client id is configured (ORCH_LANES_CLAUDE_CLIENT_ID)'; return 1; }
	exec 9>"$lock" || { token_refusal error '' '' "the lock file $lock could not be opened"; return 1; }
	# Every caller runs this function in a command substitution, so the whole
	# body is a subshell and the EXIT trap orch_take_lock arms releases a mkdir
	# mutex on every path out — including this one.
	orch_take_lock 9 "$lock" 30 || { token_refusal unreachable '' '' "another tool holds the credentials lock $lock"; exec 9>&-; return 1; }
	# The expiry was decided before this lock was taken. A peer that renewed
	# while this call waited has already written a live token, and posting
	# anyway would rotate the peer's fresh refresh token away and leave that
	# account needing a manual re-login. Take what the peer wrote instead.
	local fresh_at
	if ! claude_token_expired "$(jq -r 'try (.claudeAiOauth.expiresAt // 0) catch 0' "$creds")" "$(date +%s)"; then
		fresh_at=$(jq -r 'try (.claudeAiOauth.accessToken // empty) catch empty' "$creds")
		if [[ -n "$fresh_at" ]]; then exec 9>&-; printf '%s' "$fresh_at"; return 0; fi
	fi
	rt=$(jq -r 'try (.claudeAiOauth.refreshToken // empty) catch empty' "$creds")
	[[ -n "$rt" ]] || { token_refusal expired '' '' "there is no refresh token in $creds to renew with"; exec 9>&-; return 1; }
	# Secrets travel in the environment, never in an argument vector: on Linux
	# /proc/<pid>/cmdline is world-readable and /proc/<pid>/environ is not, so a
	# `jq --arg rt "$rt"` hands every local user a refresh token that renews
	# indefinitely. The client id is not a secret and stays on argv.
	body=$(LANES_RT="$rt" jq -nc --arg ci "$client_id" \
		'{grant_type:"refresh_token", client_id:$ci, refresh_token:env.LANES_RT}') \
		|| { token_refusal error '' '' 'the token request body could not be built'; exec 9>&-; return 1; }
	# From the POST to the rename, the endpoint may already have rotated the
	# refresh token the credentials file holds, and an interrupt anywhere in
	# that window leaves the account on a retired one that only a fresh login
	# recovers. A caller's ceiling is such an interrupt: `timeout` signals the
	# whole process group, this subshell and the request included. So INT and
	# TERM are ignored across the window, and the request inherits the ignore
	# and completes; curl's --max-time bounds it. KILL is not held off, and no
	# caller of this script sends it. Every return below ends this subshell,
	# whose EXIT trap releases the mutex, so only the success path puts the
	# lock's own handlers back.
	trap '' INT TERM
	# The User-Agent reaches the injected command through its ENVIRONMENT, never
	# argv, which is where the real POST carries it too: a stub asserting the
	# header asserts what curl would send.
	if [[ -n "${ORCH_LANES_TOKEN_CMD:-}" ]]; then
		resp=$(LANES_USER_AGENT="$CLAUDE_TOKEN_UA" "$ORCH_LANES_TOKEN_CMD" <<<"$body")
	else
		resp=$(curl -s --max-time 25 -X POST "$CLAUDE_TOKEN_URL" \
			-A "$CLAUDE_TOKEN_UA" \
			-H "Content-Type: application/json" -H "anthropic-beta: $CLAUDE_OAUTH_BETA" \
			-D - -w '\n%{http_code}' --data-binary @- <<<"$body") \
			&& resp="$(http_answer "$resp")"
	fi || { token_refusal unreachable '' '' 'the token endpoint could not be reached'; exec 9>&-; return 1; }
	split_http_answer "$resp"
	suffix="$(token_error_suffix "$HTTP_BODY")"
	# A status the endpoint refused with IS the failure, so it is what the cause
	# names. `rate_limited` and `unreachable` leave the login itself untested;
	# only a code that is neither still reads as a proven-dead one.
	if [[ -n "$HTTP_CODE" && "$HTTP_CODE" != 2?? ]]; then
		token_refusal "$(http_refusal_status "$HTTP_CODE" expired)" "$HTTP_CODE" "$HTTP_RETRY" \
			"the token endpoint refused the renewal with HTTP $HTTP_CODE$suffix"
		exec 9>&-; return 1
	fi
	new_at=$(jq -r 'try (.access_token // empty) catch empty' <<<"$HTTP_BODY")
	[[ -n "$new_at" ]] || { token_refusal expired "$HTTP_CODE" "$HTTP_RETRY" "the token endpoint returned no access token$suffix"; exec 9>&-; return 1; }
	local tmp new_rt expires_in new_exp
	# The new expiry is written with the new token or nothing is: a credentials
	# file carrying a live token under a past expiresAt reads as expired on
	# every later run, so each one renews again and rotates the refresh token
	# the account's own harness is holding.
	# Strictly positive: a zero lifetime writes expiresAt at this instant, so
	# the lane returns renewed and the next run reads it expired and renews
	# again. That is the rotation storm this renewal exists to close, reached
	# through the check that closes it.
	expires_in=$(jq -r 'try (.expires_in // empty) catch empty' <<<"$HTTP_BODY")
	[[ "$expires_in" =~ ^[0-9]+$ && "$expires_in" -gt 0 ]] || { token_refusal expired "$HTTP_CODE" "$HTTP_RETRY" 'the token endpoint returned no usable expires_in'; exec 9>&-; return 1; }
	new_exp=$(( ($(date +%s) + expires_in) * 1000 ))
	new_rt=$(jq -r 'try (.refresh_token // empty) catch empty' <<<"$HTTP_BODY")
	tmp="$(mktemp "$dir/.credentials.XXXXXX")" || { token_refusal error '' '' "no temporary file could be created in $dir"; exec 9>&-; return 1; }
	# Between here and the rename this file holds a live rotated refresh token.
	# The ignore set before the POST keeps an interrupt from leaving it in the
	# config directory, where a backup or a dotfile sync would carry it off the
	# machine.
	LANES_AT="$new_at" LANES_RT="${new_rt:-$rt}" jq --argjson exp "$new_exp" \
		'.claudeAiOauth.accessToken = env.LANES_AT
		 | .claudeAiOauth.refreshToken = env.LANES_RT
		 | .claudeAiOauth.expiresAt = $exp' \
		"$creds" >"$tmp" && mv "$tmp" "$creds" \
		|| { rm -f -- "${tmp:?}"; token_refusal error '' '' "the renewed credentials could not be written to $creds"; exec 9>&-; return 1; }
	# Back to the lock's own handlers, never to the default disposition: the
	# mutex is still held over the two builtins below, and `trap - INT TERM`
	# would leave a signal there killing this shell with no trap at all, the
	# EXIT trap included, so the mutex would outlive it.
	orch_arm_lock_signals
	exec 9>&-
	printf '%s' "$new_at"
}

# headroom = 100 - the BINDING bucket. A lane with an unknown bucket set gets
# null headroom and is never picked: "we could not measure it" must not read as
# "it is empty".
#
# A lane that authenticated fine but reported NO usable bucket is downgraded to
# `no_usage_data` rather than left as `ok`. Observed on an enterprise plan, which
# authenticates and returns a usage object carrying none of the consumer
# windows. Leaving it `ok` with blank numbers reads as "measured, and idle",
# which is the one thing it must not read as.
#
# The binding bucket names the `resets` key of the largest bucket. On a tie the
# longer window binds (weekly, then model, then session): its wall lasts longest.
emit_lane() {
	# refreshable is true only for a lane this run found expired and made live,
	# by its own renewal or by taking one a peer wrote under the lock: a lane
	# whose token had not expired, and one whose renewal failed, are both false.
	# `through` is the credential this row was measured through: `local` for a
	# config dir on this machine, `host` for a row the provider reported. Carried
	# in the record itself so no listing stamps it afterwards, which cost the
	# whole listing one jq pass whether or not a provider was configured.
	local alias="$1" harness="$2" dir="$3" status="$4" detail="$5" plan="$6" buckets="$7" age="${8:-null}" refreshable="${9:-false}" through="${10:-local}" prior="${11:-}" elapsed="${12:-null}"
	[[ -n "$prior" ]] || prior='{}'
	# `null`, never 0, when the store could not be read: "we could not see the
	# launches in flight" must not read as "there are none".
	local claims="null"
	[[ "$LANE_CLAIMS_RC" -ne 0 ]] || claims="$(lane_claims_count "$LANE_CLAIMS_LIVE" "$dir")"
	jq -nc \
		--arg alias "$alias" --arg harness "$harness" --arg dir "$dir" \
		--arg status "$status" --arg detail "$detail" --arg plan "$plan" \
		--argjson claims "$claims" --argjson age "$age" \
		--argjson refreshable "$refreshable" \
		--arg through "$through" --argjson b "$buckets" \
		--argjson pb "$prior" --argjson elapsed "$elapsed" "$LANE_MODEL_JQ"'
		($b // {} | utc_resets) as $b
		| [$b.session_5h_pct, $b.weekly_pct, $b.model_pct] | map(select(. != null)) as $known
		| (if ($status == "ok" and ($known | length) == 0) then "no_usage_data" else $status end) as $st
		| ({status: $st} | lane_measured) as $measured
		| ([{k: "weekly", p: $b.weekly_pct}, {k: "model", p: $b.model_pct}, {k: "session", p: $b.session_5h_pct}]
		   | map(select(.p != null)) | sort_by(-.p) | first // null) as $bind
		| {
		    alias: $alias,
		    harness: $harness,
		    config_dir: $dir,
		    measured_through: $through,
		    status: $st,
		    refreshable: $refreshable,
		    plan: (if $plan == "" then null else $plan end),
		    session_5h_pct: ($b.session_5h_pct // null),
		    weekly_pct: ($b.weekly_pct // null),
		    model_pct: ($b.model_pct // null),
		    model_label: ($b.model_label // null),
		    model_buckets: ($b.model_buckets // []),
		    claims: $claims,
		    headroom_pct: (if ($measured and ($known | length) > 0) then (100 - ($known | max)) else null end),
		    binding_bucket: (if ($measured and $bind != null) then $bind.k else null end),
		    binding_resets_at: (if ($measured and $bind != null) then ($b.resets[$bind.k] // null) else null end),
		    usage_age_s: $age,
		    _rate_prior: ($pb | utc_resets),
		    _rate_elapsed_s: $elapsed,
		    resets: ($b.resets // {session: null, weekly: null, model: null}),
		    detail: (if $st == "no_usage_data" and $detail == ""
		             then "authenticated, but the usage response carried no session/weekly window"
		             elif $detail == "" then null else $detail end)
		  }
		| with_lane_binding(""; false)'
}


# Called before `collect_lanes`, never inside it: collect_lanes runs in a
# command substitution, and a read failure recorded there would die with the
# subshell instead of reaching the decision.
load_lane_claims() {
	LANE_CLAIMS_RC=0
	LANE_CLAIMS_LIVE="$(lane_claims_read "$(lane_claims_dir "$PROJECT_ROOT")")" || LANE_CLAIMS_RC=$?
}

collect_lanes() {
	local harness_filter="$1" exclude="${2:-}" exclude_id="" d h
	[[ -z "$exclude" ]] || exclude_id="$(lane_claims_canon "$exclude")"
	{
		for h in claude codex; do
			[[ "$harness_filter" == "all" || "$harness_filter" == "$h" ]] || continue
			while IFS= read -r d; do
				[[ -n "$d" ]] || continue
				[[ -z "$exclude_id" || "$(lane_claims_canon "$d")" != "$exclude_id" ]] || continue
				measure_lane "$h" "$d"
			done < <(lane_dirs "$h")
		done
	} | jq -s '.'
}

# ── Host accounts ────────────────────────────────────────────────────────────
#
# A hosted fleet's launches do not run on this machine's copy of an account.
# `lane-host create` hands the sandbox the PROVIDER's own secret for the
# account and the local config dir never reaches it, so the two copies are
# independent: a refresh token this machine can no longer renew leaves the
# local directory `expired` while the sandbox goes on working for hours. A
# listing showing only the local reading reports such an account as dead.
#
# The provider answers `accounts` with one tab-separated `key=value` line per
# account it holds a credential for, keyed on the config dir kendex passed it
# as `create --account`. kendex never names the provider's secret layout: what
# the credential IS stays the provider's, and only the windows read through it
# come back here.
#
# No provider has to implement the verb: an absent one exits 2 and this
# listing stays the local reading it always was.
#
# This function is the ONE reader of the protocol. `lanes host-accounts` prints
# what it validated, so a caller asking whether the host holds an account asks
# that rather than matching the provider's bytes for itself, and the account
# field, the harness match and the dropped invalid row are decided once.
#
# Fields: `account` and `harness`, plus the optional `status`,
# `session-5h-pct`, `weekly-pct`, `model-pct`, `model-label`,
# `session-resets`, `weekly-resets` and `model-resets`. A percentage the row
# omits is a window the provider did not measure, which emit_lane reports as
# no_usage_data rather than as an idle account. A field this script cannot
# read drops the whole row with a notice: a percentage nobody can parse must
# not be judged as room.
#
# Status: 0 the provider answered, rows or none; 2 the optional verb is absent,
# with nothing on stderr; 1 the verb failed or this function could not run it,
# its own bytes and the keyed notice already on stderr. A caller that cannot
# tell those apart reads a failed verb as a host holding nothing, which is the
# one reading the protocol exists to prevent.
#
# The answer itself comes from host_accounts_answer, which is where the cache and
# the time bound are; this function parses and filters it.
host_account_records() { # HOST HARNESS — one lane record per account it holds
	local host="$1" want="${2:-all}" rc=0 rows line field key value bad retire
	local account harness status s_pct w_pct m_pct m_label s_reset w_reset m_reset
	local buckets
	rows="$(host_accounts_answer "$host")" || rc=$?
	[[ "$rc" -eq 0 ]] || return "$rc"
	while IFS= read -r line; do
		[[ -n "$line" ]] || continue
		account=""; harness=""; status="ok"; bad=""
		s_pct=null; w_pct=null; m_pct=null
		m_label=""; s_reset=""; w_reset=""; m_reset=""
		# The row's fields, one per line. `printf '%s\n'`, never `%s`: a last
		# field with no newline after it is a line `read` returns non-zero on,
		# and the loop body would never see it — which is where a row puts its
		# last percentage.
		while IFS= read -r field; do
			[[ -n "$field" ]] || continue
			key="${field%%=*}"
			value="${field#*=}"
			case "$key" in
				account) account="$value" ;;
				harness) harness="$value" ;;
				status) status="$value" ;;
				model-label) m_label="$value" ;;
				session-resets) s_reset="$value" ;;
				weekly-resets) w_reset="$value" ;;
				model-resets) m_reset="$value" ;;
				session-5h-pct|weekly-pct|model-pct)
					if [[ -z "$value" ]]; then continue; fi
					if [[ "$value" =~ ^[0-9]{1,3}$ ]] && (( 10#$value <= 100 )); then
						case "$key" in
							session-5h-pct) s_pct=$((10#$value)) ;;
							weekly-pct) w_pct=$((10#$value)) ;;
							model-pct) m_pct=$((10#$value)) ;;
						esac
					else
						bad="$key"
					fi
					;;
				*) ;;
			esac
		done < <(printf '%s\n' "$line" | tr '\t' '\n')
		[[ -n "$account" ]] || bad="${bad:-account}"
		[[ "$harness" =~ ^(claude|codex)$ ]] || bad="${bad:-harness}"
		if [[ -n "$bad" ]]; then
			message host-account-invalid "${account:-<unnamed>}" "$bad" >&2
			continue
		fi
		# Judged AFTER the field rules, so a row nothing can read is reported
		# whichever harness a caller asked for: a provider emitting a malformed
		# row says so once, not only to the caller that wanted that harness.
		[[ "$want" == all || "$harness" == "$want" ]] || continue
		# The same two settings that remove a local lane remove a hosted row, and
		# for the same reason: they are the operator saying the account is not
		# available to this fleet, which a copy of it on another machine does not
		# change. Without this an excluded account came back as host capacity the
		# overseer could neither wait out nor place an item on, and a retired one
		# was listed twice, retired locally and ok through the host. Keyed on the
		# row's own account value, the config dir `create --account` receives.
		if lane_excluded "$account"; then
			continue
		fi
		if retire="$(lane_retired "$account")"; then
			emit_lane "$(lane_alias_for "$account")" "$harness" "$account" "retired" \
				"retired on $retire (ORCH_LANE_RETIRE)" "" '{}' null false host
			continue
		fi
		buckets="$(jq -nc --argjson s "$s_pct" --argjson w "$w_pct" --argjson m "$m_pct" \
			--arg ml "$m_label" --arg sr "$s_reset" --arg wr "$w_reset" --arg mr "$m_reset" '
			def nz($v): if $v == "" then null else $v end;
			{ session_5h_pct: $s, weekly_pct: $w, model_pct: $m,
			  model_label: nz($ml),
			  model_buckets: (if $m == null then [] else [{label: nz($ml), pct: $m,
			                                                    resets_at: nz($mr)}] end),
			  resets: {session: nz($sr), weekly: nz($wr), model: nz($mr)} }')" || {
			message host-account-invalid "$account" buckets >&2
			continue
		}
		emit_lane "$(lane_alias_for "$account")" "$harness" "$account" "$status" "" "" "$buckets" null false host
	done <<<"$rows"
}

# The provider's raw `accounts` answer, cached and time-bounded. Its status is
# the one host_account_records passes on: 0 answered, 2 verb absent, 1 failed.
host_accounts_answer() { # HOST — the provider's rows on stdout, its status back
	local host="$1" rc=0 rows err cached now_s record="" record_rc=0 busy_wait
	local -a bound=()
	# Read through the same cache every usage figure in this script uses, keyed on
	# the PROVIDER rather than on a harness and a config dir, since one answer
	# covers every account it names. Without it the fleet inventory forked a
	# provider call on every invocation, unbounded and never reused, and on a
	# provider that will never implement the verb it paid that fork to be told so
	# again. `--no-cache` refreshes it; the launcher's own read passes that flag,
	# because which accounts a host holds decides a gate rather than reporting a
	# figure.
	now_s="$(date +%s)" || { message host-accounts-unreadable "$host" clock >&2; return 1; }
	if [[ "$USE_CACHE" == "true" ]] && cached="$(read_usage_cache host-accounts "$host" "$now_s" "$(usage_serve_max_age)")"; then
		# ONE read of the record, status on its first line and the rows after it:
		# a listing the overseer runs every cycle pays for each process it starts,
		# and two reads of one string is one process more than the answer needs.
		# Emitted only for a record carrying BOTH fields in the shape this
		# function wrote them — read_usage_cache validates that the body is an
		# object and nothing more, and a record missing `rows` would otherwise
		# hand the parser the string `null` to read as a provider row. A record
		# that fails that test emits nothing, `read` fails, and the miss falls
		# through to the provider rather than reporting a status nobody parsed.
		rc=""
		{ IFS= read -r rc || rc=""; rows="$(cat)"; } < <(jq -r '
			if (.usage.status | type) == "number" and (.usage.rows | type) == "string"
			then "\(.usage.status)\n\(.usage.rows)" else empty end' <<<"$cached")
		case "$rc" in
			0) printf '%s\n' "$rows"; return 0 ;;
			2) return 2 ;;
		esac
		rc=0
	fi
	# The verb is OPTIONAL, so its absence is not news: exit 2 is the protocol's
	# "this provider does not implement the verb" (schemas/lane-host.md), and a
	# provider that answers it that way leaves this listing exactly the local
	# reading it has always been, with nothing on stderr. Its own bytes are
	# held back until the status says which case it is, because the shipped
	# reference provider answers an unknown verb with its parser's whole usage
	# message and a listing the overseer runs constantly must not carry that.
	# Any other non-zero status IS the verb failing, and then the provider's
	# bytes pass through the way the dispatcher hands them back, under the
	# keyed notice naming what this script did with the failure. A bound reached
	# is that same case, `timeout`'s own 124 naming it.
	#
	# A read that asked for NO CACHE asked to wait for this provider now, and a
	# bound is the only thing that ends that wait: the launcher's gate probe passes
	# --no-cache, so on a machine carrying neither timeout spelling an accounts
	# verb that hangs would hold a launch open with nothing on stderr. Refused
	# instead, as the verb failing, which every caller already reads as a host it
	# could not ask. A cached read keeps the unbounded call: its cost is one per
	# window and its caller is a listing, which no launch waits on.
	#
	# lane-host waits ORCH_LANE_HOST_BUSY_WAIT_SECS for a provider slot before it
	# refuses as lane-host-busy, and a bound that ends first cuts that wait off
	# as the verb failing, with no busy line. So a bounded call waits for a slot
	# for less than its bound. A value lane-host would refuse is passed on as it
	# stands, for lane-host to name.
	busy_wait="${ORCH_LANE_HOST_BUSY_WAIT_SECS:-30}"
	if [[ "$ACCOUNTS_TIMEOUT_S" -ne 0 && -n "$ACCOUNTS_TIMEOUT_CMD" ]]; then
		if [[ "$busy_wait" =~ ^(0|[1-9][0-9]*)$ && "$busy_wait" -ge "$ACCOUNTS_TIMEOUT_S" ]]; then
			busy_wait=$((ACCOUNTS_TIMEOUT_S - 1))
		fi
		bound=(env "ORCH_LANE_HOST_BUSY_WAIT_SECS=$busy_wait" "$ACCOUNTS_TIMEOUT_CMD" "$ACCOUNTS_TIMEOUT_S")
	elif [[ "$ACCOUNTS_TIMEOUT_S" -ne 0 && "$USE_CACHE" != true ]]; then
		message host-accounts-unbounded "$host" "$ACCOUNTS_TIMEOUT_S" >&2
		return 1
	fi
	err="$(mktemp)" || { message host-accounts-unreadable "$host" mktemp >&2; return 1; }
	# The handler ends in `exit 1`: without it the handler returns and execution
	# falls through to the `cat` below, which reads the file the handler has
	# just deleted and prints its own error where the keyed line belongs.
	trap 'rm -f -- "${err:?}"; exit 1' INT TERM
	rows="$(${bound[@]+"${bound[@]}"} "$SCRIPT_DIR/lane-host" accounts 2>"$err")" || rc=$?
	if [[ "$rc" -ne 0 ]]; then
		if [[ "$rc" -eq "$LANE_HOST_BUSY_EXIT" ]]; then
			cat -- "$err" >&2
			message lane-host-busy accounts - >&2
		elif [[ "$rc" -ne 2 ]]; then
			cat -- "$err" >&2
			message host-accounts-unreadable "$host" "$rc" >&2
		fi
		rm -f -- "$err"
		trap - INT TERM
		# The absent verb is cached; a FAILED one is not. A provider that does not
		# implement it will answer the same way all window, while a failure is the
		# transient one of the two and must not be replayed for the rest of it.
		[[ "$rc" -ne 2 ]] || {
			write_usage_cache host-accounts "$host" "$now_s" '{"status":2,"rows":""}' || true
			return 2
		}
		return 1
	fi
	rm -f -- "$err"
	trap - INT TERM
	record="$(jq -nc --arg r "$rows" '{status: 0, rows: $r}')" || record_rc=$?
	# A record this script could not build is not cached at all: the answer it
	# would have held is already on stdout, and the next listing asks the provider
	# again. A cache that cannot be WRITTEN takes the same policy measure_lane
	# takes for a usage body — it costs the next run a call, never a wrong answer.
	[[ "$record_rc" -ne 0 ]] || write_usage_cache host-accounts "$host" "$now_s" "$record" || true
	printf '%s\n' "$rows"
}

# The recorded reading of the session one `lanes context` row names, the
# lane_context_collect fetch contract: the record on stdout and exit 0, exit 1
# where none is recorded, exit 2 with the cause on stdout where it could not be
# read. A row whose window a running fleet lane record names is that lane, read
# in its own mailbox, through its host where the record names one. The
# caller's own row with no such record is the overseer, whose record is read
# only where it names this very pane: a successor's report must not carry the
# figure its predecessor left in the same mailbox.
context_record_fetch() { # LANE CALLER
	local lane="$1" caller="$2" rec fields item host root path out rc=0 probe_rc=0
	rec="$(jq -c --arg w "$lane" 'map(select(((.window // "") | sub("^.*:"; "")) == $w)) | first // empty' <<<"$CONTEXT_LANES")" \
		|| { printf 'the fleet lane records could not be searched for window %s\n' "$lane"; return 2; }
	if [[ -z "$rec" ]]; then
		if [[ -z "$caller" ]]; then
			printf 'no running fleet lane record names the window %s, so the mailbox its reading is recorded in is unknown\n' "$lane"
			return 2
		fi
		[[ -n "$CONTEXT_OVERSEER_BOX" ]] || { printf 'the main checkout could not be resolved, so the overseer mailbox is unknown\n'; return 2; }
		path="$CONTEXT_OVERSEER_BOX/$LANE_CONTEXT_RECORD"
		[[ -e "$path" ]] || return 1
		out="$(cat -- "$path" 2>&1)" || { printf '%s\n' "$out"; return 2; }
		[[ -n "$out" ]] || return 1
		lane_context_record_fields "$out" || { printf '%s\n' "$out"; return 0; }
		[[ -n "$CONTEXT_CALLER_KEY" && "$LANE_CTX_PANE_KEY" == "$CONTEXT_CALLER_KEY" ]] || return 1
		printf '%s\n' "$out"
		return 0
	fi
	fields="$(jq -r '[(.item // ""), (.host // ""), (.mail_root // "")] | join("\t")' <<<"$rec")" \
		|| { printf 'the fleet lane record for window %s could not be read\n' "$lane"; return 2; }
	item="${fields%%$'\t'*}"; fields="${fields#*$'\t'}"
	host="${fields%%$'\t'*}"; root="${fields#*$'\t'}"
	[[ -n "$item" && -n "$root" ]] || { printf 'the fleet lane record for window %s names no item or no mail_root\n' "$lane"; return 2; }
	path="$root/tmp/lane-mail/$item/$LANE_CONTEXT_RECORD"
	if [[ -z "$host" ]]; then
		[[ -e "$path" ]] || return 1
		out="$(cat -- "$path" 2>&1)" || { printf '%s\n' "$out"; return 2; }
		[[ -n "$out" ]] || return 1
		printf '%s\n' "$out"
		return 0
	fi
	# A hosted read that fails with 2 is a file the host does not hold, or a
	# host lane-host could not reach at all, which answers 2 as well; the probe
	# tells them apart, as lane-mail's own hosted read does.
	out="$("$SCRIPT_DIR/lane-host" cat --item "$item" "$path" 2>/dev/null)" || rc=$?
	if [[ "$rc" -eq 0 ]]; then
		[[ -n "$out" ]] || return 1
		printf '%s\n' "$out"
		return 0
	fi
	"$SCRIPT_DIR/lane-host" touch --item "$item" >/dev/null 2>&1 || probe_rc=$?
	[[ "$probe_rc" -eq 0 ]] || { printf 'the host of %s did not answer\n' "$item"; return 2; }
	[[ "$rc" -ne 2 ]] || return 1
	printf 'the host of %s answered and the read of %s failed with exit %s\n' "$item" "$path" "$rc"
	return 2
}

render_table() {
	jq -r '
		def col($s; $n): ($s | tostring) as $t
		  | if ($t | length) >= $n then $t else $t + (" " * ($n - ($t | length))) end;
		def num($v): if $v == null then "-" else ($v | tostring) + "%" end;
		(["LANE","HARNESS","THROUGH","STATUS","PLAN","5H","WEEK","MODEL","HEADROOM","CLAIMS","AGE"] | @tsv),
		(.[] | [ .alias, .harness, (.measured_through // "local"), .status, (.plan // "-"),
		         num(.session_5h_pct), num(.weekly_pct), num(.model_pct),
		         (if .headroom_pct == null then "-" else (.headroom_pct | tostring) + "%" end),
		         (if .claims == null then "?" else .claims end),
		         (if .usage_age_s == null then "-" else (.usage_age_s | tostring) + "s" end)
		       ] | @tsv)
	' | lane_context_columns
}

# `pick` fails closed. Exit 3 when nothing qualifies, so a caller can tell
# "every lane is full" (actionable: wait, or raise the threshold) apart from
# "the helper broke" (exit 1).
#
# Among the lanes under the threshold, the fewest live claims wins and the wall
# only breaks the tie: back-to-back picks measure usage that has not moved yet,
# so ordering by room alone hands one account the whole fleet. The wall that
# orders is the one that filtered — the binding bucket, or the model's own
# under --model — so the lane chosen is the one with the most room for the
# launch actually being made.
# The threshold is never traded away for a claim count — a lane at or above
# --max-pct is out before this ordering runs.
#
# With --model the threshold reads the bucket that walls THAT model
# (lib/lane-model.sh) instead of the binding bucket: an account whose weekly
# window has room can still have none left for the model the launch will pass,
# and picking it puts a usage banner on the new session's first turn. A lane
# whose windows answer nothing for the model is dropped, the way an unmeasured
# lane is — "we could not measure it" must not read as "it is free".
#
# Which of the two it was is REPORTED, not folded away. The three states are
# lib/lane-model.sh's `wall_verdict`, shared with `pick --lane`, and this form
# partitions its lanes on it: the refusal names the model and the count of each
# state, and every candidate unmeasured gets the named form's own wording. A
# generic "nothing is below the limit" beside a table showing those lanes as ok
# with headroom sends an operator to wait for a reset nobody measured.
# `pick --lane DIR` judges ONE named account instead of choosing among the
# fleet. A launcher that was GIVEN a lane still has the model question to ask,
# and it asks it here: the same wall, the same null rule and the same threshold
# cmd_pick applies, so the answer cannot drift from the chooser's. A launcher
# that judged it for itself would also be judging --max-pct for itself, in a
# shell, without this parser's check on the value.
#
# Only that directory is measured. The chooser's sweep refreshes every account's
# usage, which is a whole fleet of network calls to answer about one.
#
# Exit 0 room, 3 walled, 5 nothing measured this lane for this launch, 4 the
# directory is no configured lane of this harness, 6 the claim store could not
# be read, 1 the judge itself failed — a measurement, a wall, a verdict, or a
# --max-pct this parser refused. Each refusal has its own status because a
# launcher dispatches on the status and would otherwise name the wrong
# dependency to an operator.
#
# 4 is not a refusal a launcher inherits: a directory outside the discovery
# glob, or outside ORCH_LANE_DIRS where that is set, has no record here and
# never had one, so a launch onto it is judged by whatever gate the launcher
# had before this question existed.
#
# A lane whose usage could not be fetched has status other than ok and answers
# 5, not 3: it is a window nobody read, and the caller names the read rather
# than telling an operator their allowance is gone.
#
# The plain form prints the env prefix on 0 and nothing on stdout otherwise;
# every refusal puts its keyed line on stderr. Under --json the lane's record
# is printed on 0, 3 and 5, and on 3 it carries `wall`. On this form the wall IS
# the answer rather than the chooser's working field, so a caller reports the
# percentage it refused on without measuring a second time. The record on 5
# carries the `status` that says WHY nothing measured, which a caller needs to
# tell a window naming no model from a credential this machine cannot renew:
# only the second has a remedy, and only that one leaves an account whose
# copy on another host may still be live.
cmd_pick_lane() {
	local dir="$1" harness="$2" max_pct="$3" model="$4" as_json="$5" binding_floor="$6"
	local target found="" d record wall bucket verdict
	# The same claim load `list` does, for the same reason: the record this form
	# hands back carries `claims`, and without the store read it would carry 0
	# for an account with sessions in flight — the one value emit_lane says that
	# field must never invent. emit_lane leaves it null when the store could not
	# be read, and that is the whole of what an unreadable store costs here.
	load_lane_claims
	# A NOTICE, never a refusal. This form's verdict is the wall and nothing
	# else: no arm below reads `claims`, and neither does the launcher that
	# dispatches on the status, so refusing would stop a launch over a field
	# nobody consults. The chooser is the other case — it SORTS on `claims`, so
	# an unreadable store there can stack a second session onto an account
	# already running one, and it dies. Same policy as the claim write in
	# open-terminal, which is never fatal: a launch that worked is not a failure
	# because its bookkeeping did not.
	[[ "$LANE_CLAIMS_RC" -eq 0 ]] || message pick-lane-claims >&2
	target="$(lane_claims_canon "$dir")"
	# Both sides through the one normaliser, so a dir given with a trailing
	# slash or through a symlink reaches the record discovered for it.
	while IFS= read -r d; do
		[[ -n "$d" ]] || continue
		[[ "$(lane_claims_canon "$d")" == "$target" ]] || continue
		found="$d"
		break
	done < <(lane_dirs "$harness")
	if [[ -z "$found" ]]; then
		message pick-lane-unlisted "$dir" "$harness" >&2
		return 4
	fi
	record="$(measure_lane "$harness" "$found")" || { message pick-lane-failed "$dir" measure >&2; return 1; }
	record="$(jq -c --arg model "$model" --argjson floor "$binding_floor" "$LANE_MODEL_JQ"'
		with_lane_binding($model; $floor)
	' <<<"$record")" || { message pick-lane-failed "$dir" wall >&2; return 1; }
	# The classifier is lib/lane-model.sh's, shared with the fleet chooser: one
	# definition of room, walled and unmeasured, so this form cannot answer a
	# question the chooser answers differently.
	verdict="$(jq -r --argjson max "$max_pct" "$LANE_MODEL_JQ"'
		.wall | wall_verdict($max)
	' <<<"$record")" || { message pick-lane-failed "$dir" verdict >&2; return 1; }
	record="$(jq -c "$LANE_MODEL_JQ"' lane_public' <<<"$record")" || return 1
	case "$verdict" in
		room)
			if [[ "$as_json" == "true" ]]; then printf '%s\n' "$record"; return 0; fi
			# The mapping is lib/lane-launch.sh's, shared with the launchers
			# that render this prefix into a command; `pick --harness` is
			# validated to claude or codex, so the harness here is one it names.
			lane_env_prefix "$harness" "$found"
			return
			;;
		walled)
			wall="$(jq -er '.wall' <<<"$record")" || {
				message pick-lane-failed "$dir" wall >&2
				return 1
			}
			bucket="$(jq -er '.binding_bucket' <<<"$record")" || {
				message pick-lane-failed "$dir" bucket >&2
				return 1
			}
			message pick-lane-walled "$dir" "$wall" "$bucket" "$max_pct" >&2
			# Under --json only, as on exit 0: the plain form speaks env prefixes
			# and keyed lines, and its refusal detail is the wall= field above.
			[[ "$as_json" != "true" ]] || printf '%s\n' "$record"
			return 3
			;;
		unmeasured)
			message pick-lane-unmeasured "$dir" "${model:-none}" >&2
			# Under --json only, as on 0 and 3. The record's `status` is the
			# whole of what a launcher needs here: `expired` names a credential
			# this machine could not renew, which is an owner's login to fix
			# rather than a window to wait out.
			[[ "$as_json" != "true" ]] || printf '%s\n' "$record"
			return 5
			;;
		*)
			# jq answered something this case does not know, which is the judge
			# broken rather than a lane refused.
			message pick-lane-failed "$dir" "verdict:$verdict" >&2
			return 1
			;;
	esac
}

cmd_pick() {
	local harness="$1" max_pct="$2" as_json="$3" model="$4" binding_floor="$5" exclude="$6"
	local lanes judged chosen walled unmeasured
	load_lane_claims
	lanes="$(collect_lanes "$harness" "$exclude")"
	# An unreadable claim store reads as "no launches in flight", which is the
	# one thing it must not read as: picking on it can stack a second session
	# onto an account already running one.
	[[ "$LANE_CLAIMS_RC" -eq 0 ]] || die pick-claims "$@"
	# PARTITIONED on lib/lane-model.sh's verdict, never filtered on a predicate
	# written out again here: the named form reads the same definition, so the
	# chooser cannot lose a state that form knows. The counts are what the
	# refusal below reports, which is why nothing qualifying is not one answer.
	judged="$(jq -c --argjson max "$max_pct" --arg model "$model" --argjson floor "$binding_floor" "$LANE_MODEL_JQ"'
		[ .[] | with_lane_binding($model; $floor)
		  | . + {verdict: (.wall | wall_verdict($max))} ]
		| { chosen: ([ .[] | select(.verdict == "room") ]
		              | sort_by([(.claims // 0), .wall]) | first
		              | if . == null then null
		                else . + {effective_headroom_pct: (if .wall == null then null else 100 - .wall end)}
		                | del(.wall, .verdict) | lane_public end),
		    qualifying: ([ .[] | select(.verdict == "room") ] | length),
		    walled: ([ .[] | select(.verdict == "walled") ] | length),
		    unmeasured: ([ .[] | select(.verdict == "unmeasured") ] | length) }
	' <<<"$lanes")"
	chosen="$(jq -c '.chosen' <<<"$judged" 2>/dev/null || true)"
	if [[ -z "$chosen" || "$chosen" == "null" ]]; then
		walled="$(jq -r '.walled // 0' <<<"$judged" 2>/dev/null || true)"
		unmeasured="$(jq -r '.unmeasured // 0' <<<"$judged" 2>/dev/null || true)"
		{
			# Walled and unmeasured are different news for an operator: one
			# allowance is spent and will reset, the other was never read, and
			# the table underneath shows an unmeasured lane as ok with headroom.
			# Every candidate unmeasured gets the named form's own wording.
			if [[ "${walled:-0}" -eq 0 && "${unmeasured:-0}" -gt 0 ]]; then
				message no-candidate-unmeasured "$harness" "${model:-none}" "$unmeasured"
			else
				message no-candidate "$harness" "$max_pct" "${model:-none}" "${walled:-0}" "${unmeasured:-0}"
			fi
			render_table <<<"$lanes"
		} >&2
		# The two counts on STDOUT under --json, as the named form prints its
		# record there on the same exit: a caller walking several picks reports
		# what each sweep found, and the keyed line above is a message for a
		# person. `{"walled":N,"unmeasured":N}` is the whole object; nothing
		# else is printed on this path, so a caller reading `.walled` gets the
		# count or a jq error, never a lane record it would mistake for a pick.
		#
		# Both are proven digits before jq is handed them: the reads above
		# swallow a failure into an empty string, and --argjson on one is jq
		# refusing its own arguments, which would abort this refusal instead of
		# returning it.
		[[ "${walled:-}" =~ ^[0-9]+$ ]] || walled=0
		[[ "${unmeasured:-}" =~ ^[0-9]+$ ]] || unmeasured=0
		[[ "$as_json" != "true" ]] || jq -nc --argjson w "$walled" --argjson u "$unmeasured" \
			'{walled: $w, unmeasured: $u, qualifying_count: 0}'
		return 3
	fi
	if [[ "$as_json" == "true" ]]; then
		jq -c --argjson n "$(jq -r '.qualifying' <<<"$judged")" '. + {qualifying_count: $n}' <<<"$chosen"
		return 0
	fi
	lane_env_prefix "$harness" "$(jq -r '.config_dir' <<<"$chosen")"
}

# ── CLI ──────────────────────────────────────────────────────────────────────

need_val() { [[ $# -ge 2 && -n "${2:-}" ]] || die missing-value "$@"; }

# pct_valid VALUE — the one shape-and-range test every percentage in this
# script is held to: a whole number, 0-100. A threshold above 100 passes every
# real percentage, so a fully spent wall at 100 would read as room and the
# launch would open on the usage banner both pick forms exist to prevent. The
# caller supplies its own refusal key, so one bound serves the flag, its
# setting and the handoff mark without a second spelling of the test.
pct_valid() { [[ "$1" =~ ^[0-9]{1,3}$ ]] && (( 10#$1 <= 100 )); }

# The one parser. It answers every form that produces no lane work — the
# command index, a help request, a bad option — so the dry run below decides
# those before any configuration is read, off these arms and no second copy.
parse_argv() {
	# Every default this parser owns is set HERE, never above the loader: the
	# settings [env] table assigns any name and .env.local is sourced as shell, so
	# a default above the load is whatever the checkout left there for every
	# option the caller did not pass. Settings reach the script through their own
	# ORCH_* names, resolved after the load.
	HARNESS=""
	# The bound as percent USED, which is the unit lib/lane-model.sh compares a
	# wall against. --min-headroom-pct 10 is the same bound in the record's own
	# unit and is converted to this one before any lane is judged. Assigned
	# below from ORCH_LANE_MAX_PCT or from the flag, whichever the caller gave:
	# the setting is read HERE, in the parser the loader has already run for,
	# so a launcher that forwards nothing still gets the configured threshold
	# and no second copy of the default exists to drift from this one.
	MAX_PCT=""
	PCT_OPTION=""
	PCT_VALUE=""
	AS_JSON=false
	USE_CACHE=true
	# The caller's own pass interval, which widens the age a cached figure is
	# served within. Read here for the reason MAX_PCT is: the loader has run
	# for this parse, so the setting and the flag meet in one place and no
	# second copy of the default exists to drift from this one.
	USAGE_MAX_AGE=""
	LANE_ARG=""
	EXCLUDE_LANE=""
	MODEL=""
	BINDING_FLOOR=false
	LOCAL_ONLY=false

	SUB="${1:-}"
	# A bare invocation names the commands and does nothing else, so it is one
	# of those forms rather than a lane failure.
	[[ -n "$SUB" ]] || { print_lanes_index; exit 0; }
	case "$SUB" in
		help|--help|-h) print_lanes_usage; exit 0 ;;
	esac
	shift

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--harness) need_val "$@"; HARNESS="$2"; shift 2 ;;
			--harness=*) HARNESS="${1#--harness=}"; need_val --harness "$HARNESS"; shift ;;
			--max-pct) need_val "$@"; PCT_OPTION=--max-pct; PCT_VALUE="$2"; shift 2 ;;
			--max-pct=*) PCT_OPTION=--max-pct; PCT_VALUE="${1#--max-pct=}"; need_val --max-pct "$PCT_VALUE"; shift ;;
			--min-headroom-pct) need_val "$@"; PCT_OPTION=--min-headroom-pct; PCT_VALUE="$2"; shift 2 ;;
			--min-headroom-pct=*) PCT_OPTION=--min-headroom-pct; PCT_VALUE="${1#--min-headroom-pct=}"; need_val --min-headroom-pct "$PCT_VALUE"; shift ;;
			--model) need_val "$@"; MODEL="$2"; shift 2 ;;
			--model=*) MODEL="${1#--model=}"; need_val --model "$MODEL"; shift ;;
			--binding-floor) BINDING_FLOOR=true; shift ;;
			--local) LOCAL_ONLY=true; shift ;;
			--lane) need_val "$@"; LANE_ARG="$2"; shift 2 ;;
			--lane=*) LANE_ARG="${1#--lane=}"; need_val --lane "$LANE_ARG"; shift ;;
			--exclude-lane) need_val "$@"; EXCLUDE_LANE="$2"; shift 2 ;;
			--exclude-lane=*) EXCLUDE_LANE="${1#--exclude-lane=}"; need_val --exclude-lane "$EXCLUDE_LANE"; shift ;;
			--json) AS_JSON=true; shift ;;
			--no-cache) USE_CACHE=false; shift ;;
			--max-age) need_val "$@"; USAGE_MAX_AGE="$2"; shift 2 ;;
			--max-age=*) USAGE_MAX_AGE="${1#--max-age=}"; need_val --max-age "$USAGE_MAX_AGE"; shift ;;
			--help|-h) print_lanes_usage; exit 0 ;;
			*)
				# `check` takes one config dir and `state` one item; anything
				# else is an option typo.
				[[ ( "$SUB" == check || "$SUB" == state ) && -z "$LANE_ARG" && "$1" != -* ]] || die unknown-option "$@"
				LANE_ARG="$1"
				shift
				;;
		esac
	done

	# Two spellings, ONE bound: --min-headroom-pct is converted into --max-pct
	# here and nowhere else, so lib/lane-model.sh's wall_verdict stays the only
	# place a lane is judged against it. The refusal names the spelling that was
	# actually passed.
	if [[ -n "$PCT_OPTION" ]]; then
		pct_valid "$PCT_VALUE" || die invalid-percent "$PCT_OPTION"
		if [[ "$PCT_OPTION" == --max-pct ]]; then
			MAX_PCT=$((10#$PCT_VALUE))
		else
			MAX_PCT=$((100 - 10#$PCT_VALUE))
		fi
	else
		# Held to the same bound as the flag and refused on the same terms: a
		# threshold nobody can read must not fall back to a number of this
		# script's own, which is the silent disagreement between launcher and
		# pick that reading the setting here exists to end.
		MAX_PCT="${ORCH_LANE_MAX_PCT:-95}"
		pct_valid "$MAX_PCT" || die invalid-lane-max-pct "$MAX_PCT"
		MAX_PCT=$((10#$MAX_PCT))
	fi

	# Refused rather than dropped: an interval nobody can read would silently
	# leave this caller on the TTL alone, which is the fetch-every-pass burst
	# the option exists to close. Normalized where the digits are proven, so no
	# later comparison re-infers a base from a leading zero.
	[[ -n "$USAGE_MAX_AGE" ]] || USAGE_MAX_AGE="${ORCH_LANES_USAGE_MAX_AGE:-0}"
	[[ "$USAGE_MAX_AGE" =~ ^[0-9]+$ ]] || die invalid-usage-max-age "$USAGE_MAX_AGE"
	USAGE_MAX_AGE=$((10#$USAGE_MAX_AGE))
}

# `.env.local` is sourced as shell, so anything answering without doing lane
# work answers before the loader runs: the dry run is the real parser in a
# subshell, so nothing it assigns survives to be clobbered, and 9 is the only
# status meaning it reached the end.
parse_rc=0
( parse_argv "$@"; exit 9 ) || parse_rc=$?
[[ "$parse_rc" -eq 9 ]] || exit "$parse_rc"
unset parse_rc

# Probed only once argv is settled: help, the command index and a bad option are
# answers this script owes with nothing else installed.
need_jq

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export PROJECT_ROOT
# shellcheck source=lib/file-lock.sh
source "$SCRIPT_DIR/lib/file-lock.sh"
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
# This script runs without errexit, so the loader's refusal must be checked
# here: continuing past it would select a lane from whatever exported before
# the bad line — a successful-looking answer from partial configuration.
kendex_load_project_env "$PROJECT_ROOT" || {
  message settings-rejected >&2
  exit 1
}
# Live claims are read ONCE per run, before any lane is measured: the pruning
# read is what keeps the store bounded, and one snapshot keeps every lane's
# count taken against the same instant.
LANE_CLAIMS_LIVE=""
# Non-zero when the claim store could not be read: `list` still reports what
# it measured, `pick` refuses rather than deciding on an unknown.
LANE_CLAIMS_RC=0

# shellcheck source=lib/lane-claims.sh
source "$SCRIPT_DIR/lib/lane-claims.sh"
# shellcheck source=lib/lane-context.sh
source "$SCRIPT_DIR/lib/lane-context.sh"
# shellcheck source=lib/lane-model.sh
source "$SCRIPT_DIR/lib/lane-model.sh"
# For lane_env_prefix: the harness-to-variable mapping this script's pick forms
# hand back and the launchers render, owned in one place so they cannot drift.
# shellcheck source=lib/lane-launch.sh
source "$SCRIPT_DIR/lib/lane-launch.sh"
# shellcheck source=lib/lane-host-slots.sh
source "$SCRIPT_DIR/lib/lane-host-slots.sh"
# shellcheck source=lib/lane-state.sh
source "$SCRIPT_DIR/lib/lane-state.sh"
# The lib carries the strict mode its other callers run under. This one is
# deliberately errexit-free — one unreadable lane must not fail the whole
# inventory — so restore that posture at the seam.
set +e

CLAUDE_USAGE_URL="${ORCH_LANES_CLAUDE_USAGE_URL:-https://api.anthropic.com/api/oauth/usage}"
CLAUDE_TOKEN_URL="${ORCH_LANES_CLAUDE_TOKEN_URL:-https://platform.claude.com/v1/oauth/token}"
CLAUDE_OAUTH_BETA="oauth-2025-04-20"
CODEX_USAGE_URL="${ORCH_LANES_CODEX_USAGE_URL:-https://chatgpt.com/backend-api/wham/usage}"

# ~5h, with tolerance — Codex reports window durations that vary by account.
SESSION_WINDOW_S=18000

# At least the longest watch interval on the host: `oversee-watch --interval`
# defaults to 240, and a TTL under that guarantees every pass finds the figure
# expired and fetches, which is the burst this cache exists to bound.
USAGE_TTL="${ORCH_LANES_USAGE_TTL:-300}"
# How long a reader waits for the host-wide refresh lock. The holder refreshes
# one account, a request curl bounds at 10 seconds, so a wait that long
# outlasts an ordinary refresh. It stays under the 20-second ceiling
# lane-mail-check puts on `pick --lane`, so a timed-out wait still leaves that
# caller time for its own request. A timeout costs one duplicate request for
# one account, under its keyed notice.
USAGE_LOCK_WAIT_S=10
# What a COLD lane waits before the retry after a 429. The recorded window can
# be minutes, and a listing is a caller waiting at a terminal.
USAGE_RETRY_WAIT_MAX_S=5
# Whether this run has spent its one cold-lane retry. One per run, not per
# lane: lanes are measured one after another, so a retry per cold lane would
# cost a host-wide limit that wait and one extra request for every cold lane.
# With it, a run spends at most USAGE_RETRY_WAIT_MAX_S and one request on
# retries. collect_lanes measures every lane in one pipeline stage, in
# sequence, so a later lane there reads what an earlier one set.
USAGE_RETRY_SPENT=false
# How long a refused endpoint is left alone when its answer named no
# Retry-After: long enough that a fleet measuring every thirty seconds stops
# feeding the limit it hit, short enough that a lane comes back inside one
# operator's attention. An answer that DOES name a Retry-After is waited out for
# exactly that, since the endpoint is the one that knows.
USAGE_REFUSAL_WINDOW_S=300
# Built at most once per measuring shell, by the first lane that needs renewing.
CLAUDE_TOKEN_UA=""
# Seconds the provider's `accounts` verb may take. It can cross a network, and
# this listing runs on every overseer cycle, so an unbounded call makes the fleet
# inventory wait on one host. 0 asks for no bound.
ACCOUNTS_TIMEOUT_S="${ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S:-10}"
# `timeout`, or the coreutils spelling a Homebrew install carries, empty where
# neither is installed. Feature-detected: without it the call is unbounded, and
# the cache below still holds the cost to one call per window.
ACCOUNTS_TIMEOUT_CMD=""
for _accounts_timeout in timeout gtimeout; do
	if command -v "$_accounts_timeout" >/dev/null 2>&1; then
		ACCOUNTS_TIMEOUT_CMD="$_accounts_timeout"
		break
	fi
done
unset _accounts_timeout
# Beside the claim store, resolved by its owner, so both follow one setting.
USAGE_CACHE_DIR="$(dirname -- "$(lane_claims_dir "$PROJECT_ROOT")")/usage"
# One clock for every host a fleet spans: a retirement date is a UTC date. A
# clock that cannot be read refuses the run, since an empty date would read as
# "no retirement has come" and hand a retired lane back out.
TODAY="$(date -u +%Y-%m-%d)" && [[ "$TODAY" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die time-failed

# A lane key is a directory name or an alias. A `/` or `~` makes it a path,
# which names no lane, so an exclusion written that way would protect nothing.
lane_key_valid() {
	[[ -n "$1" && "$1" != */* && "$1" != *'~'* ]]
}

# Whether $1 is a YYYY-MM-DD naming a real calendar day. Arithmetic, not
# date(1): GNU and BSD date parse differently, and this runs on both.
calendar_date_valid() {
	[[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 1
	local y=$((10#${1:0:4})) m=$((10#${1:5:2})) d=$((10#${1:8:2})) days=31
	case "$m" in
		4|6|9|11) days=30 ;;
		2) days=28; (( y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) )) && days=29 ;;
	esac
	(( m >= 1 && m <= 12 && d >= 1 && d <= days ))
}

# Refused before any lane is enumerated: an exclusion or retirement that names
# no lane would leave the account it meant to cover readable and pickable, and
# a TTL that cannot be read has no window to apply.
validate_lane_settings() {
	local item
	while IFS= read -r item; do
		lane_key_valid "$item" || die invalid-exclude "$item"
	done < <(setting_items "${ORCH_LANE_EXCLUDE:-}")
	while IFS= read -r item; do
		[[ "$item" == *=* ]] && lane_key_valid "$(trim "${item%%=*}")" \
			&& calendar_date_valid "$(trim "${item#*=}")" || die invalid-retire "$item"
	done < <(setting_items "${ORCH_LANE_RETIRE:-}")
	[[ "$USAGE_TTL" =~ ^[0-9]+$ ]] || die invalid-usage-ttl "$USAGE_TTL"
	# Refused here rather than handed to `timeout`, which would exit 125 and be
	# reported as the provider failing the verb.
	[[ "$ACCOUNTS_TIMEOUT_S" =~ ^[0-9]+$ ]] || die invalid-accounts-timeout "$ACCOUNTS_TIMEOUT_S"
	# Normalized once, where the digits are proven, so no later arithmetic can
	# re-infer a base: `[[ 08 -ne 0 ]]` reads the leading zero as octal, errors,
	# and the bound below is neither applied nor refused.
	ACCOUNTS_TIMEOUT_S=$((10#$ACCOUNTS_TIMEOUT_S))
	USAGE_TTL=$((10#$USAGE_TTL))
}

parse_argv "$@"

case "$SUB" in
	list)
		HARNESS="${HARNESS:-all}"
		[[ "$HARNESS" =~ ^(claude|codex|all)$ ]] || die invalid-harness "$@"
		validate_lane_settings
		load_lane_claims
		# Every row says which credential measured it, local rows included: a
		# listing that labelled only the hosted ones would leave the reader to
		# infer the rest, and the whole point of the merge is that one account
		# can carry two readings that disagree. emit_lane writes that field, so
		# neither this listing nor the reader below stamps rows afterwards.
		out="$(collect_lanes "$HARNESS")"
		# Asked only where a provider is configured. A fleet with no provider
		# reads the local config dirs and nothing else, exactly as before.
		if [[ "$LOCAL_ONLY" != true && "${ORCH_LANE_HOST:-local}" != local ]]; then
			# The reader's own status is read first and adds nothing to this
			# listing: it has already said on stderr what it did with an absent
			# or failed verb, and either way there are no host rows to merge.
			# Only the slurp that follows is this arm's to report, so a merge
			# failure is never printed as the provider's answer.
			accounts_rc=0
			rows="$(host_account_records "${ORCH_LANE_HOST}" "$HARNESS")" || accounts_rc=$?
			if [[ "$accounts_rc" -eq 0 ]]; then
				hosted_rc=0
				hosted="$(jq -cs . <<<"$rows")" || hosted_rc=$?
				if [[ "$hosted_rc" -ne 0 ]]; then
					message host-accounts-merge-failed "$ORCH_LANE_HOST" "$hosted_rc" >&2
				else
					out="$(jq -c --argjson hosted "$hosted" '. + $hosted' <<<"$out")"
				fi
			fi
		fi
		out="$(jq -c --argjson max "$MAX_PCT" "$LANE_MODEL_JQ"' map(. + {verdict: (.wall | wall_verdict($max))} | lane_public)' <<<"$out")"
		if [[ "$AS_JSON" == "true" ]]; then printf '%s\n' "$out"; else render_table <<<"$out"; fi
		;;
	host-accounts)
		HARNESS="${HARNESS:-all}"
		[[ "$HARNESS" =~ ^(claude|codex|all)$ ]] || die invalid-harness "$@"
		validate_lane_settings
		# `local` names no provider, so there is no host copy to report. Refused
		# rather than answered as 2: the dispatcher's own refusal of a provider
		# verb under `local` is that same 2, and a caller reading it as "the
		# optional verb is absent" would take a misconfigured host for a
		# provider that simply does not implement it.
		[[ "${ORCH_LANE_HOST:-local}" != local ]] || die host-accounts-local
		# emit_lane reads the claim store for every record it writes, host rows
		# included, so the store is loaded before any row is emitted.
		load_lane_claims
		accounts_rc=0
		rows="$(host_account_records "${ORCH_LANE_HOST}" "$HARNESS")" || accounts_rc=$?
		# The provider's answer, absent verb and failed verb are passed straight
		# through as this command's own status: the caller asking whether a host
		# holds an account must be able to tell "it says it holds none" from
		# "there is no answer to be had".
		[[ "$accounts_rc" -eq 0 ]] || exit "$accounts_rc"
		render_rc=0
		out="$(jq -cs "$LANE_MODEL_JQ"' map(lane_public)' <<<"$rows")" || render_rc=$?
		if [[ "$render_rc" -eq 0 && "$AS_JSON" != "true" ]]; then
			out="$(jq -r '.[] | [.config_dir, .harness] | @tsv' <<<"$out")" || render_rc=$?
		fi
		# Never a partial answer: a render that failed prints no rows at all,
		# because a caller matching an account against a truncated list reads a
		# held account as one the host does not hold.
		[[ "$render_rc" -eq 0 ]] || die host-accounts-render-failed "$ORCH_LANE_HOST" "$render_rc"
		printf '%s\n' "$out"
		;;
	pick)
		HARNESS="${HARNESS:-claude}"
		[[ "$HARNESS" =~ ^(claude|codex)$ ]] || die invalid-pick-harness "$@"
		validate_lane_settings
		if [[ -n "$LANE_ARG" ]]; then
			[[ -z "$EXCLUDE_LANE" ]] || die unknown-option --exclude-lane
			cmd_pick_lane "$LANE_ARG" "$HARNESS" "$MAX_PCT" "$MODEL" "$AS_JSON" "$BINDING_FLOOR"
		else
			cmd_pick "$HARNESS" "$MAX_PCT" "$AS_JSON" "$MODEL" "$BINDING_FLOOR" "$EXCLUDE_LANE"
		fi
		;;
	check)
		[[ -n "$LANE_ARG" ]] || die missing-value check
		validate_lane_settings
		# A bare word may be an alias, and an excluded lane's alias is absent
		# from `list`: the directory names that alias stands for are checked too.
		check_names="$LANE_ARG"
		if [[ "$LANE_ARG" != */* ]]; then
			while IFS=$'\t' read -r alias_name alias_val; do
				[[ "$alias_val" != "$LANE_ARG" ]] || check_names+=$'\n'"$alias_name"
			done < <(alias_pairs)
		fi
		while IFS= read -r check_name; do
			if lane_excluded "$check_name"; then message lane-excluded "$LANE_ARG" >&2; exit 4; fi
			if retired_on="$(lane_retired "$check_name")"; then message lane-retired "$LANE_ARG" "$retired_on" >&2; exit 4; fi
		done <<<"$check_names"
		;;
	state)
		[[ -n "$LANE_ARG" ]] || die missing-value state
		lane_pane_observe "$LANE_ARG"
		# No /proc read: this script's vantage point is the tmux server, the
		# same one oversee-watch reads, so the two cannot disagree. A caller
		# that also holds the lane's worktree — `open-terminal --wake` — passes
		# the harness process as the sixth argument instead.
		lane_state_rc=0
		lane_state LANE_STATE_ANSWER listed "$LANE_PANE_CMD" "$LANE_PANE_PID" "$LANE_PANE_SCREEN" || lane_state_rc=$?
		[[ "$lane_state_rc" -ne 2 ]] || die lane-scan-failed "$LANE_ARG"
		# A hosted lane's harness is on another machine, so `unjudged` here is
		# "no pane on this server carries the name", never "the lane is dead".
		# The provider is asked whether the host itself answers, and its answer
		# is reported BESIDE the state, never AS the state: `touch` keeps a host
		# alive and carries no "no such lane" reply (schemas/lane-host.md), so
		# every non-zero exit is a probe that failed — a rebooting host, the
		# dispatcher's own refusal, a transient ssh error — and calling that
		# `gone` would send the overseer down the window-gone path in
		# references/oversee-events.md, which relaunches an item whose first
		# session is still running on the remote host. lane-mail's failed read
		# says `host-unreachable` for this same probe and asserts no lane state
		# either.
		if [[ "$LANE_STATE_ANSWER" == unjudged && "${ORCH_LANE_HOST:-local}" != local && -z "$LANE_PANE_SCREEN" ]]; then
			probe_rc=0
			# The provider knows the item, never the session a window sits in.
			probe_err="$("$SCRIPT_DIR/lane-host" touch --item "${LANE_ARG#*:}" 2>&1 >/dev/null)" || probe_rc=$?
			if [[ "$probe_rc" -eq "$LANE_HOST_BUSY_EXIT" ]]; then
				printf '%s\n' "$probe_err" >&2
				message lane-host-busy touch "$LANE_ARG" >&2
			elif [[ "$probe_rc" -ne 0 ]]; then
				message host-unreachable "$LANE_ARG" "$LANE_STATE_ANSWER" "$probe_err" >&2
			fi
		fi
		if [[ "$AS_JSON" == "true" ]]; then
			jq -nc --arg i "$LANE_ARG" --arg s "$LANE_STATE_ANSWER" '{item:$i,state:$s}'
		else
			printf '%s\n' "$LANE_STATE_ANSWER"
		fi
		;;
	context)
		HANDOFF_HEADROOM_PCT="${ORCH_HANDOFF_HEADROOM_PCT:-3}"
		pct_valid "$HANDOFF_HEADROOM_PCT" || die invalid-handoff-headroom "$HANDOFF_HEADROOM_PCT"
		# The context mark resolves through orch-env, as the turn-end hook and
		# oversee-succeed resolve it, so one settings file sets it for all three.
		HANDOFF_CONTEXT_PCT="$("$SCRIPT_DIR/orch-env" ORCH_HANDOFF_CONTEXT_PCT 90)" || die settings-rejected
		context_rc=0
		lane_context_handoff_due 0 1 "$HANDOFF_CONTEXT_PCT" >/dev/null || context_rc=$?
		[[ "$context_rc" -ne 2 ]] || die invalid-handoff-context "$HANDOFF_CONTEXT_PCT"
		validate_lane_settings
		load_lane_claims
		# An unreadable claim store is not an empty fleet: reporting no lanes
		# would read as "every lane has room", which is the answer that sends
		# a lane into its wall.
		[[ "$LANE_CLAIMS_RC" -eq 0 ]] || die context-claims "$@"
		# The caller's pane names the SHAPE; lib/lane-context.sh's
		# lane_context_caller_cfg turns that into the account, and owns the
		# rule. oversee-succeed's own caller entry pairs them this way, and the
		# lane's turn-end handoff hook asks the same function about itself, so
		# no session is one account in this report and another there.
		caller_cfg=""
		CONTEXT_CALLER_KEY=""
		if [[ -n "${TMUX_PANE:-}" ]]; then
			caller_cmd="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_current_command}' 2>/dev/null)" || caller_cmd=""
			caller_cfg="$(lane_context_caller_cfg "$(lane_context_shape "${caller_cmd#-}")")"
			CONTEXT_CALLER_KEY="$(lane_context_caller_key)" || CONTEXT_CALLER_KEY=""
		fi
		# Where each row's reading is recorded: a lane's in its own mailbox, which
		# its fleet lane record places, and the overseer's in the overseer mailbox
		# at the main checkout, where lane-mail keeps it.
		# No fleet state is a session outside any fleet, whose rows are the
		# caller's alone; a state that is there and cannot be read is refused.
		CONTEXT_LANES='[]'
		fleet_exists="$("$SCRIPT_DIR/workflow-state" exists --json oversee 2>/dev/null | jq -r '.exists')" \
			|| die context-fleet oversee
		if [[ "$fleet_exists" == true ]]; then
			CONTEXT_LANES="$("$SCRIPT_DIR/workflow-state" get oversee '[.lanes // [] | .[] | select(.status == "running")]' 2>/dev/null)" \
				|| die context-fleet oversee
		fi
		CONTEXT_OVERSEER_BOX="$("$SCRIPT_DIR/git-context" common-root . 2>/dev/null)/tmp/lane-mail/overseer" || CONTEXT_OVERSEER_BOX=""
		# A separate list, never LANE_CLAIMS_LIVE itself: the caller's pane is
		# a pane to measure and not a launch in flight, and the usage pass
		# below counts that global's rows against each account.
		panes_to_measure="$(lane_context_with_caller "$LANE_CLAIMS_LIVE" "$(lane_claims_canon "$caller_cfg")")"
		out="$(lane_context_collect "$panes_to_measure" lane_alias_for context_record_fetch "$HANDOFF_CONTEXT_PCT")"
		usage="$(collect_lanes all)"
		usage_i=0; usage_count="$(jq -r length <<<"$usage")"
		while (( usage_i < usage_count )); do
			usage_dir="$(jq -r --argjson i "$usage_i" '.[$i].config_dir' <<<"$usage")"
			usage_key="$(lane_claims_canon "$usage_dir")"
			usage="$(jq -c --argjson i "$usage_i" --arg d "$usage_key" '.[$i].config_dir=$d' <<<"$usage")"
			usage_i=$((usage_i + 1))
		done
		out="$(jq -nc --argjson c "$out" --argjson u "$usage" --argjson t "$HANDOFF_HEADROOM_PCT" '$c|map(. as $x|((($u|map(select(.config_dir==$x.config_dir))|first)//{}) as $l|($l.headroom_pct//null) as $h|.+{headroom_pct:$h,binding_resets_at:($l.binding_resets_at//null),handoff_required:(($h!=null and $h<=$t) or $x.context_handoff_due==true)}))')"
		if [[ "$AS_JSON" == "true" ]]; then printf '%s\n' "$out"; else lane_context_render <<<"$out"; fi
		;;
	*) die unknown-subcommand "$@" ;;
esac
