#!/usr/bin/env bash
# oversee-cycle — a closed lane's merge-time record against its class target,
# and the fleet's per-class rollup of those records.
#
# Usage:
#   oversee-cycle [--state-dir DIR] record (--pr N | --commit SHA)
#                 [--tier micro|small|standard] [--repo OWNER/REPO] ITEM
#   oversee-cycle [--state-dir DIR] rollup
#
# --state-dir is the fleet state's directory, as workflow-state takes it.
#
# record reads the lane record ITEM names in the oversee state, the merged
# pull request's stamps from the github skill's `pr-timeline`, and the class
# of the merged diff from harness-ci's classifier through lib/change-class.sh,
# over the merge commit's first parent to the merge commit, read from this
# checkout, which fetches the merge commit from origin where it lacks it. Run
# it from a checkout of the lane's repository: where the lane's worktree names
# another origin, or --repo another repository, the class is unread with
# cause checkout-other-repo. A classifier answer whose `measured=` marker is
# not true is no class. --repo
# defaults to the lane record's repo, then this checkout's. The recorded launch
# tier wins; a differing --tier refuses as tier-mismatch naming launch and given.
# A record whose tier is null, a launch that judged none, takes --tier where
# given and otherwise records none, printed `-`, with escaped null.
# An old record with no tier warns as launch-tier-missing and requires --tier.
# --commit records a single-commit direct push. The caller must refuse a
# multi-commit push: no push-before value is an input. The supplied commit's
# authored date is first_commit and its committer date is merged, not the
# network push time. Its first parent to the commit uses the same classifier.
# No CI check is read. pr_opened, gate_green, ci_green and armed are null,
# as are open, phase, gate waits, pr_rounds and refixed; verdict is unmeasured
# when classified. The cycle object carries commit instead of pr, and the
# cycle line below uses commit=SHA instead of pr=N. actual and escaped still
# enter the per-class rollup. Exactly one of --pr and --commit is required.
# The round counts come from
# the lane's own workflow state, read as oversee-report reads it through
# lib/lane-gitfile.sh's lane_item_state; a lane whose state is gone, which
# ../workflows/merge-pr.md § 5 removes, records its rounds as null, never as zero, and a
# read that failed also prints `oversee-cycle: rounds-unread item=ITEM` and
# the reason on stderr. A lane whose host kind declares files=none
# (lane-host capabilities), a Claude cloud session, keeps no state this
# machine can read: its rounds are null and nothing is read or printed.
#
# It writes the record's `cycle` object, appends one `cycle` row to the fleet
# log, and prints the same line:
#   cycle item=ITEM pr=N class=C tier=T target=S merge_group=S actual=S open=S verdict=V
#     phase=P phase_secs=S cause=W bot_wait=S thread_fix=S paused=S missing=A,B
#     review=N fix=N bot=N full_validations=N pr_rounds=N escaped=B refixed=B
# (one line). A value it could not read prints `-`.
#   stamps    launched (the record's launched_at), first_commit, pr_opened,
#             gate_green (pr-timeline's gate_met), ci_green, armed (armed,
#             else queued), merged
#   missing   the stamps that are null
#   target    seconds, pull request open to merge: the class target from the
#             table below plus pr-timeline's ci_merge_group_secs, null as 0
#   merge_group  those merge-group CI seconds, `-` when null
#   actual    merged minus launched, lane launch to merge; the rollup reads it
#   open      pr-timeline's open_secs, pull request open to merge, null where
#             pr_opened or merged is missing
#   verdict   met, miss (open over target), unmeasured (open null), or
#             unclassified (the classifier gave no class)
#   phase     the longest gap between two consecutive stamps in time order
#             among the stamps at or after pr_opened and at or before merged
#             in time, the span the verdict judges, named by the stamp that
#             ends it; the earliest wins a tie.
#             The gap ending at merged loses the merge-group CI seconds,
#             floored at 0, before the longest gap is chosen.
#             A stamp outside that span enters no gap: a ci_green whose
#             checks finished before the PR opened, or one an optional check
#             completes after the merge.
#             Null while a stamp other than launched, first_commit and
#             armed is missing: a missing stamp has no time, and one that
#             could fall in the span joins two gaps. A null armed is a merge
#             never armed or queued, as on the admin route: pr-timeline reads
#             an arm by every merge method
#   gate waits  the gap that ends at gate_green, split into the waits it
#             holds, which sum to it:
#               paused      the lane was parked or walled: the lane record's
#                           `pauses`, and a `parked` still standing, which runs
#                           on past the gap; a record whose pauses do not read
#                           refuses as pauses-unreadable
#               bot_wait    the rest of the time after a push up to the next
#                           bot review: the bot reviewing the push
#               thread_fix  the rest of the time after a bot review up to the
#                           next push or the gate: the lane working the threads
#             the gap opens in the wait the latest push or bot review before
#             it opened, bot_wait where there is neither
#             pushes and bot reviews are pr-timeline's `push_times`, the
#             head branch's push log, and `bot_review_times`. Null while
#             the phase is, where gate_green falls outside the span, or
#             where pr-timeline's `push_times` is null:
#             no head branch named, or no push in its log for the life the
#             PR opened in
#   cause     the largest gate wait, the earlier of bot_wait, thread_fix and
#             paused winning a tie, where the phase is gate_green. Where the
#             phase is ci_green, the larger part of its gap split at
#             pr-timeline's last_push: work, the rounds pushed before the
#             final head, or ci, the final head's checks after its push;
#             work wins a tie, a push before the gap opened leaves it all
#             ci, and the cause is null where last_push is null or after
#             ci_green. Null on any other phase, except on a miss, which is
#             never recorded without a cause: on a miss the phase is the
#             cause wherever no split above applies, and the cause is
#             `unread` where the phase is null
#   escaped   a micro tier whose merged class is small or standard, or a small
#             tier whose merged class is standard
#   tier_inputs  the launch record's {estimate, delta, paths}, null on old records
#   class_reason  the classifier's class: cause= value, separate from class_cause,
#             which names an unread class
#   escape_cause  estimate-miss for production-size evidence, path-miss for path
#             or several-subsystems evidence; null without that evidence or no escape
#             The cycle line and fleet log retain all three fields; rollup counts
#             estimate_miss and path_miss.
#   refixed   a push landed after the first gate pass (pr-timeline's
#             first_gate_met: the first approval on any head, one a later
#             push dismissed included, else the first review-gate status
#             pass); null where no gate pass or no push was read
#   pr_rounds the count of review rounds in the record's `pr_rounds` list,
#             which is pr-timeline's `rounds`: each review round and fix round
#             GitHub saw, with its start, end and seconds. review, fix, bot
#             and full_validations count the lane's local rounds, read from
#             its workflow state, which GitHub never sees. A negative interval
#             measures nothing: a round whose seconds read negative, which
#             pr-timeline gives where a head's first check suite postdates its
#             review, records null seconds and prints
#             `oversee-cycle: negative-interval item=ITEM kind=K head=H secs=S`
#             on stderr
# When this record makes the third miss on one phase among the fleet's
# records, it also prints and logs
#   repeat-miss phase=P items=A,B,C causes=W,W,W
# which is the bar for filing a CI or process issue in that repository;
# causes names each item's cause in the order of items, read by the miss
# rule under cause above for a record that carries none. A ci_green miss
# counts toward the bar only where its cause is ci. A record that was
# already a counting miss on that phase does not make it again.
#
# rollup prints, and appends to the fleet log, one row per class with any
# recorded lane, in the order of the target table, then unclassified; with no
# fleet state yet it prints nothing and exits 0:
#   rollup class=C items=N median=S p90=S misses=N review=N fix=N bot=N
#     full_validations=N rounds_unread=N escaped=N refixed=N pr_rounds=N
#     pr_rounds_unread=N round_median=S fix_median=S rounds_untimed=N
# median and p90 are nearest-rank over the measured launch-to-merge seconds;
# the round figures are sums over the records that carry rounds, and
# rounds_unread counts the records that do not. pr_rounds is the nearest-rank
# median of the review rounds per record over the records that carry
# pr_rounds, and pr_rounds_unread counts the records that do not;
# round_median and fix_median are the nearest-rank medians of the seconds of
# every review round and every fix round those records hold, and
# rounds_untimed counts their rounds with no seconds. A person compares
# pr_rounds and round_median to the review-stage targets `--help` prints; the
# rollup gives no verdict on them, and the owner names no fix-round target.
# A negative interval enters no median or p90, in a record written before
# the record refused it too; such a round counts as untimed.
#
# Every refusal's first stderr line is `oversee-cycle: KEY=VALUE`.
# Exit status: 0 done; 1 a refusal (state-missing, state-unreadable,
# record-missing, pauses-unreadable, timeline-failed, not-merged,
# commit-unreadable, state-write-failed, fleet-log-failed); 2 usage.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_STATE="$SCRIPT_DIR/workflow-state"
GITHUB="$SCRIPT_DIR/../../github/scripts/github.sh"
LANE_HOST="$SCRIPT_DIR/lane-host"
# shellcheck source=lib/change-class.sh
source "$SCRIPT_DIR/lib/change-class.sh"
# shellcheck source=lib/lane-gitfile.sh
source "$SCRIPT_DIR/lib/lane-gitfile.sh"
# shellcheck source=lib/lane-capabilities.sh
source "$SCRIPT_DIR/lib/lane-capabilities.sh"
# shellcheck source=../../github/scripts/lib/gh-repo.sh
source "$SCRIPT_DIR/../../github/scripts/lib/gh-repo.sh"

TARGETS='{"render":300,"trivial":300,"micro":1200,"small":1800,"standard":5400}'
# The owner's review-stage targets: review rounds per pull request by class,
# and seconds per review round.
ROUND_TARGETS='{"micro":1,"small":1,"standard":2}'
ROUND_SECS_TARGET=600
# The rules every program below reads a record through: a negative interval
# is no measure, and a miss's cause falls back to its phase, then `unread`.
CYCLE_DEFS='def interval: if type == "number" and . < 0 then null else . end;
  def miss_cause: .cause // .phase // "unread";'

usage() {
  awk 'NR > 1 && /^set -euo/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"
  jq -r '"Targets, open-to-merge seconds: " + (to_entries | map("\(.key) \(.value)") | join(", "))' <<<"$TARGETS"
  jq -r --arg secs "$ROUND_SECS_TARGET" \
    '"Review rounds per pull request: " + (to_entries | map("\(.key) \(.value)") | join(", "))
     + "; seconds per round: " + $secs' <<<"$ROUND_TARGETS"
}

refuse() { # KEY VALUE [DETAIL_FILE]
  printf 'oversee-cycle: %s=%s\n' "$1" "$2" >&2
  [[ -z "${3:-}" || ! -s "$3" ]] || cat -- "$3" >&2
  exit 1
}
usage_error() { printf 'oversee-cycle: usage=%s\n' "$1" >&2; exit 2; }

WS_ARGS=()
if [[ "${1:-}" == --state-dir ]]; then
  [[ -n "${2:-}" ]] || usage_error --state-dir
  WS_ARGS=(--state-dir "$2"); shift 2
fi
VERB="${1:-}"
[[ $# -eq 0 ]] || shift
case "$VERB" in
  --help | -h) usage; exit 0 ;;
  record | rollup) ;;
  *) usage_error "${VERB:-verb}" ;;
esac

WORK="$(mktemp -d)" || refuse mktemp failed
trap 'rm -rf -- "$WORK"' EXIT

STATE_FILE="$("$WORKFLOW_STATE" ${WS_ARGS[@]+"${WS_ARGS[@]}"} path oversee)" || refuse state-missing path
# A fleet with no state yet, a session stopping before its first launch, has
# nothing to roll up; a record for a lane it never launched refuses.
if [[ ! -f "$STATE_FILE" ]]; then
  [[ "$VERB" != rollup ]] || exit 0
  refuse state-missing "$STATE_FILE"
fi

log_row() { # ITEM TEXT
  jq -n --arg item "$1" --arg text "$2" '{kind: "cycle", item: $item, text: $text}' >"$WORK/row.json"
  "$WORKFLOW_STATE" ${WS_ARGS[@]+"${WS_ARGS[@]}"} append-file oversee fleet_log "$WORK/row.json" \
    >/dev/null 2>"$WORK/ws.err" || refuse fleet-log-failed "$1" "$WORK/ws.err"
}

if [[ "$VERB" == rollup ]]; then
  [[ $# -eq 0 ]] || usage_error "$1"
  lines="$(jq -r --argjson targets "$TARGETS" "$CYCLE_DEFS"'
    def nr($p): sort as $a | ($a | length) as $n
      | if $n == 0 then "-" else $a[(($n * $p) | ceil) - 1] end;
    def n: if . == null then "-" else tostring end;
    [.lanes[]? | .cycle // empty] as $cycles
    | (($targets | keys_unsorted) + ["unclassified"])[] as $class
    | [$cycles[] | select((.class // "unclassified") == $class)] as $c
    | select($c | length > 0)
    | [$c[] | .rounds // empty] as $r
    | def sum(f): [$r[] | f] | add;
      "rollup class=\($class) items=\($c | length)"
      + " median=\([$c[] | .actual | interval // empty] | nr(0.5))"
      + " p90=\([$c[] | .actual | interval // empty] | nr(0.9))"
      + " misses=\([$c[] | select(.verdict == "miss")] | length)"
      + " review=\(sum(.review) | n) fix=\(sum(.fix) | n) bot=\(sum(.bot) | n)"
      + " full_validations=\(sum(.full_validations) | n)"
      + " rounds_unread=\([$c[] | select(.rounds == null)] | length)"
      + " escaped=\([$c[] | select(.escaped == true)] | length)"
      + " estimate_miss=\([$c[] | select(.escape_cause == "estimate-miss")] | length)"
      + " path_miss=\([$c[] | select(.escape_cause == "path-miss")] | length)"
      + " refixed=\([$c[] | select(.refixed == true)] | length)"
      + " pr_rounds=\([$c[] | .pr_rounds // empty | [.[] | select(.kind == "review")] | length] | nr(0.5))"
      + " pr_rounds_unread=\([$c[] | select(.pr_rounds == null)] | length)"
      + " round_median=\([$c[] | .pr_rounds // empty | .[] | select(.kind == "review") | .secs | interval // empty] | nr(0.5))"
      + " fix_median=\([$c[] | .pr_rounds // empty | .[] | select(.kind == "fix") | .secs | interval // empty] | nr(0.5))"
      + " rounds_untimed=\([$c[] | .pr_rounds // empty | .[] | select((.secs | interval) == null)] | length)"
  ' "$STATE_FILE")" || refuse state-unreadable "$STATE_FILE"
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    class="${line#rollup class=}"
    log_row "${class%% *}" "$line"
    printf '%s\n' "$line"
  done <<<"$lines"
  exit 0
fi

PR="" COMMIT="" TIER="" REPO="" ITEM=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --pr | --commit | --tier | --repo)
      [[ -n "${2:-}" ]] || usage_error "$1"
      case "$1" in
        --pr) PR="$2" ;; --commit) COMMIT="$2" ;; --tier) TIER="$2" ;; --repo) REPO="$2" ;;
      esac
      shift 2 ;;
    -*) usage_error "$1" ;;
    *) [[ -z "$ITEM" ]] || usage_error "$1"; ITEM="$1"; shift ;;
  esac
done
# The overseer's record call selects one delivery form, never both or none.
if [[ -z "$PR" && -z "$COMMIT" ]] || [[ -n "$PR" && -n "$COMMIT" ]]; then
  usage_error '--pr,--commit'
fi
[[ -n "$ITEM" ]] || usage_error item
[[ -z "$PR" || "$PR" =~ ^[1-9][0-9]*$ ]] || usage_error --pr
case "$TIER" in '' | micro | small | standard) ;; *) usage_error --tier ;; esac

if ! lane="$(jq -c --arg item "$ITEM" '[.lanes[]? | select(.item == $item)] | first // empty' "$STATE_FILE")"; then
  refuse state-unreadable "$STATE_FILE"
fi
[[ -n "$lane" ]] || refuse record-missing "$ITEM"
launch_tier="$(jq -r 'if has("tier") then .tier // "none" else "missing" end' <<<"$lane")" \
  || refuse state-unreadable "$STATE_FILE"
case "$launch_tier" in
  none) ;;
  missing)
    printf 'oversee-cycle: launch-tier-missing item=%s\n' "$ITEM" >&2
    [[ -n "$TIER" ]] || usage_error --tier ;;
  *)
    if [[ -n "$TIER" && "$TIER" != "$launch_tier" ]]; then
      printf 'oversee-cycle: tier-mismatch item=%s launch=%s given=%s\n' "$ITEM" "$launch_tier" "$TIER" >&2
      exit 1
    fi
    TIER="$launch_tier" ;;
esac
case "$TIER" in '' | micro | small | standard) ;; *) usage_error --tier ;; esac
[[ -n "$REPO" ]] || REPO="$(jq -r '.repo // empty' <<<"$lane")"
LANE_HOST_SPEC="$(jq -r '.host // empty' <<<"$lane")"
LANE_ROOT="$(jq -r '.mail_root // empty' <<<"$lane")"

rounds=null rounds_unread="" files=""
if ! lane_capabilities_read "$LANE_HOST" "${LANE_HOST_SPEC:-local}" 2>"$WORK/state.err"; then
  rounds_unread="$WORK/state.err"
elif lane_capability files files && [[ "$files" == none ]]; then
  :
elif ! lane_item_state "$WORKFLOW_STATE" "$LANE_HOST" "${ORCH_STATE_DIR:-tmp}" "$ITEM" \
  "$LANE_HOST_SPEC" "$LANE_ROOT" "$WORK"; then
  rounds_unread="$WORK/state.err"
elif [[ -n "$LANE_ITEM_STATE" ]]; then
  rounds="$(jq -c '{review: ((if .first_panel then 1 else 0 end) + (.rereview_cycles // 0)),
     fix: (.cycles // 0),
     bot: (.pr_comment_review.iterations // 0),
     full_validations: ([.validate_rounds[]? | select(.mode == "full")] | length)}' \
    <<<"$LANE_ITEM_STATE" 2>"$WORK/state.err")" || { rounds=null; rounds_unread="$WORK/state.err"; }
fi

if [[ -n "$PR" ]]; then
  timeline="$("$GITHUB" pr-timeline "$PR" ${REPO:+--repo "$REPO"} 2>"$WORK/timeline.err")" \
    || refuse timeline-failed "$PR" "$WORK/timeline.err"
  merge="$(jq -r '.merge_commit // empty' <<<"$timeline")" || refuse timeline-failed "$PR"
  [[ -n "$merge" ]] || refuse not-merged "$PR"
else
  merge="$COMMIT"
fi

# other_repo CHECKOUT — true where CHECKOUT is provably not a checkout of the
# lane's repository: a local lane's worktree names another origin, or the
# repository the timeline was read from is not the one CHECKOUT resolves to.
# Where neither can be read nothing is proved, and the class read goes on.
lower() { awk '{ print tolower($0) }'; }
other_repo() {
  local mine theirs
  if [[ -z "$LANE_HOST_SPEC" && -n "$LANE_ROOT" && -d "$LANE_ROOT" ]]; then
    mine="$(git -C "$1" config --get remote.origin.url)" || return 1
    theirs="$(git -C "$LANE_ROOT" config --get remote.origin.url)" || return 1
    [[ "$mine" != "$theirs" ]]
    return
  fi
  [[ -n "$REPO" ]] || return 1
  mine="$(unset GH_REPO; kendex_github_resolve_gh_repo "$1" 2>/dev/null)" || return 1
  [[ "$(lower <<<"$mine")" != "$(lower <<<"$REPO")" ]]
}

# The class is the classifier's and nothing else's: an unread class records
# null with its cause, and the verdict says unclassified rather than judging
# the lane against a target it was never measured into. It is read from this
# checkout, which must be one of the lane's repository: another repository's
# merge commit is never fetched from this one's origin.
class="" class_cause="" class_reason="" class_evidence=""
checkout="$(git rev-parse --show-toplevel 2>/dev/null)" || checkout=""
if [[ -z "$checkout" ]]; then
  class_cause="checkout-absent"
elif other_repo "$checkout"; then
  class_cause="checkout-other-repo"
elif ! base="$(git -C "$checkout" rev-parse --verify -q "$merge^1^{commit}")" \
  && ! { git -C "$checkout" fetch -q origin "$merge" 2>"$WORK/class.err" \
         && base="$(git -C "$checkout" rev-parse --verify -q "$merge^1^{commit}")"; }; then
  class_cause="merge-commit-absent"
elif change_class_read "$base" "$merge" "$checkout" "$WORK/class.err"; then
  class_evidence="$(sed -n 's/^class: class=[^ ]* measured=[^ ]* cause=//p' "$WORK/class.err" | tail -1)" \
    || refuse class-log-unreadable "$ITEM"
  class_reason="${class_evidence%% *}"
  if [[ "$CHANGE_CLASS_MEASURED" != true ]]; then
    class_cause="class-unmeasured"
  elif jq -e --arg c "$CHANGE_CLASS" 'has($c)' >/dev/null <<<"$TARGETS"; then
    class="$CHANGE_CLASS"
  else
    class_cause="class-unknown-$CHANGE_CLASS"
  fi
else
  class_cause="$CHANGE_CLASS_CAUSE"
fi

if [[ -n "$COMMIT" ]]; then
  COMMIT="$(git rev-parse --verify --end-of-options "$merge^{commit}" 2>"$WORK/commit.err")" \
    || refuse commit-unreadable "$merge" "$WORK/commit.err"
  dates="$(git show -s --format='%at %ct' "$COMMIT" -- 2>"$WORK/commit.err")" \
    || refuse commit-unreadable "$COMMIT" "$WORK/commit.err"
  timeline="$(jq -cn --arg commit "$COMMIT" --arg dates "$dates" '
    ($dates | split(" ") | map(tonumber | todate)) as $d
    | {commit: $commit, stamps: {first_commit: $d[0], merged: $d[1]}}')" \
    || refuse commit-unreadable "$COMMIT"
fi

# The lane's pauses in epoch seconds: each one the record keeps, and a park
# still standing, which no relaunch has closed.
pauses="$(jq -c '[(.pauses // [])[] | {from: (.from | fromdate), to: (if .to == null then null else .to | fromdate end)}]
  + (if .parked.at == null then [] else [{from: (.parked.at | fromdate), to: null}] end)' <<<"$lane" 2>"$WORK/pauses.err")" \
  || refuse pauses-unreadable "$ITEM" "$WORK/pauses.err"

negatives="$(jq -r --arg item "$ITEM" "$CYCLE_DEFS"'.rounds // [] | .[] | select(.secs != (.secs | interval))
  | "oversee-cycle: negative-interval item=\($item) kind=\(.kind) head=\(.head) secs=\(.secs)"' <<<"$timeline")" \
  || refuse timeline-failed "${PR:-$COMMIT}"

cycle="$(jq -c -n --argjson lane "$lane" --argjson t "$timeline" --argjson rounds "$rounds" --argjson pauses "$pauses" \
  --argjson targets "$TARGETS" --arg class "$class" --arg cause "$class_cause" --arg tier "$TIER" \
  --arg class_reason "$class_reason" --arg evidence "$class_evidence" "$CYCLE_DEFS"'
  # The gate waits of the gap FROM..TO, epoch seconds: an instant a pause
  # covers is paused, any other is the wait the latest push or bot review at
  # or before it opened, bot_wait where neither came yet. A push and a bot
  # review in one second read the push first.
  def gate_waits($from; $to):
    ($pauses | map({a: ([.from, $from] | max), b: ([.to // $to, $to] | min)})
     | map(select(.b > .a)) | sort_by(.a)
     | reduce .[] as $p ([]; if length > 0 and $p.a <= .[-1].b
         then .[-1].b = ([.[-1].b, $p.b] | max) else . + [$p] end)) as $union
    | def paused($a; $b): [$union[] | ([.b, $b] | min) - ([.a, $a] | max) | select(. > 0)] | add // 0;
    ([$t.push_times[] | {at: fromdate, wait: "bot_wait"}] + [$t.bot_review_times[] | {at: fromdate, wait: "thread_fix"}]
     | sort_by(.at, .wait)) as $events
    | ([{at: $from, wait: ([$events[] | select(.at <= $from)] | last | .wait // "bot_wait")}]
       + [$events[] | select(.at > $from and .at < $to)] + [{at: $to}])
    | [range(1; length) as $i | {wait: .[$i - 1].wait, secs: ((.[$i].at - .[$i - 1].at) - paused(.[$i - 1].at; .[$i].at))}]
    | {bot_wait: ([.[] | select(.wait == "bot_wait") | .secs] | add // 0),
       thread_fix: ([.[] | select(.wait == "thread_fix") | .secs] | add // 0),
       paused: paused($from; $to)};
  $t.stamps as $s
  | {launched: $lane.launched_at, first_commit: $s.first_commit, pr_opened: $s.created,
     gate_green: $s.gate_met, ci_green: $s.ci_green, armed: ($s.armed // $s.queued),
     merged: $s.merged} as $stamps
  | (if $class == "" then null else $class end) as $class
  | (if $tier == "" then null else $tier end) as $tier
  | $t.ci_merge_group_secs as $merge_group
  | (if $class == null then null else $targets[$class] + ($merge_group // 0) end) as $target
  | (if $stamps.launched == null or $stamps.merged == null then null
     else ($stamps.merged | fromdate) - ($stamps.launched | fromdate) end) as $actual
  | $t.open_secs as $open
  | [$stamps | to_entries[] | select(.value == null) | .key] as $missing
  | (if $missing - ["launched", "first_commit", "armed"] != [] then null else ($stamps.pr_opened | fromdate) as $o
     | ($stamps.merged | fromdate) as $m
     | [$stamps | to_entries[] | select(.value != null) | {name: .key, at: (.value | fromdate)} | select(.at >= $o and .at <= $m)]
     | sort_by(.at) end) as $seq
  | (if $seq == null then {phase: null, secs: null} else
       [range(1; $seq | length) as $i | {phase: $seq[$i].name, secs: ($seq[$i].at - $seq[$i - 1].at)}
        | if .phase == "merged" then .secs = ([.secs - ($merge_group // 0), 0] | max) else . end]
       | sort_by(- .secs) | first end) as $dominant
  | ($seq // [] | map(.name) | index("gate_green")) as $gate
  | (if ($gate // 0) == 0 or $t.push_times == null then null
     else gate_waits($seq[$gate - 1].at; $seq[$gate].at) end) as $waits
  | ($seq // [] | map(.name) | index("ci_green")) as $ci
  | (if ($ci // 0) == 0 or $s.last_push == null then null
     else $seq[$ci - 1].at as $from | $seq[$ci].at as $to | ($s.last_push | fromdate) as $push
     | if $push > $to then null elif $push - $from >= $to - $push then "work" else "ci" end end) as $ci_cause
  | (if $t.commit == null then {pr: $t.pr} else {commit: $t.commit} end)
    + {class: $class, class_cause: (if $cause == "" then null else $cause end),
     class_reason: (if $class_reason == "" then null else $class_reason end),
     tier_inputs: $lane.tier_inputs, tier: $tier, stamps: $stamps, target: $target, merge_group: $merge_group, actual: $actual, open: $open,
     verdict: (if $class == null then "unclassified" elif $open == null then "unmeasured"
               elif $open > $target then "miss" else "met" end),
     phase: $dominant.phase, phase_secs: $dominant.secs, gate_waits: $waits,
     cause: (if $dominant.phase == "gate_green" and $waits != null
               then $waits | to_entries | sort_by(- .value) | first.key
             elif $dominant.phase == "ci_green" then $ci_cause
             else null end),
     missing: $missing, rounds: $rounds,
     pr_rounds: ($t.rounds | if . == null then null else map(.secs |= interval) end),
     escaped: (if $class == null or $tier == null then null
               else ($tier == "micro" and ($class | IN("small", "standard")))
                 or ($tier == "small" and $class == "standard") end),
     refixed: (if $s.first_gate_met == null or $s.last_push == null then null
               else $s.last_push > $s.first_gate_met end)}
  | .escape_cause = (if .escaped != true then null
      elif $class_reason == "several-subsystems" or ($evidence | test("(^| )path=")) then "path-miss"
      elif ($class_reason | startswith("production-")) then "estimate-miss"
      else null end)
  | if .verdict == "miss" then .cause = miss_cause else . end')" \
  || refuse timeline-failed "${PR:-$COMMIT}"

"$WORKFLOW_STATE" ${WS_ARGS[@]+"${WS_ARGS[@]}"} update oversee --arg item "$ITEM" --argjson cycle "$cycle" \
  '(.lanes[] | select(.item == $item)).cycle = $cycle' >/dev/null 2>"$WORK/ws.err" \
  || refuse state-write-failed "$ITEM" "$WORK/ws.err"

line="$(jq -r --arg item "$ITEM" 'def n: if . == null then "-" else tostring end;
  "cycle item=\($item) " + (if .commit == null then "pr=\(.pr)" else "commit=\(.commit)" end)
  + " class=\(.class | n) tier=\(.tier | n) target=\(.target | n)"
  + " merge_group=\(.merge_group | n)"
  + " actual=\(.actual | n) open=\(.open | n) verdict=\(.verdict) phase=\(.phase | n) phase_secs=\(.phase_secs | n)"
  + " cause=\(.cause | n) bot_wait=\(.gate_waits.bot_wait | n) thread_fix=\(.gate_waits.thread_fix | n)"
  + " paused=\(.gate_waits.paused | n)"
  + " missing=\(if .missing == [] then "-" else .missing | join(",") end)"
  + " review=\(.rounds.review | n) fix=\(.rounds.fix | n) bot=\(.rounds.bot | n)"
  + " full_validations=\(.rounds.full_validations | n)"
  + " pr_rounds=\(if .pr_rounds == null then null else [.pr_rounds[] | select(.kind == "review")] | length end | n)"
  + " escaped=\(.escaped | n) tier_inputs=\(.tier_inputs | n)"
  + " class_reason=\(.class_reason | n) escape_cause=\(.escape_cause | n) refixed=\(.refixed | n)"' <<<"$cycle")"
log_row "$ITEM" "$line"
printf '%s\n' "$line"
[[ -z "$class_cause" ]] || printf 'oversee-cycle: class-unread cause=%s\n' "$class_cause" >&2
[[ ! -s "$WORK/class.err" || -z "$class_cause" ]] || cat -- "$WORK/class.err" >&2
if [[ -n "$rounds_unread" ]]; then
  printf 'oversee-cycle: rounds-unread item=%s\n' "$ITEM" >&2
  cat -- "$rounds_unread" >&2
fi
[[ -z "$negatives" ]] || printf '%s\n' "$negatives" >&2

# The bar fires on the record that makes the third miss: one that was
# already a counting miss on this phase, recorded again, makes nothing new.
# One conjunct per line: this record is a miss that counts, as the header
# states, on a named phase, that it was not already; the fleet's records that
# are misses that count, on that phase, are exactly three.
repeat="$(jq -r --argjson cycle "$cycle" --argjson prior "$(jq -c '.cycle // null' <<<"$lane")" "$CYCLE_DEFS"'
  def counts: .verdict == "miss" and (.phase != "ci_green" or .cause == "ci");
  if ($cycle | counts | not)
     or $cycle.phase == null
     or (($prior | counts) and $prior.phase == $cycle.phase)
  then empty else
    [.lanes[]? | select(.cycle | counts)
               | select(.cycle.phase == $cycle.phase)]
    | select(length == 3)
    | "repeat-miss phase=\($cycle.phase) items=\(map(.item) | join(","))"
      + " causes=\(map(.cycle | miss_cause) | join(","))" end' "$STATE_FILE")" \
  || refuse state-unreadable "$STATE_FILE"
if [[ -n "$repeat" ]]; then
  log_row "$ITEM" "$repeat"
  printf '%s\n' "$repeat"
fi
