#!/usr/bin/env bash
# oversee-succeed — replace an overseer past its context mark, or on an
# account near its wall, with a fresh overseer session in the same tmux window
# position.
#
# Usage:
#   oversee-succeed [--harness H] [--context TOKENS:WINDOW] [--handoff PATH] [--wait-secs N]
#                   [-- HARNESS_FLAGS...]
#   oversee-succeed --print-launch-line [--harness H] [--handoff PATH] [-- HARNESS_FLAGS...]
#   oversee-succeed --check-marks [--harness H] [--context TOKENS:WINDOW]
#   oversee-succeed --dead-pane PANE --line-file PATH [--wait-secs N]
#   oversee-succeed --walled-pane PANE [--harness H] [--handoff PATH] [--wait-secs N]
#                   [-- HARNESS_FLAGS...]
#
#   `oversee launch --predecessor` replaces a live overseer through the same
#   walk, flag assembly and launch steps (lib/overseer-launch.sh), and hands
#   the fleet watch on through the same step 6 (lib/watch-handover.sh), with
#   no mark judged, no caller entry and no flags carried over; this script is the
#   succession that judges the marks, carries the caller's own flags, and
#   recovers an overseer that died or walled.
#
#   Five modes over ONE launch path. The first is an overseer succeeding
#   ITSELF, described below. `--check-marks` stops after that judgement and
#   reports it, so `oversee-watch` can wake an overseer whose own marks it
#   reached without a second copy of the rule. The next two serve an overseer
#   that DIED, whose pane can no longer be asked anything: a dead pane runs no
#   harness and records no reading, so nothing there names the harness, the
#   model or the account the session ran on. `--print-launch-line` prints that command while the
#   overseer is still alive, for `oversee-watch` to record, and `--dead-pane`
#   sends the recorded line into the dead pane's own window slot. Neither of
#   those two judges a mark: the overseer's death is the trigger, not its
#   context or its account.
#
#   `--walled-pane` serves an overseer whose ACCOUNT is spent. That overseer is
#   not dead: its harness is still running, so its launch record answers for
#   its harness, account, model and directory where it names that pane, and
#   --harness, its foreground command and its context reading where it names
#   none, exactly as a live caller's do, and no
#   recorded line is needed to launch its successor. What it cannot do is take
#   a turn, so it never reaches the mark judgement that would hand it over.
#   This mode is therefore the succession with the WALL in place of the mark:
#   no mark is judged, the preference is walked as step 3 walks it, ending in
#   the caller entry, which keeps this session's own harness, model, effort
#   and permission flags, and `lanes pick` names the account, never the one
#   the walled pane is spending. `--dead-pane` cannot serve it, because that mode deliberately
#   picks no lane — the recorded line IS its choice, and for a walled overseer
#   that line names the account that just walled.
#
#   Every mode but `--dead-pane` reads the caller's LAUNCH RECORD first: the
#   fleet state's `overseer` object (../schemas/workflow-state.md § Oversee state
#   state), where it names the caller pane on this tmux server. The harness,
#   account, model and directory it names are taken ahead of the caller's
#   SessionStart row (lib/session-rows.sh), then --harness, the pane command
#   and the processes under it, the pane's context reading and the account
#   variables, which answer only for a session neither the record nor the row
#   names and for a fact both leave unknown; a Copilot session's account is
#   its record's, else the account of the Copilot process under its pane as
#   lib/lane-context.sh § lane_context_pane_shape reads it. `--check-marks`
#   reads the harness, account and model. A record naming a model gives the
#   caller's successor that model and effort as one pair, in place of the pair
#   the flags after -- spell; with no model, the flags keep theirs. The
#   context mark still rests on --context alone. The record's `pending`
#   member, the successor a succession wrote before its launch, is never read
#   as the caller's own.
#
#   Its CALLER confirms the wall before calling this. `oversee-watch` does so
#   with the account judgement of `--check-marks`, because the overseer's own
#   pane carries the limit banners it relays about other lanes; nothing here
#   re-reads the pane's account, which that judgement has already measured.
#
#   Run from the overseer's own tmux pane after the overseer handoff file is
#   rewritten (../workflows/oversee.md § 5). In order:
#     1. Read ORCH_OVERSEER_SUCCESSION, `on` (default) or `off`. `off` prints
#        `succession-off`, exits 0 and launches nothing; any other value
#        refuses `invalid-succession`. Under --check-marks `off` is reported on
#        the line instead and the judgement below still runs.
#     2. Judge the context mark and the account triggers. Any one fires the succession.
#        The ACCOUNT mark is this overseer's own account, judged by `lanes
#        pick --lane` at ORCH_OVERSEER_HEADROOM_PCT, which is also the floor
#        the successor's own account must clear; a Codex account room on its
#        credits clears it, by the rule `lanes --help` states under pick, and takes no rate trigger. One number for both jobs buys
#        a wider successor pool at the price of the warning this mark gives: at
#        the default it fires close to the wall, and the rate trigger beside it
#        restores the warning. The account is the one
#        this session is spending, and the buckets judged are the ones it
#        actually spends: the shared 5-hour and plan-wide weekly windows, plus
#        only those model-scoped weekly windows whose label the model this
#        session's recorded context reading names. A weekly window scoped to a
#        model this overseer will never launch walls nothing it does, so it
#        decides nothing here; lib/lane-model.sh holds that rule and the pick
#        applies it, and a session whose reading names no model, or whose
#        harness lib/lane-context.sh judges on the binding bucket, is judged
#        on the account binding bucket instead. An account nothing measured for this launch,
#        and a judge that could not answer at all, both report NO headroom,
#        which is its own
#        state and never a healthy one: the account mark does not fire, the
#        context, rate and qualifying marks still decide. An unmeasured
#        account is kept for the successor at the context mark alone, where
#        no account with room is found, and an unreadable judge keeps none
#        (step 3).
#        The QUALIFYING mark (ORCH_OVERSEER_SUCCESSOR_ACCOUNTS, 0 turns it
#        off) counts the accounts of this overseer's harness above
#        ORCH_OVERSEER_HEADROOM_PCT, by the `lanes pick` judgement a successor
#        pick takes, credit room included, this overseer's own among them
#        where the account mark found room on it. Counted whole, the figure reads the same
#        from every account it covers; a count without this account would read
#        one from either of two accounts, and the overseer would move back and
#        forth as their headroom readings crossed. The mark fires where the
#        count is at or below the setting, at least one other account is in
#        it, the account the pick names has more headroom than this one, and
#        the walk of step 3, run here and launching nothing, chooses an entry
#        whose successor settles the mark: counting from the lane picked, it
#        finds no other account with room, or a count above the
#        setting. Where the walk chooses none the mark does not fire, so a
#        setting no move can clear leaves this trigger inert; at the default
#        of 1 it fires only where the account mark found no room on this
#        overseer's own account and exactly one other account has room. Its
#        `mark-reached` line always carries `headroom`, this overseer's own
#        reading, which at the default shows why that account was not
#        counted. A qualifying judgement reads ORCH_OVERSEER_PREFERENCE and
#        can refuse at exit 1 as the walk does: `invalid-preference` or
#        `lanes-failed`.
#        The CONTEXT mark is judged only on the reading --context hands in,
#        the tokens used and effective capacity this session's hook read out
#        of its transcript, which that hook passes here and names in the
#        command its refusal prints. No stored reading is judged, so a session
#        is never judged on a figure another session left, and a run given no
#        --context, the watch's included, judges the account triggers alone.
#        The shared lane_context_handoff_due rule judges both independent
#        context triggers, using the same setting as the lane hook. Below both
#        it prints `context-below-mark`. An unmeasured context rule prints
#        `context-unmeasured`, with `reason=window-unnamed` for a reading whose
#        capacity is unknown below the token cap, and `reason=context-unread` for a
#        run handed no reading; under --check-marks a run handed none prints
#        `account-below-mark`, since its caller asked about the account
#        triggers alone. Each
#        carries the account headroom that did not fire either, `none` where
#        the account is unmeasured and `unreadable` where the judge could not
#        answer, exit 0 and launch nothing. Under --check-marks a mark that IS reached
#        prints `mark-reached` and a reading that could not be taken prints
#        `mark-unmeasured`, either of which ends the run there; a reached mark
#        otherwise falls through to step 3.
#     3. Walk ORCH_OVERSEER_PREFERENCE through lib/overseer-launch.sh's
#        parser. kendex.settings.toml.example § Fleet owns the entry grammar
#        and numeric model selection and eligibility. The walk uses
#        ol_walk and builds the chosen entry's flag words through its
#        ol_launch_flags, the walk and assembly `oversee launch` takes.
#        An entry naming no model in the current grammar refuses
#        `invalid-preference`. The walk tries the entries in
#        the setting's order and holds no model list or order of its own. A
#        pi session spends a claude account on the pi-claude provider and the
#        Copilot pool on a github-copilot model, which `lanes pick --harness
#        pi` judges from the lane host's harness=pi accounts row for the Pi
#        root, with ORCH_LANE_COPILOT_POOL as the override, and whose lane
#        variable is PI_CODING_AGENT_DIR
#        (lib/lane-launch.sh § lane_pick_harness). On any other provider it spends one no lane measures, so that entry takes
#        no pick and launches with no lane variable, and a qualifying mark
#        never chooses it. A pi caller's own model is the first of its
#        record's, the --model word after -- and its reading's that names a
#        provider (lib/overseer-launch.sh § ol_pi_model), and its successor
#        runs and records that one; where none names a provider it spends an
#        account nothing names, and its caller entry refuses
#        `pi-account-unknown`. No permission posture crosses to or from pi,
#        whose row names no permission word. Unset, the setting is
#        lib/overseer-launch.sh's OL_DEFAULT_PREFERENCE, the default README.md
#        § Setup states; set to empty, it names no entry. Every launch on a measured account but one goes
#        through `lanes pick
#        --harness --model --min-headroom-pct`, the headroom trigger itself,
#        so every successor's account clears it by step 2's rule, and among
#        the accounts with room it is `lanes pick`'s own order that puts one
#        carrying live lane claims behind an empty one. The
#        bound is judged on the bucket that walls the model that entry passes,
#        and the pick is held to the reading the SUCCESSOR will take of itself
#        at its own account mark, so it is never opened onto an account its
#        first judgement already reads as spent. lib/lane-context.sh names that
#        reading (lane_context_mark_model): a claude successor is judged on its
#        model, so the model wall IS that reading; a codex successor is judged
#        on the account's own binding bucket and the pick adds
#        `--binding-floor` to hold it there. An entry, the caller's own
#        included, whose claude successor would run on a model the claude
#        adapter names no window for refuses `model-window-unknown` and ends
#        the run rather than being skipped, a setting to fix and not a lane to
#        pass over, as does a pi
#        successor, `pi-handoff-unmarked`, whose settings leave compaction on
#        or cannot be read, or whose pi-hooks carrier sends no window, read
#        under the Pi root it runs on: the picked account's on the Copilot
#        pool. An entry with no qualifying lane IS skipped, and so is a
#        copilot entry whose picked account cannot load a context reader or fallback
#        status line, after its pick, with `successor-status-line` on
#        stderr.
#        A named entry's LAUNCH carries the model and effort words its own row
#        writes. A same-harness entry keeps the caller's permission words
#        exactly. A cross-harness entry transfers only a full-bypass posture
#        that both rows define, then writes the target row's spelling and
#        carries no other word of the caller's, each spelled for the caller's
#        CLI; under any other posture it is skipped before its pick, with
#        `entry-permission-untransferable` on stderr, and the walk goes on.
#        A qualifying judgement, handed no permission words, skips an entry
#        whose rows define no such posture, so it never chooses one a
#        succession would skip.
#        The walk ALWAYS ends in one further entry, the caller's own
#        harness and lane ($CLAUDE_CONFIG_DIR or $CODEX_HOME) with no model or
#        effort flag of its own: the overseer passes its model and effort
#        flags after -- to keep them, or that lane's configured defaults
#        apply. Its pick is judged on the model this pane already runs, since
#        those flags are what the successor will carry. That entry is the one
#        exception above, the launch the pick
#        does not name, and the caller's own lane is kept unpicked only where
#        the account mark found room on it; where that found none, and where
#        nothing measured it, the fleet-wide pick over the caller's harness
#        names the lane instead. At the context mark an account nothing
#        measured is still kept where that pick, or the pick of a named entry
#        of the caller's harness on that account's harness, finds no account
#        with room: the successor spends the account the caller already
#        spends, so the refusal would protect none. The named entry launches
#        its own model and effort on it. The run prints
#        `successor-account-unmeasured lane=<dir> status=<status>
#        detail=<detail>` on stdout, the status and detail of the caller's
#        account record, and writes it as one fleet-log row. An unreadable
#        judge keeps nothing, so its entries take their picks alone. A preference states a FIRST choice and never
#        gives up this last one: without it a single entry whose one harness
#        was spent refused with every account of the caller's harness
#        unexamined. A walk where that entry is skipped too refuses
#        `no-lane-qualifies` at exit 3, which then means no account of any
#        harness walked has room. That refusal reports what it covered —
#        `entries`, the preference entries stated, `fallback`, the harness
#        that last entry swept or `none` where the walk never reached it, and
#        `walled` and `unmeasured`, the accounts each sweep found —
#        and carries `mark=headroom` with this
#        overseer's own account and reset where the account mark fired, and
#        `mark=context` alone otherwise, where this overseer's own account
#        either has room or was never measured and there is no account to
#        name. Under --walled-pane it carries `mark=wall` and no account: this
#        run judges no mark, so it measured no account to name. The CALLER
#        names it, from the account judgement that confirmed the wall, whose
#        own fields say which account ran out and when its binding bucket
#        frees up.
#     4. Open the successor's session through the overseer-host adapter
#        (`overseer-host`, schemas/overseer-host.md). The runtime is held to
#        tmux, because this script reads the successor's account off its
#        pane: ORCH_OVERSEER_HOST naming another refuses `runtime-unsupported`
#        before anything is printed, recorded or opened. On tmux the session
#        is a window named `overseer` at the session's base index, the harness
#        launched there with a brief naming the handoff file, once the
#        checkout it starts in is fast-forwarded to its base branch's origin
#        head through `sync-base` (lib/overseer-launch.sh § ol_checkout_sync)
#        inside ORCH_OVERSEER_SYNC_TIMEOUT_S seconds, in every mode that
#        launches. A checkout that is dirty, diverged, off its base branch,
#        not synced inside that bound or otherwise refused is the notice
#        `checkout-unsynced cause=<key> path=<checkout> fix=<what clears it>`
#        on stderr and, its path left out, in the fleet log, and the successor
#        opens on the tree as it stands. The caller, or the dead or walled
#        predecessor, still runs in that checkout: a succession abandoned
#        after the sync leaves it on the fast-forwarded tree, and this script
#        calls the moved helpers for the rest of its run. The steps from
#        here to the close are
#        lib/overseer-launch.sh's, the one launcher `oversee launch` runs a
#        first launch or a --predecessor succession through, the succession
#        itself its ol_succession. The command is built by lib/lane-launch.sh,
#        the builder open-terminal uses, so a machine whose harness command is
#        an account shim is launched through that shim rather than under an
#        environment prefix it overwrites. Before the successor's first turn
#        the session record is written into the fleet state's `overseer`
#        object: runtime, server, session, account and a generation one past
#        the record it replaces, which is how the hooks and the watch tell
#        the successor from this session; a launch abandoned once its
#        window opened puts the caller's record back. Then read the session's account back, wait
#        for the adapter's `inspect` to show a running turn, and read the
#        account again now that the harness is certainly the thing
#        answering — all inside the one --wait-secs bound. A session observed
#        running an account other than the one picked refuses
#        `successor-wrong-lane`: the first read catches one that already
#        disagrees, before the successor has had a turn to open a window or
#        write to the tracker with it, and the second catches a wrapper that
#        handed the account over as the harness started. A session stopped at
#        a folder-trust dialog refuses `successor-dialog` with the pane line
#        instead of waiting out the deadline. A successor is given that
#        trust BEFORE it starts, through the same builder: the caller's
#        directory is made trusted in the config the launch reads, for codex
#        under a CODEX_HOME of the launch's own where the account's config
#        cannot carry it, for claude in the picked config dir's own
#        .claude.json, and a launch whose entry could not be made refuses
#        `launch-trust-missing` rather than opening on the question.
#     5. Stop the caller's session through the adapter with the successor
#        named: on tmux the successor is swapped into the caller's window slot
#        and the caller's window closed, so the successor holds the caller's
#        index and no other window moves; with renumber-windows on, tmux
#        renumbers as for any closed window.
#     6. Ensure the fleet repeat watch runs through the orch job runner,
#        serving the successor pane, before step 5 can end this command.
#        With no watch claim, start one and wait for its claim. With a live
#        claim, start the handover helper, which waits for the caller to
#        close and restarts the recorded watch from the new pane. The shared
#        owner is lib/watch-handover.sh. A refused start or helper launch
#        refuses the succession with the runner's job-unit line. A later
#        helper failure goes to oversee-watch.err beside the fleet state.
#        This applies to live succession, --dead-pane and --walled-pane.
#        Death replay takes its watch identity from the recorded launch.
#        references/watch-delivery.md gives the session's log reader.
#   A failure at any step, or a TERM, INT or HUP from the launch until the
#   close, leaves the caller's window running and closes a successor window
#   already opened. All three are ignored during the close: it is the commit
#   point, and it ends this script's own window.
#   Run it under a shell-tool timeout longer than --wait-secs.
#
# Options:
#   --handoff PATH   The handoff file the brief names (default
#                    tmp/handoffs/OVERSEER-HANDOFF.md); letters, digits and
#                    ./_- only, so the brief survives the pane's shell
#                    Live self-succession checks its Start here generation
#                    per ../references/communication-modes.md § Handoff.
#                    Check and print modes read no handoff.
#   --wait-secs N    Seconds the successor has to come up: ONE bound over
#                    reading its account, waiting for its running turn, and
#                    confirming the account once that turn shows, not one each.
#                    A run may overrun it by one second, the least the
#                    confirming read can settle in. At 1 that floor is the whole
#                    budget and the running-turn wait gets a single probe; at 2
#                    and 3 each wait gets one second (default 60)
#   -- FLAGS...      Passed to the harness word by word, each quoted. A caller
#                    or print entry carries every word unchanged but
#                    the question-tool words, which every entry carries
#                    exactly when ORCH_QUESTION_TOOL is off, its default. A
#                    named same-harness entry replaces model and effort but
#                    keeps permission words exact. A named cross-harness entry
#                    accepts one transferable full-bypass posture, and no other
#                    permission word, writes the target harness's spelling and
#                    carries no other caller word;
#                    under any other posture the walk skips it. Print mode records this
#                    session rather than a later preference.
#                    Refused beside --dead-pane, whose line already holds them
#   --harness H      The harness this overseer runs, claude, codex, copilot or
#                    pi, where its pane cannot say: a Codex pane reports node
#                    and a pi pane pi, which name no one harness, and a
#                    Copilot CLI pane is named from a Copilot process at most
#                    two levels under it (lib/lane-context.sh §
#                    lane_context_pane_shape), so --harness answers for one
#                    with no such process; the turn-end reading that would
#                    name any of them does not exist before the first turn
#                    end. A node or copilot pane whose process table cannot be
#                    read refuses as pane-unreadable before --harness is read.
#                    It answers after the launch record and the session's
#                    SessionStart row and ahead of the pane and the reading;
#                    any other value is refused as
#                    invalid-harness, and --dead-pane, whose recorded line
#                    names its harness, refuses it
#   --context TOKENS:WINDOW
#                    This session's context reading, as its turn-end hook took
#                    it: the tokens the last response left in the context and
#                    the window its model has, empty where no adapter named
#                    one. Taken by the two modes that judge a mark and refused
#                    beside the others
#   --check-marks    Judge supplied context before pane or harness discovery.
#                    A due reading returns its keyed result; otherwise judge
#                    this overseer's account triggers. No window is opened and
#                    nothing is launched. Lanes are picked only to judge
#                    whether a qualifying mark has a successor that settles
#                    it, and that judgement can refuse at exit 1 as the walk
#                    does (step 2). `mark-reached` carries
#                    `kind` (context, headroom, rate or qualifying), the `value` it read, the
#                    `mark` it crossed and `succession`, the effective
#                    ORCH_OVERSEER_SUCCESSION. A reading that could not be
#                    taken at all is `mark-unmeasured kind=<context|headroom|rate|qualifying>
#                    reason=<...>`,
#                    which is not a mark that lifted: a caller holding a
#                    standing mark keeps it. Below every mark, with each read,
#                    the `context-below-mark` line above is printed instead,
#                    and `account-below-mark` where no --context was handed in
#                    and so no context mark was judged.
#                    Because it launches nothing, `off` does not gate it: an
#                    overseer past its mark is told so whether or not a
#                    successor may open. Exit 0 with the line on stdout, but
#                    for those refusals. Takes
#                    no other option but --context, --handoff and --wait-secs
#                    included
#   --print-launch-line
#                    Print the command a successor of THIS overseer would be
#                    launched with — the caller's own harness, its own lane,
#                    the flags after --, and the brief naming --handoff, each
#                    as its launch record answers where one names this pane,
#                    so a session whose pane names no harness is still
#                    printed — and launch nothing. ORCH_OVERSEER_PREFERENCE is not walked and
#                    no account's headroom is read: the line records what this
#                    session runs, and the preference chooses where a LATER
#                    successor goes. A codex line still carries the folder-trust
#                    preparation of step 4, because the pane that replays it is
#                    as unattended as the one a live succession opens, and the
#                    home that trust was made in is part of the line. It also
#                    carries the launch-only settings from lib/lane-launch.sh
#                    once, ahead of the flags after --: no Codex update prompt,
#                    no shared background server warning, and enabled hooks run
#                    without a persisted trust entry.
#                    Exit 0 with the line on stdout
#   --dead-pane PANE The tmux pane of an overseer that has already died, in
#                    place of the caller's own: no mark is judged, no lane is
#                    picked, and --line-file supplies the whole command. Its
#                    window is where the successor lands, exactly as the
#                    caller's window is in the first mode
#   --line-file PATH The recorded launch line, read whole, one trailing newline
#                    dropped. Required with --dead-pane and refused without it
#   --walled-pane PANE
#                    The tmux pane of an overseer whose account is spent, in
#                    place of the caller's own. No mark is judged and no
#                    recorded line is read: its launch record answers for its
#                    harness, account, model and directory where it names the
#                    pane, as for a live caller, and --harness and the pane
#                    where it names none, and step 3 picks the lane
#                    as it does for a live succession, with the account the
#                    walled pane is spending left out of every pick and a pick
#                    that names it anyway refused. Its
#                    window is where the successor lands. The command built is
#                    printed bare on stdout before the window opens, so the
#                    caller's own output records the line it sent, and it is
#                    recorded in the fleet state as a live succession's is
#
# Output: every line is `oversee-succeed: <key> <field>=<value>` first, with the
# explanation and any failing dependency's own stderr under it.
#
# Every REFUSAL is on stderr and ends the run at exit 1, with ONE exception:
# `no-lane-qualifies` ends it at exit 3, which is the status `lanes pick`
# itself answers "no lane clears the bound" with. One number, one meaning:
# every other refusal is this run failing, and 3 is the fleet having no room,
# which a caller recovering an overseer acts on differently from a launch that
# broke. Not everything on
# stderr is a refusal: `successor-lane-unobserved` says the account could not
# be read and the launch stands, so it is a notice the run continues past.
#
# `line-unrecorded` and `record-unwritten` are notices on stderr too: the
# fleet state could not take this run's launch line or its session record,
# and the succession stands. So is `checkout-unsynced` (step 4), which every
# launching mode also writes to the fleet log as one `close` row, its path
# left out, with `fleet-log-unwritten` where that row could not be written.
# `record-unread` reports a failed caller-record lookup in modes other than
# --dead-pane; --harness, the pane, its context
# reading and its environment answer for it. Live self-succession later
# refuses `handoff-stale` if the fleet generation or handoff cannot be read
# or does not match. Recovery continues after an unreadable state with
# `record-unwritten step=read`. Under
# --print-launch-line it stays out of the line, since the watch start records
# the print's stdout alone.
# `succession-off`, `context-unmeasured`, `context-below-mark`,
# `account-below-mark`, `mark-reached` and `mark-unmeasured` are on stdout
# and end the run at exit 0. `successor-account-unmeasured` (step 3) is on
# stdout and in the fleet log, and settles no exit status.
# `successor-launch` is on stdout too, but settles no
# exit status: it is printed mid-run, before the window is opened, and names the
# form the lane reached the harness by. `watch-handover` and `watch-started` are
# on stdout too and settle nothing either, printed before the close, and a
# `watch-restart-failed` before the close refuses the launch. A failure
# after the close is recorded in the watch error log.
# `successor-working` goes to stdout only after the close succeeded, and a real
# handoff has ended this script's window by then.
# In the self-succession mode alone, every refusal from `successor-launch` on
# is also one `close` row in the fleet log, its keyed line and its text joined,
# so the session that reads the log next learns the succession failed and the
# predecessor kept the fleet; `fleet-log-unwritten` on stderr says that row
# could not be written. A --dead-pane or --walled-pane run writes none: the
# watch that ran it logs its failed relaunch itself.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

usage() { sed -n '/^# Usage:/,/^# Output:/p' "$0" | sed 's/^# \{0,1\}//'; }

message() { # KEY FIELD=VALUE...
  local key="$1" text
  local headroom_text='The headroom field says what the account mark found: a number above the trigger, or at or below it for a Codex account room on its credits (lanes --help, pick), or none or unreadable where nothing measured it.'
  shift
  case "$key" in
    tmux-missing) text='Run it from inside the overseer tmux pane.' ;;
    unknown-option) text="$(usage | sed -n '/^Usage:/,/^$/p')" ;;
    invalid-wait-secs) text='--wait-secs takes a positive whole number of seconds.' ;;
    invalid-handoff) text='The handoff path takes letters, digits and ./_- only.' ;;
    handoff-stale) text='The handoff must carry one Start here line with the current fleet generation. Rewrite it before succession; no successor was launched.' ;;
    invalid-dead-pane) text='--dead-pane takes a tmux pane id, %N.' ;;
    invalid-walled-pane) text='--walled-pane takes a tmux pane id, %N.' ;;
    invalid-line-file) text='--line-file names no readable file with a launch line in it.' ;;
    mode-conflict) text='--print-launch-line, --check-marks, --dead-pane, --walled-pane and -- HARNESS_FLAGS name five different runs. --dead-pane needs --line-file and takes none of the others; --line-file is read only with it; --walled-pane takes --handoff, --wait-secs and -- HARNESS_FLAGS and none of the other modes, reading no recorded line because the walled pane still answers for itself; --check-marks takes no other option but --context, --handoff and --wait-secs included, because it opens no window for either to reach; --context is taken by --check-marks and a plain succession alone.' ;;
    line-unrecorded) text='The successor launch line could not be written to the fleet state, so a later dead-overseer relaunch has none to send. The succession itself stands.' ;;
    record-unread) text='The fleet state could not be read, so this session'\''s launch record was not consulted: its harness, account and model are read off its pane and its environment, as for a session nothing has recorded.' ;;
    record-unwritten) text='The session record in the fleet state could not be written for the successor, or put back after an abandoned launch, so the record does not name the session that is running. The step field says which; the succession itself stands.' ;;
    runtime-unsupported) text='This script reads the successor'\''s account off its tmux pane, so it opens sessions on the tmux runtime alone. ORCH_OVERSEER_HOST names another; nothing was launched and this overseer keeps running.' ;;
    settings-rejected) text='The settings load failed; no successor is chosen from partial settings.' ;;
    invalid-succession) text='ORCH_OVERSEER_SUCCESSION takes on or off.' ;;
    invalid-question-tool) text='ORCH_QUESTION_TOOL takes off or overseer.' ;;
    succession-off) text='ORCH_OVERSEER_SUCCESSION is off; nothing was launched.' ;;
    invalid-headroom-trigger) text='ORCH_OVERSEER_HEADROOM_PCT takes a whole number of percent from 0 to 100.' ;;
    invalid-wall-minutes) text='ORCH_OVERSEER_WALL_MINUTES takes a whole number of minutes; 0 disables this trigger.' ;;
    invalid-successor-accounts) text='ORCH_OVERSEER_SUCCESSOR_ACCOUNTS takes a whole number; 0 disables this trigger.' ;;
    invalid-context-mark) text='ORCH_HANDOFF_CONTEXT_PCT takes a whole number of percent from 1 to 100.' ;;
    pane-unreadable) text='The caller pane could not be read.' ;;
    harness-unnamed) text='The caller pane runs no harness this script launches, and neither --harness nor a context reading of this pane names one.' ;;
    invalid-harness) text='--harness takes claude, codex, copilot or pi.' ;;
    copilot-account-unknown) text='This overseer runs Copilot CLI, its launch record names no account, and no Copilot process under its pane had an environment to read one from. Nothing was printed. Record the account with oversee register --account DIR from this pane, then print the line again.' ;;
    invalid-context) text='--context takes TOKENS:WINDOW, two whole numbers, the window empty where no adapter named one.' ;;
    context-unmeasured) text="No account mark is reached and the context mark was not judged: the --context reading names no window (window-unnamed), or this run was handed none (context-unread). Nothing was launched. At the context mark, run the succession the turn-end refusal names, which carries the reading. $headroom_text" ;;
    context-below-mark) text="No mark is reached; nothing was launched. The shared context rule requires no handoff at this reading. $headroom_text" ;;
    account-below-mark) text="No account mark is reached. This run was handed no --context reading, so the context mark was not judged; references/oversee-events.md § Judgement rules says who judges it. $headroom_text" ;;
    mark-reached) text='This overseer is at or past one of its own marks and has to hand this session over. Run oversee-succeed with the permission, model and effort flags this session runs under; where succession is off, write the overseer handoff file and ask for a fresh overseer session by hand.' ;;
    mark-unmeasured) text='One trigger could not be measured this time, and no other trigger fired. Nothing is launched and nothing is settled: a reading that failed is never a mark that lifted, so a caller holding a standing mark keeps it. The reason field names the figure that was missing.' ;;
    invalid-preference) text='ORCH_OVERSEER_PREFERENCE entries are harness:model:effort with harness claude, codex, copilot or pi, model the model that harness launches, on pi a provider/id, and effort the level as that harness spells it, each in the characters kendex.settings.toml.example § Fleet in the orch skill states. An entry naming no model is refused.' ;;
    lanes-failed) text='A lanes read failed on a path about to launch; no lane is chosen on a guess.' ;;
    walled-lane-unknown) text='The account this walled overseer is spending could not be named, so the one account its successor must not open on is unknown and nothing was launched. A session carrying neither of the two account variables, under a harness whose default this reader cannot resolve, and a pi session on a model no lane measures or naming no provider, are the shapes that reach this.' ;;
    model-window-unknown) text='The claude adapter names no context window for the model this successor would run, and a successor runs with its compaction off, so it would reach its wall with no handoff mark. Nothing was launched. Name a claude model the window table in lib/adapters/claude.sh names.' ;;
    pi-account-unknown) text='This pi overseer names its model with no provider, in its launch record, the --model word after -- and its context reading alike, so the account its successor would spend is unknown and nothing was launched. Pass --model as provider/id after --, pi-claude/<id> for a claude account.' ;;
    pi-handoff-unmarked) text='A pi successor would compact or reach its wall with no handoff mark, so nothing was launched. The reason field names which: compaction-on is a pi settings file, the one the file field names, leaving compaction.enabled on; settings-unreadable is that file present and unreadable, its reader words below; no-window-read is no installed pi-hooks carrier sending the context window.' ;;
    successor-account-unmeasured) text='The successor opens on this overseer'\''s own account, which nothing measured and the caller already spends.' ;;
    launch-choice-failed) text='The launch flag table cannot state a required model or an equivalent cross-harness permission posture. Nothing was launched.' ;;
    no-lane-qualifies) text='No lane walked clears the headroom trigger; nothing was launched and this overseer keeps running. The walk is every ORCH_OVERSEER_PREFERENCE entry, counted in entries, and then the fleet-wide sweep of the harness the fallback field names, which is none where the walk never reached that entry, so a preference aimed at a spent harness is not what this says. walled and unmeasured are the accounts those sweeps refused and the accounts nothing could measure, counted once per sweep. The mark field names the trigger. At mark=headroom the account and resets fields name the account that ran out and when the bucket this session spends frees up. At mark=wall the caller pane read walled and no mark was judged, so no account is named here; the caller that read that wall names it.' ;;
    launch-trust-missing) text='The folder-trust entry for the caller directory could not be made in the config this successor would read, so nothing was launched and the caller keeps running. The successor would open on the folder-trust question and wait there for an answer nobody at the pane gives. The reason field names what failed: trust-refused is an answer already recorded for that directory that is not trust, which this will not overwrite; config-unreadable is the account config present and unreadable or unparseable, a dangling shim link being the usual codex cause; account-store is the account transcript directory that could not be made; home-path, home-create, home-link, home-entry, config-write and config-install are the private CODEX_HOME under the account, or the claude config dir .claude.json, that could not be built, so check that the account directory is writable, home-entry naming a real file or directory sitting where a link to the account belongs; entry-unreadable is the entry written and not read back.' ;;
    launch-failed) text='The successor could not be launched; the caller keeps running.' ;;
    interrupted) text='A signal stopped the script; the successor window was closed and the caller keeps running.' ;;
    successor-launch) text='The successor command is built; the form names how the picked lane reaches the harness.' ;;
    entry-permission-untransferable) text='This entry names another harness than the caller runs, and something of the caller would not cross to it. Without a model field: the caller runs under permission words with no equivalent on that harness, so a successor there would change what it may do. With a model field: the entry is a deprecated numeric one, which would run that caller model in the spelling of the caller harness, and the walk translates none. The entry is skipped and the walk goes on to the next one, ending at the harness the caller runs.' ;;
    successor-status-line) text='The shared installer could not configure this Copilot home or its statusLine fallback. detail names the setup failure and cause names the fallback failure. The entry is skipped.' ;;
    successor-lane-spent) text='The pick named the very account this walled overseer is running on, which its successor may never open on: an inventory that has not caught up with the wall on that pane can still report room there. The entry is skipped, so a fleet whose only candidate is that account refuses rather than relaunching into the wall.' ;;
    successor-dialog) text='The successor stopped at a dialog nobody is there to answer; the caller keeps running. The pane line follows.' ;;
    successor-not-working) text='The successor never showed a running turn; the caller keeps running.' ;;
    fleet-log-unwritten) text='The fleet log row for the line the key field names could not be written; that line stands and is printed beside this one. The step field says what failed, and the writer words follow.' ;;
    checkout-unsynced) text='The checkout this session opens in is not at its base branch'\''s origin head, so a merged hook, render or script may be missing from it. The launch goes on, on the tree as it stands; the fix field says what clears the cause.' ;;
    successor-wrong-lane) text='The successor is running on another account than the one picked, so a wrapper on PATH replaced the selection; the caller keeps running.' ;;
    successor-lane-unobserved) text='The account the successor runs on could not be established. The launch stands: this check refuses on a disagreement it observed, never on an observation it could not make.' ;;
    successor-lane-unknown) text='The account check returned an outcome this script does not know; the successor was closed rather than trusted.' ;;
    successor-working) text='The successor is running in the caller window slot.' ;;
    close-failed) text='The caller window could not be closed; the caller keeps running.' ;;
    watch-handover) text='The fleet watch serving the caller pane is restarted from the successor pane once this window closes, by a helper the orch job runner started outside this run, as the runner fields say. How the restart went is written to the log field, which the next watch start prints.' ;;
    watch-restarted) text='The fleet watch was stopped and started again from the successor pane, with the successor flags and account, so a successor that dies is reported. Its output stays beside the fleet state for the successor to read.' ;;
    watch-started) text='The repeat fleet watch runs outside the successor session. Read the log field to receive its events.' ;;
    watch-restart-failed) text='The fleet watch could not be started or restarted from the successor pane. Before the caller closes, this failure refuses the succession. A later helper failure is recorded in the watch error log.' ;;
  esac
  printf 'oversee-succeed: %s' "$key"
  printf ' %s' "$@"
  printf '\n%s\n' "$text"
}

# The exit status is a parameter of ONE function, so a refusal's words and its
# status are written on one line and no site can pair the key with a status the
# header does not give it.
die_status() { # STATUS KEY FIELD=VALUE...
  local status="$1"
  shift
  message "$@" >&2
  [[ ! -s "${DEP_ERR:-}" ]] || cat -- "$DEP_ERR" >&2
  exit "$status"
}

die() { die_status 1 "$@"; }

# Validation reads ASCII classes, whatever the caller's locale.
matches() { # VALUE REGEX
  local LC_ALL=C
  [[ "$1" =~ $2 ]]
}

case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac

# Every dependency writes its stderr here, one call at a time, so a refusal's
# keyed line comes first and die relays the detail after it. Exported so the
# settings load keeps it.
DEP_ERR="$(mktemp)" || die launch-failed step=mktemp
export DEP_ERR
trap 'rm -f -- "$DEP_ERR"' EXIT

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export PROJECT_ROOT
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$PROJECT_ROOT" 2>"$DEP_ERR" || die settings-rejected "path=$PROJECT_ROOT"
# shellcheck source=lib/lane-context.sh
source "$SCRIPT_DIR/lib/lane-context.sh"
# shellcheck source=lib/lane-state.sh
source "$SCRIPT_DIR/lib/lane-state.sh"
# shellcheck source=lib/lane-launch.sh
source "$SCRIPT_DIR/lib/lane-launch.sh"
# The launch steps shared with `oversee launch`: the walk, the flags, the
# command, the runtime's create, the session record, the verification and the
# stop.
# shellcheck source=lib/overseer-launch.sh
source "$SCRIPT_DIR/lib/overseer-launch.sh"
# shellcheck source=lib/watch-pid.sh
source "$SCRIPT_DIR/lib/watch-pid.sh"
# shellcheck source=lib/job-unit.sh
source "$SCRIPT_DIR/lib/job-unit.sh"
# The watch handover and the job launch the helper below restarts the watch
# through, shared with `oversee launch --predecessor`.
# shellcheck source=lib/watch-handover.sh
source "$SCRIPT_DIR/lib/watch-handover.sh"

# The internal `--watch-restart STATE CALLER_SESSION PANE LANE_VAR LANE_HOME
# HARNESS CWD SCRIPT ARGC ARGS... [FLAG...]` run, step 6's helper, which the succession starts before its
# close through the orch job runner (header step 6). Every
# line it prints goes to oversee-watch.err, where the handover pointed its
# stdout and stderr, so the next watch start on the state other than a
# succession's prints it. Each outcome is one keyed line, and none is a refusal
# of anything: the succession has already committed.
watch_restart() { # STATE CALLER_SESSION PANE LANE_VAR LANE_HOME HARNESS CWD SCRIPT ARGC ARGS... [FLAG...]
  local state="$1" caller="$2" pane="$3" var="$4" home="$5" harness="$6" deadline runner
  local cwd="$7" script="$8" argc="$9"
  local -a argv=() flags=()
  shift 9
  argv=("${@:1:$argc}")
  shift "$argc"
  [[ $# -eq 0 ]] || flags=(-- "$@")
  watch_pid_paths "$state" || { message watch-restart-failed step=state-path "path=$state"; return 0; }
  deadline=$((SECONDS + WATCH_STOP_SECS))
  # The caller is closed once the runtime's `inspect` no longer lists it.
  while [[ -n "$caller" ]]; do
    if ! ol_session_inspect "$caller"; then
      message watch-restart-failed step=close "session=$caller"
      cat -- "$DEP_ERR"
      return 0
    fi
    [[ "$OL_INSPECT_STATE" != gone ]] || break
    if (( SECONDS >= deadline )); then
      message watch-restart-failed step=close "session=$caller"
      return 0
    fi
    sleep 0.1
  done
  # A unit gets none of this run's directory or variables unless it is handed
  # them: the runner names the directory it is launched from and every
  # exported variable, and env sets the three the successor changes. STATE
  # is the absolute path `workflow-state path` printed, so it still names the
  # state from there.
  if ! cd -- "$cwd" 2>/dev/null; then
    message watch-restart-failed step=start "dir=$cwd"
    return 0
  fi
  local harness_args=()
  [[ -z "$harness" ]] || harness_args=(--harness "$harness")
  if ! watch_job_launch watch-restart "$state" "$WATCH_LOG_FILE" "$WATCH_ERR_FILE" \
      env TMUX_PANE="$pane" "$var=$home" OVERSEE_WATCH_ORIGIN=succession \
      "$script" ${argv[@]+"${argv[@]}"} ${harness_args[@]+"${harness_args[@]}"} ${flags[@]+"${flags[@]}"}; then
    message watch-restart-failed step=start "dir=$cwd" "error=$JOB_UNIT_ERROR_KEY" "$JOB_UNIT_ERROR"
    return 0
  fi
  runner="$JOB_UNIT_LINE"
  # The watch this run started, known by the record it writes of itself: any
  # other live record, one about to exit or one the successor started by hand,
  # is not the restart this line reports. Its start stops the old watch first,
  # which WATCH_STOP_SECS bounds, so it is given that and as long again.
  deadline=$((SECONDS + 2 * WATCH_STOP_SECS))
  until watch_pid_live "$state" && [[ "$WATCH_ORIGIN" == succession && "$WATCH_PANE" == "$pane" ]]; do
    if (( SECONDS >= deadline )); then
      message watch-restart-failed step=start "log=$WATCH_ERR_FILE"
      return 0
    fi
    sleep 0.1
  done
  message watch-restarted "pid=$WATCH_PID" "pane=$pane" "$runner"
}
if [[ "${1:-}" == --watch-restart ]]; then
  shift
  [[ $# -ge 9 ]] || die unknown-option "arg=--watch-restart"
  watch_restart "$@"
  exit 0
fi

# Defaults are set after the settings load, which assigns any name.
HANDOFF=tmp/handoffs/OVERSEER-HANDOFF.md
WAIT_SECS=60
# Account headroom, in percent of the binding bucket, at or below which the
# overseer succeeds itself, Codex credit room aside (lanes --help, pick). One
# number is this mark and the floor every successor account must clear. The default answers
# the floor. A higher one rules out every candidate between it and the wall,
# which is how a fleet of walled accounts refuses every successor it walks,
# and it costs the mark its warning: a walled overseer runs no turn at all, so
# it cannot read its mail, handle an event, or call this script, and at this
# default the level alone gives little notice before that. Restoring the
# notice is the rate trigger beside the level.
HEADROOM_TRIGGER="${ORCH_OVERSEER_HEADROOM_PCT:-5}"
WALL_MINUTES="${ORCH_OVERSEER_WALL_MINUTES:-20}"
SUCCESSOR_ACCOUNTS="${ORCH_OVERSEER_SUCCESSOR_ACCOUNTS:-1}"
HARNESS_FLAGS=()
DEAD_PANE=""
WALLED_PANE=""
LINE_FILE=""
PRINT_LINE=0
CHECK_MARKS=0
# Whether the caller SUPPLIED the two options that carry a default, so check
# mode can refuse them: a value it parsed and then ignored is a setting the
# operator believes took effect.
HANDOFF_GIVEN=0
WAIT_GIVEN=0
CONTEXT_ARG=""
CONTEXT_GIVEN=0
HARNESS_ARG=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --handoff|--wait-secs|--dead-pane|--walled-pane|--line-file|--context|--harness)
      [[ $# -ge 2 ]] || die unknown-option "arg=$1"
      case "$1" in
        --context) CONTEXT_ARG="$2"; CONTEXT_GIVEN=1 ;;
        --harness) HARNESS_ARG="$2" ;;
        --handoff) HANDOFF="$2"; HANDOFF_GIVEN=1 ;;
        --wait-secs) WAIT_SECS="$2"; WAIT_GIVEN=1 ;;
        --dead-pane) DEAD_PANE="$2" ;;
        --walled-pane) WALLED_PANE="$2" ;;
        *) LINE_FILE="$2" ;;
      esac
      shift 2
      ;;
    --print-launch-line) PRINT_LINE=1; shift ;;
    --check-marks) CHECK_MARKS=1; shift ;;
    --) shift; HARNESS_FLAGS=("$@"); break ;;
    *) die unknown-option "arg=$1" ;;
  esac
done
matches "$WAIT_SECS" '^[1-9][0-9]*$' || die invalid-wait-secs "value=$WAIT_SECS"
matches "$HANDOFF" '^[A-Za-z0-9._/-]+$' || die invalid-handoff "path=$HANDOFF"
matches "$HEADROOM_TRIGGER" '^[0-9]{1,3}$' && (( 10#$HEADROOM_TRIGGER <= 100 )) \
  || die invalid-headroom-trigger "ORCH_OVERSEER_HEADROOM_PCT=$HEADROOM_TRIGGER"
HEADROOM_TRIGGER=$((10#$HEADROOM_TRIGGER))

# ONE tagged mode, matched by name at every site below, so no site conjoins two
# flags and reads a third combination as one of the two.
#   succeed  the overseer succeeding itself from its own live pane
#   check    the triggers judged and reported, nothing picked and nothing launched
#   print    the line THIS overseer's successor would run, printed, nothing launched
#   dead     the recorded line, sent into a dead overseer's window slot
#   walled   a lane picked afresh for an overseer whose account is spent, sent
#            into its window slot; no mark judged and no recorded line read
MODE=succeed
if [[ -n "$DEAD_PANE" ]]; then
  MODE=dead
  [[ "$PRINT_LINE" -eq 0 && "$CHECK_MARKS" -eq 0 && ${#HARNESS_FLAGS[@]} -eq 0 && -z "$WALLED_PANE" ]] \
    || die mode-conflict "dead-pane=$DEAD_PANE" "print=$PRINT_LINE" "check=$CHECK_MARKS" \
      "flags=${#HARNESS_FLAGS[@]}" "walled-pane=${WALLED_PANE:-none}"
  matches "$DEAD_PANE" '^%[0-9]+$' || die invalid-dead-pane "value=$DEAD_PANE"
  [[ -n "$LINE_FILE" ]] || die mode-conflict "dead-pane=$DEAD_PANE" "line-file=none"
  [[ -f "$LINE_FILE" && -s "$LINE_FILE" ]] || die invalid-line-file "path=${LINE_FILE:-none}"
elif [[ -n "$WALLED_PANE" ]]; then
  MODE=walled
  [[ "$PRINT_LINE" -eq 0 && "$CHECK_MARKS" -eq 0 && -z "$LINE_FILE" ]] \
    || die mode-conflict "walled-pane=$WALLED_PANE" "print=$PRINT_LINE" "check=$CHECK_MARKS" \
      "line-file=${LINE_FILE:-none}"
  matches "$WALLED_PANE" '^%[0-9]+$' || die invalid-walled-pane "value=$WALLED_PANE"
elif [[ "$CHECK_MARKS" -eq 1 ]]; then
  MODE=check
  [[ "$PRINT_LINE" -eq 0 && -z "$LINE_FILE" && ${#HARNESS_FLAGS[@]} -eq 0 \
     && "$HANDOFF_GIVEN" -eq 0 && "$WAIT_GIVEN" -eq 0 ]] \
    || die mode-conflict "check=1" "print=$PRINT_LINE" "line-file=${LINE_FILE:-none}" \
      "flags=${#HARNESS_FLAGS[@]}" "handoff=$HANDOFF_GIVEN" "wait-secs=$WAIT_GIVEN"
elif [[ "$PRINT_LINE" -eq 1 ]]; then
  MODE=print
  [[ -z "$LINE_FILE" ]] || die mode-conflict "print=1" "line-file=$LINE_FILE"
else
  [[ -z "$LINE_FILE" ]] || die mode-conflict "line-file=$LINE_FILE" "dead-pane=none"
fi
# The two modes that judge a mark, matched by name at every site below rather
# than re-conjoined there: `succeed` acts on the judgement and `check` reports
# it, and every read they rest on is the same read.
JUDGES=0
[[ "$MODE" != succeed && "$MODE" != check ]] || JUDGES=1
(( JUDGES || ! CONTEXT_GIVEN )) || die mode-conflict "mode=$MODE" "context=$CONTEXT_ARG"
[[ "$MODE" != dead || -z "$HARNESS_ARG" ]] || die mode-conflict "mode=$MODE" "harness=$HARNESS_ARG"
case "$HARNESS_ARG" in '' | claude | codex | copilot | pi) ;; *) die invalid-harness "value=$HARNESS_ARG" ;; esac
# Only a supplied reading is judged; a stored record can name identity alone.
tokens="" window="" CONTEXT_STATE=unjudged
if (( CONTEXT_GIVEN )); then
  matches "$CONTEXT_ARG" '^(0|[1-9][0-9]*):([1-9][0-9]*)?$' || die invalid-context "value=$CONTEXT_ARG"
  tokens="${CONTEXT_ARG%%:*}" window="${CONTEXT_ARG#*:}" CONTEXT_STATE=unmeasured
fi
if (( JUDGES )); then
  matches "$WALL_MINUTES" '^[0-9]{1,9}$' || die invalid-wall-minutes "ORCH_OVERSEER_WALL_MINUTES=$WALL_MINUTES"
  matches "$SUCCESSOR_ACCOUNTS" '^[0-9]{1,9}$' || die invalid-successor-accounts "ORCH_OVERSEER_SUCCESSOR_ACCOUNTS=$SUCCESSOR_ACCOUNTS"
  WALL_MINUTES=$((10#$WALL_MINUTES))
  SUCCESSOR_ACCOUNTS=$((10#$SUCCESSOR_ACCOUNTS))
fi
# Printing a line launches nothing, so the setting that governs launching does
# not gate it: an operator who turned succession off still wants the record
# written, since it is what the owner's later relaunch by hand reads. Judging a
# mark launches nothing either, and the same reasoning holds harder there: an
# overseer past its own mark with succession off still has to hand over by hand,
# and a judgement suppressed for the setting is a fleet left unattended in
# silence. So `check` reads the setting, reports it and judges anyway.
SUCCESSION=on
if [[ "$MODE" != print ]]; then
  case "${ORCH_OVERSEER_SUCCESSION:-on}" in
    on) ;;
    off) SUCCESSION=off ;;
    *) die invalid-succession "ORCH_OVERSEER_SUCCESSION=$ORCH_OVERSEER_SUCCESSION" ;;
  esac
  if [[ "$SUCCESSION" == off && "$MODE" != check ]]; then
    message succession-off ORCH_OVERSEER_SUCCESSION=off
    exit 0
  fi
fi

# Resolve the hook's setting through orch-env before judging the live reading.
# A due check needs no pane identity or successful record write.
if (( JUDGES )); then
  requested_pct="$("$SCRIPT_DIR/orch-env" ORCH_HANDOFF_CONTEXT_PCT 90 2>"$DEP_ERR")" \
    || die settings-rejected "setting=ORCH_HANDOFF_CONTEXT_PCT"
  CONTEXT_PCT="$(lane_context_handoff_pct "$requested_pct")" \
    || die invalid-context-mark "ORCH_HANDOFF_CONTEXT_PCT=$requested_pct"
fi
if (( JUDGES )) && [[ "$CONTEXT_STATE" == unmeasured ]]; then
  due_rc=0
  due="$(lane_context_handoff_due "$tokens" "$window" "$CONTEXT_PCT")" || due_rc=$?
  case "$due_rc" in
    0) CONTEXT_STATE="$due" ;;
    1) CONTEXT_STATE=unmeasured ;;
    *) die invalid-context-mark "ORCH_HANDOFF_CONTEXT_PCT=$CONTEXT_PCT" ;;
  esac
fi
if [[ "$MODE" == check && "$CONTEXT_STATE" == due ]]; then
  message mark-reached kind=context "value=$tokens" "mark=$CONTEXT_PCT" \
    "succession=$SUCCESSION" headroom=unreadable "window=$window"
  exit 0
fi
[[ -n "${TMUX:-}" ]] || die tmux-missing var=TMUX
# A pane of its own replaces the caller's, so only the modes reading the
# caller's need $TMUX_PANE at all.
[[ "$MODE" == dead || "$MODE" == walled || -n "${TMUX_PANE:-}" ]] \
  || die tmux-missing var=TMUX_PANE

# Whether a successor keeps the harness question tool: ORCH_QUESTION_TOOL,
# decided by lib/lane-launch.sh for every overseer launcher. Off by default,
# so a successor carries its harness row's words that take the tool away,
# where the row names any, as every lane launch does; `overseer` keeps it.
# The setting is the one owner: question-tool words in the caller's
# own flags never carry, since a successor on another harness would be handed
# a flag its launch refuses. Read only by the modes that build a line: `dead`
# sends the line it was handed and `check` launches nothing.
QUESTION_OFF=()
if [[ "$MODE" != dead && "$MODE" != check ]]; then
  if ! question_policy="$(launch_overseer_question_tool)"; then
    die invalid-question-tool "ORCH_QUESTION_TOOL=${ORCH_QUESTION_TOOL:-}"
  fi
  [[ "$question_policy" != off ]] || QUESTION_OFF=(--question-off)
fi

# The runtime, held to tmux by the library both launchers share: this script
# reads the successor's account off its pane, so a provider path is refused
# here, before this run reads the caller's session through it or prints or
# records anything, never opened through and recorded as tmux.
if ! ol_runtime_supported; then
  [[ "$OL_REASON" != runtime-unsupported ]] || die runtime-unsupported "host=$OL_RUNTIME"
  die launch-failed step=host-resolve
fi

CALLER_PANE="${DEAD_PANE:-${WALLED_PANE:-${TMUX_PANE:-}}}"
# The caller's window and server are the runtime's `inspect` of its session
# (lib/overseer-launch.sh § ol_session_inspect), the read the launch and the
# watch take of an overseer too; a session the runtime no longer lists has
# no slot for a successor to take.
ol_session_inspect "$CALLER_PANE" || die pane-unreadable "pane=$CALLER_PANE"
[[ "$OL_INSPECT_STATE" != gone ]] || die pane-unreadable "pane=$CALLER_PANE" state=gone
CALLER_WINDOW="$OL_INSPECT_WINDOW" CALLER_SERVER="$OL_INSPECT_SERVER"
# The directory is the named fallback for a session its record names none
# for, which inspect does not carry.
CALLER_PATH="$(tmux display-message -p -t "$CALLER_PANE" '#{pane_current_path}' 2>"$DEP_ERR")" \
  || die pane-unreadable "pane=$CALLER_PANE"
# The caller's own launch record, where the fleet state's `overseer` object
# names this pane on this tmux server (lib/overseer-launch.sh §
# ol_record_current): the harness, account, model, effort and directory the
# session was launched with, the effort read only beside the model it pairs
# with (§ walk_entries). Every fact it answers is taken from it ahead of
# --harness, the pane command, this pane's context reading and the
# environment below, which stay the reading for a first session nothing has
# recorded and for any fact its record leaves unknown. Its `pending` successor
# is never read: that command names the account and model the NEXT session
# runs, and a run judging this one on them would read another session's marks.
# A state that cannot be read is a notice and the bootstrap readings stand,
# since a broken state file would otherwise stop every judgement of a live
# overseer.
#
# Where no record answers, the session's own SessionStart row
# (lib/session-rows.sh) does: the harness its hook install names, the account
# its environment carries, its model and its directory, as the harness itself
# stated them. Where neither answers, --harness precedes the pane command and
# the processes under it (lib/lane-context.sh § lane_context_pane_shape), the
# named fallback, and a context reading for this pane supplies its model and,
# for ambiguous commands, its harness. No stored count is judged; which
# reading stands is the context.json row of schemas/workflow-state.md.
#
# A dead pane is judged by nothing and its line is handed in whole, so it
# reads no current-session identity, only the identity the record holds for
# the line it replays (lib/overseer-launch.sh § ol_record_line_identity).
CALLER_HARNESS="" CALLER_MODEL="" CALLER_ACCOUNT_HARNESS="" CALLER_ACCOUNT_MODEL=""
if [[ "$MODE" != dead ]]; then
  record_rc=0
  ol_caller_known "$CALLER_SERVER" "$CALLER_PANE" "$PROJECT_ROOT" || record_rc=$?
  if (( record_rc > 1 )); then
    message record-unread "pane=$CALLER_PANE" >&2
    [[ ! -s "$DEP_ERR" ]] || cat -- "$DEP_ERR" >&2
  fi
  [[ -z "$OL_KNOWN_CWD" ]] || CALLER_PATH="$OL_KNOWN_CWD"
  reading_harness="" reading_model=""
  OVERSEER_BOX="$(lane_context_overseer_box "$PROJECT_ROOT")"
  if [[ -f "$OVERSEER_BOX/$LANE_CONTEXT_RECORD" ]] \
     && lane_context_record_fields "$(cat -- "$OVERSEER_BOX/$LANE_CONTEXT_RECORD" 2>/dev/null)" \
     && [[ "$LANE_CTX_PANE_KEY" == "$CALLER_SERVER $CALLER_PANE" ]]; then
    reading_harness="$LANE_CTX_HARNESS" reading_model="$LANE_CTX_MODEL"
  fi
  # The pane, read once into LANE_PANE_SHAPE and LANE_PANE_ACCOUNT
  # (lib/lane-context.sh § lane_context_pane_shape): the harness where nothing
  # above names one, and a Copilot session's account where its record names
  # none, whichever source named the harness.
  caller_obs="$(tmux display-message -p -t "$CALLER_PANE" '#{pane_pid} #{pane_current_command}' 2>"$DEP_ERR")" \
    || die pane-unreadable "pane=$CALLER_PANE"
  caller_cmd="${caller_obs#* }"
  lane_context_pane_shape "${caller_cmd#-}" "${caller_obs%% *}" \
    || die pane-unreadable "pane=$CALLER_PANE" field=process-table
  CALLER_HARNESS="${OL_KNOWN_HARNESS:-${HARNESS_ARG:-$LANE_PANE_SHAPE}}"
  if [[ "$CALLER_HARNESS" == both ]]; then
    case "$reading_harness" in
      claude | codex | copilot | pi) CALLER_HARNESS="$reading_harness" ;;
      *) die harness-unnamed "pane=$CALLER_PANE" ;;
    esac
  fi
  # The model passes through the rule a reading takes (lib/lane-context.sh §
  # lane_context_mark_model), so a codex session is judged on its account's
  # binding bucket whichever of the record and the reading named its model.
  # A pi session's account follows the provider its model names, and its
  # record, its `--model` word after -- and its reading each can name the
  # model with or without one: lib/overseer-launch.sh § ol_pi_model is the one
  # precedence over the three, so a turn-end judgement, handed no flags, and
  # the succession it asks for read one account.
  if ! flag_model="$(launch_choice_launch_model "$CALLER_HARNESS" "${HARNESS_FLAGS[*]+${HARNESS_FLAGS[*]}}")"; then
    die launch-choice-failed "harness=$CALLER_HARNESS" step=model-read
  fi
  caller_model="${OL_KNOWN_MODEL:-${reading_model:-$flag_model}}"
  if [[ "$CALLER_HARNESS" == pi ]]; then
    caller_model="$(ol_pi_model "$OL_KNOWN_MODEL" "$flag_model" "$reading_model")"
  fi
  CALLER_MODEL="$(lane_context_mark_model "$CALLER_HARNESS" "$caller_model")"
  OL_PREFERENCE_CALLER_MODEL="$caller_model"
  # The harness and model `lanes` measures this session's account as
  # (lib/overseer-launch.sh § ol_account): a pi session on the pi-claude
  # provider spends a claude account, on a github-copilot model the Copilot
  # pool, on another provider `none`, and on a model naming no provider one
  # that is `unknown`.
  ol_account "$CALLER_HARNESS" "$CALLER_MODEL"
  CALLER_ACCOUNT_HARNESS="$OL_ACCOUNT_HARNESS" CALLER_ACCOUNT_MODEL="$OL_ACCOUNT_MODEL"
fi

# The account mark, judged on the account THIS session is spending and on the
# buckets it actually spends. `lanes pick --lane` is the judge: the one reader
# of a single named account, the same one the lane turn-end hook asks about a
# lane. Asking it with `--model` leaves out every model-scoped weekly window
# whose label that model does not name, through lib/lane-model.sh and not a
# second rule here — a window scoped to a model this overseer will never launch
# walls nothing it does, and marking the session on it costs a window swap and
# a handoff for a bucket nobody here spends. The model is the one this pane's
# own recorded reading named, read above; a session whose reading names none,
# or whose harness is judged on its binding bucket, passes the empty string,
# which that file judges on the account binding bucket instead.
#
# The account is the caller's launch record's where that record names this
# session, and otherwise `lane_context_caller_cfg`'s answer, the owner of
# "which account is this session spending" for a session nothing recorded.
# `lanes context` reports the caller's row through that function alone, so
# for a recorded session whose environment names another account its row
# names the environment's; the mark asks directly because it also needs the
# model, which that report can only take off a pane whose foreground process
# is still a harness.
#
# The bound is the trigger itself, so `lanes pick --lane` returns the verdict
# rather than this script comparing a percentage: MORE than the trigger, or
# Codex credit room (lanes --help, pick), is room, and a lane exactly at it
# otherwise is refused, the documented `at or below` rule.
#
# The caller account is ONE named state, established here and matched by name
# at every site after: `unreadable` where the judge itself failed, `unmeasured`
# where nothing measured this account for this launch, `has-room` where that
# pick exits 0 and `at-trigger` where it exits 3. A judge that failed is not a reason
# to refuse: it says nothing about this account, the account mark does not
# fire and the other marks still decide, and the below-mark and qualifying
# lines carry `headroom=unreadable` so the cause stays visible. Only the paths about to launch a successor refuse on a lanes
# failure. HEADROOM_FIELD is what each state reports on a below-mark line, set
# beside the name so no site re-derives either from an empty string.
#
# Only the modes that judge a mark ask. The other three do not: `print`
# launches nothing, `dead` launches on a death whose recorded line already
# names the account, and `walled` launches on the wall its caller read off
# the pane. An account read in `dead` would answer about the pane that DIED;
# in `walled` the caller has already had this figure judged, which is what
# established the wall, so reading it again here would measure every account
# of the fleet a second time inside one recovery.
#
# CALLER_CFG is that account, named once for every mode that can read it: the
# judgement below asks about it, the caller entry launches on it, and `walled`
# keeps it as the one account its pick may never return. A dead pane names
# none this run can read, its harness having left the pane.
#
# A launch record naming this session answers the account before the
# environment does: a launcher prefixes one account variable without clearing
# the other, and a session started from a shell that carried another account's
# variable would otherwise be judged on that one. Nothing in a session
# launched from a stored token names the account, its environment carrying no
# lane variable, so the record is the one place that says which account it was
# opened on, and the line `print` records for a dead-pane relaunch opens its
# successor there. A session spending no account `lanes` measures names none
# where its record names none, and `dead` reads neither.
# A Copilot session's account is the one its launch record names, else the
# one the Copilot process under its pane was started on, whichever source
# named the harness, and no other: this script can run outside the session,
# where the COPILOT_HOME lane_context_caller_cfg reads is not the session's.
# The line is refused where neither names one.
CALLER_CFG="$OL_KNOWN_ACCOUNT"
[[ "$CALLER_HARNESS" != copilot || -n "$CALLER_CFG" ]] || CALLER_CFG="$LANE_PANE_ACCOUNT"
[[ "$CALLER_HARNESS" != copilot || -n "$CALLER_CFG" ]] || die copilot-account-unknown "pane=$CALLER_PANE"
case "$CALLER_ACCOUNT_HARNESS" in
  claude | codex | pi) [[ -n "$CALLER_CFG" ]] || CALLER_CFG="$(lane_context_caller_cfg "$CALLER_ACCOUNT_HARNESS")" ;;
esac
CALLER_STATE=unreadable HEADROOM_FIELD=unreadable
CALLER_HEADROOM="" CALLER_ACCOUNT="" CALLER_RESETS="" CALLER_STATUS="" CALLER_DETAIL=""
RATE_STATE=unreadable WALL_PROJECTED="" QUALIFYING_STATE=unreadable QUALIFYING_COUNT="" QUALIFYING_HEADROOM=""
if (( JUDGES )); then
  # An account `lanes` does not measure is one nothing measured, its exit 4.
  caller_rc=4 caller_record=""
  if ol_account_measured "$CALLER_ACCOUNT_HARNESS"; then
    caller_rc=0
    caller_record="$(ol_lanes pick --lane "$CALLER_CFG" --harness "$CALLER_ACCOUNT_HARNESS" \
      --min-headroom-pct "$HEADROOM_TRIGGER" ${CALLER_ACCOUNT_MODEL:+--model "$CALLER_ACCOUNT_MODEL"} \
      --json 2>"$DEP_ERR")" || caller_rc=$?
  fi
  case "$caller_rc" in
    0|3)
      # Both exits print the record; `wall` is the percentage USED of the
      # bucket that decided, which is the trigger's own unit inverted. Read by
      # name, so a record that carried neither figure leaves the state
      # unreadable rather than standing in a zero and reading as full room.
      # `alias` is the account label every lane report names an account by,
      # the same field `lanes context` puts in its own account column.
      caller_row="$(jq -r '[ (.wall // ""), (.alias // ""), (.binding_resets_at // ""), (.usage_rate_state // ""), (.projected_wall_minutes // "") ] | @tsv' \
        <<<"$caller_record" 2>"$DEP_ERR")" || caller_row=""
      # Split by hand, never `IFS=$'\t' read`: a TAB is IFS whitespace, so read
      # drops a leading one and an unmeasured lane's empty wall would shift
      # the account into its place. lib/lane-context.sh splits its claims the
      # same way, for the same reason.
      caller_wall="${caller_row%%$'\t'*}"; caller_rest="${caller_row#*$'\t'}"
      CALLER_ACCOUNT="${caller_rest%%$'\t'*}"; caller_rest="${caller_rest#*$'\t'}"
      CALLER_RESETS="${caller_rest%%$'\t'*}"; caller_rest="${caller_rest#*$'\t'}"
      RATE_STATE="${caller_rest%%$'\t'*}"
      WALL_PROJECTED="${caller_rest#*$'\t'}"
      if matches "$caller_wall" '^[0-9]{1,3}$'; then
        CALLER_HEADROOM=$((100 - 10#$caller_wall))
        HEADROOM_FIELD="$CALLER_HEADROOM"
        CALLER_STATE=has-room
        (( caller_rc == 0 )) || CALLER_STATE=at-trigger
      fi
      ;;
    4|5)
      CALLER_STATE=unmeasured HEADROOM_FIELD=none
      # Exit 5 prints the record, whose status and detail say why nothing
      # measured it; exit 4 is a harness `lanes` measures no account of.
      caller_row="$(jq -r '[(.status // ""), (.detail // "")] | @tsv' <<<"$caller_record" 2>/dev/null)" || caller_row=""
      CALLER_STATUS="${caller_row%%$'\t'*}" CALLER_DETAIL=""
      [[ "$caller_row" != *$'\t'* ]] || CALLER_DETAIL="${caller_row#*$'\t'}"
      ;;
    *) ;;
  esac
fi

# One line names one trigger. The level trigger leads when several fire on the
# same reading because it also identifies the account that must not be reused.
MARK_KIND=""
if (( JUDGES )); then
  if [[ "$CALLER_STATE" == at-trigger ]]; then
    MARK_KIND=headroom
  elif (( WALL_MINUTES > 0 )) && [[ "$RATE_STATE" == measured ]] \
       && matches "$WALL_PROJECTED" '^[0-9]+$' && (( WALL_PROJECTED <= WALL_MINUTES )); then
    MARK_KIND=rate
  elif [[ "$CONTEXT_STATE" == due ]]; then
    MARK_KIND=context
  fi
fi

# The preference names where a LATER successor goes; `print` records what THIS
# session runs, so it walks the caller entry alone whatever the setting says,
# and `dead` walks nothing: the recorded line IS the choice, already made by
# whichever of the two modes above wrote it.
#
# `walled` walks the preference as a live succession does: the wall that
# stopped this session can be the bucket of its own model alone, and another
# model may still have room on the same fleet. A named entry writes its own
# model and effort and strips the caller's pair, as it does at a mark, so the
# command names one of each. The walk still never opens on the account that
# walled (WALLED_LANE_ID below).
build_entries() {
  ENTRIES=()
  # The named entries alone, for the refusal to report: the caller fallback below
  # is appended to the walk and is not one of them, so an operator reads how many
  # entries were stated and that the fallback ran after all of them.
  NAMED_ENTRIES=0
  if [[ "$MODE" == print ]]; then
    ENTRIES=(caller)
  else
    # The parse is lib/overseer-launch.sh's ol_preference_entries, the one
    # `oversee launch` reads the same setting with, so the two launchers cannot
    # come to admit different entries.
    ol_preference_entries "$(ol_preference)" || die invalid-preference "entry=$OL_BAD_ENTRY"
    ENTRIES=(${OL_ENTRIES[@]+"${OL_ENTRIES[@]}"})
    NAMED_ENTRIES="$OL_NAMED"
    # The walk ALWAYS ends here, whatever the setting says. The caller entry is
    # the fleet-wide sweep of this overseer's own harness with no model named,
    # and it was once reachable only with an empty preference: a preference was
    # then a narrowing with no last resort, so a single entry whose one harness
    # was spent refused while every account of the caller's harness stood
    # unexamined. A preference states a FIRST choice; it does not give up the
    # last one. `no-lane-qualifies` past this point means no account of any
    # harness walked has room, which is what the words say.
    ENTRIES+=(caller)
  fi
}

# The walk is lib/overseer-launch.sh's ol_walk, the one `oversee launch` takes:
# ENTRIES in order, the first that names a lane into `chosen`, its harness,
# model, effort and lane in the library's OL_* fields. It launches nothing, so
# `check` walks it too, to learn whether a qualifying mark has a successor
# that settles it. What this script hands it is its own policy.
#
# The EXCLUDED account: the rate and qualifying marks exclude the caller's own
# account, since the successor must move off it. So does `walled`: an entry
# of another model is judged on that model's bucket, where the walled account
# can still read room, and a pick naming it would drop the entry although
# another account has room; WALLED_LANE_ID below backs that exclusion.
#
# The CALLER entry: the harness and the account this session is spending,
# established once above from its launch record or through
# lib/lane-context.sh's owner of that question, so the successor opens on the
# account whose room was measured. A raw variable answers two other things:
# the empty string where the harness runs on its own default, which the trust
# preparation would meet as no lane at all and refuse, and the private launch
# home where this session runs under one, which names no account anything
# claimed. Its model and effort are the pair its launch record names, where
# it names a model: the successor is then built as a same-harness entry is,
# its own pair written and the caller's stripped. With none, the caller's own
# flags carry whatever pair they spell. Either way the successor runs the
# model this pane already runs, so its PICK is judged on that model, as a
# preference entry's pick is judged on the model that entry passes; judged on
# no model the pick reads the account binding bucket, stricter than the
# reading the successor will take of itself.
#
# The caller's own lane is KEPT, unpicked, on `has-room` alone and never at a
# rate or qualifying mark, whose successor must move. At the trigger it is
# the account that ran out; unmeasured or unreadable, nothing established that
# it has room. Every other state goes through `lanes pick`, the one judge of
# account room for every entry alike, so its exit 3 skips this entry exactly
# as it skips another harness's, but for one state at one mark: `unmeasured`
# at the context mark keeps the caller's account where the pick of an entry
# of the caller's harness on that account's harness finds none with room.
# The successor spends the account the caller is already
# spending, so a refusal there protects no account and leaves a person to
# hand over by hand. `unreadable` keeps nothing: a judge that failed says
# nothing about this account, and the pick alone decides. `print` reads no account at all and keeps the
# lane the session already runs on. `walled` judges no mark, so CALLER_STATE
# was never read off the account judge and stands at `unreadable`: the pane's
# own banner established the wall, and it never keeps the lane.
#
# A named entry of another harness takes the caller's permission posture only
# where lib/lane-launch.sh's transfer judge admits it; where it does not, the
# entry is skipped rather than chosen and refused after the walk. A pi caller
# whose model names no provider refuses `pi-account-unknown` at its own
# entry. A qualifying mark is held to the count its successor will read;
# header step 2 states which counts settle it.
walk_entries() {
  local exclude="" rc=0 skip
  local -a fields
  case "$MARK_KIND" in rate|qualifying) exclude="$CALLER_CFG" ;; esac
  [[ "$MODE" != walled ]] || exclude="$WALLED_LANE"
  OL_WALK_CALLER_HARNESS="$CALLER_HARNESS" OL_WALK_CALLER_LANE="$CALLER_CFG"
  OL_WALK_CALLER_PICK_MODEL="$CALLER_MODEL" OL_WALK_CALLER_MODEL="" OL_WALK_CALLER_EFFORT=""
  [[ -z "$OL_CUR_MODEL" ]] || OL_WALK_CALLER_MODEL="$OL_CUR_MODEL" OL_WALK_CALLER_EFFORT="$OL_CUR_EFFORT"
  # A pi successor runs, and so records, the provider-bearing model its
  # caller's account was judged on, in place of a model from the record or
  # the flags that names no provider, so no generation's record holds a
  # bare model the next would have to read (ol_pi_model). A flag model
  # naming its provider, the split --provider form included, is kept.
  if [[ "$CALLER_HARNESS" == pi && "$CALLER_MODEL" == ?*/?* ]]; then
    if [[ -n "$OL_WALK_CALLER_MODEL" ]]; then
      [[ "$OL_WALK_CALLER_MODEL" == ?*/?* ]] || OL_WALK_CALLER_MODEL="${CALLER_MODEL%%:*}"
    elif [[ "$flag_model" != ?*/?* ]]; then
      OL_WALK_CALLER_MODEL="${CALLER_MODEL%%:*}"
      if ! OL_WALK_CALLER_EFFORT="$(launch_choice_effort pi "${HARNESS_FLAGS[*]+${HARNESS_FLAGS[*]}}")"; then
        die launch-choice-failed harness=pi step=effort-read
      fi
    fi
  fi
  OL_WALK_CALLER_KEEP=0
  case "$MODE:$CALLER_STATE:$MARK_KIND" in
    print:*) OL_WALK_CALLER_KEEP=1 ;;
    *:has-room:rate | *:has-room:qualifying) ;;
    *:has-room:*) OL_WALK_CALLER_KEEP=1 ;;
  esac
  OL_WALK_KEEP_UNMEASURED=""
  [[ "$CALLER_STATE:$MARK_KIND" != unmeasured:context ]] || OL_WALK_KEEP_UNMEASURED="$CALLER_ACCOUNT_HARNESS"
  # `check` is handed no permission words, so it asks what the harness rows
  # alone can answer and skips an entry on permission saying nothing: it
  # judges no launch of its own, and never chooses an entry the succession it
  # starts skips.
  OL_WALK_SOURCE_HARNESS="$CALLER_HARNESS" OL_WALK_SOURCE_FLAGS="${HARNESS_FLAGS[*]+${HARNESS_FLAGS[*]}}"
  OL_WALK_SOURCE_ROWS=0
  [[ "$MODE" != check ]] || OL_WALK_SOURCE_ROWS=1
  OL_WALK_REFUSE_ID="${WALLED_LANE_ID:-}" OL_WALK_SUCCESSOR_BOUND=0
  [[ "$MARK_KIND" != qualifying ]] || OL_WALK_SUCCESSOR_BOUND="$SUCCESSOR_ACCOUNTS"
  ol_walk "$HEADROOM_TRIGGER" "$exclude" ${ENTRIES[@]+"${ENTRIES[@]}"} || rc=$?
  for skip in ${OL_WALK_SKIPS[@]+"${OL_WALK_SKIPS[@]}"}; do
    IFS=$'\t' read -r -a fields <<<"$skip"
    message "${fields[@]}" >&2
  done
  (( rc != 1 )) || die "$OL_REASON" "${OL_FIELDS[@]}"
  chosen="$OL_CHOSEN"
}

# Capacity is the only fleet-wide read. Headroom, rate and context are already
# decided, so a slow sweep cannot hide a mark this pane already reached. It is
# lib/overseer-launch.sh's ol_pick_record, the question the walk's pick and
# its successor count ask too, so the three cannot judge an account three ways.
#
# QUALIFYING_COUNT is the accounts a successor could open on, this one left
# out, and at least one of them is what makes a move possible at all.
# QUALIFYING_TOTAL is the figure the mark is set against: those accounts and
# this overseer's own where it is `has-room`. The
# header's step 2 says why the mark is never set against the first.
QUALIFYING_TOTAL=""
chosen=""
if (( JUDGES )) && (( SUCCESSOR_ACCOUNTS > 0 )) && [[ -z "$MARK_KIND" && "$CALLER_STATE" != at-trigger ]]; then
  capacity_rc=0
  ol_pick_record "$CALLER_HARNESS" "$CALLER_MODEL" "$HEADROOM_TRIGGER" "$CALLER_CFG" || capacity_rc=$?
  case "$capacity_rc" in
    0|3)
      capacity_row="$(jq -r '[ (.qualifying_count // ""), (.effective_headroom_pct // "") ] | @tsv' \
        <<<"$OL_PICK_RECORD" 2>"$DEP_ERR")" || capacity_row=""
      QUALIFYING_COUNT="${capacity_row%%$'\t'*}"
      QUALIFYING_HEADROOM="${capacity_row#*$'\t'}"
      if matches "$QUALIFYING_COUNT" '^[0-9]+$' \
         && { (( QUALIFYING_COUNT == 0 )) || matches "$QUALIFYING_HEADROOM" '^[0-9]{1,3}$'; }; then QUALIFYING_STATE=measured; fi
      ;;
  esac
  if [[ "$QUALIFYING_STATE" == measured ]]; then
    QUALIFYING_TOTAL="$QUALIFYING_COUNT"
    [[ "$CALLER_STATE" != has-room ]] || QUALIFYING_TOTAL=$((QUALIFYING_COUNT + 1))
    if (( QUALIFYING_COUNT > 0 && QUALIFYING_TOTAL <= SUCCESSOR_ACCOUNTS \
          && QUALIFYING_HEADROOM > CALLER_HEADROOM )); then
      # The mark fires only where a successor settles it, and the walk that
      # would open one is the judge of that: the same entries, the same picks
      # and the same successor count, so the judgement and the launch cannot
      # answer two ways. Its choice is the one a succession launches on.
      MARK_KIND=qualifying
      build_entries
      walk_entries
      [[ -n "$chosen" ]] || MARK_KIND=""
    fi
  fi
fi

if (( JUDGES )) && [[ -z "$MARK_KIND" ]]; then
    # A reading that did not succeed is not a mark that did not fire, and only
    # `check` has to tell them apart: its caller holds a standing mark across a
    # pass that could not measure, where a run about to launch has the
    # documented fallback of letting the mark it CAN read decide alone. So the
    # unmeasured answers get their own key here. Below, a context mark not
    # judged is never a below-mark line: `check` handed no reading was asked
    # about the account triggers alone, and every other case is unmeasured.
    #
    # The context mark leads, judged above: a mark that fired is what the
    # caller must act on, whatever the other reading could not say.
    if [[ "$MODE" == check ]]; then
      case "$CALLER_STATE" in
        unreadable | unmeasured)
          message mark-unmeasured kind=headroom "reason=headroom-$HEADROOM_FIELD" \
            "succession=$SUCCESSION"
          exit 0
          ;;
      esac
      if [[ "$CONTEXT_STATE" == unmeasured ]]; then
        message mark-unmeasured kind=context reason=window-unnamed "succession=$SUCCESSION"
        exit 0
      fi
      if (( WALL_MINUTES > 0 )) && [[ "$RATE_STATE" != measured && "$RATE_STATE" != credits ]]; then
        message mark-unmeasured kind=rate "reason=${RATE_STATE:-unreadable}" \
          "succession=$SUCCESSION"
        exit 0
      fi
      if (( SUCCESSOR_ACCOUNTS > 0 )) && [[ "$QUALIFYING_STATE" != measured ]]; then
        message mark-unmeasured kind=qualifying reason=unreadable \
          "succession=$SUCCESSION"
        exit 0
      fi
    fi
    case "$MODE:$CONTEXT_STATE" in
      check:unjudged) message account-below-mark "headroom=$HEADROOM_FIELD" ;;
      *:unjudged) message context-unmeasured reason=context-unread "headroom=$HEADROOM_FIELD" ;;
      *:unmeasured) message context-unmeasured reason=window-unnamed "headroom=$HEADROOM_FIELD" ;;
      *) message context-below-mark "tokens=$tokens" "window=$window" "mark=$CONTEXT_PCT" \
           "headroom=$HEADROOM_FIELD" ;;
    esac
    exit 0
fi

# A reached account mark ends `check`; a due context already returned above.
# Actual succession keeps account priority when choosing a successor.
if [[ "$MODE" == check ]]; then
  if [[ "$MARK_KIND" == headroom ]]; then
    message mark-reached kind=headroom "value=$CALLER_HEADROOM" "mark=$HEADROOM_TRIGGER" \
      "succession=$SUCCESSION" "account=${CALLER_ACCOUNT:-unknown}" "resets=${CALLER_RESETS:-none}"
  elif [[ "$MARK_KIND" == rate ]]; then
    message mark-reached kind=rate "value=$WALL_PROJECTED" "mark=$WALL_MINUTES" \
      "succession=$SUCCESSION" "account=${CALLER_ACCOUNT:-unknown}"
  else
    message mark-reached kind=qualifying "value=$QUALIFYING_TOTAL" "mark=$SUCCESSOR_ACCOUNTS" \
      "succession=$SUCCESSION" "headroom=$HEADROOM_FIELD"
  fi
  exit 0
fi

# The account the walled pane is SPENDING: the one account its successor may
# never open on. Read once before the walk, which holds every entry to it.
#
# The pick judges room and nothing else, so a reading that still shows room
# for the account whose own screen carries the wall — an inventory not yet
# refreshed, a wall the usage endpoint does not report — would hand that
# directory straight back.
#
# Identity is decided by the pairing lib/lane-launch.sh's lane_account_check
# uses, lane_claims_canon over lane_launch_home_account, and by no spelling of
# its own: this side is whatever the operator's shell exported, and the pick's
# side is whatever lane discovery produced, so a trailing slash, a symlinked
# home, or a codex private launch home makes two strings for one account and
# a bare test would let the successor open on the very account that walled.
#
# An account this cannot name is refused rather than passed: with no lane to
# compare against, the exclusion below is dead and the recovery would reopen
# on an unknown account.
#
# Two names for it, as lane_account_check keeps two: WALLED_LANE is the
# spelling this session carries, CALLER_CFG above and no second reading of it,
# which is what a line naming the account should print, and WALLED_LANE_ID is
# that spelling made comparable.
WALLED_LANE=""
WALLED_LANE_ID=""
if [[ "$MODE" == walled ]]; then
  WALLED_LANE="$CALLER_CFG"
  WALLED_LANE_ID="$(ol_account_id "$WALLED_LANE")" || WALLED_LANE_ID=""
  [[ -n "$WALLED_LANE_ID" ]] || die walled-lane-unknown "harness=$CALLER_HARNESS"
fi

# `dead` walks nothing: the recorded line IS the choice. A qualifying mark was
# already walked where it was judged, and that walk's choice stands.
if [[ "$MODE" == dead ]]; then
  chosen=recorded
elif [[ -z "$chosen" ]]; then
  build_entries
  walk_entries
  if (( OL_KEPT_UNMEASURED )); then
    message successor-account-unmeasured "lane=$OL_LANE_DIR" "status=${CALLER_STATUS:-none}" "detail=${CALLER_DETAIL:-none}"
    ol_fleet_log_notice successor-account-unmeasured "lane=$OL_LANE_DIR" "status=${CALLER_STATUS:-none}" "detail=${CALLER_DETAIL:-none}"
  fi
fi

# `mark=` says which fields follow, and the account and reset only follow the
# account mark. At the context mark this overseer's own account either has
# room or was never measured, so there is no account to name: naming one there
# would send the operator to wait on a reset that unblocks nothing.
#
# In `walled` the mark is neither: the caller's own pane read walled, which no
# figure here measured, so `mark=wall` says so and names no account. The
# caller that read that wall took an account judgement to confirm it, and
# names the account and its reset off that line rather than off a reading
# this run never made.
if [[ -z "$chosen" ]]; then
  # What the walk covered, so a spent fleet reads differently from a preference
  # aimed at the wrong harness: the preference entries stated, the harness the
  # fallback entry swept or `none` where the walk never reached it, and how
  # many accounts each sweep found walled and how many it could not measure.
  # An account two sweeps both walked counts once per sweep, which is what
  # "walked" means here.
  WALK=("entries=$NAMED_ENTRIES" "fallback=$OL_FALLBACK_WALKED"
        "walled=$OL_WALKED_WALLED" "unmeasured=$OL_WALKED_UNMEASURED")
  [[ "$MODE" != walled ]] || die_status 3 no-lane-qualifies "${WALK[@]}" mark=wall
  [[ "$MARK_KIND" != headroom ]] || die_status 3 no-lane-qualifies "${WALK[@]}" \
    mark=headroom "account=${CALLER_ACCOUNT:-unknown}" "resets=${CALLER_RESETS:-none}"
  die_status 3 no-lane-qualifies "${WALK[@]}" "mark=${MARK_KIND:-context}"
fi

if [[ "$MODE" == dead ]]; then
  # The recorded line is the whole command, lane prefix and brief included: it
  # was built by one of the building modes below, on a pane that was alive to answer
  # for its harness and its account. Read whole and taken as it stands, so a
  # relaunch cannot differ from the line the fleet state says it will send.
  cmd="$(cat -- "$LINE_FILE")" || die invalid-line-file "path=$LINE_FILE"
  [[ -n "$cmd" ]] || die invalid-line-file "path=$LINE_FILE"
  # Nothing here picked a lane, so there is no picked account to hold the pane
  # to: `unchecked` is lane_account_check's own name for exactly that, and it
  # reports `skipped` rather than a verification it could not make.
  LANE_FORM=unchecked
  lane_dir=""
  lane_var=CLAUDE_CONFIG_DIR
else
  # The successor's flag words as argv, from which the command is written in
  # one place below and which the fleet watch restarted from the successor
  # pane is handed, so the two cannot name different flags. They are
  # lib/overseer-launch.sh's ol_launch_flags, the one assembly a first launch
  # takes too: the entry's model and effort from lib/lane-launch.sh's table,
  # the caller's own words carried over as that entry allows, and the
  # harness's launch settings, compaction words and question-tool words
  # leading them. A codex successor otherwise opens on the startup update
  # prompt in a pane nobody is at, and a claude successor with no named window
  # is refused as a setting to fix.
  ol_launch_flags ${QUESTION_OFF[@]+"${QUESTION_OFF[@]}"} "$OL_HARNESS" "$OL_MODEL" "$OL_EFFORT" \
    "$OL_PICK_MODEL" "$CALLER_HARNESS" ${HARNESS_FLAGS[@]+"${HARNESS_FLAGS[@]}"} \
    || die "$OL_REASON" "entry=$chosen" ${OL_FIELDS[@]+"${OL_FIELDS[@]}"}
  SUCC_FLAGS=(${OL_FLAGS[@]+"${OL_FLAGS[@]}"})
  lane_dir="$OL_LANE_DIR" harness="$OL_HARNESS"
  # The command itself, the brief naming the handoff, the folder trust a codex
  # successor needs before it reads its arguments and the form the lane
  # reaches the harness by are lib/overseer-launch.sh's, the one builder a
  # first launch uses too. `dead` never reaches this: its line was built by
  # one of the modes that reach this branch and already carries whatever home
  # it named. lane_dir is a path here for every session spending an account
  # `lanes` measures: the arms of lane_context_caller_cfg this reaches print a
  # directory, and every other entry takes a pick the judge refuses to hand
  # back empty. A pi successor on any other provider has none, and
  # ol_command_line launches it bare.
  ol_command_line "$harness" "$HANDOFF" "$lane_dir" "$CALLER_PATH" ${SUCC_FLAGS[@]+"${SUCC_FLAGS[@]}"} \
    || die launch-trust-missing "lane=$lane_dir" "dir=$CALLER_PATH" "reason=$OL_TRUST_REASON"
  cmd="$OL_CMD"
  lane_var="$OL_LANE_VAR"
  launch_home="$OL_LAUNCH_HOME"
  LANE_FORM="$OL_FORM"
  LANE_TRUST_ROUTE="$OL_TRUST_ROUTE"
  # Pi has no launch word for compaction: its settings file turns it off, and
  # its pi-hooks carrier names the window the handoff mark is read against,
  # both judged where the successor opens as open-terminal judges a pi lane
  # (lib/adapters/pi.sh), and on the Pi root it runs under: the picked
  # account's where the line names it as PI_CODING_AGENT_DIR, a successor on
  # the Copilot pool, as open-terminal's pi_lane_root_apply judges a pool
  # lane, and this run's own otherwise.
  if [[ "$harness" == pi ]]; then
    pi_root="$(lane_adapter_pi_agent_dir)"
    [[ "$lane_var" != PI_CODING_AGENT_DIR || -z "$lane_dir" ]] || pi_root="$lane_dir"
    pi_rc=0
    PI_CODING_AGENT_DIR="$pi_root" lane_adapter_pi_compaction_on "$CALLER_PATH" || pi_rc=$?
    case "$pi_rc" in
      1) ;;
      0) die pi-handoff-unmarked reason=compaction-on "file=$LANE_ADAPTER_PI_FILE" ;;
      *) printf '%s\n' "$LANE_ADAPTER_PI_CAUSE" > "$DEP_ERR"
         die pi-handoff-unmarked reason=settings-unreadable "file=$LANE_ADAPTER_PI_FILE" ;;
    esac
    PI_CODING_AGENT_DIR="$pi_root" lane_adapter_pi_window_read "$CALLER_PATH" \
      || die pi-handoff-unmarked reason=no-window-read "dir=$CALLER_PATH"
  fi
fi

# The line alone, on stdout, with nothing keyed around it: its one consumer is
# `oversee-watch`, which stores it verbatim in the fleet state and hands it
# back as --line-file when the overseer it names dies.
if [[ "$MODE" == print ]]; then
  printf '%s\n' "$cmd"
  exit 0
fi

# The line this run built, for a `walled` caller's own output: that caller is
# `oversee-watch`, which reports the recovery it just performed and has no
# other way to say which command it sent. Printed before the window opens, for
# the reason the record below is written there. `dead` prints none, its line
# being the one its caller handed in.
[[ "$MODE" != walled ]] || printf '%s\n' "$cmd"

# The caller's own session record, read before anything below writes to the
# `overseer` object: it is what an abandoned launch puts back whole, launch
# line included, so a later dead-overseer relaunch never replays a line this
# run refused. Only live self-succession has a writer that can make the
# handoff current; recovery cannot demand a snapshot from a dead or walled
# predecessor (../references/communication-modes.md § Handoff).
if ! ol_record_read; then
  [[ "$MODE" != succeed ]] || die handoff-stale "path=$HANDOFF" expected=unknown
  message record-unwritten field=overseer step=read >&2
  [[ ! -s "$DEP_ERR" ]] || cat -- "$DEP_ERR" >&2
fi
if [[ "$MODE" == succeed ]]; then
  generation="$(jq -er '.generation // empty' <<<"$OL_PRIOR" 2>"$DEP_ERR")" \
    || die handoff-stale "path=$HANDOFF" expected=unknown
  [[ "$generation" =~ ^[0-9]+$ ]] \
    || die handoff-stale "path=$HANDOFF" expected=unknown
  handoff_generation="$(sed -n 's/^Start here: .* generation=\([0-9][0-9]*\)$/\1/p' 2>"$DEP_ERR" < "$HANDOFF")" \
    || die handoff-stale "path=$HANDOFF" "expected=$generation"
  [[ "$handoff_generation" == "$generation" ]] \
    || die handoff-stale "path=$HANDOFF" "expected=$generation"
fi
# The successor is recorded BEFORE its window opens, not after the close: the
# close kills this script's own window and a write placed after it may never
# run. Its line and launch identity are the record's `pending` member until
# the session record names it (lib/overseer-launch.sh § ol_succession), and a
# write that fails is a notice, never a reason to leave the fleet unattended.
# `walled` records too: its successor runs a command this run built, and a
# later death that read the walled session's line would relaunch onto the
# account this recovery just left. `dead` replays the line the record holds.
# The launch identity the record writes below carries: the one the command was
# built with, and in `dead`, which built none, the one the record holds for
# the line it replays (lib/overseer-launch.sh § ol_record_line_identity), so a
# session relaunched from its record is still identified by it. The directory
# that identity names is where the relaunch opens, as a live succession opens
# in its caller record's: the line was built for it, a codex line's folder
# trust included, and the session opened and the record written name one
# directory. A dead pane's own path answers only where the record names none.
if [[ "$MODE" == dead ]]; then
  if ! ol_record_line_identity "$cmd"; then
    message record-unwritten field=overseer step=identity >&2
    [[ ! -s "$DEP_ERR" ]] || cat -- "$DEP_ERR" >&2
  fi
  replay_cwd="$(jq -r '.cwd // empty' <<<"${OL_IDENTITY:-null}" 2>/dev/null)" || replay_cwd=""
  [[ -z "$replay_cwd" ]] || CALLER_PATH="$replay_cwd"
fi
PENDING=pending
[[ "$MODE" != dead ]] || PENDING=replay
# Which form the lane reached the harness by, before the window exists: on a
# host where the two disagree about the account, this line is what says which
# selector was used and a refusal below is read against it. The trust field
# names which route made the launch directory trusted, or none on a harness
# that asks no such question.
message successor-launch "form=$LANE_FORM" "lane=${lane_dir:-none}" "trust=${LANE_TRUST_ROUTE:-none}"

# Two overseers never run: every failure from here closes the successor and
# puts the predecessor's session record back, so the record names the
# session that is still running. The close-out is the library's
# ol_session_abandon, the same one `oversee launch` runs; the words are this
# script's.
SUCC_PANE="" SUCC_WINDOW=""
# A refusal the fleet log carries too (header, Output), through
# lib/overseer-launch.sh § ol_fleet_log_notice.
abandon() {
  ol_session_abandon || { message record-unwritten field=overseer step=restore >&2; [[ -z "$OL_DETAIL" ]] || printf '%s\n' "$OL_DETAIL" >&2; }
  [[ "$MODE" != succeed ]] || ol_fleet_log_notice "$@"
  die "$@"
}
# A shell tool that times out signals this script. The traps are set before
# the session exists, and a signal that lands during the runtime's create runs
# once the call returns; ol_session_abandon inside abandon reads the session
# off the provider's answer and closes it, so the window is named here only
# where the create had already returned it.
interrupted() { # SIGNAL
  abandon interrupted "window=${OL_WINDOW:-none}" "signal=$1"
}
trap 'interrupted TERM' TERM
trap 'interrupted INT' INT
trap 'interrupted HUP' HUP

# The succession itself is lib/overseer-launch.sh's ol_succession, the one
# `oversee launch --predecessor` runs: the pending record, the runtime's
# create at the session's base index, the session record, the account and
# first-turn verification inside the one --wait-secs bound (ol_session_verify
# says why the account is asked twice), and the predecessor's stop, which
# keeps the successor at the base index, the commit point. These are this script's words at
# each step it reports. `verified` arranges step 6 of the header before the
# close, because nothing after it can be counted on to run; the helper is
# started before the commit point ignores any signal, so it inherits none of
# those ignores.
ol_succession_hook() { # STEP
  case "$1" in
    # A record write that fails is a notice, and 0 lets the succession go on
    # (header, Output).
    pending-unrecorded)
      message line-unrecorded "field=overseer.pending" >&2
      [[ ! -s "$DEP_ERR" ]] || cat -- "$DEP_ERR" >&2
      return 0 ;;
    opened) SUCC_PANE="$OL_SESSION" SUCC_WINDOW="$OL_WINDOW" ;;
    record-unwritten)
      message record-unwritten field=overseer step=write >&2
      [[ ! -s "$DEP_ERR" ]] || cat -- "$DEP_ERR" >&2
      return 0 ;;
    verified)
      # The deciding read could not observe the account: the launch stands,
      # and the notice says why the check refused nothing.
      [[ -z "$OL_UNOBSERVED" ]] || message successor-lane-unobserved "reason=$OL_UNOBSERVED" >&2
      hand_over_watch ;;
  esac
}
# Step 6 of the header: lib/watch-handover.sh's watch_handover, the one
# `oversee launch --predecessor` runs, in this script's words.
hand_over_watch() {
  if [[ "$MODE" == dead ]]; then
    # Replay chose no new argv. The session record owner resolves the home
    # and harness of the line that was replayed, with the caller as fallback.
    local record_rc=0
    ol_record_current "$OL_SERVER" "$SUCC_PANE" || record_rc=$?
    (( record_rc < 2 )) || abandon watch-restart-failed step=identity
    harness="${OL_CUR_HARNESS:-$CALLER_HARNESS}"
    launch_home="${OL_CUR_HOME:-${OL_CUR_ACCOUNT:-$CALLER_CFG}}"
    lane_var="$(lane_env_prefix "$harness" - "${OL_CUR_MODEL:-$CALLER_MODEL}")"
    lane_var="${lane_var%%=*}"
    SUCC_FLAGS=()
  fi
  if watch_handover "$CALLER_PANE" "$SUCC_PANE" "$lane_var" "$launch_home" "$harness" ${SUCC_FLAGS[@]+"${SUCC_FLAGS[@]}"}; then
    message "$WATCH_HANDOVER_KEY" "${WATCH_HANDOVER_FIELDS[@]}"
  else
    abandon "$WATCH_HANDOVER_KEY" "${WATCH_HANDOVER_FIELDS[@]}"
  fi
}
# Every refusal closes the successor before the commit point, or at a stop
# that failed, so a disagreement costs nothing but the successor.
if ! ol_succession "$CALLER_PANE" "$CALLER_PATH" "$cmd" "$OL_IDENTITY" "$PENDING" \
    "$lane_var" "$lane_dir" "$LANE_FORM" "$WAIT_SECS"; then
  case "$OL_REASON" in
    create-failed) abandon launch-failed "step=$OL_REASON" ;;
    stop-failed) abandon close-failed "window=$CALLER_WINDOW" ;;
    wrong-lane) abandon successor-wrong-lane "picked=$lane_dir" "observed=$OL_OBSERVED" ;;
    result-unknown) abandon successor-lane-unknown "result=$OL_RESULT" ;;
    # The pane line and the last screen are in DEP_ERR, where the library
    # put them: on the line after the keyed one, as dependency detail goes.
    dialog) abandon successor-dialog "window=$SUCC_WINDOW" "waited=$OL_WAITED" ;;
    not-working) abandon successor-not-working "window=$SUCC_WINDOW" "waited=$OL_WAITED" ;;
    inspect-failed) abandon launch-failed "step=$OL_STEP" ;;
    *) abandon launch-failed "step=verify" "reason=$OL_REASON" ;;
  esac
fi
message successor-working "window=$SUCC_WINDOW" "pane=$SUCC_PANE"
