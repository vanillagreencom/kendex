  unset GH_TOKEN GITHUB_TOKEN
  { orch_load_env_bot_token "$PROJECT_ROOT" && orch_github_auth_status; } \
    || die auth-failed "" "service=github"
fi

if [[ ${#REPOS[@]} -eq 0 ]]; then
  # The shared resolver, so a watch launched with GH_REPO naming another
  # repository reduces that one rather than the checkout it was started in.
  # Exit 2 prints the value it rejected, which is no more usable as a `--repo`
  # argument than nothing resolved at all, so both refuse here.
  resolve_status=0
  resolved="$(orch_resolve_gh_repo "$PROJECT_ROOT")" || resolve_status=$?
  [[ "$resolve_status" -eq 0 && -n "$resolved" ]] || die repo-unresolved "" "option=--repo"
  REPOS=("$resolved")
fi
# Settled once, HERE — below the default resolution, the one point every path's
# REPOS has reached its final value, so a repo `gh repo view` reported in its
# registered casing is canonicalized too.
check_repo_set
if [[ -x "$PR_WATCH" ]]; then
  :
else
  ow_message reducer-missing "path=$PR_WATCH" >&2
  PR_WATCH=""
fi
if [[ -z "$ITEM_BRANCHES" ]]; then
  ow_message items-omitted "count=0" "skipped=merged,handoff" >&2
else
  # Handoff fails CLOSED like triage: a lane that handed off and exited is
  # otherwise a lane-exited the overseer relaunches from nothing.
