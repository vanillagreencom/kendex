#!/usr/bin/env bash
# oversee-watch blocks until the fleet needs the overseer, reports every event
# the pass found as one block, and exits. The workflow handles every EVENT line
# and re-runs it.
#
# Two passes on one clock. The mail pass reads every mailbox and the lane
# records on ORCH_WATCH_MAIL_INTERVAL; the long pass (one lane snapshot,
# pr-watch, merged items, team triage, lane preparation, lane classification,
# accounts) runs forked on --interval, so a long pass that overruns holds up no
# mail pass, and the heartbeat closes on the long passes. A check that finds an
# event records it and the pass runs on to the next check, so no kind starves
# another: a reducer line on every pass or a lane parked on its limit banner
# would otherwise be the only thing the watch ever said. The block carries the
# latest pr-watch context once. Live tracker and pane reads remain
# authoritative; persisted state holds only edge keys. Usage, event details,
# configuration, and failure contracts live in usage().
# Stdout is the overseer protocol: the EVENT records documented in usage(),
# their record or pane payloads, and the optional `pr-watch rc=N` context block.
# Consumers handle every EVENT in order. Those records are not prose messages.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

usage() {
  cat <<'USAGE'
Usage: oversee-watch [--interval SECS] [--max-loops N] [--since ISO8601]
                     [--item ISSUE_ID]... [--repo OWNER/REPO]...
                     [--hosted ITEM=REMOTE_ROOT]... [--root ITEM=PATH]...
                     [--handoff PATH] [--state PATH [--skip-lane WINDOW]...]
                     [LANE_WINDOW...] [-- OVERSEER_FLAGS...]
       oversee-watch --repeat SECS --state PATH [any option above]...

Blocks until the fleet needs the overseer, then prints every event it found
as one block, each line prefixed with its kind, and exits once. Re-run after
handling every line with the live fleet in scope.

Two passes run on one clock. The mail pass reads every lane mailbox, the
overseer mailbox and the lane records every ORCH_WATCH_MAIL_INTERVAL seconds
and prints what it finds as it finds it: lane-question, lane-notice,
directive-read, directive-unread, peer-note and owner-note. The long pass
reads everything else every --interval seconds, counted from the start of one
long pass to the start of the next and kept across runs in the state
directory, so a run that ends on mail news does not bring the next long pass
forward. A long pass runs apart from the mail pass: one that overruns its
interval holds up no mail pass, the next one starts only once it has ended,
and its lines are printed together when it ends. A run with news starts no
further long pass past one already due on the turn the news came, and exits
once none is in flight. A block holding only mail news carries no pr-watch
context. The heartbeat reads the mail once more when a long pass ended after
the last mail pass.

The long pass's events, checked and reported in this order:
  EVENT overseer-dead <pane> window=<window> passes=<N> succession=<on|off>
                             the OVERSEER's own pane — the $TMUX_PANE this
                             watch was started from — read `exited` by the
                             shared judge on N consecutive passes. Nothing
                             else notices an overseer that ended: its lanes
                             keep working, this watch keeps printing to a log
                             nobody reads, and the fleet runs unattended. The
                             line also goes to the fleet log and to the
                             overseer mailbox, where the successor reads it as
                             an owner-note. Unless ORCH_OVERSEER_SUCCESSION is
                             `off`, the watch then launches that successor
                             into the dead pane's window slot through
                             `oversee-succeed --dead-pane`, with the launch
                             line the fleet state recorded, and stops: the
                             successor runs a watch of its own
  EVENT overseer-walled <pane> window=<window> passes=<N> succession=<on|off>
                             the same pane read `walled` by the same judge on
                             N consecutive passes AND its own account judged
                             at or below its trigger: the harness is still
                             running and its ACCOUNT is spent. Such a session
                             takes no turn, so it answers no lane, reads no
                             mail and cannot hand itself over — a fleet as
                             unattended as a death leaves, reached by the
                             other road. The account judgement is
                             `oversee-succeed --check-marks`, the same one
                             overseer-mark rests on, and it is required
                             because THIS pane carries the limit banners this
                             watch relays about other lanes: a wall the
                             account refutes is one of those, and the pane is
                             left alone under overseer-wall-unconfirmed. The
                             banner's own window follows the line, as it does
                             for a lane's usage-limit. The line goes to the
                             same two channels. The successor is launched
                             through `oversee-succeed --walled-pane`, which
                             picks its account afresh and never reopens on the
                             spent one; the line it built is on the watch's
                             stderr under the event. Where no account
                             qualifies, one `overseer-recovery-blocked` notice
                             naming the account and when its binding bucket
                             frees up goes to both channels and the repeat
                             stops
  EVENT overseer-mark <pane> kind=<context|headroom|rate|qualifying> value=<N> mark=<N>
                             succession=<on|off>
                             the OVERSEER's own context use or account headroom
                             reached its own mark, judged by
                             `oversee-succeed --check-marks` so the rule is
                             stated once. It reaches an overseer BETWEEN turn
                             ends, where its own turn-end hook cannot: the hook
                             refuses at the same marks, and a session part way
                             through a long turn meets neither until this line.
                             The route follows on the next line. Emitted once
                             at the crossing and again every
                             ORCH_OVERSEER_MARK_REPEAT passes while it stands;
                             a reading that could not be taken leaves the
                             standing mark where it was and says so on stderr
  EVENT pr-watch rc=N        new review-gate attention; reducer output follows
  EVENT merged <PR> <branch> <repo>
                             an --item PR merged at or after --since, in any
                             --repo
  EVENT triage <item>        an item created at or after --since that is absent
                             from the first repository's persisted baseline
  EVENT lane-ready <item>    a lane open-terminal handed to a background job
                             while its host prepared it is launched: its
                             record reads running, and the watch carries it
  EVENT lane-prepare-failed <item> reason=<reason> log=<path>
                             that job failed and closed its window: reason
                             wait-failed is the host's preparation,
                             launch-failed a launch step, each named in the
                             job's log. The record reads stopped, which
                             lane-close closes
  EVENT lane-prepare-stuck <item> age=<secs>s log=<path>
                             that record has read preparing for longer than
                             ORCH_WATCH_PREPARE_SECS with no outcome written;
                             lane-close closes it.
                             These three are read from --state records and
                             reported once per preparation
  EVENT window-gone <lane>   the tmux window no longer exists. Nothing follows
                             the line: the remedy is one relaunch, which
                             reads the item's worktree and PR, not a screen
  EVENT lane-exited <lane>   `pgrep -P` reports no child under a bare shell on
                             two passes; the lane's closing lines follow. An
                             unusable probe is not an answer and keeps the
                             lane watched
  EVENT lane-closed <item>   under a lane-exited whose window watches a --hosted
                             item already reported merged, once the pass finds
                             its worktree gone: `lane-close` succeeded;
                             the provider's output follows, then `kept=none`
                             when that output has no `kept=` line because the
                             close archived nothing. A lane exiting while its
                             worktree stands is not closed
  EVENT lane-close-refused <item>
                             the same close exited 3: its clone or worktree
                             has user-owned changes. Generated whole-file render
                             drift is archived and cleaned instead of refused.
                             `path=PATH` follows, taken from the
                             provider's `close-refused path=PATH` line, or
                             `path=unknown` without one; the sandbox stays.
                             Never retried, never --force
  EVENT handoff <item>       the --item's workflow state carries a `.handoff`
                             record with no `.resumed_at`; the record follows.
                             Emitted once per record, on every surface: it
                             reads the item's state, never a pane.
  EVENT usage-limit <lane> [<config-dir>] [resets=<utc>]
                             a live harness with no turn in flight shows a
                             limit banner below the last user turn on its screen.
                             The block that follows is a window AROUND that
                             banner, a few lines above it and the rest of the
                             cap below, so the banner is always in the block
                             and the sentence marking a quoted wall travels
                             with it.
                             `resets=` carries the reset time the banner
                             states; the wall is still standing. It is absent
                             when the banner states no reset in a shape the
                             harnesses draw OR names a time zone this host
                             cannot resolve. A clause naming a clock and no
                             day is pinned to the first occurrence after the
                             pass this watch first saw the banner on
  EVENT usage-limit-passed <lane> [<config-dir>] resets=<utc>
                             the same banner, naming a reset that has gone by:
                             the screen is remembering a spent window that has
                             reopened. Bump the lane, never park it. A clause
                             naming only a clock or a weekday reaches this only
                             once this watch has seen that wall standing; one
                             naming a date is spent on sight
  EVENT lane-asking <lane>   a question or selection prompt differs from the
                             last one emitted for this lane; the dialog follows
  EVENT model-capacity <lane>
                             a Codex turn ended because its selected model is
                             at capacity. Nothing follows the line: the
                             remedy is one continuation line back to the lane
  EVENT idle-after-return <lane>
                             the live harness sits idle on two passes; the
                             lane's closing lines follow
  EVENT account <alias> config_dir=<dir> harness=<harness> through=<local|host>
                status=<status> verdict=<room|walled|unmeasured> headroom_pct=<N|->
                binding_bucket=<bucket|-> binding_resets_at=<utc|->
                change=<status|headroom|reset>[,...] was=<status>/<verdict>
                             an account the fleet can launch on changed since
                             the last pass that read it, as `lanes list --json`
                             reads it once per pass: its status word changed,
                             its verdict against ORCH_LANE_MAX_PCT crossed in
                             either direction, or the binding bucket reset the
                             last reading named has passed and the reading has
                             moved off it. `change=` names every one that
                             applies and `was=` the status and verdict before
                             it. `config_dir` names the credentials, since
                             two accounts can share an alias. The first
                             reading of an account is its baseline and an
                             unchanged account says nothing
  EVENT heartbeat            --max-loops long passes with no event; every
                             --repo's open PRs follow, each line prefixed with
                             its repo, then `account-roster accounts=<N>` and
                             one `account <alias> config_dir=...` line per
                             account, the fields the account event carries up
                             to `change=`, from the last long pass's reading.
                             `account-roster unread` replaces them when that
                             reading failed

The mail pass's events, in this order, lane by lane and the overseer's own
mailbox last:
  EVENT lane-question <item> <id>
                             the --item's lane appended an ask to its lane
                             mailbox; its text follows. Answer it with
                             `lane-mail send --re <id>`. Read from the
                             mailbox, never a pane, so it runs on every
                             surface, inside tmux or not
  EVENT lane-notice <item> <id>
                             the same, for a notice the lane wants read but
                             is not waiting on; its text follows
  EVENT directive-read <item> <id>
                             the lane's to-lane.cursor has passed a directive
                             sent to it: the lane has read it. The cursor is
                             the receipt, whichever of the lane's read paths
                             moved it. A lane first watched is taken as
                             having read up to its cursor, reported for
                             nothing already read
  EVENT directive-unread <item> <id> age=<seconds>
                             a directive the cursor has not passed is older
                             than ORCH_DIRECTIVE_UNREAD_SECS; reported once,
                             on the first mail pass past that age, and again
                             as directive-read once the lane reads it
  EVENT peer-note <repo> <id> kind=<kind> [re=<ask id>]
                             a note, ask or answer another repository's
                             overseer sent to this one with `lane-mail peer`.
                             kind is ask, answer or directive, and only an ask
                             is owed a reply; `re=` names the ask of this
                             overseer's that an answer replies to
  EVENT owner-note <id>      a note in the overseer's own mailbox, sent with
                             `lane-mail send --item overseer --directive`;
                             its text follows. Read with or without --item.
                             Every text and `options:` line of these kinds
                             is indented two spaces, so a message line never
                             begins with EVENT
The overseer mailbox is read through its own to-lane.cursor, `lane-mail inbox
--item overseer`, which a session start reads first: a note any reader has
taken is not reported again, whatever state directory, --since or checkout
this watch runs with. While the long pass reads the overseer pane dead or
walled, no mailbox is read, so a successor finds what was sent in the
meantime.

Every pane payload above is the lines that event's handling reads and no
more, always taken from below the lane's last user turn and capped by
ORCH_WATCH_TAIL_LINES. A dialog and a closing report are drawn at the bottom
of a pane, so those keep the LAST lines of the slice and a longer slice
loses its top ones; nothing in the event recovers them, and only a larger
ORCH_WATCH_TAIL_LINES carries more. A usage-limit block is the exception: it
is a window around the banner rather than either end of the slice, so the one
line its handling needs is never the line the cap drops, and it arrives with
the lines on BOTH sides that say whose words they are.

Only lane-exited drops the prompt noise a removed worktree repeats
(`^Hook failed:` and `^bash: cd: ...: No such file or directory`), which
would otherwise be the whole payload of a lane that deleted its own tree; the
shell drawing those has the terminal back only once the harness is gone, so
no other kind can carry them. A slice that is nothing but that noise prints
`payload-noise-only lines=N` in place of the block, so silence and
suppression read apart. No other payload is filtered.

The latest pr-watch attention lines close the block when any exist and the
pr-watch event did not open it. Triage
reads the live tracker list and rebuilds only acknowledged triage keys in the
first repository's OVERSEE_WATCH_STATE_DIR baseline from kept or canceled
verdicts. Lane prompts use pane and turn.

A line already delivered is not delivered again by a re-run: overseer-dead,
overseer-walled, merged, lane-asking, usage-limit, model-capacity,
lane-exited, idle-after-return, handoff and account are keyed in that
baseline; lane-question, lane-notice, directive-read and directive-unread in
the mail pass's own file beside it; owner-note and peer-note by the overseer
mailbox's cursor. Each repeats only when what it reports changes: another PR, a
different wall or a reset gone by, a replacement pane, a different screen, a
new record, another account state. An unchanged standing overseer-mark is the one keyed line that
comes back on a timer: it is reported every ORCH_OVERSEER_MARK_REPEAT passes
while it stands, so a repeat there is the interval and never a new crossing.
A suppressed line still holds: a walled lane
stays walled, an overseer past its mark is still past it, and the
pass runs on to the remaining checks and the heartbeat. A lane mailbox read
that comes back shorter than the lines already drained from it, an empty one
included, is a read that missed lines rather than a replacement, and moves no
position: only a mailbox opening with another envelope, or one whose first
line carries no id and that holds fewer lines, is read whole again.

Options:
  --interval SECS     seconds from the start of one long pass to the start of
                      the next (default 240)
  --max-loops N       long passes before a heartbeat (default 25)
  --since ISO8601     UTC created/merged-at floor, with a Z suffix. Pass the
                      fleet's fixed start time on every run, never "now" — the
                      value names the state file, so a run given a different
                      one starts from no sightings and parks every walled lane
                      afresh; LINEAR_TEAM below arms the triage check
  --item ISSUE_ID     live item; repeatable. No values skips merged and
                      handoff with a note
  --repo OWNER/REPO   repository; repeatable and case-normalized. Every
                      check reads all of them; triage and lane rows persist
                      in the first one's baseline, mail rows in the file
                      beside it
  --hosted ITEM=REMOTE_ROOT
                      the item's lane lives on another host; its mailbox is
                      read through `lane-host` against REMOTE_ROOT rather
                      than this disk. Repeatable, once per item. An item with
                      no --hosted entry is read from `worktree path ITEM`,
                      and the project root when that reports none. The
                      clone root is learned from REMOTE_ROOT/.git and kept:
                      the item's workflow state is read from the clone, and
                      so is its mailbox once the worktree is gone. A window
                      watches the item it is named for, and gh-N watches
                      issue-N, as open-terminal names a GitHub item's lane.
                      A run carrying any hosted lane, from this option or a
                      state record with a host, while `lane-host resolve`
                      answers local is refused as hosted-without-host rather
                      than read on this disk
  --root ITEM=PATH    the item's lane worktree on this disk, where its
                      mailbox is read; a lane whose worktree sits outside
                      this checkout (a proposal sweep launched from a source
                      repository) is read nowhere else. Repeatable, once per
                      item; a --hosted entry for the same item wins
  --handoff PATH      the overseer handoff file a successor's brief names,
                      passed through to `oversee-succeed` when this watch
                      records the overseer's launch line (default
                      tmp/handoffs/OVERSEER-HANDOFF.md)
  LANE_WINDOW...      tmux window names to watch; requires $TMUX. A bare name
                      is a window in the session this watch started in, which
                      it resolves once through $TMUX_PANE and names on
                      stderr as session-resolved, so a pane that later dies
                      moves no lane into another session; `session:window`,
                      tmux's own target form, names one in another session.
                      A bare name with no session resolved is refused as
                      session-unresolved naming the lane and the --state file
  -- OVERSEER_FLAGS...
                      the flags the OVERSEER itself runs under — its
                      permission flags, plus its current model and effort
                      flags, regardless of ORCH_OVERSEER_PREFERENCE. These are
                      the same words `oversee-succeed -- ...` takes. This
                      watch replaces the fleet state's overseer.launch_line
                      once at startup, because a
                      dead pane can no longer be asked what it was launched
                      with. A watch started without them records a line with
                      no permission flags, and the successor it relaunches
                      stops at the first prompt nobody is there to answer
  --repeat SECS       the watch for a session: run one watch per pass with
                      the other options, sleep SECS after it exits with any
                      status, and run the next. A successor launch, a
                      notice-only recovery or an exhausted retry stops the
                      repeat command with status 0. Requires --state. A
                      window that tmux does not list is carried until a pass
                      exits 0 having reported window-gone with one stderr
                      note; later passes name it --skip-lane until tmux lists
                      it again.
                      The repeat loop records itself beside the --state
                      file: its own pid, whatever launched it, the state
                      path, the pane it serves, its origin, its script and
                      directory in oversee-watch.pid, and its arguments
                      before -- in oversee-watch.argv. That record is the
                      watch's claim, which the start refusals below and a
                      succession's handover read; how an overseer launches,
                      finds and stops its watch is
                      references/watch-delivery.md's. However it is sent,
                      TERM on the loop ends it and the pass it is running,
                      and the record goes with it. A start on a
                      state whose recorded watch still runs is refused as
                      watch-running naming that pid, except where that watch
                      is the one `oversee-succeed` restarted for this same
                      pane after a self-succession, or serves a pane tmux no
                      longer lists: that watch is stopped and replaced, under
                      a watch-taken-over note. Every start but a succession's
                      then prints, under a watch-replayed note, and removes
                      oversee-watch.log and oversee-watch.err beside the
                      state: what a restarted watch printed where no session
                      read it, and what the restart itself said. A watch a
                      succession started writes those two files, so it never
                      prints or removes them
  --state PATH        the oversee workflow-state file open-terminal records
                      every lane in (`workflow-state path oversee`), re-read
                      before every loop of the run and, in repeat mode,
                      before every pass as well. Repeat mode's automatic
                      close uses the directory containing this file. Each
                      `lanes[]` entry whose status is `running` is one
                      --item, its `window` one LANE_WINDOW when set, and its
                      `mail_root` one --hosted entry when `host` is set and
                      one --root entry otherwise, all added to any given on
                      the command line, the state's entry winning where both
                      name one item or window, so a lane launched, relaunched
                      or closed while the run loops joins or leaves it with
                      no restart.
                      The set is noted on stderr as fleet-read whenever a
                      read changes what the reader last carried, with the
                      count of records whose status is not running, so a
                      state that parses to no running lane is named rather
                      than watched in silence: a standalone run names the
                      fleet its own first read found, repeat mode names the
                      fleet it launches each pass with, and a pass names a
                      change one of its own loops found
  --skip-lane WINDOW  a lane window this run does not watch, whatever the
                      state says; its item stays watched. Repeat mode names
                      each window a pass already reported gone, so the record
                      that still carries it is not reported again every loop,
                      and hands every pass the windows given here besides.
                      Repeatable; requires --state

Exit codes:
  0  at least one EVENT line was printed
  3  overseer-dead or overseer-walled was reported and a successor took that
     overseer's
     window. This watch is done: the successor runs its own. Repeat mode
     stops on it and exits 0
  2  usage or global failure, including overseer-command publication, or a
     lane-local mailbox, clone or workflow-state read failed. A lane-local
     failure is reported and the pass reads the remaining lanes before it
     exits. An unchanged lane-local failure, a provider-reported stopped state
     among them, stays quiet after its first report until a successful read or
     a different failure; the pass still exits 2. A
     state write can fail after its event was printed. Pr-watch commits
     repository baselines in order, so earlier repository baselines may
     already have advanced when a later rename fails. Only baselines that did
     not advance repeat their events
Repeat mode prints each pass's output and ignores its exit code. It exits 2
only on a usage error, a state file it cannot read or parse, an argument a
pass would refuse (an item, a --hosted entry, a repeated --repo, a lane
outside tmux or outside any resolved session, a hosted lane with no host), a
tmux window list that fails, a watch already running on its state, a record
it cannot write, or a repeat delay it cannot sleep. TERM ends it at 143,
stopping the pass it was running; TERM is the stop signal on every start. A
watch started as a background job, the one a succession restarts among them,
ignores INT from its start, and no trap can take that back.

Which mode fits the overseer's harness:
  repeat       a harness that delivers a detached log's lines as they are
               written or holds a blocking follow of it inside the turn.
               The watch runs detached and outlives the session, so it
               reports overseer-dead
  single pass  a harness whose only wake is a background command's exit:
               each pass runs as that command and the next starts after
               every line is handled. Nothing reports overseer-dead
references/watch-delivery.md holds each harness's mechanism and re-arm rule.

When pr-watch.sh is installed, oversee-watch runs it with --heal on every pass.
Gate-stale dispatches PR_WATCH_WRITER_WORKFLOW, so its credential requires
actions:write. When pr-watch.sh is absent, the step is skipped with one stderr note.
Inside tmux, an --item with no LANE_WINDOW skips the pane checks with one
stderr note; outside tmux there is no pane to read and nothing is noted.

Environment:
  LINEAR_TEAM                 team the triage check reads under --since, from
                              kendex.settings.toml [env] unless the environment
                              sets it. Empty or absent skips triage, said once;
                              with a team a missing tracker CLI or
                              workflow-state exits 2 rather than dropping it
  ORCH_STATE_DIR              workflow-state directory; relative paths join
                              the project root; absolute paths stay unchanged
  ORCH_WATCH_TAIL_LINES       most lines any one event's pane payload prints,
                              a positive whole number, default 12. At the
                              default the measured Claude Code permission and
                              AskUserQuestion dialogs and the Codex trust
                              dialog arrive whole; the Codex model picker's
                              slice is 19 lines, so it keeps its bottom 12 and
                              loses the startup box above them
  ORCH_WATCH_PREPARE_SECS     seconds a lane handed to a background launch
                              job may read preparing before
                              lane-prepare-stuck goes out, a positive whole
                              number, default 1800
  OVERSEE_WATCH_PR_WATCH      path to pr-watch.sh
  OVERSEE_WATCH_TRACKER       path to the Linear CLI
  OVERSEE_WATCH_WORKFLOW_STATE path to workflow-state; with an --item a
                              missing one exits 2 rather than dropping handoff
  OVERSEE_WATCH_LANE_MAIL     path to lane-mail; a missing one exits 2 rather
                              than dropping the mail pass
  OVERSEE_WATCH_LANES         path to lanes, whose `list --json` is the
                              account reading behind the account event and the
                              heartbeat roster; a missing one exits 2. The read
                              takes the same 60 second ceiling and usage age as
                              the overseer's own mark judgement
  OVERSEE_WATCH_SUCCEED       path to oversee-succeed, which records the
                              overseer's launch line and relaunches a dead or
                              walled overseer. A missing one leaves the
                              overseer check to report and launch nothing,
                              said once
  ORCH_OVERSEER_DEAD_PASSES   consecutive passes the overseer pane must read
                              `exited` before overseer-dead goes out, and
                              `walled` before overseer-walled does (default
                              2). One pass is a poll that caught a live
                              session between its harness and its shell. The
                              walled case also needs its account judged at or
                              below ORCH_OVERSEER_HEADROOM_PCT; passes alone
                              never close a window whose harness is alive
  ORCH_OVERSEER_SUCCESSION    `off` leaves the overseer-dead and
                              overseer-walled notices and
                              launches no successor; `oversee-succeed` owns
                              every other value. An overseer-mark line still
                              goes out under it, carrying succession=off
  ORCH_OVERSEER_MARK_REPEAT   passes a standing overseer-mark waits before it
                              is reported again (default 5). The first crossing
                              is always reported; this only bounds how often a
                              mark the overseer has not yet acted on comes back.
                              The judgement itself runs every pass and reads
                              every account the fleet can launch on, under a 60
                              second ceiling where `timeout` is installed; a
                              read that passes it leaves the mark unjudged for
                              that pass, and on a host without `timeout` the
                              read runs unbounded
  PR_WATCH_WRITER_WORKFLOW    workflow dispatched by pr-watch --heal
  OVERSEE_WATCH_STATE_DIR     one baseline file per repository — reducer,
                              triage, lane-asking, usage-limit, handoff and
                              account rows — the mail pass's file beside the
                              first one, holding each lane mailbox's read
                              position and when the last long pass started,
                              plus claims/ and usage/, both shared across the
                              repositories that point here
  ORCH_WATCH_MAIL_INTERVAL    seconds from one mail pass to the next, a whole
                              number, default 20. 0 reads the mail on every
                              turn of the loop and waits out a long pass in
                              flight rather than polling it
  ORCH_DIRECTIVE_UNREAD_SECS  age in seconds past which a directive the lane
                              has not read is reported directive-unread, a
                              whole number, default 300
USAGE
}
# stderr messages start `oversee-watch: REASON field=value ...`. Backslash,
# tab, carriage return and newline in field values are escaped. Tool error
# details and the English explanation follow the stable header.
ow_message() { # REASON FIELD=VALUE...
  local reason="$1" text field
  shift
  case "$reason" in
    missing-value) text='The option requires a value.' ;;
    option-unknown) text='The option is not supported. Use --help for supported options.' ;;
    state-directory-create-failed) text='The watch state directory could not be created. Check OVERSEE_WATCH_STATE_DIR.' ;;
    state-directory-unwritable) text='The watch state directory is not writable. Check OVERSEE_WATCH_STATE_DIR.' ;;
    interval-invalid) text='The interval must be a non-negative integer.' ;;
    handoff-invalid) text='The handoff path takes letters, digits and ./_- only, as oversee-succeed reads it.' ;;
    mail-interval-invalid) text='ORCH_WATCH_MAIL_INTERVAL takes a whole number of seconds, with no leading zero.' ;;
    unread-secs-invalid) text='ORCH_DIRECTIVE_UNREAD_SECS takes a whole number of seconds, with no leading zero.' ;;
    dead-passes-invalid) text='ORCH_OVERSEER_DEAD_PASSES must be a positive integer.' ;;
    mark-repeat-invalid) text='ORCH_OVERSEER_MARK_REPEAT must be a positive integer.' ;;
    overseer-mark-unjudged) text='The overseer own-mark judgement could not be made this pass, so its context use and account headroom settle nothing here. A standing mark is not cleared by a reading that failed; oversee-succeed owns the judgement and its own keyed line says why.' ;;
    overseer-wall-unjudged) text='The overseer pane read walled and the account judgement that would confirm it could not be made, so nothing is acted on: this pane carries the limit banners this watch relays about OTHER lanes, and the screen alone cannot tell those from the overseer own account running out. The reading is left to the next pass.' ;;
    overseer-wall-unconfirmed) text='The overseer pane read walled and its own account measures room, so the banner on that screen is one this watch relayed about another lane and the overseer is working. Nothing is launched and no window is closed. The fields name the judgement that refuted it.' ;;
    overseer-unwatched) text='The overseer pane is not being watched, so an overseer that dies is reported by nothing. The field names what is missing.' ;;
    overseer-unreadable) text='The overseer pane could not be read, so its state settles nothing this pass.' ;;
    overseer-line-missing) text='The fleet state records no overseer launch line, so a dead overseer cannot be relaunched. Start the watch with -- and the overseer flags while the overseer is alive.' ;;
    overseer-unrecorded) text='The overseer pane could not be recorded in the fleet state. A relaunch reads that record, so this watch reports a death it cannot act on.' ;;
    overseer-notice-failed) text='The overseer-dead notice could not be delivered. The field names the channel; the event line still went out.' ;;
    overseer-relaunch-failed) text='oversee-succeed refused or failed the relaunch; the overseer is not replaced and this watch keeps running. Its own keyed line says why.' ;;
    overseer-recovery-blocked) text='No account in the fleet qualifies for a successor, so the recovery stops rather than retry the same accounts. The fields name the spent account and the reset its banner states; a notice carrying both went to the fleet log and the overseer mailbox.' ;;
    overseer-succeeded) text='A successor holds the dead overseer window and runs its own watch. This one stops rather than read the fleet twice.' ;;
    repeat-invalid) text='The repeat delay must be a non-negative integer.' ;;
    state-required) text='The option reads its lanes from the oversee workflow state. Add --state PATH.' ;;
    state-unreadable) text='The oversee state file could not be read. The watch stops rather than carry a partial fleet.' ;;
    state-invalid) text='The oversee state file is not workflow-state JSON with a lanes array of records naming their item. The watch stops rather than carry a partial fleet.' ;;
    window-absent) text='tmux does not list the window. Passes carry it until one reports it gone; later passes skip it until tmux lists it again.' ;;
    sleep-failed) text='The repeat delay could not be slept. Repeat mode stops rather than run passes back to back.' ;;
    fleet-read) text='The fleet this watch carries, as the last state read gave it; printed again when a re-read changes it. dropped counts records whose status is not running, which the watch does not carry.' ;;
    max-loops-invalid) text='The loop limit must be a positive integer.' ;;
    prepare-secs-invalid) text='ORCH_WATCH_PREPARE_SECS takes a positive whole number of seconds, with no leading zero.' ;;
    tail-lines-invalid) text='ORCH_WATCH_TAIL_LINES takes a positive whole number of lines, with no leading zero.' ;;
    limit-banner-missing) text='The pane was classified walled but its screen yields no limit banner to report. The classifier and the payload disagree, so the pass stops rather than send an event with nothing its handling can read. The field names the lane, or the overseer pane where the overseer is the one classified.' ;;
    tmux-missing) text='Run in the tmux session that owns these lanes, or omit the lanes.' ;;
    since-invalid) text='Use a UTC timestamp in YYYY-MM-DDTHH:MM:SSZ form.' ;;
    helper-missing) text='The required helper is not executable. Check the named setting.' ;;
    item-invalid) text='The work item is not a supported issue identifier.' ;;
    command-missing) text='The required command is not on PATH.' ;;
    auth-failed) text='No configured GitHub credential works. Run gh auth login.' ;;
    repo-unresolved) text='Specify a repository because GitHub could not resolve it.' ;;
    repo-duplicate) text='Name each repository once.' ;;
    pr-list-failed) text='The GitHub PR list command failed.' ;;
    pr-list-invalid) text='The GitHub PR list output could not be parsed.' ;;
    triage-state-failed) text='The fleet triage verdict log could not be read.' ;;
    triage-item-invalid) text='The fleet triage log contains an invalid issue identifier.' ;;
    time-failed) text='The current UTC time could not be read.' ;;
    tracker-list-failed) text='The tracker list command failed.' ;;
    tracker-list-invalid) text='The tracker list output could not be parsed.' ;;
    handoff-read-failed) text='The handoff record could not be read.' ;;
    lane-close-failed) text='lane-close failed before it completed the close. The next run reports the exit again and retries.' ;;
    hosted-invalid) text='Spell --hosted as ITEM=REMOTE_ROOT, with the item in letters, digits, dot, underscore and hyphen.' ;;
    hosted-unknown-item) text='The --hosted item is not one this run watches. Name it with --item, or drop the entry.' ;;
    root-invalid) text='Spell --root as ITEM=PATH, with the item in letters, digits, dot, underscore and hyphen.' ;;
    root-unknown-item) text='The --root item is not one this run watches. Name it with --item, or drop the entry.' ;;
    root-duplicate) text='Name each --root item once: two roots for one lane would read one mailbox and drain the other.' ;;
    hosted-duplicate) text='Name each hosted item once.' ;;
    hosted-without-host) text='A hosted lane is carried, and lane-host resolves this host to local, so its mailbox, state and close would be read on this disk where the lane is not. Set ORCH_LANE_HOST to the provider the lane was launched through, in kendex.settings.toml [env] or .env.local.' ;;
    host-resolve-failed) text='lane-host could not say which host the hosted lanes live on, so none of them is read. Its own words follow.' ;;
    session-resolved) text='The tmux session every bare lane window name is read in, resolved once while the pane that started this watch still exists.' ;;
    session-unresolved) text='A bare lane window name is carried and tmux named no session for this watch, so the name could resolve through whichever session tmux picks. Start the watch from the overseer pane, or record the window as SESSION:WINDOW.' ;;
    watch-running) text='Another watch already runs on this fleet state, and this start could not show its pane gone: tmux lists it, or this start runs outside tmux, the record names no pane, or the pane list could not be read. Two watches would read one overseer mailbox and each replay what the other drained. Handle its events, or stop it as references/watch-delivery.md states and start again; the pid field is the watch that read finds.' ;;
    watch-replay-failed) text='The output a restarted watch left beside the fleet state could not be printed or removed, so the start stops rather than lose it or print it twice. The path names the file.' ;;
    watch-record-failed) text='The watch could not write its own record beside the fleet state, so a second watch could not be refused and a succession could not restart this one.' ;;
    watch-taken-over) text='A live watch on this fleet state was stopped and this one runs in its place. The reason field says why it could be: succession is the watch oversee-succeed restarted for this pane, pane-gone one whose pane tmux no longer lists.' ;;
    watch-replayed) text='A watch oversee-succeed restarted wrote output no session read, and the restart wrote how it went. Both follow, stdout here and stderr on stderr, and are then removed, so no event it reported and no refusal it ended on is lost.' ;;
    mail-read-failed) text='The lane mailbox could not be read. Fix what lane-mail names rather than reading the lane as silent.' ;;
    mail-read-invalid) text='The lane mailbox reader did not open with its count line.' ;;
    limit-scan-failed) text='The screen could not be searched for a usage limit. The field names the lane, or the overseer pane where the overseer is the one being read.' ;;
    reset-scan-failed) text='The limit banner could not be searched for its reset clause.' ;;
    window-list-failed) text='The tmux window list could not be read.' ;;
    pane-command-failed) text='The pane command could not be read.' ;;
    pane-command-invalid) text='The pane command reply is malformed.' ;;
    pane-identity-failed) text='The pane identity could not be read.' ;;
    pane-identity-invalid) text='The pane identity reply is malformed.' ;;
    pane-capture-failed) text='The pane could not be captured.' ;;
    pane-publish-failed) text='The pane capture could not be published.' ;;
    state-write-failed) text='The watch state file could not be written. Check OVERSEE_WATCH_STATE_DIR.' ;;
    state-replace-failed) text='The watch state file could not be replaced. Check OVERSEE_WATCH_STATE_DIR.' ;;
    state-read-failed) text='The watch state file could not be read. Check OVERSEE_WATCH_STATE_DIR.' ;;
    reducer-failed) text='The PR reducer failed without per-PR output.' ;;
    triage-disabled) text='Team triage is skipped because LINEAR_TEAM is empty. Other watch checks continue.' ;;
    reducer-missing) text='The PR reducer is missing. Other watch checks continue.' ;;
    items-omitted) text='No work items were supplied. Merged and handoff checks are skipped.' ;;
    lanes-omitted) text='No lane windows were supplied. Pane checks are skipped; the named checks continue.' ;;
    child-probe-failed) text='The child-process probe could not run. Shell panes remain watched.' ;;
    account-unread) text='The account roster could not be read this pass, so no account event is judged and a heartbeat carries account-roster unread in place of the roster. The baseline stands for the next read. The field names the exit, the seconds the ceiling allowed, or parse=failed when the listing or a record in it could not be read.' ;;
    account-reset-unparsed) text='The binding_resets_at the baseline held could not be parsed into a time, so whether that bucket reset settles nothing, and the baseline has already moved to the new reading: that reset is not reported. Status and headroom changes on the account are still judged.' ;;
    claim-missing) text='The pane has no live lane claim. The usage event names no account.' ;;
    reducer-baseline) text='The initial PR attention is the baseline. Only new attention produces events.' ;;
    state-target-invalid) text='The watch state target is not a regular file.' ;;
    long-pass-unfinished) text='The long pass exited 0 without writing its status, so whether it found news is unknown.' ;;
    *) printf 'oversee-watch: message-invalid reason=%s\n' "$reason" >&2; return 2 ;;
  esac
  printf 'oversee-watch: %s' "$reason"
  for field in "$@"; do
    field="${field//\\/\\\\}"
    field="${field//$'\t'/\\t}"
    field="${field//$'\r'/\\r}"
    field="${field//$'\n'/\\n}"
    printf ' %s' "$field"
  done
  printf '\n%s\n' "$text"
}
die() { # REASON TOOL_DETAIL FIELD=VALUE...
  local reason="$1" detail="$2"
  shift 2
  ow_message "$reason" "$@" >&2
  [[ -z "$detail" ]] || printf '%s\n' "$detail" >&2
  exit 2
}

# A provider or mailbox failure belongs to one lane. Keep its result outside
# `die`, because ending the process here would drop every mailbox after it.
# The caller reports the failure against the state snapshot it owns, then
# commits only the rows belonging to reads that completed.
lane_failure_set() { # REASON TOOL_DETAIL FIELD=VALUE...
  LANE_FAILURE_REASON="$1"
  LANE_FAILURE_DETAIL="$2"
  shift 2
  LANE_FAILURE_FIELDS=("$@")
}

lane_failure_report() { # ITEM STATE
  local item="$1" state="$2" key stopped_state="" prior="" line token saw_kind saw_item
  local -a tokens=()
  PASS_FAILED=1
  PASS_FAILED_ITEMS+="$item"$'\n'
  # A failure is reported once, as lane-exited is: a standing one stays quiet
  # after its first report, and a different one, or a read that succeeded and
  # cleared the row, is news again. The key is the stopped state a hosted
  # provider names in its own keyed line, whose other words change from read
  # to read, and the reason with its fields otherwise.
  while IFS= read -r line; do
    saw_kind=0; saw_item=0; stopped_state=""
    tokens=()
    read -ra tokens <<<"$line"
    for token in ${tokens[@]+"${tokens[@]}"}; do
      [[ "$token" == lane-stopped ]] && saw_kind=1
      [[ "$token" == "item=$item" ]] && saw_item=1
      case "$token" in state=*) stopped_state="${token#state=}" ;; esac
    done
    [[ "$saw_kind" -eq 1 && "$saw_item" -eq 1 && "$stopped_state" =~ ^[A-Za-z0-9._-]+$ ]] \
      && break
    stopped_state=""
  done <<<"$LANE_FAILURE_DETAIL"
  if [[ -n "$stopped_state" ]]; then
    key="stopped $stopped_state"
  else
    key="$LANE_FAILURE_REASON ${LANE_FAILURE_FIELDS[*]+"${LANE_FAILURE_FIELDS[*]}"}"
  fi
  # A row value is one line with no tab in it.
  key="${key//$'\t'/ }"
  key="${key//$'\n'/ }"
  if ! prior="$(lane_row_get lane-failed "$state" "$item")"; then
    die state-read-failed "" "item=$item" "row=lane-failed"
  fi
  state="$(lane_row_set lane-failed "$state" "$item" "$key")"
  if [[ "$prior" != "$key" ]]; then
    ow_message "$LANE_FAILURE_REASON" ${LANE_FAILURE_FIELDS[@]+"${LANE_FAILURE_FIELDS[@]}"} >&2
    [[ -z "$LANE_FAILURE_DETAIL" ]] || printf '%s\n' "$LANE_FAILURE_DETAIL" >&2
  fi
  LANE_FAILURE_STATE="$state"
}
need_val() { [[ $# -ge 2 && -n "${2:-}" ]] || die missing-value "" "option=$1"; }

# The one parser. It answers a help request and a bad option itself, so the dry
# run below decides those before any configuration is read, off these arms and
# no second copy of the option arities.
parse_argv() {
  # Every default this parser owns is set HERE, never above the loader: the
  # settings [env] table assigns any name and .env.local is sourced as shell, so
  # a default above the load is whatever the checkout left there for every
  # option the caller did not pass. Settings reach the script through their own
  # OVERSEE_WATCH_* names, resolved after the load.
  # REPOS, ITEMS and LANES are the sharpest case: the loop APPENDS to them.
  INTERVAL=240
  MAX_LOOPS=25
  SINCE=""
  REPOS=()
  ITEMS=()
  LANES=()
  HOSTED=()
  ROOTS=()
  SKIP_LANES=()
  REPEAT=""
  STATE_FILE=""
  HANDOFF=tmp/handoffs/OVERSEER-HANDOFF.md
  OVERSEER_FLAGS=()
  # How many leading words are this watch's own, before the `--` that starts
  # the overseer's flags: what the watch records of its command, and what a
  # restart from a successor pane runs again with the successor's flags.
  ARGV_BASE_COUNT=$#
  local total=$#

  while [[ $# -gt 0 ]]; do
    case "$1" in
      # Everything after it is the overseer's own launch flags, never a lane
      # window: the words are the harness's and this parser reads none of them.
      --) ARGV_BASE_COUNT=$((total - $#)); shift; OVERSEER_FLAGS=("$@"); break ;;
      --handoff) need_val "$@"; HANDOFF="$2"; shift 2 ;;
      --handoff=*) HANDOFF="${1#--handoff=}"; need_val --handoff "$HANDOFF"; shift ;;
      --repeat) need_val "$@"; REPEAT="$2"; shift 2 ;;
      --repeat=*) REPEAT="${1#--repeat=}"; need_val --repeat "$REPEAT"; shift ;;
      --state) need_val "$@"; STATE_FILE="$2"; shift 2 ;;
      --state=*) STATE_FILE="${1#--state=}"; need_val --state "$STATE_FILE"; shift ;;
      --hosted) need_val "$@"; HOSTED+=("$2"); shift 2 ;;
      --hosted=*) need_val --hosted "${1#--hosted=}"; HOSTED+=("${1#--hosted=}"); shift ;;
      --root) need_val "$@"; ROOTS+=("$2"); shift 2 ;;
      --root=*) need_val --root "${1#--root=}"; ROOTS+=("${1#--root=}"); shift ;;
      --skip-lane) need_val "$@"; SKIP_LANES+=("$2"); shift 2 ;;
      --skip-lane=*) need_val --skip-lane "${1#--skip-lane=}"; SKIP_LANES+=("${1#--skip-lane=}"); shift ;;
      --interval) need_val "$@"; INTERVAL="$2"; shift 2 ;;
      --interval=*) INTERVAL="${1#--interval=}"; need_val --interval "$INTERVAL"; shift ;;
      --max-loops) need_val "$@"; MAX_LOOPS="$2"; shift 2 ;;
      --max-loops=*) MAX_LOOPS="${1#--max-loops=}"; need_val --max-loops "$MAX_LOOPS"; shift ;;
      --since) need_val "$@"; SINCE="$2"; shift 2 ;;
      --since=*) SINCE="${1#--since=}"; need_val --since "$SINCE"; shift ;;
      --item) need_val "$@"; ITEMS+=("$2"); shift 2 ;;
      --item=*) need_val --item "${1#--item=}"; ITEMS+=("${1#--item=}"); shift ;;
      --repo) need_val "$@"; REPOS+=("$2"); shift 2 ;;
      --repo=*) need_val --repo "${1#--repo=}"; REPOS+=("${1#--repo=}"); shift ;;
      # The bare word too: `help` is an answered form on the sibling orch CLIs,
      # and here it would otherwise be read as a lane window name.
      --help | -h | help) usage; exit 0 ;;
      -*) ow_message option-unknown "option=$1" >&2; usage >&2; exit 2 ;;
      *) LANES+=("$1"); shift ;;
    esac
  done
}

# `.env.local` is sourced as shell, so help is answered before the loader runs:
# the dry run is the real parser in a subshell, so nothing it assigns survives
# to be clobbered, and 9 is the only status meaning it reached the end.
parse_rc=0
( parse_argv "$@"; exit 9 ) || parse_rc=$?
[[ "$parse_rc" -eq 9 ]] || exit "$parse_rc"
unset parse_rc

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export PROJECT_ROOT
SKILLS_DIR="$PROJECT_ROOT/.agents/skills"
export SKILLS_DIR
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$PROJECT_ROOT"
# shellcheck source=lib/gh-auth.sh
source "$SCRIPT_DIR/lib/gh-auth.sh"
# shellcheck source=lib/gh-repo.sh
source "$SCRIPT_DIR/lib/gh-repo.sh"
# shellcheck source=lib/date-ladder.sh
source "$SCRIPT_DIR/lib/date-ladder.sh"
# shellcheck source=lib/usage-reset.sh
source "$SCRIPT_DIR/lib/usage-reset.sh"
# shellcheck source=lib/lane-claims.sh
source "$SCRIPT_DIR/lib/lane-claims.sh"
# shellcheck source=lib/pr-watch-pass.sh
source "$SCRIPT_DIR/lib/pr-watch-pass.sh"
# shellcheck source=lib/lane-state.sh
source "$SCRIPT_DIR/lib/lane-state.sh"
# shellcheck source=lib/lane-context.sh
source "$SCRIPT_DIR/lib/lane-context.sh"
# shellcheck source=lib/lane-gitfile.sh
source "$SCRIPT_DIR/lib/lane-gitfile.sh"
# shellcheck source=lib/watch-pid.sh
source "$SCRIPT_DIR/lib/watch-pid.sh"
PR_WATCH="${OVERSEE_WATCH_PR_WATCH:-$SKILLS_DIR/review-gate/scripts/pr-watch.sh}"
TRACKER="${OVERSEE_WATCH_TRACKER:-$SKILLS_DIR/linear/scripts/linear.sh}"
WORKFLOW_STATE="${OVERSEE_WATCH_WORKFLOW_STATE:-$SCRIPT_DIR/workflow-state}"
LANE_MAIL="${OVERSEE_WATCH_LANE_MAIL:-$SCRIPT_DIR/lane-mail}"
LANE_CLOSE="${OVERSEE_WATCH_LANE_CLOSE:-$SCRIPT_DIR/lane-close}"
SUCCEED="${OVERSEE_WATCH_SUCCEED:-$SCRIPT_DIR/oversee-succeed}"
LANES_CLI="${OVERSEE_WATCH_LANES:-$SCRIPT_DIR/lanes}"
# Consecutive `exited` readings of the overseer pane before the death is news.
# One is a poll that caught a live session between its harness and its shell,
# the same reason the lane-exited check debounces.
DEAD_PASSES="${ORCH_OVERSEER_DEAD_PASSES:-2}"
# Passes a standing overseer-mark waits before it is reported again. A mark the
# overseer has not acted on stands for every pass until it hands over, and a
# line on each of them would bury every other event in the block; one that never
# came back would let the mark ride out the fleet after a single reading.
MARK_REPEAT="${ORCH_OVERSEER_MARK_REPEAT:-5}"
# Seconds each account read of a pass is given: the overseer's own mark
# judgement and the account roster. Each reads every account the fleet can
# launch on, which waits on a credentials lock and a usage endpoint per
# account, and on a cache miss on the host-wide usage refresh lock (up to 10
# seconds) and, after a 429 with nothing cached, one sleep of up to 5 seconds
# and one more usage request, and a pass that spent its whole interval there
# would delay every other event it carries. The ceiling is per read, so a pass
# can spend it once for each reader. A read the ceiling abandons leaves its
# answer unjudged, which is the answer a failed read already gives.
READ_CEILING=60
STATE_DIR_SETTING="${ORCH_STATE_DIR:-tmp}"
WORKFLOW_STATE_DIR="$STATE_DIR_SETTING"
case "$WORKFLOW_STATE_DIR" in
  /*) ;;
  *) WORKFLOW_STATE_DIR="$PROJECT_ROOT/$WORKFLOW_STATE_DIR" ;;
esac
WORKFLOW_STATE_ARGS=(--state-dir "$WORKFLOW_STATE_DIR")
FLEET_STATE_DIR="${OVERSEE_WATCH_FLEET_STATE_DIR:-$WORKFLOW_STATE_DIR}"
PW_STATE_DIR="${OVERSEE_WATCH_STATE_DIR:-$PROJECT_ROOT/tmp/oversee-watch}"
# Two state files per fleet: the first repository's baseline, which the long
# pass writes, and the mail pass's file beside it, which only the mail pass and
# the scheduler around it write. The long pass runs while mail passes go on,
# so one file each is what keeps either from committing a copy of the other's
# rows it took before the other advanced them. The overseer mailbox has no
# position here at all: its own to-lane.cursor is the one every reader
# advances, a session start included.
# Triage keys, lane-asking fingerprints and usage-limit sightings are rows in
# the first repository's file, never a file of their own. The live pane
# capture remains authoritative.
# Per-lane rows in the first repository's baseline, beside the reducer's
# `<pr>\t<kind>` and triage's `triage\t<id>`:
#   lane-asking<TAB><lane><TAB><fingerprint>
#   usage-limit<TAB><lane><TAB><first-seen-epoch>|<pane key>|<reported event>|<reset key>
#   model-capacity<TAB><lane><TAB><pane key>|<turn identity>|model-capacity
#   lane-exited<TAB><lane><TAB><pane key>[|reported]
#   lane-idle<TAB><lane><TAB><pane key>|<screen key>[|reported]
#   handoff<TAB><item><TAB><record checksum>
#   lane-prepare<TAB><item><TAB><preparation start epoch>|<ready|failed|stuck>
#   lane-failed<TAB><item><TAB><the last lane-local failure the long pass reported>
#   merged<TAB><item><TAB><repo>#<number>[ <repo>#<number>...]
#   account<TAB><harness>|<through>|<config dir><TAB><status>|<verdict>|<binding_resets_at or ->
# And in the mail pass's file:
#   lane-mail<TAB><item>[@clone]<TAB><to-overseer.jsonl lines already drained> <first id>
#   directive<TAB><item>[@clone]<TAB><to-lane.cursor reported read> <last line reported unread> <first id>
#   clone-root<TAB><item><TAB><the hosted lane's clone, on its own host>
#   lane-failed<TAB><item><TAB><the last lane-local failure the mail pass reported>
#   long-pass<TAB>fleet<TAB><the epoch the last long pass started at>
# Three rows are keyed by the overseer's own pane rather than by a lane, and
# are pruned on every pass so a pane that stops being the overseer's leaves
# nothing behind:
#   overseer-mark<TAB><server> <pane><TAB><kind>|<passes since it was reported>
#   overseer-dead<TAB><server> <pane><TAB><count>|pending:<N>|reported
#   overseer-walled<TAB><server> <pane><TAB><count>|pending:<N>|reported
# The last two are one machinery under two names, one per case the overseer's
# own pane can be recovered from: `exited` is the harness gone and `walled` is
# the account spent under a harness still running. Separate rows rather than
# one carrying its case, so a pane that flips between the two starts its count
# over instead of counting a wall's passes towards a death's threshold.
# The usage-limit value is split apart where the event is emitted, some 200
# lines below where it is written; the reset key's own layout is
# usage_reset_key's, and it comes LAST because it carries `|` of its own.
# The reported columns are what keeps a re-run from delivering a line again:
# a lane parked on its wall, sitting idle, left at a bare shell, or an item
# merged and still in --item read the same on every pass of every run, and the
# overseer re-runs the watch after every event.
# Each helper takes the whole baseline blob and returns the answer or the
# rewritten blob, so a pass mutates a local and commits once.
# One per-lane row per KIND in the watch state, all laid out above:
# `lane-asking` holds the prompt fingerprint a lane was last reported on,
# `usage-limit` the pass clock this watch first saw a lane's limit banner on,
# the pane it saw it in, and the wall it named; `lane-exited` and `lane-idle`
# the pane a lane read as exited or idle on the previous pass, the first half
# of the two consecutive passes those kinds need, marked once reported. Rows,
# not process globals: a pass that found any event exits the process, so with a
# lane parked on its banner every pass is a first pass, and a debounce kept in
# memory never reaches its second. Same three columns, same file, one set of readers.
lane_row_get() {
  awk -F'\t' -v kind="$1" -v lane="$3" '$1 == kind && NF == 3 && $2 == lane { print $3 }' <<<"$2"
}

lane_row_clear() {
  awk -F'\t' -v kind="$1" -v lane="$3" 'NF && !($1 == kind && NF == 3 && $2 == lane)' <<<"$2"
}

lane_row_set() {
  local rest
  rest="$(lane_row_clear "$1" "$2" "$3")"
  [[ -z "$rest" ]] || printf '%s\n' "$rest"
  printf '%s\t%s\t%s\n' "$1" "$3" "$4"
}

# The same two-phase flush triage uses, on the same file: nothing is written
# when the pass changed nothing, and the event has already printed.
lane_row_commit() {
  [[ "$1" != "${PW_SEEN[0]}" ]] || return 0
  pw_stage_state "$(pw_state_file "${REPOS[0]}")" "$1"
  pw_commit_state "$(pw_state_file "${REPOS[0]}")"
  PW_SEEN[0]="$1"
}
# The same flush, on the mail pass's file.
MAIL_SEEN=""
mail_row_commit() {
  [[ "$1" != "$MAIL_SEEN" ]] || return 0
  pw_stage_state "$MAIL_STATE_FILE" "$1"
  pw_commit_state "$MAIL_STATE_FILE"
  MAIL_SEEN="$1"
}

# The session every bare lane window name belongs to, resolved ONCE, while the
# pane that started this watch still exists: tmux resolves a target with no
# session through the calling pane, and once that pane is gone it picks a
# session of its own, so a watch outliving its launcher would read every bare
# lane in some other session and report it window-gone. A repeat pass is handed
# the wrapper's answer in OVERSEE_WATCH_SESSION and never asks tmux itself.
# Empty off tmux, or where tmux named none; check_lane_set refuses a bare name
# then, with tmux's own words in WATCH_SESSION_DETAIL.
WATCH_SESSION=""
WATCH_SESSION_DETAIL=""
watch_session_resolve() {
  local out target=()
  [[ -n "${TMUX:-}" ]] || return 0
  if [[ "$REPEAT_CHILD" -eq 1 ]]; then
    WATCH_SESSION="${OVERSEE_WATCH_SESSION:-}"
    return 0
  fi
  [[ -z "${TMUX_PANE:-}" ]] || target=(-t "$TMUX_PANE")
  if out="$(tmux display-message -p ${target[@]+"${target[@]}"} '#S' 2>&1)" && [[ -n "$out" ]]; then
    WATCH_SESSION="$out"
  else
    WATCH_SESSION_DETAIL="$out"
  fi
}

# The -t target a lane is read through: a bare name inside the resolved
# session, matched exactly, and a `session:window` name as it was given.
lane_target() { # LANE
  case "$1" in
    *:*) printf '%s\n' "$1" ;;
    *) printf '=%s:%s\n' "$WATCH_SESSION" "$1" ;;
  esac
}

# The windows of the session a lane names: `session:window` lists that
# session, a bare name the resolved one. The session is matched exactly (`=`):
# tmux otherwise falls back to a prefix match, and a lane whose session died
# would silently watch a sibling's. A session tmux destroyed with its last
# window has no windows, so it lists as none and the lane reads gone; any
# other failure is fatal.
lane_session_windows() {
  local out session="$WATCH_SESSION"
  [[ "$1" != *:* ]] || session="${1%%:*}"
  out="$(tmux list-windows -t "=$session" -F '#W' 2>&1)" && { printf '%s\n' "$out"; return 0; }
  [[ "$out" == "can't find session: "* ]] && return 0
  printf '%s\n' "$out"
  return 1
}

# The one presence answer, for a pass and for repeat mode's lane records.
lane_window_listed() { # LANE
  local existing
  existing="$(lane_session_windows "$1")" || die window-list-failed "$existing" "lane=$1"
  grep -qxF -- "${1#*:}" <<<"$existing"
}

parse_argv "$@"

[[ "$INTERVAL" =~ ^[0-9]+$ ]] || die interval-invalid "" "value=$INTERVAL"
[[ "$MAX_LOOPS" =~ ^[0-9]+$ && "$MAX_LOOPS" -ge 1 ]] || die max-loops-invalid "" "value=$MAX_LOOPS"
# The age a usage figure may be served at, named to every lane reader a pass
# runs: two of this watch's intervals. Two reads are one interval of sleep plus
# a pass's own work apart, so a window of one interval has always expired by
# the next pass and every pass would post for every account; two cover any
# pass whose work is shorter than its sleep. A larger ORCH_LANES_USAGE_MAX_AGE
# the settings already set is kept, since this variable outranks the settings
# ladder, and a value that is not a whole number is passed on for `lanes` to
# refuse rather than overwritten. `lanes` only ever widens its TTL with it and
# never widens a TTL of 0.
LANES_MAX_AGE="${ORCH_LANES_USAGE_MAX_AGE:-0}"
if [[ "$LANES_MAX_AGE" =~ ^[0-9]+$ ]] && (( 10#$LANES_MAX_AGE < 10#$INTERVAL * 2 )); then
  LANES_MAX_AGE=$((10#$INTERVAL * 2))
fi
# The same alphabet oversee-succeed refuses outside of, judged here so a repeat
# run is refused at its start rather than at the first pass that records a line.
[[ "$HANDOFF" =~ ^[A-Za-z0-9._/-]+$ ]] || die handoff-invalid "" "path=$HANDOFF"
[[ "$DEAD_PASSES" =~ ^[0-9]+$ && "$DEAD_PASSES" -ge 1 ]] \
  || die dead-passes-invalid "" "ORCH_OVERSEER_DEAD_PASSES=$DEAD_PASSES"
[[ "$MARK_REPEAT" =~ ^[1-9][0-9]*$ ]] \
  || die mark-repeat-invalid "" "ORCH_OVERSEER_MARK_REPEAT=$MARK_REPEAT"
# The ceiling on every pane payload this watch prints. The overseer handles
# each event from the lines under it, so the cap is what keeps a fleet's worth
# of events inside one overseer's context. The default holds the measured
# Claude Code dialogs and the Codex trust dialog whole; the Codex model
# picker's slice is longer and keeps its bottom 12 lines
# (tests/fixtures/oversee-watch). What the cap trims is gone from the event,
# and only a larger cap brings it back.
WATCH_TAIL_LINES="${ORCH_WATCH_TAIL_LINES:-12}"
[[ "$WATCH_TAIL_LINES" =~ ^[1-9][0-9]*$ ]] || die tail-lines-invalid "" "value=$WATCH_TAIL_LINES"
# How long a lane handed to a background launch job may read preparing before
# it is reported stuck. The host's own preparation takes minutes; the default
# leaves it several times that before a record nothing finished is named.
PREPARE_SECS="${ORCH_WATCH_PREPARE_SECS:-1800}"
[[ "$PREPARE_SECS" =~ ^[1-9][0-9]*$ ]] || die prepare-secs-invalid "" "value=$PREPARE_SECS"
# The mail pass's own cadence, apart from --interval: mail is a file read per
# lane, and the long pass's reads share the lanes' GitHub quota, so a note
# reaches the overseer within this many seconds whatever --interval costs.
MAIL_INTERVAL="${ORCH_WATCH_MAIL_INTERVAL:-20}"
[[ "$MAIL_INTERVAL" =~ ^(0|[1-9][0-9]*)$ ]] || die mail-interval-invalid "" "value=$MAIL_INTERVAL"
UNREAD_SECS="${ORCH_DIRECTIVE_UNREAD_SECS:-300}"
[[ "$UNREAD_SECS" =~ ^(0|[1-9][0-9]*)$ ]] || die unread-secs-invalid "" "value=$UNREAD_SECS"
# What argv itself gave, kept before the first state read rebuilds the four
# arrays: every merge adds the command line's own entries to the records the
# state names, so the baseline has to outlive the set a loop carries.
GIVEN_ITEMS=(${ITEMS[@]+"${ITEMS[@]}"})
GIVEN_LANES=(${LANES[@]+"${LANES[@]}"})
GIVEN_HOSTED=(${HOSTED[@]+"${HOSTED[@]}"})
GIVEN_ROOTS=(${ROOTS[@]+"${ROOTS[@]}"})
[[ ${#SKIP_LANES[@]} -eq 0 || -n "$STATE_FILE" ]] || die state-required "" "option=--skip-lane"
# A lane is read through tmux, so a run naming one outside tmux is refused, and
# so is a bare name with no session to read it in. A single run and every
# repeat pass ask it of the lanes they carry.
# The session is named once, by the process that resolved it, the first time
# a bare name is read in it: after the argument checks, so a refusal is still
# the first line a refused run prints.
SESSION_NOTED=0
check_lane_set() {
  local lane
  [[ ${#LANES[@]} -eq 0 || -n "${TMUX:-}" ]] || die tmux-missing "" "lanes=${LANES[*]}"
  for lane in ${LANES[@]+"${LANES[@]}"}; do
    [[ "$lane" != *:* ]] || continue
    [[ -n "$WATCH_SESSION" ]] \
      || die session-unresolved "$WATCH_SESSION_DETAIL" "lane=$lane" "path=${STATE_FILE:-none}"
    [[ "$SESSION_NOTED" -eq 0 && "$REPEAT_CHILD" -eq 0 ]] || continue
    ow_message session-resolved "session=$WATCH_SESSION" >&2
    SESSION_NOTED=1
  done
}
# A pass the repeat wrapper launched, which inherits that wrapper's session,
# overseer record and watch record rather than making its own.
REPEAT_CHILD=0
if [[ -n "${OVERSEE_WATCH_REPEAT_OWNER:-}" && "$OVERSEE_WATCH_REPEAT_OWNER" == "$PPID" ]]; then
  REPEAT_CHILD=1
fi
watch_session_resolve
check_lane_set

# No floor by default: the floor must not move between runs, and a run has no
# way to know when the previous one stopped looking.
SINCE_EPOCH=0
if [[ -n "$SINCE" ]]; then
  [[ "$SINCE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] \
    || die since-invalid "" "value=$SINCE"
  SINCE_EPOCH="$(to_epoch "$SINCE")" || die since-invalid "" "value=$SINCE"
fi

# One canonical spelling per repository. GitHub reads a repo path
# case-insensitively, so lowercasing each entry leaves the duplicate check, the
# owner the merged check matches on, the reducer's state-file name, the repo it
# prefixes its lines with and the GH_REPO it exports all naming one string. A
# repeat would reduce that repository twice into one state file and report it
# twice in the context, so it is a usage error, named as the caller spelled it.
# A single run and repeat mode both call it.
check_repo_set() {
  local repo_i repo_raw repos_seen=""
  [[ ${#REPOS[@]} -gt 0 ]] || return 0
  for repo_i in "${!REPOS[@]}"; do
    repo_raw="${REPOS[$repo_i]}"
    REPOS[$repo_i]="$(printf '%s' "$repo_raw" | tr '[:upper:]' '[:lower:]')"
    if grep -qxF -- "${REPOS[$repo_i]}" <<<"$repos_seen"; then
      die repo-duplicate "" "repo=$repo_raw"
    fi
    repos_seen+="${REPOS[$repo_i]}"$'\n'
  done
}

# The --item and --hosted checks, run by a single run and by every repeat pass
# on the set that pass will carry. The item's head branch is its id lowercased
# (worktree create's branch name); one branch per line, for the jq membership
# test.
check_item_set() {
  local item entry hosted_item hosted_seen=""
  ITEM_BRANCHES=""
  for item in ${ITEMS[@]+"${ITEMS[@]}"}; do
    [[ "$item" =~ ^[A-Za-z0-9._-]+$ ]] || die item-invalid "" "item=$item"
    ITEM_BRANCHES+="$(printf '%s' "$item" | tr '[:upper:]' '[:lower:]')"$'\n'
  done
  # `--hosted ITEM=REMOTE_ROOT` and `--root ITEM=PATH`, validated here so the
  # mail pass never composes a path out of a value nobody judged.
  check_root_entries hosted ${HOSTED[@]+"${HOSTED[@]}"}
  check_root_entries root ${ROOTS[@]+"${ROOTS[@]}"}
  [[ ${#HOSTED[@]} -eq 0 ]] || check_lane_host
}
# A hosted lane is read through `lane-host`, which answers `local` where no
# provider is set, and on that answer every hosted read would be made on this
# disk where the lane is not. Asked once per process, the first time a hosted
# lane is carried, so a fleet that gains one while the run loops is judged then.
LANE_HOST_SPEC=""
check_lane_host() {
  local out entry items=""
  if [[ -z "$LANE_HOST_SPEC" ]]; then
    out="$("$SCRIPT_DIR/lane-host" resolve 2>&1)" \
      || die host-resolve-failed "$out" "path=$SCRIPT_DIR/lane-host"
    LANE_HOST_SPEC="$out"
  fi
  [[ "$LANE_HOST_SPEC" == local ]] || return 0
  for entry in "${HOSTED[@]}"; do items+="${items:+,}${entry%%=*}"; done
  die hosted-without-host "" "items=$items" "host=local"
}
# One entry per item: two roots for one lane would read one of its mailboxes
# and drain the other. An entry for an item this run does not watch reads no
# mailbox at all, and the item it was meant for quietly reads its local root
# instead. KIND is the option's reason prefix, hosted or root.
check_root_entries() { # KIND ENTRY...
  local kind="$1" entry item known seen=""
  shift
  for entry in "$@"; do
    [[ "$entry" == *=* ]] || die "$kind-invalid" "" "value=$entry"
    [[ "${entry%%=*}" =~ ^[A-Za-z0-9._-]+$ && -n "${entry#*=}" ]] \
      || die "$kind-invalid" "" "value=$entry"
    grep -qxF -- "${entry%%=*}" <<<"$seen" \
      && die "$kind-duplicate" "" "item=${entry%%=*}"
    known=0
    for item in ${ITEMS[@]+"${ITEMS[@]}"}; do
      [[ "$item" != "${entry%%=*}" ]] || known=1
    done
    [[ "$known" -eq 1 ]] || die "$kind-unknown-item" "" "item=${entry%%=*}"
    seen+="${entry%%=*}"$'\n'
  done
}

# HOSTED_ROOT is the item's lane root on its own host, empty for a lane on this
# disk. Set rather than printed: a substitution would carry the lookup's own
# status out under errexit, and a fleet with no hosted lane at all is the
# common case.
HOSTED_ROOT=""
hosted_root() { # ITEM
  local entry
  HOSTED_ROOT=""
  for entry in ${HOSTED[@]+"${HOSTED[@]}"}; do
    [[ "${entry%%=*}" == "$1" ]] || continue
    HOSTED_ROOT="${entry#*=}"
    return 0
  done
}
# The item's lane worktree on this disk as LOCAL_ROOT, from a --root entry;
# empty when none names it, and the mail pass then lets lane-mail resolve it.
LOCAL_ROOT=""
local_root() { # ITEM
  local entry
  LOCAL_ROOT=""
  for entry in ${ROOTS[@]+"${ROOTS[@]}"}; do
    [[ "${entry%%=*}" == "$1" ]] || continue
    LOCAL_ROOT="${entry#*=}"
    return 0
  done
}
# Whether a route of either type already names the item, for the state merge:
# a state record of either type displaces a hand-passed entry, so a lane that
# moved between this disk and a host is read where its record says.
route_listed() { # ITEM
  hosted_root "$1"
  [[ -z "$HOSTED_ROOT" ]] || return 0
  local_root "$1"
  [[ -n "$LOCAL_ROOT" ]]
}
# Whether an item or a window is already carried, for the state merge.
item_listed() { # ITEM
  local entry
  for entry in ${ITEMS[@]+"${ITEMS[@]}"}; do [[ "$entry" != "$1" ]] || return 0; done
  return 1
}
window_listed() { # WINDOW
  local entry
  for entry in ${LANES[@]+"${LANES[@]}"}; do [[ "$entry" != "$1" ]] || return 0; done
  return 1
}
# Whether --skip-lane names the window. A pass hears it from its caller and
# from the wrapper, which adds each window a pass already reported gone, a
# fact no record of its own can say.
lane_skipped() { # WINDOW
  local entry
  for entry in ${SKIP_LANES[@]+"${SKIP_LANES[@]}"}; do [[ "$entry" != "$1" ]] || return 0; done
  return 1
}

# The live fleet, read from the oversee workflow state open-terminal writes
# (schemas/workflow-state.md § Oversee state): a first line counting the
# records no pass carries, then one line per running lane record, item,
# window, local|hosted and mail_root joined by the unit separator. `running`,
# lib/lane-claims.sh's LANE_RUNNING_JQ, is the one answer to which records a
# pass carries, so the count and the rows cannot describe two different fleets. A file that is not that state,
# or a running record with no item, ends the watch: a lane read as absent is
# a lane nobody watches.
LANE_ROWS_FILTER="$LANE_RUNNING_JQ"'
  if type != "object" then error("state-type expected=object actual=\(type)") else . end
  | (.lanes // []) | if type != "array" then error("lanes-type expected=array actual=\(type)") else . end
  | ([.[] | select(running | not)] | length),
    (.[] | select(running)
  | if ((.item? | type) == "string" and (.item | length) > 0) then . else error("lane-field field=item value=\(.item | tojson)") end
  | [.item, (.window // ""), (if .host == null then "local" else "hosted" end), (.mail_root // "")] | join("\u001f"))'

# The preparation records of lanes open-terminal handed to a background job,
# one line each: item, outcome, the preparation's start in epoch seconds, the
# job's log and the failure reason, joined by the unit separator. The record's
# status is the outcome: preparing is pending, running is ready, and stopped
# carrying the job's reason is failed. Any other record's preparation is over,
# a close or a kept sandbox included, and is not read.
PREPARE_ROWS_FILTER='
  (.lanes // [])[] | select(type == "object" and (.prepare | type) == "object")
  | ({preparing: "pending", running: "ready"}[.status // ""] // (if .status == "stopped" and .prepare.reason != null then "failed" else empty end)) as $outcome
  | [.item, $outcome, (.prepare.since | fromdateiso8601 | tostring), .prepare.log, (.prepare.reason // "")] | join("\u001f")'
PREPARE_ROWS=""

# The one reader of the state, asked by the repeat wrapper before every pass
# and by the pass itself before every loop: the live set changes on every
# launch, relaunch and close, and a hosted lane's root rides in its record, so
# no change to the fleet waits for a restart. The state's records come first,
# then the command line's own entries for items and windows no record names,
# so a record wins where both name one item, and no run is refused over a lane
# that was passed by hand and then gained a record, of either route type. A
# local record's mail_root is carried as a --root entry, so a lane whose
# worktree sits outside this checkout is read where its mailbox is. A state
# that cannot be read, or a set this run would refuse, ends the read rather
# than carry a fleet nobody watches. The rows are split on the unit separator,
# never a tab: a tab is IFS whitespace, so `read` folds two of them into one
# and a lane with no window would take `local` as its window name.
FLEET_CARRIED=""
fleet_merge() { # [quiet]
  local state rows dropped line item window where root kept carried
  state="$(cat -- "$STATE_FILE" 2>&1)" || die state-unreadable "$state" "option=--state" "path=$STATE_FILE"
  rows="$(jq -r "$LANE_ROWS_FILTER" <<<"$state" 2>&1)" || die state-invalid "$rows" "option=--state" "path=$STATE_FILE"
  PREPARE_ROWS="$(jq -r "$PREPARE_ROWS_FILTER" <<<"$state" 2>&1)" || die state-invalid "$PREPARE_ROWS" "option=--state" "path=$STATE_FILE"
  # The count is the first line; a fleet of no running lane has no second.
  dropped="${rows%%$'\n'*}"
  if [[ "$rows" == *$'\n'* ]]; then rows="${rows#*$'\n'}"; else rows=""; fi
  ITEMS=()
  LANES=()
  HOSTED=()
  ROOTS=()
  while IFS=$'\x1f' read -r item window where root; do
    [[ -n "$item" ]] || continue
    ITEMS+=("$item")
    [[ -z "$window" ]] || LANES+=("$window")
    if [[ "$where" == hosted ]]; then HOSTED+=("$item=$root")
    elif [[ -n "$root" ]]; then ROOTS+=("$item=$root"); fi
  done <<<"$rows"
  for line in ${GIVEN_ITEMS[@]+"${GIVEN_ITEMS[@]}"}; do item_listed "$line" || ITEMS+=("$line"); done
  for line in ${GIVEN_LANES[@]+"${GIVEN_LANES[@]}"}; do window_listed "$line" || LANES+=("$line"); done
  for line in ${GIVEN_HOSTED[@]+"${GIVEN_HOSTED[@]}"}; do route_listed "${line%%=*}" || HOSTED+=("$line"); done
  for line in ${GIVEN_ROOTS[@]+"${GIVEN_ROOTS[@]}"}; do route_listed "${line%%=*}" || ROOTS+=("$line"); done
  # Last, so a window already reported gone leaves the set however it arrived.
  if [[ ${#SKIP_LANES[@]} -gt 0 ]]; then
    kept=()
    for line in ${LANES[@]+"${LANES[@]}"}; do lane_skipped "$line" || kept+=("$line"); done
    LANES=(${kept[@]+"${kept[@]}"})
  fi
  check_item_set
  check_lane_set
  # The set this read carries, named once the refusals above have passed it
  # and only when it differs from the last read's: a state that parses to no
  # running record is a silent fleet otherwise, every pass a healthy-looking
  # heartbeat over nothing. The fields are built once: the note and the key
  # deciding whether to print it are the same words. `quiet` takes the
  # baseline without naming it, for the one read a pass makes of a set its
  # caller has already named.
  carried=("items=${#ITEMS[@]}" "windows=${#LANES[@]}" "hosted=${#HOSTED[@]}" "dropped=$dropped")
  if [[ "${carried[*]}" != "$FLEET_CARRIED" ]]; then
    [[ "${1:-}" == quiet ]] || ow_message fleet-read "${carried[@]}" "path=$STATE_FILE" >&2
    FLEET_CARRIED="${carried[*]}"
  fi
}

# Repeat mode runs here, ahead of every note and read a single run makes. Each
# pass is this script in single-run mode, so a pass keeps that contract whole.
overseer_record_refuse() { # DETAIL REASON FIELD=VALUE...
  local detail="$1"; shift
  ow_message "$@" >&2
  [[ -z "$detail" ]] || printf '%s\n' "$detail" >&2
  exit 2
}
# The tail every oversee-succeed call this watch makes carries: the handoff
# path the successor's brief must name, and the overseer's own flags after the
# `--` that ends that script's parser. Spelled here and nowhere else, because
# two sites ask for the same successor — the record of the line a death would
# replay, and the walled recovery that builds one now — and a flag added to
# one spelling and not the other is a successor launched two ways.
#
# An array rather than a printed list: a flag is one argv word whatever it
# holds, and a line-per-word rendering would split one carrying a newline into
# two. Never empty, so every call site expands it plainly.
OVERSEER_LAUNCH_ARGS=()
overseer_launch_args() {
  OVERSEER_LAUNCH_ARGS=(--handoff "$HANDOFF")
  [[ ${#OVERSEER_FLAGS[@]} -eq 0 ]] || OVERSEER_LAUNCH_ARGS+=(-- "${OVERSEER_FLAGS[@]}")
}

overseer_command_record() {
  local pane="${TMUX_PANE:-}" key server window line record detail
  [[ -n "${TMUX:-}" && -n "$pane" && -x "$WORKFLOW_STATE" && -x "$SUCCEED" ]] || return 0
  # The key is the orch library's, the same function the report and the lane
  # turn-end hook read a session's own key with: the hook compares its own
  # against the pair written here, and a second derivation that drifted would
  # leave the overseer's turn end judged by nothing, with no keyed line.
  # That library swallows tmux's own words, and a second read of `#{pid}` here
  # would be a twin of the verb it owns, so the refusal names the read that
  # failed instead of replaying a message this script cannot have. The window
  # read below runs here and does replay tmux's. A key that came back in some
  # other shape is its own cause and is replayed as one.
  if ! key="$(lane_context_caller_key)"; then
    overseer_record_refuse "tmux reported no server pid for pane $pane" \
      overseer-unrecorded "pane=$pane" "step=identity"
  fi
  [[ "$key" =~ ^([0-9]+)[[:blank:]]+(%[0-9]+)$ ]] \
    || overseer_record_refuse "the pane key read back as: $key" \
      overseer-unrecorded "pane=$pane" "step=identity"
  # Taken here, before the next match replaces BASH_REMATCH.
  server="${BASH_REMATCH[1]}"
  if ! window="$(tmux display-message -p -t "$pane" '#{window_id}' 2>&1)"; then
    overseer_record_refuse "$window" overseer-unrecorded "pane=$pane" "step=window"
  fi
  [[ "$window" =~ ^@[0-9]+$ ]] \
    || overseer_record_refuse "" overseer-unrecorded "pane=$pane" "step=window"
  overseer_launch_args
  if ! line="$("$SUCCEED" --print-launch-line "${OVERSEER_LAUNCH_ARGS[@]}" 2>&1)"; then
    overseer_record_refuse "$line" overseer-line-missing "pane=$pane" "path=$SUCCEED"
  fi
  [[ -n "$line" ]] \
    || overseer_record_refuse "" overseer-line-missing "pane=$pane" "path=$SUCCEED"
  record="$(jq -n --arg server "$server" --arg pane "$pane" --arg window "$window" --arg line "$line" \
    '{server: $server, pane: $pane, window: $window, launch_line: $line}' 2>&1)" \
    || overseer_record_refuse "$record" overseer-unrecorded "pane=$pane" "step=render"
  detail="$("$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} \
    set oversee overseer "$record" 2>&1)" \
    || overseer_record_refuse "$detail" overseer-unrecorded "pane=$pane" "step=write"
}

# Whether PANE, a pane id, is one the tmux server this start runs on no longer
# lists. Only a listing that succeeded answers: a server that could not be
# asked leaves the pane unjudged, and the watch serving it is refused, not
# stopped. A pane on another tmux server reads as gone here; one fleet state is
# watched from one server.
watch_pane_gone() { # PANE
  local panes
  [[ -n "${TMUX:-}" && "$1" == %* ]] || return 1
  panes="$(tmux list-panes -a -F '#{pid} #{pane_id}' 2>/dev/null)" || return 1
  ! awk -v p="$1" '$2 == p { found = 1 } END { exit !found }' <<<"$panes"
}

# The repeat loop's pass or delay, the one child a stop has to take with it.
REPEAT_CHILD_PID=""
repeat_stop() { # STATUS
  [[ -z "$REPEAT_CHILD_PID" ]] || kill -TERM "$REPEAT_CHILD_PID" 2>/dev/null || true
  exit "$1"
}

# The watch's own record beside the fleet state (lib/watch-pid.sh), which a
# second start is refused on and `oversee-succeed` restarts this watch from. A
# live record refuses the start, with two exceptions, whose watch is stopped
# and replaced. One is the watch a succession restarted for THIS pane: that
# start is the successor running its own watch, as oversee.md § 4 has every
# overseer do. The other is a watch whose pane tmux no longer lists: it serves
# an overseer that is gone. That is the watch a succession hands over, which
# the restarted watch's own start stops here, and the one a successor meets
# where that restart never ran; this function is the one place a live watch is
# replaced. The pid recorded is this process's own, whatever launched it, so a
# stop reaches the loop and never a shell that only started it.
#
# oversee-watch.log and .err have one writer: a watch a succession started,
# through its own stdout and stderr. A start of that origin is reading files it
# writes, so it never prints or removes them. Any other start gets here only
# once their writer is stopped above or gone, a live one being refused, and
# prints and removes them, so nothing a restarted watch reported where no
# session read it, and no refusal it ended on, is lost.
watch_claim() { # ARGV...
  local why=""
  if watch_pid_live "$STATE_FILE"; then
    if [[ "$WATCH_ORIGIN" == succession && -n "${TMUX_PANE:-}" && "$WATCH_PANE" == "$TMUX_PANE" ]]; then
      why=succession
    elif watch_pane_gone "$WATCH_PANE"; then
      why=pane-gone
    fi
    [[ -n "$why" ]] && watch_stop "$WATCH_PID" \
      || die watch-running "" "pid=$WATCH_PID" "pane=$WATCH_PANE" "path=$STATE_FILE"
    ow_message watch-taken-over "pid=$WATCH_PID" "pane=$WATCH_PANE" "reason=$why" >&2
  fi
  watch_pid_write "$STATE_FILE" "${TMUX_PANE:-none}" "${OVERSEE_WATCH_ORIGIN:-hand}" \
    "$SCRIPT_DIR/${BASH_SOURCE[0]##*/}" "${@:1:$ARGV_BASE_COUNT}" \
    || die watch-record-failed "" "path=${WATCH_PID_FILE:-$STATE_FILE}"
  trap 'watch_pid_release "$STATE_FILE"' EXIT
  trap 'repeat_stop 143' TERM
  # Reaches only a loop started in the foreground: a background job ignores
  # INT from its start, and bash cannot trap a signal ignored on entry.
  trap 'repeat_stop 130' INT
  if [[ "${OVERSEE_WATCH_ORIGIN:-hand}" != succession ]] \
     && [[ -s "$WATCH_LOG_FILE" || -s "$WATCH_ERR_FILE" ]]; then
    ow_message watch-replayed "log=$WATCH_LOG_FILE" "err=$WATCH_ERR_FILE" >&2
    if [[ -f "$WATCH_LOG_FILE" ]]; then
      cat -- "$WATCH_LOG_FILE" || die watch-replay-failed "" "path=$WATCH_LOG_FILE"
    fi
    if [[ -f "$WATCH_ERR_FILE" ]]; then
      cat -- "$WATCH_ERR_FILE" >&2 || die watch-replay-failed "" "path=$WATCH_ERR_FILE"
    fi
    rm -f -- "${WATCH_LOG_FILE:?}" "${WATCH_ERR_FILE:?}" \
      || die watch-replay-failed "" "path=$WATCH_LOG_FILE"
  fi
}

# The pass is handed the state itself and only the entries argv gave this
# wrapper, never the merged set: a lane whose record closed while the pass
# loops has to leave that pass's fleet, which a hand-passed --item never does.
# A state the wrapper's own read refuses ends the watch here rather than after
# every sleep, since the pass would refuse it too.
REPEAT_FIRST=1
repeat_watch() { # ARGV...
  local self="$SCRIPT_DIR/${BASH_SOURCE[0]##*/}" args line noted="" gone="" pending pass_rc fleet_state_dir
  fleet_state_dir="${STATE_FILE%/*}"
  [[ "$fleet_state_dir" != "$STATE_FILE" ]] || fleet_state_dir=.
  check_repo_set
  while :; do
    fleet_merge
    # Once, after the first read, so a state that cannot be read is refused as
    # that and not as a record that could not be written beside it, and before
    # the overseer record, so a refused second start leaves the one the running
    # watch wrote.
    if [[ -n "$REPEAT_FIRST" ]]; then
      REPEAT_FIRST=""
      watch_claim "$@"
      overseer_command_record
    fi
    args=(--interval "$INTERVAL" --max-loops "$MAX_LOOPS" \
          --handoff "$HANDOFF" --state "$STATE_FILE")
    [[ -z "$SINCE" ]] || args+=(--since "$SINCE")
    for line in ${REPOS[@]+"${REPOS[@]}"}; do args+=(--repo "$line"); done
    for line in ${GIVEN_HOSTED[@]+"${GIVEN_HOSTED[@]}"}; do args+=(--hosted "$line"); done
    for line in ${GIVEN_ROOTS[@]+"${GIVEN_ROOTS[@]}"}; do args+=(--root "$line"); done
    for line in ${GIVEN_ITEMS[@]+"${GIVEN_ITEMS[@]}"}; do args+=(--item "$line"); done
    # The caller's own skips, which this wrapper's merge has already taken out
    # of LANES: the loop below walks LANES, so it reaches none of them, and a
    # pass not told of them re-reads their records and watches the very windows
    # the caller took out of this run. The loop adds the windows it finds gone,
    # which the merge cannot have removed, so the two sources never collide.
    for line in ${SKIP_LANES[@]+"${SKIP_LANES[@]}"}; do args+=(--skip-lane "$line"); done
    pending=""
    for line in ${LANES[@]+"${LANES[@]}"}; do
      if lane_window_listed "$line"; then
        # Listed again, so a later death under this name is news again.
        noted="$(grep -vxF -- "$line" <<<"$noted" || :)"
        gone="$(grep -vxF -- "$line" <<<"$gone" || :)"
      elif grep -qxF -- "$line" <<<"$gone"; then
        # The pass re-reads the state, so the record still names this window:
        # skipping it there is the only way it stays out of the pane checks.
        args+=(--skip-lane "$line")
      else
        # An absent window rides every pass, noted once, until a pass that
        # carried it exits 0; later passes skip it while it stays gone.
        grep -qxF -- "$line" <<<"$noted" \
          || { noted+=$'\n'"$line"; ow_message window-absent "lane=$line" >&2; }
        pending+=$'\n'"$line"
      fi
    done
    for line in ${GIVEN_LANES[@]+"${GIVEN_LANES[@]}"}; do args+=("$line"); done
    # LAST, after every lane window: `--` ends this parser, so anything appended
    # after the overseer's flags would reach the harness instead of the watch.
    [[ ${#OVERSEER_FLAGS[@]} -eq 0 ]] || args+=(-- "${OVERSEER_FLAGS[@]}")
    # The pass and the delay run in the background and are waited on, so a
    # TERM on this loop reaches its trap at once and the trap stops the pass:
    # bash holds a trap until a FOREGROUND child returns, and a stopped loop
    # would otherwise leave its pass reading the fleet for its whole run.
    pass_rc=0
    OVERSEE_WATCH_FLEET_STATE_DIR="$fleet_state_dir" \
      OVERSEE_WATCH_REPEAT_OWNER="$$" \
      OVERSEE_WATCH_SESSION="$WATCH_SESSION" \
      "$self" "${args[@]}" &
    REPEAT_CHILD_PID=$!
    wait "$REPEAT_CHILD_PID" || pass_rc=$?
    REPEAT_CHILD_PID=""
    # The overseer this watch served is gone and a successor holds its window,
    # running a watch of its own. Two watches on one fleet read one overseer
    # mailbox and each replay what the other drained, so this one ends here.
    if [[ "$pass_rc" -eq 3 ]]; then
      ow_message overseer-succeeded "pane=${TMUX_PANE:-none}" >&2
      exit 0
    fi
    # Notice-only recovery and an exhausted retry leave a manual replacement
    # to start one new watch. The old watch stops before both can read the same
    # overseer mailbox.
    [[ "$pass_rc" -ne 4 ]] || exit 0
    # A pass exits 0 only after its check_lanes ran, which printed window-gone
    # for every absent window it carried; any other exit may have stopped first.
    [[ "$pass_rc" -ne 0 ]] || gone+="$pending"
    # Named for a test's sleep stub, which tells this delay from a pass's own
    # sleeps by the variable and never by reading the process table. A delay
    # that cannot be slept ends the watch with its cause named, never silently.
    OVERSEE_WATCH_SLEEP=repeat sleep "$REPEAT" &
    REPEAT_CHILD_PID=$!
    wait "$REPEAT_CHILD_PID" || die sleep-failed "" "secs=$REPEAT"
    REPEAT_CHILD_PID=""
  done
}
if [[ -n "$REPEAT" ]]; then
  [[ "$REPEAT" =~ ^[0-9]+$ ]] || die repeat-invalid "" "value=$REPEAT"
  [[ -n "$STATE_FILE" ]] || die state-required "" "option=--repeat"
fi
# This invocation owns the current overseer command. A live manual replacement
# must publish its command before any pass can consume the old session's line.
# Repeat mode publishes it in repeat_watch, once its own claim has stood.
[[ "$REPEAT_CHILD" -eq 1 || -n "$REPEAT" ]] || overseer_command_record
[[ -z "$REPEAT" ]] || repeat_watch "$@"
# The run's first read, before the notes and helper checks below judge the set
# it starts with; every loop reads it again. A repeat-mode pass takes that
# baseline quietly, because the wrapper that launched it has just named the
# same set and a second line for it says nothing. A standalone run has no
# wrapper to have named anything, so its first read names the fleet it starts
# with, the one read that would otherwise go by with the set unstated.
FIRST_READ_QUIET=""
[[ "$REPEAT_CHILD" -ne 1 ]] || FIRST_READ_QUIET=quiet
[[ -z "$STATE_FILE" ]] || fleet_merge "$FIRST_READ_QUIET"

TRIAGE_ENABLED=0
# LINEAR_TEAM decides whether this fleet has a team to triage at all: empty,
# however it was spelled, is a repo that tracks work elsewhere, so triage is
# skipped, named once, and the watch runs on --since for the merged check.
# With a team, triage fails CLOSED: ../references/oversee-events.md § Event kinds
# owes a verdict to every emitted team item, so a broken install that silently
# dropped triage would drop every unseen item with it, and each missing
# dependency names its remedy.
if [[ -n "$SINCE" ]]; then
  if [[ -n "${LINEAR_TEAM:-}" ]]; then
    [[ -x "$TRACKER" ]] \
      || die helper-missing "" "path=$TRACKER" "setting=OVERSEE_WATCH_TRACKER"
    [[ -x "$WORKFLOW_STATE" ]] \
      || die helper-missing "" "path=$WORKFLOW_STATE" "setting=OVERSEE_WATCH_WORKFLOW_STATE"
    TRIAGE_ENABLED=1
  else
    ow_message triage-disabled "setting=LINEAR_TEAM" "value=${LINEAR_TEAM:-}" >&2
  fi
fi

check_item_set

# The item a lane window watches, as LANE_ITEM, with hosted_root set for it.
# open-terminal names a window for its item, except a GitHub item's: window
# gh-N, item issue-N. The literal name is tried first, so a tracker whose own
# identifiers read gh-N keeps them.
hosted_lane_item() { # LANE
  LANE_ITEM="${1#*:}"
  hosted_root "$LANE_ITEM"
  [[ -z "$HOSTED_ROOT" && "$LANE_ITEM" == gh-* && "${LANE_ITEM#gh-}" =~ ^[0-9]+$ ]] || return 0
  LANE_ITEM="issue-${LANE_ITEM#gh-}"
  hosted_root "$LANE_ITEM"
}

# The hosted items whose worktree this pass's mail read found gone, one per line.
HOSTED_GONE_ITEMS=""

# `lane-host cat --item ITEM PATH` into DEST: 0 read, 1 not there, 2 failed.
# Exit 2 is also the dispatcher's own refusal, so it reads as a missing file
# only once `touch` answers (schemas/lane-host.md). A failed read leaves no DEST.
host_fetch() { # ITEM PATH DEST
  local rc=0
  "$SCRIPT_DIR/lane-host" cat --item "$1" "$2" >"$3" 2>"$WORK_DIR/host.err" || rc=$?
  [[ "$rc" -ne 0 ]] || return 0
  rm -f -- "$3"
  [[ "$rc" -eq 2 ]] || return 2
  "$SCRIPT_DIR/lane-host" touch --item "$1" >/dev/null 2>>"$WORK_DIR/host.err" || return 2
  return 1
}

# The clone a hosted lane's worktree belongs to, which its record does not
# carry: the worktree's `.git` file names it while the worktree stands, read
# through lib/lane-gitfile.sh, and STATE's clone-root row keeps it for after
# merge-pr.md § 5 removes the worktree. A root that is itself a clone has a
# `.git` directory, which `cat` fails on and whose HEAD answers: the clone is
# the root, with no `.git` appended. Sets HOSTED_CLONE, and HOSTED_GONE to 1
# when the worktree is gone. Call after hosted_root.
hosted_clone() { # ITEM STATE
  local line="" common="" rc=0 err
  HOSTED_GONE=0
  host_fetch "$1" "$HOSTED_ROOT/.git" "$WORK_DIR/gitfile" || rc=$?
  if [[ "$rc" -eq 2 ]]; then
    err="$(cat "$WORK_DIR/host.err")"
    if host_fetch "$1" "$HOSTED_ROOT/.git/HEAD" "$WORK_DIR/githead"; then
      HOSTED_CLONE="$HOSTED_ROOT"
      return 0
    fi
    printf '%s\n' "$err" >"$WORK_DIR/host.err"
  fi
  case "$rc" in
    0)
      if ! IFS= read -r line <"$WORK_DIR/gitfile" && [[ -z "$line" ]]; then
        lane_failure_set handoff-read-failed "" "item=$1" "path=$HOSTED_ROOT/.git" "value=<empty>"
        return 1
      fi
      if ! common="$(lane_gitfile_common_dir "$line")"; then
        lane_failure_set handoff-read-failed "" "item=$1" "path=$HOSTED_ROOT/.git" "value=$line"
        return 1
      fi
      HOSTED_CLONE="${common%/.git}" ;;
    1)
      HOSTED_GONE=1
      if ! HOSTED_CLONE="$(lane_row_get clone-root "$2" "$1")" || [[ -z "$HOSTED_CLONE" ]]; then
        lane_failure_set handoff-read-failed "" "item=$1" "clone=unknown"
        return 1
      fi ;;
    *)
      lane_failure_set handoff-read-failed "$(cat "$WORK_DIR/host.err")" \
        "item=$1" "path=$HOSTED_ROOT/.git"
      return 1 ;;
  esac
}

# The directory an item's workflow state is read from, as ITEM_STATE_DIR. A
# hosted lane's state is in its clone (workflow-state joins a relative state
# directory to the common root), fetched into a scratch directory the same
# reader then reads; a file the host does not have leaves it empty, as a
# missing local file does. The clone is the one the last mail pass learned.
item_state_dir() { # ITEM
  local clone remote rc=0
  ITEM_STATE_DIR="$WORKFLOW_STATE_DIR"
  hosted_root "$1"
  [[ -n "$HOSTED_ROOT" ]] || return 0
  if ! clone="$(lane_row_get clone-root "$MAIL_SEEN" "$1")" || [[ -z "$clone" ]]; then
    lane_failure_set handoff-read-failed "" "item=$1" "clone=unknown"
    return 1
  fi
  remote="$STATE_DIR_SETTING"
  [[ "$remote" == /* ]] || remote="$clone/$remote"
  ITEM_STATE_DIR="$WORK_DIR/hosted-state/$1"
  if ! mkdir -p -- "$ITEM_STATE_DIR"; then
    lane_failure_set handoff-read-failed "" "item=$1" "path=$ITEM_STATE_DIR"
    return 1
  fi
  host_fetch "$1" "$remote/workflow-state-$1.json" "$ITEM_STATE_DIR/workflow-state-$1.json" || rc=$?
  if [[ "$rc" -gt 1 ]]; then
    lane_failure_set handoff-read-failed "$(cat "$WORK_DIR/host.err")" "item=$1" "path=$remote"
    return 1
  fi
}

# Run the one lane close-out verb where a hosted item's lane-exited is reported,
# once per pane, after its merge. Exit 3 is a checkout with user-owned changes:
# the user settles it, so it is reported and never retried or forced. Any other
# exit returns 1 with its message on stderr: the caller commits the rows it
# already settled, other lanes' closes among them, before the pass exits 2.
close_hosted_lane() { # ITEM
  local out line path="" rc=0
  out="$("$LANE_CLOSE" --state-dir "$FLEET_STATE_DIR" "$1" 2>&1)" || rc=$?
  case "$rc" in
    0)
      echo "EVENT lane-closed $1"
      if line="$(grep '^kept=' <<<"$out")"; then
        printf '%s\n' "$line"
      else
        echo "kept=none"
      fi ;;
    3)
      # The provider's close-refused line names the refused checkout.
      while IFS= read -r line; do
        [[ "$line" == *"close-refused path="* ]] || continue
        path="${line#*close-refused path=}"
        break
      done <<<"$out"
      echo "EVENT lane-close-refused $1"
      printf 'path=%s\n' "${path:-unknown}"
      [[ -z "$out" ]] || printf '%s\n' "$out" >&2 ;;
    *)
      ow_message lane-close-failed "item=$1" "exit=$rc" >&2
      [[ -z "$out" ]] || printf '%s\n' "$out" >&2
      return 1 ;;
  esac
}

command -v gh >/dev/null 2>&1 || die command-missing "" "command=gh"
command -v jq >/dev/null 2>&1 || die command-missing "" "command=jq"
command -v cksum >/dev/null 2>&1 || die command-missing "" "command=cksum"

WORK_DIR="$(mktemp -d)"
# Where the long pass the main loop forks spools its lines, named here for the
# EXIT trap below.
LONG_PID=""
LONG_OUT="$WORK_DIR/long.out"
LONG_ERR="$WORK_DIR/long.err"
LONG_STATUS="$WORK_DIR/long.status"
LONG_DONE="$WORK_DIR/long.done"
# Waits for the long pass and prints what it said. The EXIT trap's half of
# long_collect, so it prints and never exits.
long_drain() {
  local rc=0
  [[ -n "$LONG_PID" ]] || return 0
  wait "$LONG_PID" || rc=$?
  LONG_PID=""
  cat -- "$LONG_OUT"
  cat -- "$LONG_ERR" >&2
  return "$rc"
}
# A long pass still in flight when this process exits, on a die in a mail pass
# among other ways, is waited for and its lines printed: its baselines may have
# advanced past the events it found, and a line dropped here is lost for good.
trap 'long_drain || :; rm -rf "$WORK_DIR"' EXIT

# Auth ladder (gates.md § Waiter auth ladder): a stale env token yields to the
# keyring; when neither works, the env token is dropped so the project's
# GH_BOT_TOKEN can be selected — the last candidate. Never proceed
# unauthenticated: an unauthenticated `gh pr list` would report an empty
# fleet, not a failure.
orch_sanitize_gh_env
if ! orch_github_auth_status; then
  unset GH_TOKEN GITHUB_TOKEN
  { orch_load_env_bot_token "$PROJECT_ROOT" && orch_github_auth_status; } \
    || die auth-failed "" "service=github"
fi

if [[ ${#REPOS[@]} -eq 0 ]]; then
  # The shared resolver, so a watch launched with GH_REPO naming another
  # repository reduces that one rather than the checkout it was started in.
  # Exit 2 prints the value it rejected, which is no more usable as a `--repo`
  # argument than nothing resolved at all, so both refuse here.
  resolve_status=0
  resolved="$(orch_resolve_gh_repo "$PROJECT_ROOT")" || resolve_status=$?
  [[ "$resolve_status" -eq 0 && -n "$resolved" ]] || die repo-unresolved "" "option=--repo"
  REPOS=("$resolved")
fi
# Settled once, HERE — below the default resolution, the one point every path's
# REPOS has reached its final value, so a repo `gh repo view` reported in its
# registered casing is canonicalized too.
check_repo_set
if [[ -x "$PR_WATCH" ]]; then
  :
else
  ow_message reducer-missing "path=$PR_WATCH" >&2
  PR_WATCH=""
fi
# Handoff fails CLOSED like triage: a lane that handed off and exited is
# otherwise a lane-exited the overseer relaunches from nothing. Asked again
# after every re-read of the state, because a fleet that started with no item
# can gain its first one between two loops of this run.
require_item_helpers() {
  [[ -n "$ITEM_BRANCHES" ]] || return 0
  [[ -x "$WORKFLOW_STATE" ]] \
    || die helper-missing "" "path=$WORKFLOW_STATE" "setting=OVERSEE_WATCH_WORKFLOW_STATE"
}
if [[ -z "$ITEM_BRANCHES" ]]; then
  ow_message items-omitted "count=0" "skipped=merged,handoff" >&2
fi
require_item_helpers
# The mail pass fails closed too, items or not: it is the only channel a lane
# has to reach the overseer on a surface with no pane, and the one the owner's
# notes arrive on, so a missing reader would leave them unread with nothing said.
[[ -x "$LANE_MAIL" ]] \
  || die helper-missing "" "path=$LANE_MAIL" "setting=OVERSEE_WATCH_LANE_MAIL"
# The account read is the only way capacity reaches the overseer between
# events, so a missing reader stops the watch rather than leave every account
# change unsaid.
[[ -x "$LANES_CLI" ]] \
  || die helper-missing "" "path=$LANES_CLI" "setting=OVERSEE_WATCH_LANES"
# Inside tmux the pane checks are how an item's lane is watched, so a run
# naming items and no window is told which checks it is not running, as the
# two notes above say for the reducer and the merged check. Outside tmux there
# is no pane to read and nothing to note.
if [[ -n "${TMUX:-}" && -n "$ITEM_BRANCHES" && ${#LANES[@]} -eq 0 ]]; then
  ow_message lanes-omitted "count=0" "active=pr-watch,merged,triage,handoff" >&2
fi

pw_init_state
MAIL_STATE_FILE="$(pw_state_file "${REPOS[0]}").mail"
[[ ! -f "$MAIL_STATE_FILE" ]] || MAIL_SEEN="$(cat -- "$MAIL_STATE_FILE")" \
  || die state-read-failed "" "path=$MAIL_STATE_FILE"

# Every --repo: a consumer-repo PR merges where the item's work went, under the
# same branch name, and a fork's PR on that name is rejected per repo. Reported
# once per PR: the item's `merged` row holds every `<repo>#<number>` already
# delivered, so a merged item still in --item on a re-run is not news again,
# while a further PR on the branch, in any repo, is. The rows are committed
# once, after the lines are out.
check_merged() {
  [[ -n "$ITEM_BRANCHES" ]] || return 0
  local errf="$WORK_DIR/merged.err" item branch repo list hit hits prior keys key line state="${PW_SEEN[0]}"
  for item in "${ITEMS[@]}"; do
    branch="$(printf '%s' "$item" | tr '[:upper:]' '[:lower:]')"
    hits=""
    for repo in "${REPOS[@]}"; do
      list="$(gh pr list --repo "$repo" --head "$branch" --state merged --limit 10 --json number,headRefName,headRepositoryOwner,mergedAt 2>"$errf")" \
        || die pr-list-failed "$(cat "$errf")" "repo=$repo" "state=merged" "branch=$branch"
      hit="$(jq -r --arg branch "$branch" --arg owner "${repo%%/*}" --arg repo "$repo" --argjson since "$SINCE_EPOCH" '
        [ .[]
          | select(.headRefName | ascii_downcase == $branch)
          | select(((.headRepositoryOwner.login // "") | ascii_downcase) == $owner)
          | select(.mergedAt != null)
          | select((.mergedAt | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) >= $since)
          | "\(.number) \(.headRefName) \($repo)" ]
        | .[]' <<<"$list" 2>"$errf")" \
        || die pr-list-invalid "$(cat "$errf")" "repo=$repo" "branch=$branch"
      [[ -z "$hit" ]] || hits+="$hit"$'\n'
    done
    if [[ -z "$hits" ]]; then
      state="$(lane_row_clear merged "$state" "$item")"
      continue
    fi
    prior="$(lane_row_get merged "$state" "$item")"
    keys=""
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      key="${line##* }#${line%% *}"
      keys="${keys:+$keys }$key"
      grep -qxF -- "$key" <<<"${prior// /$'\n'}" && continue
      echo "EVENT merged $line"
      PASS_EVENT=1
    done <<<"$hits"
    state="$(lane_row_set merged "$state" "$item" "$keys")"
  done
  state="$(lane_row_prune merged "$state" "${ITEMS[@]}")"
  lane_row_commit "$state"
}

check_triage() {
  [[ "$TRIAGE_ENABLED" -eq 1 ]] || return 0
  local errf="$WORK_DIR/triage.err" now age days out ids verdicts pr_keys triage_keys="" seen id new_ids="" next rc=0
  verdicts="$("$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} get oversee '.triaged // [] | map(select(.verdict == "kept" or .verdict == "canceled") | .issue) | .[]' 2>"$errf")" || rc=$?
  [[ "$rc" -eq 0 ]] \
    || die triage-state-failed "$(cat "$errf")" "exit=$rc"
  verdicts="$(awk 'NF && !seen[$0]++' <<<"$verdicts")"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] \
      || die triage-item-invalid "" "item=$id"
    [[ -z "$triage_keys" ]] || triage_keys+=$'\n'
    triage_keys+="triage"$'\t'"$id"
  done <<<"$verdicts"
  pr_keys="$(awk -F'\t' '$1 != "triage" { print }' <<<"${PW_SEEN[0]}")"
  if [[ -n "$pr_keys" && -n "$triage_keys" ]]; then
    next="$pr_keys"$'\n'"$triage_keys"
  else
    next="$pr_keys$triage_keys"
  fi
  if [[ "$next" != "${PW_SEEN[0]}" ]]; then
    pw_stage_state "$(pw_state_file "${REPOS[0]}")" "$next"
    pw_commit_state "$(pw_state_file "${REPOS[0]}")"
    PW_SEEN[0]="$next"
  fi
  now="$(date -u +%s)" || die time-failed "" "clock=UTC"
  age=$((now - SINCE_EPOCH))
  [[ "$age" -ge 0 ]] || age=0
  # Linear's live list accepts whole-day windows. Round up, then apply the
  # exact ISO floor below so the wider server query cannot mint an old event.
  days=$((age / 86400 + 1))
  out="$("$TRACKER" issues list --team "$LINEAR_TEAM" --created-since "${days}d" --max --format=safe 2>"$errf")" || rc=$?
  [[ "$rc" -eq 0 ]] \
    || die tracker-list-failed "$(cat "$errf")" "team=$LINEAR_TEAM" "exit=$rc"
  ids="$(jq -r --argjson since "$SINCE_EPOCH" '
    def created_epoch: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
    if type != "array" then error("tracker-type expected=array actual=\(type)") else . end
    | [ .[]
      | if ((.created_at? | type) == "string" and (.created_at | length) > 0)
        then . else error("tracker-field field=created_at value=\(.created_at | tojson)") end
      | select((.created_at | created_epoch) >= $since)
      | if ((.id? | type) == "string" and (.id | test("^[A-Za-z0-9._-]+$")))
        then .id else error("tracker-field field=id value=\(.id | tojson)") end ]
    | unique[]
  ' <<<"$out" 2>"$errf")" \
    || die tracker-list-invalid "$(cat "$errf")" "team=$LINEAR_TEAM"
  seen="$(awk -F'\t' '$1 == "triage" && NF == 2 { print $2 }' <<<"${PW_SEEN[0]}")"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    grep -qxF -- "$id" <<<"$seen" || new_ids+="$id"$'\n'
  done <<<"$ids"
  [[ -n "$new_ids" ]] || return 0
  new_ids="${new_ids%$'\n'}"
  while IFS= read -r id; do
    echo "EVENT triage $id"
  done <<<"$new_ids"
  PASS_EVENT=1
}

# A lane told to hand off records `.handoff` in its item's state and exits.
# The record is the carrier, read from workflow state and never a pane, so the
# check runs on every surface. Whether one stands is `workflow-state
# handoff-standing`'s answer, the same one the lane's own turn-end hook asks,
# so the watch cannot report a lane as handed off that the hook still holds.
# It is reported once per record: the row keyed by the record's checksum is
# what stops a re-run between the event and the
# relaunch from reporting it again, and a record the relaunched lane stamped
# `.resumed_at` on is spent. Ordered after lane-exited and before
# usage-limit: the lane's exit is the older news, and a spent account is not
# what a handed-off lane is waiting on. Every item's record is reported in the
# pass that finds it, and the rows are committed once, after the lines are out.
check_handoff() {
  [[ ${#ITEMS[@]} -gt 0 ]] || return 0
  local item answer rec rc key prior errf="$WORK_DIR/handoff.err" state="${PW_SEEN[0]}"
  # The verdict line `handoff-standing` publishes, the one place its text lives
  # in this script.
  local verdict='workflow-state: handoff-standing'
  for item in "${ITEMS[@]}"; do
    grep -qxF -- "$item" <<<"$PASS_FAILED_ITEMS" && continue
    if ! item_state_dir "$item"; then
      lane_failure_report "$item" "$state"
      state="$LANE_FAILURE_STATE"
      lane_row_commit "$state"
      continue
    fi
    # `handoff-standing` owns the test and publishes its verdict as the word on
    # its first line, so that word is read here and its status is not: a script
    # its settings loader killed before the verb ran exits with a status of its
    # own, and only a run that reached the verb writes a verdict. `none` is no
    # record standing, a state file that is not there included, and `stands`
    # carries the record on the line under it. Anything else, an install
    # without the verb included, is a state this pass could not read, and is
    # reported rather than passed off as "no handoff".
    rc=0
    answer="$("$WORKFLOW_STATE" --state-dir "$ITEM_STATE_DIR" handoff-standing "$item" 2>"$errf")" || rc=$?
    if [[ "$rc" -eq 0 && "$answer" == "$verdict=none" ]]; then
      state="$(lane_row_clear handoff "$state" "$item")"
      state="$(lane_row_clear lane-failed "$state" "$item")"
      continue
    fi
    if [[ "$rc" -ne 0 || "$answer" != "$verdict=stands"$'\n'* ]]; then
      lane_failure_set handoff-read-failed "$(cat "$errf")" "item=$item" "path=$ITEM_STATE_DIR"
      lane_failure_report "$item" "$state"
      state="$LANE_FAILURE_STATE"
      lane_row_commit "$state"
      continue
    fi
    rec="${answer#*$'\n'}"
    state="$(lane_row_clear lane-failed "$state" "$item")"
    key="$(printf '%s' "$rec" | cksum | awk '{ print $1 }')"
    prior="$(lane_row_get handoff "$state" "$item")"
    state="$(lane_row_set handoff "$state" "$item" "$key")"
    [[ "$key" != "$prior" ]] || continue
    echo "EVENT handoff $item"
    printf '%s\n' "$rec"
    PASS_EVENT=1
  done
  state="$(lane_row_prune handoff "$state" "${ITEMS[@]}")"
  lane_row_commit "$state"
}

# A lane open-terminal handed to a background job while its host prepared it
# is reported from its record: the outcome the job wrote, once, and a record
# still preparing past PREPARE_SECS, once. The row is keyed by the
# preparation's start, so a relaunch that prepares again is reported afresh.
check_prepare() {
  local item outcome since log reason key age rows="${PW_SEEN[0]}" items=()
  while IFS=$'\x1f' read -r item outcome since log reason; do
    [[ -n "$item" ]] || continue
    items+=("$item")
    age=$((PASS_NOW - since))
    case "$outcome" in
      pending) [[ "$age" -gt "$PREPARE_SECS" ]] || continue; key="$since|stuck" ;;
      ready|failed) key="$since|$outcome" ;;
    esac
    [[ "$key" != "$(lane_row_get lane-prepare "$rows" "$item")" ]] || continue
    rows="$(lane_row_set lane-prepare "$rows" "$item" "$key")"
    case "$outcome" in
      pending) echo "EVENT lane-prepare-stuck $item age=${age}s log=$log" ;;
      ready) echo "EVENT lane-ready $item" ;;
      failed) echo "EVENT lane-prepare-failed $item reason=$reason log=$log" ;;
    esac
    PASS_EVENT=1
  done <<<"$PREPARE_ROWS"
  rows="$(lane_row_prune lane-prepare "$rows" ${items[@]+"${items[@]}"})"
  lane_row_commit "$rows"
}

# One lane-mail read for the mail pass, its output in MAIL_OUT. A read that
# failed is set as the lane's failure and returns 1, for the caller to report.
MAIL_OUT=""
mail_read() { # ITEM LANE_MAIL_ARGS...
  local item="$1" rc=0
  shift
  MAIL_OUT="$("$LANE_MAIL" "$@" 2>"$WORK_DIR/mail.err")" || rc=$?
  [[ "$rc" -ne 0 ]] || return 0
  lane_failure_set mail-read-failed "$(cat "$WORK_DIR/mail.err")" "item=$item" "exit=$rc"
  return 1
}

# Every --item's lane mailbox, read from disk or through `lane-host`, so the
# check runs on every surface: a lane with no pane, on another host, or in a
# session this process cannot see still reaches the overseer. Each item's row
# holds how many to-overseer.jsonl lines have been drained and the id the file
# opened with, and `drain` reports the file's own count and first id, so a
# message is reported once. An ask already answered is dropped by `drain`
# rather than by a row, so a restarted overseer with no rows re-reports only
# what it still owes a reply. Beside it, `receipts` reads the lane's
# to-lane.cursor, which every read path the lane has advances: the cursor is
# the lane's receipt for each directive it has passed. The overseer's own
# mailbox is read last, items or not, with `inbox`, which advances its own
# to-lane.cursor: the reader a session start runs as well, so a note is
# reported by whichever reads it first and by nothing after.
check_mail() {
  local item stored prior seen header count first line fields id kind options text rest root cursor from re
  local envelopes replaced lane_read to_first read_at unread_at at
  local mail_items host_flag args
  local state="$MAIL_SEEN"
  HOSTED_GONE_ITEMS=""
  mail_items=(${ITEMS[@]+"${ITEMS[@]}"})
  mail_items+=(overseer)
  for item in "${mail_items[@]}"; do
    root=""
    host_flag=()
    cursor="$item"
    if [[ "$item" != overseer ]]; then
      hosted_root "$item"
      root="$HOSTED_ROOT"
      host_flag=(--host)
      # A local lane with a recorded root is read there, with no --host: only a
      # hosted read needs one, and lane-mail's ownership gate is on send.
      if [[ -z "$root" ]]; then local_root "$item"; root="$LOCAL_ROOT"; host_flag=(); fi
    fi
    if [[ -n "$HOSTED_ROOT" && "$item" != overseer ]]; then
      if ! hosted_clone "$item" "$state"; then
        lane_failure_report "$item" "$state"
        mail_row_commit "$LANE_FAILURE_STATE"
        state="$MAIL_SEEN"
        continue
      fi
      state="$(lane_row_set clone-root "$state" "$item" "$HOSTED_CLONE")"
      # With the worktree removed, the lane's closing notice lands in the
      # clone's mailbox: another file, so another cursor.
      if [[ "$HOSTED_GONE" -eq 1 ]]; then
        HOSTED_GONE_ITEMS+="$item"$'\n'
        root="$HOSTED_CLONE"; cursor="$item@clone"
      fi
    fi
    args=(--item "$item")
    [[ -z "$root" ]] || args+=(--root "$root" ${host_flag[@]+"${host_flag[@]}"})
    replaced=0
    count=0
    prior=0
    if [[ "$item" == overseer ]]; then
      if ! mail_read "$item" inbox "${args[@]}"; then
        lane_failure_report "$item" "$state"
        mail_row_commit "$LANE_FAILURE_STATE"
        state="$MAIL_SEEN"
        continue
      fi
      envelopes="$MAIL_OUT"
    else
      if ! stored="$(lane_row_get lane-mail "$state" "$cursor")"; then
        die state-read-failed "" "item=$item" "row=lane-mail"
      fi
      # `<count> <first>`: the lines drained, and the id the mailbox opened with
      # when they were, empty where it opened with none.
      read -r prior seen <<<"$stored"
      [[ "$prior" =~ ^[0-9]+$ ]] || { prior=0; seen=""; }
      while :; do
        if ! mail_read "$item" drain "${args[@]}" --after "$prior"; then
          lane_failure_report "$item" "$state"
          mail_row_commit "$LANE_FAILURE_STATE"
          state="$MAIL_SEEN"
          continue 2
        fi
        header="${MAIL_OUT%%$'\n'*}"
        [[ "$header" =~ ^count=([0-9]+)\ first=([A-Za-z0-9._-]*)$ ]] \
          || die mail-read-invalid "" "item=$item" "value=${header:-<empty>}"
        count="${BASH_REMATCH[1]}"
        first="${BASH_REMATCH[2]}"
        # A mailbox opening with another envelope than the one recorded is not
        # that mailbox: a lane relaunched onto a replacement host brings a
        # fresh one, and the saved cursor would suppress what it holds, losing
        # those messages for good. Where no first id was recorded the count
        # answers, a mailbox holding fewer lines than were drained. Read the
        # replacement whole, once — a second mismatch is the same answer and
        # would not end. A read that finds no line at all is no replacement: an
        # append-only mailbox never empties, so it is a read that missed.
        [[ "$replaced" -eq 0 && "$prior" -gt 0 && "$count" -gt 0 ]] || break
        if [[ -n "$seen" ]]; then
          [[ "$first" != "$seen" ]] || break
        else
          [[ "$count" -lt "$prior" ]] || break
        fi
        replaced=1
        prior=0
      done
      envelopes="$(tail -n +2 <<<"$MAIL_OUT")"
    fi
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      if ! fields="$(jq -r '[.id // "", .kind // "", ((.options // []) | join(", ")), .from // "", .re // ""] | @tsv' <<<"$line")"; then
        die mail-read-invalid "" "item=$item" "value=envelope"
      fi
      id="${fields%%$'\t'*}"
      rest="${fields#*$'\t'}"
      kind="${rest%%$'\t'*}"
      rest="${rest#*$'\t'}"
      options="${rest%%$'\t'*}"
      rest="${rest#*$'\t'}"
      from="${rest%%$'\t'*}"
      re="${rest#*$'\t'}"
      case "$item:$kind" in
        # The overseer's own mailbox carries the owner's notes and its peers'.
        # A line with no sender is an older owner note, never a peer's. A peer
        # line carries its kind, because only an ask is owed a reply and an
        # answer to a directive would name an id in no outbox; `re=` rides an
        # answer, without which two replies from one peer are told apart by
        # their wording alone.
        overseer:*)
          if [[ -z "$from" || "$from" == owner ]]; then
            echo "EVENT owner-note $id"
          else
            echo "EVENT peer-note ${from#overseer:} $id kind=$kind${re:+ re=$re}"
          fi
          ;;
        *:ask) echo "EVENT lane-question $item $id" ;;
        # Only the lane writes this file, and it writes asks and notices; any
        # other kind is a line to show rather than a line to drop silently.
        *) echo "EVENT lane-notice $item $id" ;;
      esac
      if ! text="$(jq -r '.text // ""' <<<"$line")"; then
        die mail-read-invalid "" "item=$item" "value=text"
      fi
      # Every payload line is indented two spaces, so a message line spelling
      # `EVENT ...` never reads as a record: only the watch's own lines start
      # at the first column.
      [[ -z "$text" ]] || sed 's/^/  /' <<<"$text"
      # An ask's choices are the other half of the question; without this line
      # the overseer is asked to pick from a list it was never shown.
      [[ -z "$options" ]] || printf '  options: %s\n' "$options"
      PASS_EVENT=1
    done <<<"$envelopes"
    if [[ "$item" == overseer ]]; then
      state="$(lane_row_clear lane-failed "$state" "$item")"
      mail_row_commit "$state"
      continue
    fi
    # A read shorter than what was already drained moves no position, since
    # lowering it would report the lines between again once the file reads
    # whole.
    [[ "$replaced" -eq 0 && "$count" -lt "$prior" ]] \
      || state="$(lane_row_set lane-mail "$state" "$cursor" "$count $first")"
    # Committed here, per item and after its lines are out: a later mailbox
    # can fail without discarding this read, and a row left uncommitted would
    # re-report this item's messages on the re-run that follows.
    #
    # No prune, unlike every other row kind: those hold a pane key a pane
    # replaces, this one how far the overseer has read a lane's mailbox. An
    # item out of --item for one run and back in the next would otherwise
    # drain from zero and report every message that lane ever sent.
    mail_row_commit "$state"
    if ! mail_read "$item" receipts "${args[@]}"; then
      lane_failure_report "$item" "$state"
      mail_row_commit "$LANE_FAILURE_STATE"
      state="$MAIL_SEEN"
      continue
    fi
    header="${MAIL_OUT%%$'\n'*}"
    [[ "$header" =~ ^cursor=([0-9]+)\ count=[0-9]+\ first=([A-Za-z0-9._-]*)$ ]] \
      || die mail-read-invalid "" "item=$item" "value=${header:-<empty>}"
    lane_read="${BASH_REMATCH[1]}"
    to_first="${BASH_REMATCH[2]}"
    # `<read> <unread> <first>`: the cursor directive-read was last reported
    # up to, the last line reported directive-unread, and the id to-lane.jsonl
    # opened with. A lane with no row yet is taken as having read up to its
    # cursor, so a first pass does not replay every directive it ever read; a
    # replacement mailbox, or a cursor moved back, starts both counts over.
    if ! stored="$(lane_row_get directive "$state" "$cursor")"; then
      die state-read-failed "" "item=$item" "row=directive"
    fi
    read -r read_at unread_at seen <<<"$stored"
    if ! [[ "$read_at" =~ ^[0-9]+$ && "$unread_at" =~ ^[0-9]+$ ]]; then
      read_at="$lane_read"; unread_at=0
    elif [[ ( -n "$seen" && "$to_first" != "$seen" ) || "$lane_read" -lt "$read_at" ]]; then
      read_at=0; unread_at=0
    fi
    while read -r line id at; do
      [[ -n "$line" ]] || continue
      if [[ "$line" -le "$lane_read" ]]; then
        [[ "$line" -gt "$read_at" ]] || continue
        echo "EVENT directive-read $item $id"
        PASS_EVENT=1
      elif [[ "$line" -gt "$unread_at" && -n "$at" ]] && (( PASS_NOW - at >= UNREAD_SECS )); then
        echo "EVENT directive-unread $item $id age=$((PASS_NOW - at))"
        unread_at="$line"
        PASS_EVENT=1
      fi
    done <<<"$(tail -n +2 <<<"$MAIL_OUT")"
    state="$(lane_row_set directive "$state" "$cursor" "$lane_read $unread_at $to_first")"
    state="$(lane_row_clear lane-failed "$state" "$item")"
    mail_row_commit "$state"
  done
}

# Every payload the watch prints off a pane goes through here: blank lines are
# dropped and at most WATCH_TAIL_LINES survive — the LAST ones, because a
# dialog, a limit banner and a lane's closing report are all drawn at the
# bottom of what the pane holds. `|| true`: an all-blank block is a grep miss,
# and under pipefail that would abort the script mid-event.
bounded_tail() { # BLOCK
  grep -v '^[[:space:]]*$' <<<"$1" | tail -n "$WATCH_TAIL_LINES" || true
}

# Lines kept ABOVE the banner in a usage-limit block. A lane quoting another
# lane's wall marks the quotation in a sentence written as often above the
# banner as beside it ("gh-9 is parked; its screen showed:"), and that
# sentence is the whole difference between a wall to act on and one to leave
# alone. Clamped below the cap by banner_payload, which keeps the banner in
# the block whatever the cap is set to.
WATCH_BANNER_LEAD=3

# The payload a walled lane's event carries: a WINDOW around the banner,
# never a one-sided run. BANNER is lane_limit_banner's answer over SLICE, so
# where the banner is has ONE owner and this looks for none of its own.
#
# The judge matches a banner anywhere in the slice, so a block capped from the
# bottom trims one drawn further than the cap above the slice's end right back
# out, and a block opening on the banner drops the sentence above it that says
# whose words it is. Either way the event's whole handling — confirm the
# account spoke rather than a lane quoting a limit phrase, read the reset it
# states — has nothing to read. The window carries WATCH_BANNER_LEAD lines
# above the banner and the rest of the cap below, slides to whichever end of
# the slice it runs into, and holds the banner under every setting.
#
# Exit 1 is the judge and this disagreeing: an empty banner, or one this
# slice does not carry. Neither is a payload, and the caller refuses.
banner_payload() { # SLICE BANNER
  local first lines n at lead start end rc
  first="${2%%$'\n'*}"
  [[ -n "$first" ]] || return 1
  # Blanks go first, so the window counts the lines the overseer will read.
  rc=0; lines="$(grep -v '^[[:space:]]*$' <<<"$1")" || rc=$?
  [[ "$rc" -le 1 ]] || return "$rc"
  [[ -n "$lines" ]] || return 1
  # -xF: whole line, no pattern. The banner came out of this slice, so
  # re-spelling it as a regex here would be a second judge of where it is.
  rc=0; at="$(grep -nxF -- "$first" <<<"$lines")" || rc=$?
  [[ "$rc" -le 1 ]] || return "$rc"
  [[ -n "$at" ]] || return 1
  at="${at%%:*}"
  n="$(grep -c '' <<<"$lines")"
  # At most one line short of the cap, so the banner is never the line the
  # lead pushes out: a cap of 1 is the banner alone.
  lead="$WATCH_BANNER_LEAD"
  [[ "$lead" -lt "$WATCH_TAIL_LINES" ]] || lead=$((WATCH_TAIL_LINES - 1))
  start=$((at - lead))
  [[ "$start" -ge 1 ]] || start=1
  end=$((start + WATCH_TAIL_LINES - 1))
  # Run into the bottom and the window slides UP, spending the rest of the cap
  # on lines above the banner rather than emitting a short block.
  if [[ "$end" -gt "$n" ]]; then
    end="$n"
    start=$((end - WATCH_TAIL_LINES + 1))
    [[ "$start" -ge 1 ]] || start=1
  fi
  sed -n "${start},${end}p" <<<"$lines"
}

# A shell left in a worktree that has been removed draws these two lines on
# every prompt — the hook chain cannot run and nothing can resolve the cwd —
# so a lane that finished by deleting its own tree ends with a screen of them.
# They sit at the BOTTOM of the slice, where an unfiltered cap would keep them
# and drop the closing report, which is the one thing a lane-exited payload
# carries. That shell has the terminal back only once the harness under it is
# gone, so lane-exited is the only kind whose payload can hold them and the
# only one filtered. Anchored to the shapes that shell emits, so a report line
# merely QUOTING either is not touched: exited_noise supplies the two emitted
# shapes and exited_quotes_missing_path the quoted ones.
WATCH_NOISE_RE='^Hook failed:|^bash: cd: .*: No such file or directory'

# bounded_tail for the lane-exited payload, a lane's own closing report, with
# that prompt noise dropped first. A slice that is nothing but the noise
# prints one marker line instead of an empty block: an event with nothing
# under it would otherwise read as a lane that said nothing at all.
report_tail() { # BLOCK
  local lines kept count rc
  # Exit 1 is a grep miss, which is an answer: an all-blank block, or one the
  # filter emptied. Anything above it is the scan failing, which is no answer
  # at all — returned, so errexit stops the run rather than letting a failed
  # scan read as a lane with nothing to say.
  rc=0; lines="$(grep -v '^[[:space:]]*$' <<<"$1")" || rc=$?
  [[ "$rc" -le 1 ]] || return "$rc"
  [[ -n "$lines" ]] || return 0
  rc=0; kept="$(grep -Ev -- "$WATCH_NOISE_RE" <<<"$lines")" || rc=$?
  [[ "$rc" -le 1 ]] || return "$rc"
  if [[ -n "$kept" ]]; then
    tail -n "$WATCH_TAIL_LINES" <<<"$kept"
    return 0
  fi
  count="$(grep -c '' <<<"$lines")"
  printf 'payload-noise-only lines=%s\n' "$count"
}

# Said once per run, not per pass: the answer does not change under the watch.
LANE_PROBE_NOTED=0
note_probe_unusable() {
  [[ "$LANE_PROBE_NOTED" -eq 0 ]] || return 0
  LANE_PROBE_NOTED=1
  ow_message child-probe-failed "lane=$1" "exit=$LANE_PROBE_RC" >&2
}

# Drop KIND rows naming a lane this run does not watch. A row answers only for
# a lane under the watch; left to accumulate, one is a sighting nothing has
# looked at since, waiting for a window name to come back.
lane_row_prune() {
  local kind="$1" state="$2"
  shift 2
  # The lane list crosses in the environment, never through -v: it holds one
  # lane per line, and BWK awk — the awk macOS ships — refuses a -v value
  # carrying a newline outright ("awk: newline in string"), so every prune died
  # there and no lane event was ever emitted. ENVIRON takes the value whole.
  ow_lanes="$(printf '%s\n' "$@")" awk -F'\t' -v kind="$kind" '
    BEGIN { n = split(ENVIRON["ow_lanes"], a, "\n"); for (i = 1; i <= n; i++) watched[a[i]] = 1 }
    NF && !($1 == kind && !($2 in watched))
  ' <<<"$state"
}

# LANE_OBS columns are watch-list position, ready/gone, pane pid, current
# command, and server-plus-pane occurrence key. Capture bytes live in the file
# for that position. Position, not a filename slug, keeps arbitrary tmux window
# names from sharing one snapshot and classifying each other's screens.
LANE_OBS=""
LANE_TURNS=()
lane_field() { awk -F'\t' -v i="$2" -v field="$3" '$1 == i { print $field }' <<<"$1"; }
lane_obs_state() { lane_field "$1" "$2" 2; }
lane_pane_file() { printf '%s/pane.%s' "$WORK_DIR" "$1"; }

# Build one immutable lane snapshot for the pass. The final capture path is
# the success marker; a failed redirect leaves only a removed scratch file.
observe_lanes() {
  LANE_OBS=""
  LANE_TURNS=()
  [[ ${#LANES[@]} -gt 0 ]] || return 0
  local lane target pane below key prefix prior obs pid cmd capture errf i=0 state="${PW_SEEN[0]}"
  local banner banner_rc reset_key seen_at seen_pane seen_reported seen_key
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    capture="$(lane_pane_file "$i")"
    rm -f "$capture" "$capture.$$.tmp"
    if ! lane_window_listed "$lane"; then
      LANE_OBS+="$i"$'\t'"gone"$'\t\t\t\n'
      state="$(lane_row_clear lane-asking "$state" "$lane")"
      state="$(lane_row_clear usage-limit "$state" "$lane")"
      state="$(lane_row_clear model-capacity "$state" "$lane")"
      state="$(lane_row_clear lane-exited "$state" "$lane")"
      state="$(lane_row_clear lane-idle "$state" "$lane")"
      continue
    fi
    errf="$WORK_DIR/lane-probe.$i.err"
    target="$(lane_target "$lane")"
    obs="$(tmux display-message -p -t "$target" '#{pane_pid} #{pane_current_command}' 2>"$errf")" \
      || die pane-command-failed "$(cat "$errf")" "lane=$lane"
    [[ "$obs" =~ ^[0-9]+[[:blank:]]+[^[:space:]] ]] \
      || die pane-command-invalid "" "lane=$lane" "value=${obs:-<empty>}"
    key="$(tmux display-message -p -t "$target" '#{pid} #{pane_id}' 2>"$errf")" \
      || die pane-identity-failed "$(cat "$errf")" "lane=$lane"
    [[ "$key" =~ ^[0-9]+[[:blank:]]+%[^[:space:]]+$ ]] \
      || die pane-identity-invalid "" "lane=$lane" "value=${key:-<empty>}"
    # -J joins what tmux wrapped, as open-terminal already reads a pane:
    # without it a narrow window puts `resets ...` on a line of its own, which
    # is not a banner line, and the reset disappears with the pane's width.
    if ! tmux capture-pane -t "$target" -pJ >"$capture.$$.tmp" 2>"$errf"; then
      rm -f "$capture.$$.tmp"
      die pane-capture-failed "$(cat "$errf")" "lane=$lane"
    fi
    mv "$capture.$$.tmp" "$capture" || die pane-publish-failed "" "lane=$lane"
    pid="${obs%%[[:blank:]]*}"
    cmd="${obs#*[[:blank:]]}"
    LANE_OBS+="$i"$'\t'"ready"$'\t'"$pid"$'\t'"$cmd"$'\t'"$key"$'\n'
    pane="$(cat -- "$capture")"
    below="$(pane_below_last_turn "$pane")"
    prior="$(lane_row_get lane-asking "$state" "$lane")"
    prefix="${key}|$(pane_turn_identity "$pane")|"
    LANE_TURNS[$i]="${prefix}model-capacity"
    if ! grep -Eq -- "$LANE_ASKING_RE" <<<"$below" \
       || [[ -n "$prior" && "$prior" != "$prefix"* ]]; then
      state="$(lane_row_clear lane-asking "$state" "$lane")"
    fi
    # When this pass first sees a wall, stamp it: the row is what later lets a
    # dayless clause name a day. Stamped HERE, on every lane, rather than
    # where the event is emitted, because that path leaves on the first walled
    # lane and a second one would never be observed at all. Whether the banner
    # is a banner the lane has no turn in flight behind is lane_limit_banner's
    # one question, and both consumers ask it — which is as far as a screen
    # can settle it, so the event carries the slice the banner sits in and the
    # overseer confirms the account off that. A stamp answers for ONE wall on
    # ONE pane, so it carries the pane identity beside the wall and goes when
    # either changes. A banner naming no reset the grammar reads is stamped
    # too, with an empty reset key: the row is also where check_lanes records
    # that the wall was reported, and a wall with no row is one reported on
    # every run.
    banner_rc=0
    banner="$(lane_limit_banner "$below")" || banner_rc=$?
    [[ "$banner_rc" -ne 2 ]] || die limit-scan-failed "" "lane=$lane"
    reset_key="$(usage_reset_key "$banner")"
    prior="$(lane_row_get usage-limit "$state" "$lane")"
    if [[ -n "$banner" ]]; then
      seen_pane=""; seen_key=""
      [[ -z "$prior" ]] || IFS='|' read -r seen_at seen_pane seen_reported seen_key <<<"$prior"
      [[ "$seen_pane" == "$key" && "$seen_key" == "$reset_key" ]] \
        || state="$(lane_row_set usage-limit "$state" "$lane" "$PASS_NOW|$key||$reset_key")"
    else
      state="$(lane_row_clear usage-limit "$state" "$lane")"
    fi
  done
  state="$(lane_row_prune usage-limit "$state" "${LANES[@]}")"
  state="$(lane_row_prune model-capacity "$state" "${LANES[@]}")"
  state="$(lane_row_prune lane-exited "$state" "${LANES[@]}")"
  state="$(lane_row_prune lane-idle "$state" "${LANES[@]}")"
  lane_row_commit "$state"
}

# ---------------------------------------------------------------------------
# The overseer's own pane.
#
# Every check above answers about a LANE. Nothing answered about the session
# reading them: an overseer whose harness ended left its lanes working, this
# watch printing into a log with no reader, and the fleet unattended until a
# person happened to look at the window. The pane is the one place a watch can
# see that from, and it already has it — $TMUX_PANE is the overseer's own pane,
# inherited from the shell the overseer started this watch in.
#
# The judge is lib/lane-state.sh's, the same one every lane goes through, so a
# dead overseer and a dead lane are read by one set of rungs.
# ---------------------------------------------------------------------------

# Set once a successor holds the window of the overseer this pass recovered,
# dead or walled: the pass then ends at exit 3 without running the checks
# below it, so the mail the successor is meant to drain is not drained here
# first.
OVERSEER_SUCCEEDED=0
# Initial launch plus one later retry. This internal ceiling prevents a pane
# read dead or walled from launching successors forever when the host cannot
# start one.
OVERSEER_RELAUNCH_ATTEMPTS=2
# Repeat mode stops on notice-only recovery, an exhausted retry, or a
# recovery the fleet has no account for. A direct single pass keeps its
# documented status 0 for those outcomes.
OVERSEER_STOP=0
# The launch line for this pass, as the fleet state holds it or as this pass
# recorded it.
OVERSEER_LINE=""
# Notes are per run, and a repeat-mode pass IS a run, so each reason is said
# once per pass rather than once per lane read — the same bound
# note_probe_unusable keeps.
OVERSEER_NOTED=""
overseer_note() { # REASON FIELD=VALUE...
  grep -qxF -- "$1" <<<"$OVERSEER_NOTED" && return 0
  OVERSEER_NOTED+=$'\n'"$1"
  ow_message "$@" >&2
}

# The record carries no `at`: `workflow-state append-file` stamps the fleet
# log's time from its own clock, so the record written here and the one an
# overseer writes by hand are dated by one reader.
overseer_publish() { # NOTICE RECORD ERR_FILE
  local notice="$1" record="$2" errf="$3"
  if jq -n --rawfile text "$notice" \
       '{kind: "close", item: "overseer", text: ($text | rtrimstr("\n"))}' > "$record" 2>"$errf"
  then
    "$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} \
      append-file oversee fleet_log "$record" >/dev/null 2>"$errf" \
      || overseer_note overseer-notice-failed "channel=fleet-log"
  else
    overseer_note overseer-notice-failed "channel=fleet-log"
  fi
  "$LANE_MAIL" send --item overseer --directive --file "$notice" >/dev/null 2>"$errf" \
    || overseer_note overseer-notice-failed "channel=lane-mail"
}

# The notice every channel carries, written once into WORK_DIR: the fleet log
# reads it as the text of its record and the overseer mailbox as the body of an
# owner note, so the two cannot describe the case differently.
#
# KIND is `dead` or `walled`, the two cases check_overseer recovers from, and
# it decides three words and nothing else: the notice's own key, the reading
# that was taken, and how a relaunch describes where the successor's account
# came from. Every other plan reads the same for both, because the reason no
# successor opens is the same reason.
overseer_deliver() { # KIND PANE WINDOW SUCCESSION PLAN
  local kind="$1" notice="$WORK_DIR/overseer-$1.txt" record="$WORK_DIR/overseer-$1.json"
  local errf="$WORK_DIR/overseer-deliver.err" now plan_text reading relaunch_text
  now="$(from_epoch "$PASS_NOW" '%Y-%m-%dT%H:%M:%SZ')" || now=""
  if [[ "$kind" == walled ]]; then
    reading=walled
    relaunch_text='A successor is being launched into that window on an account the lane pick judged, never on the spent one.'
  else
    reading=exited
    relaunch_text='A successor is being launched into that window from the recorded launch line.'
  fi
  case "$5" in
    relaunch) plan_text="$relaunch_text" ;;
    off) plan_text='ORCH_OVERSEER_SUCCESSION is off, so no successor is launched; start one by hand.' ;;
    no-line) plan_text='The fleet state records no overseer launch line, so no successor is launched; start one by hand.' ;;
    no-launcher) plan_text='oversee-succeed is not installed, so no successor is launched; start one by hand.' ;;
    # Defensive: the four plans above are the whole set check_overseer calls
    # this with, for either case. A fifth would otherwise be described as one
    # of them, so it names itself rather than send a reason that is not the
    # one.
    *) plan_text="No successor is launched; the watch reported plan $5, which it has no wording for. Start one by hand." ;;
  esac
  printf 'overseer-%s: the overseer session in tmux window %s (pane %s) read %s on %s consecutive watch passes at %s. %s\n' \
    "$kind" "$3" "$2" "$reading" "$DEAD_PASSES" "${now:-an unreadable clock}" "$plan_text" > "$notice" \
    || { overseer_note overseer-notice-failed "channel=file"; return 0; }
  overseer_publish "$notice" "$record" "$errf"
}

# Exit 3 from the launcher is `lanes pick`'s own "no lane clears the bound",
# relayed by oversee-succeed: no account in the fleet has room for a
# successor. One notice on the two channels the recovery already uses, the row
# marked reported, and the repeat stops — the same ending notice-only recovery
# takes, because the bounded retry would walk the same accounts and refuse
# again.
#
# The account and the time it frees up are the account judgement's own fields,
# read off the one `--check-marks` line this pass already took and that
# confirmed the wall. Not derived from the banner: `lanes context` measured
# the headroom that confirmed it and names the bucket's own reset, so the
# figure the fleet waits on and the figure that established the wall are one
# reading. Either can be absent where that judgement named neither.
overseer_recovery_blocked() { # ROW ROWS IDENTITY PANE WINDOW
  local row="$1" rows="$2" identity="$3" pane="$4" window="$5"
  local notice="$WORK_DIR/overseer-blocked.txt" record="$WORK_DIR/overseer-blocked.json"
  local errf="$WORK_DIR/overseer-blocked.err"
  lane_row_commit "$(lane_row_set "$row" "$rows" "$identity" reported)"
  OVERSEER_STOP=1
  printf 'overseer-recovery-blocked: no account qualifies for a successor to the overseer in tmux window %s (pane %s). Its own account is %s and its binding bucket frees up at %s. The repeat stops; start a fresh overseer by hand once an account has room.\n' \
    "$window" "$pane" "${OVERSEER_MARK_ACCOUNT:-unknown}" "${OVERSEER_MARK_RESETS:-none}" > "$notice" \
    || { overseer_note overseer-notice-failed "channel=file"; return 0; }
  overseer_publish "$notice" "$record" "$errf"
  ow_message overseer-recovery-blocked "pane=$pane" \
    "account=${OVERSEER_MARK_ACCOUNT:-unknown}" "resets=${OVERSEER_MARK_RESETS:-none}" >&2
}

overseer_relaunch_failed() { # ROW ROWS IDENTITY PANE WINDOW ATTEMPT STEP
  local row="$1" rows="$2" identity="$3" pane="$4" window="$5" attempt="$6" step="$7"
  local retry=exhausted notice="$WORK_DIR/overseer-relaunch-failed.txt"
  local record="$WORK_DIR/overseer-relaunch-failed.json" errf="$WORK_DIR/overseer-relaunch-failed.err"
  if (( attempt < OVERSEER_RELAUNCH_ATTEMPTS )); then
    retry=pending
    rows="$(lane_row_set "$row" "$rows" "$identity" "pending:$attempt")"
  else
    rows="$(lane_row_set "$row" "$rows" "$identity" reported)"
    OVERSEER_STOP=1
  fi
  lane_row_commit "$rows"
  printf 'overseer-relaunch-failed: successor launch for tmux window %s (pane %s) failed on attempt %s; retry=%s; step=%s.\n' \
    "$window" "$pane" "$attempt" "$retry" "$step" > "$notice" \
    || { overseer_note overseer-notice-failed "channel=file"; return 0; }
  overseer_publish "$notice" "$record" "$errf"
  ow_message overseer-relaunch-failed "pane=$pane" "attempt=$attempt" "retry=$retry" "step=$step" >&2
}

# The overseer's own marks, judged by `oversee-succeed --check-marks`. ONE
# reading per pass, parsed once here, and the answer's fields left in globals
# for the two arms that read them: overseer_mark_check reports a crossing off
# it, and the walled arm asks it whether this pane's own ACCOUNT is the thing
# that ran out. The judgement is not remade in either: that script decides
# where both marks sit, which account row is this session's and what a reading
# that could not be taken means, and a second copy here would let the watch
# wake an overseer the succession would then tell to keep running.
#
# Memoised FOR ONE PASS because both arms can ask inside it — a wall the
# account refutes falls through to the live arm — and the judgement reads
# every account the fleet can launch on. Two readings there would pay that
# twice and could answer differently within one pass. Every long pass is a
# fork of the loop, which never judges the marks itself, so each pass starts
# with the memo unset and none outlives its pass: one invocation runs up to
# --max-loops passes an --interval apart, and a memo that outlived the pass
# would answer all of them with the first one's reading, leaving the fleet
# unattended — a wall landing after pass 1 refuted against the stale
# below-mark reading, a stale mark-reached closing a live window, a failed
# judgement disabling both arms, a lifted mark never clearing its row.
#
# OVERSEER_MARK_KEY is the answer's own key, `mark-reached`, `mark-unmeasured`
# or `below-mark` for either of the two below-mark lines; the KIND, VALUE,
# MARK, ACCOUNT and RESETS globals are its fields, empty where the line
# carries none. Exit 1 means no judgement was made at all, the note already
# said once, and nothing may be concluded from any of them.
OVERSEER_MARK_KEY=""
OVERSEER_MARK_KIND=""
OVERSEER_MARK_VALUE=""
OVERSEER_MARK_MARK=""
OVERSEER_MARK_SUCCESSION=on
OVERSEER_MARK_ACCOUNT=""
OVERSEER_MARK_RESETS=""
OVERSEER_MARK_READ=0
OVERSEER_MARK_RC=1

# bounded_account_read REASON ERR_FILE COMMAND... — one account reader of a
# pass: COMMAND runs under READ_CEILING with the usage age LANES_MAX_AGE names,
# its stdout lands in BOUNDED_OUT and its stderr in ERR_FILE, which the caller
# weighs. A failure or an overrun is noted once under REASON, naming the reader
# and its exit or the seconds it was given, and returns that status.
# Stock macOS ships no `timeout`, and without it the read runs unbounded: the
# pass then delays every other event it carries, which is the outcome this
# ceiling exists to bound and not one it can prevent there. The ceiling sends
# TERM alone, never KILL, which `lanes` relies on to finish a token renewal it
# has already posted.
BOUNDED_OUT=""
bounded_account_read() {
  local reason="$1" errf="$2" rc=0 BOUND_BY=()
  shift 2
  BOUNDED_OUT=""
  ! command -v timeout >/dev/null 2>&1 || BOUND_BY=(timeout "$READ_CEILING")
  BOUNDED_OUT="$(ORCH_LANES_USAGE_MAX_AGE="$LANES_MAX_AGE" ${BOUND_BY[@]+"${BOUND_BY[@]}"} "$@" 2>"$errf")" || rc=$?
  (( rc != 0 )) || return 0
  if [[ "$rc" -eq 124 ]]; then
    overseer_note "$reason" "path=$1" "seconds=$READ_CEILING"
  else
    overseer_note "$reason" "path=$1" "exit=$rc"
  fi
  return "$rc"
}

overseer_marks_judge() {
  local line first field
  local errf="$WORK_DIR/overseer-mark.err"
  [[ "$OVERSEER_MARK_READ" -eq 0 ]] || return "$OVERSEER_MARK_RC"
  OVERSEER_MARK_READ=1
  # Every field belongs to THIS reading. Cleared before the line is parsed,
  # never after it: an answer omitting `account` or `resets` would otherwise
  # leave an earlier pass's values standing, and overseer_recovery_blocked
  # would name an account this judgement did not.
  OVERSEER_MARK_KEY=""
  OVERSEER_MARK_KIND=""
  OVERSEER_MARK_VALUE=""
  OVERSEER_MARK_MARK=""
  OVERSEER_MARK_SUCCESSION=on
  OVERSEER_MARK_ACCOUNT=""
  OVERSEER_MARK_RESETS=""
  if [[ ! -x "$SUCCEED" ]]; then
    overseer_note overseer-mark-unjudged "path=$SUCCEED" "setting=OVERSEE_WATCH_SUCCEED"
    return 1
  fi
  # `lanes context` inside that judgement waits on a credentials lock and a
  # usage endpoint per account, and on a cache miss on the host-wide usage
  # refresh lock and a 429 retry's sleep and second request, which together can
  # outlast the pass interval.
  if ! bounded_account_read overseer-mark-unjudged "$errf" "$SUCCEED" --check-marks; then
    [[ ! -s "$errf" ]] || cat -- "$errf" >&2
    return 1
  fi
  line="$BOUNDED_OUT"
  first="${line%%$'\n'*}"
  case "$first" in
    'oversee-succeed: mark-reached '*) OVERSEER_MARK_KEY=mark-reached ;;
    'oversee-succeed: mark-unmeasured '*) OVERSEER_MARK_KEY=mark-unmeasured ;;
    'oversee-succeed: window-below-mark '* | 'oversee-succeed: context-below-mark '*)
      OVERSEER_MARK_KEY=below-mark ;;
    # A line this watch has no name for settles nothing, exactly as a run that
    # failed does: it is not a mark, and it is not evidence that one lifted.
    *) overseer_note overseer-mark-unjudged "path=$SUCCEED" "line=$first"; return 1 ;;
  esac
  for field in $first; do
    case "$field" in
      kind=*) OVERSEER_MARK_KIND="${field#kind=}" ;;
      value=*) OVERSEER_MARK_VALUE="${field#value=}" ;;
      mark=*) OVERSEER_MARK_MARK="${field#mark=}" ;;
      succession=*) OVERSEER_MARK_SUCCESSION="${field#succession=}" ;;
      account=*) OVERSEER_MARK_ACCOUNT="${field#account=}" ;;
      resets=*) OVERSEER_MARK_RESETS="${field#resets=}" ;;
    esac
  done
  OVERSEER_MARK_RC=0
  return 0
}

# Whether the screen's `walled` reading is the OVERSEER'S OWN account and not
# one it reported about a lane. The overseer's pane is the one pane in a fleet
# that routinely carries another lane's limit banner: this watch relays
# banner_payload into the overseer's transcript under every usage-limit event,
# and the overseer writes its own prose about that wall under it. The `walled`
# rung is a grep for the banner text below the last turn, so over this pane it
# cannot tell the two apart — and acting on it closes a window whose harness is
# alive.
#
# So the screen never decides alone. The account's own measurement is the
# second reading, taken from the one judge that owns it, and the answer that
# confirms the wall is that judge's own account mark: `mark-reached
# kind=headroom` is reached exactly when this session's account sits at or
# below ORCH_OVERSEER_HEADROOM_PCT. No figure is compared here, so no rule is
# copied. Every other answer, a judgement that could not be made included,
# leaves the wall unconfirmed and the pane read as the working overseer it
# looks like everywhere else.
overseer_wall_confirmed() { # PANE
  overseer_marks_judge || { overseer_note overseer-wall-unjudged "pane=$1"; return 1; }
  [[ "$OVERSEER_MARK_KEY" == mark-reached && "$OVERSEER_MARK_KIND" == headroom ]] && return 0
  overseer_note overseer-wall-unconfirmed "pane=$1" "answer=$OVERSEER_MARK_KEY" \
    "kind=${OVERSEER_MARK_KIND:-none}"
  return 1
}

# The crossing reported off that one reading.
#
# Sets OVERSEER_MARK_ROWS to the baseline the caller commits. A standing mark is
# one row keyed by `<server> <pane>`, holding the kind and the passes since it
# was last reported: the first crossing is reported, then every MARK_REPEAT
# passes while it stands. Only a below-mark line clears that row. A judgement
# that could not be made, and one whose reading that script reports as
# unmeasured, both leave the row exactly as it was — an unread mark is never
# evidence that the mark lifted.
OVERSEER_MARK_ROWS=""
overseer_mark_check() { # ROWS IDENTITY PANE
  local rows="$1" identity="$2" pane="$3" prior passes
  local kind value mark succession
  # One overseer at a time, so a pane that was the overseer and is not any more
  # — a succession, a fleet restarted in another window — leaves no row behind
  # for a pane id tmux will hand out again.
  rows="$(lane_row_prune overseer-mark "$rows" "$identity")"
  OVERSEER_MARK_ROWS="$rows"
  overseer_marks_judge || return 0
  # A reading that could not be taken is that script's own `mark-unmeasured`,
  # and it settles nothing here: the row stands, so a standing mark keeps its
  # place in the repeat count instead of coming back as a fresh crossing on the
  # next pass that could measure.
  if [[ "$OVERSEER_MARK_KEY" == mark-unmeasured ]]; then
    overseer_note overseer-mark-unjudged "path=$SUCCEED" "kind=${OVERSEER_MARK_KIND:-none}"
    return 0
  fi
  # A below-mark line is the one answer that clears the row: both readings were
  # taken and neither fired, so the overseer has room again or has already
  # handed over into a pane this key no longer names.
  if [[ "$OVERSEER_MARK_KEY" != mark-reached ]]; then
    OVERSEER_MARK_ROWS="$(lane_row_clear overseer-mark "$rows" "$identity")"
    return 0
  fi
  kind="$OVERSEER_MARK_KIND"; value="$OVERSEER_MARK_VALUE"
  mark="$OVERSEER_MARK_MARK"; succession="$OVERSEER_MARK_SUCCESSION"
  # A mark-reached line missing one of its three fields is a judgement this
  # watch cannot report, and reporting it half-formed would send the overseer
  # to a succession over a figure nothing named. The row stands, as it does for
  # a reading that failed outright.
  if [[ -z "$kind" || -z "$value" || -z "$mark" ]]; then
    overseer_note overseer-mark-unjudged "path=$SUCCEED" "kind=${kind:-none}"
    return 0
  fi
  # A row read that failed settles nothing either, for the reason the arm above
  # gives: it is not a mark, and it is not evidence that one lifted.
  if ! prior="$(lane_row_get overseer-mark "$rows" "$identity")"; then
    overseer_note overseer-mark-unjudged "path=$SUCCEED" "row=overseer-mark"
    return 0
  fi
  passes=0
  if [[ "$prior" == "$kind|"* ]]; then
    passes=$(( ${prior#*|} + 1 ))
    (( passes < MARK_REPEAT )) || passes=0
  fi
  if (( passes == 0 )); then
    echo "EVENT overseer-mark $pane kind=$kind value=$value mark=$mark succession=$succession"
    if [[ "$succession" == off ]]; then
      echo "ORCH_OVERSEER_SUCCESSION is off, so no successor opens: rewrite the overseer handoff file and ask the user to start a fresh overseer session."
    else
      echo "Run $SUCCEED -- [FLAGS] at the next safe point, with ORCH_OVERSEER_PREFERENCE=${ORCH_OVERSEER_PREFERENCE:-empty} choosing the successor lane."
    fi
    PASS_EVENT=1
  fi
  OVERSEER_MARK_ROWS="$(lane_row_set overseer-mark "$rows" "$identity" "$kind|$passes")"
}

check_overseer() {
  local pane="${TMUX_PANE:-}" window obs pid cmd screen state prior count succession plan
  local ov_line pane_identity server actual_pane identity rows attempt completed
  local ov_case row other succeed_rc below banner banner_rc
  local errf="$WORK_DIR/overseer.err"
  # Off tmux there is no overseer pane to read, and with no workflow-state
  # there is nowhere to record one: either way an overseer that dies is
  # reported by nothing, which is said rather than left silent.
  [[ -n "${TMUX:-}" && -n "$pane" ]] \
    || { overseer_note overseer-unwatched "var=TMUX_PANE"; return 0; }
  [[ -x "$WORKFLOW_STATE" ]] \
    || { overseer_note overseer-unwatched "path=$WORKFLOW_STATE" "setting=OVERSEE_WATCH_WORKFLOW_STATE"; return 0; }
  ov_line="$("$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} \
    get oversee '.overseer.launch_line // ""' 2>"$errf")" \
    || { overseer_note overseer-unwatched "state=oversee"; return 0; }

  window="$(tmux display-message -p -t "$pane" '#{window_id}' 2>"$errf")" \
    || { overseer_note overseer-unreadable "pane=$pane" "field=window_id"; return 0; }
  if ! pane_identity="$(tmux display-message -p -t "$pane" '#{pid} #{pane_id}' 2>"$errf")"; then
    overseer_note overseer-unreadable "pane=$pane" "field=identity"
    return 0
  fi
  [[ "$pane_identity" =~ ^([0-9]+)[[:blank:]]+(%[0-9]+)$ ]] \
    || { overseer_note overseer-unreadable "pane=$pane" "field=identity" "value=${pane_identity:-<empty>}"; return 0; }
  server="${BASH_REMATCH[1]}"
  actual_pane="${BASH_REMATCH[2]}"
  [[ "$actual_pane" == "$pane" ]] \
    || { overseer_note overseer-unreadable "pane=$pane" "field=identity" "value=$pane_identity"; return 0; }
  identity="$server $pane"
  if ! obs="$(tmux display-message -p -t "$pane" '#{pane_pid} #{pane_current_command}' 2>"$errf")"; then
    overseer_note overseer-unreadable "pane=$pane" "field=pane_pid"
    return 0
  fi
  [[ "$obs" =~ ^[0-9]+[[:blank:]]+[^[:space:]] ]] \
    || { overseer_note overseer-unreadable "pane=$pane" "value=${obs:-<empty>}"; return 0; }
  screen="$(tmux capture-pane -pJ -t "$pane" 2>"$errf")" \
    || { overseer_note overseer-unreadable "pane=$pane" "field=capture"; return 0; }

  # The watch invocation recorded this current session's command before its
  # first pass. Once the pane is dead, that last live-owned record is the only
  # source that still knows its account, model and permission flags.
  OVERSEER_LINE="$ov_line"

  pid="${obs%%[[:blank:]]*}"
  cmd="${obs#*[[:blank:]]}"
  # The sixth argument is empty for the reason check_lanes gives: this watch's
  # vantage point is the pane, and a screen the pane rungs cannot settle is
  # `unjudged`, never `exited`.
  lane_state state listed "$cmd" "$pid" "$screen" \
    || { overseer_note overseer-unreadable "pane=$pane" "scan=usage-limit"; return 0; }
  [[ "$LANE_PROBE_RC" -le 1 ]] || note_probe_unusable "$pane"

  # The two readings this check acts on, named once and matched by name below.
  # `exited` is the harness gone; `walled` is the account spent under a harness
  # still running, which takes no turn, so it answers no lane, reads no mail
  # and cannot hand itself over — the same unattended fleet a death leaves,
  # reached by the other road. Every other reading is an overseer still
  # working, and nothing here touches it.
  ov_case=""
  case "$state" in
    exited) ov_case=dead ;;
    walled) ov_case=walled ;;
  esac
  # The screen's wall is one reading, and over THIS pane it is not enough on
  # its own: overseer_wall_confirmed says why, and asks the account judgement
  # that settles it. A wall the account refutes leaves the pane exactly where
  # a healthy reading leaves it, below — mark reported, rows cleared, the pass
  # carrying on — because that is what the pane is.
  [[ "$ov_case" != walled ]] || overseer_wall_confirmed "$pane" || ov_case=""
  # One row per case, keyed by server plus pane: `<count>` while readings
  # accumulate, `pending:N` after a failed launch, and `reported` after
  # notice-only or the bounded recovery attempts are spent.
  rows="$(lane_row_prune overseer-dead "${PW_SEEN[0]}" "$identity")"
  rows="$(lane_row_prune overseer-walled "$rows" "$identity")"
  if [[ -z "$ov_case" ]]; then
    rows="$(lane_row_clear overseer-dead "$rows" "$identity")"
    rows="$(lane_row_clear overseer-walled "$rows" "$identity")"
    # A working overseer is the only one with marks to judge: neither a dead
    # nor a walled one runs a turn, so its context and its account settle
    # nothing and its case is the event the branch below carries.
    overseer_mark_check "$rows" "$identity" "$pane"
    lane_row_commit "$OVERSEER_MARK_ROWS"
    return 0
  fi
  case "$ov_case" in
    dead) row=overseer-dead; other=overseer-walled ;;
    *) row=overseer-walled; other=overseer-dead ;;
  esac
  # The other case's row goes with it: a pane that read walled and then exited
  # is one session recovered from one case, and a count carried across the two
  # would fire a death on a threshold a wall ran up.
  rows="$(lane_row_clear "$other" "$rows" "$identity")"
  # A standing mark belongs to the session that reached it, and that session is
  # the one just read dead or walled. `overseer_mark_check` is the only place a
  # mark row is cleared and this path never runs it, so without this the row is
  # committed back on every such pass: a replacement in this same pane would
  # then read the old session's repeat count and wait out its remainder before
  # its own first crossing is reported.
  rows="$(lane_row_clear overseer-mark "$rows" "$identity")"
  if ! prior="$(lane_row_get "$row" "$rows" "$identity")"; then
    die state-read-failed "" "pane=$pane" "row=$row"
  fi
  if [[ "$prior" == reported ]]; then
    OVERSEER_STOP=1
    lane_row_commit "$rows"
    return 1
  fi
  if [[ "$prior" =~ ^pending:([0-9]+)$ ]]; then
    completed="${BASH_REMATCH[1]}"
    attempt=$((completed + 1))
    (( attempt <= OVERSEER_RELAUNCH_ATTEMPTS )) \
      || { lane_row_commit "$(lane_row_set "$row" "$rows" "$identity" reported)"; return 1; }
  else
    [[ -z "$prior" || "$prior" =~ ^[0-9]+$ ]] \
      || die state-read-failed "" "pane=$pane" "row=$row" "value=$prior"
    count=1
    [[ -z "$prior" ]] || count=$((prior + 1))
    if (( count < DEAD_PASSES )); then
      lane_row_commit "$(lane_row_set "$row" "$rows" "$identity" "$count")"
      return 1
    fi
    attempt=1
  fi
  succession=on
  [[ "${ORCH_OVERSEER_SUCCESSION:-on}" != off ]] || succession=off
  plan=relaunch
  if [[ "$succession" == off ]]; then plan=off
  elif [[ ! -x "$SUCCEED" ]]; then plan=no-launcher
  # The recorded line is the dead case's whole choice of successor. The walled
  # case picks its own lane and builds its own line, so a fleet state with none
  # recorded does not stop it.
  elif [[ "$ov_case" == dead && -z "$OVERSEER_LINE" ]]; then plan=no-line
  fi
  if [[ "$prior" != pending:* ]]; then
    if [[ "$plan" == relaunch ]]; then
      lane_row_commit "$(lane_row_set "$row" "$rows" "$identity" pending:0)"
    else
      lane_row_commit "$(lane_row_set "$row" "$rows" "$identity" reported)"
    fi
    echo "EVENT $row $pane window=$window passes=$DEAD_PASSES succession=$succession"
    # The wall's own window under the line, as every lane usage-limit event
    # carries one: the overseer's handling reads the banner with the screen on
    # both sides of it, and the reader of THIS event has the same question
    # about the same text. Asked of the same judge over the same slice the
    # `walled` rung read, so the two cannot disagree; a disagreement stops the
    # pass under the reasons check_lanes gives them.
    if [[ "$ov_case" == walled ]]; then
      below="$(pane_below_last_turn "$screen")"
      banner_rc=0
      banner="$(lane_limit_banner "$below")" || banner_rc=$?
      [[ "$banner_rc" -ne 2 ]] || die limit-scan-failed "" "pane=$pane"
      [[ -n "$banner" ]] || die limit-banner-missing "" "pane=$pane"
      banner_payload "$below" "$banner" || die limit-banner-missing "" "pane=$pane"
    fi
    PASS_EVENT=1
    overseer_deliver "$ov_case" "$pane" "$window" "$succession" "$plan"
  fi
  if [[ "$plan" != relaunch ]]; then
    OVERSEER_STOP=1
    [[ "$prior" != pending:* ]] \
      || overseer_relaunch_failed "$row" "$rows" "$identity" "$pane" "$window" "$attempt" "plan-$plan"
    return 1
  fi

  # Its stdout joins its stderr: this watch's stdout is the event protocol, and
  # oversee-succeed's own keyed lines are the detail under the event, not
  # records of their own. The walled recovery's stdout carries the command it
  # built as well, so the pass output says which line it sent.
  succeed_rc=0
  if [[ "$ov_case" == walled ]]; then
    overseer_launch_args
    "$SUCCEED" --walled-pane "$pane" "${OVERSEER_LAUNCH_ARGS[@]}" >&2 || succeed_rc=$?
  else
    printf '%s\n' "$OVERSEER_LINE" > "$WORK_DIR/overseer-line" \
      || { overseer_relaunch_failed "$row" "$rows" "$identity" "$pane" "$window" "$attempt" line-file; return 1; }
    "$SUCCEED" --dead-pane "$pane" --line-file "$WORK_DIR/overseer-line" >&2 || succeed_rc=$?
  fi
  # Exit 3 is that script's own "no account qualifies", which a retry cannot
  # improve on; every other non-zero status is this launch failing and takes
  # the bounded retry. The dead path picks no lane, so it never answers 3.
  case "$succeed_rc" in
    0) OVERSEER_SUCCEEDED=1 ;;
    3) overseer_recovery_blocked "$row" "$rows" "$identity" "$pane" "$window" ;;
    *) overseer_relaunch_failed "$row" "$rows" "$identity" "$pane" "$window" "$attempt" launcher ;;
  esac
  return 1
}

check_lanes() {
  # No lane to watch still leaves the items: a handoff is read from state.
  [[ ${#LANES[@]} -gt 0 ]] || { check_handoff; return 0; }
  local lane pane below cmd pid state window i states="" claims="" claimed pane_key
  local seen seen_at seen_pane seen_reported seen_key reset_at reset_utc reset_note event
  local asking_state fingerprint prior turn_identity capacity capacity_key screen_key close_failed=0
  local banner banner_rc
  # One liveness read and one pane capture per lane per pass: a lane's kind is
  # decided from a single observation, never from two screens taken apart. The
  # pid leads the format so a command carrying a space cannot shift the split.
  # The kind itself is lib/lane-state.sh's, the one judge `open-terminal
  # --wake` also asks, so the two read one pane by one set of rungs instead of
  # inventing a classification each. Every loop below reads its verdict out of
  # `states` and classifies nothing of its own.
  #
  # The sixth argument, the harness process read through /proc, is empty here:
  # the watch's whole vantage point is the tmux pane, and a hosted lane's
  # harness runs on another machine anyway. With it empty the judge answers
  # `unjudged` for a screen its pane rungs cannot settle, where the wake, which
  # does pass it, can still answer.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    window=gone; pid=""; cmd=""; pane=""
    if [[ "$(lane_obs_state "$LANE_OBS" "$i")" == ready ]]; then
      window=listed
      pid="$(lane_field "$LANE_OBS" "$i" 3)"
      cmd="$(lane_field "$LANE_OBS" "$i" 4)"
      pane="$(cat -- "$(lane_pane_file "$i")")"
    fi
    # The judge exits 2 on exactly one condition, a banner scan that failed,
    # and observe_lanes already ran that scan over this slice of this capture
    # file and died `limit-scan-failed` on it. So this refuses the same
    # condition under the same reason rather than inventing a second one, and
    # in an ordinary pass it is unreachable: the status is checked because a
    # verdict nothing looked at is how a lane gets read as having no news.
    lane_state state "$window" "$cmd" "$pid" "$pane" \
      || die limit-scan-failed "" "lane=$lane"
    # A probe that could not run is not an answer: the judge falls through to
    # the screen, a lane it cannot classify stays watched, and the status is
    # noted once — a wrong lane-exited retires a working lane while a missed
    # one costs a pass.
    [[ "$LANE_PROBE_RC" -le 1 ]] || note_probe_unusable "$lane"
    states+="$i"$'\t'"$state"$'\n'
    if [[ "$state" == gone ]]; then
      echo "EVENT window-gone $lane"
      PASS_EVENT=1
    fi
  done
  # A lane window outlives its harness: open-terminal runs claude/codex inside
  # a shell, so a session that hit its limit, crashed, or quit leaves the
  # shell in the foreground — a window that exists, a pane that matches no
  # question prompt, and a slot held until someone looks. A bare shell with
  # nothing running under it IS that lane, finished; its closing lines carry
  # why. Two consecutive passes: a live harness can hold a childless shell in
  # the foreground for one poll, and relaunching a working lane costs more
  # than one interval. The first pass is a `lane-exited` row keyed by the
  # pane, so the second can be the next run's first; that second pass marks
  # the row reported, so a later run over the same pane stays silent, and a
  # replacement pane starts over and is news again.
  asking_state="${PW_SEEN[0]}"
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_obs_state "$states" "$i")" != exited ]]; then
      asking_state="$(lane_row_clear lane-exited "$asking_state" "$lane")"
      continue
    fi
    pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
    prior="$(lane_row_get lane-exited "$asking_state" "$lane")"
    if [[ "$prior" == "$pane_key|reported" ]]; then continue; fi
    if [[ "$prior" == "$pane_key" ]]; then
      asking_state="$(lane_row_set lane-exited "$asking_state" "$lane" "$pane_key|reported")"
      echo "EVENT lane-exited $lane"
      pane="$(cat -- "$(lane_pane_file "$i")")"
      # What the lane said before it stopped, which is the whole handling of
      # this event. Only below its last user turn: an exited lane's screen
      # keeps every turn that fits, and the ones above the last are a
      # transcript the overseer is not being asked to read. The slice is
      # assigned rather than substituted into the call, so a failing awk
      # aborts the run instead of printing an empty payload.
      below="$(pane_below_last_turn "$pane")"
      report_tail "$below"
      PASS_EVENT=1
      asking_state="$(lane_row_clear lane-asking "$asking_state" "$lane")"
      # A worktree still standing is a lane stopped inside merge-pr.md § 5,
      # which the overseer resumes; its sandbox closes on the exit after that.
      hosted_lane_item "$lane"
      if [[ -n "$HOSTED_ROOT" && -n "$(lane_row_get merged "$asking_state" "$LANE_ITEM")" ]] \
         && grep -qxF -- "$LANE_ITEM" <<<"$HOSTED_GONE_ITEMS"; then
        # Committed before the close, which cannot be undone: a run that stops
        # after a close must not close this lane a second time.
        lane_row_commit "$asking_state"
        if ! close_hosted_lane "$LANE_ITEM"; then
          # Left unreported, so the next run reports this exit and retries.
          asking_state="$(lane_row_set lane-exited "$asking_state" "$lane" "$pane_key")"
          close_failed=1
        fi
      fi
    else
      asking_state="$(lane_row_set lane-exited "$asking_state" "$lane" "$pane_key")"
    fi
  done
  lane_row_commit "$asking_state"
  check_handoff
  # check_handoff commits its rows through PW_SEEN; a copy taken before it
  # would write them back out on the next commit below.
  asking_state="${PW_SEEN[0]}"
  # The harness is still running and the account is spent: every lane on that
  # account dies with it, so the config dir is the actionable part and a live
  # claim is where it is recorded. A walled lane is neither asking nor idle: a
  # limit banner can sit above a stale prompt, and the account is the news, so
  # the two loops below skip it. One pass: a banner is terminal for that
  # account window, not a screen a poll can catch mid-draw. Only below the last
  # user turn: a banner the lane has since worked past is the screen
  # remembering a spent window that has since reset.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_obs_state "$states" "$i")" != walled ]]; then continue; fi
    pane="$(cat -- "$(lane_pane_file "$i")")"
    pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
    # The banner states when the wall lifts, and that decides which event
    # this is. A reset already behind us means the lane is parked against a
    # window that has since reopened — the harness will not notice on its
    # own — so it is bumped, not waited on. The wall's day comes from the
    # row observe_lanes stamped, never from the banner: with no row, or with
    # a reset `date` would not resolve, the plain event goes out with no
    # time on it and the lane is parked. `resets=` is keyed rather than
    # positional because the config dir before it is optional.
    if ! seen="$(lane_row_get usage-limit "$asking_state" "$lane")"; then
      die state-read-failed "" "lane=$lane" "row=usage-limit"
    fi
    seen_at=""; seen_pane=""; seen_reported=""; seen_key=""
    [[ -z "$seen" ]] || IFS='|' read -r seen_at seen_pane seen_reported seen_key <<<"$seen"
    reset_at=""
    [[ -z "$seen_key" ]] || reset_at="$(usage_reset_epoch "$seen_key" "$seen_at")"
    event=usage-limit
    reset_note=""
    reset_utc=""
    [[ -z "$reset_at" ]] || reset_utc="$(from_epoch "$reset_at" '%Y-%m-%dT%H:%M:%SZ' || true)"
    if [[ -n "$reset_utc" ]]; then
      reset_note=" resets=$reset_utc"
      [[ "$reset_at" -gt "$PASS_NOW" ]] || event=usage-limit-passed
    fi
    # The wall was reported on an earlier pass and nothing about it has
    # changed: the row is observe_lanes's stamp for this pane and this
    # wall, and the reported column names the event it went out as. The
    # lane stays walled above; a reset going by turns the event into
    # usage-limit-passed, which is news once more.
    if [[ "$seen_reported" == "$event" ]]; then continue; fi
    # The detail is a nicety; a claim store this process cannot read must
    # not take down the event that carries the payload. Read here, below
    # the suppression, so its note qualifies a line that is going out.
    claims="$(lane_claims_read "$(lane_claims_dir "$PROJECT_ROOT")" || true)"
    # Claims are kept for every live tmux server, and a window NAME is
    # unique only within a session: the account is resolved on the pane
    # actually captured here — `<server pid> <pane id>`, the same key the
    # claim's liveness uses — so no other lane can answer for it.
    # An unreadable claim store is already tolerated above; a resolver that
    # fails on a readable one is not the same thing, and the event goes out
    # without an account rather than with another lane's.
    claimed="$(lane_claims_config_dir "$claims" "${pane_key%% *}" "${pane_key##* }")" || claimed=""
    if [[ -z "$claimed" && -n "$claims" ]]; then
      ow_message claim-missing "lane=$lane" >&2
    fi
    # The banner and the lines under it, never the banner alone: the handling
    # (../references/oversee-events.md § Event kinds) is confirming the
    # account is what spoke rather than a lane quoting a limit phrase in its
    # own output, and one matched line settles nothing — the sentence that
    # marks a quotation is written above the banner as often as beside it,
    # which is why the block is a window around it. Asked of the same
    # judge over the same slice that classified the lane, and asked BEFORE
    # the event line, so a disagreement stops the pass instead of printing
    # half an event. The `walled` rung read this judge over this slice, so an
    # empty answer is the two disagreeing and is never a payload to print.
    # The anchor lookup below cannot miss once the answer is non-empty, since
    # the banner is lines of this slice; its refusal is the assertion of that,
    # and it is the one that can land under an event line already out.
    below="$(pane_below_last_turn "$pane")"
    banner_rc=0
    banner="$(lane_limit_banner "$below")" || banner_rc=$?
    [[ "$banner_rc" -ne 2 ]] || die limit-scan-failed "" "lane=$lane"
    [[ -n "$banner" ]] || die limit-banner-missing "" "lane=$lane"
    echo "EVENT $event $lane${claimed:+ $claimed}$reset_note"
    banner_payload "$below" "$banner" || die limit-banner-missing "" "lane=$lane"
    PASS_EVENT=1
    asking_state="$(lane_row_set usage-limit "$asking_state" "$lane" "${seen_at:-$PASS_NOW}|${seen_pane:-$pane_key}|$event|$seen_key")"
  done
  # A pane keeps its last screen, so neither a stale prompt under a bare shell
  # nor a dialog answered passes ago is a live question. A current prompt is
  # keyed by its pane slice across watch invocations: emit it once, clear the
  # key when it disappears, and emit again only when the prompt changes.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    # A lane that is up and not asking drops its row; one that is walled,
    # exited or unjudged keeps it. A wall can sit above a standing question,
    # and the row is what stops the question being re-reported once the wall
    # lifts; gone and exited clear it on their own paths.
    case "$(lane_obs_state "$states" "$i")" in
      asking) ;;
      working|idle)
        asking_state="$(lane_row_clear lane-asking "$asking_state" "$lane")"
        continue ;;
      *) continue ;;
    esac
    pane="$(cat -- "$(lane_pane_file "$i")")"
    below="$(pane_below_last_turn "$pane")"
    pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
    turn_identity="$(pane_turn_identity "$pane")"
    fingerprint="${pane_key}|${turn_identity}|$(printf '%s' "$below" | cksum)"
    if ! prior="$(lane_row_get lane-asking "$asking_state" "$lane")"; then
      die state-read-failed "" "lane=$lane" "row=lane-asking"
    fi
    asking_state="$(lane_row_set lane-asking "$asking_state" "$lane" "$fingerprint")"
    if [[ "$fingerprint" == "$prior" ]]; then continue; fi
    echo "EVENT lane-asking $lane"
    # The dialog, which is what gets answered. It is the bottom of the slice
    # the question was found in, so the cap trims the turn above it and not
    # the rows.
    bounded_tail "$below"
    PASS_EVENT=1
  done
  # The round is over and nobody is driving: the harness is up, at its input
  # prompt, with nothing in flight. Two consecutive passes, because the screen
  # between a finished tool call and the next one reads the same; the first is
  # a `lane-idle` row keyed by the pane and the slice below its last turn, as
  # for lane-exited above. The second pass reports it and marks the row, so a
  # lane left sitting at the same screen is reported once, however many runs
  # look at it; a turn taken changes the slice and starts the count over. A
  # lane that is walled, asking, working or exited is not idle and drops its
  # row.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    capacity=0
    if [[ "$(lane_obs_state "$states" "$i")" == idle ]]; then
      pane="$(cat -- "$(lane_pane_file "$i")")"
      below="$(pane_below_last_turn "$pane")"
      # Which idle this is, not whether it is idle: the judge already settled
      # that. Codex parks the same way on a capacity refusal as on a finished
      # turn, and only the refusal line tells the two apart.
      if grep -Eq -- "$CODEX_MARKER_RE" <<<"$below" && grep -qF -- "$MODEL_CAPACITY" <<<"$below"; then
        capacity=1
      fi
    else
      asking_state="$(lane_row_clear lane-idle "$asking_state" "$lane")"
      asking_state="$(lane_row_clear model-capacity "$asking_state" "$lane")"
      continue
    fi
    pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
    if [[ "$capacity" -eq 1 ]]; then
      # Capacity uses a turn-bound row. An earlier idle report cannot consume
      # the first stop after a continuation.
      capacity_key="${LANE_TURNS[$i]}"
      if ! prior="$(lane_row_get model-capacity "$asking_state" "$lane")"; then
        die state-read-failed "" "lane=$lane" "row=model-capacity"
      fi
      asking_state="$(lane_row_clear lane-idle "$asking_state" "$lane")"
      if [[ "$prior" == "$capacity_key" ]]; then continue; fi
      asking_state="$(lane_row_set model-capacity "$asking_state" "$lane" "$capacity_key")"
      # No payload: the handling is one continuation line pasted back into the
      # pane, and the key says everything it needs. The refusal line itself is
      # what the judge already matched.
      echo "EVENT model-capacity $lane"
      PASS_EVENT=1
      continue
    fi
    asking_state="$(lane_row_clear model-capacity "$asking_state" "$lane")"
    # The whole slice below the last turn is the key: any change to what the
    # lane shows is a different idle screen and news again. A repaint of an
    # older frame does not reach here, since a scrolled view carries `Jump to
    # bottom` and pane_working reads that frame as working.
    screen_key="${pane_key}|$(printf '%s' "$below" | cksum)"
    prior="$(lane_row_get lane-idle "$asking_state" "$lane")"
    if [[ "$prior" == "$screen_key|reported" ]]; then continue; fi
    if [[ "$prior" == "$screen_key" ]]; then
      asking_state="$(lane_row_set lane-idle "$asking_state" "$lane" "$screen_key|reported")"
      # The lane's closing report, which is what decides whether it is free
      # for another launch. Below the last turn is exactly the round that just
      # ended, and the cap keeps its last lines. Unfiltered: the dead-worktree
      # prompt noise is drawn by a shell that has the terminal back, and a
      # lane whose shell is drawing prompts reads exited, not idle.
      echo "EVENT idle-after-return $lane"
      bounded_tail "$below"
      PASS_EVENT=1
    else
      asking_state="$(lane_row_set lane-idle "$asking_state" "$lane" "$screen_key")"
    fi
  done
  # Committed after every asking and idle line is out: a row written ahead of
  # its event would make a crash between the two lose the question for good.
  lane_row_commit "$asking_state"
  # A failed close ends the pass only here, once every lane check above has
  # reported what it found.
  [[ "$close_failed" -eq 0 ]] || exit 2
}

# One `lanes list` per pass, read by the account events below and the
# heartbeat's roster alike, so those two never describe an account
# differently. The overseer's own mark judgement is a separate read. Each row is `<row key> TAB <row
# value> TAB <fields>`, the key and value laid out with the rows above and
# <fields> the text both the event and the roster print. `verdict` is
# `lanes`'s own wall judgement against ORCH_LANE_MAX_PCT, so the threshold and
# its default are read in one place. A read that failed or overran its ceiling
# leaves ACCOUNT_ROSTER_RC non-zero, which the heartbeat reports rather than
# printing no accounts.
ACCOUNT_ROSTER=""
ACCOUNT_ROSTER_RC=1
account_roster_read() {
  local errf="$WORK_DIR/accounts.err" rc=0 out
  ACCOUNT_ROSTER=""
  ACCOUNT_ROSTER_RC=1
  bounded_account_read account-unread "$errf" "$LANES_CLI" list --json || rc=$?
  # `lanes` writes its own keyed notices on a listing it still answered, a
  # provider it could not ask among them; those qualify this roster and pass
  # through with it.
  [[ ! -s "$errf" ]] || cat -- "$errf" >&2
  (( rc == 0 )) || return 1
  # The listing is read as one JSON array or not at all: an empty answer at
  # exit 0 is a listing that failed to render, never a fleet with no accounts.
  # A record missing the fields a row is keyed and judged on is not an account
  # this watch can compare, and refusing the read is what keeps it from
  # reading as an unchanged one. `lanes` gives every reset one whole-second
  # UTC spelling, which to_epoch reads on both date arms.
  out="$(jq -rn 'input
    | if type != "array" then error("listing is not an array") else .[] end
    | (.status // error("status missing")) as $status
    | (.verdict // error("verdict missing")) as $verdict
    | (.binding_resets_at // "-") as $resets
    | ["\(.harness)|\(.measured_through)|\(.config_dir)",
       "\($status)|\($verdict)|\($resets)",
       "\(.alias) config_dir=\(.config_dir) harness=\(.harness) through=\(.measured_through) status=\($status) verdict=\($verdict) headroom_pct=\(.headroom_pct // "-") binding_bucket=\(.binding_bucket // "-") binding_resets_at=\($resets)"]
    | @tsv' <<<"$BOUNDED_OUT" 2>"$errf")" || {
    overseer_note account-unread "path=$LANES_CLI" "parse=failed"
    [[ ! -s "$errf" ]] || cat -- "$errf" >&2
    return 1
  }
  ACCOUNT_ROSTER="$out"
  ACCOUNT_ROSTER_RC=0
}

# An account row changes when its status, its verdict against
# ORCH_LANE_MAX_PCT, or its binding bucket's reset changes. The first sighting
# of an account is its baseline and says nothing. A reset is news only once
# the reset the baseline holds has passed AND the reading has moved off it: a
# cached figure still naming the old reset is the same wall until the account
# is measured again, and the event is what carries the fresh headroom. A reset
# time that moved while still ahead is a different bucket binding, not a reset.
# An account the listing stops naming keeps its row, so one a provider drops
# for a pass is compared against its last reading when it comes back.
check_accounts() {
  local key value fields prior state="${PW_SEEN[0]}" change
  local was_status was_verdict was_resets status verdict resets reset_epoch
  account_roster_read || return 0
  while IFS=$'\t' read -r key value fields; do
    [[ -n "$key" ]] || continue
    if ! prior="$(lane_row_get account "$state" "$key")"; then
      die state-read-failed "" "account=$key" "row=account"
    fi
    [[ "$prior" != "$value" ]] || continue
    state="$(lane_row_set account "$state" "$key" "$value")"
    [[ -n "$prior" ]] || continue
    IFS='|' read -r was_status was_verdict was_resets <<<"$prior"
    IFS='|' read -r status verdict resets <<<"$value"
    change=""
    [[ "$was_status" == "$status" ]] || change+=",status"
    [[ "$was_verdict" == "$verdict" ]] || change+=",headroom"
    if [[ "$was_resets" != - && "$was_resets" != "$resets" ]]; then
      if reset_epoch="$(to_epoch "$was_resets")"; then
        [[ "$reset_epoch" -gt "$PASS_NOW" ]] || change+=",reset"
      else
        overseer_note account-reset-unparsed "account=$key" "binding_resets_at=$was_resets"
      fi
    fi
    [[ -n "$change" ]] || continue
    echo "EVENT account $fields change=${change#,} was=$was_status/$was_verdict"
    PASS_EVENT=1
  done <<<"$ACCOUNT_ROSTER"
  lane_row_commit "$state"
}

# Every --repo's open PRs, each line prefixed with its repo as the reducer's
# are, and all of them read before the event line goes out: a repo that
# cannot be listed is a failed pass, not a heartbeat missing a repo. The
# account roster follows, as the last long pass read it.
heartbeat() {
  local errf="$WORK_DIR/open.err" repo open open_all=""
  for repo in "${REPOS[@]}"; do
    open="$(gh pr list --repo "$repo" --state open --limit 50 --json number,headRefName,title \
      --jq '.[] | "\(.number)\t\(.headRefName)\t\(.title)"' 2>"$errf")" \
      || die pr-list-failed "$(cat "$errf")" "repo=$repo" "state=open"
    [[ -z "$open" ]] || open_all+="$(pw_prefix "$repo" "$open")"$'\n'
  done
  echo "EVENT heartbeat loops=$MAX_LOOPS interval=${INTERVAL}s since=${SINCE:-none}"
  [[ -z "$open_all" ]] || printf '%s' "$open_all"
  if [[ "$ACCOUNT_ROSTER_RC" -ne 0 ]]; then
    echo "account-roster unread"
  else
    echo "account-roster accounts=$(grep -c . <<<"$ACCOUNT_ROSTER" || true)"
    [[ -z "$ACCOUNT_ROSTER" ]] || awk -F'\t' '{ print "account " $3 }' <<<"$ACCOUNT_ROSTER"
  fi
  pr_watch_context
  exit 0
}

# The long pass: the overseer's own pane, one lane snapshot, pr-watch, merged
# items, triage, lane preparation, the lane checks and the accounts, in a
# forked process. Mail passes go on
# while it runs, so it spools its stdout and stderr and this process prints
# them whole once it ends, staying the one writer of the event protocol. The
# fork has its own copy of every global: what the loop below needs back
# crosses LONG_STATUS, and the baselines it committed are what the next long
# pass reads, never this process's copy of them.
LONG_PASSES=0
long_pass() {
  local i state_file
  PASS_EVENT=0
  PASS_FAILED=0
  for i in "${!REPOS[@]}"; do
    state_file="$(pw_state_file "${REPOS[$i]}")"
    PW_SEEN[$i]=""
    [[ ! -f "$state_file" ]] || PW_SEEN[$i]="$(cat -- "$state_file")" \
      || die state-read-failed "" "path=$state_file"
  done
  # No event consumer advances its baseline after this pass observes the
  # overseer exited or walled. A later live pass or the successor receives
  # that work.
  if check_overseer; then
    observe_lanes
    check_pr_watch
    check_merged
    check_triage
    check_prepare
    check_lanes
    check_accounts
  fi
  printf 'LONG_EVENT=%q\nLONG_FAILED=%q\nOVERSEER_SUCCEEDED=%q\nOVERSEER_STOP=%q\n' \
    "$PASS_EVENT" "$PASS_FAILED" "$OVERSEER_SUCCEEDED" "$OVERSEER_STOP" >"$LONG_STATUS"
  printf 'PW_PASSES=%q\nPW_RC=%q\nPW_EVENT=%q\nPW_OUT=%q\nPW_ERR=%q\nLANE_PROBE_NOTED=%q\nOVERSEER_NOTED=%q\n' \
    "$PW_PASSES" "$PW_RC" "$PW_EVENT" "$PW_OUT" "$PW_ERR" "$LANE_PROBE_NOTED" "$OVERSEER_NOTED" >>"$LONG_STATUS"
  printf 'ACCOUNT_ROSTER=%q\nACCOUNT_ROSTER_RC=%q\n' \
    "$ACCOUNT_ROSTER" "$ACCOUNT_ROSTER_RC" >>"$LONG_STATUS"
}
long_start() {
  rm -f -- "$LONG_STATUS" "$LONG_DONE"
  ( trap 'touch "$LONG_DONE"' EXIT; long_pass ) >"$LONG_OUT" 2>"$LONG_ERR" &
  LONG_PID=$!
}
# Takes an ended long pass in: its lines out, its answers back; `wait` blocks
# until it ends. A pass that died has said why on its own stderr, and this
# process exits with its status, as it did when the checks ran here.
long_collect() { # [wait]
  local rc=0
  [[ -n "$LONG_PID" ]] || return 0
  [[ "${1:-}" == wait || -e "$LONG_DONE" ]] || return 0
  long_drain || rc=$?
  [[ "$rc" -eq 0 ]] || exit "$rc"
  [[ -f "$LONG_STATUS" ]] || die long-pass-unfinished "" "path=$LONG_STATUS"
  # shellcheck source=/dev/null
  source "$LONG_STATUS"
  LONG_PASSES=$((LONG_PASSES + 1))
  [[ "$LONG_EVENT" -eq 0 ]] || PASS_EVENT=1
  [[ "$LONG_FAILED" -eq 0 ]] || PASS_FAILED=1
  MAIL_OWED=1
}

# Whether a long pass starts now: none in flight, no news from an earlier turn
# of this run, fewer than --max-loops run, and --interval gone by since the
# last one started, in this run or an earlier one. News from this turn's own
# mail pass does not hold back a long pass already due, so a run ends on both
# halves of the pass it would have made as one. The start is kept in the mail
# pass's file, so a run that ended on mail news does not bring the next long
# pass forward: how many long passes an hour holds, and so how many GitHub
# calls, is the interval's alone.
LONG_DUE=0
long_due() {
  local last
  [[ -z "$LONG_PID" && "$TURN_NEWS" -eq 0 && "$LONG_PASSES" -lt "$MAX_LOOPS" ]] || return 1
  if ! last="$(lane_row_get long-pass "$MAIL_SEEN" fleet)"; then
    die state-read-failed "" "path=$MAIL_STATE_FILE" "row=long-pass"
  fi
  LONG_DUE="$PASS_NOW"
  [[ ! "$last" =~ ^[0-9]+$ ]] || LONG_DUE=$((last + INTERVAL))
  [[ "$PASS_NOW" -ge "$LONG_DUE" ]] || return 1
  mail_row_commit "$(lane_row_set long-pass "$MAIL_SEEN" fleet "$PASS_NOW")"
  LONG_DUE=$((PASS_NOW + INTERVAL))
}

# The overseer pane read dead or walled by a long pass, as the rows it
# committed say. No mailbox is read then, so the successor, or the overseer
# once it reads live again, finds that mail rather than a log nobody reads.
overseer_down() {
  local file rows
  file="$(pw_state_file "${REPOS[0]}")"
  [[ -f "$file" ]] || return 1
  rows="$(cat -- "$file")" || die state-read-failed "" "path=$file"
  awk -F'\t' 'NF == 3 && ($1 == "overseer-dead" || $1 == "overseer-walled") { found = 1 } END { exit !found }' <<<"$rows"
}

# Until the next mail pass or long pass is due. A long pass in flight is looked
# at each second, so its block goes out within a second of its end. With no
# mail interval the mail pass runs once a turn: a long pass in flight is waited
# for, and with none the turn waits for the next one to come due.
tick_wait() {
  local now next
  while :; do
    if [[ -n "$LONG_PID" && "$MAIL_INTERVAL" -eq 0 ]]; then
      long_collect wait
      return 0
    fi
    if [[ -n "$LONG_PID" ]]; then
      long_collect
      [[ -n "$LONG_PID" ]] || return 0
    fi
    now="$(date -u +%s)" || die time-failed "" "clock=UTC"
    next="$MAIL_DUE"
    [[ "$MAIL_INTERVAL" -gt 0 ]] || next="$LONG_DUE"
    [[ -n "$LONG_PID" || "$LONG_DUE" -ge "$next" ]] || next="$LONG_DUE"
    [[ "$next" -gt "$now" ]] || return 0
    if [[ -n "$LONG_PID" ]]; then
      sleep 1
    else
      sleep "$((next - now))"
      return 0
    fi
  done
}

# One clock per turn. The stamp a lane's wall is observed on and the
# comparison that decides whether it has lifted are the same reading, so a
# slow pass cannot put them on either side of the reset. A turn that cannot
# read it classifies nothing, here or in triage, so it stops rather than
# carrying an unstamped sighting forward: there is no state below in which a
# row exists without the clock that earned it.
PASS_NOW=""
# Set by any check that printed an event this run, mail or long. Every check
# runs on either way; the run ends once, with the pr-watch context closing the
# block, when no long pass is left in flight.
PASS_EVENT=0
PASS_FAILED=0
PASS_FAILED_ITEMS=""
TURN_NEWS=0
MAIL_DUE=0
# The run's end, asked at the foot of every turn and again once the wait after
# it has taken a long pass in, so a run whose news is out never reads the mail
# or the fleet once more first. Nothing ends while a long pass is in flight.
# The heartbeat reads the mail once more when a long pass ended after the last
# mail pass: an overseer pane that pass read live again has mail waiting that
# the heartbeat's run would otherwise leave to the next.
MAIL_OWED=0
run_end() {
  [[ "$OVERSEER_SUCCEEDED" -eq 0 ]] || exit 3
  [[ "$OVERSEER_STOP" -eq 0 || "$REPEAT_CHILD" -eq 0 ]] || exit 4
  [[ -z "$LONG_PID" ]] || return 0
  if [[ "$PASS_FAILED" -eq 1 ]]; then
    pr_watch_context
    exit 2
  fi
  if [[ "$PASS_EVENT" -eq 1 ]]; then
    pr_watch_context
    exit 0
  fi
  [[ "$LONG_PASSES" -ge "$MAX_LOOPS" ]] || return 0
  if [[ "$MAIL_OWED" -eq 1 ]]; then
    MAIL_OWED=0
    overseer_down || check_mail
    run_end
  fi
  heartbeat
}
while :; do
  # The fleet before the checks that read it, every turn and not only the
  # first: a lane launched, relaunched or closed while this run loops quietly
  # is otherwise outside every mail, banner and pane read until an older lane
  # produces an event and the run returns.
  [[ -z "$STATE_FILE" ]] || { fleet_merge; require_item_helpers; }
  PASS_NOW="$(date -u +%s)" || die time-failed "" "clock=UTC"
  TURN_NEWS=$((PASS_EVENT + PASS_FAILED))
  # Mail first, so a long pass forked below starts from the clone roots and
  # removed worktrees this turn has just learned.
  if [[ "$PASS_NOW" -ge "$MAIL_DUE" ]]; then
    MAIL_DUE=$((PASS_NOW + MAIL_INTERVAL))
    MAIL_OWED=0
    overseer_down || check_mail
  fi
  ! long_due || long_start
  long_collect
  run_end
  tick_wait
  run_end
done
