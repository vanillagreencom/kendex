#!/usr/bin/env bash
# oversee-watch starts the fleet's standing scheduler, `orch-runtime watch
# run`, under this name: the runtime is exec'd here as `oversee-watch`, so
# a watch of the retired repeat loop reads the runtime's claim as a live
# watch and refuses to start beside it (lib/watch-pid.sh's liveness test is
# a pid whose command line names oversee-watch). The overseer's turn-end
# hook reads the watch through `orch-runtime watch status`. The claim, the
# event log and the baseline are the runtime's (`orch-runtime watch
# --help`); this entry's one write is the overseer's launch line, below.
#
# Usage:
#   oversee-watch --state PATH [--repeat SECS] [--interval SECS] [--max-loops N]
#                 [--since ISO8601] [--repo OWNER/REPO]...
#                 [--item ISSUE_ID]... [--root ITEM=PATH]... [--hosted ITEM=ROOT]...
#                 [--skip-lane WINDOW]... [--handoff PATH] [--harness H]
#                 [LANE_WINDOW...] [-- OVERSEER_FLAGS...]
#
# Options, and what each becomes:
#   --state PATH        the fleet state; `watch run --file PATH`. Required.
#   --interval SECS     `watch run --interval SECS`
#   --max-loops N       `watch run --max-loops N`
#   --since ISO8601     `watch run --since ISO8601`
#   --repo OWNER/REPO   `watch run --repo OWNER/REPO`, repeatable
#   --repeat SECS       accepted, no counterpart: the runtime is the standing
#                       loop, on its own cadences (ORCH_WATCH_MAIL_INTERVAL,
#                       --interval), and ends on `watch stop`
#   --item, --root, --hosted, --skip-lane, LANE_WINDOW
#                       accepted, no counterpart: the runtime reads every lane
#                       from the fleet state's own records
#   --handoff PATH, --harness H, -- OVERSEER_FLAGS...
#                       the overseer's own launch line, recorded by this start
#                       (below); the runtime takes none of them. --handoff
#                       defaults to tmp/handoffs/OVERSEER-HANDOFF.md
#   --help              this text
# A dash-led word this entry does not know is refused as option-unknown, exit
# 2, as is an option given no value (missing-value) or a start naming no
# --state (state-required).
#
# The overseer's launch line. A start run in a tmux pane (TMUX_PANE set)
# records the session's launch line in the fleet state's `overseer` record
# before the runtime claims, as the retired loop did at its start: the line
# `oversee-succeed --print-launch-line --handoff PATH [--harness H] [-- FLAGS]`
# prints, written through lib/watch-overseer-record.sh, which keeps the
# record's identity where the record names this pane on this server (a
# launcher's or `oversee register`'s record). A death or wall recovery replays
# that line (../workflows/oversee.md § 4). A start the runtime will refuse,
# beside a live runtime claim it does not replace or a claim it cannot read,
# writes no line, so a refused second start leaves the running watch's. A
# record step that fails is a notice on stderr and in the fleet log
# (overseer-unrecorded, overseer-line-missing), never a refusal: the pane is
# still watched.
#
# The cutover. A fleet whose claim record names a live watch of the retired
# repeat loop, a record with no start= line, is cut over here. That watch
# reads no stop request, so this entry stops it by its pid and never by the
# launcher's oversee-watch.runner, which names this start's own unit once the
# workflow's launch line wrote it. The loop's own TERM route first,
# lib/watch-pid.sh § watch_stop: TERM to the pid alone reaches the loop's
# trap, which releases the record and signals its pass so that a pass part
# way through a lane-close finishes that close and its row. Where the loop
# holds its record past that route's bound, a loop deaf to TERM,
# lib/job-unit.sh's group teardown, where the pid leads a process group and
# its command line names oversee-watch (a unit's main process and a setsid
# job both lead their own), which ends a deaf leader with KILL after its
# grace. A watch neither route stops is watch-stop-failed pid= route=, exit
# 1, naming the last route tried, and the runtime does not start;
# watch-taken-over names the route that stopped it. A stopped watch still
# finishing a pass, a lane-close among them, is waited out, then the runtime
# is exec'd and reads the record gone.
#
# An entry the loop itself started as its next pass (the loop hands each pass
# OVERSEE_WATCH_REPEAT_OWNER, its own pid, the record's) must not stop its
# parent, whose stop trap would end this pass with it. It starts one entry
# detached through the launch line the workflow uses, `job-unit.sh launch`
# on the state's oversee-watch.runner with stderr appended to
# oversee-watch.err and its own arguments, says watch-relaunched pid= unit=
# and exits 4, the pass status the loop reads as "stop; a replacement starts
# one watch": the loop releases its record and exits, and the detached entry
# meets that record live or gone and proceeds as above. A relaunch that fails
# is watch-relaunch-failed, exit 1, and the loop runs its next pass.
#
# What the cutover leaves and reads. The loop's per-repository `.mail` rows
# are not converted: the runtime's mail cursor starts at nothing announced,
# so its first mail turn announces each box's standing envelopes once more,
# then keeps its own row. The runtime writes oversee-watch.argv and
# oversee-watch.log under the loop's names, the argv replaced whole at its
# claim and the log appended after the last line a launcher left there, and
# prints or removes neither; the launcher's wrapper appends the runtime's
# stderr to oversee-watch.err. A unit stop's TERM ends the runtime by the
# signal's default action and leaves its claim on disk; the next start reads
# that claim gone and takes it over. A controller stop (`stop-controller`)
# leaves the watch running: the Stop workflow ends it with `orch-runtime
# watch stop --fleet` (../references/watch-delivery.md).
#
# A live runtime claim is the runtime's to judge: it refuses watch-running,
# or stops and replaces the pid OVERSEE_WATCH_REPLACE names (`watch run
# --replace`).
#
# Before any of that, the GitHub credential ladder the retired loop ran
# (../references/gates.md § Waiter auth ladder) runs once here, where the
# loop's repeat wrapper ran it: before the claim, so a watch that cannot read
# GitHub never stands as the fleet's watch nor stops the one it would
# replace. The token it selects is the runtime's, inherited by every gh the
# runtime starts; a ladder with no working candidate is auth-failed, exit 2.
#
# Every line this entry prints is `oversee-watch: <key> field=value...` on
# stderr: option-unknown, missing-value, state-required, runtime-missing,
# auth-failed, watch-stop-failed and watch-relaunch-failed are refusals;
# watch-taken-over, watch-finishing and watch-relaunched are the cutover's;
# overseer-unrecorded and overseer-line-missing are the record's notices.
# OVERSEE_WATCH_SUCCEED and OVERSEE_WATCH_WORKFLOW_STATE name the record's
# two helpers, default oversee-succeed and workflow-state beside this script;
# OVERSEE_WATCH_RUNTIME names the runtime, default the
# orch-runtime wrapper beside this script.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENTRY="$SCRIPT_DIR/${BASH_SOURCE[0]##*/}"
# This start's own arguments, which a relaunch hands the detached entry whole.
ARGS=("$@")

usage() { sed -n '/^# Usage:/,/^# orch-runtime wrapper beside this script\.$/p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; }

say() { # KEY FIELD=VALUE...
  local key="$1"
  shift
  printf 'oversee-watch: %s%s\n' "$key" "${*:+ $*}" >&2
}

die() { # STATUS KEY FIELD=VALUE...
  local status="$1"
  shift
  say "$@"
  exit "$status"
}

need_val() { [[ $# -ge 2 && -n "${2:-}" ]] || die 2 missing-value "option=$1"; }

STATE=""
RUN_ARGS=()
HANDOFF=tmp/handoffs/OVERSEER-HANDOFF.md
OVERSEER_HARNESS=""
OVERSEER_FLAGS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --) shift; OVERSEER_FLAGS=("$@"); break ;;
    --state) need_val "$@"; STATE="$2"; shift 2 ;;
    --state=*) STATE="${1#--state=}"; need_val --state "$STATE"; shift ;;
    --handoff) need_val "$@"; HANDOFF="$2"; shift 2 ;;
    --handoff=*) HANDOFF="${1#--handoff=}"; need_val --handoff "$HANDOFF"; shift ;;
    --harness) need_val "$@"; OVERSEER_HARNESS="$2"; shift 2 ;;
    --harness=*) OVERSEER_HARNESS="${1#--harness=}"; need_val --harness "$OVERSEER_HARNESS"; shift ;;
    --interval | --max-loops | --since | --repo) need_val "$@"; RUN_ARGS+=("$1" "$2"); shift 2 ;;
    --interval=* | --max-loops=* | --since=* | --repo=*)
      need_val "${1%%=*}" "${1#*=}"; RUN_ARGS+=("${1%%=*}" "${1#*=}"); shift ;;
    --repeat | --item | --root | --hosted | --skip-lane) need_val "$@"; shift 2 ;;
    --repeat=* | --item=* | --root=* | --hosted=* | --skip-lane=*)
      need_val "${1%%=*}" "${1#*=}"; shift ;;
    --help | -h | help) usage; exit 0 ;;
    -*) die 2 option-unknown "option=$1" ;;
    *) shift ;;
  esac
done
[[ -n "$STATE" ]] || die 2 state-required "option=--state"

RUNTIME="${OVERSEE_WATCH_RUNTIME:-$SCRIPT_DIR/orch-runtime}"
[[ -x "$RUNTIME" ]] || die 1 runtime-missing "path=$RUNTIME" "setting=OVERSEE_WATCH_RUNTIME"

# shellcheck source=lib/watch-pid.sh
source "$SCRIPT_DIR/lib/watch-pid.sh"
# shellcheck source=lib/job-unit.sh
source "$SCRIPT_DIR/lib/job-unit.sh"
# shellcheck source=lib/gh-auth.sh
source "$SCRIPT_DIR/lib/gh-auth.sh"
# The pane key the record is written by, the one reader every session's key
# comes from.
# shellcheck source=lib/lane-context.sh
source "$SCRIPT_DIR/lib/lane-context.sh"
# The record writer, which reads WORKFLOW_STATE, WORKFLOW_STATE_ARGS, SUCCEED,
# HANDOFF, OVERSEER_HARNESS and OVERSEER_FLAGS here and calls
# overseer_record_notice below.
# shellcheck source=lib/watch-overseer-record.sh
source "$SCRIPT_DIR/lib/watch-overseer-record.sh"

WORKFLOW_STATE="${OVERSEE_WATCH_WORKFLOW_STATE:-$SCRIPT_DIR/workflow-state}"
SUCCEED="${OVERSEE_WATCH_SUCCEED:-$SCRIPT_DIR/oversee-succeed}"
WORKFLOW_STATE_ARGS=()

OW_REPLAY_RULE='A death replays the held line only where the record names this pane by server, server start and pane id: the last line a launch, a succession or a watch start recorded for it, which a session restarted by hand may not have started with. A record naming another pane, or no line, means a death with no successor.'

# A record step that failed: the keyed line on stderr with the writer's
# detail under it, and one fleet-log row so the session that reads the log
# next learns its record was not written. Never a refusal: the pane is still
# watched off its rows or itself.
overseer_record_notice() { # DETAIL HELD REASON FIELD=VALUE...
  local detail="$1" held="$2" dir held_text
  shift 2
  say "$@" "held=$held"
  [[ -z "$detail" ]] || printf '%s\n' "$detail" >&2
  case "$held" in
    none) held_text='No line is held for this pane.' ;;
    unread) held_text='Whether a line is held was not read.' ;;
    *) held_text='A line is held for this pane, at overseer.pending.launch_line if set, else overseer.launch_line.' ;;
  esac
  if ! dir="$(mktemp -d)"; then
    say overseer-notice-failed channel=file
    return 0
  fi
  if ! printf '%s: the start could not record this session; the pane is still watched. %s %s\n' \
      "$1 $2" "$OW_REPLAY_RULE" "$held_text" > "$dir/notice" \
    || ! ol_fleet_log "$dir/notice" "$dir/record" "$dir/err" \
      "$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"}; then
    say overseer-notice-failed channel=fleet-log
    [[ ! -s "$dir/err" ]] || cat -- "$dir/err" >&2
  fi
  rm -rf -- "${dir:?}"
}

# The credential ladder, once, before the claim: a stale env token yields to
# the keyring; when neither works the env token is dropped so the project's
# GH_BOT_TOKEN can be selected, the last candidate. Never on: unauthenticated,
# every GitHub read of every pass would refuse where the loop selected the
# bot token. In this shell, not a subshell, so the runtime inherits the
# selection.
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
orch_sanitize_gh_env
if ! orch_github_auth_status; then
  unset GH_TOKEN GITHUB_TOKEN
  { orch_load_env_bot_token "$PROJECT_ROOT" && orch_github_auth_status; } \
    || die 2 auth-failed "service=github"
fi

# The one claim, read once: a live record of the retired loop is this entry's
# to stop; a live runtime claim is the runtime's to refuse or replace, and an
# unreadable claim its to refuse, and a start it refuses records no line.
record_line=1
if watch_pid_paths "$STATE"; then
  WORKFLOW_STATE_ARGS=(--state-dir "${WATCH_PID_FILE%/*}")
else
  record_line=0
fi
live_rc=0
watch_pid_live "$STATE" || live_rc=$?
legacy=0
if [[ "$live_rc" -eq 0 ]]; then
  if grep -q -- '^start=' "$WATCH_PID_FILE"; then
    [[ "${OVERSEE_WATCH_REPLACE:-}" == "$WATCH_PID" ]] || record_line=0
  else
    legacy=1
  fi
elif [[ "$live_rc" -eq 2 ]]; then
  record_line=0
fi

if [[ "$legacy" -eq 1 && "${OVERSEE_WATCH_REPEAT_OWNER:-}" == "$WATCH_PID" ]]; then
  # The loop's own pass: one entry starts detached, as the workflow starts
  # the watch, and this pass tells the loop to stop. The owner mark is this
  # pass's alone, so the detached entry stops the loop rather than deferring
  # to it.
  unset OVERSEE_WATCH_REPEAT_OWNER
  job_unit_launch "watch-$(date -u +%Y%m%dT%H%M%SZ)" "$WATCH_RUNNER_FILE" -- \
    sh -c 'err=$1; shift; exec "$@" 2>>"$err"' sh "$WATCH_ERR_FILE" "$ENTRY" ${ARGS[@]+"${ARGS[@]}"} \
    || die 1 watch-relaunch-failed "pid=$WATCH_PID" "error=${JOB_UNIT_ERROR_KEY:-launch-failed}" "$JOB_UNIT_ERROR"
  say watch-relaunched "pid=$WATCH_PID" "unit=$JOB_UNIT_LINE"
  exit 4
fi

if [[ "$legacy" -eq 1 ]]; then
  # TERM to the pid alone, the loop's own stop: its trap removes the record
  # and signals the pass it is running, which keeps a lane-close in flight
  # through to its row, where a signal to the whole group would end that
  # close where it stands.
  route=term
  if ! watch_stop "$WATCH_PID" "$STATE"; then
    # The record held past the bound: the loop ignores TERM. The group it
    # leads is torn down, KILL after the grace, which bounds a deaf leader;
    # a pid leading no group of its own, or running under another name, is
    # left alone and the stop has failed on the TERM route.
    stop_rc=0
    job_unit_kill_group "$WATCH_PID" '*oversee-watch*' || stop_rc=$?
    if [[ "$stop_rc" -eq 1 ]]; then
      die 1 watch-stop-failed "pid=$WATCH_PID" "route=$route" "secs=$WATCH_STOP_SECS"
    fi
    route=kill-group
    [[ "$stop_rc" -eq 0 ]] \
      || die 1 watch-stop-failed "pid=$WATCH_PID" "route=$route" "error=$JOB_UNIT_ERROR_KEY" "$JOB_UNIT_ERROR"
  fi
  say watch-taken-over "pid=$WATCH_PID" "pane=$WATCH_PANE" "reason=legacy" "route=$route"
  # The watch may be finishing a lane-close: it is waited out, as the loop
  # itself waited out the watch it replaced, so the close's row is committed
  # before the runtime's first pass.
  if watch_pid_runs "$WATCH_PID"; then
    say watch-finishing "pid=$WATCH_PID"
    while watch_pid_runs "$WATCH_PID"; do sleep 0.1; done
  fi
fi

# The launch line, once the watch this start replaces is gone and before the
# runtime claims, where the loop recorded it.
[[ "$record_line" -eq 0 ]] || overseer_command_record

[[ -z "${OVERSEE_WATCH_REPLACE:-}" ]] || RUN_ARGS+=(--replace "$OVERSEE_WATCH_REPLACE")
# Named one watch for this start alone: nothing the runtime starts inherits it.
unset OVERSEE_WATCH_REPLACE
# The runtime under this entry's name (the orch-runtime wrapper's
# ORCH_RUNTIME_NAME, consumed there), so its command line names
# oversee-watch, the liveness test lib/watch-pid.sh § watch_pid_runs reads.
ORCH_RUNTIME_NAME="${BASH_SOURCE[0]}" exec "$RUNTIME" watch run --file "$STATE" ${RUN_ARGS[@]+"${RUN_ARGS[@]}"}
