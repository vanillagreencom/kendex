watch_state_init
pw_init_state

# Every --repo: a consumer-repo PR merges where the item's work went, under the
# same branch name, and a fork's PR on that name is rejected per repo. Reported
# once per PR: the item's `merged` row holds every `<repo>#<number>` already
# delivered, so a merged item still in --item on a re-run is not news again,
# while a further PR on the branch, in any repo, is. The rows are committed
# once, after the lines are out.
check_merged() {
  [[ -n "$ITEM_BRANCHES" ]] || return 0
  local errf="$WORK_DIR/merged.err" item branch repo list hit hits prior keys key line state="${PW_SEEN[0]}"
  for item in "${ITEMS[@]}"; do
    branch="$(printf '%s' "$item" | tr '[:upper:]' '[:lower:]')"
    hits=""
    for repo in "${REPOS[@]}"; do
      list="$(gh pr list --repo "$repo" --head "$branch" --state merged --limit 10 --json number,headRefName,headRepositoryOwner,mergedAt 2>"$errf")" \
        || die pr-list-failed "$(cat "$errf")" "repo=$repo" "state=merged" "branch=$branch"
      hit="$(jq -r --arg branch "$branch" --arg owner "${repo%%/*}" --arg repo "$repo" --argjson since "$SINCE_EPOCH" '
        [ .[]
          | select(.headRefName | ascii_downcase == $branch)
          | select(((.headRepositoryOwner.login // "") | ascii_downcase) == $owner)
          | select(.mergedAt != null)
          | select((.mergedAt | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) >= $since)
          | "\(.number) \(.headRefName) \($repo)" ]
        | .[]' <<<"$list" 2>"$errf")" \
        || die pr-list-invalid "$(cat "$errf")" "repo=$repo" "branch=$branch"
      [[ -z "$hit" ]] || hits+="$hit"$'\n'
    done
    if [[ -z "$hits" ]]; then
      state="$(lane_row_clear merged "$state" "$item")"
      continue
    fi
    prior="$(lane_row_get merged "$state" "$item")"
    keys=""
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      key="${line##* }#${line%% *}"
      keys="${keys:+$keys }$key"
      grep -qxF -- "$key" <<<"${prior// /$'\n'}" && continue
      echo "EVENT merged $line"
      PASS_EVENT=1
    done <<<"$hits"
    state="$(lane_row_set merged "$state" "$item" "$keys")"
  done
  state="$(lane_row_prune merged "$state" "${ITEMS[@]}")"
  lane_row_commit "$state"
}

check_triage() {
  [[ "$TRIAGE_ENABLED" -eq 1 ]] || return 0
  local errf="$WORK_DIR/triage.err" now age days out ids verdicts pr_keys triage_keys="" seen id new_ids="" next rc=0
  verdicts="$("$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} get oversee '.triaged // [] | map(select(.verdict == "kept" or .verdict == "canceled") | .issue) | .[]' 2>"$errf")" || rc=$?
  [[ "$rc" -eq 0 ]] \
    || die triage-state-failed "$(cat "$errf")" "exit=$rc"
  verdicts="$(awk 'NF && !seen[$0]++' <<<"$verdicts")"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] \
      || die triage-item-invalid "" "item=$id"
    [[ -z "$triage_keys" ]] || triage_keys+=$'\n'
    triage_keys+="triage"$'\t'"$id"
  done <<<"$verdicts"
  pr_keys="$(awk -F'\t' '$1 != "triage" { print }' <<<"${PW_SEEN[0]}")"
  if [[ -n "$pr_keys" && -n "$triage_keys" ]]; then
    next="$pr_keys"$'\n'"$triage_keys"
  else
    next="$pr_keys$triage_keys"
  fi
  if [[ "$next" != "${PW_SEEN[0]}" ]]; then
    pw_stage_state "$(pw_state_file "${REPOS[0]}")" "$next"
    pw_commit_state "$(pw_state_file "${REPOS[0]}")"
    PW_SEEN[0]="$next"
  fi
  now="$(date -u +%s)" || die time-failed "" "clock=UTC"
  age=$((now - SINCE_EPOCH))
  [[ "$age" -ge 0 ]] || age=0
  # Linear's live list accepts whole-day windows. Round up, then apply the
  # exact ISO floor below so the wider server query cannot mint an old event.
  days=$((age / 86400 + 1))
  out="$("$TRACKER" issues list --team "$LINEAR_TEAM" --created-since "${days}d" --max --format=safe 2>"$errf")" || rc=$?
  [[ "$rc" -eq 0 ]] \
    || die tracker-list-failed "$(cat "$errf")" "team=$LINEAR_TEAM" "exit=$rc"
  ids="$(jq -r --argjson since "$SINCE_EPOCH" '
    def created_epoch: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
    if type != "array" then error("tracker-type expected=array actual=\(type)") else . end
    | [ .[]
      | if ((.created_at? | type) == "string" and (.created_at | length) > 0)
        then . else error("tracker-field field=created_at value=\(.created_at | tojson)") end
      | select((.created_at | created_epoch) >= $since)
      | if ((.id? | type) == "string" and (.id | test("^[A-Za-z0-9._-]+$")))
        then .id else error("tracker-field field=id value=\(.id | tojson)") end ]
    | unique[]
  ' <<<"$out" 2>"$errf")" \
    || die tracker-list-invalid "$(cat "$errf")" "team=$LINEAR_TEAM"
  seen="$(awk -F'\t' '$1 == "triage" && NF == 2 { print $2 }' <<<"${PW_SEEN[0]}")"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    grep -qxF -- "$id" <<<"$seen" || new_ids+="$id"$'\n'
  done <<<"$ids"
  [[ -n "$new_ids" ]] || return 0
  new_ids="${new_ids%$'\n'}"
  while IFS= read -r id; do
    echo "EVENT triage $id"
  done <<<"$new_ids"
  PASS_EVENT=1
}

# A lane told to hand off records `.handoff` in its item's state and exits.
# The record is the carrier, read from workflow state and never a pane, so the
# check runs on every surface. Whether one stands is `workflow-state
# handoff-standing`'s answer, the same one the lane's own turn-end hook asks,
# so the watch cannot report a lane as handed off that the hook still holds.
# It is reported once per record: the row keyed by the record's checksum is
# what stops a re-run between the event and the
# relaunch from reporting it again, and a record the relaunched lane stamped
# `.resumed_at` on is spent. Ordered after lane-exited and before
# usage-limit: the lane's exit is the older news, and a spent account is not
# what a handed-off lane is waiting on. Every item's record is reported in the
# pass that finds it, and the rows are committed once, after the lines are out.
check_handoff() {
  [[ ${#ITEMS[@]} -gt 0 ]] || return 0
  local item answer rec rc key prior errf="$WORK_DIR/handoff.err" state="${PW_SEEN[0]}"
  # The verdict line `handoff-standing` publishes, the one place its text lives
  # in this script.
  local verdict='workflow-state: handoff-standing'
  for item in "${ITEMS[@]}"; do
    grep -qxF -- "$item" <<<"$PASS_FAILED_ITEMS" && continue
    if ! item_state_dir "$item" "$state"; then
      lane_failure_report "$item" "$state"
      state="$LANE_FAILURE_STATE"
      lane_row_commit "$state"
      continue
    fi
    # `handoff-standing` owns the test and publishes its verdict as the word on
    # its first line, so that word is read here and its status is not: a script
    # its settings loader killed before the verb ran exits with a status of its
    # own, and only a run that reached the verb writes a verdict. `none` is no
    # record standing, a state file that is not there included, and `stands`
    # carries the record on the line under it. Anything else, an install
    # without the verb included, is a state this pass could not read, and is
    # reported rather than passed off as "no handoff".
    rc=0
    answer="$("$WORKFLOW_STATE" --state-dir "$ITEM_STATE_DIR" handoff-standing "$item" 2>"$errf")" || rc=$?
    if [[ "$rc" -eq 0 && "$answer" == "$verdict=none" ]]; then
      state="$(lane_row_clear handoff "$state" "$item")"
      continue
    fi
    if [[ "$rc" -ne 0 || "$answer" != "$verdict=stands"$'\n'* ]]; then
      lane_failure_set handoff-read-failed "$(cat "$errf")" "item=$item" "path=$ITEM_STATE_DIR"
      lane_failure_report "$item" "$state"
      state="$LANE_FAILURE_STATE"
      lane_row_commit "$state"
      continue
    fi
    rec="${answer#*$'\n'}"
    key="$(printf '%s' "$rec" | cksum | awk '{ print $1 }')"
    prior="$(lane_row_get handoff "$state" "$item")"
    state="$(lane_row_set handoff "$state" "$item" "$key")"
    [[ "$key" != "$prior" ]] || continue
    echo "EVENT handoff $item"
    printf '%s\n' "$rec"
    PASS_EVENT=1
  done
  state="$(lane_row_prune handoff "$state" "${ITEMS[@]}")"
  lane_row_commit "$state"
}

# Every --item's lane mailbox, read from disk or through `lane-host`, so the
# check runs on every surface: a lane with no pane, on another host, or in a
# session this process cannot see still reaches the overseer. Each item's row
# holds how many to-overseer.jsonl lines have been drained and the id the file
# opened with, and `drain` reports the file's own count and first id, so a
# message is reported once. An ask already answered
# is dropped by `drain` rather than by a row, so a restarted overseer with no
# rows re-reports only what it still owes a reply. The overseer's own mailbox
# is read the same way on every pass, items or not: `inbox --after` over its
# to-lane.jsonl, where the owner's notes land. Its count is a file of its own,
# named for the mailbox it counts and by no --since, because the owner's
# mailbox outlives every fleet; watch_state_init has already seeded that file
# from any unkeyed predecessor, so this pass reads one position.
check_mail() {
  local item verb stored prior seen out header count first line fields id kind options text rest rc args reread root cursor host_flag
  local mail_items
  local errf="$WORK_DIR/mail.err" state="${PW_SEEN[0]}" mailf="$PW_MAIL_FILE"
  HOSTED_GONE_ITEMS=""
  mail_items=(${ITEMS[@]+"${ITEMS[@]}"})
  [[ "$OVERSEER_MAIL_HELD" -eq 1 ]] || mail_items+=(overseer)
  for item in ${mail_items[@]+"${mail_items[@]}"}; do
    hosted_root "$item"
    root="$HOSTED_ROOT"
    host_flag=(--host)
    # A local lane with a recorded root is read there, with no --host: only a
    # hosted read needs one, and lane-mail's ownership gate is on send.
    if [[ -z "$root" ]]; then local_root "$item"; root="$LOCAL_ROOT"; host_flag=(); fi
    cursor="$item"
    if [[ -n "$HOSTED_ROOT" ]]; then
      if ! hosted_clone "$item" "$state"; then
        lane_failure_report "$item" "$state"
        state="$LANE_FAILURE_STATE"
        lane_row_commit "$state"
        continue
      fi
      state="$(lane_row_set clone-root "$state" "$item" "$HOSTED_CLONE")"
      # With the worktree removed, the lane's closing notice lands in the
      # clone's mailbox: another file, so another cursor.
      if [[ "$HOSTED_GONE" -eq 1 ]]; then
        HOSTED_GONE_ITEMS+="$item"$'\n'
        root="$HOSTED_CLONE"; cursor="$item@clone"
      fi
    fi
    stored=""
    if [[ "$item" == overseer ]]; then
      # Only the keyed file: watch_state_init has already seeded it from any
      # unkeyed predecessor, so the pass has one position to read.
      [[ ! -e "$mailf" ]] || stored="$(cat "$mailf")" || die state-read-failed "" "path=$mailf"
    elif ! stored="$(lane_row_get lane-mail "$state" "$cursor")"; then
      die state-read-failed "" "item=$item" "row=lane-mail"
    fi
    # `<count> <first>`: the lines drained, and the id the mailbox opened with
    # when they were, empty where it opened with none.
    read -r prior seen <<<"$stored"
    [[ "$prior" =~ ^[0-9]+$ ]] || { prior=0; seen=""; }
    verb=drain
    [[ "$item" != overseer ]] || verb=inbox
    reread=0
    while :; do
      args=(--item "$item" --after "$prior")
      [[ -z "$root" ]] || args+=(--root "$root" ${host_flag[@]+"${host_flag[@]}"})
      rc=0
      out="$("$LANE_MAIL" "$verb" "${args[@]}" 2>"$errf")" || rc=$?
      if [[ "$rc" -ne 0 ]]; then
        lane_failure_set mail-read-failed "$(cat "$errf")" "item=$item" "exit=$rc"
        lane_failure_report "$item" "$state"
        state="$LANE_FAILURE_STATE"
        lane_row_commit "$state"
        continue 2
      fi
      if ! header="$(head -n 1 <<<"$out")"; then
        die mail-read-invalid "" "item=$item" "value=count"
      fi
      [[ "$header" =~ ^count=([0-9]+)\ first=([A-Za-z0-9._-]*)$ ]] \
        || die mail-read-invalid "" "item=$item" "value=${header:-<empty>}"
      count="${BASH_REMATCH[1]}"
      first="${BASH_REMATCH[2]}"
      # A mailbox opening with another envelope than the one recorded, or
      # holding fewer lines than the cursor that read it, is not that mailbox:
      # a lane relaunched onto a replacement host brings a fresh one, and the
      # saved cursor would suppress what it holds, losing those messages for
      # good. The count is the answer where no first id was recorded. Read the
      # replacement whole, once — a second mismatch is the same answer and
      # would not end.
      [[ "$reread" -eq 0 && "$prior" -gt 0 ]] || break
      [[ "$count" -lt "$prior" || ( -n "$seen" && "$first" != "$seen" ) ]] || break
      reread=1
      prior=0
    done
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      if ! fields="$(jq -r '[.id // "", .kind // "", ((.options // []) | join(", ")), .from // "", .re // ""] | @tsv' <<<"$line")"; then
        die mail-read-invalid "" "item=$item" "value=envelope"
      fi
      id="${fields%%$'\t'*}"
      rest="${fields#*$'\t'}"
      kind="${rest%%$'\t'*}"
      rest="${rest#*$'\t'}"
      options="${rest%%$'\t'*}"
      rest="${rest#*$'\t'}"
      from="${rest%%$'\t'*}"
      re="${rest#*$'\t'}"
      case "$verb:$kind" in
        # The overseer's own mailbox carries the owner's notes and its peers'.
        # A line with no sender is an older owner note, never a peer's. A peer
        # line carries its kind, because only an ask is owed a reply and an
        # answer to a directive would name an id in no outbox; `re=` rides an
        # answer, without which two replies from one peer are told apart by
        # their wording alone.
        inbox:*)
          if [[ -z "$from" || "$from" == owner ]]; then
            echo "EVENT owner-note $id"
          else
            echo "EVENT peer-note ${from#overseer:} $id kind=$kind${re:+ re=$re}"
          fi
          ;;
        drain:ask) echo "EVENT lane-question $item $id" ;;
        # Only the lane writes this file, and it writes asks and notices; any
        # other kind is a line to show rather than a line to drop silently.
        *) echo "EVENT lane-notice $item $id" ;;
      esac
      if ! text="$(jq -r '.text // ""' <<<"$line")"; then
        die mail-read-invalid "" "item=$item" "value=text"
      fi
      # Every payload line is indented two spaces, so a message line spelling
      # `EVENT ...` never reads as a record: only the watch's own lines start
      # at the first column.
      [[ -z "$text" ]] || sed 's/^/  /' <<<"$text"
      # An ask's choices are the other half of the question; without this line
      # the overseer is asked to pick from a list it was never shown.
      [[ -z "$options" ]] || printf '  options: %s\n' "$options"
      PASS_EVENT=1
    done <<<"$(tail -n +2 <<<"$out")"
    if [[ "$item" != overseer ]]; then
      state="$(lane_row_set lane-mail "$state" "$cursor" "$count $first")"
      state="$(lane_row_clear lane-stopped "$state" "$item")"
    fi
    # Committed here, per item and after its lines are out: a later mailbox
    # can fail without discarding this read, and a row left uncommitted would
    # re-report this item's messages on the re-run that follows.
    #
    # No prune, unlike every other row kind: those hold a pane key a pane
    # replaces, this one how far the overseer has read a lane's mailbox. An
    # item out of --item for one run and back in the next would otherwise
    # drain from zero and report every message that lane ever sent.
    [[ "$item" != overseer || "$count $first" == "${stored:-0 }" ]] \
      || { pw_stage_state "$mailf" "$count $first"; pw_commit_state "$mailf"; }
    lane_row_commit "$state"
  done
}

# The last 40 non-empty pane lines. `|| true`: an all-blank pane is a grep
# miss, and under pipefail that would abort the script mid-event.
pane_tail() { grep -v '^[[:space:]]*$' <<<"$1" | tail -40 || true; }

# Said once per run, not per pass: the answer does not change under the watch.
LANE_PROBE_NOTED=0
note_probe_unusable() {
  [[ "$LANE_PROBE_NOTED" -eq 0 ]] || return 0
  LANE_PROBE_NOTED=1
  ow_message child-probe-failed "lane=$1" "exit=$LANE_PROBE_RC" >&2
}

# Drop KIND rows naming a lane this run does not watch. A row answers only for
# a lane under the watch; left to accumulate, one is a sighting nothing has
# looked at since, waiting for a window name to come back.
lane_row_prune() {
  local kind="$1" state="$2"
  shift 2
  # The lane list crosses in the environment, never through -v: it holds one
  # lane per line, and BWK awk — the awk macOS ships — refuses a -v value
  # carrying a newline outright ("awk: newline in string"), so every prune died
  # there and no lane event was ever emitted. ENVIRON takes the value whole.
  ow_lanes="$(printf '%s\n' "$@")" awk -F'\t' -v kind="$kind" '
    BEGIN { n = split(ENVIRON["ow_lanes"], a, "\n"); for (i = 1; i <= n; i++) watched[a[i]] = 1 }
    NF && !($1 == kind && !($2 in watched))
  ' <<<"$state"
}

# LANE_OBS columns are watch-list position, ready/gone, pane pid, current
# command, and server-plus-pane occurrence key. Capture bytes live in the file
# for that position. Position, not a filename slug, keeps arbitrary tmux window
# names from sharing one snapshot and classifying each other's screens.
LANE_OBS=""
LANE_TURNS=()
lane_field() { awk -F'\t' -v i="$2" -v field="$3" '$1 == i { print $field }' <<<"$1"; }
lane_obs_state() { lane_field "$1" "$2" 2; }
lane_pane_file() { printf '%s/pane.%s' "$WORK_DIR" "$1"; }

# Build one immutable lane snapshot for the pass. The final capture path is
# the success marker; a failed redirect leaves only a removed scratch file.
observe_lanes() {
  LANE_OBS=""
  LANE_TURNS=()
  [[ ${#LANES[@]} -gt 0 ]] || return 0
  local lane pane below key prefix prior obs pid cmd capture errf i=0 state="${PW_SEEN[0]}"
  local banner banner_rc reset_key seen_at seen_pane seen_reported seen_key
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    capture="$(lane_pane_file "$i")"
    rm -f "$capture" "$capture.$$.tmp"
    if ! lane_window_listed "$lane"; then
      LANE_OBS+="$i"$'\t'"gone"$'\t\t\t\n'
      state="$(lane_row_clear lane-asking "$state" "$lane")"
      state="$(lane_row_clear usage-limit "$state" "$lane")"
      state="$(lane_row_clear model-capacity "$state" "$lane")"
      state="$(lane_row_clear lane-exited "$state" "$lane")"
      state="$(lane_row_clear lane-idle "$state" "$lane")"
      continue
    fi
    errf="$WORK_DIR/lane-probe.$i.err"
    obs="$(tmux display-message -p -t "$lane" '#{pane_pid} #{pane_current_command}' 2>"$errf")" \
      || die pane-command-failed "$(cat "$errf")" "lane=$lane"
    [[ "$obs" =~ ^[0-9]+[[:blank:]]+[^[:space:]] ]] \
      || die pane-command-invalid "" "lane=$lane" "value=${obs:-<empty>}"
    key="$(tmux display-message -p -t "$lane" '#{pid} #{pane_id}' 2>"$errf")" \
      || die pane-identity-failed "$(cat "$errf")" "lane=$lane"
    [[ "$key" =~ ^[0-9]+[[:blank:]]+%[^[:space:]]+$ ]] \
      || die pane-identity-invalid "" "lane=$lane" "value=${key:-<empty>}"
    # -J joins what tmux wrapped, as open-terminal already reads a pane:
    # without it a narrow window puts `resets ...` on a line of its own, which
    # is not a banner line, and the reset disappears with the pane's width.
    if ! tmux capture-pane -t "$lane" -pJ >"$capture.$$.tmp" 2>"$errf"; then
      rm -f "$capture.$$.tmp"
      die pane-capture-failed "$(cat "$errf")" "lane=$lane"
    fi
    mv "$capture.$$.tmp" "$capture" || die pane-publish-failed "" "lane=$lane"
    pid="${obs%%[[:blank:]]*}"
    cmd="${obs#*[[:blank:]]}"
    LANE_OBS+="$i"$'\t'"ready"$'\t'"$pid"$'\t'"$cmd"$'\t'"$key"$'\n'
    pane="$(cat -- "$capture")"
    below="$(pane_below_last_turn "$pane")"
    prior="$(lane_row_get lane-asking "$state" "$lane")"
    prefix="${key}|$(pane_turn_identity "$pane")|"
    LANE_TURNS[$i]="${prefix}model-capacity"
    if ! grep -Eq -- "$LANE_ASKING_RE" <<<"$below" \
       || [[ -n "$prior" && "$prior" != "$prefix"* ]]; then
      state="$(lane_row_clear lane-asking "$state" "$lane")"
    fi
    # When this pass first sees a wall, stamp it: the row is what later lets a
    # dayless clause name a day. Stamped HERE, on every lane, rather than
    # where the event is emitted, because that path leaves on the first walled
    # lane and a second one would never be observed at all. Whether the banner
    # is a banner the lane has no turn in flight behind is lane_limit_banner's
    # one question, and both consumers ask it — which is as far as a screen
    # can settle it, so the overseer still confirms the tail before acting. A stamp answers for ONE wall on ONE pane, so it carries
    # the pane identity beside the wall and goes when either changes. A
    # banner naming no reset the grammar reads is stamped too, with an empty
    # reset key: the row is also where check_lanes records that the wall was
    # reported, and a wall with no row is one reported on every run.
    banner_rc=0
    banner="$(lane_limit_banner "$below")" || banner_rc=$?
    [[ "$banner_rc" -ne 2 ]] || die limit-scan-failed "" "lane=$lane"
    reset_key="$(usage_reset_key "$banner")"
    prior="$(lane_row_get usage-limit "$state" "$lane")"
    if [[ -n "$banner" ]]; then
      seen_pane=""; seen_key=""
      [[ -z "$prior" ]] || IFS='|' read -r seen_at seen_pane seen_reported seen_key <<<"$prior"
      [[ "$seen_pane" == "$key" && "$seen_key" == "$reset_key" ]] \
        || state="$(lane_row_set usage-limit "$state" "$lane" "$PASS_NOW|$key||$reset_key")"
    else
      state="$(lane_row_clear usage-limit "$state" "$lane")"
    fi
  done
  state="$(lane_row_prune usage-limit "$state" "${LANES[@]}")"
  state="$(lane_row_prune model-capacity "$state" "${LANES[@]}")"
  state="$(lane_row_prune lane-exited "$state" "${LANES[@]}")"
  state="$(lane_row_prune lane-idle "$state" "${LANES[@]}")"
  lane_row_commit "$state"
}

# ---------------------------------------------------------------------------
# The overseer's own pane.
#
# Every check above answers about a LANE. Nothing answered about the session
# reading them: an overseer whose harness ended left its lanes working, this
# watch printing into a log with no reader, and the fleet unattended until a
# person happened to look at the window. The pane is the one place a watch can
# see that from, and it already has it — $TMUX_PANE is the overseer's own pane,
# inherited from the shell the overseer started this watch in.
#
# The judge is lib/lane-state.sh's, the same one every lane goes through, so a
# dead overseer and a dead lane are read by one set of rungs.
# ---------------------------------------------------------------------------

# Set once a successor holds the dead overseer's window: the pass then ends at
# exit 3 without running the checks below it, so the mail the successor is
# meant to drain is not drained here first.
OVERSEER_SUCCEEDED=0
# Initial launch plus one later retry. This internal ceiling prevents a dead
# pane from launching successors forever when the host cannot start one.
OVERSEER_RELAUNCH_ATTEMPTS=2
# A dead overseer's owner notes belong to its replacement. Keep them unread
# while recovery is pending or exhausted; a manually started replacement has
# another server-plus-pane identity and reads them on its first live pass.
OVERSEER_MAIL_HELD=0
# The launch line for this pass, as the fleet state holds it or as this pass
# recorded it.
OVERSEER_LINE=""
# Notes are per run, and a repeat-mode pass IS a run, so each reason is said
# once per pass rather than once per lane read — the same bound
# note_probe_unusable keeps.
OVERSEER_NOTED=""
overseer_note() { # REASON FIELD=VALUE...
  grep -qxF -- "$1" <<<"$OVERSEER_NOTED" && return 0
  OVERSEER_NOTED+=$'\n'"$1"
  ow_message "$@" >&2
}

# The overseer's pane, its window, and the command a successor of it runs,
# written to the fleet state WHILE THE OVERSEER IS ALIVE. A dead pane draws no
# status line and holds no harness process, so nothing read from it then can
# name the harness, the model or the account the session ran on. The record is
# what survives that, and `oversee-succeed --print-launch-line` is what builds
# it, so the line a relaunch sends and the line a succession sends come from
# one builder.
#
# The line is derived only where the state holds none: a successor recorded its
# own at the moment it was chosen, and re-deriving would overwrite a chosen
# account with whatever the pane happens to read now.
overseer_record() { # SERVER PANE WINDOW RECORDED_LINE
  local server="$1" pane="$2" window="$3" line="$4" record errf="$WORK_DIR/overseer-record.err"
  if [[ -z "$line" ]]; then
    if [[ -x "$SUCCEED" ]]; then
      line="$("$SUCCEED" --print-launch-line --handoff "$HANDOFF" ${OVERSEER_FLAGS[@]+-- "${OVERSEER_FLAGS[@]}"} 2>"$errf")" || line=""
    fi
    [[ -n "$line" ]] || overseer_note overseer-line-missing "pane=$pane" "path=$SUCCEED"
  fi
  record="$(jq -n --arg server "$server" --arg pane "$pane" --arg window "$window" --arg line "$line" \
    '{server: $server, pane: $pane, window: $window, launch_line: (if $line == "" then null else $line end)}' 2>"$errf")" \
    || { overseer_note overseer-unrecorded "pane=$pane" "step=render"; return 0; }
  "$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} \
    set oversee overseer "$record" >/dev/null 2>"$errf" \
    || { overseer_note overseer-unrecorded "pane=$pane" "step=write"; return 0; }
  OVERSEER_LINE="$line"
}

overseer_publish() { # NOTICE RECORD ERR_FILE
  local notice="$1" record="$2" errf="$3" now
  now="$(from_epoch "$PASS_NOW" '%Y-%m-%dT%H:%M:%SZ')" || now=""
  if jq -n --arg at "$now" --rawfile text "$notice" \
       '{at: $at, kind: "close", item: "overseer", text: ($text | rtrimstr("\n"))}' > "$record" 2>"$errf"
  then
    "$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} \
      append-file oversee fleet_log "$record" >/dev/null 2>"$errf" \
      || overseer_note overseer-notice-failed "channel=fleet-log"
  else
    overseer_note overseer-notice-failed "channel=fleet-log"
  fi
  "$LANE_MAIL" send --item overseer --directive --file "$notice" >/dev/null 2>"$errf" \
    || overseer_note overseer-notice-failed "channel=lane-mail"
}

# The notice every channel carries, written once into WORK_DIR: the fleet log
# reads it as the text of its record and the overseer mailbox as the body of an
# owner note, so the two cannot describe the death differently.
overseer_deliver() { # PANE WINDOW SUCCESSION PLAN
  local notice="$WORK_DIR/overseer-dead.txt" record="$WORK_DIR/overseer-dead.json"
  local errf="$WORK_DIR/overseer-deliver.err" now plan_text
  now="$(from_epoch "$PASS_NOW" '%Y-%m-%dT%H:%M:%SZ')" || now=""
  case "$4" in
    relaunch) plan_text='A successor is being launched into that window from the recorded launch line.' ;;
    off) plan_text='ORCH_OVERSEER_SUCCESSION is off, so no successor is launched; start one by hand.' ;;
    no-line) plan_text='The fleet state records no overseer launch line, so no successor is launched; start one by hand.' ;;
    no-launcher) plan_text='oversee-succeed is not installed, so no successor is launched; start one by hand.' ;;
    # Defensive: the four plans above are the whole set check_overseer calls
    # this with. A fifth would otherwise be described as one of them, so it
    # names itself rather than send a reason that is not the one.
    *) plan_text="No successor is launched; the watch reported plan $4, which it has no wording for. Start one by hand." ;;
  esac
  printf 'overseer-dead: the overseer session in tmux window %s (pane %s) read exited on %s consecutive watch passes at %s. %s\n' \
    "$2" "$1" "$DEAD_PASSES" "${now:-an unreadable clock}" "$plan_text" > "$notice" \
    || { overseer_note overseer-notice-failed "channel=file"; return 0; }
  overseer_publish "$notice" "$record" "$errf"
}

overseer_relaunch_failed() { # ROWS IDENTITY PANE WINDOW ATTEMPT STEP
  local rows="$1" identity="$2" pane="$3" window="$4" attempt="$5" step="$6"
  local retry=exhausted notice="$WORK_DIR/overseer-relaunch-failed.txt"
  local record="$WORK_DIR/overseer-relaunch-failed.json" errf="$WORK_DIR/overseer-relaunch-failed.err"
  if (( attempt < OVERSEER_RELAUNCH_ATTEMPTS )); then
    retry=pending
    rows="$(lane_row_set overseer-dead "$rows" "$identity" "pending:$attempt")"
  else
    rows="$(lane_row_set overseer-dead "$rows" "$identity" reported)"
  fi
  lane_row_commit "$rows"
  printf 'overseer-relaunch-failed: successor launch for tmux window %s (pane %s) failed on attempt %s; retry=%s; step=%s.\n' \
    "$window" "$pane" "$attempt" "$retry" "$step" > "$notice" \
    || { overseer_note overseer-notice-failed "channel=file"; return 0; }
  overseer_publish "$notice" "$record" "$errf"
  ow_message overseer-relaunch-failed "pane=$pane" "attempt=$attempt" "retry=$retry" "step=$step" >&2
}

check_overseer() {
  local pane="${TMUX_PANE:-}" window obs pid cmd screen state prior count succession plan
  local record ov_server ov_pane ov_line pane_identity server actual_pane identity rows attempt completed
  local errf="$WORK_DIR/overseer.err"
  # Off tmux there is no overseer pane to read, and with no workflow-state
  # there is nowhere to record one: either way an overseer that dies is
  # reported by nothing, which is said rather than left silent.
  [[ -n "${TMUX:-}" && -n "$pane" ]] \
    || { overseer_note overseer-unwatched "var=TMUX_PANE"; return 0; }
  [[ -x "$WORKFLOW_STATE" ]] \
    || { overseer_note overseer-unwatched "path=$WORKFLOW_STATE" "setting=OVERSEE_WATCH_WORKFLOW_STATE"; return 0; }
  # Four values, one per line, never @tsv: the launch line carries the shell
  # quoting printf %q wrote, and @tsv would escape its backslashes into the
  # reading. A command is one line, so lines are an unambiguous split here.
  record="$("$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} \
    get oversee '.overseer // {} | (.server // ""), (.pane // ""), (.window // ""), (.launch_line // "")' 2>"$errf")" \
    || { overseer_note overseer-unwatched "state=oversee"; return 0; }
  ov_server="$(sed -n 1p <<<"$record")"
  ov_pane="$(sed -n 2p <<<"$record")"
  ov_line="$(sed -n 4p <<<"$record")"

  window="$(tmux display-message -p -t "$pane" '#{window_id}' 2>"$errf")" \
    || { overseer_note overseer-unreadable "pane=$pane" "field=window_id"; return 0; }
  if ! pane_identity="$(tmux display-message -p -t "$pane" '#{pid} #{pane_id}' 2>"$errf")"; then
    overseer_note overseer-unreadable "pane=$pane" "field=identity"
    return 0
  fi
  [[ "$pane_identity" =~ ^([0-9]+)[[:blank:]]+(%[0-9]+)$ ]] \
    || { overseer_note overseer-unreadable "pane=$pane" "field=identity" "value=${pane_identity:-<empty>}"; return 0; }
  server="${BASH_REMATCH[1]}"
  actual_pane="${BASH_REMATCH[2]}"
  [[ "$actual_pane" == "$pane" ]] \
    || { overseer_note overseer-unreadable "pane=$pane" "field=identity" "value=$pane_identity"; return 0; }
  identity="$server $pane"
  if ! obs="$(tmux display-message -p -t "$pane" '#{pane_pid} #{pane_current_command}' 2>"$errf")"; then
    overseer_note overseer-unreadable "pane=$pane" "field=pane_pid"
    return 0
  fi
  [[ "$obs" =~ ^[0-9]+[[:blank:]]+[^[:space:]] ]] \
    || { overseer_note overseer-unreadable "pane=$pane" "value=${obs:-<empty>}"; return 0; }
  screen="$(tmux capture-pane -pJ -t "$pane" 2>"$errf")" \
    || { overseer_note overseer-unreadable "pane=$pane" "field=capture"; return 0; }

  OVERSEER_LINE=""
  # Pane ids restart with each tmux server. Reuse a launch line only for the
  # same server-plus-pane session; a manual replacement derives its own line.
  if [[ "$ov_server" == "$server" && "$ov_pane" == "$pane" && -n "$ov_line" ]]; then
    OVERSEER_LINE="$ov_line"
  else
    overseer_record "$server" "$pane" "$window" ""
  fi

  pid="${obs%%[[:blank:]]*}"
  cmd="${obs#*[[:blank:]]}"
  # The sixth argument is empty for the reason check_lanes gives: this watch's
  # vantage point is the pane, and a screen the pane rungs cannot settle is
  # `unjudged`, never `exited`.
  lane_state state listed "$cmd" "$pid" "$screen" \
    || { overseer_note overseer-unreadable "pane=$pane" "scan=usage-limit"; return 0; }
  [[ "$LANE_PROBE_RC" -le 1 ]] || note_probe_unusable "$pane"

  # One row, keyed by server plus pane: `<count>` while readings accumulate,
  # `pending:N` after a failed launch, and `reported` after notice-only or the
  # bounded recovery attempts are spent.
  rows="$(lane_row_prune overseer-dead "${PW_SEEN[0]}" "$identity")"
  if [[ "$state" != exited ]]; then
    rows="$(lane_row_clear overseer-dead "$rows" "$identity")"
    lane_row_commit "$rows"
    return 0
  fi
  if ! prior="$(lane_row_get overseer-dead "$rows" "$identity")"; then
    die state-read-failed "" "pane=$pane" "row=overseer-dead"
  fi
  if [[ "$prior" == reported ]]; then
    OVERSEER_MAIL_HELD=1
    lane_row_commit "$rows"
    return 0
  fi
  if [[ "$prior" =~ ^pending:([0-9]+)$ ]]; then
    OVERSEER_MAIL_HELD=1
    completed="${BASH_REMATCH[1]}"
    attempt=$((completed + 1))
    (( attempt <= OVERSEER_RELAUNCH_ATTEMPTS )) \
      || { lane_row_commit "$(lane_row_set overseer-dead "$rows" "$identity" reported)"; return 0; }
  else
    [[ -z "$prior" || "$prior" =~ ^[0-9]+$ ]] \
      || die state-read-failed "" "pane=$pane" "row=overseer-dead" "value=$prior"
    count=1
    [[ -z "$prior" ]] || count=$((prior + 1))
    if (( count < DEAD_PASSES )); then
      lane_row_commit "$(lane_row_set overseer-dead "$rows" "$identity" "$count")"
      return 0
    fi
    attempt=1
  fi

  succession=on
  [[ "${ORCH_OVERSEER_SUCCESSION:-on}" != off ]] || succession=off
  plan=relaunch
  if [[ "$succession" == off ]]; then plan=off
  elif [[ ! -x "$SUCCEED" ]]; then plan=no-launcher
  elif [[ -z "$OVERSEER_LINE" ]]; then plan=no-line
  fi
  if [[ "$prior" != pending:* ]]; then
    OVERSEER_MAIL_HELD=1
    if [[ "$plan" == relaunch ]]; then
      lane_row_commit "$(lane_row_set overseer-dead "$rows" "$identity" pending:0)"
    else
      lane_row_commit "$(lane_row_set overseer-dead "$rows" "$identity" reported)"
    fi
    echo "EVENT overseer-dead $pane window=$window passes=$DEAD_PASSES succession=$succession"
    PASS_EVENT=1
    overseer_deliver "$pane" "$window" "$succession" "$plan"
  fi
  if [[ "$plan" != relaunch ]]; then
    [[ "$prior" != pending:* ]] || overseer_relaunch_failed "$rows" "$identity" "$pane" "$window" "$attempt" "plan-$plan"
    return 0
  fi

  printf '%s\n' "$OVERSEER_LINE" > "$WORK_DIR/overseer-line" \
    || { overseer_relaunch_failed "$rows" "$identity" "$pane" "$window" "$attempt" line-file; return 0; }
  # Its stdout joins its stderr: this watch's stdout is the event protocol, and
  # oversee-succeed's own keyed lines are the detail under the event, not
  # records of their own.
  if "$SUCCEED" --dead-pane "$pane" --line-file "$WORK_DIR/overseer-line" >&2; then
    OVERSEER_SUCCEEDED=1
  else
    overseer_relaunch_failed "$rows" "$identity" "$pane" "$window" "$attempt" launcher
  fi
}

check_lanes() {
  # No lane to watch still leaves the items: a handoff is read from state.
  [[ ${#LANES[@]} -gt 0 ]] || { check_handoff; return 0; }
  local lane pane below cmd pid state window i states="" claims="" claimed pane_key
  local seen seen_at seen_pane seen_reported seen_key reset_at reset_utc reset_note event
  local asking_state fingerprint prior turn_identity capacity capacity_key screen_key close_failed=0
  # One liveness read and one pane capture per lane per pass: a lane's kind is
  # decided from a single observation, never from two screens taken apart. The
  # pid leads the format so a command carrying a space cannot shift the split.
  # The kind itself is lib/lane-state.sh's, the one judge `open-terminal
  # --wake` also asks, so the two read one pane by one set of rungs instead of
  # inventing a classification each. Every loop below reads its verdict out of
  # `states` and classifies nothing of its own.
  #
  # The sixth argument, the harness process read through /proc, is empty here:
  # the watch's whole vantage point is the tmux pane, and a hosted lane's
  # harness runs on another machine anyway. With it empty the judge answers
  # `unjudged` for a screen its pane rungs cannot settle, where the wake, which
  # does pass it, can still answer.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    window=gone; pid=""; cmd=""; pane=""
    if [[ "$(lane_obs_state "$LANE_OBS" "$i")" == ready ]]; then
      window=listed
      pid="$(lane_field "$LANE_OBS" "$i" 3)"
      cmd="$(lane_field "$LANE_OBS" "$i" 4)"
      pane="$(cat -- "$(lane_pane_file "$i")")"
    fi
    # The judge exits 2 on exactly one condition, a banner scan that failed,
    # and observe_lanes already ran that scan over this slice of this capture
    # file and died `limit-scan-failed` on it. So this refuses the same
    # condition under the same reason rather than inventing a second one, and
    # in an ordinary pass it is unreachable: the status is checked because a
    # verdict nothing looked at is how a lane gets read as having no news.
    lane_state state "$window" "$cmd" "$pid" "$pane" \
      || die limit-scan-failed "" "lane=$lane"
    # A probe that could not run is not an answer: the judge falls through to
    # the screen, a lane it cannot classify stays watched, and the status is
    # noted once — a wrong lane-exited retires a working lane while a missed
    # one costs a pass.
    [[ "$LANE_PROBE_RC" -le 1 ]] || note_probe_unusable "$lane"
    states+="$i"$'\t'"$state"$'\n'
    if [[ "$state" == gone ]]; then
      echo "EVENT window-gone $lane"
      PASS_EVENT=1
    fi
  done
  # A lane window outlives its harness: open-terminal runs claude/codex inside
  # a shell, so a session that hit its limit, crashed, or quit leaves the
  # shell in the foreground — a window that exists, a pane that matches no
  # question prompt, and a slot held until someone looks. A bare shell with
  # nothing running under it IS that lane, finished; the pane tail carries
  # why. Two consecutive passes: a live harness can hold a childless shell in
  # the foreground for one poll, and relaunching a working lane costs more
  # than one interval. The first pass is a `lane-exited` row keyed by the
  # pane, so the second can be the next run's first; that second pass marks
  # the row reported, so a later run over the same pane stays silent, and a
  # replacement pane starts over and is news again.
  asking_state="${PW_SEEN[0]}"
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_obs_state "$states" "$i")" != exited ]]; then
      asking_state="$(lane_row_clear lane-exited "$asking_state" "$lane")"
      continue
    fi
    pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
    prior="$(lane_row_get lane-exited "$asking_state" "$lane")"
    if [[ "$prior" == "$pane_key|reported" ]]; then continue; fi
    if [[ "$prior" == "$pane_key" ]]; then
      asking_state="$(lane_row_set lane-exited "$asking_state" "$lane" "$pane_key|reported")"
      echo "EVENT lane-exited $lane"
      pane="$(cat -- "$(lane_pane_file "$i")")"
      [[ -z "$pane" ]] || pane_tail "$pane"
      PASS_EVENT=1
      asking_state="$(lane_row_clear lane-asking "$asking_state" "$lane")"
      # A worktree still standing is a lane stopped inside merge-pr.md § 5,
      # which the overseer resumes; its sandbox closes on the exit after that.
      hosted_lane_item "$lane"
      if [[ -n "$HOSTED_ROOT" && -n "$(lane_row_get merged "$asking_state" "$LANE_ITEM")" ]] \
         && grep -qxF -- "$LANE_ITEM" <<<"$HOSTED_GONE_ITEMS"; then
        # Committed before the close, which cannot be undone: a run that stops
        # after a close must not close this lane a second time.
        lane_row_commit "$asking_state"
        if ! close_hosted_lane "$LANE_ITEM"; then
          # Left unreported, so the next run reports this exit and retries.
          asking_state="$(lane_row_set lane-exited "$asking_state" "$lane" "$pane_key")"
          close_failed=1
        fi
      fi
    else
      asking_state="$(lane_row_set lane-exited "$asking_state" "$lane" "$pane_key")"
    fi
  done
  lane_row_commit "$asking_state"
  check_handoff
  # check_handoff commits its rows through PW_SEEN; a copy taken before it
  # would write them back out on the next commit below.
  asking_state="${PW_SEEN[0]}"
  # The harness is still running and the account is spent: every lane on that
  # account dies with it, so the config dir is the actionable part and a live
  # claim is where it is recorded. A walled lane is neither asking nor idle: a
  # limit banner can sit above a stale prompt, and the account is the news, so
  # the two loops below skip it. One pass: a banner is terminal for that
  # account window, not a screen a poll can catch mid-draw. Only below the last
  # user turn: a banner the lane has since worked past is the screen
  # remembering a spent window that has since reset.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_obs_state "$states" "$i")" != walled ]]; then continue; fi
    pane="$(cat -- "$(lane_pane_file "$i")")"
    pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
    # The banner states when the wall lifts, and that decides which event
    # this is. A reset already behind us means the lane is parked against a
    # window that has since reopened — the harness will not notice on its
    # own — so it is bumped, not waited on. The wall's day comes from the
    # row observe_lanes stamped, never from the banner: with no row, or with
    # a reset `date` would not resolve, the plain event goes out with no
    # time on it and the lane is parked. `resets=` is keyed rather than
    # positional because the config dir before it is optional.
    if ! seen="$(lane_row_get usage-limit "$asking_state" "$lane")"; then
      die state-read-failed "" "lane=$lane" "row=usage-limit"
    fi
    seen_at=""; seen_pane=""; seen_reported=""; seen_key=""
    [[ -z "$seen" ]] || IFS='|' read -r seen_at seen_pane seen_reported seen_key <<<"$seen"
    reset_at=""
    [[ -z "$seen_key" ]] || reset_at="$(usage_reset_epoch "$seen_key" "$seen_at")"
    event=usage-limit
    reset_note=""
    reset_utc=""
    [[ -z "$reset_at" ]] || reset_utc="$(from_epoch "$reset_at" '%Y-%m-%dT%H:%M:%SZ' || true)"
    if [[ -n "$reset_utc" ]]; then
      reset_note=" resets=$reset_utc"
      [[ "$reset_at" -gt "$PASS_NOW" ]] || event=usage-limit-passed
    fi
    # The wall was reported on an earlier pass and nothing about it has
    # changed: the row is observe_lanes's stamp for this pane and this
    # wall, and the reported column names the event it went out as. The
    # lane stays walled above; a reset going by turns the event into
    # usage-limit-passed, which is news once more.
    if [[ "$seen_reported" == "$event" ]]; then continue; fi
    # The detail is a nicety; a claim store this process cannot read must
    # not take down the event that carries the pane tail. Read here, below
    # the suppression, so its note qualifies a line that is going out.
    claims="$(lane_claims_read "$(lane_claims_dir "$PROJECT_ROOT")" || true)"
    # Claims are kept for every live tmux server, and a window NAME is
    # unique only within a session: the account is resolved on the pane
    # actually captured here — `<server pid> <pane id>`, the same key the
    # claim's liveness uses — so no other lane can answer for it.
    # An unreadable claim store is already tolerated above; a resolver that
    # fails on a readable one is not the same thing, and the event goes out
    # without an account rather than with another lane's.
    claimed="$(lane_claims_config_dir "$claims" "${pane_key%% *}" "${pane_key##* }")" || claimed=""
    if [[ -z "$claimed" && -n "$claims" ]]; then
      ow_message claim-missing "lane=$lane" >&2
    fi
    echo "EVENT $event $lane${claimed:+ $claimed}$reset_note"
    [[ -z "$pane" ]] || pane_tail "$pane"
    PASS_EVENT=1
    asking_state="$(lane_row_set usage-limit "$asking_state" "$lane" "${seen_at:-$PASS_NOW}|${seen_pane:-$pane_key}|$event|$seen_key")"
  done
  # A pane keeps its last screen, so neither a stale prompt under a bare shell
  # nor a dialog answered passes ago is a live question. A current prompt is
  # keyed by its pane slice across watch invocations: emit it once, clear the
  # key when it disappears, and emit again only when the prompt changes.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    # A lane that is up and not asking drops its row; one that is walled,
    # exited or unjudged keeps it. A wall can sit above a standing question,
    # and the row is what stops the question being re-reported once the wall
    # lifts; gone and exited clear it on their own paths.
    case "$(lane_obs_state "$states" "$i")" in
      asking) ;;
      working|idle)
        asking_state="$(lane_row_clear lane-asking "$asking_state" "$lane")"
        continue ;;
      *) continue ;;
    esac
    pane="$(cat -- "$(lane_pane_file "$i")")"
    below="$(pane_below_last_turn "$pane")"
    pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
    turn_identity="$(pane_turn_identity "$pane")"
    fingerprint="${pane_key}|${turn_identity}|$(printf '%s' "$below" | cksum)"
    if ! prior="$(lane_row_get lane-asking "$asking_state" "$lane")"; then
      die state-read-failed "" "lane=$lane" "row=lane-asking"
    fi
    asking_state="$(lane_row_set lane-asking "$asking_state" "$lane" "$fingerprint")"
    if [[ "$fingerprint" == "$prior" ]]; then continue; fi
    echo "EVENT lane-asking $lane"
    pane_tail "$pane"
    PASS_EVENT=1
  done
  # The round is over and nobody is driving: the harness is up, at its input
  # prompt, with nothing in flight. Two consecutive passes, because the screen
  # between a finished tool call and the next one reads the same; the first is
  # a `lane-idle` row keyed by the pane and the slice below its last turn, as
  # for lane-exited above. The second pass reports it and marks the row, so a
  # lane left sitting at the same screen is reported once, however many runs
  # look at it; a turn taken changes the slice and starts the count over. A
  # lane that is walled, asking, working or exited is not idle and drops its
  # row.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    capacity=0
    if [[ "$(lane_obs_state "$states" "$i")" == idle ]]; then
      pane="$(cat -- "$(lane_pane_file "$i")")"
      below="$(pane_below_last_turn "$pane")"
      # Which idle this is, not whether it is idle: the judge already settled
      # that. Codex parks the same way on a capacity refusal as on a finished
      # turn, and only the refusal line tells the two apart.
      if grep -Eq -- "$CODEX_MARKER_RE" <<<"$below" && grep -qF -- "$MODEL_CAPACITY" <<<"$below"; then
        capacity=1
      fi
    else
      asking_state="$(lane_row_clear lane-idle "$asking_state" "$lane")"
      asking_state="$(lane_row_clear model-capacity "$asking_state" "$lane")"
      continue
    fi
    pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
    if [[ "$capacity" -eq 1 ]]; then
      # Capacity uses a turn-bound row. An earlier idle report cannot consume
      # the first stop after a continuation.
      capacity_key="${LANE_TURNS[$i]}"
      if ! prior="$(lane_row_get model-capacity "$asking_state" "$lane")"; then
        die state-read-failed "" "lane=$lane" "row=model-capacity"
      fi
      asking_state="$(lane_row_clear lane-idle "$asking_state" "$lane")"
      if [[ "$prior" == "$capacity_key" ]]; then continue; fi
      asking_state="$(lane_row_set model-capacity "$asking_state" "$lane" "$capacity_key")"
      echo "EVENT model-capacity $lane"
      pane_tail "$pane"
      PASS_EVENT=1
      continue
    fi
    asking_state="$(lane_row_clear model-capacity "$asking_state" "$lane")"
    # The whole slice below the last turn is the key: any change to what the
    # lane shows is a different idle screen and news again. A repaint of an
    # older frame does not reach here, since a scrolled view carries `Jump to
    # bottom` and pane_working reads that frame as working.
    screen_key="${pane_key}|$(printf '%s' "$below" | cksum)"
    prior="$(lane_row_get lane-idle "$asking_state" "$lane")"
    if [[ "$prior" == "$screen_key|reported" ]]; then continue; fi
    if [[ "$prior" == "$screen_key" ]]; then
      asking_state="$(lane_row_set lane-idle "$asking_state" "$lane" "$screen_key|reported")"
      echo "EVENT idle-after-return $lane"
      pane_tail "$pane"
      PASS_EVENT=1
    else
      asking_state="$(lane_row_set lane-idle "$asking_state" "$lane" "$screen_key")"
    fi
  done
  # Committed after every asking and idle line is out: a row written ahead of
  # its event would make a crash between the two lose the question for good.
  lane_row_commit "$asking_state"
  # A failed close ends the pass only here, once every lane check above has
  # reported what it found.
  [[ "$close_failed" -eq 0 ]] || exit 2
}

# Every --repo's open PRs, each line prefixed with its repo as the reducer's
# are, and all of them read before the event line goes out: a repo that
# cannot be listed is a failed pass, not a heartbeat missing a repo.
heartbeat() {
  local errf="$WORK_DIR/open.err" repo open open_all=""
  for repo in "${REPOS[@]}"; do
    open="$(gh pr list --repo "$repo" --state open --limit 50 --json number,headRefName,title \
      --jq '.[] | "\(.number)\t\(.headRefName)\t\(.title)"' 2>"$errf")" \
      || die pr-list-failed "$(cat "$errf")" "repo=$repo" "state=open"
    [[ -z "$open" ]] || open_all+="$(pw_prefix "$repo" "$open")"$'\n'
  done
  echo "EVENT heartbeat loops=$MAX_LOOPS interval=${INTERVAL}s since=${SINCE:-none}"
  [[ -z "$open_all" ]] || printf '%s' "$open_all"
  pr_watch_context
  exit 0
}

loop=0
# One clock per pass. The stamp a lane's wall is observed on and the comparison
# that decides whether it has lifted are the same reading, so a slow pass
# cannot put them on either side of the reset. A pass that cannot read it
# classifies nothing, here or in triage, so it stops rather than carrying an
# unstamped sighting forward: there is no state below in which a row exists
# without the clock that earned it.
PASS_NOW=""
# Set by any check that printed an event this pass. Every check runs on either
# way; the pass ends here, once, with the pr-watch context closing the block.
PASS_EVENT=0
PASS_FAILED=0
PASS_FAILED_ITEMS=""
while :; do
  loop=$((loop + 1))
  PASS_NOW="$(date -u +%s)" || die time-failed "" "clock=UTC"
  PASS_EVENT=0
  PASS_FAILED=0
  PASS_FAILED_ITEMS=""
  # First: an overseer that is gone is the one condition under which no other
  # event this pass finds has a reader. A successful relaunch ends the pass
  # here, so the mail the successor drains is not drained on its behalf.
  check_overseer
  [[ "$OVERSEER_SUCCEEDED" -eq 0 ]] || exit 3
  observe_lanes
  check_pr_watch
  check_merged
  check_triage
  check_mail
  check_lanes
  if [[ "$PASS_FAILED" -eq 1 ]]; then
    pr_watch_context
    exit 2
  fi
  if [[ "$PASS_EVENT" -eq 1 ]]; then
    pr_watch_context
    exit 0
  fi
  [[ "$loop" -lt "$MAX_LOOPS" ]] || heartbeat
  sleep "$INTERVAL"
done
