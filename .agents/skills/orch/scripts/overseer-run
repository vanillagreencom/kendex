#!/usr/bin/env bash
# overseer-run — runs an overseer session's launch command and, once it
# returns, writes the harness's exit status into the oversee state's session
# record, so a harness killed before its SessionEnd hook ran is still read as
# gone without anyone reading its pane.
#
# Usage: overseer-run COMMAND [ARG]...
#
# COMMAND inherits stdin and the launch environment. The foreground Bash
# child records its own PID and start before exec COMMAND. The parent writes
# COMMAND status only against that exact run. Failed record operations report
# their cause and COMMAND still runs. Outside tmux no record is read or written.
set -euo pipefail

usage() { sed -n '/^# Usage:/,/^# their cause/p' "$0" | sed 's/^# \{0,1\}//'; }
case "${1:-}" in
  -h | --help | help) usage; exit 0 ;;
  "") usage >&2; exit 2 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

# Every line this script writes, and the only place its text lives.
message() { # KEY VALUE CAUSE
  printf 'overseer-run: %s=%s\n%s\n' "$1" "$2" "$3" >&2
}

# The pane key is lib/lane-context.sh's, the pair the record keys the session
# on; the writers are the record's owner. A library or a key that cannot be
# had costs the record and never the session: KEY stays empty and COMMAND
# still runs. Outside tmux there is no pane and no record names one.
KEY="" CAUSE="" RUN_FILE=""
if [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]]; then
  DEP_ERR="$(mktemp)" || DEP_ERR=""
  if [[ -z "$DEP_ERR" ]]; then
    CAUSE="mktemp failed"
  else
    trap 'rm -f -- "${DEP_ERR:?}"; [[ -z "$RUN_FILE" ]] || rm -f -- "${RUN_FILE:?}"' EXIT
    # shellcheck source=lib/lane-context.sh
    # shellcheck source=lib/overseer-launch.sh
    if ! { source "$SCRIPT_DIR/lib/lane-context.sh" && source "$SCRIPT_DIR/lib/overseer-launch.sh"; } 2>"$DEP_ERR"; then
      CAUSE="$(cat -- "$DEP_ERR")"
    elif ! KEY="$(lane_context_caller_key)"; then
      KEY="" CAUSE="tmux reported no server pid for pane $TMUX_PANE"
    elif ! RUN_FILE="$(mktemp)"; then
      KEY="" CAUSE="mktemp failed"
    fi
  fi
fi

rc=0
if [[ -n "$KEY" ]]; then
  # A new Bash process has its own $$ on Bash 3.2 too. A parenthesized
  # subshell would retain the wrapper PID, which can outlive COMMAND.
  "$BASH" -c '
    set -euo pipefail
    key=$1 DEP_ERR=$2 run_file=$3
    shift 3
    start=""
    if { source "$SCRIPT_DIR/lib/lane-state.sh" && source "$SCRIPT_DIR/lib/overseer-launch.sh"; } 2>"$DEP_ERR"; then
      if start="$(lane_process_start "$$")" && [[ -n "$start" ]]; then
        ol_record_start "${key%% *}" "${key#* }" "$$" "$start" >"$run_file" || true
      else
        printf "process-start-unreadable\n" >"$DEP_ERR"
      fi
    fi
    if [[ ! -s "$run_file" ]]; then
      printf "overseer-run: start-unrecorded=pending\n" >&2
      cat -- "$DEP_ERR" >&2
    fi
    exec "$@"
  ' overseer-run "$KEY" "$DEP_ERR" "$RUN_FILE" "$@" || rc=$?
else
  [[ -z "${TMUX:-}" || -z "${TMUX_PANE:-}" ]] || message start-unrecorded pending "$CAUSE"
  "$@" || rc=$?
fi

[[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] || exit "$rc"
RUN=""
if [[ -n "$RUN_FILE" && -s "$RUN_FILE" ]]; then
  RUN="$(cat -- "$RUN_FILE")" || RUN=""
fi
if [[ -z "$RUN" ]]; then
  message exit-unrecorded "$rc" "${CAUSE:-no recorded run identity}"
elif ! ol_record_exit "$RUN" "$rc"; then
  message exit-unrecorded "$rc" "$(cat -- "$DEP_ERR")"
fi
exit "$rc"
