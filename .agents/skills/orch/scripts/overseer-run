#!/usr/bin/env bash
# overseer-run — runs an overseer session's launch command and, once it
# returns, writes the harness's exit status into the oversee state's session
# record, so a harness killed before its SessionEnd hook ran is still read as
# gone without anyone reading its pane.
#
# Usage: overseer-run COMMAND [ARG]...
#
# lib/overseer-launch.sh's ol_session_open puts this in front of every line an
# overseer launch types into its pane. Before COMMAND runs, the record's
# `overseer.exit` is dropped where the record names this pane on this tmux
# server (ol_record_exit_clear), so a line run again in the same pane carries
# no status its predecessor earned. COMMAND runs as this script's child, so
# the status is the one the shell would have seen, and tmux names this
# script's bash as the pane's foreground command for the session's whole
# life: a reader of a launched overseer's harness takes it from its launch
# record or its SessionStart row (lib/overseer-launch.sh ol_caller_known). The record takes it as
# `overseer.exit = {status, at}` only where it names this pane on this tmux
# server (ol_record_exit); outside tmux nothing is read or written. A pane
# key, a library or a write that fails is said on stderr under
# `overseer-run: exit-unrecorded=<status>`, or `exit-uncleared=pending` for
# the clear; the command's own status is this script's either way.
set -euo pipefail

usage() { sed -n '/^# Usage:/,/^# the clear; the command/p' "$0" | sed 's/^# \{0,1\}//'; }
case "${1:-}" in
  -h | --help | help) usage; exit 0 ;;
  "") usage >&2; exit 2 ;;
esac

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

# Every line this script writes, and the only place its text lives.
message() { # KEY VALUE CAUSE
  case "$1" in
    exit-uncleared) printf 'overseer-run: exit-uncleared=%s\nthe exit status an earlier session in this pane left on the session record could not be dropped, so the watch may read this session as ended until a launch or a watch start rewrites the record:\n%s\n' "$2" "$3" >&2 ;;
    exit-unrecorded) printf 'overseer-run: exit-unrecorded=%s\nthe exit status could not be written to the session record, so the watch reads this session from its rows and its pane:\n%s\n' "$2" "$3" >&2 ;;
  esac
}

# The pane key is lib/lane-context.sh's, the pair the record keys the session
# on; the writers are the record's owner. A library or a key that cannot be
# had costs the record and never the session: KEY stays empty and COMMAND
# still runs. Outside tmux there is no pane and no record names one.
KEY="" CAUSE=""
if [[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]]; then
  DEP_ERR="$(mktemp)" || DEP_ERR=""
  if [[ -z "$DEP_ERR" ]]; then
    CAUSE="mktemp failed"
  else
    trap 'rm -f -- "${DEP_ERR:?}"' EXIT
    # shellcheck source=lib/lane-context.sh
    # shellcheck source=lib/overseer-launch.sh
    if ! { source "$SCRIPT_DIR/lib/lane-context.sh" && source "$SCRIPT_DIR/lib/overseer-launch.sh"; } 2>"$DEP_ERR"; then
      CAUSE="$(cat -- "$DEP_ERR")"
    elif ! KEY="$(lane_context_caller_key)"; then
      KEY="" CAUSE="tmux reported no server pid for pane $TMUX_PANE"
    elif ! ol_record_exit_clear "${KEY%% *}" "${KEY#* }"; then
      message exit-uncleared pending "$(cat -- "$DEP_ERR")"
    fi
  fi
fi

rc=0
"$@" || rc=$?

[[ -n "${TMUX:-}" && -n "${TMUX_PANE:-}" ]] || exit "$rc"
if [[ -z "$KEY" ]]; then
  message exit-unrecorded "$rc" "$CAUSE"
elif ! ol_record_exit "${KEY%% *}" "${KEY#* }" "$rc"; then
  message exit-unrecorded "$rc" "$(cat -- "$DEP_ERR")"
fi
exit "$rc"
