#!/usr/bin/env bash
# The overseer's one way to type into a pane: the command line over
# lib/pane-write.sh, which holds every rule and every refusal.
# Bash 3.2-safe: tools/bash32-lint scans this directory.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source "$SCRIPT_DIR/lib/lane-state.sh"
source "$SCRIPT_DIR/lib/pane-write.sh"

usage() {
  cat <<'EOF'
Usage: pane-write (--window WINDOW | --pane PANE) --expect PROCESS
                  (--file PATH | --key KEY) [--state-dir DIR]

Type into one tmux pane, only after proving it is the pane meant and that it
runs the process meant. Nothing is typed on a refusal.

  --window WINDOW  the lane record's window, bare or SESSION:WINDOW, resolved
                   the way lanes state and lane-close resolve it
  --pane PANE      a pane id (%N) the caller proved, such as the one
                   tmux new-window -P printed for a window it opened
  --expect PROCESS the process the pane must run: the lane's harness (claude,
                   codex, pi, copilot), ssh for a lane whose record carries
                   host, or shell for a window just opened, which accepts bash,
                   zsh, fish, sh, dash and tmux's default-shell, read again for
                   up to $PANE_WRITE_SETTLE_SECS (default 2, 0-99) while a
                   default-command wrapper holds the pane. For any name but
                   shell, the pane's foreground command, or the pane process or
                   a process below it, must carry the name; copilot's process
                   carries MainThread on Linux, which it matches too
  --file PATH      paste the file's bytes as one bracketed paste, then Enter
  --key KEY        press one key: Enter, Up, Down, C-c or a digit 0-9
  --state-dir DIR  the fleet state directory that records the hosted lane

A recorded hosted window with pane=verb sends input through the provider.
--expect ssh uses the record's harness process for the remote check.

Copy mode is cancelled before every keystroke.

Exit 0 wrote. Every other exit prints `pane-write: KEY FIELD=VALUE...` and a
`fix=` line on stderr.

Exit 1 is a refusal, and nothing was typed:

  pane-unresolved   the target is empty, --pane is not a pane id, or a
                    pane=verb host has no lane record naming this target
  pane-self         the target is the pane this command runs in ($TMUX_PANE)
  pane-missing      no pane on this server carries the target
  pane-ambiguous    two or more panes carry the window name
  pane-read-failed  tmux or the process table did not answer
  process-mismatch  the pane does not run PROCESS; running= names what it runs
  expect-missing    --expect is empty
  settle-invalid    PANE_WRITE_SETTLE_SECS is not a whole number from 0 to 99
  key-invalid       --key names a key outside the list above
  file-unreadable   --file is not a readable regular file
  argument-invalid  an option is unknown, repeated or missing its value, or a
                    required option is absent

Exit 2 is a pane write that failed after the checks passed, so part of the
input may have landed; read the pane before writing again:

  write-failed      step= names the input step that failed
EOF
}

refuse_args() { # FIELD=VALUE
  pane_write_message argument-invalid "$1" >&2
  exit 1
}

kind="" target="" expect="" action="" value="" expect_set=false state_dir_set=false state_args=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --window|--pane)
      [[ -z "$kind" ]] || refuse_args "option=$1"
      [[ $# -ge 2 ]] || refuse_args "option=$1"
      kind="${1#--}"; target="$2"; shift 2 ;;
    --expect)
      [[ "$expect_set" == false && $# -ge 2 ]] || refuse_args "option=$1"
      expect="$2"; expect_set=true; shift 2 ;;
    --file|--key)
      [[ -z "$action" && $# -ge 2 ]] || refuse_args "option=$1"
      action="${1#--}"; value="$2"; shift 2 ;;
    --state-dir)
      [[ "$state_dir_set" == false && $# -ge 2 && -n "$2" ]] || refuse_args "option=$1"
      state_dir_set=true; state_args=(--state-dir "$2"); shift 2 ;;
    *) refuse_args "option=$1" ;;
  esac
done
[[ -n "$kind" ]] || refuse_args option=--window
[[ "$expect_set" == true ]] || refuse_args option=--expect
[[ -n "$action" ]] || refuse_args option=--file

# A recorded hosted window can be dormant. Resolve the local target first
# to preserve the empty, self and ambiguous-window refusals before provider input.
pane_write_input "$action" "$value" || exit $?
source "$SCRIPT_DIR/lib/lane-claims.sh"
pane_write_resolve "$kind" "$target" || exit $?
records="" record=""
exists="$("$SCRIPT_DIR/workflow-state" ${state_args[@]+"${state_args[@]}"} exists --json oversee | jq -r '.exists')" \
  || { pane_write_refuse 1 pane-read-failed "window=$target" operation=state; exit 1; }
if [[ "$exists" == true ]]; then
  lookup_window="$target"
  if [[ "$kind" == pane ]]; then
    lookup_window="$(tmux display-message -p -t "$PANE_WRITE_ID" '#{session_name}:#{window_name}')" \
      || { pane_write_refuse 1 pane-read-failed "pane=$target" operation=display-message; exit 1; }
  fi
  records="$("$SCRIPT_DIR/workflow-state" ${state_args[@]+"${state_args[@]}"} get oversee '.lanes // []')" \
    && record="$(lane_running_record "$records" "$lookup_window" "" session)" \
    || { pane_write_refuse 1 pane-read-failed "window=$target" operation=state; exit 1; }
fi
if [[ -n "$record" ]]; then
  host="$(jq -r '.host // "local"' <<<"$record")" \
    || { pane_write_refuse 1 pane-read-failed "window=$target" operation=state-field field=host; exit 1; }
  lane_pane_mode mode "$host" || exit 1
  if [[ "$mode" == verb ]]; then
    harness="$(jq -r '.harness // empty' <<<"$record")" \
      || { pane_write_refuse 1 pane-read-failed "window=$target" operation=state-field field=harness; exit 1; }
    [[ -n "$expect" ]] || { pane_write_refuse 1 expect-missing "window=$target"; exit 1; }
    [[ "$expect" == ssh || "$expect" == "$harness" ]] \
      || { pane_write_refuse 1 process-mismatch "window=$target" "expected=$expect" "running=$harness"; exit 1; }
    target="$(jq -r '.item // empty' <<<"$record")" \
      || { pane_write_refuse 1 pane-read-failed "window=$target" operation=state-field field=item; exit 1; }
    kind=host expect="$harness"
    export ORCH_LANE_HOST="$host"
  fi
else
  selected_host="$("$SCRIPT_DIR/lane-host" resolve)" || exit 1
  lane_pane_mode mode "$selected_host" || exit 1
  [[ "$mode" != verb ]] || { pane_write_refuse 1 pane-unresolved kind=host "window=$target" item=; exit 1; }
fi
rc=0
if [[ "$kind" == host ]]; then
  pane_write "$kind" "$target" "$expect" "$action" "$value" || rc=$?
else
  pane_write_resolved "$expect" "$action" "$value" || rc=$?
fi
exit "$rc"
