#!/usr/bin/env bash
# Run the repository's post-merge steps from its base checkout.
set -euo pipefail
mode=full
case "${1:-}" in
  -h|--help)
    printf '%s\n' 'usage: post-merge [--refresh-only] [BASE_CHECKOUT]' 'Run in the base checkout; stop at the first failed step.' \
      '--refresh-only  the refresh and the restore alone, for a hosted fleet whose control host ran sync-base itself and whose CI and lane built and verified.'
    exit 0 ;;
  --refresh-only) mode=refresh-only; shift ;;
esac
status() { printf 'post-merge: %s=%s\n' "$1" "$2"; }
untracked() { git status --porcelain --untracked-files=all -z | tr '\0' '\n' | LC_ALL=C sort; }
# The checkout back to HEAD: tracked paths restored, and the untracked paths
# that appeared since BEFORE removed, so an untracked file that was there
# before the refresh is kept as sync-base keeps it.
restore() { # BEFORE — the untracked listing before the refresh
  local after new
  git checkout -q -- . || return 1
  after="$(untracked)" || return 1
  new="$(LC_ALL=C comm -13 <(printf '%s\n' "$1") <(printf '%s\n' "$after") | sed -n 's/^?? //p')" || return 1
  [[ -n "$new" ]] || return 0
  printf '%s\n' "$new" | while IFS= read -r path; do git clean -fdq -- "$path" || exit 1; done
}
step() {
  local name="$1" rc=0; shift
  "$@" || rc=$?
  status "$name" "$rc"; return "$rc"
}
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" || exit 1
[[ $# -le 1 ]] || { status arguments "$#"; exit 2; }
cd -- "${1:-.}" || { status checkout 1; exit 1; }
if [[ "$mode" == full ]]; then
  step sync-base "$SCRIPT_DIR/sync-base" . || exit $?
  ORCH_POST_MERGE_BEFORE="$(git rev-parse refs/kendex/post-merge-base)" || { status sync-base 1; exit 1; }
  ORCH_POST_MERGE_AFTER="$(git rev-parse HEAD)" || { status sync-base 1; exit 1; }
  export ORCH_POST_MERGE_BEFORE ORCH_POST_MERGE_AFTER
  COMMAND="$("$SCRIPT_DIR/orch-env" ORCH_POST_MERGE_CMD '')" || { status command 1; exit 1; }
  if [[ -n "$COMMAND" ]]; then
    step command bash -c "$COMMAND" || exit $?
  else
    status command skipped
  fi
  git update-ref refs/kendex/post-merge-base "$ORCH_POST_MERGE_AFTER" || { status checkpoint 1; exit 1; }
fi
if [[ -f kendex.toml ]]; then
  # The refresh judges and the checkout keeps the committed record, whatever
  # the refresh and the verify returned: a project that records on its
  # default branch after each merge (docs/decisions/D007-lock-record-on-main.md)
  # leaves that record stale until its rolling pull request lands, the next
  # sync-base refuses a dirty checkout, and its fast-forward refuses an
  # untracked path the landing would overwrite.
  before="$(untracked)" || { status restore 1; exit 1; }
  rc=0
  step refresh kendex refresh --scope project --yes --leave || rc=$?
  [[ $rc -ne 0 || "$mode" != full ]] || step verify kendex verify --scope project || rc=$?
  step restore restore "$before" || exit $?
  [[ $rc -eq 0 ]] || exit $rc
else
  status refresh skipped
  [[ "$mode" != full ]] || status verify skipped
fi
