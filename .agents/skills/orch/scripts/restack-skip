#!/usr/bin/env bash
# restack-skip — say whether a restacked head needs its range re-test, or
# whether the last passing validation run already covers it.
#
# The cost this removes: two lanes that change one package each raise its
# metadata.version, so the second to merge restacks over that one line and
# then re-validates code no line of which moved.
#
# The comparison is the tree the last passing run validated, merged with the
# base's new commits, against the restacked HEAD's tree. The run is the one
# `dev-validate-run --last-pass` names in the worktree; the merge is
# `git merge-tree --write-tree` of the new base and a commit of that tree on
# the HEAD the run started at, so the merge base is the fork point the
# validated tree sat on. The restack skips its re-test on one of two
# conditions:
#   no-conflict   the merge conflicted nowhere and its tree is HEAD's tree
#   version-only  every conflict the merge reports is a content conflict in
#                 a file commit-guards names as a changelog, version, package
#                 or render file, and in each such file the merge and HEAD
#                 differ only in that kind's own lines, every other path
#                 being the same in both
# Which file is which is commit-guards' answer, never this script's: it asks
# the worktree's installed `changelog-entries --classify`, which reads the
# repository's own COMMIT_GUARDS_CHANGELOG_* settings and render inventory.
# The lines each kind may differ in:
#   record, fragment  blank lines, headings, list entries and lines indented
#                     under them
#   version           its "version": "..." lines
#   package, render   its front matter's indented version: x.y.z lines,
#                     a package's metadata.version and its renders'
# Inside each conflict region of the merged file, both sides must hold only
# such lines too, so a conflict over code is never resolved unseen. No kind
# allows a conflict marker line, so one left in the restacked file is kept
# and differs from the merge.
#
# Every fact the check cannot read, a run, an object, the classifier or a git
# answer, is a re-test: a missing fact widens the checks.
#
# Usage:
#   restack-skip --worktree PATH --base REF
#
# Output, one line on stdout:
#   restack=skip condition=no-conflict|version-only run-dir=DIR validated-head=SHA head=SHA paths=P[,P...]|none   exit 0
#   restack=retest cause=CAUSE [path=P] [run-dir=DIR]                                                           exit 1
# paths= names the files the merge left conflicted, none for no-conflict.
# Causes:
#   no-passing-run    the worktree holds no passing run with a recorded tree
#   newer-red         a run newer than the last pass did not pass; run-dir=
#                     names it
#   base-unreadable   REF names no commit
#   head-unreadable   the worktree has no HEAD commit
#   object-missing    the validated tree or the HEAD it started at is gone
#   merge-failed      git merge-tree answered neither clean nor conflicted
#   conflict-kind     a conflict other than a content conflict: modify/delete,
#                     rename, binary and the like, or a conflicted path any of
#                     whose sides is no regular file of one mode: a symlink,
#                     a gitlink or a mode change
#   classifier-missing  the worktree has no executable commit-guards
#                     changelog-entries
#   classifier-failed   it could not classify the conflicted paths
#   unclassified      a conflicted path is no changelog, version, package or
#                     render file
#   diff-failed       the two trees could not be compared
#   path-shape        a path was added, removed, or is not a regular file of
#                     one mode on both sides, or HEAD lacks a conflicted file
#                     or holds it in another mode than the merge's sides
#   path-unconflicted a path differs that the merge did not leave conflicted
#   hunk              a conflicted file differs in a line its kind does not
#                     allow, a left conflict marker included, or a conflict
#                     region holds one
# Exit 2 is a usage error, which runs the re-test too.

set -euo pipefail

PROG="restack-skip"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

die() { # KEY FIELD...
  {
    printf '%s: %s' "$PROG" "$1"
    shift
    printf ' %s' "$@"
    printf '\n'
  } >&2
  exit 2
}

retest() { # CAUSE FIELD...
  printf 'restack=retest cause=%s' "$1"
  shift
  (( $# == 0 )) || printf ' %s' "$@"
  printf '\n'
  exit 1
}

usage() {
  sed -n '2,/^set -/p' < "${BASH_SOURCE[0]}" | sed '$d; s/^# \{0,1\}//'
}

worktree=""
base=""
while (( $# > 0 )); do
  case "$1" in
    --worktree) (( $# >= 2 )) || die missing-value option=--worktree; worktree="$2"; shift 2 ;;
    --base) (( $# >= 2 )) || die missing-value option=--base; base="$2"; shift 2 ;;
    -h|--help) usage; exit 0 ;;
    *) die unknown-argument "argument=$1" ;;
  esac
done
[[ -n "$worktree" ]] || die required option=--worktree
[[ -n "$base" ]] || die required option=--base
[[ -d "$worktree" ]] || die not-directory "path=$worktree"
worktree="$(cd -- "$worktree" && pwd)"
cd -- "$worktree"

last_rc=0
last="$("$SCRIPT_DIR/dev-validate-run" --last-pass --worktree "$worktree" 2>/dev/null)" || last_rc=$?
run_dir="" validated_head="" validated_tree="" red=false
read -r -a fields <<<"$last"
for field in ${fields[@]+"${fields[@]}"}; do
  case "$field" in
    last-pass=red) red=true ;;
    run-dir=*) run_dir="${field#*=}" ;;
    head=*) validated_head="${field#*=}" ;;
    tree=*) validated_tree="${field#*=}" ;;
  esac
done
[[ "$red" == false || -z "$run_dir" ]] || retest newer-red "run-dir=$run_dir"
[[ "$last_rc" == 0 && -n "$run_dir" && -n "$validated_head" && -n "$validated_tree" ]] || retest no-passing-run
new_base="$(git rev-parse --verify -q "$base^{commit}")" || retest base-unreadable "run-dir=$run_dir"
head="$(git rev-parse --verify -q 'HEAD^{commit}')" || retest head-unreadable "run-dir=$run_dir"

scratch="$(mktemp -d)" || die scratch-unavailable
trap 'rm -rf -- "$scratch"' EXIT
# The validated commit and the merge are written to a private store, the
# repository's own serving as an alternate, so the check leaves no object in
# the shared store.
objects="$(git rev-parse --path-format=absolute --git-path objects)" || retest object-missing "run-dir=$run_dir"
mkdir -- "$scratch/objects"
export GIT_OBJECT_DIRECTORY="$scratch/objects" GIT_ALTERNATE_OBJECT_DIRECTORIES="$objects"

validated="$(GIT_AUTHOR_NAME="$PROG" GIT_AUTHOR_EMAIL="$PROG@localhost" \
  GIT_COMMITTER_NAME="$PROG" GIT_COMMITTER_EMAIL="$PROG@localhost" \
  git commit-tree "$validated_tree" -p "$validated_head" -m "$PROG: validated" 2>/dev/null)" \
  || retest object-missing "run-dir=$run_dir"

merge_rc=0
git -c merge.conflictStyle=merge merge-tree --write-tree -z "$new_base" "$validated" \
  > "$scratch/merge" 2>/dev/null || merge_rc=$?
(( merge_rc <= 1 )) || retest merge-failed "run-dir=$run_dir"
# -z output: the tree, one "MODE OID STAGE<tab>PATH" entry per stage of each
# conflicted path, an empty field, then one message a record: the count of
# paths it names, those paths, its type and its text. Every stage of a
# conflicted path must be a regular file of one mode: git keeps one side of a
# symlink, gitlink or mode conflict with no marker for the line rules below to
# find, whatever message it prints for it.
merged_tree=""
section=tree
conflicted=()
conflicted_modes=()
while IFS= read -r -d '' token; do
  case "$section" in
    tree) merged_tree="$token"; section=paths ;;
    paths)
      if [[ -z "$token" ]]; then
        section=messages
      else
        path="${token#*$'\t'}"
        mode="${token%% *}"
        if (( ${#conflicted[@]} == 0 )) || [[ "${conflicted[${#conflicted[@]} - 1]}" != "$path" ]]; then
          conflicted+=("$path")
          conflicted_modes+=("$mode")
        fi
        case "$mode" in
          100644|100755) ;;
          *) retest conflict-kind "path=$path" "run-dir=$run_dir" ;;
        esac
        [[ "$mode" == "${conflicted_modes[${#conflicted_modes[@]} - 1]}" ]] \
          || retest conflict-kind "path=$path" "run-dir=$run_dir"
      fi
      ;;
    messages)
      [[ "$token" =~ ^[0-9]+$ ]] || retest merge-failed "run-dir=$run_dir"
      named=""
      for (( i = 0; i < token; i++ )); do
        IFS= read -r -d '' path || retest merge-failed "run-dir=$run_dir"
        [[ -n "$named" ]] || named="$path"
      done
      IFS= read -r -d '' type && IFS= read -r -d '' _ || retest merge-failed "run-dir=$run_dir"
      case "$type" in
        "CONFLICT (contents)") ;;
        CONFLICT*) retest conflict-kind "path=$named" "run-dir=$run_dir" ;;
      esac
      ;;
  esac
done < "$scratch/merge"
[[ -n "$merged_tree" ]] || retest merge-failed "run-dir=$run_dir"

git diff-tree -r -z --no-renames "$merged_tree" "$head^{tree}" > "$scratch/diff" 2>/dev/null \
  || retest diff-failed "run-dir=$run_dir"

# PATH — 0 when the merge left PATH conflicted.
is_conflicted() {
  local path
  for path in ${conflicted[@]+"${conflicted[@]}"}; do
    [[ "$path" != "$1" ]] || return 0
  done
  return 1
}

while IFS= read -r -d '' meta && IFS= read -r -d '' path; do
  read -r old_mode new_mode _ _ status <<<"${meta#:}"
  [[ "$status" == M && "$old_mode" == "$new_mode" ]] || retest path-shape "path=$path" "run-dir=$run_dir"
  case "$old_mode" in
    100644|100755) ;;
    *) retest path-shape "path=$path" "run-dir=$run_dir" ;;
  esac
  is_conflicted "$path" || retest path-unconflicted "path=$path" "run-dir=$run_dir"
done < "$scratch/diff"

if (( ${#conflicted[@]} == 0 )); then
  printf 'restack=skip condition=no-conflict run-dir=%s validated-head=%s head=%s paths=none\n' \
    "$run_dir" "$validated_head" "$head"
  exit 0
fi

# The worktree's own install, so the classification is the one its commits
# are held to.
classifier="$worktree/.agents/skills/commit-guards/scripts/changelog-entries"
[[ -x "$classifier" ]] || retest classifier-missing "run-dir=$run_dir"
"$classifier" --classify "${conflicted[@]}" > "$scratch/kinds" 2>/dev/null \
  || retest classifier-failed "run-dir=$run_dir"

# KIND MARKERS < FILE — the file less the lines KIND allows, and less each
# conflict region where MARKERS is 1. Exit 3 where a region holds any other
# line or never closes.
normalize() {
  LC_ALL=C awk -v kind="$1" -v markers="$2" '
    function allowed(line) {
      if (kind == "changelog") return line ~ /^[ \t]*$/ || line ~ /^#+[ \t]/ || line ~ /^[-*+][ \t]/ || line ~ /^[ \t]+[^ \t]/
      if (kind == "version") return line ~ /^[ \t]*"version"[ \t]*:[ \t]*"[^"]*"[ \t]*,?[ \t]*$/
      return fm == 1 && line ~ /^[ \t]+version:[ \t]*["\047]?[0-9]+\.[0-9]+\.[0-9]+[0-9A-Za-z.+-]*["\047]?[ \t]*$/
    }
    NR == 1 && kind == "markdown" && $0 == "---" { fm = 1; print; next }
    markers && !region && /^<<<<<<<( |$)/ { region = 1; next }
    region && /^(=======|\|\|\|\|\|\|\|( .*)?)$/ { next }
    region && /^>>>>>>>( |$)/ { region = 0; next }
    region { if (!allowed($0)) { bad = 1; exit 3 } next }
    fm == 1 && $0 == "---" { fm = 2; print; next }
    allowed($0) { next }
    { print }
    END { if (bad || region) exit 3 }
  '
}

index=0
paths=""
while IFS=$'\t' read -r kind path; do
  [[ "$path" == "${conflicted[$index]:-}" ]] || retest classifier-failed "run-dir=$run_dir"
  index=$(( index + 1 ))
  case "$kind" in
    record|fragment) kind=changelog ;;
    version) ;;
    package|render) kind=markdown ;;
    *) retest unclassified "path=$path" "run-dir=$run_dir" ;;
  esac
  git cat-file blob "$merged_tree:$path" > "$scratch/merged-blob" 2>/dev/null \
    || retest object-missing "path=$path" "run-dir=$run_dir"
  head_entry="$(git ls-tree --full-tree "$head" -- "$path" 2>/dev/null)" \
    && [[ "${head_entry%% *}" == "${conflicted_modes[$index - 1]}" ]] \
    && git cat-file blob "$head:$path" > "$scratch/head-blob" 2>/dev/null \
    || retest path-shape "path=$path" "run-dir=$run_dir"
  normalize "$kind" 1 < "$scratch/merged-blob" > "$scratch/merged-kept" \
    && normalize "$kind" 0 < "$scratch/head-blob" > "$scratch/head-kept" \
    && cmp -s -- "$scratch/merged-kept" "$scratch/head-kept" \
    || retest hunk "path=$path" "run-dir=$run_dir"
  paths="${paths:+$paths,}$path"
done < "$scratch/kinds"
(( index == ${#conflicted[@]} )) || retest classifier-failed "run-dir=$run_dir"

printf 'restack=skip condition=version-only run-dir=%s validated-head=%s head=%s paths=%s\n' \
  "$run_dir" "$validated_head" "$head" "$paths"
