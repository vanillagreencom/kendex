#!/usr/bin/env bash
# round-prune — at a dev round's start, reclaim the lane worktree's Cargo build
# output when its disk is at or past the mark, and record what that freed in
# workflow state.
#
# Usage: round-prune [--state-dir DIR] STATE_KEY
#
# The orchestrator runs it after `workflow-state new-round-id` and before the
# `dev_delegated_at` stamp and the delegation, so no validation run is in
# flight in the worktree: the prune happens between rounds and a validation run
# deletes nothing. It resolves its own target from the state and the tree, so
# no workflow passes one: the round id and the worktree from workflow state,
# or, where the state names no worktree, the linked worktree (never the main
# checkout) that has the state's branch checked out; the lease owner from that
# worktree's branch through `git-context issue-from-branch`, which is the issue
# id start-worktree claims the lease under; the Cargo target as tools/guard
# resolves it, ${CARGO_TARGET_DIR:-target} with a relative value read from the
# worktree; and the use of the volume holding that target from df. A state
# with neither has no lane target to free: it records action=no-worktree and
# exits 0. A branch naming no issue id had no start-worktree lease, and the
# state key stands in as the owner. At or past ORCH_ROUND_PRUNE_DISK_PCT
# (default 75) it runs
#   worktree cleanup --targets-only --apply --worktree WORKTREE --owner OWNER
# That prune takes every Cargo profile under the worktree's own target/,
# however recent, and nothing else: node_modules/ and .next/ stay, since nothing
# reinstalls them between rounds. A Cargo target anywhere else is out of its
# reach, so past the mark that round records action=target-elsewhere and fails
# rather than report a prune that freed nothing the build writes. It bounds
# target/ across rounds without tracking which artifact a run still reads.
# Below the mark it prunes nothing, and the next validation run starts warm.
#
# Output: one line,
#   round-prune: action=pruned|below-mark|failed|target-elsewhere|no-worktree used-pct=N mark-pct=N bytes=N round=ID worktree=PATH
# printed before the same fields are written under .round_prunes[ROUND_ID] in
# workflow state. With no worktree, used-pct is 0 and worktree is empty. bytes
# is the prune's own summary figure: 0 below the mark or with no worktree,
# and on a failed prune what it reclaimed before failing, 0 with no summary.
# A prune that kept a profile for its held build lock, a live holder or a
# change, or that exited non-zero after its summary, is failed, never pruned.
#
# Exit status: 0 pruned, below the mark or no worktree; 1 the prune failed,
# recorded as failed, with the worktree CLI's records on stderr, or the target
# lies outside the worktree's target/ past the mark, recorded as
# target-elsewhere; 2 usage, a state with no round id, a setting, worktree
# list, branch or disk read failure with nothing
# pruned or recorded, or a failed state write after the result line, when the
# prune may already have run.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_STATE="$SCRIPT_DIR/workflow-state"
ORCH_ENV="$SCRIPT_DIR/orch-env"
GIT_CONTEXT="$SCRIPT_DIR/git-context"
WORKTREE_BIN="${ORCH_WORKTREE_BIN:-$SCRIPT_DIR/../../worktree/scripts/worktree}"
MARK_DEFAULT=75

# Message text is centralized; callers supply the key and its value.
message() { # KEY VALUE
  printf 'round-prune: %s=%s\n' "$1" "$2"
  case "$1" in
  usage) printf '%s\n' 'Usage: round-prune [--state-dir DIR] STATE_KEY' ;;
  state-missing) printf '%s\n' 'workflow state has no value for that field under this key; dev_round_id comes from workflow-state new-round-id run under the same key.' ;;
  owner) printf '%s\n' 'git-context could not read the worktree branch, so the lease owner is unknown.' ;;
  worktree-list) printf '%s\n' 'git worktree list failed, so the worktree holding the state'"'"'s branch is unknown.' ;;
  target-elsewhere) printf '%s\n' 'CARGO_TARGET_DIR puts the Cargo target outside the worktree'"'"'s target/, which the owner-scoped prune cannot take; free that volume by hand or unset it for the lane.' ;;
  mark) printf '%s\n' 'ORCH_ROUND_PRUNE_DISK_PCT must be a whole percentage from 1 to 100.' ;;
  disk) printf '%s\n' 'df could not report the use of the volume holding the worktree target, so the round cannot tell whether to prune.' ;;
  prune) printf '%s\n' 'the owner-scoped prune did not reclaim the whole target; its records are above, and the round record says failed.' ;;
  record) printf '%s\n' 'the result above could not be written to workflow state; any prune it reports has already run.' ;;
  esac
}

state_args=()
case "${1:-}" in
--help | -h)
  sed -n '2,/^set -euo pipefail$/p' "$0" | sed -e '$d' -e 's/^# \{0,1\}//'
  exit 0
  ;;
--state-dir)
  [[ $# -ge 2 && -n "$2" ]] || { message usage "$1" >&2; exit 2; }
  state_args=(--state-dir "$2")
  shift 2
  ;;
esac
[[ $# -eq 1 && -n "$1" && "$1" != -* ]] || { message usage "${1:-}" >&2; exit 2; }
key="$1"

state_get() { # JQ
  "$WORKFLOW_STATE" ${state_args[@]+"${state_args[@]}"} get "$key" "$1"
}
round=""
if ! round="$(state_get '.dev_round_id // ""')" || [[ -z "$round" ]]; then
  message state-missing dev_round_id >&2
  exit 2
fi
worktree="" branch=""
worktree="$(state_get '.worktree // ""')" || { message state-missing worktree >&2; exit 2; }
# A state initialized with a branch alone names its tree through the linked
# worktree that has that branch checked out, as git-context branch-worktree
# resolves it; the main checkout, whose lease the guard refuses, is never one.
if [[ -z "$worktree" ]]; then
  branch="$(state_get '.branch // ""')" || { message state-missing branch >&2; exit 2; }
  if [[ -n "$branch" ]]; then
    worktree="$("$GIT_CONTEXT" branch-worktree "$branch")" || { message worktree-list "$branch" >&2; exit 2; }
  fi
fi

record() { # ACTION USED MARK BYTES — the result line, then the round record
  printf 'round-prune: action=%s used-pct=%s mark-pct=%s bytes=%s round=%s worktree=%s\n' \
    "$1" "$2" "$3" "$4" "$round" "$worktree"
  "$WORKFLOW_STATE" ${state_args[@]+"${state_args[@]}"} update "$key" \
    --arg round "$round" --arg action "$1" --argjson used "$2" --argjson mark "$3" \
    --argjson bytes "$4" \
    '.round_prunes[$round] = {action: $action, used_pct: $used, mark_pct: $mark, bytes: $bytes}' >/dev/null ||
    { message record "$key" >&2; exit 2; }
}

mark=""
mark="$("$ORCH_ENV" ORCH_ROUND_PRUNE_DISK_PCT "$MARK_DEFAULT")" || { message mark unreadable >&2; exit 2; }
if ! [[ "$mark" =~ ^[0-9]{1,3}$ ]] || [[ "$((10#$mark))" -lt 1 || "$((10#$mark))" -gt 100 ]]; then
  message mark "$mark" >&2
  exit 2
fi
mark="$((10#$mark))"

if [[ -z "$worktree" ]]; then
  record no-worktree 0 "$mark" 0
  exit 0
fi

# The lease start-worktree claims is keyed by the issue id the branch names.
# git-context prints the id on stdout, and on failure its keyed refusal on
# stderr, which the second, read-only call captures to tell the two apart.
owner="" owner_err=""
if ! owner="$("$GIT_CONTEXT" issue-from-branch "$worktree" 2>/dev/null)"; then
  owner_err="$("$GIT_CONTEXT" issue-from-branch "$worktree" 2>&1 >/dev/null)" || true
  case "$owner_err" in
  "git-context: issue-unmatched "*) owner="$key" ;;
  *) message owner "$worktree" >&2; exit 2 ;;
  esac
fi

# The Cargo target the validation run builds into, resolved as tools/guard
# resolves it, and the volume holding it: the target where it exists, which may
# be a mount or a link of its own, else its nearest existing ancestor.
cargo_target="${CARGO_TARGET_DIR:-target}"
case "$cargo_target" in
/*) ;;
*) cargo_target="$worktree/$cargo_target" ;;
esac
cargo_target="${cargo_target%/}"
own_target=false
if [[ -d "$cargo_target" && -d "$worktree/target" ]]; then
  [[ "$(cd -- "$cargo_target" && pwd -P)" != "$(cd -- "$worktree/target" && pwd -P)" ]] || own_target=true
elif [[ "$cargo_target" == "$worktree/target" ]]; then
  own_target=true
fi
probe="$cargo_target"
while [[ ! -d "$probe" && "$probe" == */* ]]; do probe="${probe%/*}"; done
[[ -n "$probe" ]] || probe=/
df_out="" used=""
df_out="$(df -P -- "$probe" 2>/dev/null)" || { message disk "$probe" >&2; exit 2; }
used="$(awk 'NR == 2 { sub(/%$/, "", $5); print $5 }' <<<"$df_out")"
[[ "$used" =~ ^[0-9]{1,3}$ ]] || { message disk "$probe" >&2; exit 2; }
used="$((10#$used))"

action=below-mark
bytes=0
if [[ "$used" -ge "$mark" ]]; then
  if [[ "$own_target" == false ]]; then
    action=target-elsewhere
  else
    report="" rc=0
    report="$(cd "$worktree" && "$WORKTREE_BIN" cleanup --targets-only --apply --worktree "$worktree" --owner "$owner")" || rc=$?
    [[ -z "$report" ]] || printf '%s\n' "$report" >&2
    summary_bytes="$(sed -n 's/^worktree-output-prune-summary: .* mode=apply .* bytes=\([0-9][0-9]*\) .*$/\1/p' <<<"$report")"
    [[ ! "$summary_bytes" =~ ^[0-9]+$ ]] || bytes="$summary_bytes"
    if [[ "$rc" -eq 0 && "$summary_bytes" =~ ^[0-9]+$ ]]; then
      action=pruned
    else
      action=failed
    fi
  fi
fi

record "$action" "$used" "$mark" "$bytes"
case "$action" in
failed)
  message prune "$worktree" >&2
  exit 1
  ;;
target-elsewhere)
  message target-elsewhere "$cargo_target" >&2
  exit 1
  ;;
esac
exit 0
