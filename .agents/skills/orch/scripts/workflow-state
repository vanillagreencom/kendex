#!/usr/bin/env bash
# Workflow state file management for multi-agent orch
# Usage: workflow-state <command> <issue_id> [args...]
# The review-pr workflow consumes cap output as `below COUNT/LIMIT` or
# `at-cap COUNT/LIMIT`. Without a count source, cap prints the limit alone.
# submit-pr and ci-fix consume head-budget output as `continue COUNT/LIMIT`
# or `at-cap COUNT/LIMIT`. post-pr-stop reports `recorded` or `kept`.

set -euo pipefail

# Callers preserve their positional values for this diagnostic catalog.
state_message() {
  local _message_key="$1"
  shift
  case "$_message_key" in
    state-missing)
      printf 'workflow-state: state-missing state-file=%s\n' "$state_file"
      printf '%s\n' "Error: State file not found: $state_file"
      printf "Run workflow-state init with the issue ID first.\n"
      ;;
    lock-failed)
      printf 'workflow-state: lock-failed lock-file=%s\n' "$lock_file"
      printf '%s\n' "Error: could not acquire lock on $lock_file"
      ;;
    jq-failed)
      printf 'workflow-state: jq-failed state=%s\n' "$state_file"
      printf '%s\n' "Error: jq expression failed: $jq_expr"
      ;;
    invalid-json)
      printf 'workflow-state: invalid-json path=%s\n' "$tmp_file"
      printf '%s\n' "Error: jq produced invalid JSON"
      ;;
    unknown-option)
      printf 'workflow-state: unknown-option arg1=%s\n' "$1"
      printf '%s\n' "Unknown option: $1"
      ;;
    binding-arguments)
      printf 'workflow-state: binding-arguments arg1=%s\n' "$1"
      printf '%s\n' "Error: $1 needs a NAME and a VALUE"
      ;;
    argjson-value)
      printf 'workflow-state: argjson-value arg1=%s\n' "$2"
      printf '%s\n' "Error: --argjson $2 is not exactly one JSON value"
      ;;
    slurpfile-arguments)
      printf 'workflow-state: slurpfile-arguments option=%s\n' "--slurpfile"
      printf '%s\n' "Error: --slurpfile needs a NAME and a FILE"
      ;;
    slurpfile-missing)
      printf 'workflow-state: slurpfile-missing arg1=%s arg2=%s\n' "$2" "$3"
      printf '%s\n' "Error: --slurpfile $2: no such file: $3"
      ;;
    slurpfile-value)
      printf 'workflow-state: slurpfile-value arg1=%s arg2=%s\n' "$2" "$3"
      printf '%s\n' "Error: --slurpfile $2 is not exactly one JSON value: $3"
      ;;
    extra-expression)
      printf 'workflow-state: extra-expression count=%s\n' "2"
      printf '%s\n' "Error: update takes exactly one jq expression"
      ;;
    missing-expression)
      printf 'workflow-state: missing-expression count=%s\n' "0"
      printf '%s\n' "Error: update needs a jq expression"
      ;;
    report-shape)
      printf 'workflow-state: report-shape path=%s\n' "$state_file"
      printf '%s\n' "Error: update-report expression must produce exactly one {state: <object>, report: <any>}"
      ;;
    stop-arguments)
      printf 'workflow-state: stop-arguments command=%s\n' "post-pr-stop"
      printf '%s\n' "Error: post-pr-stop needs an action and issue_id"
      ;;
    stop-fields)
      printf 'workflow-state: stop-fields action=%s\n' "$action"
      printf '%s\n' "Error: post-pr-stop $action needs issue_id, name, gate, remaining, and comment-file"
      ;;
    stop-action)
      printf 'workflow-state: stop-action action=%s\n' "$action"
      printf '%s\n' "Error: unknown post-pr-stop action: $action"
      ;;
    budget-arguments)
      printf 'workflow-state: budget-arguments command=%s\n' "head-budget"
      printf '%s\n' "Error: head-budget needs an action, issue_id, and kind"
      ;;
    budget-kind)
      printf 'workflow-state: budget-kind kind=%s\n' "$kind"
      printf '%s\n' "Error: unknown head budget: $kind"
      ;;
    budget-fields)
      printf 'workflow-state: budget-fields command=%s\n' "head-budget"
      printf '%s\n' "Error: head-budget take needs issue_id, kind, and head"
      ;;
    budget-action)
      printf 'workflow-state: budget-action action=%s\n' "$action"
      printf '%s\n' "Error: unknown head-budget action: $action"
      ;;
    lock-unavailable)
      printf 'workflow-state: lock-unavailable path=%s\n' "$lock_file"
      printf '%s\n' "Error: could not acquire lock"
      ;;
    json-invalid)
      printf 'workflow-state: json-invalid path=%s\n' "$tmp_file"
      printf '%s\n' "Error: invalid JSON"
      ;;
    append-field)
      printf 'workflow-state: append-field command=%s\n' "append-file"
      printf '%s\n' "Error: append-file needs a field"
      ;;
    append-missing)
      printf 'workflow-state: append-missing file=%s\n' "$file"
      printf '%s\n' "Error: append-file: no such file: $file"
      ;;
    append-value)
      printf 'workflow-state: append-value file=%s\n' "$file"
      printf '%s\n' "Error: append-file: $file is not exactly one JSON value"
      ;;
    clock-unreadable)
      printf 'workflow-state: clock-unreadable field=%s\n' "$field"
      printf '%s\n' "Error: date could not be read, so $field carries no time this command can stamp or judge; nothing was written"
      ;;
    fleet-log-record)
      printf 'workflow-state: fleet-log-record file=%s\n' "$file"
      printf '%s\n' "Error: append-file: fleet_log record $file is not a JSON object, so its \"at\" cannot be read"
      ;;
    fleet-log-at-invalid)
      printf 'workflow-state: fleet-log-at-invalid at=%s\n' "$at"
      printf '%s\n' "Error: append-file: fleet_log record $file is dated $at, which is not ISO 8601 UTC; write it as YYYY-MM-DDThh:mm:ssZ, or leave \"at\" out and the append stamps it"
      ;;
    fleet-log-at-future)
      printf 'workflow-state: fleet-log-at-future at=%s now=%s\n' "$at" "$now"
      printf '%s\n' "Error: append-file: fleet_log record $file is dated $at, later than the clock at $now; leave \"at\" out and the append stamps it"
      ;;
    fleet-log-row-bytes)
      printf 'workflow-state: fleet-log-row-bytes bytes=%s cap=%s\n' "$bytes" "$cap"
      printf '%s\n' "Error: append-file: fleet_log record $file carries $bytes bytes of text, over ORCH_FLEET_LOG_ROW_BYTES=$cap; write the ruling as one line under the cap"
      ;;
    fleet-log-reader)
      printf 'workflow-state: fleet-log-reader reader=%s\n' "${1:-}"
      printf '%s\n' "Error: fleet-log takes the reader takeover or audit"
      ;;
    keep-value)
      printf 'workflow-state: keep-value option=%s\n' "--keep"
      printf '%s\n' "Error: --keep requires a path argument"
      ;;
    prune-age-unreadable)
      printf 'workflow-state: prune-age-unreadable path=%s\n' "$unit"
      printf '%s\n' "Error: prune: find could not read every entry under $unit, so its age is unjudged; nothing was archived or removed"
      [[ -z "$err" ]] || printf '%s\n' "$err"
      ;;
    prune-archive-failed)
      printf 'workflow-state: prune-archive-failed path=%s\n' "$archive_dir"
      printf '%s\n' "Error: prune: the archive under $archive_dir could not be built; nothing was removed"
      [[ -z "$err" ]] || printf '%s\n' "$err"
      ;;
    prune-remove-failed)
      printf 'workflow-state: prune-remove-failed path=%s kept=%s\n' "$unit" "$archive"
      printf '%s\n' "Error: prune: $unit could not be removed; the archive holds it and every path before it"
      [[ -z "$err" ]] || printf '%s\n' "$err"
      ;;
    progress-dir-failed)
      printf 'workflow-state: progress-dir-failed path=%s\n' "$dir"
      printf '%s\n' "Error: $dir could not be created"
      [[ -z "$err" ]] || printf '%s\n' "$err"
      ;;
    prune-progress-overlap)
      printf 'workflow-state: prune-progress-overlap path=%s state-dir=%s\n' "$pd" "$sd"
      printf '%s\n' "Error: prune: ORCH_PROGRESS_REPORT_DIR is or holds the state directory, so its entries would pass the keep list; nothing was archived or removed"
      ;;
    handoff-record)
      printf 'workflow-state: handoff-record issue=%s\n' "$issue_id"
      printf '%s\n' "Error: set: the handoff record for $issue_id is not a JSON object, so its \"written_at\" cannot be read"
      ;;
    handoff-written-at-invalid)
      printf 'workflow-state: handoff-written-at-invalid written_at=%s\n' "$written_at"
      printf '%s\n' "Error: set: handoff written_at $written_at is not ISO 8601 UTC; write it as YYYY-MM-DDThh:mm:ssZ, or leave it out and the set stamps it"
      ;;
    handoff-written-at-future)
      printf 'workflow-state: handoff-written-at-future written_at=%s now=%s\n' "$written_at" "$now"
      printf '%s\n' "Error: set: the handoff record is dated $written_at, later than the clock at $now; leave \"written_at\" out and the set stamps it"
      ;;
    unknown-cap)
      printf 'workflow-state: unknown-cap setting=%s known=%s\n' "$1" "$(cap_table | awk -F'\t' '{ printf "%s%s", sep, $1; sep = "," }')"
      printf '%s\n' "Error: unknown round cap: $1 (known: $(cap_table | awk -F'\t' '{ printf "%s%s", sep, $1; sep = ", " }'))"
      ;;
    missing-issue)
      printf 'workflow-state: missing-issue option=%s\n' "--issue"
      printf '%s\n' "Error: --issue needs an ID"
      ;;
    missing-count)
      printf 'workflow-state: missing-count option=%s\n' "--count"
      printf '%s\n' "Error: --count needs a number"
      ;;
    cap-argument)
      printf 'workflow-state: cap-argument arg1=%s\n' "$1"
      printf '%s\n' "Error: cap: unknown argument: $1"
      ;;
    cap-source-conflict)
      printf 'workflow-state: cap-source-conflict options=%s\n' "--issue,--count"
      printf '%s\n' "Error: cap takes --issue or --count, not both"
      ;;
    cap-count-required)
      printf 'workflow-state: cap-count-required setting=%s\n' "$setting"
      printf '%s\n' "Error: cap: $setting is not measured against workflow state; pass --count"
      ;;
    invalid-count)
      printf 'workflow-state: invalid-count count=%s\n' "$count"
      printf '%s\n' "Error: cap: count is not a whole number: $count"
      ;;
    cap-unresolved)
      printf 'workflow-state: cap-unresolved setting=%s\n' "REVIEW_MAX_CYCLES"
      printf '%s\n' "workflow-state: could not resolve REVIEW_MAX_CYCLES; rereview_panel not set"
      ;;
    cycle-cap)
      printf 'workflow-state: cycle-cap count=%s limit=%s\n' "$(jq -r '.entered' <<<"$report")" "$cap"
      printf '%s\n' "workflow-state: rereview_cycles is at the cap ($(jq -r '.entered' <<<"$report") >= REVIEW_MAX_CYCLES=$cap, entries already taken): the fix loop is over — no further re-review cycle and no further fix round; follow review-pr § 4 At The Cap, \"Capped items are escalated, never dropped\" — one update per still-outstanding blocker and category==fix suggestion records it in escalated_items (outcome \"blocked\") and drops its superseded fixed_items entry in the same write — then go to review-pr § 5 (verdict pass) and report them"
      ;;
    exists-issue)
      printf 'workflow-state: exists-issue command=%s\n' "exists"
      printf '%s\n' "Error: exists requires an issue_id"
      ;;
    state-dir-value)
      printf 'workflow-state: state-dir-value option=%s\n' "--state-dir"
      printf '%s\n' "Error: --state-dir requires a path argument"
      ;;
    unknown-command)
      printf 'workflow-state: unknown-command arg1=%s\n' "$1"
      printf '%s\n' "Unknown command: $1"
      ;;
  esac
}

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export PROJECT_ROOT
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

# The state file for a key. Every caller passes the key the state was
# initialized under — GitHub-issue orchestration normalizes to `issue-N` before
# it reaches any subcommand — so the key names its file exactly.
get_state_file() {
    local issue_id="$1"
    echo "${STATE_DIR}/${STATE_PREFIX}-${issue_id}.json"
}

ensure_state_exists() {
    local state_file="$1"
    if [[ ! -f "$state_file" ]]; then
        state_message state-missing "$@" >&2
        exit 1
    fi
}

# Atomic update: take the lock, write to temp, validate, move.
# The lock serializes concurrent writes and prevents state corruption;
# lib/file-lock.sh says which mechanism carries it on which platform.
# Any remaining arguments are passed to jq ahead of the filter, which is how
# `update --arg`/`--argjson` hand values in out of band.
atomic_update() {
    local state_file="$1"
    local jq_expr="$2"
    shift 2
    local -a jq_args=("$@")
    local lock_file="${state_file}.lock"
    local tmp_file="${state_file}.tmp"

    (
        orch_take_lock 200 "$lock_file" 10 || { state_message lock-failed "$@" >&2; exit 1; }

        if ! jq ${jq_args[@]+"${jq_args[@]}"} "$jq_expr" "$state_file" > "$tmp_file" 2>&1; then
            state_message jq-failed "$@" >&2
            rm -f "$tmp_file"
            exit 1
        fi

        # Validate output is valid JSON
        if ! jq empty "$tmp_file" 2>/dev/null; then
            state_message invalid-json "$@" >&2
            rm -f "$tmp_file"
            exit 1
        fi

        mv "$tmp_file" "$state_file"
    ) 200>"$lock_file"
}

cmd_init() {
    local issue_id="$1"
    shift

    local agent="" worktree="" branch="" qa_labels="[]" sub_issues="[]"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --agent) agent="$2"; shift 2 ;;
            --worktree) worktree="$2"; shift 2 ;;
            --branch) branch="$2"; shift 2 ;;
            --qa-labels) qa_labels="$2"; shift 2 ;;
            --sub-issues) sub_issues="$2"; shift 2 ;;
            *) state_message unknown-option "$@" >&2; exit 1 ;;
        esac
    done

    mkdir -p "$STATE_DIR"
    local state_file
    state_file=$(get_state_file "$issue_id")

    jq -n \
        --arg issue_id "$issue_id" \
        --arg agent "$agent" \
        --arg worktree "$worktree" \
        --arg branch "$branch" \
        --argjson sub_issues "$sub_issues" \
        --argjson qa_labels "$qa_labels" \
        '{
        issue_id: $issue_id,
        sub_issues: $sub_issues,
        agent: $agent,
        worktree: $worktree,
        branch: $branch,
        qa_labels: $qa_labels,
        near_ceiling: [],
        child_sessions: {},
        review_agents: [],
        review_agent_ids: {},
        review_agent_runtime_types: {},
        pre_delegate_sha: null,
        skip_qa: false,
        cycles: 0,
        rereview_cycles: 0,
        json_paths: [],
        fixed_items: [],
        escalated_items: [],
        audit_issues_created: [],
        pr: {
          size_check: null
        },
        pr_review_baseline: null,
        pr_comment_review: {
          iterations: 0,
          fixes: [],
          issues_created: [],
          skipped: []
        },
        post_pr_budgets: {
          review_wait: null,
          ci_fix: null
        },
        post_pr_stop: null
      }' > "$state_file"
    echo "$state_file"
}

cmd_get() {
    local issue_id="$1"
    local jq_path="${2:-.}"

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    jq -r "$jq_path" "$state_file"
}

# `update <id> [--arg NAME VALUE]... [--argjson NAME JSON]...
#             [--slurpfile NAME FILE]... <jq_expr>`
# Bindings reach jq as its own --arg/--argjson, so a VALUE carrying quotes,
# apostrophes, backslashes, or newlines is a literal string to the filter.
# Text this script did not author belongs in a binding: interpolated into the
# expression it becomes a jq parse error and an unwritten state.
#
# --slurpfile is jq's own file option and binds an ARRAY of the file's values,
# so a one-value artifact reads as $NAME[0]. Only the path crosses argv, which
# is the point: Linux caps a single argument at MAX_ARG_STRLEN (128 KB), well
# under ARG_MAX, so passing a document as an --argjson value makes jq fail to
# launch once the artifact grows past it. Callers under a harness that rejects
# `$(...)` and multi-command blocks (orch references/codex-runtime) cannot put
# artifact text into a shell word at all, so the file is the only channel.
cmd_update() {
    local issue_id="$1"
    shift

    local jq_expr="" have_expr=0
    local -a jq_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --arg|--argjson)
                [[ $# -ge 3 ]] || { state_message binding-arguments "$@" >&2; return 1; }
                # Count the parsed values, never their truthiness: `jq -e .`
                # takes its status from the OUTPUT, so it rejects the perfectly
                # valid scalars false and null. Slurping also rejects a stream
                # of several values, which is not one binding.
                if [[ "$1" == "--argjson" ]] && ! jq -s -e 'length == 1' >/dev/null 2>&1 <<<"$3"; then
                    state_message argjson-value "$@" >&2; return 1
                fi
                jq_args+=("$1" "$2" "$3"); shift 3 ;;
            --slurpfile)
                [[ $# -ge 3 ]] || { state_message slurpfile-arguments "$@" >&2; return 1; }
                [[ -f "$3" ]] || { state_message slurpfile-missing "$@" >&2; return 1; }
                if ! jq -s -e 'length == 1' >/dev/null 2>&1 < "$3"; then
                    state_message slurpfile-value "$@" >&2; return 1
                fi
                jq_args+=(--slurpfile "$2" "$3"); shift 3 ;;
            *)
                [[ "$have_expr" -eq 0 ]] || { state_message extra-expression "$@" >&2; return 1; }
                jq_expr="$1"; have_expr=1; shift ;;
        esac
    done
    [[ "$have_expr" -eq 1 ]] || { state_message missing-expression "$@" >&2; return 1; }

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    atomic_update "$state_file" "$jq_expr" ${jq_args[@]+"${jq_args[@]}"}
}

# Atomic read-modify-write-report: the expression must evaluate to
# {state: <resulting full state>, report: <any>}. The write of `.state` and the
# capture of .report happen under the same lock, so the printed report is
# the evidence of exactly the transition this call performed — a follow-up
# `get` could instead observe another writer's interleaved change.
cmd_update_report() {
    local issue_id="$1"
    local jq_expr="$2"
    shift 2
    local -a jq_args=("$@")

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    local lock_file="${state_file}.lock"
    local tmp_file="${state_file}.tmp"

    # The report prints from INSIDE the locked section — no shared report
    # file exists to race on, so concurrent calls for the same issue each
    # return exactly their own transition's evidence.
    (
        orch_take_lock 200 "$lock_file" 10 || { state_message lock-failed "$@" >&2; exit 1; }

        local combined
        if ! combined=$(jq -c ${jq_args[@]+"${jq_args[@]}"} "$jq_expr" "$state_file" 2>&1); then
            state_message jq-failed "$@" >&2
            exit 1
        fi
        # Exactly ONE {state, report} object: a stream of several would write
        # multiple top-level documents into the state file.
        if ! jq -e -s 'length == 1 and (.[0].state | type == "object") and (.[0] | has("report"))' >/dev/null 2>&1 <<<"$combined"; then
            state_message report-shape "$@" >&2
            exit 1
        fi
        jq -c '.state' <<<"$combined" > "$tmp_file"
        mv "$tmp_file" "$state_file"
        jq -c '.report' <<<"$combined"
    ) 200>"$lock_file"
}

cmd_post_pr_stop() {
    local action="${1:-}" issue_id="${2:-}"
    [[ -n "$action" && -n "$issue_id" ]] || { state_message stop-arguments "$@" >&2; return 2; }
    case "$action" in
        record|record-if-empty)
            [[ $# -eq 6 ]] || { state_message stop-fields "$@" >&2; return 2; }
            local name="$3" gate="$4" remaining="$5" comment_file="$6" mode="replace"
            [[ "$action" == "record-if-empty" ]] && mode="if-empty"
            local report result tmp_comment
            report=$(cmd_update_report "$issue_id" '
              (.post_pr_stop // null) as $current |
              if $mode == "if-empty" and $current != null then
                {state: ., report: {result: "kept", stop: $current}}
              else
                {state: (.post_pr_stop = {name: $name, gate: $gate, remaining: [$remaining]}),
                 report: {result: "recorded", stop: {name: $name, gate: $gate, remaining: [$remaining]}}}
              end' --arg mode "$mode" --arg name "$name" --arg gate "$gate" --arg remaining "$remaining") || return 1
            result=$(jq -r '.result' <<<"$report")
            if [[ "$result" == "recorded" ]]; then
                tmp_comment="${comment_file}.tmp"
                printf '## Orchestration stopped\n\n- Stop: `%s`\n- Gate: `%s`\n- Remaining: %s\n' "$name" "$gate" "$remaining" > "$tmp_comment"
                mv "$tmp_comment" "$comment_file"
            fi
            printf '%s\n' "$result"
            ;;
        *) state_message stop-action "$@" >&2; return 2 ;;
    esac
}

cmd_head_budget() {
    local action="${1:-}" issue_id="${2:-}" kind="${3:-}"
    [[ -n "$action" && -n "$issue_id" && -n "$kind" ]] || { state_message budget-arguments "$@" >&2; return 2; }
    # review-wait resets on a changed head; ci-fix must not, which is what the
    # flag exists for. Every ci-fix cycle pushes its fix, so the next take
    # always sees a new head, and resetting there would give each retry a fresh
    # count with CI_FIX_MAX_CYCLES bounding nothing. A passing CI run clears it.
    local field setting head_keyed
    case "$kind" in
        review-wait) field=review_wait; setting=REVIEW_MAX_EXTERNAL_ROUNDS; head_keyed=true ;;
        ci-fix) field=ci_fix; setting=CI_FIX_MAX_CYCLES; head_keyed=false ;;
        *) state_message budget-kind "$@" >&2; return 2 ;;
    esac
    case "$action" in
        take)
            [[ $# -eq 4 ]] || { state_message budget-fields "$@" >&2; return 2; }
            local head="$4" limit report
            limit=$(cap_limit "$setting") || return 1
            report=$(cmd_update_report "$issue_id" '
              (.post_pr_budgets[$field] // null) as $saved |
              (if $head_keyed and (($saved.head // "") != $head) then 0 else ($saved.attempts // 0) end) as $used |
              if $used >= $limit then
                {state: ., report: {verdict: "at-cap", attempts: $used, limit: $limit}}
              else
                {state: (.post_pr_budgets[$field] = {head: $head, attempts: ($used + 1)}),
                 report: {verdict: "continue", attempts: ($used + 1), limit: $limit}}
              end' --arg field "$field" --arg head "$head" --argjson limit "$limit" --argjson head_keyed "$head_keyed") || return 1
            jq -r '"\(.verdict) \(.attempts)/\(.limit)"' <<<"$report"
            ;;
        *) state_message budget-action "$@" >&2; return 2 ;;
    esac
}

cmd_append() {
    local issue_id="$1"
    local field="$2"
    local value="$3"

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    # Handle nested fields (e.g., pr_comment_review.fixes)
    if [[ "$value" == "{"* ]] || [[ "$value" == "["* ]]; then
        # JSON object or array - use as-is
        atomic_update "$state_file" ".${field} += [${value}]"
    else
        # String value - use --arg for safe quoting (handles embedded quotes)
        local tmp_file="${state_file}.tmp"
        local lock_file="${state_file}.lock"
        (
            orch_take_lock 200 "$lock_file" 10 || { state_message lock-unavailable "$@" >&2; exit 1; }
            jq --arg v "$value" ".${field} += [\$v]" "$state_file" > "$tmp_file" 2>&1 || { rm -f "$tmp_file"; exit 1; }
            jq empty "$tmp_file" 2>/dev/null || { state_message json-invalid "$@" >&2; rm -f "$tmp_file"; exit 1; }
            mv "$tmp_file" "$state_file"
        ) 200>"$lock_file"
    fi
}

# The time rule the two stamped fields share: the `fleet_log` record's `at`
# and the `handoff` record's `written_at`. Both are this script's to write, not
# the caller's. Every other field of either record carries a judgement the
# caller made; the time is a clock reading the caller can only guess at, and a
# guess can name a moment that has not arrived.
#
# Prints the verdict for RAW and the clock it was judged against, separated by
# a tab.
#
#   clock    this script could not read its own clock, so it can neither
#            stamp the record nor judge what the record carries
#   stamp    the record carries no time, so the caller writes the printed
#            clock into it
#   invalid  RAW is not the ISO 8601 UTC form the schema names, or names no
#            instant a calendar has. Neither question is left to the date
#            ladder, whose two arms answer both of them differently: the GNU
#            arm reads spellings the BSD arm cannot, and the BSD arm, being
#            strptime then mktime, range-checks a day as 1 to 31 and then
#            normalizes the thirtieth of February into the first of March
#            instead of refusing it. So
#            the shape is the regex below, and the instant is the round trip
#            below that — to the epoch and back into this same form. Both arms
#            agree on it, because a date either of them normalized renders as
#            the day it moved to and no longer matches RAW. A record stored on
#            Linux and refused on macOS, or the reverse, is the one outcome
#            neither caller can act on
#   future   the record is dated past the clock, which no write can be
#   keep     anything else, because a write that lands late is a real late
#            write
#
# Naming the refusal is each caller's, since the two fields are refused under
# their own keys. `clock` is the exception: the clock is this script's, not
# either field's, so both callers refuse it under the one `clock-unreadable`
# key rather than two spellings of one cause.
ISO_UTC_RE='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
stamp_judge() { # RAW -> VERDICT<TAB>NOW
    local raw="$1" now_epoch now raw_epoch verdict=keep
    # Both clock reads are checked, because a command substitution carries no
    # failure out to the caller: unchecked, a `date` that exits nonzero leaves
    # them empty and the `stamp` arm below writes that empty string into the
    # record under a success exit, which is the one thing this rule exists to
    # prevent. A clock printing something that is not an epoch is the same
    # refusal, since `from_epoch` cannot render it and leaves `now` empty.
    now_epoch=$(date -u +%s) || now_epoch=""
    now=$(from_epoch "$now_epoch" '%Y-%m-%dT%H:%M:%SZ') || now=""
    if [[ -z "$now_epoch" || -z "$now" ]]; then
        printf 'clock\t\n'
        return 0
    fi
    if [[ -z "$raw" ]]; then
        verdict=stamp
    elif [[ ! "$raw" =~ $ISO_UTC_RE ]]; then
        verdict=invalid
    elif ! raw_epoch=$(to_epoch "$raw"); then
        verdict=invalid
    elif [[ "$(from_epoch "$raw_epoch" '%Y-%m-%dT%H:%M:%SZ')" != "$raw" ]]; then
        verdict=invalid
    elif [[ "$raw_epoch" -gt "$now_epoch" ]]; then
        verdict=future
    fi
    printf '%s\t%s\n' "$verdict" "$now"
}

# Append one JSON value read from a FILE to an array field. The value never
# crosses argv, so text nobody here authored — a finding's root cause, a
# location, a reviewer's own words — reaches the state whatever quoting it
# carries. The field's array is created when absent.
#
# On the fleet log, `at` is this script's to write, not the caller's, on the
# rule `stamp_judge` holds. A record that is not an object has no `at` to judge
# or to stamp, and is refused here rather than reaching jq as an indexing
# failure that names the filter instead of the record.
cmd_append_file() {
    local issue_id="$1"
    local field="$2"
    local file="$3"

    [[ -n "$field" ]] || { state_message append-field "$@" >&2; return 1; }
    [[ -f "$file" ]] || { state_message append-missing "$@" >&2; return 1; }
    if ! jq -s -e 'length == 1' >/dev/null 2>&1 < "$file"; then
        state_message append-value "$@" >&2; return 1
    fi

    local entry_expr='$entry[0]'
    local -a stamp_args=()
    if [[ "$field" == fleet_log ]]; then
        local at judged now
        if ! at=$(jq -er 'select(type == "object") | .at // ""' < "$file" 2>/dev/null); then
            state_message fleet-log-record "$@" >&2; return 1
        fi
        judged=$(stamp_judge "$at")
        now=${judged#*$'\t'}
        case "${judged%%$'\t'*}" in
            clock)   state_message clock-unreadable "$@" >&2; return 1 ;;
            invalid) state_message fleet-log-at-invalid "$@" >&2; return 1 ;;
            future)  state_message fleet-log-at-future "$@" >&2; return 1 ;;
            stamp)   stamp_args=(--arg now "$now")
                     entry_expr='($entry[0] | .at = $now)' ;;
        esac
        # A successor reads the last ORCH_TAKEOVER_ROWS rows whole at takeover,
        # so the cap on each row's text is what bounds that read.
        local cap bytes
        cap=$("$SCRIPT_DIR/orch-env" ORCH_FLEET_LOG_ROW_BYTES 600) || return 1
        bytes=$(jq -r '.text? // "" | tostring | utf8bytelength' < "$file") || return 1
        if (( bytes > cap )); then
            state_message fleet-log-row-bytes "$@" >&2; return 1
        fi
    fi

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    atomic_update "$state_file" ".${field} = ((.${field} // []) + [${entry_expr}])" \
        --slurpfile entry "$file" ${stamp_args[@]+"${stamp_args[@]}"}
}

# The round caps, spelled once: setting name, the workflow-state field its
# count is read from (empty when the caller keeps its own count), and its
# default. `cap`, the rereview_panel guard below, every refusal's roster and
# the help text derive from this table, so a cap included or renamed here needs no
# second edit kept in step, and `cap_limit` is the one place a cap resolves.
cap_table() {
    printf 'REVIEW_MAX_CYCLES\trereview_cycles\t4\n'
    printf 'REVIEW_MAX_EXTERNAL_ROUNDS\tpr_comment_review.iterations\t4\n'
    printf 'CI_FIX_MAX_CYCLES\t\t6\n'
}

# One cap's "<field><tab><default>", or the one refusal naming every known cap.
cap_row() {
    cap_table | awk -F'\t' -v want="$1" '$1 == want { print $2 "\t" $3; found = 1 } END { exit found ? 0 : 1 }' && return 0
    state_message unknown-cap "$@" >&2
    return 2
}

cap_limit() {
    local row
    row=$(cap_row "$1") || return 2
    "$SCRIPT_DIR/orch-env" "$1" "${row##*$'\t'}"
}

# The workflows' reader for the table above: a cap is read through this command
# instead of pairing an orch-env call with a private default and comparison.
#
#   cap SETTING                 -> the resolved cap number
#   cap SETTING --issue ID      -> "<below|at-cap> <count>/<cap>", count from state
#   cap SETTING --count N       -> "<below|at-cap> <N>/<cap>"
#
# `at-cap` is count >= cap: the count is entries already taken, so a count
# equal to the cap has spent the whole budget.
cmd_cap() {
    local setting="${1:-}"
    shift || true
    local issue_id="" count="" have_count=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --issue) [[ $# -ge 2 ]] || { state_message missing-issue "$@" >&2; return 2; }
                     issue_id="$2"; shift 2 ;;
            --count) [[ $# -ge 2 ]] || { state_message missing-count "$@" >&2; return 2; }
                     count="$2"; have_count=1; shift 2 ;;
            *) state_message cap-argument "$@" >&2; return 2 ;;
        esac
    done

    local row field limit
    row=$(cap_row "$setting") || return 2
    field="${row%%$'\t'*}"
    limit=$(cap_limit "$setting") || return 2

    if [[ "$have_count" -eq 0 && -z "$issue_id" ]]; then
        printf '%s\n' "$limit"
        return 0
    fi
    if [[ "$have_count" -eq 1 && -n "$issue_id" ]]; then
        state_message cap-source-conflict "$@" >&2; return 2
    fi

    if [[ "$have_count" -eq 0 ]]; then
        [[ -n "$field" ]] || { state_message cap-count-required "$@" >&2; return 2; }
        local state_file
        state_file=$(get_state_file "$issue_id")
        ensure_state_exists "$state_file"
        count=$(jq -r "(.${field} // 0) | tostring" "$state_file") || return 1
    fi
    [[ "$count" =~ ^[0-9]+$ ]] || { state_message invalid-count "$@" >&2; return 2; }

    if (( count >= limit )); then
        printf 'at-cap %s/%s\n' "$count" "$limit"
    else
        printf 'below %s/%s\n' "$count" "$limit"
    fi
}

cmd_increment() {
    local issue_id="$1"
    local field="$2"

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    atomic_update "$state_file" ".${field} += 1"
}

cmd_set() {
    local issue_id="$1"
    local field="$2"
    local value="$3"

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    # review-pr § 4 writes `rereview_panel` to re-enter § 2: that write IS the re-review cycle, so it raises `rereview_cycles` under the same lock it is gated on, and refuses once that count reaches REVIEW_MAX_CYCLES, so the setting is the number of entries allowed. The count is entries already taken, so the comparison is >=, not >.
    # Nothing else spends that budget: `cycles` is the general fix-round tally, and § 7's QA re-check and § 2 verification pass write `qa_recheck_panel` and `verification_panel`, fields this branch never matches.
    if [[ "$field" == "rereview_panel" && "$value" == "{"* ]]; then
        local cap report
        cap=$(cap_limit REVIEW_MAX_CYCLES) || { state_message cap-unresolved "$@" >&2; return 1; }
        report=$(cmd_update_report "$issue_id" "(.rereview_cycles // 0) as \$n | if \$n >= $cap then {state: ., report: {refused: true, entered: \$n}} else {state: (.rereview_panel = $value | .rereview_cycles = \$n + 1), report: {refused: false}} end") || return 1
        if [[ "$(jq -r '.refused' <<<"$report")" == "true" ]]; then
            state_message cycle-cap "$@" >&2
            return 1
        fi
        return 0
    fi

    # `handoff`'s `written_at` is this script's on the `stamp_judge` rule: the
    # lane types the record at its safe point and the clock is read here. The
    # schema names ISO 8601 UTC for the field, which is the shape that rule
    # holds it to. A record that is not an object carries no `written_at` to
    # judge or to stamp.
    if [[ "$field" == handoff ]]; then
        local written_at judged now
        if ! written_at=$(jq -er 'select(type == "object") | .written_at // ""' <<<"$value" 2>/dev/null); then
            state_message handoff-record "$@" >&2; return 1
        fi
        judged=$(stamp_judge "$written_at")
        now=${judged#*$'\t'}
        case "${judged%%$'\t'*}" in
            clock)   state_message clock-unreadable "$@" >&2; return 1 ;;
            invalid) state_message handoff-written-at-invalid "$@" >&2; return 1 ;;
            future)  state_message handoff-written-at-future "$@" >&2; return 1 ;;
            stamp)   atomic_update "$state_file" ".${field} = (${value} | .written_at = \$now)" \
                         --arg now "$now"
                     return 0 ;;
        esac
    fi

    if [[ "$value" == "{"* ]] || [[ "$value" == "["* ]] || [[ "$value" == "null" ]] || [[ "$value" == "true" ]] || [[ "$value" == "false" ]] || [[ "$value" =~ ^[0-9]+$ ]]; then
        # JSON object, array, null, boolean, or number - use as-is
        atomic_update "$state_file" ".${field} = ${value}"
    else
        # String value - use --arg for safe quoting (handles embedded quotes)
        local tmp_file="${state_file}.tmp"
        local lock_file="${state_file}.lock"
        (
            orch_take_lock 200 "$lock_file" 10 || { state_message lock-unavailable "$@" >&2; exit 1; }
            jq --arg v "$value" ".${field} = \$v" "$state_file" > "$tmp_file" 2>&1 || { rm -f "$tmp_file"; exit 1; }
            jq empty "$tmp_file" 2>/dev/null || { state_message json-invalid "$@" >&2; rm -f "$tmp_file"; exit 1; }
            mv "$tmp_file" "$state_file"
        ) 200>"$lock_file"
    fi
}

cmd_set_git_head() {
    local issue_id="$1"
    local field="$2"
    local worktree="${3:-.}"
    local value

    value="$(git -C "$worktree" rev-parse HEAD)"
    cmd_set "$issue_id" "$field" "$value"
}

cmd_set_now() {
    local issue_id="$1"
    local field="$2"
    local value

    value="$(date +%s)"
    cmd_set "$issue_id" "$field" "$value"
}

# Generate a unique per-delegation round token, store it at <field>, and print
# it. The token binds a dev completion artifact to exactly the delegation that
# produced it: the writer names its file dev-return-<issue>-<RID>.json
# and embeds "round_id": RID, and dev-artifact-check resolves that exact path and
# rejects any receipt whose internal round_id differs. The token proves WHICH
# delegation wrote the bytes; mtime proves only WHEN they were written.
#
# The token is a nanosecond-resolution timestamp (`date +%s%N`) plus a random
# suffix, so even rapid same-second (indeed same-millisecond) re-stamps get
# distinct tokens — unlike a concatenated `$RANDOM$RANDOM`, which is not injective
# (e.g. "1"+"20" == "12"+"0"). Both components stay within the path-safe grammar.
cmd_new_round_id() {
    local issue_id="$1"
    local field="$2"
    local value

    value="$(date +%s%N)-$RANDOM"
    cmd_set "$issue_id" "$field" "$value"
    echo "$value"
}

# Mint and print a key for work whose branch carries no issue id and whose PR
# gives none either: local-<epoch>-<pid>-<random>. The key names no issue, so
# branch-size-check measures it without reading a tracker, and it matches the
# path-safe grammar every round writer checks. Nothing is written: the caller
# that minted it owns the key, inits state under it and removes that state.
# Seconds rather than %N, which macOS date prints as a literal N; the pid keeps
# two same-second mints from one repository apart.
cmd_new_local_key() {
    local now field=local_key
    [[ $# -eq 0 ]] || { state_message unknown-option "$@" >&2; return 2; }
    now=$(date -u +%s) || now=""
    [[ "$now" =~ ^[0-9]+$ ]] || { state_message clock-unreadable "$@" >&2; return 1; }
    printf 'local-%s-%s-%s\n' "$now" "$$" "$RANDOM"
}

cmd_path() {
    local issue_id="$1"
    get_state_file "$issue_id"
}

cmd_exists() {
    local json=false

    if [[ "${1:-}" == "--json" ]]; then
        json=true
        shift
    fi

    local issue_id="${1:-}"
    if [[ -z "$issue_id" ]]; then
        state_message exists-issue "$@" >&2
        exit 2
    fi

    local state_file
    state_file=$(get_state_file "$issue_id")

    if [[ "$json" == true ]]; then
        local exists=false
        [[ -f "$state_file" ]] && exists=true
        jq -n \
          --arg issue_id "$issue_id" \
          --arg path "$state_file" \
          --argjson exists "$exists" \
          '{issue_id: $issue_id, path: $path, exists: $exists}'
        return 0
    fi

    [[ -f "$state_file" ]]
}

# The one judge of whether a lane's handoff record stands, so the watch that
# reports it, the turn-end hook that refuses on it and the resume that stamps
# it never answer the question three ways. A `.handoff` a relaunch resumed
# belongs to an earlier life of the item and is not one.
#
# The verdict is the word this verb prints, never a status it exits with, and
# the verb exits 0 for every verdict. Every orch script sources the project's
# `.env.local` as shell before its dispatch is reached, and bash 3.2 kills the
# shell on a file it cannot parse — 2 for a syntax error, 1 for one it cannot
# read — where bash 5 carries on. A status-only contract would therefore spell
# "this state could not be read" and "this script died in its settings loader
# before the verb ran" with the same 2, and send an operator to the item's
# state file over a fault in `.env.local`. Only a run that reached the verb
# writes a verdict line, so the word carries what no status can:
#   workflow-state: handoff-standing=stands      the record follows, one JSON line
#   workflow-state: handoff-standing=none        a state file that is not there included
#   workflow-state: handoff-standing=unreadable  jq's own words are on stderr
# A caller reads that word and nothing else. Any non-zero status, and any first
# line that is not one of the three, is a run that never reached this verb — an
# install older than it answers 1 from the dispatcher's unknown-command arm —
# and is never read as "none stands", which would tell a lane that has already
# written its record to write it again at every turn end, with no way out.
handoff_verdict() { # WORD — the verdict line, the one place its text lives
    printf 'workflow-state: handoff-standing=%s\n' "$1"
}

cmd_handoff_standing() {
    local issue_id="$1" state_file record

    if ! state_file=$(get_state_file "$issue_id"); then
        handoff_verdict unreadable
        return 0
    fi
    if [[ ! -f "$state_file" ]]; then
        handoff_verdict none
        return 0
    fi
    if ! record=$(jq -r '.handoff | select(type == "object" and .resumed_at == null) | tojson' "$state_file"); then
        handoff_verdict unreadable
        return 0
    fi
    if [[ -z "$record" ]]; then
        handoff_verdict none
        return 0
    fi
    handoff_verdict stands
    printf '%s\n' "$record"
}

# The main checkout every worktree of this repository shares, or the project
# root outside Git, and a project-relative setting joined to it, so a path
# setting names one directory from any checkout.
project_root() {
    if git -C "$PROJECT_ROOT" rev-parse --show-toplevel >/dev/null 2>&1; then
        "$SCRIPT_DIR/git-context" common-root "$PROJECT_ROOT"
    else
        printf '%s\n' "$PROJECT_ROOT"
    fi
}

project_path() { # PATH
    local root
    case "$1" in
        /*) printf '%s\n' "$1" ;;
        *) root=$(project_root) || return 1
           printf '%s/%s\n' "$root" "$1" ;;
    esac
}

# The fleet state's path, returning 1 where no file is there yet. A first fleet
# session has none until its first launch writes one, which leaves the verbs
# that run at a fleet's edges, takeover and prune, nothing to read or remove
# rather than a missing state to refuse.
fleet_state_file() {
    local state_file
    state_file=$(get_state_file oversee)
    printf '%s\n' "$state_file"
    [[ -f "$state_file" ]]
}

# The fleet log's two readers, each printing its rows one JSON object per
# line: the successor overseer's takeover read, the last ORCH_TAKEOVER_ROWS
# rows but the `cycle` rows oversee-cycle logs, which would crowd the rulings
# out of the window, and the audit read, every proposal and ruling row.
cmd_fleet_log() {
    local reader="${1:-}" state_file rows
    case "$reader" in
        takeover)
            state_file=$(fleet_state_file) || return 0
            rows=$("$SCRIPT_DIR/orch-env" ORCH_TAKEOVER_ROWS 10) || return 1
            jq -c --argjson n "$rows" \
                '[(.fleet_log // [])[] | select(.kind != "cycle")] | if $n == 0 then empty else .[-$n:][] end' "$state_file" ;;
        audit)
            state_file=$(get_state_file oversee)
            ensure_state_exists "$state_file"
            jq -c '(.fleet_log // [])[] | select(.kind == "proposal" or .kind == "ruling")' "$state_file" ;;
        *) state_message fleet-log-reader "$@" >&2; return 2 ;;
    esac
}

# The owner progress report record, which the writer and the prune both read
# here: its directory, ORCH_PROGRESS_REPORT_DIR joined to the project, and its
# name, a UTC stamp, the suffix of the one a succession writes, then .md. The
# pattern is derived from the stamp format, each field two digits.
PROGRESS_REPORT_STAMP='%m-%d-%H-%M'
PROGRESS_REPORT_SUFFIX=-succession
PROGRESS_REPORT_RE='[0-9]{2}'
PROGRESS_REPORT_RE="^${PROGRESS_REPORT_STAMP//%?/$PROGRESS_REPORT_RE}($PROGRESS_REPORT_SUFFIX)?\\.md\$"
progress_report_dir() {
    local setting
    setting=$("$SCRIPT_DIR/orch-env" ORCH_PROGRESS_REPORT_DIR tmp/progress-reports) || return 1
    project_path "$setting"
}

# The owner progress report's path: MM-DD-HH-MM.md in UTC under
# ORCH_PROGRESS_REPORT_DIR, with -succession before the extension for the one
# a succession writes. The directory is created; the report is the caller's.
cmd_progress_report_path() {
    local suffix="" dir now_epoch stamp err field=progress_report
    case "$#:${1:-}" in
        0:) ;;
        1:--succession) suffix=$PROGRESS_REPORT_SUFFIX ;;
        *) state_message unknown-option "$@" >&2; return 2 ;;
    esac
    dir=$(progress_report_dir) || return 1
    now_epoch=$(date -u +%s) || now_epoch=""
    stamp=$(from_epoch "$now_epoch" "$PROGRESS_REPORT_STAMP") || stamp=""
    if [[ -z "$now_epoch" || -z "$stamp" ]]; then
        state_message clock-unreadable "$@" >&2; return 1
    fi
    err=$(mkdir -p -- "$dir" 2>&1) || { state_message progress-dir-failed "$@" >&2; return 1; }
    printf '%s/%s%s.md\n' "$dir" "$stamp" "$suffix"
}

# `prune [--keep PATH]...`: the retention that
# schemas/workflow-state.md § Recording policy states, applied to the fleet
# state and the directory holding it.
#
# Every refusal here rests on telling a live lane from a closed one, which only
# the fleet state's lane records can do, so a prune with no fleet state judges
# nothing on file ages alone and touches nothing. The keep list is explicit, and
# a path on it is never a candidate whatever its age. Nothing leaves the disk or
# the state before one archive holding all of it is written: a failed archive
# removes nothing, and the rows are dropped from the state before any path is
# removed, so a failure part way leaves the archive a superset of what went.
#
# Output, one keyed line each: `pruned path=PATH` per removed path, then
# `pruned fleet_log=N lanes=N progress_reports=N paths=N`, then `kept=ARCHIVE`,
# or `kept=none` where there was nothing to archive. With no fleet state it is
# `pruned fleet-state=none path=STATE_FILE` alone.
cmd_prune() {
    local -a keeps=() units=() candidates=()
    local keep
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --keep)
                [[ $# -ge 2 && -n "$2" ]] || { state_message keep-value "$@" >&2; return 2; }
                keep="$2"
                [[ "$keep" == /* ]] || keep="$PWD/$keep"
                if [[ -d "$keep" ]]; then
                    keep=$(cd -P -- "$keep" && pwd -P) || return 1
                elif [[ -d "$(dirname -- "$keep")" ]]; then
                    keep="$(cd -P -- "$(dirname -- "$keep")" && pwd -P)/$(basename -- "$keep")" || return 1
                fi
                keeps+=("$keep"); shift 2 ;;
            *) state_message unknown-option "$@" >&2; return 2 ;;
        esac
    done

    local state_file field=fleet_log
    if ! state_file=$(fleet_state_file); then
        printf 'pruned fleet-state=none path=%s\n' "$state_file"
        return 0
    fi

    local days progress_dir now_epoch cutoff
    days=$("$SCRIPT_DIR/orch-env" ORCH_RECORD_RETENTION_DAYS 14) || return 1
    progress_dir=$(progress_report_dir) || return 1
    now_epoch=$(date -u +%s) || now_epoch=""
    cutoff=""
    [[ -z "$now_epoch" ]] || cutoff=$(from_epoch "$((now_epoch - days * 86400))" '%Y-%m-%dT%H:%M:%SZ') || cutoff=""
    [[ -n "$cutoff" ]] || { state_message clock-unreadable "$@" >&2; return 1; }

    # A lane whose record is anything but `done` is live: `running`, and a
    # `preparing` or `stopped` one a relaunch resumes into its own files. The
    # first lane record stays whatever its age or status: its `launched_at` is
    # the fleet start every watch passes as --since.
    local live rows
    live=$(jq -r '(.lanes // [])[] | select(.status != "done") | .item // empty' "$state_file") || return 1
    rows=$(jq -c --arg cut "$cutoff" --arg iso "$ISO_UTC_RE" '
        def old: type == "string" and test($iso) and . < $cut;
        {fleet_log: [(.fleet_log // [])[] | select(.at | old)],
         lanes: [(.lanes // [])[1:][] | select(.status == "done" and (.launched_at | old))]}' "$state_file") || return 1

    local sd pd=""
    sd=$(cd -P -- "$STATE_DIR" && pwd -P) || return 1
    [[ ! -d "$progress_dir" ]] || pd=$(cd -P -- "$progress_dir" && pwd -P) || return 1
    if [[ -n "$pd" && ( "$pd" == "$sd" || "$sd" == "$pd"/* ) ]]; then
        state_message prune-progress-overlap "$@" >&2; return 1
    fi

    # The watch's own files, named where their one owner names them.
    watch_pid_paths "$state_file" || return 1
    local entry f
    shopt -s nullglob dotglob
    for entry in "$sd"/*; do
        [[ "$pd" != "$entry" && "$pd" != "$entry"/* ]] || continue
        case "$entry" in
            "$sd/${state_file##*/}"|"$sd/${state_file##*/}.lock"|"$WATCH_PID_FILE"|"$WATCH_ARGV_FILE"|"$WATCH_LOG_FILE"|"$WATCH_ERR_FILE"|"$WATCH_RUNNER_FILE") ;;
            "$sd/handoffs")
                for f in "$entry"/*; do [[ "${f##*/}" == OVERSEER-HANDOFF.md ]] || units+=("$f"); done ;;
            "$sd/lane-mail")
                for f in "$entry"/*; do [[ "${f##*/}" == overseer ]] || units+=("$f"); done ;;
            *) units+=("$entry") ;;
        esac
    done
    if [[ -n "$pd" ]]; then
        for f in "$pd"/*; do
            [[ ! "${f##*/}" =~ $PROGRESS_REPORT_RE ]] || units+=("$f")
        done
    fi
    shopt -u nullglob dotglob

    local unit item re recent err="" kept_by reports=0
    for unit in ${units[@]+"${units[@]}"}; do
        kept_by=""
        for keep in ${keeps[@]+"${keeps[@]}"}; do
            [[ "$unit" != "$keep" && "$keep" != "$unit"/* ]] || kept_by=keep
        done
        # A live lane's item as a whole token of the name: its mailbox, its
        # workflow state, its status file and anything else named for it.
        while IFS= read -r item; do
            [[ -n "$item" ]] || continue
            re="(^|[-_.])${item//./\\.}([-_.]|$)"
            [[ ! "${unit##*/}" =~ $re ]] || kept_by=live
        done <<<"$live"
        [[ -z "$kept_by" ]] || continue
        # A find that fails prints why on the lines it returns, and a warning
        # beside a success leaves the unit kept as recent.
        if ! recent=$(find "$unit" -mtime "-$days" -print 2>&1); then
            err="$recent"; state_message prune-age-unreadable "$@" >&2; return 1
        fi
        [[ -z "$recent" ]] || continue
        candidates+=("$unit")
        [[ -z "$pd" || "$unit" != "$pd"/* ]] || reports=$((reports + 1))
    done

    local n_rows n_log n_lanes repo_root archive_dir stage="" archive=none saved_umask
    n_log=$(jq '.fleet_log | length' <<<"$rows") || return 1
    n_lanes=$(jq '.lanes | length' <<<"$rows") || return 1
    n_rows=$((n_log + n_lanes))
    if [[ "$n_rows" -gt 0 || "${#candidates[@]}" -gt 0 ]]; then
        repo_root=$(project_root) || return 1
        archive_dir="${FLEET_DIR:-$HOME/.fleet}/archive/${repo_root##*/}/oversee"
        # Private, as lane-host close keeps a lane's archive: the archive holds
        # whatever the state directory held, secrets included. Paths are
        # relative to /, as that close archives them, so a progress directory
        # outside the state directory archives the same way. The refusal's key
        # is the first line, and the failing step's own words follow it.
        saved_umask=$(umask)
        umask 077
        if ! err=$(mkdir -p -- "$archive_dir" 2>&1); then
            :
        elif ! stage=$(mktemp -d "$archive_dir/prune-$now_epoch-XXXXXX" 2>&1); then
            err="$stage"; stage=""
        elif ! { printf '%s\n' "$rows" > "$stage/records.json" \
                 && { printf '%s\n' "${stage#/}/records.json"
                      for unit in ${candidates[@]+"${candidates[@]}"}; do printf '%s\n' "${unit#/}"; done
                    } > "$stage/paths" \
                 && tar -czf "$stage.tgz" -C / -T "$stage/paths" 2>"$stage/tar.err"; }; then
            err=$(cat -- "$stage/tar.err" 2>/dev/null) || err=""
        else
            archive="$stage.tgz"
        fi
        umask "$saved_umask"
        if [[ "$archive" == none ]]; then
            [[ -z "$stage" ]] || rm -rf -- "${stage:?}" "${stage:?}.tgz"
            state_message prune-archive-failed "$@" >&2; return 1
        fi
        if [[ "$n_rows" -gt 0 ]] && ! atomic_update "$state_file" \
            '.fleet_log = ((.fleet_log // []) - $r[0].fleet_log) | .lanes = ((.lanes // []) - $r[0].lanes)' \
            --slurpfile r "$stage/records.json"; then
            rm -rf -- "${stage:?}"; return 1
        fi
        rm -rf -- "${stage:?}"
        for unit in ${candidates[@]+"${candidates[@]}"}; do
            err=$(rm -rf -- "${unit:?}" 2>&1) || { state_message prune-remove-failed "$@" >&2; return 1; }
            printf 'pruned path=%s\n' "$unit"
        done
    fi
    printf 'pruned fleet_log=%s lanes=%s progress_reports=%s paths=%s\n' \
        "$n_log" "$n_lanes" "$reports" "${#candidates[@]}"
    printf 'kept=%s\n' "$archive"
}

cmd_remove() {
    local state_file
    state_file="$(get_state_file "$1")"
    rm -f -- "$state_file" "$state_file.lock"
}

cmd_help() {
    cat << 'EOF'
Usage: workflow-state [--state-dir <path>] <command> <issue_id> [args...]

Global options (before the subcommand):
  --state-dir <path>            Override state directory for all subcommands.
                                Takes precedence over ORCH_STATE_DIR. Prefer this
                                flag over the ORCH_STATE_DIR=… env prefix from
                                worktree sessions: a plain flag is classifier-safe
                                under Codex approval=never.

Commands:
  init <issue_id> [options]     Create new state file
    --agent <name>              Primary agent
    --worktree <path>           Worktree path
    --branch <name>             Branch name
    --qa-labels <json_array>    QA labels (default: [])
    --sub-issues <json_array>   Sub-issue IDs (default: [])

  get <issue_id> [jq_path]      Read value (default: entire state)
  update <issue_id> [--arg NAME VALUE]... [--argjson NAME JSON]...
         [--slurpfile NAME FILE]... <jq_expr>
                                Run arbitrary jq expression. --arg binds VALUE
                                to $NAME as a literal string, --argjson binds
                                parsed JSON, --slurpfile binds FILE's values as
                                an array (a one-value file reads as $NAME[0])
                                and is passed to jq, so only the path crosses
                                argv — a document sent as an --argjson value
                                exceeds the 128 KB single-argument cap and jq
                                never launches. Text you did not author (a
                                finding's location or description, any artifact
                                field) goes in a binding and is read as $NAME —
                                interpolated instead, one apostrophe or quote
                                makes jq fail and nothing is written. Under a
                                harness that rejects $(...) and multi-command
                                blocks, --slurpfile is the only way to bind
                                artifact text: name the path, not the contents
  update-report <issue_id> <jq_expr>
                                Atomic read-modify-write-report: the jq expr
                                runs against the current state under the same
                                lock as update and must produce
                                {state: <new full state>, report: <any>} —
                                .state is written back, .report printed
                                compactly. Use when a caller needs a decision
                                and its evidence from the SAME locked step
                                (a separate get after update can interleave
                                with another writer)
  post-pr-stop record <issue_id> <name> <gate> <remaining> <comment-file>
  post-pr-stop record-if-empty <issue_id> <name> <gate> <remaining> <comment-file>
                                Atomically record or preserve the stop and
                                render its Markdown comment
  head-budget take <issue_id> <review-wait|ci-fix> <head>
                                Atomically spend an automatic retry budget.
                                review-wait restarts its count on a changed
                                head; ci-fix counts across heads, since every
                                cycle pushes one. A continuing action clears it
  append <issue_id> <field> <value>   Append to array field
  append-file <issue_id> <field> <file>
                                Append the one JSON value in <file> to the
                                array at <field>, creating it when absent. The
                                value never crosses argv, so text you did not
                                author reaches the state whatever quoting it
                                carries. On field fleet_log the record must
                                be a JSON object, refused otherwise as
                                fleet-log-record; an "at" it carries is refused
                                as fleet-log-at-invalid unless it reads
                                YYYY-MM-DDThh:mm:ssZ and names a real instant,
                                and as fleet-log-at-future when it is later
                                than the clock; one it omits, or carries as
                                empty, null or false, is stamped with the
                                current UTC time. A clock this
                                command cannot read refuses the append as
                                clock-unreadable rather than stamping an
                                unreadable time. Text longer than
                                ORCH_FLEET_LOG_ROW_BYTES bytes (default 600) is
                                refused as fleet-log-row-bytes
  cap <setting> [--issue <id> | --count <n>]
                                Round caps. Bare: print the resolved cap.
                                With --issue: read the state field the setting
                                is measured against; with --count: use <n>.
                                Either prints "<below|at-cap> <count>/<cap>",
                                at-cap being count >= cap. Settings:
EOF
    cap_table | awk -F'\t' \
        '{ printf "%34s%s (%s, %s)\n", "", $1, ($2 == "" ? "--count only" : $2), $3 }'
    cat << 'EOF'
  increment <issue_id> <field>  Increment numeric field
  set <issue_id> <field> <value>  Set field value ({/[ prefix, null/true/false,
                                or all digits parse as JSON; anything else is
                                stored as a raw string — pass strings bare,
                                never pre-quoted '"..."'). On field handoff the
                                record must be a JSON object, refused otherwise
                                as handoff-record; a "written_at" it carries is
                                refused as handoff-written-at-invalid unless it
                                reads YYYY-MM-DDThh:mm:ssZ and names a real
                                instant, and as
                                handoff-written-at-future when it is later than
                                the clock; one it omits, or carries as empty,
                                null or false, is stamped with the current UTC
                                time. A clock this command cannot
                                read refuses the set as clock-unreadable rather
                                than stamping an unreadable time
  set-git-head <issue_id> <field> [worktree]  Set field to current HEAD SHA
  set-now <issue_id> <field>     Set field to current epoch seconds
  new-round-id <issue_id> <field>  Generate a unique per-delegation round token,
                                store it at <field>, and print it (binds a dev
                                completion artifact to its delegation — kendex#776)
  new-local-key                 Mint and print a local-<epoch>-<pid>-<random>
                                key for work with no issue id (Keys below);
                                writes nothing
  path <issue_id>               Print state file path
  exists [--json] <issue_id>    Exit 0 if exists, 1 if not; --json prints status and exits 0
  handoff-standing <issue_id>   Print one verdict line and exit 0:
                                  workflow-state: handoff-standing=stands
                                    a .handoff no relaunch has resumed; the
                                    record follows on the next line
                                  workflow-state: handoff-standing=none
                                    none stands, a state file that is not
                                    there included
                                  workflow-state: handoff-standing=unreadable
                                    the state could not be read; the reader's
                                    own words are on stderr
                                The word is the answer and the status is not.
                                A non-zero status, or a first line that is none
                                of the three, is a run that never reached this
                                verb — an install without it answers 1 as an
                                unknown command, and a settings file bash 3.2
                                cannot parse kills the script before dispatch —
                                and is never read as "no record stands"
  remove <issue_id>             Delete the state file and its lock sidecar; absent is success
  fleet-log takeover|audit      Print fleet_log rows of the oversee state, one
                                JSON object per line: takeover the last rows
                                of every kind but cycle, as many as the
                                setting ORCH_TAKEOVER_ROWS (default 10),
                                and nothing, exit 0, where no fleet state
                                exists yet; audit every proposal and ruling row
  progress-report-path [--succession]
                                Print the owner progress report's path,
                                MM-DD-HH-MM.md in UTC (MM-DD-HH-MM-succession.md
                                with --succession) under ORCH_PROGRESS_REPORT_DIR
                                (default tmp/progress-reports), creating the
                                directory
  prune [--keep PATH]...        Apply the retention in schemas/workflow-state.md
                                section Recording policy to the oversee state
                                and its directory, past the retention in days
                                that ORCH_RECORD_RETENTION_DAYS sets (default
                                14). Archives everything it removes under
                                FLEET_DIR/archive/REPO/oversee first (FLEET_DIR
                                defaults to ~/.fleet); a failed archive removes
                                nothing. Never removes a --keep path, the first
                                lane record, nor a path named for a lane whose
                                record is not done. Refused as
                                prune-progress-overlap where the progress report
                                directory is or holds the state directory.
                                Prints "pruned path=PATH" per removed path, a
                                "pruned fleet_log=N lanes=N progress_reports=N
                                paths=N" count, then "kept=ARCHIVE" or kept=none.
                                With no fleet state yet it prints "pruned
                                fleet-state=none path=PATH" alone and touches
                                nothing

Keys:
  Four per-item key forms: the tracker identifier (KEN-123) for a tracked
  issue, issue-<N> for a GitHub issue, the repository-local pr-<N> for a
  pull request whose branch carries no issue id, and local-<epoch>-<pid>-<random>
  from new-local-key for work with neither, such as a local review whose fix
  round needs a key. A workflow that inits state under a local key owns that
  state: it passes the key to every round it stamps and removes the state
  when it ends. pr-<N> and local- keys name no issue. Beside them stands one
  fixed key, oversee, holding the fleet session state that
  schemas/workflow-state.md section Oversee state describes. The key is stored as passed and validated by its
  callers, not here: every command interpolates <issue_id> into the state
  filename exactly as given, so pass init the spelling every later command
  will use.

Examples:
  workflow-state init PROJ-123 --agent rust --worktree /tmp/wt
  workflow-state exists --json PROJ-123
  workflow-state get PROJ-123 .cycles
  workflow-state increment PROJ-123 cycles
  workflow-state increment PROJ-123 pr_comment_review.iterations
  workflow-state append PROJ-123 json_paths "review.json"
  workflow-state append PROJ-123 fixed_items '{"description":"Fix","commit":"abc"}'
  workflow-state set PROJ-123 pr_review.mode review
  workflow-state set PROJ-123 pr_review_baseline '{"last_threads":["PRRT_kwDOABC123"]}'
  workflow-state set-git-head PROJ-123 pre_delegate_sha /tmp/wt
  workflow-state set-now PROJ-123 review_delegated_at
  workflow-state new-round-id PROJ-123 dev_round_id
  workflow-state update PROJ-123 '.fixed_items | map(select(.source == "qa-review"))'
  workflow-state --state-dir /path/to/tmp append PROJ-123 fixed_items '{"description":"Fix"}'

Environment:
  ORCH_STATE_DIR    Override state directory (default: tmp); --state-dir wins.
  Paths             Relative paths join the main checkout or cwd outside Git;
                    absolute paths stay unchanged.

Dependencies:
  jq               JSON processing
  flock             File locking, where it is installed; without it a mkdir
                    mutex serializes the same writers (stock macOS has no flock)
EOF
}

# The one parser for the global options that may precede the subcommand, and
# for the help forms. --state-dir <path> (or --state-dir=<path>) overrides the
# state directory for EVERY subcommand and takes precedence over
# ORCH_STATE_DIR (which stays supported as a fallback). Prefer this flag from
# worktree sessions: a plain flag is classifier-safe under Codex
# approval=never, whereas an `ORCH_STATE_DIR=… workflow-state …`
# env-assignment prefix is rejected as a flagged command shape.
#
# An EMPTY value is rejected, not read as absent: `--state-dir "$VAR"` with VAR
# unset must name the mistake, not write orch state where nobody asked.
parse_global_opts() {
    STATE_DIR_FLAG=""
    GLOBAL_OPTS=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --state-dir)
                if [[ $# -lt 2 || -z "$2" ]]; then
                    state_message state-dir-value "$@" >&2
                    exit 2
                fi
                STATE_DIR_FLAG="$2"
                GLOBAL_OPTS=$((GLOBAL_OPTS + 2))
                shift 2
                ;;
            --state-dir=*)
                STATE_DIR_FLAG="${1#--state-dir=}"
                if [[ -z "$STATE_DIR_FLAG" ]]; then
                    state_message state-dir-value "$@" >&2
                    exit 2
                fi
                GLOBAL_OPTS=$((GLOBAL_OPTS + 1))
                shift
                ;;
            *)
                break
                ;;
        esac
    done

    case "${1:-help}" in
        help|--help|-h) cmd_help; exit 0 ;;
    esac
}

# `.env.local` is sourced as shell, so help is answered before the loader runs:
# the dry run is the real parser in a subshell, so no value parsed from the
# command line exists for the loader's generic [env] handling to clobber, and
# 9 is the only status meaning it reached the end.
parse_rc=0
( parse_global_opts "$@"; exit 9 ) || parse_rc=$?
[[ "$parse_rc" -eq 9 ]] || exit "$parse_rc"
unset parse_rc

# shellcheck source=lib/date-ladder.sh
source "$SCRIPT_DIR/lib/date-ladder.sh"
# shellcheck source=lib/file-lock.sh
source "$SCRIPT_DIR/lib/file-lock.sh"
# shellcheck source=lib/watch-pid.sh
source "$SCRIPT_DIR/lib/watch-pid.sh"
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$PROJECT_ROOT"

# Parsed only now, so the flag the caller passed outranks every project file.
parse_global_opts "$@"
shift "$GLOBAL_OPTS"
STATE_DIR="$(project_path "${STATE_DIR_FLAG:-${ORCH_STATE_DIR:-tmp}}")"
# Not configurable at all, and so resolved here rather than above the loader,
# which would let a settings [env] key rename the state file: the file name is
# the identity every caller and doc reference resolves, so renaming it would
# hide the state from readers that compose the path themselves.
STATE_PREFIX="workflow-state"

# Main dispatch. The help case above answered an absent or empty subcommand,
# so $1 is set and non-empty here.
case "$1" in
    init)      shift; cmd_init "$@" ;;
    get)       shift; cmd_get "$@" ;;
    update)    shift; cmd_update "$@" ;;
    update-report) shift; cmd_update_report "$@" ;;
    post-pr-stop) shift; cmd_post_pr_stop "$@" ;;
    head-budget) shift; cmd_head_budget "$@" ;;
    append)    shift; cmd_append "$@" ;;
    append-file) shift; cmd_append_file "$@" ;;
    cap)       shift; cmd_cap "$@" ;;
    increment) shift; cmd_increment "$@" ;;
    set)       shift; cmd_set "$@" ;;
    set-git-head) shift; cmd_set_git_head "$@" ;;
    set-now)   shift; cmd_set_now "$@" ;;
    new-round-id) shift; cmd_new_round_id "$@" ;;
    new-local-key) shift; cmd_new_local_key "$@" ;;
    path)      shift; cmd_path "$@" ;;
    exists)    shift; cmd_exists "$@" ;;
    handoff-standing) shift; cmd_handoff_standing "$@" ;;
    fleet-log) shift; cmd_fleet_log "$@" ;;
    progress-report-path) shift; cmd_progress_report_path "$@" ;;
    prune)     shift; cmd_prune "$@" ;;
    remove)    shift; cmd_remove "$@" ;;
    *) state_message unknown-command "$@" >&2; cmd_help >&2; exit 1 ;;
esac
