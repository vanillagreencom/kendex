#!/usr/bin/env bash
# worktree-claim verifies that an issue owns a worktree session lease. It
# claims an unleased tree and refreshes an existing lease for the same issue.
#
# Usage:
#   worktree-claim --worktree PATH --issue ID
#
# Stdout is the issue ID, one line. Exit 75 means another owner or a native
# lock holds the worktree. Other failures exit 1.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GUARD="${WORKTREE_SESSION_GUARD:-$SCRIPT_DIR/../../worktree/scripts/worktree-session-guard}"

usage() {
	awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
}

fail() {
	printf 'worktree-claim: %s\n' "$1" >&2
	exit 1
}

worktree=''
issue=''
while [[ $# -gt 0 ]]; do
	case "$1" in
	--worktree) [[ $# -ge 2 ]] || fail '--worktree requires a path'; worktree="$2"; shift 2 ;;
	--issue) [[ $# -ge 2 ]] || fail '--issue requires an issue id'; issue="$2"; shift 2 ;;
	-h | --help) usage; exit 0 ;;
	*) fail "unknown option: $1" ;;
	esac
done

[[ -n "$worktree" ]] || fail '--worktree is required'
[[ -n "$issue" ]] || fail '--issue is required'
[[ -x "$GUARD" ]] || fail "worktree-session-guard is not executable at $GUARD"
worktree_abs="$(cd -P -- "$worktree" 2>/dev/null && pwd -P)" || fail "not a directory: $worktree"

# `claim` already refreshes an existing lease of the same owner and refuses a
# foreign one, so this delegates once rather than probing first: a probe and a
# separate mutation open a window in which the answer changes between them.
rc=0
(cd "$worktree_abs" && "$GUARD" claim "$worktree_abs" --owner "$issue") || rc=$?
[[ "$rc" == 0 || "$rc" == 75 ]] \
	|| fail "worktree-session-guard claim failed on $worktree_abs (exit $rc)"
exit "$rc"
