#!/usr/bin/env bash
# Reusable provider stub. Credential bytes stay in the put file, never the log.
#
# LANE_HOST_STUB_LIB names the orch script library `append` runs, the way the
# real provider takes the remote clone's path as an argument; a copy of this
# file installed beside a `scripts/lib` needs no such variable.
set -euo pipefail
STUB_LIB="${LANE_HOST_STUB_LIB:-}"
if [ -z "$STUB_LIB" ]; then
  STUB_LIB="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/../../scripts/lib" 2>/dev/null && pwd -P)" || STUB_LIB=""
fi
printf '%q ' "$@" >> "$LANE_HOST_STUB_LOG"
printf '\n' >> "$LANE_HOST_STUB_LOG"
if [[ "${LANE_HOST_STUB_STATUS:-0}" -ne 0 ]]; then
  exit "$LANE_HOST_STUB_STATUS"
fi
# One verb at a time, for a caller telling a failed read from a failed host:
# _CAT_STATUS fails cat alone (for _CAT_ITEM or the exact _CAT_PATH when set),
# and _CAT_STATE adds the provider's lane-stopped line. _TOUCH_STATUS fails the probe.
# _CLOSE_STATUS fails close with the static provider's close-refused line (for
# _CLOSE_ITEM alone when set). _PUT_DELAY holds put open long enough for a second caller to race
# the first, and _NO_APPEND is a provider predating the verb, which the case
# below refuses. _NO_ACCOUNTS is a provider that does not implement the OPTIONAL
# accounts verb, answering exit 2 with its own line, and _ACCOUNTS_STATUS is one
# that implements the verb and fails it, which is the other case entirely.
# _APPEND_DELAY holds append at its write, further down.
case "$1" in
  close) [[ "${LANE_HOST_STUB_CLOSE_STATUS:-0}" -eq 0 || "${LANE_HOST_STUB_CLOSE_ITEM:-$3}" != "$3" ]] \
    || { printf 'lane-host-ssh: close-refused path=/srv/clone\n' >&2; exit "$LANE_HOST_STUB_CLOSE_STATUS"; } ;;
  cat)
    if [[ "${LANE_HOST_STUB_CAT_STATUS:-0}" -ne 0 \
       && "${LANE_HOST_STUB_CAT_ITEM:-$3}" == "$3" \
       && "${LANE_HOST_STUB_CAT_PATH:-$4}" == "$4" ]]; then
      [[ -z "${LANE_HOST_STUB_CAT_STATE:-}" ]] \
        || printf 'lane-stopped item=%s state=%s verb=cat\n' "$3" "$LANE_HOST_STUB_CAT_STATE" >&2
      exit "$LANE_HOST_STUB_CAT_STATUS"
    fi ;;
  touch) [[ "${LANE_HOST_STUB_TOUCH_STATUS:-0}" -eq 0 ]] || exit "$LANE_HOST_STUB_TOUCH_STATUS" ;;
  put) [[ -z "${LANE_HOST_STUB_PUT_DELAY:-}" ]] || sleep "$LANE_HOST_STUB_PUT_DELAY" ;;
  append)
    [[ -z "${LANE_HOST_STUB_NO_APPEND:-}" ]] || { printf 'lane-host-fixture: verb-invalid verb=append\n' >&2; exit 2; } ;;
  accounts)
    [[ -z "${LANE_HOST_STUB_NO_ACCOUNTS:-}" ]] || { printf 'lane-host-fixture: verb-invalid verb=accounts\n' >&2; exit 2; }
    [[ "${LANE_HOST_STUB_ACCOUNTS_STATUS:-0}" -eq 0 ]] \
      || { printf 'lane-host-fixture: accounts-failed\n' >&2; exit "$LANE_HOST_STUB_ACCOUNTS_STATUS"; } ;;
esac
# lane-host-ssh's mailbox guard, run first by cat, put and append: a path under
# tmp/lane-mail/ whose tmp/lane-mail or item directory, or the file itself, is
# a symlink or not the kind it names exits 3.
mailbox_guard() { # PATH
  local mail rest component kind
  case "$1" in */tmp/lane-mail/*) ;; *) return 0 ;; esac
  mail="${1%/tmp/lane-mail/*}/tmp/lane-mail"
  rest="${1##*/tmp/lane-mail/}"
  for component in "$mail" "$mail/${rest%%/*}" "$1"; do
    kind=-d
    [ "$component" != "$1" ] || kind=-f
    if [ -L "$component" ] || { [ -e "$component" ] && ! test "$kind" "$component"; }; then
      printf 'lane-host-fixture: mailbox-component path=%s\n' "$component" >&2
      exit 3
    fi
  done
}
case "$1" in
  # LANE_HOST_STUB_CREATE_LINE replaces the create line, for a caller refusing
  # one that lacks a field.
  create)
    if [[ -n "${LANE_HOST_STUB_CREATE_LINE:-}" ]]; then printf '%s\n' "$LANE_HOST_STUB_CREATE_LINE"
    else printf 'ssh-target=lane.example\tpath=/srv/lane\tremote-prefix=exec bash -lc\n'; fi ;;
  # LANE_HOST_STUB_DIR models a whole remote filesystem: `cat`, `put` and
  # `append` read and write the remote path under it, so a caller that moves
  # several files —
  # a lane mailbox is two — is not held to one. Without it the single
  # LANE_HOST_STUB_FILE answers, as it always has. A path that is not there
  # exits 1, which is what the remote `cat` does.
  # A path that is not there exits 2, the protocol's one reading of "the lane
  # has not written this yet"; anything else keeps its own status.
  cat)
    src="${LANE_HOST_STUB_FILE:-}"
    [ -z "${LANE_HOST_STUB_DIR:-}" ] || src="$LANE_HOST_STUB_DIR$4"
    mailbox_guard "$src"
    [ -e "$src" ] || exit 2
    cat -- "$src" ;;
  # Staged beside the target and renamed, as the protocol requires, so a put
  # that dies leaves the previous file standing.
  put)
    dest="${LANE_HOST_STUB_FILE:-}"
    [ -z "${LANE_HOST_STUB_DIR:-}" ] || dest="$LANE_HOST_STUB_DIR$4"
    mailbox_guard "$dest"
    mkdir -p -- "$(dirname -- "$dest")"
    staged="$(mktemp -- "$dest.kendex-put.XXXXXX")"
    cat > "$staged"
    mv -f -- "$staged" "$dest" ;;
  # The protocol's append: the line is added under a lock taken HERE, on the
  # disk that holds the file, which is what a sender's own lock can never be.
  # The lock and the termination rule are the package's own library, the one
  # the real provider runs, so the fixture models a provider rather than
  # restating either. LANE_HOST_STUB_APPEND_FAIL is a transfer that dies: part
  # of the stream arrives and nothing reaches the file.
  append)
    if [ -z "$STUB_LIB" ] || [ ! -r "$STUB_LIB/mailbox-append.sh" ]; then
      printf 'lane-host-fixture: lock-lib-missing dir=%s\n' "${STUB_LIB:-<unset>}" >&2
      exit 1
    fi
    . "$STUB_LIB/file-lock.sh"
    . "$STUB_LIB/mailbox-append.sh"
    dest="${LANE_HOST_STUB_FILE:-}"
    [ -z "${LANE_HOST_STUB_DIR:-}" ] || dest="$LANE_HOST_STUB_DIR$4"
    mailbox_guard "$dest"
    mkdir -p -- "$(dirname -- "$dest")"
    landing="$(mktemp -- "$dest.kendex-append.XXXXXX")"
    if [ -n "${LANE_HOST_STUB_APPEND_FAIL:-}" ]; then
      head -c 10 > "$landing"
      rm -f -- "${landing:?}"
      exit 1
    fi
    cat > "$landing"
    # Held here, with the bytes staged and nothing left but the write, so two
    # callers reach the append together. Held before the staging instead, each
    # caller's own copy of the payload is skew enough that one append finishes
    # before the other starts, and no lock is ever contended.
    [ -z "${LANE_HOST_STUB_APPEND_DELAY:-}" ] || sleep "$LANE_HOST_STUB_APPEND_DELAY"
    appended=0
    mailbox_append_locked "$dest" 30 < "$landing" || appended=$?
    rm -f -- "${landing:?}"
    if [ "$appended" -ne 0 ]; then
      case "$appended" in 3) why=lock-timeout ;; *) why=write-failed ;; esac
      printf 'lane-host-fixture: append-failed path=%s reason=%s\n' "$dest" "$why" >&2
      exit 1
    fi ;;
  touch) ;;
  stop|exec) ;;
  # LANE_HOST_STUB_CLOSE_EMPTY is a close that archived nothing: no kept= line.
  # LANE_HOST_STUB_CLOSE_JAM makes the watch's state directory unwritable once
  # the close has run, so the watch's next row commit fails.
  close)
    [[ -n "${LANE_HOST_STUB_CLOSE_EMPTY:-}" ]] \
      || printf 'kept=%s\n' "${LANE_HOST_STUB_ARCHIVE:-/fleet/archive/repo/TEST-1/tmp-stub.tgz}"
    [[ -z "${LANE_HOST_STUB_CLOSE_JAM:-}" ]] || chmod 555 "$OVERSEE_WATCH_STATE_DIR"
    printf 'delete --item %s\n' "$3" >> "$LANE_HOST_STUB_LOG"
    ;;
  list) printf 'owner/repo/TEST-1\thosted\t-\tlane.example\n' ;;
  # LANE_HOST_STUB_ACCOUNTS names a FILE holding the whole answer verbatim, so
  # a caller writes the protocol's own tabs rather than a spelling this stub
  # would have to translate. Unset, the provider holds no credential at all,
  # which is what a caller asserting the empty answer needs.
  accounts)
    [ -z "${LANE_HOST_STUB_ACCOUNTS:-}" ] || cat -- "$LANE_HOST_STUB_ACCOUNTS" ;;
  *) exit 2 ;;
esac
