[env]

# The files preflight treats as special cases when it scans the project.

# The .json files allowed to hold comments, separated by spaces. A file
# matching one of these skips the strict JSON parse. A value replaces the
# list shown here. A leading **/ matches at any folder depth.
PREFLIGHT_JSONC_GLOBS = "**/tsconfig*.json **/jsconfig*.json **/.vscode/*.json **/.devcontainer/*.json **/*-color-theme.json"

# The database migrations that must never change once written, separated by
# spaces. Preflight reports any edit to one. A value replaces the list shown
# here.
PREFLIGHT_MIGRATION_GLOBS = "**/migrations/V*__*.sql **/db/migration/V*__*.sql"
