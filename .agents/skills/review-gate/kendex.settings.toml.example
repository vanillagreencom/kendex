[env]

# REVIEW GATE — shared merge-gate engine (review-gate skill). Nothing below
# is marked `# required`, so installing this skill writes nothing into
# <project>/kendex.settings.toml. What an install writes, and when, is
# kendex's docs/authoring/settings.md. Keys resolve env > .env.local >
# .kendex/settings.toml > this file > built-in default (REVIEW_GATE_MODE
# reads only env and this committed file); list values pack into one string
# with ';' separators. Full reference: review-gate SKILL.md,
# references/settings.md, and references/adoption.md.

# Commit-status context the gate posts — the required check name in branch
# protection. Keep it stable: changing it strands the old required context
# on open PRs.
REVIEW_GATE_CONTEXT = "Review gate"

# Check/status names whose success on the current head counts as review
# evidence (for bots that only file a review object when they have
# findings). SECURITY: matched by NAME and anyone can publish under any
# name — list only trusted bots' checks. github-actions-published check-runs
# are rejected automatically. Empty = source disabled.
REVIEW_GATE_TRUSTED_STATUS_CONTEXTS = ""

# A trusted "pass" whose output contains one of these substrings never ran
# (e.g. "Review rate limited") and is NOT-EVIDENCE. Empty disables.
REVIEW_GATE_CHECKRUN_SKIP_PATTERNS = "rate limited;skipped;queued"

# 'login:binding-pattern' pairs for bots whose clean pass is only an issue
# comment binding a commit sha (e.g. "bot[bot]:Reviewed commit:").
# SECURITY: trust keys on the author LOGIN. Empty disables.
REVIEW_GATE_COMMENT_REVIEWERS = ""

# Shortest sha prefix (4–40) either binding reader accepts: a comment-form
# reviewer binding evidence, and the PR author binding a suppressed-finding
# disposition comment with `Dispositions at <sha>`.
REVIEW_GATE_SHA_PREFIX_FLOOR = "7"

# MANUAL operator override status — posted by a human, never automation.
# Substitutes for MISSING evidence only; the description must carry a
# reason (enforced). SECURITY: same trusted-publisher model as the
# contexts above.
# Empty disables.
REVIEW_GATE_OVERRIDE_CONTEXT = "kendex-reviewer-outage"

# Creator logins whose commit statuses are never evidence. SECURITY:
# wherever PR workflows hold statuses:write, PR content can mint statuses
# through github-actions[bot] — list it; the override must then come from a
# non-Actions identity. Empty disables.
REVIEW_GATE_STATUS_PUBLISHER_REJECT = ""

# Logins whose review objects at the exact head count as evidence. Empty =
# any non-author — on repos with outside collaborators, set the list so a
# drive-by review cannot satisfy the gate.
REVIEW_GATE_REVIEW_OBJECT_TRUSTED_LOGINS = ""

# "any", or "approved" (an APPROVED at head not withdrawn by a later
# CHANGES_REQUESTED from the same login).
REVIEW_GATE_REVIEW_OBJECT_MIN_STATE = "any"

# Substrings marking a review row's body as the reviewer's own errored-run
# attestation — such a row is NOT-EVIDENCE, never a blocker, never carried.
# Matched at the start of the body only (first line); a review quoting a
# pattern in later text stays evidence. Empty disables.
REVIEW_GATE_REVIEW_OBJECT_ERROR_PATTERNS = "encountered an error and was unable to review"

# "enforce" fails closed on unresolved threads CI-side; "off" only where a
# server-side zero-bypass ruleset already enforces thread hygiene. Evidence
# and changes-requested still fail closed either way.
REVIEW_GATE_THREADS = "enforce"

# Bounded attempts per predicate evidence read. A read failing every attempt
# is still exit 2 (no verdict).
REVIEW_GATE_API_ATTEMPTS = "1"
# Seconds between those attempts.
REVIEW_GATE_API_RETRY_DELAY_SECONDS = "2"

# One pull request's share of the writer's converge step, which covers every
# open pull request in one pass. Past it that pull request's evaluation is its
# own convergence failure and the pass moves on, leaving its status for the
# next one. Size it under the step's own timeout-minutes divided by the pull
# requests a pass expects; a repository that widens that step widens this.
REVIEW_GATE_PR_DEADLINE_SECONDS = "120"

# Evidence carry-forward across carry-safe deltas ("docs", "comments",
# "vendored"; empty = off): ancestor evidence extends to head when the delta
# is entirely carry-safe. "vendored" carries every file under a path
# REVIEW_GATE_VENDORED_PATHS names, whatever its extension. Never a waiver —
# code changes outside the classes always need fresh evidence, and
# changes-requested / threads still fail closed. CAVEAT: "comments" is
# line-lexical and cannot see heredocs; "docs" has no such caveat.
REVIEW_GATE_CARRY_FORWARD = ""

# The kendex render trees "vendored" trusts as kendex output, e.g.
# ".agents/*;.claude/skills/*" — bytes under them carry unreviewed, so hook
# scripts and instruction markdown belong in the exclusion list, which wins.
# A rename carries only when both its names are under the set. Config
# errors: enabling "vendored" over an empty set, or an entry naming no
# literal path text ("*", "*/*").
REVIEW_GATE_VENDORED_PATHS = ""

# Path globs that force fresh review for policy-bearing markdown obeyed
# mechanically (e.g. "*AGENTS.md;.github/*"). They disqualify both
# carry-forward and the docs-only waiver.
REVIEW_GATE_CARRY_FORWARD_EXCLUDE = ""
# Exclusion globs DECLARED to match no tracked path yet, so the selftest
# accepts them; a declaration not in the exclude list is an orphan and
# fails the selftest.
REVIEW_GATE_CARRY_FORWARD_EXCLUDE_PROPHYLACTIC = ""

# How much review each size of change needs before it can merge. Generated
# files, trivial and micro changes need no review; a small change needs one
# bot review round; a standard change keeps the full review gate. Every
# repository runs this same value unless a decision record says otherwise.
# To use other rows, or "" to turn it off, also set
# REVIEW_GATE_CLASS_POLICY_DECISION. With REVIEW_GATE_MODE = "off", assign
# this key to accept the bot round on small changes.
REVIEW_GATE_CLASS_POLICY = "render:none;trivial:none;micro:none;small:bot;standard:current"

# The decision record behind a class policy other than the default, as a
# path from the repository root. The configuration check refuses such a
# policy without it, and refuses a path the repository does not track.
REVIEW_GATE_CLASS_POLICY_DECISION = ""

# "bot" requires normal review evidence for a docs-only diff. "none" lets
# harness-ci's shared docs classifier substitute for missing evidence.
# Objections, suppressed findings, and unresolved threads still block. Used
# only when the class policy is off.
REVIEW_GATE_DOCS_ONLY = "bot"

# The render-only lane: the harness render trees this repo commits as
# kendex output, e.g. ".agents/*;.claude/*;AGENTS.md;kendex.lock.json". A
# PR whose ENTIRE diff sits under the set is approved with no review
# evidence; CI still decides the merge. Any file outside the set, or a diff
# that cannot be enumerated, takes the normal gate path. Not a carry class:
# the exclusion list does not apply, so list no policy-bearing path here.
# Empty disables the lane. Used only when the class policy is off.
REVIEW_GATE_RENDER_PATHS = ""

# "off" disables an inactive or "current" class policy before evidence
# reads. A "bot" class still requires its review round. Unknown values are a
# loud config error.
REVIEW_GATE_MODE = "enforce"

# Review-wait quiet period in seconds — SHARED with orch's approval-wait,
# and pr-watch.sh's awaiting-stale threshold. Set it HERE, in .env.local,
# or export it; a .env file is read by nothing. Must be a
# non-negative integer (at most 9 digits); anything else fails loud.
PR_REVIEW_WAIT_SECS = "900"
