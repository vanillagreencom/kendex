[env]

# What counts as a review before a pull request is allowed to merge.

# The name this gate posts its verdict under, and the name branch protection
# asks for. Keep it stable: changing it leaves open pull requests waiting on
# a name nothing posts any more.
REVIEW_GATE_CONTEXT = "Review gate"

# Check names whose success counts as a review, for bots that report only
# when they find something. Anyone can publish under any name, so list only
# checks you trust. Empty means no check counts on its own.
REVIEW_GATE_TRUSTED_STATUS_CONTEXTS = ""

# Words that mark a passing check as one that never actually ran, such as a
# review that was rate limited. A pass carrying one is not a review.
# Separate them with semicolons. Empty turns the rule off.
REVIEW_GATE_CHECKRUN_SKIP_PATTERNS = "rate limited;skipped;queued"

# Bots whose clean verdict arrives as a comment rather than a review,
# written as login:phrase pairs. Trust is keyed on the login. Empty means no
# comment counts as a review.
REVIEW_GATE_COMMENT_REVIEWERS = ""

# The fewest characters of a commit id this gate accepts wherever a comment
# names the commit it refers to. Between 4 and 40. A shorter id is easier to
# match by accident.
REVIEW_GATE_SHA_PREFIX_FLOOR = "7"

# The name a person posts under to let a pull request through while the
# review bot is down. It stands in for a missing review only, it must carry
# a reason, and automation must never post it. Empty removes the override.
REVIEW_GATE_OVERRIDE_CONTEXT = "kendex-reviewer-outage"

# Accounts whose posted checks never count as a review. Where workflows may
# post checks, the contents of a pull request can mint its own approval, so
# name the automation account. Empty trusts every publisher.
REVIEW_GATE_STATUS_PUBLISHER_REJECT = ""

# The people whose review of the current commit counts. Empty accepts anyone
# but the author. On a project open to outside contributors, name the
# reviewers so a passer-by cannot satisfy the gate.
REVIEW_GATE_REVIEW_OBJECT_TRUSTED_LOGINS = ""

# How strong a review has to be. "any" accepts any review of the current
# commit. "approved" needs an approval that a later change request from the
# same person has not withdrawn.
# values: any | approved
REVIEW_GATE_REVIEW_OBJECT_MIN_STATE = "any"

# Words that mark a review as the reviewer reporting its own failure. Such a
# review neither counts nor blocks. Only the opening of the review is
# matched. Separate them with semicolons; empty turns the rule off.
REVIEW_GATE_REVIEW_OBJECT_ERROR_PATTERNS = "encountered an error and was unable to review"

# Whether unresolved review comments block a merge. "enforce" blocks until
# every thread is resolved. "off" is only for a project where GitHub itself
# already requires that, and it changes nothing else about this gate.
# values: enforce | off
REVIEW_GATE_THREADS = "enforce"

# How many tries this gate gives one read from GitHub, counting the first.
# At least 1, and 1 means a single try with no retry. A read that fails
# every try leaves the gate with no verdict, never with a pass.
REVIEW_GATE_API_ATTEMPTS = "1"

# Seconds between those tries.
REVIEW_GATE_API_RETRY_DELAY_SECONDS = "2"

# Which later changes an earlier review still covers: docs, comments and
# vendored, separated by semicolons. It applies only where the whole change
# is of those kinds; anything else still needs a fresh review, as do
# requested changes and open threads. Empty turns it off.
REVIEW_GATE_CARRY_FORWARD = ""

# Path patterns naming the generated output the vendored kind above trusts,
# separated by semicolons, such as .agents/* to cover a folder's contents.
# Everything matching carries an earlier review, so keep hook scripts and
# instruction documents out of the set and in the exclusion list below.
REVIEW_GATE_VENDORED_PATHS = ""

# Documents that always need a fresh review, even where the change would
# otherwise be carried or waived as docs-only. Path patterns separated by
# semicolons. Use it for the instruction files people and agents follow to
# the letter.
REVIEW_GATE_CARRY_FORWARD_EXCLUDE = ""

# Patterns from the list above that match no file in this project yet.
# Naming them here keeps the self-check quiet about a rule written ahead of
# the files it guards.
REVIEW_GATE_CARRY_FORWARD_EXCLUDE_PROPHYLACTIC = ""

# Whether a documentation-only change still needs a review. "bot" asks for
# one as usual. "none" lets a shared classifier stand in for a missing
# review. Requested changes and open threads block either way.
# values: bot | none
REVIEW_GATE_DOCS_ONLY = "bot"

# Path patterns naming the files kendex generates, separated by semicolons,
# such as .agents/* to cover a folder's contents. A pull request matching
# them entirely is approved with no review, and the build still decides the
# merge. Name no document that carries policy.
REVIEW_GATE_RENDER_PATHS = ""

# The one switch that turns this gate off. "enforce" is the full gate. "off"
# reports approved before reading any evidence, leaving the merge to the
# build alone. A misspelt value is refused loudly. It reads only your shell
# and this committed file, so no private or machine-local file can set it.
# values: enforce | off
REVIEW_GATE_MODE = "enforce"

# Seconds to wait for a review before the waiting step gives up. Whole
# seconds only, at most nine digits; anything else fails loudly. The
# orchestration package reads the same number.
PR_REVIEW_WAIT_SECS = "900"
