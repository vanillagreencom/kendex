[env]

# Which outside models review a change, and how each one is run.

# The reviewers to try, best first, separated by spaces or commas. The
# claude, codex, pi-copilot and pi-copilot-gpt names have built-in commands;
# any other name needs one below. A review goes to the first name that is
# installed, has room and is not the model running this session. This is
# also the execution fallback order: a nonzero exit, timeout or recognized
# quota/rate-limit refusal tries the next name. A refusal on stderr counts
# only when stdout holds no usable review answer. Each attempt reports its
# name, cause and seconds. pi-copilot and pi-copilot-gpt, Pi on the Copilot
# pool running Claude Opus and GPT, are the fallbacks for claude and codex.
SECOND_OPINION_MODELS = "claude codex pi-copilot pi-copilot-gpt"

# The most opinions one review collects. 2 or more sends the same change to
# that many different models. With fewer eligible models, the review runs on
# those it has and reports reduced coverage.
SECOND_OPINION_COUNT = "1"

# The model running this session, so a review never asks it to judge its own
# work. It is needed only where that cannot be detected. Set it in the
# session itself: a value in this file describes no single session and is
# refused.
# SECOND_OPINION_CURRENT_MODEL = "claude"

# The commands that run the claude and codex reviewers. Unset, each runs its
# built-in command on kendex's standard model (`second-opinion --help` prints
# both). A command set here replaces that model and the built-in room check
# below, so name its room check beside it.
# SECOND_OPINION_CLAUDE_CMD = "claude -p --output-format json --no-session-persistence --model claude-opus-5-5 --effort high --restricted --permission-mode dontAsk --tools Bash,Read,Glob,Grep --allowedTools Bash(read-only:true),Read,Glob,Grep --setting-sources="
# SECOND_OPINION_CODEX_CMD = "codex exec -m gpt-6.2-sol -s read-only -c model_reasoning_effort=xhigh --disable hooks --ephemeral"

# A copilot entry has no built-in command: Copilot CLI documents no read-only
# headless mode, so name a command you have checked cannot write. Its model
# is the identity; unset, copilot is skipped.
# SECOND_OPINION_COPILOT_CMD = "..."
# SECOND_OPINION_COPILOT_MODEL = "gpt-5.5"

# How to add another reviewer: name it in the list above, give it a command,
# and say which model that command reaches. Its settings are this family,
# NAME being its name as `second-opinion --help` spells it in one:
# keys: SECOND_OPINION_<NAME>_CMD SECOND_OPINION_<NAME>_MODEL SECOND_OPINION_<NAME>_ROOM_CMD SECOND_OPINION_<NAME>_INLINE_DIFF
# Use {model} in a custom _CMD or _ROOM_CMD to insert the target's raw _MODEL
# value. Commands without {model} keep their configured arguments.
# SECOND_OPINION_PI_DEEPSEEK_CMD = "pi -p --no-session --no-extensions --model deepseek/deepseek-v4-pro --tools read,grep,find,ls"
# SECOND_OPINION_PI_DEEPSEEK_MODEL = "deepseek"

# A reviewer can be checked for room on the account it spends before it is
# asked. The check exits 0 when there is room and prints the account's
# NAME=value env prefix, which the reviewer then runs under; any other exit
# skips the reviewer for the next one. The agent-runtime skill's account
# judge, `agent-runtime accounts pick --env`, is that check; where orch is
# installed in the project it counts the lanes running on each account.
# The built-in entries come with that check, run from
# .agents/skills/agent-runtime in the project this skill is installed in
# (`second-opinion --help` prints each): claude and codex where orch is
# installed in the project and AGENT_RUNTIME_ACCOUNT_DIRS names accounts, so
# each review runs on one of those accounts with room; pi-copilot and
# pi-copilot-gpt always, with their command, model and inline diff. An entry
# whose check refuses, as the claude or codex check does where that key names
# no account of its harness, or finds agent-runtime not installed or not
# built, is skipped for the next one. Without orch, or with that key unset or
# empty, claude and codex have no check and run on the account they inherit;
# in a global install, which has no project, neither have they, and the
# Copilot entries are skipped. Setting an entry's _CMD replaces its built-in
# model and check; setting its _ROOM_CMD empty drops the check. Each target
# remains subject to session-model exclusion.
# The Copilot check reads AGENT_RUNTIME_COPILOT_POOL from the settings in the
# lane's own tree; a hosted lane states it in .env.local until its provider
# forwards it, and one without it records the check's refusal. The judge reads
# this machine's own login, the one the reviewer runs on, never a lane-host
# provider's copy.

# A reviewer that cannot run git, such as Pi on read-only file tools, is sent
# the change itself: set to 1, its review prompt carries the diff, up to the cap
# `second-opinion --help` names.
# SECOND_OPINION_PI_DEEPSEEK_INLINE_DIFF = "1"

# Seconds to wait for a reviewer to answer before giving up on it.
SECOND_OPINION_TIMEOUT = "1080"

# Where review records are written when no output file is named. A folder
# created here is set to stay out of git; one that already exists is left
# alone, so keep it out of git yourself.
SECOND_OPINION_ARTIFACT_DIR = "tmp/second-opinion"

# This project's own instruction files, added to the review prompt so the
# reviewer judges against this project's rules. Path patterns separated by
# spaces; one matching no file is reported and the review still runs. Empty
# sends the change with no project rules attached.
SECOND_OPINION_REVIEW_INSTRUCTIONS = "AGENTS.md review-bots.md .github/instructions/code-review.md .github/instructions/*.instructions.md .github/copilot-instructions.md"

# Always review with this one reviewer instead of working down the list. A
# reviewer running this session's own model is refused.
# SECOND_OPINION_TARGET = "claude"
