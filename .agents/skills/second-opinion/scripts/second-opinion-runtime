#!/usr/bin/env bash
set -euo pipefail
RUNTIME_SELF="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)/${BASH_SOURCE[0]##*/}"
die() { echo "second-opinion-runtime: $1" >&2; exit 1; }
runtime_dir_valid() {
  local dir="$1" token="$2" recorded
  [[ -d "$dir" && ! -L "$dir" ]] || return 1
  [[ -f "$dir/token" && ! -L "$dir/token" ]] || return 1
  recorded=$(cat < "$dir/token") || return 1
  [[ "$recorded" == "$token" ]]
}
validate_runtime_dir() {
  local dir="$1" token="$2"
  runtime_dir_valid "$dir" "$token" \
    || die "runtime directory or token is missing, unsafe, or changed: $dir"
}
second_opinion_runtime_setup() {
  TIMEOUT_CMD="$(command -v timeout || command -v gtimeout || true)"
  [[ -n "$TIMEOUT_CMD" ]] \
    || echo "Warning: no timeout or gtimeout on PATH — external CLI calls will run without a time limit" >&2
}
# --foreground keeps the CLI in THIS process group rather than a private one of
# timeout's making: the caller owns the lane's lifetime, so a signal sent to
# second-opinion's process group has to reach the CLI too. -k 30 follows an
# ignored TERM with a KILL instead of leaving the run hung past its deadline.
run_with_timeout() {
  local duration="$1" stderr_file="$2"
  shift 2
  if [[ -z "$TIMEOUT_CMD" ]]; then
    echo "→ cmd: direct $*" >&2
    "$@" 2>"$stderr_file"
    return
  fi
  echo "→ cmd: $TIMEOUT_CMD --foreground -k 30 ${duration}s $*" >&2
  "$TIMEOUT_CMD" --foreground -k 30 "$duration" "$@" 2>"$stderr_file"
}
create_runtime_dir() {
  local dir=""
  artifact_home
  if [[ -n "$ARTIFACT_HOME" ]]; then
    dir=$(mktemp -d "$ARTIFACT_HOME/runtime.XXXXXX" 2>/dev/null) || {
      artifact_home_unusable
      dir=""
    }
  fi
  [[ -n "$dir" ]] || dir=$(mktemp -d 2>/dev/null) || die "cannot create runtime directory"
  chmod 700 "$dir" || die "cannot secure runtime directory: $dir"
  printf '%s\n' "$dir"
}
# Detach the run and print the three protocol lines its consumers read:
# `artifact:`, `deadline:` (absolute epoch seconds) and a `wait:` command.
# Nothing watches the worker afterwards — it carries its own per-CLI timeout,
# and `wait` below owns the run's deadline.
launch() {
  local script="$1" artifact="$2" runtime_dir="$3" budget="$4" owned="$5"
  local wait_slice="$6"
  shift 6
  [[ "$budget" =~ ^[1-9][0-9]*$ ]] || die "budget must be positive"
  [[ "$owned" == true || "$owned" == false ]] || die "owned must be true or false"
  [[ "$wait_slice" =~ ^[1-9][0-9]*$ && $wait_slice -lt 600 ]] \
    || die "wait slice must be positive and below 600 seconds"
  local deadline token worker_pid log="$runtime_dir/worker.log"
  local detach=() worker_args
  token="$(date +%s).$$.$RANDOM"
  (umask 077 && set -C && printf '%s\n' "$token" > "$runtime_dir/token") \
    || die "cannot create runtime token: $runtime_dir/token"
  if [[ -n "${SECOND_OPINION_LAUNCH_MODEL:-}" ]]; then
    (umask 077 && set -C && printf '%s\n%s\n%s\n%s\n%s\n' "$token" \
      "$SECOND_OPINION_LAUNCH_MODEL" "${SECOND_OPINION_LAUNCH_SOURCE:-}" \
      "${SECOND_OPINION_LAUNCH_IN_CALLER_ENV:-false}" \
      "${SECOND_OPINION_LAUNCH_SESSION_SCOPED:-false}" > "$runtime_dir/identity") \
      || die "cannot create detached identity state"
  fi
  unset SECOND_OPINION_LAUNCH_MODEL SECOND_OPINION_LAUNCH_SOURCE \
    SECOND_OPINION_LAUNCH_IN_CALLER_ENV SECOND_OPINION_LAUNCH_SESSION_SCOPED
  # set -C: the log is created here or not at all. A symlink planted at this
  # path would otherwise redirect the whole run's output somewhere else.
  set -C
  : > "$log" || die "cannot create worker log: $log"
  set +C
  deadline=$(($(date +%s) + budget))
  worker_args=("$@" --detached-worker "--output=$artifact")
  $owned && worker_args+=(--scratch-output)
  # setsid gives the worker its own session, so a signal aimed at the caller's
  # process group does not take the detached run down with it. Stock macOS has
  # no setsid; there the worker is merely orphaned, which nohup and the closed
  # stdio already make survivable.
  command -v setsid >/dev/null 2>&1 && detach=(setsid)
  # The wrapper appends the exit marker AFTER the worker returns. That marker,
  # not the pid recorded below, is what `wait` reads as the run's result.
  env -u SECOND_OPINION_CURRENT_MODEL \
    SECOND_OPINION_RUNTIME_DIR="$runtime_dir" SECOND_OPINION_RUN_TOKEN="$token" \
    ${detach[@]+"${detach[@]}"} nohup bash -c '
      rc=0
      "$@" || rc=$?
      printf "__SECOND_OPINION_EXIT_%s__=%s\n" "$SECOND_OPINION_RUN_TOKEN" "$rc" >&2
      exit "$rc"
    ' second-opinion-worker "$script" "${worker_args[@]}" \
    < /dev/null > "$log" 2>&1 &
  worker_pid=$!
  (umask 077 && set -C && printf '%s\n' "$worker_pid" > "$runtime_dir/pid") \
    || die "cannot record detached worker pid: $runtime_dir/pid"
  printf 'artifact: %s\n' "$artifact"
  printf 'deadline: %s\n' "$deadline"
  printf 'wait:'
  printf ' %q' "$RUNTIME_SELF" wait "$artifact" "$runtime_dir" "$deadline" "$token" "$wait_slice"
  printf '\n'
}
second_opinion_detach_if_needed() {
  local artifact="$OUTPUT_PATH" owned=false attempts=1 budget runtime_dir
  if $DETACHED_WORKER || [[ "$MODE" == "detect" ]] \
      || { ! $FOREGROUND_CAP && ! $FOREGROUND_CAP_IN_CALLER_ENV; }; then return; fi
  [[ -x "$RUNTIME_SELF" ]] || die "runtime is missing: $RUNTIME_SELF"
  if [[ -z "$artifact" ]]; then
    artifact_file detached
    artifact="$ARTIFACT_PATH"
    owned=true
  elif [[ "$artifact" != /* ]]; then artifact="$(pwd)/$artifact"; fi
  [[ -n "$artifact" ]] || die "no writable artifact path for detached run"
  [[ "$artifact" != *$'\r'* && "$artifact" != *$'\n'* ]] || die "artifact path contains CR or LF"
  runtime_dir=$(create_runtime_dir)
  [[ "$MODE" == "review" || "$MODE" == "audit" ]] && attempts=2
  budget=$((attempts * (10#$TIMEOUT + 30) + 60))
  export SECOND_OPINION_LAUNCH_MODEL="$CURRENT_MODEL" \
    SECOND_OPINION_LAUNCH_SOURCE="$CURRENT_MODEL_SOURCE" \
    SECOND_OPINION_LAUNCH_IN_CALLER_ENV="$CURRENT_MODEL_IN_CALLER_ENV" \
    SECOND_OPINION_LAUNCH_SESSION_SCOPED="$CURRENT_MODEL_IS_SESSION_SCOPED"
  exec "$RUNTIME_SELF" launch "$SCRIPT_DIR/second-opinion" "$artifact" "$runtime_dir" \
    "$budget" "$owned" 300 "${ORIGINAL_ARGS[@]}"
}
completion_line() {
  local log="$1" prefix="$2" line="" match matches grep_rc=0
  matches=$(grep -F "$prefix" "$log") || grep_rc=$?
  [[ $grep_rc -le 1 ]] || return 2
  while IFS= read -r match; do line="$match"; done <<< "$matches"
  printf '%s' "$line"
}
worker_alive() { # PID — 0 = the recorded pid still names a live process
  [[ -n "$1" ]] || return 1
  kill -0 "$1" 2>/dev/null
}
# Stop a worker that outlived the run's deadline. The group form goes first so
# the CLI the worker started dies with it; a pid leading no group (no setsid on
# this host) falls back to the process itself.
stop_worker() { # PID
  local pid="$1" end
  worker_alive "$pid" || return 0
  kill -TERM -- "-$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  end=$(($(date +%s) + 5))
  while worker_alive "$pid"; do
    if [[ $(date +%s) -ge $end ]]; then
      kill -KILL -- "-$pid" 2>/dev/null || kill -KILL "$pid" 2>/dev/null || true
      break
    fi
    sleep 0.1
  done
}
wait_for_run() {
  local artifact="$1" runtime_dir="$2" deadline="$3" token="$4"
  local wait_slice="$5" log="$2/worker.log" pid_file="$2/pid"
  [[ "$deadline" =~ ^[1-9][0-9]*$ ]] || die "deadline must be a positive epoch"
  [[ "$token" =~ ^[A-Za-z0-9._-]+$ ]] || die "token is malformed"
  [[ "$wait_slice" =~ ^[1-9][0-9]*$ && $wait_slice -lt 600 ]] \
    || die "wait slice must be positive and below 600 seconds"
  validate_runtime_dir "$runtime_dir" "$token"
  local prefix="__SECOND_OPINION_EXIT_${token}__=" line status now grep_rc attempt_deadline
  local worker_pid=""
  if [[ -f "$pid_file" && ! -L "$pid_file" ]]; then
    worker_pid=$(cat < "$pid_file") || die "cannot read detached worker pid: $pid_file"
    [[ "$worker_pid" =~ ^[1-9][0-9]*$ ]] || die "detached worker pid is malformed"
  fi
  replay_log() {
    local replay_rc=0
    grep -vF "$prefix" "$log" >&2 || replay_rc=$?
    [[ $replay_rc -le 1 ]] || die "cannot replay worker log: $log"
  }
  now=$(date +%s)
  attempt_deadline=$((now + wait_slice))
  [[ $attempt_deadline -le $deadline ]] || attempt_deadline=$deadline
  while :; do
    # THE ORDER OF THESE TWO CHECKS IS THE CONTRACT, and it is not
    # interchangeable. The exit marker is the AUTHORITATIVE terminal signal:
    # the launch wrapper appends it once the worker returns, so it exists
    # exactly when there is a status to report. The pid is a LIVENESS HINT
    # only — pids are reused, so a live pid is never evidence that THIS run is
    # still going, and only its absence carries information. Read the marker
    # first on every poll; a dead pid with no marker is the non-terminal
    # failure (75, never a status), and re-reading the marker after seeing the
    # pid die closes the window between the marker write and the wrapper exit.
    grep_rc=0
    line=$(completion_line "$log" "$prefix") || grep_rc=$?
    [[ $grep_rc -ne 2 ]] || die "cannot read worker log: $log"
    if [[ -n "$line" ]]; then
      status="${line#"$prefix"}"
      [[ "$status" =~ ^[0-9]+$ && $status -le 255 ]] || die "worker status is malformed"
      replay_log
      rm -rf -- "$runtime_dir" || die "cannot remove runtime directory: $runtime_dir"
      if [[ $status -eq 0 && ! -s "$artifact" ]]; then
        echo "Error: detached run exited 0 without writing its artifact: $artifact" >&2
        exit 1
      fi
      [[ $status -eq 0 ]] && printf '%s\n' "$artifact"
      exit "$status"
    fi
    now=$(date +%s)
    if [[ $now -ge $deadline ]]; then
      stop_worker "$worker_pid"
      grep_rc=0
      line=$(completion_line "$log" "$prefix") || grep_rc=$?
      [[ $grep_rc -ne 2 ]] || die "cannot read worker log: $log"
      [[ -z "$line" ]] || continue
      replay_log
      rm -rf -- "$runtime_dir" || die "cannot remove runtime directory: $runtime_dir"
      echo "Error: detached run reached its deadline $deadline" >&2
      exit 124
    fi
    if ! worker_alive "$worker_pid"; then
      grep_rc=0
      line=$(completion_line "$log" "$prefix") || grep_rc=$?
      [[ $grep_rc -ne 2 ]] || die "cannot read worker log: $log"
      [[ -z "$line" ]] || continue
      echo "second-opinion: the detached worker is gone and published no status; rerun the same wait command" >&2
      exit 75
    fi
    if [[ $now -ge $attempt_deadline ]]; then
      grep_rc=0
      line=$(completion_line "$log" "$prefix") || grep_rc=$?
      [[ $grep_rc -ne 2 ]] || die "cannot read worker log: $log"
      [[ -z "$line" ]] || continue
      echo "second-opinion: still running; rerun the same wait command" >&2
      exit 75
    fi
    sleep 1
  done
}
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  action="${1:-}"
  [[ -n "$action" ]] || die "action required"
  shift
  case "$action" in
    launch) [[ $# -ge 7 ]] || die "launch arguments are incomplete"; launch "$@" ;;
    wait) [[ $# -eq 5 ]] || die "wait arguments are incomplete"; wait_for_run "$@" ;;
    *) die "unknown action: $action" ;;
  esac
fi
