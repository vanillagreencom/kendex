#!/usr/bin/env bash
# slack: relay one checkout's overseer mailbox to one private Slack channel
# and back, by polling, reading and writing the mailbox through lane-mail.
#
# The relay is Python because it holds a JSON journal, an HTTP client and a
# poll loop, and it needs the standard library alone (3.8 or newer). This
# launcher does the two things Python should not: it loads the checkout's
# settings through the one kendex settings reader, and it names the orch
# install beside this package in SLACK_ORCH_DIR, which the relay reads the
# secret-value pattern from, so the relay itself never spells a machine's
# layout. Each root's mailbox is that root's own lane-mail.
set -euo pipefail

here="$(cd -- "$(dirname -- "$0")" && pwd -P)"
orch="$here/../../orch"
linear="$here/../../linear"

refuse() { # KEY=VALUE LINES...
  printf 'slack: %s\n' "$1" >&2
  shift
  printf '%s\n' "$@" >&2
  exit 2
}

if ! _slack_python="$(command -v python3)"; then
  refuse "python3=missing" "python3 is not on PATH; the relay needs Python 3.8 or newer"
fi
case "$_slack_python" in
  /*) ;;
  *) _slack_python="$PWD/$_slack_python" ;;
esac
_slack_code=("$_slack_python" -c)
_slack_script=("$_slack_python" -B)
if [ -n "${_KENDEX_JARVIS_PYTHON:-}" ]; then
  _slack_code=("$_KENDEX_JARVIS_PYTHON" caller-code "")
  _slack_script=("$_KENDEX_JARVIS_PYTHON" caller-script "$here/lib")
fi
if ! "${_slack_code[@]}" 'import sys; raise SystemExit(0 if sys.version_info >= (3, 8) else 1)'; then
  refuse "python3=$("${_slack_code[@]}" 'import sys; print("Python " + sys.version.split()[0])' 2>&1 | tr ' ' '-')" "needs Python 3.8 or newer"
fi
if [ ! -f "$orch/scripts/lib/kendex-env.sh" ] || [ ! -f "$orch/references/secret-value.ere" ]; then
  refuse "orch-missing=$orch" \
    "the orch skill is not installed beside this one; the relay reads its settings loader and its secret-value pattern from there"
fi

# The settings of the checkout the command runs in: the process environment
# first, then that checkout's private env file and settings files. Presence
# settings are root-local. Preserve the caller before this load so the root
# reader cannot mistake the launch checkout's exports for caller overrides.
if ! _slack_caller_env="$("${_slack_code[@]}" 'import json, os; print(json.dumps(dict(os.environ)))')"; then
  refuse "settings-unreadable=caller-environment" "the caller environment could not be saved"
fi
_slack_script+=("$here/lib/main.py")
# Target settings cannot replace the caller's interpreter, library, script
# or sibling packages. Bash refuses assignments to these native bindings.
readonly -a _slack_script
readonly orch linear _slack_caller_env
# shellcheck source=../../orch/scripts/lib/kendex-env.sh
source "$orch/scripts/lib/kendex-env.sh"
project="$(git rev-parse --show-toplevel 2>/dev/null || pwd -P)"
# The private env file is sourced as shell, so its plain `KEY=value` lines
# are shell variables; the relay reads os.environ, so they reach it only
# exported.
set -a
if ! kendex_load_project_env "$project"; then
  refuse "settings-unreadable=$project" "a settings file of this checkout could not be loaded; the lines above say which"
fi
set +a

export PYTHONDONTWRITEBYTECODE=1
SLACK_ORCH_DIR="$orch"
export SLACK_ORCH_DIR
SLACK_LINEAR_DIR="$linear"
export SLACK_LINEAR_DIR
# Internal transport, consumed and removed by settings.py, not a setting.
export _KENDEX_SLACK_CALLER_ENV="$_slack_caller_env"
exec "${_slack_script[@]}" "$@"
