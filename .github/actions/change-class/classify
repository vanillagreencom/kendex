#!/usr/bin/env bash
# classify — the shipped classifier's verdict for a diff, whether the diff
# runs a workflow's lanes, which individual lanes it runs, and the
# changed-path families a workflow selects its jobs with.
#
# Nothing here decides a class or a docs verdict. `change-class` prints one
# on stdout, and this script forwards it with its queue-only stderr record.
# `harness-only --mode docs` writes docs_only; this script adds the path
# families beside them, grouping the path list that docs-mode call
# prints, never a second reading of the diff. Taking the list from that call
# is what keeps the grouping on the shipped reader: `change-class` repeats the
# same paths on its stderr in a shell-quoted form whose only decoder is `eval`,
# and a path list out of the judged tree is not something to hand a shell.
#
# Environment, from the action's inputs, all required but BASE, CLASSIFIER,
# LANES_FROM and COVERS_ALL_LANES:
#   EVENT  github.event_name
#   BASE   the base endpoint sha; empty where the event carries none
#   HEAD   the head endpoint sha
#   REPO   the checkout to judge; on a pull request with a `:queue` lane to
#          defer, its HEAD commit is read for the harness-ci render, below
#   CLASSIFIER  the checkout root to read the shipped scripts from; empty
#          means this script's own tree
#   LANES_FROM  the checkout root whose .github/ci-lanes.conf declares the
#          workflow's base lanes and claims; never REPO.
#          Empty means no lane is declared.
#   COVERS_ALL_LANES  accepted and ignored: the retired proof reuse's
#          coverage assertion, which copies of the harness-ci template
#          still pass.
# Environment, from the runner:
#   GITHUB_OUTPUT  the step output file every writer appends to
#
# Outputs appended to GITHUB_OUTPUT:
#   change_class       render|trivial|micro|small|standard, forwarded from the
#                      shipped classifier's stdout
#   queue_only         true|false, forwarded from the shipped classifier:
#                      whether the change must run in a merge group before
#                      it lands, the value of its `queue-only:` line, whose
#                      statement is change-class's header. Absent where the
#                      classifier root predates the output, and where the
#                      step fails before change-class answers.
#   docs_only          true|false, written by the shipped `harness-only --mode
#                      docs` itself. It answers false where harness-only
#                      cannot read the diff (an unsupported event, a missing
#                      or unresolvable endpoint, an unreadable or empty diff).
#                      A wiring error from harness-only or from this script
#                      fails the step with exit 2 instead, and the failed
#                      step, not this output, is the answer.
#   changed_skills     blank-separated first path segments under skills/
#   changed_crates     blank-separated first path segments under crates/
#   changed_workflows  blank-separated first path segments under
#                      .github/workflows/
#   changed_paths      every changed path, one per line, as the shipped reader
#                      printed them. A family is a grouping of this list, so a
#                      caller whose lanes answer to a tree no family names
#                      groups it here rather than reading the diff again.
#   lanes              true|false: whether the diff runs a workflow's lanes.
#                      A proved render runs lanes whose default-branch claims
#                      match a deleted path or an added path when any old path
#                      disappears. This covers both rename ends. In-place and
#                      addition-only
#                      renders and moves of only unclaimed paths keep
#                      lanes=false. Remaining skip conditions follow
#                      skills/harness-ci/references/wiring.md
#                      § Per-lane verdicts.
#   lanes_cause        why: render, trivial, docs-only or queue-only where
#                      lanes=false; full-run on schedule and
#                      workflow_dispatch; render-moved-claim for a claimed
#                      moved-file candidate in a render;
#                      queue-only-reader-absent where a render lacks the
#                      stand-down's reader; lane-producer-unavailable when
#                      the classifier checkout lacks the installed producer;
#                      the class otherwise.
#   lane_verdicts      one `lane_<name>=true|false` line per default-branch
#                      lane, in base order, with head-only lanes appended in
#                      head order on a valid declaration comparison. This is
#                      the union of lane names. Empty where LANES_FROM is
#                      empty or the base declaration is absent or malformed.
#
# lanes uses the two verdicts above, moved render claims, the event and the
# queue_only answer, as the installed lib/change-class.sh decides them.
# A workflow forwards it rather than spelling a class, so a change to
# which diffs run the lanes reaches every consumer with no workflow edit.
#
# A lane verdict uses default-branch claims except for the declaration path,
# whose comparison follows wiring.md § Per-lane verdicts. In this order:
# true for every lane on the full run; false wherever lanes is false; then,
# on render, true only for lanes whose
# default-branch claim matches a deleted path or a possible added destination
# when any old path disappears, with
# cause=render-moved-claim and its path and glob; then true for every lane where the
# declaration comparison failed; then, on a pull request,
# false with the cause queue-deferred for a lane the declaration marks
# `:queue` and one of its own globs reaches, where this run's change-class
# answered queue_only=true and both renders below read the mark; then, for
# a lane marked `:nightly`, true only where its own glob or the declaration
# comparison selects it; then true
# for every lane where a changed non-declaration path no base lane claims
# lies outside the docs
# set or where no changed path was read; then true where a changed path
# matches one of the lane's base globs or the declaration comparison selects
# that lane, and false everywhere else. A deferred
# lane runs in the merge group. The deferral needs the queue_only
# answer as well as the lane's own glob, so no lane is deferred on a pull
# request change-class reads as free to take the admin merge.
#
# That answer is this run's. github.sh pr-merge asks it again at merge time
# through the harness-ci render beside the github.sh it runs, which is a
# checkout of one of two trees CI can see: the default branch, LANES_FROM,
# and the pull request's head, HEAD in REPO, which submit-pr's worktree
# holds. A render from before the mark answers queue_only=false for the
# lane's paths, so a lane is deferred only where both trees carry
# .agents/skills/harness-ci/scripts/lib/ci-lanes.sh, the render's reader of
# the mark. Either absent, the lane runs with cause=queue-reader-absent and
# a `tree=` naming which, and the step raises one warning. A head that
# deletes its reader only makes the lane run. A checkout that runs pr-merge
# behind both trees is outside what CI sees, and wiring.md holds it as an
# ordering rule. The whole-run stand-down on pull_request and push follows
# the same rule with its own reader: both trees must carry the render's
# change-class that reads HARNESS_CI_PER_PUSH_REASON, or the lanes run with
# lanes_cause=queue-only-reader-absent and one warning. A glob is a shell
# pattern, so `*` also matches `/`. The
# declaration's grammar and reader are the classifier's lib/ci-lanes.sh.
# The declaration is read from LANES_FROM, the default branch's copy, because
# the author of the diff under judgement could edit the tree's own copy to
# stand a lane down. For .github/ci-lanes.conf alone, compare that declaration
# with HEAD using ci_lanes_read. Select the union's lanes whose names, claim
# sets, queue marks or nightly marks changed. A declaration hit never defers a queue lane.
# Other paths use the default branch's claims only. A missing, unreadable or
# malformed copy keeps the all-lanes fallback.
# An absent or malformed default-branch declaration is not a refusal:
# the default branch holds it, so failing the step would redden every pull
# request, the one that repairs it included.
#
# Outputs reach the caller only after every read succeeded. A refusal leaves
# the caller's output file unchanged, and the failed step runs every lane.
#
# A segment is what the path holds, not what the caller hopes: `skills/AGENTS.md`
# puts `AGENTS.md` in changed_skills. Over-inclusion is the safe direction —
# an unrecognised member selects a lane rather than dropping one.
#
# Every refusal here starts `change-class-action: wiring-error: cause=<name>`
# and exits 2, so a caller gating a lane on the class sees a red step rather
# than an empty output. Reading an empty class as "nothing to run" is the
# fail-open that exit code closes.
set -euo pipefail

die() { # CAUSE MESSAGE
  printf 'change-class-action: wiring-error: cause=%s\n' "${1#cause=}" >&2
  printf 'change-class-action: %s\n' "$2" >&2
  exit 2
}

# Where the shipped scripts are read from. A caller that judges a tree whose
# author could edit the classifier names a separate checkout here; with none
# named it is this action's own tree, which a consumer referencing the action
# at a tag or branch gets from that same revision.
scripts_root="${CLASSIFIER:-}"
[ -n "$scripts_root" ] || scripts_root="$(dirname "$0")/../../.."
SCRIPTS="$(cd "$scripts_root/skills/harness-ci/scripts" 2>/dev/null && pwd)" ||
  die "classifier-unreadable root=$scripts_root" \
    "no skills/harness-ci/scripts under the classifier root"

[ -n "${EVENT:-}" ] || die missing-event "the event input is required"
[ -n "${HEAD:-}" ] || die missing-head "the head input is required"
[ -n "${REPO:-}" ] || die missing-repo "the repo input is required"
[ -n "${GITHUB_OUTPUT:-}" ] || die missing-output-file \
  "GITHUB_OUTPUT is unset, so no caller could read a verdict"

# shellcheck source=../../../skills/harness-ci/scripts/lib/change-class.sh
if [ ! -r "$SCRIPTS/lib/change-class.sh" ] || ! . "$SCRIPTS/lib/change-class.sh"; then
  die "lane-producer-unreadable root=$scripts_root" "the installed lane producer is unavailable"
fi
if [ -n "${LANES_FROM:-}" ]; then
  # shellcheck source=../../../skills/harness-ci/scripts/lib/ci-lanes.sh
  if [ ! -r "$SCRIPTS/lib/ci-lanes.sh" ] || ! . "$SCRIPTS/lib/ci-lanes.sh"; then
    die "lanes-reader-unreadable root=$scripts_root" "the lane declaration reader is unavailable"
  fi
fi

work="$(mktemp -d)" || die mktemp-failed "could not create a working directory"
trap 'rm -rf -- "${work:?}"' EXIT

# The wrapped classifiers also write outputs. Keep their answers private
# until every read below has succeeded.
step_output="$GITHUB_OUTPUT"
export GITHUB_OUTPUT="${work:?}/outputs"
: >"$GITHUB_OUTPUT"

args=(--event "$EVENT" --head "$HEAD" --repo "$REPO")
[ -z "${BASE:-}" ] || args=("${args[@]}" --base "$BASE")

# Only stdout and the queue record are needed here. The /dev/null output
# contract avoids a local lane decision before the declaration-aware call.
verdict="$("$SCRIPTS/change-class" "${args[@]}" --output /dev/null 2>"${work:?}/class-log")" || {
  status=$?
  cat -- "${work:?}/class-log" >&2
  die "classifier-failed status=$status" "change-class exited $status"
}
cat -- "${work:?}/class-log" >&2
case "$verdict" in
  change_class=render | change_class=trivial | change_class=micro | \
    change_class=small | change_class=standard) class="${verdict#change_class=}" ;;
  *) die "verdict-unreadable class-line=$verdict" \
    "the classifier printed no change_class line this action knows" ;;
esac
# The documented stderr record owns queue_only. A classifier predating it
# leaves the output absent, as it did before the action forwarded the record.
queue_only="$(sed -n 's/^queue-only: queue_only=\([^ ]*\).*/\1/p' "${work:?}/class-log")" ||
  die "queue-only-unreadable path=${work:?}/class-log" \
    "could not read the queue-only record change-class wrote"
printf 'change_class=%s\n' "$class" >>"$GITHUB_OUTPUT"
[ -z "$queue_only" ] || printf 'queue_only=%s\n' "$queue_only" >>"$GITHUB_OUTPUT"

# The docs verdict and the paths, from the reader that owns the diff range for
# every event. It appends `docs_only=` to GITHUB_OUTPUT on its own.
# The paths outside the docs set are asked for
# only where a lane is declared: a classifier checkout older than that flag
# still serves every caller that declares none.
docs_args=(--mode docs "${args[@]}" --paths-output "${work:?}/paths")
[ -z "${LANES_FROM:-}" ] ||
  docs_args=("${docs_args[@]}" --outside-output "${work:?}/outside")
docs="$("$SCRIPTS/harness-only" "${docs_args[@]}")" || {
  status=$?
  die "path-reader-failed status=$status" "harness-only exited $status"
}
case "$docs" in
  docs_only=true | docs_only=false) ;;
  *) die "docs-verdict-unreadable docs-line=$docs" \
    "harness-only printed no docs_only line" ;;
esac

# One family per directory level a caller gates on: the skill, the workspace
# member and the workflow file. A path outside all three joins no family, and
# a change carrying one is why `standard` exists. The read is assigned on its
# own line rather than inside the printf below: a substitution that died
# inside an argument list leaves printf's own zero status as the step's, and
# the output line is then written empty with nothing red.
family() { # NAME PREFIX DEPTH
  local name="$1" prefix="$2" depth="$3" listed
  listed="$(cut -d/ -f1-"$depth" <"${work:?}/paths" |
    sed -n "s%^$prefix/%%p" | sort -u | tr '\n' ' ')" ||
    die "family-read-failed prefix=$prefix" \
      "could not group the changed paths under '$prefix'"
  printf '%s=%s\n' "$name" "${listed% }" >>"$GITHUB_OUTPUT"
}

family changed_skills skills 2
family changed_crates crates 2
family changed_workflows .github/workflows 3

sed -n 's/^changed_/family: /p' <"$GITHUB_OUTPUT" >&2

# The whole list, for a caller whose lanes answer to a tree no family names.
# A multi-line output needs a delimiter no line of the value can be. The value
# is a path list the pull request's author writes, so a path spelling the
# delimiter would end the value early and write the lines after it as outputs
# of their own; that path is refused rather than escaped.
delimiter=__change_class_changed_paths_end__
if grep -qxF -- "$delimiter" "${work:?}/paths"; then
  die "delimiter-collides path=$delimiter" \
    "a changed path is exactly the heredoc delimiter this output needs"
fi
{
  printf 'changed_paths<<%s\n' "$delimiter"
  cat -- "${work:?}/paths"
  printf '%s\n' "$delimiter"
} >>"$GITHUB_OUTPUT"

# Whether the lanes run. A `render` diff was proved by re-rendering it, a
# `trivial` one is inside its allowlist and line ceiling, and a docs-only one
# changes no path outside the documentation set at any size. Every other diff
# runs the lanes.
# A separately checked-out default branch can predate the installed producer
# while the action already carries it. With no decision, run every lane.
if declare -F change_class_lanes >/dev/null; then
  change_class_lanes "$class" "$docs" "$EVENT" "$REPO" "$HEAD" \
    "$queue_only" "$work" "${LANES_FROM:-}"
else
  lane_count=0 lane_state=unset lane_values=() lane_causes=()
  lanes=true lanes_cause=lane-producer-unavailable
fi

verdicts=""
index=0
while [ "$index" -lt "$lane_count" ]; do
  verdicts="${verdicts}lane_${lane_names[$index]}=${lane_values[$index]}
"
  printf 'lane: name=%s verdict=%s %s\n' "${lane_names[$index]}" \
    "${lane_values[$index]}" "${lane_causes[$index]}" >&2
  index=$((index + 1))
done

# Every lane_verdicts line starts `lane_`, so none can spell its delimiter.
{
  printf 'lanes=%s\nlanes_cause=%s\n' "$lanes" "$lanes_cause"
  printf 'lane_verdicts<<__change_class_lane_verdicts_end__\n%s' "$verdicts"
  printf '__change_class_lane_verdicts_end__\n'
} >>"$GITHUB_OUTPUT"
printf 'lanes: lanes=%s cause=%s\n' "$lanes" "$lanes_cause" >&2

cat -- "$GITHUB_OUTPUT" >>"$step_output"
