#!/usr/bin/env bash
# classify — the shipped classifier's verdict for a diff, whether the diff
# runs a workflow's lanes, which of the lanes a declaration names it runs,
# and the changed-path families a workflow selects its jobs with.
#
# Nothing here decides a class or a docs verdict. `change-class` prints one
# and writes it to the step's output file itself, and `harness-only --mode
# docs` does the same for docs_only; this script adds the path families beside
# them, and the families are a grouping of the path list that docs-mode call
# prints, never a second reading of the diff. Taking the list from that call
# is what keeps the grouping on the shipped reader: `change-class` repeats the
# same paths on its stderr in a shell-quoted form whose only decoder is `eval`,
# and a path list out of the judged tree is not something to hand a shell.
#
# Environment, all required but BASE, CLASSIFIER and LANES_FROM:
#   EVENT  github.event_name
#   BASE   the base endpoint sha; empty where the event carries none
#   HEAD   the head endpoint sha
#   REPO   the checkout to judge
#   CLASSIFIER  the checkout root to read the shipped scripts from; empty
#          means this script's own tree
#   LANES_FROM  the checkout root whose .github/ci-lanes.conf declares the
#          workflow's lanes: the default branch's checkout, never REPO.
#          Empty means no lane is declared.
#   GITHUB_OUTPUT  the step output file both writers append to
#
# Outputs appended to GITHUB_OUTPUT:
#   change_class       render|trivial|micro|small|standard, written by the
#                      shipped classifier itself
#   docs_only          true|false, written by the shipped `harness-only --mode
#                      docs` itself. It answers false where harness-only
#                      cannot read the diff (an unsupported event, a missing
#                      or unresolvable endpoint, an unreadable or empty diff).
#                      A wiring error from harness-only or from this script
#                      fails the step with exit 2 instead, and the failed
#                      step, not this output, is the answer.
#   changed_skills     blank-separated first path segments under skills/
#   changed_crates     blank-separated first path segments under crates/
#   changed_workflows  blank-separated first path segments under
#                      .github/workflows/
#   changed_paths      every changed path, one per line, as the shipped reader
#                      printed them. A family is a grouping of this list, so a
#                      caller whose lanes answer to a tree no family names
#                      groups it here rather than reading the diff again.
#   lanes              true|false: whether the diff runs a workflow's lanes.
#                      false on `render`, on `trivial`, and on docs_only=true
#                      whatever the class; true on every other diff.
#   lanes_cause        why: render, trivial or docs-only where lanes=false,
#                      and the class where lanes=true.
#   lane_verdicts      one `lane_<name>=true|false` line per lane the
#                      declaration names, in the order it first names them;
#                      empty where LANES_FROM is empty or the declaration is
#                      absent or malformed.
#
# lanes is made from the two verdicts above, never from the paths. A workflow
# forwards it rather than spelling a class, so a change to which diffs run the
# lanes reaches every consumer with no workflow edit.
#
# A lane verdict is lanes narrowed by the paths the lane declares it reads:
# false wherever lanes is false; otherwise true where a changed path matches
# one of the lane's globs, true for every lane where a changed path no lane
# claims lies outside the docs set or where no changed path was read, and
# false everywhere else. A glob is a shell pattern, so `*` also matches `/`.
# The declaration is read from LANES_FROM, the default branch's copy, because
# the author of the diff under judgement could edit the tree's own copy to
# stand a lane down. An absent or malformed declaration is not a refusal:
# the default branch holds it, so failing the step would redden every pull
# request, the one that repairs it included.
#
# lanes and lane_verdicts are written last: a refusal anywhere above leaves
# neither output, and the failed step runs every lane.
#
# A segment is what the path holds, not what the caller hopes: `skills/AGENTS.md`
# puts `AGENTS.md` in changed_skills. Over-inclusion is the safe direction —
# an unrecognised member selects a lane rather than dropping one.
#
# Every refusal here starts `change-class-action: wiring-error: cause=<name>`
# and exits 2, so a caller gating a lane on the class sees a red step rather
# than an empty output. Reading an empty class as "nothing to run" is the
# fail-open that exit code closes.
set -euo pipefail

die() { # CAUSE MESSAGE
  printf 'change-class-action: wiring-error: cause=%s\n' "$1" >&2
  printf 'change-class-action: %s\n' "$2" >&2
  exit 2
}

# Where the shipped scripts are read from. A caller that judges a tree whose
# author could edit the classifier names a separate checkout here; with none
# named it is this action's own tree, which a consumer referencing the action
# at a tag or branch gets from that same revision.
scripts_root="${CLASSIFIER:-}"
[ -n "$scripts_root" ] || scripts_root="$(dirname "$0")/../../.."
SCRIPTS="$(cd "$scripts_root/skills/harness-ci/scripts" 2>/dev/null && pwd)" ||
  die "classifier-unreadable root=$scripts_root" \
    "no skills/harness-ci/scripts under the classifier root"

[ -n "${EVENT:-}" ] || die missing-event "the event input is required"
[ -n "${HEAD:-}" ] || die missing-head "the head input is required"
[ -n "${REPO:-}" ] || die missing-repo "the repo input is required"
[ -n "${GITHUB_OUTPUT:-}" ] || die missing-output-file \
  "GITHUB_OUTPUT is unset, so no caller could read a verdict"

declaration=""
if [ -n "${LANES_FROM:-}" ]; then
  lanes_root="$(cd "$LANES_FROM" 2>/dev/null && pwd -P)" ||
    die "lanes-from-unreadable root=$LANES_FROM" \
      "the lanes-from checkout is not a directory"
  judged_root="$(cd "$REPO" 2>/dev/null && pwd -P)" ||
    die "repo-unreadable repo=$REPO" "the repo checkout is not a directory"
  [ "$lanes_root" != "$judged_root" ] ||
    die "lanes-from-judged-tree root=$LANES_FROM" \
      "lanes-from names the tree under judgement, whose author could stand a lane down"
  declaration="$lanes_root/.github/ci-lanes.conf"
fi

work="$(mktemp -d)" || die mktemp-failed "could not create a working directory"
trap 'rm -rf -- "${work:?}"' EXIT

args=(--event "$EVENT" --head "$HEAD" --repo "$REPO")
[ -z "${BASE:-}" ] || args=("${args[@]}" --base "$BASE")

# The verdict. `change-class` appends `change_class=` to GITHUB_OUTPUT on its
# own and prints that same line, and nothing else, on stdout, which is where
# it is read back. Any other exit is a wiring error that carries no verdict.
verdict="$("$SCRIPTS/change-class" "${args[@]}")" || {
  status=$?
  die "classifier-failed status=$status" "change-class exited $status"
}
case "$verdict" in
  change_class=render | change_class=trivial | change_class=micro | \
    change_class=small | change_class=standard) class="${verdict#change_class=}" ;;
  *) die "verdict-unreadable class-line=$verdict" \
    "the classifier printed no change_class line this action knows" ;;
esac

# The docs verdict and the paths, from the reader that owns the diff range for
# every event. It appends `docs_only=` to GITHUB_OUTPUT on its own, as the
# classifier does its class. The paths outside the docs set are asked for
# only where a lane is declared: a classifier checkout older than that flag
# still serves every caller that declares none.
docs_args=(--mode docs "${args[@]}" --paths-output "${work:?}/paths")
[ -z "$declaration" ] ||
  docs_args=("${docs_args[@]}" --outside-output "${work:?}/outside")
docs="$("$SCRIPTS/harness-only" "${docs_args[@]}")" || {
  status=$?
  die "path-reader-failed status=$status" "harness-only exited $status"
}
case "$docs" in
  docs_only=true | docs_only=false) ;;
  *) die "docs-verdict-unreadable docs-line=$docs" \
    "harness-only printed no docs_only line" ;;
esac

# Every class but `standard` is reached only after the classifier read a
# changed path, so an empty list under one of them is a state neither script
# can produce. Publishing the families empty there would select the lanes a
# narrow class runs on nothing at all.
if [ ! -s "${work:?}/paths" ] && [ "$class" != standard ]; then
  die "class-without-paths class=$class" \
    "a narrow class arrived with no changed path, which no classifier emits"
fi

# One family per directory level a caller gates on: the skill, the workspace
# member and the workflow file. A path outside all three joins no family, and
# a change carrying one is why `standard` exists. The read is assigned on its
# own line rather than inside the printf below: a substitution that died
# inside an argument list leaves printf's own zero status as the step's, and
# the output line is then written empty with nothing red.
family() { # NAME PREFIX DEPTH
  local name="$1" prefix="$2" depth="$3" listed
  listed="$(cut -d/ -f1-"$depth" <"${work:?}/paths" |
    sed -n "s%^$prefix/%%p" | sort -u | tr '\n' ' ')" ||
    die "family-read-failed prefix=$prefix" \
      "could not group the changed paths under '$prefix'"
  printf '%s=%s\n' "$name" "${listed% }" >>"$GITHUB_OUTPUT"
}

family changed_skills skills 2
family changed_crates crates 2
family changed_workflows .github/workflows 3

sed -n 's/^changed_/family: /p' <"$GITHUB_OUTPUT" >&2

# The whole list, for a caller whose lanes answer to a tree no family names.
# A multi-line output needs a delimiter no line of the value can be. The value
# is a path list the pull request's author writes, so a path spelling the
# delimiter would end the value early and write the lines after it as outputs
# of their own; that path is refused rather than escaped.
delimiter=__change_class_changed_paths_end__
if grep -qxF -- "$delimiter" "${work:?}/paths"; then
  die "delimiter-collides path=$delimiter" \
    "a changed path is exactly the heredoc delimiter this output needs"
fi
{
  printf 'changed_paths<<%s\n' "$delimiter"
  cat -- "${work:?}/paths"
  printf '%s\n' "$delimiter"
} >>"$GITHUB_OUTPUT"

# Whether the lanes run. A `render` diff was proved by re-rendering it, a
# `trivial` one is inside its allowlist and line ceiling, and a docs-only one
# changes no path outside the documentation set at any size. Every other diff
# runs the lanes.
if [ "$class" = render ] || [ "$class" = trivial ]; then
  lanes=false lanes_cause="$class"
elif [ "$docs" = docs_only=true ]; then
  lanes=false lanes_cause=docs-only
else
  lanes=true lanes_cause="$class"
fi

# The declaration: `<lane> <glob>...` per line, `#` to the end of a line a
# comment, and a lane named on several lines reading every glob they give
# it. Bash 3.2 has no associative array, so lane N's name and its globs, one
# per line, sit at index N of two arrays.
lane_names=()
lane_globs=()
lane_count=0
declaration_note=""
read_declaration() { # sets declaration_note and returns 1 where malformed
  local text line number=0 name glob index
  text="$(cat -- "$declaration" 2>/dev/null)" ||
    { declaration_note="cause=unreadable"; return 1; }
  while IFS= read -r line; do
    number=$((number + 1))
    line="${line%%#*}"
    set -f
    # shellcheck disable=SC2086 # a line is blank-separated words
    set -- $line
    set +f
    [ "$#" -gt 0 ] || continue
    name="$1"
    shift
    case "$name" in
      [!abcdefghijklmnopqrstuvwxyz0123456789]* | *[!abcdefghijklmnopqrstuvwxyz0123456789_-]*)
        declaration_note="cause=bad-name line=$number name=$name"
        return 1 ;;
    esac
    [ "$#" -gt 0 ] ||
      { declaration_note="cause=no-globs line=$number lane=$name"; return 1; }
    index=0
    while [ "$index" -lt "$lane_count" ] && [ "${lane_names[$index]}" != "$name" ]; do
      index=$((index + 1))
    done
    if [ "$index" -eq "$lane_count" ]; then
      lane_names[$index]="$name"
      lane_globs[$index]=""
      lane_count=$((lane_count + 1))
    fi
    for glob in "$@"; do
      lane_globs[$index]="${lane_globs[$index]}$glob
"
    done
  done <<<"$text"
  [ "$lane_count" -gt 0 ] || { declaration_note="cause=no-lanes"; return 1; }
}

LANE_GLOB_HIT=""
lane_claims() { # INDEX PATH — sets LANE_GLOB_HIT on a match
  local glob IFS='
'
  set -f; for glob in ${lane_globs[$1]}; do
    # shellcheck disable=SC2254 # the glob is a pattern
    case "$2" in
      $glob) set +f; LANE_GLOB_HIT="$glob"; return 0 ;;
    esac
  done
  set +f
  return 1
}

outside_docs() { # PATH — 0 outside the docs set, 1 inside it
  local status=0
  grep -qxF -- "$1" "${work:?}/outside" 2>/dev/null || status=$?
  case "$status" in
    0) return 0 ;;
    1) return 1 ;;
    *) die "outside-list-unreadable status=$status" \
      "could not read the paths harness-only placed outside the docs set" ;;
  esac
}

lane_state="unset"
if [ -n "$declaration" ]; then
  if [ ! -e "$declaration" ]; then
    lane_state="absent"
  elif read_declaration; then
    lane_state="read"
  else
    lane_state="malformed" lane_count=0
  fi
  printf 'lane-declaration: state=%s path=%s%s\n' "$lane_state" \
    "$declaration" "${declaration_note:+ $declaration_note}" >&2
fi
case "$lane_state" in
  absent | malformed)
    printf '::warning title=lane declaration %s::%s %s; no lane verdict is published\n' \
      "$lane_state" "$declaration" "${declaration_note:-}" ;;
esac

# A lane's cause, empty for a lane no changed path reached. `every` names
# what turns every lane on at once.
lane_hits=()
every=""
if [ "$lane_state" = read ] && [ "$lanes" = true ]; then
  index=0
  while [ "$index" -lt "$lane_count" ]; do
    lane_hits[$index]=""
    index=$((index + 1))
  done
  if [ ! -s "${work:?}/paths" ]; then
    every="cause=no-changed-paths"
  fi
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    claimed=false
    index=0
    while [ "$index" -lt "$lane_count" ]; do
      if lane_claims "$index" "$path"; then
        claimed=true
        [ -n "${lane_hits[$index]}" ] ||
          lane_hits[$index]="cause=claimed path=$path glob=$LANE_GLOB_HIT"
      fi
      index=$((index + 1))
    done
    if [ "$claimed" = false ] && [ -z "$every" ] && outside_docs "$path"; then
      every="cause=unclaimed-path path=$path"
    fi
  done <"${work:?}/paths"
fi

verdicts=""
index=0
while [ "$index" -lt "$lane_count" ]; do
  if [ "$lanes" = false ]; then
    lane=false lane_cause="cause=lanes-false lanes_cause=$lanes_cause"
  elif [ -n "$every" ]; then
    lane=true lane_cause="$every"
  elif [ -n "${lane_hits[$index]}" ]; then
    lane=true lane_cause="${lane_hits[$index]}"
  else
    lane=false lane_cause="cause=unreached"
  fi
  verdicts="${verdicts}lane_${lane_names[$index]}=$lane
"
  printf 'lane: name=%s verdict=%s %s\n' "${lane_names[$index]}" "$lane" \
    "$lane_cause" >&2
  index=$((index + 1))
done

# Every lane_verdicts line starts `lane_`, so none can spell its delimiter.
{
  printf 'lanes=%s\nlanes_cause=%s\n' "$lanes" "$lanes_cause"
  printf 'lane_verdicts<<__change_class_lane_verdicts_end__\n%s' "$verdicts"
  printf '__change_class_lane_verdicts_end__\n'
} >>"$GITHUB_OUTPUT"
printf 'lanes: lanes=%s cause=%s\n' "$lanes" "$lanes_cause" >&2
