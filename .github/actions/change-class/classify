#!/usr/bin/env bash
# classify — the shipped classifier's verdict for a diff, whether the diff
# runs a workflow's lanes, which of the lanes a declaration names it runs,
# the changed-path families a workflow selects its jobs with, and whether a
# passing run of this workflow already proved the tree this run tests.
#
# Nothing here decides a class or a docs verdict. `change-class` prints one
# and writes it to the step's output file itself, and `harness-only --mode
# docs` does the same for docs_only; this script adds the path families beside
# them, and the families are a grouping of the path list that docs-mode call
# prints, never a second reading of the diff. Taking the list from that call
# is what keeps the grouping on the shipped reader: `change-class` repeats the
# same paths on its stderr in a shell-quoted form whose only decoder is `eval`,
# and a path list out of the judged tree is not something to hand a shell.
#
# Environment, from the action's inputs, all required but BASE, CLASSIFIER,
# LANES_FROM and COVERS_ALL_LANES:
#   EVENT  github.event_name
#   BASE   the base endpoint sha; empty where the event carries none
#   HEAD   the head endpoint sha
#   REPO   the checkout to judge; on a pull request with a `:queue` lane to
#          defer, its HEAD commit is read for the harness-ci render, below
#   CLASSIFIER  the checkout root to read the shipped scripts from; empty
#          means this script's own tree
#   LANES_FROM  the checkout root whose .github/ci-lanes.conf declares the
#          workflow's lanes: the default branch's checkout, never REPO.
#          Empty means no lane is declared.
#   COVERS_ALL_LANES  `true` where the calling workflow runs every lane
#          whenever lanes is true, as the harness-ci template's does, and
#          each lane does the same work on every event: no job or step of
#          it is gated on the event. Any other value, empty included, says
#          it does not. Only it lets a run that reads no declaration record
#          covers=all.
#   GH_TOKEN  the job token, which `proof` reads workflow runs with
# Environment, from the runner:
#   GITHUB_OUTPUT  the step output file every writer appends to
#   RUNNER_TEMP    where the record below is written; unset, no record is
#                  written and the step says so
#   GITHUB_WORKFLOW_REF and GITHUB_REPOSITORY, which `proof` reads this
#                  run's workflow file from
#   GITHUB_SHA and the rest `proof` lists
#
# Outputs appended to GITHUB_OUTPUT:
#   change_class       render|trivial|micro|small|standard, written by the
#                      shipped classifier itself
#   queue_only         true|false, written by the shipped classifier itself:
#                      whether the change must run in a merge group before
#                      it lands, the value of its `queue-only:` line, whose
#                      statement is change-class's header. Absent where the
#                      classifier root predates the output, and where the
#                      step fails before change-class answers.
#   docs_only          true|false, written by the shipped `harness-only --mode
#                      docs` itself. It answers false where harness-only
#                      cannot read the diff (an unsupported event, a missing
#                      or unresolvable endpoint, an unreadable or empty diff).
#                      A wiring error from harness-only or from this script
#                      fails the step with exit 2 instead, and the failed
#                      step, not this output, is the answer.
#   changed_skills     blank-separated first path segments under skills/
#   changed_crates     blank-separated first path segments under crates/
#   changed_workflows  blank-separated first path segments under
#                      .github/workflows/
#   changed_paths      every changed path, one per line, as the shipped reader
#                      printed them. A family is a grouping of this list, so a
#                      caller whose lanes answer to a tree no family names
#                      groups it here rather than reading the diff again.
#   proof_reuse        true|false: whether a passing run of this workflow
#                      tested this tree and left a record of what it covered,
#                      as `proof` beside this script decides it.
#   proof_reason       `exact-proof`, or the refusal key `proof` printed.
#   proof_run          the proving run's id where proof_reuse is true.
#   proof_tree         the tree this run tests, empty where the checkout
#                      lacks the commit GITHUB_SHA names.
#   proof_record       the proving run's record, its lines as below, empty
#                      where proof_reuse is false. A workflow that selects
#                      its jobs itself reads the run's class, docs verdict,
#                      event and paths out of it to re-derive what that run
#                      ran, as kendex's tools/ci-job-set does.
#   lanes              true|false: whether the diff runs a workflow's lanes.
#                      false on `render`, on `trivial`, on docs_only=true
#                      whatever the class, and where a proof covers every
#                      lane the diff would run; true on every other diff.
#   lanes_cause        why: render, trivial, docs-only or proof-reused where
#                      lanes=false, and the class where lanes=true.
#   lane_verdicts      one `lane_<name>=true|false` line per lane the
#                      declaration names, in the order it first names them;
#                      empty where LANES_FROM is empty or the declaration is
#                      absent or malformed.
#   record_dir         the directory holding the record below, whose one
#                      file is `record`, where this run wrote one; empty
#                      where it did not. The action's upload step alone
#                      reads it, and no workflow: it uploads that directory,
#                      so the artifact's member is `record`, the name
#                      `proof` reads.
#
# lanes is made from the two verdicts above and the proof, never from the
# paths. A workflow forwards it rather than spelling a class, so a change to
# which diffs run the lanes reaches every consumer with no workflow edit.
#
# A lane verdict is lanes narrowed by the paths the lane declares it reads,
# in this order: false wherever lanes is false; then, on a pull request,
# false with the cause queue-deferred for a lane the declaration marks
# `:queue` and one of its own globs reaches, where this run's change-class
# answered queue_only=true and both renders below read the mark; then true
# for every lane where a changed path no lane claims lies outside the docs
# set or where no changed path was read; then true where a changed path
# matches one of the lane's globs, and false everywhere else. A deferred
# lane runs in the merge group, which reuses no proof for it because this
# run's record says it did not run. The deferral needs the queue_only
# answer as well as the lane's own glob, so no lane is deferred on a pull
# request change-class reads as free to take the admin merge.
#
# That answer is this run's. github.sh pr-merge asks it again at merge time
# through the harness-ci render beside the github.sh it runs, which is a
# checkout of one of two trees CI can see: the default branch, LANES_FROM,
# and the pull request's head, HEAD in REPO, which submit-pr's worktree
# holds. A render from before the mark answers queue_only=false for the
# lane's paths, so a lane is deferred only where both trees carry
# .agents/skills/harness-ci/scripts/lib/ci-lanes.sh, the render's reader of
# the mark. Either absent, the lane runs with cause=queue-reader-absent and
# a `tree=` naming which, and the step raises one warning. A head that
# deletes its reader only makes the lane run. A checkout that runs pr-merge
# behind both trees is outside what CI sees, and wiring.md holds it as an
# ordering rule. A glob is a shell pattern, so `*` also matches `/`. The
# declaration's grammar and reader are the classifier's lib/ci-lanes.sh.
# The declaration is read from LANES_FROM, the default branch's copy, because
# the author of the diff under judgement could edit the tree's own copy to
# stand a lane down. An absent or malformed declaration is not a refusal:
# the default branch holds it, so failing the step would redden every pull
# request, the one that repairs it included.
#
# A proof stands down what the proving run covered and nothing else. Its
# record says `covers=all`, `covers=none` or `covers=lanes` with one
# `lane_<name>=true|false` line per lane that run's declaration named. The
# proving run ran on another event, so a declared lane stands down on it
# only where the declaration marks the lane `:event-uniform`, the
# declaration's word that the lane does the same work on every event. A
# marked lane whose classified verdict is true and which the record covers
# turns false with the cause proof-reused; where every lane the diff would
# run turns false, lanes itself answers false with lanes_cause=proof-reused.
# An unmarked lane keeps its verdict whatever the record says, and one whose
# verdict is true and which the record covers has its `lane:` line name the
# proof it held back. With no declaration read, only
# `covers=all` stands the lanes down, on COVERS_ALL_LANES's word for every
# lane: a record of named lanes cannot be mapped onto lanes this run does
# not name. A lane the proving run skipped, or did not have, keeps its
# classified verdict.
#
# The record this run leaves, for the run after it, is written to
# RUNNER_TEMP/change-class-record/record on pull_request and merge_group,
# and the action's next step uploads that directory under the tree's name.
# Its lines:
#   tree=<sha>  workflow=<path>  event=<event>  change_class=<class>
#   docs_only=<bool>  covers=all|none|lanes  lane_<name>=true|false...
#   changed_path=<path>...
# covers is the action's view of what has passed on this tree once this run
# passes, in the lanes a declaration names, not a list of the jobs the
# workflow ran:
#   all    where COVERS_ALL_LANES is true, no declaration was read and
#          lanes is true; or where no declaration was read and a proof
#          covered every lane.
#   lanes  with one line per declared lane, where a declaration was read:
#          true for the lanes whose final verdict is true and the ones the
#          proof covered, marked or not, false for the rest; or the proving
#          run's own lane lines, carried forward, where no declaration was
#          read here. The record says what passed; the run reading it
#          judges the mark.
#   none   otherwise: a workflow that selects its jobs itself leaves
#          COVERS_ALL_LANES unset, and its records say none.
#
# lanes and lane_verdicts are written after every other verdict, and
# record_dir after them: a refusal anywhere above leaves neither lanes
# output, and the failed step runs every lane.
#
# A segment is what the path holds, not what the caller hopes: `skills/AGENTS.md`
# puts `AGENTS.md` in changed_skills. Over-inclusion is the safe direction —
# an unrecognised member selects a lane rather than dropping one.
#
# Every refusal here starts `change-class-action: wiring-error: cause=<name>`
# and exits 2, so a caller gating a lane on the class sees a red step rather
# than an empty output. Reading an empty class as "nothing to run" is the
# fail-open that exit code closes.
set -euo pipefail

die() { # CAUSE MESSAGE
  printf 'change-class-action: wiring-error: cause=%s\n' "$1" >&2
  printf 'change-class-action: %s\n' "$2" >&2
  exit 2
}

# Where the shipped scripts are read from. A caller that judges a tree whose
# author could edit the classifier names a separate checkout here; with none
# named it is this action's own tree, which a consumer referencing the action
# at a tag or branch gets from that same revision.
scripts_root="${CLASSIFIER:-}"
[ -n "$scripts_root" ] || scripts_root="$(dirname "$0")/../../.."
SCRIPTS="$(cd "$scripts_root/skills/harness-ci/scripts" 2>/dev/null && pwd)" ||
  die "classifier-unreadable root=$scripts_root" \
    "no skills/harness-ci/scripts under the classifier root"
PROOF="$(dirname "$0")/proof"
[ -x "$PROOF" ] || die "proof-missing path=$PROOF" \
  "the proof script beside this one is absent or not executable"

[ -n "${EVENT:-}" ] || die missing-event "the event input is required"
[ -n "${HEAD:-}" ] || die missing-head "the head input is required"
[ -n "${REPO:-}" ] || die missing-repo "the repo input is required"
[ -n "${GITHUB_OUTPUT:-}" ] || die missing-output-file \
  "GITHUB_OUTPUT is unset, so no caller could read a verdict"

declaration=""
if [ -n "${LANES_FROM:-}" ]; then
  lanes_root="$(cd "$LANES_FROM" 2>/dev/null && pwd -P)" ||
    die "lanes-from-unreadable root=$LANES_FROM" \
      "the lanes-from checkout is not a directory"
  judged_root="$(cd "$REPO" 2>/dev/null && pwd -P)" ||
    die "repo-unreadable repo=$REPO" "the repo checkout is not a directory"
  [ "$lanes_root" != "$judged_root" ] ||
    die "lanes-from-judged-tree root=$LANES_FROM" \
      "lanes-from names the tree under judgement, whose author could stand a lane down"
  declaration="$lanes_root/.github/ci-lanes.conf"
  # The declaration's reader ships beside the classifier, so change-class's
  # queue-only line and these verdicts read one grammar.
  # shellcheck source=../../../skills/harness-ci/scripts/lib/ci-lanes.sh
  . "$SCRIPTS/lib/ci-lanes.sh" ||
    die "lanes-reader-unreadable root=$scripts_root" \
      "no skills/harness-ci/scripts/lib/ci-lanes.sh under the classifier root"
fi

work="$(mktemp -d)" || die mktemp-failed "could not create a working directory"
trap 'rm -rf -- "${work:?}"' EXIT

args=(--event "$EVENT" --head "$HEAD" --repo "$REPO")
[ -z "${BASE:-}" ] || args=("${args[@]}" --base "$BASE")

# The verdict. `change-class` appends `change_class=` to GITHUB_OUTPUT on its
# own and prints that same line, and nothing else, on stdout, which is where
# it is read back. Any other exit is a wiring error that carries no verdict.
verdict="$("$SCRIPTS/change-class" "${args[@]}")" || {
  status=$?
  die "classifier-failed status=$status" "change-class exited $status"
}
case "$verdict" in
  change_class=render | change_class=trivial | change_class=micro | \
    change_class=small | change_class=standard) class="${verdict#change_class=}" ;;
  *) die "verdict-unreadable class-line=$verdict" \
    "the classifier printed no change_class line this action knows" ;;
esac
# The queue_only line change-class appended beside its class, the one answer
# a `:queue` lane's deferral stands on; empty where the classifier root
# predates it.
queue_only="$(sed -n 's/^queue_only=//p' "$GITHUB_OUTPUT")" ||
  die "queue-only-unreadable path=$GITHUB_OUTPUT" \
    "could not read back the queue_only line change-class wrote"

# The docs verdict and the paths, from the reader that owns the diff range for
# every event. It appends `docs_only=` to GITHUB_OUTPUT on its own, as the
# classifier does its class. The paths outside the docs set are asked for
# only where a lane is declared: a classifier checkout older than that flag
# still serves every caller that declares none.
docs_args=(--mode docs "${args[@]}" --paths-output "${work:?}/paths")
[ -z "$declaration" ] ||
  docs_args=("${docs_args[@]}" --outside-output "${work:?}/outside")
docs="$("$SCRIPTS/harness-only" "${docs_args[@]}")" || {
  status=$?
  die "path-reader-failed status=$status" "harness-only exited $status"
}
case "$docs" in
  docs_only=true | docs_only=false) ;;
  *) die "docs-verdict-unreadable docs-line=$docs" \
    "harness-only printed no docs_only line" ;;
esac

# Every class but `standard` is reached only after the classifier read a
# changed path, so an empty list under one of them is a state neither script
# can produce. Publishing the families empty there would select the lanes a
# narrow class runs on nothing at all.
if [ ! -s "${work:?}/paths" ] && [ "$class" != standard ]; then
  die "class-without-paths class=$class" \
    "a narrow class arrived with no changed path, which no classifier emits"
fi

# One family per directory level a caller gates on: the skill, the workspace
# member and the workflow file. A path outside all three joins no family, and
# a change carrying one is why `standard` exists. The read is assigned on its
# own line rather than inside the printf below: a substitution that died
# inside an argument list leaves printf's own zero status as the step's, and
# the output line is then written empty with nothing red.
family() { # NAME PREFIX DEPTH
  local name="$1" prefix="$2" depth="$3" listed
  listed="$(cut -d/ -f1-"$depth" <"${work:?}/paths" |
    sed -n "s%^$prefix/%%p" | sort -u | tr '\n' ' ')" ||
    die "family-read-failed prefix=$prefix" \
      "could not group the changed paths under '$prefix'"
  printf '%s=%s\n' "$name" "${listed% }" >>"$GITHUB_OUTPUT"
}

family changed_skills skills 2
family changed_crates crates 2
family changed_workflows .github/workflows 3

sed -n 's/^changed_/family: /p' <"$GITHUB_OUTPUT" >&2

# The whole list, for a caller whose lanes answer to a tree no family names.
# A multi-line output needs a delimiter no line of the value can be. The value
# is a path list the pull request's author writes, so a path spelling the
# delimiter would end the value early and write the lines after it as outputs
# of their own; that path is refused rather than escaped.
delimiter=__change_class_changed_paths_end__
if grep -qxF -- "$delimiter" "${work:?}/paths"; then
  die "delimiter-collides path=$delimiter" \
    "a changed path is exactly the heredoc delimiter this output needs"
fi
{
  printf 'changed_paths<<%s\n' "$delimiter"
  cat -- "${work:?}/paths"
  printf '%s\n' "$delimiter"
} >>"$GITHUB_OUTPUT"

# Whether the lanes run. A `render` diff was proved by re-rendering it, a
# `trivial` one is inside its allowlist and line ceiling, and a docs-only one
# changes no path outside the documentation set at any size. Every other diff
# runs the lanes.
if [ "$class" = render ] || [ "$class" = trivial ]; then
  lanes=false lanes_cause="$class"
elif [ "$docs" = docs_only=true ]; then
  lanes=false lanes_cause=docs-only
else
  lanes=true lanes_cause="$class"
fi

outside_docs() { # PATH — 0 outside the docs set, 1 inside it
  local status=0
  grep -qxF -- "$1" "${work:?}/outside" 2>/dev/null || status=$?
  case "$status" in
    0) return 0 ;;
    1) return 1 ;;
    *) die "outside-list-unreadable status=$status" \
      "could not read the paths harness-only placed outside the docs set" ;;
  esac
}

lane_count=0
lane_state="unset"
if [ -n "$declaration" ]; then
  if [ ! -e "$declaration" ]; then
    lane_state="absent"
  elif ci_lanes_read "$declaration"; then
    lane_state="read"
  else
    lane_state="malformed" lane_count=0
  fi
  printf 'lane-declaration: state=%s path=%s%s\n' "$lane_state" \
    "$declaration" "${declaration_note:+ $declaration_note}" >&2
fi
case "$lane_state" in
  absent | malformed)
    printf '::warning title=lane declaration %s::%s %s; no lane verdict is published\n' \
      "$lane_state" "$declaration" "${declaration_note:-}" ;;
esac

# A lane's cause, empty for a lane no changed path reached. `every` names
# what turns every lane on at once.
lane_hits=()
every=""
if [ "$lane_state" = read ] && [ "$lanes" = true ]; then
  index=0
  while [ "$index" -lt "$lane_count" ]; do
    lane_hits[$index]=""
    index=$((index + 1))
  done
  if [ ! -s "${work:?}/paths" ]; then
    every="cause=no-changed-paths"
  fi
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    claimed=false
    index=0
    while [ "$index" -lt "$lane_count" ]; do
      if ci_lanes_claims "$index" "$path"; then
        claimed=true
        [ -n "${lane_hits[$index]}" ] ||
          lane_hits[$index]="cause=claimed path=$path glob=$LANE_GLOB_HIT"
      fi
      index=$((index + 1))
    done
    if [ "$claimed" = false ] && [ -z "$every" ] && outside_docs "$path"; then
      every="cause=unclaimed-path path=$path"
    fi
  done <"${work:?}/paths"
fi

# The trees, of the two a merge of this pull request may run pr-merge from,
# whose harness-ci render lacks the reader of the `:queue` mark: `lanes-from`,
# `judged`, both comma-joined, or empty where both carry it. The render path
# is the one the harness-ci template's render-reach step runs from. The
# judged tree is read at HEAD, not REPO's worktree, which on a pull request
# is the merge GitHub built and holds the base's render where the head has
# none; a HEAD REPO cannot read counts as absent, so the lane runs.
queue_reader=.agents/skills/harness-ci/scripts/lib/ci-lanes.sh
queue_reader_missing() {
  local missing=""
  [ -f "$lanes_root/$queue_reader" ] || missing="lanes-from"
  [ "$(git -C "$REPO" cat-file -t "$HEAD:$queue_reader" 2>/dev/null)" = blob ] ||
    missing="${missing:+$missing,}judged"
  printf '%s' "$missing"
}

# Each lane's classified verdict and cause, at its index. On a pull request
# a lane marked `:queue` that one of its own globs reached stands down only
# where this run's change-class answered queue_only=true and both renders
# read the mark, so pr-merge, asking the same question from either, keeps
# the pull request off the admin merge. Otherwise it runs, its cause naming
# what was missing. A queue lane only `every` reached runs here, since no
# glob of its own put the diff in the queue.
lane_values=()
lane_causes=()
reader_missing=unread
index=0
while [ "$index" -lt "$lane_count" ]; do
  if [ "$lanes" = false ]; then
    lane_values[$index]=false lane_causes[$index]="cause=lanes-false lanes_cause=$lanes_cause"
  elif [ "$EVENT" = pull_request ] && [ "${lane_queue[$index]}" = true ] && [ -n "${lane_hits[$index]}" ]; then
    hit="${lane_hits[$index]#cause=claimed }"
    [ "$reader_missing" != unread ] || reader_missing="$(queue_reader_missing)"
    if [ -n "$reader_missing" ]; then
      lane_values[$index]=true lane_causes[$index]="cause=queue-reader-absent tree=$reader_missing $hit"
    elif [ "$queue_only" != true ]; then
      lane_values[$index]=true lane_causes[$index]="cause=queue-unconfirmed queue_only=${queue_only:-absent} $hit"
    else
      lane_values[$index]=false lane_causes[$index]="cause=queue-deferred $hit"
    fi
  elif [ -n "$every" ]; then
    lane_values[$index]=true lane_causes[$index]="$every"
  elif [ -n "${lane_hits[$index]}" ]; then
    lane_values[$index]=true lane_causes[$index]="${lane_hits[$index]}"
  else
    lane_values[$index]=false lane_causes[$index]="cause=unreached"
  fi
  index=$((index + 1))
done
case "$reader_missing" in
  unread | "") ;;
  *) printf '::warning title=queue lane not deferred::tree=%s holds no %s, so github.sh pr-merge run from it would read this pull request free to take the admin merge; run kendex refresh on the default branch and rebase the pull request onto it, and until then the lane runs\n' \
    "$reader_missing" "$queue_reader" ;;
esac

# The proof: whether a passing run of this workflow tested this tree, and
# its record. `proof` decides and never gates, so its lines are read as they
# stand and a refusal is one `proof:` line and the classified answers above.
proof_out="$("$PROOF" "${work:?}")" || {
  status=$?
  die "proof-failed status=$status" "proof exited $status"
}
proof_line() { # KEY — the value of the proof's line KEY
  printf '%s\n' "$proof_out" | sed -n "s/^$1=//p"
}
proof_reuse="$(proof_line reuse)"
proof_reason="$(proof_line reason)"
proof_run="$(proof_line run)"
proof_tree="$(proof_line tree)"
proof_workflow="$(proof_line workflow)"
proof_record="$(proof_line record)"
case "$proof_reuse" in
  true | false) [ -n "$proof_reason" ] ;;
  *) false ;;
esac || die "proof-unreadable lines=$(printf '%s' "$proof_out" | tr '\n' ' ')" \
  "proof printed no reuse and reason lines this action knows"
printf 'proof: reuse=%s reason=%s run=%s %s\n' "$proof_reuse" "$proof_reason" \
  "$proof_run" "$(proof_line detail)" >&2

# What the proving run covered: `all`, `none`, or the named lanes, read from
# its record. A record naming no covers line covers nothing.
record_covers=none
record_lanes=""
if [ "$proof_reuse" = true ]; then
  record_covers="$(sed -n 's/^covers=//p' "$proof_record")"
  case "$record_covers" in
    all | none) ;;
    lanes) record_lanes="$(sed -n 's/^\(lane_[^=]*=[a-z]*\)$/\1/p' "$proof_record")" ;;
    *) record_covers=none ;;
  esac
fi
record_covers_lane() { # NAME — 0 where the proving run covered lane NAME
  [ "$record_covers" = all ] && return 0
  [ "$record_covers" = lanes ] || return 1
  grep -qxF -- "lane_$1=true" <<<"$record_lanes"
}

# Apply the proof. A covered lane marked event-uniform whose classified
# verdict is true turns false, and a covered one left unmarked is held;
# where every lane the diff would run turns false, lanes turns false with
# it. This is the one place the mark is judged. `proven` is one `true` or
# `false` per lane, whether the record covers it, for the record below.
proven=()
applied=""
index=0
while [ "$index" -lt "$lane_count" ]; do
  proven[$index]=false
  ! record_covers_lane "${lane_names[$index]}" || proven[$index]=true
  index=$((index + 1))
done
if [ "$proof_reuse" = true ] && [ "$lanes" = true ]; then
  if [ "$lane_state" = read ]; then
    uncovered=0 held=0 stood=0
    index=0
    while [ "$index" -lt "$lane_count" ]; do
      if [ "${lane_values[$index]}" = true ]; then
        if [ "${proven[$index]}" = true ] && [ "${lane_uniform[$index]}" = true ]; then
          lane_values[$index]=false lane_causes[$index]="cause=proof-reused run=$proof_run"
          stood=$((stood + 1))
        elif [ "${proven[$index]}" = true ]; then
          lane_causes[$index]="${lane_causes[$index]} proof-held=not-event-uniform run=$proof_run"
          held=$((held + 1))
        else
          uncovered=$((uncovered + 1))
        fi
      fi
      index=$((index + 1))
    done
    if [ "$uncovered" -eq 0 ] && [ "$held" -eq 0 ] && [ "$stood" -gt 0 ]; then
      lanes=false lanes_cause=proof-reused applied="every lane the diff runs"
    elif [ "$stood" -gt 0 ] || [ "$held" -gt 0 ]; then
      applied="$stood of the lanes the diff runs, $held held as not event-uniform, $uncovered uncovered"
    else
      applied="none: the proving run covered no lane the diff runs"
    fi
  elif [ "$record_covers" = all ]; then
    lanes=false lanes_cause=proof-reused applied="every lane"
  else
    applied="none: no declaration read here and the record covers $record_covers"
  fi
  printf 'proof: applied=%s\n' "$applied" >&2
fi

verdicts=""
index=0
while [ "$index" -lt "$lane_count" ]; do
  verdicts="${verdicts}lane_${lane_names[$index]}=${lane_values[$index]}
"
  printf 'lane: name=%s verdict=%s %s\n' "${lane_names[$index]}" \
    "${lane_values[$index]}" "${lane_causes[$index]}" >&2
  index=$((index + 1))
done

# Every lane_verdicts line starts `lane_`, and every record line is
# `key=value` with a fixed key, so neither can spell its delimiter.
{
  printf 'proof_reuse=%s\nproof_reason=%s\nproof_run=%s\nproof_tree=%s\n' \
    "$proof_reuse" "$proof_reason" "$proof_run" "$proof_tree"
  printf 'proof_record<<__change_class_proof_record_end__\n'
  [ -z "$proof_record" ] || cat -- "$proof_record"
  printf '__change_class_proof_record_end__\n'
  printf 'lanes=%s\nlanes_cause=%s\n' "$lanes" "$lanes_cause"
  printf 'lane_verdicts<<__change_class_lane_verdicts_end__\n%s' "$verdicts"
  printf '__change_class_lane_verdicts_end__\n'
} >>"$GITHUB_OUTPUT"
printf 'lanes: lanes=%s cause=%s\n' "$lanes" "$lanes_cause" >&2

# The record for the run after this one, on the two events a later run can
# reuse: a merge group reuses a pull request's, a push a merge group's.
# record_dir is written on every path out of this block, so the upload step
# reads whether a record exists from this script alone.
record_dir=""
record_skipped() { # CAUSE
  printf 'record: skipped cause=%s\n' "$1" >&2
}
case "$EVENT" in
  pull_request | merge_group)
    if [ -z "$proof_tree" ]; then
      record_skipped tree-unreadable
    elif [ -z "$proof_workflow" ]; then
      record_skipped workflow-unreadable
    elif [ -z "${RUNNER_TEMP:-}" ]; then
      record_skipped no-runner-temp
    else
      record_dir="$RUNNER_TEMP/change-class-record"
    fi ;;
  *) record_skipped "unrecorded-event event=$EVENT" ;;
esac
if [ "$lanes" = true ] && [ "$lane_state" != read ] && [ "${COVERS_ALL_LANES:-}" = true ]; then
  covers=all
elif [ "$lane_state" = read ]; then
  covers=lanes
elif [ "$record_covers" = all ]; then
  covers=all
elif [ "$record_covers" = lanes ]; then
  covers=carried
else
  covers=none
fi
if [ -n "$record_dir" ]; then
  record="$record_dir/record"
  mkdir -p -- "$record_dir" ||
    die "record-unwritable path=$record_dir" "the record's directory could not be made"
  {
    printf 'tree=%s\nworkflow=%s\nevent=%s\nchange_class=%s\ndocs_only=%s\n' \
      "$proof_tree" "$proof_workflow" "$EVENT" "$class" "${docs#docs_only=}"
    case "$covers" in
      carried)
        printf 'covers=lanes\n%s\n' "$record_lanes" ;;
      lanes)
        printf 'covers=lanes\n'
        index=0
        while [ "$index" -lt "$lane_count" ]; do
          covered=false
          [ "${lane_values[$index]}" != true ] && [ "${proven[$index]}" != true ] || covered=true
          printf 'lane_%s=%s\n' "${lane_names[$index]}" "$covered"
          index=$((index + 1))
        done ;;
      *) printf 'covers=%s\n' "$covers" ;;
    esac
    sed 's/^/changed_path=/' "${work:?}/paths"
  } >"$record" || die "record-unwritable path=$record" "the record could not be written"
  printf 'record: path=%s tree=%s covers=%s\n' "$record" "$proof_tree" \
    "$(sed -n 's/^covers=//p' "$record")" >&2
fi
printf 'record_dir=%s\n' "$record_dir" >>"$GITHUB_OUTPUT"
