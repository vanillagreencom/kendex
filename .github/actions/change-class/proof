#!/usr/bin/env bash
# proof — whether a passing run of this workflow already tested the tree this
# run is about to test, and the record that run left of what it covered.
#
# MACOS_PATCH_PROOF=true computes patch_id over BASE and HEAD at their
# merge base. A merge group then reads change-class-macos-proof-<patch_id>
# from a successful pull_request run. Its record must name the same patch,
# workflow and macos_patch=true. Tree proof remains the default contract.
#
# Two events can reuse a proof, and each names the run that proved it:
#   push         to the default branch, by the merge queue and nothing else:
#                the merge_group run whose head sha is the pushed sha. The
#                rules are hyprtrade's tools/ci-merge-proof: a non-forced push
#                whose actor and triggering actor are github-merge-queue[bot]
#                and whose `after` is the judged sha, and one completed
#                merge_group run of this workflow for that sha, successful,
#                from a gh-readonly-queue branch of the default branch.
#   merge_group  whose ref is the queue's branch for one pull request,
#                refs/heads/gh-readonly-queue/<default branch>/pr-<number>-<sha>:
#                a completed, successful pull_request run of this workflow
#                for that pull request at its current head.
# Either run is found by the record it left for this run's tree, and read
# back to be held to the rules above.
# Every other event, and either event outside those rules, is refused before
# any API call. The key is the tree. A pull request run tests the merge commit
# GitHub built for it, whose tree its record names; a merge group tests the
# base with the queued entries applied, by whatever merge method the queue
# uses. The two trees are equal where the base has not moved and no other
# entry sits ahead of this one, and a group whose tree differs finds no record
# of it. A tree carries the workflow file, so the same tree ran the same
# workflow.
#
# The record is the artifact `change-class-proof-<tree>` the classify step
# of the proving run uploaded, whose one member, `record`, holds the lines
# classify's header lists. Its content is read back through `unzip`.
#
# Environment:
#   EVENT  HEAD  REPO            as classify reads them
#   GITHUB_SHA                   the commit this run tests: the merge commit
#                                on pull_request, the group head on
#                                merge_group, `after` on push
#   GITHUB_REF                   the default branch on push, the queue
#                                branch on merge_group
#   GITHUB_REPOSITORY  GITHUB_ACTOR  GITHUB_TRIGGERING_ACTOR
#   GITHUB_WORKFLOW_REF          owner/repo/.github/workflows/<file>@ref
#   GITHUB_EVENT_PATH            the event payload: `forced`, `after` and
#                                `repository.default_branch`
#   GH_TOKEN                     the job token, read with actions: read
#
# Usage: proof WORKDIR — a directory the download may write in.
#
# Output, one `key=value` line each on stdout:
#   tree      the tree GITHUB_SHA names, empty where the checkout lacks it
#   workflow  this run's workflow file, .github/workflows/<file>, empty
#             where GITHUB_WORKFLOW_REF or GITHUB_REPOSITORY does not read
#             as one. tree and workflow are printed on every answer: the
#             record a run leaves needs both even where no proof is looked up.
#   patch_id  whitespace-preserving patch identity on opt-in requests and groups
#   kind      tree|macos-patch, which separates patch proof from tree proof
#   macos_contract  workflow and selector blob digest for opt-in proof
#   reuse     true|false
#   reason    `exact-proof` where reuse is true; otherwise one refusal key,
#             distinct per rule, so a reader never collapses them to a bit:
#             no-github-sha, tree-unreadable, invalid-input,
#             ineligible-event, event-unreadable, ineligible-push,
#             ineligible-merge-group, gh-unavailable, unzip-unavailable,
#             no-token, workflow-api-error, malformed-workflow,
#             runs-api-error, malformed-runs, missing-proof,
#             ambiguous-proof, mismatched-proof, artifacts-api-error,
#             malformed-artifacts, missing-record, expired-record,
#             record-download-error, record-unreadable, record-mismatch,
#             patch-unreadable
#   detail    what the refusal saw, for the log
#   run       the proving run's id where reuse is true
#   record    the path of the downloaded record where reuse is true
#
# This script decides and never gates: every refusal exits 0 with
# reuse=false, and the caller runs the lanes. Exit 2 is a call with no
# WORKDIR, or a WORKDIR that cannot be written.
set -euo pipefail
export LC_ALL=C

QUEUE_ACTOR='github-merge-queue[bot]'

[ "$#" -eq 1 ] && [ -d "$1" ] && [ -w "$1" ] ||
  { echo "proof: usage: proof WORKDIR" >&2; exit 2; }
WORK="$1"

tree=""
workflow=""
patch_id=""
macos_contract=""
kind=tree
answer() { # REASON DETAIL [RUN RECORD]
  printf 'tree=%s\nworkflow=%s\nreuse=%s\nreason=%s\ndetail=%s\nrun=%s\nrecord=%s\n' \
    "$tree" "$workflow" "$([ "$1" = exact-proof ] && echo true || echo false)" \
    "$1" "$2" "${3:-}" "${4:-}"
  printf 'patch_id=%s\nkind=%s\nmacos_contract=%s\n' "$patch_id" "$kind" "$macos_contract"
  exit 0
}

# The tree this run tests and the workflow it runs, first: the record a pull
# request run leaves needs both even where no proof is looked up.
[ -n "${GITHUB_SHA:-}" ] || answer no-github-sha "GITHUB_SHA is unset"
tree="$(git -C "${REPO:?}" rev-parse --verify --quiet "$GITHUB_SHA^{tree}" 2>/dev/null)" ||
  answer tree-unreadable "sha=$GITHUB_SHA is not in the judged checkout"
repo="${GITHUB_REPOSITORY:-}"
workflow_path="${GITHUB_WORKFLOW_REF:-}"
workflow_path="${workflow_path#"$repo/"}"
workflow_path="${workflow_path%%@*}"
repo_re='^[0-9A-Za-z_.-]+/[0-9A-Za-z_.-]+$'
path_re='^\.github/workflows/[^/@]+$'
[[ "$repo" =~ $repo_re ]] &&
  [[ "$workflow_path" =~ $path_re ]] ||
  answer invalid-input "repository=$repo workflow=$workflow_path"
workflow="$workflow_path"
workflow_file="${workflow_path##*/}"

# The opt-in workflow runs its macOS selection on pull requests. Its
# portability record follows the patch while Linux tests the integrated tree.
if [ "${MACOS_PATCH_PROOF:-}" = true ]; then
  case "${EVENT:?}" in
    pull_request | merge_group)
      contract_blobs="$(git -C "$REPO" rev-parse --verify "$GITHUB_SHA:$workflow" &&
        git -C "$REPO" rev-parse --verify "$GITHUB_SHA:tools/ci-job-set")" ||
        answer patch-unreadable "the macOS workflow or selector is absent"
      macos_contract="$(printf '%s\n' "$contract_blobs" | git hash-object --stdin)" ||
        answer patch-unreadable "the macOS contract could not be hashed"
      patch_base="$(git -C "$REPO" merge-base "${BASE:-}" "${HEAD:-}" 2>/dev/null)" ||
        answer patch-unreadable "the diff endpoints have no readable merge base"
      patch_line="$(git -C "$REPO" diff --binary --no-ext-diff "$patch_base" "$HEAD" -- | git patch-id --verbatim)" ||
        answer patch-unreadable "git patch-id could not read the diff"
      patch_id="${patch_line%% *}"
      [[ "$patch_id" =~ ^[0-9a-f]{40}$ ]] ||
        answer patch-unreadable "git patch-id returned no single patch"
      [ "$EVENT" != merge_group ] || kind=macos-patch
      ;;
  esac
fi

# Eligibility, from the event alone, before any API call.
case "${EVENT:?}" in
  push | merge_group) ;;
  *) answer ineligible-event "event=$EVENT" ;;
esac
payload_field() { # JQ-PATH — the field as text, empty where absent or null
  jq -r "$1 | if . == null then \"\" else tostring end" "${GITHUB_EVENT_PATH:?}" 2>/dev/null
}
[ -n "${GITHUB_EVENT_PATH:-}" ] && [ -f "$GITHUB_EVENT_PATH" ] ||
  answer event-unreadable "GITHUB_EVENT_PATH=${GITHUB_EVENT_PATH:-} is no file"
default_branch="$(payload_field .repository.default_branch)" || default_branch=""
[ -n "$default_branch" ] ||
  answer event-unreadable "the payload names no repository.default_branch"

want_event=""
key_sha=""
pr_number=0
if [ "$EVENT" = push ]; then
  forced="$(payload_field .forced)" || forced=""
  after="$(payload_field .after)" || after=""
  detail="ref=${GITHUB_REF:-} actor=${GITHUB_ACTOR:-} triggering_actor=${GITHUB_TRIGGERING_ACTOR:-} forced=$forced after=$after"
  [ "${GITHUB_REF:-}" = "refs/heads/$default_branch" ] &&
    [ "${GITHUB_ACTOR:-}" = "$QUEUE_ACTOR" ] &&
    [ "${GITHUB_TRIGGERING_ACTOR:-}" = "$QUEUE_ACTOR" ] &&
    [ "$forced" = false ] && [ "$after" = "$GITHUB_SHA" ] ||
    answer ineligible-push "$detail"
  want_event=merge_group
  key_sha="$GITHUB_SHA"
else
  # The queue branch names the pull request this group ends with; GitHub
  # writes that ref, and no author field reaches it. A head that is not the
  # commit this run tests is refused.
  queue_re="^refs/heads/gh-readonly-queue/$default_branch/pr-([0-9]+)-[0-9a-f]+$"
  [ "${HEAD:-}" = "$GITHUB_SHA" ] ||
    answer ineligible-merge-group "head=${HEAD:-} sha=$GITHUB_SHA"
  [[ "${GITHUB_REF:-}" =~ $queue_re ]] ||
    answer ineligible-merge-group "ref=${GITHUB_REF:-} is no queue branch of $default_branch"
  pr_number="${BASH_REMATCH[1]}"
  want_event=pull_request
fi

command -v gh >/dev/null 2>&1 || answer gh-unavailable "no gh on PATH"
command -v unzip >/dev/null 2>&1 || answer unzip-unavailable "no unzip on PATH"
[ -n "${GH_TOKEN:-}" ] || answer no-token "GH_TOKEN is empty"

api() { # PATH [-f key=value]...
  gh api --method GET "$@"
}

# The workflow, so the runs read below are this workflow's and no other's.
workflow_json="$(api "repos/$repo/actions/workflows/$workflow_file")" ||
  answer workflow-api-error "GET actions/workflows/$workflow_file failed"
jq -e --arg path "$workflow_path" '
  ((.id | type) == "number") and (.id > 0) and (.path == $path) and (.state == "active")
' >/dev/null 2>&1 <<<"$workflow_json" ||
  answer malformed-workflow "the workflow read is not an active workflow at $workflow_path"
workflow_id="$(jq -r .id <<<"$workflow_json")"

# The id of the run on stdin where it may prove this tree, else nothing:
# this workflow, the wanted event, completed and successful, this repository
# at both ends; a queue run for the pushed sha, from a queue branch of the
# default branch; a pull request run whose pull request is the one the queue
# names, at the head that run tested. Every field a run must carry is checked
# here, so a refusal is never a missing field read as a match.
qualifying() {
  jq -r --arg repo "$repo" --arg sha "$key_sha" --arg path "$workflow_path" \
    --arg event "$want_event" --arg branch_re "^gh-readonly-queue/$default_branch/[^[:space:]]+$" \
    --argjson workflow_id "$workflow_id" --argjson pr "$pr_number" '
  select(
    ((.id | type) == "number") and (.id > 0) and
    (.workflow_id == $workflow_id) and (.event == $event) and
    (.status == "completed") and (.conclusion == "success") and
    (.path == $path) and ((.head_sha | type) == "string") and
    ((.head_branch | type) == "string") and
    ($event != "merge_group" or ((.head_sha == $sha) and (.head_branch | test($branch_re)))) and
    ($event != "pull_request" or (.head_sha as $head | any(.pull_requests[]?; .number == $pr and .head.sha == $head))) and
    (.repository.full_name == $repo) and (.head_repository.full_name == $repo))
  | .id' 2>/dev/null
}

# The record in artifact ARTIFACT of run RUN, downloaded and held to this
# run's tree and workflow; the answer either way.
take_record() { # ARTIFACT RUN
  gh api "repos/$repo/actions/artifacts/$1/zip" >"$WORK/record.zip" ||
    answer record-download-error "GET artifact $1 of run $2 failed"
  unzip -p "$WORK/record.zip" record >"$WORK/record" 2>/dev/null ||
    answer record-unreadable "artifact $1 of run $2 holds no readable record"
  recorded_tree="$(sed -n 's/^tree=//p' "$WORK/record")" || recorded_tree=""
  recorded_workflow="$(sed -n 's/^workflow=//p' "$WORK/record")" || recorded_workflow=""
  if [ "$kind" = macos-patch ]; then
    if ! recorded_contract="$(sed -n 's/^macos_contract=//p' "$WORK/record")" ||
      ! recorded_patch="$(sed -n 's/^patch_id=//p' "$WORK/record")" ||
      ! recorded_macos="$(sed -n 's/^macos_patch=//p' "$WORK/record")" ||
      ! recorded_event="$(sed -n 's/^event=//p' "$WORK/record")"; then
      answer record-unreadable "artifact $1 of run $2 holds no readable macOS proof fields"
    fi
    [ "$recorded_contract" = "$macos_contract" ] || answer record-mismatch "run $2 changed the macOS contract"
    [ "$recorded_patch" = "$patch_id" ] && [ "$recorded_macos" = true ] &&
      [ "$recorded_event" = pull_request ] && [ "$recorded_workflow" = "$workflow_path" ] ||
      answer record-mismatch "run $2 recorded patch=$recorded_patch macos=$recorded_macos event=$recorded_event workflow=$recorded_workflow"
  else
  [ "$recorded_tree" = "$tree" ] && [ "$recorded_workflow" = "$workflow_path" ] ||
    answer record-mismatch "run $2 recorded tree=$recorded_tree workflow=$recorded_workflow"
  fi
  answer exact-proof "run=$2 event=$want_event artifact=$1" "$2" "$WORK/record"
}

artifact_name="change-class-proof-$tree"
[ "$kind" != macos-patch ] || artifact_name="change-class-macos-proof-$patch_id"

# A push reuses one run: the queue made one group for the sha it pushed, and
# two say the sha was tested under two states this script cannot tell apart.
if [ "$EVENT" = push ]; then
  runs_json="$(api "repos/$repo/actions/workflows/$workflow_id/runs" \
    -f "event=$want_event" -f status=completed -f "head_sha=$key_sha" -f per_page=100)" ||
    answer runs-api-error "GET workflow $workflow_id runs for $want_event head_sha=$key_sha failed"
  jq -e '
    ((.total_count | type) == "number") and (.total_count >= 0) and
    ((.workflow_runs | type) == "array") and (.total_count == (.workflow_runs | length))
  ' >/dev/null 2>&1 <<<"$runs_json" ||
    answer malformed-runs "the runs read is not a whole list"
  if ! run_count="$(jq -r '.workflow_runs | length' <<<"$runs_json" 2>/dev/null)"; then
    answer malformed-runs "the runs read could not be counted"
  fi
  [ "$run_count" -gt 0 ] ||
    answer missing-proof "no completed $want_event run of $workflow_file for $key_sha"
  [ "$run_count" -eq 1 ] ||
    answer ambiguous-proof "$run_count completed merge_group runs for $key_sha"
fi

# This tree's records across the repository's runs, newest first as the API
# lists them; each names the run that left it, which must qualify.
artifacts_json="$(api "repos/$repo/actions/artifacts" -f "name=$artifact_name" -f per_page=100)" ||
  answer artifacts-api-error "GET artifacts named $artifact_name failed"
jq -e '(.artifacts | type) == "array"' >/dev/null 2>&1 <<<"$artifacts_json" ||
  answer malformed-artifacts "the artifacts read of $artifact_name is not a list"
if ! live="$(jq -r --arg name "$artifact_name" '
  .artifacts[] | select(.name == $name and .expired == false)
  | "\(.id | numbers):\(.workflow_run.id | numbers)"' <<<"$artifacts_json" 2>/dev/null)"; then
  answer malformed-artifacts "an artifact named $artifact_name could not be read"
fi
if [ -z "$live" ]; then
  if ! expired="$(jq -r --arg name "$artifact_name" '[.artifacts[] | select(.name == $name and .expired == true)] | length' <<<"$artifacts_json" 2>/dev/null)"; then
    answer malformed-artifacts "an artifact named $artifact_name could not be read"
  fi
  [ "$expired" = 0 ] || answer expired-record "every $artifact_name has expired"
  answer missing-record "no run carries $artifact_name"
fi
seen=""
for pair in $live; do
  artifact="${pair%%:*}" run_id="${pair#*:}"
  run_json="$(api "repos/$repo/actions/runs/$run_id")" ||
    answer runs-api-error "GET run $run_id failed"
  qualified="$(qualifying <<<"$run_json")" ||
    answer malformed-runs "run $run_id could not be read"
  [ "$qualified" != "$run_id" ] || take_record "$artifact" "$run_id"
  seen="$seen $run_id"
done
answer mismatched-proof "none of runs$seen carrying $artifact_name is the successful $want_event run of this workflow that may prove this $EVENT"
