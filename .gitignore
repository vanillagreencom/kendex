/target
node_modules
dist
.claude/settings.local.json
tmp/
# The harness trees are TRACKED, and so is the install record beside them
# (.kendex-lock.json). What sits in the trees is either a real directory a
# `source = "in-place"` declaration names, or a render of a package this
# checkout is the source of; both have to survive a clone, and `kendex
# refresh` regenerates the renders and writes the record. The links into
# .agents/skills are relative, so they resolve in any checkout.
.env.local

# The linear skill's local cache. Bare, not `.cache/`. A trailing-slash
# pattern matches a real directory but not a symlink pointing at one, and
# every worktree links this path (WORKTREE_SYMLINKS).
.cache

# Filled-in local working copies of docs (backed up privately, never committed).
docs/*-local.md
# Plan drafts stay local in this repository; docs/plans is persistent content in consumer repositories only.
docs/plans/

# Python bytecode caches, written beside any script this repo runs with python3
__pycache__/
*.pyc
# kendex:local-state begin
/tmp/
/.cache/
/.kendex-lock.v10.json
# kendex:local-state end
