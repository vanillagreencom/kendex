working/
HT-AGENTS.md
.env.local
.env.npm
.cache/
ht/
cli/target/
target/
tmp/
trees/
docs/work-in-progress/
docs/plans/
# Session handoffs (docs/handoff/README.md). Local operator state: exactly one
# untracked HANDOFF.md; only the README documenting the pattern is tracked.
/docs/handoff/*
!/docs/handoff/README.md

# Harness install/runtime mirrors; canonical source lives elsewhere.
# Match files, directories, and symlinks so worktree links stay invisible.
/.agents
/.agents/**
/.claude
/.claude/**
/.cursor
/.cursor/**
/.codex/**
!/.codex/environments/
!/.codex/environments/environment.toml
/.opencode
/.opencode/**
/.pi/**
!/.pi/prompts/
!/.pi/prompts/*.md
/opencode.json

# npm artifacts (pi-extensions are published to npm)
node_modules/
*.tgz
npm-debug.log*
yarn-error.log
.pnpm-debug.log

# Stray tsc emit next to pi-extension TS sources (Pi loads .ts directly).
# Intentional bundles (pi-claude-bridge/bundle, pi-session-bridge/bin) are
# whitelisted below.
pi-extensions/*/extensions/**/*.js
pi-extensions/*/extensions/**/*.js.map
pi-extensions/*/extensions/**/*.d.ts
!pi-extensions/pi-claude-bridge/bundle/**
!pi-extensions/pi-session-bridge/bin/**

# OS / editor junk
.DS_Store
Thumbs.db
*.swp
*.swo

# Local vstack install state (per-checkout absolute paths; do not commit)
.vstack-lock.json
# vstack-local.toml is deliberately NOT ignored: it holds this repo's own agent
# config (no machine-specific paths) and is only separate from vstack.toml
# because that file is the source catalog consumers read. See its header.

# Filled workspace copies of portable doc templates — never committed (vstack
# is portable/public). Pattern: tracked template docs/<name>.md, untracked
# filled copy docs/<name>-local.md, gist-backed per the file's own header.
docs/*-local.md
