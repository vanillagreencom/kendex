/target
node_modules
dist
.claude/settings.local.json
tmp/
docs/roadmaps/
docs/plans/
docs/handoff/
docs/reviews/

# The harness trees are TRACKED. What sits there is either a real directory
# a `source = "in-place"` declaration names, or a render of a package this
# checkout is the source of; both have to survive a clone, and `kendex
# refresh` regenerates the renders. The links into .agents/skills are
# relative, so they resolve in any checkout. The one row this posture still
# needs is the install ledger at the bottom, which `kendex refresh` writes
# here itself.
.env.local

# The linear skill's local cache. Bare, not `.cache/`. A trailing-slash
# pattern matches a real directory but not a symlink pointing at one, and
# every worktree links this path (WORKTREE_SYMLINKS).
.cache

# Filled-in local working copies of docs (backed up privately, never committed).
docs/*-local.md

# kendex: this machine's install ledger — the .agents trees and the
# links into them are committed, so a clone works without kendex.
/.kendex-lock.json

# Python bytecode caches, written beside any script this repo runs with python3
__pycache__/
*.pyc
