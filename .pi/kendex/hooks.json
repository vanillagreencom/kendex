{
  "hooks": {
    "tool_call": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.pi/kendex/hooks/block-bare-cd.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.pi/kendex/hooks/pre-commit-check.sh\"",
            "timeout": 60
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.pi/kendex/hooks/block-repo-copy.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.pi/kendex/hooks/block-argv-kill.sh\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash \"$(git rev-parse --show-toplevel)/.pi/kendex/hooks/block-worktree-refresh.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
