{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kendex",
  "version": "5.0.1",
  "identifier": "ai.kendex.app",
  "build": {
    "beforeDevCommand": {
      "cwd": "../../ui",
      "script": "npm run dev"
    },
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": {
      "cwd": "../../ui",
      "script": "npm run build"
    },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kendex",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
