{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "kendex",
  "version": "1.0.1",
  "identifier": "ai.kendex.app",
  "build": {
    "beforeDevCommand": {
      "cwd": "../../ui",
      "script": "npm run dev"
    },
    "devUrl": "http://localhost:5273",
    "beforeBuildCommand": {
      "cwd": "../../ui",
      "script": "npm run build"
    },
    "frontendDist": "../../ui/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "kendex",
        "width": 1280,
        "height": 840,
        "minWidth": 900,
        "minHeight": 600,
        "decorations": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["kendex"]
      }
    },
    "updater": {
      "endpoints": [
        "https://github.com/vanillagreencom/kendex/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM5MjJDODkxNzhCN0M2Q0MKUldUTXhyZDRrY2dpeVlJNDJ6VFlmbEFwQ0g5ZlRzOWp0TWNZSFZlSnJDSWtUWGZuZHE3K0ZxSG8K",
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "app", "dmg", "nsis"],
    "createUpdaterArtifacts": true,
    "category": "DeveloperTool",
    "shortDescription": "Package manager for AI coding agents, skills, and hooks",
    "longDescription": "Installs and manages agents, skills, hooks, commands, MCP servers, plugins and Pi extensions for AI coding tools, in a global scope and per project.",
    "homepage": "https://kendex.ai",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": [
          "git (>= 1:2.41)"
        ]
      },
      "rpm": {
        "depends": [
          "git"
        ]
      }
    }
  }
}
