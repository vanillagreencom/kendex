# This file is your skill's settings declaration, not a settings file anyone
# edits. Ship it at your skill's root: seeding runs for skills only, and the
# same file under an agent, hook, command or MCP server installs without
# seeding anything. On a project install kendex merges each key below — with
# the comment block directly above it — into the consuming repo's
# `kendex.settings.toml`. A key already assigned there is left as it is, and
# no install rewrites a value; users edit theirs in that file, not here.
#
# Commit-safe values only. A value that must stay out of git (a token, a
# credential, a personal identifier) never appears here as an assignment:
# name it in your SKILL.md as "set `MY_SKILL_TOKEN` in `.env.local`" — that
# body is what a marketplace page shows for a skill.
#
# Grammar: one `[env]` table; a comment block immediately above every key,
# with no blank line and no other assignment between them; every value a
# single-line double-quoted string containing no `"` and no `\`. Seeding takes
# whatever it recognizes and says nothing about the rest, so run
# `kendex marketplace check` on your catalog: it reads this file strictly.

[env]

# Prefix your keys with the skill name, upper-snake. This comment is what
# the consumer reads beside the key in their own settings file, so say what
# the key does and what an empty value means.
MY_SKILL_TIMEOUT = "30"
