# This file is your package's settings declaration, not a settings file
# anyone edits. Ship it at the package root. On a project install kendex
# merges each key below — with the comment block directly above it — into
# the consuming repo's `kendex.settings.toml`, and never overwrites a key
# that is already there. Users edit their values in that file, not here.
#
# Commit-safe values only. A value that must stay out of git (a token, a
# credential, a personal identifier) never appears here as an assignment:
# document it in your package's README as "set `MY_PACKAGE_TOKEN` in
# `.env.local`", which the marketplace page renders.
#
# Grammar: one `[env]` table; a comment block immediately above every key,
# with no blank line between them; every value a single-line double-quoted
# string containing no `"` and no `\`.

[env]

# Prefix your keys with the package name, upper-snake. This comment is what
# the consumer reads beside the key in their own settings file, so say what
# the key does and what an empty value means.
MY_PACKAGE_TIMEOUT = "30"
