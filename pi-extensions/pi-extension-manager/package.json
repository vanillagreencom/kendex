{
  "name": "@vanillagreen/pi-extension-manager",
  "version": "2.0.0",
  "description": "Pi package manager and settings editor with native oh-my-pi plugin inventory and enable controls.",
  "license": "MIT",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "extensions",
    "settings"
  ],
  "pi": {
    "extensions": [
      "./extensions/extension-manager.ts"
    ],
    "image": "https://raw.githubusercontent.com/vanillagreencom/kendex/main/pi-extensions/pi-extension-manager/assets/extension-manager-popup.png"
  },
  "kendex": {
    "extensionManager": {
      "displayName": "Extension Manager",
      "settings": [
        {
          "key": "enabled",
          "label": "Enable manager UI",
          "description": "Global-only, regardless of package scope: expose /extensions on Pi or /kendex:extensions on oh-my-pi. Project values are ignored. The command's :enable recovery action remains available when disabled.",
          "type": "boolean",
          "default": true,
          "category": "General",
          "apply": "reload",
          "requiresReload": true
        },
        {
          "key": "glyphStyle",
          "label": "Glyph style",
          "description": "Glyphs for kendex-owned UI chrome. Unicode is the default; ASCII uses plain box/status/separator characters for terminal compatibility. On Pi, pi-tool-renderer's global override wins when set.",
          "type": "enum",
          "enumValues": [
            "unicode",
            "ascii"
          ],
          "default": "unicode",
          "category": "Rendering",
          "apply": "live"
        },
        {
          "key": "defaultSaveScope",
          "label": "Default save scope",
          "description": "Where manager setting edits are written when the selected item scope is ambiguous.",
          "type": "enum",
          "enumValues": [
            "project",
            "user"
          ],
          "default": "project",
          "category": "Persistence",
          "apply": "live"
        },
        {
          "key": "notifyOnUpdates",
          "label": "Notify on extension updates",
          "description": "Pi only: at session start, notify about newer versions from kendex sources or npm. Package updates are not supported on oh-my-pi.",
          "type": "boolean",
          "default": true,
          "category": "Updates",
          "apply": "live"
        }
      ]
    }
  },
  "scripts": {
    "test": "bun test ./test"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "@oh-my-pi/pi-coding-agent": ">=18.1.11",
    "@oh-my-pi/pi-utils": ">=18.1.11"
  },
  "files": [
    "assets/",
    "extensions/",
    "README.md",
    "package.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vanillagreencom/kendex.git",
    "directory": "pi-extensions/pi-extension-manager"
  },
  "homepage": "https://github.com/vanillagreencom/kendex/tree/main/pi-extensions/pi-extension-manager",
  "bugs": {
    "url": "https://github.com/vanillagreencom/kendex/issues"
  },
  "author": "vanillagreen",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-utils": {
      "optional": true
    }
  }
}
