#!/usr/bin/env bash
# Build a shipped runtime crate from its sources into a user-owned cache,
# keyed by those sources, and make the complete binary visible at once. usage()
# is the contract. A wrapper that finds no binary (scripts/agent-runtime, or
# the wrapper of a crate that depends on this one, such as orch's
# scripts/orch-runtime) runs this script first where cargo is on PATH, and
# otherwise names it; a caller that must answer while the binary is missing,
# such as a harness hook, finds it absent through lib/key.sh before calling
# the wrapper and runs --detach instead, which starts the build beside it and
# answers at once.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: setup [--runtime DIR] [--name NAME] [--offline]
       setup --detach [--hold PATH] [--cap SECONDS] [--runtime DIR] [--name NAME] [--offline]
  --runtime DIR    the crate to build: its Cargo.toml, Cargo.lock and src/
                   (default: the runtime beside this script)
  --name NAME      the binary the crate builds, and the cache entry's name
                   (default: agent-runtime)
  --offline        pass --offline to cargo: no network, so every locked
                   dependency must already sit in the cargo cache
  --detach         start the build in the background and answer at once
  --hold PATH      with --detach: what the caller cannot serve without the
                   binary, such as a mailbox directory; the answer holds the
                   caller while PATH exists
  --cap SECONDS    with --detach: the build's bound (default 1200); a build
                   still running past it is ended and read as unbuilt

Computes the crate's build key (lib/key.sh: one sha256 over Cargo.toml,
Cargo.lock, every file under src/, and the same inputs of every path
dependency the manifest declares), builds with `cargo build --release
--locked` into <cache>/build/<name>/<key> and places the binary at
<cache>/bin/<name>-<key>. <cache> is $AGENT_RUNTIME_CACHE, else
$XDG_CACHE_HOME/kendex/agent-runtime, else ~/.cache/kendex/agent-runtime.
A binary already at that path is kept and nothing is built. The build's
own stderr passes through. Where rustup answers for an installed toolchain
and the manifest states a rust-version, the build runs on the first installed toolchain whose rustc
is at or above it, never the caller's rust-toolchain.toml.

Prints one line on success:
  <name>-setup: key=<key> binary=<path>
A failure prints one keyed line on stderr and exits 1:
  <name>-setup: <key> field=value ...
Keys: usage, runtime-missing, cargo-missing, digest-tool-missing,
inputs-missing, inputs-unreadable, manifest-unreadable, digest-failed,
cache-unwritable, toolchain-missing (its fix= names the rustup install, to
the line's end), build-failed, binary-missing, place-failed. bin/ never
holds a partial binary: setup stages the copy beside the target and links it
into place once complete. A concurrent placement keeps the existing file.

--detach runs at most one build per key on the computer: the first caller
claims <cache>/build/<name>/<key>.lock and runs this setup outside its own
process group, the output in <cache>/build/<name>/<key>.log; a caller that
finds the claim standing starts nothing. It prints one line:
  <name>-setup: key=<key> binary=<path>
  <name>-setup: runtime-building key=<key> log=<path>
  <name>-setup: runtime-unbuilt cause=<cause> key=<key> log=<path>
Causes: build-failed (the build's own keyed line is the log's last),
build-capped, build-lost (the build ended leaving no record), cargo-missing.
A build that ends unbuilt is recorded in
<cache>/build/<name>/<key>.failed and --detach starts that key no more: a
setup without --detach is the remedy, and its success clears the record.
Every answer exits 0, except with --hold PATH while PATH exists: a running
build exits 3 every time, and an unbuilt key exits 3 once per PATH and
cause, then 0. With PATH absent nothing is printed.

After a build, setup removes every other key of <name> that nothing uses:
its <cache>/bin/<name>-<key>, its <cache>/build/<name>/<key> folder and the
key's .lock, .log, .failed and .told-* files. A key is in use while a
running process's arguments name it, while a running cargo builds a runtime
whose sources key to it, or while a recorded checkout resolves to it: the
home directory, and each folder `kendex project list --json` names with
every worktree of its repository, each read through its skills/*/runtime,
.<dir>/skills/*/runtime and .<dir>/<dir>/skills/*/runtime sources. Setup
also keeps a key whose build holds its claim, a binary whose dep-info names
no source it was built from, a build folder with neither a binary nor a
.failed record (a build in flight), and a binary with no build folder
(installed from elsewhere). Where the build's own runtime, or a checkout a
binary's dep-info (cargo's record of the sources it was built from) names
that still stands, lies outside the recorded ones, such as a hosted lane's
clone, the host holds checkouts its record does not cover, and setup removes
nothing (cause checkout-unrecorded). Where it cannot read the processes, the project list,
a repository's worktrees or a source's key, it also removes nothing. Either
way it prints on stderr:
  <name>-setup: prune-skipped cause=<cause> [field=value ...]
Causes: processes-unread, kendex-missing, jq-missing, projects-unread,
project-unreadable, git-missing, worktrees-unread, key-unread,
checkout-unrecorded.
USAGE
}

# The seconds a claim may stand before its build has taken it: the build
# takes it within milliseconds, so one older was left by a caller killed
# between the two.
CLAIM_GRACE=10
# A detached build's bound where --cap names none: a first build that
# compiles every locked dependency runs for minutes, and a held caller waits
# no longer than this.
BUILD_CAP=1200

here="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)"
name=agent-runtime
runtime_arg="$here/../runtime"
detach=0
hold=""
cap=""

refuse() { # KEY FIELD=VALUE...
  local key="$1"
  shift
  printf '%s-setup: %s%s\n' "$name" "$key" "${*:+ $*}" >&2
  exit 1
}

# claim_lost LOCK: 0 where the build that made the claim at LOCK is gone:
# its process has ended, or it never took a claim CLAIM_GRACE seconds old.
# Sets claim_start, claim_cap and claim_pid from the claim's numbers.
claim_lost() { # LOCK
  local claim
  claim="$(readlink -- "$1" 2>/dev/null)" || claim=""
  # shellcheck disable=SC2086 # the claim's numbers, split on purpose
  set -- $claim
  claim_start="${1:-}" claim_cap="${2:-}" claim_pid="${3:-}"
  case "$#" in
    3) ! kill -0 "$3" 2>/dev/null ;;
    2) [ "$(($(date +%s) - $1))" -ge "$CLAIM_GRACE" ] ;;
    *) return 0 ;;
  esac
}

# prune: usage()'s removal after a build, run in a subshell so no read in it
# can end the setup. It removes only what it proved unused; every read it
# cannot finish removes nothing.
prune() (
  skip() { printf '%s-setup: prune-skipped cause=%s\n' "$name" "$*" >&2; exit 0; }
  is_key() { [ "${#1}" -eq 64 ] && case "$1" in *[!0-9a-f]*) return 1 ;; esac; }
  candidates=""
  for path in "$cache/bin/$name-"* "$builds/"*; do
    [ -e "$path" ] || [ -L "$path" ] || continue
    base="${path##*/}"
    case "$path" in
      "$cache/bin/"*) base="${base#"$name-"}" ;;
      *) base="${base%%.*}" ;;
    esac
    is_key "$base" && [ "$base" != "$key" ] || continue
    case " $candidates " in *" $base "*) ;; *) candidates="$candidates $base" ;; esac
  done
  [ -n "$candidates" ] || exit 0

  # A placed program runs with its own path as argv[0] (the wrappers exec
  # it, and the runtime's own exec passes its path), so its key is in the
  # arguments ps prints for every process; ps prints itself at the least.
  # -ww: without it procps cuts each line at an exported COLUMNS, which can
  # fall inside the key.
  procs="$(ps -A -ww -o args= 2>/dev/null)" && [ -n "$procs" ] || skip processes-unread

  # Every runtime source to key, each once by its resolved path.
  sources=""
  in_list() { # LIST ITEM
    case "
$1
" in *"
$2
"*) return 0 ;; esac
    return 1
  }
  resolve() { # RUNTIME — sets resolved
    resolved="$(cd -- "$1" 2>/dev/null && pwd -P)" || skip key-unread "runtime=$1"
  }
  add_source() { # RUNTIME
    [ -f "$1/Cargo.toml" ] || return 0
    resolve "$1"
    in_list "$sources" "$resolved" || sources="$sources
$resolved"
  }

  # The checkouts: the home directory's global skills, and each project
  # kendex records with every worktree of its repository, since a lane's
  # worktree resolves its own key.
  command -v kendex >/dev/null 2>&1 || skip kendex-missing
  command -v jq >/dev/null 2>&1 || skip jq-missing
  list="$(kendex project list --json 2>/dev/null)" || skip projects-unread
  rows="$(printf '%s\n' "$list" | jq -r 'if type == "array" then .[] | [.state, .folder] | @tsv else error("not an array") end' 2>/dev/null)" ||
    skip projects-unread
  unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE GIT_INDEX_FILE
  # Each root once: every worktree of a repository lists them all.
  roots=""
  add_root() {
    case "
$roots
" in *"
$1
"*) ;; *) roots="$roots
$1" ;; esac
  }
  add_root "${HOME:-}"
  tab="$(printf '\t')"
  while IFS= read -r row; do
    [ -n "$row" ] || continue
    state="${row%%"$tab"*}"
    folder="${row#*"$tab"}"
    case "$state" in
      ok) ;;
      folder-not-found | not-a-folder) continue ;;
      *) skip project-unreadable "folder=$folder" ;;
    esac
    case "$folder" in /*) ;; *) skip project-unreadable "folder=$folder" ;; esac
    [ -d "$folder" ] || skip project-unreadable "folder=$folder"
    add_root "$folder"
    # A folder in no repository has no other worktree.
    up="$folder"
    while [ -n "$up" ] && [ ! -e "$up/.git" ]; do up="${up%/*}"; done
    [ -n "$up" ] || [ -e /.git ] || continue
    command -v git >/dev/null 2>&1 || skip git-missing
    prefix="$(git -C "$folder" rev-parse --show-prefix 2>/dev/null)" || skip worktrees-unread "folder=$folder"
    trees="$(git -C "$folder" worktree list --porcelain 2>/dev/null)" || skip worktrees-unread "folder=$folder"
    while IFS= read -r line; do
      case "$line" in "worktree "*) ;; *) continue ;; esac
      tree="${line#worktree }/$prefix"
      [ ! -d "$tree" ] || add_root "${tree%/}"
    done <<EOF
$trees
EOF
  done <<EOF
$rows
EOF
  # A checkout's skills sit in the shared .agents/skills, in a source
  # catalog's skills/, or in a tool's own directory under a copy delivery
  # (.claude/skills, .codex/skills, .pi/agent/skills and the like).
  while IFS= read -r root; do
    [ -n "$root" ] || continue
    for source in "$root"/skills/*/runtime "$root"/.[!.]*/skills/*/runtime "$root"/.[!.]*/*/skills/*/runtime; do
      add_source "$source"
    done
  done <<EOF
$roots
EOF
  recorded="$sources"
  # A build from a checkout outside the recorded ones, as a hosted lane's
  # clone is, shows the same: checkouts the record misses use this cache.
  in_list "$recorded" "$runtime" || skip checkout-unrecorded "runtime=$runtime"

  # A build that holds no claim, a setup without --detach, is a cargo whose
  # arguments name the runtime's manifest.
  building="$(printf '%s\n' "$procs" | sed -n 's#.*--manifest-path \(/.*\)/Cargo\.toml.*#\1#p')"
  while IFS= read -r source; do
    [ -z "$source" ] || add_source "$source"
  done <<EOF
$building
EOF

  # The checkout a candidate was built from, read from the dep-info file
  # cargo leaves beside the binary, which lists the absolute path of every
  # source file the binary was built from, a space escaped as `\ `
  # (https://doc.rust-lang.org/cargo/reference/build-cache.html#dep-info-files).
  # The crate's own is the one whose src/main.rs it lists: a dependency
  # contributes its library alone. A builder that still stands outside the
  # recorded checkouts, such as a hosted lane's clone, shows the host holds
  # checkouts its record does not cover, any of which may share a key the
  # dep-info names for another: nothing on this host is proved unused.
  unrecorded=" "
  for candidate in $candidates; do
    [ -d "$builds/$candidate" ] && [ -e "$cache/bin/$name-$candidate" ] || continue
    builders=""
    [ ! -f "$builds/$candidate/release/$name.d" ] ||
      builders="$(awk '{ gsub(/\\ /, "\001"); for (i = 1; i <= NF; i++) { f = $i; gsub(/\001/, " ", f)
        if (f ~ /^\/.*\/src\/main\.rs$/) { sub(/\/src\/main\.rs$/, "", f); print f } } }' \
        "$builds/$candidate/release/$name.d" 2>/dev/null)" || builders=""
    if [ -z "$builders" ]; then
      unrecorded="$unrecorded$candidate "
      continue
    fi
    while IFS= read -r builder; do
      [ -f "$builder/Cargo.toml" ] || continue
      resolve "$builder"
      in_list "$recorded" "$resolved" || skip checkout-unrecorded "runtime=$builder"
    done <<EOF
$builders
EOF
  done

  keep=" "
  while IFS= read -r source; do
    [ -n "$source" ] || continue
    used="$(agent_runtime_key "$source" 2>/dev/null)" || skip key-unread "runtime=$source"
    keep="$keep$used "
  done <<EOF
$sources
EOF

  for candidate in $candidates; do
    case "$keep$unrecorded" in *" $candidate "*) continue ;; esac
    case "$procs" in *"$candidate"*) continue ;; esac
    if [ -L "$builds/$candidate.lock" ]; then claim_lost "$builds/$candidate.lock" || continue; fi
    program="$cache/bin/$name-$candidate"
    if [ -d "$builds/$candidate" ]; then
      # A setup without --detach builds under no claim.
      [ -e "$program" ] || [ -f "$builds/$candidate.failed" ] || continue
    else
      # A binary built elsewhere and installed here, as a lane-host provider
      # installs its workers' builds (lib/key.sh). Its .log and .told-* are
      # no build: a host without cargo writes them for its installed keys.
      [ ! -e "$program" ] || continue
    fi
    # The build folder goes first: one left over would hold its gigabytes,
    # a binary left over is kept as an installed one.
    rm -rf -- "${builds:?}/$candidate" || continue
    rm -f -- "$builds/$candidate".lock "$builds/$candidate".log "$builds/$candidate".failed \
      "$builds/$candidate".told-* "$program" || :
  done
)

offline=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --runtime) [ "$#" -ge 2 ] || refuse usage "argument=$1 wanted=DIR"; runtime_arg="$2"; shift ;;
    --name) [ "$#" -ge 2 ] && [ -n "$2" ] || refuse usage "argument=$1 wanted=NAME"; name="$2"; shift ;;
    --offline) offline=1 ;;
    --detach) detach=1 ;;
    --hold) [ "$#" -ge 2 ] && [ -n "$2" ] || refuse usage "argument=$1 wanted=PATH"; hold="$2"; shift ;;
    --cap)
      [ "$#" -ge 2 ] || refuse usage "argument=$1 wanted=SECONDS"
      case "$2" in '' | 0* | *[!0-9]*) refuse usage "argument=$1 wanted=SECONDS got=$2" ;; esac
      cap="$2"
      shift
      ;;
    -h | --help) usage; exit 0 ;;
    *) refuse usage "argument=$1" ;;
  esac
  shift
done
[ "$detach" -eq 1 ] || { [ -z "$hold" ] && [ -z "$cap" ]; } || refuse usage "argument=--hold|--cap wanted=--detach"
cap="${cap:-$BUILD_CAP}"
cargo_args=(build --release --locked)
[ "$offline" -eq 0 ] || cargo_args+=(--offline)

runtime="$(cd -- "$runtime_arg" 2>/dev/null && pwd -P)" || refuse runtime-missing "runtime=$runtime_arg"

# shellcheck source=lib/key.sh
. "$here/lib/key.sh"

cache="$(agent_runtime_cache)"
key="$(agent_runtime_key "$runtime")"
binary="$cache/bin/$name-$key"
builds="$cache/build/$name"
failed="$builds/$key.failed"

if [ "$detach" -eq 1 ]; then
  lock="$builds/$key.lock"
  log="$builds/$key.log"
  held=0
  [ -z "$hold" ] || [ ! -e "$hold" ] || held=1
  # answer WORD FIELDS... prints the one line and exits as usage() states.
  answer() {
    [ -n "$hold" ] && [ "$held" -eq 0 ] || printf '%s-setup: %s\n' "$name" "$*"
    [ "$held" -eq 1 ] || exit 0
    case "$1" in
      runtime-building) exit 3 ;;
      runtime-unbuilt)
        local cause told
        cause="${2#cause=}"
        told="$builds/$key.told-$(printf '%s' "$hold" | agent_runtime_digest)-$cause"
        [ ! -e "$told" ] || exit 0
        : >"$told" || exit 0
        exit 3
        ;;
    esac
    exit 0
  }
  unbuilt() { answer runtime-unbuilt "cause=$1" "key=$key" "log=$log"; }
  [ ! -x "$binary" ] || answer "key=$key" "binary=$binary"
  mkdir -p -- "$builds" "$cache/bin" || refuse cache-unwritable "path=$cache"
  # The claim is a symlink whose target is "<start> <cap>", then
  # "<start> <cap> <pid>" once the build has started: made in one call that
  # fails where one stands, on Linux and macOS alike, with no lock tool. A
  # build releases its claim only after writing its record, so a record is
  # read once the claim is held.
  start="$(date +%s)"
  if ln -s -- "$start $cap" "$lock" 2>/dev/null; then
    if [ -f "$failed" ]; then
      rm -f -- "$lock"
      unbuilt "$(cat -- "$failed")"
    fi
    if ! command -v cargo >/dev/null 2>&1; then
      rm -f -- "$lock"
      printf '%s-setup: cargo-missing key=%s\n' "$name" "$key" >"$log"
      unbuilt cargo-missing
    fi
    build=(--runtime "$runtime" --name "$name")
    [ "$offline" -eq 0 ] || build+=(--offline)
    # The build leads its own process group (`set -m` gives a background job
    # one, on Bash 3.2 as on 5), ignores SIGHUP and holds none of the
    # caller's descriptors: a harness that waits on its hook's output, or
    # signals the hook's group or session when it ends, never reaches it. It
    # bounds itself: past the cap it signals its own group, setup and cargo
    # with it, and records the cap.
    set -m
    (
      trap '' HUP
      me="$(exec sh -c 'echo "$PPID"')"
      ln -s -- "$start $cap $me" "$lock.$me"
      mv -f -- "$lock.$me" "$lock"
      "$here/setup" "${build[@]}" >"$log" 2>&1 &
      child=$!
      cause=""
      while kill -0 "$child" 2>/dev/null; do
        if [ "$(($(date +%s) - start))" -ge "$cap" ]; then
          cause="build-capped"
          trap '' TERM
          kill -TERM -- "-$me" 2>/dev/null || :
          break
        fi
        sleep 1
      done
      if [ ! -x "$binary" ]; then
        printf '%s\n' "${cause:-build-failed}" >"$failed.$me"
        mv -f -- "$failed.$me" "$failed"
      fi
      rm -f -- "$lock"
    ) </dev/null >/dev/null 2>&1 &
    set +m
    answer runtime-building "key=$key" "log=$log"
  fi
  # A claim stands. Its build runs while its process lives and its cap has
  # not passed; a claim whose build never took it is given CLAIM_GRACE
  # seconds. A claim whose build is gone without a record was lost (a
  # reboot, a kill): it is recorded so, and started again only when asked.
  if ! claim_lost "$lock"; then
    [ -n "$claim_pid" ] && [ "$(($(date +%s) - claim_start))" -ge "$claim_cap" ] ||
      answer runtime-building "key=$key" "log=$log"
    unbuilt build-capped
  fi
  [ ! -x "$binary" ] || answer "key=$key" "binary=$binary"
  [ -f "$failed" ] || { printf 'build-lost\n' >"$failed.$$" && mv -f -- "$failed.$$" "$failed"; } ||
    refuse cache-unwritable "path=$failed"
  rm -f -- "$lock"
  unbuilt "$(cat -- "$failed")"
fi

if [ -x "$binary" ]; then
  printf '%s-setup: key=%s binary=%s\n' "$name" "$key" "$binary"
  exit 0
fi

command -v cargo >/dev/null 2>&1 || refuse cargo-missing "key=$key"
# rustup applies the rust-toolchain.toml of the directory cargo runs in, a
# consumer's among them, so the build names its own toolchain from the
# crate's rust-version. A rustup that answers for no toolchain, such as under
# an isolated HOME, leaves the build as cargo resolves it.
if need="$(awk -F'"' '/^rust-version[[:space:]]*=/ { print $2; exit }' "$runtime/Cargo.toml")" &&
  [ -n "$need" ] && command -v rustup >/dev/null 2>&1; then
  toolchain=""
  answered=0
  for candidate in $(rustup toolchain list 2>/dev/null | awk '{ print $1 }'); do
    have="$(rustup run "$candidate" rustc --version 2>/dev/null)" || continue
    answered=1
    have="${have#rustc }"
    if awk -v h="${have%% *}" -v n="$need" 'BEGIN { split(h, a, "."); split(n, b, ".")
      for (i = 1; i <= 3; i++) if (a[i] + 0 != b[i] + 0) exit a[i] + 0 < b[i] + 0; exit 0 }'; then
      toolchain="$candidate"
      break
    fi
  done
  [ -n "$toolchain" ] || [ "$answered" -eq 0 ] || refuse toolchain-missing "rust-version=$need key=$key fix=rustup toolchain install $need"
  [ -z "$toolchain" ] || export RUSTUP_TOOLCHAIN="$toolchain"
fi
mkdir -p -- "$builds/$key" "$cache/bin" || refuse cache-unwritable "path=$cache"

status=0
CARGO_TARGET_DIR="$builds/$key" cargo "${cargo_args[@]}" \
  --manifest-path "$runtime/Cargo.toml" >/dev/null || status=$?
[ "$status" -eq 0 ] || refuse build-failed "status=$status key=$key"
built="$builds/$key/release/$name"
[ -f "$built" ] || refuse binary-missing "path=$built"

scratch="$(mktemp -d -- "$cache/bin/.setup.XXXXXXXX")" || refuse place-failed "path=$binary"
trap 'rm -rf -- "${scratch:?}"' EXIT
tmp="$scratch/${binary##*/}"
cat -- "$built" >"$tmp" || refuse place-failed "path=$tmp"
# The `--` comes before the mode: BSD chmod takes its first operand as the
# mode, so a `--` after it is a file operand nobody has.
chmod -- 755 "$tmp" || refuse place-failed "path=$tmp"
agent_runtime_place_binary "$tmp" "$binary" || refuse place-failed "path=$binary"
# A detached build of this key that ended unbuilt is answered by this build.
rm -f -- "$failed" "$builds/$key".told-*
prune || :
printf '%s-setup: key=%s binary=%s\n' "$name" "$key" "$binary"
