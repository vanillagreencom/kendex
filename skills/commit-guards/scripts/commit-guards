#!/usr/bin/env bash
# commit-guards — dispatcher for the check family:
#
#   commit-guards [all]            run every check named by COMMIT_GUARDS_CHECKS
#                                  over the whole tree
#   commit-guards [all] --staged   the same batch at commit scope
#   commit-guards [all] --base REF the same batch over the changes since REF
#   commit-guards [all] --against REF   the same batch over what those changes
#                                  would do to REF's own tree
#   commit-guards CHECK [ARGS..]   run one check, flags passed through
#
# --skip-unscoped withholds the checks the named scope leaves nothing for,
# rather than folding a clean count over content they never opened.
#
# commit-msg reads a message, so it never runs in the batch — the commit-msg
# hook invokes it directly. Batch aggregation fails closed: exit 2 if ANY
# check could not complete, else 1 if any found violations, else 0.
set -euo pipefail

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The trailing newline from `pwd` terminates its output; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="commit-guards"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"

KNOWN_CHECKS="todo-ban byte-ceiling suppression-ban conflict-markers changelog-entries prose md-format md-refs comments commit-msg"
BATCH_DEFAULT="todo-ban byte-ceiling suppression-ban conflict-markers changelog-entries prose md-format md-refs"
# The checks the batch hands --staged when it is asked for commit scope.
# todo-ban and comments default to the whole index, which is a CI subject:
# at commit each judges what the commit adds. md-format judges touched
# documents; md-refs checks every configured document for broken incoming
# references. The rest read the index by design.
STAGED_SCOPED_CHECKS="todo-ban byte-ceiling md-format md-refs comments"
# byte-ceiling is the one batch lane whose bare default is the commit scope,
# so the full batch names its scope outright: --all with no flag, --base REF
# or --against REF when the batch is given one. A batch summary that listed it
# clean over a scope it never read would be a verdict about nothing.
FULL_SCOPED_CHECKS="byte-ceiling"

usage() {
  gg_message usage "$GG_CHECK" "Command usage follows."
  cat <<EOF
usage: commit-guards [all] [--staged | --base REF | --against REF]
                     [--skip-unscoped] | CHECK [ARGS...]

Checks: $KNOWN_CHECKS

With no argument (or 'all'), runs every check named by
COMMIT_GUARDS_CHECKS (default: $BATCH_DEFAULT) over the whole tree:
$FULL_SCOPED_CHECKS gets --all, the rest read the index by design.
--base REF hands $FULL_SCOPED_CHECKS --base REF instead (CI on a PR), and
--against REF hands them --against REF (what the change does to REF's tree).
--staged is passed to: $STAGED_SCOPED_CHECKS.
--skip-unscoped withholds every check that selects its files from the staged
diff, naming each one, for a caller whose scope stages nothing. It is a
contradiction under --staged, which is the scope those checks read.
Those checks apply their own commit scope. md-refs checks all configured
documents for broken references, including unchanged callers.
commit-msg reads a message file/stdin and only runs by name.

Exit codes: 0 clean; 1 violations; 2 usage/config/collection error, or
any check that could not complete.
EOF
}

SCOPE_MODE="all"
BASE_REF=""
SKIP_UNSCOPED=0
if [ $# -ge 1 ]; then
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    all | --staged | --base | --base=* | --against | --against=* | --skip-unscoped) ;;
    *)
      CHECK="$1"
      shift
      case " $KNOWN_CHECKS " in
        *" $CHECK "*) exec "$SCRIPT_DIR/$CHECK" "$@" ;;
      esac
      gg_fail check-unknown "$CHECK" "unknown check '$CHECK' (known: $KNOWN_CHECKS)"
      ;;
  esac
fi

if [ "${1-}" = all ]; then shift; fi
SCOPE_FLAGS=0
while [ $# -gt 0 ]; do
  case "$1" in
    # Not a scope: it says which checks the scope can reach, so it does not
    # count toward the one-scope rule below.
    --skip-unscoped)
      SKIP_UNSCOPED=1
      shift
      continue
      ;;
    --staged) SCOPE_MODE="staged" ;;
    --base)
      [ $# -ge 2 ] || gg_fail argument-missing "--base" "--base requires a ref"
      shift
      SCOPE_MODE="base"
      BASE_REF="$1"
      ;;
    --base=*)
      SCOPE_MODE="base"
      BASE_REF="${1#--base=}"
      ;;
    --against)
      [ $# -ge 2 ] || gg_fail argument-missing "--against" "--against requires a ref"
      shift
      SCOPE_MODE="against"
      BASE_REF="$1"
      ;;
    --against=*)
      SCOPE_MODE="against"
      BASE_REF="${1#--against=}"
      ;;
    *) gg_fail argument-unknown "$1" "'all' takes only --staged, --base REF, --against REF or --skip-unscoped; invoke a single check to pass flags" ;;
  esac
  SCOPE_FLAGS=$((SCOPE_FLAGS + 1))
  shift
done
[ "$SCOPE_FLAGS" -le 1 ] || gg_fail scope-conflict "$SCOPE_FLAGS" "--staged, --base and --against name different scopes; pass one"
[ "$SKIP_UNSCOPED" -eq 0 ] || [ "$SCOPE_MODE" != "staged" ] \
  || gg_fail scope-contradiction "--staged,--skip-unscoped" "--staged IS the scope those checks read, so nothing is unscoped under it"

gg_repo_root_cd
CHECKS="$(gg_setting COMMIT_GUARDS_CHECKS "$BATCH_DEFAULT")" || exit 2
case "$CHECKS" in
  *[!\ ]*) ;;
  *) gg_fail checks-empty "COMMIT_GUARDS_CHECKS" "COMMIT_GUARDS_CHECKS resolved empty — name at least one check or unset it" ;;
esac
for c in $CHECKS; do
  case "$c" in
    commit-msg) gg_fail check-interactive "commit-msg" "commit-msg reads a message and cannot run in the batch; wire 'commit-guards commit-msg \"\$1\"' into the commit-msg hook instead" ;;
  esac
  case " $KNOWN_CHECKS " in
    *" $c "*) ;;
    *) gg_fail check-unknown "$c" "COMMIT_GUARDS_CHECKS names unknown check '$c' (known: $KNOWN_CHECKS)" ;;
  esac
done

# A check that selects its files from the STAGED diff reads nothing at all
# under a scope that stages nothing: it reports a count of zero and a clean
# verdict over content it never opened, which is the verdict about nothing
# this dispatcher exists not to give. A caller that knows its scope stages
# nothing asks for them to be withheld; each is named here, and the verdict
# record below lists only the checks that ran.
#
# Which checks those are is asked of each check's own script rather than
# listed here. A lane that starts resolving its scope through the shared
# markdown selector later must not rejoin the clean count in silence, and a
# second list here is how that happens.
MD_SELECTOR="lib/md-scope.sh"
if [ "$SKIP_UNSCOPED" -eq 1 ]; then
  KEPT=""
  WITHHELD=""
  for c in $CHECKS; do
    selector_status=0
    grep -q -- "$MD_SELECTOR" "$SCRIPT_DIR/$c" || selector_status=$?
    [ "$selector_status" -le 1 ] \
      || gg_fail selector-read "$c:$selector_status" "could not read $c to see how it resolves its scope; refusing to guess"
    if [ "$selector_status" -eq 0 ]; then
      WITHHELD="${WITHHELD:+$WITHHELD }$c"
      gg_message unscoped "$c" "This check selects its files from the staged diff, which this scope does not fill, so it would judge nothing. Withheld rather than counted clean."
      continue
    fi
    KEPT="${KEPT:+$KEPT }$c"
  done
  CHECKS="$KEPT"
  case "$CHECKS" in
    *[!\ ]*) ;;
    *)
      gg_message withheld-all "$WITHHELD" "Every enabled check selects its files from the staged diff, so this scope has nothing for any of them to judge."
      exit 0
      ;;
  esac
fi

had_violations=0
had_errors=0
for c in $CHECKS; do
  scope=()
  scope_desc=""
  case "$SCOPE_MODE" in
    staged)
      case " $STAGED_SCOPED_CHECKS " in
        *" $c "*) scope=(--staged) ;;
      esac
      ;;
    all)
      case " $FULL_SCOPED_CHECKS " in
        *" $c "*) scope=(--all) ;;
      esac
      ;;
    base)
      case " $FULL_SCOPED_CHECKS " in
        *" $c "*) scope=(--base "$BASE_REF") ;;
      esac
      ;;
    against)
      case " $FULL_SCOPED_CHECKS " in
        *" $c "*) scope=(--against "$BASE_REF") ;;
      esac
      ;;
  esac
  [ "${#scope[@]}" -eq 0 ] || scope_desc=" ${scope[*]}"
  gg_message step "$c$scope_desc" "Run the configured check."
  check_status=0
  "$SCRIPT_DIR/$c" ${scope[@]+"${scope[@]}"} || check_status=$?
  case "$check_status" in
    0) ;;
    1) had_violations=1 ;;
    *)
      had_errors=1
      gg_message incomplete "$c:$check_status" "The check did not complete."
      ;;
  esac
done

if [ "$had_errors" -eq 1 ]; then
  gg_message result 2 "Could not complete every check. Fix the errors above."
  exit 2
fi
if [ "$had_violations" -eq 1 ]; then
  gg_message result 1 "Violations found. See the failures above."
  exit 1
fi
gg_message result "0:$CHECKS" "Enabled checks are clean."
