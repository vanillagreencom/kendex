#!/usr/bin/env bash
# commit-msg — the whole commit-message gate over one message, built to sit
# directly in .git/hooks/commit-msg (it takes the message file git passes, or
# stdin). One rule, which only a commit-msg hook can carry because the waiver
# lives in the message:
#
#   changelog      a commit touching COMMIT_GUARDS_CHANGELOG_REQUIRED_PATHS
#                  writes a changelog entry, or says [no-changelog] in its
#                  header (the first non-blank, non-comment line)
#
# The rule runs over every header, git-generated ones included: a merge that
# carries code carries its entry.
#
# Exit codes: 0 pass; 1 violation; 2 usage/config/collection error (an
# unreadable message file is a collection error, never a pass).
set -euo pipefail
# Pathname expansion off: the configured paths are globs matched against the
# index, and splitting them into words would otherwise expand each against the
# work tree.
set -f

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The trailing newline from `pwd` terminates its output; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="commit-msg"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"
# shellcheck source=lib/commit-header.sh
source "$SCRIPT_DIR/lib/commit-header.sh"
# shellcheck source=lib/changelog-grammar.sh
source "$SCRIPT_DIR/lib/changelog-grammar.sh"
# shellcheck source=lib/commit-changes.sh
source "$SCRIPT_DIR/lib/commit-changes.sh"

usage() {
  gg_message usage "$GG_CHECK" "Command usage follows."
  cat <<'EOF'
usage: commit-msg [FILE]

Checks the commit message in FILE (or on stdin when FILE is absent or '-'):
a commit that touches the configured paths writes a changelog entry. Wire it
as .git/hooks/commit-msg: `commit-msg "$1"`.

Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  COMMIT_GUARDS_CHANGELOG_REQUIRED_PATHS
                               space-separated globs against the full
                               repo-relative path ('*' crosses '/'); a commit
                               that changes a matching path must also write a
                               changelog entry (default empty = rule off).
                               Both sets are read from the commit as a whole,
                               so where /proc is readable (not macOS) an amend
                               is judged against the parent it will have
  COMMIT_GUARDS_CHANGELOG_PATHS   what counts as a written entry, with
  COMMIT_GUARDS_CHANGELOG_RECORD  — the same two scopes the changelog-entries
                               check judges (defaults "changelog.d/*/*.md"
                               and "CHANGELOG.md"). The record counts only
                               under COMMIT_GUARDS_CHANGELOG_COLLATE=1, the
                               release commit's own declaration: any other
                               edit to it is not an entry
  COMMIT_GUARDS_CHANGELOG_PACKAGE_PATHS  declares packages; a fragment
                               a pattern places through its package slot is
                               that package's entry, never the program's

`[no-changelog]` anywhere in the header escapes the changelog rule.

Exit codes: 0 pass; 1 violation; 2 usage/config/collection error.
EOF
}

MSG_FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    --*) gg_fail argument-unknown "$1" "unknown argument $(gg_shown "$1") (see --help)" ;;
    *)
      [ -z "$MSG_FILE" ] || gg_fail message-extra "$1" "at most one message file (see --help)"
      MSG_FILE="$1"
      ;;
  esac
  shift
done

# Read the message BEFORE cd-ing to the repo root: the FILE argument (git
# passes .git/COMMIT_EDITMSG) is relative to the caller's directory.
if [ -z "$MSG_FILE" ] || [ "$MSG_FILE" = "-" ]; then
  message_status=0
  MSG="$(cat 2>&1)" || message_status=$?
  [ "$message_status" -eq 0 ] || gg_fail message-stdin "$message_status" "${MSG:-could not read the commit message from stdin}"
else
  [ -f "$MSG_FILE" ] || gg_fail message-missing "$MSG_FILE" "no such message file: $(gg_shown "$MSG_FILE")"
  # not-a-path: a commit message, and trailing blank lines are not part
  # of it — git strips them itself before the hook ever sees the file.
  message_status=0
  MSG="$(cat -- "$MSG_FILE" 2>&1)" || message_status=$?
  [ "$message_status" -eq 0 ] || gg_fail message-read "$MSG_FILE" "${MSG:-could not read the commit message file: $(gg_shown "$MSG_FILE")}"
fi

gg_repo_root_cd
# The accepted rules are the ones the commit carries, not an unstaged edit.
gg_settings_index_mode

REQUIRED_RAW="$(gg_setting COMMIT_GUARDS_CHANGELOG_REQUIRED_PATHS "")" || exit 2
REQUIRED="$(gg_config_path_list "$REQUIRED_RAW" changelog-required)" || exit 2

# --- a commit touching the required paths carries a changelog entry ----------
if [ -n "$REQUIRED" ]; then
  # The same two scopes changelog-entries judges, resolved by the same
  # library: the lane that names where an entry may be written and the lane
  # that then judges it cannot come to different answers.
  gg_changelog_scopes || exit 2

  gg_commit_changes
  touched=""
  IFS= read -r -d '' touched <"$GG_TMP/product.z" || :

  # A record change counts only when the release declaration is set.
  # An ordinary correction to published notes does not replace a new fragment.
  record_counts=0
  if [ -n "$GG_CHANGELOG_RECORD" ] && [ "${COMMIT_GUARDS_CHANGELOG_COLLATE:-}" = "1" ]; then
    record_counts=1
  fi

  # The record is compared as one value, never folded into the pattern list:
  # a record path carrying a space would word-split into two globs there, and
  # writing that very file would then satisfy nothing.
  entry=""
  while IFS= read -r -d '' f; do
    if [ "$record_counts" -eq 1 ] && [ "$f" = "$GG_CHANGELOG_RECORD" ]; then
      entry="$f"
      break
    fi
    # shellcheck disable=SC2086
    gg_path_matches "$f" $GG_CHANGELOG_PATTERNS || continue
    # A package's entry is that package's, never the program's, so it is no
    # entry for a program change.
    gg_path_glob_section "$f"
    gg_fragment_package "$f"
    if [ -z "$GG_FRAGMENT_PACKAGE" ]; then
      entry="$f"
      break
    fi
  done <"$GG_TMP/written.z"

  if [ -n "$touched" ] && [ -z "$entry" ]; then
    program=""
    for pat in $GG_CHANGELOG_PATTERNS; do
      gg_package_pattern "$pat" || program="${program:+$program }$pat"
    done
    program="$(gg_scrubbed "$program")"
    gg_commit_header "$MSG"
    case "$GG_COMMIT_HEADER" in
      *"[no-changelog]"*) gg_message changelog-waived "$touched" "The header waives the changelog entry." ;;
      *)
        # The record does not satisfy this rule without the release declaration.
        gg_message changelog-missing "$touched:$program" "Changed without a changelog entry."
        echo "  write one of: $program"
        echo "  or put [no-changelog] in the header when the commit changes nothing a consumer sees"
        [ -z "$GG_CHANGELOG_RECORD" ] \
          || echo "  $(gg_shown "$GG_CHANGELOG_RECORD") counts only under COMMIT_GUARDS_CHANGELOG_COLLATE=1, which is the release commit collating the fragments"
        exit 1
        ;;
    esac
  fi
fi

exit 0
