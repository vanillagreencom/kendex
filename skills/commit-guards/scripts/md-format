#!/usr/bin/env bash
# md-format — markdown holds one paragraph per line and one list item per
# line, with blank lines between paragraphs, list blocks, headings and
# fences, and no trailing-double-space line break. Fenced code, tables, HTML
# blocks, indented code and front matter are left as they are. The grammar
# is lib/md-blocks.awk's, stated in CHECKS.md § md-format; md-reflow is the
# remedy.
#
# Scopes: --staged judges every markdown file the staged diff adds or
# changes, in full; --base REF and --against REF judge the same over a commit
# range, byte-ceiling's dots (three and two); --all judges every tracked
# markdown file the path globs name; with neither, COMMIT_GUARDS_MD_SCOPE
# decides (lib/md-scope.sh). Content comes from the index, like every scan in
# this family.
#
# Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
set -euo pipefail
# Pathname expansion off: the configured paths are globs matched against the
# index, never against the work tree.
set -f

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The trailing newline from `pwd` terminates its output; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="md-format"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"
# shellcheck source=lib/md-scope.sh
source "$SCRIPT_DIR/lib/md-scope.sh"

PATHS_DEFAULT="*.md"
BLOCKS_AWK="$SCRIPT_DIR/lib/md-blocks.awk"
SHAPES_AWK="$SCRIPT_DIR/lib/md-shapes.awk"

usage() {
  gg_message usage md-format "Command usage follows."
  cat <<EOF
usage: md-format [--staged | --base REF | --against REF | --all]

A markdown file is one paragraph per line and one list item per line, with
blank lines between paragraphs, list blocks, headings and fences, and no
trailing-double-space line break. Fenced code, tables, HTML blocks, indented
code and front matter are not judged. Reflow a file with md-reflow.

--staged judges every markdown file the staged diff adds or changes, in
full; --base REF judges the same over what this branch adds since the
merge-base with REF (three dots) and --against REF over what the change
would do to REF's own tree (two dots), which is the scope a push takes;
--all judges every tracked markdown file the path globs name. With none of
them, COMMIT_GUARDS_MD_SCOPE decides: 'touched' (the default) is --staged
and judges nothing when nothing is staged; 'all' is --all.

Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  COMMIT_GUARDS_MD_PATHS      space-separated shell globs against the full
                              repo-relative path, '*' crossing '/'
                              (default $PATHS_DEFAULT)
  COMMIT_GUARDS_MD_EXCLUDES   exclusion list, pattern<TAB>reason per line
                              (default $GG_MD_EXCLUDES_DEFAULT)
  COMMIT_GUARDS_MD_SCOPE      touched | all (default $GG_MD_SCOPE_DEFAULT)

Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
EOF
}

STAGED=0
ALL=0
RANGE_KIND=""
RANGE_REF=""
while [ $# -gt 0 ]; do
  case "$1" in
    --staged) STAGED=1 ;;
    --all) ALL=1 ;;
    --base)
      [ $# -ge 2 ] || gg_fail argument-missing "--base" "--base requires a ref"
      shift
      RANGE_KIND="base"
      RANGE_REF="$1"
      ;;
    --base=*)
      RANGE_KIND="base"
      RANGE_REF="${1#--base=}"
      ;;
    --against)
      [ $# -ge 2 ] || gg_fail argument-missing "--against" "--against requires a ref"
      shift
      RANGE_KIND="against"
      RANGE_REF="$1"
      ;;
    --against=*)
      RANGE_KIND="against"
      RANGE_REF="${1#--against=}"
      ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) gg_fail argument "$1" "Unknown argument. See --help." ;;
  esac
  shift
done

[ -r "$BLOCKS_AWK" ] || gg_fail dependency "$BLOCKS_AWK" "Reinstall the commit-guards skill to restore this file."
[ -r "$SHAPES_AWK" ] || gg_fail dependency "$SHAPES_AWK" "Reinstall the commit-guards skill to restore this file."

gg_repo_root_cd
gg_md_load_paths md-format COMMIT_GUARDS_MD_PATHS "$PATHS_DEFAULT"
gg_md_scope md-format "$STAGED" "$ALL" "$RANGE_KIND" "$RANGE_REF"
[ "$GG_MD_MODE" != none ] || exit 0

gg_tmpdir
gg_md_select markdown
skipped="$GG_WALK_SKIPPED"

if [ "$GG_MD_COUNT" -eq 0 ]; then
  if [ "$skipped" -eq 0 ]; then
    gg_message no-match "$GG_MD_MODE:$GG_PATH_GLOBS_SHOWN" "No selected Markdown files match the configured paths."
  else
    gg_message unmeasured-count "$skipped" "No selected paths could be measured."
  fi
  exit 0
fi

REMEDY="reflow the file with md-reflow (scripts/md-reflow PATH), then stage it"
violations=0
while IFS= read -r -d '' sha && IFS= read -r -d '' f; do
  gg_read_blob "$sha" "$f" "markdown file"
  status=0
  LC_ALL=C awk -f "$SHAPES_AWK" -f "$BLOCKS_AWK" -v mode=check "$GG_TMP/blob" >"$GG_TMP/verdict" 2>"$GG_TMP/verdict.err" || status=$?
  if [ -s "$GG_TMP/verdict.err" ]; then
    # not-a-path: the parser diagnostic is text, not a file name.
    block_stderr="$(cat -- "$GG_TMP/verdict.err")" \
      || gg_fail diagnostic-read "$GG_TMP/verdict.err" "Could not read parser diagnostics."
    gg_message block-stderr "$f:$status" "$block_stderr" >&2
  fi
  while IFS="$GG_TAB" read -r kind line text; do
    case "$kind" in
      V)
        gg_md_block_message "$text" "$f" "$line"
        gg_message "$GG_MD_RULE" "$GG_MD_DETAIL" "$GG_MD_EXPLANATION $REMEDY"
        violations=$((violations + 1))
        ;;
      R)
        gg_md_block_message "$text" "$f" "$line"
        gg_fail "$GG_MD_RULE" "$GG_MD_DETAIL" "$GG_MD_EXPLANATION"
        ;;
      *) gg_fail block-record "$f:$kind" "The block parser returned an unknown record." ;;
    esac
  done <"$GG_TMP/verdict"
  [ "$status" -eq 0 ] || gg_fail block-exit "$f:$status" "The block parser failed."
done <"$GG_TMP/md-files.z"

gg_message summary "violations=$violations files=$GG_MD_COUNT scope=$GG_MD_MODE skipped=$skipped" "The Markdown format scan is complete."
[ "$violations" -eq 0 ] || exit 1
