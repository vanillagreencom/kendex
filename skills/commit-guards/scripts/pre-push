#!/usr/bin/env bash
# pre-push — the branch-scope guard chain, shaped for the git pre-push hook
# (the installed .git/hooks/kendex-guards shim execs it): doc-limits over the
# pushed tree, then the commit-guards batch over what each pushed branch would
# do to the remote, in the order the pre-commit chain runs them.
#
# Why a lane here at all. Git runs no hook when it REPLAYS a commit — a
# rebase, a cherry-pick, an autosquash — so a branch can arrive in a state no
# guard has ever judged: two commits that each passed at authoring time
# combine into one that breaches a ceiling, and nothing reports it until
# somebody happens to author the next commit on that branch. Push is where the
# branch leaves the machine, whatever produced its state, and the last moment
# a guard can still refuse.
#
# Every lane announces itself, a skipped one included. Aggregation fails
# CLOSED: exit 2 if any scope could not be judged, else 1 if any found
# violations, else 0. Both nonzero verdicts block the push.
set -euo pipefail

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The trailing newline from `pwd` terminates its output; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="pre-push"
# shellcheck source=lib/paths.sh
source "$SCRIPT_DIR/lib/paths.sh"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/siblings.sh
source "$SCRIPT_DIR/lib/siblings.sh"

usage() {
  cat <<'EOF'
usage: pre-push REMOTE URL

Runs doc-limits over the pushed tree and then the commit-guards batch over
what each pushed branch would do to the remote, the order the pre-commit
chain runs them in. doc-limits measures every tracked document against its
class ceiling, so its verdict does not depend on which scope a ref line
resolves to and it runs once per push, at the first line that would be
judged. COMMIT_GUARDS_CHECKS decides the batch lanes, less the ones this
scope leaves nothing for: a check this run hands no scope, whose own bare
default selects from the staged diff, opens no file here, since nothing is
staged by the time judging starts, so the batch withholds it and names it
rather than counting it clean. Where a range scope can be established the
markdown lanes take it under their default scope and judge what the branch
changed, so a malformed document or a broken reference a replay carried in is
caught; where none can be, the whole tree is the scope and those lanes are
withheld, since that sweep is absolute rather than ratcheted and choosing it
is COMMIT_GUARDS_MD_SCOPE=all, the project's call. A project that has chosen
it keeps the sweep under every scope, a range included. Git passes the remote
name
and its URL as arguments and the ref lines
`<local-ref> <local-oid> <remote-ref> <remote-oid>` on stdin. Wire it through
the installed shim: `install-git-hooks --repo <root>`.

Per ref line: a deletion, and a line whose REMOTE ref is a tag or a note, are
announced and skipped. What a line deposits on the remote decides that, never
how its left side is spelled: `git push origin HEAD` lands a branch too. A
line this lane cannot read is refused rather than skipped.

Where the ref line carries a remote oid this repository holds, the batch is
asked what landing HEAD there would DO to that tree: `--against`, two dots,
against the oid git read from the destination's own advertisement. Three dots
would answer what the branch adds over the ancestor the two share, which on a
diverged or force-pushed branch excuses a file that in fact grows at the
destination.

Otherwise the scope is a best-effort LOCAL one — `--base`, what this branch
adds over what this repository's refs for the remote last recorded — and not
a claim about the destination. Those refs record a past fetch and nothing
local dates them, so after a `git remote set-url` they still describe the
previous repository and an oversized file can read there as pre-existing.
With no base at all, the whole tree is the scope.

Two refusals keep the verdict about the thing being pushed. A branch whose tip
is not HEAD is refused: byte-ceiling is the only lane scoped to a commit range
and every other one scans the index, so the batch answers about this checkout.
The index having content HEAD does not is refused for the same reason — a
verdict over staged bytes is a verdict about a tree nobody is pushing. Neither
consults untracked files or unstaged edits, which no lane reads. The verdict
line names the way past a refusal.

Configuration: every COMMIT_GUARDS_* key the batch reads applies here
unchanged.

Exit codes: 0 clean; 1 violations; 2 usage/config/collection error, or a scope
that could not be judged. Both nonzero codes block the push.
EOF
}

case "${1-}" in
  -h | --help)
    usage
    exit 0
    ;;
esac
[ $# -eq 2 ] || gg_fail argument-count "$#" "takes the remote name and URL git passes to pre-push (see --help)"
# The remote as git named it, which for `git push <url> <branch>` is the URL
# itself, userinfo and any token in it included. It reaches `--remotes=` and
# nowhere else: no message below interpolates it. git strips userinfo from its
# own diagnostics, and a lane that printed what git withholds would put a
# credential into terminal scrollback and into every log that captures hook
# output. The ref name is what a reader needs from these messages anyway.
REMOTE="$1"
# The URL git is actually pushing to, which is the one thing that says where
# this push lands. git resolves remote.<name>.pushurl and every insteadOf
# rewrite before choosing it, so asking git beats reading the configuration
# back: one judge, and it is the one that already decided.
PUSH_URL="$2"

gg_repo_root_cd
# The policy a push is measured against is HEAD's, like the content: the
# refusals below hold the index to HEAD, and tracked settings resolve from the
# index while this is on, so an unstaged edit to a committed settings file
# cannot drop a lane from the batch that judges the commit. Untracked sources —
# .env.local, .kendex/settings.toml, the environment — are local override by
# design and are untouched by it.
gg_settings_index_mode
gg_tmpdir

BATCH="$SCRIPT_DIR/commit-guards"
[ -x "$BATCH" ] || gg_fail lane-missing "$BATCH" "$BATCH is missing or not executable — reinstall the commit-guards skill"

# Git streams the ref lines on stdin. They are read WHOLE here, and the loop
# below reads them back from the file: a loop reading straight from git's
# stream would hold it open across every check the batch runs, and any one of
# them that touched stdin would take a line the loop has not reached. The
# batch is handed /dev/null for the same reason from the other side.
cat >"$GG_TMP/refs" || gg_fail stdin-read "$?" "could not read the ref lines git sends on stdin"

# The commit this checkout is on, and the one thing the batch can judge. Empty
# on an unborn HEAD, which every branch line below is then refused against.
HEAD_OID=""
HEAD_OID="$(git rev-parse --verify --quiet HEAD 2>/dev/null)" || HEAD_OID=""

# Git's "no such object" oid: all zeros, at whatever width the repository's
# hash is. An empty value is not one — it is a malformed line.
zero_oid() { # OID — 0 when it is the all-zero oid
  case "$1" in
    "" | *[!0]*) return 1 ;;
  esac
  return 0
}

# Whether the refs a boundary would come from are at least the ones kept for
# the place this push is going.
#
# Hygiene, not soundness: it cannot establish that those refs describe the
# destination, because nothing local can — see above. What it does is stop a
# boundary being read off refs that are plainly somebody else's.
# `refs/remotes/<name>/*` were fetched from remote.<name>.url, while
# remote.<name>.pushurl and insteadOf rewrites send a push to a repository
# those refs have never described, and the fetch-upstream, push-to-a-fork
# triangle is an ordinary setup. A boundary read off them bounds the range by
# what THAT repository holds, and byte-ceiling would diff from a base the
# destination never had.
#
# Every value, and exactly one of them, because remote.<name>.url is not a
# scalar. A remote set up to push one branch to two places carries two, a
# fetch uses the FIRST, and git runs this hook once per URL — so `--get`,
# which exits 0 and answers with the LAST, would compare against a URL the
# tracking refs never came from. With more than one there is no single URL
# those refs describe, so the question has no answer and the wider scope is
# the only one left. `core.hooksPath` and `core.bare` are read with `--get`
# elsewhere in this package and are right to be: those ask which value git
# uses, and for a scalar that is the last one, which is what `--get` returns.
#
# Where the two are not equal — a remote spelled as a URL with no entry to
# read, several URLs, or the same repository under two spellings — the caller
# falls to the whole tree. That is the wider scope, and a bound is the one
# thing that must never be guessed narrow.
tracking_describes_push() { # -> 0 when the tracking refs are this push URL's
  local status=0 count=0 url="" only=""
  # 1 is the key being absent, which a remote spelled as a URL always is;
  # anything else is configuration that could not be read. Both are the same
  # answer here: not established.
  git config --get-all "remote.$REMOTE.url" >"$GG_TMP/urls" 2>/dev/null || status=$?
  [ "$status" -eq 0 ] || return 1
  while IFS= read -r url; do
    count=$((count + 1))
    only="$url"
  done <"$GG_TMP/urls"
  [ "$count" -eq 1 ] || return 1
  [ -n "$only" ] || return 1
  [ "$only" = "$PUSH_URL" ]
}

# The local boundary: what this branch adds over what this repository's refs
# for the remote last recorded — and how much that is worth, which is less
# than it looks.
#
# One thing a pre-push hook is handed is bound to the destination: the remote
# oid on the ref line, which git read from the destination's own advertisement
# moments earlier. The caller uses that where it has it, and asks byte-ceiling
# what landing HEAD there would DO to that tree. Nothing in this function is
# that; there is no second source of destination evidence short of a network
# call.
#
# So everything here is LOCAL, and reached only where the destination has no
# such ref at all. Nothing here can say what it does have, so the boundary is
# a best-effort local scope and not a claim about the destination. It is taken
# because it is usually right and the alternatives are worse, not because it
# is sound.
#
# The limitation that leaves, named here rather than left to be rediscovered:
# those refs record a past fetch and nothing local dates them. After a
# `git remote set-url` they still describe the previous repository while every
# test below passes, so on a new destination branch byte-ceiling can treat an
# oversized file as pre-existing and let it through. `git ls-remote` would
# close it and is refused: a network round trip and an offline failure mode
# inside a hook, buying back the new-branch case alone.
#
# Where no boundary can be established at all the caller falls to the whole
# tree, three lines below this one. That happens on a push by direct URL, on
# a push URL these refs do not describe, and on a branch nothing of which has
# reached the remote: in each, nothing on it has been vetted against the
# destination, and the whole tree is the only honest scope left.
#
# It is the last resort rather than the first, and the reason is measured.
# byte-ceiling's `--all` emits candidates with no source blob, so its
# tighten-only ratchet never applies and every tracked file over the ceiling
# fails; CHECKS.md § byte-ceiling states the scopes apart. So a repository
# carrying files that were already oversized when it adopted this package
# DOES have such a push refused, and the excludes list or the bypass is the
# way past it. Trying the boundary first is what keeps that rare rather than
# routine; giving `--all` a ratchet is byte-ceiling's to do, not this lane's.
local_boundary() { # VAR LOCAL-OID — VAR gets the base; 1 when there is none
  local __v="$1" local_oid="$2" status=0 line=""
  # What this branch adds over what those refs last recorded. The boundary
  # commits of that range are the newest commits they carry, and any of them
  # is a base the branch's own changes hang off — locally, on the terms set
  # out above.
  #
  # A remote spelled as a URL rather than as a name (`git push https://... main`)
  # matches no tracking refs, so nothing is excluded, the walk reaches the
  # root, and there is no boundary — which falls through to the whole tree
  # below. Wider, never narrower.
  tracking_describes_push || return 1
  git rev-list --boundary "$local_oid" --not --remotes="$REMOTE" \
    >"$GG_TMP/boundary" 2>"$GG_TMP/boundary.err" || status=$?
  [ "$status" -eq 0 ] \
    || gg_fail_cause boundary-collect "$status" "$GG_TMP/boundary.err" "git rev-list could not resolve what $(gg_shown "$local_oid") adds over the refs this remote is known to have (exit $status)"
  while IFS= read -r line; do
    case "$line" in
      -?*)
        eval "$__v=\${line#-}"
        return 0
        ;;
    esac
  done <"$GG_TMP/boundary"
  eval "$__v=''"
  return 1
}

# Whether the index holds exactly the content the pushed commit does.
#
# The not-head refusal settles that the commit leaving the machine is HEAD's.
# It settles nothing about what the lanes read: byte-ceiling is the only one
# scoped to a commit range, and every other check in the family scans the
# INDEX. So staged content makes the batch answer about a tree nobody is
# pushing — and wrong in the direction that matters, since a violation
# committed and then staged away reads clean while it is uploaded.
#
# The index, not the work tree: an unstaged edit changes nothing any lane
# reads, and neither does an untracked file, so neither is consulted. Asked
# once, at the first line that would be judged, so a push carrying nothing but
# deletions and tags is never held for it.
INDEX_STATE=unasked
index_is_head() { # -> 0 when the index holds exactly HEAD's tracked content
  local status=0 count=0 path=""
  case "$INDEX_STATE" in
    yes) return 0 ;;
    no) return 1 ;;
  esac
  git diff --cached --quiet HEAD -- 2>"$GG_TMP/index.err" || status=$?
  case "$status" in
    0)
      INDEX_STATE=yes
      return 0
      ;;
    1) ;;
    *) gg_fail_cause index-read "$status" "$GG_TMP/index.err" "git diff could not compare the index with HEAD (exit $status)" ;;
  esac
  INDEX_STATE=no
  # NUL-delimited, since these are somebody's tracked names and the list is the
  # evidence for the refusal below.
  git diff --cached --name-only -z HEAD -- >"$GG_TMP/index.z" 2>"$GG_TMP/index.err" \
    || gg_fail_cause index-read "$?" "$GG_TMP/index.err" "git diff could not list what the index holds over HEAD"
  while IFS= read -r -d '' path; do
    [ -n "$path" ] || continue
    gg_message index-path "$path" "This path is staged over HEAD."
    count=$((count + 1))
  done <"$GG_TMP/index.z"
  gg_message index-drift "$count" "pre-push: the index holds content HEAD does not, and every lane but byte-ceiling reads the index — so a verdict here would be about a tree nobody is pushing. Commit the staged content or reset it, then push again. The verdict line below names the way past this refusal."
  return 1
}

had_violations=0
had_errors=0

# doc-limits over the pushed tree, the lane the pre-commit chain runs first.
#
# Once per push rather than once per ref line: it measures every tracked
# document against its class ceiling, absolutely, so the verdict is the same
# whatever scope a line resolves to and a second run would repeat the first
# word for word. Lazily, at the first line that would actually be judged, so a
# push carrying nothing but deletions and tags is never held for it — and
# after index_is_head, because --staged reads the INDEX and only that refusal
# establishes the index is the tree being pushed.
DOC_LIMITS_STATE=unasked
doc_limits_once() { # folds the lane's verdict into this run's aggregators, once
  local status=0
  case "$DOC_LIMITS_STATE" in
    asked) return 0 ;;
  esac
  DOC_LIMITS_STATE=asked
  gg_doc_limits_lane "$SCRIPT_DIR" || status=$?
  case "$status" in
    0) ;;
    1) had_violations=1 ;;
    *) had_errors=1 ;;
  esac
}

# The scopes already judged, newline-delimited. One push can name the same
# commit under several remote refs, and the batch reads this checkout, so a
# second run over the same base would repeat the first one's verdict word for
# word. Bash 3.2 has no associative array; membership is a `case` over the
# set, the way todo-ban's commit lane does it.
JUDGED=""

judge() { # SCOPE REF SCOPE-FLAGS... — run the batch once per distinct scope
  local scope="$1" ref="$2" status=0
  shift 2
  case "$GG_NL$JUDGED" in
    *"$GG_NL$scope$GG_NL"*)
      gg_message scope-repeat "$scope" "=== pre-push: $ref is already covered by the batch run over $scope"
      return 0
      ;;
  esac
  JUDGED="$JUDGED$scope$GG_NL"
  gg_message step "$scope" "=== pre-push: commit-guards all $*, for $ref"
  # --skip-unscoped because nothing is staged here, and this lane guarantees
  # it: the index-drift refusal above holds the index equal to HEAD before
  # any judging. The index-reading checks are unaffected by that and judge
  # the pushed tree exactly; a check whose configured scope selects from the
  # staged DIFF would open no file at all and report a clean count over a
  # document nobody read. The batch decides which those are and names each
  # one it withholds — a project that configured them to sweep the tree
  # instead gets them run here, since that scope needs nothing staged.
  #
  # Where this lane HAS a range to hand them — the two scopes below that
  # carry a ref — the markdown lanes take it and judge what the branch
  # changed, which is how a replayed document reaches a verdict. The
  # whole-tree scope is the one that reaches them with nothing: imposing the
  # absolute sweep there would refuse every push in a repository holding
  # markdown that predates the guard, and choosing it is the project's to
  # make, COMMIT_GUARDS_MD_SCOPE=all. Where a project HAS chosen it, the
  # batch keeps that sweep and hands the range to no markdown lane: a range
  # is narrower, so substituting one would answer a smaller question under
  # the setting's name. That decision is the batch's, not this lane's.
  #
  # The batch reads no input, and is given none: a check that read stdin
  # would take the ref lines this loop has not reached, and a line nobody
  # reads is a branch nobody judges.
  "$BATCH" all --skip-unscoped "$@" </dev/null || status=$?
  case "$status" in
    0) ;;
    1) had_violations=1 ;;
    *)
      had_errors=1
      gg_message step-incomplete "$scope:$status" "pre-push: the batch did not complete over $scope (exit $status)"
      ;;
  esac
}

# The ref a message names. Git sends the left side as the person spelled it:
# `git push origin HEAD` and `git push origin @:refs/heads/x` both send HEAD,
# and `git push origin <sha>:refs/heads/x` sends the raw oid. None of that
# changes what leaves the machine — local_oid does — but a refusal naming HEAD
# tells a reader less than one naming the branch they are standing on. A
# detached HEAD has no branch name and keeps the spelling git sent.
# The out-variable is never named `name`: a caller passing that name would
# have this function's own local answered instead of its own.
shown_ref() { # VAR LOCAL-REF — VAR gets the ref to name in a message
  local __v="$1" name="$2" branch=""
  case "$name" in
    HEAD | @)
      branch="$(git symbolic-ref --quiet HEAD 2>/dev/null)" || branch=""
      [ -z "$branch" ] || name="$branch"
      ;;
  esac
  eval "$__v=\$name"
}

lines=0
while IFS=' ' read -r local_ref local_oid remote_ref remote_oid || [ -n "$local_ref" ]; do
  # git terminates every line, so a trailing empty read is the end of the
  # stream rather than a line with nothing on it.
  [ -n "$local_ref" ] || continue
  lines=$((lines + 1))
  # A line missing a field is a line this lane cannot read, and one it cannot
  # read may be depositing anything. Refused, never announced as carrying
  # nothing: an unreadable line passed over is the fail-open this lane exists
  # to refuse.
  if [ -z "$local_oid" ] || [ -z "$remote_ref" ] || [ -z "$remote_oid" ]; then
    had_errors=1
    gg_message ref-line-short "$local_ref" "pre-push: git sent a ref line this lane could not read. A line is <local-ref> <local-oid> <remote-ref> <remote-oid>, and this one is short, so what it would deposit is unknown. The push is refused rather than passed over it."
    continue
  fi
  if zero_oid "$local_oid"; then
    gg_message deletion "$remote_ref" "=== pre-push: $remote_ref is being deleted — no branch state arrives, nothing to judge"
    continue
  fi
  # What the line DEPOSITS decides, which is the remote ref. The left side is
  # spelled however the push was typed — a branch, HEAD, @, a raw oid — and
  # every one of those still lands a branch when the right side is one.
  # Reading the left side instead let `git push origin HEAD` past the whole
  # batch, which is the spelling `worktree push` uses after a restack.
  #
  # Tags and notes are the namespaces git keeps for what is not a line of
  # development, and they are what the skip was written for. Every other
  # destination is judged rather than guessed at: running the checks over one
  # costs a verdict, and skipping it costs the guard.
  case "$remote_ref" in
    refs/tags/* | refs/notes/*)
      gg_message non-branch "$remote_ref" "=== pre-push: $remote_ref is not a branch — skipped; a tag or a note carries no branch state to guard"
      continue
      ;;
  esac
  ref=""
  shown_ref ref "$local_ref"
  # Fail closed on a branch this checkout is not standing on. Every lane but
  # byte-ceiling reads the working tree or the index, and byte-ceiling's ref
  # scopes end at HEAD — so the batch judges HEAD and its work tree, and
  # a verdict about them says nothing about a branch that is somewhere else.
  # Passing it silently is the one outcome this lane exists to refuse.
  if [ "$local_oid" != "$HEAD_OID" ]; then
    had_errors=1
    gg_message not-head "$ref:$local_oid" "pre-push: $ref is at $(gg_shown "$local_oid") and this checkout is at $(gg_shown "${HEAD_OID:-<unborn HEAD>}"), so the guards — which read this work tree and this index — cannot judge it. Check the branch out and push again; the verdict line below names the way past this refusal."
    continue
  fi
  if ! index_is_head; then
    had_errors=1
    continue
  fi
  doc_limits_once
  # The destination's own answer first: the commit the remote ref is at,
  # usable only where this repository actually has that object — git sends the
  # oid it learned from the remote, which a shallow or freshly cloned checkout
  # may never have fetched.
  #
  # Asked with --against, two dots, because the question a push asks is what
  # landing HEAD there would DO to that tree. Three dots would answer what
  # this branch adds over the ancestor the two share, and on a branch that has
  # diverged from the destination — every force push, which is how a rebased
  # branch reaches a remote — those are different answers: a file over the
  # ceiling at the ancestor, smaller at the destination and larger at HEAD,
  # reads as a shrink to the first and as growth to the second, and the second
  # is what the destination gets.
  if ! zero_oid "$remote_oid" \
    && git rev-parse --verify --quiet "$remote_oid^{commit}" >/dev/null 2>&1; then
    judge "against:$remote_oid" "$ref" --against "$remote_oid"
    continue
  fi
  base=""
  if local_boundary base "$local_oid"; then
    judge "base:$base" "$ref" --base "$base"
  else
    # No base this lane can vouch for: either nothing on this branch has ever
    # reached the remote, or the refs this repository holds for the remote
    # describe somewhere other than where the push is going. Either way no
    # commit on it has been vetted against the destination, and the whole tree
    # is the only honest scope.
    gg_message base-none "$ref" "=== pre-push: no base to vouch for — either nothing $ref builds on has reached this remote, or this repository's refs for the remote describe somewhere else. Judging the whole tree."
    judge "all" "$ref"
  fi
done <"$GG_TMP/refs"

[ "$lines" -gt 0 ] || gg_message no-refs 0 "=== pre-push: git sent no ref lines — nothing to judge"

if [ "$had_errors" -eq 1 ]; then
  gg_message result 2 "pre-push: a guard could not complete — push blocked; fix the errors above (bypass only with git push --no-verify)"
  exit 2
fi
if [ "$had_violations" -eq 1 ]; then
  gg_message result 1 "pre-push: violations — push blocked; see the failures above"
  exit 1
fi
gg_message result 0 "pre-push: OK — branch guard chain clean"
