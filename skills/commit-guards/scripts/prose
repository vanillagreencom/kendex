#!/usr/bin/env bash
# prose — instruction markdown states the rule that holds now. A history
# reference in a file an agent loads (SKILL.md, workflows/*.md, agents/*.md,
# AGENTS.md, CLAUDE.md) fails: a calendar date, a three- or four-digit issue
# number. An agent acts on the rule, and a
# rule wrapped in the story of how it got there costs every reader the same
# paragraph to discard. The story belongs in the commit that made the change.
#
# Scope is the whole rule: only the configured paths are scanned, so a
# reference doc, a changelog and a design record keep their history intact.
# COMMIT_GUARDS_PROSE_PATHS replaces the path list.
#
# Content comes from the index, like every scan in this family. A symlink, a
# submodule gitlink and binary content at a configured path are named as
# unmeasured rather than folded into the clean count. Matching is
# case-insensitive: the banned strings are words, and a sentence-initial
# capital is the same word.
#
# Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
set -euo pipefail
# Pathname expansion off: the configured paths are globs, and splitting them
# into words would otherwise expand each against the work tree — matching
# whatever happens to be checked out instead of the tracked paths the scan
# judges, and matching nothing at all in a sparse or bare checkout.
set -f

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The trailing newline from `pwd` terminates its output; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="prose"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"

# What an agent harness loads on its own: a skill's entry point and its
# workflows, an agent definition, and the repo-level instruction files. Each
# name is spelled twice — at the repository root and anywhere below it —
# because `*` crosses `/` but never stands in for the separator itself, and
# the second spelling is also what reaches a rendered copy under `.claude/`
# or `.agents/`. The architecture docs those files point at are loaded the
# same way, so they hold the same rule — once the repository says its
# markdown is rewritten (COMMIT_GUARDS_MD_SCOPE=all, the switch the markdown
# lanes read); before that a repository's architecture docs are what the
# rewrite is for, and this lane has no staged scope to spare them.
PATHS_CORE="SKILL.md */SKILL.md AGENTS.md */AGENTS.md CLAUDE.md */CLAUDE.md workflows/*.md */workflows/*.md agents/*.md */agents/*.md"
PATHS_ARCH="docs/architecture/*.md"
PATHS_DEFAULT="$PATHS_CORE $PATHS_ARCH"

usage() {
  cat <<EOF
usage: prose

A history reference in agent-loaded markdown fails: a calendar date
(20YY-MM-DD) or a three- or four-digit issue number after '#'.
The scan reads index content. Ordinary words do not trigger this check.
Only the configured paths are scanned; a reference doc, a changelog and a
design record are out of scope by not being named. A symlink, a submodule
gitlink and binary content at a configured path are named as unmeasured.

Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  COMMIT_GUARDS_PROSE_PATHS   space-separated shell globs against the full
                              repo-relative path, '*' crossing '/' as in the
                              excludes lists
                              (default $PATHS_DEFAULT)
  COMMIT_GUARDS_MD_EXCLUDES   exclusion list, pattern<TAB>reason per line,
                              shared with md-format and md-refs
                              (default tools/md-excludes)

Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
EOF
}

if [ $# -gt 0 ]; then
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *) gg_config_error "unknown argument '$1' (see --help)" ;;
  esac
fi

gg_repo_root_cd

MD_SCOPE="$(gg_setting COMMIT_GUARDS_MD_SCOPE touched)" || exit 2
case "$MD_SCOPE" in
  all) ;;
  touched) PATHS_DEFAULT="$PATHS_CORE" ;;
  *) gg_config_error "COMMIT_GUARDS_MD_SCOPE must be 'touched' or 'all', got '$(gg_scrubbed "$MD_SCOPE")'" ;;
esac
PATHS_RAW="$(gg_setting COMMIT_GUARDS_PROSE_PATHS "$PATHS_DEFAULT")" || exit 2

# The path list, its validation and its matcher are the family's, shared with
# the sibling lane scoped the same way: lib/configured-paths.sh § configured
# path globs.
gg_load_path_globs "$PATHS_RAW" prose COMMIT_GUARDS_PROSE_PATHS || exit 2
# The markdown lanes' exclusion list, honoured here for the same reason: a
# vendored skill under a render tree matches `*/SKILL.md` and its body is
# not this repository's to edit.
EXCLUDES="$(gg_resolve_path "" COMMIT_GUARDS_MD_EXCLUDES tools/md-excludes excludes)" || exit 2
gg_load_excludes "$EXCLUDES"

# The issue-number shape has no leading boundary. Its trailing class excludes
# hex digits so longer numbers and colour values pass.
gg_tmpdir
PROSE_ERE="20[0-9]{2}-[0-9]{2}-[0-9]{2}|#[0-9]{3,4}([^0-9A-Fa-f]|\$)"

# Literal pathspecs, built from a walk rather than handing the configured
# globs to git: the family's glob contract is the shell's, and git's pathspec
# matching is a near neighbour, not the same rule. Building the list here is
# also what makes "nothing matched" visible — an empty pathspec list means
# EVERY tracked file to git, so a lane that passed it through would scan the
# whole repository the moment its configuration matched nothing.
#
# The walk itself is the family's — lib/configured-paths.sh § one walk over
# the configured paths — and it is what classifies each blob.
# `git grep --cached` SKIPS a symlink index entry outright, never reading
# through it, and drops a gitlink and a binary blob the same way: with no
# status and no stderr, so the lane would otherwise print a clean verdict
# over content it never read. Each of the three is named as unmeasured here
# and kept out of the scanned count instead.
MATCHED_SPECS=()
matched=0
add_spec() { # PATH BLOBFILE — one measurable path for the scan below
  MATCHED_SPECS+=(":(literal)$1")
  matched=$((matched + 1))
}

gg_walk_configured_paths markdown file add_spec
skipped="$GG_WALK_SKIPPED"

UNMEASURED=""
[ "$skipped" -eq 0 ] || UNMEASURED="; $skipped matched path(s) not measured"

if [ "$matched" -eq 0 ]; then
  # The "nothing matched" line belongs to ONE state: the configured globs
  # named no tracked path at all. A path that matched and was skipped is
  # reported as skipped, and printing this line over it would send its reader
  # to widen a glob that was already right — the wrong verdict dressed as
  # advice.
  if [ "$skipped" -eq 0 ]; then
    echo "prose: OK — no tracked file matches COMMIT_GUARDS_PROSE_PATHS ($GG_PATH_GLOBS_SHOWN)"
  else
    echo "prose: OK — nothing measurable to scan$UNMEASURED"
  fi
  exit 0
fi

gg_grep_lane "history reference" "$PROSE_ERE" \
  "state the rule that holds now and delete the story; the date and the issue number belong in the commit that made the change" \
  "${MATCHED_SPECS[@]}"

if [ "$GG_VIOLATIONS" -gt 0 ]; then
  echo "prose: $GG_VIOLATIONS history reference(s) in $matched scanned file(s) — paths $GG_PATH_GLOBS_SHOWN$UNMEASURED"
  exit 1
fi
echo "prose: OK — no history references in $matched scanned file(s)$UNMEASURED"
