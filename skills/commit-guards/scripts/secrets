#!/usr/bin/env bash
# secrets — a credential in a tracked text file fails, judged by gitleaks'
# default rules. Every finding names the path, the line and the gitleaks rule
# id; the matched value is never printed.
#
# Scopes: --staged (default) judges the lines the staged diff adds; --base
# REF and --against REF judge the lines each commit HEAD holds and REF lacks
# adds over its parents; --all judges every line of every tracked file. Each
# selected blob is scanned whole from a scratch copy, so a rule spanning lines
# (a private key block) still matches, and a finding counts under a diff
# scope only where its lines hold one added over each side it is judged
# against: the index's HEAD, or every parent of a range commit.
#
# gitleaks runs on gitleaks' own default rules: the repository's
# .gitleaks.toml, its .gitleaksignore and inline gitleaks:allow comments are
# not read, so the one allowlist is COMMIT_GUARDS_SECRETS_EXCLUDES, where
# every row carries its reason.
#
# Exit codes: the usage text below.
set -euo pipefail
# Pathname expansion off: the path glob matches the index, never the work tree.
set -f

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The trailing newline from `pwd` terminates its output; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="secrets"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"
# shellcheck source=lib/staged-lines.sh
source "$SCRIPT_DIR/lib/staged-lines.sh"

usage() {
  gg_message usage "$GG_CHECK" "Command usage follows."
  cat <<'EOF'
usage: secrets [--staged | --base REF | --against REF | --all] [--excludes FILE]

A credential gitleaks' default rules match in a tracked text file fails,
named by path, line and rule id; the value is never printed.

  --staged    (default) the lines the staged diff adds
  --base REF, --against REF
              the lines each commit HEAD holds and REF lacks adds
              over its parents
  --all       every line of every tracked file

Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  COMMIT_GUARDS_SECRETS_EXCLUDES   exclusion-list path (default tools/secrets-excludes)
Flag --excludes overrides the path setting.

Exit codes: 0 clean, or a gap notice for a missing or unusable gitleaks; 1
violations; 2 usage/config/collection error, a missing or unusable gitleaks
where CHECKS.md § secrets says the lane refuses, or a gitleaks run that did
not complete.
EOF
}

MODE="staged"
REF=""
EXCLUDES_OPT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --staged) MODE="staged" ;;
    --all) MODE="all" ;;
    --base | --against)
      [ $# -ge 2 ] || gg_fail argument-missing "$1" "$1 requires a ref"
      MODE="${1#--}"
      shift
      REF="$1"
      ;;
    --base=* | --against=*)
      MODE="${1%%=*}"
      MODE="${MODE#--}"
      REF="${1#*=}"
      ;;
    --excludes)
      [ $# -ge 2 ] || gg_fail argument-missing --excludes "--excludes requires a path"
      shift
      EXCLUDES_OPT="$1"
      ;;
    --excludes=*) EXCLUDES_OPT="${1#--excludes=}" ;;
    -h | --help)
      usage
      exit 0
      ;;
    *) gg_fail argument-unknown "$1" "Unknown argument. See --help." ;;
  esac
  shift
done

gg_repo_root_cd
EXCLUDES_FILE="$(gg_resolve_path "$EXCLUDES_OPT" COMMIT_GUARDS_SECRETS_EXCLUDES "tools/secrets-excludes" excludes)" || exit 2
gg_load_excludes "$EXCLUDES_FILE"
gg_load_path_globs "*" secrets secrets
gg_tmpdir

# Each selected blob is copied to tree/r/<n>/<path>: gitleaks' own path
# allowlist (lockfiles, vendored trees, images) still sees the real path, the
# number maps a finding back to the path whatever bytes the path holds, and no
# file the repository tracks lands in tree/ or tree/r/, where gitleaks reads a
# .gitleaksignore and a .gitleaks.toml.
#
# The scope is decided once, in the case below. LINES names the function that
# writes added/<n>, one "side<TAB>line" row per line blob n adds over one
# side, and is empty under --all, where every line counts. SIDE_COUNT is the
# number of sides the current blob is judged against, kept per blob in SIDES.
# COMMIT is the commit a range blob comes from, empty outside a range. REMEDY
# is the refusal's advice for the scope. CI_REFUSES is 1 where a missing
# gitleaks refuses under CI, which the tool check below explains.
PATHS=()
ORIGINS=()
SIDES=()
LINES=""
SIDE_COUNT=0
COMMIT=""
PARENTS=""
REMEDY=""
CI_REFUSES=1
SKIPPED=0
take() { # PATH BLOBFILE SHA
  local n="${#PATHS[@]}" dest
  dest="$GG_TMP/tree/r/$n/$1"
  mkdir -p -- "${dest%/*}"
  cp -- "$2" "$dest"
  PATHS+=("$1")
  ORIGINS+=("${COMMIT:+ in commit $COMMIT}")
  SIDES+=("$SIDE_COUNT")
  # Called outside an && or || list, so errexit holds inside LINES.
  case "$LINES" in
    "") ;;
    *) "$LINES" "$1" >"$GG_TMP/added/$n" ;;
  esac
}

# Each side's line numbers become "side<TAB>line" rows. gg_added_lines writes
# a file first, never a pipe: its refusal then exits this shell, not a
# pipeline's subshell.
side_rows() { # PATH SIDE [RANGE]
  local path="$1" side="$2" status=0
  shift 2
  gg_added_lines "$path" "$@" >"$GG_TMP/lines"
  LC_ALL=C awk -F '\t' -v side="$side" '{ print side "\t" $1 }' "$GG_TMP/lines" 2>"$GG_TMP/lines.err" || status=$?
  [ "$status" -eq 0 ] || gg_fail_cause lines-read "$path:$status" "$GG_TMP/lines.err" "Could not number the added lines of this path."
}

staged_lines() { # PATH — the lines the staged diff adds, as side 0
  side_rows "$1" 0
}

# A merge is judged against each parent apart. A line one parent carried came
# from that side's commits, which the range judges too, so a finding counts
# only where its span holds a line added over every parent; a block the merge
# completes from two sides' halves holds one from each.
commit_lines() { # PATH — the lines COMMIT adds over its k-th parent, as side k
  local p k=0
  for p in $PARENTS; do
    side_rows "$1" "$k" "$p..$COMMIT"
    k=$((k + 1))
  done
}

# Under a range each commit HEAD holds and REF lacks is judged on its own,
# against its parents: a credential one commit adds and a later commit
# removes is still in the history a push publishes, and the net diff of the
# range never shows it. --right-only keeps, of three dots' symmetric
# difference, the commits HEAD holds and REF lacks, the set two dots name, so
# both kinds judge the same commits. A commit with no parent adds every line
# it holds, judged against the empty tree, unless it is a shallow clone's
# boundary: its parents exist and were not fetched, so what it adds cannot be
# told.
range_walk() {
  local range="" empty="" shallow="" status=0 parent_list=()
  gg_diff_range range "$MODE" "$REF"
  empty="$(git hash-object -t tree /dev/null)" \
    || gg_fail empty-tree "$?" "git could not name the empty tree."
  gg_git_path shallow . rev-parse --git-path shallow \
    || gg_fail shallow-path "$?" "git could not name the shallow-boundary file."
  git rev-list --reverse --parents --right-only "$range" >"$GG_TMP/commits" 2>"$GG_TMP/commits.err" \
    || gg_fail_cause range-commits "$range:$?" "$GG_TMP/commits.err" "could not list the commits over $range"
  while read -r COMMIT PARENTS <&3; do
    if [ -z "$PARENTS" ]; then
      status=1
      if [ -f "$shallow" ]; then
        status=0
        grep -Fxq -- "$COMMIT" "$shallow" || status=$?
      fi
      case "$status" in
        0) gg_fail range-shallow "$COMMIT" "This clone is shallow at $COMMIT, so the commit's parents were never fetched and the lines it adds cannot be told. Fetch the whole history (actions/checkout: fetch-depth: 0) and run the scan again." ;;
        1) PARENTS="$empty" ;;
        *) gg_fail shallow-read "$shallow:$status" "Could not read the shallow-boundary file." ;;
      esac
    fi
    read -r -a parent_list <<<"$PARENTS"
    SIDE_COUNT="${#parent_list[@]}"
    gg_walk_range_paths "${PARENTS%% *}..$COMMIT" text take
    SKIPPED=$((SKIPPED + GG_WALK_SKIPPED))
  done 3<"$GG_TMP/commits"
  COMMIT=""
}

mkdir -p -- "$GG_TMP/tree/r" "$GG_TMP/added"
case "$MODE" in
  staged)
    LINES=staged_lines
    SIDE_COUNT=1
    REMEDY="Remove it from the commit and rotate the credential if it is real."
    CI_REFUSES=0
    gg_walk_staged_paths text take
    SKIPPED="$GG_WALK_SKIPPED"
    ;;
  all)
    REMEDY="Remove it and rotate the credential if it is real."
    gg_walk_configured_paths text "text file" take
    SKIPPED="$GG_WALK_SKIPPED"
    ;;
  base | against)
    LINES=commit_lines
    REMEDY="A later commit that removes it does not clear the history a push publishes: rewrite the commit that added it (git rebase -i), force-push the branch, and rotate the credential if it is real."
    range_walk
    ;;
esac

summary() { # VIOLATIONS
  gg_message summary "violations=$1 files=${#PATHS[@]} scope=$MODE skipped=$SKIPPED" "The credential scan is complete; excludes $EXCLUDES_FILE."
}

if [ "${#PATHS[@]}" -eq 0 ]; then
  summary 0
  exit 0
fi

# gitleaks is looked for only once a blob is selected. One that cannot run
# `dir`, the subcommand gitleaks 8.19 added and this lane scans with, is as
# unusable as none. Outside CI either is a gap: the lane is on by default in
# every consumer, and a refusal would stop every commit on a machine the tool
# has not reached, which the commit's author cannot repair from the commit.
# Under a non-empty CI or GITHUB_ACTIONS a range or --all scan refuses: those
# are the scopes a CI gate runs. --staged keeps the gap there too, since CI
# stages nothing to gate, and a commit made on a CI runner is judged again
# under the range its pull request scans.
tool=""
why=""
if ! command -v gitleaks >/dev/null 2>&1; then
  tool=missing
  why="gitleaks is not on PATH, so the selected files were not scanned for credentials."
elif ! gitleaks dir --help >/dev/null 2>&1; then
  tool=unusable
  found="$(gitleaks version 2>/dev/null)" || found=unknown
  why="The gitleaks on PATH, version $found, cannot run the dir scan gitleaks 8.19 added, so the selected files were not scanned for credentials."
fi
if [ -n "$tool" ]; then
  install="Install gitleaks 8.19 or newer: brew install gitleaks, or a release binary from https://github.com/gitleaks/gitleaks/releases, on PATH ahead of any older copy."
  if [ "$CI_REFUSES" -eq 1 ] && { [ -n "${CI:-}" ] || [ -n "${GITHUB_ACTIONS:-}" ]; }; then
    gg_fail "tool-$tool" gitleaks "$why
In CI the lane refuses rather than pass the change unscanned. $install Install it in a step ahead of the commit-guards step."
  fi
  gg_message gap "gitleaks-$tool:${#PATHS[@]}" "$why
The lane allows the change, because a missing tool must not stop every commit. $install"
  exit 0
fi

# [extend] useDefault: gitleaks' default rules with nothing taken away. A
# config passed by flag outranks GITLEAKS_CONFIG and GITLEAKS_CONFIG_TOML in
# the caller's environment.
printf '[extend]\nuseDefault = true\n' >"$GG_TMP/gitleaks.toml"
# A leak exits 3, so gitleaks' own failure status, 1, is never read as one.
status=0
(
  cd -- "$GG_TMP/tree" \
    && gitleaks dir --no-banner --no-color --redact --ignore-gitleaks-allow --log-level warn \
      --config "$GG_TMP/gitleaks.toml" \
      --exit-code 3 --report-format json --report-path "$GG_TMP/report.json" r
) </dev/null >"$GG_TMP/gitleaks.out" 2>&1 || status=$?
case "$status" in
  0 | 3) ;;
  *) gg_fail_cause tool-failed "gitleaks:$status" "$GG_TMP/gitleaks.out" "gitleaks did not complete." ;;
esac

# One "n<TAB>start<TAB>end<TAB>rule" row per finding. The report's Secret and
# Match fields are redacted and never read.
jq -r '
  if type != "array" then error("the report is not an array") else .[] end
  | [(.File | capture("^r/(?<n>[0-9]+)/").n), .StartLine, .EndLine, .RuleID]
  | @tsv' "$GG_TMP/report.json" >"$GG_TMP/rows" 2>"$GG_TMP/rows.err" \
  || gg_fail_cause tool-output "jq:$?" "$GG_TMP/rows.err" "Could not read gitleaks' JSON report."
LC_ALL=C sort -u -o "$GG_TMP/rows" -- "$GG_TMP/rows"

violations=0
while IFS="$GG_TAB" read -r n start end rule; do
  if [ -n "$LINES" ]; then
    # A finding under a diff scope counts where its lines hold one added over
    # each side: awk answers 0 for every side, 1 for fewer, and anything else
    # is an unread list.
    added=0
    LC_ALL=C awk -v s="$start" -v e="$end" -v sides="${SIDES[$n]}" \
      '$2 >= s && $2 <= e && !($1 in hit) { hit[$1]; held++ } END { exit held < sides }' \
      "$GG_TMP/added/$n" 2>"$GG_TMP/added.err" || added=$?
    case "$added" in
      0) ;;
      1) continue ;;
      *) gg_fail_cause added-read "${PATHS[$n]}:$added" "$GG_TMP/added.err" "Could not read the added lines of this path." ;;
    esac
  fi
  gg_message secret "${PATHS[$n]}:$start:$rule" "gitleaks rule $rule matches this line${ORIGINS[$n]}; the value is withheld. $REMEDY
A match that is no credential takes a row with its reason in $EXCLUDES_FILE. A row is a path glob: it removes the whole file from every later scan."
  violations=$((violations + 1))
done <"$GG_TMP/rows"

summary "$violations"
[ "$violations" -eq 0 ] || exit 1
