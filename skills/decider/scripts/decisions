#!/usr/bin/env bash
# Decision lookup tool — search, query, and manage architectural decision documents.
#
# Usage:
#   decisions search "FFI error handling"       Ranked keyword search (AND, scored)
#   decisions search --issue PROJ-189            Find decisions linked to an issue
#   decisions search "seqlock|mmap"             Regex OR (pipe = regex mode)
#   decisions list                              List all active decisions (compact)
#   decisions next-id                           Get next available DXXX
#   decisions get D017                          Get decision details
#
# Environment:
#   DECISIONS_DIR    Path to decision documents directory (required)
#                    Example: docs/decisions
#
# Missing directory:
#   Read-only lookups (search, list) treat an absent decisions directory as
#   "no decisions recorded": they emit an empty JSON array, note it on stderr,
#   and exit 0. Commands that feed the creation workflow (next-id, get) still
#   require an initialized directory and fail hard without one.
#
# Options:
#   --limit N        Max results for search (default: 5)
#
# Output:
#   search:   JSON array [{id, decision, path}] (keyword adds score field)
#   list:     JSON array [{id, decision, path}] of active decisions
#   next-id:  Single line "DXXX"
#   get:      JSON {id, decision, status, date, path}
#
set -euo pipefail

# Load optional project config before DECISIONS_DIR auto-discovery.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# shellcheck source=lib/vstack-env.sh
source "$SCRIPT_DIR/lib/vstack-env.sh"
vstack_load_project_env "$PROJECT_ROOT"

# --- Prerequisites ------------------------------------------------------------

if ! command -v jq &>/dev/null; then
  echo "Error: jq is required but not installed" >&2
  exit 1
fi

resolve_pcre_grep() {
  local candidate
  local candidates=()

  if candidate="$(command -v grep 2>/dev/null)"; then
    candidates+=("$candidate")
  fi
  if candidate="$(command -v ggrep 2>/dev/null)"; then
    candidates+=("$candidate")
  fi
  candidates+=(
    "/opt/homebrew/opt/grep/libexec/gnubin/grep"
    "/usr/local/opt/grep/libexec/gnubin/grep"
  )

  local seen=":"
  for candidate in "${candidates[@]}"; do
    [[ -n "$candidate" && -x "$candidate" ]] || continue
    case "$seen" in
      *":$candidate:"*) continue ;;
    esac
    seen+="$candidate:"

    if printf 'probe\n' | "$candidate" -qP '^probe$' >/dev/null 2>&1; then
      printf '%s\n' "$candidate"
      return 0
    fi
  done

  return 1
}

# --- Configuration -----------------------------------------------------------

# Auto-discover decisions directory if not set
if [[ -z "${DECISIONS_DIR:-}" ]]; then
  _dir="$(pwd)"
  while [[ "$_dir" != "/" ]]; do
    for _candidate in "docs/decisions" "decisions" "doc/decisions" "adr"; do
      if [[ -d "$_dir/$_candidate" && -f "$_dir/$_candidate/INDEX.md" ]]; then
        DECISIONS_DIR="$_dir/$_candidate"
        break 2
      fi
    done
    _dir="$(dirname "$_dir")"
  done
  unset _dir _candidate
fi

# An absent directory (unset and undiscovered, or a configured path that does
# not exist) is not an error by itself: read-only lookups treat it as "no
# decisions recorded" while creation-workflow commands still require it. A
# configured path that exists but is not a directory is always a hard error.
DECISIONS_DIR_ABSENT=0

if [[ -z "${DECISIONS_DIR:-}" ]]; then
  DECISIONS_DIR=""
  DECISIONS_DIR_ABSENT=1
elif [[ ! -e "$DECISIONS_DIR" ]]; then
  DECISIONS_DIR_ABSENT=1
elif [[ ! -d "$DECISIONS_DIR" ]]; then
  echo "Error: DECISIONS_DIR '$DECISIONS_DIR' is not a directory" >&2
  exit 1
fi

INDEX_FILE=""
if [[ "$DECISIONS_DIR_ABSENT" -eq 0 ]]; then
  INDEX_FILE="$DECISIONS_DIR/INDEX.md"
  if [[ ! -f "$INDEX_FILE" ]]; then
    echo "Error: INDEX.md not found in '$DECISIONS_DIR'" >&2
    exit 1
  fi
fi

# Hard requirement for commands that feed the creation workflow.
require_decisions_dir() {
  [[ "$DECISIONS_DIR_ABSENT" -eq 1 ]] || return 0
  if [[ -n "$DECISIONS_DIR" ]]; then
    echo "Error: DECISIONS_DIR '$DECISIONS_DIR' does not exist" >&2
  else
    echo "Error: Could not find decisions directory. Set DECISIONS_DIR or create docs/decisions/INDEX.md" >&2
  fi
  exit 1
}

# Empty-result diagnostic for read-only lookups when no directory exists.
note_missing_decisions_dir() {
  if [[ -n "$DECISIONS_DIR" ]]; then
    echo "note: decisions directory '$DECISIONS_DIR' not present — no decisions recorded" >&2
  else
    echo "note: no decisions directory found — no decisions recorded" >&2
  fi
}

PCRE_GREP="$(resolve_pcre_grep || true)"
if [[ -z "$PCRE_GREP" ]]; then
  cat >&2 <<'EOF'
Error: GNU grep with -P (PCRE) support is required.
Install GNU grep (ggrep) or add Homebrew GNU grep to PATH, for example:
  export PATH="/opt/homebrew/opt/grep/libexec/gnubin:$PATH"
  export PATH="/usr/local/opt/grep/libexec/gnubin:$PATH"
EOF
  exit 1
fi

# --- Helpers ------------------------------------------------------------------

trim() { echo "$1" | sed 's/^[[:space:]]*//;s/[[:space:]]*$//'; }

# Parse the INDEX.md table into JSON
parse_index() {
  if [[ ! -f "$INDEX_FILE" ]]; then
    echo '[]'
    return
  fi
  local rows
  rows=$(grep -E '^\| [0-9]{4}-' "$INDEX_FILE" || true)
  if [[ -z "$rows" ]]; then
    echo '[]'
    return
  fi
  echo "$rows" | while IFS='|' read -r _ date id research decision rationale revisit status link _; do
    id=$(trim "$id")
    research=$(trim "$research")
    decision=$(trim "$decision")
    rationale=$(trim "$rationale")
    status=$(trim "$status")
    local path=""
    path=$(echo "$link" | "$PCRE_GREP" -oP '\(([^)]+)\)' | head -1 | tr -d '()' || true)
    # Make path relative to DECISIONS_DIR so agents can read it directly
    if [[ -n "$path" ]]; then path="$DECISIONS_DIR/$path"; fi

    jq -n \
      --arg id "$id" \
      --arg research "$research" \
      --arg decision "$decision" \
      --arg rationale "$rationale" \
      --arg status "$status" \
      --arg path "$path" \
      '{id: $id, research: $research, decision: $decision, rationale: $rationale, status: $status, path: $path}'
  done | jq -s '.'
}

# --- Commands -----------------------------------------------------------------

show_help() {
  cat << 'EOF'
Decision Lookup Tool

Usage: decisions <action> [options]

Actions:
  search <query>       Ranked search (multi-word = AND, scored by relevance)
  search --issue ID    Find decisions linked to a specific issue
  list                 List all active decisions (compact)
  next-id              Get next available DXXX
  get <DXXX>           Get decision details (status, date, path)

Options:
  --limit N            Max results (default: 5)

Output: JSON arrays or objects
  search:  [{id, decision, path}] (keyword mode adds score field)
  list:    [{id, decision, path}]
  get:     {id, decision, status, date, path}

Search scoring:
  - Title/decision match: 3 points per term
  - ID match: 3 points per term
  - Rationale match: 1 point per term
  - All terms must match (AND logic) unless query contains |

Environment:
  DECISIONS_DIR    Path to decision documents directory (required)
                   Absent directory: search/list emit [] and exit 0 (note on
                   stderr); next-id/get still error until it is initialized.

Examples:
  decisions search "FFI error handling"    # Top decisions about FFI errors
  decisions search "ring buffer"           # Ring buffer decisions
  decisions search --issue PROJ-189         # All decisions from PROJ-189
  decisions search "seqlock|mmap"          # Regex OR (pipe = regex mode)
  decisions search "FFI" --limit 3         # Limit results
  decisions list                           # All active decisions
  decisions next-id                        # Next available DXXX
  decisions get D017                       # Details for D017
EOF
}

search_decisions() {
  local query=""
  local issue=""
  local limit=5

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue="$2"; shift 2 ;;
      --issue=*) issue="${1#--issue=}"; shift ;;
      --limit) limit="$2"; shift 2 ;;
      --limit=*) limit="${1#--limit=}"; shift ;;
      *) query="$1"; shift ;;
    esac
  done

  if [[ -z "$issue" && -z "$query" ]]; then
    echo '{"error": "Provide a search query or --issue ID"}' >&2
    return 1
  fi

  if [[ "$DECISIONS_DIR_ABSENT" -eq 1 ]]; then
    note_missing_decisions_dir
    echo '[]'
    return 0
  fi

  local all
  all=$(parse_index)

  if [[ -n "$issue" ]]; then
    # Issue search: exact match on Research column, compact output
    # Negative lookahead prevents PROJ-18 matching PROJ-189
    echo "$all" | jq --arg issue "$issue" '[
      .[] | select(.research | test($issue + "(?![0-9])"; "i")) |
      {id, decision, path}
    ]'
  else
    # Check if query contains regex operators — if so, use raw regex mode
    if echo "$query" | grep -qE '[|()\\]'; then
      echo "$all" | jq --arg q "$query" --argjson limit "$limit" '[
        .[] | select(
          (.decision | test($q; "i")) or
          (.rationale | test($q; "i")) or
          (.id | test($q; "i"))
        ) | {id, decision, path}
      ] | .[:$limit]'
    else
      # Multi-word AND search with relevance scoring
      echo "$all" | jq --arg q "$query" --argjson limit "$limit" '
        # Split query into terms
        ($q | ascii_downcase | split(" ") | map(select(length > 0))) as $terms |

        [.[] |
          # Check ALL terms match somewhere (AND logic)
          . as $row |
          ($row.decision + " " + $row.rationale + " " + $row.id | ascii_downcase) as $all_text |
          if ($terms | all(. as $t | $all_text | test($t))) then
            # Score: title match = 3pts, id match = 3pts, rationale = 1pt per term
            ($row.decision | ascii_downcase) as $title |
            ($row.id | ascii_downcase) as $did |
            ($row.rationale | ascii_downcase) as $rat |
            ([$terms[] | . as $t |
              (if ($title | test($t)) then 3 else 0 end) +
              (if ($did | test($t)) then 3 else 0 end) +
              (if ($rat | test($t)) then 1 else 0 end)
            ] | add) as $score |
            {id: $row.id, decision: $row.decision, path: $row.path, score: $score}
          else empty end
        ] | sort_by(-.score) | .[:$limit]
      '
    fi
  fi
}

list_decisions() {
  if [[ "$DECISIONS_DIR_ABSENT" -eq 1 ]]; then
    note_missing_decisions_dir
    echo '[]'
    return 0
  fi

  local all
  all=$(parse_index)
  echo "$all" | jq '[.[] | select(.status | startswith("Active")) | {id, decision, path}]'
}

cmd_next_id() {
  local max_num=0

  while IFS= read -r num; do
    # Force base-10 interpretation (strip leading zeros that bash treats as octal)
    local decimal=$((10#$num))
    if [[ "$decimal" -gt "$max_num" ]]; then
      max_num="$decimal"
    fi
  done < <("$PCRE_GREP" -oP 'D(\d+)' "$INDEX_FILE" | "$PCRE_GREP" -oP '\d+' | sort -n || true)

  printf "D%03d\n" $((max_num + 1))
}

cmd_get() {
  local id="${1:?Usage: decisions get <DECISION_ID>}"

  local all
  all=$(parse_index)

  local match
  match=$(echo "$all" | jq --arg id "$id" '[.[] | select(.id == $id)] | .[0] // empty')

  if [[ -z "$match" || "$match" == "null" ]]; then
    echo "Error: Decision $id not found" >&2
    exit 1
  fi

  # Enrich with date from decision file
  local path
  path=$(echo "$match" | jq -r '.path')
  local date="unknown"
  if [[ -f "$path" ]]; then
    date=$("$PCRE_GREP" -P '^\*\*Date\*\*:' "$path" | head -1 | sed 's/\*\*Date\*\*: //' || echo "unknown")
  fi

  echo "$match" | jq --arg date "$date" '. + {date: $date}'
}

# --- Main ---------------------------------------------------------------------

action="${1:-help}"
shift || true

case "$action" in
  search)
    if [[ -z "${1:-}" ]] || [[ "${1:-}" == "--help" ]]; then
      show_help
      exit 0
    fi
    search_decisions "$@"
    ;;
  list)
    list_decisions
    ;;
  next-id)
    require_decisions_dir
    cmd_next_id
    ;;
  get)
    require_decisions_dir
    cmd_get "$@"
    ;;
  help|--help|-h)
    show_help
    ;;
  issue|issues)
    echo "Error: Unknown action '$action' — issue lookup is: decisions search --issue <ISSUE_ID>" >&2
    exit 1
    ;;
  *)
    echo "Error: Unknown action '$action'" >&2
    show_help
    exit 1
    ;;
esac
