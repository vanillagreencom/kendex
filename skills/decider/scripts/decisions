#!/usr/bin/env bash
# Decision lookup tool — search and query architectural decision documents.
# Run `decisions help` for usage.
#
# Read-only lookups (search, list) treat an absent decisions directory as "no
# decisions recorded": empty JSON array, note on stderr, exit 0. Commands that
# feed the creation workflow (next-id, get) require an initialized directory.
set -euo pipefail

# Load optional project config before DECISIONS_DIR auto-discovery.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# shellcheck source=lib/vstack-env.sh
source "$SCRIPT_DIR/lib/vstack-env.sh"
vstack_load_project_env "$PROJECT_ROOT"

if ! command -v jq &>/dev/null; then
  echo "Error: jq is required but not installed" >&2
  exit 1
fi

# --- Configuration -----------------------------------------------------------

if [[ -z "${DECISIONS_DIR:-}" ]]; then
  _dir="$(pwd)"
  while [[ "$_dir" != "/" ]]; do
    for _candidate in "docs/decisions" "decisions" "doc/decisions" "adr"; do
      if [[ -d "$_dir/$_candidate" && -f "$_dir/$_candidate/INDEX.md" ]]; then
        DECISIONS_DIR="$_dir/$_candidate"
        break 2
      fi
    done
    _dir="$(dirname "$_dir")"
  done
  unset _dir _candidate
fi

# An absent directory (unset and undiscovered, or a configured path that does
# not exist) is not an error by itself. A configured path that exists but is
# not a directory always is.
DECISIONS_DIR_ABSENT=0

if [[ -z "${DECISIONS_DIR:-}" ]]; then
  DECISIONS_DIR=""
  DECISIONS_DIR_ABSENT=1
elif [[ ! -e "$DECISIONS_DIR" ]]; then
  DECISIONS_DIR_ABSENT=1
elif [[ ! -d "$DECISIONS_DIR" ]]; then
  echo "Error: DECISIONS_DIR '$DECISIONS_DIR' is not a directory" >&2
  exit 1
fi

INDEX_FILE=""
if [[ "$DECISIONS_DIR_ABSENT" -eq 0 ]]; then
  INDEX_FILE="$DECISIONS_DIR/INDEX.md"
  if [[ ! -f "$INDEX_FILE" ]]; then
    echo "Error: INDEX.md not found in '$DECISIONS_DIR'" >&2
    exit 1
  fi
fi

require_decisions_dir() {
  [[ "$DECISIONS_DIR_ABSENT" -eq 1 ]] || return 0
  if [[ -n "$DECISIONS_DIR" ]]; then
    echo "Error: DECISIONS_DIR '$DECISIONS_DIR' does not exist" >&2
  else
    echo "Error: Could not find decisions directory. Set DECISIONS_DIR or create docs/decisions/INDEX.md" >&2
  fi
  exit 1
}

note_missing_decisions_dir() {
  if [[ -n "$DECISIONS_DIR" ]]; then
    echo "note: decisions directory '$DECISIONS_DIR' not present — no decisions recorded" >&2
  else
    echo "note: no decisions directory found — no decisions recorded" >&2
  fi
}

# --- Helpers ------------------------------------------------------------------

PARSED_ID_PREFIX=""
PARSED_ID_NUM=""

split_decision_id() {
  local value="$1"
  PARSED_ID_PREFIX=""
  PARSED_ID_NUM=""

  if [[ "$value" =~ ^(.*[^0-9])?([0-9]+)$ ]]; then
    PARSED_ID_PREFIX="${BASH_REMATCH[1]}"
    PARSED_ID_NUM="${BASH_REMATCH[2]}"
    return 0
  fi

  return 1
}

# Parse the INDEX.md table into JSON, one jq pass over the whole file.
#
# Column order is a machine contract: a row is a line starting `| YYYY-` and
# its eight cells are read positionally (date, id, research, decision,
# rationale, revisit, status, link). The link cell yields the decision
# document's path — preferred as a markdown link target, falling back to a
# backticked or bare `.md` filename so an index written from an older row
# template still resolves its documents instead of silently reporting none.
parse_index() {
  if [[ -z "$INDEX_FILE" || ! -f "$INDEX_FILE" ]]; then
    echo '[]'
    return
  fi
  # A row that opens `| YYYY-` but misses the eight-cell contract is dropped
  # from the results. Dropped silently it reads downstream as a decision nobody
  # ever recorded, so every such row is named on stderr. stdout still carries
  # exactly the rows that parse.
  jq -R -s -r --arg f "$INDEX_FILE" '
    split("\n")
    | to_entries[]
    | select(.value | test("^\\| [0-9]{4}-"))
    | select((.value | split("|") | length) < 9)
    | "WARNING: \($f):\(.key + 1): INDEX row has \(.value | split("|") | length) cells, need at least 9 — row skipped: \(.value)"
  ' "$INDEX_FILE" >&2
  jq -R -s -c --arg dir "$DECISIONS_DIR" '
    def cell_path:
      . as $cell
      | ( [ $cell | scan("\\(([^)]+)\\)") ]
        + [ $cell | scan("`([^`]+\\.md)`") ]
        + [ $cell | scan("([A-Za-z0-9][A-Za-z0-9._/-]*\\.md)") ] )
      | if length > 0 then .[0][0] else "" end;
    [ split("\n")[]
      | select(test("^\\| [0-9]{4}-"))
      | split("|")
      | select(length >= 9)
      | map(sub("^\\s+"; "") | sub("\\s+$"; ""))
      | { id: .[2], research: .[3], decision: .[4], rationale: .[5],
          status: .[7], path: (.[8] | cell_path) }
      | .path |= (if . == "" then "" else $dir + "/" + . end)
    ]' "$INDEX_FILE"
}

show_help() {
  cat << 'EOF'
Decision Lookup Tool

Usage: decisions <action> [options]

Actions:
  search <query>       Ranked search (multi-word = AND, scored). Matches the
                       INDEX summary columns (decision, rationale, id) AND the
                       linked decision document bodies; summary matches outrank
                       body-only matches. A query containing | ( ) or \ switches
                       to regex mode (no scoring).
  search --issue ID    Decisions linked to an issue (Research column, exact
                       match; bodies are not scanned)
  list                 Active decisions
  next-id              Next decision ID, scheme inferred from the ID column
  get <DECISION_ID>    Decision details (status, date, path)

Options:
  --limit N            Max search results (default: 5)

Output (JSON):
  search:  [{id, decision, path}] (keyword mode adds score)
  list:    [{id, decision, path}]
  get:     {id, decision, status, date, path}

Scoring per term: decision 3, id 3, rationale 1, body 0.5.

Environment:
  DECISIONS_DIR        Decision documents directory. When absent, search/list
                       emit [] and exit 0 (note on stderr); next-id/get error.
  DECISION_ID_PREFIX   ID prefix for next-id (default: inferred)
  DECISION_ID_WIDTH    Zero-padding width for next-id (default: inferred)

Examples:
  decisions search "FFI error handling"
  decisions search "seqlock|mmap"
  decisions search --issue PROJ-189
  decisions search "FFI" --limit 3
  decisions list
  decisions next-id
  decisions get D017
EOF
}

# Which indexed decision BODIES match each term.
#
# One grep per TERM over only the files the index links, so cost scales with
# query length rather than corpus size, and unindexed or stray files in the
# directory cannot influence results. Emits {path: [terms...]}.
body_term_hits() {
  local rows_json="$1"; shift
  local paths=() path term matched hits=""

  while IFS= read -r path; do
    if [[ -n "$path" ]]; then
      paths+=("$path")
    fi
  done < <(printf '%s' "$rows_json" | jq -r '.[] | select(.path != null and .path != "") | .path')

  if [[ "${#paths[@]}" -eq 0 ]]; then
    echo '{}'
    return 0
  fi

  for term in "$@"; do
    if [[ -z "$term" ]]; then
      continue
    fi
    # -l lists matching files. Unreadable or absent files are not matches, and
    # a term that matches nothing is not an error.
    matched=$(printf '%s\0' "${paths[@]}" | xargs -0 -r grep -ilE -e "$term" -- 2>/dev/null || true)
    if [[ -n "$matched" ]]; then
      while IFS= read -r path; do
        hits+="$path"$'\t'"$term"$'\n'
      done <<< "$matched"
    fi
  done

  printf '%s' "$hits" | jq -R -s -c '
    split("\n") | map(select(length > 0) | split("\t") | {path: .[0], term: .[1]})
    | group_by(.path) | map({key: .[0].path, value: [.[].term]}) | from_entries
  '
}

# --- Commands -----------------------------------------------------------------

search_decisions() {
  local query=""
  local issue=""
  local limit=5

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --issue) issue="$2"; shift 2 ;;
      --issue=*) issue="${1#--issue=}"; shift ;;
      --limit) limit="$2"; shift 2 ;;
      --limit=*) limit="${1#--limit=}"; shift ;;
      *) query="$1"; shift ;;
    esac
  done

  if [[ -z "$issue" && -z "$query" ]]; then
    echo '{"error": "Provide a search query or --issue ID"}' >&2
    return 1
  fi

  if [[ "$DECISIONS_DIR_ABSENT" -eq 1 ]]; then
    note_missing_decisions_dir
    echo '[]'
    return 0
  fi

  local all
  all=$(parse_index)

  if [[ -n "$issue" ]]; then
    # Negative lookahead prevents PROJ-18 matching PROJ-189.
    echo "$all" | jq --arg issue "$issue" '[
      .[] | select(.research | test($issue + "(?![0-9])"; "i")) |
      {id, decision, path}
    ]'
    return 0
  fi

  if echo "$query" | grep -qE '[|()\\]'; then
    local rx_bodies
    rx_bodies=$(body_term_hits "$all" "$query")
    echo "$all" | jq --arg q "$query" --argjson limit "$limit" --argjson bodies "$rx_bodies" '[
      .[] | select(
        (.decision | test($q; "i")) or
        (.rationale | test($q; "i")) or
        (.id | test($q; "i")) or
        (($bodies[.path] // []) | length > 0)
      ) | {id, decision, path}
    ] | .[:$limit]'
    return 0
  fi

  local terms_arr kw_bodies
  # Same split jq performs below, so grep and jq agree on term boundaries.
  read -r -a terms_arr <<< "$(echo "$query" | tr '[:upper:]' '[:lower:]')"
  kw_bodies=$(body_term_hits "$all" "${terms_arr[@]}")
  echo "$all" | jq --arg q "$query" --argjson limit "$limit" --argjson bodies "$kw_bodies" '
    ($q | ascii_downcase | split(" ") | map(select(length > 0))) as $terms |

    [.[] |
      # A term counts if it is in the summary columns OR in the decision
      # document body, so AND can be satisfied across both — one term in the
      # title, another in prose.
      . as $row |
      ($row.decision + " " + $row.rationale + " " + $row.id | ascii_downcase) as $all_text |
      (($bodies[$row.path] // []) | map(ascii_downcase)) as $body_terms |
      if ($terms | all(. as $t | ($all_text | test($t)) or ($body_terms | index($t) != null))) then
        # Body scores below rationale, so a body-only hit always sorts under
        # every summary match rather than displacing one.
        ($row.decision | ascii_downcase) as $title |
        ($row.id | ascii_downcase) as $did |
        ($row.rationale | ascii_downcase) as $rat |
        ([$terms[] | . as $t |
          (if ($title | test($t)) then 3 else 0 end) +
          (if ($did | test($t)) then 3 else 0 end) +
          (if ($rat | test($t)) then 1 else 0 end) +
          (if ($body_terms | index($t) != null) then 0.5 else 0 end)
        ] | add) as $score |
        {id: $row.id, decision: $row.decision, path: $row.path, score: $score}
      else empty end
    ] | sort_by(-.score) | .[:$limit]
  '
}

list_decisions() {
  if [[ "$DECISIONS_DIR_ABSENT" -eq 1 ]]; then
    note_missing_decisions_dir
    echo '[]'
    return 0
  fi

  parse_index | jq '[.[] | select(.status | startswith("Active")) | {id, decision, path}]'
}

cmd_next_id() {
  local ids=() id
  while IFS= read -r id; do
    if [[ -n "$id" ]]; then
      ids+=("$id")
    fi
  done < <(parse_index | jq -r '.[].id // empty')

  local prefix="D"
  local width=3
  local prefix_configured=0
  local width_configured=0

  if [[ "${DECISION_ID_PREFIX+x}" == "x" ]]; then
    prefix="$DECISION_ID_PREFIX"
    prefix_configured=1
  fi

  if [[ "${DECISION_ID_WIDTH+x}" == "x" ]]; then
    if [[ ! "$DECISION_ID_WIDTH" =~ ^[1-9][0-9]*$ ]]; then
      echo "Error: DECISION_ID_WIDTH must be a positive integer" >&2
      return 1
    fi
    width="$DECISION_ID_WIDTH"
    width_configured=1
  fi

  if [[ "$prefix_configured" -eq 0 ]]; then
    # Infer the scheme from the last populated ID-column value. If it is not
    # incrementable, fail loudly instead of falling back to an older row and
    # returning a plausible but wrong ID.
    if [[ "${#ids[@]}" -gt 0 ]]; then
      local last_id="${ids[${#ids[@]} - 1]}"
      if ! split_decision_id "$last_id"; then
        echo "Error: Last decision ID '$last_id' in INDEX.md has no numeric suffix. Set DECISION_ID_PREFIX and DECISION_ID_WIDTH to select a scheme explicitly." >&2
        return 1
      fi
      prefix="$PARSED_ID_PREFIX"
      if [[ "$width_configured" -eq 0 ]]; then
        width="${#PARSED_ID_NUM}"
      fi
    fi
  elif [[ "$width_configured" -eq 0 ]]; then
    # A configured prefix selects the scheme; infer padding from matching rows.
    for id in ${ids[@]+"${ids[@]}"}; do
      if split_decision_id "$id" && [[ "$PARSED_ID_PREFIX" == "$prefix" ]]; then
        width="${#PARSED_ID_NUM}"
      fi
    done
  fi

  local max_num=0 decimal
  for id in ${ids[@]+"${ids[@]}"}; do
    if ! split_decision_id "$id"; then
      continue
    fi
    if [[ "$PARSED_ID_PREFIX" != "$prefix" ]]; then
      continue
    fi
    # Force base-10 (leading zeros would otherwise read as octal).
    decimal=$((10#$PARSED_ID_NUM))
    if [[ "$decimal" -gt "$max_num" ]]; then
      max_num="$decimal"
    fi
  done

  printf "%s%0*d\n" "$prefix" "$width" $((max_num + 1))
}

cmd_get() {
  local id="${1:?Usage: decisions get <DECISION_ID>}"

  local match
  match=$(parse_index | jq --arg id "$id" '[.[] | select(.id == $id)] | .[0] // empty')

  if [[ -z "$match" || "$match" == "null" ]]; then
    echo "Error: Decision $id not found" >&2
    exit 1
  fi

  local path date="unknown" parsed
  path=$(printf '%s' "$match" | jq -r '.path')
  if [[ -n "$path" && -f "$path" ]]; then
    parsed=$(awk '/^\*\*Date\*\*:/ { sub(/^\*\*Date\*\*:[[:space:]]*/, ""); print; exit }' < "$path")
    if [[ -n "$parsed" ]]; then
      date="$parsed"
    fi
  fi

  printf '%s' "$match" | jq --arg date "$date" '. + {date: $date}'
}

# --- Main ---------------------------------------------------------------------

action="${1:-help}"
shift || true

case "$action" in
  search)
    if [[ -z "${1:-}" ]] || [[ "${1:-}" == "--help" ]]; then
      show_help
      exit 0
    fi
    search_decisions "$@"
    ;;
  list)
    list_decisions
    ;;
  next-id)
    require_decisions_dir
    cmd_next_id
    ;;
  get)
    require_decisions_dir
    cmd_get "$@"
    ;;
  help|--help|-h)
    show_help
    ;;
  issue|issues)
    echo "Error: Unknown action '$action' — issue lookup is: decisions search --issue <ISSUE_ID>" >&2
    exit 1
    ;;
  *)
    echo "Error: Unknown action '$action'" >&2
    show_help
    exit 1
    ;;
esac
