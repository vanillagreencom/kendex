[env]

# DEV — the command dev agents run to validate a change (dev skill).
# Project-scope `kendex add` / `kendex refresh` merge these defaults into
# <project>/kendex.settings.toml (never overwriting existing keys). Full
# reference: dev README.md.

# The project's validation command, run from the worktree root — point it at
# a diff-scoped validator where one exists. Empty = the project's documented
# build/test/lint command.
DEV_VALIDATE_CMD = ""
