[env]

# DEV — the command dev agents run to validate a change (dev skill).
# DEV_VALIDATE_CMD below is the one key marked `# required`, so installing
# this skill writes that key into <project>/kendex.settings.toml and nothing
# else. What an install writes, and when, is kendex's docs/authoring/settings.md.
# Full reference: dev README.md.

# The project's full test, lint and typecheck command, run from the worktree
# root. The dev workflow refuses to validate while this is empty.
DEV_VALIDATE_CMD = "" # required

# The command a review-fix round runs instead, validating only the changes
# since the commit it reads from $DEV_VALIDATE_BASE, for example
# "tools/check --since $DEV_VALIDATE_BASE". Empty runs DEV_VALIDATE_CMD.
# Submit reuses only a DEV_VALIDATE_CMD result.
DEV_VALIDATE_RANGE_CMD = ""

# How long either command may run, in whole seconds, before it is signalled and,
# ten seconds later, killed outright, with the round recording a failed
# validation. It is also the one number the wait is derived from, so no agent
# picks its own polling cap.
DEV_VALIDATE_TIMEOUT_SECS = "3600"
