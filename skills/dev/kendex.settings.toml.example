[env]

# How a coding agent checks its own work before handing it back.

# The command that runs this project's tests, linting and type checks. An
# agent runs it from the project root, and refuses to finish the work while
# this is empty.
DEV_VALIDATE_CMD = "" # required

# The command a review-fix round runs instead, validating only the changes
# since the commit it reads from $DEV_VALIDATE_BASE, for example
# "tools/check --since $DEV_VALIDATE_BASE". Empty runs DEV_VALIDATE_CMD.
# An orch restack also runs it, as orch's merge-pr-restack.md sets out.
# Submit can reuse a current-head pending CI receipt; uncovered work keeps
# local validation. dev-validate-run --help defines coverage and fallback.
DEV_VALIDATE_RANGE_CMD = ""

# The status check context whose pull request run covers DEV_VALIDATE_CMD,
# for example "CI". Covered fix rounds on an open pull request can defer to
# that check. Explicit ORCH_PR_ORDER=push-first also permits covered
# implementation and internal-fix rounds to defer before publication.
# Their receipts accept local edits with CI pending; submit verifies the
# published head before merge. Uncovered work keeps local validation.
# Empty validates locally. dev-validate-run --help defines coverage.
DEV_VALIDATE_CI_CONTEXT = ""

# The prefix both commands print each finding line with, such as "guard: ".
# A run the timeout below stopped whose output holds no such line refuted
# nothing: a later run over no fewer files is not run past the timeout again,
# and a restack does not count the stopped run as a failure. Empty treats
# every stopped run as a possible failure.
DEV_VALIDATE_FINDING_PREFIX = ""

# Seconds either command may run before it is stopped. A stopped run is
# neither a pass nor a failure; the agent then runs, one at a time, the test
# files for each script the change touches. The same number decides how long
# an agent waits, so no agent picks its own.
DEV_VALIDATE_TIMEOUT_SECS = "3600"
