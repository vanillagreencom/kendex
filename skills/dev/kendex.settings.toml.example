[env]

# How a coding agent checks its own work before handing it back.

# The command that runs this project's tests, linting and type checks. An
# agent runs it from the project root, and refuses to finish the work while
# this is empty.
DEV_VALIDATE_CMD = "" # required

# The command a review-fix round runs instead, validating only the changes
# since the commit it reads from $DEV_VALIDATE_BASE, for example
# "tools/check --since $DEV_VALIDATE_BASE". Empty runs DEV_VALIDATE_CMD.
# An orch restack also runs it, as orch's merge-pr-restack.md sets out.
# Submit can reuse a current-head pending CI receipt; uncovered work keeps
# local validation. orch-runtime validate entry --help defines coverage and
# fallback.
DEV_VALIDATE_RANGE_CMD = ""

# The status check context whose run covers DEV_VALIDATE_CMD, for example
# "CI": the merge-group run for a queue-only change, the pull request run
# otherwise. Covered implementation and fix rounds leave validation to
# that check, before publication too, under every ORCH_PR_ORDER: before a
# pull request opens, the resolved base branch's rules decide.
# Their receipts accept local edits with CI pending; the merge-group run
# proves a queue-only change's head before merge. Uncovered work keeps local validation.
# Empty validates locally. orch-runtime validate entry --help defines coverage.
DEV_VALIDATE_CI_CONTEXT = ""

# The optional command that previews selection=all or selection=subset.
# It may also print expected-secs=N on a separate line, with its own margin.
# The start records N as the run's expected time: a run past it is warned
# of once and goes on, and no estimate refuses a start.
DEV_VALIDATE_SELECTION_CMD = ""

# The prefix both commands print each finding line with, such as "guard: ".
# A no-verdict run (the command's exit 3, or a host check that could not
# run) whose output holds no such line refuted nothing: the last-pass read
# and a restack count it as a pass, not a failure. Empty treats every
# no-verdict run as a possible failure.
DEV_VALIDATE_FINDING_PREFIX = ""
