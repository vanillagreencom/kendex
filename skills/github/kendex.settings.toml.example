[env]

# GITHUB — the review bot this repo trusts, its issue-id shape, and the
# timeouts around `gh` (github skill). `kendex add` writes the keys marked
# `# required` below into <project>/kendex.settings.toml, once, when this
# skill arrives; every other key here ships the value its own scripts
# already read, and assigning it there is how a project changes one. Tokens
# are not settings: keep GH_TOKEN and friends in `.env.local`. Full
# reference: github README.md.

# Bot login the sticky-verdict commands target. Empty means unconfigured:
# the sticky-comment search still prefers review-bot[bot], but accepts a
# review summary from any known review-bot login when that one posted none.
# A value pins the login and turns that fallback off.
GH_BOT_USERNAME = ""

# Regex extracting the issue id from a branch name. Empty leaves each reader
# its own default, and they differ: `pr-issue` and `open-terminal` match
# [A-Z]+-[0-9]+, `git-context` also matches issue-N. A value here replaces
# all three, so set one only for a shape none of them covers.
GH_ISSUE_PATTERN = ""

# Build/test command `pr-cross-check --verify` runs. Empty falls back to a
# project-root `verify.sh`, then to auto-detected build stacks.
GH_VERIFY_CMD = ""

# Seconds a 1Password token resolution may take.
KENDEX_GITHUB_OP_TIMEOUT = "10"

# Seconds the `gh` auth preflight may take.
KENDEX_GITHUB_AUTH_TIMEOUT = "10"

# Seconds a single `pr-view` read may take.
KENDEX_GITHUB_PR_VIEW_TIMEOUT = "30"
