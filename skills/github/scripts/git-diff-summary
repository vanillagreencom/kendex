#!/bin/bash
# Git diff domain summary - group changed files by domain with stats and risk flags
# Usage: git-diff-summary [base-branch]
#        git-diff-summary main
#        git-diff-summary --staged

set -euo pipefail

show_help() {
    cat << 'EOF'
Git Diff Domain Summary

Groups changed files by domain (auto-detected from top-level directories)
with stats and risk flags. Designed for review routing decisions.

Usage: git-diff-summary [-C path] [base-branch]

Arguments:
  base-branch    Compare against this branch (default: the remote default
                 branch, e.g. origin/main; falls back to local main when
                 no remote-tracking ref exists)
  -C path        Run as if started in <path> (worktree support)
  --staged       Show only staged changes
  --head         Show uncommitted changes vs HEAD

Output: JSON with scope (production|support), domain groupings, stats, and risk flags
EOF
}

# Default base for review scope. A stale local main must not widen scope to
# unrelated commits (vstack#718), so prefer the already-fetched remote-tracking
# ref of the repo's default branch. No network: never fetches, so offline/CI
# calls keep working. Falls back to local main when the repo has no remote.
resolve_default_base() {
    local head_ref
    head_ref=$(git symbolic-ref --quiet refs/remotes/origin/HEAD 2>/dev/null || true)
    if [ -n "$head_ref" ] && git rev-parse --verify --quiet "$head_ref" >/dev/null; then
        echo "${head_ref#refs/remotes/}"
        return
    fi
    local candidate
    for candidate in origin/main origin/master; do
        if git rev-parse --verify --quiet "refs/remotes/$candidate" >/dev/null; then
            echo "$candidate"
            return
        fi
    done
    echo "main"
}

main() {
    local base=""
    local diff_args=""
    local git_dir=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h) show_help; exit 0 ;;
            --staged) diff_args="--staged"; shift ;;
            --head) diff_args="HEAD"; shift ;;
            -C) git_dir="$2"; shift 2 ;;
            *) base="$1"; shift ;;
        esac
    done

    # Use -C path if provided, otherwise repo root
    if [ -n "$git_dir" ]; then
        cd "$git_dir"
    else
        cd "$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
    fi

    # Determine diff command (base resolution must run inside the target repo)
    local diff_ref
    if [ -n "$diff_args" ]; then
        diff_ref="$diff_args"
    else
        if [ -z "$base" ]; then
            base=$(resolve_default_base)
        fi
        diff_ref="${base}...HEAD"
    fi

    # Get file list with status (A/M/D/R)
    local files
    files=$(git diff --name-status $diff_ref 2>/dev/null || echo "")

    if [ -z "$files" ]; then
        echo '{"files_changed": 0, "scope": "support", "domains": {}, "risk_flags": []}'
        exit 0
    fi

    # Get stats
    local stats
    stats=$(git diff --stat --stat-count=999 $diff_ref 2>/dev/null | tail -1 || echo "0 files changed")

    # Detect risk flags via grep (avoids passing huge diffs through jq)
    local risk_flags="[]"
    local flags=()
    local rust_diff_added
    rust_diff_added=$(git diff $diff_ref -- '*.rs' 2>/dev/null | grep -E '^\+' || true)

    if echo "$rust_diff_added" | grep -qE '^\+.*unsafe '; then flags+=("unsafe_code_added"); fi
    if echo "$rust_diff_added" | grep -qE '^\+.*#\[repr\(C\)\]'; then flags+=("repr_c_struct_changed"); fi
    if echo "$rust_diff_added" | grep -qE '^\+.*extern "C"'; then flags+=("extern_c_changed"); fi
    if echo "$rust_diff_added" | grep -qE '^\+.*(Atomic|atomic::)'; then flags+=("atomics_modified"); fi

    # panic/unwrap in production source is the `panic_path_added` risk flag.
    # The same patterns whose enclosing context is a test surface — tests/
    # dirs, *_tests.rs files, or #[cfg(test)] modules inside production files —
    # are the distinct informational `test_panic_path_added` flag instead: a
    # test assertion is not a production panic path (vstack#944).
    local prod_paths
    prod_paths=$(echo "$files" | awk -F'\t' '{print $NF}' \
        | grep -E '(^|/)src/|(^|/)lib/' \
        | grep -vE '(/tests/|/benches/|/test/|/fixtures/|_tests?\.rs$|\.test\.[jt]sx?$|\.spec\.[jt]sx?$)' || true)
    local prod_panic=0 test_panic=0
    if [ -n "$prod_paths" ]; then
        # path<TAB>new-side line number of each added panic-pattern line
        local panic_lines
        # shellcheck disable=SC2086
        panic_lines=$(git diff $diff_ref -- $prod_paths 2>/dev/null | awk '
            /^diff --git / { path = ""; inhunk = 0 }
            /^\+\+\+ b\//  { path = substr($0, 7); next }
            /^@@/ {
                split($0, parts, "+"); split(parts[2], nums, /[, ]/)
                lineno = nums[1] + 0; inhunk = 1; next
            }
            !inhunk || path == "" { next }
            /^-/ { next }
            /^\+/ {
                if ($0 ~ /panic!|unwrap\(\)/) print path "\t" lineno
                lineno++; next
            }
            { lineno++ }
        ')
        local panic_file file_lines file_content counts pcount tcount
        for panic_file in $(echo "$panic_lines" | cut -f1 | sort -u); do
            file_lines=$(echo "$panic_lines" | awk -F'\t' -v f="$panic_file" '$1 == f {print $2}' | paste -sd, -)
            # New-side content of the file: HEAD for a base...HEAD diff, the
            # index for --staged, the worktree for --head.
            case "$diff_ref" in
                --staged) file_content=$(git show ":$panic_file" 2>/dev/null || true) ;;
                HEAD)     file_content=$(cat "$panic_file" 2>/dev/null || true) ;;
                *)        file_content=$(git show "HEAD:$panic_file" 2>/dev/null || true) ;;
            esac
            # Split the panic lines into production vs #[cfg(test)] context by
            # brace-tracking the block a #[cfg(test)] attribute opens.
            counts=$(printf '%s\n' "$file_content" | awk -v targets="$file_lines" '
                BEGIN { n = split(targets, t, ","); for (i = 1; i <= n; i++) want[t[i] + 0] = 1 }
                {
                    opens = gsub(/{/, "{"); closes = gsub(/}/, "}")
                    intest = 0
                    if (depth > 0) {
                        intest = 1
                        depth += opens - closes
                        if (depth < 0) depth = 0
                    } else if (pending) {
                        if (opens > 0) {
                            pending = 0; intest = 1
                            depth = opens - closes
                            if (depth < 0) depth = 0
                        } else if ($0 !~ /^[[:space:]]*(#\[|\/\/)/ && $0 !~ /^[[:space:]]*$/) {
                            # braceless item (e.g. a use) consumed the attribute
                            pending = 0; intest = 1
                        }
                    } else if ($0 ~ /#\[cfg\(test\)\]/) {
                        intest = 1
                        if (opens > 0) {
                            depth = opens - closes
                            if (depth < 0) depth = 0
                        } else { pending = 1 }
                    }
                    if (want[NR]) { if (intest) tcount++; else pcount++ }
                }
                END { printf "%d %d\n", pcount + 0, tcount + 0 }
            ')
            read -r pcount tcount <<< "$counts"
            if [ "$pcount" -gt 0 ]; then prod_panic=1; fi
            if [ "$tcount" -gt 0 ]; then test_panic=1; fi
        done
    fi
    if [ "$prod_panic" -eq 1 ]; then flags+=("panic_path_added"); fi

    # Whole-file test surfaces (tests/ dirs, *_tests.rs) carry the same
    # informational flag so the addition stays visible without routing as risk.
    local test_paths
    test_paths=$(echo "$files" | awk -F'\t' '{print $NF}' \
        | grep -E '(^|/)tests?/|_tests?\.rs$' || true)
    if [ -n "$test_paths" ]; then
        local test_diff
        # shellcheck disable=SC2086
        test_diff=$(git diff $diff_ref -- $test_paths 2>/dev/null | grep -E '^\+' || true)
        if echo "$test_diff" | grep -qE '^\+.*(panic!|unwrap\(\))'; then test_panic=1; fi
    fi
    if [ "$test_panic" -eq 1 ]; then flags+=("test_panic_path_added"); fi

    if [ ${#flags[@]} -gt 0 ]; then
        risk_flags=$(printf '"%s"\n' "${flags[@]}" | jq -s '.')
    fi

    # Classify files into domains and build output.
    # Domain = top-level directory name. Standard infrastructure dirs are grouped.
    echo "$files" | jq -Rs --arg stats "$stats" --argjson risk_flags "$risk_flags" '
        # Parse file list
        split("\n") | map(select(length > 0)) | map(
            capture("^(?<status>[AMDRC])[0-9]*\t(?<path>.+)$") // null
        ) | map(select(. != null)) |

        # Classify each file into domain + scope
        map(. + {
            domain: (
                if .path | test("^docs/")
                    then "docs"
                elif .path | test("^(tools|scripts|\\.github|\\.ci|\\.circleci|\\.gitlab|infra|deploy|terraform|pulumi)/")
                    then "infra"
                else
                    (.path | split("/")[0] // "root")
                end
            ),
            file_scope: (
                if .path | test("(/tests?/|/benches?/|/fixtures/|_tests?\\.rs$|\\.test\\.[jt]sx?$|\\.spec\\.[jt]sx?$)")
                    then "test"
                elif .path | test("^docs/")
                    then "docs"
                elif .path | test("^(tools|scripts|\\.github|\\.ci|\\.circleci|\\.gitlab|infra|deploy|terraform|pulumi)/")
                    then "infra"
                else "production"
                end
            )
        }) |

        # Capture scope before grouping (production if any prod file touched)
        . as $all_files |

        # Group by domain
        group_by(.domain) | map({
            key: .[0].domain,
            value: {
                files: [.[] | .path],
                count: length,
                added: [.[] | select(.status == "A")] | length,
                modified: [.[] | select(.status == "M")] | length,
                deleted: [.[] | select(.status == "D")] | length
            }
        }) | from_entries |

        # Parse stats line
        . as $domains |
        ($stats | capture("(?<files>[0-9]+) files? changed(, (?<ins>[0-9]+) insertions?\\(\\+\\))?(, (?<del>[0-9]+) deletions?\\(-\\))?") //
            {files: "0", ins: "0", del: "0"}) as $s |

        {
            files_changed: ($s.files | tonumber),
            insertions: (($s.ins // "0") | tonumber),
            deletions: (($s.del // "0") | tonumber),
            scope: (if ($all_files | any(.file_scope == "production")) then "production" else "support" end),
            domains: $domains,
            risk_flags: $risk_flags
        }
    '
}

main "$@"
