#!/usr/bin/env bash
# md-reflow — rewrite markdown to the format md-format judges: the lines of
# a paragraph, a list item or a blockquote paragraph joined into one with
# single spaces, trailing-double-space breaks joined away, and the missing
# blank line put before a heading, a fence or a list that follows a
# paragraph line. Fenced code, tables, HTML blocks, indented code and front
# matter come out byte-identical, and so does a file that is already clean.
# The grammar is lib/md-blocks.awk's, the one md-format reads by.
#
#   md-reflow [--check] PATH...     these work-tree files
#   md-reflow [--check] --staged    the work-tree copy of every markdown
#                                   file the staged diff adds or changes
#   md-reflow [--check] --all       every tracked markdown file the path
#                                   globs name
#
# --check writes nothing and exits 1 naming each file a reflow would change.
# A CRLF file is refused, not converted. Exit codes: 0 clean or rewritten;
# 1 --check found work; 2 usage/config/collection error.
set -euo pipefail
set -f

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The one newline `pwd` appended; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="md-reflow"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"
# shellcheck source=lib/md-scope.sh
source "$SCRIPT_DIR/lib/md-scope.sh"

PATHS_DEFAULT="*.md"
BLOCKS_AWK="$SCRIPT_DIR/lib/md-blocks.awk"
SHAPES_AWK="$SCRIPT_DIR/lib/md-shapes.awk"

usage() {
  cat <<EOF
usage: md-reflow [--check] PATH... | [--check] --staged | [--check] --all

Rewrites markdown to the format md-format judges: one paragraph per line,
one list item per line, blank lines before a heading, fence or list that
follows a paragraph line, no trailing-double-space break. Fenced code,
tables, HTML blocks, indented code and front matter are untouched; a clean
file is untouched; a CRLF file is refused rather than converted.

PATH... names work-tree files. --staged takes the work-tree copy of every
markdown file the staged diff adds or changes, --all every tracked markdown
file GROWTH_GUARDS_MD_PATHS names minus GROWTH_GUARDS_MD_EXCLUDES; both
resolve against the index the way md-format does. --check writes nothing
and exits 1 naming each file a reflow would change.

Exit codes: 0 clean or rewritten; 1 --check found work; 2 usage, config or
collection error.
EOF
}

CHECK=0
STAGED=0
ALL=0
PATHS=()
INVOKED_IN="$PWD"
while [ $# -gt 0 ]; do
  case "$1" in
    --check) CHECK=1 ;;
    --staged) STAGED=1 ;;
    --all) ALL=1 ;;
    -h | --help)
      usage
      exit 0
      ;;
    --) ;;
    -*) gg_config_error "unknown argument '$1' (see --help)" ;;
    *)
      case "$1" in
        /*) PATHS+=("$1") ;;
        *) PATHS+=("$INVOKED_IN/$1") ;;
      esac
      ;;
  esac
  shift
done

[ -r "$BLOCKS_AWK" ] || gg_config_error "$BLOCKS_AWK is missing — reinstall the growth-guards skill"
[ -r "$SHAPES_AWK" ] || gg_config_error "$SHAPES_AWK is missing — reinstall the growth-guards skill"
if [ "${#PATHS[@]}" -gt 0 ] && { [ "$STAGED" -eq 1 ] || [ "$ALL" -eq 1 ]; }; then
  gg_config_error "PATH arguments and --staged/--all are exclusive"
fi
if [ "${#PATHS[@]}" -eq 0 ] && [ "$STAGED" -eq 0 ] && [ "$ALL" -eq 0 ]; then
  gg_config_error "name the files to reflow, or pass --staged or --all (see --help)"
fi

gg_repo_root_cd
gg_tmpdir

# The work-tree files to rewrite, NUL-delimited, repo-root-relative.
: >"$GG_TMP/targets.z"
if [ "${#PATHS[@]}" -gt 0 ]; then
  root="$PWD"
  for p in "${PATHS[@]}"; do
    [ -f "$p" ] || gg_config_error "$(gg_shown "$p") is not a file"
    dir="$(cd -- "$(dirname -- "$p")" && pwd -P; printf x)" || gg_config_error "cannot resolve $(gg_shown "$p")"
    dir="${dir%x}"
    dir="${dir%$'\n'}"
    abs="$dir/$(basename -- "$p")"
    case "$abs" in
      "$root"/*) printf '%s\0' "${abs#"$root"/}" >>"$GG_TMP/targets.z" ;;
      *) gg_config_error "$(gg_shown "$p") is outside this repository" ;;
    esac
  done
else
  gg_md_load_paths md-reflow GROWTH_GUARDS_MD_PATHS "$PATHS_DEFAULT"
  GG_MD_MODE=staged
  [ "$ALL" -eq 0 ] || GG_MD_MODE=all
  gg_md_select markdown
  while IFS= read -r -d '' sha && IFS= read -r -d '' f; do
    printf '%s\0' "$f" >>"$GG_TMP/targets.z"
  done <"$GG_TMP/md-files.z"
fi

reflowed=0
would=0
checked=0
while IFS= read -r -d '' f; do
  [ -f "$f" ] || gg_collection_error "$(gg_shown "$f") is not a file in the work tree; reflow works on the checkout"
  [ -L "$f" ] && gg_collection_error "$(gg_shown "$f") is a symlink; reflow the file it points at"
  if gg_blob_is_binary "$f" "$f"; then
    gg_collection_error "$(gg_shown "$f") holds a NUL byte; it is not a markdown file this tool rewrites"
  fi
  checked=$((checked + 1))
  status=0
  LC_ALL=C awk -f "$SHAPES_AWK" -f "$BLOCKS_AWK" -v mode=reflow -- "$f" >"$GG_TMP/reflowed" 2>"$GG_TMP/reflow.err" || status=$?
  [ ! -s "$GG_TMP/reflow.err" ] || cat -- "$GG_TMP/reflow.err" >&2
  if [ "$status" -ne 0 ]; then
    refusal="$(grep '^R' -- "$GG_TMP/reflowed" | head -n 1 || true)"
    refusal="${refusal#R"$GG_TAB"}"
    gg_collection_error "$(gg_shown "$f"):${refusal%%"$GG_TAB"*}: ${refusal#*"$GG_TAB"} — refused, nothing written"
  fi
  # awk prints a newline after the last line; a file that had none keeps
  # having none, so a clean file stays byte-identical.
  if [ -s "$f" ] && [ -n "$(tail -c 1 -- "$f")" ]; then
    size="$(wc -c <"$GG_TMP/reflowed")"
    head -c "$((size - 1))" -- "$GG_TMP/reflowed" >"$GG_TMP/reflowed.trim"
    mv -f -- "$GG_TMP/reflowed.trim" "$GG_TMP/reflowed"
  fi
  if cmp -s -- "$f" "$GG_TMP/reflowed"; then
    continue
  fi
  if [ "$CHECK" -eq 1 ]; then
    echo "md-reflow: would reflow $(gg_shown "$f")"
    would=$((would + 1))
    continue
  fi
  # A rename inside the file's own directory, so an interrupt leaves the
  # original whole; the mode is carried over, since cp -p keeps it.
  case "$f" in
    */*) staging="${f%/*}/.md-reflow.$$.tmp" ;;
    *) staging=".md-reflow.$$.tmp" ;;
  esac
  cp -p -- "$f" "$staging" || gg_collection_error "could not stage a rewrite of $(gg_shown "$f")"
  if ! cat -- "$GG_TMP/reflowed" >"$staging"; then
    rm -f -- "$staging"
    gg_collection_error "could not write the rewrite of $(gg_shown "$f")"
  fi
  mv -f -- "$staging" "$f" || gg_collection_error "could not replace $(gg_shown "$f")"
  echo "md-reflow: reflowed $(gg_shown "$f")"
  reflowed=$((reflowed + 1))
done <"$GG_TMP/targets.z"

if [ "$CHECK" -eq 1 ]; then
  if [ "$would" -gt 0 ]; then
    echo "md-reflow: $would of $checked file(s) would change"
    exit 1
  fi
  echo "md-reflow: OK — $checked file(s) already in the format"
  exit 0
fi
echo "md-reflow: $reflowed of $checked file(s) rewritten"
