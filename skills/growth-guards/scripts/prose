#!/usr/bin/env bash
# prose — instruction markdown states the rule that holds now. A history
# reference in a file an agent loads (SKILL.md, workflows/*.md, AGENTS.md,
# CLAUDE.md) fails: a calendar date, a three- or four-digit issue number, or
# a word naming a past state. An agent acts on the rule, and a rule wrapped
# in the story of how it got there costs every reader the same paragraph to
# discard. The story belongs in the commit that made the change.
#
# Scope is the whole rule: only the configured paths are scanned, so a
# reference doc, a changelog and a design record keep their history intact.
# GROWTH_GUARDS_PROSE_PATHS replaces the path list.
#
# Content comes from the index, like every scan in this family. Matching is
# case-insensitive: the banned strings are words, and a sentence-initial
# capital is the same word.
#
# Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
set -euo pipefail
# Pathname expansion off: the configured paths are globs, and splitting them
# into words would otherwise expand each against the work tree — matching
# whatever happens to be checked out instead of the tracked paths the scan
# judges, and matching nothing at all in a sparse or bare checkout.
set -f

GG_BOOT="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd; printf x)"
GG_BOOT="${GG_BOOT%x}"
# The one newline `pwd` added; anything before it is the path.
SCRIPT_DIR="${GG_BOOT%$'\n'}"
GG_CHECK="prose"
# shellcheck source=lib/common.sh
source "$SCRIPT_DIR/lib/common.sh"
# shellcheck source=lib/settings.sh
source "$SCRIPT_DIR/lib/settings.sh"

# The four names an agent harness loads on its own: a skill's entry point and
# its workflows, and the repo-level instruction files. Each name is spelled
# twice — at the repository root and anywhere below it — because `*` crosses
# `/` but never stands in for the separator itself.
PATHS_DEFAULT="SKILL.md */SKILL.md AGENTS.md */AGENTS.md CLAUDE.md */CLAUDE.md workflows/*.md */workflows/*.md"

usage() {
  cat <<EOF
usage: prose

A history reference in agent-loaded markdown fails: a calendar date
(20YY-MM-DD), a three- or four-digit issue number after '#', or a word
naming a past state. Matching is case-insensitive and reads index content.
Only the configured paths are scanned; a reference doc, a changelog and a
design record are out of scope by not being named.

Configuration (env > .env.local > .kendex/settings.toml >
kendex.settings.toml [env] > default):
  GROWTH_GUARDS_PROSE_PATHS   space-separated shell globs against the full
                              repo-relative path, '*' crossing '/' as in the
                              excludes lists
                              (default $PATHS_DEFAULT)

Exit codes: 0 clean; 1 violations; 2 usage/config/collection error.
EOF
}

if [ $# -gt 0 ]; then
  case "$1" in
    -h | --help)
      usage
      exit 0
      ;;
    *) gg_config_error "unknown argument '$1' (see --help)" ;;
  esac
fi

gg_repo_root_cd

PATHS_RAW="$(gg_setting GROWTH_GUARDS_PROSE_PATHS "$PATHS_DEFAULT")" || exit 2

# Each pattern goes through the family's path discipline: absolute, escaping
# and '-'-leading values are configuration errors, never a glob that quietly
# matches nothing. An empty list is one too — a check that measures nowhere
# while reporting OK is the silent pass this family refuses; dropping the
# check from GROWTH_GUARDS_CHECKS is how it is turned off.
PATTERNS=""
# The same list rendered for messages: a configured pattern is somebody's
# bytes too, and %q would escape the globs out of the copy that has to match.
PATTERNS_SHOWN=""
for raw in $PATHS_RAW; do
  norm="$(gg_config_path "$raw" prose)" || exit 2
  PATTERNS="${PATTERNS:+$PATTERNS }$norm"
  PATTERNS_SHOWN="${PATTERNS_SHOWN:+$PATTERNS_SHOWN }$(gg_shown "$norm")"
done
[ -n "$PATTERNS" ] || gg_config_error "GROWTH_GUARDS_PROSE_PATHS names no path — name at least one, or drop this check from GROWTH_GUARDS_CHECKS"

matches_configured() { # PATH — 0 when some configured glob matches the full path
  local path="$1" pat
  for pat in $PATTERNS; do
    # $pat must expand unquoted to act as a glob.
    # shellcheck disable=SC2254
    case "$path" in
      $pat) return 0 ;;
    esac
  done
  return 1
}

# History, and only history. The word list is the drift this catches in
# practice: a rule that reaches for one of them is narrating a change rather
# than stating what holds. Word boundaries are spelled as non-word characters
# rather than \< and \>, which are a GNU extension the regex engines behind
# `git grep` do not all carry. The issue-number shape takes no leading
# boundary — a reference glued to a filename ('spec.md#1204') is the same
# reference — and its trailing '[^0-9]' is what keeps a longer digit run
# (a hex color, an ordinal) from matching a prefix of itself.
WORD='previously|used to|no longer|reverted|an earlier|earlier round|incident|historically|originally|at the time'
PROSE_ERE="20[0-9]{2}-[0-9]{2}-[0-9]{2}|#[0-9]{3,4}([^0-9]|\$)|(^|[^[:alnum:]_])($WORD)([^[:alnum:]_]|\$)"

gg_tmpdir
# The walk below reads one record per path, and an unmerged path is recorded
# once per stage — three rival records for one file, each of which would
# match and be scanned as its own.
gg_require_merged_index
git ls-files -z >"$GG_TMP/files.z" || gg_collection_error "git ls-files failed"

# Literal pathspecs, built from the walk rather than handing the configured
# globs to git: the family's glob contract is the shell's, and git's pathspec
# matching is a near neighbour, not the same rule. Building the list here is
# also what makes "nothing matched" visible — an empty pathspec list means
# EVERY tracked file to git, so a lane that passed it through would scan the
# whole repository the moment its configuration matched nothing.
MATCHED_SPECS=()
matched=0
while IFS= read -r -d '' f; do
  matches_configured "$f" || continue
  MATCHED_SPECS+=(":(literal)$f")
  matched=$((matched + 1))
done <"$GG_TMP/files.z"

if [ "$matched" -eq 0 ]; then
  echo "prose: OK — no tracked file matches GROWTH_GUARDS_PROSE_PATHS ($PATTERNS_SHOWN)"
  exit 0
fi

# The banned strings are words, so the same word opening a sentence is the
# same violation.
GG_GREP_LANE_FLAGS=(-i)
gg_grep_lane "history reference" "$PROSE_ERE" \
  "state the rule that holds now and delete the story; the date, the issue number and the past state belong in the commit that made the change" \
  "${MATCHED_SPECS[@]}"

if [ "$GG_VIOLATIONS" -gt 0 ]; then
  echo "prose: $GG_VIOLATIONS history reference(s) in $matched scanned file(s) — paths $PATTERNS_SHOWN"
  exit 1
fi
echo "prose: OK — no history references in $matched scanned file(s)"
