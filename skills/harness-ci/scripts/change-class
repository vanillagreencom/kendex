#!/usr/bin/env bash
# change-class — what kind of change is this diff?
#
# Usage:
#   change-class --event EVENT [--base REF] [--head REF] [--repo DIR]
#                [--output FILE]
#
# Flags carry the meanings `harness-only --help` gives them, except --mode and
# --paths-output, which this script does not take. Every read of a diff range
# is that shipped classifier's or orch's branch measurement, the revisions both
# ends of the range resolve to included. The git this script runs on the judged
# checkout itself is four reads and no write: where its object store is, the
# commit the base endpoint names, and which settings files that commit holds,
# whether it holds a lane declaration, and their bytes. The
# render proof weighs a private checkout of the head revision, never the judged
# checkout's working tree.
# stdout carries change_class=render|trivial|micro|small|standard and nothing
# else, stderr the changed paths and the reason, and exit 2 a wiring error
# that carries no verdict. The stderr `class:` line also carries `measured=`,
# which says whether a rule earned this class or this script fell back to
# `standard` because something could not be read. Only `standard` is ever
# measured=false, and only this script can tell the two apart: the cause alone
# does not, so a consumer that must not treat a fallback as a class reads the
# marker rather than a list of causes of its own. Every verdict also prints
# one `queue-only: queue_only=true|false cause=<name> [<field>=<value>]...`
# line on stderr, ahead of the `class:` line, each cause's fields as the
# table below names them. It reads false only
# with cause=no-queue-path. The causes are read in this order, first match
# winning, and every one but no-queue-path reads true:
#
#   no-changed-paths      the diff is empty
#   paths-unread          the changed paths were not read
#   path-quoted path=<p>  git quoted a changed path, which no glob matches
#   queue-list-unreadable orch's narrow-change.conf could not be read
#   queue-list-missing    that list holds no `queue` line
#   queue-path path=<p> glob=<g>
#                         a changed path matches a `queue` line of that
#                         list, the paths a change must run in a merge
#                         group for
#   queue-settings-unreadable
#                         the base commit's settings could not be read
#   lane-declaration-unreadable
#                         the base commit's .github/ci-lanes.conf could not
#                         be read
#   queue-lane lane=<n> path=<p> glob=<g>
#                         a changed path matches a glob of a lane that
#                         declaration marks `:queue`, which the
#                         change-class action defers off a pull request to
#                         the merge group
#   queue-list-undeclared the base's HARNESS_CI_QUEUE_PATHS is unset
#   repository-queue-path path=<p> glob=<g>
#                         a changed path matches a glob of that setting
#   queue-selector-failed [selector=<c>] detail=<d>
#                         the selector the base's HARNESS_CI_QUEUE_SELECTOR
#                         names could not answer: detail= is
#                         setting-malformed, inputs-unreadable (the
#                         docs verdict, the changed paths or the
#                         selector's output file),
#                         checkout-failed, command-absent, exit-<n> or
#                         output-unreadable
#   queue-selection selector=<c> output=<o> value=<v>
#                         that selector names jobs a merge group runs for
#                         this change
#   no-queue-path         none of the above: no changed path matches a glob
#                         of HARNESS_CI_QUEUE_PATHS, and the selector, where
#                         the base declares one, names no job
#
# The first two answer where no changed path reaches the judgement; the rest
# up to repository-queue-path are judged on every changed path harness-only
# read, before any refusal or rule below. The selector's two are judged last,
# on the class this script answers, since the jobs a merge group runs depend
# on it, and only on --event pull_request and merge_group, the events whose
# merge route it decides; on any other event the earlier answer stands and
# no selector runs. HARNESS_CI_QUEUE_SELECTOR is `COMMAND OUTPUT`: a repository command,
# a path relative to the repository root, and the output it writes in the
# GitHub Actions `name=value` form. It runs out of a private checkout of the
# commit --base names, the one its settings come from, with that checkout as
# its working directory and an environment of PATH, HOME and these alone:
# CHANGE_CLASS, the class; DOCS_ONLY, the `harness-only --mode docs` verdict
# for the range, true|false; CHANGED_PATHS, the changed paths harness-only
# read, one per line; EVENT, --event's value; and GITHUB_OUTPUT, the file it
# writes. The output's value is a JSON list: `[]` names no job, and a
# non-empty list keeps the change in the queue. A wiring error prints no such
# line, and a reader takes its absence as queue_only=true. An absent or
# malformed lane declaration marks no lane, as the action then defers none.
# cause=queue-list-undeclared also prints one
# `setting-unset: setting=HARNESS_CI_QUEUE_PATHS` warning per run. The
# --output FILE carries the same value as `queue_only=true|false` beside
# `change_class=`. This paragraph is the one statement of when the line reads
# true; other docs point here.
# The render proof runs `kendex verify --scope
# project --json` in the head revision's private checkout, with `--base` set to the base-rev:
# line harness-only printed and `--at-record` beside it, and reads its
# document. The classes, first match winning:
#
#   render   every changed path is a file kendex generated, `kendex verify`
#            reports files checked and none failed, and every changed path is
#            owned by a position a passing row of that run printed: a file it
#            owns whole, a tree it owns whole, or keys inside a shared file
#            whose rest that run says did not move since the range's base.
#            A removed path needs base inventory membership, absence from the
#            verified head inventory, and trusted base whole-file ownership:
#            the document's `base_owned`, the whole files and trees the base
#            revision's install record names, naming the path as a `file`
#            or holding it under a `tree`. A retirement it does not name, or
#            a document without the field, answers standard with
#            cause=render-retirement-unproved. That answer comes after every
#            other changed path is read, and any of them that is refused
#            answers in its place. It is a rule, marked measured=true like
#            cause=base-inventory-absent: every read behind it succeeded, and
#            the proof it lacks is one the verify document does not give:
#            base_owned does not name the path, or the document carries no
#            base_owned. Any other
#            changed path answers standard with cause=render-path-unowned,
#            and a shared file whose rest the run cannot vouch for answers
#            cause=render-path-partial. Both are rule verdicts, marked
#            measured=true: the reads succeeded but proved no whole owner.
#            That verdict
#            is that every installed file equals a fresh render of its
#            declared source. Under `--at-record` a package that follows
#            its source is rendered at the commit the install record names,
#            which kendex holds to the history of the revision the local
#            mirror resolves that source to and to no older than the commit
#            the base's record names, so a render the catalog has moved
#            past since it was pushed is weighed on its own terms and
#            printed as one `render-stale:` line per source commit it
#            trails. The two files kendex keeps about itself are as it
#            writes them, and that
#            every recorded entry is one the declarations back. Provenance
#            for surviving positions is proved by rendering, never by trusting
#            the head inventory or install record, which the branch can rewrite;
#            those two files are owned like any other rendered position,
#            from the row `kendex verify` prints for each, and by name to
#            nobody. The proof reads that program's `--json` document,
#            version 1, and never its human rows; a kendex that prints no
#            such document, or another version of it, answers standard.
#   trivial  every changed path is in the `harness-only --mode docs` set and
#            the change is within HARNESS_CI_TRIVIAL_MAX_LINES (default 20).
#            Where HARNESS_CI_TRIVIAL_PATHS names the repository's own
#            allowlist as blank-separated globs, it replaces that set, within
#            the same ceiling.
#   micro    production additions within the micro ceiling.
#   small    one subsystem, production additions within the small ceiling. A
#            path's subsystem is its first directory, with a leading render
#            root removed first so a source and the render mirroring it agree.
#            A path the measurement counts as a test or fixture, by its
#            built-in rule or ORCH_SIZE_TEST_PATHS, belongs to no subsystem.
#            A path in harness-only's docs set also belongs to no subsystem;
#            its lines still count toward the production ceiling.
#            An agent instruction file, an `instruction` line of orch's
#            narrow-change.conf (AGENTS.md, SKILL.md), that earns trivial or
#            micro answers small instead, cause=instruction-file: it changes
#            how every agent behaves, and small is the lowest class the
#            default review policy gives a bot review round.
#   standard everything else, and every diff this script cannot prove into a
#            narrower class. A size is measured only where harness-only read
#            every changed path against an inventory it could read: that file
#            is what generated ownership is read from, so every rule below
#            stands on it. Every other refusal it reports — the inventory at
#            an endpoint, the inventory's shape, a changed path, a path
#            lookup, the diff, the endpoints, the event, and any refusal it
#            adds later — answers standard carrying that cause, named here or
#            not. Fail-closed: standard buys a diff nothing. A base that
#            holds no inventory at all (cause=base-inventory-absent) takes
#            standard as a fixed rule ahead of the size rules, with
#            measured=true: a reading, not a refusal, though no size was
#            measured. The same diff on a base with an inventory can earn a
#            narrower class. An inventory the base holds and harness-only
#            cannot read or parse stays a refusal.
#
# A changed kendex configuration file refuses every narrow class, not only
# render: those files decide what is rendered and what each judgement below
# reads. A harness's own registry files refuse every narrow class but
# render, the files it executes as configuration: its hooks, its permissions,
# and the MCP servers it may run. kendex writes keys in those and never the
# file, so a re-rendered one reaches render only where the row owning it says
# the rest of the file did not move. The paths trivial, micro and small all
# refuse are orch's references/narrow-change.conf, beside this package; the
# ceilings in that file are micro's and small's alone. The render inventory
# on that list is read against it only where its change is more than names.
# In the size path, where harness-only prints `inventory-change: names-only`
# and each named root is one of the measurement's render roots, the inventory
# unlists only paths the diff deletes, a render effect, and it leaves the
# path set that list and the subsystem rule read.
#
# THE CLASS IS NEVER READ FROM A LABEL, A BRANCH NAME, A PULL REQUEST TITLE or
# any other author-writable field, and no flag carries one: the author of the
# diff being judged writes all of them, so trusting one fails open on exactly
# the diffs that most want to pass. For the same reason the judged tree's own
# configuration decides nothing here, and no script out of that tree is run.
# ORCH_SIZE_RENDER_ROOTS, ORCH_SIZE_TEST_PATHS and both HARNESS_CI_TRIVIAL_*
# settings come from this process's environment, else from the [env] tables of
# kendex.settings.toml and .kendex/settings.toml, the second winning, as the
# base endpoint's commit holds them. HARNESS_CI_QUEUE_PATHS (the repository's
# own queue globs, blank-separated, set empty where the shipped list is the
# whole list) and HARNESS_CI_QUEUE_SELECTOR (unset, no selector runs) come
# from those tables alone, never from the environment. The private env file
# is never read.
# A caller that acts on the verdict without review runs the DEFAULT BRANCH's
# copy of this script against the pull request's tree; the branch can change
# this file too.
#
# The render proof runs the `kendex` on PATH, save for one diff: where the only
# changed path is `.kendex-lock.json`, the install record, and this process's
# environment sets HARNESS_CI_LOCK_KENDEX, it runs the executable that names.
# The record is written by a kendex built from the recording tree, so a
# registration shape newer than the release on PATH reads to that release as
# drift. The variable is read from the
# environment alone, never from a settings file: it names a binary on the
# machine running this script. A path that is not executable answers standard
# with cause=no-verifier. The `render-verifier:` line names the verifier that
# ran, `path` or `lock`, and the version its `--version` printed, and a
# verify-refused cause carries both, so a refusal reads as the verifier's age.
#
# Only the render class reads kendex state, after harness-only answers
# harness_only=true or refuses only a generated ownership gain. The caller
# prepares the judged checkout's sources.
#
# A measured class needs --event pull_request or --event merge_group and an
# orch beside this package carrying the measurement contract below; any other
# event, and a checkout without that orch, answer render or standard and never
# a measured class. The render class reads nothing of orch's.
set -euo pipefail
# The narrow-change list's globs are bash patterns with extglob on.
shopt -s extglob

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
HARNESS_ONLY="$SCRIPT_DIR/harness-only"
ORCH_DIR="$SCRIPT_DIR/../../orch"
NARROW_CONF="$ORCH_DIR/references/narrow-change.conf"
# shellcheck source=lib/change-class.sh
. "$SCRIPT_DIR/lib/change-class.sh"
# shellcheck source=lib/ci-lanes.sh
. "$SCRIPT_DIR/lib/ci-lanes.sh"
# The micro-tier measurement's boundary as this script reaches it: every file
# it reads or runs whose edit changes the range measured, the settings the
# measurement reads, or the ceilings it compares against. orch's
# narrow-change.conf refuses the narrow classes on each, and
# https://github.com/vanillagreencom/kendex/blob/main/skills/harness-ci/tests/narrow-boundary.test.sh
# holds that file's boundary group to this list and the source lines of every
# file it names.
# measures-with: skills/harness-ci/scripts/change-class
# measures-with: skills/harness-ci/scripts/harness-only
# measures-with: skills/harness-ci/scripts/lib/change-class.sh
# measures-with: skills/harness-ci/scripts/lib/ci-lanes.sh
# measures-with: skills/orch/references/narrow-change.conf
# measures-with: skills/orch/scripts/lib/branch-growth.sh
# measures-with: skills/orch/scripts/lib/kendex-env.sh
#
# The lowest BRANCH_GROWTH_CONTRACT this script can measure with. An orch
# answering less, or none at all, is refused rather than called: its
# branch_size_classified would silently drop the base endpoint passed to it,
# load the judged tree's own settings to resolve its render roots, or leave
# unset the test paths the subsystem rule sets aside.
ORCH_CONTRACT_REQUIRED=2
# The one version of `kendex verify --json` this script reads. The document
# is the render proof's whole contract with kendex: a kendex printing another
# version, or none, answers standard rather than being read by guesswork.
VERIFY_DOCUMENT_VERSION=1
# One tab, resolved once. The ownership pass reads it once per printed
# position per changed path, and a substitution at that read forks a
# subshell every time: minutes over a repository's own refresh.
TAB="$(printf '\t')"

event=""
base=""
head="HEAD"
repo="."
output="${GITHUB_OUTPUT:-}"
changed=""
# The queue-only class. Until the changed paths are read, the diff is
# unreadable, and an unreadable diff reads queue-only.
QUEUE_ONLY=true
QUEUE_CAUSE="cause=paths-unread"

usage() { sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

die() { # FIELDS MESSAGE — a wiring error, never a verdict
  printf 'wiring-error: %s\n' "$1" >&2
  echo "change-class: $2" >&2
  exit 2
}

need_value() { # FLAG REMAINING NEXT
  [ "$2" -ge 2 ] || die "cause=missing-value option=$1" "$1 needs a value"
  case "$3" in
    -?*) die "cause=flag-used-as-value option=$1 value=$3" \
      "$1 needs a value, got the flag '$3'" ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --event) need_value "$1" "$#" "${2:-}"; event="$2"; shift 2 ;;
    --base) need_value "$1" "$#" "${2:-}"; base="$2"; shift 2 ;;
    --head) need_value "$1" "$#" "${2:-}"; head="$2"; shift 2 ;;
    --repo) need_value "$1" "$#" "${2:-}"; repo="$2"; shift 2 ;;
    --output) need_value "$1" "$#" "${2:-}"; output="$2"; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) die "cause=unknown-argument argument=$1" "unknown argument '$1'" ;;
  esac
done

[ -n "$event" ] || die "cause=missing-event option=--event" "--event is required"

work="$(mktemp -d 2>/dev/null)" || work=""
[ -n "$work" ] && [ -d "$work" ] ||
  die "cause=scratch-unavailable" "a scratch directory could not be created"
trap 'rm -rf "$work"' EXIT
paths_file="$work/paths"
harness_err="$work/harness-stderr"

# The output FILE is written before stdout, as harness-only writes its own: a
# verdict printed first would already have been read when the append died.
#
# `measured=` on the class line says which kind of answer this is, and it is
# the ONE place that distinction is made. Every class but `standard` is earned
# by a rule, so it is measured. `standard` is BOTH: a rule's verdict at the
# handful of sites that pass `measured` (a base with no inventory, an unproved
# render ownership gap, a path rule, a size rule), and this script's fallback
# everywhere something could not be read — a diff, an inventory, a render
# proof, the branch-size measurer, the narrow-change list. A consumer cannot
# tell those apart from the cause, and enumerating causes outside this script
# has failed three times, so the default for `standard` is REFUSED and a site
# that measured one says so. An `answer standard` added later is refused until
# its author decides otherwise, which is the way round that cannot hand a
# waiver to a diff nothing read. stdout is unchanged: one `change_class=` line.
answer() { # CLASS FIELDS [measured]
  measured=true
  [ "$1" != standard ] || measured=false
  [ "${3:-}" != measured ] || measured=true
  [ "$QUEUE_ONLY" = true ] || queue_selection "$1"
  if [ -n "$output" ]; then
    if ! { printf 'change_class=%s\nqueue_only=%s\n' "$1" "$QUEUE_ONLY" >>"$output"; } 2>/dev/null; then
      die "cause=output-write-failed" \
        "could not append the verdict to '$output'"
    fi
  fi
  printf 'queue-only: queue_only=%s %s\n' "$QUEUE_ONLY" "$QUEUE_CAUSE" >&2
  printf 'class: class=%s measured=%s %s\n' "$1" "$measured" "$2" >&2
  printf 'change_class=%s\n' "$1"
  exit 0
}

# harness-only owns the diff range for every event, its endpoint refusals, the
# revisions both ends of that range resolve to, and the generated-path
# ownership rules the render class needs. Its changed-path, base-rev and
# head-rev lines are repeated as they stand, and the cause inside its verdict
# notice is repeated as a note: it is the only account of why a path set is
# empty, where it becomes this script's cause, the only account of an
# inventory this script cannot stand on, where it becomes this script's cause
# too, and the only account of why the render class was out of reach on a
# diff of generated files, where the class a size earns would otherwise be
# the whole log.
harness_args=(--event "$event" --head "$head" --repo "$repo")
[ -z "$base" ] || harness_args=("${harness_args[@]}" --base "$base")
if ! harness_verdict="$("$HARNESS_ONLY" --mode harness "${harness_args[@]}" \
  --paths-output "$paths_file" --output /dev/null 2>"$harness_err")"; then
  cat "$harness_err" >&2
  die "cause=harness-only-failed event=$event" \
    "the shipped harness-only classifier refused this call"
fi
sed -n '/^changed-path: /p' "$harness_err" >&2
sed -n '/^base-rev: /p' "$harness_err" >&2
sed -n '/^head-rev: /p' "$harness_err" >&2
sed -n 's/^fallback: /harness-note: /p' "$harness_err" >&2
if ! harness_note="$(sed -n 's/^fallback: //p' "$harness_err" | tail -1)"; then
  harness_note=""
fi
# The revisions the range's two ends resolved to, read off the lines
# harness-only printed for them and resolved nowhere else: the render proof
# checks the head out and hands the base to `kendex verify --base`.
if ! base_rev="$(sed -n 's/^base-rev: //p' "$harness_err" | tail -1)"; then
  base_rev=""
fi
if ! head_rev="$(sed -n 's/^head-rev: //p' "$harness_err" | tail -1)"; then
  head_rev=""
fi
# harness-only's judgement of the inventory's own change, repeated as it
# stands. An absent or unreadable line leaves the inventory on the diff.
sed -n '/^inventory-change: /p' "$harness_err" >&2
if ! inventory_change="$(sed -n 's/^inventory-change: //p' "$harness_err" | tail -1)"; then
  inventory_change=""
fi

# Splitting a blank-separated list leaves each word open to pathname
# expansion, and a glob naming a real directory would be replaced by the files
# under the caller's working directory. Expansion is off for the split alone.
GLOB_LIST=()
set_globs() { # GLOBS
  set -f
  # shellcheck disable=SC2206
  GLOB_LIST=($1)
  set +f
}

# One matcher and one glob grammar for the allowlist and the refusal lists.
PATH_MATCH_HIT=""
path_matches() { # MODE(every|any) — against GLOB_LIST
  local path hit globs
  PATH_MATCH_HIT=""
  globs=""
  if [ "${#GLOB_LIST[@]}" -gt 0 ]; then
    printf -v globs '%s\n' "${GLOB_LIST[@]}"
  fi
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    hit=false
    if change_class_path_match "$path" "$globs"; then hit=true; fi
    if [ "$1" = any ]; then
      [ "$hit" = false ] || return 0
    else
      [ "$hit" = true ] || return 1
    fi
  done <<<"$changed"
  [ "$1" = every ]
}

# The shared path rule, applied to the branch's paths at the phase where
# that rule belongs. The registry and pointer phases follow the render proof;
# the names-only inventory leaves the path set before the narrow phase.
path_class_matches() { # PHASE CLASS
  local path
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    change_class_path "$path" "$1"
    [ "$CHANGE_CLASS_PATH" != "$2" ] || return 0
  done <<<"$changed"
  return 1
}

# The measurement settings and the repository's queue list, read from the
# [env] tables of the settings files the base endpoint's commit holds, never
# from the judged tree: a branch cannot choose the ceilings or the roots its
# own size is scored against, nor the paths that keep it in the queue, and a
# settings file the branch changes answers standard as a configuration source
# and is queue-only. That commit is the one --base names, the pull request's base tip or
# a merge group's base, never the merge base, which the author picks by
# choosing where to fork. The tables are parsed by orch's kendex-env.sh, the
# shared settings reader, in its ladder's order,
# so .kendex/settings.toml outranks kendex.settings.toml; nothing is sourced,
# so the private env file its KENDEX_ENV_FILE names never reaches this script.
# A key this process's environment carries keeps that value, as it does on the
# ladder, save the queue list and selector: a caller's environment is its own
# checkout's settings, which github.sh's router exports from the working
# tree, so both are dropped from it and the base's alone decide. The load runs in a
# subshell and hands back these keys alone.
unset HARNESS_CI_QUEUE_PATHS HARNESS_CI_QUEUE_SELECTOR
BASE_SETTINGS_KEYS='ORCH_SIZE_RENDER_ROOTS ORCH_SIZE_TEST_PATHS HARNESS_CI_TRIVIAL_MAX_LINES HARNESS_CI_TRIVIAL_PATHS HARNESS_CI_QUEUE_PATHS HARNESS_CI_QUEUE_SELECTOR'
BASE_SETTINGS_FILES='kendex.settings.toml .kendex/settings.toml'

# The bytes of PATH as the commit --base names holds it, written to OUT:
# status 0, 2 where that commit holds no PATH, and 1 where the commit or the
# file could not be read. BASE_REV is that commit, resolved once.
BASE_REV=""
base_file() { # PATH OUT
  local listed kind blob
  if [ -z "$BASE_REV" ]; then
    BASE_REV="$(git -C "$repo" rev-parse --verify --quiet "$base^{commit}" 2>/dev/null)" ||
      BASE_REV=""
    [ -n "$BASE_REV" ] || return 1
  fi
  listed="$(git -C "$repo" ls-tree "$BASE_REV" -- "$1" 2>/dev/null)" || return 1
  [ -n "$listed" ] || return 2
  kind="${listed#* }"
  kind="${kind%% *}"
  blob="${listed%%"$TAB"*}"
  blob="${blob##* }"
  [ "$kind" = blob ] || return 1
  git -C "$repo" cat-file blob "$blob" >"$2" 2>/dev/null
}

base_settings() {
  local file files=() n=0 status loaded key value
  for file in $BASE_SETTINGS_FILES; do
    status=0
    base_file "$file" "$work/base-settings-$((n + 1))" || status=$?
    case "$status" in
      0) ;;
      2) continue ;;
      *)
        MEASURE_CAUSE="cause=base-settings-unreadable base=${BASE_REV:-$base}${BASE_REV:+ path=$file}"
        return 1 ;;
    esac
    n=$((n + 1))
    files=("${files[@]+"${files[@]}"}" "$work/base-settings-$n")
  done
  [ "$n" -gt 0 ] || return 0
  if ! loaded="$(
    exec 3>&1 1>&2
    # shellcheck disable=SC2086
    unset $BASE_SETTINGS_KEYS
    # shellcheck source=../../orch/scripts/lib/kendex-env.sh
    . "$ORCH_DIR/scripts/lib/kendex-env.sh" || exit 1
    for file in "${files[@]}"; do
      kendex_load_settings_file "$file" || exit 1
    done
    for key in $BASE_SETTINGS_KEYS; do
      [ -z "${!key+x}" ] || printf '%s=%s\n' "$key" "${!key}" >&3
    done
  )"; then
    MEASURE_CAUSE="cause=base-settings-unreadable base=$BASE_REV"
    return 1
  fi
  while IFS= read -r value; do
    [ -n "$value" ] || continue
    key="${value%%=*}"
    [ -z "${!key+x}" ] || continue
    printf -v "$key" '%s' "${value#*=}"
  done <<<"$loaded"
}

# The first changed path a lane marked `:queue` claims, in the declaration
# the base commit holds, as QUEUE_LANE_HIT `lane=<n> path=<p> glob=<g>`;
# empty where none does. The base's copy is the default branch's, the one
# the change-class action reads: the branch's own copy could unmark a lane.
# Returns 1 where the declaration could not be read.
QUEUE_LANE_HIT=""
queue_lane_of_paths() {
  local status=0 index path
  QUEUE_LANE_HIT=""
  base_file .github/ci-lanes.conf "$work/ci-lanes.conf" || status=$?
  case "$status" in
    0) ;;
    2) return 0 ;;
    *) return 1 ;;
  esac
  ci_lanes_read "$work/ci-lanes.conf" || return 0
  index=0
  while [ "$index" -lt "$lane_count" ]; do
    if [ "${lane_queue[$index]}" = true ]; then
      while IFS= read -r path; do
        [ -n "$path" ] || continue
        if ci_lanes_claims "$index" "$path"; then
          QUEUE_LANE_HIT="lane=${lane_names[$index]} path=$path glob=$LANE_GLOB_HIT"
          return 0
        fi
      done <<<"$changed"
    fi
    index=$((index + 1))
  done
}

# The queue-only class, from the whole changed-path set before any rule below
# trims it, so every verdict from here on carries it. A list this script
# cannot read, or one from before the `queue` group, keeps the unreadable
# default: queue_only=true. git C-quotes a path holding a double quote or a
# newline, whatever core.quotePath says, and no anchored glob matches that
# spelling, so a quoted path is queue-only before any glob is read.
queue_only_of_paths() {
  local globs path
  while IFS= read -r path; do
    case "$path" in
      \"*) QUEUE_CAUSE="cause=path-quoted path=$path"; return ;;
    esac
  done <<<"$changed"
  if [ ! -r "$NARROW_CONF" ] || ! globs="$(change_class_list_globs "$NARROW_CONF" queue)"; then
    QUEUE_CAUSE="cause=queue-list-unreadable"
    return
  fi
  if [ -z "$globs" ]; then
    QUEUE_CAUSE="cause=queue-list-missing"
    return
  fi
  set_globs "$globs"
  if path_matches any; then
    QUEUE_CAUSE="cause=queue-path $PATH_MATCH_HIT"
    return
  fi
  # The shipped list names this catalog's own CI inputs. A repository's own,
  # its test harness or its aggregator outside .github/, are its
  # HARNESS_CI_QUEUE_PATHS, and a repository that declares none, the key
  # unset, has named no list the shipped one can be judged complete against:
  # queue-only. Set, even empty, the declaration is the rest of the list.
  if ! base_settings; then
    QUEUE_CAUSE="cause=queue-settings-unreadable"
    return
  fi
  if ! queue_lane_of_paths; then
    QUEUE_CAUSE="cause=lane-declaration-unreadable"
    return
  fi
  if [ -n "$QUEUE_LANE_HIT" ]; then
    QUEUE_CAUSE="cause=queue-lane $QUEUE_LANE_HIT"
    return
  fi
  if [ -z "${HARNESS_CI_QUEUE_PATHS+x}" ]; then
    printf 'setting-unset: setting=HARNESS_CI_QUEUE_PATHS\n' >&2
    echo "change-class: HARNESS_CI_QUEUE_PATHS is unset in the base commit's settings, so every change reads queue-only and never takes the admin merge; set it in the [env] table of kendex.settings.toml to the repository's own CI inputs, or empty for none" >&2
    QUEUE_CAUSE="cause=queue-list-undeclared"
    return
  fi
  set_globs "$HARNESS_CI_QUEUE_PATHS"
  if ! path_matches any; then
    QUEUE_ONLY=false
    QUEUE_CAUSE="cause=no-queue-path"
    return
  fi
  QUEUE_CAUSE="cause=repository-queue-path $PATH_MATCH_HIT"
}

# A checkout of REV at DIR, errors to ERR. It has a git directory of its own,
# which `git init` writes, and borrows the judged repository's objects
# through an alternates file. It never shares a git directory with the
# judged checkout, and that is what keeps kendex's arming records out of it.
# kendex records arming a package's repository effect under a git directory,
# the common one included, so a `git worktree add` would inherit it. With a
# record present, `kendex verify` runs the package's declared checker out of
# the tree it checks, and that checker is a file this diff can change.
#
# `git checkout` exits 0 when it cannot read a blob and leaves that file out,
# so the checkout is held to REV afterwards: a status naming anything is a
# tree that is not the commit, and is refused like a checkout that failed.
private_checkout() { # DIR REV ERR
  local private_tree="$1" objects left
  objects="$(git -C "$repo" rev-parse --path-format=absolute --git-path objects 2>"$3")" &&
    git init -q "$private_tree" 2>>"$3" &&
    mkdir -p "$private_tree/.git/objects/info" &&
    printf '%s\n' "$objects" >"$private_tree/.git/objects/info/alternates" &&
    git -C "$private_tree" checkout -q --detach "$2" 2>>"$3" &&
    left="$(git -C "$private_tree" status --porcelain 2>>"$3")" || return 1
  [ -z "$left" ] || { printf '%s\n' "$left" >>"$3"; return 1; }
}

# The repository's queue selector, asked about this verdict's CLASS where
# every rule above read false; the header states its contract. It is the
# base commit's command, run over the base commit's tree: the code and the
# settings that name it are the default branch's, which the branch under
# judgement cannot change, and nothing of the judged tree runs. Every failure
# reads queue-only, the route that runs the change in a merge group.
queue_selection() { # CLASS
  local command="" name="" rest="" docs paths value status=0
  local tree="$work/selector" log="$work/selector-log" out="$work/selector-output"
  [ -n "${HARNESS_CI_QUEUE_SELECTOR:-}" ] || return 0
  case "$event" in
    pull_request | merge_group) ;;
    *) return 0 ;;
  esac
  QUEUE_ONLY=true
  read -r command name rest <<<"$HARNESS_CI_QUEUE_SELECTOR"
  case "$command" in
    '' | /* | .. | ../* | */.. | */../*) name="" ;;
  esac
  case "$name" in
    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_]*) name="" ;;
  esac
  if [ -z "$name" ] || [ -n "$rest" ]; then
    QUEUE_CAUSE="cause=queue-selector-failed detail=setting-malformed"
    return 0
  fi
  QUEUE_CAUSE="cause=queue-selector-failed selector=$command"
  docs="${docs_verdict:-}"
  if [ -z "$docs" ]; then
    docs="$("$HARNESS_ONLY" --mode docs "${harness_args[@]}" --output /dev/null 2>/dev/null)" ||
      docs=unreadable
  fi
  case "$docs" in
    docs_only=true | docs_only=false) ;;
    *) QUEUE_CAUSE="$QUEUE_CAUSE detail=inputs-unreadable"; return 0 ;;
  esac
  if [ -z "$BASE_REV" ] || ! private_checkout "$tree" "$BASE_REV" "$log"; then
    cat -- "$log" >&2 2>/dev/null || true
    QUEUE_CAUSE="$QUEUE_CAUSE detail=checkout-failed"
    return 0
  fi
  if [ ! -f "$tree/$command" ] || [ ! -x "$tree/$command" ]; then
    QUEUE_CAUSE="$QUEUE_CAUSE detail=command-absent"
    return 0
  fi
  if ! paths="$(cat -- "$paths_file")" || ! : >"$out"; then
    QUEUE_CAUSE="$QUEUE_CAUSE detail=inputs-unreadable"
    return 0
  fi
  (cd -- "$tree" && env -i PATH="$PATH" HOME="${HOME:-}" CHANGE_CLASS="$1" \
    DOCS_ONLY="${docs#docs_only=}" CHANGED_PATHS="$paths" \
    EVENT="$event" GITHUB_OUTPUT="$out" "./$command") >"$log" 2>&1 </dev/null ||
    status=$?
  if [ "$status" -ne 0 ]; then
    cat -- "$log" >&2
    QUEUE_CAUSE="$QUEUE_CAUSE detail=exit-$status"
    return 0
  fi
  if ! value="$(sed -n "s/^$name=//p" "$out" | tail -1)"; then
    value=""
  fi
  case "$value" in
    '[]')
      QUEUE_ONLY=false
      QUEUE_CAUSE="cause=no-queue-path" ;;
    '['*']') QUEUE_CAUSE="cause=queue-selection selector=$command output=$name value=$value" ;;
    *)
      cat -- "$log" >&2
      QUEUE_CAUSE="$QUEUE_CAUSE detail=output-unreadable" ;;
  esac
}

# The changed paths harness-only read, and the queue-only class judged on
# them, ahead of every refusal below: a refusal raised after the paths were
# read carries the class those paths earn. An empty diff is its own cause and
# stays queue-only; any other empty set is a refusal that read no path, and
# keeps cause=paths-unread.
if [ -s "$paths_file" ]; then
  changed="$(cat -- "$paths_file")"
  queue_only_of_paths
else
  case "$harness_note" in
    '' | cause=empty-diff | cause=empty-diff\ *) QUEUE_CAUSE="cause=no-changed-paths" ;;
  esac
fi

# The committed inventory is the file every rule below is judged by: generated
# ownership is read from it, so the render branch and the size rules both
# stand on that read. A `false` verdict from harness-only means "run every
# lane", never "this is a product diff whose size may be measured". Only two
# of its causes are raised AFTER it has read every changed path against an
# inventory it could read: a path that inventory does not carry, and an
# ownership gain. The first reaches the size rules; the gain reaches the
# render proof, which must establish ownership of every changed path.
# They keep their `harness-note:` line. Every other cause is a
# refusal to read something: the inventory at an endpoint, the inventory's
# shape, a changed path, a path lookup, the diff, the endpoints, the event.
# A refusal is not a product diff, so it answers standard here with the cause
# as it stands, ahead of every path and size rule. A cause harness-only adds
# later is refused by that default rather than measured until someone names
# it, which is the way round that cannot hand a narrow class to a diff whose
# ownership was never read.
#
# One cause is a reading, not a refusal: a base that holds no inventory at
# all, older than the render that first wrote one, which is a long-lived
# branch's normal state. Ownership at that end is not recorded, so the diff
# takes standard as a fixed rule ahead of every path and size rule below,
# marked measured=true because the absence is what was read; no size is
# measured. The same diff on a base with an inventory can earn a narrower
# class. An inventory the base holds and harness-only cannot read or parse
# keeps its own cause and stays refused.
case "$harness_note" in
  '') ;;
  cause=product-source-or-unreadable-ownership | \
    cause=product-source-or-unreadable-ownership\ * | \
    cause=generated-ownership-gain | cause=generated-ownership-gain\ *) ;;
  cause=base-inventory-absent | cause=base-inventory-absent\ *)
    answer standard "$harness_note" measured ;;
  *) answer standard "$harness_note" ;;
esac

if [ ! -s "$paths_file" ]; then
  answer standard "${harness_note:-cause=no-changed-paths}"
fi

! path_class_matches before-render standard ||
  answer standard "cause=$CHANGE_CLASS_PATH_CAUSE" measured

# The render proof weighs the tree at the range's head and no other: the
# commit harness-only resolved --head to, checked out into a directory of this
# script's own. The judged checkout's working tree is never weighed. Anything
# uncommitted there, such as a file an earlier step wrote back or an untracked
# render standing in for one the branch deleted, would be weighed in place of
# what the pull request would merge. And the commit it sits at is not always
# --head: Shape 4 in ../references/wiring.md checks the subject out at the pull
# request's merge ref, and a local caller's checkout can sit anywhere. The
# checkout is private_checkout's, above.
proof_tree="$work/proof"
checkout_head() { private_checkout "$proof_tree" "$head_rev" "$work/proof-stderr"; }

# `kendex verify` weighs the manifest and render bytes of every installed
# package, holds the two files kendex keeps about itself to what it would
# write, and fails a recorded entry nothing declares. A clean exit alone is
# not the proof: it also closes a run that checked nothing, in a checkout
# holding the committed inventory and no install record. The counts in its
# document are the evidence, and the class is granted only where it checked
# something and nothing failed.
#
# The base revision handed to `kendex verify --base` is the one harness-only
# resolved for the range the changed paths came from, read off its base-rev:
# line and never derived here a second time: it is what a shared file's rest
# is compared against, so a registry file changed only where kendex writes
# keys can be owned from the row. Without that line no shared file is
# proved, which refuses the class on such a file rather than granting it.
RENDER_REFUSAL=""
# `measured` where the refusal is a rule's verdict rather than a failed read.
RENDER_MEASURED=""
VERIFY_JSON=""
renders_match() {
  local verify_args counts checked failed version verifier=kendex kind=path verifier_version
  if [ "$changed" = .kendex-lock.json ] && [ -n "${HARNESS_CI_LOCK_KENDEX:-}" ]; then
    verifier="$HARNESS_CI_LOCK_KENDEX"
    kind=lock
  fi
  if ! command -v "$verifier" >/dev/null 2>&1; then
    RENDER_REFUSAL="cause=no-verifier verifier=$kind"
    return 1
  fi
  # The version names the verifier on the log and in a refusal, and decides
  # nothing: one that cannot be read is named as such.
  if ! verifier_version="$("$verifier" --version 2>/dev/null </dev/null)"; then
    verifier_version=""
  fi
  verifier_version="${verifier_version%%$'\n'*}"
  verifier_version="${verifier_version##* }"
  case "$verifier_version" in
    '' | *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789.+_-]*)
      verifier_version=unreadable ;;
  esac
  printf 'render-verifier: verifier=%s version=%s\n' "$kind" "$verifier_version" >&2
  # harness-only prints head-rev: on every verdict it reaches after resolving
  # both ends, harness_only=true included, so an absent line is a
  # harness-only that broke that promise.
  if [ -z "$head_rev" ]; then
    RENDER_REFUSAL="cause=head-rev-missing"
    return 1
  fi
  if ! checkout_head; then
    cat "$work/proof-stderr" >&2
    RENDER_REFUSAL="cause=head-checkout-failed head=$head_rev"
    return 1
  fi
  verify_args=(verify --scope project --json)
  if [ -n "$base_rev" ]; then
    # `--at-record` weighs each package at the commit the install record
    # names, and goes only beside `--base`: the base's record is the floor
    # that stops a branch rewriting its own record back to an older catalog
    # commit.
    verify_args=("${verify_args[@]}" --base "$base_rev" --at-record)
  fi
  if ! VERIFY_JSON="$( (cd -- "$proof_tree" && "$verifier" "${verify_args[@]}") 2>"$work/verify-stderr" )"; then
    cat "$work/verify-stderr" >&2
    RENDER_REFUSAL="cause=verify-refused verifier=$kind version=$verifier_version"
    return 1
  fi
  # The document is the contract, its version first: a kendex printing
  # another shape under this flag, or none, is refused rather than read.
  if ! version="$(jq -r 'if type == "object" then (.version // "none" | tostring) else "none" end' \
    <<<"$VERIFY_JSON" 2>/dev/null)"; then
    version="none"
  fi
  if [ "$version" != "$VERIFY_DOCUMENT_VERSION" ]; then
    cat "$work/verify-stderr" >&2
    RENDER_REFUSAL="cause=verify-document-unreadable version=$version"
    return 1
  fi
  if ! counts="$(jq -r 'if ((.checked | type) == "number" and (.failed | type) == "number")
      then "\(.checked) \(.failed)" else empty end' <<<"$VERIFY_JSON" 2>/dev/null)" ||
    [ -z "$counts" ]; then
    cat "$work/verify-stderr" >&2
    RENDER_REFUSAL="cause=verify-document-unreadable version=$version"
    return 1
  fi
  checked="${counts%% *}"
  failed="${counts##* }"
  if [ "$checked" -eq 0 ]; then
    cat "$work/verify-stderr" >&2
    RENDER_REFUSAL="cause=verify-counted-nothing"
    return 1
  fi
  if [ "$failed" -ne 0 ]; then
    RENDER_REFUSAL="cause=verify-not-clean checked=$checked failed=$failed"
    return 1
  fi
  printf 'render-proof: checked=%s failed=%s\n' "$checked" "$failed" >&2
  # Each source commit the record trails, as the document names it. The
  # render was weighed at the record's commits, so this is the render's age,
  # never a refusal.
  if ! jq -r '.stale // [] | .[] | "render-stale: source=\(.source) recorded=\(.recorded) resolved=\(.resolved)"' \
    <<<"$VERIFY_JSON" >&2 2>/dev/null; then
    RENDER_REFUSAL="cause=verify-document-unreadable version=$version"
    return 1
  fi
}

# The counts say a run passed; the positions its passing rows printed say
# what it weighed. Each changed path has to be owned by one of them, read
# from the document and never from the row's kind or name: a file position
# owns exactly that path, a tree position owns every path under it, and a
# keys position — a shared registry file kendex writes entries in — owns the
# path only where the same row says the rest of that file is as the range's
# base held it. That last judgement is kendex's, made against its own edits;
# nothing here parses a settings file. The two bookkeeping files reach here
# like every other position, from the record and inventory rows, so no file
# the branch writes about itself is owned by name.
#
# Ownership is read only off rows in state ok. A failing row, a gap row, or
# a keys position without the foreign judgement owns nothing, and a changed
# path nothing owns refuses the class carrying the path.
#
# A deleted path has no row to be owned from: the head no longer renders it.
# Its owner is the base revision's install record, which kendex reads at that
# revision and prints as `base_owned`, whole files and trees only, so a shared
# registry file never appears there. The branch cannot rewrite that record.
# Whether PATH is a `file` there, or under a `tree`: exit 0 yes, 1 no or no
# field, any other status an unreadable document.
base_owned() { jq -e --arg path "$1" '(.base_owned // []) | any(.[]; .path as $owned | (.owns == "file" and $owned == $path) or (.owns == "tree" and ($owned == $path or ($path | startswith($owned + "/")))))' <<<"$VERIFY_JSON" >/dev/null 2>&1; }
#
# Every position a passing row printed, one per line: what it owns, the
# foreign judgement or `-`, and the path.
named_positions() { jq -r '.rows[] | select(.state == "ok") | .positions[] | [.owns, (.foreign // "-"), .path] | @tsv' <<<"$VERIFY_JSON"; }
render_paths_covered() {
  local path owns foreign position owned partial head_entry inventory_status owned_status retired=""
  if ! named_positions >"$work/render-named" 2>/dev/null; then
    RENDER_REFUSAL="cause=verify-document-unreadable version=$VERIFY_DOCUMENT_VERSION"
    return 1
  fi
  # The count goes out ahead of the pass, so a refused run still says what
  # it weighed.
  printf 'render-coverage: named=%s\n' "$(grep -c '' "$work/render-named")" >&2
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    if ! head_entry=$(git -C "$proof_tree" ls-tree --full-tree "$head_rev" -- "$path" 2>/dev/null); then
      RENDER_REFUSAL="cause=file-lookup-failed path=$path"
      return 1
    fi
    if [ -z "$head_entry" ]; then
      # harness-only already required this deleted file in the base's
      # inventory. Never use the branch's record to grant that ownership.
      # Head inventory absence is necessary, but does not prove the base
      # owned the whole file: its inventory includes shared keys and regions.
      # The base record's whole positions do.
      inventory_status=0
      jq -e --arg path "$path" \
        'all(.[]; (if type == "string" then . else .path end) != $path)' \
        "$proof_tree/.kendex-generated.json" >/dev/null 2>&1 || inventory_status=$?
      case "$inventory_status" in
        0)
          owned_status=0
          base_owned "$path" || owned_status=$?
          case "$owned_status" in
            0) continue ;;
            1) ;;
            *) RENDER_REFUSAL="cause=verify-document-unreadable version=$VERIFY_DOCUMENT_VERSION"; return 1 ;;
          esac
          # A retirement the base record does not name refuses the render
          # class once every later path is read: a refusal among them
          # answers instead.
          [ -n "$retired" ] || retired="cause=render-retirement-unproved path=$path"
          continue ;;
        1) ;;
        *) RENDER_REFUSAL="cause=unreadable-head-inventory head=$head_rev"; return 1 ;;
      esac
      render_refused_at "$path"
      RENDER_REFUSAL="cause=render-path-unowned path=$path"; RENDER_MEASURED=measured
      return 1
    fi
    owned=false
    partial=""
    while IFS="$TAB" read -r owns foreign position; do
      case "$owns" in
        file) [ "$path" = "$position" ] || continue; owned=true ;;
        tree) case "$path" in "$position" | "$position"/*) owned=true ;; *) continue ;; esac ;;
        keys)
          [ "$path" = "$position" ] || continue
          case "$foreign" in
            unchanged) owned=true ;;
            *) partial="$foreign" ;;
          esac ;;
        *) continue ;;
      esac
      [ "$owned" = false ] || break
    done <"$work/render-named"
    if [ "$owned" = true ]; then
      continue
    fi
    render_refused_at "$path"
    if [ -n "$partial" ]; then
      RENDER_REFUSAL="cause=render-path-partial path=$path foreign=$partial"; RENDER_MEASURED=measured
      return 1
    fi
    RENDER_REFUSAL="cause=render-path-unowned path=$path"; RENDER_MEASURED=measured
    return 1
  done <<<"$changed"
  [ -n "$retired" ] || return 0
  # Every changed path read and none refused, so the retirement is standard
  # by rule.
  RENDER_REFUSAL="$retired"
  RENDER_MEASURED=measured
  return 1
}

# What the run said around a refused path, for the operator reading the
# log: verify's own rows, which a passing verify would otherwise leave in
# the scratch directory the exit trap removes, and every position printed
# under the refused path's top-level directory, one line each.
render_refused_at() { # PATH
  local top="${1%%/*}"
  cat "$work/verify-stderr" >&2
  awk -F "$TAB" -v top="$top" '
    $3 == top || index($3, top "/") == 1 {
      printf "render-position: owns=%s foreign=%s path=%s\n", $1, $2, $3
    }' "$work/render-named" >&2
}

# An ownership gain needs the same proof as existing generated files: the
# head inventory cannot grant the render class. Every changed path, gained
# paths included, must be owned by a passing verify row. A failed proof stays
# standard rather than reaching a size class.
if [ "$harness_verdict" = "harness_only=true" ] || [ "$harness_note" = "cause=generated-ownership-gain" ]; then
  renders_match && render_paths_covered &&
    answer render "cause=renders-match-their-sources"
  answer standard "$RENDER_REFUSAL" "$RENDER_MEASURED"
fi

! path_class_matches registry standard ||
  answer standard "cause=$CHANGE_CLASS_PATH_CAUSE" measured
! path_class_matches pointer standard ||
  answer standard "cause=$CHANGE_CLASS_PATH_CAUSE" measured

# The measurement's library, sourced from orch beside this package, and the
# render roots it pairs a mirror against. MEASURE_CAUSE names a failure.
MEASURE_CAUSE=""
load_measurement() {
  if [ ! -r "$ORCH_DIR/scripts/lib/branch-growth.sh" ]; then
    MEASURE_CAUSE="cause=orch-absent path=$ORCH_DIR"
    return 1
  fi
  # shellcheck source=../../orch/scripts/lib/branch-growth.sh
  if ! . "$ORCH_DIR/scripts/lib/branch-growth.sh"; then
    MEASURE_CAUSE="cause=orch-unreadable"
    return 1
  fi
  # errexit is off wherever this runs, as `load_measurement ||` or inside
  # `measure ||`, so a library that is there but older answers `command not
  # found` on stderr and carries on into a signature that drops an argument.
  # Every call below is checked, and the contract is checked before the
  # first of them.
  local orch_contract="${BRANCH_GROWTH_CONTRACT:-0}"
  case "$orch_contract" in '' | *[!0123456789]*) orch_contract=0 ;; esac
  if [ "$orch_contract" -lt "$ORCH_CONTRACT_REQUIRED" ]; then
    MEASURE_CAUSE="cause=orch-too-old path=$ORCH_DIR contract=$orch_contract"
    return 1
  fi
  base_settings || return 1
  branch_growth_render_roots_from_env
}

# In the size path, a names-only inventory change unlists only paths the diff
# deletes, which are measured themselves; the inventory leaves the path set
# before the list and the subsystem rule read it. A root outside
# the measurement's render roots, or roots this script cannot load, keep the
# inventory on the diff, where the list below refuses it. Any other change to
# it, a changed entry or an entry for a path that stays, keeps it there too.
names_only_roots_rendered() { # ROOTS
  local root listed
  [ "$1" != - ] || return 0
  load_measurement || return 1
  set -f
  for root in ${1//,/ }; do
    for listed in $BRANCH_GROWTH_RENDER_ROOTS; do
      [ "$root" = "$listed" ] && continue 2
    done
    set +f
    echo "inventory-kept: cause=root-not-rendered root=$root" >&2
    return 1
  done
  set +f
}
case "$inventory_change" in
  names-only\ *\ roots=*)
    if names_only_roots_rendered "${inventory_change##* roots=}"; then
      changed="$(awk '$0 != ".kendex-generated.json"' <<<"$changed")" ||
        answer standard "cause=path-set-unreadable"
    fi ;;
esac

change_class_path_load "$NARROW_CONF" || answer standard "cause=$CHANGE_CLASS_PATH_CAUSE"
! path_class_matches narrow standard || answer standard "cause=$CHANGE_CLASS_PATH_CAUSE" measured

# Every measured class shares orch's branch growth reader, which owns the
# production/test split and render-mirror pairing for CI classification. It is handed the base endpoint this call named, so the lines
# are counted over the range the paths came from.
production=""
total=""
measure() {
  # The two events that define a range these rules can be read over. A pull
  # request's base end is the merge base harness-only resolved; a merge
  # group's base is an ancestor of its head by construction, so the
  # three-dot range the size reader takes below is the same commits as the
  # two-dot one either way. Every other event names no such range and is
  # refused here rather than measured over one nobody defined.
  case "$event" in
    pull_request | merge_group) ;;
    *)
      MEASURE_CAUSE="cause=unsupported-event event=$event"
      return 1 ;;
  esac
  load_measurement || return 1
  # The base endpoint is this call's own and is non-empty here: harness-only
  # refuses a call without one before it reads a diff, and the empty-paths
  # branch above repeats that refusal as this script's answer. So the
  # base-branch resolver is never reached and no path to one is passed.
  if ! branch_size_classified "$repo" "" \
    "$head" "${ORCH_SIZE_TEST_PATHS:-}" "$base"; then
    MEASURE_CAUSE="cause=size-measurement-failed detail=$BRANCH_GROWTH_ERROR"
    return 1
  fi
  production="$BRANCH_SIZE_PRODUCTION"
  total="$BRANCH_SIZE_BASELINE"
}
measure || answer standard "$MEASURE_CAUSE"

# harness-only owns the docs set. Use its non-doc paths for the subsystem
# rule as well as its verdict for trivial, without changing the measured size
# or the paths the refusal lists read.
docs_outside="$work/docs-outside"
docs_verdict="$("$HARNESS_ONLY" --mode docs "${harness_args[@]}" \
  --outside-output "$docs_outside" --output /dev/null 2>/dev/null)" || docs_verdict=unreadable
case "$docs_verdict" in
  docs_only=true | docs_only=false) ;;
  *) docs_verdict=unreadable ;;
esac

# An agent instruction file, an `instruction` line of orch's list, changes
# how every agent behaves, so it never answers below small, the lowest class
# the default review policy gives a bot round; CLAUDE.md is refused above by
# name. Every trivial and micro answer goes through here.
instruction_file=""
! path_class_matches narrow small || instruction_file="$PATH_MATCH_HIT"
answer_narrow() { # CLASS FIELDS
  [ -n "$instruction_file" ] || answer "$1" "$2"
  answer small "cause=instruction-file $instruction_file measured-class=$1"
}

trivial_max="${HARNESS_CI_TRIVIAL_MAX_LINES:-20}"
case "$trivial_max" in
  '' | *[!0123456789]*)
    die "cause=invalid-setting setting=HARNESS_CI_TRIVIAL_MAX_LINES" \
      "HARNESS_CI_TRIVIAL_MAX_LINES must be a whole number" ;;
esac
# The ceiling bounds what a trivial diff can change unreviewed, and a
# documentation path can still be one the product reads — compiled into a
# binary, shipped as a template.
if [ -n "${HARNESS_CI_TRIVIAL_PATHS:-}" ]; then
  if [ "$total" -le "$trivial_max" ]; then
    set_globs "$HARNESS_CI_TRIVIAL_PATHS"
    path_matches every &&
      answer_narrow trivial "cause=allowlisted-paths lines=$total"
  fi
else
  # The shipped allowlist is that mode's own path set, read from its verdict.
  if [ "$docs_verdict" = "docs_only=true" ] && [ "$total" -le "$trivial_max" ]; then
    answer_narrow trivial "cause=documentation-paths lines=$total"
  fi
fi

ceiling() { sed -n "s/^$1=\([0123456789][0123456789]*\)\$/\1/p" "$NARROW_CONF" | tail -1; }
micro_max=""
small_max=""
if ! { micro_max="$(ceiling micro_max_production)" &&
  small_max="$(ceiling small_max_production)" &&
  [ -n "$micro_max" ] && [ -n "$small_max" ]; }; then
  answer standard "cause=narrow-change-ceilings-missing"
fi

[ "$production" -gt "$micro_max" ] ||
  answer_narrow micro "cause=production-within-micro production=$production"

# Micro needs only the independent size proof above, not docs membership.
# Small needs completed docs discovery. harness-only emits false with an
# empty outside list on a read failure, not only on a valid path judgement.
case "$docs_verdict" in
  docs_only=true | docs_only=false) ;;
  *) answer standard "cause=documentation-paths-unreadable" ;;
esac
non_docs="$(cat -- "$docs_outside")" || answer standard "cause=documentation-paths-unreadable"
if [ "$docs_verdict" = docs_only=false ] && [ -z "$non_docs" ]; then
  answer standard "cause=documentation-paths-unreadable"
fi
non_docs=$'\n'"$non_docs"$'\n'

# The render roots are the measurement's own list, so a source and the render
# mirroring it reduce to one subsystem. A path the measurement counted as a
# test is left out, read off its list rather than judged again here: a script
# and the fixture it needs are one change wherever the fixture lives.
# Documentation is left out using harness-only's set, not another path rule.
set_globs "$BRANCH_GROWTH_RENDER_ROOTS"
render_roots=("${GLOB_LIST[@]}")
subsystem=""
one_subsystem=true
test_files=$'\n'"$BRANCH_SIZE_TEST_FILES"$'\n'
while IFS= read -r path; do
  [ -n "$path" ] || continue
  case "$non_docs" in *$'\n'"$path"$'\n'*) ;; *) continue ;; esac
  case "$test_files" in *$'\n'"$path"$'\n'*) continue ;; esac
  for root in ${render_roots[@]+"${render_roots[@]}"}; do
    case "$path" in "$root"/*) path="${path#"$root"/}"; break ;; esac
  done
  top="${path%%/*}"
  if [ -z "$subsystem" ]; then
    subsystem="$top"
  elif [ "$subsystem" != "$top" ]; then
    one_subsystem=false
    break
  fi
done <<<"$changed"

[ "$one_subsystem" = true ] ||
  answer standard "cause=several-subsystems production=$production" measured
[ "$production" -gt "$small_max" ] ||
  answer small "cause=production-within-small subsystem=$subsystem"
answer standard "cause=production-past-small production=$production" measured
