#!/usr/bin/env bash
# change-class — what kind of change is this diff, is it queue-only, and which
# lanes run?
#
# Usage:
#   change-class --event EVENT [--base REF] [--head REF] [--repo DIR]
#                [--output FILE] [--lanes-from DIR] [--queue-only-default BOOL]
#
# The classification is change-scope's, the shared classifier installed beside
# this package (scripts/change-scope there); this script runs it over the
# same range and adds what CI alone needs: the queue-only class that decides
# the merge route, the per-push mode, and the lane verdicts a workflow gates
# on. A checkout without change-scope beside this package is refused at
# startup with `wiring-error: cause=dependency-absent skill=change-scope`.
#
# --output appends lanes=true|false and lanes_cause beside the class and queue
# verdicts. The lane rules are ../references/wiring.md § Per-lane verdicts.
# --lanes-from names a separate trusted checkout with .github/ci-lanes.conf;
# empty by default, so no lane is declared. --queue-only-default true asks
# for the queue-only default's stand-down, as the harness-ci template's
# `queue-only-default: true` input does; false, the default, matches a
# workflow that passes none.
# The base commit's HARNESS_CI_UNREAD_PATHS, blank-separated globs read from
# its settings tables alone, never the environment, names paths no lane
# reads: a changed path it matches, outside the docs set, not declared text,
# not a path git quotes and not on the shipped queue list, that no lane
# claims turns no lane on.
# Every verdict prints its globs on one `unread-paths:` line, bare where it
# is unset or blank, after all this script relays from tools that read the
# head, so the change-class action's lane producer, lib/change-class.sh,
# reads the last such line as this script's own.
#
# Flags carry the meanings `change-scope --help` gives them, except
# --paths-output, which this script does not take; the class, its `class:`
# line with its `measured=` marker, the changed paths and the reader's notes
# on stderr and the exit 2 wiring error are that classifier's, carried here as
# they stand. The git this script runs on the judged checkout itself reads and
# never writes: the commit the base endpoint names, which settings files that
# commit holds, whether it holds a lane declaration, and their bytes.
# stdout carries change_class=render|trivial|micro|small|standard and nothing
# else. Every verdict also prints
# one `queue-only: queue_only=true|false inputs=declared|run cause=<name>
# [<field>=<value>]...` line on stderr, ahead of the `class:` line, each
# cause's fields as the table below names them. It reads false only
# with cause=no-queue-path. The causes are read in this order, first match
# winning, and every one but no-queue-path reads true:
#
#   no-changed-paths      harness-only returned an empty changed-path list
#   paths-unread          the changed paths were not read
#   path-quoted path=<p>  git quoted a changed path, which no glob matches
#   queue-list-unreadable change-scope's narrow-change.conf could not be read
#   queue-list-missing    that list holds no `queue` line
#   queue-path path=<p> glob=<g>
#                         a changed path matches a `queue` line of that
#                         list, the paths a change must run in a merge
#                         group for
#   queue-settings-unreadable
#                         the base commit's settings could not be read
#   per-push-unset        the base's HARNESS_CI_PER_PUSH_REASON is unset or
#                         blank: the repository takes the default, where the
#                         merge-queue run is the only proof of a head, so
#                         every change takes the queue and a pull request's
#                         stub CI run never opens the admin route. A blank
#                         value also prints one `setting-refused:
#                         setting=HARNESS_CI_PER_PUSH_REASON
#                         cause=empty-reason` line and a warning; the
#                         opt-back needs its reason. The per-push line
#                         below carries the mode on every verdict
#   lane-declaration-unreadable
#                         the base commit's .github/ci-lanes.conf could not
#                         be read
#   queue-lane lane=<n> path=<p> glob=<g>
#                         a changed path matches a glob of a lane that
#                         declaration marks `:queue`, which the
#                         change-class action defers off a pull request to
#                         the merge group
#   queue-list-undeclared the base's HARNESS_CI_QUEUE_PATHS is unset
#   repository-queue-path path=<p> glob=<g>
#                         a changed path matches a glob of that setting
#   queue-selector-failed [selector=<c>] detail=<d>
#                         the selector the base's HARNESS_CI_QUEUE_SELECTOR
#                         names could not answer: detail= is
#                         setting-malformed, inputs-unreadable (the
#                         docs verdict, the changed paths or the
#                         selector's output file),
#                         checkout-failed, command-absent, exit-<n> or
#                         output-unreadable
#   queue-selection selector=<c> output=<o> value=<v>
#                         that selector names jobs a merge group runs for
#                         this change
#   no-queue-path         none of the above: no changed path matches a glob
#                         of HARNESS_CI_QUEUE_PATHS, and the selector, where
#                         the base declares one, names no job
#
# The causes after per-push-unset are read only where the base names a reason.
# The first two answer where no changed path reaches the judgement; the rest
# up to repository-queue-path are judged on every changed path harness-only
# read, before any refusal or rule below. The selector's two are judged last,
# on the class this script answers, since the jobs a merge group runs depend
# on it, and only on --event pull_request and merge_group, the events whose
# merge route it decides; on any other event the earlier answer stands and
# no selector runs. HARNESS_CI_QUEUE_SELECTOR is `COMMAND OUTPUT`: a repository command,
# a path relative to the repository root, and the output it writes in the
# GitHub Actions `name=value` form. It runs out of a private checkout of the
# commit --base names, the one its settings come from, with that checkout as
# its working directory and an environment of PATH, HOME and these alone:
# CHANGE_CLASS, the class; DOCS_ONLY, the `harness-only --mode docs` verdict
# for the range, true|false; CHANGED_PATHS, the changed paths harness-only
# read, one per line; EVENT, --event's value; and GITHUB_OUTPUT, the file it
# writes. The output's value is a JSON list: `[]` names no job, and a
# non-empty list keeps the change in the queue. A wiring error prints no such
# line, and a reader takes its absence as queue_only=true. An absent or
# malformed lane declaration marks no lane, as the action then defers none.
# cause=queue-list-undeclared also prints one
# `setting-unset: setting=HARNESS_CI_QUEUE_PATHS` warning per run. The
# --output FILE carries the same value as `queue_only=true|false` beside
# `change_class=`. This paragraph is the one statement of when the line reads
# true; other docs point here.
# On a queue_only=true answer, the line's `inputs=` marks whether a later run
# on the same change and base reads the same answer, as `measured=` marks a
# fallback: declared where the cause was read off the changed paths, the
# base's lane declaration and its settings alone (no-changed-paths,
# path-quoted, per-push-unset, queue-lane, queue-list-undeclared and
# repository-queue-path); run where it rests on a read that can fail, the
# shipped queue list or the selector's run. The change-class action defers a
# lane on a declared answer from any render carrying lib/ci-lanes.sh, and
# per-push-unset only beside a render reading HARNESS_CI_PER_PUSH_REASON, so
# a declared cause a render with lib/ci-lanes.sh would not reach needs that
# action's reader check of its own.
# Every verdict also prints one `per-push: state=unset|set|unread` line
# after the queue-only line: the repository's mode, whichever cause that
# line names. unset is the default, the base's HARNESS_CI_PER_PUSH_REASON
# unset or blank; set, it names a reason; unread, the base commit's settings
# could not be read. The change-class action's stand-down reads this line,
# never the cause, so a change a cause above answers before the reason is
# read, such as queue-path, stands down in a repository that takes the
# default.
# The base's HARNESS_CI_DOCS_PATHS adds exact Markdown files to harness-only's
# docs set. Declared text retains its owning lane checks, including for a
# trivial class. Use --output with --lanes-from, or the composite action's
# lane outputs; a blanket docs_only or trivial waiver does not protect
# declared text. Grammar and eligibility: harness-only --help and
# ../references/wiring.md § Declared product text.
# A caller that acts on the verdict without review runs the DEFAULT BRANCH's
# copy of this script against the pull request's tree; the branch can change
# this file too.
set -euo pipefail
# The narrow-change list's globs are bash patterns with extglob on.
shopt -s extglob

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
CHANGE_SCOPE_DIR="$SCRIPT_DIR/../../change-scope"
CHANGE_SCOPE="$CHANGE_SCOPE_DIR/scripts/change-scope"
HARNESS_ONLY="$CHANGE_SCOPE_DIR/scripts/harness-only"
NARROW_CONF="$CHANGE_SCOPE_DIR/references/narrow-change.conf"

die() { # FIELDS MESSAGE — a wiring error, never a verdict
  printf 'wiring-error: %s\n' "$1" >&2
  echo "change-class: $2" >&2
  exit 2
}

# The required sibling, judged before anything else is read: a copy of this
# package outside its install layout has no classifier to answer with.
[ -x "$CHANGE_SCOPE" ] ||
  die "cause=dependency-absent skill=change-scope path=$CHANGE_SCOPE" \
    "the change-scope package is not installed beside harness-ci"
# shellcheck source=lib/change-class.sh
. "$SCRIPT_DIR/lib/change-class.sh" ||
  die "cause=dependency-absent skill=change-scope path=$CHANGE_SCOPE_DIR/scripts/lib/change-scope.sh" \
    "the change-scope library is not readable beside harness-ci"
# shellcheck source=lib/ci-lanes.sh
. "$SCRIPT_DIR/lib/ci-lanes.sh"

event=""
base=""
head="HEAD"
repo="."
output="${GITHUB_OUTPUT:-}"
lanes_from=""
queue_default=false
changed=""
# The queue-only class. Until the changed paths are read, the diff is
# unreadable, and an unreadable diff reads queue-only.
QUEUE_ONLY=true
QUEUE_CAUSE="cause=paths-unread" QUEUE_INPUTS=run

usage() { sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

need_value() { # FLAG REMAINING NEXT
  [ "$2" -ge 2 ] || die "cause=missing-value option=$1" "$1 needs a value"
  case "$3" in
    -?*) die "cause=flag-used-as-value option=$1 value=$3" \
      "$1 needs a value, got the flag '$3'" ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --event) need_value "$1" "$#" "${2:-}"; event="$2"; shift 2 ;;
    --base) need_value "$1" "$#" "${2:-}"; base="$2"; shift 2 ;;
    --head) need_value "$1" "$#" "${2:-}"; head="$2"; shift 2 ;;
    --repo) need_value "$1" "$#" "${2:-}"; repo="$2"; shift 2 ;;
    --output) need_value "$1" "$#" "${2:-}"; output="$2"; shift 2 ;;
    --lanes-from) need_value "$1" "$#" "${2:-}"; lanes_from="$2"; shift 2 ;;
    --queue-only-default) need_value "$1" "$#" "${2:-}"; queue_default="$2"; shift 2 ;;
    # Retired with proof reuse; read until the next major release.
    --covers-all-lanes)
      need_value "$1" "$#" "${2:-}"
      printf 'option-retired: option=--covers-all-lanes\n' >&2
      echo "change-class: --covers-all-lanes is ignored since proof reuse was retired; drop it" >&2
      shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) die "cause=unknown-argument argument=$1" "unknown argument '$1'" ;;
  esac
done

[ -n "$event" ] || die "cause=missing-event option=--event" "--event is required"
case "$queue_default" in
  true | false) ;;
  *) die "cause=invalid-setting option=--queue-only-default value=$queue_default" \
    "--queue-only-default must be true or false" ;;
esac

work="$(mktemp -d 2>/dev/null)" || work=""
[ -n "$work" ] && [ -d "$work" ] ||
  die "cause=scratch-unavailable" "a scratch directory could not be created"
trap 'rm -rf -- "${work:?}"' EXIT
paths_file="$work/paths"
class_err="$work/class-stderr"

# The repository's queue list, selector and per-push reason, read from the
# [env] tables of the settings files the base endpoint's commit holds, never
# from the judged tree, through the shared reader: a branch cannot choose the
# paths that keep it in the queue. A caller's environment is its own
# checkout's settings, which github.sh's router exports from the working
# tree, so these are dropped from it and the base's alone decide.
unset HARNESS_CI_QUEUE_PATHS HARNESS_CI_QUEUE_SELECTOR HARNESS_CI_PER_PUSH_REASON
BASE_SETTINGS_KEYS='HARNESS_CI_QUEUE_PATHS HARNESS_CI_QUEUE_SELECTOR HARNESS_CI_PER_PUSH_REASON'

# The first changed path a lane marked `:queue` claims, in the declaration
# the base commit holds, as QUEUE_LANE_HIT `lane=<n> path=<p> glob=<g>`;
# empty where none does. The base's copy is the default branch's, the one
# the change-class action reads: the branch's own copy could unmark a lane.
# Returns 1 where the declaration could not be read.
QUEUE_LANE_HIT=""
queue_lane_of_paths() {
  local status=0 index path
  QUEUE_LANE_HIT=""
  base_file .github/ci-lanes.conf "$work/ci-lanes.conf" || status=$?
  case "$status" in
    0) ;;
    2) return 0 ;;
    *) return 1 ;;
  esac
  ci_lanes_read "$work/ci-lanes.conf" || return 0
  index=0
  while [ "$index" -lt "$lane_count" ]; do
    if [ "${lane_queue[$index]}" = true ]; then
      while IFS= read -r path; do
        [ -n "$path" ] || continue
        if ci_lanes_claims "$index" "$path"; then
          QUEUE_LANE_HIT="lane=${lane_names[$index]} path=$path glob=$LANE_GLOB_HIT"
          return 0
        fi
      done <<<"$changed"
    fi
    index=$((index + 1))
  done
}

# The paths no lane reads, from the base's tables alone, as the keys above.
unset HARNESS_CI_UNREAD_PATHS
BASE_SETTINGS_KEYS="$BASE_SETTINGS_KEYS HARNESS_CI_UNREAD_PATHS"

# The repository's per-push mode, as PER_PUSH: `unset` where the base
# commit's HARNESS_CI_PER_PUSH_REASON is unset or blank, the default, where
# no pull-request run proves a head and every change takes the queue; `set`
# where it names a reason; `unread` where those settings could not be read.
# It is a fact about the repository, not about this change, so it is read
# once and printed on its own line whichever queue-only cause answers: the
# change-class action's stand-down reads it there. A blank reason is refused
# as unset, never as a wiring error: the base holds it, so exit 2 would
# redden every pull request, the one that repairs it included.
PER_PUSH=""
per_push_mode() {
  [ -z "$PER_PUSH" ] || return 0
  if ! base_settings; then
    PER_PUSH=unread
    return 0
  fi
  case "${HARNESS_CI_PER_PUSH_REASON:-}" in
    *[![:space:]]*) PER_PUSH=set ;;
    *)
      if [ -n "${HARNESS_CI_PER_PUSH_REASON+x}" ]; then
        printf 'setting-refused: setting=HARNESS_CI_PER_PUSH_REASON cause=empty-reason\n' >&2
        echo "::warning title=per-push opt-back refused::HARNESS_CI_PER_PUSH_REASON is set without a reason in the base commit's settings, so every change stays queue-only; give the reason the repository runs its lanes on each pull-request push" >&2
      fi
      PER_PUSH=unset ;;
  esac
}

# The queue-only class, from the whole changed-path set before any rule below
# trims it, so every verdict from here on carries it. A list this script
# cannot read, or one from before the `queue` group, keeps the unreadable
# default: queue_only=true. git C-quotes a path holding a double quote or a
# newline, whatever core.quotePath says, and no anchored glob matches that
# spelling, so a quoted path is queue-only before any glob is read.
queue_only_of_paths() {
  local globs path
  while IFS= read -r path; do
    case "$path" in
      \"*) QUEUE_CAUSE="cause=path-quoted path=$path" QUEUE_INPUTS=declared; return ;;
    esac
  done <<<"$changed"
  if [ ! -r "$NARROW_CONF" ] || ! globs="$(change_class_list_globs "$NARROW_CONF" queue)"; then
    QUEUE_CAUSE="cause=queue-list-unreadable" QUEUE_INPUTS=run
    return
  fi
  if [ -z "$globs" ]; then
    QUEUE_CAUSE="cause=queue-list-missing" QUEUE_INPUTS=run
    return
  fi
  set_globs "$globs"
  if path_matches any; then
    QUEUE_CAUSE="cause=queue-path $PATH_MATCH_HIT" QUEUE_INPUTS=run
    return
  fi
  # The shipped list names this catalog's own CI inputs. A repository's own,
  # its test harness or its aggregator outside .github/, are its
  # HARNESS_CI_QUEUE_PATHS, and a repository that declares none, the key
  # unset, has named no list the shipped one can be judged complete against:
  # queue-only. Set, even empty, the declaration is the rest of the list.
  per_push_mode
  case "$PER_PUSH" in
    unread) QUEUE_CAUSE="cause=queue-settings-unreadable" QUEUE_INPUTS=run; return ;;
    unset) QUEUE_CAUSE="cause=per-push-unset" QUEUE_INPUTS=declared; return ;;
  esac
  if ! queue_lane_of_paths; then
    QUEUE_CAUSE="cause=lane-declaration-unreadable" QUEUE_INPUTS=run
    return
  fi
  if [ -n "$QUEUE_LANE_HIT" ]; then
    QUEUE_CAUSE="cause=queue-lane $QUEUE_LANE_HIT" QUEUE_INPUTS=declared
    return
  fi
  if [ -z "${HARNESS_CI_QUEUE_PATHS+x}" ]; then
    printf 'setting-unset: setting=HARNESS_CI_QUEUE_PATHS\n' >&2
    echo "change-class: HARNESS_CI_QUEUE_PATHS is unset in the base commit's settings, so every change reads queue-only and never takes the admin merge; set it in the [env] table of kendex.settings.toml to the repository's own CI inputs, or empty for none" >&2
    QUEUE_CAUSE="cause=queue-list-undeclared" QUEUE_INPUTS=declared
    return
  fi
  set_globs "$HARNESS_CI_QUEUE_PATHS"
  if ! path_matches any; then
    QUEUE_ONLY=false
    QUEUE_CAUSE="cause=no-queue-path" QUEUE_INPUTS=declared
    return
  fi
  QUEUE_CAUSE="cause=repository-queue-path $PATH_MATCH_HIT" QUEUE_INPUTS=declared
}

# The classifier's run over the range this call named. Its wiring error, exit
# 2, is carried as it stands; its stdout is the one class line, and its
# stderr the changed paths, the reader's notes, the proof's lines and the
# `class:` line that closes them. The changed paths it read, before any of
# its rules, are the set the queue-only class is judged on.
harness_args=(--event "$event" --head "$head" --repo "$repo")
[ -z "$base" ] || harness_args=("${harness_args[@]}" --base "$base")
class_status=0
class_line="$("$CHANGE_SCOPE" "${harness_args[@]}" --paths-output "$paths_file" 2>"$class_err")" ||
  class_status=$?
if [ "$class_status" -ne 0 ]; then
  # A wiring error raised after the paths were read is still judged for the
  # queue-only class on those paths, as every verdict is, so the base
  # settings it reads print their `setting-refused:` and `setting-unset:`
  # records and annotations ahead of the error; the `queue-only:` line
  # itself prints on a verdict alone.
  if [ -s "$paths_file" ]; then
    changed="$(cat -- "$paths_file")"
    queue_only_of_paths
  fi
  cat -- "$class_err" >&2
  exit "$class_status"
fi
case "$class_line" in
  change_class=render | change_class=trivial | change_class=micro | \
    change_class=small | change_class=standard) class="${class_line#change_class=}" ;;
  *) die "cause=classifier-unreadable class-line=$class_line" \
    "change-scope printed no change_class line this script knows" ;;
esac
# The classifier's log, its closing `class:` line held back: the queue-only
# and per-push records go ahead of it, so a reader taking the last `class:`
# line still finds the record whole.
class_record="$(sed -n '$p' "$class_err")" || class_record=""
case "$class_record" in
  class:\ *) ;;
  *) die "cause=classifier-unreadable class-line=$class_record" \
    "change-scope closed its log with no class: line" ;;
esac
sed '$d' "$class_err" >"$work/class-log-head" ||
  die "cause=classifier-log-unreadable" "could not read change-scope's log"
cat -- "$work/class-log-head" >&2
if ! harness_note="$(sed -n 's/^harness-note: //p' "$class_err" | tail -1)"; then
  harness_note=""
fi
# The revision the range's head end resolved to, read off the line the reader
# printed for it and resolved nowhere else.
if ! head_rev="$(sed -n 's/^head-rev: //p' "$class_err" | tail -1)"; then
  head_rev=""
fi

# The repository's queue selector, asked about this verdict's CLASS where
# every rule above read false; the header states its contract. It is the
# base commit's command, run over the base commit's tree: the code and the
# settings that name it are the default branch's, which the branch under
# judgement cannot change, and nothing of the judged tree runs. Every failure
# reads queue-only, the route that runs the change in a merge group.
queue_selection() { # CLASS
  local command="" name="" rest="" docs paths value status=0
  local tree="$work/selector" log="$work/selector-log" out="$work/selector-output"
  [ -n "${HARNESS_CI_QUEUE_SELECTOR:-}" ] || return 0
  case "$event" in
    pull_request | merge_group) ;;
    *) return 0 ;;
  esac
  QUEUE_ONLY=true QUEUE_INPUTS=run
  read -r command name rest <<<"$HARNESS_CI_QUEUE_SELECTOR"
  case "$command" in
    '' | /* | .. | ../* | */.. | */../*) name="" ;;
  esac
  case "$name" in
    *[!ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_]*) name="" ;;
  esac
  if [ -z "$name" ] || [ -n "$rest" ]; then
    QUEUE_CAUSE="cause=queue-selector-failed detail=setting-malformed"
    return 0
  fi
  QUEUE_CAUSE="cause=queue-selector-failed selector=$command"
  docs="$("$HARNESS_ONLY" --mode docs "${harness_args[@]}" --output /dev/null 2>/dev/null)" ||
    docs=unreadable
  case "$docs" in
    docs_only=true | docs_only=false) ;;
    *) QUEUE_CAUSE="$QUEUE_CAUSE detail=inputs-unreadable"; return 0 ;;
  esac
  if [ -z "$BASE_REV" ] || ! private_checkout "$tree" "$BASE_REV" "$log"; then
    cat -- "$log" >&2 2>/dev/null || true
    QUEUE_CAUSE="$QUEUE_CAUSE detail=checkout-failed"
    return 0
  fi
  if [ ! -f "$tree/$command" ] || [ ! -x "$tree/$command" ]; then
    QUEUE_CAUSE="$QUEUE_CAUSE detail=command-absent"
    return 0
  fi
  if ! paths="$(cat -- "$paths_file")" || ! : >"$out"; then
    QUEUE_CAUSE="$QUEUE_CAUSE detail=inputs-unreadable"
    return 0
  fi
  (cd -- "$tree" && env -i PATH="$PATH" HOME="${HOME:-}" CHANGE_CLASS="$1" \
    DOCS_ONLY="${docs#docs_only=}" CHANGED_PATHS="$paths" \
    EVENT="$event" GITHUB_OUTPUT="$out" "./$command") >"$log" 2>&1 </dev/null ||
    status=$?
  if [ "$status" -ne 0 ]; then
    cat -- "$log" >&2
    QUEUE_CAUSE="$QUEUE_CAUSE detail=exit-$status"
    return 0
  fi
  if ! value="$(sed -n "s/^$name=//p" "$out" | tail -1)"; then
    value=""
  fi
  case "$value" in
    '[]')
      QUEUE_ONLY=false
      QUEUE_CAUSE="cause=no-queue-path" ;;
    '['*']') QUEUE_CAUSE="cause=queue-selection selector=$command output=$name value=$value" ;;
    *)
      cat -- "$log" >&2
      QUEUE_CAUSE="$QUEUE_CAUSE detail=output-unreadable" ;;
  esac
}

# The changed paths the classifier read, and the queue-only class judged on
# them, whatever class the rules answered: a refusal raised after the paths
# were read carries the class those paths earn. An empty diff is its own cause
# and stays queue-only, as does a successfully filtered schema-only step. An
# unread path set keeps cause=paths-unread.
if [ -s "$paths_file" ]; then
  changed="$(cat -- "$paths_file")"
  queue_only_of_paths
else
  case "$harness_note" in
    '' | cause=empty-diff | cause=empty-diff\ *) QUEUE_CAUSE="cause=no-changed-paths" QUEUE_INPUTS=declared ;;
  esac
fi

# The output FILE is written before stdout, as harness-only writes its own: a
# verdict printed first would already have been read when the append died.
[ "$QUEUE_ONLY" = true ] || queue_selection "$class"
per_push_mode
queue_line="queue-only: queue_only=$QUEUE_ONLY inputs=$QUEUE_INPUTS $QUEUE_CAUSE"
per_push_line="per-push: state=$PER_PUSH"
# per_push_mode read the base's settings; the action's lane producer reads
# this record.
set_globs "${HARNESS_CI_UNREAD_PATHS:-}"
unread_line="unread-paths:"
[ "${#GLOB_LIST[@]}" -eq 0 ] || unread_line="$unread_line ${GLOB_LIST[*]}"
if [ -n "$output" ] && [ "$output" != /dev/null ]; then
  lane_docs="$("$HARNESS_ONLY" --mode docs "${harness_args[@]}" \
    --paths-output "$work/paths" --outside-output "$work/outside" \
    --declared-output "$work/declared" \
    --output /dev/null)" || die "cause=path-reader-failed" "could not read lane inputs"
  [ -f "$work/declared" ] || die "cause=declared-paths-unreadable" \
    "the docs reader did not complete declaration discovery"
  # The classifier owns the resolved endpoints; render move checks read them
  # off its log. The records below are the ones the action's log carries,
  # save the unread-paths line: this route publishes no lane verdict it
  # could change.
  { cat -- "$work/class-log-head"; printf '%s\n%s\n' "$queue_line" "$per_push_line"; } >"$work/class-log"
  change_class_lanes "$class" "$lane_docs" "$event" "$repo" "$head" \
    "$QUEUE_ONLY" "$work" "$lanes_from" "$queue_default" "$QUEUE_INPUTS" >&2
fi
if [ -n "$output" ]; then
  if ! { printf 'change_class=%s\nqueue_only=%s\n' "$class" "$QUEUE_ONLY"
    [ "$output" = /dev/null ] || printf 'lanes=%s\nlanes_cause=%s\n' "$lanes" "$lanes_cause"
  } >>"$output" 2>/dev/null; then
    die "cause=output-write-failed" \
      "could not append the verdict to '$output'"
  fi
fi
printf '%s\n%s\n' "$queue_line" "$per_push_line" >&2
printf '%s\n' "$unread_line" >&2
printf '%s\n' "$class_record" >&2
printf 'change_class=%s\n' "$class"
