#!/usr/bin/env bash
# harness-only — may this diff skip a configured family of CI checks?
#
# The reader is change-scope's scripts/harness-only, installed beside this
# package; this script runs it with the arguments it was given, so every
# workflow, action and consumer that names this path keeps its call. Flags,
# modes, verdict lines and exit codes: `harness-only --help` there, forwarded
# here. A checkout without change-scope beside this package is refused with
# `wiring-error: cause=dependency-absent skill=change-scope` and exit 2, the
# wiring-error status every caller of this path already reads.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
READER="$SCRIPT_DIR/../../change-scope/scripts/harness-only"
if [ ! -x "$READER" ]; then
  printf 'wiring-error: cause=dependency-absent skill=change-scope path=%s\n' "$READER" >&2
  echo "harness-only: the change-scope package is not installed beside harness-ci" >&2
  exit 2
fi
exec "$READER" "$@"
