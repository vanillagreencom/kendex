[env]
# Existing control host. Each remote needs kendex on the PATH of the account
# its commands run as: the SSH user's `ssh HOST` PATH or, on the control host
# with JARVIS_CONTROL_USER set, that account's login-shell PATH.
JARVIS_CONTROL_HOST = ""
# The account the control host's overseers run as, when it is not the SSH
# user; owner-note lists and sends, and watch-loop reads mail and renews
# presence, there as it through `sudo -n`.
JARVIS_CONTROL_USER = ""
# Additional whitespace-separated SSH aliases. Bare notes must be unique
# across local and all remote roots; --host ALIAS or --local selects one.
# Use one stable alias per physical machine. Restart watch-loop after edits.
JARVIS_REMOTE_HOSTS = ""
# JSON object mapping alternate repository names to exact folder basenames.
# Example: JARVIS_REPO_ALIASES = '{"dot":".dot"}'
# Aliases extend canonical matches and share their ambiguity and host rules.
JARVIS_REPO_ALIASES = ""
# Empty makes this machine Jarvis main. A satellite names the main as
# DEST:/abs/main/home, DEST being what `ssh DEST` takes. Set a satellite's
# value in its private env file, never here: a cloned home would carry it.
JARVIS_MAIN_HOST = ""
# Default when unset: ${XDG_STATE_HOME:-$HOME/.local/state}/jarvis.
# Each home that runs at the same time needs a separate directory.
JARVIS_LOG_DIR = "~/.local/state/jarvis"
# A fixed window from the first complete event. Zero sends immediately.
# ci: unread
JARVIS_WAKE_SETTLE_SECS = "15"
# Comma-separated start harnesses (claude, codex, copilot, pi) whose managed
# session launches unattended, with the full-bypass permission words orch
# writes for overseers. Empty launches every harness with its native defaults.
JARVIS_UNATTENDED_HARNESSES = ""
# How much technical detail Jarvis's messages to you carry. Off explains the
# outcome in plain words and names a tool only when you asked about it or
# must act on it. On uses technical terms. The facts stay the same.
# values: off | on
# ci: unread
JARVIS_TECHNICAL = "off"
# The writing style of Jarvis's messages to you. Friendly adds a short
# greeting and closing line, concise gives the facts only and fun adds light
# humor. The facts, actions and questions stay the same in every style.
# values: friendly | concise | fun
# ci: unread
JARVIS_STYLE = "concise"
# Optional existing Slack hold. Set this in each root whose relay is held.
# Accepts an absolute path, ~/path, or a path relative to that root.
SLACK_JARVIS_SESSION_FILE = ""
# Report minute cadence and delivery use orch's settings. Issue-count cadence
# requires fleet state, which the Jarvis report reader does not supply.
ORCH_REPORT_EVERY_MINUTES = "120"
# Empty permits checkpoints at any hour; otherwise they arrive after the
# quiet window in ORCH_OWNER_TIME_ZONE.
ORCH_REPORT_QUIET_HOURS = "0-7"
# IANA time zone used to interpret report quiet hours.
ORCH_OWNER_TIME_ZONE = "America/Los_Angeles"
# ORCH_PROGRESS_REPORT_DIR uses orch's default tmp/progress-reports.
