#!/usr/bin/env bash
# Read committed Markdown growth through Git's documented metadata interface,
# and judge each committed document's shape with the commit-guards md-type
# installed beside this package.
set -euo pipefail
case "${BASH_SOURCE[0]}" in
  */*) SELF_DIR="${BASH_SOURCE[0]%/*}" ;;
  *) SELF_DIR=. ;;
esac
SELF_DIR="$(cd -- "$SELF_DIR" && pwd -P)"
DOCS_AUDIT_MD_TYPE="$SELF_DIR/../../commit-guards/scripts/md-type" DOCS_AUDIT_BASH="$BASH" exec python3 - "$@" <<'PY'
import argparse
import datetime as dt
import json
import os
from pathlib import Path
import re
import subprocess
import sys
import tempfile


def timestamp(value):
    try:
        if not re.fullmatch(r"\d{4}-\d\d-\d\dT\d\d:\d\d:\d\d(?:Z|[+-](?:[01]\d|2[0-3]):[0-5]\d)", value):
            raise ValueError()
        return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).astimezone(dt.timezone.utc)
    except ValueError:
        raise argparse.ArgumentTypeError("timestamp requires YYYY-MM-DDTHH:MM:SS and a UTC offset")


parser = argparse.ArgumentParser(description="Report committed Markdown snapshot growth.")
parser.add_argument("--since", required=True, type=timestamp)
parser.add_argument("--until", required=True, type=timestamp)
parser.add_argument("--top", type=int, default=10, help="Maximum growth and size rows per repository (default: %(default)s)")
parser.add_argument("repos", nargs="+")
args = parser.parse_args()
if args.since > args.until or args.top < 0:
    parser.error("since must not exceed until; top must be nonnegative")
start, end = args.since.isoformat(), args.until.isoformat()
env = os.environ.copy()
for key in ("GIT_DIR", "GIT_COMMON_DIR", "GIT_WORK_TREE", "GIT_INDEX_FILE"):
    env.pop(key, None)
env["GIT_TERMINAL_PROMPT"] = "0"
exclude = re.compile(rb"(^|/)(plans|research|node_modules|fixtures)/|^(changelog\.d|state)/|^CHANGELOG\.md$")
quote = json.dumps
md_type = os.environ["DOCS_AUDIT_MD_TYPE"]
bash = os.environ["DOCS_AUDIT_BASH"]
signal_words = re.compile(r" words=(\d+) example_words=(\d+) ")
judged_mark = re.compile(r"md-type: judged=(\d+)$")
# Documents per md-type run: md-type reads its rules once per run, and a
# bounded batch keeps the argument list within the system's limit.
SHAPE_BATCH = 100


def git(repo, operation, *argv, data=None):
    try:
        result = subprocess.run(["git", "-C", repo, *argv], input=data, capture_output=True,
                                env=env, timeout=60, check=True)
        return result.stdout
    except (OSError, subprocess.SubprocessError) as error:
        detail = error.stderr.decode(errors="replace") if isinstance(error, subprocess.CalledProcessError) else str(error)
        raise ValueError(f"{operation}: {detail.strip()}") from error


def snapshot(repo, revision):
    operation = f"snapshot {revision}"
    entries = {}
    for entry in git(repo, operation, "ls-tree", "-r", "-z", "--full-tree", revision).split(b"\0"):
        if entry:
            meta, path = entry.split(b"\t", 1)
            mode, kind, oid = meta.split()
            if kind == b"blob":
                entries[path] = oid
    inventory = entries.get(b".kendex-generated.json")
    if inventory is None:
        raise ValueError(f"{operation}: inventory missing")
    try:
        value = json.loads(git(repo, operation + " inventory", "cat-file", "blob", inventory))
        if not isinstance(value, list):
            raise ValueError("inventory must be an array")
        paths = [row.get("path") if isinstance(row, dict) else row for row in value]
        if any(not isinstance(path, str) for path in paths):
            raise ValueError("inventory entries require paths")
        generated = {os.fsencode(path) for path in paths}
    except (ValueError, UnicodeError) as error:
        raise ValueError(f"{operation}: invalid inventory: {error}") from error
    selected = {path: oid for path, oid in entries.items()
                if path.endswith(b".md") and not exclude.search(path) and path not in generated}
    ids = sorted(set(selected.values()))
    sizes = {}
    if ids:
        lines = git(repo, operation + " sizes", "cat-file", "--batch-check",
                    data=b"\n".join(ids) + b"\n").splitlines()
        if len(lines) != len(ids):
            raise ValueError(f"{operation}: incomplete size responses")
        for oid, line in zip(ids, lines):
            fields = line.split()
            if len(fields) != 3 or fields[:2] != [oid, b"blob"] or not fields[2].isdigit():
                raise ValueError(f"{operation}: invalid size response {line!r}")
            sizes[oid] = int(fields[2])
    return {path: sizes[oid] for path, oid in selected.items()}, selected


def shape(repo, identity, revision, selected):
    """Each selected document's md-type rows, ranked size signals, and the first unjudged document's cause."""
    rows, sizes = [], []
    paths = sorted(selected)
    for first in range(0, len(paths), SHAPE_BATCH):
        batch = paths[first:first + SHAPE_BATCH]
        shown = [f"{identity} path={quote(os.fsdecode(path))}" for path in batch]
        with tempfile.TemporaryDirectory(prefix="docs-audit-") as scratch:
            argv = [bash, md_type, "--root", repo]
            for n, path in enumerate(batch, 1):
                blob = Path(scratch, str(n))
                blob.write_bytes(git(repo, f"shape {revision}", "cat-file", "blob", selected[path]))
                argv += ["--as", path, str(blob)]
            try:
                result = subprocess.run(argv, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                        env=env, timeout=300)
            except (OSError, subprocess.SubprocessError) as error:
                return rows, sizes, (shown[0], f"md-type unrunnable: {error}")
        # md-type ends each document's lines with judged=N, N its place in
        # this batch.
        pending, judged = [], 0
        for line in result.stdout.decode(errors="replace").splitlines():
            if not line.startswith("md-type: "):
                continue
            mark = judged_mark.match(line)
            if not mark:
                pending.append(line)
                continue
            judged = int(mark.group(1))
            if not 1 <= judged <= len(batch):
                return rows, sizes, (shown[0], f"md-type judged an unknown document: {line}")
            for found in pending:
                match = signal_words.search(found)
                if found.startswith("md-type: signal=") and match:
                    words, example = int(match.group(1)), int(match.group(2))
                    sizes.append((-(words / example if example else float(words)), os.fsdecode(batch[judged - 1]),
                                  f"shape-size {shown[judged - 1]} md_type={quote(found)}"))
                else:
                    rows.append(f"shape {shown[judged - 1]} md_type={quote(found)}")
            pending = []
        # Exit 2 is md-type's refusal to judge, a missing or unreadable rule
        # set among them; nothing past it is judged by the same rules.
        if result.returncode not in (0, 1) or judged != len(batch):
            cause = pending[0] if pending else f"md-type exit {result.returncode}"
            return rows, sizes, (shown[min(judged, len(batch) - 1)], cause)
    return rows, sizes, None


failed = False
for named in args.repos:
    identity = f"repo={quote(Path(named).name)} repo_path={quote(named)}"
    try:
        repo = str(Path(named).resolve())
        identity = f"repo={quote(Path(repo).name)} repo_path={quote(repo)}"
        pinned = git(repo, "HEAD", "rev-parse", "--verify", "HEAD^{commit}").decode().strip()
        if git(repo, "history", "rev-parse", "--is-shallow-repository").strip() != b"false":
            raise ValueError("history: shallow repository")
        head = git(repo, "head endpoint", "rev-list", "-1", f"--before={end}", pinned).decode().strip()
        if not head:
            raise ValueError("head endpoint: no commit at or before until")
        base = git(repo, "base endpoint", "rev-list", "-1", f"--before={start}", head).decode().strip()
        if not base:
            raise ValueError("base endpoint: no commit at or before since")
        (old, _), (new, head_blobs) = snapshot(repo, base), snapshot(repo, head)
        rows = [f"{identity} base={base} head={head} since={start} until={end} "
                f"md_files={len(old)}->{len(new)} md_bytes={sum(old.values())}->{sum(new.values())}"]
        growth = sorted(((size - old.get(path, 0), size, path) for path, size in new.items()
                         if size > old.get(path, 0)), key=lambda row: (-row[0], row[2]))
        rows.extend(f"growth {identity} delta_bytes={delta} bytes={size} path={quote(os.fsdecode(path))}"
                    for delta, size, path in growth[:args.top])
        if os.access(md_type, os.R_OK):
            shapes, sizes, unjudged = shape(repo, identity, head, head_blobs)
        else:
            shapes, sizes, unjudged = [], [], (identity, f"md-type missing at {md_type}")
        rows.extend(shapes)
        rows.extend(row for _, _, row in sorted(sizes)[:args.top])
        if unjudged:
            failed = True
            rows.append(f"shape {unjudged[0]} status=unjudged cause={quote(unjudged[1])}")
        print("\n".join(rows))
    except (ValueError, OSError) as error:
        failed = True
        print(f"{identity} status=unread cause={quote(str(error))}")
sys.exit(1 if failed else 0)
PY
