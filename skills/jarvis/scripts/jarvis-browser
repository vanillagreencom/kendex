#!/usr/bin/env python3
# Platform: Linux and macOS with Python 3 and a Chromium-based browser.
"""Open a URL in the configured assistant profile. Chromium owns profile reuse."""
import argparse
from contextlib import closing
import http.client
import json
import os
from pathlib import Path
import shutil
import signal
import subprocess
import sys
import time
from urllib.parse import urlsplit
import uuid


def profile_port(profile, child=None):
    # A stale file can name a port another profile now owns. Match Chromium's
    # browser target, published in DevToolsActivePort, before reporting readiness.
    deadline = time.monotonic() + 10
    while True:
        if child and child.poll() not in (None, 0):
            raise OSError("browser exited before its endpoint was ready")
        try:
            port, target = (profile / "DevToolsActivePort").read_text().splitlines()
            if not 0 < int(port) < 65536:
                raise ValueError("profile port")
            with closing(http.client.HTTPConnection("127.0.0.1", int(port), timeout=0.5)) as connection:
                connection.request("GET", "/json/version")
                endpoint = urlsplit(json.load(connection.getresponse())["webSocketDebuggerUrl"])
            if (endpoint.scheme, endpoint.hostname, endpoint.port, endpoint.path) != (
                    "ws", "127.0.0.1", int(port), target) or not target.startswith("/devtools/browser/"):
                raise ValueError("profile browser target")
            return port
        except (OSError, ValueError, KeyError, TypeError, http.client.HTTPException) as failure:
            if time.monotonic() >= deadline:
                raise TimeoutError("profile endpoint unavailable") from failure
            time.sleep(0.05)


def set_downloads(profile, downloads):
    # Chromium has no downloads switch. DevTools Browser.setDownloadBehavior is
    # experimental and its override is cleared when the setting session detaches,
    # which this launcher does on exec or detach. The DownloadDirectory policy is
    # read only from machine-wide managed locations (root-owned /etc on Linux, a
    # managed profile on macOS) and would move the user's own browser's downloads too.
    # Chromium reads this preference when the profile opens, and a running browser
    # owns the file, so only a closed profile is edited.
    if os.path.lexists(profile / "SingletonLock"):
        return
    profile.mkdir(mode=0o700, parents=True, exist_ok=True)
    (profile / "Default").mkdir(mode=0o700, exist_ok=True)
    preferences = profile / "Default" / "Preferences"
    try:
        values = json.loads(preferences.read_text())
    except FileNotFoundError:
        values = {}
    download = values.setdefault("download", {})
    download["default_directory"] = str(downloads)
    # Keep a closed profile's explicit prompt choice; only a missing value defaults.
    download.setdefault("prompt_for_download", False)
    temporary = preferences.with_name("Preferences." + uuid.uuid4().hex)
    fd = os.open(temporary, os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o600)
    try:
        with os.fdopen(fd, "w") as stream:
            json.dump(values, stream)
        os.replace(temporary, preferences)
    except BaseException:
        temporary.unlink()
        raise


def stop_profile(profile):
    """Stop every process running on PROFILE; return the failure's cause, or None once none runs."""
    # A browser started in its own session or service unit keeps no tie to
    # its launcher; the --user-data-dir argument each launch passes is what
    # names its profile. ps joins argv with spaces, so it matches between spaces.
    argument = " --user-data-dir=" + str(profile) + " "

    def holders():
        try:
            listed = subprocess.run(["ps", "-A", "-ww", "-o", "pid=", "-o", "args="], stdin=subprocess.DEVNULL,
                                    capture_output=True, text=True, errors="replace", timeout=5)
        except (OSError, subprocess.TimeoutExpired):
            return None
        if listed.returncode:
            return None
        return [int(row.split(None, 1)[0]) for row in listed.stdout.splitlines()
                if argument in " " + row.strip() + " "]

    pids = holders()
    # SIGTERM lets Chromium shut down cleanly; SIGKILL ends one that does not.
    for signum in (signal.SIGTERM, signal.SIGKILL):
        if pids is None:
            return "process-unread"
        if not pids:
            return None
        for pid in pids:
            try:
                os.kill(pid, signum)
            except ProcessLookupError:
                pass
            except PermissionError:
                return "signal-refused"
        deadline = time.monotonic() + 1
        while (pids := holders()) and time.monotonic() < deadline:
            time.sleep(0.05)
    return "process-unread" if pids is None else "still-running" if pids else None


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog=(
        "Platform: Linux and macOS. JARVIS_BROWSER_PROFILE: required absolute assistant profile. "
        "JARVIS_BROWSER_COMMAND: optional executable name/path; otherwise detect Chromium, Chrome, Brave or Edge. "
        "JARVIS_BROWSER_PORT: loopback debugging port, default 9222; 0 lets Chromium allocate a port per profile. "
        "JARVIS_BROWSER_DOWNLOADS: optional absolute downloads directory, applied when the profile is not open. "
        "JARVIS_BROWSER_CLASS: optional window class, the Wayland app id on Linux. "
        "The plain invocation is the service form: the browser replaces this process as the unit's main process. "
        "Use --detach from a terminal, not from a service unit. "
        "The --shim launchers use --detach. "
        "--stop exits 0 once no process runs on the profile, and 2 with stop=failed cause=KEY where one may still run: "
        "process-unread, signal-refused or still-running."))
    parser.add_argument("url", nargs="?", help="URL to open; required unless a report flag is given")
    parser.add_argument("--detach", action="store_true",
                        help="terminal form: check the request, then start the browser in its own session with no output "
                             "and return once it has started (with port 0, wait for its profile endpoint)")
    report = parser.add_mutually_exclusive_group()
    report.add_argument("--port", action="store_true", help="print the configured port; with port 0, wait up to 10 seconds "
                        "for the requested profile's live debugging endpoint")
    report.add_argument("--shim", action="store_true",
                        help="print a directory whose xdg-open, x-www-browser and www-browser open their URL here")
    report.add_argument("--stop", action="store_true",
                        help="stop every browser running on the profile, however it was started: SIGTERM, "
                             "then SIGKILL to one still running a second later")
    args = parser.parse_args()
    if sys.platform not in ("linux", "darwin"):
        parser.exit(2, "jarvis-browser: platform=unsupported\n")
    port = os.environ.get("JARVIS_BROWSER_PORT", "9222")
    if port != "0":
        if not port.isascii() or not port.isdecimal() or not 1 <= int(port) <= 65535:
            parser.exit(2, "jarvis-browser: setting=JARVIS_BROWSER_PORT\n")
    if args.port and port != "0":
        print(port)
        return
    if args.shim:
        print(Path(__file__).resolve().parent / "browser-shim")
        return
    if args.url is None and not (args.port or args.stop):
        parser.error("a URL is required to launch the browser")
    profile = Path(os.environ.get("JARVIS_BROWSER_PROFILE", ""))
    if not profile.is_absolute():
        parser.exit(2, "jarvis-browser: setting=JARVIS_BROWSER_PROFILE\nSupply an absolute assistant-owned profile path.\n")
    if args.stop:
        cause = stop_profile(profile)
        if cause:
            parser.exit(2, "jarvis-browser: stop=failed cause=" + cause + "\n")
        return
    if args.port:
        try:
            print(profile_port(profile))
        except OSError:
            parser.exit(2, "jarvis-browser: endpoint=unavailable\n")
        return
    # CLI URLs can otherwise become Chromium flags instead of navigation.
    if urlsplit(args.url).scheme not in ("http", "https", "about", "file"):
        parser.exit(2, "jarvis-browser: url=unsupported-scheme\n")
    downloads = os.environ.get("JARVIS_BROWSER_DOWNLOADS")
    if downloads and not Path(downloads).is_absolute():
        parser.exit(2, "jarvis-browser: setting=JARVIS_BROWSER_DOWNLOADS\n")
    command = os.environ.get("JARVIS_BROWSER_COMMAND")
    candidates = [command] if command else [
        "chromium", "chromium-browser", "google-chrome", "google-chrome-stable",
        "chrome", "brave-browser", "brave", "microsoft-edge", "microsoft-edge-stable",
    ]
    if not command and sys.platform == "darwin":
        for app, executable in [("Chromium", "Chromium"), ("Google Chrome", "Google Chrome"),
                                ("Brave Browser", "Brave Browser"), ("Microsoft Edge", "Microsoft Edge")]:
            for root in (Path("/Applications"), Path.home() / "Applications"):
                candidates.append(str(root / (app + ".app") / "Contents/MacOS" / executable))
    browser = next((found for name in candidates if (found := shutil.which(name))), None)
    if browser is None:
        parser.exit(2, "jarvis-browser: dependency=chromium-browser\nSet JARVIS_BROWSER_COMMAND to an installed Chromium-based browser.\n")
    if downloads:
        set_downloads(profile, Path(downloads))
    window = os.environ.get("JARVIS_BROWSER_CLASS")
    argv = [browser, "--user-data-dir=" + str(profile), "--remote-debugging-address=127.0.0.1",
            "--remote-debugging-port=" + port, "--no-first-run", *(["--class=" + window] if window else []), args.url]
    # This launcher passes the caller's desktop environment unchanged.
    if args.detach:
        # A caller reading this process's output reaches its end when this process exits.
        child = subprocess.Popen(argv, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                 stderr=subprocess.DEVNULL, start_new_session=True)
        if port == "0":
            try:
                profile_port(profile, child)
            except OSError:
                if child.poll() is None:
                    child.terminate()
                    try:
                        child.wait(timeout=2)
                    except subprocess.TimeoutExpired:
                        child.kill()
                        child.wait(timeout=2)
                parser.exit(2, "jarvis-browser: endpoint=unavailable\n")
        return
    os.execv(browser, argv)


if __name__ == "__main__":
    try:
        main()
    except (OSError, ValueError):
        sys.exit("jarvis-browser: launch=failed")
