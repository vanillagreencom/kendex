#!/usr/bin/env python3
"""Read one rule or memory section without relying on its line numbers."""
import argparse
import json
from pathlib import Path
import re
import sys


def main():
    parser = argparse.ArgumentParser(description="Print an ATX Markdown heading and its section, including child sections.")
    parser.add_argument("file", type=Path)
    parser.add_argument("heading", help="Exact heading text, without the leading # marks")
    args = parser.parse_args()
    try:
        lines = args.file.read_bytes().decode("utf-8").splitlines(keepends=True)
    except (OSError, UnicodeError) as error:
        print("jarvis-section: " + json.dumps({"error": "read-failed", "file": str(args.file), "cause": str(error)}), file=sys.stderr)
        return 1

    headings = []
    fence = None
    for index, line in enumerate(lines):
        text = line.rstrip("\r\n")
        marker = re.match(r"^ {0,3}(`{3,}|~{3,})(.*)$", text)
        if fence:
            if marker and marker[1][0] == fence[0] and len(marker[1]) >= len(fence) and not marker[2].strip():
                fence = None
            continue
        if marker and (marker[1][0] == "~" or "`" not in marker[2]):
            fence = marker[1]
            continue
        match = re.match(r"^ {0,3}(#{1,6})(?:[ \t]+(.*)|$)", text)
        if match:
            title = re.sub(r"[ \t]+#+[ \t]*$", "", match[2] or "").strip(" \t")
            headings.append((index, len(match[1]), title))

    matches = [row for row in headings if row[2] == args.heading]
    if len(matches) != 1:
        candidates = matches if matches else headings
        print("jarvis-section: " + json.dumps({
            "error": "ambiguous-heading" if matches else "unknown-heading", "heading": args.heading,
            "candidates": [{"heading": title, "line": index + 1} for index, _, title in candidates],
        }), file=sys.stderr)
        return 2
    start, level, _ = matches[0]
    end = next((index for index, depth, _ in headings if index > start and depth <= level), len(lines))
    sys.stdout.buffer.write("".join(lines[start:end]).encode("utf-8"))
    return 0


if __name__ == "__main__":
    sys.exit(main())
