#!/usr/bin/env -S python3 -I
# Platform: Linux and macOS with Python 3; the 1Password CLI route is optional.
# The broker holds the session token, so Python runs isolated: no user site directory or PYTHON* setting runs code
# in it. Isolated mode also leaves this directory off sys.path.
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from lib.op_fifo import main

if __name__ == "__main__":
    main("broker")
