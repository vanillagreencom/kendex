#!/usr/bin/env bash
# Usage: owner-note REPO FILE
# Send FILE and the verify footer as a directive to REPO's overseer, on the
# control host first when JARVIS_CONTROL_HOST is set, then on this machine.
set -euo pipefail
SCRIPT_ROOT="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)"
exec python3 -B "$SCRIPT_ROOT/lib/owner_note.py" --bash "$BASH" "$@"
