#!/usr/bin/env bash
# Usage: watch-loop [--home PATH] [--initial-pass PATH ...]
#        watch-loop install --home PATH [--print]
# --initial-pass accepts a reconciled public pass per destination, saves fresh
# state and exits. Follow references/control-host-events.md before adoption.
# Run the foreground loop through its user service, Claude Monitor or an orch job.
set -euo pipefail
SCRIPT_ROOT="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)"
if [[ "${1:-}" == install ]]; then
  shift
  exec python3 -B "$SCRIPT_ROOT/lib/watch.py" install --bash "$BASH" "$@"
fi
# Keep this foreground shell in the job's process group. The existing wake
# check matches its home-specific argv; the job runner stops the whole group.
python3 -B "$SCRIPT_ROOT/lib/watch.py" loop --bash "$BASH" "$@"
