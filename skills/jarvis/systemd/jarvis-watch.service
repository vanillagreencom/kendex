[Unit]
Description=Jarvis satellite watch loop

[Service]
Type=notify
NotifyAccess=all
Environment=$environment
UnsetEnvironment=$unset
# The suffix keeps any trailing path spaces inside the assignment.
WorkingDirectory=$directory/.
ExecStart=:$launcher --home $home --satellite
Restart=on-failure
RestartSec=60

[Install]
WantedBy=default.target
