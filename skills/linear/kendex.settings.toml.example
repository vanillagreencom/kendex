[env]

# Which Linear team this project writes to, and how its issues are read and
# created.

# The team a Linear write targets unless the command names another team.
# Creating an issue, project, cycle or label can name one for that call.
# There is no default: while this is empty, writes are refused rather than
# guessing which team inside the workspace the key reaches.
LINEAR_TEAM = "" # required

# The letters in front of this team's issue numbers, as in PROJ-123. Help
# text and examples use it.
LINEAR_TEAM_PREFIX = "PROJ"

# The labels that route an issue to an agent, separated by commas. With a
# list here, creating an issue that carries none of them is refused, because
# nothing would pick that issue up. Empty turns the refusal off.
LINEAR_AGENT_LABELS = ""

# Whether a new issue must say who runs into the problem. Any value turns it
# on: a description with no "Reached by" line is refused, and a
# high-priority issue born from a review also needs a "Symptom" line. Empty
# turns it off.
LINEAR_REQUIRE_REACH = ""

# The shape read commands print in: "safe" is flat and easy to read, "table"
# is for a person, "ids" prints identifiers alone, "compact" is a small
# shape for routing, and "raw" prints Linear's own nesting. Not every
# command prints every shape. Getting one issue, and listing an issue's
# children or relations, refuse a shape they lack. Every other command
# prints the safe shape in place of one it lacks, so a wrong choice here can
# go unnoticed.
LINEAR_FORMAT = "safe"

# Seconds to wait before retrying a Linear call that was rate limited or
# failed. The wait doubles on each further attempt. Whole seconds; 0 retries
# with no wait at all.
LINEAR_RETRY_BASE_DELAY = "1"

[secrets]

# The key every Linear call authenticates with. Create one in Linear, under
# Settings, Security and access, Personal API keys. A key set here beats one
# already in your shell, unlike every other setting, because a machine-wide
# key points at the wrong workspace for all but one project.
LINEAR_API_KEY = "" # required
