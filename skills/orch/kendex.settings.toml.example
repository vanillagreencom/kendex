[env]

# ORCH — PR review gate, CI waits, reviewer fan-out, and handoff lanes.
# Nothing below is marked `# required`, so installing this skill writes
# nothing into <project>/kendex.settings.toml. What an install writes, and
# when, is kendex's docs/authoring/settings.md. Comments here are one-line
# intent + landmines; full key reference: orch README.md / DEVELOPMENT.md.
# Fleet handoff default: tmp/handoffs/OVERSEER-HANDOFF.md (workflows/oversee.md).

# Directory orch keeps its per-issue workflow state in; the `--state-dir`
# flag wins where both are set.
ORCH_STATE_DIR = "tmp"

# Absolute consumer base checkouts, space-separated in refresh order. The train
# also refreshes every other registered project that subscribes to the package.
ORCH_CONSUMER_REPOS = ""

# Overseer watcher baselines and lane claims. Empty uses
# <project-root>/tmp/oversee-watch. The overseer's host owns persistence.
OVERSEE_WATCH_STATE_DIR = ""

# Path to the worktree CLI `open-terminal` drives. Empty resolves the
# installed worktree skill's `scripts/worktree`; a value that is not
# executable stops the launch with that path named.
WORKTREE_CLI = ""

# Host provider used by lane-host. open-terminal launches lanes through it, and
# its --host option overrides it. A script path opts in; credentials alone never
# select a remote host.
ORCH_LANE_HOST = "local"

# Lane pane output. No person reads a lane's pane, so "quiet" is the package
# default: one line per completed step, and each <output_format> block the lane
# fills itself written to a file instead of printed: the artifact that step
# owns, or one of its own under the worktree tmp/. "normal" prints every block
# as written; any other value is quiet. Harness output is never suppressed. The
# destinations in full: references/skill-rules.md, Lane Output.
ORCH_LANE_OUTPUT = "quiet"

# Reviewer merge gate: "approval" needs a GitHub approval; "review" needs a
# non-author review of the current head plus zero unresolved threads (for
# bots that comment but never approve); "off" only where no reviewer exists.
PR_REVIEW_GATE = "approval"

# The review-gate ENGINE's one-switch disable, consumed by orch even where
# the review-gate skill is not installed. Only the exact value "off"
# narrows; anything else leaves PR_REVIEW_GATE authoritative.
REVIEW_GATE_MODE = "enforce"

# Total review-wait budget in seconds before the on-timeout policy applies;
# an explicit max_wait argument always wins.
PR_REVIEW_WAIT_SECS = "900"

# Check-run or commit-status name a trusted review bot publishes on
# analyzed heads; a
# success counts as review-received. SECURITY: matched by NAME and anyone
# can publish under any name — name only the trusted bot's check. Empty =
# review objects only.
PR_REVIEW_CHECK = ""

# Review timeout: "proceed" advances only when no reviewer engaged and no thread is open; "block" stops.
PR_REVIEW_ON_TIMEOUT = "proceed"

# Seconds ci-wait keeps polling before failing when no CI checks registered
# yet; raise for approval-gated CI with slow dispatch.
CI_WAIT_NO_CHECKS_GRACE = "180"

# Max automated ci-fix rounds per PR before a human takes over.
CI_FIX_MAX_CYCLES = "6"

# Max internal re-review cycles per issue before the verdict pass; the
# re-review re-entry raises rereview_cycles and refuses at this, so the number
# set is the number of re-entries allowed.
REVIEW_MAX_CYCLES = "4"

# Max external review rounds on an open PR. At or past it a finding gets a
# disposition and no fix push, except a defect the diff introduces or arms.
REVIEW_MAX_EXTERNAL_ROUNDS = "4"

# Total concurrent agent-session budget, counting the primary; "0" =
# unlimited. Reviews run in waves when the reviewer set exceeds free slots.
# On the Codex runtime, set the cap `spawn-adapter slots` reports.
REVIEWER_SLOT_BUDGET = "0"

# Who the session is talking to. "ceo" asks only about outcomes, in plain
# language, and runs the decision, merge and issue-creation gates below
# unattended unless this file sets one of them. "engineer" keeps each of those
# keys' own default and the package's original wording.
# values: ceo | engineer
ORCH_USER_MODE = "ceo"

# Post-PR choices: "auto-recommended" continues within each budget; "ask" prompts.
ORCH_DECISION_MODE = "auto-recommended"

# Merge consent only: "auto" merges after every gate passes; "ask" prompts.
ORCH_MERGE_AUTONOMY = "auto"

# Merge route: "fast-path" merges a PR directly, ahead of the queue and its
# second CI pass, when the head already holds the base head and every gate is
# met; any other value, unset or unrecognized, arms auto-merge first and the
# PR takes the queue. It instructs the lane and grants nothing: the ruleset
# bypass for the merging account is the org's decision.
ORCH_MERGE_BYPASS = "off"

# The gh config directory on the control host holding the owner credential the
# overseer merges a gate-met PR with, through `github.sh pr-merge
# --admin-credential`. Empty turns the route off and every lane takes the
# queue; no lane ever holds the credential.
ORCH_ADMIN_MERGE_GH_CONFIG_DIR = ""

# Change classes that route may merge, comma- or space-separated. Empty means
# every class; only an empty ORCH_ADMIN_MERGE_GH_CONFIG_DIR turns the route
# off. A set value names classes the change classifier answers: render,
# trivial, micro, small and standard. The class comes from that classifier
# alone, and a classifier that cannot be reached or read refuses the merge
# with class-unreadable.
ORCH_ADMIN_MERGE_CLASSES = ""

# Seconds per brief-delivery verification pass on tmux handoff lanes.
ORCH_TMUX_VERIFY_SECS = "15"

# The tmux session every lane window opens in. Unset, a fleet launch uses the
# session its oversee state records as tmux.session, else the launching pane's.
# The fleet's first tmux launch records the session it opened in, this one when
# set, once tmux confirms it exists. A launch with no live pane and no recorded
# session refuses as tmux-session-unresolved; a session tmux does not hold
# refuses as tmux-session-missing. A launch needs $TMUX set either way.
# ORCH_TMUX_SESSION = "kendex"

# Seconds a hosted lane waits for its remote shell prompt after the ssh line is
# typed. Its own bound, not the one above: it measures a route coming up and
# another machine's login. A bound spent with ssh still on the pane interrupts
# that client and waits the bound again for the pane's own shell; the ssh line
# is typed again only once that shell is back, because the pane has to be out
# of ssh before a line pasted into it is run rather than typed into the stalled
# session. The refusal counts the ssh lines typed in its attempts field.
ORCH_LANE_SSH_PROMPT_SECS = "60"

# Rename auto-discovered launch lanes (`<config-dir>=<alias>` pairs); the
# inventory is always discovered — this only renames it. ORCH_LANE_DIRS
# covers layouts discovery cannot reach.
# ORCH_LANE_ALIASES = "eclaude=work,mclaude=overflow"

# Launch lanes never listed, measured or picked; lanes retired from a UTC date.
# Each is named by its directory name or alias, never a path.
# ORCH_LANE_EXCLUDE = "sclaude"
# ORCH_LANE_RETIRE = "nclaude=YYYY-MM-DD"

# Seconds a per-host cached lane usage figure is reused; 0 fetches every run.
# Keep it at or above the longest watch interval on the host: under that, every
# pass finds the figure expired and posts again, which is the burst the cache
# exists to bound.
# ORCH_LANES_USAGE_TTL = "300"

# The calling pass's own interval in seconds, which widens the age a cached
# usage figure is served within and never narrows it. 0 leaves the TTL alone,
# and a TTL of 0 is never widened. `lanes --max-age` is the same value on argv.
# ORCH_LANES_USAGE_MAX_AGE = "0"

# Usage share at or above which `lanes pick` refuses an account, read against
# the binding bucket or, with --model, against the window that walls that
# model. Never compared with ORCH_HANDOFF_HEADROOM_PCT below: a lane picked on
# a model window can already be at or below the handoff mark on the account's
# own bucket, and `lanes pick --binding-floor` is what holds both to one bound
# for a caller that needs it.
# ORCH_LANE_MAX_PCT = "95"

# Account headroom at or below which `lanes context` marks a live lane for
# handoff, read against the binding bucket. The overseer asks a marked lane for
# its handoff at the next safe point.
# ORCH_HANDOFF_HEADROOM_PCT = "3"

# Context tokens at or past which a turn end is refused until that session's
# handoff record stands: the lane-mail-check hook judges a lane on it, and
# oversee-succeed judges the overseer on it for that hook and for the watch.
# ORCH_HANDOFF_CONTEXT_TOKENS = "500000"

# Path globs that add the needs-perf-test QA signal to review routing.
# QA_PERF_PATHS = "src/hot/* engine/src/*"

# Max concurrent lanes the overseer keeps in flight.
ORCH_OVERSEER_LANES = "3"

# "off" stops oversee-succeed from launching a successor overseer, and turns
# off the turn-end refusal that names it. A live
# overseer writes its handoff and asks the user to start the next session. A
# dead or walled overseer cannot ask, so the watch reports the case and leaves
# a notice for a manual replacement.
# ORCH_OVERSEER_SUCCESSION = "on"

# Minutes before the projected account wall that starts overseer succession.
# Zero disables the rate trigger.
ORCH_OVERSEER_WALL_MINUTES = "30"

# Maximum number of better successor accounts that starts succession.
# Zero disables the qualifying-account trigger.
ORCH_OVERSEER_SUCCESSOR_ACCOUNTS = "1"

# Consecutive oversee-watch passes the overseer's own pane must read exited
# before the watch reports overseer-dead, or walled before it reports
# overseer-walled, and relaunches. One pass is a poll that caught a live
# session between its harness and its shell. A walled reading also needs the
# account judged at or below ORCH_OVERSEER_HEADROOM_PCT: that pane carries the
# limit banners the watch relays about other lanes, and passes alone never
# close a window whose harness is alive.
# ORCH_OVERSEER_DEAD_PASSES = "2"

# Account headroom, in percent of the binding bucket, at or below which
# oversee-succeed succeeds the overseer and refuses its turn end through the
# lane-mail-check hook. No successor is opened on an account at or below it.
# ORCH_OVERSEER_HEADROOM_PCT = "10"

# Watch passes a standing overseer-mark waits before oversee-watch reports it
# again. The first crossing is always reported; this only bounds how often a
# mark the overseer has not yet acted on comes back.
# ORCH_OVERSEER_MARK_REPEAT = "5"

# Most lines any one oversee-watch event prints off a lane's pane. Each event
# kind already carries only what its handling reads; this caps what is left.
# Raise it to carry a screen the default trims.
# ORCH_WATCH_TAIL_LINES = "12"

# Branch size measurement: branch-size-check --help.
# Size alone never refuses work.
# Render-mirror roots, blank separated. A path under one of
# them drops out of the count only when what remains after the root names a
# source changed in the same diff; a render whose source did not change is
# counted.
# ORCH_SIZE_RENDER_ROOTS = ".agents .claude .codex .pi"
# Extra test-path globs, blank separated, added to the built-in test rule
# (test/, tests/, __tests__/, tests.rs, *test_util.rs, *.test.*, *.spec.*).
# A glob matches the whole repository-relative path; `*` spans `/` and every
# character but `*` and `?` is literal. Empty, the built-in rule stands alone.
# ORCH_SIZE_TEST_PATHS = "scripts/check-*.py"

# Hours before an In Progress / In Review item counts as started-stale in
# reconcile-work-items sweeps.
# RECONCILE_STALE_HOURS = "24"
