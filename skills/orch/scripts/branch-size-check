#!/usr/bin/env bash
# branch-size-check — the submit-time size check: score the branch's whole
# diffstat against the issue it implements, once, before the push
# (kendex KEN-1185).
#
# The fix-round tripwire dev-round-write applies runs at fix-round mint against
# workflow state pr.baseline_lines, and that baseline is the lane's own first
# commit. A branch that arrived at gate-open already grown — amended or
# squashed before the PR opened — never meets it: the 18-hour scan of
# 2026-09-02 found five of the day's six unruled past-2x merges were oversized
# before any fix round existed. This check runs where that gap is, at
# submit-pr before the push, and it scores the branch against the issue rather
# than against the branch's own first commit.
#
# Test lines are scored on their own line. A branch's test growth answers to
# the issue's Done-when surfaces — one control per surface plus its must-fail
# control — not to the production allowance, and a single total hides which of
# the two grew. The scan's cohort D added 73% of its lines as tests with the
# production tripwire reading green.
#
# Usage:
#   branch-size-check --worktree PATH --issue ID [--json]
#
# --issue is the normalized workflow-state key: `issue-N` for GitHub, the
# tracker identifier (KEN-123) otherwise.
#
# Exit codes: 0 within the allowance; 2 usage or environment failure; 3 the
# branch is over an allowance and must be cut before it is pushed.
#
# The verdict and its counts are recorded in the existing pr record beside
# pr.baseline_lines, as pr.size_check. There is no second state file.
#
# ORCH_SIZE_EST_LINES                 estimate -> production allowance map
#                                     (default 1=400;2=800;3=1200;4=2000;5=3200)
# ORCH_SIZE_TEST_LINES_PER_CONTROL    lines one control is allowed (default 40)
# ORCH_SIZE_RENDER_ROOTS              render-mirror roots, blank separated
#                                     (default ".agents .claude .codex .pi")

set -euo pipefail

PROG="branch-size-check"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

print_usage() {
  sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'
}

# `.env.local` is sourced as shell by the settings loader, so a help request is
# answered before any project configuration is read.
for _arg in "$@"; do
  case "$_arg" in
  --help | -h | help) print_usage; exit 0 ;;
  esac
done
unset _arg

# shellcheck source=lib/branch-growth.sh
source "$SCRIPT_DIR/lib/branch-growth.sh"

ID_GRAMMAR='^[A-Za-z0-9._-]+$'

die() {
  printf '%s: %s\n' "$PROG" "$1" >&2
  exit 2
}

refuse() {
  printf '%s: submit refused: %s\n' "$PROG" "$1" >&2
}

worktree=""
issue=""
as_json=false
while (( $# > 0 )); do
  case "$1" in
    --worktree) [[ $# -ge 2 ]] || die "--worktree requires a value"; worktree="$2"; shift 2 ;;
    --issue)    [[ $# -ge 2 ]] || die "--issue requires a value";    issue="$2";    shift 2 ;;
    --json)     as_json=true; shift ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n "$worktree" ]] || die "--worktree is required"
[[ -d "$worktree" ]] || die "--worktree path '$worktree' is not a directory"
[[ -n "$issue" ]] || die "--issue is required (the normalized workflow-state key)"
[[ "$issue" =~ $ID_GRAMMAR && "$issue" != *..* ]] \
  || die "--issue '$issue' must match ${ID_GRAMMAR} with no '..'"
command -v jq >/dev/null 2>&1 || die "jq is required"

REPO_ROOT="$(git -C "$worktree" rev-parse --show-toplevel 2>/dev/null)" \
  || die "--worktree path '$worktree' is not inside a git repository"
export PROJECT_ROOT="$REPO_ROOT"
export SCRIPT_DIR
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$REPO_ROOT"

est_lines_map="${ORCH_SIZE_EST_LINES:-1=400;2=800;3=1200;4=2000;5=3200}"
lines_per_control="${ORCH_SIZE_TEST_LINES_PER_CONTROL:-40}"
render_roots="${ORCH_SIZE_RENDER_ROOTS:-.agents .claude .codex .pi}"
[[ "$lines_per_control" =~ ^[1-9][0-9]*$ ]] \
  || die "ORCH_SIZE_TEST_LINES_PER_CONTROL must be a positive integer, got '$lines_per_control'"

# --- The issue's own text: the allowance and the surfaces are read from it ---
# A tracker that cannot be read is not a verdict about the branch. The check
# falls back to the rule that ran before it — the whole diffstat against twice
# pr.baseline_lines — and records which fallback it took, so a green run never
# claims a bar it never applied.
issue_body=""
issue_estimate=""
issue_source=""
read_issue() {
  local cache row number
  if [[ "$issue" == issue-* ]]; then
    number="${issue#issue-}"
    command -v gh >/dev/null 2>&1 || { issue_source="github_cli_absent"; return 1; }
    # gh resolves the repository from the working directory, which is the
    # caller's, not the worktree's. The subshell scopes the move.
    issue_body="$( (cd "$REPO_ROOT" && gh issue view "$number" --json body --jq '.body // ""') 2>/dev/null)" \
      || { issue_source="github_issue_unreadable"; return 1; }
    issue_source="github"
    return 0
  fi
  cache="$REPO_ROOT/.cache/linear/issues.json"
  [[ -f "$cache" ]] || { issue_source="linear_cache_absent"; return 1; }
  row="$(jq -c --arg id "$issue" 'map(select(.identifier == $id)) | .[0] // empty' "$cache" 2>/dev/null)" \
    || { issue_source="linear_cache_unreadable"; return 1; }
  [[ -n "$row" ]] || { issue_source="linear_issue_absent"; return 1; }
  issue_body="$(jq -r '.description // ""' <<<"$row")"
  issue_estimate="$(jq -r '.estimate // "" | tostring' <<<"$row")"
  [[ "$issue_estimate" =~ ^[1-9][0-9]*$ ]] || issue_estimate=""
  issue_source="linear"
  return 0
}
read_issue || true

# A stated expected delta wins over the estimate: it is the issue's own number
# of lines, where the estimate is a duration this project maps to one.
stated_lines=""
if [[ -n "$issue_body" ]]; then
  stated_lines="$(
    printf '%s\n' "$issue_body" | sed -n 's/.*[Ee]xpected delta[^0-9]*\([0-9][0-9]*\) *lines.*/\1/p' | head -n 1
  )"
  [[ "$stated_lines" =~ ^[1-9][0-9]*$ ]] || stated_lines=""
fi

est_allowance=""
if [[ -z "$stated_lines" && -n "$issue_estimate" ]]; then
  est_allowance="$(
    printf '%s\n' "$est_lines_map" \
      | tr ';' '\n' \
      | sed -n "s/^ *${issue_estimate}= *\([0-9][0-9]*\) *$/\1/p" \
      | head -n 1
  )"
  [[ "$est_allowance" =~ ^[1-9][0-9]*$ ]] || est_allowance=""
fi

# --- The Done-when surfaces the test allowance is built from ---
surfaces=0
surface_list=""
if [[ -n "$issue_body" ]]; then
  surface_list="$(
    printf '%s\n' "$issue_body" | awk '
      /^[[:space:]]*#+[[:space:]]*[Dd]one-when/ { inside = 1; next }
      inside && /^[[:space:]]*#+[[:space:]]/ { inside = 0 }
      inside && /^[[:space:]]*[-*][[:space:]]*\[[ xX]\][[:space:]]*/ {
        sub(/^[[:space:]]*[-*][[:space:]]*\[[ xX]\][[:space:]]*/, "")
        print
      }
    '
  )"
  [[ -z "$surface_list" ]] || surfaces="$(printf '%s\n' "$surface_list" | wc -l | tr -d ' ')"
fi

# --- Measure ---
if ! branch_size_classified "$worktree" "$SCRIPT_DIR/resolve-base-branch" HEAD "$render_roots"; then
  die "$BRANCH_GROWTH_ERROR"
fi
production_lines="$BRANCH_SIZE_PRODUCTION"
test_lines="$BRANCH_SIZE_TEST"
mirror_lines="$BRANCH_SIZE_MIRROR"

# --- The production allowance ---
baseline="$("$SCRIPT_DIR/workflow-state" get "$issue" '.pr.baseline_lines // "null"' 2>/dev/null || true)"
[[ "$baseline" =~ ^[1-9][0-9]*$ ]] || baseline=""

allowance=""
allowance_source=""
if [[ -n "$stated_lines" ]]; then
  allowance="$stated_lines"
  allowance_source="stated-delta"
elif [[ -n "$est_allowance" ]]; then
  allowance="$est_allowance"
  allowance_source="est-$issue_estimate"
elif [[ -n "$baseline" ]]; then
  # The baseline is what the branch measured, not what the issue expected, so
  # it keeps the headroom the fix-round tripwire gives it.
  allowance=$(( baseline * 2 ))
  allowance_source="baseline-lines"
else
  die "no production allowance for '$issue': the issue states no expected delta and workflow state pr.baseline_lines is missing or invalid (${issue_source:-issue unread})"
fi

# --- The test allowance ---
# With no Done-when surfaces there is no allowance to build, so the test lines
# are scored where they were scored before this check existed: inside the
# production total.
test_allowance=""
test_reason=""
if (( surfaces > 0 )); then
  test_allowance=$(( surfaces * 2 * lines_per_control ))
else
  test_reason="no Done-when surfaces read from ${issue_source:-the issue}; test lines scored as production"
  production_lines=$(( production_lines + test_lines ))
  test_lines=0
fi

verdict="pass"
reason=""
if (( production_lines > allowance )); then
  verdict="production_over"
  reason="production diffstat is $production_lines lines; the allowance is $allowance lines (from $allowance_source)"
elif [[ -n "$test_allowance" ]] && (( test_lines > test_allowance )); then
  verdict="tests_over"
  reason="test diffstat is $test_lines lines; the allowance is $test_allowance lines ($surfaces Done-when surfaces, one control plus its must-fail control each, $lines_per_control lines a control)"
fi

record="$(jq -n \
  --argjson production "$production_lines" \
  --argjson tests "$test_lines" \
  --argjson mirror "$mirror_lines" \
  --argjson allowance "$allowance" \
  --arg allowance_source "$allowance_source" \
  --argjson surfaces "$surfaces" \
  --argjson test_allowance "${test_allowance:-null}" \
  --arg verdict "$verdict" \
  --arg reason "${reason:-$test_reason}" \
  '{production_lines: $production, test_lines: $tests, mirror_lines: $mirror,
    production_allowance: $allowance, allowance_source: $allowance_source,
    surfaces: $surfaces, test_allowance: $test_allowance,
    verdict: $verdict, reason: $reason}')"

"$SCRIPT_DIR/workflow-state" update "$issue" \
  --argjson size_check "$record" '.pr.size_check = $size_check' >/dev/null \
  || die "the size-check verdict for '$issue' could not be recorded in workflow state"

[[ "$as_json" != "true" ]] || printf '%s\n' "$record"

if [[ "$verdict" == "pass" ]]; then
  [[ "$as_json" == "true" ]] || printf '%s: production %s of %s lines (%s); tests %s of %s lines; render mirror %s lines excluded\n' \
    "$PROG" "$production_lines" "$allowance" "$allowance_source" \
    "$test_lines" "${test_allowance:-n/a}" "$mirror_lines"
  exit 0
fi

refuse "$reason; cut the branch back to the Done-when before pushing"
if [[ -n "$surface_list" ]]; then
  printf 'Done-when surfaces:\n' >&2
  printf '%s\n' "$surface_list" | sed 's/^/  - /' >&2
fi
exit 3
