#!/usr/bin/env bash
# Close a Linear container once its children have finished, one caller at a time.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: container-close <REPOSITORY_CHECKOUT> <PARENT_ID>

Derives the shared main repository and serializes closure per Linear container.
Prints `closed <PARENT_ID>` when the container is Done, including an idempotent
repeat.
Prints `deferred` followed by pending child ids when closure must wait. A bare
`deferred` means the 120-second lock wait expired. Operational and validation
failures exit 1. A successful `closed` result may carry recovery diagnostics on
stderr; callers must preserve every one.
EOF
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac
[[ $# -eq 2 && -n "$1" && -n "$2" ]] || { usage >&2; exit 2; }

SCRIPT_DIR="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LINEAR="$SCRIPT_DIR/../../linear/scripts/linear.sh"
GIT_CONTEXT="$SCRIPT_DIR/git-context"
[[ -x "$LINEAR" ]] || { echo "container-close: Linear CLI is missing or not executable: $LINEAR" >&2; exit 1; }
[[ -x "$GIT_CONTEXT" ]] || { echo "container-close: git-context is missing or not executable: $GIT_CONTEXT" >&2; exit 1; }
command -v flock >/dev/null 2>&1 || { echo "container-close: flock is required" >&2; exit 1; }
command -v gh >/dev/null 2>&1 || { echo "container-close: gh is required to preserve child PR references" >&2; exit 1; }

REPOSITORY_CHECKOUT="$(cd -- "$1" 2>/dev/null && pwd -P)" \
  || { echo "container-close: repository checkout is not a directory: $1" >&2; exit 1; }
MAIN_REPO_ROOT="$("$GIT_CONTEXT" common-root "$REPOSITORY_CHECKOUT")" \
  || { echo "container-close: cannot resolve the shared repository root from $REPOSITORY_CHECKOUT" >&2; exit 1; }
MAIN_REPO_ROOT="$(cd -- "$MAIN_REPO_ROOT" 2>/dev/null && pwd -P)" \
  || { echo "container-close: shared repository root is not a directory: $MAIN_REPO_ROOT" >&2; exit 1; }
git -C "$MAIN_REPO_ROOT" rev-parse --is-inside-work-tree >/dev/null 2>&1 \
  || { echo "container-close: shared repository root is not a git work tree: $MAIN_REPO_ROOT" >&2; exit 1; }
PARENT_ID="$2"
[[ "$PARENT_ID" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ && "$PARENT_ID" != *..* ]] \
  || { echo "container-close: invalid parent id: $PARENT_ID" >&2; exit 2; }

mkdir -p "$MAIN_REPO_ROOT/tmp"
LOCK_FILE="$MAIN_REPO_ROOT/tmp/container-close-$PARENT_ID.lock"
umask 077
exec 9>>"$LOCK_FILE"
LOCK_WAIT_SECONDS=120
if ! flock -w "$LOCK_WAIT_SECONDS" 9; then
  printf 'deferred\n'
  exit 0
fi

RECOVERY_DIR="$MAIN_REPO_ROOT/tmp/container-close-recovery"
if [[ -L "$RECOVERY_DIR" || ( -e "$RECOVERY_DIR" && ! -d "$RECOVERY_DIR" ) ]]; then
  echo "container-close: recovery path is not a directory: $RECOVERY_DIR" >&2
  exit 1
fi
mkdir -p "$RECOVERY_DIR"
[[ -O "$RECOVERY_DIR" ]] \
  || { echo "container-close: recovery directory is not owned by this user: $RECOVERY_DIR" >&2; exit 1; }
chmod 700 "$RECOVERY_DIR"
RECOVERY="$RECOVERY_DIR/$PARENT_ID.tsv"
if [[ -L "$RECOVERY" || ( -e "$RECOVERY" && ( ! -f "$RECOVERY" || ! -O "$RECOVERY" ) ) ]]; then
  echo "container-close: recovery record is not an owned regular file: $RECOVERY" >&2
  exit 1
fi

recovery_conflict() {
  echo "container-close: recovery conflict for $PARENT_ID: $1; reconcile Linear state, then remove $RECOVERY only if no cascade repair remains" >&2
  return 1
}

RUN_DIR="$(mktemp -d "$MAIN_REPO_ROOT/tmp/container-close-$PARENT_ID.XXXXXX")" \
  || { echo "container-close: cannot create private run directory" >&2; exit 1; }
chmod 700 "$RUN_DIR"
SNAPSHOT="$RUN_DIR/canceled.tsv"
CURRENT="$RUN_DIR/current.jsonl"
SUMMARY="$RUN_DIR/summary.md"
CHILD_ROWS="$RUN_DIR/children.tsv"

cleanup() {
  rm -f -- "$SNAPSHOT" "$CURRENT" "$SUMMARY" "$CHILD_ROWS"
  rmdir -- "$RUN_DIR" 2>/dev/null || true
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM HUP

sync_linear() { "$LINEAR" sync --reconcile >/dev/null; }
parent_json() { "$LINEAR" cache issues get "$PARENT_ID"; }

load_recovery_rows() {
  local source="$1" line id rest state depth
  ids=()
  states=()
  depths=()
  while IFS= read -r line || [[ -n "$line" ]]; do
    id="${line%%$'\t'*}"
    rest="${line#*$'\t'}"
    [[ "$rest" != "$line" && "$rest" == *$'\t'* ]] || rest+=$'\t'
    state="${rest%%$'\t'*}"
    depth="${rest#*$'\t'}"
    [[ -n "$id" ]] || { echo "container-close: recovery record has a row without a child id for $PARENT_ID" >&2; return 1; }
    [[ -n "$state" ]] || { echo "container-close: recovery record for $id has no state" >&2; return 1; }
    [[ "$depth" =~ ^[0-9]+$ ]] \
      || { echo "container-close: recovery record for $id has invalid depth: $depth" >&2; return 1; }
    ids+=("$id")
    states+=("$state")
    depths+=("$depth")
  done < "$source"
}

fetch_recovery_rows() {
  local id batch=() batch_json
  : > "$CURRENT"
  for id in ${ids[@]+"${ids[@]}"}; do
    batch+=("$id")
    if [[ ${#batch[@]} -eq 50 ]]; then
      batch_json="$("$LINEAR" issues bulk-get ${batch[@]+"${batch[@]}"})" \
        || { echo "container-close: canceled-child repair lookup failed for $PARENT_ID" >&2; return 1; }
      jq -c '.[]' <<<"$batch_json" >> "$CURRENT" \
        || { echo "container-close: canceled-child repair lookup returned invalid JSON for $PARENT_ID" >&2; return 1; }
      batch=()
    fi
  done
  if [[ ${#batch[@]} -gt 0 ]]; then
    batch_json="$("$LINEAR" issues bulk-get ${batch[@]+"${batch[@]}"})" \
      || { echo "container-close: canceled-child repair lookup failed for $PARENT_ID" >&2; return 1; }
    jq -c '.[]' <<<"$batch_json" >> "$CURRENT" \
      || { echo "container-close: canceled-child repair lookup returned invalid JSON for $PARENT_ID" >&2; return 1; }
  fi
  [[ "$(wc -l < "$CURRENT" | tr -d ' ')" -eq ${#ids[@]} ]] \
    || { echo "container-close: canceled-child repair lookup was incomplete for $PARENT_ID" >&2; return 1; }
}

publish_recovery() {
  [[ -s "$SNAPSHOT" || -s "$RECOVERY" ]] || return 0
  local recovery_tmp
  ids=(); states=(); depths=()
  load_recovery_rows "$SNAPSHOT" || return 1
  if [[ -e "$RECOVERY" || -L "$RECOVERY" ]]; then
    [[ -f "$RECOVERY" && ! -L "$RECOVERY" && -O "$RECOVERY" ]] \
      || { echo "container-close: recovery record is not an owned regular file: $RECOVERY" >&2; return 1; }
    load_recovery_rows "$RECOVERY" || return 1
  fi
  recovery_tmp="$(mktemp "$RECOVERY_DIR/$PARENT_ID.XXXXXX")" \
    || { echo "container-close: cannot create recovery record for $PARENT_ID" >&2; return 1; }
  if [[ -s "$RECOVERY" ]]; then
    awk -F '\t' 'BEGIN { OFS="\t" }
      NF != 3 || $1 == "" || $2 == "" || $3 !~ /^[0-9]+$/ { bad=1; exit }
      !($1 in states) { states[$1]=$2; depths[$1]=$3; order[++count]=$1; next }
      states[$1] != $2 || depths[$1] != $3 { bad=1; exit }
      END {
        if (bad) exit 2
        for (i=1; i<=count; i++) for (j=i+1; j<=count; j++)
          if (depths[order[j]] > depths[order[i]]) { swap=order[i]; order[i]=order[j]; order[j]=swap }
        for (i=1; i<=count; i++) print order[i], states[order[i]], depths[order[i]]
      }
    ' "$RECOVERY" "$SNAPSHOT" > "$recovery_tmp" || {
      rm -f -- "$recovery_tmp"
      recovery_conflict "durable and fresh rows disagree"
      return $?
    }
  elif ! cp "$SNAPSHOT" "$recovery_tmp"; then
    rm -f -- "$recovery_tmp"
    echo "container-close: cannot copy recovery record for $PARENT_ID" >&2
    return 1
  fi
  ids=(); states=(); depths=()
  load_recovery_rows "$recovery_tmp" || { rm -f -- "$recovery_tmp"; return 1; }
  if ! chmod 600 "$recovery_tmp" || ! mv -f "$recovery_tmp" "$RECOVERY"; then
    rm -f -- "$recovery_tmp"
    echo "container-close: cannot publish recovery record for $PARENT_ID" >&2
    return 1
  fi
}

repair_canceled() {
  [[ -e "$RECOVERY" || -L "$RECOVERY" ]] || return 0
  [[ -f "$RECOVERY" && ! -L "$RECOVERY" && -O "$RECOVERY" ]] \
    || { echo "container-close: recovery record is not an owned regular file: $RECOVERY" >&2; return 1; }
  local ids=() states=() depths=() id state current_state current_type index matches
  load_recovery_rows "$RECOVERY" || return 1
  [[ ${#ids[@]} -gt 0 ]] || { echo "container-close: recovery record is empty for $PARENT_ID" >&2; return 1; }
  fetch_recovery_rows || return 1
  for ((index=0; index<${#ids[@]}; index++)); do
    id="${ids[$index]}"; state="${states[$index]}"
    matches="$(jq -r --arg id "$id" 'select(.id == $id) | .id' "$CURRENT" | wc -l | tr -d ' ')" \
      || { echo "container-close: canceled-child repair could not inspect $id" >&2; return 1; }
    [[ "$matches" -eq 1 ]] || { echo "container-close: canceled-child repair did not return exactly one row for $id" >&2; return 1; }
    current_state="$(jq -r --arg id "$id" 'select(.id == $id) | .state // ""' "$CURRENT")" \
      || { echo "container-close: canceled-child repair could not read the state for $id" >&2; return 1; }
    [[ "$current_state" == "$state" ]] && continue
    current_type="$(jq -r --arg id "$id" 'select(.id == $id) | .state_type // ""' "$CURRENT")" \
      || { echo "container-close: canceled-child repair could not read the state type for $id" >&2; return 1; }
    [[ "$current_type" == "completed" ]] \
      || { echo "container-close: canceled-child repair found unexpected state for $id: $current_state" >&2; return 1; }
    "$LINEAR" issues update "$id" --state "$state" >/dev/null \
      || { echo "container-close: could not restore $id to $state" >&2; return 1; }
    printf 'container-close: restored %s to %s\n' "$id" "$state" >&2
  done
  fetch_recovery_rows || return 1
  for ((index=0; index<${#ids[@]}; index++)); do
    id="${ids[$index]}"; state="${states[$index]}"
    matches="$(jq -r --arg id "$id" --arg state "$state" \
      'select(.id == $id and .state == $state) | .id' "$CURRENT" | wc -l | tr -d ' ')" \
      || { echo "container-close: canceled-child repair could not verify $id" >&2; return 1; }
    [[ "$matches" -eq 1 ]] || { echo "container-close: canceled-child repair could not verify $id at $state" >&2; return 1; }
  done
  rm -f -- "$RECOVERY" || { echo "container-close: cannot remove verified recovery record for $PARENT_ID" >&2; return 1; }
}

check_open_recovery() {
  [[ -e "$RECOVERY" || -L "$RECOVERY" ]] || return 0
  [[ -f "$RECOVERY" && ! -L "$RECOVERY" && -O "$RECOVERY" ]] \
    || { echo "container-close: recovery record is not an owned regular file: $RECOVERY" >&2; return 1; }
  local ids=() states=() depths=() id state current_state index
  load_recovery_rows "$RECOVERY" || return 1
  [[ ${#ids[@]} -gt 0 ]] || { echo "container-close: recovery record is empty for $PARENT_ID" >&2; return 1; }
  fetch_recovery_rows || return 1
  for ((index=0; index<${#ids[@]}; index++)); do
    id="${ids[$index]}"; state="${states[$index]}"
    current_state="$(jq -r --arg id "$id" 'select(.id == $id) | .state // ""' "$CURRENT")" \
      || { echo "container-close: open-parent recovery could not read the state for $id" >&2; return 1; }
    [[ "$current_state" == "$state" ]] \
      || {
        recovery_conflict "parent is open and child $id moved from $state to $current_state"
        return $?
      }
  done
}

child_pr() {
  local child_id="$1" rows number
  rows="$(cd -- "$MAIN_REPO_ROOT" && env -u GH_REPO -u GITHUB_REPOSITORY \
    gh pr list --state merged --search "$child_id" --limit 100 \
      --json number,headRefName,mergedAt,isCrossRepository)" \
    || { echo "container-close: cannot resolve PR for $child_id" >&2; return 1; }
  number="$(jq -r --arg id "$child_id" '
    ($id | ascii_downcase) as $needle |
    [.[] | select(.isCrossRepository != true) |
      select((.headRefName | ascii_downcase | split("/") | last) as $branch |
        $branch == $needle or ($branch | startswith($needle + "-")) or ($branch | startswith($needle + "_")))] |
    sort_by(.mergedAt) | last | .number // empty
  ' <<<"$rows")" || { echo "container-close: invalid PR response for $child_id" >&2; return 1; }
  [[ -n "$number" ]] && printf '#%s\n' "$number" || printf 'unavailable\n'
}

sync_linear || { echo "container-close: Linear sync failed for $PARENT_ID" >&2; exit 1; }
PARENT="$(parent_json)" || { echo "container-close: cannot read parent $PARENT_ID" >&2; exit 1; }
PARENT_TYPE="$(jq -r '.state_type // ""' <<<"$PARENT")" \
  || { echo "container-close: parent response is invalid for $PARENT_ID" >&2; exit 1; }
if [[ "$PARENT_TYPE" == "completed" ]]; then
  repair_canceled; printf 'closed %s\n' "$PARENT_ID"; exit 0
fi
check_open_recovery

PENDING=""
for _attempt in 1 2 3; do
  PENDING="$("$LINEAR" cache issues children "$PARENT_ID" --recursive --pending --format=ids)" \
    || { echo "container-close: cannot read pending children for $PARENT_ID" >&2; exit 1; }
  [[ -z "$PENDING" ]] && break
  [[ $_attempt -eq 3 ]] || sync_linear || { echo "container-close: Linear sync failed for $PARENT_ID" >&2; exit 1; }
done
if [[ -n "$PENDING" ]]; then
  printf 'deferred'
  while IFS= read -r id; do [[ -z "$id" ]] || printf ' %s' "$id"; done <<<"$PENDING"
  printf '\n'; exit 0
fi

CHILDREN="$("$LINEAR" cache issues children "$PARENT_ID" --recursive)" \
  || { echo "container-close: cannot read children for $PARENT_ID" >&2; exit 1; }
jq -r '[.[] | select(.state_type == "canceled")] | sort_by(.depth) | reverse[] | [.id, .state, .depth] | @tsv' \
  <<<"$CHILDREN" > "$SNAPSHOT" || { echo "container-close: child response is invalid for $PARENT_ID" >&2; exit 1; }
ids=(); states=(); depths=(); load_recovery_rows "$SNAPSHOT"
VALIDATION="$("$LINEAR" issues validate-completion "$PARENT_ID" --include-children-of "$PARENT_ID" --container)" \
  || { echo "container-close: completion validation failed for $PARENT_ID" >&2; exit 1; }
ALL_OK="$(jq -r '.all_ok // false' <<<"$VALIDATION")" \
  || { echo "container-close: completion validation returned invalid JSON for $PARENT_ID" >&2; exit 1; }
if [[ "$ALL_OK" != "true" ]]; then
  jq -c '.results[] | select(.ok != true)' <<<"$VALIDATION" >&2 \
    || { echo "container-close: completion validation returned invalid results for $PARENT_ID" >&2; exit 1; }
  echo "container-close: completion validation refused $PARENT_ID" >&2; exit 1
fi
VALIDATED_PARENT_TYPE="$(jq -r --arg id "$PARENT_ID" \
  '.results[] | select(.id == $id) | .state_type // ""' <<<"$VALIDATION")" \
  || { echo "container-close: completion validation returned invalid results for $PARENT_ID" >&2; exit 1; }
if [[ "$VALIDATED_PARENT_TYPE" == "completed" ]]; then
  publish_recovery; repair_canceled; printf 'closed %s\n' "$PARENT_ID"; exit 0
fi

jq -r '.[] | [.id, .title, .state_type] | @tsv' <<<"$CHILDREN" > "$CHILD_ROWS" \
  || { echo "container-close: cannot build child summary rows for $PARENT_ID" >&2; exit 1; }
printf '## Bundle Complete\n\n' > "$SUMMARY"
while IFS=$'\t' read -r id title state_type; do
  case "$state_type" in
    completed) MARKER="✓" ;;
    canceled) MARKER="canceled" ;;
    *) echo "container-close: child $id has unexpected summary state: $state_type" >&2; exit 1 ;;
  esac
  PR_REFERENCE="$(child_pr "$id")" || exit 1
  printf -- '- %s %s %s — PR %s\n' "$id" "$MARKER" "$title" "$PR_REFERENCE" >> "$SUMMARY"
done < "$CHILD_ROWS"
publish_recovery

COMPLETE_RC=0
"$LINEAR" issues complete "$PARENT_ID" --summary-file "$SUMMARY" >/dev/null || COMPLETE_RC=$?
if [[ $COMPLETE_RC -ne 0 ]]; then
  for _attempt in 1 2 3; do
    sync_linear || { echo "container-close: Linear sync failed after completion failure for $PARENT_ID" >&2; exit 1; }
    PARENT="$(parent_json)" || { echo "container-close: cannot read parent $PARENT_ID after completion failure" >&2; exit 1; }
    PARENT_TYPE="$(jq -r '.state_type // ""' <<<"$PARENT")" \
      || { echo "container-close: parent response is invalid for $PARENT_ID after completion failure" >&2; exit 1; }
    [[ "$PARENT_TYPE" == "completed" ]] && break
  done
  [[ "$PARENT_TYPE" == "completed" ]] || { echo "container-close: completion failed for $PARENT_ID" >&2; exit 1; }
  echo "container-close: completion command failed after $PARENT_ID reached Done" >&2
fi
repair_canceled
printf 'closed %s\n' "$PARENT_ID"
