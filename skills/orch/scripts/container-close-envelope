#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: container-close-envelope write <resolved|unresolved> <BODY> <ENVELOPE>" >&2
  echo "       container-close-envelope validate <ENVELOPE> <BODY_OUT>" >&2
  exit 2
}

validate_body() {
  local status="$1" body="$2"
  [[ -s "$body" ]] || return 1
  case "$status" in
    resolved)
      awk -F '\t' 'NF != 3 || $1 == "" || $2 == "" || $3 !~ /^[0-9]+$/ { exit 1 }' "$body"
      ;;
    unresolved)
      awk -F '\t' 'NF != 4 || $1 == "" || $2 == "" || $3 !~ /^[0-9]+$/ || ($4 != "durable" && $4 != "fresh") { exit 1 }' "$body"
      ;;
    *) return 1 ;;
  esac
}

[[ $# -ge 1 ]] || usage
command="$1"
shift
case "$command" in
  write)
    [[ $# -eq 3 ]] || usage
    status="$1" body="$2" envelope="$3"
    validate_body "$status" "$body" || { echo "container-close-envelope: invalid $status body" >&2; exit 1; }
    count="$(wc -l < "$body" | tr -d ' ')"
    digest="$(git hash-object --stdin < "$body")" \
      || { echo "container-close-envelope: cannot hash body" >&2; exit 1; }
    { printf '%s\n' "$status"; cat "$body"; printf 'complete\t%s\t%s\n' "$count" "$digest"; } > "$envelope" \
      || { echo "container-close-envelope: cannot write envelope" >&2; exit 1; }
    chmod 600 "$envelope"
    ;;
  validate)
    [[ $# -eq 2 ]] || usage
    envelope="$1" body="$2"
    [[ -s "$envelope" ]] || { echo "container-close-envelope: envelope is empty" >&2; exit 1; }
    status="$(sed -n '1p' "$envelope")" \
      || { echo "container-close-envelope: cannot read status" >&2; exit 1; }
    [[ "$status" == resolved || "$status" == unresolved ]] || { echo "container-close-envelope: invalid status: $status" >&2; exit 1; }
    trailer="$(sed -n '$p' "$envelope")" \
      || { echo "container-close-envelope: cannot read trailer" >&2; exit 1; }
    IFS=$'\t' read -r marker declared_count declared_digest extra <<< "$trailer"
    [[ "$marker" == complete && "$declared_count" =~ ^[0-9]+$ && -n "$declared_digest" && -z "$extra" ]] \
      || { echo "container-close-envelope: invalid completion trailer" >&2; exit 1; }
    sed '1d;$d' "$envelope" > "$body" \
      || { echo "container-close-envelope: cannot read body" >&2; exit 1; }
    schema_status=resolved
    [[ "$status" == resolved ]] || schema_status=unresolved
    validate_body "$schema_status" "$body" || { echo "container-close-envelope: invalid $status body" >&2; exit 1; }
    actual_count="$(wc -l < "$body" | tr -d ' ')"
    [[ "$actual_count" == "$declared_count" ]] \
      || { echo "container-close-envelope: row count mismatch" >&2; exit 1; }
    actual_digest="$(git hash-object --stdin < "$body")" \
      || { echo "container-close-envelope: cannot hash body" >&2; exit 1; }
    [[ "$actual_digest" == "$declared_digest" ]] \
      || { echo "container-close-envelope: digest mismatch" >&2; exit 1; }
    printf '%s\n' "$status"
    ;;
  *) usage ;;
esac
