#!/usr/bin/env bash
# Bounded current-head wait before orch reads findings or seeks approval.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR
if [[ "${1:-}" == --help ]]; then
  cat <<'HELP'
Usage: copilot-wait PR_NUMBER [--item ITEM]
Wait for Copilot work on the live head through Waiter launch.
ORCH_COPILOT_HOLD_SECS sets the total bound (default 600 seconds).
Poll every 10 seconds. A moved head is read again within the same bound.
Output: one copilot-wait: result line with state=none, settled, or expired,
head, review id (none when the check ended without a review), run id,
started_at and waited seconds. Workflow routing consumes these fields.
A run field other than none identifies a check or pending timeline request.
Timeline requests and work starts remain pending until a later Copilot
review or request removal. Queued or in-progress checks on the current
head take precedence.
Exit 0: none or settled. Exit 1: expired or a keyed read refusal.
Exit 2: invalid arguments or setting. Exit 3: unavailable GitHub auth.
Exit 5: lane mail arrived or was unreadable; no result. Read the inbox,
act on the mail, and launch a fresh wait through Waiter launch.
HELP
  exit 0
fi
PR_NUM="${1:-}"
[[ "$PR_NUM" =~ ^[1-9][0-9]*$ ]] || { printf 'copilot-wait: invalid-pr value=%q\n' "$PR_NUM" >&2; exit 2; }
shift
ITEM=""
if [[ "${1:-}" == --item && -n "${2:-}" ]]; then ITEM="$2"; shift 2; fi
[[ "$#" -eq 0 ]] || { printf 'copilot-wait: invalid-arguments pr=%s\n' "$PR_NUM" >&2; exit 2; }
source "$SCRIPT_DIR/lib/gh-auth.sh"
source "$SCRIPT_DIR/lib/gh-repo.sh"
source "$SCRIPT_DIR/lib/copilot-check-runs.sh"
source "$SCRIPT_DIR/lib/lane-mail-nap.sh"
PROJECT_ROOT="$(git rev-parse --show-toplevel)"
SCRATCH=$(mktemp -d 2>&1) || {
  printf 'copilot-wait: scratch pr=%s\n%s\n' "$PR_NUM" "$SCRATCH" >&2
  exit 1
}
trap 'rm -rf -- "${SCRATCH:?}"' EXIT
ERR_FILE="$SCRATCH/err"
AUTH_ERR_FILE="$SCRATCH/auth-err"
if [[ -z "${GH_TOKEN:-}${GITHUB_TOKEN:-}" ]]; then orch_load_env_bot_token "$PROJECT_ROOT" 2>"$AUTH_ERR_FILE" || true; fi
orch_sanitize_gh_env 2>>"$AUTH_ERR_FILE" || true
if ! orch_github_auth_status 2>>"$AUTH_ERR_FILE"; then
  printf 'copilot-wait: auth-unavailable pr=%s\n' "$PR_NUM" >&2
  cat -- "$AUTH_ERR_FILE" >&2
  exit 3
fi
REPO="$(orch_resolve_gh_repo "$PROJECT_ROOT")" || exit 1
BOUND="$("$SCRIPT_DIR/orch-env" ORCH_COPILOT_HOLD_SECS 600)" || exit 2
[[ "$BOUND" =~ ^[1-9][0-9]*$ ]] || { printf 'copilot-wait: invalid-bound value=%q\n' "$BOUND" >&2; exit 2; }
lane_mail_resolve copilot-wait "$ITEM"
start="$(date +%s)"
held_head="" run=none started_at=none
refuse() {
  printf 'copilot-wait: read-failed operation=%s pr=%s repo=%s head=%s\n' "$1" "$PR_NUM" "$REPO" "${head:-unreadable}" >&2
  cat -- "$AUTH_ERR_FILE" >&2
  cat -- "$ERR_FILE" >&2
  exit 1
}
read_review() { # START_TIME_OR_EMPTY
  local reviews
  reviews=$(gh api "repos/$REPO/pulls/$PR_NUM/reviews?per_page=100" --paginate --slurp) || return $?
  jq -er --arg head "$head" --arg since "$1" '
    if type != "array" or length == 0 or any(.[]; type != "array")
    then error("review pages are unreadable") else add end |
    [.[] | select((.user.login == "copilot-pull-request-reviewer[bot]" or .user.login == "Copilot") and .commit_id == $head
      and (.state == "APPROVED" or .state == "COMMENTED" or .state == "CHANGES_REQUESTED")
      and ($since == "" or ((.submitted_at | type) == "string" and .submitted_at >= $since)))] |
    if length == 0 then "none" else last |
      if (.id | type) != "number" or .id <= 0 or (.id | floor) != .id
      then error("review identity is unreadable") else .id | tostring end end' <<<"$reviews"
}
while :; do
  head="$(gh pr view "$PR_NUM" --repo "$REPO" --json headRefOid --jq .headRefOid 2>"$ERR_FILE")" || refuse head
  [[ "$head" =~ ^[0-9a-f]{40}$ ]] || refuse head
  if [[ "$head" != "$held_head" ]]; then run=none; started_at=none; held_head="$head"; fi
  runs="$(orch_copilot_check_runs "$REPO" "$head" "$PR_NUM" 2>"$ERR_FILE")" || refuse copilot
  waited=$(( $(date +%s) - start ))
  if [[ "$runs" == '[]' ]]; then
    state=none review=none
    if [[ "$run" != none ]]; then
      review=$(read_review '' 2>"$ERR_FILE") || refuse reviews
      state=settled
    fi
    confirmed=$(gh pr view "$PR_NUM" --repo "$REPO" --json headRefOid --jq .headRefOid 2>"$ERR_FILE") || refuse head
    [[ "$confirmed" =~ ^[0-9a-f]{40}$ ]] || refuse head
    if [[ "$confirmed" != "$head" ]]; then
      if [[ "$waited" -ge "$BOUND" ]]; then state=expired; head="$confirmed"; run=none; started_at=none; review=none; break; fi
      continue
    fi
    break
  fi
  run=$(jq -r '.[0].id' <<<"$runs" 2>"$ERR_FILE") || refuse copilot
  started_at=$(jq -r '.[0].started_at // "none"' <<<"$runs" 2>"$ERR_FILE") || refuse copilot
  # GitHub can publish the submitted review before its check becomes completed.
  # An older review on a re-requested head does not settle that new request.
  if [[ "$started_at" != none ]]; then
    review=$(read_review "$started_at" 2>"$ERR_FILE") || refuse reviews
    if [[ "$review" != none ]]; then
      confirmed=$(gh pr view "$PR_NUM" --repo "$REPO" --json headRefOid --jq .headRefOid 2>"$ERR_FILE") || refuse head
      if [[ "$confirmed" == "$head" ]]; then state=settled; break; fi
    fi
  fi
  if [[ "$waited" -ge "$BOUND" ]]; then state=expired; review=none; break; fi
  nap=$((BOUND - waited))
  [[ "$nap" -le 10 ]] || nap=10
  lane_mail_nap "$nap"
done
cat -- "$AUTH_ERR_FILE" >&2
printf 'copilot-wait: result state=%s pr=%s repo=%s head=%s review=%s run=%s started_at=%s waited=%s\n' \
  "$state" "$PR_NUM" "$REPO" "$head" "$review" "$run" "$started_at" "$waited"
[[ "$state" != expired ]]
