#!/usr/bin/env bash
# dev-return-write — deterministically write a dev agent's on-disk completion
# artifact that orch reads to accept a dev/QA completion without depending on the
# live return message.
#
# The dev agent runs THIS one command instead of hand-authoring the JSON, so the
# receipt is always well-formed and complete — it eliminates the truncated /
# missing-field / malformed-JSON class entirely. It is a sanctioned single-command
# invocation (harness-safe: the agent runs one command with explicit arguments, no
# shell redirection in the agent's own command; the write to disk is internal to
# this script and atomic — temp file + mv).
#
# The artifact is bound to its delegation by a per-round token: the file is named
# [WORKTREE]/tmp/dev-return-[ISSUE_ID]-[ROUND_ID].json AND carries "round_id":
# ROUND_ID inside. dev-artifact-check resolves that exact path and rejects any
# receipt whose internal round_id differs. The token proves WHICH delegation
# wrote the bytes; mtime proves only WHEN they were written.
#
# Usage:
#   dev-return-write --worktree PATH --kind implement|fix --issue ID --round-id RID \
#     --branch BRANCH --commit SHA --validate STR [--validate-note TEXT] \
#     [--validate-run-dir RUN_DIR | --validate-record FILE] [--qa-label LABEL]... \
#     [--near-ceiling-base REF] [--label LABEL... | --no-labels] [--bundled] [--no-summary] \
#     [--summary TEXT | --summary-file PATH | --recovered-text PATH] \
#     [--item N DECISION REASONING]...
#
# near_ceiling carries one byte-ceiling near-ceiling line per binary blob within
# reach of the byte ceiling, as that lane reports the branch at artifact time,
# so the next round can plan Git LFS, an asset store or generation before
# the blob grows further. --near-ceiling-base REF is the field's one producer: this
# writer runs the worktree's installed lane with --base REF and keeps every
# stdout line beginning "byte-ceiling: near-ceiling=" on exit 0 or 1 (exit 1
# only adds a file already over the ceiling). A repository with nothing at the
# lane path has no byte ceiling and so no file near one: []. A round that did
# not probe (no --near-ceiling-base), a broken link on the way to the lane, a
# lane that is not executable, or a lane that exits otherwise records
# near_ceiling: null and the cause in near_ceiling_error: an empty list would
# claim nothing is near the wall, and the orchestrator replaces its carried list
# with whatever it reads.
#
# --validate stays strictly enumerated ("pass", "no-verdict" or "FAILING:…") so
# it remains machine-checkable. --validate-note is the additive channel for a QUALIFIED
# result the enumeration cannot express — a lane that passed only on re-run, a
# flake that had to be investigated, a caveat worth carrying.
# Without it the caveat is lost from the record orch treats as authoritative,
# surviving only if the agent happens to mention it conversationally.
#
# --validate-run-dir is the run directory the round's dev-validate-run printed.
# `dev-validate-run --record` owns that directory's format and answers for it:
# validate_mode is its mode, never typed by the agent, and a --validate pass
# needs a run whose sentinel is guard-exit=0. no-verdict needs a run the bound
# ended, whose record is verdict=no-verdict: that run was cut off, not refuted,
# so it is neither a pass nor a failure, and the scoped suites the round ran in
# its place are its evidence, named in --validate-note, which it requires. A FAILING result is accepted beside
# any run: --validate judges every gate of the round, and a passing run
# with another gate failing is still a failed round. Submit reuses only a full
# pass with no validate_class_base or with validate_selection battery, so a
# range pass recorded as full, a full pass whose class --record reads from a
# round base recorded without it, or a failed run recorded as a pass, would
# stand in for the whole battery.
# validate_class_base is that base, present only where --record reports one.
# A pass or no-verdict requires the
# run, or the record below. A failing round may omit both, because dev-validate-run refuses some
# failures, an empty DEV_VALIDATE_CMD among them, before any run directory
# exists; validate_mode is then null. validate_time is the run's wall time as
# --record reports it, a no-verdict run's included, and null where no run is
# named or the run is unfinished. validate_lanes and validate_selection carry
# the command's report as --record reads it; schemas/dev-return.md names them.
#
# --validate-record FILE stands in for --validate-run-dir where the project's
# own policy runs its validation entry point in the foreground and forbids
# dev-validate-run. FILE is that run's record, whose grammar --help gives:
# the mode, the HEAD the run started at, its UTC start and end, its exit
# status and its lane selection. The writer reads it into the same fields a
# run directory fills and takes from it only what it states: the epoch start,
# the wall time and the verdict, pass for exit 0 and FAILING for any other,
# are derived here. A record states no timeout, so it never carries a
# no-verdict. Every check below, the fix-round binding included, judges both
# routes alike.
#
# A fix round's run is bound to its round. The round record dev-round-write
# stamped at delegation, PATH/tmp/dev-round-ID-RID.json, names the round's
# base_sha and delegated_at, and a fix receipt names a run only when the HEAD
# --record reports for it contains that base, or the run records that base as
# the one a rebase left off the branch, or the worktree-private restack map
# rewrites that base to the run's exact HEAD, and the run started no earlier
# than delegated_at. A rebase mid-round moves HEAD off the base, and the round's
# own run then records the base as orphaned. An earlier round's run, still on
# disk and in the dev agent's context, fails one or the other: the implement
# round's started before the base existed, and a fix round that committed
# nothing leaves the next round's base at the HEAD its own run started at, but
# that run started before the next round was delegated. Accepting either would
# record a pass for a commit it never judged, and submit would reuse a full one
# whose class covered the branch as the whole battery. An implement round has no round record and no binding.
#
# The Apple gate. Where the base branch holds the mac-run workflow, which
# GitHub dispatches only from there, the receipt declares the item's labels
# (--label per entry of the delegation's Labels: line, or --no-labels), and a
# round whose item carries an Apple label or whose branch changes an Apple
# path is a pass or no-verdict only beside the passing `mac run test` its
# validation ran, recorded as one --validate-note line. The trigger is stated
# here once, in the APPLE_* values below, and --help prints it;
# dev-implement.md section 5 and schemas/dev-return.md link here. A FAILING
# round needs neither: it is never accepted. Elsewhere the receipt is what it
# would be without the gate.
#
# Writes PATH/tmp/dev-return-ID-RID.json and prints its absolute path (one line).
#
# Artifact schema — canonical source of truth: skills/orch/schemas/dev-return.md
#   {
#     "schema_version": 1,                    // required, number
#     "round_id": "[ROUND_ID]",               // required, matches the filename token
#     "kind": "implement" | "fix",             // required
#     "issue": "[ISSUE_ID]",                  // required, normalized state key
#     "branch": "[BRANCH]",                   // required
#     "commit": "[HEAD_SHA_AFTER_COMMIT]",    // required
#     "baseline_lines": 138,                  // implement only; additions + deletions
#                                             // outside the render mirror, floor 1
#     "validate": "pass" | "no-verdict" | "FAILING: c1,c2", // required
#     "validate_mode": "full" | "range" | "ci" | null, // read from --validate-run-dir;
#                                             // null only for a FAILING round
#                                             // with no run
#     "validate_time": {"started_at": "…", "ended_at": "…", "seconds": 3300} | null,
#                                             // read from --validate-run-dir;
#                                             // null with no run or an
#                                             // unfinished one
#     "validate_class_base": "[SHA]",         // read from --validate-run-dir;
#                                             // present only where the run's
#                                             // class was read from a round
#                                             // base, not the base branch
#     "validate_note": "…" | null,            // --validate-note
#     "qa_labels": ["needs-review"],          // [] when no --qa-label given
#     "near_ceiling": ["…"] | null,           // byte-ceiling near-ceiling lines
#                                             // for the branch at this moment; [];
#                                             // null when the probe did not answer
#     "near_ceiling_error": "…" | null,       // why near_ceiling is null
#     "summary_posted": true,                 // false with --no-summary
#     "summary": "…" | null,                  // --summary text or --summary-file content
#     "recovered_from": "transcript" | null,  // --recovered-text
#     "bundled": false,                       // true with --bundled
#     "items": [{"n": 1, "decision": "Applied", "reasoning": "…"}]
#   }
#
# Kind rules:
#   --kind fix OR --bundled  → REQUIRES >=1 --item (a fix/bundled artifact with no
#                              items is incomplete).
#   --kind implement (single, no --bundled) → zero items allowed → writes "items": [].
#   --summary, --summary-file and --recovered-text are mutually exclusive for
#   every kind (one summary source, no silent precedence).
#   --recovered-text is the report round-recover read from a stalled agent's
#   transcript: it becomes the summary and sets recovered_from.
#   DECISION ∈ {Applied, Skipped, Blocked}; N is a non-negative integer; REASONING
#   must be non-empty.
#
# Validated on the orch side by dev-artifact-check (reasons:
# missing | invalid | incomplete). All usage/validation errors exit 2.

set -euo pipefail

PROG="dev-return-write"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/branch-growth.sh
source "$SCRIPT_DIR/lib/branch-growth.sh"
# shellcheck source=lib/rebase-map.sh
source "$SCRIPT_DIR/lib/rebase-map.sh"

# The Apple gate's trigger and its record. A changed path is Apple when one of
# its directory segments matches an APPLE_DIR_GLOBS glob, the way .gitignore
# matches a pattern with no slash, or when it is an APPLE_MANIFEST whose content
# at the commit matches APPLE_MANIFEST_PLATFORMS.
APPLE_WORKFLOW=".github/workflows/mac-run.yml"
APPLE_LABELS=(ios macos)
APPLE_DIR_GLOBS=('*.xcodeproj' '*.xcworkspace' ios macos)
APPLE_MANIFEST="Package.swift"
APPLE_MANIFEST_PLATFORMS='\.(iOS|macOS)'
MAC_RUN_PASS='^mac run test: pass run=[^[:space:]]+$'

# Path-safe token grammar for --issue / --round-id: no '/', no '..', no
# whitespace, so a value can never escape the tmp/ directory.
ID_GRAMMAR='^[A-Za-z0-9._-]+$'

# All refusals identify the reason and values before the explanation.
die() {
  local reason="$1"
  shift
  {
    printf '%s: %s' "$PROG" "$reason"
    printf ' %s' "$@"
    printf '\n'
    case "$reason" in
      missing-value) printf 'The option requires a value.\n' ;;
      flag-value) printf 'The next option cannot be used as this option value.\n' ;;
      duplicate) printf 'The option was supplied more than once.\n' ;;
      required) printf 'The required option is absent or empty.\n' ;;
      invalid-id) printf 'The ID must be safe for a file path.\n' ;;
      item-arguments) printf 'An item needs its number, decision, and reasoning.\n' ;;
      item-number) printf 'The item number must be a non-negative integer.\n' ;;
      item-decision) printf 'The decision must be Applied, Skipped, or Blocked.\n' ;;
      item-empty) printf 'The item reasoning is empty.\n' ;;
      item-flag) printf 'An option cannot be used as item reasoning.\n' ;;
      unknown-argument) printf 'The argument is not supported.\n' ;;
      not-directory) printf 'The worktree path is not a directory.\n' ;;
      invalid-kind) printf 'The kind must be implement or fix.\n' ;;
      invalid-validate) printf 'The validation result must be pass, no-verdict, or start with FAILING:.\n' ;;
      run-record-unreadable) printf 'dev-validate-run --record could not read the run; its refusal follows.\n' ;;
      validate-source-conflict) printf 'Name the run by one source: a run directory or a foreground validation record.\n' ;;
      validate-record-unreadable) printf 'The foreground validation record is not a readable file.\n' ;;
      validate-record-line) printf 'Each record line is one KEY=VALUE pair, its key one --help names, given once.\n' ;;
      validate-record-missing) printf 'The foreground validation record names no value for the field; --help lists the required fields.\n' ;;
      validate-record-value) printf 'The value does not match the grammar --help gives for the field.\n' ;;
      validate-record-lanes) printf 'lanes is required beside selection all, subset or battery and refused beside unreported, as the validation command output contract pairs them.\n' ;;
      validate-record-time) printf 'The run cannot end before it started.\n' ;;
      validate-disagrees) printf 'A pass needs a run that passed, and no-verdict a run the timeout ended; this run is neither.\n' ;;
      round-record-unreadable) printf 'A fix receipt names a run only against its round record, and this one carries no base_sha of 40 hex or no delegated_at epoch.\n' ;;
      run-headless) printf 'The run records no starting HEAD, so it cannot be bound to a round; start a new run.\n' ;;
      run-off-round) printf 'The run HEAD neither contains the round base nor equals its guarded restack mapping, and the run does not record that base as orphaned.\n' ;;
      rebase-map-unreadable) printf 'The worktree-private restack map could not be read, so the run cannot be bound through it.\n' ;;
      run-before-round) printf 'The run started before the round was delegated, so it validated an earlier round.\n' ;;
      ancestry-unreadable) printf 'Git could not compare the run HEAD with the round base.\n' ;;
      empty-text) printf 'The text must contain a non-whitespace character.\n' ;;
      summary-conflict) printf 'Supply one summary source.\n' ;;
      missing-file) printf 'The summary or recovered-text file does not exist.\n' ;;
      missing-items) printf 'A fix or bundled receipt must contain an item.\n' ;;
      baseline-read) printf '%s\n' "$BRANCH_GROWTH_ERROR" ;;
      scratch-failed) printf 'mktemp could not create the file the Apple gate lists changed paths in.\n' ;;
      labels-conflict) printf 'The item either carries the --label entries or carries no labels; supply one.\n' ;;
      apple-git-failed) printf 'The Apple gate could not read the base branch workflow or the paths the branch changes: %s\n' "${BRANCH_GROWTH_ERROR:-git failed}" ;;
      labels-undeclared) printf 'The base branch holds the mac-run workflow, so the receipt declares the item labels: one --label per entry of the delegation Labels: line, or --no-labels when it reads none.\n' ;;
      mac-run-missing) printf 'The item meets the Apple gate trigger. Run fleet-mac-run test, which fleet installs on the lane PATH, and record the run id it prints as the --validate-note line "mac run test: pass run=ID"; when it fails or is not on PATH, return --validate "FAILING: mac run test".\n' ;;
    esac
  } >&2
  exit 2
}

usage() {
  cat <<'EOF'
Usage:
  dev-return-write --worktree PATH --kind implement|fix --issue ID --round-id RID \
    --branch BRANCH --commit SHA --validate STR [--validate-note TEXT] \
    [--validate-run-dir RUN_DIR | --validate-record FILE] [--qa-label LABEL]... \
    [--near-ceiling-base REF] [--label LABEL... | --no-labels] [--bundled] [--no-summary] \
    [--summary TEXT | --summary-file PATH | --recovered-text PATH] \
    [--item N DECISION REASONING]...

Writes PATH/tmp/dev-return-ID-RID.json (atomically) and prints its absolute path.
An implement receipt carries additions plus deletions against the base branch,
with a floor of 1. The orchestrator verifies and persists the first accepted one.
--kind fix OR --bundled requires >=1 --item; DECISION is Applied|Skipped|Blocked;
REASONING must be non-empty. --validate is "pass", "no-verdict" or begins
with "FAILING:".
--validate-note carries a qualified result the enumeration cannot express.
dev-implement.md section 5 owns the permitted correction and rerun routes and
the notes they require. The note never relaxes --validate, which records the
final run's verdict.
--validate-run-dir RUN_DIR is the run directory dev-validate-run printed;
validate_mode is the mode dev-validate-run --record reports for it, full,
range or ci, and a --validate pass needs a run that passed, no-verdict a run the
timeout ended and a --validate-note naming the scoped suites that passed; a
FAILING result is accepted beside any run. A pass or no-verdict requires it,
or --validate-record below; a FAILING round with no run omits both and
records validate_mode null. validate_class_base is the round base --record
reports the run's class was read from, absent where the class covered the
branch; submit reuses only a full pass without one or with selection
battery. validate_time is
the run's wall time --record reports, a no-verdict run's included, and null
with no run or an unfinished one. With --kind fix the run must start at a HEAD
that contains the base_sha of PATH/tmp/dev-round-ID-RID.json, or record that
base as the one a rebase left off the branch, or equal that base's rewritten
SHA from the worktree-private kendex-rebase-map. The run must start no earlier
than delegated_at, so a run from an earlier round is refused.
--validate-record FILE takes the place of --validate-run-dir, never beside it,
for a project whose own policy runs its validation entry point in the
foreground and forbids dev-validate-run. FILE records that run, one KEY=VALUE
per line, each key once:
  validate-mode=full|range  the mode the run stands for, as validate_mode
  head=SHA                  the worktree HEAD the run started at, 40 hex
  started-at=TIME           when the run started, UTC YYYY-MM-DDTHH:MM:SSZ
  ended-at=TIME             when it ended, no earlier than started-at
  exit=N                    the entry point's exit status, 0 to 999
  selection=all|subset|battery|unreported
  lanes=NAMES               comma-separated, beside all, subset or battery only
selection and lanes are the validate: line of the validation command output
contract (references/artifact-checks.md). Every key but lanes is required.
The writer derives the wall time from the two times and the verdict from the
exit status, pass for 0 and FAILING for any other, so the record never
carries a no-verdict; head and started-at bind a --kind fix receipt as a run
directory's do.
--summary TEXT embeds the summary inline; --summary-file PATH embeds a file's
content. --recovered-text PATH embeds the report round-recover read from a
stalled agent's transcript and records recovered_from: transcript. The three
are mutually exclusive (one summary source, no silent precedence).
--near-ceiling-base REF runs the worktree's
.agents/skills/commit-guards/scripts/byte-ceiling --base REF and records one
near-ceiling line per binary blob within reach of the byte ceiling on exit
0 or 1; the next round plans Git LFS, an asset store or generation from it.
A repository with nothing at that path records []. An omitted --near-ceiling-base, a broken link on the way
to the lane, a lane that is not executable, or a lane that exits otherwise
records near_ceiling null and the cause in near_ceiling_error, so the
orchestrator keeps the list it carries.
--label LABEL is one entry of the delegation's Labels: line, and --no-labels
declares that line reads none; the Apple gate below reads them, and neither is
recorded.
Every single-valued flag may be supplied at most once
(no silent last-wins); only --qa-label, --label and --item repeat.
--issue / --round-id must match ^[A-Za-z0-9._-]+$. Canonical schema:
skills/orch/schemas/dev-return.md. Validated by dev-artifact-check.
Exit 0 on success; every usage/validation error exits 2.

Apple gate: where the base branch holds the workflow below, a pass or
no-verdict declares the item's labels, with --label or --no-labels, and for an
item the trigger names needs a --validate-note line matching the record. A
FAILING result needs neither. Elsewhere the receipt is unchanged.
EOF
  printf '  workflow:  %s\n' "$APPLE_WORKFLOW"
  printf '  labels:    %s\n' "${APPLE_LABELS[*]}"
  printf '  paths:     a changed path with a directory segment matching %s\n' "${APPLE_DIR_GLOBS[*]}"
  printf '  manifest:  a changed %s matching %s at the commit\n' "$APPLE_MANIFEST" "$APPLE_MANIFEST_PLATFORMS"
  printf '  record:    %s\n' "$MAC_RUN_PASS"
}

# This script's own flag vocabulary. would distinguish a forgotten value
# (the next token is one of OUR flags — "--summary --no-summary" would record
# the literal string "--no-summary" as the deliverable) from legitimate prose
# that merely begins with '--' ("--foo", an em-dash-style aside), which stays
# a legal value for free-form fields like --summary.
is_own_flag() {
  case "$1" in
    --worktree|--kind|--issue|--round-id|--branch|--commit|--validate|\
    --validate-note|--validate-run-dir|--validate-record|--summary|--summary-file|--recovered-text|--qa-label|\
    --near-ceiling-base|--label|--no-labels|--bundled|\
    --no-summary|--item|-h|--help) return 0 ;;
    *) return 1 ;;
  esac
}

need() {
  # $1 = flag name, $2 = current argc ($#), $3 = the would-be value. A value
  # option needs at least 2 args, and the value must not be one of this
  # script's own flag tokens — that shape is a forgotten value, not a value.
  (( $2 >= 2 )) || die missing-value "option=$1"
  if is_own_flag "$3"; then
    die flag-value "option=$1" "value=$3"
  fi
}

no_dup() {
  # $1 = flag name, $2 = its presence boolean. A single-valued flag supplied
  # twice would silently last-win — the same quiet-misrecording class as the
  # summary-source precedence this writer refuses. Repeatable flags
  # (--qa-label, --item) never route through here.
  [[ "$2" == "false" ]] || die duplicate "option=$1"
}

# Validate a path-forming token (--issue / --round-id): non-empty, matches the
# path-safe grammar, and contains no '..'. Shared verbatim with dev-artifact-check.
check_id_token() {
  # $1 = flag name, $2 = value.
  [[ -n "$2" ]] || die required "option=$1"
  [[ "$2" =~ $ID_GRAMMAR && "$2" != *..* ]] \
    || die invalid-id "option=$1" "value=$2"
}

worktree=""
kind=""
issue=""
round_id=""
branch=""
commit=""
validate=""
validate_note=""
validate_mode=""
validate_lanes=""
validate_selection=""
validate_class_base=""
validate_run_dir=""
validate_record=""
run_ref=""
run_verdict=""
validate_seconds=""
validate_started_at=""
validate_ended_at=""
run_head=""
run_start=""
run_orphaned=""
baseline_lines=null
summary_file=""
summary_file_given=false
summary_text=""
summary_given=false
recovered_text=""
recovered_given=false
bundled=false
summary_posted=true
qa_labels=()
labels=()
no_labels=false
near_ceiling=()
item_n=()
item_decision=()
item_reasoning=()
# Presence tracking: every single-valued flag uses its boolean to refuse a
# duplicate (silent last-wins).
worktree_given=false
kind_given=false
issue_given=false
round_id_given=false
branch_given=false
commit_given=false
validate_given=false
validate_note_given=false
validate_run_dir_given=false
validate_record_given=false
near_ceiling_base=""
near_ceiling_base_given=false

while (( $# > 0 )); do
  case "$1" in
    --worktree)     need "$1" $# "${2:-}"; no_dup "$1" "$worktree_given";     worktree_given=true;     worktree="$2"; shift 2 ;;
    --kind)         need "$1" $# "${2:-}"; no_dup "$1" "$kind_given";         kind_given=true;         kind="$2"; shift 2 ;;
    --issue)        need "$1" $# "${2:-}"; no_dup "$1" "$issue_given";        issue_given=true;        issue="$2"; shift 2 ;;
    --round-id)     need "$1" $# "${2:-}"; no_dup "$1" "$round_id_given";     round_id_given=true;     round_id="$2"; shift 2 ;;
    --branch)       need "$1" $# "${2:-}"; no_dup "$1" "$branch_given";       branch_given=true;       branch="$2"; shift 2 ;;
    --commit)       need "$1" $# "${2:-}"; no_dup "$1" "$commit_given";       commit_given=true;       commit="$2"; shift 2 ;;
    --validate)     need "$1" $# "${2:-}"; no_dup "$1" "$validate_given";     validate_given=true;     validate="$2"; shift 2 ;;
    --validate-note) need "$1" $# "${2:-}"; no_dup "$1" "$validate_note_given"; validate_note_given=true; validate_note="$2"; shift 2 ;;
    --validate-run-dir) need "$1" $# "${2:-}"; no_dup "$1" "$validate_run_dir_given"; validate_run_dir_given=true; validate_run_dir="$2"; shift 2 ;;
    --validate-record) need "$1" $# "${2:-}"; no_dup "$1" "$validate_record_given"; validate_record_given=true; validate_record="$2"; shift 2 ;;
    --summary)      need "$1" $# "${2:-}"; no_dup "$1" "$summary_given";      summary_given=true;      summary_text="$2"; shift 2 ;;
    --summary-file) need "$1" $# "${2:-}"; no_dup "$1" "$summary_file_given"; summary_file_given=true; summary_file="$2"; shift 2 ;;
    --recovered-text) need "$1" $# "${2:-}"; no_dup "$1" "$recovered_given"; recovered_given=true; recovered_text="$2"; shift 2 ;;
    --qa-label)     need "$1" $# "${2:-}"; qa_labels+=("$2"); shift 2 ;;
    --label)        need "$1" $# "${2:-}"; labels+=("$2"); shift 2 ;;
    --no-labels)    no_dup "$1" "$no_labels"; no_labels=true; shift ;;
    --near-ceiling-base) need "$1" $# "${2:-}"; no_dup "$1" "$near_ceiling_base_given"; near_ceiling_base_given=true; near_ceiling_base="$2"; shift 2 ;;
    --bundled)      bundled=true; shift ;;
    --no-summary)   summary_posted=false; shift ;;
    --item)
      # Consumes exactly 3 args: N DECISION REASONING.
      if (( $# < 4 )); then
        die item-arguments "count=$(($# - 1))"
      fi
      n="$2"; decision="$3"; reasoning="$4"
      if ! [[ "$n" =~ ^[0-9]+$ ]]; then
        die item-number "value=$n"
      fi
      case "$decision" in
        Applied|Skipped|Blocked) ;;
        *) die item-decision "value=$decision" ;;
      esac
      if [[ -z "$reasoning" ]]; then
        die item-empty "item=$n"
      fi
      # Same forgotten-value guard as need(): N and DECISION are already
      # domain-checked above, but a missing REASONING would otherwise swallow
      # the next flag as the recorded rationale. Prose merely beginning with
      # '--' stays legal — only this script's own flag tokens are rejected.
      if is_own_flag "$reasoning"; then
        die item-flag "item=$n" "value=$reasoning"
      fi
      item_n+=("$n")
      item_decision+=("$decision")
      item_reasoning+=("$reasoning")
      shift 4
      ;;
    -h|--help) usage; exit 0 ;;
    *) die unknown-argument "argument=$1" ;;
  esac
done

# read_validate_record PATH — the foreground validation record --help gives the
# grammar of, read into the fields the run directory's --record line fills.
# The epoch start, the wall time and the verdict are derived here, never read.
UTC_TIME='^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$'
record_value() { # PATH KEY VALUE PATTERN
  [[ "$3" =~ $4 ]] || die validate-record-value "path=$1" "field=$2" "value=$3"
}
read_validate_record() {
  local path="$1" line key value seen=" " line_no=0 exit_status="" epochs started ended
  [[ -f "$path" && -r "$path" ]] || die validate-record-unreadable "path=$path"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_no=$((line_no + 1))
    key="${line%%=*}"
    value="${line#*=}"
    [[ "$line" == *=* && "$seen" != *" $key "* ]] || die validate-record-line "path=$path" "line=$line_no"
    seen="$seen$key "
    case "$key" in
      validate-mode) record_value "$path" "$key" "$value" '^(full|range)$'; validate_mode="$value" ;;
      head) record_value "$path" "$key" "$value" '^[0-9a-f]{40}$'; run_head="$value" ;;
      started-at) record_value "$path" "$key" "$value" "$UTC_TIME"; validate_started_at="$value" ;;
      ended-at) record_value "$path" "$key" "$value" "$UTC_TIME"; validate_ended_at="$value" ;;
      exit) record_value "$path" "$key" "$value" '^(0|[1-9][0-9]{0,2})$'; exit_status="$value" ;;
      selection) record_value "$path" "$key" "$value" '^(all|subset|battery|unreported)$'; validate_selection="$value" ;;
      # The lane grammar is the validation command output contract's.
      lanes) record_value "$path" "$key" "$value" '^[[:alnum:]_.-]+(,[[:alnum:]_.-]+)*$'; validate_lanes="$value" ;;
      *) die validate-record-line "path=$path" "line=$line_no" ;;
    esac
  done <"$path"
  for key in validate-mode head started-at ended-at exit selection; do
    [[ "$seen" == *" $key "* ]] || die validate-record-missing "path=$path" "field=$key"
  done
  if [[ "$validate_selection" == unreported ]]; then
    [[ -z "$validate_lanes" ]] || die validate-record-lanes "path=$path" "selection=$validate_selection"
  else
    [[ -n "$validate_lanes" ]] || die validate-record-lanes "path=$path" "selection=$validate_selection"
  fi
  # jq reads each time as an epoch second and refuses a month or hour out of range.
  epochs="$(jq -nr --arg s "$validate_started_at" --arg e "$validate_ended_at" \
    '"\($s | fromdate) \($e | fromdate)"' 2>/dev/null)" \
    || die validate-record-value "path=$path" "field=started-at,ended-at" "value=$validate_started_at,$validate_ended_at"
  read -r started ended <<<"$epochs"
  (( ended >= started )) \
    || die validate-record-time "path=$path" "started-at=$validate_started_at" "ended-at=$validate_ended_at"
  run_start="$started"
  validate_seconds=$(( ended - started ))
  if [[ "$exit_status" == 0 ]]; then run_verdict=pass; else run_verdict=FAILING; fi
}

# --- Validate required fields ---
[[ -n "$worktree" ]] || die required option=--worktree
[[ -d "$worktree" ]] || die not-directory "path=$worktree"
case "$kind" in
  implement|fix) ;;
  "") die required option=--kind ;;
  *)  die invalid-kind "value=$kind" ;;
esac
check_id_token --issue "$issue"
check_id_token --round-id "$round_id"
[[ -n "$branch" ]]   || die required option=--branch
[[ -n "$commit" ]]   || die required option=--commit
[[ -n "$validate" ]] || die required option=--validate
[[ "$validate" == "pass" || "$validate" == "no-verdict" || "$validate" == FAILING:* ]] \
  || die invalid-validate "value=$validate"
# One source names the run, so neither can silently win.
if [[ "$validate_run_dir_given" == "true" && "$validate_record_given" == "true" ]]; then
  die validate-source-conflict options=--validate-run-dir,--validate-record
fi
if [[ "$validate_run_dir_given" == "true" ]]; then
  [[ -n "$validate_run_dir" ]] || die required option=--validate-run-dir
  run_ref="run-dir=$validate_run_dir"
  if ! run_record="$("$SCRIPT_DIR/dev-validate-run" --record --run-dir "$validate_run_dir" 2>&1)"; then
    IFS= read -r run_cause <<<"$run_record" || true
    die run-record-unreadable "path=$validate_run_dir" "cause=$run_cause"
  fi
  # The one line --record prints: validate-mode=M [lanes=L] selection=S verdict=V head=H start=S,
  # then validate-base-orphaned=O where a rebase left the run's base off the
  # branch, then class-base=C where the class was read from a round base, then
  # seconds=N started-at=T ended-at=T where the run finished, the bound's end
  # included.
  read -r -a run_fields <<<"$run_record"
  for field in ${run_fields[@]+"${run_fields[@]}"}; do
    case "$field" in
      validate-mode=*) validate_mode="${field#*=}" ;;
      lanes=*) validate_lanes="${field#*=}" ;;
      selection=*) validate_selection="${field#*=}" ;;
      verdict=*) run_verdict="${field#*=}" ;;
      head=*) run_head="${field#*=}" ;;
      start=*) run_start="${field#*=}" ;;
      validate-base-orphaned=*) run_orphaned="${field#*=}" ;;
      class-base=*) validate_class_base="${field#*=}" ;;
      seconds=*) validate_seconds="${field#*=}" ;;
      started-at=*) validate_started_at="${field#*=}" ;;
      ended-at=*) validate_ended_at="${field#*=}" ;;
    esac
  done
elif [[ "$validate_record_given" == "true" ]]; then
  [[ -n "$validate_record" ]] || die required option=--validate-record
  run_ref="validate-record=$validate_record"
  read_validate_record "$validate_record"
elif [[ "$validate" != FAILING:* ]]; then
  die required options=--validate-run-dir,--validate-record "validate=$validate"
fi
[[ -z "$run_ref" || "$validate" == FAILING:* || "$validate" == "$run_verdict" ]] \
  || die validate-disagrees "validate=$validate" "run=$run_verdict"
# An empty or whitespace-only note is worse than none: it looks like a recorded
# caveat while carrying nothing. Reject it rather than storing "".
if [[ -n "${validate_note+set}" && -n "$validate_note" ]]; then
  [[ -n "${validate_note//[[:space:]]/}" ]] \
    || die empty-text option=--validate-note
fi
# A no-verdict with no suites named would accept a round on no evidence.
[[ "$validate" != no-verdict || -n "$validate_note" ]] \
  || die required option=--validate-note validate=no-verdict
# One summary source only — accepting both would need a precedence rule, and a
# silently ignored flag is exactly the class of quiet misrecording this writer
# exists to prevent. Exclusion is by flag PRESENCE, not value: "--summary-file
# ''" (e.g. an empty path variable) is still a supplied second source, and
# treating it as absent would silently drop the caller's intent.
sources=0
for given in "$summary_given" "$summary_file_given" "$recovered_given"; do
  if [[ "$given" == "true" ]]; then sources=$((sources + 1)); fi
done
if (( sources > 1 )); then
  die summary-conflict options=--summary,--summary-file,--recovered-text
fi
# A label and --no-labels contradict each other, and neither may win silently.
if [[ "$no_labels" == true ]] && (( ${#labels[@]} > 0 )); then
  die labels-conflict "labels=${labels[*]}"
fi
if [[ "$summary_given" == "true" ]]; then
  # An empty or whitespace-only summary looks like a recorded deliverable while
  # carrying nothing — refuse it, matching the --validate-note rule.
  [[ -n "${summary_text//[[:space:]]/}" ]] \
    || die empty-text option=--summary
fi
if [[ "$summary_file_given" == "true" ]]; then
  # An explicitly supplied empty path is a caller config error (typically an
  # unset path variable) — never a no-op.
  [[ -n "$summary_file" ]] || die required option=--summary-file
  [[ -f "$summary_file" ]] || die missing-file "path=$summary_file"
fi
if [[ "$recovered_given" == "true" ]]; then
  [[ -f "$recovered_text" ]] || die missing-file "path=$recovered_text"
fi

if [[ "$near_ceiling_base_given" == "true" ]]; then
  [[ -n "$near_ceiling_base" ]] || die required option=--near-ceiling-base
fi

# A fix or bundled artifact without items is incomplete — reject before writing.
if [[ "$kind" == "fix" || "$bundled" == "true" ]]; then
  if (( ${#item_n[@]} == 0 )); then
    die missing-items "kind=$kind" "bundled=$bundled" count=0
  fi
fi

# A fix round's run must have started on the round's base, or from it once a
# rebase left it off the branch, and once the round was delegated.
if [[ "$kind" == "fix" && -n "$run_ref" ]]; then
  round_record="$worktree/tmp/dev-round-$issue-$round_id.json"
  round_fields="$(jq -r '[(if (.base_sha? | type) == "string" then .base_sha else "" end),
      (if (.delegated_at? | type) == "number" then .delegated_at | tostring else "" end)] | join(" ")' \
    "$round_record" 2>/dev/null)" || round_fields=""
  read -r round_base round_delegated_at <<<"$round_fields" || true
  [[ "$round_base" =~ ^[0-9a-f]{40}$ && "${round_delegated_at:-}" =~ ^[0-9]+$ ]] \
    || die round-record-unreadable "path=$round_record"
  [[ -n "$run_head" ]] || die run-headless "$run_ref"
  # The head is checked as hex before it reaches git, where a value shaped like
  # an option would be parsed as one.
  ancestry=0
  if [[ "$run_head" =~ ^[0-9a-f]+$ ]]; then
    git -C "$worktree" merge-base --is-ancestor "$round_base" "$run_head" 2>/dev/null || ancestry=$?
  else
    ancestry=128
  fi
  case "$ancestry" in
    0) ;;
    1)
      if [[ "$run_orphaned" != "$round_base" ]]; then
        rebase_map="$(git -C "$worktree" rev-parse --git-path kendex-rebase-map 2>/dev/null)" \
          || die rebase-map-unreadable "worktree=$worktree"
        [[ "$rebase_map" == /* ]] || rebase_map="$worktree/$rebase_map"
        mapped_base=""
        if [[ -e "$rebase_map" || -L "$rebase_map" ]]; then
          # The shared owner projects the round base without consuming the
          # file. Only a complete map can bind the run's exact HEAD below.
          if rebase_map_load "$rebase_map" && rebase_map_project "$round_base"; then
            mapped_base="$REBASE_MAP_PROJECTED"
          else
            case "${REBASE_MAP_FAIL_ARGS[0]}" in
              rebase-unmapped|restack-map-grammar|map-sha) mapped_base="" ;;
              map-read|map-build) die rebase-map-unreadable "path=$rebase_map" ;;
              *) die rebase-map-unreadable "path=$rebase_map" "cause=${REBASE_MAP_FAIL_ARGS[0]}" ;;
            esac
          fi
        fi
        [[ "$mapped_base" == "$run_head" ]] \
          || die run-off-round "$run_ref" "head=$run_head" "base-sha=$round_base"
      fi
      ;;
    *) die ancestry-unreadable "$run_ref" "head=$run_head" "base-sha=$round_base" ;;
  esac
  [[ "$run_start" =~ ^[0-9]+$ ]] \
    || die run-record-unreadable "path=$validate_run_dir" "cause=start=$run_start"
  (( 10#$run_start >= 10#$round_delegated_at )) \
    || die run-before-round "$run_ref" "start=$run_start" "delegated-at=$round_delegated_at"
fi

if [[ "$kind" == "implement" ]]; then
  branch_baseline_lines "$worktree" "$SCRIPT_DIR/resolve-base-branch" "$commit" baseline_lines \
    || die baseline-read "path=$worktree" "commit=$commit"
fi

# apple_trigger BASE_REF PATHS_FILE — sets APPLE_CAUSE to the first label or
# changed path the trigger names, or to "" when none; returns 1 when git cannot
# answer. The changed paths travel NUL-separated through PATHS_FILE, since a
# shell variable cannot hold a NUL. --no-renames lists a move out of an Apple
# directory under its old path too.
apple_trigger() {
  local base_ref="$1" paths_file="$2" label apple path rest segment glob listed manifest
  APPLE_CAUSE=""
  for label in ${labels[@]+"${labels[@]}"}; do
    for apple in "${APPLE_LABELS[@]}"; do
      if [[ "$label" == "$apple" ]]; then
        APPLE_CAUSE="label=$label"
        return 0
      fi
    done
  done
  git -C "$worktree" diff --name-only --no-renames -z "$base_ref...$commit" -- >"$paths_file" || return 1
  while IFS= read -r -d '' path; do
    rest="$path"
    while [[ "$rest" == */* ]]; do
      segment="${rest%%/*}"
      rest="${rest#*/}"
      for glob in "${APPLE_DIR_GLOBS[@]}"; do
        # shellcheck disable=SC2053 # the glob is the pattern
        if [[ "$segment" == $glob ]]; then
          APPLE_CAUSE="path=$path"
          return 0
        fi
      done
    done
    [[ "$rest" == "$APPLE_MANIFEST" ]] || continue
    # A manifest the commit deletes names no platform.
    listed="$(git -C "$worktree" ls-tree --full-tree --name-only "$commit" -- "$path")" || return 1
    [[ -n "$listed" ]] || continue
    manifest="$(git -C "$worktree" cat-file blob "$commit:$path")" || return 1
    if LC_ALL=C grep -Eq -- "$APPLE_MANIFEST_PLATFORMS" <<<"$manifest"; then
      APPLE_CAUSE="path=$path"
      return 0
    fi
  done <"$paths_file"
}

# GitHub dispatches the workflow only from the base branch, so the base, never
# the worktree or the round's commit, decides whether the gate is armed.
apple_base_ref=""
apple_armed=""
if [[ "$validate" != FAILING:* ]]; then
  BRANCH_GROWTH_ERROR=""
  branch_growth_base_ref "$worktree" "$SCRIPT_DIR/resolve-base-branch" apple_base_ref \
    || die apple-git-failed "path=$worktree" "commit=$commit"
  apple_armed="$(git -C "$worktree" ls-tree --full-tree --name-only "$apple_base_ref" -- "$APPLE_WORKFLOW")" \
    || die apple-git-failed "path=$worktree" "base=$apple_base_ref"
fi
if [[ -n "$apple_armed" ]]; then
  if [[ "$no_labels" == false ]] && (( ${#labels[@]} == 0 )); then
    die labels-undeclared "path=$worktree" "base=$apple_base_ref"
  fi
  apple_paths="$(mktemp)" || die scratch-failed "tmpdir=${TMPDIR:-/tmp}"
  trap 'rm -f -- "${apple_paths:?}"' EXIT
  apple_trigger "$apple_base_ref" "$apple_paths" || die apple-git-failed "path=$worktree" "commit=$commit"
  rm -f -- "${apple_paths:?}"
  trap - EXIT
  if [[ -n "$APPLE_CAUSE" ]]; then
    mac_run_recorded=false
    while IFS= read -r line; do
      if [[ "$line" =~ $MAC_RUN_PASS ]]; then mac_run_recorded=true; fi
    done <<<"$validate_note"
    [[ "$mac_run_recorded" == true ]] || die mac-run-missing "$APPLE_CAUSE" "validate=$validate"
  fi
fi

# --- Build the variable-length arrays deterministically with jq ---
if (( ${#qa_labels[@]} > 0 )); then
  qa_json="$(jq -n '$ARGS.positional' --args "${qa_labels[@]}")"
else
  qa_json='[]'
fi

# The probe runs the worktree's own installed lane, so it measures under the
# settings that repository's commits are held to.
# Nothing at the lane path means no byte ceiling, so the list stays empty. A
# worktree's untracked .agents children are links to the main checkout, so a
# dangling link at or above the lane is a broken install, not an absent lane.
near_error=""
lane="$worktree/.agents/skills/commit-guards/scripts/byte-ceiling"
lane_broken=""
ancestor="${lane%/*}"
while [[ "$ancestor" != "$worktree" && "$ancestor" == "$worktree"/* ]]; do
  [[ -L "$ancestor" && ! -e "$ancestor" ]] && lane_broken="$ancestor"
  ancestor="${ancestor%/*}"
done
if [[ "$near_ceiling_base_given" != "true" ]]; then
  near_error="byte-ceiling not probed: no --near-ceiling-base"
elif [[ -n "$lane_broken" ]]; then
  near_error="byte-ceiling broken link: $lane_broken"
elif [[ -x "$lane" ]]; then
  lane_err="$(mktemp)"
  trap 'rm -f -- "${lane_err:?}"' EXIT
  lane_rc=0
  lane_out="$(cd -- "$worktree" && "$lane" --base "$near_ceiling_base" 2>"$lane_err")" || lane_rc=$?
  case "$lane_rc" in
    0|1)
      while IFS= read -r line; do
        [[ "$line" == "byte-ceiling: near-ceiling="* ]] && near_ceiling+=("$line")
      done <<<"$lane_out"
      ;;
    *)
      near_error="byte-ceiling exit $lane_rc: $(head -n1 -- "$lane_err")"
      ;;
  esac
  rm -f -- "${lane_err:?}"
  trap - EXIT
elif [[ -e "$lane" || -L "$lane" ]]; then
  near_error="byte-ceiling not executable: $lane"
fi

if [[ -n "$near_error" ]]; then
  near_json=null
elif (( ${#near_ceiling[@]} > 0 )); then
  near_json="$(jq -n '$ARGS.positional' --args "${near_ceiling[@]}")"
else
  near_json='[]'
fi

if (( ${#item_n[@]} > 0 )); then
  items_json="$(
    for i in "${!item_n[@]}"; do
      jq -n \
        --argjson n "${item_n[$i]}" \
        --arg decision "${item_decision[$i]}" \
        --arg reasoning "${item_reasoning[$i]}" \
        '{n: $n, decision: $decision, reasoning: $reasoning}'
    done | jq -s '.'
  )"
else
  items_json='[]'
fi

# --- Compute the absolute, round-scoped out path ---
mkdir -p "$worktree/tmp"
out_dir="$(cd "$worktree/tmp" && pwd)"
out="$out_dir/dev-return-$issue-$round_id.json"

# --- Write atomically: build to a same-dir temp file, then mv over the target ---
# A concurrent checker never observes a partial/empty artifact, and a failed
# generation leaves any prior receipt intact.
tmp="$(mktemp "$out_dir/.dev-return-$issue.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

# Summary content (inline --summary, --summary-file content, or null) rides
# along for GitHub/ad-hoc recovery, where the completion summary is returned to
# the orchestrator rather than posted to a tracker; summary_posted stays honest
# (true only for the Linear-posted case).
recovered_from=null
if [[ "$recovered_given" == "true" ]]; then
  summary_arg=(--rawfile summary "$recovered_text")
  recovered_from='"transcript"'
elif [[ "$summary_file_given" == "true" ]]; then
  summary_arg=(--rawfile summary "$summary_file")
elif [[ "$summary_given" == "true" ]]; then
  summary_arg=(--arg summary "$summary_text")
else
  summary_arg=(--argjson summary null)
fi

jq -n \
  --argjson schema_version 1 \
  --arg round_id "$round_id" \
  --arg kind "$kind" \
  --arg issue "$issue" \
  --arg branch "$branch" \
  --arg commit "$commit" \
  --argjson baseline_lines "$baseline_lines" \
  --arg validate "$validate" \
  --arg validate_mode "$validate_mode" \
  --arg validate_lanes "$validate_lanes" \
  --arg validate_selection "$validate_selection" \
  --arg validate_class_base "$validate_class_base" \
  --arg validate_seconds "$validate_seconds" \
  --arg validate_started_at "$validate_started_at" \
  --arg validate_ended_at "$validate_ended_at" \
  --arg validate_note "$validate_note" \
  --argjson qa_labels "$qa_json" \
  --argjson near_ceiling "$near_json" \
  --arg near_ceiling_error "$near_error" \
  --argjson summary_posted "$summary_posted" \
  "${summary_arg[@]}" \
  --argjson recovered_from "$recovered_from" \
  --argjson bundled "$bundled" \
  --argjson items "$items_json" \
  '({
     schema_version: $schema_version,
     round_id: $round_id,
     kind: $kind,
     issue: $issue,
     branch: $branch,
     commit: $commit,
     validate: $validate,
     validate_mode: (if $validate_mode == "" then null else $validate_mode end),
     validate_time: (if $validate_seconds == "" then null
       else {started_at: $validate_started_at, ended_at: $validate_ended_at, seconds: ($validate_seconds | tonumber)} end),
     validate_note: (if $validate_note == "" then null else $validate_note end),
     qa_labels: $qa_labels,
     near_ceiling: $near_ceiling,
     near_ceiling_error: (if $near_ceiling_error == "" then null else $near_ceiling_error end),
     summary_posted: $summary_posted,
     summary: $summary,
     recovered_from: $recovered_from,
     bundled: $bundled,
     items: $items
   } + (if $validate_selection == "" then {} else {validate_selection: $validate_selection} end)
     + (if $validate_lanes == "" then {} else {validate_lanes: $validate_lanes} end)
     + (if $validate_class_base == "" then {} else {validate_class_base: $validate_class_base} end)
     + if $kind == "implement" then {baseline_lines: $baseline_lines} else {} end)' > "$tmp"

mv "$tmp" "$out"
trap - EXIT

printf '%s\n' "$out"
