#!/usr/bin/env bash
# dev-round-live — is a fix round in flight in this worktree, so that rebasing
# it would move the branch off the commit the delegated agent is working from?
#
# The ACTIVE round is the one whose token equals workflow state `dev_round_id`,
# live from the moment `dev-round-write` stamps its record until the matching
# `dev-return` receipt lands. Every caller that rebases asks here, because a
# second copy of a guard loses an arm per copy (kendex#944).
#
# Usage: dev-round-live --worktree PATH --issue ID [--state-dir DIR]
#
# Exit codes:
#   0  no round in flight: the branch may be rebased. An implement round, a
#      stale record and a landed receipt all answer here, silently, so a caller
#      whose stdout is closed is never failed by a message it did not ask for.
#   3  a fix round is live: hand back, then retry once that round's receipt
#      lands or a fresh dev_round_id is stamped
#   1  the answer could not be established, which is not a state with no round
#   2  usage error

set -euo pipefail

PROG="dev-round-live"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKFLOW_STATE="$SCRIPT_DIR/workflow-state"
ISSUE_GRAMMAR='^[A-Za-z0-9][A-Za-z0-9._-]*$'

usage() {
	awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
}

# $1 = exit code, $2 = message. 2 is a usage error, 1 an unanswered question.
fail() {
	printf '%s: %s\n' "$PROG" "$2" >&2
	exit "$1"
}

worktree=''
issue=''
state_dir=''

while [[ $# -gt 0 ]]; do
	case "$1" in
	-h | --help) usage; exit 0 ;;
	--worktree | --issue | --state-dir)
		[[ $# -ge 2 ]] || fail 2 "$1 requires a value"
		case "$1" in
		--worktree) worktree="$2" ;;
		--issue) issue="$2" ;;
		--state-dir) state_dir="$2" ;;
		esac
		shift 2
		;;
	*) fail 2 "unknown argument: $1" ;;
	esac
done

[[ -n "$worktree" ]] || fail 2 "--worktree is required"
[[ -n "$issue" ]] || fail 2 "--issue is required"
[[ "$issue" =~ $ISSUE_GRAMMAR && "$issue" != *..* ]] || fail 2 "invalid issue id: $issue"
command -v jq >/dev/null 2>&1 || fail 2 "jq is required"
worktree_abs="$(cd -P -- "$worktree" 2>/dev/null && pwd -P)" || fail 2 "not a directory: $worktree"

state_flags=()
[[ -z "$state_dir" ]] || state_flags=(--state-dir "$state_dir")

# `exists --json` answers {path, exists}. Only a definite yes or no may decide:
# an error, or an answer that is neither, leaves the question unanswered, and
# an unanswered question is not permission to rebase.
state_rc=0
state_info="$("$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} exists --json "$issue")" || state_rc=$?
[[ "$state_rc" -eq 0 ]] \
	|| fail 1 "could not resolve the workflow state for '$issue' (exists exit $state_rc; the error above says why)"
state_file="$(jq -r '.path // ""' <<<"$state_info" 2>/dev/null || true)"
state_present="$(jq -r '.exists' <<<"$state_info" 2>/dev/null || true)"
[[ -n "$state_file" && ( "$state_present" == "true" || "$state_present" == "false" ) ]] \
	|| fail 1 "unexpected exists --json answer for '$issue': $state_info"

# Proceed answers are silent: the exit code is the answer, and only the two
# hand-back answers speak, on stderr.
[[ "$state_present" == "true" ]] || exit 0

round_rc=0
active_round="$("$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} get "$issue" '.dev_round_id // ""')" || round_rc=$?
[[ "$round_rc" -eq 0 ]] || fail 1 "could not read the active dev round for $issue (get exit $round_rc)"

[[ -n "$active_round" ]] || exit 0
[[ -e "$worktree_abs/tmp/dev-round-$issue-$active_round.json" ]] || exit 0
[[ ! -e "$worktree_abs/tmp/dev-return-$issue-$active_round.json" ]] || exit 0

fail 3 "fix round $active_round is live in $worktree_abs (its round record has no dev-return receipt); a rebase would move the branch off the commit that round is working from"
