#!/usr/bin/env bash
# dev-round-write — persist a fix round's delegated item set to a round-scoped
# on-disk record at delegation time, so the set survives the orchestrator's
# context (kendex#1230).
#
# Before this record existed, the delegated item set lived only in the
# delegation message: a dev agent respawned mid-round could not write a
# truthful completion artifact (the curated, renumbered subset is not
# recoverable from the raw review JSONs), and dev-artifact-check
# --expect-items had no on-disk source of truth — the orchestrator typed the
# numbers from its own context. The orchestrator runs THIS one command
# immediately after stamping the round (`workflow-state new-round-id`), before
# delegating.
#
# The record follows the dev-return round-token discipline (kendex#776): it is
# named [WORKTREE]/tmp/dev-round-[ISSUE_ID]-[ROUND_ID].json and carries
# "round_id": ROUND_ID inside. Readers:
#   - dev-artifact-check --expect-items-from-round derives the exact expected
#     item-number set from it (rejecting a record whose internal token differs);
#   - a respawned dev agent (dev/workflows/dev-fix.md § 6) reads items[].text
#     to recover exactly what was delegated instead of guessing;
#   - the ok==false tail-reconciliation nudge can point at it, making the nudge
#     self-sufficient after any respawn.
#
# Usage:
#   dev-round-write --worktree PATH --issue ID --round-id RID \
#     (--item N TEXT REACH [--item N TEXT REACH]... | --items-file JSON_PATH) \
#     [--adds "PATH [PATH...]"]
#
# One --item per delegated review item: N is the item's delegated number (the
# `#[N]` in the formatted items — a set, so duplicates are rejected; canonical
# integer, no leading zeros), TEXT is that item's full formatted block verbatim
# (multi-line is fine; plain text, no backticks, so the command stays
# classifier-safe under Codex approval=never), and REACH names the shipped
# producer, user action, or fixture that reaches the finding. When the item
# text is shell-hostile — real review blocks routinely carry backticks, which
# strict harness classifiers reject even quoted — the orchestrator instead
# builds a JSON array of {n, text, reach} with its harness file-write tool and
# passes it as --items-file (mutually exclusive with --item; same
# n/text/reach rules, extra element keys are dropped on normalization).
#
# REACH is the fix-round bar (kendex KEN-1046): a merged-PR audit found rounds
# answering a review thread rather than a producer, so a shape a bot typed was
# patched as if a user had reached it. An item with no reach is a `Declined:`
# reply, not a fix — skills/orch/references/finding-disposition.md § Filing bar.
#
# A round's record is IMMUTABLE once written: re-running with identical content
# is an idempotent retry (success, same path); different content under the same
# round id is refused (exit 2) — a partial-list retry must never silently
# shrink the authoritative delegated set. A changed delegation mints a NEW
# round id (`workflow-state new-round-id`), which is the round-token
# discipline: one token, one delegation, one item set.
#
# Protected-addition scope: skills/orch/schemas/dev-round.md § Protected additions.
# The writer records HEAD as the comparison base used at acceptance.
#
# Record schema — canonical source of truth: skills/orch/schemas/dev-round.md
#   {
#     "schema_version": 2,
#     "round_id": "[ROUND_ID]",             // required, matches the filename token
#     "issue": "[ISSUE_ID]",                // required, normalized state key
#     "base_sha": "[HEAD_AT_DELEGATION]",    // required, full commit id
#     "adds": ["tools/allowed-file"],        // required, protected additions
#     "items": [{"n": 1, "text": "…", "reach": "…"}]
#   }
#
# It is a sanctioned single-command invocation. Writes the record, then prints
# its path. All usage/validation errors exit 2; an oversized branch exits 3.

set -euo pipefail

PROG="dev-round-write"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# shellcheck source=lib/branch-growth.sh
source "$SCRIPT_DIR/lib/branch-growth.sh"

# Path-safe token grammar for --issue / --round-id: no '/', no '..', no
# whitespace, so a value can never escape the tmp/ directory. Shared verbatim
# with dev-return-write and dev-artifact-check.
ID_GRAMMAR='^[A-Za-z0-9._-]+$'
die() {
  printf '%s: %s\n' "$PROG" "$1" >&2
  exit 2
}

usage() {
  cat <<'EOF'
Usage:
  dev-round-write --worktree PATH --issue ID --round-id RID \
    (--item N TEXT REACH [--item N TEXT REACH]... | --items-file JSON_PATH) \
    [--adds "PATH [PATH...]"]

Persists the round's delegated item set to PATH/tmp/dev-round-ID-RID.json
(atomically) and prints that path. One --item per delegated review
item: N is the item's delegated number (duplicates rejected — the set is what
dev-artifact-check --expect-items-from-round checks against; canonical integer,
no leading zeros), REACH names the shipped producer, user action, or fixture
that reaches the finding — a command a person runs, a file a shipped writer
emits, a test in the tree. An item with no reach is a `Declined:` reply, not a
fix. What this script refuses is a short list, not a scanner: an empty reach, a
PRRT_ review-thread node id, and a few literal values. A value outside
those shapes is recorded, not approved — the classes in
references/finding-disposition.md are the orchestrator's judgement, applied
before the round is delegated. TEXT is the item's full formatted block verbatim
(non-empty plain text, no backticks); for shell-hostile text pass
--items-file JSON_PATH, a JSON array of {n, text, reach} built with the harness
file-write tool (mutually exclusive with --item, same rules, extra element keys
dropped).
A round's record is immutable: an identical re-invocation is an idempotent
success; different content under the same round id exits 2 — a changed
delegation needs a NEW round id. The record is read back by
dev-artifact-check --expect-items-from-round, by a respawned dev agent
recovering its items, and by the tail-reconciliation nudge.
Protected-addition scope: skills/orch/schemas/dev-round.md § Protected additions.
--adds carries the authorized protected paths as one blank-separated list,
the same list the delegation's Adds: line renders. A blank or tab separates,
so a path containing whitespace is read as two paths and cannot be authorized
as one. Absolute, traversing, empty-component, and duplicate paths are
rejected.
The record captures the worktree's current HEAD as base_sha; a worktree with
no resolvable HEAD is rejected.
Before the record is written, the branch's additions plus deletions must be
at most twice workflow state pr.baseline_lines. Full implementation acceptance
sets it; a null or invalid value refuses before the record is written.
An oversized branch exits 3 and must be cut before another fix round.
--issue / --round-id must match
^[A-Za-z0-9._-]+$ with no '..'. Canonical schema:
skills/orch/schemas/dev-round.md.
EOF
}

# This script's own flag vocabulary — distinguishes a forgotten value from
# legitimate prose that merely begins with '--'.
is_own_flag() {
  case "$1" in
    --worktree|--issue|--round-id|--item|--items-file|--adds|-h|--help) return 0 ;;
    *) return 1 ;;
  esac
}

need() {
  # $1 = flag name, $2 = current argc ($#), $3 = the would-be value.
  (( $2 >= 2 )) || die "$1 requires a value"
  if is_own_flag "$3"; then
    die "$1 requires a value, got flag '$3' (value missing?)"
  fi
}

no_dup() {
  # $1 = flag name, $2 = its presence boolean. A single-valued flag supplied
  # twice would silently last-win.
  [[ "$2" == "false" ]] || die "$1 supplied more than once"
}

check_id_token() {
  # $1 = flag name, $2 = value.
  [[ -n "$2" ]] || die "$1 is required (non-empty)"
  [[ "$2" =~ $ID_GRAMMAR && "$2" != *..* ]] \
    || die "$1 '$2' must match ${ID_GRAMMAR} with no '..' (path-safe: no '/' or whitespace)"
}

# --- The reach bar ---
# Values that name nothing shipped, matched case-insensitively. The node id is
# a substring — it can appear anywhere in a value; the rest are the whole
# value. A refused value is reworded, or its item becomes a `Declined:` reply.
REACH_REFUSALS=(
  '*prrt_*'                      # a GitHub review-thread node id, anywhere
  'copilot thread'
  'the finding'
  'a name containing a quote'
  'an empty pi_coding_agent_dir'
)

check_reach() {
  # $1 = the item's number (for the diagnostic), $2 = the reach value.
  local n="$1" reach="$2" lower pattern
  [[ -n "${reach//[[:space:]]/}" ]] \
    || die "item $n has no reach: name the shipped producer, user action, or fixture that reaches the finding — an item with no reach is a 'Declined:' reply, not a fix"
  if is_own_flag "$reach"; then die "item $n reach must name a producer, got flag '$reach' (value missing?)"; fi
  lower="$(printf '%s' "$reach" | tr '[:upper:]' '[:lower:]')"
  for pattern in "${REACH_REFUSALS[@]}"; do
    if [[ "$lower" == $pattern ]]; then
      die "item $n reach '$reach' is on the refusal list: name a command a person runs, a file a shipped writer emits, or a test in the tree — an item with no reach is a 'Declined:' reply, not a fix"
    fi
  done
}

run_size_tripwire() {
  local worktree="$1" issue="$2"

  if ! enforce_size_tripwire "$worktree" "$issue" "$SCRIPT_DIR"; then
    printf '%s: %s\n' "$PROG" "$BRANCH_GROWTH_ERROR" >&2
    [[ "$BRANCH_GROWTH_STATUS" == "over-limit" ]] && exit 3
    exit 2
  fi
}

worktree=""
issue=""
round_id=""
items_file=""
adds=""
item_n=()
item_text=()
item_reach=()
seen_n=" "
worktree_given=false
issue_given=false
round_id_given=false
items_file_given=false
adds_given=false

while (( $# > 0 )); do
  case "$1" in
    --worktree) need "$1" $# "${2:-}"; no_dup "$1" "$worktree_given"; worktree_given=true; worktree="$2"; shift 2 ;;
    --issue)    need "$1" $# "${2:-}"; no_dup "$1" "$issue_given";    issue_given=true;    issue="$2"; shift 2 ;;
    --round-id) need "$1" $# "${2:-}"; no_dup "$1" "$round_id_given"; round_id_given=true; round_id="$2"; shift 2 ;;
    --items-file) need "$1" $# "${2:-}"; no_dup "$1" "$items_file_given"; items_file_given=true; items_file="$2"; shift 2 ;;
    --adds) need "$1" $# "${2:-}"; no_dup "$1" "$adds_given"; adds_given=true; adds="$2"; shift 2 ;;
    --item)
      # Consumes exactly 3 args: N TEXT REACH.
      if (( $# < 4 )); then
        die "--item requires exactly 3 arguments: N TEXT REACH — REACH names the shipped producer, user action, or fixture that reaches the finding, and an item with no reach is a 'Declined:' reply, not a fix"
      fi
      n="$2"; text="$3"; reach="$4"
      # Canonical integer only: '01' would survive a bare digits check but is
      # not a JSON number and would make jq --argjson fail downstream.
      if ! [[ "$n" =~ ^(0|[1-9][0-9]*)$ ]]; then
        die "--item N must be a non-negative integer with no leading zeros, got '$n'"
      fi
      case "$seen_n" in
        *" $n "*) die "duplicate --item number $n: the delegated items form a set" ;;
      esac
      # An empty or whitespace-only text records nothing recoverable; a text
      # that is one of this script's own flags is a forgotten value.
      [[ -n "${text//[[:space:]]/}" ]] \
        || die "--item TEXT must contain non-whitespace text (item $n)"
      if is_own_flag "$text"; then
        die "--item TEXT must be the item's formatted block, got flag '$text' (item $n; value missing?)"
      fi
      check_reach "$n" "$reach"
      seen_n="$seen_n$n "
      item_n+=("$n")
      item_text+=("$text")
      item_reach+=("$reach")
      shift 4
      ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown argument: $1" ;;
  esac
done

[[ -n "$worktree" ]] || die "--worktree is required"
[[ -d "$worktree" ]] || die "--worktree path '$worktree' is not a directory"
check_id_token --issue "$issue"
check_id_token --round-id "$round_id"
base_sha="$(git -C "$worktree" rev-parse --verify 'HEAD^{commit}' 2>/dev/null)" \
  || die "worktree '$worktree' has no resolvable HEAD commit to record as the round base"

run_size_tripwire "$worktree" "$issue"

# --- Exactly one item source: inline --item xor --items-file ---
if [[ "$items_file_given" == "true" ]] && (( ${#item_n[@]} > 0 )); then
  die "--item and --items-file are mutually exclusive: provide one item source"
fi
if [[ "$items_file_given" == "true" ]]; then
  [[ -n "$items_file" ]] || die "--items-file requires a non-empty path"
  [[ -f "$items_file" ]] || die "--items-file path '$items_file' does not exist"
  jq empty "$items_file" >/dev/null 2>&1 \
    || die "--items-file '$items_file' is not parseable JSON"
  # Same rules as inline --item, enforced on the file: a non-empty array whose
  # every element carries an integer n >= 0 (unique — the numbers form a set),
  # a non-empty, non-whitespace text string, and a non-empty reach string.
  jq -e '
    (type == "array") and (length > 0)
    and all(.[];
          (type == "object")
          and ((.n? | type) == "number") and (.n == (.n | floor)) and (.n >= 0)
          and ((.text? | type) == "string")
          and ((.text | gsub("[[:space:]]"; "")) != "")
          and ((.reach? | type) == "string")
          and ((.reach | gsub("[[:space:]]"; "")) != ""))
    and (([.[].n] | length) == ([.[].n] | unique | length))
  ' "$items_file" >/dev/null 2>&1 \
    || die "--items-file '$items_file' must be a non-empty JSON array of {n, text, reach} — integer n >= 0, unique, non-empty text, non-empty reach naming the producer that reaches the finding"
  # The same refusal list the inline route enforces: a file route that skipped
  # it would be the way around the check.
  for (( i = 0, items_count="$(jq 'length' "$items_file")"; i < items_count; i++ )); do
    check_reach "$(jq -r --argjson i "$i" '.[$i].n' "$items_file")" \
      "$(jq -r --argjson i "$i" '.[$i].reach' "$items_file")"
  done
  items_json="$(jq 'map({n: .n, text: .text, reach: .reach})' "$items_file")"
else
  (( ${#item_n[@]} > 0 )) \
    || die "at least one --item (or --items-file) is required: a fix round with no delegated items has nothing to persist"
  # --- Build the items array deterministically with jq ---
  items_json="$(
    for i in "${!item_n[@]}"; do
      jq -n \
        --argjson n "${item_n[$i]}" \
        --arg text "${item_text[$i]}" \
        --arg reach "${item_reach[$i]}" \
        '{n: $n, text: $text, reach: $reach}'
    done | jq -s '.'
  )"
fi

# --- Protected additions: one blank-separated path list ---
# The delegation renders the same list after `Adds:`, so writer and delegation
# cannot drift. A blank IS the separator, so a path containing one is read as
# two paths and cannot be authorized as one; the delegation's Adds: line has
# the same limit, and both are stated that way in the docs.
#
# The paths travel as NUL-delimited data rather than as arguments, the same
# transport dev-artifact-check uses for the additions it refuses: a path that
# looks like an option would otherwise decide how it is read.
adds_json='[]'
if [[ "$adds_given" == "true" ]]; then
  read -r -a adds_paths <<< "$adds"
  adds_json="$(printf '%s\0' ${adds_paths[@]+"${adds_paths[@]}"} | jq -Rsc 'split("\u0000")[:-1]')" \
    || die "--adds '$adds' could not be recorded as a path list"
  jq -e '
    (length > 0)
    and all(.[];
          (startswith("/") | not)
          and (split("/") | all(. != "" and . != "." and . != "..")))
    and (length == (unique | length))
  ' <<<"$adds_json" >/dev/null 2>&1 \
    || die "--adds '$adds' must be unique repository-relative paths with no empty, '.', or '..' components"
fi

# --- Compute the absolute, round-scoped out path ---
mkdir -p "$worktree/tmp"
out_dir="$(cd "$worktree/tmp" && pwd)"
out="$out_dir/dev-round-$issue-$round_id.json"

out_exists=false
[[ -e "$out" || -L "$out" ]] && out_exists=true
[[ ! -L "$out" ]] \
  || die "round $issue/$round_id record path must not be a symlink"

# --- Write atomically: build a same-directory temporary file, then link it. ---
tmp="$(mktemp "$out_dir/.dev-round-$issue.XXXXXX")"
trap 'rm -f "$tmp"' EXIT

jq -n \
  --argjson schema_version 2 \
  --arg round_id "$round_id" \
  --arg issue "$issue" \
  --arg base_sha "$base_sha" \
  --argjson adds "$adds_json" \
  --argjson items "$items_json" \
  '{
     schema_version: $schema_version,
     round_id: $round_id,
     issue: $issue,
     base_sha: $base_sha,
     adds: $adds,
     items: $items
   }' > "$tmp"

# --- Same-round records are immutable ---
# The record is the authoritative delegated set for exactly one delegation.
# An identical re-invocation (a retry after an unclear failure) is idempotent;
# different content under the same token would silently rewrite what was
# delegated — e.g. a retry with a partial list shrinking the set the
# completion artifact is checked against. jq output is deterministic, so a
# byte comparison decides identity.
# Placement is ATOMIC create-if-absent, not check-then-move: a bare
# existence test races a concurrent retry (both observe absent, both mv,
# last write silently wins — exactly the rewrite this block forbids).
# ln(2) fails with EEXIST atomically, so exactly one contender places the
# record; every other lands in the comparison branch below, where an
# identical retry is idempotent and a divergent one refuses.
if [[ "$out_exists" == "true" ]]; then
  cmp -s "$tmp" "$out" \
    || die "round record $out already exists with different content — a changed delegation needs a NEW round id"
elif ! ln "$tmp" "$out" 2>/dev/null; then
  cmp -s "$tmp" "$out" \
    || die "round record $out raced with different content — mint a NEW round id"
fi

rm -f "$tmp"
trap - EXIT
printf '%s\n' "$out"
