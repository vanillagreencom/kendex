#!/usr/bin/env bash
# item-tier — the cycle a work item runs: micro, small or standard.
#
# Usage:
#   item-tier [--production N] [--floor CLASS] [--path PATH]...
#             [--base REF --head REF] [--repo DIR]
#
# Every input names a class, and the widest one wins, in the order
# micro < small < standard:
#
#   --production N   the overseer's launch-time estimate of the item's added
#                    production lines, against the micro_max_production and
#                    small_max_production ceilings in
#                    references/narrow-change.conf.
#   --floor CLASS    a class the item already holds: the tier a lane runs at,
#                    or the class above the one a run escaped from.
#   --path PATH      a file the item's **Location** names, classified through
#                    harness-ci's shared path rules. No render is proved at
#                    launch. A matched rule supplies its class and cause;
#                    an unmatched path leaves the other inputs unchanged.
#   --base, --head   the item's branch, classified by harness-ci's
#                    change-class through lib/change-class.sh. render and
#                    trivial count as micro. A class the classifier's
#                    `measured=` marker says it did not measure answers
#                    standard as classifier-unmeasured.
#
# At least one of --production, --floor and --base is required. --repo
# (default .) is the checkout the classifier reads. No `**Expected delta**`
# line is read here: that line is branch-size-check's optional allowance, and
# the estimate is the caller's.
#
# A ceiling list or a classifier this script cannot read answers standard,
# naming the cause, never a narrower class.
#
# stdout is one line, `tier=CLASS brief=VERB cause=CAUSE[ DETAIL]`. VERB is
# the orch command the launch brief runs: micro, small, or start for
# standard. CAUSE names the input that decided. Exit 2 is a usage or
# environment failure, its `item-tier-error: cause=` line naming which, and
# prints no tier.
set -euo pipefail
# The narrow-change list's globs are bash patterns with extglob on.
shopt -s extglob

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
NARROW_CONF="$SCRIPT_DIR/../references/narrow-change.conf"
# shellcheck source=lib/change-class.sh
. "$SCRIPT_DIR/lib/change-class.sh"

usage() { sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

die() { # CAUSE MESSAGE
  printf 'item-tier-error: cause=%s\n%s\n' "$1" "$2" >&2
  exit 2
}

need_value() { # FLAG REMAINING
  [ "$2" -ge 2 ] || die missing-value "$1 needs a value"
}

production=""
floor=""
base=""
head=""
repo="."
paths=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --production) need_value "$1" "$#"; production="$2"; shift 2 ;;
    --floor) need_value "$1" "$#"; floor="$2"; shift 2 ;;
    --path) need_value "$1" "$#"; paths+=("$2"); shift 2 ;;
    --base) need_value "$1" "$#"; base="$2"; shift 2 ;;
    --head) need_value "$1" "$#"; head="$2"; shift 2 ;;
    --repo) need_value "$1" "$#"; repo="$2"; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) die unknown-argument "unknown argument '$1'" ;;
  esac
done

case "$production" in
  '') ;;
  *[!0123456789]*) die invalid-production "--production must be a whole number" ;;
esac
case "$floor" in
  '' | micro | small | standard) ;;
  *) die invalid-floor "--floor must be micro, small or standard" ;;
esac
if { [ -n "$base" ] && [ -z "$head" ]; } || { [ -z "$base" ] && [ -n "$head" ]; }; then
  die range-incomplete "--base and --head are given together"
fi
[ -n "$production" ] || [ -n "$floor" ] || [ -n "$base" ] ||
  die no-input "name --production, --floor or --base"

rank() { # CLASS
  case "$1" in
    micro) echo 0 ;;
    small) echo 1 ;;
    standard) echo 2 ;;
    *) die internal-class "no rank for class '$1'" ;;
  esac
}

tier=""
cause=""
# The first input naming the widest class decides, and names the cause.
consider() { # CLASS CAUSE
  if [ -z "$tier" ] || [ "$(rank "$1")" -gt "$(rank "$tier")" ]; then
    tier="$1"
    cause="$2"
  fi
}

# The ceilings, read once and only when an estimate needs them.
micro_max=""
small_max=""
conf_cause=""
read_conf() {
  [ -r "$NARROW_CONF" ] || { conf_cause="narrow-change-unreadable"; return 1; }
  micro_max="$(sed -n 's/^micro_max_production=\([0123456789][0123456789]*\)$/\1/p' "$NARROW_CONF" | tail -1)" &&
    small_max="$(sed -n 's/^small_max_production=\([0123456789][0123456789]*\)$/\1/p' "$NARROW_CONF" | tail -1)" ||
    { conf_cause="narrow-change-unreadable"; return 1; }
  [ -n "$micro_max" ] && [ -n "$small_max" ] ||
    { conf_cause="narrow-change-ceilings-missing"; return 1; }
}

if [ -n "$production" ]; then
  if ! read_conf; then
    consider standard "$conf_cause"
  elif [ "$production" -le "$micro_max" ]; then
    consider micro "estimate-within-micro production=$production"
  elif [ "$production" -le "$small_max" ]; then
    consider small "estimate-within-small production=$production"
  else
    consider standard "estimate-past-small production=$production"
  fi
fi

if [ "${#paths[@]}" -gt 0 ]; then
  if change_class_location_load; then
    for path in "${paths[@]}"; do
      change_class_path "$path" launch
      [ -z "$CHANGE_CLASS_PATH" ] || consider "$CHANGE_CLASS_PATH" "$CHANGE_CLASS_PATH_CAUSE"
    done
  else
    consider standard "$CHANGE_CLASS_CAUSE"
  fi
fi

[ -z "$floor" ] || consider "$floor" "floor class=$floor"

if [ -n "$base" ]; then
  class_err="$(mktemp "${TMPDIR:-/tmp}/item-tier-class.XXXXXX")" ||
    die scratch-unavailable "a scratch file for the classifier's log could not be created"
  trap 'rm -f -- "$class_err"' EXIT
  if change_class_read "$base" "$head" "$repo" "$class_err"; then
    # standard is both a verdict and the classifier's fallback; only the
    # `measured=` marker on its `class:` line tells them apart.
    # A log that cannot be read carries no marker, which is unmeasured.
    measured=""
    unmeasured=""
    if ! measured="$(sed -n 's/^class: class=[a-z]* measured=\([a-z]*\).*/\1/p' "$class_err" | tail -1)" ||
      [ "$measured" != true ]; then
      cat -- "$class_err" >&2
      if ! unmeasured="$(sed -n 's/^class: class=[a-z]* measured=[a-z]* //p' "$class_err" | tail -1)"; then
        unmeasured=""
      fi
      consider standard "classifier-unmeasured detail=${unmeasured:-no-marker}"
    else
      case "$CHANGE_CLASS" in
        render | trivial | micro) consider micro "classifier class=$CHANGE_CLASS" ;;
        small | standard) consider "$CHANGE_CLASS" "classifier class=$CHANGE_CLASS" ;;
        *) consider standard "classifier-unreadable class=$CHANGE_CLASS" ;;
      esac
    fi
  else
    cat -- "$class_err" >&2
    consider standard "classifier-failed detail=$CHANGE_CLASS_CAUSE"
  fi
fi

case "$tier" in
  micro) brief=micro ;;
  small) brief=small ;;
  standard) brief=start ;;
  *) die internal-tier "no tier was decided" ;;
esac
printf 'tier=%s brief=%s cause=%s\n' "$tier" "$brief" "$cause"
