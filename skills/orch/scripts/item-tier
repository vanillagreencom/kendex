#!/usr/bin/env bash
# item-tier — the cycle a work item runs: micro, small or standard.
#
# Usage:
#   item-tier [--production N] [--body FILE] [--floor CLASS] [--path PATH]...
#             [--base REF --head REF] [--repo DIR]
#
# Every input names a class, and the widest one wins, in the order
# micro < small < standard:
#
#   --production N   the overseer's launch-time estimate of the item's added
#                    production lines, against the micro_max_production and
#                    small_max_production ceilings in
#                    references/narrow-change.conf.
#   --floor CLASS    a class the item already holds: the tier a lane runs at,
#                    or the class above the one a run escaped from.
#   --path PATH      a file the item's **Location** names, classified through
#                    harness-ci's shared path rules. No render is proved at
#                    launch. A matched rule supplies its class and cause;
#                    an unmatched path leaves the other inputs unchanged.
#   --base, --head   the item's changed paths. The shared path rules apply;
#                    measured branch line counts never select a tier. A
#                    SKILL.md whose one changed line is its frontmatter's
#                    metadata.version is no instruction-file edit.
#
# --body reads Expected delta through lib/branch-growth.sh and floors the
# launch estimate with a valid production count. A malformed header is
# ignored. With no Location paths, estimate or valid delta, launch is standard.
# At least one of --production, --body, --floor and --base is required.
# --repo (default .) is the checkout the classifier reads.
#
# A ceiling list or a classifier this script cannot read answers standard,
# naming the cause, never a narrower class.
#
# stdout is one line, `tier=CLASS brief=VERB cause=CAUSE[ DETAIL] estimate=N delta=N paths=N`.
# open-terminal records these inputs from the launch brief. Missing counts
# print `-`; paths is the count of --path arguments. VERB is
# the orch command the launch brief runs: micro, small, or start for
# standard. CAUSE names the input that decided. Exit 2 is a usage or
# environment failure, its `item-tier-error: cause=` line naming which, and
# prints no tier.
set -euo pipefail
# The narrow-change list's globs are bash patterns with extglob on.
shopt -s extglob

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
NARROW_CONF="$SCRIPT_DIR/../references/narrow-change.conf"
# shellcheck source=lib/change-class.sh
. "$SCRIPT_DIR/lib/change-class.sh"
# shellcheck source=lib/branch-growth.sh
. "$SCRIPT_DIR/lib/branch-growth.sh"

usage() { sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'; }

die() { # CAUSE MESSAGE
  printf 'item-tier-error: cause=%s\n%s\n' "$1" "$2" >&2
  exit 2
}

need_value() { # FLAG REMAINING
  [ "$2" -ge 2 ] || die missing-value "$1 needs a value"
}

production=""
body=""
floor=""
base=""
head=""
repo="."
paths=()
while [ "$#" -gt 0 ]; do
  case "$1" in
    --production) need_value "$1" "$#"; production="$2"; shift 2 ;;
    --body) need_value "$1" "$#"; body="$2"; shift 2 ;;
    --floor) need_value "$1" "$#"; floor="$2"; shift 2 ;;
    --path) need_value "$1" "$#"; paths+=("$2"); shift 2 ;;
    --base) need_value "$1" "$#"; base="$2"; shift 2 ;;
    --head) need_value "$1" "$#"; head="$2"; shift 2 ;;
    --repo) need_value "$1" "$#"; repo="$2"; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) die unknown-argument "unknown argument '$1'" ;;
  esac
done

case "$production" in
  '') ;;
  *[!0123456789]*) die invalid-production "--production must be a whole number" ;;
esac
case "$floor" in
  '' | micro | small | standard) ;;
  *) die invalid-floor "--floor must be micro, small or standard" ;;
esac
if { [ -n "$base" ] && [ -z "$head" ]; } || { [ -z "$base" ] && [ -n "$head" ]; }; then
  die range-incomplete "--base and --head are given together"
fi
[ -n "$production" ] || [ -n "$body" ] || [ -n "$floor" ] || [ -n "$base" ] ||
  die no-input "name --production, --body, --floor or --base"

estimate="$production"
delta=""
if [ -n "$body" ]; then
  body_text="$(cat -- "$body")" || die body-unreadable "cannot read --body '$body'"
  expected_delta_read "$body_text" || EXPECTED_DELTA_PRODUCTION=""
  delta="$EXPECTED_DELTA_PRODUCTION"
  if [ -n "$delta" ] && { [ -z "$production" ] || [ "$delta" -gt "$production" ]; }; then
    production="$delta"
  fi
fi

rank() { # CLASS
  case "$1" in
    micro) echo 0 ;;
    small) echo 1 ;;
    standard) echo 2 ;;
    *) die internal-class "no rank for class '$1'" ;;
  esac
}

tier=""
cause=""
# The first input naming the widest class decides, and names the cause.
consider() { # CLASS CAUSE
  if [ -z "$tier" ] || [ "$(rank "$1")" -gt "$(rank "$tier")" ]; then
    tier="$1"
    cause="$2"
  fi
}

if [ -n "$body" ] && [ -z "$delta" ] && [ -z "$production" ] && [ "${#paths[@]}" -eq 0 ]; then
  consider standard body-without-tier-inputs
fi

# The ceilings, read once and only when an estimate needs them.
micro_max=""
small_max=""
conf_cause=""
read_conf() {
  [ -r "$NARROW_CONF" ] || { conf_cause="narrow-change-unreadable"; return 1; }
  micro_max="$(sed -n 's/^micro_max_production=\([0123456789][0123456789]*\)$/\1/p' "$NARROW_CONF" | tail -1)" &&
    small_max="$(sed -n 's/^small_max_production=\([0123456789][0123456789]*\)$/\1/p' "$NARROW_CONF" | tail -1)" ||
    { conf_cause="narrow-change-unreadable"; return 1; }
  [ -n "$micro_max" ] && [ -n "$small_max" ] ||
    { conf_cause="narrow-change-ceilings-missing"; return 1; }
}

if [ -n "$production" ]; then
  if ! read_conf; then
    consider standard "$conf_cause"
  elif [ "$production" -le "$micro_max" ]; then
    consider micro "estimate-within-micro production=$production"
  elif [ "$production" -le "$small_max" ]; then
    consider small "estimate-within-small production=$production"
  else
    consider standard "estimate-past-small production=$production"
  fi
fi

if [ "${#paths[@]}" -gt 0 ]; then
  if change_class_location_load; then
    for path in "${paths[@]}"; do
      change_class_path "$path" launch
      [ -z "$CHANGE_CLASS_PATH" ] || consider "$CHANGE_CLASS_PATH" "$CHANGE_CLASS_PATH_CAUSE"
    done
  else
    consider standard "$CHANGE_CLASS_CAUSE"
  fi
fi

[ -z "$floor" ] || consider "$floor" "floor class=$floor"

# Every catalog package change raises metadata.version in its SKILL.md, and
# its tracked render repeats that line; the raise changes no instruction an
# agent reads. Both sides of the range's diff go to lib/change-class.sh's
# metadata_version_only, whose header entry says what it compares; a change
# it does not answer as version-only, or a side that cannot be read, counts
# as an instruction-file edit.
version_raise_only() { # PATH
  case "$1" in SKILL.md | */SKILL.md) ;; *) return 1 ;; esac
  local merge_base
  merge_base="$(git -C "$repo" merge-base "$base" "$head")" &&
    git -C "$repo" show "$merge_base:$1" >"$scratch/old" 2>/dev/null &&
    git -C "$repo" show "$head:$1" >"$scratch/new" 2>/dev/null || return 1
  metadata_version_only "$scratch/old" "$scratch/new"
}

if [ -n "$base" ]; then
  scratch="$(mktemp -d "${TMPDIR:-/tmp}/item-tier.XXXXXX")" ||
    die scratch-unavailable "could not create a directory for changed paths"
  trap 'rm -rf -- "${scratch:?}"' EXIT
  range_paths="$scratch/paths"
  if ! git -C "$repo" diff --name-only -z --no-ext-diff --no-renames "$base...$head" -- >"$range_paths"; then
    consider standard branch-paths-unreadable
  elif ! change_class_location_load; then
    consider standard "$CHANGE_CLASS_CAUSE"
  else
    consider micro branch-paths
    while IFS= read -r -d '' path; do
      change_class_path "$path" launch
      case "$CHANGE_CLASS_PATH_CAUSE" in
        instruction-file\ *) ! version_raise_only "$path" || continue ;;
      esac
      [ -z "$CHANGE_CLASS_PATH" ] || consider "$CHANGE_CLASS_PATH" "$CHANGE_CLASS_PATH_CAUSE"
    done <"$range_paths"
  fi
fi

case "$tier" in
  micro) brief=micro ;;
  small) brief=small ;;
  standard) brief=start ;;
  *) die internal-tier "no tier was decided" ;;
esac
printf 'tier=%s brief=%s cause=%s estimate=%s delta=%s paths=%s\n' \
  "$tier" "$brief" "$cause" "${estimate:--}" "${delta:--}" "${#paths[@]}"
