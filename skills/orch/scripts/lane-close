#!/usr/bin/env bash
# Close one recorded tmux lane, its hosted sandbox, and its fleet record.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
WORKFLOW_STATE="$SCRIPT_DIR/workflow-state"
LANE_HOST="$SCRIPT_DIR/lane-host"
LANE_MAIL="$SCRIPT_DIR/lane-mail"
DEV_VALIDATE_RUN="$SCRIPT_DIR/dev-validate-run"
LINEAR="$SCRIPT_DIR/../../linear/scripts/linear.sh"
source "$SCRIPT_DIR/lib/lane-state.sh"

message() { # REASON FIELD=VALUE...
  local reason="$1" field
  shift
  printf 'lane-close: %s' "$reason"
  for field in "$@"; do printf ' %s' "$field"; done
  printf '\n'
  case "$reason" in
    argument-count) printf '%s\n' 'Specify one lane item.' ;;
    missing-value) printf '%s\n' 'The option requires a value.' ;;
    record-missing) printf '%s\n' 'No fleet lane record names this item.' ;;
    record-invalid) printf '%s\n' 'The lane record lacks a value required for safe close-out, or an option contradicts one it carries.' ;;
    pane-missing) printf '%s\n' 'No tmux pane carries the recorded window name.' ;;
    pane-ambiguous) printf '%s\n' 'More than one tmux pane carries the recorded window name.' ;;
    pane-read-failed) printf '%s\n' 'The lane pane could not be read.' ;;
    lane-live) printf '%s\n' 'The lane is not finished. Close-out changed nothing.' ;;
    tracker-read-failed)
      printf '%s\n' \
        'The tracker state could not be read. Close-out changed nothing. cause names which read did not answer:' \
        '  key-ambiguous   the item key issue-N is what a github lane and a linear lane are both keyed by, so it names no tracker. Pass --tracker linear|github, and --repo OWNER/REPO with github.' \
        '  key-not-issue   the item key is not issue-N, so it carries no github issue number. Close it under its own tracker.' \
        '  repo-missing    the github lane has no repository. Pass --repo OWNER/REPO.' \
        '  read-failed     the tracker CLI failed. Its own words are on the lines above this one.' \
        '  cli-missing     the linear CLI is not executable beside this script.' \
        '  payload-unparsed  the linear CLI answered something that is not JSON.' \
        '  no-state-type   the linear payload carried no state_type, so it answered nothing.' \
        '  tracker-unknown  tracker is neither linear nor github. Pass --tracker linear|github.' \
        'source=derived is a tracker read from the item key rather than from the record or --tracker, and source=given is one of those two.' ;;
    harness-unsupported) printf '%s\n' 'The recorded harness has no close-out path. harness=unknown is a record that carries none: pass --harness claude|codex|pi.' ;;
    ask-unanswered) printf '%s\n' 'The lane asked the overseer a question and is waiting for the answer. Closing it would end the session that answer would reach. Answer the ask, then close the lane.' ;;
    mail-read-failed) printf '%s\n' 'The lane mailbox could not be read, so nothing here says whether the lane asked anything. Close-out changed nothing.' ;;
    tmux-failed) printf '%s\n' 'A tmux operation failed. Close-out stopped.' ;;
    stop-failed)
      printf '%s\n' \
        'The harness could not be stopped by signal. Close-out stopped. cause names the step:' \
        '  provider          the lane host stop verb exited with status; its own words are on the lines above this one.' \
        '                    status=4 under --keep-sandbox is an item whose worktree is gone; only a full close skips that stop.' \
        '  answer-unparsed   the lane host stop verb succeeded without its stopped item=ID processes=COUNT line.' \
        '  any other value   the local stop step lib/lane-state.sh lane_stop_owned names, pid= the process it failed on.' ;;
    stop-skipped) printf '%s\n' "The lane host answered that the item's worktree is gone, so no harness process can be found by its directory. The host close below ends the harness where the provider's close ends the sandbox; otherwise the window close hangs up the lane's ssh session, which ends it. A static host's close ends no process." ;;
    exit-timeout) printf '%s\n' 'The pane did not read exited before the close timeout. processes= is how many harness processes the stop signalled in the lane worktree and saw exit; 0 means none was left there to signal. Close-out stopped.' ;;
    state-write-failed) printf '%s\n' 'The lane closed, but its fleet record could not be updated.' ;;
    prepare-stop-failed) printf '%s\n' 'The background launch job the record names could not be stopped. Close-out changed nothing else.' ;;
    validate-stop-failed) printf '%s\n' "A validation run in the lane's worktree could not be ended. The window and record are unchanged; dev-validate-run's own words are on the lines above this one." ;;
    helper-missing) printf '%s\n' 'The required helper is not executable. Close-out changed nothing.' ;;
    stopped) printf '%s\n' 'The lane window closed and its sandbox was kept.' ;;
    closed) printf '%s\n' 'The lane, sandbox and fleet record closed.' ;;
  esac
}

usage() {
  cat <<'EOF'
Usage: lane-close [--state-dir PATH] [--keep-sandbox]
                  [--harness claude|codex|pi] [--tracker linear|github]
                  [--repo OWNER/REPO] ITEM

Close one lane recorded in the oversee workflow state. The command refuses a
live lane. It accepts an exited lane, or an idle lane whose tracker item is
terminal. An idle lane's harness is ended by SIGTERM, never by typing into its
pane: through lane-host stop for a record carrying host, and for a local lane
by the same stop against the worktree the record's mail_root names. The close
then waits up to ORCH_LANE_CLOSE_SECS (default 15) for the pane to read exited.
A hosted stop answering status 4, the item's worktree already removed by its
own close-out, prints stop-skipped cause=worktree-removed and goes straight to
the host close and window kill. The host close ends the harness where the
provider's close ends the sandbox; otherwise the window kill hangs up the
lane's ssh session, which ends it, as a static host's close ends no process.
Under --keep-sandbox, where no host close follows, that answer refuses as
stop-failed.
The local stop reads each harness process's directory through /proc, or
through lsof on a host without /proc such as macOS; a host with neither
refuses as stop-failed cause=cwd-reader-missing.
A record already marked stopped can close its kept sandbox without a pane. A
preparing record, a hosted launch whose background job has written no
outcome, closes without a harness exit: the job the record names is stopped
and its window closed. --keep-sandbox ends the harness, closes its window and
records stopped without closing the lane host.
A local lane's close also ends every validation run its worktree, the record's
mail_root, holds with no verdict, through dev-validate-run --stop; a hosted
lane's runs end with its sandbox.

A lane holding an ask nobody has answered refuses as ask-unanswered, under
--keep-sandbox and on a stopped record alike: the answer would reach a session
this is about to end. An exited lane takes no such refusal, its session being
gone already. A kept sandbox can be relaunched into a session that reads the
reply, which is why the two differ: --keep-sandbox on an exited lane records
stopped and refuses nothing, and the full close of that stopped record refuses
until the ask is answered. Answering is the one thing that lifts it. A mailbox
that cannot be read refuses as mail-read-failed.

The recorded window resolves in either form tmux accepts: a bare window name
on this server, or SESSION:WINDOW, whose session name must match exactly.

--harness, --tracker and --repo supply a lane identity for a record written
before the launcher recorded one. Each fills only a field the record leaves
null or absent; the record wins where it carries a value, and an option that
contradicts one refuses as record-invalid. An exited lane needs none of them.

A field neither the record nor an option carries is read from the lane where
the lane answers it: tracker from the item key, linear for a tracker
identifier, and harness from the pane's own foreground command. repo is read
from nothing, so a github lane whose record carries none still needs --repo. A
derived value never beats a recorded or a supplied one, and a pane running a
wrapper rather than the harness itself leaves harness underived.

An issue-N key derives nothing. It is what a github lane is keyed by and what
a linear lane is keyed by wherever GH_ISSUE_PATTERN accepts that spelling, so
a record under that key carrying no tracker refuses as key-ambiguous and takes
--tracker linear|github, plus --repo for a github lane. Where the key does
answer, --tracker only pins what it says; a value that disagrees with the key
reaches a tracker read that cannot answer, and refuses naming that cause. The
identity a caller still supplies is --tracker for an issue-N record that
carries none, --repo for a github lane and --harness for a lane whose pane
runs a wrapper.
EOF
}

need_value() {
  [[ $# -ge 2 && -n "${2:-}" ]] || { message missing-value "option=$1" >&2; exit 2; }
}

STATE_DIR=""
KEEP_SANDBOX=false
OPT_HARNESS=""
OPT_TRACKER=""
OPT_REPO=""
ITEM=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --state-dir) need_value "$@"; STATE_DIR="$2"; shift 2 ;;
    --state-dir=*) STATE_DIR="${1#--state-dir=}"; need_value --state-dir "$STATE_DIR"; shift ;;
    --harness) need_value "$@"; OPT_HARNESS="$2"; shift 2 ;;
    --harness=*) OPT_HARNESS="${1#--harness=}"; need_value --harness "$OPT_HARNESS"; shift ;;
    --tracker) need_value "$@"; OPT_TRACKER="$2"; shift 2 ;;
    --tracker=*) OPT_TRACKER="${1#--tracker=}"; need_value --tracker "$OPT_TRACKER"; shift ;;
    --repo) need_value "$@"; OPT_REPO="$2"; shift 2 ;;
    --repo=*) OPT_REPO="${1#--repo=}"; need_value --repo "$OPT_REPO"; shift ;;
    --keep-sandbox) KEEP_SANDBOX=true; shift ;;
    --help|-h) usage; exit 0 ;;
    --*) message argument-count "value=$1" >&2; usage >&2; exit 2 ;;
    *)
      [[ -z "$ITEM" ]] || { message argument-count "count=2" >&2; usage >&2; exit 2; }
      ITEM="$1"
      shift ;;
  esac
done
[[ -n "$ITEM" ]] || { message argument-count "count=0" >&2; usage >&2; exit 2; }

STATE_ARGS=()
[[ -z "$STATE_DIR" ]] || STATE_ARGS=(--state-dir "$STATE_DIR")
command -v jq >/dev/null 2>&1 || { message record-invalid "item=$ITEM" "field=jq" >&2; exit 1; }
[[ -x "$WORKFLOW_STATE" ]] || { message record-invalid "item=$ITEM" "field=workflow-state" >&2; exit 1; }

records="$($WORKFLOW_STATE ${STATE_ARGS[@]+"${STATE_ARGS[@]}"} get oversee '.lanes // []')" \
  || { message record-missing "item=$ITEM" >&2; exit 1; }
if ! count="$(jq -r --arg item "$ITEM" '[.[] | select(.item == $item)] | length' <<<"$records")"; then
  message record-invalid "item=$ITEM" "field=record" >&2
  exit 1
fi
[[ "$count" == 1 ]] || { message record-missing "item=$ITEM" "count=$count" >&2; exit 1; }
record="$(jq -c --arg item "$ITEM" '.[] | select(.item == $item)' <<<"$records")" \
  || { message record-invalid "item=$ITEM" "field=record" >&2; exit 1; }

record_field() { jq -r --arg field "$1" '.[$field] // empty' <<<"$record"; }

# The lane identity this close-out needs, taken from the record and, where the
# record has none, from the launch options. A record the launcher wrote before
# it recorded tracker, repo and harness leaves those null, and its idle lane
# would otherwise have no close-out at all. The RECORD wins wherever it carries
# a value: an option that would repoint a recorded lane at another harness,
# tracker or repository refuses instead, because the operator supplying it and
# the record disagree about which lane this is.
resolve_identity() { # OUT_VAR FIELD RECORDED SUPPLIED
  local recorded="$3" supplied="$4"
  if [[ -n "$recorded" && -n "$supplied" && "$recorded" != "$supplied" ]]; then
    message record-invalid "item=$ITEM" "field=$2" "recorded=$recorded" "option=$supplied" >&2
    exit 1
  fi
  printf -v "$1" '%s' "${recorded:-$supplied}"
}

# What the lane itself answers for a field the record and the options both
# leave empty. It fills only an empty field, so the precedence above stands
# whole: recorded, then supplied, then this. A derivation that cannot answer
# leaves the field empty and its existing refusal reached.
#
# The outcome is published rather than returned: a refusal naming where a value
# came from reads it, and every other call site is a plain statement whose
# status errexit would act on.
DERIVE_IDENTITY_FILLED=0
derive_identity() { # OUT_VAR DERIVED
  DERIVE_IDENTITY_FILLED=0
  [[ -z "${!1}" ]] || return 0
  printf -v "$1" '%s' "$2"
  DERIVE_IDENTITY_FILLED=1
}

status="$(record_field status)"
window_name="$(record_field window)"
mail_root="$(record_field mail_root)"
host="$(record_field host)"
resolve_identity tracker tracker "$(record_field tracker)" "$OPT_TRACKER"
resolve_identity repo repo "$(record_field repo)" "$OPT_REPO"
resolve_identity harness harness "$(record_field harness)" "$OPT_HARNESS"
# The item key answers the tracker for one of its two shapes and not the other,
# by lib/lane-state.sh's rule; the repository stays --repo's alone.
derive_identity tracker "$(lane_key_tracker "$ITEM")"
tracker_source=given
[[ "$DERIVE_IDENTITY_FILLED" -eq 0 ]] || tracker_source=derived

case "$status" in
  done)
    message closed "item=$ITEM" "status=done"
    exit 0 ;;
  running|stopped|preparing) ;;
  *) message record-invalid "item=$ITEM" "field=status" >&2; exit 1 ;;
esac
[[ -n "$mail_root" ]] || { message record-invalid "item=$ITEM" "field=mail_root" >&2; exit 1; }

update_status() { # STATUS
  "$WORKFLOW_STATE" ${STATE_ARGS[@]+"${STATE_ARGS[@]}"} update oversee \
    --arg item "$ITEM" --arg status "$1" \
    'if any(.lanes[]; .item == $item) then (.lanes[] | select(.item == $item) | .status) = $status else error("lane record disappeared") end' \
    >/dev/null
}

# A lane that stops to ask the overseer something waits for the answer inside
# the session this close-out ends. Closing it takes the question with the
# session: the overseer answers into a mailbox nobody reads again, and the
# question the lane stopped to ask is never answered. The mailbox is the only
# record of that, so a read that fails refuses too — one this cannot read is
# not a lane with nothing to say.
refuse_unanswered_ask() {
  local out rc=0 summary ask_count ask_id epoch now age=unknown args
  [[ -x "$LANE_MAIL" ]] || { message record-invalid "item=$ITEM" "field=lane-mail" >&2; exit 1; }
  args=(pending --item "$ITEM" --root "$mail_root")
  [[ -z "$host" ]] || args+=(--host)
  out="$(ORCH_LANE_HOST="$host" "$LANE_MAIL" "${args[@]}")" || rc=$?
  [[ "$rc" -eq 0 ]] \
    || { message mail-read-failed "item=$ITEM" "root=$mail_root" "status=$rc" >&2; exit 1; }
  [[ -n "$out" ]] || return 0
  # `pending` lists the lane's unread directives too, which the lane owes
  # nothing to the overseer for; only an ask is waiting on an answer.
  summary="$(jq -r -R -s 'split("\n") | map(fromjson? | objects | select(.kind == "ask")) | "\(length)\t\(.[0].id // "")"' <<<"$out")" \
    || { message mail-read-failed "item=$ITEM" "root=$mail_root" "status=parse" >&2; exit 1; }
  IFS=$'\t' read -r ask_count ask_id <<<"$summary"
  [[ "$ask_count" -gt 0 ]] || return 0
  # lane-mail mints an ask id as <epoch>-<pid>-<random>, so the oldest ask
  # carries the second it was asked and how long the lane has waited needs no
  # date parser here. An id outside that grammar still refuses, with the wait
  # unmeasured rather than guessed.
  epoch="${ask_id%%-*}"
  if [[ "$epoch" =~ ^[0-9]+$ ]] && now="$(date -u +%s)"; then age="$((now - epoch))s"; fi
  message ask-unanswered "item=$ITEM" "ask=$ask_id" "age=$age" "count=$ask_count" >&2
  exit 1
}

close_host() {
  local rc=0 out err
  [[ -n "$host" ]] || return 0
  [[ -x "$LANE_HOST" ]] || { message record-invalid "item=$ITEM" "field=lane-host" >&2; return 1; }
  out="$(mktemp)" || return 1
  err="$(mktemp)" || { rm -f -- "$out"; return 1; }
  ORCH_LANE_HOST="$host" "$LANE_HOST" close --item "$ITEM" >"$out" 2>"$err" || rc=$?
  cat -- "$out"
  cat -- "$err" >&2
  if [[ "$rc" -eq 0 ]] && ! grep -q '^kept=' "$out"; then printf 'kept=none\n'; fi
  rm -f -- "$out" "$err"
  return "$rc"
}

# A validation the lane started goes on after its session ends, and nothing
# would ever read its verdict. A local lane's mail_root is its worktree, as
# open-terminal records it; one that is no directory on this disk holds no run
# this could stop.
stop_validations() {
  local rc=0
  [[ -d "$mail_root" ]] || return 0
  [[ -x "$DEV_VALIDATE_RUN" ]] || { message helper-missing "item=$ITEM" "path=$DEV_VALIDATE_RUN" >&2; exit 1; }
  "$DEV_VALIDATE_RUN" --stop --worktree "$mail_root" >/dev/null || rc=$?
  [[ "$rc" -eq 0 ]] \
    || { message validate-stop-failed "item=$ITEM" "worktree=$mail_root" "status=$rc" >&2; exit 1; }
}

pane_still_exists() {
  local listed
  listed="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null)" || return 2
  awk -v pane="$pane_id" '$0 == pane { found=1 } END { exit !found }' <<<"$listed"
}

# The end of every close-out: a local lane's validations ended, the host closed
# unless --keep-sandbox, the window closed where pane_id names one tmux still
# lists, then the record and the line naming the outcome, pane= carried where
# the close had a pane.
pane_id=""
finish_close() {
  local next_status=done pane_rc=0 fields=("item=$ITEM")
  [[ -n "$host" ]] || stop_validations
  if [[ "$KEEP_SANDBOX" == true ]]; then next_status=stopped; else close_host || exit $?; fi
  if [[ -n "$pane_id" ]]; then
    pane_still_exists || pane_rc=$?
    case "$pane_rc" in
      0) tmux kill-window -t "$pane_id" \
           || { message tmux-failed "item=$ITEM" "operation=kill-window" "pane=$pane_id" >&2; exit 1; } ;;
      1) ;;
      *) message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1 ;;
    esac
    fields+=("pane=$pane_id")
  fi
  update_status "$next_status" \
    || { message state-write-failed "item=$ITEM" "status=$next_status" >&2; exit 1; }
  if [[ "$next_status" == stopped ]]; then message stopped "${fields[@]}" "status=stopped"
  else message closed "${fields[@]}" "status=done"; fi
  exit 0
}

# A stopped record means an earlier --keep-sandbox call already exited the
# harness and removed its window. Only the kept sandbox and the record remain.
if [[ "$status" == stopped ]]; then
  # The sandbox is kept, so this lane can still be relaunched into the session
  # an answer would reach. Its ask is owed a reply before the record closes.
  refuse_unanswered_ask
  if [[ "$KEEP_SANDBOX" == true ]]; then
    message stopped "item=$ITEM" "status=stopped"
    exit 0
  fi
  finish_close
fi

# The recorded window resolves through the shared owner, which accepts the
# bare and SESSION:WINDOW forms alike and reports which silence it met. A read
# that fails and a name two panes carry refuse; RESOLVED_PANE is the one pane,
# empty where no pane carries the name.
RESOLVED_PANE=""
resolve_window() {
  local rc=0
  lane_pane_resolve "$window_name" || rc=$?
  [[ "$rc" -ne 2 ]] \
    || { message pane-read-failed "item=$ITEM" "window=$window_name" >&2; exit 1; }
  case "$LANE_PANE_COUNT" in
    0) ;;
    1) RESOLVED_PANE="$LANE_PANE_ID" ;;
    *) message pane-ambiguous "item=$ITEM" "window=$window_name" "count=$LANE_PANE_COUNT" >&2; exit 1 ;;
  esac
}

# A preparing record is a hosted launch open-terminal handed to a background
# job that has written no outcome, so no session was started and no harness is
# exited. A lane with no session cannot hold an ask, and the host need not have
# its mailbox until its preparation ends, so no mailbox is read. The job is stopped by the process group the record names, where
# that group still runs open-terminal, a pid since reused being left alone; the
# window it holds is closed with its claim; the host is closed or kept as for a
# stopped record.
if [[ "$status" == preparing ]]; then
  [[ -z "$window_name" ]] || resolve_window
  job="$(jq -r '.prepare.pid // empty' <<<"$record")"
  if [[ "$job" =~ ^[1-9][0-9]*$ ]] && job_cmd="$(ps -o command= -p "$job")" && [[ "$job_cmd" == *open-terminal* ]]; then
    kill -TERM -- "-$job" || { message prepare-stop-failed "item=$ITEM" "pid=$job" >&2; exit 1; }
  fi
  pane_id="$RESOLVED_PANE"
  finish_close
fi

[[ -n "$window_name" ]] || { message record-invalid "item=$ITEM" "field=window" >&2; exit 1; }

resolve_window
[[ -n "$RESOLVED_PANE" ]] || { message pane-missing "item=$ITEM" "window=$window_name" >&2; exit 1; }
pane_id="$LANE_PANE_ID"
pane_pid="$LANE_PANE_PID"
pane_cmd="$LANE_PANE_CMD"
# The harness is the pane's own foreground command wherever the pane runs it
# directly. A lane started by typing a wrapper at an interactive prompt keeps
# that shell as the pane process and the harness as its child, so this answers
# for the direct launches and leaves the rest to --harness.
case "$pane_cmd" in
  claude|codex|pi) derive_identity harness "$pane_cmd" ;;
esac
pane_screen="$(tmux capture-pane -pJ -t "$pane_id" 2>/dev/null)" \
  || { message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1; }
lane_state state listed "$pane_cmd" "$pane_pid" "$pane_screen" \
  || { message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1; }

# One tracker CLI call, its own words kept for the refusal and dropped on
# success: a close that works stays quiet, and one that does not says what the
# CLI said rather than swallowing it. Status 0 with OUT_VAR set, or 1 with that
# stderr already relayed.
tracker_read() { # OUT_VAR COMMAND...
  local _tr_out _tr_err _tr_rc=0
  _tr_err="$(mktemp)" || return 1
  _tr_out="$("${@:2}" 2>"$_tr_err")" || _tr_rc=$?
  [[ "$_tr_rc" -eq 0 ]] || cat -- "$_tr_err" >&2
  rm -f -- "${_tr_err:?}"
  [[ "$_tr_rc" -eq 0 ]] || return 1
  printf -v "$1" '%s' "$_tr_out"
}

# Whether the work item is finished and, where that is not an answer, WHY. The
# several ways this read fails to answer are one status to the caller and
# distinct words to the operator, so the refusal names the cause rather than
# asserting one of them. TRACKER_CAUSE carries it on every status 2.
TRACKER_CAUSE=""
tracker_terminal() {
  local value number
  TRACKER_CAUSE=""
  case "$tracker" in
    linear)
      [[ -x "$LINEAR" ]] || { TRACKER_CAUSE=cli-missing; return 2; }
      tracker_read value "$LINEAR" issues get "$ITEM" --format=safe \
        || { TRACKER_CAUSE=read-failed; return 2; }
      # Terminality is the stable state_type, never the display name: a team
      # renames Done or Canceled freely, and a renamed terminal state read by
      # name would hold a finished lane open. A payload carrying no state_type
      # answered nothing, so it reads as a failed tracker read, not as work
      # still running.
      value="$(jq -r '.state_type // empty' <<<"$value")" || { TRACKER_CAUSE=payload-unparsed; return 2; }
      [[ -n "$value" ]] || { TRACKER_CAUSE=no-state-type; return 2; }
      [[ "$value" == completed || "$value" == canceled ]] ;;
    github)
      # The key is read before the repository: an item whose key is not issue-N
      # carries no issue number at all, which no repository supplies.
      [[ "$ITEM" == issue-* ]] || { TRACKER_CAUSE=key-not-issue; return 2; }
      [[ -n "$repo" ]] || { TRACKER_CAUSE=repo-missing; return 2; }
      number="${ITEM#issue-}"
      tracker_read value gh issue view "$number" --repo "$repo" --json state --jq .state \
        || { TRACKER_CAUSE=read-failed; return 2; }
      [[ "$value" == CLOSED ]] ;;
    # An empty tracker under an issue-N key is the derivation declining, not an
    # unrecognised value: both trackers spell a key that way, so the caller is
    # asked which one rather than told the tracker is unknown.
    *)
      TRACKER_CAUSE=tracker-unknown
      [[ -n "$tracker" || "$ITEM" != issue-* ]] || TRACKER_CAUSE=key-ambiguous
      return 2 ;;
  esac
}

case "$state" in
  exited) ;;
  idle)
    tracker_rc=0
    tracker_terminal || tracker_rc=$?
    case "$tracker_rc" in
      0) ;;
      1) message lane-live "item=$ITEM" "state=idle" "pane=$pane_id" >&2; exit 1 ;;
      *) message tracker-read-failed "item=$ITEM" "tracker=$tracker" "source=$tracker_source" "cause=$TRACKER_CAUSE" >&2; exit 1 ;;
    esac ;;
  *) message lane-live "item=$ITEM" "state=$state" "pane=$pane_id" >&2; exit 1 ;;
esac

pane_now_exited() {
  local row screen current_pid current_cmd current_state
  if ! row="$(tmux list-panes -a -F '#{pane_id}'$'\t''#{pane_pid}'$'\t''#{pane_current_command}' 2>/dev/null \
    | awk -F'\t' -v pane="$pane_id" '$1 == pane { print }')"; then
    return 2
  fi
  [[ -n "$row" ]] || return 0
  IFS=$'\t' read -r _ current_pid current_cmd <<<"$row"
  screen="$(tmux capture-pane -pJ -t "$pane_id" 2>/dev/null)" || return 2
  lane_state current_state listed "$current_cmd" "$current_pid" "$screen" || return 2
  [[ "$current_state" == exited ]]
}

# The harness is ended by signal to its own process, never by keystrokes into
# its pane. A hosted lane is signalled by its provider, which alone reaches the
# host's process table; a local lane by the same library stop against the
# worktree its record names. STOPPED_COUNT is how many processes the stop
# signalled, which the exit wait below names where the pane outlives it.
STOPPED_COUNT=""
STOP_SKIPPED=false
STOP_WORKTREE_REMOVED=4
STOP_LINE_RE='^stopped item=[^ ]+ processes=([0-9]+)$'
stop_harness() {
  local out rc=0 fields=("item=$ITEM" "harness=$harness")
  if [[ -n "$host" ]]; then
    [[ -x "$LANE_HOST" ]] || { message record-invalid "item=$ITEM" "field=lane-host" >&2; exit 1; }
    out="$(ORCH_LANE_HOST="$host" "$LANE_HOST" stop --item "$ITEM" --harness "$harness")" || rc=$?
    # A merged lane's own close-out removes its worktree before the lane goes
    # idle, so the provider has no directory to find the harness by. Only an
    # idle lane on a terminal item reaches this stop, and what follows ends the
    # harness, so the stop is skipped rather than refused: the host close where
    # the provider's close ends the sandbox, otherwise the window kill, which
    # hangs up the lane's ssh session, as a static host's close ends no
    # process. Under --keep-sandbox no host close follows.
    if [[ "$rc" -eq "$STOP_WORKTREE_REMOVED" && "$KEEP_SANDBOX" == false ]]; then
      message stop-skipped "${fields[@]}" "cause=worktree-removed"
      STOP_SKIPPED=true
      return 0
    fi
    [[ "$rc" -eq 0 ]] || { message stop-failed "${fields[@]}" "cause=provider" "status=$rc" >&2; exit 1; }
    if [[ "$out" =~ $STOP_LINE_RE ]]; then
      STOPPED_COUNT="${BASH_REMATCH[1]}"
    else
      message stop-failed "${fields[@]}" "cause=answer-unparsed" >&2
      exit 1
    fi
  else
    if ! lane_stop_owned "$mail_root" "$harness"; then
      [[ -z "$LANE_STOP_PID" ]] || fields+=("pid=$LANE_STOP_PID")
      message stop-failed "${fields[@]}" "cause=$LANE_STOP_CAUSE" >&2
      exit 1
    fi
    STOPPED_COUNT="$LANE_STOP_COUNT"
  fi
}

if [[ "$state" == idle ]]; then
  case "$harness" in
    claude|codex|pi) ;;
    *) message harness-unsupported "item=$ITEM" "harness=${harness:-unknown}" >&2; exit 1 ;;
  esac
  refuse_unanswered_ask
  close_secs="${ORCH_LANE_CLOSE_SECS:-15}"
  [[ "$close_secs" =~ ^[1-9][0-9]*$ ]] \
    || { message record-invalid "item=$ITEM" "field=ORCH_LANE_CLOSE_SECS" >&2; exit 1; }
  stop_harness
  [[ "$STOP_SKIPPED" == false ]] || finish_close
  passes=$((close_secs * 5))
  while :; do
    rc=0
    pane_now_exited || rc=$?
    case "$rc" in
      0) break ;;
      1) ;;
      *) message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1 ;;
    esac
    passes=$((passes - 1))
    (( passes > 0 )) \
      || { message exit-timeout "item=$ITEM" "harness=$harness" "pane=$pane_id" "processes=$STOPPED_COUNT" >&2; exit 1; }
    sleep 0.2
  done
fi

finish_close
