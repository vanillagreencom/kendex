#!/usr/bin/env bash
# Close one recorded tmux lane, its hosted sandbox, and its fleet record.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
WORKFLOW_STATE="$SCRIPT_DIR/workflow-state"
LANE_HOST="$SCRIPT_DIR/lane-host"
LANE_MAIL="$SCRIPT_DIR/lane-mail"
LINEAR="$SCRIPT_DIR/../../linear/scripts/linear.sh"
source "$SCRIPT_DIR/lib/lane-state.sh"

message() { # REASON FIELD=VALUE...
  local reason="$1" field
  shift
  printf 'lane-close: %s' "$reason"
  for field in "$@"; do printf ' %s' "$field"; done
  printf '\n'
  case "$reason" in
    argument-count) printf '%s\n' 'Specify one lane item.' ;;
    missing-value) printf '%s\n' 'The option requires a value.' ;;
    record-missing) printf '%s\n' 'No fleet lane record names this item.' ;;
    record-invalid) printf '%s\n' 'The lane record lacks a value required for safe close-out, or an option contradicts one it carries.' ;;
    pane-missing) printf '%s\n' 'No tmux pane carries the recorded window name.' ;;
    pane-ambiguous) printf '%s\n' 'More than one tmux pane carries the recorded window name.' ;;
    pane-read-failed) printf '%s\n' 'The lane pane could not be read.' ;;
    lane-live) printf '%s\n' 'The lane is not finished. Close-out changed nothing.' ;;
    tracker-read-failed) printf '%s\n' 'The tracker state could not be read. Close-out changed nothing. With tracker=linear the read itself failed. With tracker=github the lane needs a repository: pass --repo OWNER/REPO. source=derived is a tracker read from the item key rather than from the record or --tracker, and source=given is one of those two.' ;;
    harness-unsupported) printf '%s\n' 'The recorded harness has no close-out path. harness=unknown is a record that carries none: pass --harness claude|codex.' ;;
    ask-unanswered) printf '%s\n' 'The lane asked the overseer a question and is waiting for the answer. Closing it would end the session that answer would reach. Answer the ask, then close the lane.' ;;
    mail-read-failed) printf '%s\n' 'The lane mailbox could not be read, so nothing here says whether the lane asked anything. Close-out changed nothing.' ;;
    composer-draft) printf '%s\n' 'The lane composer holds text nobody sent. Submitting /exit there would send the draft with it. Clear the composer in the pane, then close the lane.' ;;
    composer-unreadable) printf '%s\n' 'Nothing on this screen measures the lane composer, so nothing may be typed into it. Read the pane and quit the harness there yourself, then close the lane again: an exited lane needs no composer read.' ;;
    tmux-failed) printf '%s\n' 'A tmux operation failed. Close-out stopped.' ;;
    exit-dialog-missing) printf '%s\n' 'Claude Code did not show its exit dialog. Close-out stopped.' ;;
    exit-timeout) printf '%s\n' 'The harness did not exit before the close timeout. Close-out stopped.' ;;
    state-write-failed) printf '%s\n' 'The lane closed, but its fleet record could not be updated.' ;;
    stopped) printf '%s\n' 'The lane window closed and its sandbox was kept.' ;;
    closed) printf '%s\n' 'The lane, sandbox and fleet record closed.' ;;
  esac
}

usage() {
  cat <<'EOF'
Usage: lane-close [--state-dir PATH] [--keep-sandbox]
                  [--harness claude|codex] [--tracker linear|github]
                  [--repo OWNER/REPO] ITEM

Close one lane recorded in the oversee workflow state. The command refuses a
live lane. It accepts an exited lane, or an idle lane whose tracker item is
terminal. A record already marked stopped can close its kept sandbox without
a pane. --keep-sandbox exits the harness, closes its window and records
stopped without calling the lane host.

A lane holding an ask nobody has answered refuses as ask-unanswered, under
--keep-sandbox and on a stopped record alike: the answer would reach a session
this is about to end. An exited lane takes no such refusal, its session being
gone already. A kept sandbox keeps that ask answerable, so the two differ:
--keep-sandbox on an exited lane records stopped and refuses nothing, and the
full close of that stopped record refuses until the ask is answered or the lane
is relaunched onto the sandbox and reads it. A mailbox that cannot be read
refuses as mail-read-failed.

The recorded window resolves in either form tmux accepts: a bare window name
on this server, or SESSION:WINDOW, whose session name must match exactly.

--harness, --tracker and --repo supply a lane identity for a record written
before the launcher recorded one. Each fills only a field the record leaves
null or absent; the record wins where it carries a value, and an option that
contradicts one refuses as record-invalid. An exited lane needs none of them.

A field neither the record nor an option carries is read from the lane where
the lane answers it: tracker from the item key, github for issue-N and linear
for a tracker identifier, and harness from the pane's own foreground command.
repo is read from nothing, so a github lane whose record carries none still
needs --repo. A derived value never beats a recorded or a supplied one, and a
pane running a wrapper rather than the harness itself leaves harness underived.

The item key already answers the tracker for every item, so --tracker only
pins what the key says; a value that disagrees with the key reaches a tracker
read that cannot answer. The identity a caller still supplies is --repo for a
github lane and --harness for a lane whose pane runs a wrapper.
EOF
}

need_value() {
  [[ $# -ge 2 && -n "${2:-}" ]] || { message missing-value "option=$1" >&2; exit 2; }
}

STATE_DIR=""
KEEP_SANDBOX=false
OPT_HARNESS=""
OPT_TRACKER=""
OPT_REPO=""
ITEM=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --state-dir) need_value "$@"; STATE_DIR="$2"; shift 2 ;;
    --state-dir=*) STATE_DIR="${1#--state-dir=}"; need_value --state-dir "$STATE_DIR"; shift ;;
    --harness) need_value "$@"; OPT_HARNESS="$2"; shift 2 ;;
    --harness=*) OPT_HARNESS="${1#--harness=}"; need_value --harness "$OPT_HARNESS"; shift ;;
    --tracker) need_value "$@"; OPT_TRACKER="$2"; shift 2 ;;
    --tracker=*) OPT_TRACKER="${1#--tracker=}"; need_value --tracker "$OPT_TRACKER"; shift ;;
    --repo) need_value "$@"; OPT_REPO="$2"; shift 2 ;;
    --repo=*) OPT_REPO="${1#--repo=}"; need_value --repo "$OPT_REPO"; shift ;;
    --keep-sandbox) KEEP_SANDBOX=true; shift ;;
    --help|-h) usage; exit 0 ;;
    --*) message argument-count "value=$1" >&2; usage >&2; exit 2 ;;
    *)
      [[ -z "$ITEM" ]] || { message argument-count "count=2" >&2; usage >&2; exit 2; }
      ITEM="$1"
      shift ;;
  esac
done
[[ -n "$ITEM" ]] || { message argument-count "count=0" >&2; usage >&2; exit 2; }

STATE_ARGS=()
[[ -z "$STATE_DIR" ]] || STATE_ARGS=(--state-dir "$STATE_DIR")
command -v jq >/dev/null 2>&1 || { message record-invalid "item=$ITEM" "field=jq" >&2; exit 1; }
[[ -x "$WORKFLOW_STATE" ]] || { message record-invalid "item=$ITEM" "field=workflow-state" >&2; exit 1; }

records="$($WORKFLOW_STATE ${STATE_ARGS[@]+"${STATE_ARGS[@]}"} get oversee '.lanes // []')" \
  || { message record-missing "item=$ITEM" >&2; exit 1; }
if ! count="$(jq -r --arg item "$ITEM" '[.[] | select(.item == $item)] | length' <<<"$records")"; then
  message record-invalid "item=$ITEM" "field=record" >&2
  exit 1
fi
[[ "$count" == 1 ]] || { message record-missing "item=$ITEM" "count=$count" >&2; exit 1; }
record="$(jq -c --arg item "$ITEM" '.[] | select(.item == $item)' <<<"$records")" \
  || { message record-invalid "item=$ITEM" "field=record" >&2; exit 1; }

record_field() { jq -r --arg field "$1" '.[$field] // empty' <<<"$record"; }

# The lane identity this close-out needs, taken from the record and, where the
# record has none, from the launch options. A record the launcher wrote before
# it recorded tracker, repo and harness leaves those null, and its idle lane
# would otherwise have no close-out at all. The RECORD wins wherever it carries
# a value: an option that would repoint a recorded lane at another harness,
# tracker or repository refuses instead, because the operator supplying it and
# the record disagree about which lane this is.
resolve_identity() { # OUT_VAR FIELD RECORDED SUPPLIED
  local recorded="$3" supplied="$4"
  if [[ -n "$recorded" && -n "$supplied" && "$recorded" != "$supplied" ]]; then
    message record-invalid "item=$ITEM" "field=$2" "recorded=$recorded" "option=$supplied" >&2
    exit 1
  fi
  printf -v "$1" '%s' "${recorded:-$supplied}"
}

# What the lane itself answers for a field the record and the options both
# leave empty. It fills only an empty field, so the precedence above stands
# whole: recorded, then supplied, then this. A derivation that cannot answer
# leaves the field empty and its existing refusal reached.
#
# The outcome is published rather than returned: a refusal naming where a value
# came from reads it, and every other call site is a plain statement whose
# status errexit would act on.
DERIVE_IDENTITY_FILLED=0
derive_identity() { # OUT_VAR DERIVED
  DERIVE_IDENTITY_FILLED=0
  [[ -z "${!1}" ]] || return 0
  printf -v "$1" '%s' "$2"
  DERIVE_IDENTITY_FILLED=1
}

status="$(record_field status)"
window_name="$(record_field window)"
mail_root="$(record_field mail_root)"
host="$(record_field host)"
resolve_identity tracker tracker "$(record_field tracker)" "$OPT_TRACKER"
resolve_identity repo repo "$(record_field repo)" "$OPT_REPO"
resolve_identity harness harness "$(record_field harness)" "$OPT_HARNESS"
# The item key's own grammar answers the tracker: open-terminal writes issue-N
# for a GitHub item and the tracker's canonical identifier for every other,
# whose tracker is that launcher's own default, linear. The repository behind a
# GitHub item is in no other field of the record, so it stays --repo's alone.
case "$ITEM" in
  issue-*) derived_tracker=github ;;
  *) derived_tracker=linear ;;
esac
derive_identity tracker "$derived_tracker"
tracker_source=given
[[ "$DERIVE_IDENTITY_FILLED" -eq 0 ]] || tracker_source=derived

case "$status" in
  done)
    message closed "item=$ITEM" "status=done"
    exit 0 ;;
  running|stopped) ;;
  *) message record-invalid "item=$ITEM" "field=status" >&2; exit 1 ;;
esac
[[ -n "$mail_root" ]] || { message record-invalid "item=$ITEM" "field=mail_root" >&2; exit 1; }

update_status() { # STATUS
  "$WORKFLOW_STATE" ${STATE_ARGS[@]+"${STATE_ARGS[@]}"} update oversee \
    --arg item "$ITEM" --arg status "$1" \
    'if any(.lanes[]; .item == $item) then (.lanes[] | select(.item == $item) | .status) = $status else error("lane record disappeared") end' \
    >/dev/null
}

# A lane that stops to ask the overseer something waits for the answer inside
# the session this close-out ends. Closing it takes the question with the
# session: the overseer answers into a mailbox nobody reads again, and the
# question the lane stopped to ask is never answered. The mailbox is the only
# record of that, so a read that fails refuses too — one this cannot read is
# not a lane with nothing to say.
refuse_unanswered_ask() {
  local out rc=0 summary ask_count ask_id epoch now age=unknown args
  [[ -x "$LANE_MAIL" ]] || { message record-invalid "item=$ITEM" "field=lane-mail" >&2; exit 1; }
  args=(pending --item "$ITEM" --root "$mail_root")
  [[ -z "$host" ]] || args+=(--host)
  out="$(ORCH_LANE_HOST="$host" "$LANE_MAIL" "${args[@]}")" || rc=$?
  [[ "$rc" -eq 0 ]] \
    || { message mail-read-failed "item=$ITEM" "root=$mail_root" "status=$rc" >&2; exit 1; }
  [[ -n "$out" ]] || return 0
  summary="$(jq -r -R -s 'split("\n") | map(fromjson? | objects) | "\(length)\t\(.[0].id // "")"' <<<"$out")" \
    || { message mail-read-failed "item=$ITEM" "root=$mail_root" "status=parse" >&2; exit 1; }
  IFS=$'\t' read -r ask_count ask_id <<<"$summary"
  [[ "$ask_count" -gt 0 ]] || return 0
  # lane-mail mints an ask id as <epoch>-<pid>-<random>, so the oldest ask
  # carries the second it was asked and how long the lane has waited needs no
  # date parser here. An id outside that grammar still refuses, with the wait
  # unmeasured rather than guessed.
  epoch="${ask_id%%-*}"
  if [[ "$epoch" =~ ^[0-9]+$ ]] && now="$(date -u +%s)"; then age="$((now - epoch))s"; fi
  message ask-unanswered "item=$ITEM" "ask=$ask_id" "age=$age" "count=$ask_count" >&2
  exit 1
}

close_host() {
  local rc=0 out err
  [[ -n "$host" ]] || return 0
  [[ -x "$LANE_HOST" ]] || { message record-invalid "item=$ITEM" "field=lane-host" >&2; return 1; }
  out="$(mktemp)" || return 1
  err="$(mktemp)" || { rm -f -- "$out"; return 1; }
  ORCH_LANE_HOST="$host" "$LANE_HOST" close --item "$ITEM" >"$out" 2>"$err" || rc=$?
  cat -- "$out"
  cat -- "$err" >&2
  if [[ "$rc" -eq 0 ]] && ! grep -q '^kept=' "$out"; then printf 'kept=none\n'; fi
  rm -f -- "$out" "$err"
  return "$rc"
}

# A stopped record means an earlier --keep-sandbox call already exited the
# harness and removed its window. Only the kept sandbox and the record remain.
if [[ "$status" == stopped ]]; then
  # The sandbox is kept, so this lane can still be relaunched into the session
  # an answer would reach. Its ask is owed a reply before the record closes.
  refuse_unanswered_ask
  if [[ "$KEEP_SANDBOX" == true ]]; then
    message stopped "item=$ITEM" "status=stopped"
    exit 0
  fi
  close_host || exit $?
  update_status done || { message state-write-failed "item=$ITEM" "status=done" >&2; exit 1; }
  message closed "item=$ITEM" "status=done"
  exit 0
fi

[[ -n "$window_name" ]] || { message record-invalid "item=$ITEM" "field=window" >&2; exit 1; }

# The recorded window resolves through the shared owner, which accepts the
# bare and SESSION:WINDOW forms alike and reports which silence it met.
resolve_rc=0
lane_pane_resolve "$window_name" || resolve_rc=$?
[[ "$resolve_rc" -ne 2 ]] \
  || { message pane-read-failed "item=$ITEM" "window=$window_name" >&2; exit 1; }
case "$LANE_PANE_COUNT" in
  0) message pane-missing "item=$ITEM" "window=$window_name" >&2; exit 1 ;;
  1) ;;
  *) message pane-ambiguous "item=$ITEM" "window=$window_name" "count=$LANE_PANE_COUNT" >&2; exit 1 ;;
esac
pane_id="$LANE_PANE_ID"
pane_pid="$LANE_PANE_PID"
pane_cmd="$LANE_PANE_CMD"
# The harness is the pane's own foreground command wherever the pane runs it
# directly. A lane started by typing a wrapper at an interactive prompt keeps
# that shell as the pane process and the harness as its child, so this answers
# for the direct launches and leaves the rest to --harness.
case "$pane_cmd" in
  claude|codex) derive_identity harness "$pane_cmd" ;;
esac
pane_screen="$(tmux capture-pane -pJ -t "$pane_id" 2>/dev/null)" \
  || { message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1; }
lane_state state listed "$pane_cmd" "$pane_pid" "$pane_screen" \
  || { message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1; }

tracker_terminal() {
  local value rc=0 number
  case "$tracker" in
    linear)
      [[ -x "$LINEAR" ]] || return 2
      value="$($LINEAR issues get "$ITEM" --format=safe 2>/dev/null)" || rc=$?
      [[ "$rc" -eq 0 ]] || return 2
      # Terminality is the stable state_type, never the display name: a team
      # renames Done or Canceled freely, and a renamed terminal state read by
      # name would hold a finished lane open. A payload carrying no state_type
      # answered nothing, so it reads as a failed tracker read, not as work
      # still running.
      value="$(jq -r '.state_type // empty' <<<"$value")" || return 2
      [[ -n "$value" ]] || return 2
      [[ "$value" == completed || "$value" == canceled ]] ;;
    github)
      [[ -n "$repo" && "$ITEM" == issue-* ]] || return 2
      number="${ITEM#issue-}"
      value="$(gh issue view "$number" --repo "$repo" --json state --jq .state 2>/dev/null)" || return 2
      [[ "$value" == CLOSED ]] ;;
    *) return 2 ;;
  esac
}

case "$state" in
  exited) ;;
  idle)
    tracker_rc=0
    tracker_terminal || tracker_rc=$?
    case "$tracker_rc" in
      0) ;;
      1) message lane-live "item=$ITEM" "state=idle" "pane=$pane_id" >&2; exit 1 ;;
      *) message tracker-read-failed "item=$ITEM" "tracker=$tracker" "source=$tracker_source" >&2; exit 1 ;;
    esac ;;
  *) message lane-live "item=$ITEM" "state=$state" "pane=$pane_id" >&2; exit 1 ;;
esac

mode_read() {
  local mode
  mode="$(tmux display-message -p -t "$pane_id" '#{pane_in_mode}' 2>/dev/null)" || return 1
  if [[ "$mode" == 1 ]]; then
    tmux send-keys -t "$pane_id" -X cancel || return 1
    mode="$(tmux display-message -p -t "$pane_id" '#{pane_in_mode}' 2>/dev/null)" || return 1
  fi
  [[ "$mode" == 0 ]]
}

pane_still_exists() {
  local listed
  listed="$(tmux list-panes -a -F '#{pane_id}' 2>/dev/null)" || return 2
  awk -v pane="$pane_id" '$0 == pane { found=1 } END { exit !found }' <<<"$listed"
}

pane_now_exited() {
  local row screen current_pid current_cmd current_state
  if ! row="$(tmux list-panes -a -F '#{pane_id}'$'\t''#{pane_pid}'$'\t''#{pane_current_command}' 2>/dev/null \
    | awk -F'\t' -v pane="$pane_id" '$1 == pane { print }')"; then
    return 2
  fi
  [[ -n "$row" ]] || return 0
  IFS=$'\t' read -r _ current_pid current_cmd <<<"$row"
  screen="$(tmux capture-pane -pJ -t "$pane_id" 2>/dev/null)" || return 2
  lane_state current_state listed "$current_cmd" "$current_pid" "$screen" || return 2
  [[ "$current_state" == exited ]]
}

if [[ "$state" == idle ]]; then
  [[ "$harness" == claude || "$harness" == codex ]] \
    || { message harness-unsupported "item=$ITEM" "harness=${harness:-unknown}" >&2; exit 1; }
  refuse_unanswered_ask
  # `/exit` is pasted at the cursor, so a composer holding a draft would submit
  # the draft with it and start a turn on a lane the fleet has called finished.
  # The judge calls such a lane idle, which is what it is; only this caller,
  # about to type, needs the composer's own emptiness, and it refuses rather
  # than clear a draft it cannot measure here.
  composer_rc=0
  lane_composer_empty "$pane_screen" || composer_rc=$?
  case "$composer_rc" in
    0) ;;
    1) message composer-draft "item=$ITEM" "pane=$pane_id" "harness=$harness" >&2; exit 1 ;;
    *) message composer-unreadable "item=$ITEM" "pane=$pane_id" "harness=$harness" >&2; exit 1 ;;
  esac
  scratch="$(mktemp -d)" || exit 1
  trap 'rm -rf -- "$scratch"' EXIT
  printf '/exit' >"$scratch/exit-command"
  tmux load-buffer "$scratch/exit-command" \
    || { message tmux-failed "item=$ITEM" "operation=load-buffer" >&2; exit 1; }
  tmux paste-buffer -p -d -t "$pane_id" \
    || { message tmux-failed "item=$ITEM" "operation=paste-buffer" >&2; exit 1; }
  mode_read && tmux send-keys -t "$pane_id" Enter \
    || { message tmux-failed "item=$ITEM" "operation=submit-exit" >&2; exit 1; }

  close_secs="${ORCH_LANE_CLOSE_SECS:-15}"
  [[ "$close_secs" =~ ^[1-9][0-9]*$ ]] \
    || { message record-invalid "item=$ITEM" "field=ORCH_LANE_CLOSE_SECS" >&2; exit 1; }
  passes=$((close_secs * 5))
  if [[ "$harness" == claude ]]; then
    # `/exit` has two answers, and this waits for either. With a task running
    # the harness raises its confirmation dialog, which the Enter below
    # answers. With nothing running it ends the session outright and no dialog
    # is ever drawn: that pane is the outcome this was asked for, so the wait
    # ends there with nothing sent and the close-out below runs as it would
    # have after a confirmation. Only a pane showing neither when the wait runs
    # out is exit-dialog-missing.
    exit_answer=waiting
    while (( passes > 0 )); do
      # Both reads of a pass answer a failed tmux the same way. A capture that
      # does not answer is not a harness that drew no dialog.
      pane_screen="$(tmux capture-pane -pJ -t "$pane_id" 2>/dev/null)" \
        || { message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1; }
      if grep -q 'Exit and stop tasks' <<<"$pane_screen"; then exit_answer=dialog; break; fi
      rc=0
      pane_now_exited || rc=$?
      case "$rc" in
        0) exit_answer=exited; break ;;
        1) ;;
        *) message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1 ;;
      esac
      passes=$((passes - 1))
      sleep 0.2
    done
    case "$exit_answer" in
      dialog)
        mode_read && tmux send-keys -t "$pane_id" Enter \
          || { message tmux-failed "item=$ITEM" "operation=confirm-exit" >&2; exit 1; } ;;
      exited) ;;
      *) message exit-dialog-missing "item=$ITEM" "pane=$pane_id" >&2; exit 1 ;;
    esac
    passes=$((close_secs * 5))
  fi
  while (( passes > 0 )); do
    rc=0
    pane_now_exited || rc=$?
    case "$rc" in
      0) break ;;
      1) ;;
      *) message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1 ;;
    esac
    passes=$((passes - 1))
    sleep 0.2
  done
  rc=0
  pane_now_exited || rc=$?
  case "$rc" in
    0) ;;
    1) message exit-timeout "item=$ITEM" "harness=$harness" "pane=$pane_id" >&2; exit 1 ;;
    *) message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1 ;;
  esac
fi

if [[ "$KEEP_SANDBOX" != true ]]; then close_host || exit $?; fi
pane_rc=0
pane_still_exists || pane_rc=$?
case "$pane_rc" in
  0) tmux kill-window -t "$pane_id" \
       || { message tmux-failed "item=$ITEM" "operation=kill-window" "pane=$pane_id" >&2; exit 1; } ;;
  1) ;;
  *) message pane-read-failed "item=$ITEM" "pane=$pane_id" >&2; exit 1 ;;
esac
next_status=done
[[ "$KEEP_SANDBOX" != true ]] || next_status=stopped
update_status "$next_status" \
  || { message state-write-failed "item=$ITEM" "status=$next_status" >&2; exit 1; }
if [[ "$next_status" == stopped ]]; then
  message stopped "item=$ITEM" "pane=$pane_id" "status=stopped"
else
  message closed "item=$ITEM" "pane=$pane_id" "status=done"
fi
