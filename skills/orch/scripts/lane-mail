#!/usr/bin/env bash
# One append-only mailbox per lane, read and written through this one CLI;
# usage() states the protocol, the layout and every refusal key. The
# invariants: one writing side per file, so no lock crosses hosts and no line
# is rewritten or removed, and a message survives a crashed or restarted
# sender and receiver alike. Every reader consumes only newline-terminated
# lines, so an append or a `lane-host put` in flight costs one poll and never
# a lost or duplicated message; a terminated line that does not parse is
# counted and not emitted, keeping `--after` and the cursor aligned with the
# file. Text crosses a file, never argv (orch SKILL.md § Harness-Safe Shell).
# Bash 3.2-safe: tools/bash32-lint scans this directory.

set -euo pipefail

NL='
'

usage() {
  cat <<'USAGE'
Usage: lane-mail ask|notice|wait|inbox --item ITEM [options]
       lane-mail send|drain|pending --item ITEM [--root ROOT] [--host] [options]

The lane-to-overseer channel. Harness-agnostic, tmux-free, and reachable
through `lane-host` for a lane on another host.

Lane side, rooted at the lane's own git worktree:
  ask --item ITEM --file PATH [--options a,b]
              append an ask to to-overseer.jsonl; print `id=<id>`
  notice --item ITEM --file PATH
              append a notice to to-overseer.jsonl
  wait --item ITEM --id MSGID [--timeout S] [--interval S]
              block until an answer with re=MSGID appears in to-lane.jsonl and
              print its text; exit 124 at --timeout. The whole file is
              searched, so a restarted lane still finds an answer that arrived
              while it was gone
  inbox --item ITEM [--after N]
              print every unread to-lane.jsonl envelope that is not an answer,
              then advance to-lane.cursor past every complete line. An answer
              belongs to the `wait` that asked for it. With --after, print
              the header below, then every such envelope after line N,
              reading and writing no cursor

Overseer side:
  send --item ITEM (--re MSGID | --directive) --file PATH
              append to to-lane.jsonl the answer to MSGID, or a directive that
              answers no ask
  drain --item ITEM --after N
              print the header below, then every to-overseer.jsonl
              envelope after line N, skipping asks to-lane.jsonl answers
  pending --item ITEM
              print every to-overseer.jsonl ask with no answer, which is what
              a restarted overseer owes a reply

Options:
  --item ITEM   one path segment of ASCII letters, digits, `.`, `_` and `-`,
                and never `.` or `..`
  --file PATH   the message text, read whole; one trailing newline is dropped
  --options a,b an ask's choices, split on commas
  --root ROOT   the lane's worktree on its own host, required with --host.
                Without it, `worktree path ITEM` answers where that worktree
                exists, and the project root otherwise. `--item overseer`
                is the overseer's own mailbox, rooted at the project's main
                checkout from any of its checkouts
  --host        read and write through `lane-host`, not this disk
  --after N     the read cursor: the count a previous drain or inbox printed
  --timeout S   seconds before `wait` exits 124; 0 never times out
  --interval S  seconds between `wait` polls (default 5)

Header, the first line drain and inbox --after print: `count=<complete lines>
first=<id>`, the id carried by the file's first line, empty when that line is
no envelope or its id is outside the item alphabet. A reader keeps both: a
file opening with another id is a replacement mailbox, not the one counted.

Envelope, one JSON object per line: id, kind, at, re (answers only), text and
options (asks with choices). kind is ask, notice, answer or directive; at is
UTC; id is <epoch>-<pid>-<random>.

Exit codes: 0 did what it says; 2 usage, an unreadable message file, an item
outside the alphabet, a lock, a write or a host that failed; 124 `wait`
reached --timeout with no answer. Refusal keys, first line
`lane-mail: <key>=<value>`: verb-invalid, option-unknown, option-conflict,
missing-value, option-required, item-invalid, after-invalid, seconds-invalid,
command-missing, file-unreadable, root-unresolved, cursor-invalid, lock-failed,
write-failed, host-write, host-unreachable, mail-read-failed, timeout.

A hosted read that fails is never read as an empty mailbox. `lane-host cat`
exits 2 for a file that is not there, and the dispatcher exits 2 for a host it
refuses, so a failed read confirms the host with `lane-host touch` first. A
failed probe is `host-unreachable`, carrying the host's `state=` from
`lane-host list` because a stopped host is started and a gone one relaunched.
A probe that answers reads 2 as a mailbox the lane has not opened and every
other status as `mail-read-failed`, never as silence.
USAGE
}

# stderr messages start `lane-mail: <key>=<value>`. The English explanation
# follows, then whatever the failing command itself wrote, captured at the site
# so nothing precedes the key.
lm_message() { # KEY VALUE
  local text
  case "$1" in
    verb-invalid) text='No such command. Run lane-mail --help.' ;;
    option-unknown) text='The option is not supported by this command. Run lane-mail --help.' ;;
    option-conflict) text='These options cannot be given together.' ;;
    missing-value) text='The option requires a value.' ;;
    option-required) text='The command requires this option.' ;;
    item-invalid) text='An item is one path segment of ASCII letters, digits, dot, underscore and hyphen, and never . or ..' ;;
    after-invalid) text='--after takes a non-negative integer, the count a previous drain or inbox printed.' ;;
    seconds-invalid) text='The option takes a non-negative integer number of seconds.' ;;
    command-missing) text='The required command is not on PATH.' ;;
    file-unreadable) text='The message file is not a readable file.' ;;
    root-unresolved) text='The lane root could not be resolved. Pass --root.' ;;
    cursor-invalid) text='The cursor file does not hold a line count. Remove it to restart the lane read.' ;;
    lock-failed) text='The mailbox lock could not be taken; another writer holds it.' ;;
    write-failed) text='The mailbox could not be written.' ;;
    host-write) text='The hosted mailbox could not be written through lane-host put.' ;;
    host-unreachable) text='The lane host could not be reached, so the mailbox state is unknown and the read is refused rather than reported as empty. A stopped host is started; a gone one is relaunched.' ;;
    mail-read-failed) text='The hosted mailbox could not be read and its host answers, so the read is refused rather than reported as empty.' ;;
    timeout) text='No answer to this ask arrived before --timeout.' ;;
    *) printf 'lane-mail: message-invalid key=%s\n' "$1" >&2; return 2 ;;
  esac
  printf 'lane-mail: %s=%s%s\n%s\n' "$1" "$2" "${REFUSE_EXTRA:+ $REFUSE_EXTRA}" "$text"
}

REFUSE_EXTRA=""
refuse() { # KEY VALUE [CAUSE] [EXIT]; REFUSE_EXTRA closes the keyed line
  lm_message "$1" "$2" >&2
  [ -z "${3:-}" ] || printf '%s\n' "$3" >&2
  exit "${4:-2}"
}

case "${1:-}" in
  --help | -h | help | '') usage; exit 0 ;;
esac

VERB="$1"
shift
case "$VERB" in
  ask | notice | wait | inbox | send | drain | pending) ;;
  *) refuse verb-invalid "$VERB" ;;
esac

ITEM=""
FILE=""
OPTIONS=""
ROOT=""
HOST=0
AFTER=""
MSGID=""
TIMEOUT=0
INTERVAL=5
DIRECTIVE=0

need_val() { [ "$#" -ge 2 ] && [ -n "${2:-}" ] || refuse missing-value "$1"; }

while [ "$#" -gt 0 ]; do
  case "$1" in
    --item) need_val "$@"; ITEM="$2"; shift 2 ;;
    --file) need_val "$@"; FILE="$2"; shift 2 ;;
    --options) need_val "$@"; OPTIONS="$2"; shift 2 ;;
    --root) need_val "$@"; ROOT="$2"; shift 2 ;;
    --after) need_val "$@"; AFTER="$2"; shift 2 ;;
    --id) need_val "$@"; MSGID="$2"; shift 2 ;;
    --re) need_val "$@"; MSGID="$2"; shift 2 ;;
    --timeout) need_val "$@"; TIMEOUT="$2"; shift 2 ;;
    --interval) need_val "$@"; INTERVAL="$2"; shift 2 ;;
    --host) HOST=1; shift ;;
    --directive) DIRECTIVE=1; shift ;;
    --help | -h) usage; exit 0 ;;
    *) refuse option-unknown "$1" ;;
  esac
done

# Judged before it reaches a path: a `/`, a NUL or a dotted name would
# otherwise select a directory of the caller's choosing.
case "$ITEM" in
  '') refuse option-required --item ;;
  . | ..) refuse item-invalid "$ITEM" ;;
esac
case "$ITEM" in
  *[!A-Za-z0-9._-]*) refuse item-invalid "$ITEM" ;;
esac

for dependency in jq awk cat date mkdir mv tail; do
  command -v "$dependency" >/dev/null 2>&1 || refuse command-missing "$dependency"
done

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib/file-lock.sh
. "$SCRIPT_DIR/lib/file-lock.sh"

WORK_DIR="$(mktemp -d)" || refuse write-failed "${TMPDIR:-/tmp}"
# orch_take_lock's mutex arm arms its own EXIT trap, so every caller below
# re-arms this one after it returns; both halves run either way.
lm_cleanup() { orch_release_lock; rm -rf -- "$WORK_DIR"; }
trap lm_cleanup EXIT

# A lane verb is rooted at its own worktree; the overseer's verbs take --root.
if [ "$HOST" -eq 1 ] && [ -z "$ROOT" ]; then
  refuse option-required --root
fi
if [ -z "$ROOT" ]; then
  case "$ITEM:$VERB" in
    # One overseer mailbox per project: a shell in any checkout, main or a lane
    # worktree, and the watch in the overseer's meet at the main checkout.
    overseer:*)
      ROOT="$("$SCRIPT_DIR/git-context" common-root . 2>/dev/null)" || ROOT=""
      ;;
    *:send | *:drain | *:pending)
      WORKTREE="$SCRIPT_DIR/../../worktree/scripts/worktree"
      if [ -x "$WORKTREE" ]; then
        ROOT="$("$WORKTREE" path "$ITEM" 2>/dev/null)" || ROOT=""
        # `worktree path` composes the path an item's worktree would live
        # at whether or not one is there, so the directory decides: an item
        # with no worktree is a lane running in the checkout itself.
        [ -n "$ROOT" ] && [ -d "$ROOT" ] || ROOT=""
      fi
      ;;
  esac
  if [ -z "$ROOT" ]; then
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT=""
  fi
  [ -n "$ROOT" ] || refuse root-unresolved "$ITEM"
fi

# The overseer's own disk, resolved as oversee-watch resolves it. Its writers,
# the watch and an agent running `send`, are separate processes here, and
# $ROOT is the lane's root on another host, so it cannot hold this lock.
lm_host_lock() { # prints the lock file for ITEM
  local dir="${OVERSEE_WATCH_STATE_DIR:-}"
  if [ -z "$dir" ]; then
    dir="$(git rev-parse --show-toplevel 2>/dev/null)" || dir=""
    [ -n "$dir" ] || refuse root-unresolved "$ITEM"
    dir="$dir/tmp/oversee-watch"
  fi
  mkdir -p -- "$dir" || refuse write-failed "$dir"
  printf '%s/lane-mail-%s.lock' "$dir" "$ITEM"
}

BOX="$ROOT/tmp/lane-mail/$ITEM"
TO_OVERSEER="$BOX/to-overseer.jsonl"
TO_LANE="$BOX/to-lane.jsonl"
CURSOR="$BOX/to-lane.cursor"

# Fetch REMOTE_PATH into DEST, empty when the mailbox does not exist yet. A
# failed hosted read probes the host, so an unreachable one is refused rather
# than reported as an empty mailbox.
lm_fetch() { # REMOTE_PATH DEST
  local rc=0 probe_rc=0
  : >"$2" || refuse write-failed "$2"
  if [ "$HOST" -eq 0 ]; then
    [ -f "$1" ] || return 0
    cat -- "$1" >"$2" 2>"$WORK_DIR/read.err" \
      || refuse file-unreadable "$1" "$(cat -- "$WORK_DIR/read.err")"
    return 0
  fi
  "$SCRIPT_DIR/lane-host" cat --item "$ITEM" "$1" >"$2" 2>"$WORK_DIR/host.err" || rc=$?
  [ "$rc" -ne 0 ] || return 0
  # The probe runs for every failed read, exit 2 included: the dispatcher
  # refuses a host it cannot use with that same 2, and only the probe tells
  # it from a provider saying the file is not there.
  "$SCRIPT_DIR/lane-host" touch --item "$ITEM" >/dev/null 2>"$WORK_DIR/probe.err" || probe_rc=$?
  if [ "$probe_rc" -ne 0 ]; then
    REFUSE_EXTRA="state=$(lm_host_state)"
    refuse host-unreachable "$ITEM" "$(cat -- "$WORK_DIR/probe.err")"
  fi
  [ "$rc" -eq 2 ] || refuse mail-read-failed "$ITEM" "$(cat -- "$WORK_DIR/host.err")"
  # The host answers and the file is not there: a lane that has not opened its
  # mailbox. The failed read wrote whatever it managed; start from nothing.
  : >"$2" || refuse write-failed "$2"
}

# The lane's state as the provider lists it, so an operator knows whether to
# start the host or relaunch it. `unknown` when the listing has no row for it.
lm_host_state() {
  local listing=""
  listing="$("$SCRIPT_DIR/lane-host" list 2>"$WORK_DIR/list.err")" || listing=""
  awk -F'\t' -v item="/$ITEM" 'NF >= 2 && substr($1, length($1) - length(item) + 1) == item { print $2; found = 1; exit }
    END { if (!found) print "unknown" }' <<<"$listing"
}

# The newline-terminated prefix of SRC, written to DEST. A partial last line is
# a writer still appending; it is left for the next read. `printf x` guards the
# substitution, which strips the very newline this test is about.
lm_terminated() { # SRC DEST
  local last
  : >"$2" || refuse write-failed "$2"
  [ -s "$1" ] || return 0
  [ -r "$1" ] || refuse file-unreadable "$1"
  last="$(tail -c 1 -- "$1"; printf x)" || refuse file-unreadable "$1"
  if [ "$last" = "$NL"x ]; then
    cat -- "$1" >"$2" 2>"$WORK_DIR/read.err" \
      || refuse file-unreadable "$1" "$(cat -- "$WORK_DIR/read.err")"
  else
    awk 'NR > 1 { print prev } { prev = $0 }' <"$1" >"$2" 2>"$WORK_DIR/read.err" \
      || refuse file-unreadable "$1" "$(cat -- "$WORK_DIR/read.err")"
  fi
}

lm_count() { # FILE — complete lines, parsing or not
  awk 'END { print NR + 0 }' <"$1"
}

# The line a cursor reader saves: the count, and the id its first line carries,
# empty when that line is no envelope or its id is outside the item alphabet.
# A replacement mailbox opens with another envelope, so a reader holding the
# old count can tell the file it was taken on from one that has as many lines.
lm_header() { # FILE
  local first
  first="$(awk 'NR == 1 { print; exit }' <"$1" |
    jq -r -R '(fromjson? // empty) | objects | .id | strings | select(test("^[A-Za-z0-9._-]+$"))')" \
    || refuse file-unreadable "$1"
  printf 'count=%s first=%s\n' "$(lm_count "$1")" "$first"
}

# The parsing JSON objects among FILE's lines. A terminated line that does not
# parse is dropped here and counted above, so a cursor stays aligned with the
# file whatever a line holds.
lm_objects() { # FILE
  jq -c -R '(fromjson? // empty) | select(type == "object")' <"$1"
}

# The ids of asks to-lane.jsonl already answers, one per line, into DEST.
lm_answered() { # DEST
  lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
  lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
  lm_objects "$WORK_DIR/lane.jsonl" |
    jq -r 'select(.kind == "answer") | .re // empty' >"$1"
}

# Runs in a command substitution: a refusal exits that subshell after writing
# its keyed line, and errexit carries the status out. jq's words are captured
# at the site and replayed under the key, never ahead of it.
lm_envelope() { # KIND [RE] — prints the line; the id lands in WORK_DIR/id
  local id at line
  at="$(date -u +%Y-%m-%dT%H:%M:%SZ)" || refuse write-failed "$BOX"
  id="$(date -u +%s)-$$-$RANDOM"
  printf '%s\n' "$id" >"$WORK_DIR/id" || refuse write-failed "$WORK_DIR/id"
  line="$(jq -cn --arg id "$id" --arg kind "$1" --arg at "$at" --arg re "${2:-}" \
    --arg options "$OPTIONS" --rawfile text "$FILE" '
      {id: $id, kind: $kind, at: $at}
      + (if $re == "" then {} else {re: $re} end)
      + {text: ($text | sub("\n$"; ""))}
      + (if $options == "" then {} else {options: ($options | split(","))} end)' \
    2>"$WORK_DIR/jq.err")" || refuse file-unreadable "$FILE" "$(cat -- "$WORK_DIR/jq.err")"
  printf '%s\n' "$line"
}

# Serialized on the file itself; to-overseer.jsonl has many writers, to-lane one.
# A writer killed inside its printf leaves a fragment with no newline of its
# own. Closing it makes it a line the reader counts and does not parse, so the
# envelope that follows lands whole instead of being glued to it and both lost.
lm_terminate() { # FILE
  [ -s "$1" ] || return 0
  [ "$(tail -c 1 -- "$1"; printf x)" != "$NL"x ] || return 0
  printf '\n' >>"$1" || refuse write-failed "$1"
}

lm_append_local() { # FILE LINE
  mkdir -p -- "$BOX" || refuse write-failed "$BOX"
  : >>"$1" || refuse write-failed "$1"
  exec 9>>"$1"
  orch_take_lock 9 "$1" 30 || refuse lock-failed "$1"
  trap lm_cleanup EXIT
  lm_terminate "$1"
  printf '%s\n' "$2" >&9 || refuse write-failed "$1"
  exec 9>&-
  orch_release_lock
}

# Read-modify-write through the transport, under the lock so a second overseer
# writer cannot put a copy that never saw this line. `put` replaces the whole
# file by rename, so a transfer that fails leaves the last one standing and no
# reader ever meets a half-written mailbox.
lm_append_host() { # FILE LINE
  local rc=0 lock
  lock="$(lm_host_lock)"
  : >>"$lock" || refuse write-failed "$lock"
  exec 8>>"$lock"
  orch_take_lock 8 "$lock" 30 || refuse lock-failed "$lock"
  trap lm_cleanup EXIT
  lm_fetch "$1" "$WORK_DIR/send.raw"
  lm_terminate "$WORK_DIR/send.raw"
  printf '%s\n' "$2" >>"$WORK_DIR/send.raw" || refuse write-failed "$WORK_DIR/send.raw"
  "$SCRIPT_DIR/lane-host" put --item "$ITEM" "$1" <"$WORK_DIR/send.raw" \
    >/dev/null 2>"$WORK_DIR/put.err" || rc=$?
  exec 8>&-
  orch_release_lock
  [ "$rc" -eq 0 ] || refuse host-write "$ITEM" "$(cat -- "$WORK_DIR/put.err")"
}

lm_read_file() {
  [ -n "$FILE" ] || refuse option-required --file
  { [ -f "$FILE" ] && [ -r "$FILE" ]; } || refuse file-unreadable "$FILE"
}

lm_after() {
  case "$AFTER" in
    '' | *[!0-9]*) refuse after-invalid "${AFTER:-<unset>}" ;;
  esac
}

lm_seconds() { # OPTION VALUE
  case "$2" in
    '' | *[!0-9]*) refuse seconds-invalid "$1" ;;
  esac
}

case "$VERB" in
  ask | notice)
    lm_read_file
    if [ "$VERB" = notice ] && [ -n "$OPTIONS" ]; then
      refuse option-unknown --options
    fi
    LINE="$(lm_envelope "$VERB")"
    lm_append_local "$TO_OVERSEER" "$LINE"
    if [ "$VERB" = ask ]; then
      printf 'id=%s\n' "$(cat -- "$WORK_DIR/id")"
    fi
    ;;

  send)
    lm_read_file
    if [ "$DIRECTIVE" -eq 1 ] && [ -n "$MSGID" ]; then
      refuse option-conflict '--re,--directive'
    fi
    if [ "$DIRECTIVE" -eq 0 ] && [ -z "$MSGID" ]; then
      refuse option-required --re
    fi
    if [ "$DIRECTIVE" -eq 1 ]; then
      LINE="$(lm_envelope directive)"
    else
      LINE="$(lm_envelope answer "$MSGID")"
    fi
    if [ "$HOST" -eq 1 ]; then
      lm_append_host "$TO_LANE" "$LINE"
    else
      lm_append_local "$TO_LANE" "$LINE"
    fi
    ;;

  wait)
    [ -n "$MSGID" ] || refuse option-required --id
    lm_seconds --timeout "$TIMEOUT"
    lm_seconds --interval "$INTERVAL"
    START="$(date -u +%s)"
    while :; do
      lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
      lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
      lm_objects "$WORK_DIR/lane.jsonl" |
        jq -c --arg re "$MSGID" 'select(.kind == "answer" and .re == $re)'>"$WORK_DIR/match"
      if [ -s "$WORK_DIR/match" ]; then
        # The first answer to this ask. The inbox drops every answer, so a
        # correction reaches the lane as a directive, never a second answer.
        awk 'NR == 1' <"$WORK_DIR/match" | jq -r '.text'
        exit 0
      fi
      NAP="$INTERVAL"
      if [ "$TIMEOUT" -gt 0 ]; then
        NOW="$(date -u +%s)"
        LEFT="$((TIMEOUT - (NOW - START)))"
        [ "$LEFT" -gt 0 ] || refuse timeout "$MSGID" "" 124
        # --timeout is a deadline, so a nap never runs past it: one shorter
        # than --interval would otherwise wait the whole interval, and one
        # that is not a multiple of it would overshoot by the remainder.
        [ "$LEFT" -ge "$NAP" ] || NAP="$LEFT"
      fi
      sleep "$NAP"
    done
    ;;

  inbox)
    # --after is the caller's own cursor, as for drain: the watch keeps its
    # count in a row and never moves the file cursor a lane's inbox reads.
    if [ -n "$AFTER" ]; then
      lm_after
      SEEN="$AFTER"
    else
      mkdir -p -- "$BOX" || refuse write-failed "$BOX"
      : >>"$CURSOR" || refuse write-failed "$CURSOR"
      # One lock across the read and the rewrite, so the Stop hook and a
      # workflow wait point never hand the same line over twice. The lock is its
      # own file because a rename replaces the cursor, and a lock on the cursor
      # would be a lock on an inode the next reader no longer opens.
      : >>"$CURSOR.lock" || refuse write-failed "$CURSOR.lock"
      exec 9>>"$CURSOR.lock"
      orch_take_lock 9 "$CURSOR.lock" 30 || refuse lock-failed "$CURSOR.lock"
      trap lm_cleanup EXIT
      SEEN="$(cat -- "$CURSOR")" || refuse file-unreadable "$CURSOR"
      [ -n "$SEEN" ] || SEEN=0
      case "$SEEN" in
        *[!0-9]*) refuse cursor-invalid "$CURSOR" ;;
      esac
    fi
    lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
    lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
    COUNT="$(lm_count "$WORK_DIR/lane.jsonl")"
    [ -z "$AFTER" ] || lm_header "$WORK_DIR/lane.jsonl"
    awk -v seen="$SEEN" 'NR > seen' <"$WORK_DIR/lane.jsonl" >"$WORK_DIR/unread"
    # An answer is handed to the `wait` that asked for it, never to the inbox,
    # so a lane is not told twice about a reply it already acted on.
    lm_objects "$WORK_DIR/unread" | jq -c 'select(.kind != "answer")'
    if [ -z "$AFTER" ]; then
      printf '%s\n' "$COUNT" >"$WORK_DIR/cursor" || refuse write-failed "$CURSOR"
      mv -- "$WORK_DIR/cursor" "$CURSOR" || refuse write-failed "$CURSOR"
      exec 9>&-
      orch_release_lock
    fi
    ;;

  drain | pending)
    [ "$VERB" != drain ] || lm_after
    lm_answered "$WORK_DIR/answered"
    ANSWERED="$(cat -- "$WORK_DIR/answered")"
    lm_fetch "$TO_OVERSEER" "$WORK_DIR/over.raw"
    lm_terminated "$WORK_DIR/over.raw" "$WORK_DIR/over.jsonl"
    if [ "$VERB" = drain ]; then
      lm_header "$WORK_DIR/over.jsonl"
      awk -v seen="$AFTER" 'NR > seen' <"$WORK_DIR/over.jsonl" >"$WORK_DIR/new"
    else
      cat -- "$WORK_DIR/over.jsonl" >"$WORK_DIR/new"
    fi
    # An answered ask is not news again; `pending` is what is still owed a reply.
    lm_objects "$WORK_DIR/new" | jq -c --arg answered "$ANSWERED" --arg verb "$VERB" '
      ($answered | split("\n")) as $done
      | . as $envelope
      | select($verb == "drain" or $envelope.kind == "ask")
      | select($envelope.kind != "ask" or ($done | index($envelope.id) | not))'
    ;;
esac
