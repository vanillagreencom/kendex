#!/usr/bin/env bash
# One numbered mailbox per lane, read and written through this one CLI;
# usage() states the protocol, the layout and every refusal key. The
# invariants: every write adds a line under a lock on the file itself, taken
# on the disk that holds it. Compaction rewrites through that same inode and
# keeps logical numbers beside it. A message survives a restarted sender
# and receiver alike. Every reader consumes only newline-terminated
# lines, so a local or a `lane-host append` write in flight costs one poll and
# never a lost or duplicated message; a terminated line that does not parse is
# counted and not emitted, keeping `--after` and the cursor aligned with the
# file. A halt is acknowledged by a plain `inbox` read or a `wait` that
# hands it over: `--ack` stops short of an unread one, so a hook that hands
# mail over never consumes it.
# A send or notice prints its receipt; oversee-report reads the notice id.
# Silence is a send or notice that did not land. With the repeat guard, a repeat
# of one envelope to one item inside a minute is refused before the append
# rather than delivered a second time. Older host libraries can deliver it again.
# The Receipt section of usage() owns
# what counts as a repeat, and nothing here restates it.
# An owner ask in the overseer mailbox is closed by `resolve` alone, exactly
# once, under the same lock the append takes, and a send carrying a delivery
# id lands once under that lock too; usage() § Owner channel owns both rules.
# Text crosses a file, never argv (orch ../SKILL.md § Harness-Safe Shell).
# Bash 3.2-safe: tools/bash32-lint scans this directory.

set -euo pipefail

NL='
'

usage() {
  cat <<'USAGE'
Usage: lane-mail ask|notice|wait|inbox|watch --item ITEM [options]
       lane-mail send|drain|pending|events --item ITEM [--root ROOT] [--host] [options]
       lane-mail compact --item ITEM [--root ROOT]
       lane-mail resolve --item overseer --id MSGID [--text PATH | --default] [options]
       lane-mail peer ask|send --repo REPO [--host] [options]

The lane-to-overseer channel. Harness-agnostic, tmux-free, and reachable
through `lane-host` for a lane on another host.

Lane side, rooted at the lane's own git worktree:
  ask --item ITEM --file PATH [--options a,b]
              append an ask to to-overseer.jsonl; print `id=<id>`
  notice --item ITEM --file PATH
              append a notice to to-overseer.jsonl
  wait --item ITEM --id MSGID [--timeout S] [--interval S]
              block until an answer with re=MSGID appears in to-lane.jsonl and
              print its text; exit 124 at --timeout. The whole file is
              searched, so a restarted lane still finds an answer that arrived
              while it was gone. Before advancing the read cursor, hand
              every preceding unread envelope to the lane on stderr;
              stdout holds only the selected answer's text
  inbox --item ITEM [--root ROOT] [--peek | --ack N]
              print every unread to-lane.jsonl envelope, including answers,
              then advance to-lane.cursor past every complete line. A `wait`
              advances the same cursor past the answer it returns, so the
              inbox does not hand that answer over again. With --peek, print
              the header below, then every such envelope after to-lane.cursor,
              moving no cursor but one already past the complete lines
              present, which comes down to them. With --ack N, print nothing
              and advance to-lane.cursor to N, the count a --peek printed,
              never back, never past an unread halt and never past the
              complete lines present: an N past them acknowledges that line
              count, or the line before an unread halt, and prints
              `lane-mail: ack-clamped=<count acknowledged> asked=<N>` on
              stderr, so a line written later stays unread; a cursor already
              past the lines present comes down to the count acknowledged.
              A lowering by --peek or --ack prints
              `lane-mail: cursor-lowered=<count> was=<cursor>` on stderr
  watch --item ITEM [--root ROOT] [--interval S] [--once]
              the lane's standing mailbox monitor, run under its harness's
              background wake. Every --interval, when envelopes `inbox` would
              print lie past to-lane.cursor and this watch has not announced
              them, print `lane-mail: mail=<item> new=<n>`, n counting those
              envelopes, then one line of instruction and the `inbox` command
              that reads them, with --root naming the mailbox this watch
              reads. One watch process announces an envelope at most once,
              however many polls find it still unread; a re-armed watch
              announces again every envelope still unread, including answers
              no `wait` has read.
              Each poll rewrites to-lane.watch, the liveness record a send's
              receipt reads. Moves no cursor, runs until it is stopped, and
              refuses `mailbox-missing` when the mailbox directory is absent
              at its start or removed while it runs. With --once it exits 0
              after its first announcement, withdrawing to-lane.watch, for a
              harness whose only background wake is a command's exit: the
              lane re-arms it once it has read what it announced. Whether
              that exit wakes a Copilot CLI lane is not yet measured; the
              orch watch-delivery reference owns that premise

Overseer side:
  compact --item ITEM [--root ROOT]
              archive expired, read, closed rows before rewriting under the
              mailbox inode locks. ORCH_RECORD_RETENTION_DAYS defaults to 5
              with SLACK_THREAD_DAYS (relay default 7) as its minimum.
              to-overseer.jsonl uses age alone because its readers own their
              read records. Keep unread to-lane rows and open exchanges.
              Each FILE.numbering records dropped, first and retained logical
              lines under the same lock. All readers keep logical numbers and
              the original first id, including after every row is removed.
              Prints `compacted item=ITEM to-lane=N to-overseer=N`.
              When rows leave, stderr names their archive as
              `lane-mail: archived=PATH`; prune consumes this path.
  send --item ITEM (--re MSGID | --directive | --halt) --file PATH
              append to to-lane.jsonl the answer to MSGID, or a directive that
              answers no ask. A lane's MSGID can name a notice: its inbox and
              watch hand over the answer. In the overseer mailbox MSGID must
              name an owner ask. --halt sends a directive the lane-mail-halt
              hook refuses every lane tool call on until a plain inbox read
              or a wait hands it over. Prints the receipt below on stdout. No halt
              goes to `--item overseer`: no hook halts an overseer on it, and
              the watch acknowledges that mailbox with --ack
              A send to a lane first reads the lane's record in the fleet
              state (--state-dir, else the checkout's) and matches the
              channel its host kind declares (lane-host capabilities).
              channel=mailbox sends as above, and so does a lane with no
              record when no --state-dir is given; with one, an unreadable
              state refuses as state-unreadable and no record as
              lane-unrecorded. channel=session, a Claude cloud session,
              refuses as lane-foreign where the record's mail_root is no
              checkout of this repository, and queues a --directive into the
              record's session_id through `claude -p --cloud SESSION
              --output-format json` under the record's account, the file on
              stdin, printing `lane-mail: sent item=ITEM channel=session
              session=ID` on an {ok: true} answer. An answer whose error
              says the session is archived refuses as session-archived, any
              other as session-send-failed with the CLI's words, and --re
              and --halt refuse as channel-session, since such a lane never
              asks and no hook enforces a halt there.
  drain --item ITEM --after N [--receipts]
              print the header below, then every to-overseer.jsonl
              envelope after line N, skipping asks to-lane.jsonl answers.
              --receipts then prints `receipts cursor=<N> count=<complete
              lines> first=<id>` for to-lane.jsonl, N being the count
              to-lane.cursor holds and never more than the lines listed, 0
              where the lane has never read, or `missed` where the cursor
              was not there beside the lock its reads leave, or reads above
              0 over a listing of no line: a read that missed. Then `<line> <id> <epoch>` for every to-lane.jsonl
              directive: its line number, its id, and its `at` in epoch
              seconds, empty where `at` does not parse. The cursor is the
              receipt: a directive on a line at or below N is one the lane
              has read. A directive whose id is outside the item alphabet is
              not listed
  pending --item ITEM [--to owner|peer] [--due]
              print every open to-overseer.jsonl ask: for a lane
              item, what a restarted overseer owes a reply; for `--item
              overseer`, the asks this overseer SENT the owner or a peer that
              nobody has closed (owner) or answered (peer). Then every to-lane.jsonl directive past
              to-lane.cursor: sent and not yet read. A peer's inbound ask
              lands in to-lane.jsonl and is read by `inbox`, so `pending`
              never lists it. A cursor read `drain --receipts` would report
              `missed` is refused `mail-read-failed=<item> cursor=missed`
              and prints nothing. --to keeps the asks whose `to` field
              names that audience and prints no directive, so the report's
              "Waiting on you" and the owner relay read one field and
              never infer the audience; --due keeps the asks whose deadline
              has passed by this clock and whose form lets the deadline
              close them, as the owner channel's ask below states: the
              ones the watch resolves. Either
              reads no cursor, since no directive is printed, so a cursor
              read that missed refuses neither
  events --item ITEM
              print every envelope of both files, to-overseer.jsonl then
              to-lane.jsonl, each with `box` naming the file it came from,
              `line` its logical line number and `count` that file's logical
              line count, including lines filtered as invalid JSON,
              and `mail_class` on to-lane records from the shared mailbox rule,
              answered asks and their answers included. Moves no cursor and
              marks nothing: a relay keeps its own record of what it carried,
              keyed by envelope id, so --after is refused `events-no-cursor`

Owner channel, the overseer's own mailbox from any of its checkouts:
  ask --item overseer --to owner --file PATH --options a,b
              (--recommend a | --reserved) [--wait MINUTES] [--ref MSGID]
              a question for the owner, appended to to-overseer.jsonl with
              `to` as a field. Every owner ask, a draft ask too, carries a
              deadline: --wait minutes from now, ORCH_ASK_WAIT_MINUTES
              (default 120) when --wait is not given. What the deadline
              does is the ask's form, stated here alone. --recommend names
              the option that stands there where nobody answers, one of
              --options: pending --due lists the ask once its deadline
              passes, and resolve --default closes it with that option.
              --reserved marks an owner-reserved decision, which no default
              closes: the record carries `reserved: true` and no
              recommendation, pending --due never lists it, resolve
              --default refuses it `ask-reserved`, and it stays in pending
              --to owner, past its deadline too, until the overseer closes
              it once it holds the owner's answer. --recommend beside
              --reserved is refused `option-conflict`, and an ask with
              neither, and no --draft, is refused `recommend-required`. The
              owner may still answer outside the options, through send
              --re. --ref names the envelope the ask answers and copies its
              delivery_id, as notice's --ref below does
  ask --item overseer --to owner --file PATH --draft PATH [--wait MINUTES]
              an owner ask to approve a message sent as the owner. --file
              is the question the owner reads; --draft names a JSON object
              of exactly recipient, medium (slack-channel, slack-thread or
              email) and text, all strings. The ask's options are
              approve,deny and its recommendation deny, so the deadline
              never approves a send; --options, --recommend or --reserved
              beside it is refused `option-conflict`. The record carries
              `draft`: those three fields, text exactly as the file holds
              it, and
              text_hash, the lowercase hex SHA-256 of text's UTF-8 bytes
              that lane-mail computes. The master sends only when the
              approval it holds for that ask id names the same text_hash
  notice --item overseer --to owner --file PATH [--ref MSGID] [--attach PATH]
              a note for the owner. --ref names the envelope it answers,
              an owner note in to-lane.jsonl, one the owner wrote and not a
              peer's line or a resolution, or an owner ask in
              to-overseer.jsonl whose ruling it reports, so a relay puts the
              reply where the note or the question was written. Under that
              file's mailbox lock, the notice copies the reference's
              delivery_id, when present, as re_delivery_id. This field is
              copied, never authored by a caller. --attach
              names a file the relay carries beside the text: a regular
              file, not itself a symlink, whose directory resolves
              physically to the progress-report directory workflow-state
              names, recorded at that physical path; refused
              `attach-outside` otherwise
  resolve --item overseer --id MSGID [--text PATH | --default] [--delivery-id KEY]
              closes an owner ask with a separate `resolution` envelope,
              `re=MSGID`, and `by=explicit` when neither option is given.
              --text also records the owner's answer with `by=text`.
              --default supplies the recommendation with `by=default` only
              when no answer stands; otherwise it closes without an answer.
              The check and both appends share the mailbox lock.
              Prints `lane-mail: resolved id=<MSGID> by=<by> answer=<id>`,
              where answer names the close record. A second close is refused
              `resolved-already`, unless its delivery-id repeats that close.
              An id naming no owner ask is `ask-unknown`, for send --re too;
              --default on a reserved ask is `ask-reserved`, and on an ask
              line carrying no recommendation, which `ask` never writes,
              `recommend-missing`
  send --item overseer --directive ... --thread-ts TS --parent PATH
              Slack's relay supplies both fields on a threaded owner directive.
              PATH holds one JSON object: ts (equal to TS), author (owner or
              bot), excerpt (the parent's first 300 characters with newlines
              collapsed), and envelope only for a relay-posted parent.
              inbox prints both fields as part of the envelope. A top-level
              directive and an ask's answer carry neither
  send --item overseer --re MSGID --file PATH [--delivery-id KEY]
              every answer to an open owner ask lands separately with by=text.
              An answer leaves the ask pending until resolve closes it.
              The lock judges repeats before closure, so a replay after close
              still names its original answer. New answers after close refuse.
  send --item ITEM ... --delivery-id KEY
              a send whose envelope carries KEY, the sender's own name for
              this delivery. Under the mailbox lock a KEY the file already
              holds refuses the send as `delivery-repeated=<KEY> id=<id>`,
              naming the envelope that landed, so a retry after a crash
              between the append and the sender's mark lands nothing twice.
              Local only: a hosted append passes through a provider that
              judges no key

Peer side, one other repository's overseer mailbox per call:
  peer ask --repo REPO --file PATH [--options a,b]
              append one ask, one id, to this repository's own overseer
              to-overseer.jsonl and to REPO's overseer to-lane.jsonl; print
              `id=<id>`. `pending --item overseer` lists it until REPO answers
              and `wait --item overseer --id <id>` blocks for that answer.
              Both records use the reply's data-only lookup before either append;
              REPO's pane is judged as `peer send` judges it after the `id=` line
  peer send --repo REPO --file PATH [--re MSGID]
              append to REPO's overseer to-lane.jsonl the answer to MSGID, or
              a directive that answers no ask; prints the same receipt `send`
              prints, whose item is the `overseer` mailbox it wrote and never
              the repository that holds it. That mailbox has one reader, the
              session REPO's fleet record names by the `server` and `pane` of
              its `overseer` member (orch schemas/workflow-state.md). A local
              send, an answer included, refuses before appending where no
              overseer is recorded here: `lane-mail: overseer-absent=<root>`
              names the owner's owner-note tool for a remote overseer. The
              owner form, `send --item overseer`, requires the same record.
              An unreadable record refuses as `overseer-unreadable`. Where
              a recorded overseer names no pane or a `server_start` not epoch
              seconds, or a pane that no longer runs on the server its
              `server_start` names, or on that server pid where it carries
              no `server_start`, stderr
              opens `lane-mail: no-reader=<REPO root> cause=unnamed|pane-gone`
              with a `fix=` line naming `oversee register`; where that cannot
              be judged from here, `lane-mail: reader-unjudged=<REPO root>
              cause=hosted|server`. Either is a notice after the
              receipt, at exit 0: the note landed. Only ORCH_STATE_DIR is
              read from REPO's settings files, as data, to place its record,
              and no file of REPO's is sourced. An answer (--re) has no pane
              check: the asker's `wait --item overseer --id` reads it with
              no named session. After delivery, an answer also appends to
              this repository's own to-overseer.jsonl so compact can close
              the inbound ask without reading REPO

Options:
  --item ITEM   one path segment of ASCII letters, digits, `.`, `_` and `-`,
                and never `.` or `..`
  --file PATH   the message text, read whole; one trailing newline is dropped
  --options a,b an ask's choices, split on commas
  --root ROOT   the lane's worktree on its own host, required with --host.
                Without it, `worktree path ITEM` answers where that worktree
                exists, and the project root otherwise. `--item overseer`
                is the overseer's own mailbox, rooted at the project's main
                checkout from any of its checkouts. On `inbox` and `watch`
                it names the lane's worktree from a shell in another
                checkout, as the lane-mail-check hook does for a lane working
                from the main clone; without it they read the caller's own
                checkout
  --repo REPO   peer only: ANOTHER repository's main checkout. A value
                holding `/` is a path; a bare name is a checkout beside the
                caller's own. A value resolving to this checkout is refused as
                `repo-self`, since both sides of an exchange in one mailbox
                would make this repository its own peer; a note to this
                overseer is `send --item overseer`. With --host it is a path
                on the peer's host, taken as given, and outside that check as
                it is outside the ownership gate: nothing here can establish
                whose path it is
  --host        read and write through `lane-host`, not this disk
  --after N     drain only: the read cursor, the count a previous drain printed
  --peek        inbox only: read to-lane.cursor and leave it where it is,
                unless it stands past the complete lines present
  --ack N       inbox only: the count a --peek printed, acknowledged once its
                envelopes were handed over
  --halt        send only: a directive that halts the lane, as above
  --state-dir PATH
                send only: the fleet state whose record names the lane
  --to WHO      `owner` or `peer`: the audience field of an overseer ask or
                notice, which a peer ask writes as `peer` itself, and the
                filter `pending` keeps
  --ref MSGID   ask and notice --to owner only: the owner note or owner ask
                answered
  --attach PATH notice --to owner only: the file carried beside the text
  --recommend a ask --to owner only: the option that stands at the deadline
  --wait N      ask --to owner only: minutes until the ask's deadline
  --draft PATH  ask --to owner only: the message the owner approves
  --reserved    ask --to owner only: a decision no deadline closes
  --due         pending only: asks whose deadline has passed
  --text PATH   resolve only: the owner's answer, read as --file is
  --default     resolve only: close at deadline; recommend only if unanswered
  --delivery-id KEY
                send and resolve only: the sender's name for this delivery
  --thread-ts TS --parent PATH
                send --item overseer --directive only: the thread pointer
  --timeout S   seconds before `wait` exits 124; 0 never times out
  --interval S  seconds between `wait` and `watch` polls (default 5)
  --once        watch only: exit after the first announcement

Header, the first line drain and inbox --peek print: `count=<complete lines>
first=<id>`, the id carried by the file's first line, empty when that line is
no envelope or its id is outside the item alphabet. A reader keeps both: a
file opening with another id is a replacement mailbox, not the one counted.
Counts include compacted rows. The first id stays original.

Envelope, one JSON object per line: id, kind, at, from, re (answers and closes),
halt (true on a directive sent with --halt), text and options (asks with
choices), and the owner-channel fields each verb above writes: to, ref,
attach, recommend, wait, deadline (UTC, at plus wait minutes), delivery_id,
re_delivery_id (an ask's or notice's copy of its --ref envelope's
delivery_id), thread_ts and parent (threaded owner directives only),
closes (false on new owner answers; absent on legacy closing answers),
draft (a draft ask only: recipient, medium, text and text_hash),
reserved (true on a reserved ask only),
and by (`text` or `default` on an owner answer; `explicit`, `text` or
`default` on a close). kind is ask, notice, answer, resolution or directive;
at is UTC; id is <epoch>-<pid>-<random>. from
is the sender, read from its own checkout and never from an option: a lane
verb writes the item, a send into the overseer's own mailbox and a `resolve
--text` write `owner`, and everything else an overseer sends, a `resolve
--default` included, writes `overseer:<repository>`. The repository is the `[marketplace]` name in the
caller's kendex.toml, else the last segment of its origin URL, else the
checkout's own directory name.
Reads of legacy closing answers warn `lane-mail: legacy-close=<id>` on stderr.
The old format remains readable through kendex 1.4.

Receipt, the line a `send`, a `peer send` and a `notice` print on stdout once
the envelope is appended: `lane-mail: sent item=<item> id=<id> bytes=<n> monitor=<m>`, where
bytes is the length of the text the envelope carries, the message file less the
one trailing newline it drops. monitor is `live` when the mailbox's
to-lane.watch, `at=<epoch> interval=<s>` rewritten by `watch` at every poll,
is no older than twice its interval plus five seconds by the sender's clock,
so a monitor is polling that mailbox and wakes its lane; it is `none`
otherwise, and a Claude Code or Codex lane needs a wake while a lane on
another harness takes none. A Pi lane runs no
watch and always reads none: that package wakes it when mail lands. A Copilot lane's `none` is a `watch --once` that
announced and is not yet re-armed, and the re-armed watch announces what
still stands unread; the orch watch-delivery reference says what the
overseer does where that watch's exit does not wake the lane. A `peer send` writes a peer's overseer mailbox, so
its receipt always names item `overseer` rather than the repository it reached.
A `notice` receipt replaces `monitor=<m>` with `to=<owner|peer> ref=<ref>`;
ref is empty when no --ref was given, and a lane notice has an empty to field.
`oversee-report write` reads the notice receipt's id for its report-written line.
Silence is not a success: a send or notice that printed no receipt appended nothing.

Hosts with older append libraries skip the minute repeat check and can deliver
the same envelope again. The repeat rules below apply locally and on hosts
whose append library has the repeat guard.

A send, ask or notice repeating an envelope the mailbox already holds is a retry of a delivery
that landed, not a second message. A send carrying --delivery-id is judged by
that key alone, under the lock, and never by this window. What is compared is the envelope whole,
every field of it but the id it is minted with and the stamp, which the window
judges instead; a generated deadline is compared as its offset from the stamp.
The comparison is against a line already in the mailbox stamped within the minute
before this send. Any one field differing makes a message of its own, so the
same words answering two asks both land, a `--halt` after an identical plain
directive lands and halts the lane, and two overseers writing one mailbox never
silence each other. A repeat is refused before the append as
`lane-mail: duplicate id=<id>`, naming the line already there; another item, or
more than a minute later, appends as any send does.

The minute rule holds for every send. An owner notice, `notice --item
overseer --to owner`, is also judged on its text alone for 24 hours: a text
equal to that of an owner notice already in to-overseer.jsonl, stamped within
the 24 hours before this send, is refused as
`lane-mail: owner-notice-repeated=overseer id=<id>`, naming the latest such
notice, whatever its attachment, reference or any other field. The minute
check runs first, so a retry inside the minute is still `duplicate`. The owner
holds the text the id names; new words, not a wait, send it again.

The repeat check and append hold the destination mailbox's same lock through
`lib/mailbox-append.sh`, locally and on a host with the repeat guard. Two identical sends
cannot both append: the second checks the first row while it holds that lock
and refuses with its id. A mailbox read failure refuses the write as
`write-failed` locally or `host-append` on a provider, never as an empty mailbox.

A send writes a mailbox of the caller's own repository alone, its own lanes
and its own overseer mailbox: a --root whose common root is not the caller's,
or resolves to none, is refused as `lane-foreign`. `peer` is the only
cross-repository write. A hosted send is outside that check: its root is a
path on another host, and nothing here can establish which repository owns it.

Exit codes: 0 did what it says; 2 usage, an unreadable message file, an item
outside the alphabet, a lock, a write or a host that failed; 69
`lane-host-busy`, lane-host's own status for a call it refused at its per-home
cap, passed through; 124 `wait` reached --timeout with no answer. Refusal
keys, first line `lane-mail: <key>=<value>`: verb-invalid, option-unknown,
option-conflict, missing-value, option-required, item-invalid, after-invalid,
seconds-invalid, minutes-invalid, to-invalid, ref-invalid, ref-unknown,
recommend-invalid, recommend-missing, recommend-required, draft-field,
draft-medium, attach-outside,
ask-unknown, ask-reserved, resolved-already, delivery-repeated, owner-notice-repeated,
overseer-only, events-no-cursor,
command-missing, file-unreadable, root-unresolved, repo-unresolved, repo-self,
lane-foreign, mailbox-unsafe, cursor-invalid, duplicate, lock-failed,
write-failed, host-append, host-unreachable, mail-read-failed, lane-host-busy,
timeout, item-case-variant, mailbox-missing, retention-invalid, archive-failed, archived,
state-unreadable, lane-unrecorded, host-capabilities-unread, channel-session,
session-unrecorded, session-archived, session-send-failed. `duplicate` is the one key whose
value follows ` id=` rather than `=`, so it names the earlier envelope through
the same field the receipt above prints; `resolved-already`,
`delivery-repeated` and `owner-notice-repeated` close their own value with
` id=<id>` naming the envelope already there.

One mailbox per lane, named exactly as `--item` spells it. A verb that would
open a second directory under the same root differing from ITEM only in case is
refused: the lane and the overseer would each read a folder the other never
writes. A verb on a mailbox already there reads and writes it, so a pair an
earlier launcher left is drained through each spelling and removed. A hosted
mailbox sits on its provider's disk, where this check cannot see it. A peer
verb is judged the same way, once per mailbox it opens: the peer's, and the
caller's own record.

A hosted read that fails is never read as an empty mailbox. `lane-host cat`
exits 2 for a file that is not there, and the dispatcher exits 2 for a host it
refuses, so a failed read confirms the host with `lane-host touch` first. A
failed probe is `host-unreachable`, carrying the host's `state=` from
`lane-host list` because a stopped host is started and a gone one relaunched.
A probe that answers reads 2 as a mailbox the lane has not opened and every
other status as `mail-read-failed`, never as silence. A call lane-host refused
at its per-home cap ran no provider: it is `lane-host-busy` with lane-host's
exit 69, never probed and never read as a host out of reach.

A hosted write adds its line through `lane-host append`, which takes its lock
on the host holding the file. That is the same lock a local write takes on the
target file itself, so a mailbox with many writers keeps every line however
many machines they sit on: the owner and every peer writing one hosted
overseer mailbox all reach the one lock. A failed append is probed like a
failed read: a host that does not answer is `host-unreachable` with its
`state=`, and a host that answers and declines the write, a provider with no
`append` verb included, is `host-append`. No write falls back to reading the
file and putting it back, which is what loses a line.

A hosted peer needs a provider that addresses another repository's checkout.
The shipped `lane-host-ssh` does not: its inventory describes one repository
and addresses that repository's lanes by item, refusing rows naming a second
one outright, so no row can name a peer. The attempt surfaces as
`host-unreachable` for the item, which names the probe that failed rather than
the provider that has no row to serve.
USAGE
}

# stderr messages start `lane-mail: <key>=<value>`, with the one exception the
# separator below carries: `duplicate` closes its key with ` id=`, naming the
# earlier envelope through the field the sent receipt prints. The English
# explanation follows, then whatever the failing command itself wrote, captured
# at the site so nothing precedes the key.
lm_message() { # KEY VALUE
  local text sep='='
  case "$1" in
    verb-invalid) text='No such command. Run lane-mail --help.' ;;
    option-unknown) text='The option is not supported by this command. Run lane-mail --help.' ;;
    option-conflict) text='These options cannot be given together.' ;;
    missing-value) text='The option requires a value.' ;;
    option-required) text='The command requires this option.' ;;
    item-invalid) text='An item is one path segment of ASCII letters, digits, dot, underscore and hyphen, and never . or ..' ;;
    after-invalid) text='--after and --ack take a non-negative integer, the count a previous drain or inbox printed.' ;;
    seconds-invalid) text='The option takes a non-negative integer number of seconds.' ;;
    command-missing) text='The required command is not on PATH.' ;;
    file-unreadable) text='The message file is not a readable file.' ;;
    root-unresolved) text='The lane root could not be resolved. Pass --root.' ;;
    repo-unresolved) text='The peer repository is not a checkout on this disk. Pass the path of one, or a bare name of a checkout beside this one.' ;;
    repo-self) text='A peer is another repository, and that value resolves to this one. Both sides of an exchange would land in one mailbox, where this repository is reported as its own peer. To write a note to this overseer, use `send --item overseer`.' ;;
    lane-foreign) text='That mailbox belongs to another repository. A send reaches only this repository: its lanes, and its own overseer mailbox. Reach a peer overseer with `lane-mail peer`.' ;;
    no-reader) text='The note or ask landed, and no session reads that checkout'\''s overseer mailbox: its fleet record names no tmux pane, or binds it to a tmux server start time that is not epoch seconds (cause=unnamed), or names one that no longer runs on the tmux server the record binds it to by its start time, or on that server process where the record carries no start time (cause=pane-gone). The lane-mail hooks hand that mailbox only to the session the record names, so it waits unread until one is named, and an ask'\''s answer with it.
fix=run `oversee register` from the orch skill in the session that should read that checkout'\''s mail, which makes that session the checkout'\''s overseer, its turn end held at the context marks for a succession as a fleet overseer'\''s is; or start its fleet with `oversee launch`' ;;
    reader-unjudged) text='The note or ask landed, and whether a session reads that checkout'\''s overseer mailbox is unknown: a hosted peer keeps its fleet record and tmux server on its own host (cause=hosted), or the pane it names is on a tmux server this shell does not reach (cause=server).' ;;
    overseer-unreadable) text='The checkout overseer record could not be read. Nothing was appended.' ;;
    mailbox-unsafe) text='A mailbox directory, file, cursor or lock is a symlink or not the kind of file it names, so nothing is read or written through it. Remove it; the next write recreates it.' ;;
    item-case-variant) text='A mailbox for this item already exists under another spelling of the same name, so a lane and an overseer would read separate folders on a case-sensitive disk. Use that spelling, or drain it and remove it.' ;;
    cursor-invalid) text='The cursor file does not hold a line count. Remove it to restart the lane read.' ;;
    lock-failed) text='The mailbox lock could not be taken; another writer holds it.' ;;
    write-failed) text='The mailbox could not be written.' ;;
    retention-invalid) text='Retention and relay thread age must be positive integers.' ;;
    archive-failed) text='Expired mailbox rows could not be archived, so nothing was removed.' ;;
    archived) text='Expired mailbox rows are kept in this archive.' ;;
    host-append) text='The hosted mailbox could not be appended through lane-host append. The host answered the probe, so the provider declined the write and the line below is what it reported; a provider with no append verb fails here too. Nothing falls back to reading the mailbox and putting it back, which drops a line when two machines write one file.' ;;
    host-unreachable) text='The lane host could not be reached, so the mailbox state is unknown: a read is refused rather than reported as empty, and a write rather than reported as delivered. A stopped host is started; a gone one is relaunched.' ;;
    mail-read-failed) text='The hosted mailbox could not be read and its host answers, so the read is refused rather than reported as empty. A send stopped here appended nothing: a mailbox no read could judge is one no send can be judged against.' ;;
    lane-host-busy) text='lane-host refused the call at its per-home cap on provider calls, so the mailbox was neither read nor written and the host was not judged. Run the verb again; the line below is the one lane-host printed.' ;;
    timeout) text='No answer to this ask arrived before --timeout.' ;;
    mail) text='Overseer mail landed in this lane mailbox. Run the command below and act on every envelope it prints, answers and directives alike, as its text directs.' ;;
    mailbox-missing) text='The mailbox directory is not there, so no watch of it can wake the lane. Run the watch from the lane worktree, or with --root naming it, for the item its launch created.' ;;
    minutes-invalid) text='The option, or ORCH_ASK_WAIT_MINUTES, takes a non-negative integer number of minutes.' ;;
    to-invalid) text='--to takes owner or peer. A peer ask is `peer ask --repo`, which writes peer itself, so an ask or notice typed here takes owner.' ;;
    ref-invalid) text='--ref takes the id of an envelope: ASCII letters, digits, dot, underscore and hyphen.' ;;
    ref-unknown) text='No owner note in to-lane.jsonl and no owner ask in to-overseer.jsonl carries that id, so nothing here can be answered by it; a line a peer overseer sent and a resolution there are neither. Read the note or the ask again and pass the id it carries.' ;;
    recommend-invalid) text='--recommend names one of the choices --options lists, and an ask with no choices has nothing to recommend.' ;;
    recommend-missing) text='The ask carries no recommendation, so no default can stand for it: close it without --default.' ;;
    draft-field) text='A draft is a JSON object of exactly recipient, medium and text, each a string holding a non-blank character. lane-mail computes text_hash itself, so a draft that names it is refused too.' ;;
    draft-medium) text='A draft medium is slack-channel, slack-thread or email.' ;;
    recommend-required) text='An owner ask names what its deadline does by its form, --recommend, --reserved or --draft; the owner-channel ask help states each. The owner can still answer outside the choices, through send --re.' ;;
    events-no-cursor) text='events takes no cursor: every read prints every envelope of both files, and a relay keys what it carried by each envelope id, never by a line count. Drop --after.' ;;
    attach-outside) text='An attachment is a regular file, not itself a symlink, whose directory resolves physically to the progress-report directory, and it is recorded at that physical path. The report writer alone sets it; a path anywhere else is refused so nothing outside that directory can be carried to the owner.' ;;
    ask-reserved) text='The ask is an owner-reserved decision: no default stands for it at its deadline. Record the owner'"'"'s answer with send --re, then close it with resolve, or record and close together with resolve --text.' ;;
    ask-unknown) text='No ask in the mailbox carries that id: an owner ask in the overseer mailbox, or in a lane'"'"'s, an ask that lane sent. An overseer send --re answers an owner ask and resolve closes one.' ;;
    resolved-already) text='This ask is already closed by the record named above. Deliver later text as a directive with `send --item overseer --directive`.' ;;
    delivery-repeated) text='An envelope carrying this delivery id already stands in the mailbox, named by id= above: this send is a retry of a delivery that landed, so nothing is appended. Record that id against the delivery and go on.' ;;
    owner-notice-repeated) text='The owner already holds this notice: the owner notice named by id= above carries the same text and was sent within the last 24 hours, so nothing is appended whatever the attachment or reference. That id is the receipt of the send that landed. New words send it again; waiting does not.' ;;
    overseer-only) text='resolve closes an owner ask in the overseer mailbox alone. A lane ask is answered with `send --item ITEM --re MSGID`.' ;;
    cursor-lowered) text='to-lane.cursor stood past the complete lines the mailbox holds, a count an --ack wrote before it was clamped, so it moved down to the count above. Every line up to that count stays read, and every line after it, the next line written included, is handed over.' ;;
    ack-clamped) text='The --ack count is past the complete lines the mailbox holds, so the count acknowledged is the one above: those lines, or fewer where an unread halt stands among them. A line written later stays unread for the next read.' ;;
    state-unreadable) text='The fleet state could not be read for the lane'"'"'s record, so which channel reaches the lane is unknown. Nothing was sent.' ;;
    host-capabilities-unread) text='lane-host could not declare the capability line of the host the lane'"'"'s record names, or declared a channel this send has no arm for, so nothing says how to reach the lane. Nothing was sent.' ;;
    lane-unrecorded) text='The fleet state the send names holds no record for this lane, so which channel reaches it is unknown. Nothing was sent. Name the state the lane was launched into, or, for a lane with no record, such as one the watch carries from --item alone, send the same command with no --state-dir.' ;;
    channel-session) text='The lane runs in a cloud session, which never asks and enforces no halt, so this option reaches nothing there. Send a plain --directive; a stop goes to the operator, who archives the session.' ;;
    session-unrecorded) text='The lane'"'"'s record names no account or no session id, so no cloud session can be reached. Nothing was sent.' ;;
    session-archived) text='The Claude CLI answered that the cloud session is archived, so it takes no more messages. Nothing was delivered. oversee-events.md lane-stalled names what follows.' ;;
    session-send-failed) text='The Claude CLI did not answer ok true for the cloud session, so nothing says the directive was queued. Its exit status and its own words follow; send again once they are fixed.' ;;
    duplicate) sep=' id='; text='This envelope was sent to this item less than a minute ago: every field of it but its own id and its stamp matches the envelope the id above names, so the send is a retry of a delivery that already landed rather than a second message. Change any field of the message, or wait out the minute, to send it again.' ;;
    *) printf 'lane-mail: message-invalid key=%s\n' "$1" >&2; return 2 ;;
  esac
  printf 'lane-mail: %s%s%s%s\n%s\n' "$1" "$sep" "$2" "${REFUSE_EXTRA:+ $REFUSE_EXTRA}" "$text"
}

REFUSE_EXTRA=""
refuse() { # KEY VALUE [CAUSE] [EXIT]; REFUSE_EXTRA closes the keyed line
  lm_message "$1" "$2" >&2
  [ -z "${3:-}" ] || printf '%s\n' "$3" >&2
  exit "${4:-2}"
}

case "${1:-}" in
  --help | -h | help | '') usage; exit 0 ;;
esac

VERB="$1"
shift
PEER_VERB=""
if [ "$VERB" = peer ]; then
  PEER_VERB="${1:-}"
  case "$PEER_VERB" in
    ask | send) shift ;;
    *) refuse verb-invalid "peer ${PEER_VERB:-<missing>}" ;;
  esac
fi
case "$VERB" in
  ask | notice | wait | inbox | watch | send | drain | pending | events | resolve | compact | peer) ;;
  *) refuse verb-invalid "$VERB" ;;
esac

ITEM=""
FILE=""
OPTIONS=""
OPTS_GIVEN=""
ROOT=""
REPO=""
HOST=0
AFTER=""
MSGID=""
TIMEOUT=0
INTERVAL=5
DIRECTIVE=0
HALT=0
PEEK=0
ACK=""
RECEIPTS=0
TO=""
REF=""
ATTACH=""
RECOMMEND=""
WAIT=""
WAIT_GIVEN=0
DUE=0
DEFAULT=0
DELIVERY_ID=""
DRAFT=""
RESERVED=0
DRAFT_RECORD=/dev/null
THREAD_TS=""
PARENT=""
PARENT_JSON=null
ONCE=0
STATE_DIR=""

need_val() { [ "$#" -ge 2 ] && [ -n "${2:-}" ] || refuse missing-value "$1"; }

while [ "$#" -gt 0 ]; do
  # The spelling, not the value: a valued option shifts past its own, so this
  # collects exactly the options the caller typed, in the words it typed them.
  OPTS_GIVEN="$OPTS_GIVEN$1$NL"
  case "$1" in
    --item) need_val "$@"; ITEM="$2"; shift 2 ;;
    --file) need_val "$@"; FILE="$2"; shift 2 ;;
    --options) need_val "$@"; OPTIONS="$2"; shift 2 ;;
    --root) need_val "$@"; ROOT="$2"; shift 2 ;;
    --repo) need_val "$@"; REPO="$2"; shift 2 ;;
    --after) need_val "$@"; AFTER="$2"; shift 2 ;;
    --id) need_val "$@"; MSGID="$2"; shift 2 ;;
    --re) need_val "$@"; MSGID="$2"; shift 2 ;;
    --timeout) need_val "$@"; TIMEOUT="$2"; shift 2 ;;
    --interval) need_val "$@"; INTERVAL="$2"; shift 2 ;;
    --host) HOST=1; shift ;;
    --directive) DIRECTIVE=1; shift ;;
    --halt) DIRECTIVE=1; HALT=1; shift ;;
    --peek) PEEK=1; shift ;;
    --receipts) RECEIPTS=1; shift ;;
    --ack) need_val "$@"; ACK="$2"; shift 2 ;;
    --to) need_val "$@"; TO="$2"; shift 2 ;;
    --ref) need_val "$@"; REF="$2"; shift 2 ;;
    --attach) need_val "$@"; ATTACH="$2"; shift 2 ;;
    --recommend) need_val "$@"; RECOMMEND="$2"; shift 2 ;;
    --wait) need_val "$@"; WAIT="$2"; WAIT_GIVEN=1; shift 2 ;;
    --draft) need_val "$@"; DRAFT="$2"; shift 2 ;;
    --reserved) RESERVED=1; shift ;;
    --due) DUE=1; shift ;;
    --text) need_val "$@"; FILE="$2"; shift 2 ;;
    --default) DEFAULT=1; shift ;;
    --delivery-id) need_val "$@"; DELIVERY_ID="$2"; shift 2 ;;
    --thread-ts) need_val "$@"; THREAD_TS="$2"; shift 2 ;;
    --parent) need_val "$@"; PARENT="$2"; shift 2 ;;
    --once) ONCE=1; shift ;;
    --state-dir) need_val "$@"; STATE_DIR="$2"; shift 2 ;;
    --help | -h) usage; exit 0 ;;
    *) refuse option-unknown "$1" ;;
  esac
done

if [ "$VERB" = compact ]; then
  for given in $OPTS_GIVEN; do
    case "$given" in --item | --root) ;; *) refuse option-unknown "$given" ;; esac
  done
fi

# A peer verb addresses a repository, not a lane, and writes that repository's
# overseer mailbox. One rule rather than a list of rejects: these are the
# options a peer verb takes, and every other spelling the parser accepted is a
# lane option, refused rather than dropped so a caller is never told a choice
# landed that never did. The refusal names the spelling typed, so a `--id` on
# a peer ask does not send its reader to `--re`.
[ "$RECEIPTS" -eq 0 ] || [ "$VERB" = drain ] || refuse option-unknown --receipts
if [ "$VERB" = peer ]; then
  [ -n "$REPO" ] || refuse option-required --repo
  for given in $OPTS_GIVEN; do
    case "$given" in
      --repo | --file | --host) ;;
      --options) [ "$PEER_VERB" = ask ] || refuse option-unknown --options ;;
      --re) [ "$PEER_VERB" = send ] || refuse option-unknown --re ;;
      *) refuse option-unknown "$given" ;;
    esac
  done
  ITEM=overseer
  # A peer ask is addressed by the verb: the record it leaves carries the
  # audience field pending filters on, written here and never typed.
  [ "$PEER_VERB" != ask ] || TO=peer
elif [ -n "$REPO" ]; then
  refuse option-unknown --repo
fi

# The owner-channel options belong to the overseer mailbox, and each to one
# verb of it; typed anywhere else they are refused rather than dropped, as
# --options on a notice is, so no caller is told a field landed that never
# did. --to is the one that reaches two verbs, and a value outside the two
# audiences is a field nothing reads. --after is drain's cursor alone; on
# `events` it takes a key of its own, since a relay reaching for a cursor
# there keys by envelope id instead.
for given in $OPTS_GIVEN; do
  case "$given" in
    --to)
      case "$TO" in owner | peer) ;; *) refuse to-invalid "$TO" ;; esac
      case "$VERB:$ITEM:$TO" in
        ask:overseer:owner | notice:overseer:owner | pending:*:*) ;;
        ask:overseer:peer | notice:overseer:peer) refuse to-invalid "$TO" ;;
        *) refuse option-unknown --to ;;
      esac ;;
    --ref) case "$VERB:$ITEM" in ask:overseer | notice:overseer) ;; *) refuse option-unknown --ref ;; esac ;;
    --attach) [ "$VERB:$ITEM" = notice:overseer ] || refuse option-unknown --attach ;;
    --recommend | --wait | --draft | --reserved) [ "$VERB:$ITEM" = ask:overseer ] || refuse option-unknown "$given" ;;
    --due) [ "$VERB" = pending ] || refuse option-unknown --due ;;
    --after)
      case "$VERB" in
        drain) ;;
        events) refuse events-no-cursor --after ;;
        *) refuse option-unknown --after ;;
      esac ;;
    --text | --default) [ "$VERB" = resolve ] || refuse option-unknown "$given" ;;
    --delivery-id) case "$VERB" in send | resolve) ;; *) refuse option-unknown --delivery-id ;; esac ;;
    --thread-ts | --parent)
      [ "$VERB:$ITEM:$DIRECTIVE" = send:overseer:1 ] || refuse option-unknown "$given" ;;
    --once) [ "$VERB" = watch ] || refuse option-unknown --once ;;
    --state-dir) [ "$VERB" = send ] || refuse option-unknown --state-dir ;;
  esac
done

# Judged before it reaches a path: a `/`, a NUL or a dotted name would
# otherwise select a directory of the caller's choosing.
case "$ITEM" in
  '') refuse option-required --item ;;
  . | ..) refuse item-invalid "$ITEM" ;;
esac
case "$ITEM" in
  *[!A-Za-z0-9._-]*) refuse item-invalid "$ITEM" ;;
esac

for dependency in jq awk cat date mkdir mv tail tr; do
  command -v "$dependency" >/dev/null 2>&1 || refuse command-missing "$dependency"
done

# Slack's relay produces both pointer fields together on threaded directives.
if [ -n "$THREAD_TS$PARENT" ]; then
  [ -n "$THREAD_TS" ] && [ -n "$PARENT" ] || refuse option-conflict '--thread-ts,--parent'
  PARENT_JSON="$(jq -ce --arg ts "$THREAD_TS" '
    select(type == "object" and .ts == $ts and (.author == "owner" or .author == "bot")
      and (.excerpt | type == "string" and length <= 300)
      and (if has("envelope") then (.envelope | type == "string") else true end))
    ' -- "$PARENT" 2>/dev/null)" || refuse file-unreadable "$PARENT"
fi

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
# shellcheck source=lib/file-lock.sh
. "$SCRIPT_DIR/lib/file-lock.sh"
# shellcheck source=lib/mailbox-append.sh
. "$SCRIPT_DIR/lib/mailbox-append.sh"
# shellcheck source=lib/lane-host-slots.sh
. "$SCRIPT_DIR/lib/lane-host-slots.sh"
# shellcheck source=lib/tmux-server.sh
. "$SCRIPT_DIR/lib/tmux-server.sh"

# Nested subshells keep each mutex's lifetime separate on hosts without flock.
# A reader can hold the cursor lock while taking a mailbox snapshot.
lm_locked() ( # FD PATH COMMAND...
  local fd="$1" path="$2"
  shift 2
  ORCH_LOCK_MUTEX_DIR=""
  if [ "$VERB" = compact ] && [ "$fd" -ne 7 ]; then
    eval "exec $fd<>\"\$path\"" 2>"$WORK_DIR/open.err" ||
      refuse write-failed "$path" "$(cat -- "$WORK_DIR/open.err")"
  else
    eval "exec $fd<\"\$path\"" 2>"$WORK_DIR/open.err" ||
      refuse file-unreadable "$path" "$(cat -- "$WORK_DIR/open.err")"
  fi
  orch_take_lock "$fd" "$path" 30 2>"$WORK_DIR/locked.err" ||
    refuse lock-failed "$path" "$(cat -- "$WORK_DIR/locked.err")"
  trap orch_release_lock EXIT
  "$@"
)

# Missing mail files have no rows to rewrite. Do not create a cursor lock on
# an unread mailbox: pending treats that lock without a cursor as a missed read.
lm_existing_lock() ( # FD PATH COMMAND...
  local fd="$1" path="$2"
  shift 2
  if [ -f "$path" ]; then
    lm_locked "$fd" "$path" "$@"
  else
    eval "exec $fd</dev/null" || refuse file-unreadable /dev/null
    "$@"
  fi
)

lm_store() {
  command -v python3 >/dev/null 2>&1 || refuse command-missing python3
  python3 "$SCRIPT_DIR/lib/lane-mail-store.py" "$@" 2>"$WORK_DIR/store.err" ||
    refuse file-unreadable "$BOX" "$(cat -- "$WORK_DIR/store.err")"
}

# The template names TMPDIR outright, as lib/review-artifact-gates.sh does: a
# bare `mktemp` reads it only on GNU, and BSD mktemp, the one macOS ships,
# allocates under its own per-user directory instead. The trailing slash macOS
# sets comes off, and a relative root takes `./` so it cannot read as an option.
TMP_ROOT="${TMPDIR:-/tmp}"
TMP_ROOT="${TMP_ROOT%/}"
case "$TMP_ROOT" in
  "") TMP_ROOT="/" ;;
  /*) ;;
  *) TMP_ROOT="./$TMP_ROOT" ;;
esac
WORK_DIR="$(mktemp -d "$TMP_ROOT/lane-mail.XXXXXX")" || refuse write-failed "$TMP_ROOT"
# orch_take_lock's mutex arm arms its own EXIT trap, so every caller below
# re-arms this one after it returns; both halves run either way.
lm_cleanup() { orch_release_lock; rm -rf -- "$WORK_DIR"; }
trap lm_cleanup EXIT

# A send to a lane is matched on the channel its record's host kind declares
# (../schemas/lane-host.md § Host kinds). A mailbox channel goes on to the
# mailbox below, and so does a lane with no record when the send names no
# fleet state; a send that names one refuses an unreadable state or one with
# no record for the lane, since either would land a cloud lane's directive in
# a mailbox nobody reads. A session channel is a Claude cloud session of this
# repository, judged by its record's mail_root as a mailbox send is by its
# root: a directive is queued into the record's session through the Claude
# CLI under the record's account, which answers {ok, session_id, url}. Such a
# lane never asks, so an answer has nothing to reach, and no hook enforces a
# halt there.
lm_send_channel() {
  local state_args=() rc=0 exists record host channel harness account session root out answer cause
  [ -z "$STATE_DIR" ] || state_args=(--state-dir "$STATE_DIR")
  if ! exists="$("$SCRIPT_DIR/workflow-state" ${state_args[@]+"${state_args[@]}"} exists --json oversee 2>"$WORK_DIR/state.err")" ||
    ! exists="$(jq -er '.exists | tostring' <<<"$exists")"; then
    refuse state-unreadable "$ITEM" "$(cat -- "$WORK_DIR/state.err")"
  fi
  record='{}'
  if [ "$exists" = true ]; then
    record="$("$SCRIPT_DIR/workflow-state" ${state_args[@]+"${state_args[@]}"} get oversee \
      '[.lanes[]? | objects | select(.item == "'"$ITEM"'")] | first // {}' 2>"$WORK_DIR/state.err")" ||
      refuse state-unreadable "$ITEM" "$(cat -- "$WORK_DIR/state.err")"
  fi
  if [ "$record" = '{}' ]; then
    [ -z "$STATE_DIR" ] || refuse lane-unrecorded "$ITEM" "state-dir=$STATE_DIR"
    return 0
  fi
  host="$(jq -r '.host // "local"' <<<"$record")" || refuse state-unreadable "$ITEM"
  lane_capabilities_read "$SCRIPT_DIR/lane-host" "$host" 2>"$WORK_DIR/caps.err" ||
    refuse host-capabilities-unread "$host" "$(cat -- "$WORK_DIR/caps.err")"
  lane_capability channel channel
  case "$channel" in
    mailbox) return 0 ;;
    session) ;;
    *) refuse host-capabilities-unread "$host" "channel=$channel" ;;
  esac
  IFS=$'\t' read -r harness account session root < <(jq -r '[.harness // "", .account // "", .session_id // "", .mail_root // ""] | @tsv' <<<"$record") ||
    refuse state-unreadable "$ITEM"
  lm_root_own "$root"
  [ -z "$MSGID" ] || refuse channel-session --re
  [ "$HALT" -eq 0 ] || refuse channel-session --halt
  { [ -n "$account" ] && [ -n "$session" ]; } || refuse session-unrecorded "$ITEM"
  rc=0
  out="$(env "$(lane_env_prefix "$harness" "$account")" claude -p --cloud "$session" --output-format json <"$FILE" 2>"$WORK_DIR/claude.err")" || rc=$?
  # The CLI's own error words decide an archived session; any other answer
  # that is no {ok: true} is a send that failed, carried with those words.
  answer="$(jq -r 'if .ok == true then "sent" elif (.error // "" | tostring | test("archived"; "i")) then "archived" else "failed" end' <<<"$out" 2>/dev/null)" || answer=failed
  cause="$(jq -r '.error // empty | tostring' <<<"$out" 2>/dev/null || true) $(cat -- "$WORK_DIR/claude.err")"
  [ "$answer" != archived ] || refuse session-archived "$session" "$cause"
  { [ "$rc" -eq 0 ] && [ "$answer" = sent ]; } || refuse session-send-failed "$session" "exit=$rc $cause"
  printf 'lane-mail: sent item=%s channel=session session=%s\n' "$ITEM" "$session"
  exit 0
}
if [ "$VERB" = send ] && [ "$ITEM" != overseer ]; then
  # shellcheck source=lib/lane-capabilities.sh
  . "$SCRIPT_DIR/lib/lane-capabilities.sh"
  # shellcheck source=lib/lane-launch.sh
  . "$SCRIPT_DIR/lib/lane-launch.sh"
fi

# The caller's own repository: the main checkout behind this shell, whatever
# worktree it sits in. It names the sender, places a peer named as a bare name,
# and decides which lanes are this overseer's to write.
OWN_ROOT="$("$SCRIPT_DIR/git-context" common-root . 2>/dev/null)" || OWN_ROOT=""
# A peer verb writes the caller's own record and places a bare --repo name
# beside the caller's checkout. With no own root there is nowhere correct for
# either, so it is refused here: before a name is composed, before the peer
# root is judged, and before any envelope is written.
[ "$VERB" != peer ] || [ -n "$OWN_ROOT" ] || refuse root-unresolved .

# The caller's repository name: what its kendex.toml publishes, else the last
# segment of its origin URL, else the checkout's own directory name.
lm_repository() {
  local root name="" url=""
  root="$OWN_ROOT"
  [ -n "$root" ] || root="$(pwd -P)" || refuse root-unresolved .
  if [ -f "$root/kendex.toml" ]; then
    # A basic string and a literal string are the two TOML spellings of a
    # name. The quote arrives as a variable rather than an escape, so the
    # program reads the same under every awk. Any value this cannot read
    # prints nothing and falls through to the origin URL below, rather than
    # being mangled into the identity every peer message carries: a basic
    # string processes escapes and this does not decode them, so one holding a
    # backslash is such a value. A literal string processes none, so a
    # backslash there is a character like any other and is read as written.
    name="$(awk -v q="'" '
      /^[[:space:]]*\[/ { table = ($0 ~ /^[[:space:]]*\[marketplace\][[:space:]]*$/); next }
      table && /^[[:space:]]*name[[:space:]]*=/ {
        value = $0
        sub(/^[[:space:]]*name[[:space:]]*=[[:space:]]*/, "", value)
        mark = substr(value, 1, 1)
        if (mark != "\"" && mark != q) exit
        value = substr(value, 2)
        close_at = index(value, mark)
        if (close_at < 2) exit
        value = substr(value, 1, close_at - 1)
        if (mark == "\"" && index(value, "\\") > 0) exit
        print value
        exit
      }' <"$root/kendex.toml")" || refuse file-unreadable "$root/kendex.toml"
  fi
  if [ -z "$name" ]; then
    url="$(git -C "$root" remote get-url origin 2>/dev/null)" || url=""
    url="${url%/}"
    name="${url##*/}"
    name="${name%.git}"
  fi
  [ -n "$name" ] || name="${root##*/}"
  # The name reaches a whitespace-separated watch record, so it carries the
  # item alphabet: a directory name holding a space would split that record.
  printf '%s\n' "${name//[!A-Za-z0-9._-]/-}"
}

# Who sent it, never typed: a lane writes its own item, a note into the
# overseer's own mailbox is the owner's, and every other overseer write
# carries the repository it was sent from.
FROM=""
case "$VERB:$ITEM:$DEFAULT" in
  ask:* | notice:*) FROM="$ITEM" ;;
  send:overseer:*) FROM=owner ;;
  resolve:*:0) FROM=owner; [ -n "$FILE" ] || FROM="overseer:$(lm_repository)" ;;
  send:* | peer:* | resolve:*) FROM="overseer:$(lm_repository)" ;;
esac

# A lane verb is rooted at its own worktree; the overseer's verbs take --root.
if [ "$VERB" = peer ]; then
  # A hosted peer root is a path on its own host, so it is taken as given.
  if [ "$HOST" -eq 1 ]; then
    ROOT="$REPO"
  else
    case "$REPO" in
      */*) PEER_ROOT="$REPO" ;;
      *) PEER_ROOT="${OWN_ROOT%/*}/$REPO" ;;
    esac
    # A peer's overseer mailbox sits at its main checkout, so the value goes
    # through the same judge the lane gate uses: a path that is no checkout is
    # refused rather than written into, and one inside a peer resolves to its
    # root instead of opening a second mailbox no watch reads.
    ROOT="$("$SCRIPT_DIR/git-context" common-root "$PEER_ROOT" 2>/dev/null)" || ROOT=""
    [ -n "$ROOT" ] || refuse repo-unresolved "$PEER_ROOT"
    # A peer is another repository. Resolved to this one, `peer ask` would put
    # both sides of an exchange in one mailbox: the watch would report this
    # repository as its own peer, and the overseer could answer its own ask.
    # Judged on the resolved roots rather than the typed value, so every
    # spelling that names this checkout meets it here, beside the test that
    # says what a peer target may be at all.
    [ "$ROOT" != "$OWN_ROOT" ] || refuse repo-self "$ROOT"
  fi
elif [ "$HOST" -eq 1 ] && [ -z "$ROOT" ]; then
  refuse option-required --root
fi
if [ -z "$ROOT" ]; then
  case "$ITEM:$VERB" in
    # One overseer mailbox per project: a shell in any checkout, main or a lane
    # worktree, and the watch in the overseer's meet at the main checkout.
    overseer:*)
      ROOT="$("$SCRIPT_DIR/git-context" common-root . 2>/dev/null)" || ROOT=""
      ;;
    *:send | *:drain | *:pending | *:events | *:compact)
      WORKTREE="$SCRIPT_DIR/../../worktree/scripts/worktree"
      if [ -x "$WORKTREE" ]; then
        ROOT="$("$WORKTREE" path "$ITEM" 2>/dev/null)" || ROOT=""
        # `worktree path` composes the path an item's worktree would live
        # at whether or not one is there, so the directory decides: an item
        # with no worktree is a lane running in the checkout itself.
        [ -n "$ROOT" ] && [ -d "$ROOT" ] || ROOT=""
      fi
      ;;
  esac
  if [ -z "$ROOT" ]; then
    ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || ROOT=""
  fi
  [ -n "$ROOT" ] || refuse root-unresolved "$ITEM"
fi

# A send writes a mailbox of the caller's own repository, never one another
# repository owns: its own lanes, and its own overseer mailbox from any of its
# checkouts. The overseer item is judged with the rest, because a --root into
# another repository's overseer mailbox is the cross-repository write `peer`
# exists to be. A root that resolves to no common root at all is refused with
# them, so an unreadable checkout is no way in. A hosted send is out of reach:
# the root is a path on another host.
lm_root_own() { # ROOT
  LANE_ROOT="$("$SCRIPT_DIR/git-context" common-root "$1" 2>/dev/null)" || LANE_ROOT=""
  { [ -n "$LANE_ROOT" ] && [ "$LANE_ROOT" = "$OWN_ROOT" ]; } || refuse lane-foreign "$1"
}
if { [ "$VERB" = send ] || [ "$VERB" = resolve ]; } && [ "$HOST" -eq 0 ]; then
  lm_root_own "$ROOT"
fi

# The mailbox a verb reads or writes. A peer exchange moves it once: the same
# envelope lands in the peer's mailbox and then in the caller's own record.
lm_box() { # ROOT
  MAIL_ROOT="$1"
  BOX="$MAIL_ROOT/tmp/lane-mail/$ITEM"
  TO_OVERSEER="$BOX/to-overseer.jsonl"
  TO_LANE="$BOX/to-lane.jsonl"
  CURSOR="$BOX/to-lane.cursor"
  WATCH_FILE="$BOX/to-lane.watch"
}
lm_box "$ROOT"

# A mailbox component that is a symlink, or not the kind of file it names,
# would carry a read or an append somewhere the lane never wrote, and a
# checkout can commit one. Judged once, before any verb reads or writes, from
# tmp/lane-mail down: tmp itself may be a link a worktree setup makes. A hosted
# mailbox is judged by its provider behind `lane-host cat` and `append`.
lm_plain() {
  local path kind
  for path in "$MAIL_ROOT/tmp/lane-mail" "$BOX" "$TO_OVERSEER" "$TO_LANE" "$TO_OVERSEER.numbering" "$TO_LANE.numbering" "$CURSOR" "$CURSOR.lock" "$WATCH_FILE"; do
    kind=-f
    case "$path" in "$MAIL_ROOT/tmp/lane-mail" | "$BOX") kind=-d ;; esac
    { [ ! -L "$path" ] && { [ ! -e "$path" ] || test "$kind" "$path"; }; } || refuse mailbox-unsafe "$path"
  done
}
[ "$HOST" -eq 1 ] || lm_plain

# Two directories for one lane differing only in case are two mailboxes on a
# case-sensitive disk: the lane's asks are never seen and the overseer's
# directives are never read, in silence. Refused only where the verb would open
# the second one, so a verb on a mailbox already there reads and writes it and a
# pair an earlier launcher left is drained through each spelling and removed. On
# a case-folding disk the named mailbox and the variant are one directory, so the
# return below fires and nothing is refused. A hosted mailbox is on its
# provider's disk, out of reach.
lm_one_spelling() {
  local entry name lower
  [ ! -d "$BOX" ] || return 0
  lower="$(printf '%s' "$ITEM" | tr '[:upper:]' '[:lower:]')"
  for entry in "$MAIL_ROOT"/tmp/lane-mail/*; do
    [ -d "$entry" ] || continue
    name="${entry##*/}"
    # A sibling writer can create the item's own directory between the return
    # above and this scan, and that exact spelling is never a variant of itself.
    [ "$name" != "$ITEM" ] || continue
    [ "$(printf '%s' "$name" | tr '[:upper:]' '[:lower:]')" != "$lower" ] ||
      refuse item-case-variant "$ITEM" "Existing mailbox: $entry"
  done
}
[ "$HOST" -eq 1 ] || lm_one_spelling

# A transport call that failed is a host out of reach or a provider that
# answered and declined, and only the probe tells them apart. It runs for every
# failed call, exit 2 included: the dispatcher refuses a host it cannot use
# with that same 2. An unreachable host is refused here, carrying the state an
# operator acts on; a host that answers returns, and the caller names what its
# own verb could not do.
lm_host_answers() {
  local probe_rc=0
  "$SCRIPT_DIR/lane-host" touch --item "$ITEM" >/dev/null 2>"$WORK_DIR/probe.err" || probe_rc=$?
  [ "$probe_rc" -ne 0 ] || return 0
  lm_host_busy "$probe_rc" "$WORK_DIR/probe.err"
  REFUSE_EXTRA="state=$(lm_host_state)"
  refuse host-unreachable "$ITEM" "$(cat -- "$WORK_DIR/probe.err")"
}

# A call lane-host refused at its per-home cap ran no provider, so it says
# nothing about the host and is never probed: the probe would wait for a slot
# in turn. It exits with lane-host's own status, which a caller reads as busy.
lm_host_busy() { # STATUS ERR_FILE
  [ "$1" -ne "$LANE_HOST_BUSY_EXIT" ] || refuse lane-host-busy "$ITEM" "$(cat -- "$2")" "$LANE_HOST_BUSY_EXIT"
}

# Fetch REMOTE_PATH into DEST, empty when the mailbox does not exist yet. A
# failed hosted read probes the host, so an unreachable one is refused rather
# than reported as an empty mailbox.
LM_FETCH_ABSENT=0
lm_fetch() { # REMOTE_PATH DEST — LM_FETCH_ABSENT 1 where the file was not there
  local rc=0
  LM_FETCH_ABSENT=0
  : >"$2" || refuse write-failed "$2"
  if [ "$HOST" -eq 0 ]; then
    [ -f "$1" ] || { LM_FETCH_ABSENT=1; return 0; }
    case "$1" in
      "$TO_LANE" | "$TO_OVERSEER")
        if [ "${LM_HELD_PATH:-}" = "$1" ]; then
          lm_store snapshot 9 "$1" "$2"
        else
          lm_locked 8 "$1" lm_store snapshot 8 "$1" "$2"
        fi
        return ;;
    esac
    cat -- "$1" >"$2" 2>"$WORK_DIR/read.err" \
      || refuse file-unreadable "$1" "$(cat -- "$WORK_DIR/read.err")"
    return 0
  fi
  "$SCRIPT_DIR/lane-host" cat --item "$ITEM" "$1" >"$2" 2>"$WORK_DIR/host.err" || rc=$?
  if [ "$rc" -eq 0 ]; then
    case "$1" in
      "$TO_LANE" | "$TO_OVERSEER")
        lm_fetch "$1.numbering" "$2.numbering"
        [ "$LM_FETCH_ABSENT" -eq 0 ] || rm -f -- "$2.numbering"
        (exec 8<"$2"; lm_store snapshot 8 "$2" "$2") ;;
    esac
    LM_FETCH_ABSENT=0
    return 0
  fi
  lm_host_busy "$rc" "$WORK_DIR/host.err"
  lm_host_answers
  [ "$rc" -eq 2 ] || refuse mail-read-failed "$ITEM" "$(cat -- "$WORK_DIR/host.err")"
  # The host answers and the file is not there: a lane that has not opened its
  # mailbox. The failed read wrote whatever it managed; start from nothing.
  LM_FETCH_ABSENT=1
  : >"$2" || refuse write-failed "$2"
}

# The lane's state as the provider lists it, so an operator knows whether to
# start the host or relaunch it. `unknown` when the listing has no row for it.
lm_host_state() {
  local listing=""
  listing="$("$SCRIPT_DIR/lane-host" list 2>"$WORK_DIR/list.err")" || listing=""
  awk -F'\t' -v item="/$ITEM" 'NF >= 2 && substr($1, length($1) - length(item) + 1) == item { print $2; found = 1; exit }
    END { if (!found) print "unknown" }' <<<"$listing"
}

# The newline-terminated prefix of SRC, written to DEST. A partial last line is
# a writer still appending; it is left for the next read. Where the last line
# ends is `mailbox_line_complete`, the one owner both sides of a mailbox ask,
# so the reader and the writer cannot come apart on it.
lm_terminated() { # SRC DEST
  local complete=0
  : >"$2" || refuse write-failed "$2"
  if [ -f "$1.index" ]; then
    cp -- "$1.index" "$2.index" && cp -- "$1.header" "$2.header" || refuse write-failed "$2"
  else
    awk '{ print NR }' <"$1" >"$2.index" || refuse file-unreadable "$1"
  fi
  [ -s "$1" ] || return 0
  [ -r "$1" ] || refuse file-unreadable "$1"
  mailbox_line_complete "$1" || complete=$?
  [ "$complete" -ne 2 ] || refuse file-unreadable "$1"
  if [ "$complete" -eq 0 ]; then
    cat -- "$1" >"$2" 2>"$WORK_DIR/read.err" \
      || refuse file-unreadable "$1" "$(cat -- "$WORK_DIR/read.err")"
  else
    awk 'NR > 1 { print prev } { prev = $0 }' <"$1" >"$2" 2>"$WORK_DIR/read.err" \
      || refuse file-unreadable "$1" "$(cat -- "$WORK_DIR/read.err")"
    # Raw snapshots reserve the next logical number for the fragment. Only
    # this terminated-prefix decision makes that number readable.
    awk 'NR > 1 { print prev } { prev = $0 }' <"$1.index" >"$2.index" || refuse file-unreadable "$1"
    if [ -f "$1.header" ]; then
      awk '{ sub(/^count=/, "", $1); printf "count=%d %s\n", $1 - 1, $2 }' <"$1.header" >"$2.header" || refuse file-unreadable "$1"
    fi
  fi
}

lm_count() { # FILE — logical complete lines, parsing or not
  if [ -f "$1.header" ]; then
    awk '{ sub(/^count=/, "", $1); print $1 }' <"$1.header"
    return
  fi
  awk 'END { print NR + 0 }' <"$1"
}

# Filter a snapshot by logical number, not by its compacted physical offset.
lm_after_file() { # FILE SEEN DEST [BEFORE]
  awk -v seen="$2" -v before="${4:-}" 'FILENAME == ARGV[1] { line[FNR] = $0; next }
    line[FNR] > seen && (before == "" || line[FNR] < before)' "$1.index" "$1" >"$3" || refuse file-unreadable "$1"
}

# The line a cursor reader saves: the count, and the id its first line carries,
# empty when that line is no envelope or its id is outside the item alphabet.
# A replacement mailbox opens with another envelope, so a reader holding the
# old count can tell the file it was taken on from one that has as many lines.
lm_header() { # FILE
  local first
  if [ -f "$1.header" ]; then
    cat -- "$1.header" || refuse file-unreadable "$1.header"
    return
  fi
  first="$(awk 'NR == 1 { print; exit }' <"$1" |
    jq -r -R '(fromjson? // empty) | objects | .id | strings | select(test("^[A-Za-z0-9._-]+$"))')" \
    || refuse file-unreadable "$1"
  printf 'count=%s first=%s\n' "$(lm_count "$1")" "$first"
}

# The parsing JSON objects among FILE's lines. A terminated line that does not
# parse is dropped here and counted above. Events name BOX to carry logical
# line numbers before that filtering, aligned with the master's seen count.
lm_objects() { # FILE [BOX]
  local count=0 numbers=/dev/null
  [ "$ITEM" != overseer ] || mailbox_warn_legacy "$1" || return 2
  if [ -n "${2:-}" ]; then
    count="$(lm_count "$1")" || return 1
    numbers="$1.index"
  fi
  jq -c -R --arg box "${2:-}" --argjson count "$count" --slurpfile numbers "$numbers" "$MAILBOX_CLASS_JQ"'input_line_number as $physical
    | (fromjson? // empty) | select(type == "object")
    | if $box == "" then . else . + {box: $box, line: $numbers[$physical - 1], count: $count}
        + (if $box == "to-lane" then {mail_class: overseer_mail_class} else {} end) end' <"$1"
}

# The receipt's measured fields, read before the append so that nothing able
# to fail sits between the append and the line reporting it: a send that
# landed always prints its receipt, and a caller reads silence as a send that
# did not.
lm_receipt_fields() { # LINE — sets SENT_ID, SENT_BYTES and SENT_MONITOR
  SENT_BYTES="$(jq -r '.text | utf8bytelength' <<<"$1")" || refuse write-failed "$TO_LANE"
  SENT_ID="$(cat -- "$WORK_DIR/id")" || refuse file-unreadable "$WORK_DIR/id"
  SENT_MONITOR="$(lm_monitor)" || exit "$?"
}

# `live` where the mailbox's watch record is fresh, `none` otherwise: absent,
# stale, or not the shape `watch` writes. Read through lm_fetch, so a hosted
# lane's record is read on the host that holds it and a host out of reach is
# refused rather than reported as no monitor.
lm_monitor() {
  local now=""
  now="$(date -u +%s)" || refuse write-failed "$BOX"
  lm_fetch "$WATCH_FILE" "$WORK_DIR/watch.rec"
  awk -v now="$now" '
    NR == 1 && $1 ~ /^at=[0-9]+$/ && $2 ~ /^interval=[0-9]+$/ {
      at = substr($1, 4) + 0; interval = substr($2, 10) + 0
      if (now - at >= 0 && now - at <= 2 * interval + 5) live = 1
    }
    END { print (live ? "live" : "none") }' <"$WORK_DIR/watch.rec" || refuse file-unreadable "$WATCH_FILE"
}

# The receipt itself: the item the send reached, the id of the envelope it
# appended, the bytes of message text that envelope carries, and whether a
# monitor stands on the mailbox.
lm_sent() {
  if [ "$VERB" = notice ]; then
    printf 'lane-mail: sent item=%s id=%s bytes=%s to=%s ref=%s\n' "$ITEM" "$SENT_ID" "$SENT_BYTES" "$TO" "$REF"
  else
    printf 'lane-mail: sent item=%s id=%s bytes=%s monitor=%s\n' "$ITEM" "$SENT_ID" "$SENT_BYTES" "$SENT_MONITOR"
  fi
}

# Whether the peer checkout's overseer mailbox has a reader, said on stderr
# once a `peer send` directive or a `peer ask` has landed, so it never
# refuses. The reader is the one session the checkout's fleet record names
# under `.overseer` by tmux server and pane: the lane-mail-check hooks hand the
# mailbox to that session alone, and a live watch there reads it itself. No
# record, or one naming no server pid and `%N` pane, or a `server_start` that
# is not epoch seconds, names nobody, and a pane that no longer runs reads
# nothing. The pane is judged on the server the record's `server_start` binds
# it to, since a later server may be handed the same pid and pane id; a
# record carrying no start names the session in that pane on that server pid
# whatever its start, as the hooks read it, which hand it the mailbox and
# write the start into the record. Which record carries no start is
# lib/overseer-launch.sh § OL_JQ_DEFS's ol_unstarted, sourced here alone so
# no other verb pays for it. A
# hosted peer's record and tmux server sit on its own host, out of this
# shell's reach.
lm_peer_reader() {
  local record server start pane rc=0
  # shellcheck source=lib/overseer-launch.sh
  . "$SCRIPT_DIR/lib/overseer-launch.sh"
  if [ "$HOST" -eq 1 ]; then
    lm_notice reader-unjudged "$ROOT" cause=hosted
    return 0
  fi
  record="$(jq -r "$OL_JQ_DEFS"'
    . as $o | ($o.server // "") as $s
    | [($s | tostring), (if $o | ol_unstarted($s; ($o.pane // $o.session // "")) then "unstarted"
            else ($o.server_start // "" | tostring) end), ($o.pane // "" | tostring)] | join(" ")' \
    <<<"$LM_OVERSEER_RECORD")" || refuse overseer-unreadable "$ROOT"
  server="${record%% *}"
  record="${record#* }"
  start="${record%% *}"
  pane="${record#* }"
  case "$server" in
    '' | *[!0-9]*) server="" ;;
  esac
  # A record carrying no start is judged on its server alone; any other start
  # that is not epoch seconds binds the record to no server.
  case "$start" in
    unstarted) start="" ;;
    '' | *[!0-9]*) start=invalid ;;
  esac
  case "$pane" in
    % | %*[!0-9]*) pane="" ;;
    %*) ;;
    *) pane="" ;;
  esac
  if [ -z "$server" ] || [ "$start" = invalid ] || [ -z "$pane" ]; then
    lm_notice no-reader "$ROOT" cause=unnamed
    return 0
  fi
  tmux_pane_live "$server" "$start" "$pane" || rc=$?
  case "$rc" in
    0) ;;
    1) lm_notice no-reader "$ROOT" cause=pane-gone ;;
    *) lm_notice reader-unjudged "$ROOT" cause=server ;;
  esac
  return 0
}

# Owner sends use full resolution; peer asks and replies share data-only
# resolution, so the caller cannot accept a record its replying peer misses.
lm_overseer_state() { # full|data ROOT ARGS...
  local scope="$1" root="$2"
  shift 2
  if [ "$scope" = data ]; then
    (cd -- "$root" && env -u ORCH_STATE_DIR "$SCRIPT_DIR/workflow-state" --no-private-env "$@") 2>"$WORK_DIR/reader.err"
  else
    (cd -- "$root" && "$SCRIPT_DIR/workflow-state" "$@") 2>"$WORK_DIR/reader.err"
  fi
}

# oversee register and oversee launch write the checkout-local fleet record.
# A missing record here is not a route to a remote overseer: owner-note owns
# that delivery. Hosted mail already addresses its destination through the
# provider; this shell cannot read that host's fleet state.
LM_OVERSEER_RECORD=""
lm_require_overseer() { # full|data ROOT
  local scope="$1" root="$2" path
  if ! path="$(lm_overseer_state "$scope" "$root" path oversee)"; then
    refuse overseer-unreadable "$root" "$(cat -- "$WORK_DIR/reader.err")"
  fi
  [ -n "$path" ] || refuse overseer-unreadable "$root"
  LM_OVERSEER_RECORD=null
  if [ -e "$path" ]; then
    LM_OVERSEER_RECORD="$(lm_overseer_state "$scope" "$root" get oversee '.overseer // null')" ||
      refuse overseer-unreadable "$root" "$(cat -- "$WORK_DIR/reader.err")"
  fi
  if [ "$LM_OVERSEER_RECORD" = null ]; then
    printf 'lane-mail: overseer-absent=%s no overseer is recorded here; use the owner-note tool for a remote overseer\n' "$root" >&2
    exit 2
  fi
}

# A notice on stderr that ends nothing: the keyed line closed by FIELD, the
# English, then the words of the command that could not answer, where any.
lm_notice() { # KEY VALUE FIELD [CAUSE]
  REFUSE_EXTRA="$3"
  lm_message "$1" "$2" >&2
  REFUSE_EXTRA=""
  [ -z "${4:-}" ] || printf '%s\n' "$4" >&2
}

# Every directive in a terminated to-lane.jsonl, one `{line, envelope}` object
# per line. Numbered over every complete line, parsing or not, as the cursor
# counts them, so a line number and the cursor are one scale: the one answer
# to which directives a reader has passed.
lm_directives() { # FILE
  jq -c -R -n --slurpfile numbers "$1.index" 'foreach inputs as $raw (0; . + 1;
    $numbers[. - 1] as $line
    | ($raw | try fromjson catch null)
    | select(type == "object" and .kind == "directive")
    | {line: $line, envelope: .})' <"$1" || refuse file-unreadable "$TO_LANE"
}

# The ids of asks to-lane.jsonl already answers, one per line, into DEST. It
# leaves the terminated to-lane.jsonl at WORK_DIR/lane.jsonl, which pending and
# drain --receipts read after it rather than fetching the file twice.
lm_answered() { # DEST
  lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
  lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
  lm_objects "$WORK_DIR/lane.jsonl" |
    jq -r 'select(.kind == "answer") | .re // empty' >"$1"
}

# Runs in a command substitution: a refusal exits that subshell after writing
# its keyed line, and errexit carries the status out. jq's words are captured
# at the site and replayed under the key, never ahead of it.
# One clock read stamps the id, `at` and the deadline, so the three cannot
# straddle a second; jq's todate spells the same UTC form `date` did. Every
# owner-channel field rides the variable its option set, the draft the file
# lm_draft wrote, and is written only where set, so an envelope with none is
# byte-for-byte what it was before.
lm_envelope() { # KIND [RE] — prints the line; the id lands in WORK_DIR/id
  local id now line
  now="$(date -u +%s)" || refuse write-failed "$BOX"
  id="$now-$$-$RANDOM"
  printf '%s\n' "$id" >"$WORK_DIR/id" || refuse write-failed "$WORK_DIR/id"
  line="$(jq -cn --arg id "$id" --arg kind "$1" --argjson now "$now" --arg re "${2:-}" \
    --arg from "$FROM" --arg halt "$HALT" --arg options "$OPTIONS" \
    --arg to "$TO" --arg ref "$REF" --arg attach "$ATTACH" --arg recommend "$RECOMMEND" \
    --arg reserved "$RESERVED" \
    --arg wait "$WAIT" --arg delivery "$DELIVERY_ID" --arg re_delivery "$RE_DELIVERY_ID" --arg by "$BY" \
    --arg thread "$THREAD_TS" --argjson parent "$PARENT_JSON" \
    --slurpfile draft "$DRAFT_RECORD" --rawfile text "$FILE" '
      {id: $id, kind: $kind, at: ($now | todate), from: $from}
      + (if $re == "" then {} else {re: $re} end)
      + (if $halt == "1" then {halt: true} else {} end)
      + (if $to == "" then {} else {to: $to} end)
      + (if $ref == "" then {} else {ref: $ref} end)
      + (if $attach == "" then {} else {attach: $attach} end)
      + (if $recommend == "" then {} else {recommend: $recommend} end)
      + (if $reserved == "1" then {reserved: true} else {} end)
      + (if $wait == "" then {} else {wait: ($wait | tonumber), deadline: (($now + ($wait | tonumber) * 60) | todate)} end)
      + (if $delivery == "" then {} else {delivery_id: $delivery} end)
      + (if $thread == "" then {} else {thread_ts: $thread, parent: $parent} end)
      + (if $re_delivery == "" then {} else {re_delivery_id: $re_delivery} end)
      + (if $by == "" then {} else {by: $by} end)
      + (if $kind == "answer" and $by != "" then {closes: false} else {} end)
      + (if $draft == [] then {} else {draft: $draft[0]} end)
      + {text: ($text | sub("\n$"; ""))}
      + (if $options == "" then {} else {options: ($options | split(","))} end)' \
    2>"$WORK_DIR/jq.err")" || refuse file-unreadable "$FILE" "$(cat -- "$WORK_DIR/jq.err")"
  printf '%s\n' "$line"
}
BY=""
RE_DELIVERY_ID=""

# Serialized on the file itself; to-overseer.jsonl has many writers, to-lane
# one. The lock, the created file and the closing of an unterminated last line
# are `lib/mailbox-append.sh`, the one owner a hosted append obeys too, so the
# two paths cannot drift apart. The here-string carries the line with the
# trailing newline a mailbox line ends on.
# GUARD, where given, is the check the library runs under the lock before the
# append; only an expected guard refusal returns 4 for the verb to name.
# Operational failures keep their diagnostics and never become a refusal
# based on an incomplete scan.
lm_append_local() { # FILE LINE [GUARD]
  local rc=0 candidate="" report=""
  mkdir -p -- "$BOX" || refuse write-failed "$BOX"
  if [ "$VERB" != resolve ] && [ -z "$DELIVERY_ID" ] && [ "${3:-}" != : ]; then
    candidate="$WORK_DIR/sent.json"
    printf '%s\n' "$2" >"$candidate" || refuse write-failed "$candidate"
  fi
  # The library opens the file itself, so a mailbox the lane cannot write is
  # the shell's own message on its stderr. Captured here and replayed under
  # the key, like every other failing command this script runs, so the keyed
  # line stays first and a reader is never met by a library path instead.
  mailbox_append_locked "$1" 30 "${3:-}" "$candidate" <<<"$2" 2>"$WORK_DIR/local.err" || rc=$?
  trap lm_cleanup EXIT
  if [ "$rc" -eq 4 ]; then
    report="$(cat -- "$WORK_DIR/local.err")" || refuse file-unreadable "$WORK_DIR/local.err"
    [ "${report#duplicate id=}" != "$report" ] || return 4
    refuse duplicate "${report#duplicate id=}"
  fi
  [ "$rc" -ne 5 ] || refuse mail-read-failed "$ITEM" "$(cat -- "$WORK_DIR/local.err")"
  [ "$rc" -ne 3 ] || refuse lock-failed "$1" "$(cat -- "$WORK_DIR/local.err")"
  [ "$rc" -eq 0 ] || refuse write-failed "$1" "$(cat -- "$WORK_DIR/local.err")"
  cat -- "$WORK_DIR/local.err" >&2
}

# The guards the library runs under the lock. Each reads the file the line
# would join, complete lines only, since the writer holding the lock has
# closed any fragment, and leaves what it found in the work directory for the
# verb's refusal to name.

# The envelope already carrying this send's delivery id, its id into
# WORK_DIR/delivery.earlier; refuses where one stands.
lm_guard_delivery() { # FILE
  jq -r -R --arg key "$DELIVERY_ID" '(fromjson? // empty) | objects
    | select(.delivery_id == $key) | .id | strings' <"$1" >"$WORK_DIR/delivery.earlier" || return 2
  [ ! -s "$WORK_DIR/delivery.earlier" ]
}

# The latest owner notice carrying this send's text and stamped within the 24
# hours before it, its id into WORK_DIR/notice.earlier; refuses where one
# stands. The text alone is judged: a report re-sent with another attachment,
# reference or minute is words the owner already holds. The candidate is the
# file lm_append_local wrote, since a message can exceed one argument.
lm_guard_owner_notice() { # FILE
  jq -n -r -R --rawfile sent "$WORK_DIR/sent.json" "$MAILBOX_TIME_JQ"'
    ($sent | fromjson) as $candidate
    | ($candidate.at | at_epoch) as $now
    | [inputs | (fromjson? // empty) | objects
      | select(.kind == "notice" and .to == "owner" and .text == $candidate.text)
      | (.at | at_epoch) as $at
      | select($now != null and $at != null and ($now - $at) >= 0 and ($now - $at) <= 86400)
      | .id | strings]
    | last // empty' <"$1" >"$WORK_DIR/notice.earlier" || return 2
  [ ! -s "$WORK_DIR/notice.earlier" ]
}

# The record already closing this ask, into WORK_DIR/resolved.earlier as
# `<id> <by> <delivery_id>`; refuses where one stands.
lm_guard_resolve() { # FILE
  mailbox_warn_legacy "$1" || return 2
  jq -r -R --arg re "$MSGID" "$MAILBOX_CLASS_JQ"' (fromjson? // empty) | objects
    | select(overseer_mail_class == "close" and .re == $re)
    | "\(.id) \(.by) \(.delivery_id // "")"' <"$1" >"$WORK_DIR/resolved.earlier" || return 2
  [ ! -s "$WORK_DIR/resolved.earlier" ]
}

# Slack answers and closes share this file's lock. A retry is judged before
# the close, so a delivery that landed before closing still names its answer.
lm_guard_owner_answer() { # FILE
  [ -z "$DELIVERY_ID" ] || lm_guard_delivery "$1" || return $?
  lm_guard_resolve "$1"
}

# A default supplies words only where the owner supplied none. Test and
# append under the close's lock so a reply racing its deadline wins if it
# landed first. The close record follows these optional answer bytes.
lm_guard_close() { # FILE
  lm_guard_resolve "$1" || return $?
  if [ "$BY" = default ]; then
    jq -r -R --arg re "$MSGID" '(fromjson? // empty) | objects
      | select(.kind == "answer" and .re == $re) | .id' <"$1" >"$WORK_DIR/owner.answers" || return 2
    [ ! -s "$WORK_DIR/owner.answers" ] || return 0
  fi
  [ -z "$ANSWER_LINE" ] || printf '%s\n' "$ANSWER_LINE" >&9 || return 3
}

# The ask in to-overseer.jsonl with that id, into ASK_JSON, read through
# lm_fetch as every read of this mailbox is: the one judge of what an ask is,
# for the resolve that closes one and the reply that names one. In the
# overseer mailbox that is an owner ask; in a lane's, the lane's own ask, which
# names no audience. Returns 1 with ASK_JSON empty where no such ask stands.
ASK_JSON=""
lm_ask_find() { # ID
  local to=""
  [ "$ITEM" != overseer ] || to=owner
  lm_fetch "$TO_OVERSEER" "$WORK_DIR/ask.raw"
  lm_terminated "$WORK_DIR/ask.raw" "$WORK_DIR/ask.jsonl"
  if ! ASK_JSON="$(lm_objects "$WORK_DIR/ask.jsonl" |
    jq -c --arg id "$1" --arg to "$to" 'select(.kind == "ask" and (.to // "") == $to and .id == $id)' | awk 'NR == 1')"; then
    refuse file-unreadable "$TO_OVERSEER"
  fi
  [ -n "$ASK_JSON" ]
}

# The host worker delivers owner requests with send --delivery-id. Read each
# possible reference under the lock its writers take, then copy the delivery
# id before releasing it. Take only one file lock at a time; the ask's or
# notice's append takes its own lock after this read.
lm_ref_find() {
  local path ref_json
  for path in "$TO_LANE" "$TO_OVERSEER"; do
    [ -f "$path" ] || continue
    exec 9<"$path" || refuse file-unreadable "$path"
    orch_take_lock 9 "$path" 30 || { trap lm_cleanup EXIT; refuse lock-failed "$path"; }
    trap lm_cleanup EXIT
    LM_HELD_PATH="$path"
    if [ "$path" = "$TO_LANE" ]; then
      lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
      lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
      ref_json="$(lm_objects "$WORK_DIR/lane.jsonl" |
        jq -c --arg id "$REF" "$MAILBOX_CLASS_JQ"' select(.id == $id and overseer_mail_class == "owner-note")' |
        awk 'NR == 1')" || refuse file-unreadable "$path"
    else
      lm_ask_find "$REF" || ASK_JSON=""
      ref_json="$ASK_JSON"
    fi
    if [ -n "$ref_json" ]; then
      RE_DELIVERY_ID="$(jq -r '.delivery_id // empty' <<<"$ref_json")" || refuse file-unreadable "$path"
    fi
    LM_HELD_PATH=""
    exec 9<&-
    orch_release_lock
    [ -z "$ref_json" ] || return 0
  done
  refuse ref-unknown "$REF"
}

# The ask ID closes or answers, refused where none stands.
lm_ask() { # ID
  lm_ask_find "$1" || refuse ask-unknown "$1"
}

# The line resolve prints, once per resolution however many times it is asked.
lm_resolved() { # ASK_ID BY ANSWER_ID
  printf 'lane-mail: resolved id=%s by=%s answer=%s\n' "$1" "$2" "$3"
}

# An owner ask's deadline: --wait as given, else ORCH_ASK_WAIT_MINUTES from
# the kendex settings ladder, else 120. Read only for an owner ask, whose
# deadline the owner-channel ask help gives its meaning, and the ladder is
# loaded here for the deadline. Record reads use lm_overseer_state, with the
# peer's settings read as data, never sourcing a file of the peer's.
lm_wait_minutes() {
  if [ "$WAIT_GIVEN" -eq 1 ]; then
    case "$WAIT" in
      '' | *[!0-9]*) refuse minutes-invalid --wait ;;
    esac
    return 0
  fi
  # shellcheck source=lib/kendex-env.sh
  . "$SCRIPT_DIR/lib/kendex-env.sh"
  kendex_load_project_env "$OWN_ROOT" 2>"$WORK_DIR/env.err" ||
    refuse file-unreadable "$OWN_ROOT/kendex.settings.toml" "$(cat -- "$WORK_DIR/env.err")"
  WAIT="${ORCH_ASK_WAIT_MINUTES-120}"
  case "$WAIT" in
    '' | *[!0-9]*) refuse minutes-invalid "ORCH_ASK_WAIT_MINUTES=$WAIT" ;;
  esac
}

# An owner ask's draft, the message the owner approves before it is sent as
# the owner: exactly recipient, medium and text, each a string holding a
# non-blank character, the medium one the relay delivers. text_hash is taken
# here over the decoded text the record carries, never read from the file, so
# `jq -j .draft.text | sha256sum` on the record reproduces it and an approval
# binds those exact bytes. The record reaches the envelope through
# WORK_DIR/draft.json, never argv.
lm_draft() {
  local verdict key value hasher hash
  { [ -f "$DRAFT" ] && [ -r "$DRAFT" ]; } || refuse file-unreadable "$DRAFT"
  verdict="$(jq -rs '
    if length != 1 or (.[0] | type) != "object" then error("a draft is one JSON object") else .[0] end
    | ((["recipient", "medium", "text"] - keys) + (keys - ["recipient", "medium", "text"])
       + [to_entries[] | select((.value | type) != "string" or (.value | test("^\\s*$"))) | .key]) as $bad
    | if $bad != [] then ["draft-field", $bad[0]]
      elif (.medium | IN("slack-channel", "slack-thread", "email")) then ["ok", ""]
      else ["draft-medium", .medium] end
    | @tsv' -- "$DRAFT" 2>"$WORK_DIR/jq.err")" ||
    refuse file-unreadable "$DRAFT" "$(cat -- "$WORK_DIR/jq.err")"
  IFS=$'\t' read -r key value <<<"$verdict"
  [ "$key" = ok ] || refuse "$key" "$value"
  if command -v sha256sum >/dev/null 2>&1; then
    hasher="sha256sum"
  elif command -v shasum >/dev/null 2>&1; then
    hasher="shasum -a 256"
  else
    refuse command-missing sha256sum,shasum
  fi
  jq -j .text -- "$DRAFT" >"$WORK_DIR/draft.text" 2>"$WORK_DIR/jq.err" ||
    refuse file-unreadable "$DRAFT" "$(cat -- "$WORK_DIR/jq.err")"
  # shellcheck disable=SC2086  # hasher is a command and its own arguments.
  hash="$($hasher <"$WORK_DIR/draft.text" 2>"$WORK_DIR/hash.err")" ||
    refuse file-unreadable "$WORK_DIR/draft.text" "$(cat -- "$WORK_DIR/hash.err")"
  DRAFT_RECORD="$WORK_DIR/draft.json"
  jq -c --arg hash "${hash%% *}" '{recipient, medium, text, text_hash: $hash}' -- "$DRAFT" \
    >"$DRAFT_RECORD" 2>"$WORK_DIR/jq.err" || refuse file-unreadable "$DRAFT" "$(cat -- "$WORK_DIR/jq.err")"
}

# The attachment, judged where it stands: a regular file, not itself a
# symlink, whose directory resolves physically to the progress-report
# directory workflow-state names, which is one rule at the one point the relay
# would otherwise carry any path it was handed. ATTACH is rewritten to the
# physical path so the relay opens what was judged.
lm_attach_confined() {
  local reports dir base
  reports="$("$SCRIPT_DIR/workflow-state" progress-report-path 2>"$WORK_DIR/reports.err")" ||
    refuse attach-outside "$ATTACH" "$(cat -- "$WORK_DIR/reports.err")"
  reports="$(cd -- "${reports%/*}" 2>/dev/null && pwd -P)" || refuse attach-outside "$ATTACH"
  { [ ! -L "$ATTACH" ] && [ -f "$ATTACH" ]; } || refuse attach-outside "$ATTACH"
  case "$ATTACH" in
    */*) dir="${ATTACH%/*}"; base="${ATTACH##*/}" ;;
    *) dir=.; base="$ATTACH" ;;
  esac
  dir="$(cd -- "$dir" 2>/dev/null && pwd -P)" || refuse attach-outside "$ATTACH"
  [ "$dir" = "$reports" ] || refuse attach-outside "$ATTACH"
  ATTACH="$dir/$base"
}

# The line alone crosses the transport, and the provider adds it under a lock
# on the host that holds the file. No lock here would be the recipient's: a
# sender reading the mailbox, adding its line and putting the file back locks
# its own disk, so two senders on different machines both read the same file
# and the second put drops the first one's line with no error. A failed append
# is probed like a failed read, so a host out of reach keeps its own key and
# the state an operator acts on, and `host-append` is a host that answered.
lm_append_host() { # FILE LINE
  local rc=0 report=""
  printf '%s\n' "$2" >"$WORK_DIR/send.line" || refuse write-failed "$WORK_DIR/send.line"
  "$SCRIPT_DIR/lane-host" append --item "$ITEM" "$1" <"$WORK_DIR/send.line" \
    >/dev/null 2>"$WORK_DIR/append.err" || rc=$?
  [ "$rc" -ne 0 ] || return 0
  if [ "$rc" -eq 4 ]; then
    report="$(cat -- "$WORK_DIR/append.err")" || refuse file-unreadable "$WORK_DIR/append.err"
    case "$report" in
      'duplicate id='*) refuse duplicate "${report#duplicate id=}" ;;
    esac
  fi
  lm_host_busy "$rc" "$WORK_DIR/append.err"
  lm_host_answers
  refuse host-append "$ITEM" "$(cat -- "$WORK_DIR/append.err")"
}

lm_read_file() {
  [ -n "$FILE" ] || refuse option-required --file
  { [ -f "$FILE" ] && [ -r "$FILE" ]; } || refuse file-unreadable "$FILE"
}

lm_after() { # VALUE
  case "$1" in
    '' | *[!0-9]*) refuse after-invalid "${1:-<unset>}" ;;
  esac
}

# FILE holds lines past the read cursor. Answers to notices have no `wait`,
# so inbox and watch must include them. A `wait` advances the same cursor
# past the answer it returns to keep that answer out of the next inbox read.
lm_inbox_objects() { # FILE
  lm_objects "$1"
}

# Replaced by rename, so a reader never meets a half-written count.
# lm_cursor_put answers with its status alone, for the --peek reads, which
# must not refuse; lm_cursor_write refuses where it fails.
lm_cursor_put() { # COUNT
  printf '%s\n' "$1" >"$WORK_DIR/cursor" && mv -- "$WORK_DIR/cursor" "$CURSOR"
}
lm_cursor_write() { # COUNT
  lm_cursor_put "$1" || refuse write-failed "$CURSOR"
}

# The count to-lane.cursor holds, as SEEN, read through the route every other
# read of this mailbox takes; a cursor that is not there counts 0, and
# CURSOR_ABSENT says it was not there, and CURSOR_COUNTED 0 says it held no
# count at all, absent or empty. inbox calls it under its lock; the readers
# that move no cursor take none, since the rename above never shows them half
# a count.
SEEN=0
CURSOR_ABSENT=0
CURSOR_COUNTED=1
lm_cursor_read() {
  lm_fetch "$CURSOR" "$WORK_DIR/cursor.read"
  CURSOR_ABSENT="$LM_FETCH_ABSENT"
  CURSOR_COUNTED=1
  SEEN="$(awk 'NR == 1 { print; exit }' <"$WORK_DIR/cursor.read")" || refuse file-unreadable "$CURSOR"
  case "$SEEN" in
    '') SEEN=0; CURSOR_COUNTED=0 ;;
    *[!0-9]*) refuse cursor-invalid "$CURSOR" ;;
  esac
}

lm_seconds() { # OPTION VALUE
  case "$2" in
    '' | *[!0-9]*) refuse seconds-invalid "$1" ;;
  esac
}

# Cursor, outbound, inbound: inbox takes the same cursor-before-mail order.
# Both mailbox locks span the exchange classification and the rewrite.
lm_compact_locked() {
  local counts root total
  lm_cursor_read
  lm_store plan "$BOX" "$WORK_DIR" "$COMPACT_CUTOFF" "$SEEN" "$MAILBOX_TIME_JQ$MAILBOX_CLASS_JQ"
  counts="$(cat -- "$WORK_DIR/counts.json")" || refuse file-unreadable "$BOX"
  total="$(jq '.["to-lane"] + .["to-overseer"]' <<<"$counts")" || refuse file-unreadable "$BOX"
  if [ "$total" -gt 0 ]; then
    # shellcheck source=lib/state-archive.sh
    . "$SCRIPT_DIR/lib/state-archive.sh"
    root="$OWN_ROOT"
    [ -n "$root" ] || root="$ROOT"
    archive_write "$root" "compact-$ITEM-$COMPACT_NOW" "" "$WORK_DIR/to-lane.jsonl" "$WORK_DIR/to-overseer.jsonl" ||
      refuse archive-failed "$ARCHIVE_DIR" "$ARCHIVE_ERR"
    REFUSE_EXTRA="kept=$ARCHIVE"
    lm_store rewrite "$BOX" "$WORK_DIR"
    REFUSE_EXTRA=""
    lm_message archived "$ARCHIVE" >&2
  fi
  jq -r --arg item "$ITEM" '"compacted item=\($item) to-lane=\(.["to-lane"]) to-overseer=\(.["to-overseer"])"' <<<"$counts"
}

case "$VERB" in
  compact)
    # Retention reads settings here, not on the hooks' reader path.
    COMPACT_DAYS="$("$SCRIPT_DIR/orch-env" ORCH_RECORD_RETENTION_DAYS 5)" || refuse retention-invalid ORCH_RECORD_RETENTION_DAYS
    # The relay's settings.py uses seven days when the setting is absent.
    THREAD_DAYS="$("$SCRIPT_DIR/orch-env" SLACK_THREAD_DAYS 7)" || refuse retention-invalid SLACK_THREAD_DAYS
    case "$COMPACT_DAYS:$THREAD_DAYS" in *[!0-9:]*) refuse retention-invalid "$COMPACT_DAYS:$THREAD_DAYS" ;; esac
    [ "$COMPACT_DAYS" -gt 0 ] && [ "$THREAD_DAYS" -gt 0 ] || refuse retention-invalid "$COMPACT_DAYS:$THREAD_DAYS"
    [ "$COMPACT_DAYS" -ge "$THREAD_DAYS" ] || COMPACT_DAYS="$THREAD_DAYS"
    COMPACT_NOW="$(date -u +%s)" || refuse write-failed "$BOX"
    COMPACT_CUTOFF="$((COMPACT_NOW - COMPACT_DAYS * 86400))"
    if [ ! -d "$BOX" ]; then
      printf 'compacted item=%s to-lane=0 to-overseer=0\n' "$ITEM"
    else
      lm_existing_lock 7 "$CURSOR.lock" lm_existing_lock 8 "$TO_OVERSEER" lm_existing_lock 9 "$TO_LANE" lm_compact_locked
    fi
    ;;

  ask | notice)
    lm_read_file
    if [ "$VERB" = notice ] && [ -n "$OPTIONS" ]; then
      refuse option-unknown --options
    fi
    # The overseer's own ask or notice names its audience, the field the
    # relay, the report and pending all read; one with none reaches nobody.
    [ "$ITEM" != overseer ] || [ -n "$TO" ] || refuse option-required --to
    # An owner ask names what its deadline does, by its form (the
    # owner-channel ask help states each); one naming no form (--recommend,
    # --reserved or --draft) says nothing, so it is refused. `ask:overseer` is
    # always an owner ask, the audience check above having refused every
    # other.
    if [ "$VERB:$ITEM" = ask:overseer ]; then
      # A reserved decision has no option safe to stand at its deadline, so
      # it names none. A draft's choices are fixed so its deadline never
      # approves a send made as the owner; the checks below then run on them.
      if [ "$RESERVED" -eq 1 ]; then
        [ -z "$RECOMMEND" ] || refuse option-conflict '--reserved,--recommend'
        [ -z "$DRAFT" ] || refuse option-conflict '--reserved,--draft'
      elif [ -n "$DRAFT" ]; then
        [ -z "$OPTIONS" ] || refuse option-conflict '--draft,--options'
        [ -z "$RECOMMEND" ] || refuse option-conflict '--draft,--recommend'
        OPTIONS=approve,deny
        RECOMMEND=deny
        lm_draft
      fi
      [ -n "$RECOMMEND" ] || [ "$RESERVED" -eq 1 ] || refuse recommend-required "$TO"
      [ -n "$OPTIONS" ] || refuse option-required --options
      # The envelope records --options split on commas, so a value holding a
      # comma spans two choices and is none of them; without one, a match
      # between the delimiters is exactly one of those choices.
      if [ -n "$RECOMMEND" ]; then
        case "$RECOMMEND" in
          *,*) refuse recommend-invalid "$RECOMMEND" ;;
        esac
        case ",$OPTIONS," in
          *",$RECOMMEND,"*) ;;
          *) refuse recommend-invalid "$RECOMMEND" ;;
        esac
      fi
      lm_wait_minutes
    fi
    if [ -n "$REF" ]; then
      case "$REF" in
        *[!A-Za-z0-9._-]*) refuse ref-invalid "$REF" ;;
      esac
      # The envelope answered is an owner note in to-lane.jsonl or an owner
      # ask in to-overseer.jsonl, the two things the owner reads a reply to;
      # a notice of this overseer's own, a peer's line and a resolution
      # answer nothing the owner wrote. The note is judged by the class the
      # watch reports it under, so a line the watch calls a peer's is never
      # the owner's here.
      lm_ref_find
    fi
    [ -z "$ATTACH" ] || lm_attach_confined
    LINE="$(lm_envelope "$VERB")"
    [ "$VERB" != notice ] || lm_receipt_fields "$LINE"
    # An owner notice is judged on its text for a day, under the lock after
    # the minute check, so a retry inside the minute keeps its `duplicate`.
    if [ "$VERB:$TO" = notice:owner ]; then
      lm_append_local "$TO_OVERSEER" "$LINE" lm_guard_owner_notice || {
        REFUSE_EXTRA="id=$(cat -- "$WORK_DIR/notice.earlier")"
        refuse owner-notice-repeated "$ITEM"
      }
    else
      lm_append_local "$TO_OVERSEER" "$LINE"
    fi
    if [ "$VERB" = ask ]; then
      printf 'id=%s\n' "$(cat -- "$WORK_DIR/id")"
    else
      lm_sent
    fi
    ;;

  send)
    lm_read_file
    [ "$ITEM" = overseer ] || lm_send_channel
    if [ "$DIRECTIVE" -eq 1 ] && [ -n "$MSGID" ]; then
      [ "$HALT" -eq 0 ] || refuse option-conflict '--re,--halt'
      refuse option-conflict '--re,--directive'
    fi
    if [ "$DIRECTIVE" -eq 0 ] && [ -z "$MSGID" ]; then
      refuse option-required --re
    fi
    [ "$HALT" -eq 0 ] || [ "$ITEM" != overseer ] || refuse option-conflict '--item=overseer,--halt'
    if [ -n "$MSGID" ] && [ "$ITEM" = overseer ]; then
      lm_ask "$MSGID"
      BY=text
    fi
    [ "$ITEM" != overseer ] || [ "$HOST" -eq 1 ] || lm_require_overseer full "$ROOT"
    # The delivery-id check runs under the lock on the disk that holds the
    # file; a provider's append takes no guard, so a hosted send carries none.
    [ -z "$DELIVERY_ID" ] || [ "$HOST" -eq 0 ] || refuse option-conflict '--host,--delivery-id'
    # The envelope is built first and judged whole; lm_envelope writes the id
    # into the work directory and prints the line, so a refusal below leaves
    # nothing in any mailbox.
    if [ "$DIRECTIVE" -eq 1 ]; then
      LINE="$(lm_envelope directive)"
    else
      LINE="$(lm_envelope answer "$MSGID")"
    fi
    # A send naming its delivery uses that key's guard under the append lock.
    # Other local sends and hosts with the repeat guard use the shared minute
    # check there. Older host libraries can append the same envelope again.
    lm_receipt_fields "$LINE"
    if [ "$HOST" -eq 1 ]; then
      lm_append_host "$TO_LANE" "$LINE"
    elif [ -n "$MSGID" ] && [ "$ITEM" = overseer ]; then
      if ! lm_append_local "$TO_LANE" "$LINE" lm_guard_owner_answer; then
        if [ -s "$WORK_DIR/delivery.earlier" ]; then
          REFUSE_EXTRA="id=$(cat -- "$WORK_DIR/delivery.earlier")"
          refuse delivery-repeated "$DELIVERY_ID"
        fi
        REFUSE_EXTRA="id=$(awk '{ print $1 }' <"$WORK_DIR/resolved.earlier")" ||
          refuse file-unreadable "$WORK_DIR/resolved.earlier"
        refuse resolved-already "$MSGID" "$(cat -- "$WORK_DIR/local.err")"
      fi
    elif [ -n "$DELIVERY_ID" ]; then
      lm_append_local "$TO_LANE" "$LINE" lm_guard_delivery || {
        REFUSE_EXTRA="id=$(cat -- "$WORK_DIR/delivery.earlier")"
        refuse delivery-repeated "$DELIVERY_ID"
      }
    else
      lm_append_local "$TO_LANE" "$LINE"
    fi
    lm_sent
    ;;

  resolve)
    [ "$ITEM" = overseer ] || refuse overseer-only "$ITEM"
    [ "$HOST" -eq 0 ] || refuse option-unknown --host
    [ -n "$MSGID" ] || refuse option-required --id
    if [ "$DEFAULT" -eq 1 ]; then
      [ -z "$FILE" ] || refuse option-conflict '--text,--default'
    elif [ -n "$FILE" ]; then
      lm_read_file
    fi
    lm_ask "$MSGID"
    if [ "$DEFAULT" -eq 1 ]; then
      BY=default
      RESERVED_ASK="$(jq -r '.reserved == true' <<<"$ASK_JSON")" || refuse file-unreadable "$TO_OVERSEER"
      [ "$RESERVED_ASK" = false ] || refuse ask-reserved "$MSGID"
      # The recommendation is the answer's text, crossing the file every
      # text crosses: nothing here builds an envelope from an argument.
      jq -r '.recommend // empty' <<<"$ASK_JSON" >"$WORK_DIR/default.txt" ||
        refuse file-unreadable "$TO_OVERSEER"
      [ -s "$WORK_DIR/default.txt" ] || refuse recommend-missing "$MSGID"
      FILE="$WORK_DIR/default.txt"
    elif [ -n "$FILE" ]; then
      BY=text
    else
      BY=explicit
    fi
    ANSWER_LINE=""
    [ "$BY" = explicit ] || ANSWER_LINE="$(lm_envelope answer "$MSGID")"
    : >"$WORK_DIR/close.txt" || refuse write-failed "$BOX"
    FILE="$WORK_DIR/close.txt"
    LINE="$(lm_envelope resolution "$MSGID")"
    CLOSE_ID="$(cat -- "$WORK_DIR/id")" || refuse file-unreadable "$WORK_DIR/id"
    if lm_append_local "$TO_LANE" "$LINE" lm_guard_close; then
      lm_resolved "$MSGID" "$BY" "$CLOSE_ID"
    else
      read -r EARLIER_ID EARLIER_BY EARLIER_KEY <"$WORK_DIR/resolved.earlier" ||
        refuse file-unreadable "$WORK_DIR/resolved.earlier"
      # The same delivery asking again gets the same close and no second
      # envelope: a relay that resolved and crashed before its mark cannot
      # turn the reply it holds into a directive.
      if [ -n "$DELIVERY_ID" ] && [ "$DELIVERY_ID" = "$EARLIER_KEY" ]; then
        lm_resolved "$MSGID" "$EARLIER_BY" "$EARLIER_ID"
      else
        REFUSE_EXTRA="id=$EARLIER_ID"
        refuse resolved-already "$MSGID" "$(cat -- "$WORK_DIR/local.err")"
      fi
    fi
    ;;

  events)
    lm_fetch "$TO_OVERSEER" "$WORK_DIR/over.raw"
    lm_terminated "$WORK_DIR/over.raw" "$WORK_DIR/over.jsonl"
    lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
    lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
    lm_objects "$WORK_DIR/over.jsonl" to-overseer || refuse file-unreadable "$TO_OVERSEER"
    lm_objects "$WORK_DIR/lane.jsonl" to-lane || refuse file-unreadable "$TO_LANE"
    ;;

  peer)
    lm_read_file
    # A peer's reply needs the caller's record too. Refuse the ask before
    # either append rather than delivering a question nobody can answer.
    [ "$PEER_VERB" != ask ] || lm_require_overseer data "$OWN_ROOT"
    [ "$HOST" -eq 1 ] || lm_require_overseer data "$ROOT"
    if [ "$PEER_VERB" = ask ]; then
      LINE="$(lm_envelope ask)"
    elif [ -n "$MSGID" ]; then
      LINE="$(lm_envelope answer "$MSGID")"
    else
      LINE="$(lm_envelope directive)"
    fi
    if [ "$PEER_VERB" = send ]; then
      lm_receipt_fields "$LINE"
    fi
    if [ "$HOST" -eq 1 ]; then
      lm_append_host "$TO_LANE" "$LINE"
    else
      lm_append_local "$TO_LANE" "$LINE"
    fi
    # An answer is read by the asker's `wait --item overseer --id`, which
    # reads to-lane.jsonl itself, so no named session is owed for it.
    if [ "$PEER_VERB" = send ]; then
      lm_sent
      [ -n "$MSGID" ] || lm_peer_reader
    fi
    # Record both directions locally for retention, only after delivery:
    # an undelivered ask must owe no answer, and an undelivered answer must
    # leave its inbound ask open. The id or receipt precedes the record so a
    # local write failure still tells the caller what the peer received.
    if [ "$PEER_VERB" = ask ]; then
      printf 'id=%s\n' "$(cat -- "$WORK_DIR/id")"
      lm_peer_reader
    fi
    if [ "$PEER_VERB" = ask ] || [ -n "$MSGID" ]; then
      lm_box "$OWN_ROOT"
      lm_plain
      lm_one_spelling
      lm_append_local "$TO_OVERSEER" "$LINE" :
    fi
    ;;

  wait)
    [ -n "$MSGID" ] || refuse option-required --id
    lm_seconds --timeout "$TIMEOUT"
    lm_seconds --interval "$INTERVAL"
    START="$(date -u +%s)"
    while :; do
      lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
      lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
      lm_objects "$WORK_DIR/lane.jsonl" |
        jq -c --arg re "$MSGID" 'select(.kind == "answer" and .re == $re)'>"$WORK_DIR/match"
      if [ -s "$WORK_DIR/match" ]; then
        : >>"$CURSOR.lock" || refuse write-failed "$CURSOR.lock"
        exec 9>>"$CURSOR.lock"
        orch_take_lock 9 "$CURSOR.lock" 30 || refuse lock-failed "$CURSOR.lock"
        lm_cursor_read
        ANSWER_ID="$(awk 'NR == 1' <"$WORK_DIR/match" | jq -r '.id')"
        jq -rR '(fromjson? // null) | if type == "object" then .id // "" else "" end' <"$WORK_DIR/lane.jsonl" >"$WORK_DIR/ids"
        ANSWER_AT="$(awk -v id="$ANSWER_ID" 'FILENAME == ARGV[1] { line[FNR] = $0; next }
          $0 == id { print line[FNR]; exit }' "$WORK_DIR/lane.jsonl.index" "$WORK_DIR/ids")"
        lm_after_file "$WORK_DIR/lane.jsonl" "$SEEN" "$WORK_DIR/unread" "$ANSWER_AT"
        lm_inbox_objects "$WORK_DIR/unread" >&2
        [ "$SEEN" -ge "$ANSWER_AT" ] || lm_cursor_write "$ANSWER_AT"
        awk 'NR == 1' <"$WORK_DIR/match" | jq -r '.text'
        exit 0
      fi
      NAP="$INTERVAL"
      if [ "$TIMEOUT" -gt 0 ]; then
        NOW="$(date -u +%s)"
        LEFT="$((TIMEOUT - (NOW - START)))"
        [ "$LEFT" -gt 0 ] || refuse timeout "$MSGID" "" 124
        # --timeout is a deadline, so a nap never runs past it: one shorter
        # than --interval would otherwise wait the whole interval, and one
        # that is not a multiple of it would overshoot by the remainder.
        [ "$LEFT" -ge "$NAP" ] || NAP="$LEFT"
      fi
      sleep "$NAP"
    done
    ;;

  inbox)
    case "${ACK:+k}$PEEK" in
      0 | k0 | 1) ;;
      *) refuse option-conflict '--peek,--ack' ;;
    esac
    [ -z "$ACK" ] || lm_after "$ACK"
    mkdir -p -- "$BOX" || refuse write-failed "$BOX"
    # One lock across the read and the rewrite, so the Stop hook and a
    # workflow wait point never hand the same line over twice. The lock is its
    # own file because a rename replaces the cursor, and a lock on the cursor
    # would be a lock on an inode the next reader no longer opens.
    : >>"$CURSOR.lock" || refuse write-failed "$CURSOR.lock"
    exec 9>>"$CURSOR.lock"
    orch_take_lock 9 "$CURSOR.lock" 30 || refuse lock-failed "$CURSOR.lock"
    trap lm_cleanup EXIT
    lm_cursor_read
    # A mailbox read before its first line still leaves a count behind: the
    # fleet's state sync reads this file outside this script and takes one
    # numeric line, which an empty file is not. An empty cursor an earlier
    # inbox left is given its count the same way. Written under the lock, so a
    # first read racing another never renames 0 over a count it advanced.
    # A peek writes the same 0 but never refuses on it: the hooks peek before
    # every tool call, and a write that cannot land there would refuse each
    # one, the call that frees the disk included. Where the count cannot land
    # the peek still leaves a cursor, empty, as pending needs one beside the
    # lock to tell a lane that has read from a read that missed.
    if [ "$CURSOR_COUNTED" -eq 0 ]; then
      if [ "$PEEK" -eq 0 ]; then
        lm_cursor_write 0
      else
        lm_cursor_put 0 2>/dev/null || { : >>"$CURSOR"; } 2>/dev/null || :
      fi
    fi
    # One snapshot of the mailbox and its complete-line count, which the
    # --ack branch and the read below both take the cursor from.
    lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
    lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
    COUNT="$(lm_count "$WORK_DIR/lane.jsonl")"
    if [ -n "$ACK" ]; then
      # The count stops at the complete lines present: a cursor past them
      # marks read a line not yet written, which no watch then announces and
      # no inbox then prints.
      ASKED="$ACK"
      [ "$ACK" -le "$COUNT" ] || ACK="$COUNT"
      # The count stops at the line before
      # the first unread halt, whatever a hook that showed it acknowledges.
      jq -r -R '(fromjson? // null) | if type == "object" and .halt == true then "halt" else "-" end' \
        <"$WORK_DIR/lane.jsonl" >"$WORK_DIR/kinds" || refuse file-unreadable "$TO_LANE"
      HALT_AT="$(awk -v seen="$SEEN" 'FILENAME == ARGV[1] { line[FNR] = $0; next }
        line[FNR] > seen && $0 == "halt" { print line[FNR] - 1; exit }' "$WORK_DIR/lane.jsonl.index" "$WORK_DIR/kinds")" ||
        refuse file-unreadable "$TO_LANE"
      [ -z "$HALT_AT" ] || [ "$ACK" -le "$HALT_AT" ] || ACK="$HALT_AT"
      [ "$ASKED" -le "$COUNT" ] || lm_notice ack-clamped "$ACK" "asked=$ASKED"
      if [ "$SEEN" -gt "$COUNT" ]; then
        # A cursor still past the lines present, one an --ack wrote before the
        # clamp above that no peek could lower, comes down to the count acknowledged, never to the
        # line count: a line that landed after the peek this count came from
        # is not one the lane was shown.
        lm_notice cursor-lowered "$ACK" "was=$SEEN"
      elif [ "$ACK" -le "$SEEN" ]; then
        # Forward only: a Stop hook that peeked before a workflow wait point
        # handed more over acknowledges a count the cursor has already passed.
        exit 0
      fi
      lm_cursor_write "$ACK"
      exit 0
    fi
    # A peek brings a cursor already past the lines present down to them, as a
    # plain read does: the hooks --ack only after a peek that printed a line,
    # and a peek over such a cursor prints none, so no --ack would ever lower
    # it and the next line written would be marked read. Like the first-read
    # 0 above, a write that cannot land never refuses the peek.
    if [ "$PEEK" -eq 1 ] && [ "$SEEN" -gt "$COUNT" ] && lm_cursor_put "$COUNT" 2>/dev/null; then
      lm_notice cursor-lowered "$COUNT" "was=$SEEN"
    fi
    [ "$PEEK" -eq 0 ] || lm_header "$WORK_DIR/lane.jsonl"
    lm_after_file "$WORK_DIR/lane.jsonl" "$SEEN" "$WORK_DIR/unread"
    lm_inbox_objects "$WORK_DIR/unread"
    # Rewritten only when it moves, so a read that found nothing new leaves
    # the file as it was.
    [ "$PEEK" -eq 1 ] || [ "$COUNT" = "$SEEN" ] || lm_cursor_write "$COUNT"
    exec 9>&-
    orch_release_lock
    ;;

  watch)
    lm_seconds --interval "$INTERVAL"
    # The mailbox a launch created. A watch of any other directory would poll
    # an empty mailbox forever and read as armed, and one whose mailbox is
    # removed under it, its worktree gone, has no lane left to wake.
    [ -d "$BOX" ] || refuse mailbox-missing "$BOX"
    # The command the woken turn runs, always naming the root this watch
    # resolved: the turn may run it from another checkout, where a read with
    # no root would open that checkout's mailbox instead.
    printf -v WATCH_READ '%q inbox --item %q --root %q' "$SCRIPT_DIR/lane-mail" "$ITEM" "$ROOT"
    # A trapped signal ends the wait below at once, and the EXIT trap then
    # withdraws the liveness record, so a send stops reading this monitor as
    # live the moment it is stopped. A KILL runs no trap: the record then goes
    # stale within its window, and the work directory stays.
    trap 'rm -f -- "$WATCH_FILE"; lm_cleanup' EXIT
    trap 'exit 129' HUP
    trap 'exit 130' INT
    trap 'exit 143' TERM
    # Lines up to here are announced, or read before this watch started; the
    # cursor the lane's own `inbox` moves raises it, so mail already read is
    # never announced, and a fresh watch announces what stands unread.
    ANNOUNCED=0
    while :; do
      [ -d "$BOX" ] || refuse mailbox-missing "$BOX"
      printf 'at=%s interval=%s\n' "$(date -u +%s)" "$INTERVAL" >"$WORK_DIR/watch.rec" &&
        mv -- "$WORK_DIR/watch.rec" "$WATCH_FILE" || refuse write-failed "$WATCH_FILE"
      lm_cursor_read
      [ "$ANNOUNCED" -ge "$SEEN" ] || ANNOUNCED="$SEEN"
      lm_fetch "$TO_LANE" "$WORK_DIR/lane.raw"
      lm_terminated "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl"
      lm_after_file "$WORK_DIR/lane.jsonl" "$ANNOUNCED" "$WORK_DIR/unread"
      NEW="$(lm_inbox_objects "$WORK_DIR/unread" | awk 'END { print NR + 0 }')" ||
        refuse file-unreadable "$TO_LANE"
      if [ "$NEW" -ne 0 ]; then
        REFUSE_EXTRA="new=$NEW" lm_message mail "$ITEM"
        printf '%s\n' "$WATCH_READ"
        # The exit is the wake, and the EXIT trap above withdraws the
        # liveness record with it, so a send meanwhile reads the monitor as
        # the none it is until the lane re-arms.
        [ "$ONCE" -eq 0 ] || exit 0
      fi
      ANNOUNCED="$(lm_count "$WORK_DIR/lane.jsonl")"
      # The copies of the mailbox this poll read go before the wait, so a
      # watch killed there leaves none of the lane's messages behind.
      rm -f -- "$WORK_DIR/lane.raw" "$WORK_DIR/lane.jsonl" "$WORK_DIR/unread"
      sleep "$INTERVAL" &
      wait "$!"
    done
    ;;

  drain | pending)
    [ "$VERB" != drain ] || lm_after "$AFTER"
    lm_answered "$WORK_DIR/answered"
    ANSWERED="$(cat -- "$WORK_DIR/answered")"
    # And what was sent the other way: from the to-lane.jsonl lm_answered
    # left, each directive against the cursor that says how far the reader
    # got. pending lists the ones not passed; drain --receipts lists them all
    # beside the cursor, clamped to the lines listed, so a directive appended
    # and read between the file read and the cursor read is not taken as read
    # before it was listed. Judged before anything is printed, so a pending
    # read that missed prints nothing but its refusal. The cursor is read
    # only where a directive would be printed: a pending kept to --to or
    # --due prints asks alone, so no cursor reaches its output and none
    # is judged.
    LISTS_DIRECTIVES=0
    if [ "$VERB" = pending ] && [ -z "$TO" ] && [ "$DUE" -eq 0 ]; then LISTS_DIRECTIVES=1; fi
    [ "$RECEIPTS" -eq 0 ] || LISTS_DIRECTIVES=1
    if [ "$LISTS_DIRECTIVES" -eq 1 ]; then
      lm_cursor_read
      lm_directives "$WORK_DIR/lane.jsonl" >"$WORK_DIR/directives"
      COUNT="$(lm_count "$WORK_DIR/lane.jsonl")" || refuse file-unreadable "$TO_LANE"
      # The cursor counts lines of an append-only file, so one above 0 over a
      # listing of no line is a listing that missed. Over one that has lines
      # it is a directive appended and read after the listing, clamped to it.
      if [ "$SEEN" -gt 0 ] && [ "$COUNT" -eq 0 ]; then
        SEEN=missed
      else
        [ "$SEEN" -le "$COUNT" ] || SEEN="$COUNT"
      fi
      # A cursor that is not there is one of two things, told apart here once:
      # a lane that has never read, whose inbox has made neither the cursor
      # nor its lock, or a read of it that missed, beside the lock every read
      # the lane has made left behind. Every inbox, a peek included, leaves
      # the cursor beside the lock; a first inbox creates the lock a moment
      # before it writes the cursor, so a read inside that moment is judged
      # missed as well: the watch moves nothing on it and pending refuses it.
      if [ "$CURSOR_ABSENT" -eq 1 ]; then
        lm_fetch "$CURSOR.lock" "$WORK_DIR/cursor.lock.read"
        [ "$LM_FETCH_ABSENT" -eq 1 ] || SEEN=missed
      fi
      # pending has no receipts line to carry `missed`: listed, a read that
      # missed shows directives the lane read as unread and, over a listing
      # that missed, answered asks as owed, so it is refused instead.
      if [ "$VERB" = pending ] && [ "$SEEN" = missed ]; then
        REFUSE_EXTRA=cursor=missed
        refuse mail-read-failed "$ITEM"
      fi
    fi
    lm_fetch "$TO_OVERSEER" "$WORK_DIR/over.raw"
    lm_terminated "$WORK_DIR/over.raw" "$WORK_DIR/over.jsonl"
    if [ "$VERB" = drain ]; then
      lm_header "$WORK_DIR/over.jsonl"
      lm_after_file "$WORK_DIR/over.jsonl" "$AFTER" "$WORK_DIR/new"
    else
      cat -- "$WORK_DIR/over.jsonl" >"$WORK_DIR/new"
    fi
    # An answered ask is not news again; `pending` is what is still owed a
    # reply. --to keeps one audience's asks and --due the ones past their
    # deadline by this clock, the one deadline judge the watch resolves its
    # owner asks by; a reserved ask is never due, since no default closes it.
    NOW_EPOCH="$(date -u +%s)" || refuse write-failed "$BOX"
    lm_objects "$WORK_DIR/lane.jsonl" | jq -r "$MAILBOX_CLASS_JQ"'select(overseer_mail_class == "close") | .re' >"$WORK_DIR/closed" ||
      refuse file-unreadable "$TO_LANE"
    CLOSED="$(cat -- "$WORK_DIR/closed")" || refuse file-unreadable "$WORK_DIR/closed"
    lm_objects "$WORK_DIR/new" | jq -c --arg answered "$ANSWERED" --arg closed "$CLOSED" --arg verb "$VERB" \
      --arg to "$TO" --argjson due "$DUE" --argjson now "$NOW_EPOCH" "$MAILBOX_TIME_JQ"'
      ($answered | split("\n")) as $done
      | ($closed | split("\n")) as $closed
      | . as $envelope
      | select($verb == "drain" or $envelope.kind == "ask")
      | select($envelope.kind != "ask" or
          ((if $envelope.to == "owner" then $closed else $done end) | index($envelope.id) | not))
      | select($to == "" or $envelope.to == $to)
      | select($due == 0 or ($envelope.reserved != true
          and (($envelope.deadline // "" | at_epoch) as $d | $d != null and $d <= $now)))'
    if [ "$VERB" = pending ] && [ "$LISTS_DIRECTIVES" -eq 1 ]; then
      jq -c --argjson seen "$SEEN" 'select(.line > $seen) | .envelope' <"$WORK_DIR/directives" ||
        refuse file-unreadable "$TO_LANE"
    elif [ "$RECEIPTS" -eq 1 ]; then
      HEADER="$(lm_header "$WORK_DIR/lane.jsonl")"
      printf 'receipts cursor=%s %s\n' "$SEEN" "$HEADER"
      jq -r "$MAILBOX_TIME_JQ"'
        .envelope as $e
        | select(($e.id | type) == "string" and ($e.id | test("^[A-Za-z0-9._-]+$")))
        | "\(.line) \($e.id) \(($e.at | at_epoch) // "")"' <"$WORK_DIR/directives" ||
        refuse file-unreadable "$TO_LANE"
    fi
    ;;
esac
