#!/usr/bin/env bash
# lanes — enumerate the harness auth "lanes" on this machine and measure each
# one's live usage, so a fleet launch can pick the account with real headroom
# instead of relying on supervisor memory.
#
# One account can back several sessions, so an account-level limit can stall
# several workers at once.
#
# SCOPE: mechanism only — inventory, measurement, and a default chooser.
# Policy (which model/effort tier, per-lane preferences, reserve thresholds)
# belongs in each consumer's own wrapper, because it is the part that differs
# per project. This deliberately exposes the numbers rather than deciding with
# them.
#
# Usage:
#   lanes list [--harness claude|codex|copilot|all] [--local] [--cache-only] [--no-cache] [--json]
#   lanes pick [--harness claude|codex|copilot|pi] [--max-pct N | --min-headroom-pct N]
#              [--model NAME] [--binding-floor] [--exclude-lane DIR]
#              [--for-overseer] [--no-cache] [--json]
#   lanes pick --lane <config-dir> [--harness claude|codex|copilot|pi]
#              [--max-pct N | --min-headroom-pct N] [--model NAME]
#              [--binding-floor] [--projected] [--no-cache] [--json]
#   lanes host-accounts [--harness claude|codex|copilot|pi|all] [--no-cache] [--json]
#   lanes context [--json]
#   lanes check <config-dir|name>
#   lanes state <item> [--json]
#   lanes facts --state-dir DIR ITEM
#
#   list  Print every lane found, measured, with its live claim count and the
#         age of its usage figure. A lane whose access token has expired is
#         RENEWED first unless --cache-only is set, its record marked
#         `refreshable`; one that cannot be renewed reports the status its
#         refusal took, with the cause. Table by default, --json for the
#         structured record; the table's last column, DETAIL, is the record's
#         `detail`, `-` where it carries none, so two lanes under one status
#         word still show which refusal each met. Each --json record carries
#         `verdict`: `room`, `walled` or `unmeasured`, its binding bucket
#         judged against ORCH_LANE_MAX_PCT by the rule `pick` with no --model
#         refuses on, so a reader of the listing never holds a second copy of
#         that threshold or its default. The verdict is the reading's, a wall
#         that lifts at binding_resets_at; `burn_pct_per_lane_hour` and
#         `projected_headroom_pct` beside it are the projection `pick` also
#         drops a lane on. Claims charge only their spending pool: Claude and
#         Codex windows count plan claims, Copilot counts Copilot claims, and
#         API grants carry no in-flight burn. An older claim without a pool is
#         a plan claim. Pick records name that allowance in `pool`.
#         Each record carries `retire_date`: the
#         ORCH_LANE_RETIRE date as YYYY-MM-DD, past or future, or null where
#         no entry names the account.
#         A weekly wall oversee-watch recorded from a lane's harness banner
#         (lib/account-wall.sh) holds that account's `weekly_pct` at 100 until
#         the reset the banner stated, whatever the usage endpoint reads; a
#         record that cannot be read reads the lane `error`.
#         Which STATUS word a failed Codex renewal reads, and its remedy, is
#         stated once, under "Why a Codex token is renewed by the Codex CLI"
#         below. The STATUS words are `ok`; `rate_limited`, an endpoint that
#         answered HTTP 429; `unreachable`, one that answered 5xx or that
#         nothing could be read from at all, or a renewal another tool's
#         credentials lock kept from being tried; `refused`, a usage endpoint
#         that answered any other code outside 2xx, 401 and 403 included, which
#         is a reading of the credential it was asked through and not a read
#         that was never made; `expired`, a login proven dead, or a failed
#         Codex renewal that section lists as `expired`; `no_credentials`;
#         `no_usage_data`, authenticated with no window to measure; `retired`;
#         and `error`, a step this machine failed on its own, a renewal's
#         included. A lane whose usage REFRESH met a 429 while the host still
#         holds a figure younger than the 5-hour session window, with no
#         consumed bucket reset reached, reports `rate_limited` ON that figure,
#         with its age in the AGE column, and is
#         judged on it; with no such figure it carries no window. Only `ok`
#         and a `rate_limited` lane carrying a figure are pickable. The split
#         matters because `expired` is the one word an operator answers by
#         logging in again, or for a Codex lane by the codex command its
#         `detail` names — `open-terminal` turns it into that remedy line — so
#         it goes only to a login proven dead and to those Codex outcomes.
#         An endpoint refusal names its HTTP code in `detail` unless a Claude
#         usage 401 or 403 has a profile that confirms an ended plan. That
#         detail names the free plan and canceled subscription.
#         Where ORCH_LANE_HOST names a provider that implements the OPTIONAL
#         `accounts` verb, its answer is merged in: one further row per account
#         the PROVIDER holds a credential for, carrying the windows read
#         through that credential. A provider without the verb answers exit 2,
#         which is no answer rather than a failure, and the listing is then the
#         local reading alone with nothing on stderr.
#         Every row says which credential measured it, in `measured_through`
#         (the THROUGH column): `local` for this machine's config dir, `host`
#         for the provider's own copy. The two readings of one account can
#         disagree — a local copy that can no longer be renewed reads
#         `expired` while the host's keeps working — and a launch on that
#         provider runs under the host's. A fleet with no provider lists the
#         local config dirs alone, as before.
#   host-accounts  Print the accounts the CONFIGURED PROVIDER reports holding a
#         credential for, one validated row per account, as `list` reads them:
#         the same field rules, the same account-and-harness requirement and the
#         same dropped row for a field nothing can parse. This is the only
#         reader of the `accounts` protocol, so a caller asking whether the host
#         holds an account inherits that validation instead of matching the
#         provider's bytes for itself. `all` is the claude, codex and copilot
#         rows; a Pi root's Copilot pool row comes back under --harness pi
#         alone. Tab-separated `config-dir` and `harness`
#         by default, `@tsv`-escaped, so a value carrying a tab, newline or
#         backslash is printed escaped; --json prints the whole records, each
#         marked `measured_through: "host"`, and is the exact form a caller
#         comparing a config dir reads. Exit 0 is an answer, rows or none; 2 is a
#         provider that does not implement the optional verb, with nothing on
#         stderr; 1 is the verb failing, the provider's own message first and
#         this script's keyed line under it. ORCH_LANE_HOST must name a
#         provider: `local` is refused rather than answered as an absent verb.
#         The answer is cached under ORCH_LANES_USAGE_TTL and time-bounded by
#         ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S; --no-cache asks the provider now,
#         which is what a caller deciding whether the host holds an account
#         passes, and is refused as `host-accounts-unbounded` on a machine with
#         no timeout command to bound that wait with. `list` and `pick` read the
#         answer through the cache, as they read every usage window.
#   pick  Print the launch env prefix for the lane to launch on (e.g.
#         `CLAUDE_CONFIG_DIR=/home/me/.eclaude`): among the lanes under
#         --max-pct, the one with the largest selection_score. Its formula is
#         H * (1 + 1 / (1 + T)), where H is projected headroom in percent and
#         T is hours to the binding reset, floored at zero. An unknown reset
#         earns no bonus (score H). For example, 80% room resetting in 1 hour
#         scores 120; 90% resetting in 9 hours scores 99. Equal room favors the
#         sooner reset. The bonus is at most twofold, so 11% cannot beat 100%
#         on reset time alone. Equal scores favor fewer live claims, then more
#         projected room. A Codex account at or above --max-pct is `room` on
#         its credits (`list` too: binding_bucket `credits`, HEADROOM its
#         balance) while `credits.balance` exceeds the credit floor below,
#         `has_credits` is true, and `overage_limit_reached` and
#         `spend_control_reached` are false. Expires first, the rule's one
#         statement: the pick spends the allowance that expires first,
#         sorting room candidates on [tier, E, -S, claims,
#         -projected_headroom_pct, wall]. Tier 0 is the Claude cloud credit
#         or a Pi anthropic/ API grant from a provider accounts row,
#         a grant that expires and does not refill. Cloud credit uses the
#         host's pool=cloud-credit; API credit uses the launch model's pool:
#         `remaining_dollars` above ORCH_LANE_CLOUD_CREDIT_FLOOR,
#         `limit_dollars` above 0, `locked_reason` null and E ahead, E the
#         earlier of the credit's `resets_at` and the account's
#         ORCH_LANE_RETIRE date. It is `room` whatever its plan windows read;
#         spent, locked or expired credit is walled, and unread credit is
#         unmeasured. Each refusal carries refusal={cause:"cloud-credit" or "api-credit",
#         retry_at:null}; the grant expiry is not a refill time. A cloud-credit
#         host spends no plan window. Tier 1 is every
#         refilling window; tier 2 a balance with no expiry, the Codex credits
#         above. E is 0 outside tier 0; S is the credit's share left times the
#         reset bonus of its hours to E in tier 0, selection_score in tier 1
#         and the balance in tier 2. A measured Claude account whose body has
#         no credit with numeric `remaining_dollars` and `limit_dollars` and
#         an E is no tier 0, one `lanes: cloud-credit-unread account=NAME`
#         line each. Under launch=cloud-session an account is a candidate
#         only where an ORCH_LANE_CLOUD_REPOS entry names the owner/repo of
#         this checkout's github.com origin; any other takes the verdict
#         `cloud-repo-unset`, a `lanes: cloud-repo-unset` line when none
#         qualifies. The entry records the account's one-time setup: the
#         cloud environment's setup script
#         (kendex's main-branch install.sh, run with --cli-only)
#         and repository access approved once, both claude.ai cards in a
#         session of that account on that repository. A lane is
#         judged on its PROJECTED wall, the smaller of two projected rooms.
#         The window that binds is charged, per live claim, one hour of its
#         burn: the measured rate, or ORCH_LANE_BURN_PCT_PER_HOUR where none
#         is measured, scaled by length for a weekly or model window (5/168)
#         and a monthly pool (5/720). The 5-hour session window is charged,
#         whatever binds, per live claim, its session burn for each hour left
#         to its reset, 1 to 5, or 1 where the reset is unknown: the measured
#         rate where the session binds and one is measured,
#         ORCH_LANE_BURN_PCT_PER_HOUR otherwise. Account-wide rates use claims
#         at sample time (at least one) as the divisor; model rates use one
#         because claims omit models. So an
#         account whose room the lanes already on it will spend is dropped the
#         way a walled one is. An OVERSEER SEAT is returned last, only while
#         its projected room exceeds ORCH_OVERSEER_SEAT_RESERVE_PCT (default 50).
#         A seat is an account `.overseer.account` names in this checkout's fleet
#         state, and every fleet state a live claim in the store names, which
#         is each fleet sharing OVERSEE_WATCH_STATE_DIR that runs a lane. The
#         host provider also names seats held on any machine with seat=1; a
#         fleet state that cannot be read refuses the pick with exit 1.
#         --for-overseer judges seats as ordinary accounts, with no reserve.
#         --json prints that lane's whole record, which carries headroom_pct,
#         binding_bucket (session, weekly, model, monthly or credits), the matching
#         binding_resets_at, claims, burn_pct_per_lane_hour,
#         projected_headroom_pct, selection_score, and qualifying_count from that same
#         judgement, with the two rooms projected_headroom_pct is the smaller
#         of, binding_projected_headroom_pct and session_projected_headroom_pct,
#         the session charge, session_burn_pct_per_lane_hour for each of
#         session_charge_hours, and projected_window, {bucket, pct,
#         resets_at}: the window whose projected room is the smaller, its
#         reading and its reset, null with no projection. With
#         --model those fields name the most-consumed
#         bucket among the shared 5-hour window, the all-model weekly window,
#         the named model's scoped weekly window, and for a Copilot account
#         or a Pi launch on the Copilot pool the monthly pool (see --harness). Exit 3 when no lane
#         qualifies, so a caller can fail closed rather than launch into a
#         wall; its keyed line on stderr says how many candidates were WALLED
#         at or above --max-pct with no credit room and how many measured
#         nothing for the launch, and `no-candidate-unmeasured` is every
#         candidate unmeasured, which is
#         a read to fix rather than an allowance to wait out. The table under
#         that line is `list`'s, DETAIL included, so each candidate's refusal
#         (a 429, a 403, an expired login) reads there. Two more causes
#         read differently from a reset to wait for. A lane counted WALLED can
#         be one whose reading has room and whose live lanes project past the
#         bound: `lanes list --json` shows its `claims` and
#         `projected_headroom_pct`, and it comes back as those lanes end, not
#         at a reset. And `seats=N` counts accounts judged `seat-reserve`,
#         each named on a `lanes: pick-seat-omitted lane=DIR projected-headroom=N
#         reserve=N` line. They return when their projected room exceeds the
#         reserve. Copilot pool picks, through Copilot or Pi, keep seats and
#         charge their pool claims at the monthly burn; they read no fleet state or provider seat marks. Under --json that exit
#         also prints `{"walled":N,"unmeasured":N,"seats":N,"qualifying_count":0,
#         "walled_resets_at":T,"refusals":[{config_dir:D,refusal:R}]}` on stdout,
#         the same counts, so a caller
#         walking several picks can report what each sweep found instead of
#         parsing the message written for a person. walled_resets_at is the
#         earliest retry among the walled candidates' deciding allowances.
#         A cloud grant states no retry. A plan window uses projected_window, judged
#         with --model as the pick is, the binding reset where one has no
#         projection, and null where none states a reset: when a launch of
#         that harness and model can first find room. A deciding window whose
#         reset is unknown states none; the binding reset never stands in.
#         Where ORCH_LANE_HOST names a provider that answers `accounts`, the
#         candidates are the rows `list` merges, with each account the provider
#         reports judged on the provider's reading IN PLACE OF this machine's:
#         a launch on that provider runs under its copy. So a config dir with no
#         local credentials file is picked on the host's windows, and one whose
#         local copy reads `expired` is judged on the host's. A host row that
#         measured nothing is dropped like any unmeasured lane, and an account
#         with neither a local file nor a host row stays `no_credentials`. The
#         stderr table under exit 3 names each candidate's THROUGH. A host row
#         carrying no `status` and no percentage says only that the provider
#         holds the account, so this machine's reading stands for it. A host
#         row read `unreachable` is a read the provider never made, not a
#         reading of its copy: where this machine's own reading of that config
#         dir is measured and younger than the usage window this caller serves
#         a cached figure under (ORCH_LANES_USAGE_TTL, or --max-age where
#         that is longer), the account is judged on it instead, under one
#         `lanes: pick-local-reading` line naming the lane and the figure's
#         age; where the local reading measures nothing or is older than that,
#         the unreachable row stays, so the refusal names the read that
#         failed. Every other host status is the provider's reading of its own
#         copy, `refused` and `expired` included, and stands as above, except
#         for a successful Claude reading with no window for --model: where a
#         fresh local reading carries a model window, pick uses the local
#         reading under `pick-local-model-reading`, judged on the shared
#         windows alone where none of its model windows names the model. It
#         keeps an account unmeasured, not empty, where the local reading
#         reads nothing, carries no model window or is older than that usage
#         window. An absent or failed verb leaves the local reading alone, as
#         it does for `list`.
#         `pick --lane` judges its one account by this same rule, and a dir
#         the provider reports with a reading is judged even where discovery
#         does not reach it. The overseer's own picks (oversee launch, the
#         succession walk and capacity count, oversee-succeed's headroom
#         mark) run under ORCH_LANE_HOST=local, since its session runs on
#         this machine's copy. So a folder whose local login a provider-side
#         retire removed reads `no_credentials` there and cannot seat an
#         overseer.
#
#         With --lane <config-dir> it judges that ONE account instead of
#         choosing among the fleet, measuring only that directory. A launcher
#         that was handed a lane asks this rather than rebuilding the rule.
#         It judges the wall READING, the question every caller asking whether
#         an account is out of room now puts: a lane's handoff mark, a lane
#         close, an overseer's own mark. --projected judges the projected wall
#         the chooser judges instead, for a launcher about to add a lane, so a
#         lane a person names is refused on the rule the chooser drops it on.
#         A seat is judged against the reserve too: a running lane hands off
#         at its first turn end at or below it, so it can overrun by one turn.
#         --for-overseer exempts the overseer's own mark from the reserve.
#         Under --json, usage_cache names the local measured record's path and
#         served_until epoch, or is null when no local figure was measured.
#         Exit 0 has room and prints the env prefix, or the lane's record under
#         --json; 3 is a wall at or above --max-pct no credit room lifts, or
#         `verdict=seat-reserve` at or below the seat reserve; 5 is a lane nothing
#         measured for this launch, whether no window names --model or the
#         account's usage could not be read at all, and under --json its record
#         is printed too, whose `status` says which, or a Pi model whose
#         provider nothing measures, `pick-provider-unmeasured`, refused before
#         any lane is read, so it prints no record under --json and its cause
#         is that keyed stderr line alone; 4 is a directory that is no
#         configured lane of this harness and no account the provider reports a
#         reading for, which a launcher reads as nothing to
#         judge rather than as a refusal; 7 is `cloud-repo-unset`, a cloud
#         session account with no repository entry, and prints no record;
#         1 is the judge itself failing, on a
#         measurement or on a --max-pct this parser refused. Every exit but 0
#         puts its keyed line on stderr. A claim store that could not be read is
#         a NOTICE on stderr and no exit of its own: the record's `claims` and
#         `projected_headroom_pct` are null and the wall reading alone is
#         judged. Under --projected it is exit 6 instead, keyed
#         `pick-lane-claims-refused`, before anything is measured: that verdict
#         charges the claims, and none counted is not none in flight.
#         Unread overseer seats print `pick-overseer-seats-unread` and judge
#         the wall reading alone, with no seat reserve. Under --projected
#         they instead refuse with exit 8, keyed `pick-overseer-seats`, before
#         local or provider usage is read.
#         A cloud-credit refusal on 3 or 5 carries `refusal`, whose cause and
#         retry_at decide the refusal instead of any plan fields. Other records
#         printed on 3 under --json carry `wall` and `binding_bucket`,
#         the binding reading, beside `projected_headroom_pct` and
#         `projected_window`: a --projected caller names its refusal from
#         `projected_window`, as the `pick-lane-walled` line's wall= and
#         bucket= do under --projected, and any other caller from the reading.
#   context  Print context use for each live work lane in this fleet, as its
#         own turn-end hook recorded it: the tokens the last response left in the
#         context, read by the harness adapter (lib/lane-context.sh) from the
#         transcript, and its effective compaction point; a Copilot CLI lane's
#         is the reading its kendex extension took of Copilot's
#         `session.usage_info`, the capacity the limit Copilot compacts at,
#         whose source the --json row names in `context_capacity_source`, or,
#         where no such reading stands, the one its turn end took from the
#         session record its status line writes (references/copilot-runtime.md);
#         one with neither is `unrecorded`, never room. No pane is
#         read. A lane's reading is in its own mailbox, which the running
#         lane record of the fleet state (`workflow-state get oversee`)
#         places, read through the provider that record names. A running
#         lane record no claim names, a lane launched with no --lane, is a
#         row of its own, its `pane` the record's
#         SESSION:WINDOW and its server null. The
#         caller's own row with no lane record is the overseer, which is
#         judged at its own turn end and reads `unrecorded` here.
#         CONTEXT_USED_PCT is the share of that effective capacity CONSUMED. A row
#         with no reading is `unrecorded`, never empty; one whose reading names
#         no window is `window-unread`; one whose record could not be read, or
#         a claimed window no running lane record places, is `unreadable`. HANDOFF is
#         `required` when lib/lane-context.sh's shared context rule requires
#         handoff, the judge the hook uses, or at a HEADROOM at or
#         below ORCH_HANDOFF_HEADROOM_PCT (default 3), or on a seat at or below
#         ORCH_OVERSEER_SEAT_RESERVE_PCT. The caller's own row uses the ordinary
#         mark. An account room on its credits (see pick) is never marked by
#         headroom; its HEADROOM is its balance.
#         --json carries `binding_bucket`, `credits` and `binding_resets_at`;
#         the last is when the binding window resets, a credits row's spent
#         plan window, in whole-second UTC with a Z, so a headroom
#         refusal can say when the account returns. It also carries `server`, the tmux server the row's
#         `pane` belongs to, since pane ids restart at %0 on every server.
#         The caller's OWN pane is reported too, claim or no claim, so an
#         overseer started by hand sees its own figure rather than an empty
#         fleet, and that row alone carries `caller: true` — the report says
#         which row is the reader's session so no reader has to work it out.
#   state  Print what the lane for <item> is doing, as the one word
#          lib/lane-state.sh judges it to be: working, idle, rate-limit-switch,
#          asking, walled, exited or unjudged. rate-limit-switch adds a fix line
#          on stderr to dismiss the reminder and keep the current model.
#          <item> is the lane's tmux window name, which is
#          the tracker id (TEAM-N) or gh-N; the SESSION:WINDOW form a lane
#          record's `window` carries is accepted too, and names that window
#          under exactly that session. Pass the record's `window` as it stands:
#          the whole name selects the pane. The hosted probe uses the record's
#          item, or the window part when no record exists. A hosted record declaring
#          status=verb checks the remote harness first. Its pane=verb capture
#          comes from the provider; other lanes keep the local pane reading.
#          This answers exactly as oversee-watch does
#          about the same lane, except for a window a running fleet lane
#          record names as a Pi lane: that one is judged from the rows its
#          lane-mail-check hook writes in its mailbox (lib/session-rows.sh),
#          through its host where the record names one, and never from its
#          pane, so a Pi lane with no row is `unjudged` and never `asking`;
#          a fleet state whose records cannot be read refuses as
#          `lanes: state-fleet`. The local pane is the fallback for an
#          unrecorded pane=local lane. An unrecorded pane=verb lane is
#          unjudged because no record names its remote harness.
#          A Copilot allow-all lane's record note is on stderr beside it
#          (references/copilot-runtime.md).
#          A local name no pane on this server carries is
#          `unjudged`: a window that closed and a name two windows share are
#          the same silence from here. `gone` is the judge's answer for a
#          window a caller has already found absent, which this verb never
#          asserts, so it is not among the words printed here. Where
#          the lane's resolved host names a provider, `lane-host touch` says whether
#          the HOST answers; a failed probe prints `lanes: host-unreachable`
#          on stderr with the provider's own message, one lane-host refused at
#          its per-home cap `lanes: lane-host-busy`, and either leaves the state
#          alone. --json prints {"item":..,"state":..}. Exit 1 when a scan
#          failed rather than answered.
#   facts  Read one exact launched item from DIR's oversee workflow state.
#          Print one JSON object: item; status (read, absent or failed); reason
#          (null on read, a stable key otherwise); stage (the last recorded
#          stage kind or null); review_rounds, fix_receipts, validation_runs,
#          restacks and repeated_class_rounds (recorded-derived numbers or
#          "unread", using lane_state_rounds); post_pr_stop (null or the recorded
#          gate and name). Non-read results carry null for all facts.
#          Exit 0 means read; 1 means confirmed absence; 2 means failed or
#          unbound read. Absence reasons are root-gone, state-absent and
#          files-none. Failure reasons are fleet-unread, record-missing,
#          record-ambiguous, record-invalid, root-unbound, root-unread,
#          state-unread, state-invalid and scratch-unavailable.
#          DIR binds the fleet state. The lane's host and mail_root bind its
#          own state. Reads use existing host capabilities and file transport.
#          No read uses another item key or the caller checkout as fallback.
#          A parked sandbox stays stopped. No live activity or GitHub is read.
#   check  Exit 0 when no lane setting excludes or retires <config-dir>, or the
#         lane a bare name or alias names; exit 4 with `lanes: lane-excluded`
#         or `lanes: lane-retired` when one does, so a caller can tell a
#         covered lane from a failure (exit 1). Nothing inside the directory is
#         read. Prints the resolved config dir on stdout, or nothing for an
#         unknown bare name. A bare name resolves the first local alias match
#         in list's inventory. `open-terminal` asks it for every named --lane.
#
# Options:
#   --harness NAME   claude, codex, copilot, or all (default: all for list,
#                    claude for pick).
#                    pick also takes pi, judged on the account its --model's
#                    provider bills (lib/lane-launch.sh lane_pick_harness). A
#                    `pi-claude/` model runs Claude Code on a Claude seat
#                    through pi-claude-bridge, so the pick is a claude pick on
#                    that model in every respect, its prefix CLAUDE_CONFIG_DIR.
#                    A `github-copilot/` model spends the Copilot pool rather
#                    than any Claude or Codex window, and is judged on that
#                    pool alone. The pool is read live where ORCH_LANE_HOST
#                    names a provider: its `accounts` verb's harness=pi row for
#                    a Pi root carries the pool as `monthly-pct` and its reset
#                    as `monthly-resets`, which reach the record as
#                    `binding_resets_at` (schemas/lane-host.md). The
#                    ORCH_LANE_COPILOT_POOL setting is the override, judged
#                    only for a Pi root no provider row reads. Its candidates
#                    are the Pi roots either names. Where none carries a
#                    reading and none is walled the pick exits 5 as
#                    `copilot-pool-unstated`, and under --lane a directory
#                    neither reads is unmeasured (exit 5), never unlisted;
#                    each prints a `fix=` line naming the read that failed,
#                    a provider row's own status and detail among them, and
#                    its repair. An accounts read that failed or was busy,
#                    with no override entry for a Pi root (one for a Copilot
#                    CLI home names none), exits 1 as `copilot-pool-unread`,
#                    which asking again can answer. A provider row says
#                    `measured_through: "host"` and a stated reading "stated";
#                    a stated pool that is walled stays walled until the owner
#                    states a new reading. The printed prefix is
#                    PI_CODING_AGENT_DIR, and `list` does not show them. Any
#                    anthropic/ model spends API credit instead, read only
#                    from a provider harness=pi accounts row with credit-limit,
#                    credit-spent, credit-remaining and credit-expires. Its
#                    account is the Claude home create receives; the provider
#                    maps that account to the remote Pi root. API and Copilot
#                    rows are separate candidates. No local host or Copilot
#                    override measures API credit. An unread API row names
#                    its detail and exits 5: the automatic form prints
#                    pick-provider-unmeasured; --lane prints
#                    cloud-credit-refused with cause=api-credit. Both become
#                    lane-provider-unmeasured at launch. A failed accounts
#                    command exits 1 with its original busy or timeout cause.
#                    Any other provider, and a Pi pick naming no model, exits 5 as
#                    `pick-provider-unmeasured` in both forms, before any lane
#                    is read: nothing measures what it spends.
#   --max-pct N      pick: refuse a lane whose binding bucket is at or above N
#                    percent used, Codex credit room excepted (see pick)
#                    (default: 95, or $ORCH_LANE_MAX_PCT). The
#                    setting is read through the kendex settings ladder below,
#                    so the launch gate and a pick typed by hand hold one
#                    threshold; the flag still overrides it.
#   --min-headroom-pct N  pick: the same bound in the record's own unit, the
#                    `headroom_pct` every row carries: keep only a lane with
#                    MORE than N percent headroom, so one sitting exactly at N
#                    is refused, credit room excepted as for --max-pct. It
#                    is converted to --max-pct once, so both
#                    spellings reach the one comparison and the last one passed
#                    wins.
#   --lane DIR       pick: judge that one config dir instead of choosing among
#                    the fleet; no other lane is measured
#   --model NAME     pick: judge the bound against the bucket that walls a
#                    launch on NAME — the 5-hour session window, the plan-wide
#                    weekly window, the model-scoped weekly window whose
#                    label names NAME, and the monthly Copilot pool a Copilot
#                    account or a Pi launch on a `github-copilot/` model
#                    spends — instead of the binding bucket. A lane
#                    whose windows answer nothing for NAME is never picked.
#                    The scoped model window alone is not enough because either
#                    shared window can wall every model on the account. A
#                    reading whose model windows name none of NAME is judged
#                    on the shared windows alone; behind a host row with no
#                    window for NAME, a local reading with no model window, or
#                    a stale one, stays unmeasured (see pick).
#                    On claude, codex and copilot, a model class NAME is
#                    judged as the model `kendex tier-model` reads for it
#                    (lib/overseer-launch.sh § ol_model_class), and as no
#                    NAME where the class has none on that harness. A
#                    claude or codex NAME the class table does not name, an
#                    old exact id, warns once as `preference-deprecated`;
#                    a copilot NAME, which no class names, is judged as
#                    written. A table kendex cannot
#                    answer exits 1 as `model-class-unread`.
#   --binding-floor  pick: hold the account's own binding bucket to the same
#                    bound as well, so a lane is room only where BOTH clear it.
#                    With --model the two can differ: an account whose binding
#                    bucket is a model this launch will not pass has room for
#                    the launch and none of its own. Pass it for a caller whose
#                    launched session will be judged on the binding bucket
#                    rather than on --model — every codex session, which
#                    lib/lane-context.sh judges on its binding bucket. A session that
#                    WILL be judged on --model is already held to the reading
#                    it takes, and the flag would then refuse it an account
#                    over a window neither judgement reads. Without --model the
#                    binding bucket is the judged wall, so the flag asks for
#                    what is judged anyway.
#   --exclude-lane DIR  pick: omit this config dir before the chooser judges
#                    the remaining accounts. Used when the caller needs a
#                    different account rather than capacity on its own.
#   --for-overseer   pick, with or without --lane: judge seats as ordinary
#                    accounts, with no reserve or last rank, for an overseer's
#                    launch or its own mark.
#   --projected      pick --lane: judge the projected wall rather than the
#                    reading, for a launch about to add a lane to the account.
#                    Refused without --lane, since the chooser always judges it.
#   --local          list: this machine's config dirs alone. The provider is
#                    not asked, so a caller looking a config dir up by alias
#                    costs no round trip and meets no hosted row.
#   --no-cache       Fetch every lane's usage afresh instead of reusing a
#                    cached figure; the fresh figure still refreshes the cache.
#                    A RECORDED REFUSAL is not a cached figure and is not
#                    bypassed: an operator asking for a fresh reading must not
#                    be the one caller on the host that posts again what the
#                    endpoint has already refused. A lane the usage endpoint
#                    refuses with 429, on record or on this run's own fetch,
#                    is answered from the last figure only while it is younger
#                    than the 5-hour session window and no consumed bucket
#                    reset has arrived. It reports `rate_limited` with that
#                    figure's age, or no usable figure when either bound ends.
#                    A live refusal still blocks a new request. A refresh
#                    still takes the host-wide refresh lock.
#   --cache-only     List from eligible cached usage or a live recorded refusal,
#                    without usage requests, token renewal or provider accounts.
#                    Implies --local. A cache miss reports `unreachable`, with
#                    no windows, credits or usage age. --max-age still widens
#                    the ordinary serve age; a TTL of 0 disables ordinary
#                    figures. A live usage 429 can still carry its retained
#                    last figure under the refusal policy below.
#   --max-age SECS   Serve a cached usage figure up to SECS old, for a caller
#                    naming its own pass interval. It WIDENS
#                    ORCH_LANES_USAGE_TTL and never narrows it, so a caller
#                    passing nothing, or less than the TTL, keeps the TTL. A
#                    TTL of 0 is never widened: no ordinary figure is served.
#                    The live usage-429 retained-figure policy still applies.
#                    A consumed bucket reset ends eligibility before this age.
#                    ORCH_LANES_USAGE_MAX_AGE is the same value as a setting.
#   --json           Machine-readable output
#
# The lane INVENTORY is always discovered, never hand-maintained: config is an
# overlay on top of it, so adding an account needs no edit anywhere. Discovery
# is `~/.claude` plus every `~/.*claude*` directory, `~/.codex` plus every
# `~/.*codex*` directory plus $CODEX_HOME when it is set, and `~/.copilot` plus
# every `~/.*copilot*` directory plus $COPILOT_HOME when it is set; a
# discovered directory with no config marker (claude `.claude.json` or
# `.credentials.json`, codex `auth.json` or `config.toml`, copilot
# `config.json` or `session-state`, which only Copilot CLI writes: a Pi root,
# whose name can hold `copilot`, writes `settings.json` as a Copilot home
# does) is skipped. A setting names a lane by its
# directory name, with or without the leading dot, or by its alias; a name
# carrying `/` or `~` is a path, names no lane, and is refused.
#
# COPILOT: the account's monthly AI credit pool, read from GitHub's usage
# endpoint with the login Copilot CLI keeps in `<dir>/config.json` or the
# Linux Secret Service, through lib/copilot-credits.sh, which owns the
# endpoint, the login layout it assumes and the rules for zero, overage and
# unlimited; the record is schemas/copilot-credits.md. The pool is a MONTHLY
# bucket, `monthly_pct`, with the counts beside it as `credits`. An account
# whose login does not read takes its ORCH_LANE_COPILOT_POOL reading where the
# setting states one, and reads `no_credentials` under the login's keyed
# reason otherwise.
#   ORCH_LANE_ALIASES  Comma-separated `<config-dir-name>=<alias>` pairs giving
#                      lanes meaningful names (`eclaude=work,mclaude=overflow`).
#                      A directory with no mapping keeps its discovered name.
#   ORCH_LANE_DIRS     Colon-separated config dirs, for a layout discovery does
#                      not reach. An entry holding config.json and no
#                      .credentials.json is a Copilot lane, one holding
#                      auth.json and no .credentials.json is a Codex lane, and
#                      any other entry is a Claude lane. A harness's entries replace its discovery;
#                      a harness with no entry is still discovered. An excluded
#                      or retired entry is never probed: a name holding `codex`
#                      is a Codex entry, one holding `copilot` a Copilot entry,
#                      any other a Claude one, and it still
#                      turns that harness's discovery off.
#   ORCH_LANE_EXCLUDE  Comma-separated lane names (`sclaude,claude`) that are
#                      never listed, measured or picked: nothing inside an
#                      excluded directory is read, not even to tell its harness.
#   ORCH_LANE_RETIRE   Comma-separated `<name>=<YYYY-MM-DD>` pairs
#                      (`oldclaude=YYYY-MM-DD`). The lane is picked until that
#                      UTC date; from it on, `list` shows it as `retired` and
#                      nothing inside it is read. A malformed pair, or a date
#                      naming no calendar day, is refused.
#                      Both reach an account a lane host reports as well as a
#                      config dir on this machine: the setting says the account
#                      is not this fleet's to use, which a copy of it on another
#                      machine does not change.
#   ORCH_MODEL_RECOVERY_LIMIT (default 3): refuse this item's Nth consecutive
#                      model-switch recovery after N-1 successful replacements.
#                      A replacement's first turn without a mismatch resets it.
#                      Refusal: lane-relaunch: model-recovery=limit item=ITEM
#                      recoveries=COUNT limit=N. The fleet log keeps one row.
#   ORCH_LANE_MAX_PCT  The default of --max-pct (default 95), read against the
#                      binding bucket or, with --model, against the window that
#                      walls that model, and never compared with
#                      ORCH_HANDOFF_HEADROOM_PCT. Refused, before any lane is
#                      measured, when it is not an integer 0-100.
#   ORCH_OVERSEER_SEAT_RESERVE_PCT  Room kept in each plan window for the
#                      overseer (default 50, provisional). A seat is admitted
#                      only above this reserve, ranked last. Running lanes on
#                      it hand off at or below it. 100 admits no seat and marks
#                      every lane on one; 0 uses --max-pct alone, still last.
#                      Keep it above ORCH_OVERSEER_HEADROOM_PCT. Credits do not
#                      spend plan windows. Refused before any measurement when
#                      it is not an integer 0-100.
#   ORCH_LANE_BURN_PCT_PER_HOUR  Percentage points of the 5-hour session window
#                      one live lane is expected to spend in an hour: the
#                      burn `pick` charges a live claim wherever it charges
#                      no measured rate. Which window it is charged on, and
#                      for how long, is the PROJECTED wall under `pick`
#                      (default 5; 0 charges nothing there). Refused, before any lane is measured,
#                      when it is not an integer 0-100.
#   ORCH_LANE_CODEX_CREDIT_FLOOR  Credits, never a percentage, a Codex
#                      account past the threshold must exceed (default 5000,
#                      provisional; see `pick`). Refused, before any lane is
#                      measured, when it is not a whole number 0 or more.
#   ORCH_LANE_CLOUD_CREDIT_FLOOR  Dollars, never a percentage, a Claude cloud
#                      or Pi Anthropic API credit must exceed (default 10,
#                      provisional; see `pick`). Refused, before any lane is
#                      measured, when it is not a whole number 0 or more.
#   ORCH_LANE_CLOUD_REPOS  Comma-separated `<name>=<owner>/<repo>` pairs, one
#                      per account and repository it was given access to,
#                      which a cloud-session pick keeps (see `pick`). A
#                      malformed pair is refused.
#   ORCH_LANES_USAGE_TTL  Seconds a cached usage figure is reused (default 300;
#                      0 disables ordinary figures, but not the live usage-429
#                      retained-figure policy). Keep it at least the longest watch
#                      interval on the host — `oversee-watch --interval`
#                      defaults to 240 — because a TTL under that interval has
#                      every pass find the figure expired and fetch again. The
#                      provider's `accounts` answer is cached under the same
#                      TTL. A consumed bucket reset ends cache eligibility
#                      before that TTL or a wider --max-age. The age limit is
#                      this TTL widened by --max-age, and the same limit
#                      bounds the age of a local figure `pick` judges in place
#                      of a provider row read `unreachable`.
#   ORCH_LANES_USAGE_MAX_AGE  The default of --max-age (default 0, which is the
#                      TTL alone): the caller's own pass interval, in seconds.
#                      A pass longer than the TTL serves its last figure until
#                      that age limit or a consumed bucket reset arrives.
#   ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S  Seconds the provider's `accounts` verb
#                      may take (default 30; 0 asks for no bound). Applied
#                      where `timeout` or `gtimeout` is installed. A bound
#                      reached is the verb failing, reported as
#                      `host-accounts-unreadable`. A bounded call waits for a
#                      lane-host slot for less than the bound, so a full
#                      ORCH_LANE_HOST_SHORT_MAX_CALLS cap reads as `lane-host-busy`
#                      rather than as the bound. Where neither spelling is
#                      installed, a CACHED read runs unbounded and the cache
#                      holds its cost to one call per TTL unless a consumed
#                      bucket reset requires an earlier refresh. A `--no-cache`
#                      read is refused as `host-accounts-unbounded` rather than
#                      waiting: the cache covers a listing or a pick, not a
#                      read that asked to ask the provider now.
#   ORCH_LANE_COPILOT_POOL  Comma-separated `<account dir>=<used>/<granted>`
#                      entries: the override for a Pi account's Copilot pool,
#                      judged where no provider `accounts` row reads that Pi
#                      root, the row replacing it where one does (--harness).
#                      Each entry is the owner's reading of the Copilot credits
#                      that pool has used of its monthly grant,
#                      the account dir an absolute path to the Pi root a lane
#                      on that pool is launched on, as its PI_CODING_AGENT_DIR. `pick --harness pi`
#                      on a `github-copilot/` model judges it as a `monthly`
#                      bucket at the used share,
#                      rounded up, against --max-pct; a pool at or past its
#                      grant is walled, whatever overage the account permits.
#                      No endpoint is asked for an entry: the reading is what
#                      the setting says. A malformed entry, or a second one for an
#                      account already stated, refuses that pick. A Copilot
#                      account dir may be stated too: its reading stands only
#                      where the account's stored login does not read, the
#                      measured pool answering otherwise.
#   ORCH_LANES_CLAUDE_CLIENT_ID  The OAuth client id the renewal posts with.
#                      Required for it: with this unset every Claude account
#                      whose access token has expired reads `error` with the
#                      cause `no OAuth client id is configured`, and `pick`
#                      refuses every one of them. Set it once per host.
# All read through the kendex settings ladder (process env > .env.local >
# .kendex/settings.toml / kendex.settings.toml [env]).
#
# USAGE CACHE: each fetched usage body is written to $OVERSEE_WATCH_STATE_DIR/
# usage/<harness>-<config dir checksum>.json (else <project root>/tmp/
# oversee-watch/usage, beside the claim store) and reused while younger than
# ORCH_LANES_USAGE_TTL, or than --max-age where that is longer, unless a
# consumed bucket reset arrives first. Every overseer sharing that directory
# polls an account at most once per age window, except for reset refreshes.
# `usage_age_s` (the AGE column) is how old the figure is. Fresh normalized
# records reuse parsed readings. Normal reads check stored token and login
# expiry and the credentials file's modification time. A stale, changed or
# legacy record uses the credential and raw-usage parsers; an expired token
# is renewed or reports its refusal. Parser changes reach an existing record
# when it is refreshed or normalized from a legacy raw record. --cache-only
# skips credentials and renewal. A fresh write keeps the displaced figure as
# `prior`; lane records expose the binding bucket's rate and projected wall
# after samples at least a minute apart, and none on credits
# (usage_rate_state `credits`).
#
# The refresh itself is HOST-WIDE SERIALIZED: a lane its record cannot answer
# takes one lock, unless --cache-only is set. That flag never refreshes.
# The lock, `.usage-refresh.lock` in that same directory, covers its
# refresh and re-reads the record inside it. Two readers arriving together are
# therefore one refresh of each account, not two, which is what the TTL alone
# cannot do: without the lock every caller's fetch lands in the same second at
# TTL expiry. A lane the record can answer, with a figure or a live refusal,
# never takes the lock and never waits. A lock that does not come free within
# 10 seconds is a keyed notice and the lane is refreshed anyway, because
# refusing it on contention is the same wall that serving a stale figure exists
# to prevent.
#
# A caller with no OVERSEE_WATCH_STATE_DIR falls back to <project root>/tmp/
# oversee-watch, so two callers run from DIFFERENT CHECKOUTS with that variable
# unset share neither the cache nor the lock and each pays the full burst. Set
# it once per host to be inside the bound.
#
# A fetch that could not be RUN is never cached, but one an endpoint REFUSED is:
# the record then holds a short negative entry — the status the refusal took,
# its HTTP code, the cause, and the instant the window closes — and while that
# window is open no caller on the host posts to that endpoint for that lane
# again. The window is the answer's own Retry-After where it named one in
# seconds, and USAGE_REFUSAL_WINDOW_S where it did not. Re-posting is what
# sustains a rate limit, so every watch pass on the host reads the record
# instead of asking again. The last figure the record held stays beside the
# refusal. A usage 429 reports `rate_limited` on that figure only while it is
# younger than the 5-hour session window and no consumed bucket reset has
# arrived. After either bound, a live recorded refusal still blocks a new
# request and reports no usable figure. A new 429 with no eligible figure
# makes the first such lane in a run retry once, after the window or
# 5 seconds whichever is shorter, so that retry is the one request posted
# inside a recorded window; a later cold lane in the same run reports its
# refusal at once. The record returns to a figure alone the moment the
# endpoint answers again.
# The lane host's `accounts` answer shares that cache and TTL, under
# `host-accounts-<provider path checksum>.json`: one record per provider rather
# than per account, since one answer covers every account it names. The
# absent-verb answer is cached too, so a provider that will never implement the
# verb stops paying a fork per invocation; a FAILED verb is never cached. The
# rows are cached AFTER the account policy: an excluded account's row is
# omitted, and a retired account's row is reduced to its account, harness and
# a `status=retired` marker with no usage figure. The record carries a stamp
# of the policy that shaped it, every setting an exclusion or retirement key
# is matched through (LANE_POLICY_SETTINGS: ORCH_LANE_EXCLUDE, ORCH_LANE_RETIRE
# and ORCH_LANE_ALIASES) and the UTC day, and is a miss under any other, so a
# lifted or tightened setting, an alias that moves and a retirement date that
# arrives all reach the provider on the next read. A lane's own record is a
# miss while its directory is excluded or retired. Fresh normalized reads
# skip the cache inventory scan, so a refused record can remain on disk.
# Cold reads and `check` consult `.pruned` and scan when its policy stamp
# differs or the cache directory is newer. A scan deletes policy-refused
# records. Nothing in that judgment reads a credential directory.
# `--no-cache` refreshes it, and `host-accounts` passes that flag from
# `open-terminal`, whose read decides whether the host holds an account for a
# launch gate rather than reporting a figure. `pick` reads the answer through
# the cache: what it takes from it is usage windows, on the TTL every window
# here has. Such a read is refused where nothing can bound it, since the cache
# it declined is what covers an unbounded call everywhere else.
#
# CLAIMS are the launches already in flight on a lane: `open-terminal` records
# one per tmux lane it launches under a resolved lane, and a claim is live
# while its pane is (stored under $OVERSEE_WATCH_STATE_DIR/claims, else
# <project root>/tmp/oversee-watch/claims; a claim whose pane is gone is
# pruned on read). A claim counts against the account its launch named, the
# alias `list` gives that spelling (`1claude` for `~/.1claude`), as well as
# against its canonical config dir: a store several homes share sees one
# account under each home's path. Claims in the same spending pool, whichever
# home wrote them, count and are charged once against that account. A dir named the bare
# harness word (`~/.claude`) is each home's own default login and keys by its
# path alone, unless ORCH_LANE_ALIASES names it. A claim on a lane this machine
# lists is that lane's by its path alone: an alias is not unique, and two
# local lanes sharing one stay two accounts; only another home's claim is
# matched by name, and charged to every local lane carrying it. Usage numbers
# lag a launch by minutes, so `pick` called twice in a row would hand the same
# account both lanes; the claim count is the correction, and it orders `pick`
# ahead of headroom. Each claim is also charged its expected burn in the projected wall the chooser and
# `pick --lane --projected` judge; `pick --lane` alone and `list` keep the
# reading's verdict, with the projection beside it.
#
# LAUNCHERS decide how a picked lane reaches the harness. A command named for
# the lane's config directory — its basename without the leading dot, so
# `1claude` for `~/.1claude` — selects the account itself, and where PATH holds
# one the launch goes through it and sets no environment variable at all. Every
# launcher asks one judge, `lib/lane-launch.sh`, so `open-terminal` and
# `oversee-succeed` build the same command for the same lane. The name must
# carry the harness word without being it: `~/.claude` and
# `~/.codex` name the harness binary, which is the thing being configured rather
# than a configurator, and a codex lane launched under `--harness claude` names
# the wrong binary entirely; both take the variable instead.
#
# Such a wrapper exports CLAUDE_CONFIG_DIR or CODEX_HOME for its OWN name, which
# is why it cannot be combined with a variable: in front of it the variable is
# overwritten and the lane silently runs on another account. The variable is the
# form used only where no such command exists.
#
# Where the platform reports a process environment, the launcher then reads the
# launched harness's environment and closes a window whose account disagrees
# with the pick. Where it does not, it says so by name and the launch stands, so
# the launcher rule is the whole defence.
#
# Headroom is `100 - max(session_5h, weekly, model_weekly)`: the BINDING
# constraint, not an average. An account at 5% session but 95% weekly has 5%
# headroom, and averaging would have called it 50% and sent the fleet into it.
#
# MODEL-SCOPED windows are per model, and an account can carry several. Headroom
# takes the most-consumed one, which is the right answer for a launch whose
# model is not yet decided; a launch that HAS a model asks `pick --model` for
# the window scoped to it, since the account with weekly room can still have
# none left for that one model and the launch's first turn is a usage banner.
#
# Why the renewal names itself:
#   platform.claude.com answers HTTP 429 `rate_limit_error` to a token POST
#   carrying no User-Agent, whatever the rate, and matches on the `claude-cli/`
#   prefix without parsing the version. Claude Code sends
#   `claude-cli/<version> (external, cli)`, which is why an interactive launch
#   renews an account this script could not. The version is read from the
#   installed `claude` once per measuring shell, with a fallback where PATH
#   holds none, since the endpoint does not read it.
#
# Why the renewal is unconditional:
#   Refreshing rotates the refresh token in the credentials file, which other
#   tools on the machine share (a Waybar usage widget doing the same thing is
#   the reference case), so the write takes the same lock the reference
#   implementation uses and re-reads the credentials under it. Leaving the
#   renewal opt-in instead left every idle account reading `expired` and `pick`
#   choosing nothing, which is the failure it exists to prevent.
#
# Why a Codex token is renewed by the Codex CLI:
#   The Codex CLI renews its own token only while it runs, so an idle Codex
#   account's token expires, and its usage query then answers 401. Its expiry
#   is the access token's own `exp` claim, read before any usage query. The
#   renewal runs the CLI rather than posting a refresh-token grant of this
#   script's own: the CLI is the one refresher of its auth.json, and a second
#   one rotating the same refresh token can leave the account on a revoked
#   login. `codex app-server` in that config dir is asked `account/read` with
#   `refreshToken`, the request its protocol documents for a proactive
#   refresh, under the same credentials lock the Claude renewal takes. Its
#   answer does not say whether the refresh worked, so auth.json read back is
#   the verdict. This is the one statement of what a failed Codex renewal
#   reads; `detail` carries the cause and the remedy, CODEX_HOME naming that
#   config dir:
#   - no refresh token in auth.json: `expired`, remedy `codex login`;
#   - no codex command on PATH: `expired`, remedy install the CLI and run
#     codex once;
#   - a token still expired after the run, judged by codex_renew_refusal on
#     the CLI's last `Failed to refresh token:` line and its answer: the token
#     endpoint refused the refresh token, `expired`, remedy `codex login`; the
#     request never reached that endpoint, `unreachable`; any other line, put
#     first in `detail`, or none, `unreachable` where the CLI answered with an
#     error, `detail` naming it, and otherwise `expired`, remedy run codex
#     once;
#   - a live expiry but no access token after the run: `expired`, remedy run
#     codex once;
#   - a run directory this machine could not create: `error`.
#   A held credentials lock reads `unreachable`, as for Claude; a lock file
#   it cannot open, `error`.
#
# Credentials never reach argv: `ps` and journald can read /proc/<pid>/cmdline,
# which on Linux is world-readable while /proc/<pid>/environ is not. Bearer
# tokens go to curl over stdin via `-K -`, and the refresh and access tokens
# reach jq through the environment rather than `--arg`.
#
# Testing: ORCH_LANES_FETCH_CMD takes `<harness> <config_dir>` on argv;
# ORCH_LANES_TOKEN_CMD takes the token request body on stdin and reads the
# User-Agent the POST would have carried from LANES_USER_AGENT in its
# environment. Both print what their network call prints: the HTTP status and
# any Retry-After on the FIRST line, separated by a space, and the response body
# under it. A command that exits non-zero is the call failing outright, which
# names no status at all. The Codex renewal runs the `codex` PATH resolves, so
# a stub first on PATH stands in for the CLI. The network layer is the only
# impure part; everything else is pure parsing.

set -uo pipefail

PROG="lanes"
# Exported so the loader cannot reassign it: it snapshots exported names before
# reading any project file and re-asserts them after, which is how a script says
# a name is its own and not a setting. A parsed settings [env] key redirecting
# SCRIPT_DIR would otherwise choose which lib this sources.
export PROG

SCRIPT_DIR="${BASH_SOURCE[0]%/*}"
[[ "$SCRIPT_DIR" != "${BASH_SOURCE[0]}" ]] || SCRIPT_DIR=.
SCRIPT_DIR="$(cd "$SCRIPT_DIR" && pwd)"
export SCRIPT_DIR

print_lanes_usage() {
	sed -n '/^# Usage:/,/^# Headroom/p' "$0" | sed 's/^# \{0,1\}//'
}

print_lanes_index() {
	sed -n '/^# Usage:/,/^# Options:/p' "$0" | sed 's/^# \{0,1\}//'
}

# Callers preserve positional values for this diagnostic catalog.
message() {
  local _message_key="$1"
  shift
  case "$_message_key" in
    missing-jq)
      printf 'lanes: missing-jq exit=%s\n' "1"
      printf '%s\n' "jq is required"
      ;;
    account-read-failed)
      printf 'lanes: account-read-failed step=%s exit=%s\n' "$1" "$2"
      printf '%s\n' 'The account batch could not be read. No account is selected from partial readings.'
      ;;
    pick-claims)
      printf 'lanes: pick-claims exit=%s\n' "1"
      printf '%s\n' "in-flight lane claims could not be read; refusing to pick (fix the claims directory, or set OVERSEE_WATCH_STATE_DIR)"
      ;;
    refusal-unrecorded)
      printf 'lanes: refusal-unrecorded dir=%s\n' "$1"
      printf '%s\n' "an endpoint's refusal could not be recorded, so every caller on this host posts to it again until one can (fix the state directory, or set OVERSEE_WATCH_STATE_DIR)"
      ;;
    pick-lane-claims)
      printf 'lanes: pick-lane-claims claims=%s\n' "null"
      printf '%s\n' "in-flight lane claims could not be read; this lane's claims and projection are null and it is judged on its wall reading alone (fix the claims directory, or set OVERSEE_WATCH_STATE_DIR)"
      ;;
    pick-lane-claims-refused)
      printf 'lanes: pick-lane-claims-refused lane=%s\n' "$1"
      printf '%s\n' "in-flight lane claims could not be read, so the lanes already on that account cannot be charged; refusing rather than judge it as running none (fix the claims directory, or set OVERSEE_WATCH_STATE_DIR)"
      ;;
    missing-value)
      printf 'lanes: missing-value arg1=%s\n' "$1"
      printf '%s\n' "$1 requires a value"
      ;;
    unknown-option)
      printf 'lanes: unknown-option arg1=%s\n' "$1"
      printf '%s\n' "unknown option: $1"
      ;;
    invalid-percent)
      printf 'lanes: invalid-percent option=%s\n' "$1"
      printf '%s\n' "$1 must be an integer 0-100"
      ;;
    pick-lane-walled)
      printf 'lanes: pick-lane-walled lane=%s wall=%s bucket=%s max-pct=%s projected-headroom=%s' "$1" "$2" "$3" "$4" "$5"
      [[ -z "${6:-}" ]] || printf ' credits=%s credit-floor=%s' "$6" "$7"
      printf '\n'
      printf '%s\n' "that account's window for this model is at or above the threshold, under --projected once the lanes already on it are charged their expected burn, and bucket is then the window whose projected room decided, the session window included; launching it would open on a usage banner"
      ;;
    pick-lane-unmeasured)
      printf 'lanes: pick-lane-unmeasured lane=%s model=%s\n' "$1" "$2"
      printf '%s\n' "no window of that account measures this model, and an unmeasured window is not an empty one"
      ;;
    pick-local-reading)
      printf 'lanes: pick-local-reading lane=%s host=%s age-s=%s\n' "$1" "$2" "$3"
      printf '%s\n' "the provider never read its copy of that account, so this machine's own measured reading of the config dir, younger than the window a cached figure is served within (ORCH_LANES_USAGE_TTL, or --max-age where longer), is judged in its place"
      ;;
    pick-lane-unlisted)
      printf 'lanes: pick-lane-unlisted lane=%s harness=%s\n' "$1" "$2"
      printf '%s\n' "that directory is no configured lane of this harness, so this script holds no record to judge it by"
      ;;
    pick-lane-failed)
      printf 'lanes: pick-lane-failed lane=%s step=%s\n' "$1" "$2"
      printf '%s\n' "that lane could not be measured; an unread window is never read as an empty one"
      ;;
    invalid-harness)
      printf 'lanes: invalid-harness option=%s\n' "--harness"
      printf '%s\n' "--harness must be claude, codex, copilot, or all; host-accounts also takes pi"
      ;;
    invalid-pick-harness)
      printf 'lanes: invalid-pick-harness option=%s\n' "--harness"
      printf '%s\n' "pick --harness must be claude, codex, copilot or pi"
      ;;
    model-class-unread)
      printf 'lanes: model-class-unread harness=%s model=%s\n' "$1" "$2"
      printf '%s\n' "kendex tier-model could not answer the model class table, so whether the model names a class is unknown and no window is judged on it. Install or repair kendex."
      ;;
    pick-provider-unmeasured)
      printf 'lanes: pick-provider-unmeasured harness=%s model=%s\n' "$1" "$2"
      printf '%s\n' "Pi reads a Claude seat for pi-claude/, a Copilot pool for github-copilot/, and provider API credit for anthropic/. Repair the provider harness=pi accounts row for an unread Anthropic grant. A local host measures no API credit."
      ;;
    copilot-pool-unstated)
      printf 'lanes: copilot-pool-unstated model=%s setting=%s read=%s\n' "$1" "ORCH_LANE_COPILOT_POOL" "$2"
      printf '%s\n' "no lane host row and no ORCH_LANE_COPILOT_POOL entry reads a Copilot pool for any Pi account, so nothing measures what this launch spends, and an unmeasured pool is not an empty one; the fix= line below names the read that failed"
      ;;
    pick-local-model-reading)
      printf 'lanes: pick-local-model-reading lane=%s host=%s model=%s age-s=%s\n' "$1" "$2" "$3" "$4"
      printf '%s\n' "the provider has no window for this model, so this machine's fresh reading is judged in its place, on the shared windows alone where none of its model windows names this model"
      ;;
    pick-local-model-unmeasured)
      printf 'lanes: pick-local-model-unmeasured lane=%s model=%s\n' "$1" "$2"
      printf '%s\n' "$3"
      ;;
    copilot-pool-unread)
      printf 'lanes: copilot-pool-unread host=%s model=%s setting=%s\n' "$1" "$2" "ORCH_LANE_COPILOT_POOL"
      printf '%s\n' "the lane host's accounts read failed, as the line above says, and ORCH_LANE_COPILOT_POOL states no pool reading here, so nothing measured this Pi launch; a failed read is never cached, so asking again can answer it"
      ;;
    invalid-copilot-pool)
      printf 'lanes: invalid-copilot-pool entry=%s\n' "$1"
      printf '%s\n' "ORCH_LANE_COPILOT_POOL entries must be <absolute account dir>=<credits used>/<credits granted>, the grant above 0 and one entry per account; a pool reading nobody can parse, or two for one account, is not judged as room"
      ;;
    invalid-retire)
      printf 'lanes: invalid-retire entry=%s\n' "$1"
      printf '%s\n' "ORCH_LANE_RETIRE entries must be <name>=<YYYY-MM-DD>; a lane whose retirement cannot be read is not picked on a guess"
      ;;
    usage-cache-prune-failed)
      printf 'lanes: usage-cache-prune-failed path=%s\n' "$1"
      printf '%s\n' "a removed account's usage record could not be deleted; check the cache directory permissions"
      ;;
    lane-scan-failed)
      printf 'lanes: lane-scan-failed item=%s\n' "$1"
      printf '%s\n' "the lane's pane could not be searched; its state is unknown, not idle"
      ;;
    host-accounts-unreadable)
      printf 'lanes: host-accounts-unreadable host=%s exit=%s\n' "$1" "$2"
      printf '%s\n' "the provider failed the accounts verb it implements, so nothing here says which accounts the host holds and a listing carries only the credentials on this machine; whatever the provider wrote is above this line, and exit 124 is the ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S bound, which leaves nothing there. The verb is optional: a provider that does not implement it exits 2 and is reported nowhere"
      ;;
    host-accounts-unbounded)
      printf 'lanes: host-accounts-unbounded host=%s bound-s=%s\n' "$1" "$2"
      printf '%s\n' "the accounts verb was asked for without the cache, and neither timeout nor gtimeout is installed to bound it; a provider that never answered would hold this read open, so it was not asked. Install coreutils, or set ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S=0 to accept an unbounded wait"
      ;;
    host-accounts-local)
      printf 'lanes: host-accounts-local host=%s\n' "local"
      printf '%s\n' "ORCH_LANE_HOST names no provider, so there is no host copy of any account to report; a provider that does not implement the accounts verb exits 2 instead, which is a different answer"
      ;;
    host-accounts-render-failed)
      printf 'lanes: host-accounts-render-failed host=%s exit=%s\n' "$1" "$2"
      printf '%s\n' "the provider's rows were read but could not be rendered, so no account is printed rather than some of them; this is jq failing, not the provider"
      ;;
    host-accounts-merge-failed)
      printf 'lanes: host-accounts-merge-failed host=%s exit=%s\n' "$1" "$2"
      printf '%s\n' "the provider's rows were read but could not be folded into this listing, which therefore carries only the credentials on this machine; this is the merge failing, not the provider"
      ;;
    host-account-invalid)
      printf 'lanes: host-account-invalid account=%s field=%s\n' "$1" "$2"
      printf '%s\n' "the provider's accounts row carries a field this script cannot read, so the row is left out rather than listed on a guess"
      ;;
    lane-host-busy)
      printf 'lanes: lane-host-busy step=%s item=%s\n' "$1" "$2"
      printf '%s\n' "lane-host refused the provider call at its per-home cap on provider calls, and its own line is above; the provider ran nothing, so this says nothing about the host. Ask again"
      ;;
    host-unreachable)
      printf 'lanes: host-unreachable item=%s state=%s\n' "$1" "$2"
      printf '%s\n' "the host provider did not answer the touch probe; the state names what this machine could read of the lane and says nothing about the host, and the provider's own message follows"
      [ -z "$3" ] || printf '%s\n' "$3"
      ;;
    copilot-note)
      printf 'lanes: %s item=%s\n' "$2" "$1"
      printf '%s\n' "the Copilot allow-all lane's session record note; the state is the pane's (references/copilot-runtime.md § Allow-all blocked by policy)"
      ;;
    invalid-usage-ttl)
      printf 'lanes: invalid-usage-ttl value=%s\n' "$1"
      printf '%s\n' "ORCH_LANES_USAGE_TTL must be a whole number of seconds"
      ;;
    invalid-accounts-timeout)
      printf 'lanes: invalid-accounts-timeout value=%s\n' "$1"
      printf '%s\n' "ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S must be a whole number of seconds; 0 asks for no bound"
      ;;
    invalid-usage-max-age)
      printf 'lanes: invalid-usage-max-age value=%s\n' "$1"
      printf '%s\n' "--max-age and ORCH_LANES_USAGE_MAX_AGE must be a whole number of seconds; it widens ORCH_LANES_USAGE_TTL for this caller and never narrows it"
      ;;
    usage-cache-reset)
      printf 'lanes: usage-cache-reset account=%s resets-at=%s\n' "$1" "$2"
      printf '%s\n' "A consumed usage bucket reset. The cached figure cannot be served."
      ;;
    usage-lock-timeout)
      printf 'lanes: usage-lock-timeout lock-file=%s wait-s=%s\n' "$1" "$2"
      if [[ -d "$1.d" ]]; then
        printf '%s\n' "the host-wide usage refresh lock is held by another reader and did not come free, so this run refreshed the account without it and the usage endpoint may see two requests for it. If no lane reader is running, remove it: rmdir '$1.d'"
      else
        printf '%s\n' "the host-wide usage refresh lock is held by another lane reader and did not come free, so this run refreshed the account without it and the usage endpoint may see two requests for it. The lock frees when that reader exits"
      fi
      ;;
    usage-lock-unopenable)
      printf 'lanes: usage-lock-unopenable lock-file=%s\n' "$1"
      printf '%s\n' "the host-wide usage refresh lock file could not be opened, so this run measured without it and the usage endpoint may see two refreshes of the same accounts; check the usage cache directory, or set OVERSEE_WATCH_STATE_DIR"
      ;;
    invalid-handoff-headroom) printf 'lanes: invalid-handoff-headroom value=%s\nORCH_HANDOFF_HEADROOM_PCT must be an integer 0-100\n' "$1" ;;
    invalid-overseer-seat-reserve) printf 'lanes: invalid-overseer-seat-reserve value=%s\nORCH_OVERSEER_SEAT_RESERVE_PCT must be an integer 0-100\n' "$1" ;;
    invalid-lane-max-pct) printf 'lanes: invalid-lane-max-pct value=%s\nORCH_LANE_MAX_PCT must be an integer 0-100\n' "$1" ;;
    invalid-lane-burn) printf 'lanes: invalid-lane-burn value=%s\nORCH_LANE_BURN_PCT_PER_HOUR must be an integer 0-100\n' "$1" ;;
    invalid-lane-codex-credit-floor) printf 'lanes: invalid-lane-codex-credit-floor value=%s\nORCH_LANE_CODEX_CREDIT_FLOOR must be an integer 0 or more\n' "$1" ;;
    invalid-lane-cloud-credit-floor) printf 'lanes: invalid-lane-cloud-credit-floor value=%s\nORCH_LANE_CLOUD_CREDIT_FLOOR must be a whole number of dollars, 0 or more\n' "$1" ;;
    invalid-cloud-repos)
      printf 'lanes: invalid-cloud-repos entry=%s\n' "$1"
      printf '%s\n' "ORCH_LANE_CLOUD_REPOS entries must be <name>=<owner>/<repo>; an entry nobody can read would hand a cloud session an account the repository card waits on"
      ;;
    host-capabilities-unread)
      printf 'lanes: host-capabilities-unread host=%s\n' "$1"
      printf '%s\n' "lane-host could not say which pool and launch this host kind declares, so the pick cannot tell an expiring credit from a refilling window; its own words are above this line"
      ;;
    cloud-credit-unread)
      printf 'lanes: cloud-credit-unread account=%s\n' "$1"
      printf '%s\n' "the account has no readable dollar credit and expiry, so this credit pool cannot select it; a provider API row's status and detail name its failed reading"
      ;;
    cloud-credit-refused)
      printf 'lanes: cloud-credit-refused account=%s cause=%s retry-at=%s\n' "$1" "$2" "$3"
      printf '%s\n' "the cloud grant does not admit this launch; a plan window does not reopen it"
      ;;
    cloud-repo-unset)
      printf 'lanes: cloud-repo-unset account=%s repo=%s\n' "$1" "$2"
      printf '%s\n' "no ORCH_LANE_CLOUD_REPOS entry gives that account access to this checkout's github.com repository, so a cloud session on it would wait on the add-repository card; the operator approves the card once in a session of that account and records the entry"
      ;;
    pick-overseer-seats)
      printf 'lanes: pick-overseer-seats step=%s state=%s\n' "$1" "$2"
      printf '%s\n' "the fleet state naming an overseer's account could not be read at that step; refusing to pick rather than hand a lane the seat an overseer runs on (fix the fleet state, or pass --for-overseer for an overseer's own pick)"
      ;;
    pick-overseer-seats-unread)
      printf 'lanes: pick-overseer-seats-unread step=%s state=%s\n' "$1" "$2"
      printf '%s\n' "the overseer seats could not be read; the lane was judged on its wall reading alone, with no seat reserve"
      ;;
    pick-seat-omitted)
      printf 'lanes: pick-seat-omitted lane=%s projected-headroom=%s reserve=%s\n' "$1" "$2" "$3"
      printf '%s\n' "the account does not have room above the overseer's reserve"
      ;;
    time-failed)
      printf 'lanes: time-failed clock=%s\n' "UTC"
      printf '%s\n' "the current UTC date could not be read; no retirement can be judged without it"
      ;;
    invalid-exclude)
      printf 'lanes: invalid-exclude entry=%s\n' "$1"
      printf '%s\n' "ORCH_LANE_EXCLUDE entries are lane names or aliases; a path names no lane, so the account it meant to exclude would be read"
      ;;
    lane-excluded)
      printf 'lanes: lane-excluded dir=%s\n' "$1"
      printf '%s\n' "ORCH_LANE_EXCLUDE names this lane; nothing launches under it"
      ;;
    lane-retired)
      printf 'lanes: lane-retired dir=%s date=%s\n' "$1" "$2"
      printf '%s\n' "ORCH_LANE_RETIRE retired this lane; nothing launches under it"
      ;;
    context-claims)
      printf 'lanes: context-claims exit=%s\n' "1"
      printf '%s\n' "in-flight lane claims could not be read; refusing to report context (fix the claims directory, or set OVERSEE_WATCH_STATE_DIR)"
      ;;
    invalid-handoff-context)
      printf 'lanes: invalid-handoff-context value=%s\n' "$1"
      printf '%s\n' "ORCH_HANDOFF_CONTEXT_PCT must be a whole number of percent from 1 to 100"
      ;;
    state-fleet)
      printf 'lanes: state-fleet window=%s\n' "$1"
      printf '%s\n' "the fleet state's lane records could not be read, so whether this window is a Pi lane, judged from the rows its hook writes and never from its pane, is unknown; refusing to answer rather than read a Pi lane's pane"
      ;;
    context-fleet)
      printf 'lanes: context-fleet item=%s\n' "$1"
      printf '%s\n' "the fleet state's lane records could not be read, so no lane's mailbox, where its turn-end hook records its context, can be found; refusing to report context rather than report every lane unrecorded"
      ;;
    unknown-subcommand)
      printf 'lanes: unknown-subcommand SUB=%s\n' "$SUB"
      printf '%s\n' "unknown subcommand: $SUB (expected list, pick, host-accounts, check, context, or state)"
      ;;
    settings-rejected)
      printf 'lanes: settings-rejected path=%s\n' "$PROJECT_ROOT"
      printf 'The settings load failed. No lane can be selected from partial settings.\n'
      ;;
    no-candidate)
      printf 'lanes: no-candidate harness=%s max-pct=%s model=%s walled=%s unmeasured=%s seats=%s\n' "$1" "$2" "$3" "$4" "$5" "$6"
      printf 'No lane has room for this launch. Lanes considered:\n'
      ;;
    no-candidate-unmeasured)
      printf 'lanes: no-candidate-unmeasured harness=%s model=%s unmeasured=%s\n' "$1" "$2" "$3"
      printf 'No allowance of these accounts measures this launch, and an unmeasured allowance is not an empty one. Lanes considered:\n'
      ;;
  esac
}

die() {
  message "$@" >&2
  exit 1
}

need_jq() { command -v jq >/dev/null 2>&1 || die missing-jq; }

# ── Enumeration ──────────────────────────────────────────────────────────────
#
# A lane is a config directory holding harness credentials. Claude keeps them in
# `<dir>/.credentials.json`, Codex in `<dir>/auth.json`.
#
# Discovery is by convention — `~/.claude` plus any `~/.*claude*` directory, and
# the same for codex — because that is how multi-account setups on this machine
# are actually laid out (a per-account config dir plus a shell alias that
# exports CLAUDE_CONFIG_DIR or CODEX_HOME). ORCH_LANE_DIRS overrides discovery
# for each harness it holds an entry of, for a setup that does not follow it.
#
# Exclusion is applied where a directory is first named, and retirement before
# anything looks inside it: an excluded account is one agents must not touch,
# and even the credentials-file probe that tells an ORCH_LANE_DIRS entry's
# harness is a look.
#
# A discovered directory is a lane only when it holds its harness's config
# marker (claude `.claude.json` or `.credentials.json`, codex `auth.json` or
# `config.toml`): a shared session store or a backup matches the glob too. A
# marked directory WITHOUT credentials is still listed, with
# status=no_credentials, so a mis-set config dir stays visible. ORCH_LANE_DIRS
# entries and $CODEX_HOME are named on purpose and skip the marker check.

# Trim the surrounding whitespace a comma-separated list invites.
trim() {
	local s="$1"
	s="${s#"${s%%[![:space:]]*}"}"
	TRIMMED="${s%"${s##*[![:space:]]}"}"
	[[ "${2:-}" == silent ]] || printf '%s' "$TRIMMED"
}

# The non-empty, trimmed items of a comma-separated setting, one per line.
# Split without word-splitting or globbing: a value may carry `*` or spaces.
setting_items() {
	local rest="$1," item
	SETTING_ITEMS=()
	while [[ -n "$rest" ]]; do
		trim "${rest%%,*}" silent; item="$TRIMMED"
		rest="${rest#*,}"
		[[ -n "$item" ]] || continue
		SETTING_ITEMS+=("$item")
		[[ "${2:-}" == silent ]] || printf '%s\n' "$item"
	done
}

# Match basename's trailing-slash spelling without starting a process.
lane_base() {
	LANE_BASE="$1"
	while [[ "$LANE_BASE" == */ && "$LANE_BASE" != / ]]; do LANE_BASE="${LANE_BASE%/}"; done
	[[ "$LANE_BASE" == / ]] || LANE_BASE="${LANE_BASE##*/}"
}

# Whether setting key KEY names the lane at DIR: its directory name, with or
# without the leading dot.
lane_named() {
	local base
	lane_base "$2"; base="$LANE_BASE"
	[[ "$1" == "$base" || "$1" == "${base#.}" ]]
}

# Every setting an exclusion or retirement key is matched through, by
# lane_matches and its readers. The provider cache stamp (USAGE_POLICY) is
# built from this list, so no setting that can change a match is left out.
LANE_POLICY_SETTINGS=(ORCH_LANE_EXCLUDE ORCH_LANE_RETIRE ORCH_LANE_ALIASES)

# Seeded in the owning shell before measurement runs in child shells. Keep
# lane_claims_canon as the normalizer for callers outside this invocation.
LANE_CANON_DIRS=() LANE_CANON_IDS=()
lane_canon() { # DIR: result in LANE_CANON
	local i
	for ((i=0; i<${#LANE_CANON_DIRS[@]}; i++)); do
		[[ "${LANE_CANON_DIRS[i]}" == "$1" || "${LANE_CANON_IDS[i]}" == "$1" ]] || continue
		LANE_CANON="${LANE_CANON_IDS[i]}"
		return 0
	done
	lane_claims_canon "$1" silent || return 1
	LANE_CANON="$LANE_CLAIMS_CANON"
	LANE_CANON_DIRS+=("$1"); LANE_CANON_IDS+=("$LANE_CANON")
}

# Whether exclusion or retirement key KEY names the lane at DIR: a directory
# name lane_named accepts, or the alias lane_alias_for gives it. Neither reads
# inside DIR.
lane_matches() {
	lane_named "$1" "$2" && return 0
	lane_alias_for "$2" silent
	[[ "$1" == "$LANE_ALIAS" ]]
}

lane_excluded() {
	local name
	for name in ${LANE_EXCLUDES[@]+"${LANE_EXCLUDES[@]}"}; do
		lane_matches "$name" "$1" && return 0
	done
	return 1
}

# The UTC date ORCH_LANE_RETIRE sets for DIR, empty when none. Entries were
# validated at startup (validate_lane_settings).
lane_retire_date() {
	local i
	LANE_RETIRE_DATE=""
	for ((i=0; i<${#LANE_RETIRE_KEYS[@]}; i++)); do
		lane_matches "${LANE_RETIRE_KEYS[i]}" "$1" || continue
		LANE_RETIRE_DATE="${LANE_RETIRE_VALUES[i]}"
		break
	done
	[[ "${2:-}" == silent ]] || printf '%s' "$LANE_RETIRE_DATE"
}

# Prints DIR's retirement date and succeeds when that UTC date is today or
# earlier; fails for a lane with no retirement or one still ahead.
lane_retired() {
	lane_retire_date "$1" silent
	[[ -n "$LANE_RETIRE_DATE" && ! "$TODAY" < "$LANE_RETIRE_DATE" ]] || return 1
	[[ "${2:-}" == silent ]] || printf '%s' "$LANE_RETIRE_DATE"
}

# Whether the policy admits the lane at DIR: neither excluded nor retired.
# Discovery neither probes nor caches a directory it refuses; a retired one is
# still listed, as retired, without a probe.
lane_admissible() {
	! lane_excluded "$1" && ! lane_retired "$1" silent
}

# ORCH_LANE_DIRS entries of harness $1, excluded ones included: whether a
# harness is configured is decided before exclusion drops an entry, or excluding
# every entry would turn its discovery back on. An excluded or retired entry is
# never probed; its name decides, as discovery's glob does. Any other entry is
# copilot when it holds config.json and no .credentials.json, and codex when it
# holds auth.json and no .credentials.json.
configured_lane_dirs() { # HARNESS [SILENT]
	local rest="$ORCH_LANE_DIRS:" entry kind
	CONFIGURED_LANE_DIRS=()
	while [[ -n "$rest" ]]; do
		entry="${rest%%:*}"
		rest="${rest#*:}"
		[[ -n "$entry" ]] || continue
		kind=claude
		if ! lane_admissible "$entry"; then
			lane_base "$entry"
			case "$LANE_BASE" in
				*codex*) kind=codex ;;
				*copilot*) kind=copilot ;;
			esac
		elif [[ -f "$entry/config.json" && ! -f "$entry/.credentials.json" ]]; then
			kind=copilot
		elif [[ -f "$entry/auth.json" && ! -f "$entry/.credentials.json" ]]; then
			kind=codex
		fi
		[[ "$kind" != "$1" ]] || CONFIGURED_LANE_DIRS+=("$entry")
	done
	[[ "${2:-}" == silent || ${#CONFIGURED_LANE_DIRS[@]} == 0 ]] || printf '%s\n' "${CONFIGURED_LANE_DIRS[@]}"
}

# Dirs of harness $1 (`claude`, `codex`, `copilot` or `pi`), excluded ones
# dropped unless $2 is `all`, which keeps every dir this machine knows.
# The ORCH_LANE_DIRS entries of that harness replace its discovery; with none,
# it is discovered. A set CODEX_HOME joins the codex inventory either way,
# since the codex CLI reads it wherever it points — as the ACCOUNT it names,
# because a codex launch that had to make its own folder-trust record sets it
# to a private home built under one (lib/lane-home.sh). Listed raw, that home
# is a second lane for an account already in this list, and the headroom of
# one account is counted and claimed twice. A set COPILOT_HOME joins the
# copilot inventory the same way; a Copilot launch builds no private home, so
# the value is the account as it stands.
lane_dirs() {
	local home="${LANES_HOME:-$HOME}" d seen=$'\n'
	local candidates=()
	LANE_DIRS_FOUND=()
	# A Pi account on the Copilot pool this machine knows is one the owner
	# states a reading for: nothing here is discovered as one, and a provider's
	# harness=pi rows join the pick as host rows. The same setting also
	# states a Copilot CLI account's fallback reading, and such an account is
	# no Pi root: an entry the copilot inventory lists is left out, so a Pi
	# launch never opens on a Copilot home holding no Pi login. `all` keeps
	# the roots ORCH_LANE_EXCLUDE names, for a pick asking what the owner stated.
	if [[ "$1" == pi ]]; then
		local copilot_ids=$'\n' id
		[[ -n "${ORCH_LANE_COPILOT_POOL:-}" ]] || return 0
		lane_dirs copilot '' silent || return 1
		for d in ${LANE_DIRS_FOUND[@]+"${LANE_DIRS_FOUND[@]}"}; do
			lane_canon "$d" || return 1
			copilot_ids+="$LANE_CANON"$'\n'
		done
		LANE_DIRS_FOUND=()
		while IFS=$'\t' read -r d _; do
			lane_canon "$d" || return 1; id="$LANE_CANON"
			case "$copilot_ids" in *$'\n'"$id"$'\n'*) continue ;; esac
			candidates+=("$d")
		done < <(copilot_pool_entries 2>/dev/null)
	else
		CONFIGURED_LANE_DIRS=()
		[[ -z "${ORCH_LANE_DIRS:-}" ]] || configured_lane_dirs "$1" silent
		if (( ${#CONFIGURED_LANE_DIRS[@]} )); then
			candidates=("${CONFIGURED_LANE_DIRS[@]}")
		else
			local markers=(.claude.json .credentials.json)
			case "$1" in codex) markers=(auth.json config.toml) ;; copilot) markers=(config.json session-state) ;; esac
			for d in "$home/.$1" "$home"/.*"$1"*; do
				[[ -d "$d" ]] || continue
				! lane_admissible "$d" || [[ -e "$d/${markers[0]}" || -e "$d/${markers[1]}" ]] || continue
				candidates+=("$d")
			done
		fi
		if [[ "$1" == codex && -n "${CODEX_HOME:-}" ]]; then
			d="$(lane_launch_home_account "$CODEX_HOME")" || return 1
			candidates+=("$d")
		fi
		[[ "$1" != copilot || -z "${COPILOT_HOME:-}" ]] || candidates+=("$COPILOT_HOME")
	fi
	for d in ${candidates[@]+"${candidates[@]}"}; do
		[[ "$1" == pi ]] || case "$seen" in *$'\n'"$d"$'\n'*) continue ;; esac
		seen+="$d"$'\n'
		[[ "${2:-}" != all ]] && lane_excluded "$d" && continue
		LANE_DIRS_FOUND+=("$d")
	done
	[[ "${3:-}" == silent || ${#LANE_DIRS_FOUND[@]} == 0 ]] || printf '%s\n' "${LANE_DIRS_FOUND[@]}"
}

# The discovered alias is the config dir's own name, which is also the command
# name a shell wrapper would conventionally use for it (`~/.eclaude` ->
# `eclaude`). It is purely a label: launching emits the config-dir env var,
# which works whether or not such a wrapper exists, so nothing probes PATH.
#
# ORCH_LANE_ALIASES overlays user-chosen names onto that discovery, keyed by
# the discovered name, so the inventory stays automatic while the labels stay
# the operator's. An entry naming a directory that does not exist is inert.
lane_alias_for() {
	local i
	lane_base "$1"; LANE_ALIAS="${LANE_BASE#.}"
	for ((i=0; i<${#LANE_ALIAS_KEYS[@]}; i++)); do
		lane_named "${LANE_ALIAS_KEYS[i]}" "$1" || continue
		LANE_ALIAS="${LANE_ALIAS_VALUES[i]}"
		break
	done
	[[ "${2:-}" == silent ]] || printf '%s' "$LANE_ALIAS"
}

# The ORCH_LANE_ALIASES pairs with a name and an alias, as trimmed
# `<name>\t<alias>` lines.
alias_pairs() {
	local i
	for ((i=0; i<${#LANE_ALIAS_KEYS[@]}; i++)); do
		printf '%s\t%s\n' "${LANE_ALIAS_KEYS[i]}" "${LANE_ALIAS_VALUES[i]}"
	done
}

# ── Usage fetch (the only impure layer) ──────────────────────────────────────
#
# Both network calls, and both of the commands the suite injects in their place,
# answer in ONE shape: the HTTP status and any Retry-After on the first line,
# the response body under it. A caller that read only the body could not tell a
# rate limit from a dead login, which is the whole defect this shape closes.

# Turn a `curl -D - -w '\n%{http_code}'` capture into that shape. The headers
# reach stdout ahead of the body, so the body starts after the LAST header
# block: a 1xx interim response is a block of its own, and a split at the first
# blank line would hand the real headers back as the body. Each block starts
# its own header read, so a Retry-After an interim or redirect block carried is
# never read as the refusal's own.
http_answer() { # CAPTURE
	local capture code
	capture="$(printf '%s' "$1" | tr -d '\r')"
	code="${capture##*$'\n'}"
	printf '%s' "${capture%$'\n'"$code"}" | awk -v code="$code" '
		BEGIN { inhdr = 1; blank = 0; retry = "" }
		inhdr && blank && /^HTTP\// { blank = 0; retry = ""; next }
		inhdr && blank { inhdr = 0; printf "%s %s\n", code, retry }
		inhdr && /^$/ { blank = 1; next }
		inhdr && tolower($1) == "retry-after:" { retry = $2; next }
		inhdr { next }
		{ print }
		END { if (inhdr) printf "%s %s\n", code, retry }
	'
}

# Read that shape into HTTP_CODE, HTTP_RETRY and HTTP_BODY. A field the answer
# does not name is empty, and so is a code that is not three digits. HTTP_RETRY
# is passed on as the answer wrote it: `write_usage_refusal` is the one judge of
# whether it names seconds to wait out.
split_http_answer() { # ANSWER
	local head="${1%%$'\n'*}"
	HTTP_BODY="${1#*$'\n'}"
	[[ "$1" == *$'\n'* ]] || HTTP_BODY=""
	HTTP_CODE="${head%% *}"
	HTTP_RETRY="${head#* }"
	[[ "$head" == *' '* ]] || HTTP_RETRY=""
	[[ "$HTTP_CODE" =~ ^[0-9]{3}$ ]] || HTTP_CODE=""
}

# What an HTTP refusal of a lane's own request means for the lane, with the
# caller's own reading of every other code as $2. `expired` asks the operator to
# log in again — `open-terminal` turns it into that remedy line — so an HTTP
# refusal the account will survive must never take it.
http_refusal_status() { # CODE DEFAULT
	case "$1" in
		429) printf 'rate_limited' ;;
		5??) printf 'unreachable' ;;
		*) printf '%s' "$2" ;;
	esac
}

fetch_usage() {
	local harness="$1" dir="$2" token="$3" account_id="${4:-}"
	if [[ -n "${ORCH_LANES_FETCH_CMD:-}" ]]; then
		"$ORCH_LANES_FETCH_CMD" "$harness" "$dir"
		return $?
	fi
	command -v curl >/dev/null 2>&1 || return 1
	local resp
	if [[ "$harness" == "claude" ]]; then
		resp=$(curl -s --max-time 10 -D - -w '\n%{http_code}' "$CLAUDE_USAGE_URL" \
			-H "anthropic-beta: $CLAUDE_OAUTH_BETA" -K - <<-CURLCFG
			header = "Authorization: Bearer ${token}"
		CURLCFG
		) || return 1
	elif [[ "$harness" == "copilot" ]]; then
		resp=$(copilot_credits_request "$token") || return 1
	else
		local args=(-s --max-time 10 -D - -w $'\n%{http_code}' "$CODEX_USAGE_URL")
		[[ -n "$account_id" ]] && args+=(-H "chatgpt-account-id: $account_id")
		resp=$(curl "${args[@]}" -K - <<-CURLCFG
			header = "Authorization: Bearer ${token}"
		CURLCFG
		) || return 1
	fi
	http_answer "$resp"
}

# ── Per-lane measurement ─────────────────────────────────────────────────────

# Report a lane from a refusal the cache holds, which is how a lane inside a
# refusal window is answered: the recorded status and cause, and the record's
# own age in place of a usage figure's, so a reader sees how long ago the
# endpoint refused and that this run posted nothing.
emit_refusal() { # ALIAS HARNESS DIR PLAN RECORD
	local status detail age
	IFS=$'\t' read -r status detail age < <(
		jq -r '[.refusal.status, .refusal.detail, (.age | tostring)] | @tsv' <<<"$5"
	)
	emit_lane "$1" "$2" "$3" "$status" "$detail" "$4" '{}' "$age"
}

# Emit one lane record. Never fails the whole run for one bad lane: an
# unreadable or unauthenticated lane is reported with a status and skipped by
# `pick`, because a fleet launch must still see the lanes that DO work.
# ORCH_LANE_COPILOT_POOL, one `DIR<tab>PCT<tab>USED<tab>LIMIT` line per
# entry: the account DIR a Pi launch on a `github-copilot/` model opens on, and
# the credits of its Copilot pool the owner states used and granted, one entry
# per account. PCT is the
# share used, rounded UP, so a pool with one credit short of its grant left is
# never read as having more, and a pool at or past its grant is 100: spent,
# whatever overage the account permits, since no paid overage is authorised.
# Returns 1 with the refusal on stderr at the first entry it cannot read: a
# reading nobody can parse is not judged as room. The chooser reads it before
# any lane is judged and measure_copilot_pool before its one account is, each
# refusing on that status; lane_dirs, which only lists the accounts, leaves the
# refusal to them.
copilot_pool_entries() {
	local item dir value used limit canon seen=$'\n'
	while IFS= read -r item; do
		trim "${item%=*}" silent; dir="$TRIMMED"
		trim "${item##*=}" silent; value="$TRIMMED"
		if [[ "$item" != *=* || "$dir" != /* || ! "$value" =~ ^([0-9]{1,12})/([0-9]{1,12})$ ]]; then
			message invalid-copilot-pool "$item" >&2
			return 1
		fi
		used=$((10#${BASH_REMATCH[1]}))
		limit=$((10#${BASH_REMATCH[2]}))
		(( limit > 0 )) || { message invalid-copilot-pool "$item" >&2; return 1; }
		# One reading per account, compared through the one lane-path
		# normaliser: a second one, agreeing or not, is refused rather than
		# losing to the first, which could be the reading with room.
		lane_canon "$dir" || return 1; canon="$LANE_CANON"
		case "$seen" in *$'\n'"$canon"$'\n'*) message invalid-copilot-pool "$item" >&2; return 1 ;; esac
		seen+="$canon"$'\n'
		if (( used >= limit )); then
			printf '%s\t100\t%s\t%s\n' "$dir" "$used" "$limit"
		else
			printf '%s\t%s\t%s\t%s\n' "$dir" $(( (used * 100 + limit - 1) / limit )) "$used" "$limit"
		fi
	done < <(setting_items "${ORCH_LANE_COPILOT_POOL:-}")
}

# The Copilot pool record where no measured reading can be made: the stated
# ORCH_LANE_COPILOT_POOL reading for DIR as a `monthly` bucket, judged by
# lib/lane-model.sh like every other window, its counts as `credits`, and
# `measured_through` `stated`: neither this machine nor a provider read it. A
# Pi root, whose Copilot login nothing on this machine reads, lands here
# unless a provider's row reads its pool (host_row_or_local), and so does a
# Copilot account whose stored login does not read, WHY naming that cause.
# Where the setting states nothing for DIR the account is unmeasured, never
# room: a Pi root `no_usage_data`, a Copilot account `no_credentials` under
# WHY.
measure_copilot_pool() { # ALIAS HARNESS DIR WHY
	local entries target d pct used limit
	entries="$(copilot_pool_entries)" || return 1
	lane_canon "$3" || return 1; target="$LANE_CANON"
	while IFS=$'\t' read -r d pct used limit; do
		[[ -n "$d" ]] || continue
		lane_canon "$d" || return 1
		[[ "$LANE_CANON" == "$target" ]] || continue
		emit_lane "$1" "$2" "$3" ok "Copilot pool: $used of $limit credits used, as ORCH_LANE_COPILOT_POOL states; $4" "" \
			"$(jq -nc --argjson p "$pct" --argjson u "$used" --argjson g "$limit" \
				'{monthly_pct: $p, credits: {unit: "AIC", unlimited: false, used: $u, granted: $g,
				  remaining: ([$g - $u, 0] | max)}}')" null false stated
		return
	done <<<"$entries"
	if [[ "$2" == pi ]]; then
		emit_lane "$1" pi "$3" no_usage_data "no lane host row and no ORCH_LANE_COPILOT_POOL entry reads a Copilot pool for this account" "" '{}' null false stated
	else
		emit_lane "$1" "$2" "$3" no_credentials "$4, and ORCH_LANE_COPILOT_POOL states no reading for this account" "" '{}'
	fi
}

measure_lane() {
	local harness="$1" dir="$2"
	local alias creds status="ok" detail="" plan="" token="" account_id="" expires_ms=0 now_s
	local refreshed=false refresh_out refusal
	lane_alias_for "$dir" silent; alias="$LANE_ALIAS"
	local normalized_i
	load_normalized "$NORMALIZED_TARGET" || return 1
	for ((normalized_i=0; normalized_i<${#NORMALIZED_DIRS[@]}; normalized_i++)); do
		[[ "${NORMALIZED_DIRS[normalized_i]}" == "$dir" && "${NORMALIZED_HARNESSES[normalized_i]}" == "$harness" && "${NORMALIZED_THROUGHS[normalized_i]}" == local ]] || continue
		printf '%s\n' "${NORMALIZED_ROWS[normalized_i]}"
		return 0
	done
	lane_now; now_s="$LANE_NOW"

	# Before the credentials path is even composed: a retired account is read
	# no more than an excluded one.
	local retire
	if lane_retired "$dir" silent; then
		retire="$LANE_RETIRE_DATE"
		emit_lane "$alias" "$harness" "$dir" "retired" "retired on $retire (ORCH_LANE_RETIRE)" "" '{}'
		return
	fi
	if [[ "$CACHE_ONLY" != true ]]; then
		if [[ "$harness" == pi ]]; then
			measure_copilot_pool "$alias" pi "$dir" "no Copilot login is read for a Pi root"
			return
		fi
		if [[ "$harness" == copilot ]]; then
			if ! copilot_credits_token "$dir"; then
				measure_copilot_pool "$alias" copilot "$dir" "copilot login unread: $COPILOT_CREDITS_REASON in $COPILOT_CREDITS_WHERE"
				return
			fi
			token="$COPILOT_CREDITS_TOKEN"
		else
			if [[ "$harness" == "claude" ]]; then creds="$dir/.credentials.json"; else creds="$dir/auth.json"; fi

			if [[ ! -f "$creds" ]]; then
				emit_lane "$alias" "$harness" "$dir" "no_credentials" "no credential file at $creds" "" '{}'
				return
			fi
			local credential_fields refresh_expiry
			if ! credential_fields="$(jq -er --arg h "$harness" "$LANE_CREDENTIALS_JQ"'
				select(. != false and . != null)
				| lane_access_token($h), lane_token_expiry_ms($h),
				  (try (.claudeAiOauth.subscriptionType // "") catch ""),
				  (try (.tokens.account_id // "") catch ""),
				  (try (.claudeAiOauth.refreshTokenExpiresAt // 0) catch 0)' "$creds" 2>/dev/null)"; then
				emit_lane "$alias" "$harness" "$dir" "error" "credential file is not valid JSON" "" '{}'
				return
			fi
			{ IFS= read -r token; IFS= read -r expires_ms; IFS= read -r plan;
			  IFS= read -r account_id; IFS= read -r refresh_expiry; } <<<"$credential_fields"
			# `claude auth status` exposes current account authentication, but its
			# documented JSON has no refresh-expiry timestamp. /status is an
			# interactive view. Neither supplies this chooser's exact expiry read.
			# Read the stored refreshTokenExpiresAt here: a live access token and
			# usage room can survive the refresh login's end. An absent timestamp
			# stays unmeasured; it does not prove expiry.
			# https://code.claude.com/docs/en/cli-reference
			# https://code.claude.com/docs/en/authentication#renew-an-expiring-login
			if [[ "$harness" == claude ]]; then
				if token_expired "$refresh_expiry" "$now_s"; then
					emit_lane "$alias" "$harness" "$dir" expired "refresh token expired; sign in again" "" '{}'
					return
				fi
			fi
		fi

		if [[ -z "$token" ]]; then
			emit_lane "$alias" "$harness" "$dir" "no_credentials" "no access token in $creds" "$plan" '{}'
			return
		fi

		# An expired access token is renewed here, so the lane `pick` prints is one
		# whose token is live — see the header. A renewal that cannot happen fails
		# closed with the status its renewal function judged, naming its cause, and
		# is never measured as `ok`. A Copilot lane states no expiry and never gets
		# here.
		if token_expired "$expires_ms" "$now_s"; then
			if refusal="$(read_usage_refusal "$harness" "$dir" token)"; then
				emit_refusal "$alias" "$harness" "$dir" "$plan" "$refusal"
				return
			fi
			# At most one `claude --version` per measuring shell, and none at all on a
			# run whose lanes all carry live tokens.
			[[ "$harness" != claude || -n "$CLAUDE_TOKEN_UA" ]] || CLAUDE_TOKEN_UA="$(claude_token_ua)"
			if ! refresh_out="$(renew_token "$harness" "$dir" "$creds")"; then
				local head code retry
				head="${refresh_out%%$'\n'*}"
				read -r status code retry <<<"$head"
				[[ "$code" != "-" ]] || code=""
				[[ "$retry" != "-" ]] || retry=""
				detail="access token expired and could not be renewed: ${refresh_out#*$'\n'}"
				# Recorded only where the endpoint answered: a refusal this machine
				# raised on its own posted nothing, so there is nothing to stop a
				# later caller from posting.
				[[ -z "$code" ]] ||
					write_usage_refusal "$harness" "$dir" token "$status" "$code" "$detail" "$retry" || true
				emit_lane "$alias" "$harness" "$dir" "$status" "$detail" "$plan" '{}'
				return
			fi
			token="$refresh_out"
			expires_ms="$(token_expiry_ms "$harness" "$creds")" || return 1
			refreshed=true
		fi

	fi

	# Read before the host-wide lock. A warm figure or refusal does not wait
	# behind another caller's refresh. Cache boundaries observe time themselves
	# after renewal or lock waits, including the locked second read.
	local raw="" buckets age=null current_at="" prior_at="" prior_raw="" prior_buckets='{}' elapsed="null" sample_claims=1
	# store_usage_refusal keeps the prior figure beside a failed renewal.
	# A cache-only reader must answer that live refusal before the figure.
	if [[ "$CACHE_ONLY" == true ]] && refusal="$(read_usage_refusal "$harness" "$dir" token)"; then
		emit_refusal "$alias" "$harness" "$dir" "$plan" "$refusal"
		return
	fi
	if ! usage_from_record; then
		if [[ "$CACHE_ONLY" == true ]]; then
			status=unreachable
			detail="usage cache miss within $(usage_serve_max_age)s serve age (--cache-only)"
		else
			if [[ "$USAGE_CACHE_PRUNED" != true ]]; then prune_usage_cache; USAGE_CACHE_PRUNED=true; fi
			usage_lock_take
			refresh_lane_usage
			usage_lock_release
		fi
	fi
	# An empty `raw` is a lane no figure answers, whose status, detail and age
	# the record or the refresh set: it reports no windows.
	if [[ -z "$raw" ]]; then
		emit_lane "$alias" "$harness" "$dir" "$status" "$detail" "$plan" '{}' "$age" "$refreshed"
		return
	fi
	buckets="$(parse_usage_body "$harness" <<<"$raw")"
	if [[ "$prior_at" =~ ^[0-9]+$ && -n "$prior_raw" ]]; then
		elapsed=$((10#$current_at - 10#$prior_at))
		prior_buckets="$(parse_usage_body "$harness" <<<"$prior_raw")"
	fi
	[[ -n "$buckets" ]] || buckets='{}'
	[[ -n "$prior_buckets" ]] || prior_buckets='{}'
	# A Copilot plan is named by the usage body, not by a credential file.
	[[ "$harness" != copilot ]] || plan="$(jq -r '.plan // empty' <<<"$buckets")"
	emit_lane "$alias" "$harness" "$dir" "$status" "$detail" "$plan" "$buckets" "$age" "$refreshed" local "$prior_buckets" "$elapsed" "$sample_claims"
}

# Answers the lane from its usage record without posting anything, into
# measure_lane's own `raw`, `age`, `status` and `detail`, and the sample
# fields read_usage_cache sets: a figure eligible by age and bucket resets,
# else a live refusal of the usage endpoint. Cache-only reads give the live
# refusal priority over the figure store_usage_refusal retained beside it.
# A 429 on record is
# answered from the last figure beside it while serve_refused_usage finds one;
# any other refusal, and a 429 with no such figure, is reported as the record
# states it with no windows. Returns 1 where the record answers neither, the
# one case that posts. It reads measure_lane's `harness` and `dir`.
#
# The refusal is honoured whatever --no-cache says: that flag declines a cached
# FIGURE it could refresh, not the record of a request the endpoint already
# refused, nor the last figure a 429 is answered from. The flag is the path
# most able to multiply a burst, since declining the cache is what puts every
# caller back on the endpoint at once.
usage_from_record() {
	local refusal=""
	if [[ "$CACHE_ONLY" == true ]]; then
		refusal="$(read_usage_refusal "$harness" "$dir" usage)" || refusal=""
	fi
	usage_serve_max_age silent
	if [[ "$USE_CACHE" == "true" && -z "$refusal" ]] && read_usage_cache "$harness" "$dir" "$USAGE_SERVE_MAX_AGE" silent; then
		[[ "$USAGE_CACHE_LEGACY" != true || "$CACHE_ONLY" == true || "$refreshed" == true || "${CURRENT_USAGE_LOCKED:-false}" == true ]] || return 1
		return 0
	fi
	if [[ "$CACHE_ONLY" != true ]]; then
		refusal="$(read_usage_refusal "$harness" "$dir" usage)" || return 1
	fi
	[[ -n "$refusal" ]] || return 1
	IFS=$'\t' read -r status detail age < <(
		jq -r '[.refusal.status, .refusal.detail, (.age | tostring)] | @tsv' <<<"$refusal"
	)
	[[ "$status" != "rate_limited" ]] ||
		serve_refused_usage "$harness" "$dir" "$detail; these are the last figures it gave" || true
	return 0
}

# The fetch half of measure_lane, run with the host-wide usage lock held. It
# assigns measure_lane's own `raw`, `age`, `status` and `detail`, and on an
# answer `current_at`, `prior_at` and `prior_raw`, the way
# serve_refused_usage does and for the same reason, and reads its `harness`,
# `dir`, `token` and `account_id`. An empty `raw` on return is a lane no figure
# answers.
#
# The record boundaries observe time after waits and answers. A waiting
# reader can reuse the winner's sample, and a refusal starts at its answer.
refresh_lane_usage() {
	local answer window CURRENT_USAGE_LOCKED=true
	# The second read, inside the lock: a caller that waited takes the figure or
	# the refusal the holder brought back instead of posting its own request.
	if usage_from_record; then
		if [[ "$USAGE_CACHE_LEGACY" == true ]] && write_usage_cache "$harness" "$dir" "" normalize-only; then
			raw="$USAGE_WRITTEN_BODY" current_at="$USAGE_WRITTEN_AT"
			prior_at="$USAGE_PRIOR_AT" prior_raw="$USAGE_PRIOR_RAW" sample_claims="$USAGE_SAMPLE_CLAIMS"
			lane_now; age=$((LANE_NOW - current_at))
		fi
		return
	fi
	if ! answer="$(fetch_usage "$harness" "$dir" "$token" "$account_id")"; then
		status="unreachable"
		detail="usage query could not be run"
		return
	fi
	split_http_answer "$answer"
	if [[ "$HTTP_CODE" == "429" ]]; then
		# The refusal is recorded FIRST, so it stands whichever way this lane
		# resolves: the row served below is one caller's answer, and the record
		# is what keeps every other caller on this host off the endpoint until
		# the window passes.
		record_usage_refusal
		# A cached figure seconds old is a better answer than no answer, and no
		# rate limit is a reason to wall a launch on an account the host has a
		# reading of.
		serve_refused_usage "$harness" "$dir" "$detail; these are the last figures it gave" && return
		# Nothing usable is cached, so there is no figure to stand in. One
		# retry, because a first refusal with nothing behind it leaves every
		# caller with nothing to decide on. It waits the window or
		# USAGE_RETRY_WAIT_MAX_S, whichever is shorter, so it is the one request
		# posted inside a window this host recorded. One per RUN: a later cold
		# lane reports its refusal at once.
		[[ "$USAGE_RETRY_SPENT" == "false" ]] || return
		USAGE_RETRY_SPENT=true
		window="$(usage_refusal_window "$HTTP_RETRY")"
		sleep "$(( window < USAGE_RETRY_WAIT_MAX_S ? window : USAGE_RETRY_WAIT_MAX_S ))"
		if ! answer="$(fetch_usage "$harness" "$dir" "$token" "$account_id")"; then
			detail="$detail, and the one retry could not be run"
			return
		fi
		split_http_answer "$answer"
	fi
	# The usage endpoint refusing says nothing about the login this script can
	# act on, so no code it answers reads `expired`: a 5xx is `unreachable`, a
	# 429 `rate_limited`, and any other code `refused`, a reading of the
	# credential the request went through that a read never made cannot claim.
	if [[ -n "$HTTP_CODE" && "$HTTP_CODE" != 2?? ]]; then
		record_usage_refusal
		return
	fi
	if [[ -z "$HTTP_BODY" ]]; then
		status="unreachable"
		detail="usage query answered HTTP $HTTP_CODE with no body"
		return
	fi
	if ! jq -e 'type == "object"' >/dev/null 2>&1 <<<"$HTTP_BODY"; then
		status="error"
		detail="usage response was not a JSON object"
		return
	fi
	# An answer, so the lane is measured whatever a first refusal above set.
	raw="$HTTP_BODY"
	age=0
	status="ok"
	detail=""
	# A cache that cannot be written costs the next run a fetch, never a wrong
	# figure, so this run reports what it measured either way. The write
	# replaces the whole record, so a refusal on record is spent the moment the
	# endpoint answers again. The figure it displaces is this sample's prior.
	write_usage_cache "$harness" "$dir" "$raw" || true
	current_at="$USAGE_WRITTEN_AT"
	prior_at="${USAGE_PRIOR_AT:-}"; prior_raw="${USAGE_PRIOR_RAW:-}"
	sample_claims="${USAGE_SAMPLE_CLAIMS:-1}"
}

# Records the refusal the last split_http_answer read at current time and sets
# measure_lane's `status` and `detail` to it. Every usage refusal goes through
# here, a cold lane's retry included, so one line judges what each code means
# and the window each is recorded for.
record_usage_refusal() {
	status="$(http_refusal_status "$HTTP_CODE" refused)"
	detail="usage query refused with HTTP $HTTP_CODE"
	local profile_detail
	if [[ "$harness" == claude && ( "$HTTP_CODE" == 401 || "$HTTP_CODE" == 403 ) ]] &&
		profile_detail="$(claude_refusal_plan_detail "$token")"; then
		detail="$profile_detail"
	fi
	write_usage_refusal "$harness" "$dir" usage "$status" "$HTTP_CODE" "$detail" "$HTTP_RETRY" || true
}

# Claude Code's profile response names the live plan. Its stored
# subscriptionType can survive cancellation, and auth status does not expose
# subscription_status. An unread or contradictory profile proves no cause.
claude_refusal_plan_detail() { # TOKEN
	local resp HTTP_CODE HTTP_RETRY HTTP_BODY
	command -v curl >/dev/null 2>&1 || return 1
	resp=$(curl -s --max-time 10 -D - -w '\n%{http_code}' "${CLAUDE_USAGE_URL%/*}/profile" \
		-H "anthropic-beta: $CLAUDE_OAUTH_BETA" -K - <<-CURLCFG
		header = "Authorization: Bearer ${1}"
	CURLCFG
	) || return 1
	split_http_answer "$(http_answer "$resp")"
	[[ "$HTTP_CODE" == 2?? ]] || return 1
	jq -er '
		.organization as $org
		| select($org.organization_type == "claude_free"
		    and $org.subscription_status == "canceled"
		    and .account.has_claude_max == false)
		| "plan ended: \($org.organization_type), subscription \($org.subscription_status)"
	' <<<"$HTTP_BODY" 2>/dev/null
}

# Serves the last figure the host holds for a rate-limited lane, into
# measure_lane's own `raw`, `age`, `status` and `detail`, while it is younger
# than SESSION_WINDOW_S and no consumed bucket reset has arrived. Either
# bound ends eligibility, because the figure cannot show current usage after
# a reset. A refusal the endpoint keeps giving never replaces the figure,
# so without these bounds one frozen figure would stand in for an account
# indefinitely and `pick` would launch on it.
# It returns 1 where no eligible figure is held. The caller then reports
# the refusal with no windows. A live refusal still blocks a new request.
#
# It assigns its caller's locals rather than printing, because several values
# cannot come back through one substitution and the caller goes on to parse
# them. usage_from_record and refresh_lane_usage are its callers, and the values
# are measure_lane's locals, reached through their frames by bash's dynamic
# scope: neither may declare them, or the writes stop at its frame.
serve_refused_usage() { # HARNESS DIR DETAIL
	read_usage_cache "$1" "$2" "$SESSION_WINDOW_S" silent || return 1
	status="rate_limited"
	detail="$3"
}

# ── Usage cache ──────────────────────────────────────────────────────────────
#
# One file per lane, named by its harness and a checksum of its whole config dir,
# so lanes sharing a directory name keep separate records and no name can leave
# the cache directory. The record still carries harness and config dir, and a
# record naming another lane (a checksum collision) is a miss.
#
# A lane's record holds a usage figure, a refusal, or a refusal with the last
# figure kept beside it. `fetched_at` is when the record's own answer arrived:
# the figure's, or the refusal's where there is one, and a figure kept beside a
# refusal keeps its own stamp in `usage_fetched_at`. The figure is kept because
# a usage 429 is answered from it: a refused REFRESH leaves the host's last
# reading usable only within its age limit and before a consumed bucket reset.
# That age is always the figure's own, never the refusal's, so no reader can
# take a refused refresh for a fresh figure. The two readers select on the key
# they need, so a record with no
# figure is a miss for the figure reader and one with no refusal a miss for the
# refusal reader. The refusal names which endpoint refused, because the token
# endpoint and the usage endpoint are different hosts under different limits.

LANE_CRC_TABLE=()
lane_checksum() { # PATH: POSIX cksum, including its byte-count suffix.
	local LC_ALL=C path="$1" i bit value byte crc=0 length
	if (( ${#LANE_CRC_TABLE[@]} == 0 )); then
		for ((i=0; i<256; i++)); do
			value=$((i << 24))
			for ((bit=0; bit<8; bit++)); do
				if (( value & 0x80000000 )); then value=$(((value << 1) ^ 0x04c11db7)); else value=$((value << 1)); fi
				value=$((value & 0xffffffff))
			done
			LANE_CRC_TABLE[i]="$value"
		done
	fi
	length=${#path}
	for ((i=0; i<length; i++)); do
		printf -v byte '%d' "'${path:i:1}"
		crc=$((((crc << 8) ^ LANE_CRC_TABLE[((crc >> 24) ^ byte) & 255]) & 0xffffffff))
	done
	value="$length"
	while (( value > 0 )); do
		crc=$((((crc << 8) ^ LANE_CRC_TABLE[((crc >> 24) ^ value) & 255]) & 0xffffffff))
		value=$((value >> 8))
	done
	LANE_CHECKSUM=$(((~crc) & 0xffffffff)) LANE_CHECKSUM_BYTES="$length"
}

usage_cache_file() { # HARNESS DIR [SILENT]
	# Keep the existing names without starting a checksum pipeline per home.
	lane_checksum "$2"
	USAGE_CACHE_FILE="$USAGE_CACHE_DIR/$1-$LANE_CHECKSUM-$LANE_CHECKSUM_BYTES.json"
	[[ "${3:-}" == silent ]] || printf '%s' "$USAGE_CACHE_FILE"
}

# Records usage_cache_permitted has admitted this process, one path per line.
# A record is judged once: the process runs under one policy and writes every
# record under it, so what it admitted stays admissible for its lifetime.
USAGE_CACHE_ADMITTED=$'\n' USAGE_CACHE_PRUNED=false
USAGE_POLICY_JQ='def usage_policy_current($policy): .policy == $policy;'
USAGE_RESET_JQ='def usage_consumed_reset($now):
	utc_resets | shared_bindings + (.model_buckets // []) | .[]
	| select((.pct | type) == "number" and .pct > 0)
	| (.resets_at | reset_epoch) as $reset
	| select($reset != null and $reset <= $now) | .resets_at;'

# Whether the record at FILE may be read or kept, the one judgment the figure
# reader, the writer's prior sample and the startup scan share. A lane record
# is judged by the directory it names, a provider record by the policy stamp
# it was written under, since its rows are what that policy left; a record
# nothing can parse is refused. With no policy in force only a provider
# record can be stale, so a caller naming a lane HARNESS is answered without a
# read. Nothing here reads a credential directory.
usage_cache_permitted() { # FILE [HARNESS]
	local verdict
	[[ "$USAGE_CACHE_ADMITTED" != *$'\n'"$1"$'\n'* ]] || return 0
	if [[ -z "${ORCH_LANE_EXCLUDE:-}${ORCH_LANE_RETIRE:-}" && -n "${2:-}" && "$2" != host-accounts ]]; then
		return 0
	fi
	verdict="$(jq -r "${USAGE_POLICY_ARGS[@]}" "$USAGE_POLICY_JQ"'
		if .harness == "host-accounts" then (if usage_policy_current($policy) then "ok" else "stale" end)
		elif (.harness | type) == "string" and (.config_dir | type) == "string" then "lane\t" + .config_dir
		else "malformed" end' "$1" 2>/dev/null)" || return 1
	case "$verdict" in
		ok) ;;
		lane$'\t'*) lane_admissible "${verdict#*$'\t'}" || return 1 ;;
		*) return 1 ;;
	esac
	USAGE_CACHE_ADMITTED+="$1"$'\n'
}

# Delete every record the policy refuses, scanning the cache itself: discovery
# no longer names an excluded or retired directory, and a provider no longer
# selected still has a record. With neither setting in force no record holds
# a removed account's usage, and a provider record written under a policy is
# refused on read and replaced by the next write, so the scan is spared.
#
# The scan is also spared while `.pruned` holds this process's policy stamp
# and the directory is no newer than it: every record written, replaced or
# deleted renames or unlinks an entry, which makes the directory newer, so a
# writer under any policy can require another cold scan. Fresh normalized
# reads skip the inventory scan and only seed an absent marker. The marker
# is written BEFORE a cold scan, so a record that
# lands while the scan runs is dated after it and judged by a later cold scan;
# where the clock behind the comparison counts whole seconds, a record that
# lands in the marker's own second after the scan passed it stays on disk,
# refused on read, until the directory next changes. A marker that cannot be
# written is removed, and one a failed scan leaves behind is emptied, so
# later cold pruning calls scan.
prune_usage_cache() {
	local file marker="$USAGE_CACHE_DIR/.pruned" stamp=""
	[[ -n "${ORCH_LANE_EXCLUDE:-}${ORCH_LANE_RETIRE:-}" && -d "$USAGE_CACHE_DIR" ]] || return 0
	if [[ "${1:-}" == warm ]]; then
		[[ -e "$marker" ]] || printf '%s' "$USAGE_POLICY" >"$marker" 2>/dev/null || true
		return 0
	fi
	[[ ! -r "$marker" ]] || stamp="$(<"$marker")"
	[[ "$stamp" != "$USAGE_POLICY" || "$USAGE_CACHE_DIR" -nt "$marker" ]] || return 0
	printf '%s' "$USAGE_POLICY" >"$marker" 2>/dev/null || rm -f -- "$marker"
	for file in "$USAGE_CACHE_DIR"/*.json; do
		[[ -f "$file" ]] || continue
		usage_cache_permitted "$file" && continue
		rm -f -- "$file" && continue
		: >"$marker" 2>/dev/null || true
		die usage-cache-prune-failed "$file"
	done
}

# Prints `{fetched_at, age, usage, prior}` for a cached body of harness $1 and
# dir $2 at current time whose age is under $3 seconds; an EMPTY $3 accepts any
# age. `fetched_at` and `age` are the figure's own. Fails on a miss: an
# unreadable or malformed record, one naming another lane, one holding no
# figure, one stamped in the future, and a consumed bucket whose reset arrived.
#
# The bound is the caller's argument and not $USAGE_TTL, because the two
# questions this cache answers take different ones: a measurement asks for a
# figure fresh enough to report, and a refused fetch asks for the last figure
# there is. Whether --no-cache forbids the read is likewise the caller's: it
# declines a figure it could refresh, not the figure that stands in for one the
# endpoint refused.
read_usage_cache() { # HARNESS DIR MAX_AGE_S [SILENT]
	local file output cached expired="" buckets legacy creds observed starting_age="${age:-null}"
	usage_cache_file "$1" "$2" silent
	file="$USAGE_CACHE_FILE"
	[[ -f "$file" ]] || return 1
	if [[ "$1" != host-accounts ]]; then
		lane_admissible "$2" || return 1
		case "$1" in claude) creds="$2/.credentials.json" ;; codex) creds="$2/auth.json" ;; copilot) creds="$2/config.json" ;; esac
		# This shell's successful renewal can follow a peer's fresh usage write.
		# Its credentials are already validated. Other login changes miss here.
		[[ "$CACHE_ONLY" == true || "${refreshed:-false}" == true || ! "$creds" -nt "$file" ]] || return 1
	fi
	lane_now; observed="$LANE_NOW"
	output="$(jq -er --arg h "$1" --arg d "$2" --arg policy "$USAGE_POLICY" --arg host "${ORCH_LANE_HOST:-local}" \
		--argjson now "$observed" --argjson max "${3:-null}" "$LANE_MODEL_JQ$USAGE_POLICY_JQ$USAGE_RESET_JQ"'
		(.usage_fetched_at // .fetched_at) as $at
		| select(.harness == $h and .config_dir == $d
		       and ($at | type) == "number" and (.usage | type) == "object")
		| select($h != "host-accounts" or usage_policy_current($policy))
		| ($now - $at) as $age
		| select($age >= 0 and ($max == null or $age < $max))
		| ([if $h == "host-accounts" then .normalized.accounts[]?.reset_buckets
		    else .normalized.account.reset_buckets end
		    | usage_consumed_reset($now)]
		   | first // "") as $expired
		| $expired, (.normalized == null or (.normalized | usage_policy_current($policy) | not) or .normalized.host != $host
		    or .normalized.fetched_at != $at or .normalized.prior_at != (.prior.fetched_at // null)),
		  ({fetched_at: $at, age: $age, usage: .usage, prior: (.prior // null), sample_claims: (.sample_claims // 1)} | tojson),
		  $age, $at, (.usage | tojson), (.prior.fetched_at // ""),
		  (if (.prior.usage | type) == "object" then (.prior.usage | tojson) else "" end),
		  (.sample_claims // 1)' "$file" 2>/dev/null)" || return 1
	{ IFS= read -r expired; IFS= read -r legacy; IFS= read -r cached;
	  IFS= read -r age; IFS= read -r current_at; IFS= read -r raw;
	  IFS= read -r prior_at; IFS= read -r prior_raw; IFS= read -r sample_claims; } <<<"$output"
	[[ "$CACHE_ONLY" != true ]] || legacy=true
	if [[ "$legacy" == true ]]; then
		if [[ "$1" == host-accounts ]]; then
			buckets="$(jq -r '.rows' <<<"$raw")" || return 1
			buckets="$(host_account_rows "$buckets" all buckets)" || return 1
		else
			buckets="$(parse_usage_body "$1" unrounded <<<"$raw")" || return 1
		fi
		lane_now; observed="$LANE_NOW"
		age=$((observed - current_at))
		[[ "$age" -ge 0 && ( -z "${3:-}" || "$age" -lt "$3" ) ]] || return 1
		output="$(jq -sr --argjson now "$observed" --argjson record "$cached" "$LANE_MODEL_JQ$USAGE_RESET_JQ"'
			([.[] | usage_consumed_reset($now)] | first // ""),
			($record + {age: ($now - $record.fetched_at)} | tojson)' <<<"$buckets")" || return 1
		{ IFS= read -r expired; IFS= read -r cached; } <<<"$output"
	fi
	if [[ -n "$expired" ]]; then
		message usage-cache-reset "$2" "$expired" >&2
		raw="" age="$starting_age" current_at="" prior_at="" prior_raw="" sample_claims=1
		return 1
	fi
	USAGE_CACHE_RECORD="$cached" USAGE_CACHE_LEGACY="$legacy"
	[[ "${4:-}" == silent ]] || printf '%s\n' "$cached"
}

# The age a cached figure is served within: the TTL, or the caller's own pass
# interval where that is longer. It only ever WIDENS the TTL. A watch whose
# pass is longer than the TTL would otherwise fetch on every pass — the figure
# is always past the TTL by the time it comes round — which is the burst; a
# caller with a short pass still gets the TTL it configured. A TTL of 0 is an
# operator declining ordinary cached figures, and no caller's interval widens
# it. The refusal reader can still serve a retained figure under its own bound.
usage_serve_max_age() {
	if [[ "$USAGE_TTL" -eq 0 ]]; then
		USAGE_SERVE_MAX_AGE=0
	elif [[ "$USAGE_MAX_AGE" -gt "$USAGE_TTL" ]]; then
		USAGE_SERVE_MAX_AGE="$USAGE_MAX_AGE"
	else
		USAGE_SERVE_MAX_AGE="$USAGE_TTL"
	fi
	[[ "${1:-}" == silent ]] || printf '%s' "$USAGE_SERVE_MAX_AGE"
}

# Renamed into place only once complete, so a concurrent reader never parses
# half a record.
write_usage_cache() { # HARNESS DIR [USAGE [MODE]]
	local file tmp prior=null sample_claims=1 normalized=null parsed bound_fields sample_at="" retained_body=""
	local ems="${expires_ms:-0}" rms="${refresh_expiry:-0}" write_mode="${4:-refresh}" body="${3:-}" existing_record=null
	lane_now; USAGE_WRITTEN_AT="$LANE_NOW"
	USAGE_PRIOR_AT=""; USAGE_PRIOR_RAW=""
	usage_cache_file "$1" "$2" silent
	file="$USAGE_CACHE_FILE"
	# Historical normalization may rewrite only the record bound under this lock.
	[[ "$write_mode" != normalize-only || "$USAGE_REFRESH_LOCK_HELD" == true ]] || return 1
	if [[ -f "$file" ]] && usage_cache_permitted "$file" "$1"; then
		existing_record="$(<"$file")"
		bound_fields="$(jq -er --arg h "$1" --arg d "$2" --arg mode "$write_mode" '
			(.usage_fetched_at // .fetched_at) as $at
			| select(.harness == $h and .config_dir == $d
			       and ($at | type) == "number" and (.usage | type) == "object")
			| . as $record
			| (if $mode == "normalize-only" then .prior // null else {fetched_at: $at, usage} end) as $p
			| $at, ($record.usage | tojson), ($p | tojson), ($p.fetched_at // ""),
			  (if ($p.usage | type) == "object" then ($p.usage | tojson) else "" end),
			  ($record.sample_claims // 1)' <<<"$existing_record" 2>/dev/null)" || bound_fields=""
		if [[ -n "$bound_fields" ]]; then
			{ IFS= read -r sample_at; IFS= read -r retained_body; IFS= read -r prior;
			  IFS= read -r USAGE_PRIOR_AT; IFS= read -r USAGE_PRIOR_RAW; IFS= read -r sample_claims; } <<<"$bound_fields"
		fi
	fi
	if [[ "$write_mode" == normalize-only ]]; then
		[[ -n "$sample_at" ]] || return 1
		body="$retained_body"
	else
		sample_claims=1
		if [[ "$1" != host-accounts && "$LANE_CLAIMS_RC" == 0 ]]; then
			account_claims "$2" "$1" '' silent || return 1
			sample_claims="$ACCOUNT_CLAIMS"
		fi
	fi
	USAGE_SAMPLE_CLAIMS="$sample_claims"
	USAGE_WRITTEN_BODY="$body"
	if [[ "$1" != host-accounts ]]; then
		parsed="$(parse_usage_samples "$1" "$body" "${USAGE_PRIOR_RAW:-null}")" || return 1
		[[ "$ems" =~ ^[0-9]+$ ]] || ems=0
		[[ "$rms" =~ ^[0-9]+$ ]] || rms=0
		normalized="$(jq -nc --arg h "$1" --arg d "$2" --arg status "${status:-ok}" --arg detail "${detail:-}" \
			--arg plan "${plan:-}" --argjson parsed "$parsed" --argjson ems "$ems" --argjson rms "$rms" \
			'{account: {harness: $h, config_dir: $d, status: $status, detail: $detail,
			  plan: (if $h == "copilot" then $parsed.buckets.plan // "" else $plan end), through: "local",
			  buckets: $parsed.buckets, reset_buckets: $parsed.reset_buckets,
			  prior_buckets: $parsed.prior_buckets, expires_ms: $ems, refresh_expires_ms: $rms}}')" || return 1
	else
		local host_rows
		host_rows="$(jq -r '.rows // ""' <<<"$body")" || return 1
		normalized="$(host_account_rows "$host_rows" all normalized)" || return 1
	fi
	mkdir -p -- "$USAGE_CACHE_DIR" 2>/dev/null || return 1
	tmp="$(mktemp -- "$USAGE_CACHE_DIR/.usage.XXXXXX" 2>/dev/null)" || return 1
	if [[ "$write_mode" == normalize-only ]]; then
		USAGE_WRITTEN_AT="$sample_at"
	else
		lane_now; USAGE_WRITTEN_AT="$LANE_NOW"
	fi
	if jq -nc "${USAGE_POLICY_ARGS[@]}" --arg host "${ORCH_LANE_HOST:-local}" --argjson normalized "$normalized" \
		--arg mode "$write_mode" --argjson existing "$existing_record" \
		--arg h "$1" --arg d "$2" --argjson now "$USAGE_WRITTEN_AT" --argjson u "$body" --argjson p "$prior" --argjson claims "$sample_claims" \
		'(if $mode == "normalize-only" then $existing
		  else {harness: $h, config_dir: $d, fetched_at: $now, usage: $u, prior: $p, sample_claims: $claims} end)
		+ {normalized: ($normalized + {host: $host, policy: $policy, fetched_at: $now, prior_at: ($p.fetched_at // null)}
		    + (if $mode == "normalize-only" and $existing.refusal != null then {refusal: $existing.refusal} else {} end))}
		+ (if $h == "host-accounts" then {policy: $policy} else {} end)' >"$tmp" \
		&& mv -f -- "$tmp" "$file"; then
		return 0
	fi
	rm -f -- "${tmp:?}"
	return 1
}

# Prints `{age, refusal}` for a live recorded refusal of endpoint $3 on the lane
# of harness $1 and dir $2 at current time; fails on a miss, a refusal of the other
# endpoint, a malformed record and one stamped in the future.
#
# --no-cache does NOT reach this. It declines a cached FIGURE, and an operator
# asking for a fresh reading must not be the one caller on the host that posts
# again what the endpoint has already refused.
read_usage_refusal() {
	local file creds observed
	usage_cache_file "$1" "$2" silent
	file="$USAGE_CACHE_FILE"
	[[ -f "$file" ]] || return 1
	case "$1" in claude) creds="$2/.credentials.json" ;; codex) creds="$2/auth.json" ;; *) creds="$2/config.json" ;; esac
	[[ "$CACHE_ONLY" == true || "${refreshed:-false}" == true || ! "$creds" -nt "$file" ]] || return 1
	lane_now; observed="$LANE_NOW"
	jq -ce --arg h "$1" --arg d "$2" --argjson now "$observed" --arg ep "$3" '
		select(.harness == $h and .config_dir == $d
		       and (.fetched_at | type) == "number"
		       and (.refusal | type) == "object"
		       and .refusal.endpoint == $ep
		       and (.refusal.expires_at | type) == "number"
		       and .refusal.expires_at > $now)
		| ($now - .fetched_at) as $age
		| select($age >= 0)
		| {age: $age, refusal: .refusal}' "$file" 2>/dev/null
}

# Record a refusal the endpoint answered, so every caller sharing this state
# directory reads it instead of posting the same request again. Its window is
# the answer's own Retry-After where it named one in seconds, and
# USAGE_REFUSAL_WINDOW_S where it did not: a Retry-After written as an HTTP date
# names no seconds this can wait out, and a window nobody can read must not
# become a window of zero.
#
# A record that could not be written leaves every caller on the host posting
# again each pass, which is what the window exists to stop, so that failure is a
# `refusal-unrecorded` notice on stderr. The lane is still reported.
write_usage_refusal() { # HARNESS DIR ENDPOINT STATUS CODE DETAIL [RETRY_AFTER]
	store_usage_refusal "$@" && return 0
	message refusal-unrecorded "$USAGE_CACHE_DIR" >&2
	return 1
}

# Writes the refusal over the lane's record, keeping the figure the record held
# for this lane, under its own stamp, beside it: `kept` is that figure as
# `{usage, usage_fetched_at}`, or `{}` where there is none.
store_usage_refusal() { # HARNESS DIR ENDPOINT STATUS CODE DETAIL [RETRY_AFTER]
	local file tmp window kept="" parsed observed ems="${expires_ms:-0}" rms="${refresh_expiry:-0}"
	window="$(usage_refusal_window "${7:-}")"
	file="$(usage_cache_file "$1" "$2")" || return 1
	mkdir -p -- "$USAGE_CACHE_DIR" 2>/dev/null || return 1
	[[ ! -f "$file" ]] || kept="$(jq -c --arg h "$1" --arg d "$2" '
		(.usage_fetched_at // .fetched_at) as $at
		| select(.harness == $h and .config_dir == $d
		       and ($at | type) == "number" and (.usage | type) == "object")
		| {usage: .usage, usage_fetched_at: $at, normalized: .normalized}' "$file" 2>/dev/null)"
	[[ -n "$kept" ]] || kept='{}'
	parsed="$(jq -c '.normalized.account // null' <<<"$kept")" || return 1
	if [[ "$parsed" == null ]]; then
		local body samples
		body="$(jq -c '.usage // {}' <<<"$kept")" || return 1
		samples="$(parse_usage_samples "$1" "$body" null)" || return 1
		parsed="$(jq -nc --argjson p "$samples" '{buckets: $p.buckets, reset_buckets: $p.reset_buckets}')" || return 1
	fi
	[[ "$ems" =~ ^[0-9]+$ ]] || ems=0
	[[ "$rms" =~ ^[0-9]+$ ]] || rms=0
	tmp="$(mktemp -- "$USAGE_CACHE_DIR/.usage.XXXXXX" 2>/dev/null)" || return 1
	lane_now; observed="$LANE_NOW"
	if jq -nc --arg h "$1" --arg d "$2" --argjson now "$observed" --arg ep "$3" \
		--arg status "$4" --arg code "$5" --arg detail "$6" \
		--arg policy "$USAGE_POLICY" --arg host "${ORCH_LANE_HOST:-local}" --arg plan "${plan:-}" \
		--argjson reading "$parsed" --argjson ems "$ems" --argjson rms "$rms" \
		--argjson until "$(( observed + window ))" --argjson kept "$kept" \
		'($kept | del(.normalized)) + {harness: $h, config_dir: $d, fetched_at: $now,
		  refusal: {endpoint: $ep, status: $status,
		            code: (if $code == "" then null else $code end),
		            detail: $detail, expires_at: $until}}
		| . + {normalized: {host: $host, policy: $policy,
		    fetched_at: (.usage_fetched_at // $now), prior_at: null, refusal: .refusal,
		    account: ($reading + {harness: $h, config_dir: $d, through: "local",
		      status: (if .usage != null then "ok" else $status end),
		      detail: (if .usage != null then "" else $detail end),
		      plan: (if $h == "copilot" then $reading.plan // $plan else $plan end),
		      prior_buckets: {}, expires_ms: $ems, refresh_expires_ms: $rms})}}' >"$tmp" \
		&& mv -f -- "$tmp" "$file"; then
		return 0
	fi
	rm -f -- "${tmp:?}"
	return 1
}

# The seconds a refusal naming Retry-After $1 is recorded for: that many where
# it names a positive whole number, USAGE_REFUSAL_WINDOW_S where it does not.
# The one judge of the window, so the cold-lane retry waits inside the same
# window the record holds.
usage_refusal_window() { # RETRY_AFTER
	local window="${1:-}"
	[[ "$window" =~ ^[0-9]+$ && "$window" -gt 0 ]] || window="$USAGE_REFUSAL_WINDOW_S"
	printf '%s' "$window"
}

# ── Host-wide usage refresh lock ─────────────────────────────────────────────
#
# One host-wide lock over each lane's REFRESH, so N callers times M lanes is
# one request per lane per age window, plus reset refreshes, instead of one per
# caller. The kendex watch, the fleet watch, each
# `oversee-succeed --check-marks` and each `pick` sweep
# the same accounts, and nothing else serializes them. measure_lane takes it
# only for a lane its own record read could not answer, and refresh_lane_usage
# reads the record again inside it, so the second caller through takes the
# first caller's figure or refusal instead of posting its own request. That is
# the pattern refresh_claude_token uses on the credentials file, for the same
# reason. A lane with a fresh figure or a live refusal never waits.
#
# A lock this run could NOT take is a keyed notice and the refresh still
# runs. This lock collapses concurrent refreshes; it does not authorize a read.
# Refusing the lane on contention would report it unmeasured, which is the
# wall on every launch decision that serving a stale figure exists to prevent,
# and a peer legitimately holding the lock would reach it. The notice is what
# keeps a doubled request from being silent.
#
# The take arms orch_take_lock's EXIT trap in this shell, so measure_lane only
# ever runs in a subshell: a pipeline stage in collect_lanes and a command
# substitution in cmd_pick_lane.
USAGE_REFRESH_LOCK_HELD=false
usage_lock_take() {
	USAGE_REFRESH_LOCK_HELD=false
	local lock="$USAGE_CACHE_DIR/.usage-refresh.lock"
	mkdir -p -- "$USAGE_CACHE_DIR" 2>/dev/null
	if ! exec 8>"$lock"; then
		message usage-lock-unopenable "$lock" >&2
		return 0
	fi
	if ! orch_take_lock 8 "$lock" "$USAGE_LOCK_WAIT_S"; then
		message usage-lock-timeout "$lock" "$USAGE_LOCK_WAIT_S" >&2
		exec 8>&-
	else
		USAGE_REFRESH_LOCK_HELD=true
	fi
}

# Closing the descriptor releases a flock; orch_release_lock removes the mkdir
# mutex where flock is absent and is a no-op where this run holds none.
usage_lock_release() {
	USAGE_REFRESH_LOCK_HELD=false
	exec 8>&-
	orch_release_lock
}

# Whether an OAuth expiry in milliseconds since the epoch has passed at epoch
# seconds $2, the expiry being what token_expiry_ms reads.
# A zero or unparseable stamp is NOT expired: the file states no expiry, and
# refusing on it would disable a lane that works.
token_expired() {
	local exp="${1%%.*}"
	[[ "$exp" =~ ^[0-9]+$ ]] || return 1
	[[ "$exp" -gt 0 ]] && (( exp <= $2 * 1000 ))
}

# The expiry of the access token in credentials file $2 of harness $1, in
# milliseconds since the epoch, as token_expired reads it. A Claude file states
# it as expiresAt. A Codex auth.json states none, so it is the `exp` claim of
# the access token itself, a JWT whose segments are unpadded base64url, hence
# the translation and the padding before decoding; 0 where the file holds no
# such token (an API key, or a token no claim reads out of).
LANE_CREDENTIALS_JQ='def lane_token_expiry_ms($h):
	if $h == "claude" then try (.claudeAiOauth.expiresAt // 0) catch 0
	else (try (.tokens.access_token | split(".")[1]
			        | gsub("-"; "+") | gsub("_"; "/")
			        | . + ("=" * ((4 - length % 4) % 4))
			        | @base64d | fromjson | .exp | numbers | floor * 1000)
			       catch null) // 0 end;
def lane_access_token($h):
	try (if $h == "claude" then .claudeAiOauth.accessToken // ""
	     else .tokens.access_token // .OPENAI_API_KEY // "" end) catch "";'
token_expiry_ms() { # HARNESS CREDS
	jq -r --arg h "$1" "$LANE_CREDENTIALS_JQ"'lane_token_expiry_ms($h)' "$2"
}

# The access token in credentials file $2 of harness $1, empty where it holds
# none. A Codex auth.json holding an API key and no login answers the key.
access_token() { # HARNESS CREDS
	jq -r --arg h "$1" "$LANE_CREDENTIALS_JQ"'lane_access_token($h)' "$2"
}

# The User-Agent the renewal posts with. platform.claude.com answers HTTP 429
# `rate_limit_error` to a token POST carrying none, whatever the rate, which is
# why an interactive `claude` launch renews an account this script could not.
# The endpoint matches the `claude-cli/` prefix and does not parse the version,
# so a host with no `claude` on PATH sends the fallback rather than nothing.
CLAUDE_CLI_UA_FALLBACK="2.1.278"
claude_token_ua() {
	local version=""
	version="$(claude --version 2>/dev/null)" && version="${version%% *}"
	[[ "$version" =~ ^[0-9][0-9A-Za-z.+-]*$ ]] || version="$CLAUDE_CLI_UA_FALLBACK"
	printf 'claude-cli/%s (external, cli)' "$version"
}

# The failure form every refusal below takes: a first line the caller reads the
# classification off — `<status> <code> <retry-after>`, `-` for a field the
# answer named none of — and the cause under it. The classification travels with
# the cause because this function is the only judge of why a renewal did not
# happen, and a caller re-deriving it from the sentence would be a second judge.
token_refusal() { # STATUS CODE RETRY_AFTER CAUSE
	printf '%s %s %s\n%s' "$1" "${2:--}" "${3:--}" "$4"
}

# The endpoint's own error object, as a suffix for the cause, so an operator
# reads what the endpoint said rather than only that it said no. Empty where the
# answer carries none.
token_error_suffix() { # BODY
	local type message
	type="$(jq -r 'try (.error.type // empty) catch empty' <<<"$1")"
	message="$(jq -r 'try (.error.message // empty) catch empty' <<<"$1")"
	[[ -n "$type" || -n "$message" ]] || return 0
	if [[ -n "$type" && -n "$message" ]]; then printf ' (%s: %s)' "$type" "$message"
	else printf ' (%s%s)' "$type" "$message"; fi
}

# Renews the expired access token in credentials file $3 of harness $1, config
# dir $2, through that harness's step. Prints the new token on stdout and
# returns 0, or prints a `token_refusal` there and returns 1, so the renewal is
# the only judge of the lane's status.
# The credentials lock on descriptor 9 is the one lock every renewal of that
# account takes, so two callers renew it once; lib/file-lock.sh carries it
# where flock is absent. Every caller runs this in a command substitution, so
# the EXIT trap orch_take_lock arms releases a mkdir mutex on every path out.
# A held lock is `unreachable`: it leaves the login untested. Inside the lock
# the expiry is read again, and a live token a peer wrote meanwhile is taken:
# renewing anyway would rotate the peer's fresh refresh token away.
# A step that reached its endpoint may already have rotated the refresh token,
# and an interrupt before the file is rewritten leaves the account on a
# retired one only a fresh login recovers. A caller's ceiling is such an
# interrupt, since `timeout` signals the whole process group, and an ignore
# alone does not stop it: the Codex CLI installs its own INT and TERM
# handlers. So the step runs as a background job under `set -m`, which bash
# puts in a process group of its own and never hands the terminal, and no
# group signal to the caller reaches it; macOS ships no setsid. The job is a
# subshell that execs nothing, so bash's setpgid never races an exec. This shell
# ignores INT and TERM while it waits, so it keeps the lock until the step
# exits. Job control is on only for the fork, so no foreground command here
# takes the terminal. The cost: the step holds this script's stderr, so a
# caller reading stderr through a pipe waits past its ceiling for the step's
# own request bound, curl's --max-time for Claude and the CLI's request
# timeouts for Codex. No caller sends KILL. The
# lock's own handlers go back afterwards, never `trap - INT TERM`, whose
# default disposition kills the shell with no EXIT trap and leaves the mutex
# held.
renew_token() { # HARNESS DIR CREDS
	local harness="$1" dir="$2" creds="$3" lock at rc=0
	lock="$dir/.lanes-refresh.lock"
	exec 9>"$lock" || { token_refusal error '' '' "the lock file $lock could not be opened"; return 1; }
	orch_take_lock 9 "$lock" 30 || { token_refusal unreachable '' '' "another tool holds the credentials lock $lock"; exec 9>&-; return 1; }
	lane_now
	if ! token_expired "$(token_expiry_ms "$harness" "$creds")" "$LANE_NOW" \
		&& at="$(access_token "$harness" "$creds")" && [[ -n "$at" ]]; then
		printf '%s' "$at"
	else
		trap '' INT TERM
		# Under job control bash leaves a job's stdin alone, and a job that
		# read a terminal would stop for good while this shell holds the lock.
		set -m
		case "$harness" in
			claude) refresh_claude_token "$dir" "$creds" ;;
			codex) refresh_codex_token "$dir" "$creds" ;;
			*) token_refusal error '' '' "no renewal exists for a $harness token"; false ;;
		esac </dev/null &
		set +m
		wait "$!" || rc=1
		orch_arm_lock_signals
	fi
	exec 9>&-
	return "$rc"
}

# The Claude renewal step: a refresh-token grant against the Claude token
# endpoint, the new token written back into credentials file $2 of config dir
# $1. Only a login this renewal proved dead takes `expired`: a step this
# machine failed on its own is `error`, and a POST that never reached the
# endpoint is `unreachable`.
refresh_claude_token() { # DIR CREDS
	local dir="$1" creds="$2" rt client_id body resp new_at suffix
	client_id="${ORCH_LANES_CLAUDE_CLIENT_ID:-}"
	[[ -n "$client_id" ]] || { token_refusal error '' '' 'no OAuth client id is configured (ORCH_LANES_CLAUDE_CLIENT_ID)'; return 1; }
	rt=$(jq -r 'try (.claudeAiOauth.refreshToken // empty) catch empty' "$creds")
	[[ -n "$rt" ]] || { token_refusal expired '' '' "there is no refresh token in $creds to renew with"; return 1; }
	# Secrets travel in the environment, never in an argument vector: on Linux
	# /proc/<pid>/cmdline is world-readable and /proc/<pid>/environ is not, so a
	# `jq --arg rt "$rt"` hands every local user a refresh token that renews
	# indefinitely. The client id is not a secret and stays on argv.
	body=$(LANES_RT="$rt" jq -nc --arg ci "$client_id" \
		'{grant_type:"refresh_token", client_id:$ci, refresh_token:env.LANES_RT}') \
		|| { token_refusal error '' '' 'the token request body could not be built'; return 1; }
	# The User-Agent reaches the injected command through its ENVIRONMENT, never
	# argv, which is where the real POST carries it too: a stub asserting the
	# header asserts what curl would send. curl's --max-time bounds the POST.
	if [[ -n "${ORCH_LANES_TOKEN_CMD:-}" ]]; then
		resp=$(LANES_USER_AGENT="$CLAUDE_TOKEN_UA" "$ORCH_LANES_TOKEN_CMD" <<<"$body")
	else
		resp=$(curl -s --max-time 25 -X POST "$CLAUDE_TOKEN_URL" \
			-A "$CLAUDE_TOKEN_UA" \
			-H "Content-Type: application/json" -H "anthropic-beta: $CLAUDE_OAUTH_BETA" \
			-D - -w '\n%{http_code}' --data-binary @- <<<"$body") \
			&& resp="$(http_answer "$resp")"
	fi || { token_refusal unreachable '' '' 'the token endpoint could not be reached'; return 1; }
	split_http_answer "$resp"
	suffix="$(token_error_suffix "$HTTP_BODY")"
	# A status the endpoint refused with IS the failure, so it is what the cause
	# names. `rate_limited` and `unreachable` leave the login itself untested;
	# only a code that is neither still reads as a proven-dead one.
	if [[ -n "$HTTP_CODE" && "$HTTP_CODE" != 2?? ]]; then
		token_refusal "$(http_refusal_status "$HTTP_CODE" expired)" "$HTTP_CODE" "$HTTP_RETRY" \
			"the token endpoint refused the renewal with HTTP $HTTP_CODE$suffix"
		return 1
	fi
	new_at=$(jq -r 'try (.access_token // empty) catch empty' <<<"$HTTP_BODY")
	[[ -n "$new_at" ]] || { token_refusal expired "$HTTP_CODE" "$HTTP_RETRY" "the token endpoint returned no access token$suffix"; return 1; }
	local tmp new_rt expires_in new_exp
	# The new expiry is written with the new token or nothing is: a credentials
	# file carrying a live token under a past expiresAt reads as expired on
	# every later run, so each one renews again and rotates the refresh token
	# the account's own harness is holding.
	# Strictly positive: a zero lifetime writes expiresAt at this instant, so
	# the lane returns renewed and the next run reads it expired and renews
	# again. That is the rotation storm this renewal exists to close, reached
	# through the check that closes it.
	expires_in=$(jq -r 'try (.expires_in // empty) catch empty' <<<"$HTTP_BODY")
	[[ "$expires_in" =~ ^[0-9]+$ && "$expires_in" -gt 0 ]] || { token_refusal expired "$HTTP_CODE" "$HTTP_RETRY" 'the token endpoint returned no usable expires_in'; return 1; }
	lane_now
	new_exp=$(( (LANE_NOW + expires_in) * 1000 ))
	new_rt=$(jq -r 'try (.refresh_token // empty) catch empty' <<<"$HTTP_BODY")
	tmp="$(mktemp "$dir/.credentials.XXXXXX")" || { token_refusal error '' '' "no temporary file could be created in $dir"; return 1; }
	# Between here and the rename this file holds a live rotated refresh token.
	# renew_token's process group keeps a caller's interrupt from leaving it in
	# the config directory, where a backup or a dotfile sync would carry it off the machine.
	LANES_AT="$new_at" LANES_RT="${new_rt:-$rt}" jq --argjson exp "$new_exp" \
		'.claudeAiOauth.accessToken = env.LANES_AT
		 | .claudeAiOauth.refreshToken = env.LANES_RT
		 | .claudeAiOauth.expiresAt = $exp' \
		"$creds" >"$tmp" && mv "$tmp" "$creds" \
		|| { rm -f -- "${tmp:?}"; token_refusal error '' '' "the renewed credentials could not be written to $creds"; return 1; }
	printf '%s' "$new_at"
}

# What `codex app-server` reads on stdin for a renewal: the handshake, then
# `account/read` with `refreshToken`, which the app-server protocol documents
# as asking the CLI to refresh its token before answering.
CODEX_RENEW_REQUESTS='{"method":"initialize","id":0,"params":{"clientInfo":{"name":"lanes","version":"1"}}}
{"method":"initialized"}
{"method":"account/read","id":1,"params":{"refreshToken":true}}'
# Tenths of a second the CLI's stdin is held open for the answer to request 1.
# It does not bound the run: the CLI keeps running after its stdin closes while
# a refresh is in flight, and its own request timeouts end it.
CODEX_RENEW_WAIT_TENTHS=250

# Why a `codex app-server` run left the token expired, as a `token_refusal`:
# one table over the last `Failed to refresh token:` line the CLI logged into
# run dir $2 and its answer to request 1, each pattern a codex-cli 0.159.0
# message. The status and remedy each row takes are the header's, under "Why a
# Codex token is renewed by the Codex CLI".
codex_renew_refusal() { # DIR RUN_DIR
	local said answer
	said="$(sed -n 's/.*Failed to refresh token: //p' "$2/stderr" | tail -n 1)"
	answer="$(jq -rR 'fromjson? | objects | select(.id == 1 and .error != null)
		| .error.message // (.error | tostring)' "$2/answer")"
	case "$said" in
		*'Your access token could not be refreshed'*)
			token_refusal expired '' '' "codex could not renew it: $said; log in again with CODEX_HOME=$1 codex login" ;;
		*'error sending request for url (https://auth.openai.com/'*)
			token_refusal unreachable '' '' "codex could not reach the token endpoint: $said" ;;
		*)
			said="${said:+codex could not renew it: $said; }"
			if [[ -n "$answer" ]]; then
				token_refusal unreachable '' '' "${said}codex answered the renewal with an error: $answer"
			else
				token_refusal expired '' '' "${said:-codex did not renew it; }run codex once with CODEX_HOME=$1"
			fi
			;;
	esac
}

# The Codex step, through the Codex CLI and never a refresh-token grant of this
# script's own: a second refresher of one auth.json races every Codex session
# on the account, and the loser holds a revoked login. `codex app-server` in
# that config dir is asked `account/read` with `refreshToken` and writes
# auth.json as any Codex run does, and auth.json read back is the verdict.
# The outcomes are the header's, under "Why a Codex token is renewed by the
# Codex CLI".
refresh_codex_token() { # DIR AUTH_JSON
	local dir="$1" creds="$2" run waited refusal="" at
	if [[ -z "$(jq -r 'try (.tokens.refresh_token // empty) catch empty' "$creds")" ]]; then
		token_refusal expired '' '' "there is no refresh token in $creds to renew with; log in again with CODEX_HOME=$dir codex login"
		return 1
	fi
	command -v codex >/dev/null 2>&1 \
		|| { token_refusal expired '' '' "no codex command is on PATH to renew it; install the Codex CLI and run codex once with CODEX_HOME=$dir"; return 1; }
	run="$(mktemp -d "$dir/.lanes-renew.XXXXXX")" || { token_refusal error '' '' "no temporary directory could be created in $dir"; return 1; }
	# The writer holds the CLI's stdin open until the answer to request 1 is in
	# its output, the CLI has exited, or the bound passes. The CLI runs in the
	# config dir, so no project configuration of the caller's directory reaches
	# it, and without descriptor 9, so a process it leaves behind cannot hold
	# the credentials lock.
	{
		printf '%s\n' "$CODEX_RENEW_REQUESTS"
		waited=0
		until grep -q -e '"id":1[,}]' "$run/answer" 2>/dev/null || [[ -e "$run/exited" || "$waited" -ge "$CODEX_RENEW_WAIT_TENTHS" ]]; do
			sleep 0.1
			waited=$((waited + 1))
		done
	} | (cd -- "$dir" && CODEX_HOME="$dir" codex app-server; : >"$run/exited") >"$run/answer" 2>"$run/stderr" 9>&-
	lane_now
	token_expired "$(token_expiry_ms codex "$creds")" "$LANE_NOW" && refusal="$(codex_renew_refusal "$dir" "$run")"
	rm -rf -- "$run"
	[[ -z "$refusal" ]] || { printf '%s' "$refusal"; return 1; }
	at="$(access_token codex "$creds")"
	[[ -n "$at" ]] || { token_refusal expired '' '' "codex left no access token in $creds; run codex once with CODEX_HOME=$dir"; return 1; }
	printf '%s' "$at"
}

# headroom = 100 - the BINDING bucket. A lane with an unknown bucket set gets
# null headroom and is never picked: "we could not measure it" must not read as
# "it is empty".
#
# A lane that authenticated fine but reported NO usable bucket is downgraded to
# `no_usage_data` rather than left as `ok`. Observed on an enterprise plan, which
# authenticates and returns a usage object carrying none of the consumer
# windows. Leaving it `ok` with blank numbers reads as "measured, and idle",
# which is the one thing it must not read as.
#
# The binding bucket names the `resets` key of the largest bucket. On a tie the
# longer window binds (monthly, then weekly, then model, then session): its
# wall lasts longest.
#
# A Copilot record also carries `credits` and `unlimited`, information beside
# its `monthly` bucket (schemas/copilot-credits.md); a Codex record carries
# the `credits` lib/lane-usage.sh parse_codex_usage reads.
LANE_EMIT_JQ='def emit_lane_row($alias; $harness; $dir; $id; $status; $detail; $plan; $retire; $claims; $age; $refreshable; $through; $b; $pb; $elapsed; $sample_claims):
		($b // {} | utc_resets) as $b
		| [$b.session_5h_pct, $b.weekly_pct, $b.model_pct, $b.monthly_pct] | map(select(. != null)) as $known
		| (if ($status == "ok" and ($known | length) == 0 and $b.credits.unit != "usd") then "no_usage_data" else $status end) as $st
		| ({status: $st} | lane_measured) as $measured
		| ([{k: "monthly", p: $b.monthly_pct}, {k: "weekly", p: $b.weekly_pct}, {k: "model", p: $b.model_pct}, {k: "session", p: $b.session_5h_pct}]
		   | map(select(.p != null)) | sort_by(-.p) | first // null) as $bind
		| {
		    alias: $alias,
		    harness: $harness,
		    config_dir: $dir,
		    _id: $id,
		    retire_date: (if $retire == "" then null else $retire end),
		    measured_through: $through,
		    status: $st,
		    refreshable: $refreshable,
		    plan: (if $plan == "" then null else $plan end),
		    session_5h_pct: ($b.session_5h_pct // null),
		    weekly_pct: ($b.weekly_pct // null),
		    model_pct: ($b.model_pct // null),
		    model_label: ($b.model_label // null),
		    model_buckets: ($b.model_buckets // []),
		    monthly_pct: ($b.monthly_pct // null),
		    credits: (if $b.credits == null then null
		              else $b.credits + {measured_at: ((now - ($age // 0)) | floor | todate)} end),
		    unlimited: ($b.unlimited == true),
		    claims: $claims,
		    headroom_pct: (if ($measured and ($known | length) > 0) then (100 - ($known | max)) else null end),
		    binding_bucket: (if ($measured and $bind != null) then $bind.k else null end),
		    binding_resets_at: (if ($measured and $bind != null) then ($b.resets[$bind.k] // null) else null end),
		    usage_age_s: $age,
		    _rate_prior: ($pb | utc_resets),
		    _rate_elapsed_s: $elapsed,
		    _rate_sample_claims: $sample_claims,
		    resets: (($b.resets // {}) | {session: (.session // null), weekly: (.weekly // null),
		                                 model: (.model // null), monthly: (.monthly // null)}),
		    detail: (if $st == "no_usage_data" and $detail == ""
		             then "authenticated, but the usage response carried no session/weekly/monthly window"
		             elif $detail == "" then null else $detail end)
		  }
		| . + (if $harness == "copilot" then {credits_used: ($b.credits_used // null)} else {} end)
		| with_lane_binding(""; false);'

emit_lane() {
	# refreshable is true only for a lane this run found expired and made live,
	# by its own renewal or by taking one a peer wrote under the lock: a lane
	# whose token had not expired, and one whose renewal failed, are both false.
	# `through` is the credential this row was measured through: `local` for a
	# config dir on this machine, `host` for a row the provider reported. Carried
	# in the record itself so no listing stamps it afterwards, which cost the
	# whole listing one jq pass whether or not a provider was configured.
	local alias="$1" harness="$2" dir="$3" status="$4" detail="$5" plan="$6" buckets="$7" age="${8:-null}" refreshable="${9:-false}" through="${10:-local}" prior="${11:-}" elapsed="${12:-null}" sample_claims="${13:-1}"
	lane_retire_date "$dir" silent
	[[ -n "$prior" ]] || prior='{}'
	# No-figure callers pass empty buckets. In a cache-only listing, the wall
	# oversee-watch recorded cannot supply the missing usage reading. Parsed
	# figures and ordinary listings retain the existing wall overlay.
	if [[ "$CACHE_ONLY" != true || "$buckets" != '{}' ]]; then
		buckets="$(account_wall_buckets "$PROJECT_ROOT" "$dir" "$buckets")" || { buckets='{}' status=error detail="wall record unreadable"; }
	fi
	# `null`, never 0, when the store could not be read: "we could not see the
	# launches in flight" must not read as "there are none".
	local claims="null"
	if [[ "$LANE_CLAIMS_RC" == 0 ]]; then
		account_claims "$dir" "$harness" "$buckets" silent || return 1
		claims="$ACCOUNT_CLAIMS"
	fi
	lane_canon "$dir" || return 1
	jq -nc \
		--arg alias "$alias" --arg harness "$harness" --arg dir "$dir" --arg id "$LANE_CANON" \
		--arg status "$status" --arg detail "$detail" --arg plan "$plan" --arg retire "$LANE_RETIRE_DATE" \
		--argjson claims "$claims" --argjson age "$age" \
		--argjson refreshable "$refreshable" \
		--arg through "$through" --argjson b "$buckets" \
		--argjson pb "$prior" --argjson elapsed "$elapsed" --argjson sample_claims "$sample_claims" "$LANE_MODEL_JQ$LANE_EMIT_JQ"'emit_lane_row($alias; $harness; $dir; $id; $status; $detail; $plan; $retire; $claims; $age; $refreshable; $through; $b; $pb; $elapsed; $sample_claims)'
}

# Called before `collect_lanes`, never inside it: collect_lanes runs in a
# command substitution, and a read failure recorded there would die with the
# subshell instead of reaching the decision.
load_lane_claims() {
	local line cfg named pool rest h d own=$'\n' key
	LANE_CLAIMS_RC=0
	LANE_CLAIMS_LIVE="$(lane_claims_read "$(lane_claims_dir "$PROJECT_ROOT")" fleet)" || LANE_CLAIMS_RC=$?
	LANE_CLAIM_ACCOUNTS=""
	# An alias is not unique: two of this machine's own lanes can share one
	# (`/home/u/.foo` and `/srv/u/.foo`). A claim on one of them is that lane's
	# by its path, and only a claim no lane here holds, another home's, is
	# named, so a name never moves a claim between two lanes this machine
	# knows: every harness's, Pi roots and excluded dirs included, since an
	# exclusion added while a lane runs leaves its claim live.
	for h in claude codex copilot pi; do
		lane_dirs "$h" all silent || { message account-read-failed discovery "$?" >&2; return 1; }
		for d in ${LANE_DIRS_FOUND[@]+"${LANE_DIRS_FOUND[@]}"}; do
			lane_canon "$d" || { message account-read-failed canonical "$?" >&2; return 1; }
			own+="$LANE_CANON"$'\n'
		done
	done
	# Fleet mode ends in named spelling and pool. The reader supplies plan
	# for an older claim, so empty fleet and named fields keep their positions.
	while IFS= read -r line; do
		[[ -n "$line" ]] || continue
		cfg="${line%%$'\t'*}"
		pool="${line##*$'\t'}"
		rest="${line%$'\t'*}"
		named="${rest##*$'\t'}"
		key=""
		case "$own" in *$'\n'"$cfg"$'\n'*) ;; *) lane_account_name "${named:-$cfg}" silent; key="$LANE_ACCOUNT_NAME" ;; esac
		LANE_CLAIM_ACCOUNTS+="$cfg"$'\t'"$key"$'\t'"$pool"$'\n'
	done <<<"$LANE_CLAIMS_LIVE"
	load_normalized "${1:-}" || return 1
}

# The name a store several homes share knows DIR's account by: the alias `list`
# gives it, or nothing for a home's own default account. A dir named the bare
# harness word (`~/.claude`, `~/.codex`, `~/.copilot`) is the login that
# harness falls back to in whatever home it sits, so two users' `~/.claude` are
# two accounts, and only an ORCH_LANE_ALIASES name joins it to another home's.
lane_account_name() { # DIR [SILENT]
	local alias base
	lane_alias_for "$1" silent; alias="$LANE_ALIAS"
	lane_base "$1"; base="$LANE_BASE"
	base="${base#.}"
	LANE_ACCOUNT_NAME=""
	[[ "$alias" == "$base" && "$base" =~ ^(claude|codex|copilot)$ ]] || LANE_ACCOUNT_NAME="$alias"
	[[ "${2:-}" == silent ]] || printf '%s' "$LANE_ACCOUNT_NAME"
}

# Live claims against DIR's account. A store several homes share names one
# account by as many paths as there are homes (`/home/a/.eclaude`,
# `/home/b/.eclaude`), so a claim counts against DIR where its canonical config
# dir is DIR's, or where lane_account_name of the spelling its launch named is
# DIR's and not empty, which load_lane_claims leaves only on another home's
# claim. Plan windows count only plan claims; Copilot counts its monthly
# pool claims. Pi USD grants have no in-flight charge. Reads
# LANE_CLAIM_ACCOUNTS, which load_lane_claims names.
account_claims() { # DIR [HARNESS [BUCKETS [SILENT]]]
	local pool=plan unit="" line cfg named claim_pool key
	case "${2:-claude}" in
		copilot | pi) pool=copilot ;;
	esac
	if [[ "${2:-}" == pi && -n "${3:-}" ]]; then
		unit="$(jq -r '.credits.unit // empty' <<<"$3")" || return 1
		[[ "$unit" != usd ]] || { ACCOUNT_CLAIMS=0; [[ "${4:-}" == silent ]] || printf '0\n'; return 0; }
	fi
	lane_canon "$1" || return 1
	key="$LANE_CANON"
	lane_account_name "$1" silent
	ACCOUNT_CLAIMS=0
	while IFS= read -r line; do
		[[ -n "$line" ]] || continue
		cfg="${line%%$'\t'*}"; named="${line#*$'\t'}"
		claim_pool="${named##*$'\t'}"; named="${named%%$'\t'*}"
		[[ "$claim_pool" == "$pool" ]] || continue
		[[ "$cfg" == "$key" || ( -n "$named" && "$named" == "$LANE_ACCOUNT_NAME" ) ]] || continue
		ACCOUNT_CLAIMS=$((ACCOUNT_CLAIMS + 1))
	done <<<"$LANE_CLAIM_ACCOUNTS"
	[[ "${4:-}" == silent ]] || printf '%s\n' "$ACCOUNT_CLAIMS"
}

# EXCLUDE is the config dirs, one a line, that `pick` omits before the chooser
# judges the rest: --exclude-lane. An omitted dir is
# never measured. HOSTED is a JSON array of host rows that STAND IN for this
# machine's reading of the same config dir, which `pick` passes and `list` does
# not: a launch on a hosted fleet runs under the provider's copy, so the chooser
# judges that copy, while a listing shows both readings. Which reading stands
# for a local dir the host reports is host_row_or_local's answer, and each host
# row passes the same exclusion test. Each row is matched on the `_id`
# host_lane_rows stamped on it; a host row discovery reaches is emitted from the
# local loop, in the local dir's place, and the tail carries only the rows
# naming a dir discovery does not reach.
collect_lanes() {
	local harness_filter="$1" exclude="${2:-}" hosted="${3:-[]}" model="${4:-}" excluded="" held="" reached="" id d h row x held_records i
	local held_ids=() held_rows=()
	while IFS= read -r x; do
		[[ -n "$x" ]] || continue
		lane_canon "$x" || return 1
		excluded+="$LANE_CANON"$'\n'
	done <<<"$exclude"
	if [[ "$hosted" != "[]" ]]; then
		held_records="$(jq -r '.[] | ._id, tojson' <<<"$hosted")" || return 1
		while IFS= read -r id && IFS= read -r row; do
			held+="$id"$'\n'; held_ids+=("$id"); held_rows+=("$row")
		done <<<"$held_records"
	fi
	{
		# `all` is the three harnesses whose accounts this machine measures; the
		# Copilot pool a Pi launch on a `github-copilot/` model spends is
		# asked for by name alone.
		for h in claude codex copilot pi; do
			[[ "$harness_filter" == "$h" || ( "$harness_filter" == "all" && "$h" != pi ) ]] || continue
			[[ "$(lane_pick_pool "$h" "$model")" != api-credit ]] || continue
			while IFS= read -r d; do
				[[ -n "$d" ]] || continue
				if [[ -n "$excluded" || -n "$held" ]]; then
					lane_canon "$d" || return 1; id="$LANE_CANON"
					case $'\n'"$excluded" in
						*$'\n'"$id"$'\n'*) continue ;;
					esac
					case $'\n'"$held"$'\n' in
						*$'\n'"$id"$'\n'*)
							reached+="$id"$'\n'
							# A helper failure must not restore shared host room
							# when the requested model was never measured. This
							# pipeline reports it as an unread candidate.
							for ((i=0; i<${#held_ids[@]}; i++)); do
								[[ "${held_ids[i]}" != "$id" ]] || { row="${held_rows[i]}"; break; }
							done
							host_row_or_local "$h" "$d" "$row" "$model" \
								|| { [[ "$NORMALIZED_FAILED" != true ]] || return 1; message pick-lane-failed "$d" local-reading >&2;
									jq -c '. + {status: "error", headroom_pct: null, detail: "local-reading failed"}' <<<"$row" || return 1; }
							continue
							;;
					esac
				fi
				measure_lane "$h" "$d" || return 1
			done < <(lane_dirs "$h")
		done
		jq -c --arg x "$excluded" --arg r "$reached" '
			($x | split("\n") | map(select(. != ""))) as $excluded
			| ($r | split("\n") | map(select(. != ""))) as $reached
			| .[] | select(._id as $i | any($excluded[]; . == $i) | not)
			| select(._id as $i | any($reached[]; . == $i) | not)' <<<"$hosted"
	} | jq -s '.'
}

# The provider's rows for HARNESS as one JSON array in HOSTED_ROWS, `[]` where
# ORCH_LANE_HOST names none or there are none to merge. READINGS is
# host_account_records' own. The reader has already said on stderr what it did
# with an absent or failed verb, and either way there are no host rows, so the
# caller keeps this machine's reading. HOSTED_READ names how the read ended,
# `local`, `answered`, `absent` or `failed`, a merge failure among the last:
# a Pi pick with no override tells a pool no provider reads from one a retry
# can read. Globals, so the caller runs this in its own shell. Only the merge is
# this function's to report, so a merge failure is never printed as the
# provider's answer.
#
# Each row carries `_id`, its config dir through the one normaliser, so a dir
# the provider names with a trailing slash or through a symlink still stands for
# the local dir it names; lane_public drops it. The provider's rows are read
# through the usage cache under ORCH_LANES_USAGE_TTL, like every usage figure
# here: they are windows, and whether the host holds an account for a launch
# gate is `host-accounts --no-cache`'s answer, never this one.
HOSTED_ROWS="[]" HOSTED_READ=local HOST_ACCOUNTS_ROWS="" HOSTED_API_DISCOVERED=false
host_lane_rows() { # HARNESS [READINGS [MODEL]]
	local rows answer format="" hosted="" dirs ids="" d accounts_rc=0 hosted_rc=0 i
	HOSTED_ROWS="[]" HOSTED_READ=local HOST_ACCOUNTS_ROWS="" HOSTED_API_DISCOVERED=false
	[[ "${ORCH_LANE_HOST:-local}" != local ]] || return 0
	load_normalized "$NORMALIZED_TARGET" || return 1
	if [[ "$NORMALIZED_HOST_READY" == true ]]; then
		if [[ "$NORMALIZED_HOST_STATUS" == 2 ]]; then HOSTED_READ=absent; return 0; fi
		HOSTED_READ=answered HOSTED_API_DISCOVERED="$NORMALIZED_HOST_API"
		HOST_ACCOUNTS_ROWS="$(jq -r '.rows' <<<"$NORMALIZED_HOST_USAGE")" || return 1
		rows=""
		for ((i=0; i<${#NORMALIZED_DIRS[@]}; i++)); do
			[[ "${NORMALIZED_THROUGHS[i]}" == host ]] || continue
			[[ "${2:-}" != readings || "${NORMALIZED_READINGS[i]}" == true ]] || continue
			rows+="${NORMALIZED_ROWS[i]}"$'\n'
		done
		HOSTED_ROWS="$(jq -cs --arg h "$1" 'map(select(.harness == $h or ($h == "all" and .harness != "pi")))' <<<"$rows")" || return 1
		return 0
	fi
	[[ "$(lane_pick_pool "$1" "${3:-}")" != api-credit ]] || format=record
	answer="$(host_accounts_answer "$ORCH_LANE_HOST" "$format")" || accounts_rc=$?
	case "$accounts_rc" in
		0) HOSTED_READ=answered ;;
		2) HOSTED_READ=absent; return 0 ;;
		*) HOSTED_READ=failed; return 0 ;;
	esac
	rows="$answer"
	if [[ "$format" == record ]]; then
		HOSTED_API_DISCOVERED="$(jq -r '.api_discovered' <<<"$answer")" || hosted_rc=$?
		rows="$(jq -r '.rows' <<<"$answer")" || hosted_rc=$?
	fi
	# Keep this command's answer for seats too, even with no cache or a zero TTL.
	HOST_ACCOUNTS_ROWS="$rows"
	# Seed host-only paths through the protocol's parser before child shells
	# emit their readings. The emitting pass reports any invalid cached row.
	[[ "$hosted_rc" -ne 0 ]] || host_account_rows "$rows" "$1" canon 2>/dev/null || hosted_rc=$?
	[[ "$hosted_rc" -ne 0 ]] || rows="$(host_account_rows "$rows" "$1" "${2:-}")" || hosted_rc=$?
	dirs="$(jq -sr '.[].config_dir' <<<"$rows")" || hosted_rc=$?
	while IFS= read -r d; do
		[[ -n "$d" ]] || continue
		lane_canon "$d" || { hosted_rc=$?; break; }
		ids+="$LANE_CANON"$'\n'
	done <<<"$dirs"
	[[ "$hosted_rc" -ne 0 ]] || hosted="$(jq -cs --arg ids "$ids" '
		($ids | split("\n") | .[:-1]) as $ids
		| to_entries | map(.value + {_id: $ids[.key]})' <<<"$rows")" || hosted_rc=$?
	if [[ "$hosted_rc" -ne 0 ]]; then
		message host-accounts-merge-failed "$ORCH_LANE_HOST" "$hosted_rc" >&2
		HOSTED_READ=failed
		return 0
	fi
	HOSTED_ROWS="$hosted"
}

# ── Host accounts ────────────────────────────────────────────────────────────
#
# A hosted fleet's launches do not run on this machine's copy of an account.
# `lane-host create` hands the sandbox the PROVIDER's own secret for the
# account and the local config dir never reaches it, so the two copies are
# independent: a refresh token this machine can no longer renew leaves the
# local directory `expired` while the sandbox goes on working for hours. A
# listing showing only the local reading reports such an account as dead.
#
# The provider answers `accounts` with one tab-separated `key=value` line per
# account it holds a credential for, keyed on the config dir kendex passed it
# as `create --account`. kendex never names the provider's secret layout: what
# the credential IS stays the provider's, and only the windows read through it
# come back here.
#
# No provider has to implement the verb: an absent one exits 2 and this
# listing stays the local reading it always was.
#
# This function is the ONE reader of the protocol. `lanes host-accounts` prints
# what it validated, so a caller asking whether the host holds an account asks
# that rather than matching the provider's bytes for itself, and the account
# field, the harness match and the dropped invalid row are decided once.
#
# Fields: `account` and `harness`, plus the optional `seat`, `status`, `detail`,
# `session-5h-pct`, `weekly-pct`, `model-pct`, `monthly-pct`, `model-label`,
# `session-resets`, `weekly-resets`, `model-resets` and `monthly-resets`. A
# `harness=pi` row names a Pi root for a Copilot pool as `monthly-pct`, or
# a Claude home for an API grant as the four `credit-*` fields.
# `all` leaves it out, as it leaves Pi out of collect_lanes,
# and only a caller naming `pi` gets it. A percentage the row
# omits is a window the provider did not measure, which emit_lane reports as
# no_usage_data rather than as an idle account. `detail` is the provider's own
# words for the row's status, carried into the record's `detail` as written,
# so the refusal it names (`http-429-rate_limit_error`,
# `http-403-permission_error`) reaches a reader of the record whatever status
# word the provider chose. An api-credit- detail identifies an unread API
# grant; the status decides its measurement. Only seat=1 marks a seat;
# any other seat value keeps the row unmarked.
# A usage field this script cannot read drops the whole row with a notice: a
# percentage nobody can parse must not be judged as room.
#
# Status: 0 the provider answered, rows or none; 2 the optional verb is absent,
# with nothing on stderr; 1 the verb failed or this function could not run it,
# its own bytes and the keyed notice already on stderr. A caller that cannot
# tell those apart reads a failed verb as a host holding nothing, which is the
# one reading the protocol exists to prevent.
#
# The answer itself comes from host_accounts_answer, which is where the cache and
# the time bound are; this function parses and filters it.
#
# READINGS `readings` drops a row carrying no `status` and no percentage: such a
# row says the provider HOLDS the account and nothing about what its copy
# measures, so a pick keeps this machine's reading of that account.
host_account_records() { # HOST HARNESS [READINGS] — one lane record per account it holds
	local rows rc=0
	rows="$(host_accounts_answer "$1")" || rc=$?
	[[ "$rc" -eq 0 ]] || return "$rc"
	host_account_rows "$rows" "${2:-all}" "${3:-}"
}

# CACHE is the form written to the usage cache: the provider's row for an
# account the policy admits, nothing for an excluded one, and for a retired one
# its account, harness and a `status=retired` marker with no usage figure. The
# marker keeps the row a reading, so a listing that wants readings still
# reports the account retired rather than unlisted; it is never read under a
# policy that does not retire the account, since the record it sits in is
# stamped with every setting the retirement was matched through, the alias
# map included, and the day, and is a miss under any other.
host_account_rows() { # ROWS HARNESS [READINGS|CACHE|BUCKETS|CANON|SEATS|DISCOVERY]
	local rows="$1" want="$2" mode="${3:-}" line field key value bad retire said rest alias
	local batch_args=() selected id claims wall wall_file kind payload normalized_result=""
	local account harness status detail seat s_pct w_pct m_pct mo_pct m_label s_reset w_reset m_reset mo_reset
	local buckets credit_limit credit_spent credit_remaining credit_expires credit_fields monthly_field
	while IFS= read -r line; do
		[[ -n "$line" ]] || continue
		account=""; harness=""; status="ok"; detail=""; seat=""; bad=""; said=""
		s_pct=null; w_pct=null; m_pct=null; mo_pct=null
		m_label=""; s_reset=""; w_reset=""; m_reset=""; mo_reset=""
		credit_limit=""; credit_spent=""; credit_remaining=""; credit_expires=""; credit_fields=""; monthly_field=""
		rest="$line"$'\t'
		while [[ -n "$rest" ]]; do
			field="${rest%%$'\t'*}"; rest="${rest#*$'\t'}"
			[[ -n "$field" ]] || continue
			key="${field%%=*}"
			value="${field#*=}"
			case "$key" in
				account) account="$value" ;;
				harness) harness="$value" ;;
				status) status="$value"; said="${value:+status}" ;;
				detail) detail="$value" ;;
				seat) seat="$value" ;;
				model-label) m_label="$value" ;;
				session-resets) s_reset="$value" ;;
				weekly-resets) w_reset="$value" ;;
				model-resets) m_reset="$value" ;;
				monthly-resets) mo_reset="$value" ;;
				credit-limit|credit-spent|credit-remaining|credit-expires)
					credit_fields=yes; said="$key"
					case "$key" in
						credit-limit) credit_limit="$value" ;;
						credit-spent) credit_spent="$value" ;;
						credit-remaining) credit_remaining="$value" ;;
						credit-expires) credit_expires="$value" ;;
					esac
					;;
				session-5h-pct|weekly-pct|model-pct|monthly-pct)
					[[ "$key" != monthly-pct ]] || monthly_field=yes
					if [[ -z "$value" ]]; then continue; fi
					if [[ "$value" =~ ^[0-9]{1,3}$ ]] && (( 10#$value <= 100 )); then
						case "$key" in
							session-5h-pct) s_pct=$((10#$value)) ;;
							weekly-pct) w_pct=$((10#$value)) ;;
							model-pct) m_pct=$((10#$value)) ;;
							monthly-pct) mo_pct=$((10#$value)) ;;
						esac
						said="$key"
					else
						bad="$key"
					fi
					;;
				*) ;;
			esac
		done
		[[ -n "$account" ]] || bad="${bad:-account}"
		[[ "$harness" =~ ^(claude|codex|copilot|pi)$ ]] || bad="${bad:-harness}"
		if [[ -n "$credit_fields" ]]; then
			[[ "$harness" == pi && -z "$monthly_field" ]] || bad="${bad:-credit-fields}"
			for value in "$credit_limit" "$credit_remaining"; do
				[[ "$value" =~ ^[0-9]+([.][0-9]{1,2})?$ ]] || bad="${bad:-credit-fields}"
			done
			[[ "$credit_spent" =~ ^[0-9]+([.][0-9]{1,2})?$ ]] || bad="${bad:-credit-spent}"
		fi
		if [[ -n "$bad" ]]; then
			message host-account-invalid "${account:-<unnamed>}" "$bad" >&2
			continue
		fi
		selected=true id="" claims=null wall="" wall_file="" retire=""
		[[ "$want" == all || "$harness" == "$want" ]] || selected=false
		# Normalization keeps the same complete cache inventory, Pi included.
		if [[ "$mode" != normalized ]]; then
			[[ "$want:$harness" != all:pi || "$mode" == cache || "$mode" == buckets ]] || continue
		fi
		[[ "$mode" != readings || -n "$said" ]] || selected=false
		if [[ "$mode" != discovery ]] && lane_excluded "$account"; then selected=false; fi
		lane_alias_for "$account" silent; alias="$LANE_ALIAS"
		if lane_retired "$account" silent; then
			retire="$LANE_RETIRE_DATE"
			if [[ "$mode" != seats && "$mode" != canon && "$mode" != discovery ]]; then
				status=retired detail="retired on $retire (ORCH_LANE_RETIRE)"
			fi
		fi
		retire="$LANE_RETIRE_DATE"
		if [[ "$selected" == true && "$mode" != cache && "$mode" != discovery ]]; then
			lane_canon "$account" || return 1; id="$LANE_CANON"
			if [[ "$mode" == readings || -z "$mode" ]]; then
				[[ "$LANE_CLAIMS_RC" != 0 ]] || { account_claims "$account" "$harness" '' silent || return 1; claims="$ACCOUNT_CLAIMS"; }
				if [[ -d "$ACCOUNT_WALL_DIR" && "$status" != retired ]]; then
					account_wall_file "$PROJECT_ROOT" "$account" || return 1
					wall_file="$ACCOUNT_WALL_FILE"
					[[ ! -e "$wall_file" ]] || wall="$(<"$wall_file")"
				fi
			fi
		fi
		batch_args+=("$account" "$harness" "$status" "$detail" "$seat" "$said" "$s_pct" "$w_pct" "$m_pct" "$mo_pct"
			"$m_label" "$s_reset" "$w_reset" "$m_reset" "$mo_reset" "$credit_fields" "$credit_limit" "$credit_spent"
			"$credit_remaining" "$credit_expires" "$alias" "$id" "$retire" "$claims" "$wall" "$wall_file" "$line" "$selected")
	done <<<"$rows"
	local decoded
	decoded="$(jq -nr --arg mode "$mode" --args "$LANE_MODEL_JQ$LANE_EMIT_JQ$ACCOUNT_WALL_JQ"'
		def nz: if . == "" then null else . end;
		$ARGS.positional as $a
		| [range(0; ($a | length); 28) as $i
		   | $a[$i:$i+28] as $v
		   | if $v[15] != "" and ((try ($v[16] | tonumber) catch 0) <= 0 or (try ($v[19] | fromdateiso8601) catch null) == null)
		     then {kind: "invalid", payload: $v[0]}
		     elif $v[27] != "true" or $mode == "canon" then empty
		     elif $mode == "cache" then
		       {kind: "text", payload: (if $v[2] == "retired" then "account=\($v[0])	harness=\($v[1])	status=retired" else $v[26] end)}
		     elif $mode == "seats" then
		       if $v[4] == "1" then {kind: "text", payload: $v[21]} else empty end
		     elif $mode == "discovery" then
		       if $v[15] != "" or ($v[3] | startswith("api-credit-")) then {kind: "text", payload: "true"} else empty end
		     else
		       (if $v[2] == "retired" then {} else
		         {session_5h_pct: ($v[6] | fromjson), weekly_pct: ($v[7] | fromjson),
		          model_pct: ($v[8] | fromjson), monthly_pct: ($v[9] | fromjson),
		          credits: (if $v[15] == "" then null else {unit: "usd", limit_dollars: ($v[16] | tonumber),
		             used_dollars: ($v[17] | if . == "" then null else tonumber end), remaining_dollars: ($v[18] | tonumber),
		             resets_at: $v[19], locked_reason: null} end),
		          model_label: ($v[10] | nz), model_buckets: (if $v[8] == "null" then []
		             else [{label: ($v[10] | nz), pct: ($v[8] | tonumber), resets_at: ($v[13] | nz)}] end),
		          resets: {session: ($v[11] | nz), weekly: ($v[12] | nz), model: ($v[13] | nz), monthly: ($v[14] | nz)}} end) as $b
		       | if $mode == "normalized" then
		           {kind: "account", payload: {harness: $v[1], config_dir: $v[0], status: $v[2], detail: $v[3], plan: "", through: "host",
		              buckets: $b, reset_buckets: $b, prior_buckets: {}, has_reading: ($v[5] != "")}}
		         elif $mode == "buckets" then {kind: "json", payload: ($b | tojson)}
		         else
		           (if $v[24] == "" then null else account_wall_read($v[24]) end) as $w
		           | (if $w == "unreadable" then {} elif $w != null then ($b | account_wall_apply($w; $v[21])) else $b end) as $b
		           | (if $w == "unreadable" then {kind: "wall-error", payload: $v[25]} else empty end),
		             {kind: "json", payload: (emit_lane_row($v[20]; $v[1]; $v[0]; $v[21];
		                (if $w == "unreadable" then "error" else $v[2] end);
		                (if $w == "unreadable" then "wall record unreadable" else $v[3] end);
		                ""; $v[22]; (if $v[1] == "pi" and $b.credits.unit == "usd" then 0 else $v[23] | fromjson end);
		                null; false; "host"; $b; {}; null; 1) | tojson)}
		         end
		     end] as $rows
		| if $mode == "normalized" then
		    ($rows[] | select(.kind == "invalid") | .kind, .payload),
		    "normalized", ({accounts: [$rows[] | select(.kind == "account") | .payload]} | tojson)
		  else $rows[] | .kind, .payload end' ${batch_args[@]+"${batch_args[@]}"})" || return 1
	while IFS= read -r kind && IFS= read -r payload; do
		case "$kind" in
			invalid) message host-account-invalid "$payload" credit-fields >&2 ;;
			wall-error) account_wall_unreadable "$payload" >&2 ;;
			json|text|normalized) printf '%s\n' "$payload" ;;
		esac
	done <<<"$decoded"
}

# The provider's `accounts` answer after row validation and the account policy,
# cached and time-bounded: a malformed row is dropped with one
# host-account-invalid notice on the cold read and none on a cached one. Its
# status is the one host_account_records passes on: 0 answered, 2 verb absent,
# 1 failed.
host_accounts_answer() { # HOST [RECORD] — rows or their cache record, status back
	local host="$1" rc=0 rows err cached record="" record_rc=0 busy_wait discovered cache_phase host_locked=false
	local -a bound=()
	# Read through the same cache every usage figure in this script uses, keyed on
	# the PROVIDER rather than on a harness and a config dir, since one answer
	# covers every account it names. Without it the fleet inventory forked a
	# provider call on every invocation, unbounded and never reused, and on a
	# provider that will never implement the verb it paid that fork to be told so
	# again. `--no-cache` refreshes it; the launcher's own read passes that flag,
	# because which accounts a host holds decides a gate rather than reporting a
	# figure. `pick` reads through the cache, since what it takes from the answer
	# is usage windows, read on the TTL every window has.
	for cache_phase in fast locked; do
	if [[ "$USE_CACHE" == "true" ]] && cached="$(read_usage_cache host-accounts "$host" "$(usage_serve_max_age)")"; then
		# ONE read of the record, status on its first line and the rows after it:
		# a listing the overseer runs every cycle pays for each process it starts,
		# and two reads of one string is one process more than the answer needs.
		# Emitted only for a record carrying BOTH fields in the shape this
		# function wrote them — read_usage_cache validates that the body is an
		# object and nothing more, and a record missing `rows` would otherwise
		# hand the parser the string `null` to read as a provider row. A record
		# that fails that test emits nothing, `read` fails, and the miss falls
		# through to the provider rather than reporting a status nobody parsed.
		# Record callers also need discovery: filtered rows in an older cache
		# cannot say whether account policy removed a provider API grant.
		rc=""
		{ IFS= read -r rc || rc=""; rows="$(cat)"; } < <(jq -r --arg mode "${2:-}" '
			if (.usage.status | type) == "number" and (.usage.rows | type) == "string"
			   and ($mode != "record" or .usage.status == 2 or (.usage.api_discovered | type) == "boolean")
			then "\(.usage.status)\n" + (if $mode == "record" then (.usage | tojson) else .usage.rows end)
			else empty end' <<<"$cached")
		case "$rc" in
			0) [[ "$host_locked" != true ]] || usage_lock_release; printf '%s\n' "$rows"; return 0 ;;
			2) [[ "$host_locked" != true ]] || usage_lock_release; return 2 ;;
		esac
		rc=0
	fi
	if [[ "$cache_phase" == fast ]]; then
		if [[ "$USAGE_CACHE_PRUNED" != true ]]; then prune_usage_cache; USAGE_CACHE_PRUNED=true; fi
		usage_lock_take
		host_locked=true
	fi
	done
	# The verb is OPTIONAL, so its absence is not news: exit 2 is the protocol's
	# "this provider does not implement the verb" (schemas/lane-host.md), and a
	# provider that answers it that way leaves this listing exactly the local
	# reading it has always been, with nothing on stderr. Its own bytes are
	# held back until the status says which case it is, because the shipped
	# reference provider answers an unknown verb with its parser's whole usage
	# message and a listing the overseer runs constantly must not carry that.
	# Any other non-zero status IS the verb failing, and then the provider's
	# bytes pass through the way the dispatcher hands them back, under the
	# keyed notice naming what this script did with the failure. A bound reached
	# is that same case, `timeout`'s own 124 naming it.
	#
	# A read that asked for NO CACHE asked to wait for this provider now, and a
	# bound is the only thing that ends that wait: the launcher's gate probe passes
	# --no-cache, so on a machine carrying neither timeout spelling an accounts
	# verb that hangs would hold a launch open with nothing on stderr. Refused
	# instead, as the verb failing, which every caller already reads as a host it
	# could not ask. A cached read keeps the unbounded call: its cost is one per
	# TTL window unless a consumed bucket reset requires an earlier refresh,
	# whether a listing or a pick makes it.
	#
	# lane-host waits ORCH_LANE_HOST_SHORT_BUSY_WAIT_SECS for an accounts slot before it
	# refuses as lane-host-busy, and a bound that ends first cuts that wait off
	# as the verb failing, with no busy line. So a bounded call waits for a slot
	# for less than its bound. A value lane-host would refuse is passed on as it
	# stands, for lane-host to name.
	busy_wait="${ORCH_LANE_HOST_SHORT_BUSY_WAIT_SECS:-30}"
	if [[ "$ACCOUNTS_TIMEOUT_S" -ne 0 && -n "$ACCOUNTS_TIMEOUT_CMD" ]]; then
		if [[ "$busy_wait" =~ ^(0|[1-9][0-9]*)$ && "$busy_wait" -ge "$ACCOUNTS_TIMEOUT_S" ]]; then
			busy_wait=$((ACCOUNTS_TIMEOUT_S - 1))
		fi
		bound=(env "ORCH_LANE_HOST_SHORT_BUSY_WAIT_SECS=$busy_wait" "$ACCOUNTS_TIMEOUT_CMD" "$ACCOUNTS_TIMEOUT_S")
	elif [[ "$ACCOUNTS_TIMEOUT_S" -ne 0 && "$USE_CACHE" != true ]]; then
		message host-accounts-unbounded "$host" "$ACCOUNTS_TIMEOUT_S" >&2
		usage_lock_release
		return 1
	fi
	err="$(mktemp)" || { message host-accounts-unreadable "$host" mktemp >&2; usage_lock_release; return 1; }
	# The handler ends in `exit 1`: without it the handler returns and execution
	# falls through to the `cat` below, which reads the file the handler has
	# just deleted and prints its own error where the keyed line belongs.
	trap 'usage_lock_release; rm -f -- "${err:?}"; exit 1' INT TERM
	rows="$(${bound[@]+"${bound[@]}"} "$SCRIPT_DIR/lane-host" accounts 2>"$err")" || rc=$?
	if [[ "$rc" -ne 0 ]]; then
		if [[ "$rc" -eq "$LANE_HOST_BUSY_EXIT" ]]; then
			cat -- "$err" >&2
			message lane-host-busy accounts - >&2
		elif [[ "$rc" -ne 2 ]]; then
			cat -- "$err" >&2
			message host-accounts-unreadable "$host" "$rc" >&2
		fi
		rm -f -- "$err"
		orch_arm_lock_signals
		# The absent verb is cached; a FAILED one is not. A provider that does not
		# implement it will answer the same way all window, while a failure is the
		# transient one of the two and must not be replayed for the rest of it.
		[[ "$rc" -ne 2 ]] || {
			write_usage_cache host-accounts "$host" '{"status":2,"rows":""}' || true
			usage_lock_release
			return 2
		}
		usage_lock_release
		return 1
	fi
	rm -f -- "$err"
	orch_arm_lock_signals
	# The same parser names valid API rows before policy removes candidates.
	# Its emitting cache pass below owns malformed-row notices.
	discovered="$(host_account_rows "$rows" pi discovery 2>/dev/null)" || { usage_lock_release; return 1; }
	rows="$(host_account_rows "$rows" all cache)" || { usage_lock_release; return 1; }
	record="$(jq -nc --arg r "$rows" --arg api "$discovered" '{status: 0, rows: $r, api_discovered: ($api != "")}')" || record_rc=$?
	# Row callers can still use an answer the cache record could not carry.
	# Record callers need discovery too and refuse that failure below. A failed
	# cache write costs the next run a call, never a wrong answer.
	[[ "$record_rc" -ne 0 ]] || write_usage_cache host-accounts "$host" "$record" || true
	usage_lock_release
	if [[ "${2:-}" == record ]]; then
		[[ "$record_rc" -eq 0 ]] || return 1
		rows="$record"
	fi
	printf '%s\n' "$rows"
}

# The recorded reading of the session one `lanes context` row names, the
# lane_context_collect fetch contract: the record on stdout and exit 0, exit 1
# where none is recorded, exit 2 with the cause on stdout where it could not be
# read. A row whose window a running fleet lane record names is that lane, read
# in its own mailbox, through its host where the record names one.
context_record_fetch() { # LANE CALLER
	local lane="$1" caller="$2" rec
	rec="$(jq -c --arg w "$lane" 'map(select(((.window // "") | sub("^.*:"; "")) == $w)) | first // empty' <<<"$CONTEXT_LANES")" \
		|| { printf 'the fleet lane records could not be searched for window %s\n' "$lane"; return 2; }
	if [[ -z "$rec" ]]; then
		# The caller's own row with no lane record is the overseer, whose context
		# is judged at its own turn end on the reading that turn end took and on
		# no stored one, so this report carries none for it.
		[[ -z "$caller" ]] || return 1
		printf 'no running fleet lane record names the window %s, so the mailbox its reading is recorded in is unknown\n' "$lane"
		return 2
	fi
	mailbox_file_fetch "$rec" "$LANE_CONTEXT_RECORD"
}

# CLAIMS with a row appended for every running Copilot fleet lane record
# LANES_JSON holds whose window no claim names. A Copilot launch takes no
# --lane, so no claim, yet its turn end judges a reading recorded in its
# mailbox like any lane's, so the sweep reads it from its record. Another
# harness's lane is read through its claim alone: its claim goes when its pane
# dies, its record can still read running, and a row from that record would
# bring back the dead lane's stale reading. The row names the
# record's account, or none, its window's name as the lane, no server, and
# the window's whole `SESSION:WINDOW` as the pane, a target tmux takes where
# it takes a pane id. Exit 1 where the records could not be read.
context_record_claims() { # CLAIMS LANES_JSON
	local rows
	rows="$(jq -r --arg claims "$1" '
		($claims | split("\n") | map(split("\t") | .[1] // empty)) as $named
		| .[] | select((.window // "") != "" and (.harness // "") == "copilot")
		| (.window | sub("^[^:]*:"; "")) as $w
		| select(any($named[]; . == $w) | not)
		| [(.account // ""), $w, "", .window] | join("\t")' <<<"$2")" || return 1
	[[ -z "$1" ]] || printf '%s\n' "$1"
	[[ -z "$rows" ]] || printf '%s\n' "$rows"
}

# The file NAME in the lane mailbox the fleet lane record REC names, under the
# same contract: its bytes on stdout and exit 0, exit 1 where it is not there
# or is empty, exit 2 with the cause on stdout where it could not be read.
mailbox_file_fetch() { # REC NAME
	local rec="$1" fields item host root path out rc=0 probe_rc=0
	fields="$(jq -r '[(.item // ""), (.host // ""), (.mail_root // "")] | join("\t")' <<<"$rec")" \
		|| { printf 'the fleet lane record %s could not be read\n' "$rec"; return 2; }
	item="${fields%%$'\t'*}"; fields="${fields#*$'\t'}"
	host="${fields%%$'\t'*}"; root="${fields#*$'\t'}"
	[[ -n "$item" && -n "$root" ]] || { printf 'the fleet lane record %s names no item or no mail_root\n' "$rec"; return 2; }
	path="$root/tmp/lane-mail/$item/$2"
	if [[ -z "$host" ]]; then
		[[ -e "$path" ]] || return 1
		out="$(cat -- "$path" 2>&1)" || { printf '%s\n' "$out"; return 2; }
		[[ -n "$out" ]] || return 1
		printf '%s\n' "$out"
		return 0
	fi
	# A hosted read that fails with 2 is a file the host does not hold, or a
	# host lane-host could not reach at all, which answers 2 as well; the probe
	# tells them apart, as lane-mail's own hosted read does.
	out="$(ORCH_LANE_HOST="$host" "$SCRIPT_DIR/lane-host" cat --item "$item" "$path" 2>/dev/null)" || rc=$?
	if [[ "$rc" -eq 0 ]]; then
		[[ -n "$out" ]] || return 1
		printf '%s\n' "$out"
		return 0
	fi
	ORCH_LANE_HOST="$host" "$SCRIPT_DIR/lane-host" touch --item "$item" >/dev/null 2>&1 || probe_rc=$?
	[[ "$probe_rc" -eq 0 ]] || { printf 'the host of %s did not answer\n' "$item"; return 2; }
	[[ "$rc" -ne 2 ]] || return 1
	printf 'the host of %s answered and the read of %s failed with exit %s\n' "$item" "$path" "$rc"
	return 2
}

# What a Pi lane emitted, for `state`: STATE_ROWS is the verdict
# lib/session-rows.sh § session_rows_lane_verdict reads off the rows its hook
# wrote in its mailbox, through its host where its record names one, and
# `unreadable` where they could not be read; it is empty for a window no
# running fleet lane record names as a Pi lane's, whose pane is judged. Exit 2
# where the fleet state is there and its records could not be read, since a Pi
# lane read as any other would be judged by its pane. It keeps the records in
# STATE_RECORDS.
STATE_ROWS="" STATE_RECORDS=""
state_rows_read() { # WINDOW
	local exists rec rows rc=0
	STATE_ROWS="" STATE_RECORDS=""
	exists="$("$SCRIPT_DIR/workflow-state" exists --json oversee 2>/dev/null | jq -r '.exists')" || return 2
	[[ "$exists" == true ]] || return 0
	STATE_RECORDS="$("$SCRIPT_DIR/workflow-state" get oversee '.lanes // []' 2>/dev/null)" || return 2
	rec="$(lane_running_record "$STATE_RECORDS" "$1" pi)" || return 2
	[[ -n "$rec" ]] || return 0
	STATE_ROWS=unreadable
	rows="$(mailbox_file_fetch "$rec" "$SESSION_ROWS_LANE")" || rc=$?
	case "$rc" in
		0) ;;
		1) rows="" ;;
		*) return 0 ;;
	esac
	session_rows_lane_verdict /dev/stdin <<<"$rows" || return 0
	STATE_ROWS="$SESSION_ROWS_VERDICT"
}

render_table() {
	jq -r "$LANE_HEADROOM_CELL_JQ"'
		def col($s; $n): ($s | tostring) as $t
		  | if ($t | length) >= $n then $t else $t + (" " * ($n - ($t | length))) end;
		def num($v): if $v == null then "-" else ($v | tostring) + "%" end;
		(["LANE","HARNESS","THROUGH","STATUS","PLAN","5H","WEEK","MODEL","MONTH","HEADROOM","CLAIMS","AGE","DETAIL"] | @tsv),
		(.[] | [ .alias, .harness, (.measured_through // "local"), .status, (.plan // "-"),
		         num(.session_5h_pct), num(.weekly_pct), num(.model_pct), num(.monthly_pct),
		         headroom_cell,
		         (if .claims == null then "?" else .claims end),
		         (if .usage_age_s == null then "-" else (.usage_age_s | tostring) + "s" end),
		         (.detail // "-")
		       ] | @tsv)
	' | lane_context_columns
}

# `pick` fails closed. Exit 3 when nothing qualifies, so a caller can tell
# "every lane is full" (actionable: wait, or raise the threshold) apart from
# "the helper broke" (exit 1).
#
# The threshold is judged on the PROJECTED wall, lib/lane-model.sh's
# judged_wall: the wall reading plus the expected burn of the lanes already
# live on the account. A reading lags the launches in flight by minutes, so an
# account with room now and ten lanes burning it walls in the middle of a
# shift; charging each claim its burn drops it before it is handed another.
#
# Among qualifying lanes, lib/lane-model.sh ranks projected room weighted by
# time to the binding reset. Claims reduce that room before it is scored.
# The threshold is never traded away for a claim count — a lane whose
# projection is at or above --max-pct is out before this ordering runs.
#
# The overseer needs plan room to watch and succeed. Seats are measured with
# every other account, but lane-model judges them against the reserve and
# ranks them last. The same judge marks running lanes at the reserve, so
# admission stopping does not leave those lanes spending the overseer's room.
# --for-overseer exempts the overseer's own launch and mark.
#
# A walled projection can reopen as live lanes end. `seats=` names reserve
# refusals, which reopen when projected room rises above the reserve.
#
# With --model the threshold reads the bucket that walls THAT model
# (lib/lane-model.sh) instead of the binding bucket: an account whose weekly
# window has room can still have none left for the model the launch will pass,
# and picking it puts a usage banner on the new session's first turn. A lane
# whose windows answer nothing for the model is dropped, the way an unmeasured
# lane is — "we could not measure it" must not read as "it is free".
#
# Which of the two it was is REPORTED, not folded away. The three states are
# lib/lane-model.sh's `wall_verdict`, shared with `pick --lane`, and this form
# partitions its lanes on it: the refusal names the model and the count of each
# state, and every candidate unmeasured gets the named form's own wording. A
# generic "nothing is below the limit" beside a table showing those lanes as ok
# with headroom sends an operator to wait for a reset nobody measured.
# `pick --lane DIR` judges ONE named account instead of choosing among the
# fleet. A launcher that was GIVEN a lane still has the model question to ask,
# and it asks it here: the same wall, the same null rule and the same threshold
# cmd_pick applies, so the answer cannot drift from the chooser's. A launcher
# that judged it for itself would also be judging --max-pct for itself, in a
# shell, without this parser's check on the value.
#
# Only that directory is measured. The chooser's sweep refreshes every account's
# usage, which is a whole fleet of network calls to answer about one.
#
# Exit 0 room, 3 walled, 5 nothing measured this lane for this launch, 4 the
# directory is no configured lane of this harness, 6 the claim store could not
# be read under --projected, 7 the cloud session account has no repository entry,
# 8 the overseer seats could not be read under --projected, 1 the judge
# itself failed: a measurement, a wall, a verdict, or a
# --max-pct this parser refused. Each refusal has its own status because a
# launcher dispatches on the status and would otherwise name the wrong
# dependency to an operator.
# Without --projected, unread seats print pick-overseer-seats-unread and the
# wall reading alone decides, with no seat reserve.
#
# 4 is not a refusal a launcher inherits: a directory outside the discovery
# glob, or outside ORCH_LANE_DIRS where that is set, and not reported with a
# reading by the provider, has no record here and never had one, so a launch onto it is judged by whatever gate the launcher
# had before this question existed.
#
# A lane whose usage could not be fetched has status other than ok and answers
# 5, not 3: it is a window nobody read, and the caller names the read rather
# than telling an operator their allowance is gone.
#
# The plain form prints the env prefix on 0 and nothing on stdout otherwise;
# every refusal puts its keyed line on stderr. Under --json the lane's record
# is printed on 0, 3 and 5, and on 3 it carries `wall`. On this form the wall IS
# the answer rather than the chooser's working field, so a caller reports the
# percentage it refused on without measuring a second time. The record on 5
# carries the `status` that says WHY nothing measured, which a caller needs to
# tell a window naming no model from a credential this machine cannot renew:
# only the second has a remedy, and only that one leaves an account whose
# copy on another host may still be live.
# The provider rows both pick forms judge HARNESS on, host_lane_rows' readings,
# in HOSTED_ROWS and HOSTED_READ. For a Pi pick these are the provider's
# harness=pi rows for the selected model's pool. Copilot rows can use the
# stated override; API grants use only the provider's reading.
pick_host_rows() { # HARNESS [MODEL]
	host_lane_rows "$1" readings "${2:-}" || return 1
	if [[ "$1" == pi ]]; then
		local pool
		pool="$(lane_pick_pool "$1" "${2:-}")" || return 1
		# A failed command returned no reading to repair. Both pick forms
		# preserve its busy or timeout diagnostic and fail as a command.
		[[ "$pool" != api-credit || "$HOSTED_READ" != failed ]] || return 1
		HOSTED_ROWS="$(jq -c --arg pool "$pool" \
			'def api_credit: .credits != null or ((.detail // "") | startswith("api-credit-"));
			 map(select(if $pool == "api-credit" then api_credit else (api_credit | not) end))' <<<"$HOSTED_ROWS")" || return 1
	fi
}

# The fix= line for each unmeasured pool record in RECORDS, a JSON array: a
# provider row that stands names its own status and detail, and any other the
# accounts read HOSTED_READ names.
copilot_pool_records_fix() { # RECORDS
	local harness through dir status detail
	while IFS=$'\x1f' read -r harness through dir status detail; do
		if [[ "$harness" == copilot ]]; then
			lane_copilot_pool_fix "${ORCH_LANE_HOST:-local}" cli "$dir" "$status" "$detail"
		elif [[ "$through" == host ]]; then
			lane_copilot_pool_fix "$ORCH_LANE_HOST" row "$dir" "$status" "$detail"
		else
			lane_copilot_pool_fix "${ORCH_LANE_HOST:-local}" "$HOSTED_READ" "$dir"
		fi || return 1
	done < <(jq -r '.[] | [.harness, .measured_through, .config_dir, .status, .detail // ""] | join("\u001f")' <<<"$1")
}

cmd_pick_lane() {
	local dir="$1" harness="$2" max_pct="$3" model="$4" as_json="$5" binding_floor="$6" burn="$7" projected_verdict="$8" credit_floor="$9" for_overseer="${10}"
	local target found="" d record="" wall bucket verdict hosted projected credits refusal cause retry seat_harness=""
	local pick_pool
	pick_pool="$(lane_pick_pool "$harness" "$model")" || return 1
	# A malformed override refuses this form as it refuses the chooser, before a
	# provider row could stand in for an entry nobody can parse.
	if [[ "$harness" == pi && "$pick_pool" != api-credit ]]; then copilot_pool_entries >/dev/null || return 1; fi
	# The same claim load `list` does, for the same reason: the record this form
	# hands back carries `claims` and the projection beside it, which the
	# verdict judges under --projected. Without the
	# store read it would carry 0 for an account with sessions in flight — the
	# one value emit_lane says that field must never invent. emit_lane leaves it
	# null when the store could not be read.
	load_lane_claims "$dir" || return 1
	# Under --projected, a REFUSAL, exit 6, before anything is measured: the
	# verdict charges the claims, and an unread store judged as none is the
	# launch the chooser dies rather than make. Otherwise a NOTICE: the verdict
	# is the wall reading, which no claim count enters, and the record's claims
	# and projection are null. Same policy as the claim write in open-terminal,
	# which is never fatal: a read that worked is not a failure because its
	# bookkeeping did not.
	if [[ "$LANE_CLAIMS_RC" -ne 0 ]]; then
		if [[ "$projected_verdict" == true ]]; then
			message pick-lane-claims-refused "$dir" >&2
			return 6
		fi
		message pick-lane-claims >&2
	fi
	SEATS=""
	if [[ "$for_overseer" != true && "$harness" != copilot && "$harness" != pi ]]; then
		if [[ "$projected_verdict" == true ]]; then
			seat_harness="$harness"
		else
			pick_host_rows "$harness" || return 1
		fi
		if ! overseer_seats "$seat_harness"; then
			[[ "$NORMALIZED_FAILED" != true ]] || return 1
			if [[ "$projected_verdict" == true ]]; then
				message pick-overseer-seats "$SEATS_STEP" "$SEATS_STATE" >&2
				return 8
			fi
			message pick-overseer-seats-unread "$SEATS_STEP" "$SEATS_STATE" >&2
			SEATS=""
		fi
	else
		pick_host_rows "$harness" "$model" || return 1
	fi
	lane_canon "$dir" || return 1; target="$LANE_CANON"
	# Both sides through the one normaliser, so a dir given with a trailing
	# slash or through a symlink reaches the record discovered for it.
	if [[ "$pick_pool" != api-credit ]]; then
	lane_dirs "$harness" '' silent || return 1
	for d in ${LANE_DIRS_FOUND[@]+"${LANE_DIRS_FOUND[@]}"}; do
		[[ -n "$d" ]] || continue
		lane_canon "$d" || return 1
		[[ "$LANE_CANON" == "$target" ]] || continue
		found="$d"
		break
	done
	fi
	# The chooser's rule for one account, host_row_or_local, with its
	# `lanes: pick-local-reading` line. A dir the provider holds and discovery
	# does not reach is judged on the provider's row alone, which is then no
	# longer a lane with no record.
	hosted="$HOSTED_ROWS"
	record=""
	[[ "$hosted" == '[]' ]] || record="$(jq -c --arg t "$target" 'map(select(._id == $t)) | first // empty' <<<"$hosted")" || { message pick-lane-failed "$dir" host >&2; return 1; }
	if [[ -n "$record" && -z "$found" ]]; then
		found="$(jq -r '.config_dir' <<<"$record")" || { message pick-lane-failed "$dir" host >&2; return 1; }
	elif [[ -n "$record" && "$pick_pool" != api-credit ]]; then
		record="$(host_row_or_local "$harness" "$found" "$record" "$model")" || { message pick-lane-failed "$dir" local-reading >&2; return 1; }
	fi
	# Every directory is a Pi account the Copilot pool reading can be asked
	# about: one the setting states nothing for is unmeasured, never unlisted,
	# which a launcher reads as nothing to judge and launches.
	[[ -n "$found" || "$harness" != pi ]] || found="$dir"
	if [[ -z "$found" ]]; then
		message pick-lane-unlisted "$dir" "$harness" >&2
		return 4
	fi
	if [[ -z "$record" && "$pick_pool" == api-credit ]]; then
		record="$(emit_lane "$found" "$harness" "$found" no_usage_data "no provider API-credit row" "" '{}')" || return 1
	else
		[[ -n "$record" ]] || record="$(measure_lane "$harness" "$found")" || { message pick-lane-failed "$dir" measure >&2; return 1; }
	fi
	# The classifier is lib/lane-model.sh's, shared with the fleet chooser: one
	# definition of room, walled and unmeasured, so this form cannot answer a
	# question the chooser answers differently. The reading by default, which
	# is what a caller asking whether the account is out of room now reads: a
	# lane's own claim is among the ones charged, so a projection would send
	# every lane on a busy account to hand off with room left. --projected is
	# the launch question, the chooser's own wall.
	lane_tier_inputs "[$record]" "$harness" "$model" || return 1
	record="$(lane_judge "$record" "$model" "$binding_floor" "$burn" "$max_pct" "$projected_verdict" "$credit_floor" "$SEATS" "$SEAT_RESERVE")" || { message pick-lane-failed "$dir" wall >&2; return 1; }
	local judged cache_path="" cache_at="" at
	usage_cache_file "$harness" "$found" silent
	# The record is served while its own sample time is within the serve age,
	# read_usage_cache's rule. The row's age was observed before this judge, so
	# a clock read here can be a second past it.
	if [[ -f "$USAGE_CACHE_FILE" ]] && at="$(jq -r '.usage_fetched_at // .fetched_at' "$USAGE_CACHE_FILE" 2>/dev/null)" \
		&& [[ "$at" =~ ^[0-9]+$ ]]; then
		cache_path="$USAGE_CACHE_FILE" cache_at="$at"
	fi
	usage_serve_max_age silent
	judged="$(jq -r --arg cache "$cache_path" --argjson at "${cache_at:-null}" --argjson max "$USAGE_SERVE_MAX_AGE" "$LANE_MODEL_JQ"'
	  .usage_cache = (if $cache != "" and .measured_through == "local"
	    and (.headroom_pct | type) == "number" and (.usage_age_s | type) == "number" then
	      {path: $cache, served_until: ([$at + $max,
	        (.resets[], .model_buckets[]?.resets_at | reset_epoch | select(. != null))] | min)}
	    else null end)
	  | .verdict, (if .verdict != "seat-reserve" then del(.verdict) else . end | lane_public | tojson)' <<<"$record")" || { message pick-lane-failed "$dir" verdict >&2; return 1; }
	{ IFS= read -r verdict; IFS= read -r record; } <<<"$judged"
	if [[ "$verdict" == walled || "$verdict" == unmeasured ]]; then
		refusal="$(jq -r 'if .refusal == null then empty else [.refusal.cause, (.refusal.retry_at // "none")] | @tsv end' <<<"$record")" || return 1
		if [[ -n "$refusal" ]]; then
			IFS=$'\t' read -r cause retry <<<"$refusal"
			message cloud-credit-refused "$dir" "$cause" "$retry" >&2
			[[ "$as_json" != true ]] || printf '%s\n' "$record"
			[[ "$verdict" != walled ]] || return 3
			return 5
		fi
	fi
	case "$verdict" in
		cloud-repo-unset)
			message cloud-repo-unset "$found" "${TIER_REPO:-none}" >&2
			return 7
			;;
		room)
			if [[ "$as_json" == "true" ]]; then printf '%s\n' "$record"; return 0; fi
			# The mapping is lib/lane-launch.sh's, shared with the launchers
			# that render this prefix into a command; the harness here is the
			# one lane_pick_harness named for the launch.
			lane_env_prefix "$harness" "$found" "$model"
			return
			;;
		seat-reserve)
			projected="$(jq -r --argjson p "$projected_verdict" 'if $p then .projected_headroom_pct else 100 - .wall end' <<<"$record")" || return 1
			message pick-seat-omitted "$dir" "$projected" "$SEAT_RESERVE" >&2
			[[ "$as_json" != true ]] || printf '%s\n' "$record"
			return 3
			;;
		walled)
			# Under --projected the window whose projected room decided, which
			# is the session window where the lanes on the account spend it
			# first; the reading's binding bucket otherwise.
			wall="$(jq -er --argjson p "$projected_verdict" 'if $p and .projected_window != null then .projected_window.pct else .wall end' <<<"$record")" || {
				message pick-lane-failed "$dir" wall >&2
				return 1
			}
			bucket="$(jq -er --argjson p "$projected_verdict" 'if $p and .projected_window != null then .projected_window.bucket else .binding_bucket end' <<<"$record")" || {
				message pick-lane-failed "$dir" bucket >&2
				return 1
			}
			# `none` where the claims were unknown and the wall alone walled it.
			projected="$(jq -r '.projected_headroom_pct // "none"' <<<"$record")" || {
				message pick-lane-failed "$dir" projection >&2
				return 1
			}
			# A Codex credit reading names its balance, `none` if unparsed.
			credits="$(jq -r 'if .harness == "codex" and .credits != null then (.credits.balance // "none") else "" end' <<<"$record")" || {
				message pick-lane-failed "$dir" credits >&2
				return 1
			}
			message pick-lane-walled "$dir" "$wall" "$bucket" "$max_pct" "$projected" "$credits" "$credit_floor" >&2
			# Under --json only, as on exit 0: the plain form speaks env prefixes
			# and keyed lines, and its refusal detail is the wall= and bucket=
			# fields above, the projected window under --projected.
			[[ "$as_json" != "true" ]] || printf '%s\n' "$record"
			return 3
			;;
		unmeasured)
			# A Pi root nothing measured: a failed accounts read is one a retry
			# can answer, and any other read is named on a fix= line.
			if [[ "$harness" == pi && "$HOSTED_READ" == failed ]]; then
				message copilot-pool-unread "$ORCH_LANE_HOST" "${model:-none}" >&2
				return 1
			fi
			message pick-lane-unmeasured "$dir" "${model:-none}" >&2
			[[ "$harness" != pi && "$harness" != copilot ]] || copilot_pool_records_fix "[$record]" >&2 || return 1
			# Under --json only, as on 0 and 3. The record's `status` is the
			# whole of what a launcher needs here: `expired` names a credential
			# this machine could not renew, which is an owner's login to fix
			# rather than a window to wait out.
			[[ "$as_json" != "true" ]] || printf '%s\n' "$record"
			return 5
			;;
		*)
			# jq answered something this case does not know, which is the judge
			# broken rather than a lane refused.
			message pick-lane-failed "$dir" "verdict:$verdict" >&2
			return 1
			;;
	esac
}

# The overseer seats, one canonical config dir a line: provider seat=1 rows and `.overseer.account` of
# this checkout's fleet state, and of every fleet state a live claim in the
# store names. Claims carry the state file of the fleet that launched them, so
# where OVERSEE_WATCH_STATE_DIR puts several fleets on one store, each peer
# fleet running a lane is found through it; a peer running none has no lane on
# any account to spread, and its seat is not found. A named fleet state that is
# gone is a fleet that ended and holds no seat. One that is there and cannot be
# read fails the call, which the chooser refuses on: a seat nobody could read
# is not a seat nobody holds. Reads LANE_CLAIMS_LIVE in load_lane_claims'
# `fleet` form, whose fifth field is that state file.
#
# A seat stays while its fleet state records it, whether or not that overseer
# still runs: no liveness judgement of a recorded overseer exists as a callable
# owner (`oversee launch` inlines its own), so a stopped fleet's seat stays
# protected until an overseer launch or register rewrites the record.
#
# The seats land in SEATS; a failure leaves SEATS_STEP and SEATS_STATE naming
# the step and the state it could not read, for the caller's refusal.
# A projected named pick passes its harness so fleet-state failures precede
# provider usage reads. Other callers already loaded the provider's rows.
SEATS="" SEATS_STEP="" SEATS_STATE=""
overseer_seats() { # [HARNESS]
	local fleets claimed f account provider_seats
	SEATS="" SEATS_STATE=oversee
	SEATS_STEP=fleet-state
	fleets="$("$SCRIPT_DIR/workflow-state" exists --json oversee | jq -r 'if .exists then .path else empty end')" || return 1
	SEATS_STEP=claims
	claimed="$(awk -F'\t' '$5 != "" { print $5 }' <<<"$LANE_CLAIMS_LIVE")" || return 1
	SEATS_STEP=seat
	while IFS= read -r f; do
		[[ -n "$f" && -e "$f" ]] || continue
		SEATS_STATE="$f"
		account="$(jq -r '.overseer.account // empty' <"$f")" || return 1
		[[ -n "$account" ]] || continue
		lane_canon "$account" || return 1
		SEATS+="$LANE_CANON"$'\n'
	done < <(printf '%s\n%s\n' "$fleets" "$claimed" | sort -u)
	if [[ -n "${1:-}" ]]; then pick_host_rows "$1" || return 1; fi
	# host_lane_rows already read host_accounts_answer; failures leave no rows.
	provider_seats="$(host_account_rows "$HOST_ACCOUNTS_ROWS" all seats)" || return 1
	SEATS+="${provider_seats:+$provider_seats$'\n'}"
}

cmd_pick() {
	local harness="$1" max_pct="$2" as_json="$3" model="$4" binding_floor="$5" exclude="$6" for_overseer="$7" burn="$8" credit_floor="$9"
	local lanes hosted judged chosen walled unmeasured resets omitted="" seats=0 seat room refusals refusal_lines cause retry
	local pick_pool
	pick_pool="$(lane_pick_pool "$harness" "$model")" || return 1
	# A Pi account on the Copilot pool is a Pi root the provider reports a
	# harness=pi row for or the override names. The override is refused here
	# when nobody can parse it, before anything is read; its Copilot CLI
	# entries are no Pi root, so pool_roots holds only its Pi roots.
	local pool_roots=""
	if [[ "$harness" == pi && "$pick_pool" != api-credit ]]; then
		copilot_pool_entries >/dev/null || return 1
		pool_roots="$(lane_dirs pi all)"
	fi
	load_lane_claims || return 1
	# An unreadable claim store reads as "no launches in flight", which is the
	# one thing it must not read as: picking on it can stack a second session
	# onto an account already running one.
	[[ "$LANE_CLAIMS_RC" -eq 0 ]] || die pick-claims "$@"
	# After the claim load: emit_lane counts claims on every host row it writes.
	pick_host_rows "$harness" "$model" || return 1
	SEATS=""
	if [[ "$for_overseer" != true && "$harness" != copilot && "$harness" != pi ]]; then
		overseer_seats || die pick-overseer-seats "$SEATS_STEP" "$SEATS_STATE"
	fi
	hosted="$HOSTED_ROWS"
	if [[ "$pick_pool" == api-credit && "$hosted" == "[]" && "$HOSTED_API_DISCOVERED" != true ]]; then
		message pick-provider-unmeasured "$harness" "${model:-none}" >&2
		return 5
	fi
	# With neither a provider row nor an override entry nothing measures this
	# Pi launch: exit 1 where the accounts read failed, which a retry can
	# answer, and otherwise exit 5, a read to repair and never a window to wait
	# out. Entries that exclusion removed are a pick with no candidate, answered
	# as one below.
	if [[ "$harness" == pi && "$pick_pool" != api-credit && -z "$pool_roots" && "$HOSTED_READ" == failed ]]; then
		message copilot-pool-unread "$ORCH_LANE_HOST" "${model:-none}" >&2
		return 1
	elif [[ "$harness" == pi && "$pick_pool" != api-credit && -z "$pool_roots" && "$hosted" == "[]" ]]; then
		{ message copilot-pool-unstated "${model:-none}" "$HOSTED_READ"; lane_copilot_pool_fix "${ORCH_LANE_HOST:-local}" "$HOSTED_READ"; } >&2
		return 5
	fi
	lanes="$(collect_lanes "$harness" "$exclude" "$hosted" "$model")" || return 1
	lane_tier_inputs "$lanes" "$harness" "$model" || return 1
	judged="$(lane_select "$model" "$binding_floor" "$burn" "$max_pct" "$credit_floor" "$TIER_POOL" "$CLOUD_CREDIT_FLOOR" "$TIER_RETIRE" "$TIER_CLOUD_REPO" "$SEATS" "$SEAT_RESERVE" <<<"$lanes")" || return 1
	while read -r dir; do message cloud-credit-unread "$dir" >&2; done < <(jq -r '.cloud_credit_unread[]' <<<"$judged")
	chosen="$(jq -c '.chosen' <<<"$judged" 2>/dev/null || true)"
	if [[ -z "$chosen" || "$chosen" == "null" ]]; then
		refusals="$(jq -c '.refusals' <<<"$judged")" || return 1
		refusal_lines="$(jq -r '.[] | [.config_dir, .refusal.cause, (.refusal.retry_at // "none")] | @tsv' <<<"$refusals")" || return 1
		while IFS=$'\t' read -r dir cause retry; do
			[[ -z "$dir" ]] || message cloud-credit-refused "$dir" "$cause" "$retry" >&2
		done <<<"$refusal_lines"
		walled="$(jq -r '.walled // 0' <<<"$judged" 2>/dev/null || true)"
		unmeasured="$(jq -r '.unmeasured // 0' <<<"$judged" 2>/dev/null || true)"
		omitted="$(jq -r '.seats[] | [.config_dir, (.projected_headroom_pct // "none")] | @tsv' <<<"$judged")" || return 1
		seats="$(jq -r '.seats | length' <<<"$judged")" || return 1
		# A Pi pick where no candidate carries a pool reading and none is walled
		# is the unstated refusal, each unread provider row named on its fix=
		# line: a pool nobody read is never one to wait out.
		if [[ "$harness" == pi && "$pick_pool" != api-credit && "${walled:-0}" -eq 0 && "${unmeasured:-0}" -gt 0 ]]; then
			{
				message copilot-pool-unstated "${model:-none}" row
				copilot_pool_records_fix "$(jq -c '.unread' <<<"$judged")"
			} >&2
			return 5
		fi
		{
			# Walled and unmeasured are different news for an operator: one
			# allowance is spent, the other was never read, and
			# the table underneath shows an unmeasured lane as ok with headroom.
			# Every candidate unmeasured gets the named form's own wording.
			if [[ "${walled:-0}" -eq 0 && "${unmeasured:-0}" -gt 0 && "$seats" -eq 0 ]]; then
				message no-candidate-unmeasured "$harness" "${model:-none}" "$unmeasured"
			else
				message no-candidate "$harness" "$max_pct" "${model:-none}" "${walled:-0}" "${unmeasured:-0}" "$seats"
			fi
			while IFS=$'\t' read -r seat room; do
				[[ -z "$seat" ]] || message pick-seat-omitted "$seat" "$room" "$SEAT_RESERVE"
			done <<<"$omitted"
			while IFS= read -r dir; do
				[[ -z "$dir" ]] || message cloud-repo-unset "$dir" "${TIER_REPO:-none}"
			done < <(jq -r '.cloud_repo_unset[]' <<<"$judged")
			render_table <<<"$lanes"
		} >&2
		# The counts on STDOUT under --json, as the named form prints its
		# record there on the same exit: a caller walking several picks reports
		# what each sweep found, and the keyed line above is a message for a
		# person. `{"walled":N,"unmeasured":N,"seats":N,"qualifying_count":0,
		# "walled_resets_at":T,"refusals":[{config_dir:D,refusal:R}]}` is the object, T the judgement's own
		# earliest walled reset or null; nothing else is printed on this path, so a
		# caller reading `.walled` gets the count or a jq error, never a lane
		# record it would mistake for a pick. `seats` is the judgement's reserve refusal count.
		#
		# The first two are proven digits before jq is handed them: the reads above
		# swallow a failure into an empty string, and --argjson on one is jq
		# refusing its own arguments, which would abort this refusal instead of
		# returning it.
		[[ "${walled:-}" =~ ^[0-9]+$ ]] || walled=0
		[[ "${unmeasured:-}" =~ ^[0-9]+$ ]] || unmeasured=0
		resets="$(jq -c '.walled_resets_at' <<<"$judged")" || return 1
		[[ "$as_json" != "true" ]] || jq -nc --argjson w "$walled" --argjson u "$unmeasured" --argjson s "$seats" \
			--argjson r "$resets" --argjson refusals "$refusals" \
			'{walled: $w, unmeasured: $u, seats: $s, qualifying_count: 0, walled_resets_at: $r, refusals: $refusals}'
		if [[ "$pick_pool" == api-credit && "$walled" -eq 0 && "$unmeasured" -gt 0 ]]; then
			message pick-provider-unmeasured "$harness" "${model:-none}" >&2
			return 5
		fi
		return 3
	fi
	if [[ "$as_json" == "true" ]]; then
		jq -c --argjson n "$(jq -r '.qualifying' <<<"$judged")" '. + {qualifying_count: $n}' <<<"$chosen"
		return 0
	fi
	lane_env_prefix "$harness" "$(jq -r '.config_dir' <<<"$chosen")" "$model"
}

# ── CLI ──────────────────────────────────────────────────────────────────────

need_val() { [[ $# -ge 2 && -n "${2:-}" ]] || die missing-value "$@"; }

# pct_valid VALUE — the one shape-and-range test every percentage in this
# script is held to: a whole number, 0-100. A threshold above 100 passes every
# real percentage, so a fully spent wall at 100 would read as room and the
# launch would open on the usage banner both pick forms exist to prevent. The
# caller supplies its own refusal key, so one bound serves the flag, its
# setting and the handoff mark without a second spelling of the test.
pct_valid() { [[ "$1" =~ ^[0-9]{1,3}$ ]] && (( 10#$1 <= 100 )); }

# The one parser. It answers every form that produces no lane work — the
# command index, a help request, a bad option — so the dry run below decides
# those before any configuration is read, off these arms and no second copy.
parse_argv() {
	# Every default this parser owns is set HERE, never above the loader: the
	# settings [env] table assigns any name and .env.local is sourced as shell, so
	# a default above the load is whatever the checkout left there for every
	# option the caller did not pass. Settings reach the script through their own
	# ORCH_* names, resolved after the load.
	HARNESS=""
	# The bound as percent USED, which is the unit lib/lane-model.sh compares a
	# wall against. --min-headroom-pct 10 is the same bound in the record's own
	# unit and is converted to this one before any lane is judged. Assigned
	# below from ORCH_LANE_MAX_PCT or from the flag, whichever the caller gave:
	# the setting is read HERE, in the parser the loader has already run for,
	# so a launcher that forwards nothing still gets the configured threshold
	# and no second copy of the default exists to drift from this one.
	MAX_PCT=""
	PCT_OPTION=""
	PCT_VALUE=""
	AS_JSON=false
	USE_CACHE=true
	# The caller's own pass interval, which widens the age a cached figure is
	# served within. Read here for the reason MAX_PCT is: the loader has run
	# for this parse, so the setting and the flag meet in one place and no
	# second copy of the default exists to drift from this one.
	USAGE_MAX_AGE=""
	LANE_ARG=""
	EXCLUDE_LANE=""
	MODEL=""
	BINDING_FLOOR=false
	FOR_OVERSEER=false
	PROJECTED=false
	LOCAL_ONLY=false
	CACHE_ONLY=false

	SUB="${1:-}"
	# A bare invocation names the commands and does nothing else, so it is one
	# of those forms rather than a lane failure.
	[[ -n "$SUB" ]] || { print_lanes_index; exit 0; }
	case "$SUB" in
		help|--help|-h) print_lanes_usage; exit 0 ;;
	esac
	shift

	while [[ $# -gt 0 ]]; do
		case "$1" in
			--harness) need_val "$@"; HARNESS="$2"; shift 2 ;;
			--harness=*) HARNESS="${1#--harness=}"; need_val --harness "$HARNESS"; shift ;;
			--max-pct) need_val "$@"; PCT_OPTION=--max-pct; PCT_VALUE="$2"; shift 2 ;;
			--max-pct=*) PCT_OPTION=--max-pct; PCT_VALUE="${1#--max-pct=}"; need_val --max-pct "$PCT_VALUE"; shift ;;
			--min-headroom-pct) need_val "$@"; PCT_OPTION=--min-headroom-pct; PCT_VALUE="$2"; shift 2 ;;
			--min-headroom-pct=*) PCT_OPTION=--min-headroom-pct; PCT_VALUE="${1#--min-headroom-pct=}"; need_val --min-headroom-pct "$PCT_VALUE"; shift ;;
			--model) need_val "$@"; MODEL="$2"; shift 2 ;;
			--model=*) MODEL="${1#--model=}"; need_val --model "$MODEL"; shift ;;
			--binding-floor) BINDING_FLOOR=true; shift ;;
			--for-overseer) FOR_OVERSEER=true; shift ;;
			--projected) PROJECTED=true; shift ;;
			--local) LOCAL_ONLY=true; shift ;;
			--cache-only) [[ "$SUB" == list ]] || die unknown-option "$@"; CACHE_ONLY=true; LOCAL_ONLY=true; shift ;;
			--lane) need_val "$@"; LANE_ARG="$2"; shift 2 ;;
			--lane=*) LANE_ARG="${1#--lane=}"; need_val --lane "$LANE_ARG"; shift ;;
			--exclude-lane) need_val "$@"; EXCLUDE_LANE="$2"; shift 2 ;;
			--exclude-lane=*) EXCLUDE_LANE="${1#--exclude-lane=}"; need_val --exclude-lane "$EXCLUDE_LANE"; shift ;;
			--state-dir) [[ "$SUB" == facts ]] || die unknown-option "$@"; need_val "$@"; FACTS_STATE_DIR="$2"; shift 2 ;;
			--state-dir=*) [[ "$SUB" == facts ]] || die unknown-option "$@"; FACTS_STATE_DIR="${1#--state-dir=}"; need_val --state-dir "$FACTS_STATE_DIR"; shift ;;
			--json) AS_JSON=true; shift ;;
			--no-cache) USE_CACHE=false; shift ;;
			--max-age) need_val "$@"; USAGE_MAX_AGE="$2"; shift 2 ;;
			--max-age=*) USAGE_MAX_AGE="${1#--max-age=}"; need_val --max-age "$USAGE_MAX_AGE"; shift ;;
			--help|-h) print_lanes_usage; exit 0 ;;
			*)
				# `check` takes one config dir and `state` one item; anything
				# else is an option typo.
				[[ ( "$SUB" == check || "$SUB" == state || "$SUB" == facts ) && -z "$LANE_ARG" && "$1" != -* ]] || die unknown-option "$@"
				LANE_ARG="$1"
				shift
				;;
		esac
	done

	# Two spellings, ONE bound: --min-headroom-pct is converted into --max-pct
	# here and nowhere else, so lib/lane-model.sh's wall_verdict stays the only
	# place a lane is judged against it. The refusal names the spelling that was
	# actually passed.
	if [[ -n "$PCT_OPTION" ]]; then
		pct_valid "$PCT_VALUE" || die invalid-percent "$PCT_OPTION"
		if [[ "$PCT_OPTION" == --max-pct ]]; then
			MAX_PCT=$((10#$PCT_VALUE))
		else
			MAX_PCT=$((100 - 10#$PCT_VALUE))
		fi
	else
		# Held to the same bound as the flag and refused on the same terms: a
		# threshold nobody can read must not fall back to a number of this
		# script's own, which is the silent disagreement between launcher and
		# pick that reading the setting here exists to end.
		MAX_PCT="${ORCH_LANE_MAX_PCT:-95}"
		pct_valid "$MAX_PCT" || die invalid-lane-max-pct "$MAX_PCT"
		MAX_PCT=$((10#$MAX_PCT))
	fi
	SEAT_RESERVE="${ORCH_OVERSEER_SEAT_RESERVE_PCT:-50}"
	pct_valid "$SEAT_RESERVE" || die invalid-overseer-seat-reserve "$SEAT_RESERVE"
	SEAT_RESERVE=$((10#$SEAT_RESERVE))
	# The expected burn of one live lane where its account measured no rate,
	# read here for the reason MAX_PCT is and refused on the same terms: a
	# figure nobody can read must not become one of this script's own.
	BURN_PCT="${ORCH_LANE_BURN_PCT_PER_HOUR:-5}"
	pct_valid "$BURN_PCT" || die invalid-lane-burn "$BURN_PCT"
	BURN_PCT=$((10#$BURN_PCT))
	# Read and refused on the terms MAX_PCT is.
	CREDIT_FLOOR="${ORCH_LANE_CODEX_CREDIT_FLOOR:-5000}"
	[[ "$CREDIT_FLOOR" =~ ^[0-9]+$ ]] || die invalid-lane-codex-credit-floor "$CREDIT_FLOOR"
	CREDIT_FLOOR=$((10#$CREDIT_FLOOR))
	# Read and refused on the terms the Codex floor is. The default is
	# provisional: the acceptance run's spend for one lane sets it.
	CLOUD_CREDIT_FLOOR="${ORCH_LANE_CLOUD_CREDIT_FLOOR:-10}"
	[[ "$CLOUD_CREDIT_FLOOR" =~ ^[0-9]+$ ]] || die invalid-lane-cloud-credit-floor "$CLOUD_CREDIT_FLOOR"
	CLOUD_CREDIT_FLOOR=$((10#$CLOUD_CREDIT_FLOOR))

	# Refused rather than dropped: an interval nobody can read would silently
	# leave this caller on the TTL alone, which is the fetch-every-pass burst
	# the option exists to close. Normalized where the digits are proven, so no
	# later comparison re-infers a base from a leading zero.
	[[ -n "$USAGE_MAX_AGE" ]] || USAGE_MAX_AGE="${ORCH_LANES_USAGE_MAX_AGE:-0}"
	[[ "$USAGE_MAX_AGE" =~ ^[0-9]+$ ]] || die invalid-usage-max-age "$USAGE_MAX_AGE"
	USAGE_MAX_AGE=$((10#$USAGE_MAX_AGE))
}

# `.env.local` is sourced as shell, so anything answering without doing lane
# work answers before the loader runs: the dry run is the real parser in a
# subshell, so nothing it assigns survives to be clobbered, and 9 is the only
# status meaning it reached the end.
parse_rc=0
( parse_argv "$@"; exit 9 ) || parse_rc=$?
[[ "$parse_rc" -eq 9 ]] || exit "$parse_rc"
unset parse_rc

# Probed only once argv is settled: help, the command index and a bad option are
# answers this script owes with nothing else installed.
need_jq

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export PROJECT_ROOT
