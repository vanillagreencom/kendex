source "$SCRIPT_DIR/lib/lane-capabilities.sh"
# The caller's own launch record and SessionStart row, for `context`.
# shellcheck source=lib/overseer-launch.sh
source "$SCRIPT_DIR/lib/overseer-launch.sh"
# The lib carries the strict mode its other callers run under. This one is
# deliberately errexit-free — one unreadable lane must not fail the whole
# inventory — so restore that posture at the seam.
set +e

CLAUDE_USAGE_URL="${ORCH_LANES_CLAUDE_USAGE_URL:-https://api.anthropic.com/api/oauth/usage}"
CLAUDE_TOKEN_URL="${ORCH_LANES_CLAUDE_TOKEN_URL:-https://platform.claude.com/v1/oauth/token}"
CLAUDE_OAUTH_BETA="oauth-2025-04-20"
CODEX_USAGE_URL="${ORCH_LANES_CODEX_USAGE_URL:-https://chatgpt.com/backend-api/wham/usage}"

# ~5h, with tolerance — Codex reports window durations that vary by account.
SESSION_WINDOW_S=18000

# At least the longest watch interval on the host: `oversee-watch --interval`
# defaults to 240, and a TTL under that guarantees every pass finds the figure
# expired and fetches, which is the burst this cache exists to bound.
USAGE_TTL="${ORCH_LANES_USAGE_TTL:-300}"
# How long a reader waits for the host-wide refresh lock. The holder refreshes
# one account, a request curl bounds at 10 seconds, so a wait that long
# outlasts an ordinary refresh. It stays under the 20-second ceiling
# lane-mail-check puts on `pick --lane`, so a timed-out wait still leaves that
# caller time for its own request. A timeout costs one duplicate request for
# one account, under its keyed notice.
USAGE_LOCK_WAIT_S=10
# What a COLD lane waits before the retry after a 429. The recorded window can
# be minutes, and a listing is a caller waiting at a terminal.
USAGE_RETRY_WAIT_MAX_S=5
# Whether this run has spent its one cold-lane retry. One per run, not per
# lane: lanes are measured one after another, so a retry per cold lane would
# cost a host-wide limit that wait and one extra request for every cold lane.
# With it, a run spends at most USAGE_RETRY_WAIT_MAX_S and one request on
# retries. collect_lanes measures every lane in one pipeline stage, in
# sequence, so a later lane there reads what an earlier one set.
USAGE_RETRY_SPENT=false
# How long a refused endpoint is left alone when its answer named no
# Retry-After: long enough that a fleet measuring every thirty seconds stops
# feeding the limit it hit, short enough that a lane comes back inside one
# operator's attention. An answer that DOES name a Retry-After is waited out for
# exactly that, since the endpoint is the one that knows.
USAGE_REFUSAL_WINDOW_S=300
# Built at most once per measuring shell, by the first lane that needs renewing.
CLAUDE_TOKEN_UA=""
# Seconds the provider's `accounts` verb may take. It can cross a network, and
# this listing runs on every overseer cycle, so an unbounded call makes the fleet
# inventory wait on one host. The default is 30 seconds for the provider's
# account and API-credit listings. 0 asks for no bound.
ACCOUNTS_TIMEOUT_S="${ORCH_LANE_HOST_ACCOUNTS_TIMEOUT_S:-30}"
# `timeout`, or the coreutils spelling a Homebrew install carries, empty where
# neither is installed. Feature-detected: without it the call is unbounded, and
# the cache below holds the cost to one call per age window, plus reset refreshes.
ACCOUNTS_TIMEOUT_CMD=""
for _accounts_timeout in timeout gtimeout; do
	if command -v "$_accounts_timeout" >/dev/null 2>&1; then
		ACCOUNTS_TIMEOUT_CMD="$_accounts_timeout"
		break
	fi
done
unset _accounts_timeout
# Beside the claim store, resolved by its owner, so both follow one setting.
CLAIMS_DIR="$(lane_claims_dir "$PROJECT_ROOT")"
USAGE_CACHE_DIR="${CLAIMS_DIR%/*}/usage"
ACCOUNT_WALL_DIR="${CLAIMS_DIR%/*}/walls"
# One clock for every host a fleet spans: a retirement date is a UTC date. A
# clock that cannot be read refuses the run, since an empty date would read as
# "no retirement has come" and hand a retired lane back out.
TODAY="$(date -u +%Y-%m-%d)" || die time-failed
# Start elapsed seconds at the sampled epoch. Subtracting two independently
# rounded SECONDS readings can otherwise stamp a refusal ahead of the clock.
# The epoch read includes its own delay; reset elapsed time after it returns.
RUN_NOW="$(date +%s)" || die time-failed
SECONDS=0
RUN_STARTED_SECONDS=$SECONDS
[[ "$RUN_NOW" =~ ^[0-9]+$ && "$TODAY" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || die time-failed
# Observation time is current; stored sample and prior times stay historical.
lane_now() { LANE_NOW=$((RUN_NOW + SECONDS - RUN_STARTED_SECONDS)); }

# The policy a provider record is stamped with and judged under: the UTC day
# a retirement date is measured against and every LANE_POLICY_SETTINGS entry,
# as `<name>=<value>` lines. A provider record holds the rows that policy
# left, so any other makes it a miss: a lifted exclusion restores a row the
# record omits, a tightened one or a moved alias removes one it holds, and a
# retirement date that arrives reduces one it kept whole. The same stamp
# names the policy `.pruned` was last scanned under. Passed to every jq that
# writes or judges a provider record.
USAGE_POLICY="today=$TODAY"
for _policy_setting in "${LANE_POLICY_SETTINGS[@]}"; do
	USAGE_POLICY+=$'\n'"$_policy_setting=${!_policy_setting:-}"
done
unset _policy_setting
USAGE_POLICY_ARGS=(--arg policy "$USAGE_POLICY")

# A normalized record contains readings only. Claims, walls, age and the
# caller's model are supplied again when this batch is rendered.
NORMALIZED_DIRS=() NORMALIZED_HARNESSES=() NORMALIZED_ROWS=() NORMALIZED_THROUGHS=() NORMALIZED_READINGS=()
NORMALIZED_HOST_READY=false NORMALIZED_HOST_USAGE="" NORMALIZED_HOST_STATUS=0 NORMALIZED_HOST_API=false
NORMALIZED_AT=-1 NORMALIZED_TARGET="" NORMALIZED_FAILED=false
# Reuse a complete batch within one epoch. A later consumer rechecks expiry.
load_normalized() { # [NAMED_DIR]
	lane_now
	local now="$LANE_NOW" target="${1:-}" rc
	[[ "$NORMALIZED_AT" != "$now" || "$NORMALIZED_TARGET" != "$target" ]] || return 0
	decode_normalized "$target" || { rc=$?; NORMALIZED_FAILED=true; message account-read-failed normalized "$rc" >&2; return 1; }
	NORMALIZED_AT="$now" NORMALIZED_TARGET="$target"
}
decode_normalized() { # [NAMED_DIR]
	local h d file creds target="${1:-}" at row kind id alias retire wall json err
	local files=() fields=() rows=() index=0 decoded decode_rc
	local host_ready=false host_usage="" host_status=0 host_api=false
	NORMALIZED_DIRS=() NORMALIZED_HARNESSES=() NORMALIZED_ROWS=() NORMALIZED_THROUGHS=() NORMALIZED_READINGS=()
	NORMALIZED_HOST_READY=false NORMALIZED_HOST_USAGE=""
	[[ "$USE_CACHE" == true && "$CACHE_ONLY" != true && "$USAGE_TTL" != 0 ]] || return 0
	if [[ -n "$target" ]]; then lane_canon "$target" || return 1; target="$LANE_CANON"; fi
	for h in claude codex copilot; do
		lane_dirs "$h" all silent || return 1
		for d in ${LANE_DIRS_FOUND[@]+"${LANE_DIRS_FOUND[@]}"}; do
			lane_canon "$d" || return 1
			[[ -z "$target" || "$target" == "$LANE_CANON" ]] || continue
			lane_admissible "$d" || continue
			usage_cache_file "$h" "$d" silent
			file="$USAGE_CACHE_FILE"
			case "$h" in claude) creds="$d/.credentials.json" ;; codex) creds="$d/auth.json" ;; copilot) creds="$d/config.json" ;; esac
			[[ -f "$file" && -f "$creds" && ! "$creds" -nt "$file" ]] || continue
			files+=("$file")
		done
	done
	if [[ "${ORCH_LANE_HOST:-local}" != local ]]; then
		usage_cache_file host-accounts "$ORCH_LANE_HOST" silent
		[[ ! -f "$USAGE_CACHE_FILE" ]] || files+=("$USAGE_CACHE_FILE")
	fi
	if (( ${#files[@]} == 0 )); then
		prune_usage_cache; USAGE_CACHE_PRUNED=true
		return 0
	fi
	usage_serve_max_age silent
	# The files this batch names are atomically replaced by the cache writer.
	# Older files have no normalized member and use the existing cold reader.
	# The claims read can wait across an expiry, so this batch uses elapsed time.
	decoded="$(jq -sr --arg policy "$USAGE_POLICY" --arg host "${ORCH_LANE_HOST:-local}" \
		--argjson now "$now" --argjson max "$USAGE_SERVE_MAX_AGE" "$LANE_MODEL_JQ$USAGE_POLICY_JQ$USAGE_RESET_JQ"'
		.[] | . as $cache
		| select((.normalized | usage_policy_current($policy)) and .normalized.host == $host)
		| (.usage_fetched_at // .fetched_at) as $at
		| select(.normalized.fetched_at == $at and .normalized.prior_at == (.prior.fetched_at // null))
		| select(.harness != "host-accounts" or ((.usage.status | type) == "number" and (.usage.rows | type) == "string"
		         and (.usage.status == 2 or (.usage.api_discovered | type) == "boolean")))
		| select(($at | type) == "number" and $now >= $at)
		| select(.normalized.refusal == null or .normalized.refusal == .refusal)
		| select(if .usage == null then .refusal.expires_at > $now else $now - $at < $max end)
		| (if .harness == "host-accounts" then
		     select([.normalized.accounts[]?.reset_buckets | usage_consumed_reset($now)] | length == 0)
		   else . end)
		| (if .harness == "host-accounts" then (.usage.status | tostring), (.usage.api_discovered == true), "host-cache", (.usage | tojson) else empty end),
		  ((.normalized.accounts // [.normalized.account])[] | select(type == "object")
		| select((.expires_ms // 0) <= 0 or .expires_ms > $now * 1000)
		| select((.refresh_expires_ms // 0) <= 0 or .refresh_expires_ms > $now * 1000)
		| select([.reset_buckets | usage_consumed_reset($now)] | length == 0)
		| . + {age: (if .through == "host" then null else $now - $at end),
		        prior_buckets: (.prior_buckets // {}),
		        elapsed: (if .through != "host" and ($cache.prior.fetched_at | type) == "number" then $at - $cache.prior.fetched_at else null end),
		        sample_claims: (if .through == "host" then 1 else $cache.sample_claims // 1 end)}
		| .config_dir, .harness, .through, tojson)' "${files[@]}" 2>/dev/null)" || {
		decode_rc=$?
		# Missing or malformed cache files use the cold reader. A failed decoder does not.
		[[ "$decode_rc" == 2 || "$decode_rc" == 4 ]] && return 0
		return "$decode_rc"
	}
	while IFS= read -r d && IFS= read -r h && IFS= read -r kind && IFS= read -r json; do
		if [[ "$kind" == host-cache ]]; then
			host_ready=true host_usage="$json" host_status="$d" host_api="$h"
			continue
		fi
		[[ -n "$d" ]] || continue
		lane_canon "$d" || return 1; id="$LANE_CANON"
		[[ -z "$target" || "$target" == "$id" ]] || continue
		lane_alias_for "$d" silent; alias="$LANE_ALIAS"
		lane_retire_date "$d" silent; retire="$LANE_RETIRE_DATE"
		ACCOUNT_CLAIMS=null
		[[ "$LANE_CLAIMS_RC" != 0 ]] || account_claims "$d" "$h" '' silent || return 1
		wall=""
		if [[ -d "$ACCOUNT_WALL_DIR" ]]; then
			account_wall_file "$PROJECT_ROOT" "$d" || return 1
			[[ ! -e "$ACCOUNT_WALL_FILE" ]] || wall="$(<"$ACCOUNT_WALL_FILE")"
		fi
		fields+=("$json" "$id" "$alias" "$retire" "${ACCOUNT_CLAIMS:-null}" "$wall" "${ACCOUNT_WALL_FILE:-}")
	done <<<"$decoded"
	if (( ${#fields[@]} )); then
		decoded="$(jq -nr --args "$LANE_MODEL_JQ$LANE_EMIT_JQ$ACCOUNT_WALL_JQ"'
		$ARGS.positional as $args | range(0; $args | length; 7) as $i
		| ($args[$i] | fromjson) as $r
		| (if $args[$i+5] == "" then null else account_wall_read($args[$i+5]) end) as $w
		| (if $w == "unreadable" then {}
		   elif $w != null then ($r.buckets | account_wall_apply($w; $args[$i+1]))
		   else $r.buckets end) as $b
		| emit_lane_row($args[$i+2]; $r.harness; $r.config_dir; $args[$i+1];
		    (if $w == "unreadable" then "error" else $r.status end);
		    (if $w == "unreadable" then "wall record unreadable" else $r.detail end);
		    $r.plan; $args[$i+3];
		    (if $r.harness == "pi" and $b.credits.unit == "usd" then 0 else $args[$i+4] | fromjson end);
		    $r.age; false; $r.through; $b; $r.prior_buckets; $r.elapsed; $r.sample_claims)
		| $r.config_dir, $r.harness, $r.through, ($r.has_reading != false), tojson,
		  (if $w == "unreadable" then $args[$i+6] else "" end)' "${fields[@]}")" || return $?
		# Command substitution removes a final empty diagnostic line.
		while IFS= read -r d && IFS= read -r h && IFS= read -r kind && IFS= read -r at && IFS= read -r row && { IFS= read -r err || err=""; }; do
			[[ -z "$err" ]] || account_wall_unreadable "$err" >&2
			NORMALIZED_DIRS+=("$d"); NORMALIZED_HARNESSES+=("$h"); NORMALIZED_ROWS+=("$row")
			NORMALIZED_THROUGHS+=("$kind"); NORMALIZED_READINGS+=("$at")
		done <<<"$decoded"
	fi
	NORMALIZED_HOST_READY="$host_ready" NORMALIZED_HOST_USAGE="$host_usage"
	NORMALIZED_HOST_STATUS="$host_status" NORMALIZED_HOST_API="$host_api"
	if (( ${#NORMALIZED_ROWS[@]} )) || [[ "$NORMALIZED_HOST_READY" == true ]]; then
		prune_usage_cache warm
	else
		prune_usage_cache; USAGE_CACHE_PRUNED=true
	fi
}

# A lane key is a directory name or an alias. A `/` or `~` makes it a path,
# which names no lane, so an exclusion written that way would protect nothing.
lane_key_valid() {
	[[ -n "$1" && "$1" != */* && "$1" != *'~'* ]]
}

# Whether $1 is a YYYY-MM-DD naming a real calendar day. Arithmetic, not
# date(1): GNU and BSD date parse differently, and this runs on both.
calendar_date_valid() {
	[[ "$1" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || return 1
	local y=$((10#${1:0:4})) m=$((10#${1:5:2})) d=$((10#${1:8:2})) days=31
	case "$m" in
		4|6|9|11) days=30 ;;
		2) days=28; (( y % 4 == 0 && (y % 100 != 0 || y % 400 == 0) )) && days=29 ;;
	esac
	(( m >= 1 && m <= 12 && d >= 1 && d <= days ))
}

# Refused before any lane is enumerated: an exclusion or retirement that names
# no lane would leave the account it meant to cover readable and pickable, and
# a TTL that cannot be read has no window to apply.
validate_lane_settings() {
	local setting item key value
	LANE_EXCLUDES=() LANE_RETIRE_KEYS=() LANE_RETIRE_VALUES=()
	LANE_ALIAS_KEYS=() LANE_ALIAS_VALUES=() LANE_CLOUD_KEYS=() LANE_CLOUD_VALUES=()
	for setting in ORCH_LANE_EXCLUDE ORCH_LANE_RETIRE ORCH_LANE_ALIASES ORCH_LANE_CLOUD_REPOS; do
		setting_items "${!setting:-}" silent
		for item in ${SETTING_ITEMS[@]+"${SETTING_ITEMS[@]}"}; do
			trim "${item%%=*}" silent; key="$TRIMMED"
			trim "${item#*=}" silent; value="$TRIMMED"
			case "$setting" in
				ORCH_LANE_EXCLUDE)
					lane_key_valid "$item" || die invalid-exclude "$item"
					LANE_EXCLUDES+=("$item") ;;
				ORCH_LANE_RETIRE)
					[[ "$item" == *=* ]] && lane_key_valid "$key" && calendar_date_valid "$value" || die invalid-retire "$item"
					LANE_RETIRE_KEYS+=("$key"); LANE_RETIRE_VALUES+=("$value") ;;
				ORCH_LANE_ALIASES)
					[[ "$item" == *=* && -n "$key" && -n "$value" ]] || continue
					LANE_ALIAS_KEYS+=("$key"); LANE_ALIAS_VALUES+=("$value") ;;
				ORCH_LANE_CLOUD_REPOS)
					[[ "$item" == *=* ]] && lane_key_valid "$key" && [[ "$value" =~ ^[A-Za-z0-9-]+/[A-Za-z0-9._-]+$ ]] || die invalid-cloud-repos "$item"
					LANE_CLOUD_KEYS+=("$key"); LANE_CLOUD_VALUES+=("$value") ;;
			esac
		done
	done
	[[ "$USAGE_TTL" =~ ^[0-9]+$ ]] || die invalid-usage-ttl "$USAGE_TTL"
	# Refused here rather than handed to `timeout`, which would exit 125 and be
	# reported as the provider failing the verb.
	[[ "$ACCOUNTS_TIMEOUT_S" =~ ^[0-9]+$ ]] || die invalid-accounts-timeout "$ACCOUNTS_TIMEOUT_S"
	# Normalized once, where the digits are proven, so no later arithmetic can
	# re-infer a base: `[[ 08 -ne 0 ]]` reads the leading zero as octal, errors,
	# and the bound below is neither applied nor refused.
	ACCOUNTS_TIMEOUT_S=$((10#$ACCOUNTS_TIMEOUT_S))
	USAGE_TTL=$((10#$USAGE_TTL))
	[[ "$SUB" != check ]] || prune_usage_cache
}

facts_result() { # STATUS REASON
	jq -cn --arg item "$LANE_ARG" --arg status "$1" --arg reason "$2" '
		{item: $item, status: $status, reason: $reason, stage: null,
		 review_rounds: null, fix_receipts: null, validation_runs: null,
		 restacks: null, repeated_class_rounds: null, post_pr_stop: null}'
}

cmd_facts() (
	local fleet records record host root scratch state result rc=0
	[[ -n "$LANE_ARG" ]] || die missing-value facts
	[[ -n "${FACTS_STATE_DIR:-}" ]] || die missing-value --state-dir
	if ! fleet="$("$SCRIPT_DIR/workflow-state" --state-dir "$FACTS_STATE_DIR" get oversee)"; then
		facts_result failed fleet-unread; exit 2
	fi
	if ! records="$(jq -ce --arg item "$LANE_ARG" '
		if type == "object" and (.lanes | type) == "array"
		then [.lanes[] | select(.item == $item)] else error("invalid fleet state") end
	' <<<"$fleet")"; then
		facts_result failed fleet-unread; exit 2
	fi
	case "$(jq 'length' <<<"$records")" in
		0) facts_result failed record-missing; exit 2 ;;
		1) ;;
		*) facts_result failed record-ambiguous; exit 2 ;;
	esac
	record="$(jq -c '.[0]' <<<"$records")" || exit 2
	if ! jq -e '(.host == null or (.host | type) == "string") and
		(.mail_root == null or (.mail_root | type) == "string")' <<<"$record" >/dev/null; then
		facts_result failed record-invalid; exit 2
	fi
	host="$(jq -r '.host // ""' <<<"$record")" || exit 2
	root="$(jq -r '.mail_root // ""' <<<"$record")" || exit 2
	scratch="$(mktemp -d)" || { facts_result failed scratch-unavailable; exit 2; }
	trap 'rm -rf -- "${scratch:?}"' EXIT
	# shellcheck source=lib/lane-gitfile.sh
	source "$SCRIPT_DIR/lib/lane-gitfile.sh" || exit 2
	lane_item_state "$SCRIPT_DIR/workflow-state" "$SCRIPT_DIR/lane-host" "${ORCH_STATE_DIR:-tmp}" \
		"$LANE_ARG" "$host" "$root" "$scratch" "" "$LANE_ARG" true || rc=$?
	if [[ "$rc" -ne 0 ]]; then
		[[ ! -s "$scratch/state.err" ]] || cat "$scratch/state.err" >&2
		facts_result failed "${LANE_ITEM_STATE_REASON:-state-unread}"; exit 2
	fi
	if [[ -z "$LANE_ITEM_STATE" ]]; then
		facts_result absent "${LANE_ITEM_STATE_REASON:-state-absent}"; exit 1
	fi
	state="$(jq -cse 'if length == 1 and (.[0] | type) == "object"
		then .[0] else error("invalid item state") end' <<<"$LANE_ITEM_STATE")" || {
		facts_result failed state-invalid; exit 2
	}
	lane_state_rounds "$state" "$scratch/state.err" || {
		cat "$scratch/state.err" >&2
		facts_result failed state-invalid; exit 2
	}
	result="$(jq -c --arg item "$LANE_ARG" \
		--argjson review "$LANE_REVIEW_ROUNDS" --arg fix "$LANE_FIX_RECEIPTS" \
		--argjson validation "$LANE_VALIDATION_RUNS" --argjson restacks "$LANE_RESTACKS" \
		--arg repeated "$LANE_REPEATED_CLASS_ROUNDS" '
		{item: $item, status: "read", reason: null, stage: (.stages[-1].kind // null),
		 review_rounds: $review, fix_receipts: ($fix | fromjson? // $fix),
		 validation_runs: $validation, restacks: $restacks,
		 repeated_class_rounds: ($repeated | fromjson? // $repeated),
		 post_pr_stop: (if .post_pr_stop == null then null else .post_pr_stop | {gate, name} end)}
	' <<<"$state")" || { facts_result failed state-invalid; exit 2; }
	printf '%s\n' "$result"
)

parse_argv "$@"

case "$SUB" in
	facts) cmd_facts; exit $? ;;
	list)
		HARNESS="${HARNESS:-all}"
		[[ "$HARNESS" =~ ^(claude|codex|copilot|all)$ ]] || die invalid-harness "$@"
		validate_lane_settings
		load_lane_claims || exit 1
		# Every row says which credential measured it, local rows included: a
		# listing that labelled only the hosted ones would leave the reader to
		# infer the rest, and the whole point of the merge is that one account
		# can carry two readings that disagree. emit_lane writes that field, so
		# neither this listing nor the reader below stamps rows afterwards.
		out="$(collect_lanes "$HARNESS")" || exit 1
		# Asked only where a provider is configured. A fleet with no provider
		# reads the local config dirs and nothing else, exactly as before.
		if [[ "$LOCAL_ONLY" != true && "${ORCH_LANE_HOST:-local}" != local ]]; then
			host_lane_rows "$HARNESS" || exit 1
			out="$(jq -c --argjson hosted "$HOSTED_ROWS" '. + $hosted' <<<"$out")"
		fi
		# The verdict is the reading's: `walled` tells oversee-watch the wall is
		# reached and lifts at binding_resets_at, which a projection does not
		# say. The projection rides beside it for a reader weighing the claims.
		lane_now; now="$LANE_NOW"
		out="$(jq -c --argjson max "$MAX_PCT" --argjson burn "$BURN_PCT" --argjson credit_floor "$CREDIT_FLOOR" --argjson now "$now" "$LANE_MODEL_JQ"'
			map(with_lane_projection($burn; $now) | with_lane_verdict(.wall; $max; $credit_floor) | lane_public)' <<<"$out")"
		if [[ "$AS_JSON" == "true" ]]; then printf '%s\n' "$out"; else render_table <<<"$out"; fi
		;;
	host-accounts)
		HARNESS="${HARNESS:-all}"
		[[ "$HARNESS" =~ ^(claude|codex|copilot|pi|all)$ ]] || die invalid-harness "$@"
		validate_lane_settings
		# `local` names no provider, so there is no host copy to report. Refused
		# rather than answered as 2: the dispatcher's own refusal of a provider
		# verb under `local` is that same 2, and a caller reading it as "the
		# optional verb is absent" would take a misconfigured host for a
		# provider that simply does not implement it.
		[[ "${ORCH_LANE_HOST:-local}" != local ]] || die host-accounts-local
		# emit_lane reads the claim store for every record it writes, host rows
		# included, so the store is loaded before any row is emitted.
		load_lane_claims || exit 1
		accounts_rc=0
		rows="$(host_account_records "${ORCH_LANE_HOST}" "$HARNESS")" || accounts_rc=$?
		# The provider's answer, absent verb and failed verb are passed straight
		# through as this command's own status: the caller asking whether a host
		# holds an account must be able to tell "it says it holds none" from
		# "there is no answer to be had".
		[[ "$accounts_rc" -eq 0 ]] || exit "$accounts_rc"
		render_rc=0
		out="$(jq -cs "$LANE_MODEL_JQ"' map(lane_public)' <<<"$rows")" || render_rc=$?
		if [[ "$render_rc" -eq 0 && "$AS_JSON" != "true" ]]; then
			out="$(jq -r '.[] | [.config_dir, .harness] | @tsv' <<<"$out")" || render_rc=$?
		fi
		# Never a partial answer: a render that failed prints no rows at all,
		# because a caller matching an account against a truncated list reads a
		# held account as one the host does not hold.
		[[ "$render_rc" -eq 0 ]] || die host-accounts-render-failed "$ORCH_LANE_HOST" "$render_rc"
		printf '%s\n' "$out"
		;;
	pick)
		HARNESS="${HARNESS:-claude}"
		# A class becomes its model before any window is matched to it.
		model_rc=0
		ol_model_class "$HARNESS" "$MODEL" || model_rc=$?
		case "$model_rc" in
			0) ;;
			2) ol_deprecated "$HARNESS:$MODEL" ;;
			*) die model-class-unread "$HARNESS" "$MODEL" ;;
		esac
		MODEL="$OL_CLASS_MODEL"
		# The accounts this launch spends, which both forms judge it on: a Pi
		# launch on a Claude seat is a claude pick in every respect.
		PICK_HARNESS="$(lane_pick_harness "$HARNESS" "$MODEL")"
		[[ -n "$PICK_HARNESS" ]] || die invalid-pick-harness "$@"
		validate_lane_settings
		if [[ "$PICK_HARNESS" == unmeasured ]]; then
			message pick-provider-unmeasured "$HARNESS" "${MODEL:-none}" >&2
			exit 5
		fi
		if [[ -n "$LANE_ARG" ]]; then
			[[ -z "$EXCLUDE_LANE" ]] || die unknown-option --exclude-lane
			cmd_pick_lane "$LANE_ARG" "$PICK_HARNESS" "$MAX_PCT" "$MODEL" "$AS_JSON" "$BINDING_FLOOR" "$BURN_PCT" "$PROJECTED" "$CREDIT_FLOOR" "$FOR_OVERSEER"
		else
			[[ "$PROJECTED" != true ]] || die unknown-option --projected
			cmd_pick "$PICK_HARNESS" "$MAX_PCT" "$AS_JSON" "$MODEL" "$BINDING_FLOOR" "$EXCLUDE_LANE" "$FOR_OVERSEER" "$BURN_PCT" "$CREDIT_FLOOR"
		fi
		;;
	check)
		[[ -n "$LANE_ARG" ]] || die missing-value check
		validate_lane_settings
		# Local discovery gives the same first alias match as list, without
		# measuring accounts. Policy on another account sharing that alias must
		# not refuse the selected directory; list drops excluded accounts first.
		check_dir="$LANE_ARG"
		if [[ "$LANE_ARG" != */* ]]; then
			check_dir=""
			for check_harness in claude codex copilot; do
				while IFS= read -r candidate; do
					[[ -n "$candidate" ]] || continue
					lane_alias_for "$candidate" silent
					[[ "$LANE_ALIAS" == "$LANE_ARG" ]] || continue
					check_dir="$candidate"
					break
				done < <(lane_dirs "$check_harness")
				[[ -z "$check_dir" ]] || break
			done
		fi
		# With no resolved account, retain the raw-name refusal so an excluded
		# alias cannot fall back to a same-named directory in open-terminal.
		check_names="${check_dir:-$LANE_ARG}"
		if [[ -z "$check_dir" && "$LANE_ARG" != */* ]]; then
			while IFS=$'\t' read -r alias_name alias_val; do
				[[ "$alias_val" != "$LANE_ARG" ]] || check_names+=$'\n'"$alias_name"
			done < <(alias_pairs)
		fi
		while IFS= read -r check_name; do
			if lane_excluded "$check_name"; then message lane-excluded "$LANE_ARG" >&2; exit 4; fi
			if lane_retired "$check_name" silent; then message lane-retired "$LANE_ARG" "$LANE_RETIRE_DATE" >&2; exit 4; fi
		done <<<"$check_names"
		[[ -z "$check_dir" ]] || printf '%s\n' "$check_dir"
		;;
	state)
		[[ -n "$LANE_ARG" ]] || die missing-value state
		# No /proc read: this script's vantage point is the tmux server, the
		# same one oversee-watch reads, so the two cannot disagree. A caller
		# that also holds the lane's worktree — `open-terminal --wake` — passes
		# the harness process as the sixth argument instead.
		# A Pi lane is judged from the rows its own hook wrote, never its pane;
		# the pane is read only for a window no running Pi record names.
		state_rows_read "$LANE_ARG" || die state-fleet "$LANE_ARG"
		state_record="$(lane_running_record "${STATE_RECORDS:-[]}" "$LANE_ARG" "" session)" || die state-fleet "$LANE_ARG"
		state_host="$(jq -r '.host // "local"' <<<"${state_record:-null}")"
		[[ -n "$state_record" ]] || state_host="${ORCH_LANE_HOST:-local}"
		state_item="$(jq -r '.item // empty' <<<"${state_record:-null}")"
		state_probe_item="$state_item"
		[[ -n "$state_record" ]] || state_probe_item="${LANE_ARG#*:}"
		state_harness="$(jq -r '.harness // empty' <<<"${state_record:-null}")"
		state_mode=local state_source="" state_status=pane
		if [[ "$state_host" != local ]]; then
			lane_pane_mode state_mode "$state_host" || state_mode=unreadable
			lane_capability state_status status
		fi
		[[ "$state_status" == verb ]] || state_item=""
		if [[ -z "$state_item" && "$state_mode" != local ]]; then
			LANE_PANE_ID="" LANE_PANE_CMD="" LANE_PANE_PID="" LANE_PANE_SCREEN="" LANE_PANE_COUNT=0
			state_source=unreadable
		else
			lane_pane_observe "$LANE_ARG" "$state_host" "$state_item"
			state_source="$LANE_PANE_SOURCE"
		fi
		# No pane on this server carries the name: nothing here sees the lane's
		# harness, so its rows answer nothing either and the judge says unjudged.
		[[ -n "$LANE_PANE_ID" || "$state_mode" == verb && -n "$state_item" ]] || STATE_ROWS=""
		[[ -z "$LANE_PANE_ID" ]] || { rec="$(lane_running_record "$STATE_RECORDS" "$LANE_ARG" copilot)" &&
			lane_now; lane_context_copilot_note "$rec" "$LANE_NOW"; } || die state-fleet "$LANE_ARG"
		[[ -z "$COPILOT_SESSION_NOTE" ]] || message copilot-note "$LANE_ARG" "$COPILOT_SESSION_NOTE" >&2
		lane_state_rc=0
		ORCH_LANE_HOST="$state_host" lane_state LANE_STATE_ANSWER listed "$LANE_PANE_CMD" "$LANE_PANE_PID" "$LANE_PANE_SCREEN" "" "" "$STATE_ROWS" "$state_item" "$state_harness" "$state_source" \
			|| lane_state_rc=$?
		[[ "$lane_state_rc" -ne 2 ]] || die lane-scan-failed "$LANE_ARG"
		if [[ "$LANE_STATE_ANSWER" == rate-limit-switch ]]; then
			printf 'fix=item=%s state=rate-limit-switch; dismiss the Codex model-switch reminder and keep the current model; close the lane if its work is finished\n' "$LANE_ARG" >&2
		fi
		# A hosted lane's harness is on another machine, so `unjudged` here is
		# "no pane on this server carries the name", never "the lane is dead".
		# The provider is asked whether the host itself answers, and its answer
		# is reported BESIDE the state, never AS the state: `touch` keeps a host
		# alive and carries no "no such lane" reply (schemas/lane-host.md), so
		# every non-zero exit is a probe that failed — a rebooting host, the
		# dispatcher's own refusal, a transient ssh error — and calling that
		# `gone` would send the overseer down the window-gone path in
		# references/oversee-events.md, which relaunches an item whose first
		# session is still running on the remote host. lane-mail's failed read
		# says `host-unreachable` for this same probe and asserts no lane state
		# either.
		if [[ "$LANE_STATE_ANSWER" == unjudged && "$state_host" != local && -z "$LANE_PANE_SCREEN" ]]; then
			probe_rc=0
			# The provider knows the item, never the session a window sits in.
			probe_err="$(ORCH_LANE_HOST="$state_host" "$SCRIPT_DIR/lane-host" touch --item "$state_probe_item" 2>&1 >/dev/null)" || probe_rc=$?
			if [[ "$probe_rc" -eq "$LANE_HOST_BUSY_EXIT" ]]; then
				printf '%s\n' "$probe_err" >&2
				message lane-host-busy touch "$LANE_ARG" >&2
			elif [[ "$probe_rc" -ne 0 ]]; then
				message host-unreachable "$LANE_ARG" "$LANE_STATE_ANSWER" "$probe_err" >&2
			fi
		fi
		if [[ "$AS_JSON" == "true" ]]; then
			jq -nc --arg i "$LANE_ARG" --arg s "$LANE_STATE_ANSWER" '{item:$i,state:$s}'
		else
			printf '%s\n' "$LANE_STATE_ANSWER"
		fi
		;;
	context)
		HANDOFF_HEADROOM_PCT="${ORCH_HANDOFF_HEADROOM_PCT:-3}"
		pct_valid "$HANDOFF_HEADROOM_PCT" || die invalid-handoff-headroom "$HANDOFF_HEADROOM_PCT"
		# The context mark resolves through orch-env, as the turn-end hook and
		# oversee-succeed resolve it, so one settings file sets it for all three.
		HANDOFF_CONTEXT_PCT="$("$SCRIPT_DIR/orch-env" ORCH_HANDOFF_CONTEXT_PCT 90)" || die settings-rejected
		context_rc=0
		lane_context_handoff_due 0 1 "$HANDOFF_CONTEXT_PCT" >/dev/null || context_rc=$?
		[[ "$context_rc" -ne 2 ]] || die invalid-handoff-context "$HANDOFF_CONTEXT_PCT"
		validate_lane_settings
		load_lane_claims || exit 1
		# An unreadable claim store is not an empty fleet: reporting no lanes
		# would read as "every lane has room", which is the answer that sends
		# a lane into its wall.
		[[ "$LANE_CLAIMS_RC" -eq 0 ]] || die context-claims "$@"
		# The caller's account: the one its overseer launch record or its
		# SessionStart row names (lib/overseer-launch.sh § ol_caller_known, the
		# reader oversee-succeed asks too), else the SHAPE its pane names turned
		# into an account by lib/lane-context.sh's lane_context_caller_cfg, the
		# rule the lane's turn-end handoff hook asks about itself, so no session
		# is one account in this report and another there. A launched overseer
		# runs under overseer-run, whose bash is the pane's foreground command,
		# so its pane names no harness and the records answer.
		caller_cfg=""
		if [[ -n "${TMUX_PANE:-}" ]]; then
			OL_KNOWN_ACCOUNT="" OL_KNOWN_HARNESS=""
			if caller_key="$(lane_context_caller_key)"; then
				DEP_ERR=/dev/null ol_caller_known "${caller_key%% *}" "$TMUX_PANE" "$PWD" || true
			fi
			caller_cfg="$OL_KNOWN_ACCOUNT"
			if [[ -z "$caller_cfg" ]]; then
				caller_shape="$OL_KNOWN_HARNESS"
				if [[ -z "$caller_shape" ]]; then
					caller_cmd="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_current_command}' 2>/dev/null)" || caller_cmd=""
					caller_shape="$(lane_context_shape "${caller_cmd#-}")"
				fi
				caller_cfg="$(lane_context_caller_cfg "$caller_shape")"
			fi
		fi
		# Where each row's reading is recorded: a lane's in its own mailbox, which
		# its fleet lane record places.
		# No fleet state is a session outside any fleet, whose rows are the
		# caller's alone; a state that is there and cannot be read is refused.
		CONTEXT_LANES='[]'
		context_fleet="" context_records='[]'
		fleet_exists="$("$SCRIPT_DIR/workflow-state" exists --json oversee 2>/dev/null | jq -r '.exists')" \
			|| die context-fleet oversee
		if [[ "$fleet_exists" == true ]]; then
			context_state="$("$SCRIPT_DIR/workflow-state" path oversee)" || die context-fleet oversee
			context_fleet="$(lane_claims_canon "${context_state%/*}")/${context_state##*/}"
			context_records="$("$SCRIPT_DIR/workflow-state" get oversee '.lanes // []' 2>/dev/null)" \
				|| die context-fleet oversee
			CONTEXT_LANES="$(jq -c "$LANE_RUNNING_JQ"'[.[] | select(running)]' <<<"$context_records")" \
				|| die context-fleet oversee
		fi
		context_claims="$(lane_claims_for_fleet "$LANE_CLAIMS_LIVE" "$context_fleet" "$context_records")" \
			|| die context-claims "$@"
		context_claims="$(context_record_claims "$context_claims" "$CONTEXT_LANES")" || die context-fleet oversee
		# A separate list, never LANE_CLAIMS_LIVE itself: the caller's pane is
		# a pane to measure and not a launch in flight, and the usage pass
		# below counts that global's rows against each account.
		panes_to_measure="$(lane_context_with_caller "$context_claims" "$(lane_claims_canon "$caller_cfg")")"
		out="$(lane_context_collect "$panes_to_measure" lane_alias_for context_record_fetch "$HANDOFF_CONTEXT_PCT")"
		pick_host_rows all || exit 1
		usage="$(collect_lanes all)" || exit 1
		usage_i=0; usage_count="$(jq -r length <<<"$usage")"
		while (( usage_i < usage_count )); do
			usage_dir="$(jq -r --argjson i "$usage_i" '.[$i].config_dir' <<<"$usage")"
			usage_key="$(lane_claims_canon "$usage_dir")"
			usage="$(jq -c --argjson i "$usage_i" --arg d "$usage_key" '.[$i].config_dir=$d' <<<"$usage")"
			usage_i=$((usage_i + 1))
		done
		overseer_seats || die pick-overseer-seats "$SEATS_STEP" "$SEATS_STATE"
		# The handoff mark is the verdict a lane's own hook asks `pick --lane` for.
		out="$(jq -nc --argjson c "$out" --argjson u "$usage" --argjson max "$((100 - 10#$HANDOFF_HEADROOM_PCT))" \
			--argjson credit_floor "$CREDIT_FLOOR" --arg seats "$SEATS" --argjson reserve "$SEAT_RESERVE" "$LANE_MODEL_JQ"'
          ($seats | split("\n") | map(select(. != ""))) as $seats
          | $c | map(. as $x | ((($u | map(select(.config_dir == $x.config_dir)) | first) // {})
            | with_lane_seat_verdict(.wall; $max; $credit_floor; (if $x.caller == true then [] else $seats end); $reserve)) as $l
            | . + {headroom_pct: ($l.headroom_pct // null), binding_bucket: ($l.binding_bucket // null),
                   binding_resets_at: ($l.binding_resets_at // null), credits: ($l.credits // null),
                   handoff_required: ($l.verdict == "walled" or $l.verdict == "seat-reserve" or $x.context_handoff_due == true)})')"
		if [[ "$AS_JSON" == "true" ]]; then printf '%s\n' "$out"; else lane_context_render <<<"$out"; fi
		;;
	*) die unknown-subcommand "$@" ;;
esac
