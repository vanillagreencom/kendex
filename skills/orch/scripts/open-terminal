#!/usr/bin/env bash
# Wake a lane on this machine: hand the line that reads its inbox to the
# session the lane already holds, as a second process in print mode for
# Claude, Codex and Copilot and through pi-bridge for Pi, once the runtime's
# lane status reads the lane idle. The wake decides nothing else: which lane,
# which account and which session are the lane record's and the harness
# store's. A lane's launch, relaunch and stop are the runtime's, through
# `orch-runtime op --fleet --request FILE` with a `launch-lane` or
# `close-owned-resources` request (../workflows/oversee.md § 3).
#
# Message headers are `open-terminal: REASON field=value ...`; backslash,
# tab, carriage return and newline in values are escaped on that first line.
# English explanations follow and are not a parsing contract.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

message() { # REASON FIELD=VALUE...
  local reason="$1" text field
  shift
  case "$reason" in
    missing-value) text='The option requires a value.' ;;
    option-unknown) text='This entry takes --wake with --harness, --state-dir, --tracker, --repo, --lane and --launch-flags, and nothing else. A lane launch, relaunch or stop is the runtime'"'"'s: orch-runtime op --fleet --request FILE with a launch-lane or close-owned-resources request (workflows/oversee.md § 3).' ;;
    wake-only) text='This entry wakes a lane and does nothing else: pass --wake. A lane launch, relaunch or stop is the runtime'"'"'s: orch-runtime op --fleet --request FILE with a launch-lane or close-owned-resources request (workflows/oversee.md § 3).' ;;
    helper-missing) text='The required helper is not executable.' ;;
    items-missing) text='Specify a work item.' ;;
    tracker-invalid) text='The tracker must be linear or github.' ;;
    harness-missing) text='Name the harness the lane runs: --harness claude, codex, pi or copilot.' ;;
    state-missing) text='A wake names the fleet by its state: pass --state-dir, the directory holding workflow-state-oversee.json.' ;;
    flags-invalid) text='Launch flags must contain plain flag words without shell metacharacters.' ;;
    lane-unknown) text='The --lane option names no directory on this machine. A wake spends the account the lane record names where no --lane is passed.' ;;
    issue-invalid) text='The issue identifier does not match the configured pattern.' ;;
    issue-canonical-failed) text='The canonical spelling of the issue identifier could not be read; git-context'"'"'s own line is above.' ;;
    github-item-invalid) text='A GitHub work item must be an issue number.' ;;
    repo-missing) text='Specify a repository with --repo for a GitHub item.' ;;
    wake-invalid) text='The wake takes --harness claude, codex, pi or copilot and a lane on this machine: a hosted lane'"'"'s sessions are on its host, and a cloud lane has none to resume.' ;;
    state-absent) text='No oversee workflow state exists at the address this wake resolved, so nothing was ever launched into it. Nothing woken. Point the wake at the fleet state with --state-dir, the directory holding the file workflow-state-oversee.json.' ;;
    state-read-failed) text='The fleet state could not be read; the store'"'"'s own line is above. Nothing woken.' ;;
    record-missing) text='No lane record names the item, so no launch made this lane and there is no session to wake. Nothing woken. Launch the item through the runtime (workflows/oversee.md § 3).' ;;
    directory-missing) text='The lane'"'"'s worktree is not a directory on this machine. Nothing woken.' ;;
    wake-refused) text='The lane is not idle: the reason names the state the runtime'"'"'s lane status read from its pane and its harness process, and a resume would run a second session beside a live one. Nothing was started. A reason of unjudged is a reading the runtime could not make; its own line is above.' ;;
    session-missing) text='No session of this harness names the item. Nothing was started.' ;;
    session-scan-failed) text='The harness'"'"'s session store could not be read. Nothing was started.' ;;
    launch-trust-missing) text='The folder-trust entry for the lane'"'"'s worktree could not be made in the config the woken session would read, so nothing was started; the reason names the step.' ;;
    launch-identity-unread) text='The detached turn'"'"'s process identity could not be read, so the lane record names no turn for lane-close to stop; the turn runs.' ;;
    wake-failed) text='The delivering command exited non-zero before the wake window closed. The lane was not woken; the log says why.' ;;
    record-write-failed) text='The lane record could not be rewritten; the woken session runs. The store'"'"'s own line is above.' ;;
    lane-woken) text='The line that reads the lane inbox is on its way to the session. The delivering command runs detached; its output goes to the log.' ;;
    summary) text='The wake batch is complete.' ;;
    *) printf 'open-terminal: message-invalid reason=%s\n' "$reason" >&2; return 2 ;;
  esac
  printf 'open-terminal: %s' "$reason"
  for field in "$@"; do
    field="${field//\\/\\\\}"
    field="${field//$'\t'/\\t}"
    field="${field//$'\r'/\\r}"
    field="${field//$'\n'/\\n}"
    printf ' %s' "$field"
  done
  printf '\n%s\n' "$text"
}

usage() {
  cat <<'USAGE'
Usage: open-terminal --wake --harness HARNESS --state-dir DIR [options] ITEM...

Wake a lane on this machine: resume the session its record and its harness
store name, as a second process in print mode (claude, codex, copilot) or
through pi-bridge (pi), with the one line that reads its inbox, once the
runtime's lane status reads the lane idle. A lane launch, relaunch or stop is
the runtime's: orch-runtime op --fleet --request FILE with a launch-lane or
close-owned-resources request (workflows/oversee.md § 3).

Options:
  --wake                 required: this entry does nothing else
  --harness HARNESS      claude, codex, pi or copilot: the harness the lane runs
  --state-dir DIR        the fleet state the lane record is read from and
                         rewritten into: session_id, status and the wake's
                         own process identity, which lane-close stops by
  --tracker linear|github  the item's tracker (default linear)
  --repo OWNER/REPO      the repository of a GitHub item
  --lane DIR             the account the woken turn spends; without it the
                         account the lane record names
  --launch-flags "..."   plain flag words the woken command carries, such as
                         a copilot model and effort
  --help                 this text

A wake into a lane whose status is not idle refuses as wake-refused naming
the state; a lane no record names, a hosted or cloud lane, and a lane whose
harness holds no session for it are refused by name and nothing starts.
USAGE
}

need_val() { [[ $# -ge 2 && -n "${2:-}" ]] || { message missing-value "option=$1" >&2; exit 2; }; }

parse_argv() {
  WAKE=false
  HARNESS=""
  STATE_DIR=""
  TRACKER="linear"
  REPO=""
  LANE=""
  LAUNCH_FLAGS=""
  ITEMS=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --wake) WAKE=true; shift ;;
      --harness) need_val "$@"; HARNESS="$2"; shift 2 ;;
      --harness=*) HARNESS="${1#--harness=}"; need_val --harness "$HARNESS"; shift ;;
      --state-dir) need_val "$@"; STATE_DIR="$2"; shift 2 ;;
      --state-dir=*) STATE_DIR="${1#--state-dir=}"; need_val --state-dir "$STATE_DIR"; shift ;;
      --tracker) need_val "$@"; TRACKER="$2"; shift 2 ;;
      --tracker=*) TRACKER="${1#--tracker=}"; need_val --tracker "$TRACKER"; shift ;;
      --repo) need_val "$@"; REPO="$2"; shift 2 ;;
      --repo=*) REPO="${1#--repo=}"; need_val --repo "$REPO"; shift ;;
      --lane) need_val "$@"; LANE="$2"; shift 2 ;;
      --lane=*) LANE="${1#--lane=}"; need_val --lane "$LANE"; shift ;;
      --launch-flags) need_val "$@"; LAUNCH_FLAGS="$2"; shift 2 ;;
      --launch-flags=*) LAUNCH_FLAGS="${1#--launch-flags=}"; need_val --launch-flags "$LAUNCH_FLAGS"; shift ;;
      --help | -h | help) usage; exit 0 ;;
      --*) message option-unknown "option=$1" >&2; exit 2 ;;
      *) ITEMS+=("$1"); shift ;;
    esac
  done
}

# Help is answered before any configuration is read: `.env.local` is sourced
# as shell, so the dry run is the real parser in a subshell, and 9 is the
# only status meaning it reached the end.
parse_rc=0
( parse_argv "$@"; exit 9 ) || parse_rc=$?
[[ "$parse_rc" -eq 9 ]] || exit "$parse_rc"
unset parse_rc

# `|| true`: outside a git repository the substitution exits non-zero, and
# the wake is answered by its own refusals, not git's exit 128.
PROJECT_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
export PROJECT_ROOT
SKILLS_DIR="$PROJECT_ROOT/.agents/skills"
export SKILLS_DIR
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$PROJECT_ROOT"
# shellcheck source=lib/lane-state.sh
source "$SCRIPT_DIR/lib/lane-state.sh"
# shellcheck source=lib/lane-launch.sh
source "$SCRIPT_DIR/lib/lane-launch.sh"
# shellcheck source=lib/lane-context.sh
source "$SCRIPT_DIR/lib/lane-context.sh"
# shellcheck source=lib/lane-relaunch.sh
source "$SCRIPT_DIR/lib/lane-relaunch.sh"
WORKTREE_CLI="${WORKTREE_CLI:-$SKILLS_DIR/worktree/scripts/worktree}"
ORCH_RUNTIME="${ORCH_RUNTIME_CLI:-$SCRIPT_DIR/orch-runtime}"
LANES_CLI="${LANES_CLI:-$SCRIPT_DIR/lanes}"
WORKFLOW_STATE="$SCRIPT_DIR/workflow-state"
GH_ISSUE_PATTERN="${GH_ISSUE_PATTERN:-[A-Z]+-[0-9]+}"

parse_argv "$@"
[[ "$WAKE" == true ]] || { message wake-only >&2; exit 1; }
[[ -n "$HARNESS" ]] || { message harness-missing >&2; exit 1; }
[[ "$HARNESS" =~ ^(claude|codex|pi|copilot)$ ]] || { message wake-invalid "option=--wake" "harness=$HARNESS" >&2; exit 1; }
[[ -n "$STATE_DIR" ]] || { message state-missing >&2; exit 1; }
[[ ${#ITEMS[@]} -gt 0 ]] || { message items-missing "count=0" >&2; exit 1; }
[[ "$TRACKER" == "linear" || "$TRACKER" == "github" ]] || { message tracker-invalid "tracker=$TRACKER" >&2; exit 1; }
# $LAUNCH_FLAGS is interpolated verbatim into a shell-executed command, so a
# shell metacharacter here is arbitrary command execution at the wake. Only
# plain flag words may pass; brackets (`opus[1m]`) and the colon (pi's
# `sonnet:high`) are ordinary flag values, and every shell-active character is
# refused.
if [[ -n "$LAUNCH_FLAGS" ]]; then
  launch_flags_pattern='^[]A-Za-z0-9._=/:[-]+( []A-Za-z0-9._=/:[-]+)*$'
  if [[ ! "$LAUNCH_FLAGS" =~ $launch_flags_pattern ]]; then
    message flags-invalid "flags=$LAUNCH_FLAGS" >&2
    exit 1
  fi
fi
[[ -z "$LANE" || -d "$LANE" ]] || { message lane-unknown "lane=$LANE" >&2; exit 1; }
[[ -x "$WORKTREE_CLI" ]] || { message helper-missing "path=$WORKTREE_CLI" >&2; exit 1; }
[[ -x "$WORKFLOW_STATE" ]] || { message helper-missing "path=$WORKFLOW_STATE" >&2; exit 1; }
if ! "$WORKFLOW_STATE" --state-dir "$STATE_DIR" exists oversee; then
  message state-absent "state=$("$WORKFLOW_STATE" --state-dir "$STATE_DIR" path oversee)" >&2
  exit 1
fi
# Each item starts from this scrub; a lane recorded with the owner's live
# display keeps the live-session names for its turn alone.
LAUNCH_SCRUB_BASE=("${LANE_LAUNCH_SCRUB[@]}")

# The two homes lib/lane-relaunch.sh asks of its caller for the session scan:
# the account a codex session store is read under, this process's own, and
# the copilot home, named by --lane where one is, else the caller's.
launch_ambient_codex_home() {
  if [[ "${LANE_ENV%%=*}" == CODEX_HOME ]]; then printf '%s\n' "${LANE_ENV#*=}"; return; fi
  ( CODEX_HOME="${CODEX_HOME:-}"; lane_context_caller_cfg codex )
}
copilot_launch_home() {
  if [[ "${LANE_ENV%%=*}" == COPILOT_HOME ]]; then printf '%s\n' "${LANE_ENV#*=}"; return; fi
  lane_context_caller_cfg copilot
}

# The lane record the fleet state holds for WT_ID, compact on stdout; status
# 2 for a state that could not be read, which is no answer, and 1 for none.
lane_record() { # WT_ID
  local lanes
  lanes="$("$WORKFLOW_STATE" --state-dir "$STATE_DIR" get oversee '.lanes // []')" || return 2
  jq -ce --arg item "$1" 'first(.[] | objects | select(.item == $item)) // null' <<<"$lanes"
}

# The runtime's reading of the lane: `idle` wakes it, any other word refuses.
wake_state() { # WT_ID
  local reply rc=0
  reply="$("$ORCH_RUNTIME" --state-dir "$STATE_DIR" lane status --item "$1" 2>"$WAKE_ERR")" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    cat -- "$WAKE_ERR" >&2
    printf 'unjudged\n'
    return 0
  fi
  jq -r '.result.state // "unjudged"' <<<"$reply" 2>/dev/null || printf 'unjudged\n'
}

# The woken command: the harness's own resume of SESSION_ID in print mode,
# with the lane's inbox line as its one prompt, the lead settings and the
# question-tool words first, then the flags; pi takes the line through
# pi-bridge into the live session in WT. The compaction words follow the
# model the session's transcript names (WAKE_MODEL), since the new process
# takes none of the settings the first launch ran with.
wake_line() { # ITEM WT_ID SESSION_ID WT
  local flags="" tok line
  local -a flag_tokens=()
  read -r -a flag_tokens <<<"$LAUNCH_FLAGS"
  launch_choice_lead_settings --question-off --model "$WAKE_MODEL" "$HARNESS" ${flag_tokens[@]+"${flag_tokens[@]}"}
  for tok in ${LAUNCH_CHOICE_KEPT[@]+"${LAUNCH_CHOICE_KEPT[@]}"}; do
    flags+="'$tok' "
  done
  line=" 'Run .agents/skills/mailbox/scripts/lane-mail inbox --item $2 and act on every envelope it prints, answers and directives alike, as its text directs. $LAUNCH_UNATTENDED_TEXT'"
  case "$HARNESS" in
    pi) printf 'pi-bridge send --cwd %q%s\n' "$4" "$line" ;;
    claude) printf 'claude -n %q %s--resume %q -p%s\n' "$1" "$flags" "$3" "$line" ;;
    codex) printf 'codex exec resume %s%q%s\n' "$flags" "$3" "$line" ;;
    copilot) printf 'copilot %s--resume=%q -p%s\n' "$flags" "$3" "$line" ;;
  esac
}

# The command under the account it spends and the launch environment
# lib/lane-launch.sh renders for every launcher: the account variable where
# the record or --lane names one, the folder trust a codex or copilot session
# reads, the identity scrub and the lane's own words.
wake_command() { # ITEM WT CMD
  local item="$1" wt="$2" cmd="$3" launch_var="" launch_home="" form
  case "$HARNESS" in
    codex | copilot)
      if [[ -n "$LANE_ENV" ]]; then
        launch_var="${LANE_ENV%%=*}"; launch_home="${LANE_ENV#*=}"
      elif [[ "$HARNESS" == codex ]]; then
        launch_var=CODEX_HOME; launch_home="$(launch_ambient_codex_home)" || return 1
      else
        launch_var=COPILOT_HOME; launch_home="$(copilot_launch_home)" || return 1
      fi
      if ! lane_trust_prepare "$HARNESS" "$launch_home" "$wt"; then
        message launch-trust-missing "item=$item" "lane=$launch_home" "dir=$wt" "reason=$LANE_TRUST_REASON" >&2
        [[ -z "$LANE_TRUST_DETAIL" ]] || printf '%s\n' "$LANE_TRUST_DETAIL" >&2
        return 1
      fi
      launch_home="$LANE_TRUST_HOME"
      form="$(lane_launch_form "$cmd" "$HARNESS" "$launch_home" "")" || return 1
      cmd="$(lane_launch_line "$cmd" "$HARNESS" "$launch_var" "$launch_home" "$form")" || return 1 ;;
    *)
      if [[ -n "$LANE_ENV" ]]; then launch_var="${LANE_ENV%%=*}"; launch_home="${LANE_ENV#*=}"; fi
      form="$(lane_launch_form "$cmd" "$HARNESS" "$launch_home" "")" || return 1
      cmd="$(lane_launch_line "$cmd" "$HARNESS" "$launch_var" "$launch_home" "$form")" || return 1 ;;
  esac
  cmd="export KENDEX_USER_EMAIL='' && $cmd"
  printf '%s\n' "export KENDEX_LANE_ORIGIN=$(lane_single_quote "$wt") && $cmd"
}

run_detached() { # LOG COMMAND...
  local log="$1" name
  local -a scrub=()
  shift
  for name in "${LANE_LAUNCH_SCRUB[@]}" TMUX TMUX_PANE; do scrub+=(-u "$name"); done
  lane_run_detached "$log" "$log" env "${scrub[@]}" "$@"
}

# A resumed turn can run for a long time, so it runs detached from the caller,
# in the lane's worktree, with its output in that worktree's tmp/. Its exit
# status is read if it lands inside the window: pi-bridge returns once the
# session takes the line, and a Claude, Codex or Copilot start failure (a
# rejected flag, an auth wall, an unresumable id) exits there too. The status
# comes from a file the detached shell writes, because an exited child that
# nobody has reaped still answers `kill -0`.
open_wake() { # DIR WT_ID CMD
  local log="$1/tmp/lane-wake-$2.log" status="$1/tmp/lane-wake-$2.status" waited=0 rc=0 pid start
  mkdir -p -- "$1/tmp" && rm -f -- "$status" || return 1
  run_detached "$log" bash -c 'cd -- "$1" && eval "$3"; echo "$?" >"$2"' wake "$1" "$status" "$3"
  # The turn runs outside the pane's process tree, where the pane's stop never
  # reaches it, so its own identity is recorded for lane-close to stop it by:
  # the detached shell, whose children are the resumed harness. Read before
  # the wait below, which a short turn outlives; no start is a turn already
  # over, which records none.
  pid=$!
  if start="$(lane_process_start "$pid")"; then
    [[ -z "$start" ]] || LAUNCH_WAKE="$(jq -cn --argjson pid "$pid" --arg start "$start" '{pid: $pid, start: $start}')" || return 1
  else
    message launch-identity-unread "item=$2" "step=wake" >&2
  fi
  while [[ ! -s "$status" ]] && (( waited < 10 )); do sleep 0.5; waited=$((waited + 1)); done
  [[ ! -s "$status" ]] || rc="$(cat -- "$status")" || return 1
  if [[ "$rc" != 0 ]]; then
    message wake-failed "item=$2" "harness=$HARNESS" "exit=$rc" "log=$log" >&2
    return 1
  fi
  message lane-woken "item=$2" "harness=$HARNESS" "log=$log"
}

# The lane record after the wake: the session it resumed, status running and
# the identity of the turn it started, null where none was read; every other
# field as the launch wrote it. The refusal and the write are one locked step.
wake_record_write() { # WT_ID SESSION_ID
  local report
  report="$("$WORKFLOW_STATE" --state-dir "$STATE_DIR" update-report oversee '
    (.lanes // []) as $l
    | if any($l[]; .item == $item)
      then {state: (.lanes = ($l | map(if .item == $item
          then . + {session_id: (if $session == "" then null else $session end), status: "running", wake: $wake}
          else . end))), report: "rewritten"}
      else {state: ., report: "unrecorded"} end' \
    --arg item "$1" --arg session "$2" --argjson wake "${LAUNCH_WAKE:-null}")" || return 1
  [[ "$report" != '"unrecorded"' ]] || return 2
}

wake_item() { # RAW
  local raw="$1" item wt_id record host kind live_display wt state session_file="" session_id="" resume_rc=0 reading cmd record_rc=0
  LANE_ENV="" LAUNCH_WAKE="" WAKE_MODEL=""
  LANE_LAUNCH_SCRUB=("${LAUNCH_SCRUB_BASE[@]}")
  if [[ "$TRACKER" == linear ]]; then
    # git-context owns the canonical spelling of a tracker item, the record
    # key the lane's mailbox and its state are bound under.
    local canonical_rc=0
    item="$("$SCRIPT_DIR/git-context" issue-canonical "$raw" "$GH_ISSUE_PATTERN")" || canonical_rc=$?
    if [[ "$canonical_rc" -eq 1 ]]; then message issue-invalid "item=$raw" >&2; return 1
    elif [[ "$canonical_rc" -ne 0 ]]; then message issue-canonical-failed "item=$raw" "exit=$canonical_rc" >&2; return 1; fi
    wt_id="$item"
  else
    [[ "$raw" =~ ^[0-9]+$ ]] || { message github-item-invalid "item=$raw" >&2; return 1; }
    [[ -n "$REPO" ]] || { message repo-missing "option=--repo" >&2; return 1; }
    item="$raw"
    wt_id="issue-$raw"
  fi
  record_rc=0
  record="$(lane_record "$wt_id")" || record_rc=$?
  case "$record_rc" in
    0) ;;
    1) message record-missing "item=$item" "state=oversee" >&2; return 1 ;;
    *) message state-read-failed "item=$item" >&2; return 1 ;;
  esac
  host="$(jq -r '.host // ""' <<<"$record")" || return 1
  kind="$(jq -r '.kind // "local"' <<<"$record")" || return 1
  if [[ -n "$host" || "$kind" != local ]]; then
    message wake-invalid "option=--wake" "harness=$HARNESS" "host=${host:-$kind}" >&2
    return 1
  fi
  # The account the turn spends: --lane, else the record's, as the account
  # variable the launchers render.
  if [[ -n "$LANE" ]]; then
    LANE_ENV="$(lane_env_prefix "$HARNESS" "$LANE")" || return 1
  else
    local account
    account="$(jq -r '.account // ""' <<<"$record")" || return 1
    [[ -z "$account" ]] || LANE_ENV="$(lane_env_prefix "$HARNESS" "$account")" || return 1
  fi
  live_display="$(jq -r '.live_display == true' <<<"$record")" || return 1
  [[ "$live_display" != true ]] || lane_launch_keep_live_session
  wt="$("$WORKTREE_CLI" path "$wt_id")" || { message directory-missing "item=$item" "path=" >&2; return 1; }
  [[ -d "$wt" ]] || { message directory-missing "item=$item" "path=$wt" >&2; return 1; }
  # A Pi wake enters the live session through pi-bridge. Any other wake starts
  # a second process on the session, so only an idle lane takes one.
  if [[ "$HARNESS" != pi ]]; then
    state="$(wake_state "$wt_id")" || state=unjudged
    [[ "$state" == idle ]] || { message wake-refused "item=$item" "reason=$state" >&2; return 1; }
    session_file="$(find_relaunch_session "$HARNESS" "$wt")" || resume_rc=$?
    [[ "$resume_rc" -le 1 ]] || { message session-scan-failed "item=$item" "harness=$HARNESS" >&2; return 1; }
    [[ -n "$session_file" ]] || { message session-missing "item=$item" "harness=$HARNESS" >&2; return 1; }
    session_id="$(session_id_of "$HARNESS" "$session_file")" || { message session-scan-failed "item=$item" "harness=$HARNESS" >&2; return 1; }
    # A copilot row names no compaction words and no adapter reads its session.
    if [[ "$HARNESS" != copilot ]]; then
      reading="$(lane_context_reading "$HARNESS" < "$session_file")" || { message session-scan-failed "item=$item" "harness=$HARNESS" >&2; return 1; }
      [[ "$reading" != *$'\t'* ]] || WAKE_MODEL="${reading##*$'\t'}"
    fi
  fi
  cmd="$(wake_line "$item" "$wt_id" "$session_id" "$wt")" || return 1
  cmd="$(wake_command "$item" "$wt" "$cmd")" || return 1
  open_wake "$wt" "$wt_id" "$cmd" || return 1
  record_rc=0
  wake_record_write "$wt_id" "$session_id" || record_rc=$?
  case "$record_rc" in
    0) ;;
    2) message record-missing "item=$item" "state=oversee" >&2; return 1 ;;
    *) message record-write-failed "item=$item" "state=oversee" >&2; return 1 ;;
  esac
}

WAKE_ERR="$(mktemp)" || { message helper-missing "path=mktemp" >&2; exit 1; }
trap 'rm -f -- "$WAKE_ERR"' EXIT
woken=0 failed=0
for raw in "${ITEMS[@]}"; do
  if wake_item "$raw"; then woken=$((woken + 1)); else failed=$((failed + 1)); fi
done
if [[ "$failed" -gt 0 ]]; then
  message summary "woken=$woken" "failed=$failed" >&2
  exit 1
fi
message summary "woken=$woken" "failed=$failed"
