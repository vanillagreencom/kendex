#!/usr/bin/env bash
# Launch one or more work item worktrees in a separate terminal/window.
# This is a handoff helper only; it does not monitor spawned sessions.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# `|| true` is load-bearing under `set -e`: outside a git repo this command
# substitution exits non-zero and killed the whole script before argument
# parsing, so even `--help` died with git's exit 128 and no output. Help and
# argument validation must not require a repository; the commands that genuinely
# need one already check $WORKTREE_CLI and report it by name.
PROJECT_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
SKILLS_DIR="$PROJECT_ROOT/.agents/skills"
# shellcheck source=lib/vstack-env.sh
source "$SCRIPT_DIR/lib/vstack-env.sh"
vstack_load_project_env "$PROJECT_ROOT"
# shellcheck source=lib/lane-claims.sh
source "$SCRIPT_DIR/lib/lane-claims.sh"
WORKTREE_CLI="${WORKTREE_CLI:-$SKILLS_DIR/worktree/scripts/worktree}"
LANES_CLI="${LANES_CLI:-$SCRIPT_DIR/lanes}"
GH_ISSUE_PATTERN="${GH_ISSUE_PATTERN:-[A-Z]+-[0-9]+}"
# Bounded seconds per brief-delivery verification pass on tmux lanes.
TMUX_VERIFY_SECS="${ORCH_TMUX_VERIFY_SECS:-15}"
# Model, effort, and permission posture are decided per task by the caller at
# launch time and arrive here as --launch-flags. Nothing in this script, the
# settings file, or a handoff template pins them: a docs fix and a systems
# rewrite do not want the same model, and a stored default silently applies
# yesterday's answer to today's work item.
LAUNCH_FLAGS=""

TRACKER="linear"
REPO=""
TERMINAL_MODE=""
HARNESS=""
CMD_TEMPLATE=""
LANE=""
LANE_MAX_PCT="${ORCH_LANE_MAX_PCT:-90}"
LANE_ENV=""
RELAUNCH=false
ITEMS=()

usage() {
  cat <<'USAGE'
Usage: open-terminal [--tracker linear|github] [--repo OWNER/REPO] ITEM... [options]

Options:
  --harness <name>  claude, codex, opencode, pi
  --tmux            Open tmux windows in the current session
  --ghostty         Open Ghostty/GUI terminals
  --cmd "..."       Custom command; {issue}, {item}, and {repo} are replaced
  --lane <spec>     Launch under a chosen harness account. `auto` picks the
                    qualifying account with the fewest launches in flight for
                    --harness; `auto:<h>` picks for harness <h>; a config dir
                    is used literally; any other value is looked up as a lane
                    alias. Refuses to launch when no lane is under the usage
                    threshold, rather than launching into a wall. On tmux
                    lanes only: every window launched under a lane records a
                    claim (see `lanes --help`), live while its pane is, and
                    `auto` re-picks before each further item, so a batch
                    spreads across accounts instead of stacking on one. A
                    re-pick that qualifies no lane stops the batch, leaving
                    the items already launched alone. A GUI launch has no
                    pane to keep a claim alive, so a GUI batch stays on the
                    lane resolved up front.
  --lane-max-pct N  Threshold for --lane auto (default: 90, or $ORCH_LANE_MAX_PCT)
  --launch-flags S  Flags for the launched harness command, chosen per task by
                    the caller (model, effort, permission posture). Plain flag
                    words only — the string is interpolated into a
                    shell-executed launch command. Nothing is hardcoded here or
                    in settings; a claude lane whose flags carry no
                    permission-bypass warns, because handoff is unattended and
                    a prompting mode stalls the lane at its first tool call.
  --relaunch        Replace a dead session on items that may already have a
                    worktree: an existing tree is reused instead of being read
                    as another session's claim. A worktree under a lease held
                    by a different owner is still skipped.

On tmux lanes the brief's delivery is verified against the pane and re-sent
once if a first-run dialog consumed it ($ORCH_TMUX_VERIFY_SECS per pass,
default 15, positive integer clamped to 120).

Each item's worktree is created here (worktree create, or create --reuse
under --relaunch when the item's tree already exists). An item whose worktree
is owned by another session (create exit 75) is skipped and the remaining
items still launch. The final summary line reports launched, skipped, and
failed counts.

Exit codes:
  0   at least one lane launched and none failed (skipped items allowed)
  75  every item was skipped as owned by another session; nothing launched
  1   any lane failed (worktree create error, launch error), or usage error
USAGE
}

# A valued option with no value must fail with the flag named, not crash on an
# unbound $2 under nounset.
need_val() { [[ $# -ge 2 && -n "${2:-}" ]] || { echo "Error: $1 requires a value" >&2; exit 2; }; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --tracker) need_val "$@"; TRACKER="$2"; shift 2 ;;
    --tracker=*) TRACKER="${1#--tracker=}"; shift ;;
    --repo) need_val "$@"; REPO="$2"; shift 2 ;;
    --repo=*) REPO="${1#--repo=}"; shift ;;
    --tmux) TERMINAL_MODE="tmux"; shift ;;
    --ghostty) TERMINAL_MODE="ghostty"; shift ;;
    --harness) need_val "$@"; HARNESS="$2"; shift 2 ;;
    --harness=*) HARNESS="${1#--harness=}"; shift ;;
    --cmd) need_val "$@"; CMD_TEMPLATE="$2"; shift 2 ;;
    --cmd=*) CMD_TEMPLATE="${1#--cmd=}"; shift ;;
    --lane) need_val "$@"; LANE="$2"; shift 2 ;;
    --lane=*) LANE="${1#--lane=}"; shift ;;
    --lane-max-pct) need_val "$@"; LANE_MAX_PCT="$2"; shift 2 ;;
    --lane-max-pct=*) LANE_MAX_PCT="${1#--lane-max-pct=}"; shift ;;
    --launch-flags) need_val "$@"; LAUNCH_FLAGS="$2"; shift 2 ;;
    --launch-flags=*) LAUNCH_FLAGS="${1#--launch-flags=}"; shift ;;
    --relaunch) RELAUNCH=true; shift ;;
    --help|-h) usage; exit 0 ;;
    *) ITEMS+=("$1"); shift ;;
  esac
done

[[ -x "$WORKTREE_CLI" ]] || { echo "Error: worktree CLI not found at $WORKTREE_CLI" >&2; exit 1; }
[[ ${#ITEMS[@]} -gt 0 ]] || { echo "Error: no work items specified" >&2; exit 1; }
[[ "$TRACKER" == "linear" || "$TRACKER" == "github" ]] || { echo "Error: --tracker must be linear or github" >&2; exit 1; }
[[ -n "$HARNESS" || -n "$CMD_TEMPLATE" ]] || { echo "Error: --harness or --cmd required" >&2; exit 1; }
[[ "$HARNESS" != "codex-app" ]] || { echo "Error: codex-app handoff requires Codex Desktop codex_app thread tools; open-terminal only launches terminal harnesses" >&2; exit 1; }

# ORCH_TMUX_VERIFY_SECS feeds a per-pass sleep loop (two passes per tmux
# lane): a runaway value hangs every lane in the launch and a non-integer
# breaks the loop arithmetic, so anything but a positive integer is a config
# error and oversized values are clamped to a bound that still fails fast.
# Validated after argument parsing so --help never dies on project settings,
# and ONLY for tmux launches — GUI/custom-command lanes never read it, and a
# broken tmux-only setting must not abort unrelated launches. The implicit
# mode (no flag, $TMUX set → tmux) resolves HERE, before this gate, so an
# implicit tmux launch validates instead of silently taking the default.
if [[ -z "$TERMINAL_MODE" ]]; then
  if [[ -n "${TMUX:-}" ]]; then TERMINAL_MODE="tmux"; else TERMINAL_MODE="gui"; fi
fi
# Only Claude tmux lanes run brief verification (other harnesses and
# custom --cmd launches pass an empty brief and never read the timeout),
# so only they validate it.
if [[ "$TERMINAL_MODE" != "tmux" || "$HARNESS" != "claude" || -n "$CMD_TEMPLATE" ]]; then
  TMUX_VERIFY_SECS=15
elif [[ ! "$TMUX_VERIFY_SECS" =~ ^[0-9]+$ ]]; then
  echo "Error: ORCH_TMUX_VERIFY_SECS must be a positive integer (seconds), got '$TMUX_VERIFY_SECS'." >&2
  exit 1
fi
# Strip leading zeros (octal hazard), then bound the digit count BEFORE any
# arithmetic: a huge value would overflow signed math to negative, dodge the
# 120 clamp, and zero out both verification loops.
TMUX_VERIFY_SECS="$(printf '%s' "$TMUX_VERIFY_SECS" | sed 's/^0*//')"
TMUX_VERIFY_SECS="${TMUX_VERIFY_SECS:-0}"
if (( ${#TMUX_VERIFY_SECS} > 9 )); then
  echo "WARNING: ORCH_TMUX_VERIFY_SECS is absurdly large; clamped to 120 seconds per verification pass." >&2
  TMUX_VERIFY_SECS=120
fi
TMUX_VERIFY_SECS=$((10#$TMUX_VERIFY_SECS))
if ((TMUX_VERIFY_SECS == 0)); then
  echo "Error: ORCH_TMUX_VERIFY_SECS must be a positive integer (seconds), got '0'." >&2
  exit 1
fi
if (( TMUX_VERIFY_SECS > 120 )); then
  echo "WARNING: ORCH_TMUX_VERIFY_SECS=$TMUX_VERIFY_SECS clamped to 120 seconds per verification pass." >&2
  TMUX_VERIFY_SECS=120
fi

# $LAUNCH_FLAGS is interpolated verbatim into a shell-executed launch command
# (bash -lc on GUI lanes, keystrokes into the pane shell on tmux lanes), so a
# shell metacharacter here is arbitrary command execution at launch. Only plain
# flag words may pass; anything else is a caller error, not a launch. Bracketed
# model ids (`opus[1m]`) are ordinary flag values, so brackets are allowed and
# every shell-active character is not.
if [[ -n "$LAUNCH_FLAGS" ]]; then
  # `]` leads and `-` trails inside the bracket expression, the only positions
  # where they are literal rather than range/close syntax.
  launch_flags_pattern='^[]A-Za-z0-9._=/[-]+( []A-Za-z0-9._=/[-]+)*$'
  if [[ ! "$LAUNCH_FLAGS" =~ $launch_flags_pattern ]]; then
    echo "Error: --launch-flags '$LAUNCH_FLAGS' contains characters outside letters, digits, and . _ = / - [ ] words separated by single spaces — refusing to interpolate it into a shell command." >&2
    exit 1
  fi
fi

# Handoff is unattended: a claude lane whose flags carry no permission bypass
# stalls at its first tool call with nobody there to answer. Warn loudly, but
# launch — the flags are the caller's explicit per-task decision.
if [[ "$HARNESS" == "claude" && -z "$CMD_TEMPLATE" ]]; then
  case "$LAUNCH_FLAGS" in
    *dangerously-skip-permissions*|*bypassPermissions*|*dontAsk*) ;;
    *)
      echo "WARNING: --launch-flags '$LAUNCH_FLAGS' carries no permission-bypass flag — every lane will stall at its first tool call with nobody attached to answer; handoff autonomy is void." >&2
      ;;
  esac
fi

# Resolve the launch lane BEFORE creating any worktree. A fleet launch that
# discovers "every account is full" after spawning three worktrees has already
# done the expensive, hard-to-undo half of the work (vstack#894).
#
# The lane becomes an env prefix on the launched command rather than a different
# binary, so it works whether or not the machine has a shell alias per account.
LANE_AUTO=false
LANE_HARNESS=""
pick_auto_lane() { "$LANES_CLI" pick --harness "$LANE_HARNESS" --max-pct "$LANE_MAX_PCT"; }
if [[ -n "$LANE" ]]; then
  case "$LANE" in
    auto|auto:*)
      lane_harness="${LANE#auto}"
      lane_harness="${lane_harness#:}"
      [[ -n "$lane_harness" ]] || lane_harness="$HARNESS"
      [[ -n "$lane_harness" ]] || { echo "Error: --lane auto needs --harness, or use --lane auto:<harness>" >&2; exit 1; }
      [[ -x "$LANES_CLI" ]] || { echo "Error: lanes helper not found at $LANES_CLI" >&2; exit 1; }
      LANE_AUTO=true
      LANE_HARNESS="$lane_harness"
      lane_rc=0
      LANE_ENV="$(pick_auto_lane)" || lane_rc=$?
      if [[ "$lane_rc" -ne 0 ]]; then
        # lanes exits 3 for "every lane is over the threshold" and 1 for a real
        # failure. Both stop the launch; only the first is the operator's call.
        if [[ "$lane_rc" -eq 3 ]]; then
          echo "Error: no $lane_harness lane under ${LANE_MAX_PCT}% used; nothing was launched." >&2
          echo "  Wait for a reset, raise --lane-max-pct, or pass an explicit --lane <config-dir>." >&2
        else
          echo "Error: could not resolve a lane (lanes exited $lane_rc); nothing was launched." >&2
        fi
        exit 1
      fi
      ;;
    *)
      lane_dir="$LANE"
      # A value carrying a `/` is meant as a path, so a miss there is a typo,
      # not an alias. A bare word is resolved as a lane alias — the discovered
      # name, or whatever ORCH_LANE_ALIASES renamed it to — through the same
      # inventory `pick` measures, so aliases need no second source of truth.
      if [[ "$lane_dir" == */* ]]; then
        [[ -d "$lane_dir" ]] || { echo "Error: --lane '$LANE' is not a directory (expected 'auto', 'auto:<harness>', a config dir, or a lane alias)" >&2; exit 1; }
      else
        # A bare word is resolved as an alias BEFORE the filesystem. Testing
        # `-d` first meant any same-named directory in the caller's cwd shadowed
        # a real lane and launched the fleet against the wrong account without
        # saying so. A bare directory name still works when no alias claims it.
        [[ -x "$LANES_CLI" ]] || { echo "Error: lanes helper not found at $LANES_CLI" >&2; exit 1; }
        lane_dir="$("$LANES_CLI" list --json | jq -r --arg a "$LANE" 'map(select(.alias == $a)) | first | .config_dir // empty')"
        if [[ -z "$lane_dir" ]]; then
          lane_dir="$LANE"
          [[ -d "$lane_dir" ]] || { echo "Error: --lane '$LANE' is neither a known lane alias nor a directory (see: lanes list)" >&2; exit 1; }
        fi
      fi
      case "$HARNESS" in
        codex) LANE_ENV="CODEX_HOME=$lane_dir" ;;
        *)     LANE_ENV="CLAUDE_CONFIG_DIR=$lane_dir" ;;
      esac
      ;;
  esac
  # Refused here, before any worktree is created (vstack#894: resolve the lane
  # before mutating anything). The value is single-quoted in the rendered
  # launch command, and a single quote inside the path cannot be embedded
  # safely.
  if [[ "$LANE_ENV" == *"'"* ]]; then
    echo "Error: lane config dir contains a single quote; cannot render a safe launch command: $LANE_ENV" >&2
    exit 1
  fi
  echo "Lane: $LANE_ENV"
fi



resolve_repo() {
  if [[ -n "$REPO" ]]; then printf '%s\n' "$REPO"; return; fi
  gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true
}

start_cmd() {
  local item="$1" repo="$2"
  if [[ -n "$CMD_TEMPLATE" ]]; then
    local out="${CMD_TEMPLATE//\{issue\}/$item}"
    out="${out//\{item\}/$item}"
    out="${out//\{repo\}/$repo}"
    printf '%s\n' "$out"
    return
  fi
  # The codex arms must stay plain prose built from shell-inert characters
  # (letters, digits, space, ./#-): codex has no /orch slash command, and the
  # composed line crosses at least one more quoting layer (e.g. an agent-confine
  # wrapper) before the spawned window's shell runs it, so a `$` that has lost
  # its single quotes gets expanded there and codex launches with no prompt at
  # all (vstack#976).
  # Each flag token is single-quoted in the rendered line. The validator bars
  # quotes and every shell-active character except `[`/`]`, which bracketed
  # model ids (`opus[1m]`) legitimately carry — and those are glob syntax to the
  # shell that finally runs this command, so an unquoted token expands against
  # the launch directory and the lane starts on a different model, or none.
  # Trailing space only when flags are present, so an unflagged launch renders
  # the exact command a human would type rather than a double-spaced one.
  local flags=""
  if [[ -n "$LAUNCH_FLAGS" ]]; then
    local -a flag_tokens=()
    # read -a splits on IFS without globbing; a bare `for tok in $LAUNCH_FLAGS`
    # would expand the very brackets this quoting exists to protect.
    read -r -a flag_tokens <<<"$LAUNCH_FLAGS"
    local tok
    for tok in "${flag_tokens[@]}"; do
      flags+="'$tok' "
    done
  fi
  local tc="$BRIEF_TERMINAL_CONDITION"
  case "$TRACKER:$HARNESS" in
    linear:claude)   printf "claude -n %q %s'/orch start %s%s'\n" "$item" "$flags" "$item" "$tc" ;;
    linear:codex)    printf "codex %s'Read .agents/skills/orch/SKILL.md and execute the orch start workflow for %s%s'\n" "$flags" "$item" "$tc" ;;
    linear:opencode) printf "opencode %s--prompt '/orch start %s%s'\n" "$flags" "$item" "$tc" ;;
    linear:pi)       printf "pi %s'/skill:orch start %s%s'\n" "$flags" "$item" "$tc" ;;
    github:claude)   printf "claude -n github-%q %s'/orch start github %s#%s%s'\n" "$item" "$flags" "$repo" "$item" "$tc" ;;
    github:codex)    printf "codex %s'Read .agents/skills/orch/SKILL.md and execute the orch start workflow for github %s#%s%s'\n" "$flags" "$repo" "$item" "$tc" ;;
    github:opencode) printf "opencode %s--prompt '/orch start github %s#%s%s'\n" "$flags" "$repo" "$item" "$tc" ;;
    github:pi)       printf "pi %s'/skill:orch start github %s#%s%s'\n" "$flags" "$repo" "$item" "$tc" ;;
    *) echo "Error: unsupported harness: $HARNESS" >&2; exit 1 ;;
  esac
}

# Handoff lanes are unattended and some runtimes self-judge completion, so
# every rendered brief — the launch command's prompt AND the tmux
# delivery/re-send copy — carries the terminal condition (handoff.md /
# oversee.md).
readonly BRIEF_TERMINAL_CONDITION=" — complete means the PR is MERGED and the worktree cleaned up, not merely opened"

# Delivered means SUBMITTED, not merely present: the brief echoed in the
# launch command (`claude -n` line) or sitting unsent in the composer's
# │-bordered input box is not delivery. The predicate requires the brief on a
# plain transcript line (neither of those) AND a transcript-activity marker
# proving the TUI accepted the prompt: a ●/⏺ response bullet, a ✻/✳ working
# spinner, or the esc-to-interrupt processing hint. -J joins wrapped lines so
# a narrow pane cannot split the brief across a line break and fake an
# undelivered screen.
tmux_brief_visible() {
  local pane="$1" brief="$2" screen
  # -S -: capture from the start of history, not just the visible viewport —
  # a fast response can scroll the submitted prompt out of view before the
  # first poll, and a viewport-only capture would misread that as
  # undelivered and queue a duplicate brief into a running session.
  screen="$(tmux capture-pane -pJ -S - -t "$pane" 2>/dev/null)" || return 1
  # No short-circuiting `grep -q` pipelines over the capture: with -S - a
  # retained pane can exceed a pipe buffer, an early -q match SIGPIPEs the
  # upstream printf, and pipefail turns a FOUND brief into exit 141 — a
  # submitted prompt then reads as missing and gets duplicated. grep -v
  # always reads its whole input; the containment checks are bash matches.
  local filtered
  filtered="$(printf '%s\n' "$screen" | grep -vF 'claude -n' | grep -vF '│')" || true
  [[ "$filtered" == *"$brief"* ]] || return 1
  [[ "$screen" == *'●'* || "$screen" == *'⏺'* || "$screen" == *'✻'* ||
     "$screen" == *'✳'* || "$screen" == *'esc to interrupt'* ]]
}

tmux_verify_brief() {
  local pane="$1" brief="$2" waited=0
  while (( waited < TMUX_VERIFY_SECS )); do
    sleep 1
    waited=$((waited + 1))
    tmux_brief_visible "$pane" "$brief" && return 0
  done
  return 1
}

# Before re-typing the brief, get the TUI to a ready composer: while a
# first-run dialog (theme / trust / browser integration) is still up, brief
# characters land in the DIALOG and are lost — only the trailing Enter
# survives to dismiss it, leaving an empty composer and a dead lane. Each
# pass sends one Enter (accepting the dialog's default, which is also what
# an unattended lane needs) and waits for the main TUI's composer footer.
# An Enter into an already-ready empty composer is a no-op, so the nudge is
# safe when the screen is merely slow.
tmux_wait_composer() {
  local pane="$1" waited=0 screen
  while (( waited < TMUX_VERIFY_SECS )); do
    # VISIBLE viewport only (no -S -): readiness is a property of the
    # current screen — a footer buried in scrollback behind a first-run
    # dialog must not read as "composer ready" and send the brief into the
    # dialog again.
    screen="$(tmux capture-pane -pJ -t "$pane" 2>/dev/null)" || return 1
    [[ "$screen" == *'? for shortcuts'* ]] && return 0
    tmux send-keys -t "$pane" Enter || return 1
    sleep 1
    waited=$((waited + 1))
  done
  return 1
}

open_tmux() {
  local dir="$1" title="$2" cmd="$3" brief="${4:-}"
  # Called on the left of `||` at the launch loop, which suspends errexit for
  # this whole function body — every tmux step is checked explicitly so a
  # failed window creation or keystroke cannot fall through to a success
  # return (most visibly on briefless lanes, whose early return would
  # otherwise count a broken window as launched).
  [[ -n "${TMUX:-}" ]] || { echo "Error: not inside tmux" >&2; return 1; }
  local last_idx pane spec server
  if ! last_idx=$(tmux list-windows -F '#{window_index}' | tail -1) || [[ -z "$last_idx" ]]; then
    echo "Error: tmux list-windows failed; cannot place window '$title'" >&2
    return 1
  fi
  # The server pid rides along with the pane id: it is the other half of a
  # lane claim's liveness key, and taking both from the creating call means no
  # second tmux round trip and no window between them.
  if ! spec=$(tmux new-window -a -t ":${last_idx}" -n "$title" -c "$dir" -P -F '#{pid} #{pane_id}') || [[ -z "$spec" ]]; then
    echo "Error: tmux new-window failed for '$title'" >&2
    return 1
  fi
  pane="${spec##* }"
  server="${spec% *}"
  [[ "$server" != "$spec" ]] || server=""
  # A lane launch is in flight the moment its window exists: `lanes pick`
  # counts it from here, minutes before the account's usage numbers move.
  # Recorded only under a resolved lane — the config dir is the account's
  # identity — and never fatal: a launch that worked is not a failure because
  # its bookkeeping did not.
  if [[ -n "$LANE_ENV" && -n "$server" ]]; then
    lane_claim_write "$(lane_claims_dir "$PROJECT_ROOT")" "$server" "$pane" "${LANE_ENV#*=}" "$title" \
      || echo "Warning: could not record the lane claim for '$title'; lanes pick will not count it (set OVERSEE_WATCH_STATE_DIR)" >&2
  fi
  if ! tmux send-keys -t "$pane" "clear" Enter ||
     ! tmux send-keys -t "$pane" -l "$cmd" ||
     ! tmux send-keys -t "$pane" Enter; then
    echo "Error: tmux send-keys failed launching '$title'" >&2
    return 1
  fi
  echo "Opened tmux window '$title' in $dir"
  [[ -n "$brief" ]] || return 0
  # Delivery verification (vstack#1173): a first-run dialog (theme / trust /
  # browser integration) can consume the CLI-arg brief, leaving a healthy TUI
  # at an empty composer while the launch looks successful. Confirm the brief
  # actually reached the TUI; if not, re-send it once into the composer and
  # re-verify; if still absent, fail this lane loudly instead of reporting
  # success. Sibling of the codex kickoff fix in vstack#976.
  tmux_verify_brief "$pane" "$brief" && return 0
  if ! tmux_wait_composer "$pane"; then
    echo "Error: '$title' never reached a ready composer (first-run dialog stuck?) — attach and start it manually: $brief" >&2
    return 1
  fi
  if ! tmux send-keys -t "$pane" -l "$brief" || ! tmux send-keys -t "$pane" Enter; then
    echo "Error: tmux send-keys failed re-delivering the brief to '$title'" >&2
    return 1
  fi
  if tmux_verify_brief "$pane" "$brief"; then
    echo "Re-delivered brief to '$title' (initial CLI-arg prompt was consumed at boot)"
    return 0
  fi
  echo "Error: brief undelivered to '$title' after one re-send — the session is likely sitting at a first-run dialog or an empty composer. Attach and start it manually: $brief" >&2
  return 1
}

open_gui() {
  local dir="$1" title="$2" cmd="$3"
  local shell_cmd="cd '$dir' && $cmd"
  if command -v ghostty >/dev/null 2>&1; then
    setsid env -u CLAUDECODE ghostty --working-directory="$dir" --title="$title" -e bash -lc "$shell_cmd" </dev/null >/dev/null 2>&1 &
  elif command -v xdg-terminal-exec >/dev/null 2>&1; then
    setsid env -u CLAUDECODE xdg-terminal-exec bash -lc "$shell_cmd" </dev/null >/dev/null 2>&1 &
  else
    echo "Error: no supported GUI terminal found" >&2
    return 1
  fi
  echo "Opened terminal '$title' in $dir"
}

repo="$(resolve_repo)"
launched=0
failed=0
skipped=0
attempted=0
# The DISTINCT lanes this run launched on, so the summary cannot attribute a
# spread batch to whichever lane happened to be last — nor inflate the count
# when a re-pick returns to a lane already used.
lanes_seen=""
[[ -z "$LANE_ENV" ]] || lanes_seen="$LANE_ENV"$'\n'
for raw in "${ITEMS[@]}"; do
  item="$raw"
  if [[ "$TRACKER" == "linear" ]]; then
    # Validate case-insensitively, then normalize to whichever case the
    # configured GH_ISSUE_PATTERN accepts, so lowercase-convention projects
    # (e.g. GH_ISSUE_PATTERN="cc-[0-9]+") work without forcing uppercase.
    item_upper="$(printf '%s' "$raw" | tr '[:lower:]' '[:upper:]')"
    item_lower="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]')"
    if [[ "$item_upper" =~ ^$GH_ISSUE_PATTERN$ ]]; then
      item="$item_upper"
    elif [[ "$item_lower" =~ ^$GH_ISSUE_PATTERN$ ]]; then
      item="$item_lower"
    elif [[ "$raw" =~ ^$GH_ISSUE_PATTERN$ ]]; then
      item="$raw"
    else
      echo "Error: invalid issue id: $raw" >&2; exit 1
    fi
    wt_id="$item"
    title="$item"
  else
    [[ "$item" =~ ^[0-9]+$ ]] || { echo "Error: GitHub item must be an issue number: $raw" >&2; exit 1; }
    [[ -n "$repo" ]] || { echo "Error: --repo OWNER/REPO required when gh repo cannot resolve" >&2; exit 1; }
    wt_id="issue-$item"
    title="gh-$item"
  fi
  # `--lane auto` is re-resolved for every item after the first: the claim the
  # previous window recorded is what moves this item off that account, and a
  # single upfront pick puts a whole batch on one lane. The trigger is "an
  # earlier item was attempted", never "an earlier item succeeded" — a window
  # that was created and then failed its brief still holds that account, and
  # its claim must still be read. Still ahead of this item's worktree, so a
  # stopped batch leaves no orphan tree behind. A pick that can no longer
  # prove a lane stops the batch rather than launching onto an account nothing
  # vouched for. tmux only: a claim's liveness handle is a pane, so on a GUI
  # surface a re-pick would re-read numbers nothing has moved.
  attempted=$((attempted + 1))
  if [[ "$LANE_AUTO" == true && "$TERMINAL_MODE" == "tmux" && "$attempted" -gt 1 ]]; then
    lane_rc=0
    next_lane="$(pick_auto_lane)" || lane_rc=$?
    if [[ "$lane_rc" -ne 0 ]]; then
      if [[ "$lane_rc" -eq 3 ]]; then
        echo "Error: no $LANE_HARNESS lane under ${LANE_MAX_PCT}% used for $item; stopping after $launched launch(es)." >&2
      else
        echo "Error: could not re-resolve a lane for $item (lanes exited $lane_rc); stopping after $launched launch(es)." >&2
      fi
      failed=$((failed + 1))
      break
    fi
    if [[ "$next_lane" == *"'"* ]]; then
      echo "Error: lane config dir contains a single quote; cannot render a safe launch command: $next_lane" >&2
      failed=$((failed + 1))
      break
    fi
    if [[ "$next_lane" != "$LANE_ENV" ]]; then
      LANE_ENV="$next_lane"
      echo "Lane: $LANE_ENV"
    fi
    grep -qxF -- "$LANE_ENV" <<<"$lanes_seen" || lanes_seen+="$LANE_ENV"$'\n'
  fi
  # The worktree create is the ownership claim: exit 75 means another session
  # holds this item, which skips it without touching its siblings. Any other
  # failure is this item's alone — the batch continues so one broken item
  # cannot silently prevent the rest of a fleet launch.
  # A relaunch re-enters the item's own worktree, which the first launch
  # already created: bare create reads an existing tree as a claim and exits
  # 75, so the replacement session would be skipped instead of launched.
  # `create --reuse` is the reuse assertion, and it still exits 75 on a lease
  # held under another owner — a live foreign claim stays a skip. It requires
  # the tree to exist, so a relaunch after cleanup takes the bare form.
  create_args=("$wt_id")
  if [[ "$RELAUNCH" == true && "$("$WORKTREE_CLI" exists "$wt_id" 2>/dev/null || true)" == "true" ]]; then
    create_args+=(--reuse)
  fi
  create_rc=0
  wt="$("$WORKTREE_CLI" create "${create_args[@]}")" || create_rc=$?
  if [[ "$create_rc" -eq 75 ]]; then
    echo "Skipped $item: owned by another session (worktree create exit 75)" >&2
    skipped=$((skipped + 1))
    continue
  elif [[ "$create_rc" -ne 0 ]]; then
    echo "Error: worktree create failed for $item (exit $create_rc)" >&2
    failed=$((failed + 1))
    continue
  fi
  cmd="$(start_cmd "$item" "$repo")"
  # The brief the claude arms pass as the initial CLI prompt, restated for the
  # tmux delivery check (and its one re-send). Empty for other harnesses and
  # custom --cmd templates, which disables the check.
  brief=""
  if [[ -z "$CMD_TEMPLATE" && "$HARNESS" == "claude" ]]; then
    if [[ "$TRACKER" == "linear" ]]; then brief="/orch start $item$BRIEF_TERMINAL_CONDITION"; else brief="/orch start github $repo#$item$BRIEF_TERMINAL_CONDITION"; fi
  fi
  # The lane is recorded in the launched command itself, so `ps` and the tmux
  # window both show which account a stalled session belongs to. The value is
  # single-quoted in the rendered command: lane dirs are paths, and an unquoted
  # space would split the env assignment inside the launch shell. A quote-
  # bearing lane dir was refused at lane resolution, before any worktree.
  if [[ -n "$LANE_ENV" ]]; then
    cmd="env ${LANE_ENV%%=*}='${LANE_ENV#*=}' $cmd"
  fi
  if [[ "$TERMINAL_MODE" == "tmux" ]]; then
    open_tmux "$wt" "$title" "$cmd" "$brief" || { failed=$((failed + 1)); continue; }
  else
    open_gui "$wt" "$title" "$cmd" || { failed=$((failed + 1)); continue; }
  fi
  launched=$((launched + 1))
done

skipped_note=""
[[ "$skipped" -eq 0 ]] || skipped_note=", skipped $skipped (owned by another session)"
if [[ "$failed" -gt 0 ]]; then
  echo "Error: $failed handoff lane(s) failed; launched $launched successfully$skipped_note." >&2
  exit 1
fi
if [[ "$launched" -eq 0 && "$skipped" -gt 0 ]]; then
  echo "Done: launched 0 handoff session(s)$skipped_note." >&2
  exit 75
fi
lanes_used="$(grep -c . <<<"$lanes_seen" || true)"
if [[ "$lanes_used" -gt 1 ]]; then
  # A re-picked batch ran on several accounts; naming the last one would
  # attribute every session to a lane most of them never touched.
  echo "Done: launched $launched handoff session(s)$skipped_note across $lanes_used lanes (see the Lane: lines above)."
elif [[ -n "$LANE_ENV" ]]; then
  echo "Done: launched $launched handoff session(s)$skipped_note on lane $LANE_ENV."
else
  echo "Done: launched $launched handoff session(s)$skipped_note."
fi
