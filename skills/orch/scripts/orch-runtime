#!/usr/bin/env bash
# Run the orch-runtime binary that matches the shipped sources beside this
# script. Every argument goes to the binary; its --help is the contract.
#
# The binary is <cache>/bin/orch-runtime-<key>, the one scripts/setup placed
# for these sources: the key and the cache layout are agent-runtime's
# lib/key.sh, the required sibling beside this package, and the key covers
# this crate's inputs and agent-runtime's. When the binary is absent this
# wrapper builds nothing: it prints
#   orch-runtime: setup-required key=<key> run=<path to scripts/setup>
# on stderr and exits 69; a caller that must answer meanwhile starts it with
# `setup --detach`. A copy outside the sibling layout is refused first, exit 2:
#   orch-runtime: dependency-absent skill=agent-runtime path=<key.sh>
set -euo pipefail

here="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)"
key_lib="$here/../../agent-runtime/scripts/lib/key.sh"
if [ ! -r "$key_lib" ]; then
  printf 'orch-runtime: dependency-absent skill=agent-runtime path=%s\n' "$key_lib" >&2
  exit 2
fi

refuse() { # KEY FIELD=VALUE...
  local key="$1"
  shift
  printf 'orch-runtime: %s%s\n' "$key" "${*:+ $*}" >&2
  exit 1
}

# shellcheck source=../../agent-runtime/scripts/lib/key.sh
. "$key_lib"

runtime="$(cd -- "$here/../runtime" 2>/dev/null && pwd -P)" || refuse runtime-missing "runtime=$here/../runtime"
cache="$(agent_runtime_cache)"
key="$(agent_runtime_key "$runtime")"
binary="$cache/bin/orch-runtime-$key"
if [ ! -x "$binary" ]; then
  printf 'orch-runtime: setup-required key=%s run=%s\n' "$key" "$here/setup" >&2
  exit 69
fi
exec "$binary" "$@"
