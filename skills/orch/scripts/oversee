#!/usr/bin/env bash
# oversee register [--account DIR]: the runtime's `register --fleet`, which
# records the controller a person opened by hand in the pane this runs in.
# The runtime owns the arguments, the answer and the record write.
set -euo pipefail
here="$(cd -- "${BASH_SOURCE[0]%/*}" && pwd -P)"
if [[ "${1:-}" != register ]]; then
  printf 'oversee: unknown-command command=%s\nThe command is register: orch-runtime register --fleet.\n' "${1:-}" >&2
  exit 2
fi
shift
exec "${ORCH_RUNTIME_CLI:-$here/orch-runtime}" register --fleet "$@"
