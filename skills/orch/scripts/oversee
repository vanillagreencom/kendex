source "$SCRIPT_DIR/lib/gh-repo.sh"
# The orch runtime a first launch hands its start-controller request to; the
# wrapper beside this script runs the binary scripts/setup placed for these
# sources.
ORCH_RUNTIME="${ORCH_RUNTIME_CLI:-$SCRIPT_DIR/orch-runtime}"


# The runtime, held to tmux by the library both launchers share: this
# launcher reads the new session's account off its pane.
if ! ol_runtime_supported; then
  [[ "$OL_REASON" != runtime-unsupported ]] || die runtime-unsupported "host=$OL_RUNTIME"
  die launch-failed step=host-resolve
fi

# The oversee state, where the record lives, its path in STATE_PATH: created
# for a fresh fleet, read for every other. One refusal for both, naming the
# path. A resume creates none: a fresh state records no overseer to resume.
STATE_PATH=""
state_ready() {
  STATE_PATH="$("$SCRIPT_DIR/workflow-state" path oversee 2>"$DEP_ERR")" || die state-unwritable state=oversee
  if ! "$SCRIPT_DIR/workflow-state" exists oversee >/dev/null 2>"$DEP_ERR"; then
    [[ "$COMMAND" != resume ]] || die state-missing "path=$STATE_PATH"
    "$SCRIPT_DIR/workflow-state" init oversee >/dev/null 2>"$DEP_ERR" || die state-unwritable "path=$STATE_PATH"
  fi
  ol_record_read || die state-unwritable "path=$STATE_PATH"
}

# ---------------------------------------------------------------------------
# register
# ---------------------------------------------------------------------------
register() {
  key="$(lane_context_caller_key)" || die pane-unreadable "pane=$TMUX_PANE" field=pid
  matches "$key" '^([0-9]+)[[:blank:]]+(%[0-9]+)$' || die pane-unreadable "pane=$TMUX_PANE" field=pid "value=$key"
  server="${key%% *}"
  window="$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>"$DEP_ERR")" \
    || die pane-unreadable "pane=$TMUX_PANE" field=window_id
  # The launch identity a hand-opened session can state, from what its own
  # harness said at its start where its SessionStart row stands
  # (lib/session-rows.sh): the harness its hook install names, the account its
  # environment carries, its model and its directory. A Copilot session's
  # account is the COPILOT_HOME it runs under, where its context reader must
  # live, so the reader below is installed there. Nothing here launched
  # it, so no effort is known. Where no row stands, a harness with no such
  # hook or a session started before its install, the pane's foreground
  # process and directory are read instead, the named fallback, said as
  # `identity-fallback`, and no model is known.
  model="" start_rc=0
  session_rows_start "$(session_rows_overseer_file "$PWD" "$server" "$TMUX_PANE")" || start_rc=$?
  if (( start_rc == 0 )) && [[ -n "$SR_HARNESS" && -n "$SR_CWD" ]]; then
    cwd="$SR_CWD" model="$SR_MODEL" shape="$SR_HARNESS"
    [[ -n "$ACCOUNT" ]] || ACCOUNT="$SR_ACCOUNT"
  else
    cause=no-start-row
    [[ "$start_rc" -ne 2 ]] || cause=unreadable
    message identity-fallback "session=$TMUX_PANE" "cause=$cause" >&2
    cwd="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_current_path}' 2>"$DEP_ERR")" \
      || die pane-unreadable "pane=$TMUX_PANE" field=pane_current_path
    cmd="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_current_command}' 2>"$DEP_ERR")" \
      || die pane-unreadable "pane=$TMUX_PANE" field=pane_current_command
    pane_pid="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_pid}' 2>"$DEP_ERR")" \
      || die pane-unreadable "pane=$TMUX_PANE" field=pane_pid
    # A Copilot pane is named, and its account read off its own Copilot
    # process, by lib/lane-context.sh § lane_context_pane_shape. --account
    # outranks that account; the one lane_context_caller_cfg derives reads the
    # Claude and Codex variables and so answers for no Copilot pane.
    lane_context_pane_shape "${cmd#-}" "$pane_pid" \
      || die pane-unreadable "pane=$TMUX_PANE" field=process-table
    shape="$LANE_PANE_SHAPE"
    if [[ "$shape" == copilot ]]; then
      ACCOUNT="${ACCOUNT:-$LANE_PANE_ACCOUNT}"
    elif [[ -z "$ACCOUNT" ]]; then
      ACCOUNT="$(lane_context_caller_cfg "$shape")"
    fi
  fi
  # The home its own variable carries where that is a private codex home, and
  # the account otherwise.
  harness="" home="$ACCOUNT"
  case "$shape" in
    claude) harness=claude ;;
    codex) harness=codex; home="${CODEX_HOME:-$ACCOUNT}" ;;
    copilot) harness=copilot ;;
    both) ;;
    *) harness="$shape" ;;
  esac
  ol_identity "$harness" "$ACCOUNT" "$home" "$model" "" "$cwd" || die record-unwritten field=overseer step=identity
  ol_record_write tmux "$TMUX_PANE" "$window" "$server" "$OL_IDENTITY" "" \
    || die record-unwritten field=overseer
  # The writer retains unknown fields only for this same session. Check that
  # resulting identity, not the fallback's empty fields.
  record="$(ol_record_get)" || die state-unreadable field=overseer
  fields="$(jq -r '[.harness // "", .home // "", .cwd // ""] | join("\u001f")' <<<"$record" 2>"$DEP_ERR")" \
    || die state-unreadable field=overseer
  IFS=$'\x1f' read -r harness home cwd <<<"$fields"
  if [[ "$harness" == copilot ]]; then
    reader_before=missing
    ! copilot_context_reader "$home" || reader_before=present
    if copilot_context_install "$home"; then
      [[ "$reader_before" != missing || "$COPILOT_CONTEXT_MODE" != extension ]] \
        || message context-reader=next-start "home=$home" >&2
    else
      message context-reader=missing "home=$home" "file=$COPILOT_CONTEXT_FILE" "detail=$COPILOT_CONTEXT_DETAIL" \
        "cause=${COPILOT_CONTEXT_CAUSE:-none}" >&2
    fi
    if ! copilot_hooks_gate "$cwd" "$home"; then
      message turn-end-hook=missing harness=copilot "reason=$COPILOT_HOOK_REASON" \
        'fix=add copilot to [install] harnesses in kendex.toml and run kendex apply' >&2
      [[ -z "$COPILOT_HOOK_ERROR" ]] || printf '%s\n' "$COPILOT_HOOK_ERROR" >&2
    fi
  elif [[ -n "$harness" ]]; then
    # kendex owns the inventory for every non-Copilot harness. `kendex list`
    # has no structured output format, so its table, on stderr, is the one
    # interface: columns kind, name, harness, scope and optional state, a
    # hook's name reading event:matcher:name, its own name after the last colon.
    # It is asked in the checkout this record belongs to, whose install the
    # hook comes from: the recorded cwd is the session's working directory as
    # its start row stated it, which can be a lane worktree, a directory
    # outside the checkout or one gone since, none of which lists the hook.
    inventory_rc=0
    inventory="$(cd -- "$PROJECT_ROOT" && kendex list --harness "$harness" 2>&1)" || inventory_rc=$?
    if [[ "$inventory_rc" != 0 ]] || ! awk -v h="$harness" \
        '$1 == "hook" && $3 == h && NF == 4 { n = $2; sub(/.*:/, "", n); if (n == "lane-mail-check") found=1 }
         END { exit !found }' <<<"$inventory"; then
      message turn-end-hook=missing "harness=$harness" "exit=$inventory_rc" \
        "fix=add $harness to [install] harnesses in kendex.toml and run kendex apply" >&2
      [[ "$inventory_rc" == 0 ]] || printf '%s\n' "$inventory" >&2
    fi
  fi
  message registered "session=$TMUX_PANE" "window=$window" "server=$server" \
    "generation=$OL_GENERATION" "account=${ACCOUNT:-none}" \
    "retained=$OL_RECORD_RETAINED" "fresh=$OL_RECORD_FRESH"
  exit 0
}

# ---------------------------------------------------------------------------
# The flag words a resume relaunches the recorded session under
# ---------------------------------------------------------------------------
# The question-tool words a launch adds, into QUESTION_OFF: the setting is
# their one owner.
QUESTION_OFF=()
question_off_read() {
  local question_policy
  question_policy="$(launch_overseer_question_tool)" \
    || die invalid-question-tool "ORCH_QUESTION_TOOL=${ORCH_QUESTION_TOOL:-}"
  QUESTION_OFF=()
  [[ "$question_policy" != off ]] || QUESTION_OFF=(--question-off)
}

# The flag words a relaunch of the session RECORD names runs under, into
# OL_FLAGS: its HARNESS, MODEL and EFFORT, where a Claude record's launch line
# gives the executable model in place of the record's comparison form, which
# drops an exact id's window, and its recorded permission posture. Returns 1
# with ol_launch_flags's OL_REASON and OL_FIELDS.
record_flags() { # RECORD HARNESS MODEL EFFORT
  local record="$1" harness="$2" model="$3" effort="$4" line
  if [[ "$harness" == claude ]]; then
    line="$(jq -r '.launch_line // ""' <<<"$record" 2>"$DEP_ERR")" || die state-unwritable field=overseer
    if [[ -n "$line" ]] && ol_command_read claude "$line" && [[ -n "$OL_COMMAND_MODEL" ]]; then
      model="$OL_COMMAND_MODEL"
    fi
  fi
  ol_record_permission "$record" "$harness" \
    || { OL_REASON=launch-choice-failed; OL_FIELDS=(reason=permission-unrecorded "harness=${harness:-none}" "word=$(launch_choice_permission_write "$harness" || true)"); return 1; }
  ol_launch_flags ${QUESTION_OFF[@]+"${QUESTION_OFF[@]}"} "$harness" "$model" "$effort" "" "$harness" \
    ${OL_PERMISSION_FLAGS[@]+"${OL_PERMISSION_FLAGS[@]}"}
}


# ---------------------------------------------------------------------------
# launch
# ---------------------------------------------------------------------------
# A succession opens in its predecessor's session and names no tmux session; the
# server is still the one lib/tmux-server.sh's rule reaches.
if [[ "$COMMAND" == register || -n "$PREDECESSOR" ]]; then
  [[ "$COMMAND" != register || -n "${TMUX_PANE:-}" ]] || die tmux-missing var=TMUX_PANE
  SERVER_SOCKET="$(tmux_server_socket)" || die tmux-missing var=TMUX
else
  [[ -n "$SESSION_NAME" ]] || SESSION_NAME="${ORCH_TMUX_SESSION:-}"
  if [[ -z "$SESSION_NAME" ]]; then
    repo_rc=0
    repo_name="$(GH_REPO= orch_resolve_gh_repo "$PROJECT_ROOT")" || repo_rc=$?
    case "$repo_rc" in
      0) SESSION_NAME="${repo_name#*/}" ;;
      1) SESSION_NAME="${PROJECT_ROOT##*/}" ;;
      *) die session-unresolved "repo=$repo_name" ;;
    esac
  fi
  # The server every tmux call below reaches, named on every line: the rule is
  # lib/tmux-server.sh's, answered for the session just resolved.
  export ORCH_TMUX_SESSION="$SESSION_NAME"
  SERVER_SOCKET="$(tmux_server_socket)" || die tmux-missing var=TMUX
  # The one reading of tmux's answer is lib/tmux-server.sh's: absent is a
  # missing session, anything else the call failing.
  probe=0
  tmux_session_present "$SESSION_NAME" || probe=$?
  if (( probe )); then
    printf '%s\n' "$TMUX_SESSION_DETAIL" > "$DEP_ERR"
    [[ "$probe" -eq 3 ]] || die tmux-failed operation=has-session "server=$SERVER_SOCKET"
    die tmux-session-missing "session=$SESSION_NAME" "server=$SERVER_SOCKET"
  fi
fi

state_ready
# A live overseer: the record names a tmux session, and the runtime's
# `inspect` of it answers a live state on a server the record names it on by
# `ol_names`: that server pid, started when the record says. A record naming
# a session the runtime no longer lists, or one an earlier server handed the
# same pid and pane held, is a stopped fleet's, and the launch takes the next
# generation over it. A record carrying no server start names no session, but
# a pane it records live on that server pid may be the running overseer, so
# nothing is opened beside it: live_pane is the pane that blocks a launch,
# named_pane the one the record names. A live one is launched over only as
# the predecessor --predecessor names, and a predecessor is only ever the
# named one: the session a succession stops is the one the fleet records as
# its overseer on this very server, never another pane, and never a pane a
# startless record names, which a later server may have handed the same pid
# and pane id.
if ! live="$(jq -r 'if type == "object" and (.runtime // "tmux") == "tmux" and (.pane // "") != ""
    then (.pane + " " + ((.generation // 0) | tostring)) else "" end' <<<"$OL_PRIOR" 2>"$DEP_ERR")"; then
  die state-unwritable field=overseer
fi
live_pane="" named_pane=""
if [[ -n "$live" ]]; then
  read -r live_pane live_generation <<<"$live"
fi
register_self=0
if [[ "$COMMAND" == register && -n "$live_pane" && "$live_pane" == "${TMUX_PANE:-}" ]]; then
  caller_server="$(tmux display-message -p -t "$TMUX_PANE" '#{pid}' 2>"$DEP_ERR")" \
    || die launch-failed step=server "session=$TMUX_PANE" "server=$SERVER_SOCKET"
  recorded_server="$(jq -r '.server // empty' <<<"$OL_PRIOR" 2>"$DEP_ERR")" || die state-unwritable field=overseer
  [[ "$recorded_server" != "$caller_server" ]] || register_self=1
fi
if [[ -n "$live_pane" && "$register_self" == 0 ]]; then
  ol_session_inspect "$live_pane" || die launch-failed step=inspect
  if [[ "$OL_INSPECT_STATE" == gone ]]; then
    live_pane=""
  else
    # A start that cannot be read cannot tell the recorded overseer from a
    # session an earlier server's pid and pane id left, so nothing is opened
    # beside a pane that may be it.
    live_start="${OL_INSPECT_START:-}"
    [[ -n "$live_start" ]] || live_start="$(ol_session_start "$OL_INSPECT_SERVER" "$live_pane")" \
      || die launch-failed step=server-start "session=$live_pane" "server=$SERVER_SOCKET"
    if ! live_named="$(jq -r --arg server "$OL_INSPECT_SERVER" --arg start "$live_start" --arg pane "$live_pane" \
      "$OL_JQ_DEFS"' [ol_names($server; $start; $pane), ol_owns($server; $start; $pane)]
        | map(tostring) | join(" ")' <<<"$OL_PRIOR" 2>"$DEP_ERR")"; then
      die state-unwritable field=overseer
    fi
    read -r live_named live_blocks <<<"$live_named"
    if [[ "$live_named" == true && -n "$PREDECESSOR" ]]; then
      predecessor_server="$(tmux display-message -p '#{pid}' 2>"$DEP_ERR")" \
        || die launch-failed step=server "server=$SERVER_SOCKET"
      [[ "$OL_INSPECT_SERVER" != "$predecessor_server" ]] || named_pane="$live_pane"
    fi
    [[ "$live_blocks" == true ]] || live_pane=""
  fi
fi
[[ -z "$PREDECESSOR" || "$named_pane" == "$PREDECESSOR" ]] \
  || die predecessor-not-live "session=$PREDECESSOR" "live=${named_pane:-none}" "server=$SERVER_SOCKET"
[[ "$register_self" == 0 ]] || live_pane=""
[[ -z "$live_pane" || -n "$PREDECESSOR" ]] \
  || die overseer-live "session=$live_pane" "server=$SERVER_SOCKET" "generation=$live_generation"

if [[ "$COMMAND" == register ]]; then register; fi

# resume's steps 4 and 5: the command built out of the launch identity the
# record OL_PRIOR holds, into OL_CMD, RESUME_LINE, OL_HARNESS and lane_dir,
# and CWD the directory the session started in.
RESUME_LINE="" RESUME_ID=""
resume_line() {
  local fields generation account model effort recorded_cwd
  fields="$(jq -r '[.generation, .session_id, .harness, .account, .model, .effort, .cwd, .class]
    | map(. // "" | tostring) | join("\u001f")' <<<"$OL_PRIOR" 2>"$DEP_ERR")" || die state-unwritable field=overseer
  IFS=$'\x1f' read -r generation RESUME_ID OL_HARNESS account model effort recorded_cwd OL_MODEL_CLASS <<<"$fields"
  [[ -n "$RESUME_ID" ]] || die session-id-unrecorded "generation=${generation:-none}" "path=$STATE_PATH"
  # The directory as a launch resolves --cwd: a start directory gone since
  # refuses here, where tmux would open the pane in $HOME.
  [[ -n "$recorded_cwd" ]] && CWD="$(cd -- "$recorded_cwd" 2>/dev/null && pwd -P)" \
    || die invalid-cwd "dir=${recorded_cwd:-none}"
  record_flags "$OL_PRIOR" "$OL_HARNESS" "$model" "$effort" \
    || die "$OL_REASON" "session_id=$RESUME_ID" ${OL_FIELDS[@]+"${OL_FIELDS[@]}"}
  lane_dir="$account"
  if ! ol_command_line --resume "$RESUME_ID" "$OL_HARNESS" "$HANDOFF" "$lane_dir" "$CWD" ${OL_FLAGS[@]+"${OL_FLAGS[@]}"}; then
    [[ "$OL_REASON" != resume-unsupported ]] || die resume-unsupported "harness=${OL_HARNESS:-none}"
    die launch-trust-missing "lane=$lane_dir" "dir=$CWD" "reason=$OL_TRUST_REASON"
  fi
  RESUME_LINE="$OL_CMD"
  # The record's launch line is the fresh command for the same identity: a
  # successor or a dead-pane relaunch replaying it never resumes a session
  # that has since ended or handed over.
  ol_command_line "$OL_HARNESS" "$HANDOFF" "$lane_dir" "$CWD" ${OL_FLAGS[@]+"${OL_FLAGS[@]}"} \
    || die launch-trust-missing "lane=$lane_dir" "dir=$CWD" "reason=$OL_TRUST_REASON"
}

question_off_read
if [[ "$COMMAND" == resume ]]; then
  resume_line
else
  HEADROOM_TRIGGER="${ORCH_OVERSEER_HEADROOM_PCT:-10}"
  matches "$HEADROOM_TRIGGER" '^[0-9]{1,3}$' && (( 10#$HEADROOM_TRIGGER <= 100 )) \
    || die invalid-headroom-trigger "ORCH_OVERSEER_HEADROOM_PCT=$HEADROOM_TRIGGER"
  HEADROOM_TRIGGER=$((10#$HEADROOM_TRIGGER))
  ol_preference_entries "$(ol_preference)" || die invalid-preference "entry=$OL_BAD_ENTRY"
  (( OL_NAMED > 0 )) || die preference-empty setting=ORCH_OVERSEER_PREFERENCE

  predecessor_harness="" predecessor_flags=()
  if [[ -n "$PREDECESSOR" ]]; then
    predecessor_harness="$(jq -r '.harness // ""' <<<"$OL_PRIOR" 2>"$DEP_ERR")" || die state-unwritable field=overseer
    ol_record_permission "$OL_PRIOR" "$predecessor_harness" \
      || die launch-choice-failed reason=permission-unrecorded "harness=${predecessor_harness:-none}" "word=$(launch_choice_permission_write "$predecessor_harness" || true)"
    predecessor_flags=(${OL_PERMISSION_FLAGS[@]+"${OL_PERMISSION_FLAGS[@]}"})
    OL_WALK_SOURCE_HARNESS="$predecessor_harness" OL_WALK_SOURCE_FLAGS="${predecessor_flags[*]+${predecessor_flags[*]}}"
  fi

  # The walk and the flags are lib/overseer-launch.sh's ol_walk and
  # ol_launch_flags, the ones `oversee-succeed` takes. Every entry here is a
  # preference entry. A first launch writes the table's posture; a successor
  # carries the predecessor's recorded posture through the same walk.
  rc=0
  ol_walk "$HEADROOM_TRIGGER" "" "${OL_ENTRIES[@]}" || rc=$?
  for skip in ${OL_WALK_SKIPS[@]+"${OL_WALK_SKIPS[@]}"}; do
    IFS=$'\t' read -r -a fields <<<"$skip"
    message "${fields[@]}" >&2
  done
  case "$rc" in
    0) ;;
    3) die_status 3 no-lane-qualifies "entries=$OL_NAMED" \
         "walled=$OL_WALKED_WALLED" "unmeasured=$OL_WALKED_UNMEASURED" ;;
    *) die "$OL_REASON" "${OL_FIELDS[@]}" ;;
  esac
  ol_launch_flags ${QUESTION_OFF[@]+"${QUESTION_OFF[@]}"} "$OL_HARNESS" "$OL_MODEL" "$OL_EFFORT" "$OL_PICK_MODEL" "${predecessor_harness:-}" \
    ${predecessor_flags[@]+"${predecessor_flags[@]}"} \
    || die "$OL_REASON" "entry=$OL_CHOSEN" ${OL_FIELDS[@]+"${OL_FIELDS[@]}"}
  lane_dir="$OL_LANE_DIR"
  ol_command_line "$OL_HARNESS" "$HANDOFF" "$lane_dir" "$CWD" ${OL_FLAGS[@]+"${OL_FLAGS[@]}"} \
    || die launch-trust-missing "lane=$lane_dir" "dir=$CWD" "reason=$OL_TRUST_REASON"
fi

# Every failure from here closes the session and puts the record back: the
# close-out is the library's ol_session_abandon, the words are this script's.
abandon() {
  ol_session_abandon || { message record-unwritten field=overseer step=restore >&2; [[ -z "$OL_DETAIL" ]] || printf '%s\n' "$OL_DETAIL" >&2; }
  die "$@"
}
# A signal that lands during the runtime's create runs its trap once the call
# returns; ol_session_abandon inside abandon reads the session off the
# provider's answer and closes it, so it is named here only where create had
# already returned it.
interrupted() { # SIGNAL
  abandon interrupted "session=${OL_SESSION:-none}" "signal=$1"
}
trap 'interrupted TERM' TERM
trap 'interrupted INT' INT
trap 'interrupted HUP' HUP

# This script's words at each step of a launch: the ones
# lib/overseer-launch.sh's ol_succession asks for, which the first launch
# below says at the same points of its own steps. A record write that fails
# refuses the succession before its commit point, as it refuses a first
# launch.
ol_succession_hook() { # STEP
  case "$1" in
    pending-unrecorded | record-unwritten) return 1 ;;
    opened)
      SESSION="$OL_SESSION"
      message overseer-launch "form=$OL_FORM" "lane=$lane_dir" "trust=$OL_TRUST_ROUTE" \
        "session=$SESSION" "window=$OL_WINDOW" "server=$SERVER_SOCKET" ;;
    verified)
      [[ -z "$OL_UNOBSERVED" ]] || message overseer-lane-unobserved "reason=$OL_UNOBSERVED" >&2 ;;
  esac
}
# ol_session_verify's refusals, each closing the session and putting the
# record back.
refuse_unverified() {
  case "$OL_REASON" in
    wrong-lane) abandon overseer-wrong-lane "picked=$lane_dir" "observed=$OL_OBSERVED" ;;
    result-unknown) abandon overseer-lane-unknown "result=$OL_RESULT" ;;
    dialog) abandon overseer-dialog "session=$SESSION" "waited=$OL_WAITED" ;;
    not-working) abandon overseer-not-working "session=$SESSION" "waited=$OL_WAITED" ;;
    inspect-failed) abandon launch-failed "step=$OL_STEP" ;;
    *) abandon launch-failed step=verify "reason=$OL_REASON" ;;
  esac
}

# A first launch is the runtime's `start-controller` (header step 6): this
# script hands on what it computed (the walk's pick and launch identity, the
# line it built and its bypass posture, the brief, and the fleet watch's
# words as the workflow's launch block spells them) and the runtime mints
# the record, opens the session, delivers the brief, launches the watch and
# publishes the controller. A runtime that is not set up refuses the launch;
# no session is opened in its place. The reply's effect report carries the
# recorded outcome: confirmed, with the record to read; unconfirmed, held
# with its note; failed before anything opened, with its note.
start_controller() {
  local state_abs since repo repo_rc=0 watch_words reply rc=0 key outcome note cause intent fields brief
  ol_checkout_sync "$CWD" || ol_checkout_notice
  state_abs="$STATE_PATH"
  [[ "$state_abs" == /* ]] || state_abs="$PWD/$state_abs"
  # `--since`: the first lane record's launched_at, else this launch's time
  # (../workflows/oversee.md § 4).
  since="$(jq -r '[.lanes[]? | .launched_at | strings] | min // empty' "$STATE_PATH" 2>"$DEP_ERR")" \
    || die state-unwritable "path=$STATE_PATH"
  [[ -n "$since" ]] || since="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  # `--repo`: the checkout's own repository; the connected repositories are
  # the runtime's own setting. A checkout naming none passes no --repo.
  repo="$(orch_resolve_gh_repo "$PROJECT_ROOT")" || repo_rc=$?
  case "$repo_rc" in
    0) ;;
    1) repo="" ;;
    *) die repo-unresolved "repo=$repo" ;;
  esac
  START_REQUEST="$(mktemp)" || die launch-failed step=mktemp
  # The brief, under the state directory's intents/ (the EXIT trap above says
  # why), named by this launch's stamp and pid and created exclusively, so two
  # launches never share one file and no file is written over.
  brief="${state_abs%/*}/intents"
  mkdir -p -- "$brief" || die launch-failed step=brief
  brief="$brief/start-controller.$(date -u +%Y%m%dT%H%M%SZ).$$.brief"
  ( set -o noclobber && printf '%s\n' "$OL_BRIEF" > "$brief" ) || die launch-failed step=brief
  # The words as a JSON array: `--args` takes each as one positional string,
  # so a flag word crosses whole; `--` ends jq's own option parsing.
  watch_words="$(jq -n '$ARGS.positional' --args -- "$SCRIPT_DIR/oversee-watch" --repeat 60 --state "$state_abs" \
    --interval 240 --since "$since" --harness "$OL_HARNESS" ${repo:+--repo "$repo"} -- ${OL_FLAGS[@]+"${OL_FLAGS[@]}"} 2>"$DEP_ERR")" \
    || die launch-failed step=request
  jq -cn --argjson identity "${OL_IDENTITY:-null}" --arg line "$OL_CMD" --arg brief "$brief" --argjson watch "$watch_words" '
    {op: "start-controller",
     controller: (($identity // {}) + {launch_line: $line, permission: "bypass"}),
     brief_file: $brief,
     watch: $watch}' > "$START_REQUEST" 2>"$DEP_ERR" || die launch-failed step=request
  reply="$(ORCH_TMUX_VERIFY_SECS="$WAIT_SECS" "$ORCH_RUNTIME" op --fleet --request "$START_REQUEST" 2>"$DEP_ERR")" || rc=$?
  if (( rc )); then
    key="$(sed -n '1s/^orch-runtime: \([^ ]*\).*/\1/p' "$DEP_ERR")"
    die start-refused "key=${key:-runtime-unavailable}" "exit=$rc"
  fi
  outcome="$(jq -r '.result.effect.report.intent.outcome // empty' <<<"$reply" 2>"$DEP_ERR")" || die start-refused key=reply-unread
  [[ -n "$outcome" ]] || die start-refused key=reply-unread
  fields="$(jq -r '.result.effect.report.intent | [(.id // "none"), (.observation.note // "none"), (.observation.cause // "none")] | join("\u001f")' <<<"$reply" 2>"$DEP_ERR")" \
    || die start-refused key=reply-unread
  IFS=$'\x1f' read -r intent note cause <<<"$fields"
  case "$outcome" in
    confirmed) ;;
    unconfirmed) die controller-unconfirmed "intent=$intent" "note=$note" "cause=$cause" ;;
    *) die launch-failed step=runtime "outcome=$outcome" "note=$note" ;;
  esac
  ol_record_read || die state-unwritable "path=$STATE_PATH"
  fields="$(jq -r '[(.pane // ""), (.window // ""), (.generation // "")] | map(tostring) | join("\u001f")' <<<"$OL_PRIOR" 2>"$DEP_ERR")" \
    || die state-unwritable "path=$STATE_PATH"
  IFS=$'\x1f' read -r SESSION OL_WINDOW OL_GENERATION <<<"$fields"
}

SESSION=""
if [[ -n "$PREDECESSOR" ]]; then
  # A succession is lib/overseer-launch.sh's ol_succession: the pending
  # record, the session opened at the base
  # index, the record, the verification and the predecessor's stop,
  # the commit point.
  if ! ol_succession "$PREDECESSOR" "$CWD" "$OL_CMD" "$OL_IDENTITY" pending \
      "$OL_LANE_VAR" "$lane_dir" "$OL_FORM" "$WAIT_SECS"; then
    case "$OL_REASON" in
      record-unwritten) abandon record-unwritten field=overseer "step=$OL_STEP" ;;
      create-failed) abandon launch-failed "step=$OL_REASON" ;;
      stop-failed) abandon close-failed "predecessor=$PREDECESSOR" ;;
      *) refuse_unverified ;;
    esac
  fi
elif [[ "$COMMAND" == resume ]]; then
  # A resume opens the recorded session's resume form itself, at the base
  # index, and a record it cannot write closes it again: nothing else would
  # tell it from any other session. The runtime's start-controller builds a
  # session's command from typed fields and has no resume form by session id
  # (header, resume), so this route keeps the library's session path.
  ol_session_open "$CWD" overseer "$RESUME_LINE" --session "$SESSION_NAME" || abandon launch-failed "step=$OL_REASON"
  ol_succession_hook opened
  ol_record_write "$OL_RUNTIME" "$SESSION" "$OL_WINDOW" "$OL_SERVER" "$OL_IDENTITY" "$OL_CMD" \
    || abandon record-unwritten field=overseer step=write
  ol_session_verify "$SESSION" "$OL_LANE_VAR" "$lane_dir" "$OL_FORM" "$WAIT_SECS" || refuse_unverified
  ol_succession_hook verified
else
  trap - HUP TERM INT
  start_controller
fi
trap - HUP TERM INT
if [[ "$COMMAND" == resume ]]; then
  message resumed "session=$SESSION" "window=$OL_WINDOW" "server=$SERVER_SOCKET" \
    "generation=$OL_GENERATION" "lane=${lane_dir:-none}" "session_id=$RESUME_ID"
  exit 0
fi
message overseer-launched "session=$SESSION" "window=$OL_WINDOW" "server=$SERVER_SOCKET" \
  "generation=$OL_GENERATION" "lane=$lane_dir" ${PREDECESSOR:+"predecessor=$PREDECESSOR"}
