#!/usr/bin/env bash
# oversee — the overseer session itself: launch one, or register one a person
# opened by hand.
#
# Usage:
#   oversee launch [--session NAME | --predecessor SESSION] [--cwd DIR]
#                  [--handoff PATH] [--wait-secs N]
#   oversee register [--account DIR]
#
#   launch   opens a fleet's FIRST overseer, or with --predecessor its
#            successor. A first launch is a succession launch with no
#            predecessor: the account walk, the flag words and every step
#            after them are lib/overseer-launch.sh's, the ones
#            `oversee-succeed` runs when it replaces an overseer at a mark,
#            so the two cannot choose, open, verify or record a session
#            differently. In order:
#     1. Resolve the runtime through `overseer-host resolve`
#        (ORCH_OVERSEER_HOST). This launcher reads the new session's account
#        off its tmux pane, so a runtime other than tmux refuses
#        `runtime-unsupported` here.
#     2. Resolve the tmux session the window opens in: --session, else
#        ORCH_TMUX_SESSION, else the checkout repository's name. A name
#        tmux does not hold refuses `tmux-session-missing`, and a has-session
#        call failing for any other reason, no server at the socket among
#        them, refuses `tmux-failed` naming the socket. The verb needs no
#        $TMUX: from outside tmux it reaches the person's own server, the
#        socket tmux derives from their uid (lib/tmux-server.sh), which every
#        line below names as `server=`. With --predecessor no session is
#        resolved, since the window opens in the predecessor's session, and
#        --session beside it refuses `option-conflict`.
#     3. Read the fleet state's `overseer` record (schemas/workflow-state.md),
#        creating the oversee state where a fresh fleet has none. The state,
#        like the settings, is --cwd's repository's: the launch moves there
#        before either is read, so the record it writes is the one the
#        launched overseer's hooks, watch and succession read. A record
#        naming a tmux session the adapter's `inspect` still finds on this
#        server is a live overseer, and a second one is never opened beside
#        it: `overseer-live` names
#        it and its generation. A live pane whose server start cannot be read
#        refuses `launch-failed step=server-start`: whether it is the
#        recorded overseer cannot be judged. A record carrying no server
#        start names no session, yet its pane live on the recorded server
#        pid refuses `overseer-live` too. Two overseers never act at once; a live one
#        is replaced as the --predecessor this launch names, or through
#        `oversee-succeed`, never launched over. --predecessor naming any
#        session but that live one refuses `predecessor-not-live`, its `live`
#        field the live overseer or `none` where none is recorded: a
#        succession stops the recorded overseer and no other pane. A record
#        carrying no server start names no predecessor, so --predecessor
#        over it refuses the same way until `oversee register` in its pane
#        binds it.
#     4. Walk ORCH_OVERSEER_PREFERENCE, comma-separated `harness:model:effort`
#        entries, in order, and open on the first whose harness has a lane
#        above ORCH_OVERSEER_HEADROOM_PCT: the entry names its model in the
#        characters kendex.settings.toml.example § Fleet states, an entry
#        naming none refusing `invalid-preference`, and unset the setting is
#        lib/overseer-launch.sh's OL_DEFAULT_PREFERENCE. The old
#        `harness:positive-integer:effort` form is deprecated and read until
#        the next major release. It uses the caller's model
#        and warns once per run; a first launch has no caller. The walk is
#        that file's ol_walk, and `lanes pick` names the lane, judged on the bucket that
#        walls that model and held to the reading the session will take of
#        itself (lib/overseer-launch.sh § ol_pick_lane). An entry with no
#        qualifying lane is skipped, and so is one whose harness row names no
#        full-bypass word to launch it under, pi's, before its pick, with
#        `entry-permission-unwritable` on stderr. A copilot entry accepts the
#        extension set up by the shared installer; only explicit
#        `EXTENSIONS=false` requires the copilot-statusline statusLine fallback.
#        Setup failure skips the entry with `successor-status-line` on stderr;
#        a preference set to empty
#        refuses `preference-empty`, because a first launch has no caller
#        whose own harness and lane could stand in; a walk that ends empty
#        refuses `no-lane-qualifies` at exit 3 with the counts each sweep found.
#     5. Build the command through lib/overseer-launch.sh's ol_launch_flags:
#        the entry's model and effort words, the harness's full-bypass
#        permission words, its launch settings, the compaction words for the
#        entry's model, its question-tool words where ORCH_QUESTION_TOOL is
#        off, its default, and the brief naming --handoff. A claude model the
#        adapter names no window for refuses `model-window-unknown`, since the
#        overseer runs with compaction off. An unattended overseer takes no
#        flags from the caller:
#        the words are spelled per harness by lib/lane-launch.sh's table, so a
#        preference that names two harnesses is never handed one harness's
#        spelling for the other. The launch is made trusted for --cwd
#        first, refusing `launch-trust-missing` where the entry cannot be made.
#     6. Open the session through the adapter's `create`, at its base index,
#        also with --predecessor, once the command and its identity are written as the
#        record's `pending` successor (a write that fails refuses
#        `record-unwritten step=pending` with nothing opened), print
#        `overseer-launch` naming the form, lane, session and window, and
#        write the session record before the first turn: runtime tmux, the
#        server, the pane, its window, the launch identity (harness, account,
#        home, model, effort and directory, as the command built in step 5
#        carries them), the launch line and generation 1, or one past the
#        record a stopped fleet left. A record
#        that cannot be written closes the session and refuses
#        `record-unwritten`, with --predecessor before the predecessor is
#        stopped: an overseer nothing records is one the hooks and the watch
#        cannot tell from any other session, and a live-overseer check that
#        read the stopped predecessor's record would open a second overseer
#        beside it.
#     7. Verify the session inside --wait-secs, as a succession does: read its
#        account, wait for a running turn through `inspect --launch`, read the
#        account again. `overseer-wrong-lane`, `overseer-dialog` and
#        `overseer-not-working` each close the session, put the record back
#        and refuse. `overseer-lane-unobserved` is a notice: the launch stands.
#     8. With --predecessor, stop the predecessor through the adapter with
#        the successor named: on tmux the successor stays at the base index
#        and the predecessor's window closes. That is the commit
#        point, so HUP, INT and TERM are ignored across it; a stop that fails
#        closes the successor, puts the record back and refuses
#        `close-failed`, the predecessor still running. Run from inside the
#        predecessor's own window, the stop ends this command with it.
#     9. With --predecessor, hand the fleet watch to the successor pane,
#        arranged before step 8 because nothing after the stop can be counted
#        on to run: lib/watch-handover.sh's watch_handover, the step 6
#        `oversee-succeed` runs, so a successor that dies or walls is judged
#        by the watch from its first pass. `watch-absent` where no watch runs
#        on the fleet state, otherwise `watch-handover pid=<N> pane=<pane>
#        log=<path>` and the runner line of `oversee-succeed`'s restart
#        helper, which restarts the watch from the successor pane once the
#        predecessor's session is gone and writes how that went to the log
#        field's file (`oversee-succeed --help`, step 6). Run from outside
#        tmux, the launch hands the helper the $TMUX tmux sets in the
#        successor's pane, which the restarted watch reads that pane under. A
#        helper the job runner refused is the notice `watch-restart-failed
#        step=helper`, a fleet state with no path `step=state-path`, and a
#        $TMUX tmux would not state `step=tmux`, each on stderr; the
#        succession stands, and the successor's own watch start takes over
#        the watch of the gone pane (`oversee-watch` § watch_claim).
#     On success `overseer-launched` names the session, window, generation
#     and lane, and the predecessor where one was stopped, at exit 0.
#   register writes the session record for the session this command runs in,
#            a tmux pane a person opened by hand: runtime tmux, the tmux
#            server, $TMUX_PANE, its window, the file its event rows land in,
#            and the launch identity its SessionStart row states
#            (lib/session-rows.sh): the harness, the account (--account
#            ahead of it), the model and the directory. With no such row it
#            reads them as the named fallback, notice `identity-fallback` on
#            stderr: the account --account or this session's own account
#            variable names through lib/lane-context.sh, the harness the
#            pane's foreground process names, or copilot where the pane reads
#            node or copilot and a Copilot process runs at most two levels
#            under it (its account --account's alone), and the pane's
#            directory, the model unknown. The home is a private CODEX_HOME
#            where the session carries one, the account otherwise; no effort
#            is read. Where ol_names proves the same server, server start and
#            pane, unknown fields and an unpassed launch line keep their prior
#            values. Another pane inherits none of them. The generation is one past the record's,
#            or the record's own where it already names this pane, so
#            registering twice launches nothing and counts nothing twice.
#            A server start that cannot be read refuses `record-unwritten`
#            and writes nothing.
#            Prints `registered` naming the session and generation, with
#            `retained` and `fresh` sorted comma-separated field names, or
#            `none`, from the record writer.
#
# Options:
#   --session NAME   The tmux session the window opens in (default
#                    ORCH_TMUX_SESSION, else the repository name)
#   --predecessor SESSION
#                    The live overseer session the fleet state records, which
#                    the launch replaces: the successor opens beside it and
#                    stays at the base index once verified. launch only, never beside
#                    --session
#   --cwd DIR        The directory the session starts in, and the repository
#                    whose settings and fleet state the launch uses (default
#                    the current directory)
#   --handoff PATH   The handoff file the brief names (default
#                    tmp/handoffs/OVERSEER-HANDOFF.md); letters, digits and
#                    ./_- only, so the brief survives the pane's shell
#   --wait-secs N    Seconds the session has to come up: one bound over
#                    reading its account, waiting for its running turn and
#                    confirming the account once that turn shows (default 60)
#   --account DIR    register: the account the session spends, where its
#                    environment does not say
#
# Output: every line is `oversee: <key> <field>=<value>` first, with the
# explanation and any failing dependency's own stderr under it. A refusal is
# on stderr at exit 1, except `no-lane-qualifies` at exit 3, the status
# `lanes pick` itself answers "no lane clears the bound" with. `overseer-launch`,
# `overseer-launched`, `registered`, `watch-handover` and `watch-absent` are on
# stdout; `overseer-lane-unobserved` and `watch-restart-failed` are notices on
# stderr the run continues past.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

usage() { sed -n '/^# Usage:/,/^# Output:/p' "$0" | sed 's/^# \{0,1\}//'; }

message() { # KEY FIELD=VALUE...
  local key="$1" text
  shift
  case "$key" in
    unknown-option) text="$(usage | sed -n '/^Usage:/,/^$/p')" ;;
    unknown-command) text='The commands are launch and register.' ;;
    invalid-wait-secs) text='--wait-secs takes a positive whole number of seconds.' ;;
    invalid-handoff) text='The handoff path takes letters, digits and ./_- only.' ;;
    invalid-cwd) text='--cwd names no directory.' ;;
    settings-rejected) text='The settings load failed; nothing is launched from partial settings.' ;;
    runtime-unsupported) text='This launcher reads the new session'\''s account off its tmux pane, so it opens sessions on the tmux runtime alone. ORCH_OVERSEER_HOST names another; nothing was launched.' ;;
    tmux-missing) text='register runs inside the overseer'\''s own tmux pane; launch reaches a tmux server through $TMUX or ORCH_TMUX_SESSION.' ;;
    session-unresolved) text='The checkout repository name is invalid, so no default tmux session can be named. Give --session or set ORCH_TMUX_SESSION. Nothing was opened.' ;;
    tmux-session-missing) text='The tmux session named does not exist on the server this run reaches. Nothing was opened; the server field names the socket.' ;;
    tmux-failed) text='The tmux call the operation field names failed on the server the server field names, for another reason than an absent session: no server may be running at that socket. Nothing was opened; tmux says why below.' ;;
    state-unwritable) text='The oversee workflow state could not be created or read, so no session record can be kept. Nothing was launched.' ;;
    overseer-live) text='The fleet state names an overseer session this tmux server still lists, so a second one is not opened beside it. Two overseers never act at once: replace a live one through oversee launch --predecessor naming it, or oversee-succeed, or stop it and clear the record. A record carrying no server start takes oversee register in that pane before --predecessor accepts it.' ;;
    predecessor-not-live) text='The session --predecessor names is not the live overseer the fleet state records on this server. The live field names that overseer, or none where no live one is recorded. A record carrying no server start names none: run oversee register in its pane first. A succession only ever stops the recorded overseer; nothing was opened.' ;;
    option-conflict) text='--predecessor is a launch option, and a successor opens beside its predecessor rather than in the tmux session --session names, so the two are never given together.' ;;
    close-failed) text='The predecessor could not be stopped, so the successor was closed and the record put back; the predecessor keeps running.' ;;
    invalid-preference) text='ORCH_OVERSEER_PREFERENCE entries are harness:model:effort with harness claude, codex, copilot or pi, model the model that harness launches, on pi a provider/id, and effort the level as that harness spells it, each in the characters kendex.settings.toml.example § Fleet in the orch skill states. An entry naming no model is refused. A first launch skips pi entries.' ;;
    preference-empty) text='A first launch has no caller whose own harness and lane could stand in, so ORCH_OVERSEER_PREFERENCE must name at least one entry.' ;;
    invalid-headroom-trigger) text='ORCH_OVERSEER_HEADROOM_PCT takes a whole number of percent from 0 to 100.' ;;
    invalid-question-tool) text='ORCH_QUESTION_TOOL takes off or overseer.' ;;
    lanes-failed) text='A lanes read failed on a path about to launch; no lane is chosen on a guess.' ;;
    no-lane-qualifies) text='No lane of any harness the preference names is above the headroom trigger; nothing was launched. entries counts the preference entries walked; walled and unmeasured are the accounts the sweeps refused and the accounts nothing could measure.' ;;
    entry-permission-unwritable) text='The launch flag table names no full-bypass permission word for this entry'\''s harness, so a first launch there would stop at its first approval prompt with nobody at the pane. The entry is skipped and the walk goes on; oversee-succeed takes such an entry for a caller of the same harness.' ;;
    successor-status-line) text='The shared installer could not configure this Copilot home or its statusLine fallback. detail names the setup failure and cause names the fallback failure. The entry is skipped.' ;;
    launch-choice-failed) text='The launch flag table cannot state this harness'\''s model, effort or permission words. Nothing was launched.' ;;
    model-window-unknown) text='The claude adapter names no context window for the model this entry names, and an overseer runs with its compaction off, so it would reach its wall with no handoff mark. Nothing was launched. Name a claude model the window table in lib/adapters/claude.sh names.' ;;
    launch-trust-missing) text='The folder-trust entry for the launch directory could not be made in the config this session would read, so nothing was launched; the reason field is lib/lane-launch.sh'\''s.' ;;
    launch-failed) text='The session could not be opened or read; the step field names the call that failed.' ;;
    record-unwritten) text='The session record could not be written to the fleet state, so the session was closed again, or at step=pending never opened, and a predecessor keeps running: an overseer nothing records is one the hooks and the watch cannot tell from any other session.' ;;
    overseer-launch) text='The command is built and the session opened; the form names how the picked lane reaches the harness.' ;;
    overseer-dialog) text='The session stopped at a dialog nobody is there to answer; it was closed and the record put back. The pane line follows.' ;;
    overseer-not-working) text='The session never showed a running turn inside the wait; it was closed and the record put back.' ;;
    overseer-wrong-lane) text='The session is running on another account than the one picked, so a wrapper on PATH replaced the selection; it was closed and the record put back.' ;;
    overseer-lane-unobserved) text='The account the session runs on could not be established. The launch stands: this check refuses on a disagreement it observed, never on an observation it could not make.' ;;
    overseer-lane-unknown) text='The account check returned an outcome this script does not know; the session was closed rather than trusted.' ;;
    overseer-launched) text='The overseer is running and recorded.' ;;
    watch-handover) text='The fleet watch serving the predecessor pane is restarted from the successor pane once the predecessor is stopped, by a helper the orch job runner started outside this run, as the runner fields say. How the restart went is written to the log field, which the next watch start prints.' ;;
    watch-absent) text='No watch runs on the fleet state, so none is restarted. The successor starts its own.' ;;
    watch-restart-failed) text='The fleet watch was not handed to the successor pane; the succession goes on and the step field names what failed, with the orch job runner error where it refused a launch. The old watch serves a pane about to close until the successor starts its own watch, which takes it over.' ;;
    interrupted) text='A signal stopped the launch; the session was closed and the record put back.' ;;
    pane-unreadable) text='This session'\''s own pane could not be read; tmux says why below.' ;;
    registered) text='The session record names this session.' ;;
    identity-fallback) text='No SessionStart row of this session stands, so its harness, account and directory are read off its pane and environment, the named fallback. No model or effort is read; a record proven to name this same pane keeps fields the fallback cannot read.' ;;
    context-reader=missing) text='The Copilot context reader could not be configured. The running session is registered, but its context mark has no new reader. Repair the named home and register again.' ;;
    context-reader=next-start) text='The configured Copilot reader loads at the next session start. This running session does not load a newly installed extension.' ;;
    turn-end-hook=missing) text='The checkout does not provide active turn-end hook coverage for this harness. The running session is registered. Add the harness to [install] harnesses in kendex.toml and run kendex apply.' ;;
  esac
  printf 'oversee: %s' "$key"
  printf ' %s' "$@"
  printf '\n%s\n' "$text"
}

die_status() { # STATUS KEY FIELD=VALUE...
  local status="$1"
  shift
  message "$@" >&2
  [[ ! -s "${DEP_ERR:-}" ]] || cat -- "$DEP_ERR" >&2
  exit "$status"
}
die() { die_status 1 "$@"; }

matches() { # VALUE REGEX
  local LC_ALL=C
  [[ "$1" =~ $2 ]]
}

case "${1:-}" in
  -h|--help|help|"") usage; exit 0 ;;
esac
COMMAND="$1"
shift
case "$COMMAND" in
  launch|register) ;;
  *) die_status 2 unknown-command "command=$COMMAND" ;;
esac

HANDOFF=tmp/handoffs/OVERSEER-HANDOFF.md
WAIT_SECS=60
SESSION_NAME=""
PREDECESSOR=""
CWD=""
ACCOUNT=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --session|--predecessor|--cwd|--handoff|--wait-secs|--account)
      [[ $# -ge 2 ]] || die_status 2 unknown-option "arg=$1"
      case "$1" in
        --session) SESSION_NAME="$2" ;;
        --predecessor) PREDECESSOR="$2" ;;
        --cwd) CWD="$2" ;;
        --handoff) HANDOFF="$2" ;;
        --wait-secs) WAIT_SECS="$2" ;;
        *) ACCOUNT="$2" ;;
      esac
      shift 2 ;;
    *) die_status 2 unknown-option "arg=$1" ;;
  esac
done
matches "$WAIT_SECS" '^[1-9][0-9]*$' || die invalid-wait-secs "value=$WAIT_SECS"
matches "$HANDOFF" '^[A-Za-z0-9._/-]+$' || die invalid-handoff "path=$HANDOFF"
[[ -z "$PREDECESSOR" || ( "$COMMAND" == launch && -z "$SESSION_NAME" ) ]] \
  || die_status 2 option-conflict "command=$COMMAND" "session=${SESSION_NAME:-none}" "predecessor=$PREDECESSOR"

DEP_ERR="$(mktemp)" || die launch-failed step=mktemp
export DEP_ERR
trap 'rm -f -- "$DEP_ERR"' EXIT

# A launch runs from the directory the session starts in: the settings it
# loads and the fleet state its record goes into are that repository's, the
# ones the launched overseer's hooks, watch and succession read, wherever
# this command was typed.
if [[ "$COMMAND" == launch ]]; then
  given="${CWD:-$PWD}"
  CWD="$(cd -- "$given" 2>/dev/null && pwd -P)" || die invalid-cwd "dir=$given"
  cd -- "$CWD" || die invalid-cwd "dir=$given"
fi

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export PROJECT_ROOT
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$PROJECT_ROOT" 2>"$DEP_ERR" || die settings-rejected "path=$PROJECT_ROOT"
# shellcheck source=lib/lane-context.sh
source "$SCRIPT_DIR/lib/lane-context.sh"
# shellcheck source=lib/lane-state.sh
source "$SCRIPT_DIR/lib/lane-state.sh"
# shellcheck source=lib/lane-launch.sh
source "$SCRIPT_DIR/lib/lane-launch.sh"
# shellcheck source=lib/overseer-launch.sh
source "$SCRIPT_DIR/lib/overseer-launch.sh"
# shellcheck source=lib/tmux-server.sh
source "$SCRIPT_DIR/lib/tmux-server.sh"

# The watch handover a succession arranges, `oversee-succeed`'s own.
# shellcheck source=lib/watch-pid.sh
source "$SCRIPT_DIR/lib/watch-pid.sh"
# shellcheck source=lib/job-unit.sh
source "$SCRIPT_DIR/lib/job-unit.sh"
# shellcheck source=lib/watch-handover.sh
source "$SCRIPT_DIR/lib/watch-handover.sh"

# The runtime, held to tmux by the library both launchers share: this
# launcher reads the new session's account off its pane.
if ! ol_runtime_supported; then
  [[ "$OL_REASON" != runtime-unsupported ]] || die runtime-unsupported "host=$OL_RUNTIME"
  die launch-failed step=host-resolve
fi

# The oversee state, where the record lives: created for a fresh fleet, read
# for every other. One refusal for both, naming the path.
state_ready() {
  local path
  path="$("$SCRIPT_DIR/workflow-state" path oversee 2>"$DEP_ERR")" || die state-unwritable state=oversee
  if ! "$SCRIPT_DIR/workflow-state" exists oversee >/dev/null 2>"$DEP_ERR"; then
    "$SCRIPT_DIR/workflow-state" init oversee >/dev/null 2>"$DEP_ERR" || die state-unwritable "path=$path"
  fi
  ol_record_read || die state-unwritable "path=$path"
}

# ---------------------------------------------------------------------------
# register
# ---------------------------------------------------------------------------
if [[ "$COMMAND" == register ]]; then
  [[ -n "${TMUX_PANE:-}" ]] || die tmux-missing var=TMUX_PANE
  key="$(lane_context_caller_key)" || die pane-unreadable "pane=$TMUX_PANE" field=pid
  matches "$key" '^([0-9]+)[[:blank:]]+(%[0-9]+)$' || die pane-unreadable "pane=$TMUX_PANE" field=pid "value=$key"
  server="${key%% *}"
  window="$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>"$DEP_ERR")" \
    || die pane-unreadable "pane=$TMUX_PANE" field=window_id
  # The launch identity a hand-opened session can state, from what its own
  # harness said at its start where its SessionStart row stands
  # (lib/session-rows.sh): the harness its hook install names, the account its
  # environment carries, its model and its directory. Nothing here launched
  # it, so no effort is known. Where no row stands, a harness with no such
  # hook or a session started before its install, the pane's foreground
  # process and directory are read instead, the named fallback, said as
  # `identity-fallback`, and no model is known.
  model="" start_rc=0
  session_rows_start "$(session_rows_overseer_file "$PWD" "$server" "$TMUX_PANE")" || start_rc=$?
  if (( start_rc == 0 )) && [[ -n "$SR_HARNESS" && -n "$SR_CWD" ]]; then
    cwd="$SR_CWD" model="$SR_MODEL" shape="$SR_HARNESS"
    [[ -n "$ACCOUNT" ]] || ACCOUNT="$SR_ACCOUNT"
  else
    cause=no-start-row
    [[ "$start_rc" -ne 2 ]] || cause=unreadable
    message identity-fallback "session=$TMUX_PANE" "cause=$cause" >&2
    cwd="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_current_path}' 2>"$DEP_ERR")" \
      || die pane-unreadable "pane=$TMUX_PANE" field=pane_current_path
    cmd="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_current_command}' 2>"$DEP_ERR")" \
      || die pane-unreadable "pane=$TMUX_PANE" field=pane_current_command
    shape="$(lane_context_shape "${cmd#-}")"
    # The account --account named, kept apart from the one derived below,
    # which reads the Claude and Codex variables and so answers for no
    # Copilot pane.
    given_account="$ACCOUNT"
    [[ -n "$ACCOUNT" ]] || ACCOUNT="$(lane_context_caller_cfg "$shape")"
    # A Copilot pane reads `node`, its npm loader, or `copilot`, the binary
    # started directly, and neither names a shape, so its harness is the
    # process carrying one of Copilot's own names (lib/lane-state.sh §
    # lane_harness_process_re) at most two levels under the pane: its shell,
    # the loader, the binary. A Codex pane also reads `node`, and a Copilot
    # run it starts sits deeper, under its own tool shell, so it is not this
    # pane's harness. Its account is --account's alone: nothing here reads
    # COPILOT_HOME for a session.
    if [[ "$shape" == both ]]; then
      case "${cmd#-}" in
        node | copilot)
          pane_pid="$(tmux display-message -p -t "$TMUX_PANE" '#{pane_pid}' 2>"$DEP_ERR")" \
            || die pane-unreadable "pane=$TMUX_PANE" field=pane_pid
          table="$(lane_process_table)" || die pane-unreadable "pane=$TMUX_PANE" field=process-table
          name_re="$(lane_harness_process_re copilot)" || die pane-unreadable "pane=$TMUX_PANE" field=process-table
          if ! below="$(lane_process_below "$table" "$pane_pid" "$name_re" 1 2)"; then
            die pane-unreadable "pane=$TMUX_PANE" field=process-table
          fi
          if [[ "$below" == found ]]; then
            shape=copilot ACCOUNT="$given_account"
          fi
          ;;
      esac
    fi
  fi
  # The home its own variable carries where that is a private codex home, and
  # the account otherwise.
  harness="" home="$ACCOUNT"
  case "$shape" in
    claude) harness=claude ;;
    codex) harness=codex; home="${CODEX_HOME:-$ACCOUNT}" ;;
    copilot) harness=copilot ;;
    both) ;;
    *) harness="$shape" ;;
  esac
  ol_identity "$harness" "$ACCOUNT" "$home" "$model" "" "$cwd" || die record-unwritten field=overseer step=identity
  state_ready
  ol_record_write tmux "$TMUX_PANE" "$window" "$server" "$OL_IDENTITY" "" \
    || die record-unwritten field=overseer
  # The writer retains unknown fields only for this same session. Check that
  # resulting identity, not the fallback's empty fields.
  record="$(ol_record_get)" || die state-unreadable field=overseer
  fields="$(jq -r '[.harness // "", .home // "", .cwd // ""] | join("\u001f")' <<<"$record" 2>"$DEP_ERR")" \
    || die state-unreadable field=overseer
  IFS=$'\x1f' read -r harness home cwd <<<"$fields"
  if [[ "$harness" == copilot ]]; then
    reader_before=missing
    ! copilot_context_reader "$home" || reader_before=present
    if copilot_context_install "$home"; then
      [[ "$reader_before" != missing || "$COPILOT_CONTEXT_MODE" != extension ]] \
        || message context-reader=next-start "home=$home" >&2
    else
      message context-reader=missing "home=$home" "file=$COPILOT_CONTEXT_FILE" "detail=$COPILOT_CONTEXT_DETAIL" \
        "cause=${COPILOT_CONTEXT_CAUSE:-none}" >&2
    fi
    if ! copilot_hooks_gate "$cwd" "$home"; then
      message turn-end-hook=missing harness=copilot "reason=$COPILOT_HOOK_REASON" \
        'fix=add copilot to [install] harnesses in kendex.toml and run kendex apply' >&2
      [[ -z "$COPILOT_HOOK_ERROR" ]] || printf '%s\n' "$COPILOT_HOOK_ERROR" >&2
    fi
  elif [[ -n "$harness" ]]; then
    # kendex owns the inventory for every non-Copilot harness. Its list table
    # is on stderr, with columns kind, name, harness, scope and optional state.
    inventory_rc=0
    inventory="$(cd -- "$cwd" && kendex list --harness "$harness" 2>&1)" || inventory_rc=$?
    if [[ "$inventory_rc" != 0 ]] || ! awk -v h="$harness" \
        '$1 == "hook" && $2 == "lane-mail-check" && $3 == h && NF == 4 { found=1 }
         END { exit !found }' <<<"$inventory"; then
      message turn-end-hook=missing "harness=$harness" "exit=$inventory_rc" \
        "fix=add $harness to [install] harnesses in kendex.toml and run kendex apply" >&2
      [[ "$inventory_rc" == 0 ]] || printf '%s\n' "$inventory" >&2
    fi
  fi
  message registered "session=$TMUX_PANE" "window=$window" "server=$server" \
    "generation=$OL_GENERATION" "account=${ACCOUNT:-none}" \
    "retained=$OL_RECORD_RETAINED" "fresh=$OL_RECORD_FRESH"
  exit 0
fi

# ---------------------------------------------------------------------------
# launch
# ---------------------------------------------------------------------------
# A succession opens in its predecessor's session and names no tmux session; the
# server is still the one lib/tmux-server.sh's rule reaches.
if [[ -n "$PREDECESSOR" ]]; then
  SERVER_SOCKET="$(tmux_server_socket)" || die tmux-missing var=TMUX
else
  [[ -n "$SESSION_NAME" ]] || SESSION_NAME="${ORCH_TMUX_SESSION:-}"
  if [[ -z "$SESSION_NAME" ]]; then
    # shellcheck source=lib/gh-repo.sh
    source "$SCRIPT_DIR/lib/gh-repo.sh"
    repo_rc=0
    repo_name="$(GH_REPO= orch_resolve_gh_repo "$PROJECT_ROOT")" || repo_rc=$?
    case "$repo_rc" in
      0) SESSION_NAME="${repo_name#*/}" ;;
      1) SESSION_NAME="${PROJECT_ROOT##*/}" ;;
      *) die session-unresolved "repo=$repo_name" ;;
    esac
  fi
  # The server every tmux call below reaches, named on every line: the rule is
  # lib/tmux-server.sh's, answered for the session just resolved.
  export ORCH_TMUX_SESSION="$SESSION_NAME"
  SERVER_SOCKET="$(tmux_server_socket)" || die tmux-missing var=TMUX
  # The one reading of tmux's answer is lib/tmux-server.sh's: absent is a
  # missing session, anything else the call failing.
  probe=0
  tmux_session_present "$SESSION_NAME" || probe=$?
  if (( probe )); then
    printf '%s\n' "$TMUX_SESSION_DETAIL" > "$DEP_ERR"
    [[ "$probe" -eq 3 ]] || die tmux-failed operation=has-session "server=$SERVER_SOCKET"
    die tmux-session-missing "session=$SESSION_NAME" "server=$SERVER_SOCKET"
  fi
fi

state_ready
# A live overseer: the record names a tmux session, and the runtime's
# `inspect` of it answers a live state on a server the record names it on by
# `ol_names`: that server pid, started when the record says. A record naming
# a session the runtime no longer lists, or one an earlier server handed the
# same pid and pane held, is a stopped fleet's, and the launch takes the next
# generation over it. A record carrying no server start names no session, but
# a pane it records live on that server pid may be the running overseer, so
# nothing is opened beside it: live_pane is the pane that blocks a launch,
# named_pane the one the record names. A live one is launched over only as
# the predecessor --predecessor names, and a predecessor is only ever the
# named one: the session a succession stops is the one the fleet records as
# its overseer on this very server, never another pane, and never a pane a
# startless record names, which a later server may have handed the same pid
# and pane id.
if ! live="$(jq -r 'if type == "object" and (.runtime // "tmux") == "tmux" and (.pane // "") != ""
    then (.pane + " " + ((.generation // 0) | tostring)) else "" end' <<<"$OL_PRIOR" 2>"$DEP_ERR")"; then
  die state-unwritable field=overseer
fi
live_pane="" named_pane=""
if [[ -n "$live" ]]; then
  read -r live_pane live_generation <<<"$live"
  ol_session_inspect "$live_pane" || die launch-failed step=inspect
  if [[ "$OL_INSPECT_STATE" == gone ]]; then
    live_pane=""
  else
    # A start that cannot be read cannot tell the recorded overseer from a
    # session an earlier server's pid and pane id left, so nothing is opened
    # beside a pane that may be it.
    live_start="$(ol_session_start "$OL_INSPECT_SERVER" "$live_pane")" \
      || die launch-failed step=server-start "session=$live_pane" "server=$SERVER_SOCKET"
    if ! live_named="$(jq -r --arg server "$OL_INSPECT_SERVER" --arg start "$live_start" --arg pane "$live_pane" \
      "$OL_JQ_DEFS"' [ol_names($server; $start; $pane), ol_owns($server; $start; $pane)]
        | map(tostring) | join(" ")' <<<"$OL_PRIOR" 2>"$DEP_ERR")"; then
      die state-unwritable field=overseer
    fi
    read -r live_named live_blocks <<<"$live_named"
    [[ "$live_named" != true ]] || named_pane="$live_pane"
    [[ "$live_blocks" == true ]] || live_pane=""
  fi
fi
[[ -z "$PREDECESSOR" || "$named_pane" == "$PREDECESSOR" ]] \
  || die predecessor-not-live "session=$PREDECESSOR" "live=${named_pane:-none}" "server=$SERVER_SOCKET"
[[ -z "$live_pane" || -n "$PREDECESSOR" ]] \
  || die overseer-live "session=$live_pane" "server=$SERVER_SOCKET" "generation=$live_generation"

HEADROOM_TRIGGER="${ORCH_OVERSEER_HEADROOM_PCT:-10}"
matches "$HEADROOM_TRIGGER" '^[0-9]{1,3}$' && (( 10#$HEADROOM_TRIGGER <= 100 )) \
  || die invalid-headroom-trigger "ORCH_OVERSEER_HEADROOM_PCT=$HEADROOM_TRIGGER"
HEADROOM_TRIGGER=$((10#$HEADROOM_TRIGGER))
QUESTION_OFF=()
if ! question_policy="$(launch_overseer_question_tool)"; then
  die invalid-question-tool "ORCH_QUESTION_TOOL=${ORCH_QUESTION_TOOL:-}"
fi
[[ "$question_policy" != off ]] || QUESTION_OFF=(--question-off)
ol_preference_entries "$(ol_preference)" || die invalid-preference "entry=$OL_BAD_ENTRY"
(( OL_NAMED > 0 )) || die preference-empty setting=ORCH_OVERSEER_PREFERENCE

# The walk and the flags are lib/overseer-launch.sh's ol_walk and
# ol_launch_flags, the ones `oversee-succeed` takes. A launch here has no
# caller entry and no predecessor flags to carry, so every entry is a
# preference entry and every command writes the table's words alone; the
# walk skips an entry whose harness row names no full-bypass word, pi's.
rc=0
ol_walk "$HEADROOM_TRIGGER" "" "${OL_ENTRIES[@]}" || rc=$?
for skip in ${OL_WALK_SKIPS[@]+"${OL_WALK_SKIPS[@]}"}; do
  IFS=$'\t' read -r -a fields <<<"$skip"
  message "${fields[@]}" >&2
done
case "$rc" in
  0) ;;
  3) die_status 3 no-lane-qualifies "entries=$OL_NAMED" \
       "walled=$OL_WALKED_WALLED" "unmeasured=$OL_WALKED_UNMEASURED" ;;
  *) die "$OL_REASON" "${OL_FIELDS[@]}" ;;
esac
ol_launch_flags ${QUESTION_OFF[@]+"${QUESTION_OFF[@]}"} "$OL_HARNESS" "$OL_MODEL" "$OL_EFFORT" "$OL_PICK_MODEL" "" \
  || die "$OL_REASON" "entry=$OL_CHOSEN" ${OL_FIELDS[@]+"${OL_FIELDS[@]}"}
lane_dir="$OL_LANE_DIR"
ol_command_line "$OL_HARNESS" "$HANDOFF" "$lane_dir" "$CWD" ${OL_FLAGS[@]+"${OL_FLAGS[@]}"} \
  || die launch-trust-missing "lane=$lane_dir" "dir=$CWD" "reason=$OL_TRUST_REASON"

# Every failure from here closes the session and puts the record back: the
# close-out is the library's ol_session_abandon, the words are this script's.
abandon() {
  ol_session_abandon || { message record-unwritten field=overseer step=restore >&2; [[ -z "$OL_DETAIL" ]] || printf '%s\n' "$OL_DETAIL" >&2; }
  die "$@"
}
# A signal that lands during the runtime's create runs its trap once the call
# returns; ol_session_abandon inside abandon reads the session off the
# provider's answer and closes it, so it is named here only where create had
# already returned it.
interrupted() { # SIGNAL
  abandon interrupted "session=${OL_SESSION:-none}" "signal=$1"
}
trap 'interrupted TERM' TERM
trap 'interrupted INT' INT
trap 'interrupted HUP' HUP

# This script's words at each step of a launch: the ones
# lib/overseer-launch.sh's ol_succession asks for, which the first launch
# below says at the same points of its own steps. A record write that fails
# refuses the succession before its commit point, as it refuses a first
# launch.
ol_succession_hook() { # STEP
  case "$1" in
    pending-unrecorded | record-unwritten) return 1 ;;
    opened)
      SESSION="$OL_SESSION"
      message overseer-launch "form=$OL_FORM" "lane=$lane_dir" "trust=$OL_TRUST_ROUTE" \
        "session=$SESSION" "window=$OL_WINDOW" "server=$SERVER_SOCKET" ;;
    verified)
      [[ -z "$OL_UNOBSERVED" ]] || message overseer-lane-unobserved "reason=$OL_UNOBSERVED" >&2
      [[ -z "$PREDECESSOR" ]] || hand_over_watch ;;
  esac
}
# Step 9 of the header: lib/watch-handover.sh's watch_handover, the one
# `oversee-succeed` runs, in this script's words. The restarted watch reads
# the successor's pane only under a $TMUX (`oversee-watch` § check_overseer),
# which a launch from outside tmux has none of: the helper is then handed the
# one tmux sets in the successor's own pane.
hand_over_watch() {
  local tmux_env="${TMUX:-}"
  if [[ -z "$tmux_env" ]] \
     && ! tmux_env="$(tmux display-message -p -t "$SESSION" '#{socket_path},#{pid},#{session_id}' 2>"$DEP_ERR")"; then
    message watch-restart-failed step=tmux "session=$SESSION" >&2
    [[ ! -s "$DEP_ERR" ]] || cat -- "$DEP_ERR" >&2
    return 0
  fi
  if TMUX="${tmux_env/,\$/,}" watch_handover "$PREDECESSOR" "$SESSION" "$OL_LANE_VAR" "$OL_LAUNCH_HOME" \
      "$OL_HARNESS" ${OL_FLAGS[@]+"${OL_FLAGS[@]}"}; then
    message "$WATCH_HANDOVER_KEY" "${WATCH_HANDOVER_FIELDS[@]}"
  else
    message "$WATCH_HANDOVER_KEY" "${WATCH_HANDOVER_FIELDS[@]}" >&2
    [[ ! -s "$DEP_ERR" ]] || cat -- "$DEP_ERR" >&2
  fi
}
# ol_session_verify's refusals, each closing the session and putting the
# record back.
refuse_unverified() {
  case "$OL_REASON" in
    wrong-lane) abandon overseer-wrong-lane "picked=$lane_dir" "observed=$OL_OBSERVED" ;;
    result-unknown) abandon overseer-lane-unknown "result=$OL_RESULT" ;;
    dialog) abandon overseer-dialog "session=$SESSION" "waited=$OL_WAITED" ;;
    not-working) abandon overseer-not-working "session=$SESSION" "waited=$OL_WAITED" ;;
    inspect-failed) abandon launch-failed "step=$OL_STEP" ;;
    *) abandon launch-failed step=verify "reason=$OL_REASON" ;;
  esac
}

SESSION=""
if [[ -n "$PREDECESSOR" ]]; then
  # A succession is lib/overseer-launch.sh's ol_succession, the one
  # `oversee-succeed` runs: the pending record, the session opened at the base
  # index, the record, the verification and the predecessor's stop,
  # the commit point.
  if ! ol_succession "$PREDECESSOR" "$CWD" "$OL_CMD" "$OL_IDENTITY" pending \
      "$OL_LANE_VAR" "$lane_dir" "$OL_FORM" "$WAIT_SECS"; then
    case "$OL_REASON" in
      record-unwritten) abandon record-unwritten field=overseer "step=$OL_STEP" ;;
      create-failed) abandon launch-failed "step=$OL_REASON" ;;
      stop-failed) abandon close-failed "predecessor=$PREDECESSOR" ;;
      *) refuse_unverified ;;
    esac
  fi
else
  # A first launch opens at the base index, and a record it
  # cannot write closes it again: nothing else would tell it from any other
  # session.
  ol_session_open "$CWD" overseer "$OL_CMD" --session "$SESSION_NAME" || abandon launch-failed "step=$OL_REASON"
  ol_succession_hook opened
  ol_record_write "$OL_RUNTIME" "$SESSION" "$OL_WINDOW" "$OL_SERVER" "$OL_IDENTITY" "$OL_CMD" \
    || abandon record-unwritten field=overseer step=write
  ol_session_verify "$SESSION" "$OL_LANE_VAR" "$lane_dir" "$OL_FORM" "$WAIT_SECS" || refuse_unverified
  ol_succession_hook verified
fi
trap - HUP TERM INT
message overseer-launched "session=$SESSION" "window=$OL_WINDOW" "server=$SERVER_SOCKET" \
  "generation=$OL_GENERATION" "lane=$lane_dir" ${PREDECESSOR:+"predecessor=$PREDECESSOR"}
