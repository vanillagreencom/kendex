#!/usr/bin/env bash
# oversee-cycle — the per-class totals of the fleet's merge cycles and a
# running lane's stage rows, through the runtime, which owns them.
#
# Usage:
#   oversee-cycle [--state-dir DIR] report
#   oversee-cycle [--state-dir DIR] stages ITEM
#
# report prints one `rollup class=` row per class with a record, then each
# recorded stage's `stage item=` row, writing nothing; stages prints a
# running lane's `stage item=` rows by start. Both are `orch-runtime cycle`'s;
# the close records each cycle with the lane's close.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
args=()
if [[ "${1:-}" == --state-dir ]]; then
  [[ -n "${2:-}" ]] || { printf 'oversee-cycle: usage=--state-dir\n' >&2; exit 2; }
  args=(--state-dir "$2")
  shift 2
fi
case "${1:-}" in
  report | stages) verb="$1"; shift ;;
  --help | -h) awk 'NR > 1 && /^set -euo/ { exit } NR > 1 { sub(/^# ?/, ""); print }' "$0"; exit 0 ;;
  *) printf 'oversee-cycle: usage=%s\n' "${1:-verb}" >&2; exit 2 ;;
esac
exec "$SCRIPT_DIR/orch-runtime" ${args[@]+"${args[@]}"} cycle "$verb" "$@"
