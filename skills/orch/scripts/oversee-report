#!/usr/bin/env bash
# The overseer's periodic status report: when one is due, and its rows,
# rendered from the fleet state and the tracker. Usage, sources and exit
# statuses: --help.
#
# Stdout is a protocol for two readers. `due` prints one `report-due` line or
# nothing, which oversee-watch relays as its event. `render` and `write` print
# the report itself, the text the overseer pastes into its chat; `write` puts
# the same bytes in the report file, so the chat and the file cannot differ.
# Stderr's report-written line names the file and notice-id, so the overseer
# knows the report already reached the owner.
set -euo pipefail
# The caller's stderr, which this script's own lines alone are written to.
exec 3>&2

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# The column names a report may carry, and the only place they are spelled.
COLUMN_VOCABULARY="issue|what it is|why it matters"
# Most characters one prose cell keeps; a longer title or Done-when line is cut.
CELL_MAX=160
# Page size of the open pull request list.
PR_PAGE=500
# Most merged pull requests one repository's search returns, GitHub search's
# own ceiling. A list that reaches it refuses, since the merges past it would
# be missing from Landed.
MERGED_PAGE=1000
# A lane-mail refusal naming one lane's host or mailbox; group 2 is the item.
LANE_MAIL_REFUSAL='^lane-mail: (host-unreachable|mail-read-failed)=([^ ]+)( |$)'
# Farthest back Landed reaches, in seconds: 7 days, a window this repository's
# merge rate keeps well under MERGED_PAGE whatever the report settings are.
LANDED_LOOKBACK=604800

# Every line this script writes to stderr, and the only place its text lives:
# a stable key and the value acted on, then the English under it, then what a
# command this script ran wrote. What its helpers write is held until exit and
# printed after it (§ held stderr).
message() { # KEY VALUE [CAUSE]
  {
    printf 'oversee-report: %s=%s\n' "$1" "$2"
    case "$1" in
      args) echo "oversee-report takes due, render or write, then --state PATH and one --repo OWNER/REPO or more; write also takes --summary-file PATH and --succession. See --help." ;;
      state) echo "The fleet state file could not be read as workflow-state JSON, so no report is judged or rendered from a partial fleet." ;;
      setting) echo "The setting holds a value it does not take. oversee-report --help lists the values." ;;
      setting-read) echo "orch-env could not read the setting, so which repositories the report reads is unknown. Its own words are below." ;;
      clock) echo "The current UTC time, a file time or a scratch file could not be had." ;;
      sort) echo "sort failed over the landed rows, so their order is unknown." ;;
      auth-helper) echo "The shared GitHub auth helper could not be loaded, so no GitHub credential can be chosen:" ;;
      auth-failed) echo "No configured GitHub credential works: not the env token, the keyring or the project's GH_BOT_TOKEN. Run gh auth login." ;;
      pr-list) echo "The GitHub pull request list failed, so what landed or what is open is unknown:" ;;
      pr-list-truncated) echo "The repository's merged search reached GitHub's ceiling, so a merge past it would be missing from the report. Nothing is rendered from a partial list." ;;
      settings-load) echo "The project's settings or private env file could not be loaded; the kendex-env lines below name the file and the fault." ;;
      tracker-missing) echo "The Linear CLI is not executable, so the issue's title and Done-when cannot be read. Install the linear skill or set OVERSEE_REPORT_TRACKER." ;;
      tracker-read) echo "The issue could not be read from the tracker:" ;;
      mail-read) echo "The lane's mailbox could not be read, so whether it waits on an answer is unknown:" ;;
      owner-asks) echo "The overseer mailbox's owner asks could not be listed, so what waits on the owner is unknown:" ;;
      owner-reports) echo "The overseer mailbox's report notices could not be read, so the last report sent to the owner is unknown:" ;;
      notice) echo "The report file stands and was printed above, and the notice carrying it to the owner could not be sent:" ;;
      item-state) echo "The lane's own workflow state could not be read, so whether a post-PR stop holds it is unknown:" ;;
      host-capabilities) echo "lane-host could not name the lane host kind's channel, so whether the lane has a mailbox to read is unknown:" ;;
      lane-host-busy) echo "lane-host refused a provider call for this lane at its per-home cap on provider calls, so what the lane waits on is unknown and nothing is rendered from a partial fleet. Run the report again:" ;;
      summary) echo "The summary file is missing or empty. The report notice carries the overseer's own summary to the owner, so nothing is written without one." ;;
      summary-shape)
        case "$2" in
          bare-id) echo "Link each KEN item or PR number in Slack mrkdwn; do not leave a bare identifier." ;;
          github-link) echo "Link the Linear item, not a GitHub pull request or commit. The item holds that detail." ;;
          waiting-on-you) echo "Include the Waiting on you label, even when its answer is Nothing." ;;
          label-spacing) echo "Put a blank line before each owner-message label." ;;
          line-cap) echo "Keep the summary within ORCH_REPORT_SUMMARY_LINES. Put detail in the report file." ;;
        esac ;;
      report-exists) echo "A report under this name already stands, and it is never overwritten. Write again in the next minute." ;;
      write) echo "The report file could not be written." ;;
      report-written) echo "The report printed above is this file's content." ;;
      report-path) echo "workflow-state progress-report-path gave no path, so where reports live is unknown:" ;;
    esac
    [ -z "${3:-}" ] || printf '%s\n' "$3"
  } >&3
}

refuse() { # KEY VALUE [CAUSE]
  message "$@"
  exit 2
}

usage() {
  cat <<'EOF'
Usage: oversee-report due    --state PATH --repo OWNER/REPO [--repo ...]
       oversee-report render --state PATH --repo OWNER/REPO [--repo ...]
       oversee-report write  --state PATH --repo OWNER/REPO [--repo ...]
                             --summary-file PATH [--succession]

The overseer's status report, in the rows
references/communication-modes.md § Status report gives: Landed, Escapes,
Running, Validation, Use 1, Next, Waiting on you.

--state is the oversee workflow-state file the watch reads. The report is
the owner progress report record schemas/workflow-state.md § Recording policy
states: its directory and its names are `workflow-state progress-report-path`'s,
and this script reads and writes them through that verb alone. The newest
report there is the last written report: its age is what the cadence measures.
--repo names each repository the GitHub lists read, the watch's own --repo
values; ORCH_CONNECTED_REPOS, under Settings, adds each one it lists after them.
Report contents start at the last report sent to the owner, identified by
its attachment in `lane-mail events --item overseer`. A quiet report sends
no notice and does not advance that owner baseline. With no retained sent
report, the fleet start, the earliest lanes[] launch, stands in for it.
A report covers merges up to the moment it read its lists, and `write`
stamps its file with that moment. Landed reaches back 7 days at most,
whatever the settings. Where the last sent report or fleet start is older, the
row reads `Landed (since <UTC>, earlier merges not listed):` and merges before
that time are in no report.

due      prints `report-due reason=minutes since=<UTC>` once the last report
         is ORCH_REPORT_EVERY_MINUTES old, else `report-due reason=issues
         since=<UTC> landed=<N>` once ORCH_REPORT_EVERY_ISSUES distinct fleet
         items landed since it, else nothing. Where the last report is older
         than Landed's 7-day lookback, one item landed inside the lookback is
         enough, and landed= counts the lookback alone. Nothing under
         ORCH_REPORT=off, and nothing where no report exists and no lanes[]
         record has a launched_at.
         Quiet hours do not silence due. Outside quiet hours, a quiet report
         newer than the last sent report makes the morning brief due even
         before the next cadence interval, unless both triggers are off.
render   prints the rows.
write    prints the rows and writes the same bytes to the path
         `workflow-state progress-report-path` prints, with --succession
         passed on to it, then sends the owner the report notice,
         `lane-mail notice --item overseer --to owner --attach <that file>`
         with the summary file's text as its text, so a relay carries the
         file to the owner. The summary is the notice's text alone, never
         in the file or the print: the relay posts it as the file's Slack
         comment, in Slack's mrkdwn markup, which Markdown does not read
         the same way. The new file is
         the next cadence's starting point. During ORCH_REPORT_QUIET_HOURS
         it still writes and prints, but sends no owner notice. The first
         due report after the window ends sends the morning brief, covering
         the work since the last sent report. Decisions needed and critical
         notices use lane-mail directly and remain immediate at any hour.
         A path that already stands is
         refused; a notice that cannot be sent is refused as `notice`
         after the report is printed, the file standing. A `notice`
         refusal whose lines name lane-mail's `owner-notice-repeated`
         leaves the report file standing and the owner already holding the
         same text, under the notice id that line names.
         Before rendering or writing, write checks the summary in its posted
         mrkdwn form. It refuses as summary-shape with the first failing
         rule: bare-id, github-link, waiting-on-you, label-spacing, line-cap.
         Owner wording and the template live in
         references/communication-modes.md § Owner messages.

Rows:
  Landed          each fleet item, a lanes[] record of any status, with a
                  pull request of its own merged since the last report, in
                  any --repo or ORCH_CONNECTED_REPOS entry: one merged
                  search per repo, matched against every item by
                  lib/lane-state.sh's lane_own, the rule the watch's merged
                  check uses: the number its parked record names, its
                  branch, the key lower-cased, or the key in the title's
                  conventional-commit scope or right after Closes on a body
                  line, as a Claude cloud session's claude/ branch names no
                  item. The issue cell carries the
                  PR number and the merge commit.
  Escapes         one line under Landed: pull requests merged to the base
                  branch resolve-base-branch names that a revert commit
                  there names as #N, or a `Regressed-by: #N` line (plain or
                  bold) in a Linear issue labelled bug and created at or
                  after the merge, in LINEAR_TEAM where that is set; a #N
                  elsewhere in an issue is not counted. Within 14 days of
                  the merge, in the week of the first finding, for this
                  week, last week and the week the review cap fell to 1
                  (lib/escapes.sh). It fetches that branch from origin in
                  the project checkout and reads Linear live.
                  `Escapes: unread (<cause>)` where git or Linear could not
                  be read or parsed, or the workspace has no label named
                  bug.
  Running         each lanes[] record reading running, preparing or parked.
                  The issue cell carries its open PR, or `no PR`, and that
                  status; a parked record's PR is the one its `parked` names,
                  the pull request its park judged. A parked lane's disk is
                  stopped, so no row below reads it.
  Validation      one line per lanes[] record reading running: the minutes
                  its validation runs took, in total and per dev round or
                  restack, from
                  the validate_rounds its own workflow state holds
                  (schemas/workflow-state.md), each rounded to the nearest
                  minute; `no validation run recorded` where it holds none.
  Use 1           the fleet log's use1 rows stamped since the last report,
                  counted by outcome: `Use 1: approved-on-rerequest=N
                  fallback=N declined-unchanged=N`, then `unrecognized=N`
                  where a row carries any other outcome.
                  The overseer writes them per
                  references/copilot-head-notices.md § Use 1 rows. A row
                  whose `at` is not ISO 8601 UTC refuses as state.
  Next            the first ORCH_REPORT_UPCOMING keys of launch_queue that
                  have no lanes[] record, whatever its status: a record is
                  written at launch, so a key with one has launched.
  Waiting on you  each owner ask no answer has closed, from `lane-mail
                  pending --item overseer --to owner`, as `Question for you:
                  <text>`, with its recommendation and the time after which
                  it becomes the default where the ask carries them; a
                  reserved ask says it has no default and when it is due,
                  or that it is overdue once that time has passed, or,
                  once `lane-mail events` holds an owner answer to it, that
                  it awaits its close,
                  then one line per thing a running lane waits on, naming the
                  item: an ask `lane-mail pending` lists, the post_pr_stop its
                  own workflow state holds, and failing checks on its open PR
                  as `github.sh pr-list-failing --all` judges them; its lane-mail
                  refusal naming the item is `- ITEM mailbox unreadable ...`.
                  A lane whose host kind's channel is not mailbox (lane-host
                  capabilities), a Claude cloud session, has no mailbox read.
A row with nothing in it reads `none`. Landed, Running and Next are tables
whose columns ORCH_REPORT_COLUMNS lists: `issue`; `what it is`, the issue's
title; `why it matters`, the first line of its `## Done when` section. The
tracker is the lane record's, else the one the key names (lib/lane-state.sh,
lane_key_tracker). A Linear issue is read live through the linear skill, a
GitHub issue-N from the record's repo. An item whose tracker neither answers
renders `(tracker unknown)` as what it is, a GitHub item whose record names
no repo `(repo unknown)`, one whose key is not issue-N `(no issue number)`,
each with `-` as why it matters: that issue was not read.

Settings, read through the kendex settings ladder:
  ORCH_REPORT                on | off, default on; off silences due alone,
                             and write, the handover report's route,
                             still writes
  ORCH_REPORT_EVERY_MINUTES  minutes between reports, default 120; 0 or empty
                             turns this trigger off
  ORCH_REPORT_EVERY_ISSUES   landed items that make a report due, default 0,
                             which turns this trigger off
  ORCH_REPORT_QUIET_HOURS    owner-local start-end hours, default 0-7; empty
                             turns suppression off. Each hour is 0 to 23,
                             without leading zeros; start and end differ.
                             Start is included, end excluded; 23-7 wraps
                             midnight. Suppresses write's owner notice only
  ORCH_OWNER_TIME_ZONE       named zone in the host's zoneinfo, default
                             America/Los_Angeles; never the runner's zone
  ORCH_REPORT_UPCOMING       Next rows, default 5
  ORCH_REPORT_COLUMNS        comma-separated column names, default
                             `issue,what it is,why it matters`
  ORCH_REPORT_SUMMARY_LINES  positive line cap for write's summary, default 15;
                             counts blank lines, excluding trailing blanks
  ORCH_CONNECTED_REPOS       blank-separated OWNER/REPO list, read through
                             orch-env in this checkout as oversee-watch reads
                             it: each entry, lowercased, is read after the
                             --repo values by every list a --repo is, an
                             entry they already name in any casing skipped.
                             Unreadable refuses as setting-read
  OVERSEE_REPORT_TRACKER     path to the Linear CLI
  OVERSEE_REPORT_GITHUB      path to the github skill's github.sh
  OVERSEE_REPORT_LANE_MAIL, OVERSEE_REPORT_LANE_HOST,
  OVERSEE_REPORT_WORKFLOW_STATE
                             paths to lane-mail, lane-host and workflow-state
The report's directory is ORCH_PROGRESS_REPORT_DIR, workflow-state's setting.

GitHub auth, before the first gh call: the ladder oversee-watch runs
(references/gates.md § Waiter auth ladder), the env token, then the
keyring, then the project's GH_BOT_TOKEN. None working refuses as
auth-failed.

Exit status:
  0  the line, the rows or the report was printed, or nothing was due
  2  a refusal; the first stderr line is `oversee-report: KEY=VALUE`
EOF
}

# --- arguments ---------------------------------------------------------------

[[ $# -ge 1 ]] || refuse args none
case "$1" in
  -h | --help) usage; exit 0 ;;
  due | render | write) VERB="$1"; shift ;;
  *) refuse args "$1" ;;
esac
STATE=""
SUMMARY=""
SUCCESSION=0
REPOS=()
while [[ $# -gt 0 ]]; do
  case "$1" in
    --state) [[ $# -ge 2 && -n "$2" ]] || refuse args "$1"; STATE="$2"; shift 2 ;;
    --repo) [[ $# -ge 2 && -n "$2" ]] || refuse args "$1"; REPOS+=("$2"); shift 2 ;;
    --summary-file) [[ $# -ge 2 && -n "$2" ]] || refuse args "$1"; SUMMARY="$2"; shift 2 ;;
    --succession) SUCCESSION=1; shift ;;
    -h | --help) usage; exit 0 ;;
    *) refuse args "$1" ;;
  esac
done
[[ -n "$STATE" ]] || refuse args missing-state
[[ ${#REPOS[@]} -gt 0 ]] || refuse args missing-repo
if [[ "$VERB" == write ]]; then
  [[ -n "$SUMMARY" ]] || refuse args missing-summary-file
elif [[ -n "$SUMMARY" || "$SUCCESSION" -eq 1 ]]; then
  refuse args write-only-option
fi

# --- held stderr -------------------------------------------------------------

# From here on every helper's stderr, the settings loader's, the auth ladder's
# and that of any command whose refusal passes no cause, goes to one file,
# printed to the caller at exit after this script's own lines: a refusal's
# first stderr line is its key whatever ran before it. mktemp's own stderr,
# with nowhere yet to hold it, is dropped; the key names it.
WORK_DIR="$(mktemp -d 2>/dev/null)" || refuse clock mktemp
TMP_FILE=""
trap '[[ ! -s "$WORK_DIR/held.err" ]] || cat -- "$WORK_DIR/held.err" >&3; rm -rf -- "${WORK_DIR:?}"; [[ -z "$TMP_FILE" ]] || rm -f -- "$TMP_FILE"' EXIT
exec 2>"$WORK_DIR/held.err"

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$PROJECT_ROOT" || refuse settings-load "$PROJECT_ROOT"
# shellcheck source=lib/date-ladder.sh
source "$SCRIPT_DIR/lib/date-ladder.sh"
# shellcheck source=lib/lane-gitfile.sh
source "$SCRIPT_DIR/lib/lane-gitfile.sh"
# shellcheck source=lib/lane-state.sh
source "$SCRIPT_DIR/lib/lane-state.sh"
TRACKER="${OVERSEE_REPORT_TRACKER:-$SCRIPT_DIR/../../linear/scripts/linear.sh}"
GITHUB="${OVERSEE_REPORT_GITHUB:-$SCRIPT_DIR/../../github/scripts/github.sh}"
LANE_MAIL="${OVERSEE_REPORT_LANE_MAIL:-$SCRIPT_DIR/lane-mail}"
LANE_HOST="${OVERSEE_REPORT_LANE_HOST:-$SCRIPT_DIR/lane-host}"
WORKFLOW_STATE="${OVERSEE_REPORT_WORKFLOW_STATE:-$SCRIPT_DIR/workflow-state}"
# Relative to a clone's root on a lane's host, as workflow-state joins it.
STATE_DIR_SETTING="${ORCH_STATE_DIR:-tmp}"

# shellcheck source=lib/gh-auth.sh
source "$SCRIPT_DIR/lib/gh-auth.sh" 2>"$WORK_DIR/gh-auth.err" \
  || refuse auth-helper "$SCRIPT_DIR/lib/gh-auth.sh" "$(cat "$WORK_DIR/gh-auth.err")"
# After gh-auth.sh, which refuses a missing github skill first: lib/gh-repo.sh,
# which this sources, reads the same skill.
# shellcheck source=lib/escapes.sh
source "$SCRIPT_DIR/lib/escapes.sh"

# github_auth — the auth ladder oversee-watch runs (references/gates.md §
# Waiter auth ladder): a stale env token yields to the keyring, and where
# neither works the project's GH_BOT_TOKEN is the last candidate. Never
# unauthenticated, since an unauthenticated list would read as nothing landed.
# Called before the first gh call alone, so a due judged on minutes asks
# GitHub nothing. What the ladder writes, a keyring-fallback warning or why
# each credential failed, is held stderr.
github_auth() {
  orch_sanitize_gh_env
  orch_github_auth_status && return 0
  unset GH_TOKEN GITHUB_TOKEN
  { orch_load_env_bot_token "$PROJECT_ROOT" && orch_github_auth_status; } || refuse auth-failed github
}

# --- settings ----------------------------------------------------------------

# `-` rather than `:-` throughout: an empty ORCH_REPORT_EVERY_MINUTES is a
# setting that turns the trigger off, not an absent one.
REPORT="${ORCH_REPORT-on}"
case "$REPORT" in on | off) ;; *) refuse setting "ORCH_REPORT:$REPORT" ;; esac
# Off is decided before any other setting or the state is read: a cadence the
# settings turn off judges nothing, so nothing it would have read can fail it.
[[ "$VERB" != due || "$REPORT" == on ]] || exit 0
# The repositories ORCH_CONNECTED_REPOS lists, after the --repo values, as the
# watch whose report-due event runs this reads them: a merge there can make a
# report due, so the report lists it.
CONNECTED="$(orch_connected_repos "${REPOS[@]}")" || refuse setting-read ORCH_CONNECTED_REPOS
IFS=$'\n' read -ra CONNECTED_REPOS -d '' <<<"$CONNECTED" || true
REPOS+=(${CONNECTED_REPOS[@]+"${CONNECTED_REPOS[@]}"})
EVERY_MINUTES="${ORCH_REPORT_EVERY_MINUTES-120}"
[[ "$EVERY_MINUTES" =~ ^(0|[1-9][0-9]*)?$ ]] || refuse setting "ORCH_REPORT_EVERY_MINUTES:$EVERY_MINUTES"
EVERY_ISSUES="${ORCH_REPORT_EVERY_ISSUES-0}"
[[ "$EVERY_ISSUES" =~ ^(0|[1-9][0-9]*)$ ]] || refuse setting "ORCH_REPORT_EVERY_ISSUES:$EVERY_ISSUES"
QUIET_HOURS="${ORCH_REPORT_QUIET_HOURS-0-7}"
OWNER_ZONE="${ORCH_OWNER_TIME_ZONE-America/Los_Angeles}"
# date accepts an unknown TZ as UTC on some hosts. The owner's named zone
# must exist in the host's zoneinfo, as usage-reset's named-zone reader needs.
[[ -n "$OWNER_ZONE" && -f "${TZDIR:-/usr/share/zoneinfo}/$OWNER_ZONE" && -r "${TZDIR:-/usr/share/zoneinfo}/$OWNER_ZONE" ]] || refuse setting "ORCH_OWNER_TIME_ZONE:$OWNER_ZONE"
QUIET_START=0
QUIET_END=0
if [[ -n "$QUIET_HOURS" ]]; then
  [[ "$QUIET_HOURS" =~ ^([0-9]|1[0-9]|2[0-3])-([0-9]|1[0-9]|2[0-3])$ ]] || refuse setting "ORCH_REPORT_QUIET_HOURS:$QUIET_HOURS"
  QUIET_START="${BASH_REMATCH[1]}"
  QUIET_END="${BASH_REMATCH[2]}"
  [[ "$QUIET_START" -ne "$QUIET_END" ]] || refuse setting "ORCH_REPORT_QUIET_HOURS:$QUIET_HOURS"
fi
# One judgement for due's morning catch-up and write's notice suppression.
# Hours are start-inclusive and end-exclusive; a window can cross midnight.
quiet_at() {
  local hour
  [[ -n "$QUIET_HOURS" ]] || return 1
  hour="$(from_epoch "$1" %H "$OWNER_ZONE")" || refuse clock "$1"
  hour=$((10#$hour))
  if [[ "$QUIET_START" -lt "$QUIET_END" ]]; then
    [[ "$hour" -ge "$QUIET_START" && "$hour" -lt "$QUIET_END" ]]
  else
    [[ "$hour" -ge "$QUIET_START" || "$hour" -lt "$QUIET_END" ]]
  fi
}
UPCOMING="${ORCH_REPORT_UPCOMING-5}"
[[ "$UPCOMING" =~ ^(0|[1-9][0-9]*)$ ]] || refuse setting "ORCH_REPORT_UPCOMING:$UPCOMING"
COLUMNS_SETTING="${ORCH_REPORT_COLUMNS-issue,what it is,why it matters}"
COLUMNS=()
column_list=()
IFS=',' read -r -a column_list <<<"$COLUMNS_SETTING"
for column in ${column_list[@]+"${column_list[@]}"}; do
  column="${column#"${column%%[![:space:]]*}"}"
  column="${column%"${column##*[![:space:]]}"}"
  case "|$COLUMN_VOCABULARY|" in *"|$column|"*) ;; *) refuse setting "ORCH_REPORT_COLUMNS:$COLUMNS_SETTING" ;; esac
  for seen in ${COLUMNS[@]+"${COLUMNS[@]}"}; do
    [[ "$seen" != "$column" ]] || refuse setting "ORCH_REPORT_COLUMNS:$COLUMNS_SETTING"
  done
  COLUMNS+=("$column")
done
[[ ${#COLUMNS[@]} -gt 0 ]] || refuse setting "ORCH_REPORT_COLUMNS:$COLUMNS_SETTING"

# Check the owner comment before progress-report-path creates its directory.
if [[ "$VERB" == write ]]; then
SUMMARY_LINES="${ORCH_REPORT_SUMMARY_LINES-15}"
[[ "$SUMMARY_LINES" =~ ^[1-9][0-9]*$ ]] || refuse setting "ORCH_REPORT_SUMMARY_LINES:$SUMMARY_LINES"
[[ -f "$SUMMARY" && -r "$SUMMARY" ]] || refuse summary "$SUMMARY"
if ! SUMMARY_TEXT="$(awk '{ line[NR] = $0 } NF { last = NR } END { for (i = 1; i <= last; i++) print line[i] }' < "$SUMMARY")"; then
  refuse summary "$SUMMARY"
fi
[[ -n "$SUMMARY_TEXT" ]] || refuse summary "$SUMMARY"
# The overseer supplies Slack's upload comment through --summary-file.
# Slack cannot enforce the owner's format before that comment is posted.
if ! SHAPE_FAILURE="$(LC_ALL=C awk -v cap="$SUMMARY_LINES" '
  {
    text = $0
    gsub(/<https?:\/\/[^<>|[:space:]]+\|[^<>]+>/, "", text)
    if (text ~ /(^|[^[:alnum:]_])KEN-[0-9]+([^[:alnum:]_]|$)/ ||
        text ~ /(^|[^[:alnum:]_])#[0-9]+([^[:alnum:]_]|$)/) bare = 1
    if ($0 ~ /https?:\/\/github\.com\/[^\/[:space:]<>]+\/[^\/[:space:]<>]+\/(pull|commit)\//) github = 1
    label = $0
    gsub(/\*/, "", label)
    sub(/^[[:space:]]+/, "", label)
    if (label ~ /^Waiting on you(:|[[:space:]]*$)/) waiting = 1
    if (label ~ /^(Landed|Running|Blocked|Waiting on you)(:|[[:space:]]*$)/ &&
        (NR == 1 || previous ~ /[^[:space:]]/)) spacing = 1
    previous = $0
  }
  END {
    if (bare) print "bare-id"
    else if (github) print "github-link"
    else if (!waiting) print "waiting-on-you"
    else if (spacing) print "label-spacing"
    else if (NR > cap) print "line-cap"
  }' <<<"$SUMMARY_TEXT")"; then
  refuse summary "$SUMMARY"
fi
[[ -z "$SHAPE_FAILURE" ]] || refuse summary-shape "$SHAPE_FAILURE"
fi

# --- fleet state and the last report -----------------------------------------

if ! STATE_JSON="$(jq -c 'select(type == "object" and ((.lanes // []) | type) == "array") | .lanes //= []' -- "$STATE" 2>/dev/null)"; then
  refuse state "$STATE"
fi
[[ -n "$STATE_JSON" ]] || refuse state "$STATE"
# NOW is read before any list, and a report covers merges before it alone: a
# written report is stamped NOW, so a merge the lists could not yet see falls
# in the next one, and every merge inside the lookback below in exactly one.
NOW="$(date -u +%s)" || refuse clock now
NOTICE_MODE=send
if quiet_at "$NOW"; then NOTICE_MODE=quiet; fi

# MARKER is the epoch the cadence measures from: the newest report's
# modification time, else the fleet start, else empty where the state records
# no lane. Owner notices keep a separate starting point for report contents.
# report_path [--succession] — sets REPORT_PATH to the path workflow-state
# gives the next report, and REPORT_GLOB to its name's shape, each digit a
# [0-9]: a report is a file of that shape, and nothing here spells the name.
REPORT_PATH=""
REPORT_GLOB=""
report_path() {
  local base
  if ! REPORT_PATH="$("$WORKFLOW_STATE" progress-report-path "$@" 2>"$WORK_DIR/report-path.err")" \
    || [[ -z "$REPORT_PATH" ]]; then
    refuse report-path "${1:-plain}" "$(cat "$WORK_DIR/report-path.err")"
  fi
  base="${REPORT_PATH##*/}"
  REPORT_GLOB="${base//[0-9]/[0-9]}"
}
report_path --succession
SUCCESSION_GLOB="$REPORT_GLOB"
report_path
REPORT_DIR="${REPORT_PATH%/*}"
MARKER=""
# lane-mail events is the existing record of notices actually sent. Match
# report attachments, not other owner notices, and use the file's list-read
# time rather than the notice's later time, which could skip a mid-render merge.
if ! OWNER_EVENTS="$("$LANE_MAIL" events --item overseer 2>"$WORK_DIR/mail.err")"; then
  refuse owner-reports overseer "$(cat "$WORK_DIR/mail.err")"
fi
if ! OWNER_REPORTS="$(jq -s '[.[] | select(.kind == "notice" and .to == "owner") | .attach // empty]' \
  <<<"$OWNER_EVENTS" 2>"$WORK_DIR/mail.err")"; then
  refuse owner-reports overseer "$(cat "$WORK_DIR/mail.err")"
fi
# The asks an owner answer names, by lane-mail's own class for an answer:
# Waiting on you reads a reserved one as answered, not overdue.
if ! OWNER_ANSWERED="$(jq -s '[.[] | select(.box == "to-lane" and .mail_class == "resolution") | .re]' \
  <<<"$OWNER_EVENTS" 2>"$WORK_DIR/mail.err")"; then
  refuse owner-asks overseer "$(cat "$WORK_DIR/mail.err")"
fi
OWNER_MARKER=""
for file in "$REPORT_DIR"/*; do
  [[ -f "$file" ]] || continue
  # Unquoted on purpose: each glob is a pattern.
  # shellcheck disable=SC2053
  [[ "${file##*/}" == $REPORT_GLOB || "${file##*/}" == $SUCCESSION_GLOB ]] || continue
  stamp="$(stat -c %Y -- "$file" 2>/dev/null || stat -f %m -- "$file" 2>/dev/null)" || refuse clock "$file"
  [[ -n "$MARKER" && "$MARKER" -ge "$stamp" ]] || MARKER="$stamp"
  sent="$(jq -r --arg file "$file" 'index($file) != null' <<<"$OWNER_REPORTS")" || refuse owner-reports overseer
  if [[ "$sent" == true ]]; then
    [[ -n "$OWNER_MARKER" && "$OWNER_MARKER" -ge "$stamp" ]] || OWNER_MARKER="$stamp"
  fi
done
if [[ -z "$MARKER" || -z "$OWNER_MARKER" ]]; then
  start="$(jq -r '[.lanes[] | .launched_at // empty] | sort | first // ""' <<<"$STATE_JSON")" || refuse state "$STATE"
  if [[ -n "$start" ]]; then
    start="$(to_epoch "$start")" || refuse state "$STATE"
    [[ -n "$MARKER" ]] || MARKER="$start"
    [[ -n "$OWNER_MARKER" ]] || OWNER_MARKER="$start"
  fi
fi
# Cadence counts from every written report. The report itself counts from
# the last sent one. If retention removed that file, the fleet start is a
# conservative floor; the existing lookback still bounds the merged search.
WINDOW_MARKER="$OWNER_MARKER"
[[ "$VERB" != due ]] || WINDOW_MARKER="$MARKER"
# A window as old as a fleet that ran for weeks, or one resumed after a long
# pause, passes the merged search's ceiling, and a refusal there would stand
# on every call until someone edited the report directory. Landed stops at the
# lookback instead, and its row says it did.
LANDED_SINCE="$WINDOW_MARKER"
LANDED_CUT=0
if [[ -n "$WINDOW_MARKER" && $((NOW - LANDED_LOOKBACK)) -gt "$WINDOW_MARKER" ]]; then
  LANDED_SINCE=$((NOW - LANDED_LOOKBACK))
  LANDED_CUT=1
fi

# --- what landed --------------------------------------------------------------

# LANDED holds `item<TAB>number<TAB>sha` per fleet item whose own pull
# request merged at or after LANDED_SINCE and before NOW, in any REPOS entry, oldest
# merge first. Each repository is read once, as one search for pull requests
# merged since then, and every lanes[] item is matched against that one list by
# lib/lane-state.sh's LANE_MERGED_JQ, the filter oversee-watch's merged check
# uses: the calls stay one per repository however many lanes the fleet has run.
LANDED=""
landed_read() {
  local repo items list rows since found=""
  [[ -n "$LANDED_SINCE" ]] || return 0
  # Each item with its parked record, whose pull request number lane_own
  # takes in the repository that record names; of an item's records, one
  # carrying a park wins, as the watch reads it.
  if ! items="$(jq -c '[.lanes[] | select(.item)] | group_by(.item)
    | map((map(select(.parked)) | first) // first | {item, parked: (.parked // {})})' <<<"$STATE_JSON")"; then
    refuse state "$STATE"
  fi
  since="$(from_epoch "$LANDED_SINCE" %Y-%m-%dT%H:%M:%SZ)" || refuse clock "$LANDED_SINCE"
  for repo in "${REPOS[@]}"; do
    if ! list="$(gh pr list --repo "$repo" --state merged --search "merged:>=$since" --limit "$MERGED_PAGE" \
      --json number,headRefName,headRepositoryOwner,mergedAt,mergeCommit,title,body 2>"$WORK_DIR/gh.err")"; then
      refuse pr-list "$repo" "$(cat "$WORK_DIR/gh.err")"
    fi
    if ! rows="$(jq -r --argjson items "$items" --arg repo "$repo" --arg owner "${repo%%/*}" --argjson since "$LANDED_SINCE" \
      --argjson until "$NOW" --argjson page "$MERGED_PAGE" "$LANE_MERGED_JQ"'
      if length >= $page then "page-full"
      else . as $list | $items[] as $lane
        | (if ($lane.parked.repo // "" | ascii_downcase) == ($repo | ascii_downcase) then $lane.parked.pr else null end) as $pr
        | $list | lane_merged($lane.item; $owner; $pr; $since)[] | select(.at < $until)
        | [(.at | tostring), $lane.item, (.number | tostring), ((.mergeCommit.oid // "") | .[0:7])] | @tsv
      end' <<<"$list" 2>"$WORK_DIR/jq.err")"; then
      refuse pr-list "$repo" "$(cat "$WORK_DIR/jq.err")"
    fi
    [[ "$rows" != page-full ]] || refuse pr-list-truncated "$repo"
    [[ -z "$rows" ]] || found+="$rows"$'\n'
  done
  [[ -n "$found" ]] || return 0
  if ! LANDED="$(sort -n -k1,1 <<<"$found" | cut -f2-)"; then
    refuse sort landed
  fi
  LANDED+=$'\n'
}

# --- due -----------------------------------------------------------------------

if [[ "$VERB" == due ]]; then
  [[ -n "$MARKER" ]] || exit 0
  since="$(from_epoch "$MARKER" %Y-%m-%dT%H:%M:%SZ)" || refuse clock "$MARKER"
  # A recent quiet report must not delay the morning brief by another interval.
  # A disabled cadence remains disabled, including after the quiet window.
  if [[ "$NOTICE_MODE" == send && -n "$OWNER_MARKER" && "$MARKER" -gt "$OWNER_MARKER" &&
        ("${EVERY_MINUTES:-0}" -gt 0 || "$EVERY_ISSUES" -gt 0) ]] && quiet_at "$MARKER"; then
    since="$(from_epoch "$OWNER_MARKER" %Y-%m-%dT%H:%M:%SZ)" || refuse clock "$OWNER_MARKER"
    echo "report-due reason=minutes since=$since"
    exit 0
  fi
  if [[ -n "$EVERY_MINUTES" && "$EVERY_MINUTES" -gt 0 && $((NOW - MARKER)) -ge $((EVERY_MINUTES * 60)) ]]; then
    echo "report-due reason=minutes since=$since"
    exit 0
  fi
  [[ "$EVERY_ISSUES" -gt 0 ]] || exit 0
  github_auth
  landed_read
  # Items, not pull requests: one item's second PR, in a consumer repository
  # under the same branch, is not a second item finished.
  count="$(awk -F'\t' 'NF && !seen[$1]++ { n++ } END { print n + 0 }' <<<"$LANDED")"
  # Where the lookback cut the window, the count since MARKER is at least this
  # one and is not read: one item inside it makes the report due, so items
  # landing further apart than the lookback still reach a report.
  if [[ "$count" -ge "$EVERY_ISSUES" || ("$LANDED_CUT" -eq 1 && "$count" -gt 0) ]]; then
    echo "report-due reason=issues since=$since landed=$count"
  fi
  exit 0
fi

# --- render ----------------------------------------------------------------------

# issue_cells ITEM — sets TITLE and WHY from the item's issue, read from the
# tracker its lane record names, else the one lane_key_tracker says its key
# names. Where neither answers, or a GitHub record names no repository, the
# issue is not read: TITLE names why in parentheses and WHY stays empty, so an
# unread row reads apart from a read one with no Done-when. The report never
# guesses a tracker or a repo.
TITLE=""
WHY=""
issue_cells() {
  local item="$1" fields tracker repo json
  TITLE=""
  WHY=""
  if ! fields="$(jq -r --arg item "$item" '
    [.lanes[] | select(.item == $item)] | first // {}
    | "\(.tracker // "")\u001f\(.repo // "")"' <<<"$STATE_JSON")"; then
    refuse state "$STATE"
  fi
  # A unit separator, not a tab: IFS whitespace would fold an empty tracker
  # into the repo that follows it.
  IFS=$'\x1f' read -r tracker repo <<<"$fields"
  [[ -n "$tracker" ]] || tracker="$(lane_key_tracker "$item")"
  case "$tracker" in
    github)
      [[ -n "$repo" ]] || { TITLE="(repo unknown)"; return 0; }
      [[ "$item" =~ ^issue-[0-9]+$ ]] || { TITLE="(no issue number)"; return 0; }
      if ! json="$(gh issue view "${item#issue-}" --repo "$repo" --json title,body 2>"$WORK_DIR/tracker.err")"; then
        refuse tracker-read "$item" "$(cat "$WORK_DIR/tracker.err")"
      fi
      if ! json="$(jq -c '{title, description: .body}' <<<"$json" 2>"$WORK_DIR/tracker.err")"; then
        refuse tracker-read "$item" "$(cat "$WORK_DIR/tracker.err")"
      fi ;;
    linear)
      [[ -x "$TRACKER" ]] || refuse tracker-missing "$TRACKER"
      # --format=safe pins the shape: LINEAR_FORMAT from the project's settings
      # would otherwise nest the issue or drop its description.
      if ! json="$("$TRACKER" issues get "$item" --format=safe 2>"$WORK_DIR/tracker.err")"; then
        refuse tracker-read "$item" "$(cat "$WORK_DIR/tracker.err")"
      fi ;;
    *) TITLE="(tracker unknown)"; return 0 ;;
  esac
  # A read that answered with no title answered nothing this report can use.
  if ! TITLE="$(jq -r 'if (.title | type) == "string" and .title != "" then .title else error("no title") end' \
    <<<"$json" 2>"$WORK_DIR/tracker.err")"; then
    refuse tracker-read "$item" "$(cat "$WORK_DIR/tracker.err")"
  fi
  WHY="$(jq -r '(("\n" + (.description // "")) | gsub("\r\n"; "\n") | split("\n## Done when\n")) as $s
    | if ($s | length) > 1 then ($s[1] | split("\n## ")[0]) else "" end
    | [split("\n")[] | select(test("\\S"))] | first // ""
    | sub("^\\s*([-*]|[0-9]+\\.)\\s+"; "")' <<<"$json" 2>"$WORK_DIR/tracker.err")" \
    || refuse tracker-read "$item" "$(cat "$WORK_DIR/tracker.err")"
}

# cell TEXT — one table cell: whitespace collapsed, cut to CELL_MAX
# characters, bars escaped, `-` for nothing.
cell() {
  local text
  text="$(printf '%s' "$1" | tr '\n\t' '  ' | awk '{ $1 = $1; print }')"
  [[ ${#text} -le $CELL_MAX ]] || text="${text:0:$((CELL_MAX - 3))}..."
  text="${text//|/\\|}"
  printf '%s' "${text:--}"
}

# table NAME ROWS — ROWS holds `item<TAB>issue cell` lines; `NAME: none`
# where it holds none.
table() {
  local name="$1" rows="$2" item label column line
  if [[ -z "$rows" ]]; then
    printf '%s: none\n' "$name"
    return 0
  fi
  printf '%s:\n' "$name"
  line="|"; for column in "${COLUMNS[@]}"; do line+=" $column |"; done; printf '%s\n' "$line"
  line="|"; for column in "${COLUMNS[@]}"; do line+=" --- |"; done; printf '%s\n' "$line"
  while IFS=$'\t' read -r item label; do
    [[ -n "$item" ]] || continue
    issue_cells "$item"
    line="|"
    for column in "${COLUMNS[@]}"; do
      case "$column" in
        issue) line+=" $(cell "$label") |" ;;
        "what it is") line+=" $(cell "$TITLE") |" ;;
        "why it matters") line+=" $(cell "$WHY") |" ;;
        *) echo "oversee-report: column $column passed the vocabulary check and has no renderer" >&3; exit 2 ;;
      esac
    done
    printf '%s\n' "$line"
  done <<<"$rows"
}

# running_lanes — reads each running lane once for two rows. BLOCKERS gets one
# line per thing the lane waits on: an ask the overseer has not answered, a
# post-PR stop its state records, and red checks on its open pull request.
# Each line names the item and what it waits on, so it reads apart from a
# question for the user. VALIDATION gets one line per lane: the minutes its
# recorded validation runs took, in total and per dev round or restack.
BLOCKERS=""
VALIDATION=""
running_lanes() {
  local lanes item host root args asks mail rc line failing="" repo list stop minutes channel
  BLOCKERS=""
  VALIDATION=""
  for repo in "${REPOS[@]}"; do
    # github.sh picks its own token, and puts GH_BOT_TOKEN, inherited or from
    # the project's env files, ahead of the keyring and of GITHUB_TOKEN.
    # github_auth has already chosen, and a bot it chose is GH_TOKEN, so an
    # empty GH_BOT_TOKEN, which the project files cannot override, holds the
    # child to that choice.
    if ! list="$(GH_BOT_TOKEN='' GH_REPO="$repo" "$GITHUB" pr-list-failing --all 2>"$WORK_DIR/gh.err")"; then
      refuse pr-list "$repo" "$(cat "$WORK_DIR/gh.err")"
    fi
    if ! list="$(jq -r '.[] | "\(.branch | ascii_downcase)\t#\(.number)\t\(.failed_checks | join(", "))"' <<<"$list" 2>"$WORK_DIR/gh.err")"; then
      refuse pr-list "$repo" "$(cat "$WORK_DIR/gh.err")"
    fi
    [[ -z "$list" ]] || failing+="$list"$'\n'
  done
  lanes="$(jq -r '.lanes[] | select(.status == "running") | "\(.item)\u001f\(.host // "")\u001f\(.mail_root // "")"' <<<"$STATE_JSON")" \
    || refuse state "$STATE"
  while IFS=$'\x1f' read -r item host root; do
    [[ -n "$item" ]] || continue
    [[ -n "$root" ]] || refuse state "$STATE"
    args=(pending --item "$item" --root "$root")
    [[ -z "$host" ]] || args+=(--host)
    # A refusal naming this lane marks its row, as the heartbeat's `failing`
    # does; any other failure, a missing or crashed helper too, refuses. A
    # lane whose host kind's channel is not the mailbox, a Claude cloud
    # session, has no mailbox to read, as lane_item_state reads no state
    # where files=none.
    lane_capabilities_read "$LANE_HOST" "${host:-local}" 2>"$WORK_DIR/caps.err" \
      || refuse host-capabilities "${host:-local}" "$(cat "$WORK_DIR/caps.err")"
    lane_capability channel channel
    mail=read rc=0 asks=""
    case "$channel" in
      mailbox) asks="$(ORCH_LANE_HOST="$host" "$LANE_MAIL" "${args[@]}" 2>"$WORK_DIR/mail.err")" || rc=$? ;;
      session|task) ;;
      *) refuse host-capabilities "${host:-local}" "channel=$channel" ;;
    esac
    [[ "$rc" -ne "$LANE_HOST_BUSY_EXIT" ]] || refuse lane-host-busy "$item" "$(cat "$WORK_DIR/mail.err")"
    if [[ "$rc" -ne 0 ]]; then
      line="$(awk 'NR == 1' "$WORK_DIR/mail.err")"
      [[ "$rc" -eq 2 && "$line" =~ $LANE_MAIL_REFUSAL && "${BASH_REMATCH[2]}" == "$item" ]] \
        || refuse mail-read "$item" "$(cat "$WORK_DIR/mail.err")"
      mail="${BASH_REMATCH[1]}" asks=""
      BLOCKERS+="- $item mailbox unreadable (mail-read=$item): $line"$'\n'
    fi
    # pending also lists the unread directives this overseer sent the lane,
    # which wait on the lane, not on the overseer: the asks alone are kept.
    if ! asks="$(jq -r -R --arg item "$item" 'fromjson? | objects | select(.kind == "ask") | "- \($item) waits on the overseer to answer: \(.text // "" | gsub("\n"; " "))"' <<<"$asks" 2>"$WORK_DIR/mail.err")"; then
      refuse mail-read "$item" "$(cat "$WORK_DIR/mail.err")"
    fi
    [[ -z "$asks" ]] || BLOCKERS+="$asks"$'\n'
    # A host that did not answer holds the hosted lane's state too.
    LANE_ITEM_STATE="" rc=0
    [[ "$mail" == host-unreachable && -n "$host" ]] || lane_item_state \
      "$WORKFLOW_STATE" "$LANE_HOST" "$STATE_DIR_SETTING" "$item" "$host" "$root" "$WORK_DIR" \
      || rc=$?
    case "$rc" in
      0) ;;
      4) refuse lane-host-busy "$item" "$(cat "$WORK_DIR/state.err")" ;;
      *) refuse item-state "$item" "$(cat "$WORK_DIR/state.err")" ;;
    esac
    if [[ -n "$LANE_ITEM_STATE" ]]; then
      if ! stop="$(jq -r --arg item "$item" '.post_pr_stop // empty
        | "- \($item) waits on a stopped \(.gate // "post-PR") gate, \(.name // "unnamed"): \((.remaining // []) | join("; "))"' <<<"$LANE_ITEM_STATE")"; then
        refuse item-state "$item" "$LANE_ITEM_STATE"
      fi
      [[ -z "$stop" ]] || BLOCKERS+="$stop"$'\n'
    fi
    if [[ "$mail" == host-unreachable && -n "$host" ]]; then
      minutes="- $item: validation unread, its host unreachable"
    elif ! minutes="$(jq -r --arg item "$item" 'def min: (. + 30) / 60 | floor;
      (if . == null then [] else .validate_rounds // [] end) as $rounds
      | if ($rounds | length) == 0 then "- \($item): no validation run recorded"
        else "- \($item): \([$rounds[].seconds] | add | min) min over \($rounds | length) run\(if ($rounds | length) == 1 then "" else "s" end): \([$rounds[] | "\(.kind) \(.mode) \(.seconds | min) selection=\(.selection // "unreported")\(if .lanes == null then "" else " lanes=\(.lanes)" end)"] | join(", "))"
        end' <<<"${LANE_ITEM_STATE:-null}" 2>"$WORK_DIR/state.err")"; then
      refuse item-state "$item" "$(cat "$WORK_DIR/state.err")"
    fi
    VALIDATION+="$minutes"$'\n'
    if ! list="$(awk -F'\t' -v item="$item" \
      'tolower(item) == $1 { print "- " item " waits on red checks on " $2 ": " $3 }' <<<"$failing")"; then
      refuse pr-list "${REPOS[0]}" "the failing-check list could not be matched to $item"
    fi
    [[ -z "$list" ]] || BLOCKERS+="$list"$'\n'
  done <<<"$lanes"
  BLOCKERS="${BLOCKERS%$'\n'}"
  VALIDATION="${VALIDATION%$'\n'}"
}

# escapes_row — the Escapes line under Landed: the escapes lib/escapes.sh
# counts in this week, in last week and in the week the review cap fell to
# one, or `Escapes: unread (<cause>)` where a source could not be read. The
# count always holds the cap week, so a missing one is a broken count.
escapes_row() {
  local this last cap
  if ! escapes_read "$PROJECT_ROOT" "$TRACKER" "$NOW" "$WORK_DIR"; then
    printf 'Escapes: unread (%s)\n' "$ESCAPE_UNREAD"
    return 0
  fi
  this="$(awk -F'\t' 'END { print $2 }' <<<"$ESCAPE_WEEKS")"
  last="$(awk -F'\t' '{ prev = cur; cur = $2 } END { print prev }' <<<"$ESCAPE_WEEKS")"
  if ! cap="$(awk -F'\t' -v week="$ESCAPE_CAP_WEEK" '$1 == week { print $2 }' <<<"$ESCAPE_WEEKS")" || [[ -z "$cap" ]]; then
    printf 'Escapes: unread (the count holds no line for the cap week %s)\n' "$ESCAPE_CAP_WEEK"
    return 0
  fi
  printf 'Escapes: this week %s, last week %s, the week the review cap fell to 1 (%s) %s\n' \
    "$this" "$last" "$ESCAPE_CAP_WEEK" "$cap"
}

render() {
  local rows="" item number sha repo list open="" pr status landed_name=Landed cut_since
  github_auth
  landed_read
  while IFS=$'\t' read -r item number sha; do
    [[ -n "$item" ]] || continue
    rows+="$item"$'\t'"$item (#$number, ${sha:-no sha})"$'\n'
  done <<<"$LANDED"
  if [[ "$LANDED_CUT" -eq 1 ]]; then
    if ! cut_since="$(from_epoch "$LANDED_SINCE" %Y-%m-%dT%H:%M:%SZ)"; then
      refuse clock "$LANDED_SINCE"
    fi
    landed_name="Landed (since $cut_since, earlier merges not listed)"
  fi
  table "$landed_name" "$rows"
  escapes_row
  echo

  # Open PRs as `branch<TAB>number`, across every REPOS entry.
  for repo in "${REPOS[@]}"; do
    if ! list="$(gh pr list --repo "$repo" --state open --limit "$PR_PAGE" --json number,headRefName 2>"$WORK_DIR/gh.err")"; then
      refuse pr-list "$repo" "$(cat "$WORK_DIR/gh.err")"
    fi
    if ! list="$(jq -r '.[] | "\(.headRefName | ascii_downcase)\t\(.number)"' <<<"$list" 2>"$WORK_DIR/gh.err")"; then
      refuse pr-list "$repo" "$(cat "$WORK_DIR/gh.err")"
    fi
    [[ -z "$list" ]] || open+="$list"$'\n'
  done
  running_lanes
  list="$(jq -r '.lanes[] | select(.status == "running" or .status == "preparing" or .status == "parked")
    | [.item, .status, (.parked.pr // "" | tostring)] | @tsv' <<<"$STATE_JSON")" \
    || refuse state "$STATE"
  rows=""
  while IFS=$'\t' read -r item status parked_pr; do
    [[ -n "$item" ]] || continue
    if [[ -n "$parked_pr" ]]; then pr="#$parked_pr"
    else pr="$(awk -F'\t' -v b="$(printf '%s' "$item" | tr '[:upper:]' '[:lower:]')" '$1 == b { print "#" $2; exit }' <<<"$open")"; fi
    rows+="$item"$'\t'"$item (${pr:-no PR}, $status)"$'\n'
  done <<<"$list"
  table Running "$rows"
  echo

  if [[ -z "$VALIDATION" ]]; then
    echo "Validation: none"
  else
    printf 'Validation:\n%s\n' "$VALIDATION"
  fi
  echo

  # The overseer's use1 fleet log rows stamped since the last report, counted
  # by outcome. An outcome outside the three is counted as unrecognized rather
  # than dropped, and a row whose stamp does not read refuses the report.
  if ! list="$(jq -r --argjson since "${WINDOW_MARKER:-0}" --argjson until "$NOW" '
    [(.fleet_log // [])[] | select(.kind == "use1")
      | select((.at | fromdateiso8601) as $t | $t >= $since and $t < $until) | .outcome] as $rows
    | ["approved-on-rerequest", "fallback", "declined-unchanged"] as $known
    | if ($rows | length) == 0 then "Use 1: none"
      else "Use 1: " + ([$known[] as $k | "\($k)=\([$rows[] | select(. == $k)] | length)"] | join(" "))
        + ([$rows[] | select(IN($known[]) | not)] | length | if . > 0 then " unrecognized=\(.)" else "" end)
      end' <<<"$STATE_JSON" 2>"$WORK_DIR/jq.err")"; then
    refuse state "$STATE" "$(cat "$WORK_DIR/jq.err")"
  fi
  printf '%s\n\n' "$list"

  # A queued item with any lanes[] record has launched, and a done one stays
  # in the queue until the next selection rewrites it: neither is upcoming.
  list="$(jq -r --argjson n "$UPCOMING" '
    ((.launch_queue // []) - [.lanes[].item])[:$n][]
    | [., .] | @tsv' <<<"$STATE_JSON")" \
    || refuse state "$STATE"
  table Next "$list"
  echo

  # The open questions are the overseer mailbox's own record, read through
  # the one field that names their audience; nothing here keeps a second list.
  if ! list="$("$LANE_MAIL" pending --item overseer --to owner 2>"$WORK_DIR/mail.err")"; then
    refuse owner-asks overseer "$(cat "$WORK_DIR/mail.err")"
  fi
  if ! list="$(jq -r -R --argjson now "$NOW" --argjson answered "$OWNER_ANSWERED" 'fromjson? | objects
    | "- Question for you: \(.text // "" | gsub("\n"; " "))"
      + (if .reserved == true and (.id | IN($answered[])) then " (reserved, answered, awaiting close)"
        elif .reserved == true
          then " (reserved, no default; \(if (.deadline | fromdateiso8601) <= $now then "overdue since" else "due" end) \(.deadline))"
        elif .recommend then " (recommended \(.recommend); \(if .deadline then "defaults to it after \(.deadline)" else "no deadline" end))" else "" end)' \
    <<<"$list" 2>"$WORK_DIR/mail.err")"; then
    refuse owner-asks overseer "$(cat "$WORK_DIR/mail.err")"
  fi
  list+="${list:+${BLOCKERS:+$'\n'}}$BLOCKERS"
  if [[ -z "$list" ]]; then
    echo "Waiting on you: none"
  else
    printf 'Waiting on you:\n%s\n' "$list"
  fi
}

if [[ "$VERB" == render ]]; then
  render
  exit 0
fi

# --- write -----------------------------------------------------------------------

BODY="$(render)" || exit 2
if [[ "$SUCCESSION" -eq 1 ]]; then report_path --succession; else report_path; fi
TARGET="$REPORT_PATH"
[[ ! -e "$TARGET" ]] || refuse report-exists "$TARGET"
TMP_FILE="$(mktemp "${TARGET%/*}/.report.XXXXXX")" || refuse write "${TARGET%/*}"
printf '%s\n' "$BODY" > "$TMP_FILE" || refuse write "$TMP_FILE"
# Stamped NOW, not the end of the render: the next report starts where this
# one's lists were read. touch -t reads its stamp in TZ.
STAMP="$(from_epoch "$NOW" %Y%m%d%H%M.%S)" || refuse clock "$NOW"
TZ=UTC touch -t "$STAMP" -- "$TMP_FILE" || refuse write "$TMP_FILE"
[[ ! -e "$TARGET" ]] || refuse report-exists "$TARGET"
mv -- "$TMP_FILE" "$TARGET" || refuse write "$TARGET"
TMP_FILE=""
cat -- "$TARGET" || refuse write "$TARGET"
# A quiet report advances the file cadence, but has no owner notice in the
# mailbox, so the next owner report still includes the night's merges.
if [[ "$NOTICE_MODE" == quiet ]]; then
  message report-written "$TARGET"
  exit 0
fi
# The report reaches the owner as one notice carrying the file, after the
# print so the chat has the report whatever the notice does. The summary is
# the notice's text alone, written in Slack's mrkdwn for the upload comment,
# so it stays out of the Markdown file and the chat.
printf '%s\n' "$SUMMARY_TEXT" > "$WORK_DIR/notice.txt" || refuse write "$WORK_DIR/notice.txt"
NOTICE_RECEIPT="$("$LANE_MAIL" notice --item overseer --to owner --attach "$TARGET" --file "$WORK_DIR/notice.txt" \
  2>"$WORK_DIR/notice.err")" || refuse notice "$TARGET" "$(cat "$WORK_DIR/notice.err")"
NOTICE_ID="${NOTICE_RECEIPT#* id=}"
message report-written "$TARGET notice-id=${NOTICE_ID%% *}"
