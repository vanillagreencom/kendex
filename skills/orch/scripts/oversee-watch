#!/usr/bin/env bash
# oversee-watch blocks until the fleet needs the overseer, reports every event
# the pass found as one block, and exits. The workflow handles every EVENT line
# and re-runs it.
#
# Two passes on one clock: the mail pass reads every mailbox and the lane
# records on ORCH_WATCH_MAIL_INTERVAL, and the long pass (one lane snapshot,
# pr-watch, merged items, team triage, outside contributions, refresh failures,
# security alerts, lane preparation, lane classification, accounts, report)
# runs forked on
# --interval. A check that finds an event records it and the pass runs on to
# the next check, so no kind starves another: a reducer line on every pass or
# a lane parked on its limit banner would otherwise be the only thing the watch
# ever said. The block carries the latest pr-watch context once. Live tracker and pane reads remain
# authoritative; persisted state holds only edge keys. Usage, event details,
# configuration, and failure contracts live in usage(), which lib/oversee-watch-text.sh
# holds beside the message catalog.
# Stdout is the overseer protocol: the EVENT records documented in usage(),
# their record or pane payloads, and the optional `pr-watch rc=N` context block.
# Consumers handle every EVENT in order. Those records are not prose messages.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

# shellcheck source=lib/oversee-watch-text.sh
source "$SCRIPT_DIR/lib/oversee-watch-text.sh"

die() { # REASON TOOL_DETAIL FIELD=VALUE...
  local reason="$1" detail="$2"
  shift 2
  ow_message "$reason" "$@" >&2
  [[ -z "$detail" ]] || printf '%s\n' "$detail" >&2
  exit 2
}

# A provider or mailbox failure belongs to one lane. Keep its result outside
# `die`, because ending the process here would drop every mailbox after it.
# The caller reports the failure against the state snapshot it owns, then
# commits only the rows belonging to reads that completed.
lane_failure_set() { # REASON TOOL_DETAIL FIELD=VALUE...
  LANE_FAILURE_REASON="$1"
  LANE_FAILURE_DETAIL="$2"
  shift 2
  LANE_FAILURE_FIELDS=("$@")
}

lane_failure_report() { # ITEM STATE
  local item="$1" state="$2" key stopped_state="" prior="" line token saw_kind saw_item
  local -a tokens=()
  PASS_FAILED_ITEMS+="$item"$'\n'
  # A failure is reported once, as lane-exited is: a standing one stays quiet
  # after its first report, and a different one, or a read that succeeded and
  # cleared the row, is news again. The key is the stopped state a hosted
  # provider names in its own keyed line, whose other words change from read
  # to read, and otherwise the reason with its fields and the failing tool's
  # first keyed line.
  while IFS= read -r line; do
    saw_kind=0; saw_item=0; stopped_state=""
    tokens=()
    read -ra tokens <<<"$line"
    for token in ${tokens[@]+"${tokens[@]}"}; do
      [[ "$token" == lane-stopped ]] && saw_kind=1
      [[ "$token" == "item=$item" ]] && saw_item=1
      case "$token" in state=*) stopped_state="${token#state=}" ;; esac
    done
    [[ "$saw_kind" -eq 1 && "$saw_item" -eq 1 && "$stopped_state" =~ ^[A-Za-z0-9._-]+$ ]] \
      && break
    stopped_state=""
  done <<<"$LANE_FAILURE_DETAIL"
  if [[ -n "$stopped_state" ]]; then
    key="stopped $stopped_state"
  else
    # The tool's own first keyed line: lane-mail and the hosts exit 2 for
    # every refusal, so the reason and its fields alone would make every
    # cause one failure and a new one would pass in silence.
    key="$LANE_FAILURE_REASON ${LANE_FAILURE_FIELDS[*]+"${LANE_FAILURE_FIELDS[*]}"} $(
      awk '/^[A-Za-z0-9._-]+: [A-Za-z0-9._-]+([= ]|$)/ { print; exit }' <<<"$LANE_FAILURE_DETAIL")"
  fi
  # A row value is one line with no tab in it.
  key="${key//$'\t'/ }"
  key="${key//$'\n'/ }"
  if ! prior="$(lane_row_get lane-failed "$state" "$item")"; then
    die state-read-failed "" "item=$item" "row=lane-failed"
  fi
  state="$(lane_row_set lane-failed "$state" "$item" "$key")"
  # Only news fails the run: a failure already reported and still standing
  # neither ends the run nor stretches the repeat delay, so the other lanes'
  # mail keeps its interval while one lane stays broken.
  if [[ "$prior" != "$key" ]]; then
    PASS_FAILED=1
    ow_message "$LANE_FAILURE_REASON" ${LANE_FAILURE_FIELDS[@]+"${LANE_FAILURE_FIELDS[@]}"} >&2
    [[ -z "$LANE_FAILURE_DETAIL" ]] || printf '%s\n' "$LANE_FAILURE_DETAIL" >&2
  fi
  LANE_FAILURE_STATE="$state"
}
need_val() { [[ $# -ge 2 && -n "${2:-}" ]] || die missing-value "" "option=$1"; }

# The one parser. It answers a help request and a bad option itself, so the dry
# run below decides those before any configuration is read, off these arms and
# no second copy of the option arities.
parse_argv() {
  # Every default this parser owns is set HERE, never above the loader: the
  # settings [env] table assigns any name and .env.local is sourced as shell, so
  # a default above the load is whatever the checkout left there for every
  # option the caller did not pass. Settings reach the script through their own
  # OVERSEE_WATCH_* names, resolved after the load.
  # REPOS, ITEMS and LANES are the sharpest case: the loop APPENDS to them.
  INTERVAL=240
  MAX_LOOPS=25
  SINCE=""
  REPOS=()
  ITEMS=()
  LANES=()
  HOSTED=()
  ROOTS=()
  SKIP_LANES=()
  REPEAT=""
  STATE_FILE=""
  HANDOFF=tmp/handoffs/OVERSEER-HANDOFF.md
  OVERSEER_FLAGS=()
  OVERSEER_HARNESS=""
  # How many leading words are this watch's own, before the `--` that starts
  # the overseer's flags: what the watch records of its command, and what a
  # restart from a successor pane runs again with the successor's flags.
  ARGV_BASE_COUNT=$#
  local total=$#

  while [[ $# -gt 0 ]]; do
    case "$1" in
      # Everything after it is the overseer's own launch flags, never a lane
      # window: the words are the harness's and this parser reads none of them.
      --) ARGV_BASE_COUNT=$((total - $#)); shift; OVERSEER_FLAGS=("$@"); break ;;
      --handoff) need_val "$@"; HANDOFF="$2"; shift 2 ;;
      --harness) need_val "$@"; OVERSEER_HARNESS="$2"; shift 2 ;;
      --handoff=*) HANDOFF="${1#--handoff=}"; need_val --handoff "$HANDOFF"; shift ;;
      --repeat) need_val "$@"; REPEAT="$2"; shift 2 ;;
      --repeat=*) REPEAT="${1#--repeat=}"; need_val --repeat "$REPEAT"; shift ;;
      --state) need_val "$@"; STATE_FILE="$2"; shift 2 ;;
      --state=*) STATE_FILE="${1#--state=}"; need_val --state "$STATE_FILE"; shift ;;
      --hosted) need_val "$@"; HOSTED+=("$2"); shift 2 ;;
      --hosted=*) need_val --hosted "${1#--hosted=}"; HOSTED+=("${1#--hosted=}"); shift ;;
      --root) need_val "$@"; ROOTS+=("$2"); shift 2 ;;
      --root=*) need_val --root "${1#--root=}"; ROOTS+=("${1#--root=}"); shift ;;
      --skip-lane) need_val "$@"; SKIP_LANES+=("$2"); shift 2 ;;
      --skip-lane=*) need_val --skip-lane "${1#--skip-lane=}"; SKIP_LANES+=("${1#--skip-lane=}"); shift ;;
      --interval) need_val "$@"; INTERVAL="$2"; shift 2 ;;
      --interval=*) INTERVAL="${1#--interval=}"; need_val --interval "$INTERVAL"; shift ;;
      --max-loops) need_val "$@"; MAX_LOOPS="$2"; shift 2 ;;
      --max-loops=*) MAX_LOOPS="${1#--max-loops=}"; need_val --max-loops "$MAX_LOOPS"; shift ;;
      --since) need_val "$@"; SINCE="$2"; shift 2 ;;
      --since=*) SINCE="${1#--since=}"; need_val --since "$SINCE"; shift ;;
      --item) need_val "$@"; ITEMS+=("$2"); shift 2 ;;
      --item=*) need_val --item "${1#--item=}"; ITEMS+=("${1#--item=}"); shift ;;
      --repo) need_val "$@"; REPOS+=("$2"); shift 2 ;;
      --repo=*) need_val --repo "${1#--repo=}"; REPOS+=("${1#--repo=}"); shift ;;
      # The bare word too: `help` is an answered form on the sibling orch CLIs,
      # and here it would otherwise be read as a lane window name.
      --help | -h | help) usage; exit 0 ;;
      -*) ow_message option-unknown "option=$1" >&2; usage >&2; exit 2 ;;
      *) LANES+=("$1"); shift ;;
    esac
  done
}

# `.env.local` is sourced as shell, so help is answered before the loader runs:
# the dry run is the real parser in a subshell, so nothing it assigns survives
# to be clobbered, and 9 is the only status meaning it reached the end.
parse_rc=0
( parse_argv "$@"; exit 9 ) || parse_rc=$?
[[ "$parse_rc" -eq 9 ]] || exit "$parse_rc"
unset parse_rc

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export PROJECT_ROOT
SKILLS_DIR="$PROJECT_ROOT/.agents/skills"
export SKILLS_DIR
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$PROJECT_ROOT"
# shellcheck source=lib/gh-auth.sh
source "$SCRIPT_DIR/lib/gh-auth.sh"
# shellcheck source=lib/gh-repo.sh
source "$SCRIPT_DIR/lib/gh-repo.sh"
# shellcheck source=lib/date-ladder.sh
source "$SCRIPT_DIR/lib/date-ladder.sh"
# shellcheck source=lib/usage-reset.sh
source "$SCRIPT_DIR/lib/usage-reset.sh"
# shellcheck source=lib/lane-claims.sh
source "$SCRIPT_DIR/lib/lane-claims.sh"
# shellcheck source=lib/account-wall.sh
source "$SCRIPT_DIR/lib/account-wall.sh"
# shellcheck source=lib/pr-watch-pass.sh
source "$SCRIPT_DIR/lib/pr-watch-pass.sh"
# shellcheck source=lib/outside-contribution.sh
source "$SCRIPT_DIR/lib/outside-contribution.sh"
# shellcheck source=lib/security-alerts.sh
source "$SCRIPT_DIR/lib/security-alerts.sh"
# shellcheck source=lib/lane-state.sh
source "$SCRIPT_DIR/lib/lane-state.sh"
# shellcheck source=lib/tmux-server.sh
source "$SCRIPT_DIR/lib/tmux-server.sh"
# shellcheck source=lib/watch-session.sh
source "$SCRIPT_DIR/lib/watch-session.sh"
# shellcheck source=lib/lane-context.sh
source "$SCRIPT_DIR/lib/lane-context.sh"
# shellcheck source=lib/lane-gitfile.sh
source "$SCRIPT_DIR/lib/lane-gitfile.sh"
# shellcheck source=lib/lane-capabilities.sh
source "$SCRIPT_DIR/lib/lane-capabilities.sh"
# shellcheck source=lib/watch-host-kinds.sh
source "$SCRIPT_DIR/lib/watch-host-kinds.sh"
# shellcheck source=lib/watch-pid.sh
source "$SCRIPT_DIR/lib/watch-pid.sh"
# shellcheck source=lib/lane-launch.sh
source "$SCRIPT_DIR/lib/lane-launch.sh"
# shellcheck source=lib/lane-relaunch.sh
source "$SCRIPT_DIR/lib/lane-relaunch.sh"
# shellcheck source=lib/mailbox-append.sh
source "$SCRIPT_DIR/lib/mailbox-append.sh"
PR_WATCH="${OVERSEE_WATCH_PR_WATCH:-$SKILLS_DIR/review-gate/scripts/pr-watch.sh}"
TRACKER="${OVERSEE_WATCH_TRACKER:-$SKILLS_DIR/linear/scripts/linear.sh}"
WORKFLOW_STATE="${OVERSEE_WATCH_WORKFLOW_STATE:-$SCRIPT_DIR/workflow-state}"
LANE_MAIL="${OVERSEE_WATCH_LANE_MAIL:-$SCRIPT_DIR/lane-mail}"
LANE_CLOSE="${OVERSEE_WATCH_LANE_CLOSE:-$SCRIPT_DIR/lane-close}"
SUCCEED="${OVERSEE_WATCH_SUCCEED:-$SCRIPT_DIR/oversee-succeed}"
LANES_CLI="${OVERSEE_WATCH_LANES:-$SCRIPT_DIR/lanes}"
REPORT_CLI="${OVERSEE_WATCH_REPORT:-$SCRIPT_DIR/oversee-report}"
OPEN_TERMINAL="${OVERSEE_WATCH_OPEN_TERMINAL:-$SCRIPT_DIR/open-terminal}"
# Consecutive `exited` readings of the overseer pane before the death is news.
# One is a poll that caught a live session between its harness and its shell,
# the same reason the lane-exited check debounces.
DEAD_PASSES="${ORCH_OVERSEER_DEAD_PASSES:-2}"
# Passes a standing overseer-mark waits before it is reported again. A mark the
# overseer has not acted on stands for every pass until it hands over, and a
# line on each of them would bury every other event in the block; one that never
# came back would let the mark ride out the fleet after a single reading.
MARK_REPEAT="${ORCH_OVERSEER_MARK_REPEAT:-5}"
# Seconds each account read of a pass is given: the overseer's own mark
# judgement and the account roster. Each reads every account the fleet can
# launch on, which waits on a credentials lock and a usage endpoint per
# account, and on a cache miss on the host-wide usage refresh lock (up to 10
# seconds) and, after a 429 with nothing cached, one sleep of up to 5 seconds
# and one more usage request, and a pass that spent its whole interval there
# would delay every other event it carries. The ceiling is per read, so a pass
# can spend it once for each reader. A read the ceiling abandons leaves its
# answer unjudged, which is the answer a failed read already gives.
READ_CEILING=60
STATE_DIR_SETTING="${ORCH_STATE_DIR:-tmp}"
WORKFLOW_STATE_DIR="$STATE_DIR_SETTING"
case "$WORKFLOW_STATE_DIR" in
  /*) ;;
  *) WORKFLOW_STATE_DIR="$PROJECT_ROOT/$WORKFLOW_STATE_DIR" ;;
esac
PW_STATE_DIR="${OVERSEE_WATCH_STATE_DIR:-$PROJECT_ROOT/tmp/oversee-watch}"
# Two state files per fleet: the first repository's baseline, which the long
# pass writes, and the mail pass's file beside it, which only the mail pass and
# the scheduler around it write. The long pass runs while mail passes go on,
# so one file each is what keeps either from committing a copy of the other's
# rows it took before the other advanced them. The overseer mailbox has no
# position here at all: its own to-lane.cursor is the one every reader
# advances, a session start included.
# Per-lane rows in the first repository's baseline, never a file of their own,
# beside the reducer's `<pr>\t<kind>` and triage's `triage\t<id>`:
#   lane-asking<TAB><lane><TAB><pane key>|<turn identity>|<copilot note>|<slice cksum>
#   usage-limit<TAB><lane><TAB><first-seen-epoch>|<pane key>|<reported event>|<reset key>
#   model-capacity<TAB><lane><TAB><pane key>|<turn identity>|model-capacity
#   lane-exited<TAB><lane><TAB><pane key>[|reported]
#   terminal-close<TAB><item><TAB><terminal state>|<lane record JSON>
#   lane-idle<TAB><lane><TAB><pane key>|<copilot note>|<screen cksum>[|reported]
#   handoff<TAB><item><TAB><record checksum>
#   lane-prepare<TAB><item><TAB><preparation start epoch>|<ready|failed|stuck>
#   start-stalled<TAB><item><TAB><running_at epoch>|<passes since reported, or seen>|<branch heads>|<last observed progress epoch>
#   lane-long<TAB><item><TAB><launched_at epoch>|<reported age interval>
#   lane-failed<TAB><item><TAB><the last lane-local failure the long pass reported>
#   merged<TAB><item><TAB><repo>#<number>[ <repo>#<number>...]
#   outside-contribution<TAB><repo>#<number><TAB><pr HEAD_SHA|issue>
#   refresh-failing<TAB><repo><TAB><newest run's REFRESH_RUN as JSON>|[<passes since reported>|<cause>|unjudged]
#   main-push-failing<TAB><repo><TAB>[<sorted failed jobs>,<sorted failure identities or null for unread logs>] as JSON
#   security-alert, bot-fix and security-alerts-unread rows, which
#   lib/security-alerts.sh sets out above check_security_alerts
#   account<TAB><harness>|<through>|<config dir><TAB><status>|<verdict>|<binding_resets_at or ->|<status of the last unmeasured reading, or ->
# And in the mail pass's file:
#   lane-mail<TAB><item>[@clone]<TAB><to-overseer.jsonl lines already drained> <first id>
#   directive<TAB><item>[@clone]<TAB><to-lane.cursor reported read> <last line reported unread>[:<passes since unread reported>] <first id>
#   clone-root<TAB><item><TAB><the hosted lane's clone, on its own host>
#   lane-failed<TAB><item><TAB><the last lane-local failure the mail pass reported>
#   long-pass<TAB>fleet<TAB><the epoch the last long pass started at>
#   mail-pass<TAB>fleet<TAB><the epoch the last full mail pass started at>
# Four rows are keyed by the overseer's own pane rather than by a lane, and
# are pruned on every pass so a pane that stops being the overseer's leaves
# nothing behind:
#   overseer-mark<TAB><server> <pane><TAB><kind>|<passes since it was reported>
#   overseer-dead<TAB><server> <pane><TAB><count>|pending:<N>|reported
#   overseer-walled<TAB><server> <pane><TAB><count>|pending:<N>|reported
#   overseer-context-gap<TAB><server> <pane><TAB><gap>|told|alerted
# overseer-dead (harness gone) and overseer-walled (account spent, harness
# running) are one machinery in two rows, so a pane flipping between the two
# starts its count over rather than counting a wall towards a death.
# The usage-limit reset key, laid out by usage_reset_key, comes LAST because
# it carries `|` of its own.
# The reported columns keep a re-run, which follows every event, from
# delivering a line again for a walled, idle or exited lane or a merged --item.
# Each helper takes the whole baseline blob and returns the answer or the
# rewritten blob, so a pass mutates a local and commits once. `lane-exited` and
# `lane-idle` hold a needed first pass in a row, not a global: a pass that
# found any event exits the process.
lane_row_get() {
  awk -F'\t' -v kind="$1" -v lane="$3" '$1 == kind && NF == 3 && $2 == lane { print $3 }' <<<"$2"
}

lane_row_clear() {
  awk -F'\t' -v kind="$1" -v lane="$3" 'NF && !($1 == kind && NF == 3 && $2 == lane)' <<<"$2"
}

# In place, so a pass that sets a row to the value it already holds leaves
# the blob as it was and commits nothing. The value crosses in the
# environment, as lane_row_prune's list does: awk would read escapes in a -v.
lane_row_set() {
  ow_value="$4" awk -F'\t' -v kind="$1" -v lane="$3" '
    NF && $1 == kind && NF == 3 && $2 == lane { if (!set) print kind "\t" lane "\t" ENVIRON["ow_value"]; set = 1; next }
    NF { print }
    END { if (!set) print kind "\t" lane "\t" ENVIRON["ow_value"] }' <<<"$2"
}

# The same two-phase flush triage uses, on the same file: nothing is written
# when the pass changed nothing, and the event has already printed.
lane_row_commit() {
  [[ "$1" != "${PW_SEEN[0]}" ]] || return 0
  pw_stage_state "$(pw_state_file "${REPOS[0]}")" "$1"
  pw_commit_state "$(pw_state_file "${REPOS[0]}")"
  PW_SEEN[0]="$1"
}
# The same flush, on the mail pass's file.
MAIL_SEEN=""
mail_row_commit() {
  [[ "$1" != "$MAIL_SEEN" ]] || return 0
  pw_stage_state "$MAIL_STATE_FILE" "$1"
  pw_commit_state "$MAIL_STATE_FILE"
  MAIL_SEEN="$1"
}

# The -t target a lane is read through: a bare name inside the resolved
# session, matched exactly, and a `session:window` name as it was given.
lane_target() { # LANE
  case "$1" in
    *:*) printf '%s\n' "$1" ;;
    *) printf '=%s:%s\n' "$WATCH_SESSION" "$1" ;;
  esac
}

# The windows of the session a lane names: `session:window` lists that
# session, a bare name the resolved one. The session is matched exactly (`=`):
# tmux otherwise falls back to a prefix match, and a lane whose session died
# would silently watch a sibling's. A session tmux destroyed with its last
# window has no windows, so it lists as none and the lane reads gone; any
# other failure is fatal.
lane_session_windows() {
  local out session="$WATCH_SESSION"
  [[ "$1" != *:* ]] || session="${1%%:*}"
  out="$(tmux list-windows -t "=$session" -F '#W' 2>&1)" && { printf '%s\n' "$out"; return 0; }
  [[ "$out" == "can't find session: "* ]] && return 0
  printf '%s\n' "$out"
  return 1
}

# The one presence answer, for a pass and for repeat mode's lane records.
lane_window_listed() { # LANE
  local existing
  existing="$(lane_session_windows "$1")" || die window-list-failed "$existing" "lane=$1"
  grep -qxF -- "${1#*:}" <<<"$existing"
}

parse_argv "$@"

FLEET_STATE_DIR="${OVERSEE_WATCH_FLEET_STATE_DIR:-$WORKFLOW_STATE_DIR}"
if [[ -n "$STATE_FILE" ]]; then
  FLEET_STATE_DIR="${STATE_FILE%/*}"
  [[ "$FLEET_STATE_DIR" != "$STATE_FILE" ]] || FLEET_STATE_DIR=.
  case "$FLEET_STATE_DIR" in
    /*) ;;
    *) FLEET_STATE_DIR="$PWD/$FLEET_STATE_DIR" ;;
  esac
fi
WORKFLOW_STATE_ARGS=(--state-dir "$FLEET_STATE_DIR")

[[ "$INTERVAL" =~ ^[0-9]+$ ]] || die interval-invalid "" "value=$INTERVAL"
[[ "$MAX_LOOPS" =~ ^[0-9]+$ && "$MAX_LOOPS" -ge 1 ]] || die max-loops-invalid "" "value=$MAX_LOOPS"
# The age a usage figure may be served at, named to every lane reader a pass
# runs: two of this watch's intervals. A long pass reads once an --interval,
# counted start to start, or longer where one overruns, and the mail pass
# judges a standing wall at most once an interval too, so a window of one
# interval has always expired by the next read and every one would post for
# every account; two cover that. A larger ORCH_LANES_USAGE_MAX_AGE
# the settings already set is kept, since this variable outranks the settings
# ladder, and a value that is not a whole number is passed on for `lanes` to
# refuse rather than overwritten. `lanes` only ever widens its TTL with it and
# never widens a TTL of 0.
LANES_MAX_AGE="${ORCH_LANES_USAGE_MAX_AGE:-0}"
if [[ "$LANES_MAX_AGE" =~ ^[0-9]+$ ]] && (( 10#$LANES_MAX_AGE < 10#$INTERVAL * 2 )); then
  LANES_MAX_AGE=$((10#$INTERVAL * 2))
fi
# The same alphabet oversee-succeed refuses outside of, judged here so a repeat
# run is refused at its start rather than at the first pass that records a line.
[[ "$HANDOFF" =~ ^[A-Za-z0-9._/-]+$ ]] || die handoff-invalid "" "path=$HANDOFF"
[[ "$DEAD_PASSES" =~ ^[0-9]+$ && "$DEAD_PASSES" -ge 1 ]] \
  || die dead-passes-invalid "" "ORCH_OVERSEER_DEAD_PASSES=$DEAD_PASSES"
[[ "$MARK_REPEAT" =~ ^[1-9][0-9]*$ ]] \
  || die mark-repeat-invalid "" "ORCH_OVERSEER_MARK_REPEAT=$MARK_REPEAT"
# The ceiling on every pane payload this watch prints. The overseer handles
# each event from the lines under it, so the cap is what keeps a fleet's worth
# of events inside one overseer's context. The default holds the measured
# Claude Code dialogs and the Codex trust dialog whole; the Codex model
# picker's slice is longer and keeps its bottom 12 lines
# (https://github.com/vanillagreencom/kendex/tree/main/skills/orch/tests/fixtures/oversee-watch).
# What the cap trims is gone from the event,
# and only a larger cap brings it back.
WATCH_TAIL_LINES="${ORCH_WATCH_TAIL_LINES:-12}"
[[ "$WATCH_TAIL_LINES" =~ ^[1-9][0-9]*$ ]] || die tail-lines-invalid "" "value=$WATCH_TAIL_LINES"
PREPARE_SECS="${ORCH_WATCH_PREPARE_SECS:-1800}"
[[ "$PREPARE_SECS" =~ ^[1-9][0-9]*$ ]] || die prepare-secs-invalid "" "value=$PREPARE_SECS"
# The mail pass's own cadence, apart from --interval: its reads are files and
# provider reads, so with every repository named by --repo it costs no GitHub
# call.
MAIL_INTERVAL="${ORCH_WATCH_MAIL_INTERVAL:-20}"
[[ "$MAIL_INTERVAL" =~ ^(0|[1-9][0-9]*)$ ]] || die mail-interval-invalid "" "value=$MAIL_INTERVAL"
# The overseer mailbox, which every owner, Slack and peer note lands in. A wait
# for the next mail pass checks its size once a second and reads it alone the
# moment it moves, so a note waits a second rather than up to the mail
# interval, and the lane mailboxes keep that interval. With no interval the
# mail is read once a turn and nothing waits on this.
OVERSEER_BOX="$(lane_context_overseer_box "$PROJECT_ROOT")/to-lane.jsonl"
# `none` for a mailbox not there yet or unreadable: the read it starts judges
# it. wc -c, since stat's size flag differs between GNU and BSD.
overseer_box_size() {
  wc -c 2>/dev/null < "$OVERSEER_BOX" || echo none
}
UNREAD_SECS="${ORCH_DIRECTIVE_UNREAD_SECS:-300}"
[[ "$UNREAD_SECS" =~ ^(0|[1-9][0-9]*)$ ]] || die unread-secs-invalid "" "value=$UNREAD_SECS"
# How long a running lane record may stand with no status file before
# start-stalled goes out: a lane that never started its workflow writes none,
# on every harness, and its pane says nothing a watch may read about why.
START_STALL_SECS="${ORCH_WATCH_START_STALL_SECS:-600}"
[[ "$START_STALL_SECS" =~ ^[1-9][0-9]*$ ]] || die start-stall-secs-invalid "" "value=$START_STALL_SECS"
# How long a status=none lane, a cloud session no process read reaches, may
# hold its pull request's head and lane status body unchanged before
# lane-stalled goes out. Provisional: the first cloud acceptance run sets it.
LANE_STALL_SECS="${ORCH_WATCH_LANE_STALL_SECS:-3600}"
[[ "$LANE_STALL_SECS" =~ ^[1-9][0-9]*$ ]] || die lane-stall-secs-invalid "" "value=$LANE_STALL_SECS"
# How long a stalled cloud lane may leave its one directive unanswered before
# the watch closes it for a hosted relaunch: lib/watch-host-kinds.sh
# cloud_stall_close.
CLOUD_STALL_MINUTES="${ORCH_CLOUD_STALL_MINUTES:-30}"
[[ "$CLOUD_STALL_MINUTES" =~ ^[1-9][0-9]*$ ]] || die cloud-stall-minutes-invalid "" "value=$CLOUD_STALL_MINUTES"
CLOUD_STALL_SECS=$((CLOUD_STALL_MINUTES * 60))
# Age threshold in seconds for lane-long on a running or parked lane.
# Repeat schedule: oversee-watch --help, event lane-long.
LANE_AGE_SECS="${ORCH_WATCH_LANE_AGE_SECS:-12600}"
[[ "$LANE_AGE_SECS" =~ ^[1-9][0-9]*$ ]] || die lane-age-secs-invalid "" "value=$LANE_AGE_SECS"
# Who runs the usage-limit route: `auto` relaunches a walled lane here
# (wall_route), `ask` reports it with the pick's answer for the overseer.
WALL_RELAUNCH="${ORCH_WALL_RELAUNCH:-auto}"
[[ "$WALL_RELAUNCH" == auto || "$WALL_RELAUNCH" == ask ]] || die wall-relaunch-invalid "" "value=$WALL_RELAUNCH"
# The state's records the pane never judges and the start-stall check reads,
# rebuilt by every fleet read: `<window>=<item>` for each Pi lane, judged from
# the rows its own hook writes (lib/session-rows.sh), and `<item>=<epoch it went
# running>` for each record naming a mail_root to look for its status file
# under.
PI_LANES=()
LAUNCHES=()
# `<item>=<launched_at epoch>` for each running or parked record, which
# lane-long ages, and every item any record names, which keeps its row.
LANE_AGES=()
RECORDED_ITEMS=()
# What argv itself gave, kept before the first state read rebuilds the four
# arrays: every merge adds the command line's own entries to the records the
# state names, so the baseline has to outlive the set a loop carries.
GIVEN_ITEMS=(${ITEMS[@]+"${ITEMS[@]}"})
GIVEN_LANES=(${LANES[@]+"${LANES[@]}"})
GIVEN_HOSTED=(${HOSTED[@]+"${HOSTED[@]}"})
GIVEN_ROOTS=(${ROOTS[@]+"${ROOTS[@]}"})
[[ ${#SKIP_LANES[@]} -eq 0 || -n "$STATE_FILE" ]] || die state-required "" "option=--skip-lane"
# A pass the repeat wrapper launched, which inherits that wrapper's session,
# overseer record and watch record rather than making its own.
REPEAT_CHILD=0
if [[ -n "${OVERSEE_WATCH_REPEAT_OWNER:-}" && "$OVERSEE_WATCH_REPEAT_OWNER" == "$PPID" ]]; then
  REPEAT_CHILD=1
fi
watch_session_resolve
check_lane_set

# No floor by default: the floor must not move between runs, and a run has no
# way to know when the previous one stopped looking.
SINCE_EPOCH=0
if [[ -n "$SINCE" ]]; then
  [[ "$SINCE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] \
    || die since-invalid "" "value=$SINCE"
  SINCE_EPOCH="$(to_epoch "$SINCE")" || die since-invalid "" "value=$SINCE"
fi

# One canonical spelling per repository. GitHub reads a repo path
# case-insensitively, so lowercasing each entry leaves the duplicate check, the
# owner the merged check matches on, the reducer's state-file name, the repo it
# prefixes its lines with and the GH_REPO it exports all naming one string. A
# repeat would reduce that repository twice into one state file and report it
# twice in the context, so it is a usage error, named as the caller spelled it.
# A single run and repeat mode both call it.
# ORCH_CONNECTED_REPOS then adds each repository the overseer may launch lanes
# in, after every --repo so the items repository stays first. An entry a --repo
# already names is skipped rather than refused: a launch line written before
# the setting names them by hand, and repeat mode hands its pass the set this
# check settled. The setting is read even with no --repo, so the repeat
# wrapper, which resolves no default, refuses an unreadable one once rather
# than each pass refusing it after every sleep; the set itself is still
# unresolved there and gains nothing, and the call below the default
# resolution adds the entries.
check_repo_set() {
  local repo_i repo_raw repos_seen="" connected connected_list=()
  for repo_i in ${REPOS[@]+"${!REPOS[@]}"}; do
    repo_raw="${REPOS[$repo_i]}"
    REPOS[$repo_i]="$(printf '%s' "$repo_raw" | tr '[:upper:]' '[:lower:]')"
    if grep -qxF -- "${REPOS[$repo_i]}" <<<"$repos_seen"; then
      die repo-duplicate "" "repo=$repo_raw"
    fi
    repos_seen+="${REPOS[$repo_i]}"$'\n'
  done
  connected="$(orch_connected_repos ${REPOS[@]+"${REPOS[@]}"})" \
    || die connected-repos-unread "" "setting=ORCH_CONNECTED_REPOS"
  [[ ${#REPOS[@]} -gt 0 ]] || return 0
  IFS=$'\n' read -ra connected_list -d '' <<<"$connected" || true
  REPOS+=(${connected_list[@]+"${connected_list[@]}"})
}

# The --item and --hosted checks, run by a single run and by every repeat pass
# on the set that pass will carry. The item's head branch is its id lowercased
# (worktree create's branch name); one branch per line, for the jq membership
# test.
check_item_set() {
  local item entry hosted_item hosted_seen="" stopped=""
  local merge_items=(${ITEMS[@]+"${ITEMS[@]}"} ${PARKED_ITEMS[@]+"${PARKED_ITEMS[@]}"})
  if [[ -n "$FLEET_STATE" ]]; then
    stopped="$(jq -r '(.lanes // [])[] | objects | select(.status == "stopped") | .item | strings' <<<"$FLEET_STATE")" \
      || die state-invalid "" "path=$STATE_FILE"
    while IFS= read -r item; do [[ -z "$item" ]] || merge_items+=("$item"); done <<<"$stopped"
  fi
  ITEM_BRANCHES=""
  MERGED_ITEMS=()
  for item in ${merge_items[@]+"${merge_items[@]}"}; do
    item_in "$item" ${MERGED_ITEMS[@]+"${MERGED_ITEMS[@]}"} && continue
    [[ "$item" =~ ^[A-Za-z0-9._-]+$ ]] || die item-invalid "" "item=$item"
    ITEM_BRANCHES+="$(printf '%s' "$item" | tr '[:upper:]' '[:lower:]')"$'\n'
    MERGED_ITEMS+=("$item")
  done
  # `--hosted ITEM=REMOTE_ROOT` and `--root ITEM=PATH`, validated here so the
  # mail pass never composes a path out of a value nobody judged.
  check_root_entries hosted ${HOSTED[@]+"${HOSTED[@]}"}
  check_root_entries root ${ROOTS[@]+"${ROOTS[@]}"}
  check_lane_host
}
# One entry per item: two roots for one lane would read one of its mailboxes
# and drain the other. An entry for an item this run does not watch reads no
# mailbox at all, and the item it was meant for quietly reads its local root
# instead. KIND is the option's reason prefix, hosted or root.
check_root_entries() { # KIND ENTRY...
  local kind="$1" entry item known seen=""
  shift
  for entry in "$@"; do
    [[ "$entry" == *=* ]] || die "$kind-invalid" "" "value=$entry"
    [[ "${entry%%=*}" =~ ^[A-Za-z0-9._-]+$ && -n "${entry#*=}" ]] \
      || die "$kind-invalid" "" "value=$entry"
    grep -qxF -- "${entry%%=*}" <<<"$seen" \
      && die "$kind-duplicate" "" "item=${entry%%=*}"
    known=0
    for item in ${ITEMS[@]+"${ITEMS[@]}"}; do
      [[ "$item" != "${entry%%=*}" ]] || known=1
    done
    [[ "$known" -eq 1 ]] || die "$kind-unknown-item" "" "item=${entry%%=*}"
    seen+="${entry%%=*}"$'\n'
  done
}

# Whether the item is a parked record's, for the merged check's hand, with
# PARKED_KEY the `<repo>#<number>` of the pull request its park judged.
PARKED_KEY=""
item_parked() { # ITEM
  local i
  for i in ${PARKED_ITEMS[@]+"${!PARKED_ITEMS[@]}"}; do
    [[ "${PARKED_ITEMS[$i]}" != "$1" ]] || { PARKED_KEY="${PARKED_KEYS[$i]}"; return 0; }
  done
  return 1
}
# Whether an item or a window is already carried, for the state merge.
item_listed() { # ITEM
  local entry
  for entry in ${ITEMS[@]+"${ITEMS[@]}"}; do [[ "$entry" != "$1" ]] || return 0; done
  return 1
}
window_listed() { # WINDOW
  local entry
  for entry in ${LANES[@]+"${LANES[@]}"}; do [[ "$entry" != "$1" ]] || return 0; done
  return 1
}
# Whether --skip-lane names the window. A pass hears it from its caller and
# from the wrapper, which adds each window a pass already reported gone, a
# fact no record of its own can say.
lane_skipped() { # WINDOW
  local entry
  for entry in ${SKIP_LANES[@]+"${SKIP_LANES[@]}"}; do [[ "$entry" != "$1" ]] || return 0; done
  return 1
}

# The live fleet, read from the oversee workflow state open-terminal writes
# (../schemas/workflow-state.md § Oversee state): a first line counting the
# records no pass carries, then one line per running lane record, item,
# window, its host (`local` for a record naming none), mail_root, harness and the time the record went
# running in epoch seconds, its running_at or, on a record written before that
# stamp, its launched_at, joined by the unit separator. `running`,
# lib/lane-claims.sh's LANE_RUNNING_JQ, is the one answer to which records a
# pass carries, so the count and the rows cannot describe two different fleets. A file that is not that state,
# or a running record with no item, ends the watch: a lane read as absent is
# a lane nobody watches.
LANE_ROWS_FILTER="$LANE_RUNNING_JQ"'
  if type != "object" then error("state-type expected=object actual=\(type)") else . end
  | (.lanes // []) | if type != "array" then error("lanes-type expected=array actual=\(type)") else . end
  | ([.[] | select(running | not)] | length),
    (.[] | select(running)
  | if ((.item? | type) == "string" and (.item | length) > 0) then . else error("lane-field field=item value=\(.item | tojson)") end
  | [.item, (.window // ""), (.host // "local"), (.mail_root // ""),
     (.harness // ""), ((.running_at // .launched_at) | if . == null then "" else (fromdateiso8601 | tostring) end),
     (.launched_at | if . == null then "" else (fromdateiso8601 | tostring) end)]
  | join("\u001f"))'

# The unit separator keeps paths with spaces in one field.
PREPARE_ROWS_FILTER='
  (.lanes // [])[] | select(type == "object" and (.prepare | type) == "object")
  | ({preparing: "pending", running: "ready"}[.status // ""] // (if .status == "stopped" and .prepare.reason != null then "failed" else empty end)) as $outcome
  | [.item, $outcome, (.prepare.since | fromdateiso8601 | tostring), .prepare.log, (.prepare.reason // "")] | join("\u001f")'
PREPARE_ROWS=""

# The parked records, as item, `<repo>#<number>` and launched_at: a lane
# lane-close --park stopped with its disk kept, and the pull request its park
# judged, whose merge alone the merged check hands on as parked-merged. Only
# it and lane-long read one: its pane is gone and its mailbox on a stopped
# disk. The repository is lowercased here, the one spelling check_repo_set
# gives every --repo, so the key meets the merged side's whatever case the
# record's writer used: GitHub reads owner and repository names
# case-insensitively, and a record carries the spelling gh repo view or the
# launch's --repo gave it.
PARKED_ROWS_FILTER='
  (.lanes // [])[] | select(type == "object" and .status == "parked")
  | if ((.item? | type) != "string" or (.item | length) == 0) then error("lane-field field=item value=\(.item | tojson)")
    elif ((.parked.pr? | type) != "number" or (.parked.repo? | type) != "string") then error("lane-field field=parked value=\(.parked | tojson)")
    else "\(.item)\u001f\(.parked.repo | ascii_downcase)#\(.parked.pr)\u001f\(.launched_at | if . == null then "" else (fromdateiso8601 | tostring) end)" end'
PARKED_ITEMS=()
PARKED_KEYS=()

# The one reader of the state, asked by the repeat wrapper before every pass
# and by the pass itself before every loop: the live set changes on every
# launch, relaunch and close, and a hosted lane's root rides in its record, so
# no change to the fleet waits for a restart. The state's records come first,
# then the command line's own entries for items and windows no record names,
# so a record, parked ones included, wins where both name one item, and no
# run is refused over a lane that was passed by hand and then gained a record,
# of either route type. A local record's mail_root is carried as a --root
# entry, so a lane whose
# worktree sits outside this checkout is read where its mailbox is. A state
# that cannot be read, or a set this run would refuse, ends the read rather
# than carry a fleet nobody watches. The rows are split on the unit separator,
# never a tab: a tab is IFS whitespace, so `read` folds two of them into one
# and a lane with no window would take `local` as its window name.
FLEET_CARRIED=""
# The state text the last read parsed, which the heartbeat's owed items judge.
FLEET_STATE=""
fleet_merge() { # [quiet]
  local state rows dropped line item window host root harness running launched kept carried parked recorded
  state="$(cat -- "$STATE_FILE" 2>&1)" || die state-unreadable "$state" "option=--state" "path=$STATE_FILE"
  FLEET_STATE="$state"
  rows="$(jq -r "$LANE_ROWS_FILTER" <<<"$state" 2>&1)" || die state-invalid "$rows" "option=--state" "path=$STATE_FILE"
  PREPARE_ROWS="$(jq -r "$PREPARE_ROWS_FILTER" <<<"$state" 2>&1)" || die state-invalid "$PREPARE_ROWS" "option=--state" "path=$STATE_FILE"
  parked="$(jq -r "$PARKED_ROWS_FILTER" <<<"$state" 2>&1)" || die state-invalid "$parked" "option=--state" "path=$STATE_FILE"
  recorded="$(jq -r '(.lanes // [])[] | objects | .item | strings' <<<"$state" 2>&1)" \
    || die state-invalid "$recorded" "option=--state" "path=$STATE_FILE"
  RECORDED_ITEMS=()
  while IFS= read -r item; do [[ -z "$item" ]] || RECORDED_ITEMS+=("$item"); done <<<"$recorded"
  PARKED_ITEMS=()
  PARKED_KEYS=()
  LANE_AGES=()
  while IFS=$'\x1f' read -r item kept launched; do
    [[ -n "$item" ]] || continue
    PARKED_ITEMS+=("$item")
    PARKED_KEYS+=("$kept")
    [[ -z "$launched" ]] || LANE_AGES+=("$item=$launched")
  done <<<"$parked"
  # The count is the first line; a fleet of no running lane has no second.
  dropped="${rows%%$'\n'*}"
  if [[ "$rows" == *$'\n'* ]]; then rows="${rows#*$'\n'}"; else rows=""; fi
  ITEMS=()
  LANES=()
  HOSTED=()
  ROOTS=()
  PI_LANES=()
  LAUNCHES=()
  host_routes_reset
  while IFS=$'\x1f' read -r item window host root harness running launched; do
    [[ -n "$item" ]] || continue
    host_route "$item" "$host" "$root"
    ITEMS+=("$item")
    # A status=none kind's window holds no harness the pane passes judge.
    [[ -z "$window" ]] || item_in "$item" ${STATUSLESS[@]+"${STATUSLESS[@]}"} || LANES+=("$window")
    [[ -z "$window" || "$harness" != pi ]] || PI_LANES+=("$window=$item")
    [[ -z "$running" || -z "$root" ]] || LAUNCHES+=("$item=$running")
    [[ -z "$launched" ]] || LANE_AGES+=("$item=$launched")
  done <<<"$rows"
  for line in ${GIVEN_ITEMS[@]+"${GIVEN_ITEMS[@]}"}; do item_listed "$line" || item_parked "$line" || ITEMS+=("$line"); done
  for line in ${GIVEN_LANES[@]+"${GIVEN_LANES[@]}"}; do window_listed "$line" || LANES+=("$line"); done
  for line in ${GIVEN_HOSTED[@]+"${GIVEN_HOSTED[@]}"}; do route_listed "${line%%=*}" || HOSTED+=("$line"); done
  for line in ${GIVEN_ROOTS[@]+"${GIVEN_ROOTS[@]}"}; do route_listed "${line%%=*}" || ROOTS+=("$line"); done
  # Last, so a window already reported gone leaves the set however it arrived.
  if [[ ${#SKIP_LANES[@]} -gt 0 ]]; then
    kept=()
    for line in ${LANES[@]+"${LANES[@]}"}; do lane_skipped "$line" || kept+=("$line"); done
    LANES=(${kept[@]+"${kept[@]}"})
  fi
  check_item_set
  check_lane_set
  # The set this read carries, named once the refusals above have passed it
  # and only when it differs from the last read's: a state that parses to no
  # running record is a silent fleet otherwise, every pass a healthy-looking
  # heartbeat over nothing. The fields are built once: the note and the key
  # deciding whether to print it are the same words. `quiet` takes the
  # baseline without naming it, for the one read a pass makes of a set its
  # caller has already named.
  carried=("items=${#ITEMS[@]}" "windows=${#LANES[@]}" "hosted=${#HOSTED[@]}" "parked=${#PARKED_ITEMS[@]}" "dropped=$dropped")
  if [[ "${carried[*]}" != "$FLEET_CARRIED" ]]; then
    [[ "${1:-}" == quiet ]] || ow_message fleet-read "${carried[@]}" "path=$STATE_FILE" >&2
    FLEET_CARRIED="${carried[*]}"
  fi
}

# A session record the start could not write, said on stderr and in the fleet
# log and then left behind: the watch goes on to judge the session, from the
# exit status and rows file the record already holds for this pane where it
# names them, and from the pane, the named fallback, where it names none
# (overseer_pane_read). The reason and its fields are the
# keyed line's, and the fleet log row repeats the reason and the pane so the
# successor that reads the log at takeover sees what this watch could not
# record; the other fields stay on stderr, since a path= is as long as the
# install's path and the row is not. HELD is the line a death would replay
# as the record stands, `none` or `unread`: the keyed line carries it whole
# as `held=`, and the fleet-log row, bounded by ORCH_FLEET_LOG_ROW_BYTES,
# says whether one is held and where it is read, since the row and the line
# sit in the same state file. Runs before WORK_DIR exists, so its files are
# its own and removed here.
overseer_record_notice() { # DETAIL HELD REASON PANE_FIELD FIELD=VALUE...
  local detail="$1" held="$2" notice record errf held_text
  shift 2
  ow_message "$@" "held=$held" >&2
  [[ -z "$detail" ]] || printf '%s\n' "$detail" >&2
  if ! notice="$(mktemp)" || ! record="$(mktemp)" || ! errf="$(mktemp)"; then
    ow_message overseer-notice-failed "channel=file" >&2
    return 0
  fi
  case "$held" in
    none) held_text='No line is held for this pane.' ;;
    unread) held_text='Whether a line is held was not read.' ;;
    *) held_text='A line is held for this pane, at overseer.pending.launch_line if set, else overseer.launch_line.' ;;
  esac
  if printf '%s: the start could not record this session; the pane is still watched. %s %s\n' "$1 $2" "$OW_REPLAY_RULE" "$held_text" > "$notice"
  then
    if ! ol_fleet_log "$notice" "$record" "$errf" "$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"}; then
      ow_message overseer-notice-failed "channel=fleet-log" >&2
      [[ ! -s "$errf" ]] || cat -- "$errf" >&2
    fi
  else
    ow_message overseer-notice-failed "channel=file" >&2
  fi
  rm -f -- "${notice:?}" "${record:?}" "${errf:?}"
}
# Repeat mode runs here, ahead of every note and read a single run makes. Each
# pass is this script in single-run mode, so a pass keeps that contract whole.
# shellcheck source=lib/watch-overseer-record.sh
source "$SCRIPT_DIR/lib/watch-overseer-record.sh"

# Whether PANE, a pane id, is one the tmux server this start reaches no longer
# lists. Only a listing that succeeded answers: a server that could not be
# asked leaves the pane unjudged, and the watch serving it is refused, not
# stopped. A pane on another tmux server reads as gone here; one fleet state is
# watched from one server.
watch_pane_gone() { # PANE
  local panes
  tmux_server_named && [[ "$1" == %* ]] || return 1
  panes="$(tmux list-panes -a -F '#{pid} #{pane_id}' 2>/dev/null)" || return 1
  ! awk -v p="$1" '$2 == p { found = 1 } END { exit !found }' <<<"$panes"
}

# The repeat loop's pass or delay, the one child a stop has to take with it.
# The record goes first, so the start that stopped this loop is not refused,
# then the loop waits for that child, which may be ending a lane-close.
# A unit's stop signals each process its group holds until none is new, so
# TERM also reaches what this stop forks: its record read's subshell, which
# runs the trap inherited across its fork as malformed text, and grep and rm.
# Ignored first, the signal ends none of them and never re-enters this stop;
# the children it signals were forked before.
REPEAT_CHILD_PID=""
repeat_stop() { # STATUS
  trap '' TERM INT
  watch_pid_release "$STATE_FILE"
  [[ -z "$BOX_POLL_PID" ]] || kill -TERM "$BOX_POLL_PID" 2>/dev/null || :
  if [[ -n "$REPEAT_CHILD_PID" ]]; then
    kill -TERM "$REPEAT_CHILD_PID" 2>/dev/null || true
    wait "$REPEAT_CHILD_PID" 2>/dev/null || true
  fi
  exit "$1"
}

# The watch's own record beside the fleet state (lib/watch-pid.sh), which a
# second start is refused on and `oversee-succeed` restarts this watch from. A
# live record refuses the start, with two exceptions, whose watch is stopped
# and replaced: the watch a succession restarted for THIS pane, since that
# start is the successor running its own watch (../workflows/oversee.md § 4), and a watch
# whose pane tmux no longer lists, which serves an overseer that is gone. This
# function is the one place a live watch is replaced. The pid recorded is this
# process's own, so a stop reaches the loop and never a shell that started it.
#
# oversee-watch.log and .err have one writer: a watch a succession started,
# through its own stdout and stderr. A start of that origin is reading files it
# writes, so it never prints or removes them. Any other start gets here only
# once their writer is stopped above or gone, a live one being refused, and
# prints and removes them, with the runner record the restart wrote beside
# them, so no event or refusal a restarted watch left unread is lost.
watch_claim() { # ARGV...
  local why="" taken=""
  if watch_pid_live "$STATE_FILE"; then
    if [[ "$WATCH_ORIGIN" == succession && -n "${TMUX_PANE:-}" && "$WATCH_PANE" == "$TMUX_PANE" ]]; then
      why=succession
    elif watch_pane_gone "$WATCH_PANE"; then
      why=pane-gone
    fi
    [[ -n "$why" ]] && watch_stop "$WATCH_PID" "$STATE_FILE" \
      || die watch-running "" "pid=$WATCH_PID" "pane=$WATCH_PANE" "path=$STATE_FILE"
    ow_message watch-taken-over "pid=$WATCH_PID" "pane=$WATCH_PANE" "reason=$why" >&2
    taken="$WATCH_PID"
  fi
  watch_pid_write "$STATE_FILE" "${TMUX_PANE:-none}" "${OVERSEE_WATCH_ORIGIN:-hand}" \
    "$SCRIPT_DIR/${BASH_SOURCE[0]##*/}" "${@:1:$ARGV_BASE_COUNT}" \
    || die watch-record-failed "" "path=${WATCH_PID_FILE:-$STATE_FILE}"
  trap 'watch_pid_release "$STATE_FILE"' EXIT
  trap 'repeat_stop 143' TERM
  # Reaches a loop started in the foreground or as a job unit: a job a
  # non-interactive shell starts with & ignores INT from its start, and bash
  # cannot trap a signal ignored on entry.
  trap 'repeat_stop 130' INT
  # The watch taken over may still be finishing a lane-close: waiting commits
  # its lane row before the first pass here and makes the replay below whole.
  if [[ -n "$taken" ]] && watch_pid_runs "$taken"; then
    ow_message watch-finishing "pid=$taken" >&2
    while watch_pid_runs "$taken"; do sleep 0.1; done
  fi
  if [[ "${OVERSEE_WATCH_ORIGIN:-hand}" != succession ]] \
     && [[ -s "$WATCH_LOG_FILE" || -s "$WATCH_ERR_FILE" ]]; then
    ow_message watch-replayed "log=$WATCH_LOG_FILE" "err=$WATCH_ERR_FILE" >&2
    if [[ -f "$WATCH_LOG_FILE" ]]; then
      cat -- "$WATCH_LOG_FILE" || die watch-replay-failed "" "path=$WATCH_LOG_FILE"
    fi
    if [[ -f "$WATCH_ERR_FILE" ]]; then
      cat -- "$WATCH_ERR_FILE" >&2 || die watch-replay-failed "" "path=$WATCH_ERR_FILE"
    fi
    rm -f -- "${WATCH_LOG_FILE:?}" "${WATCH_ERR_FILE:?}" "${WATCH_RUNNER_FILE:?}" \
      || die watch-replay-failed "" "path=$WATCH_LOG_FILE"
  fi
}

# Waits out the sleep PID, checking the overseer mailbox once a second while it
# runs. Returns 1 once the mailbox has moved off SEEN, the sleep stopped and
# reaped, and 0 when the sleep ends first, its status left for `wait`. The
# check's own sleep is waited on in the background, as tick_sleep's is, and
# repeat_stop takes it with the loop.
BOX_POLL_PID=""
box_wait() { # PID SEEN
  while kill -0 "$1" 2>/dev/null; do
    sleep 1 &
    BOX_POLL_PID=$!
    wait "$BOX_POLL_PID" || die sleep-failed "" "secs=1"
    BOX_POLL_PID=""
    [[ "$(overseer_box_size)" != "$2" ]] || continue
    kill -TERM "$1" 2>/dev/null || :
    wait "$1" 2>/dev/null || :
    return 1
  done
}

# The pass is handed the state itself and only the entries argv gave this
# wrapper, never the merged set: a lane whose record closed while the pass
# loops has to leave that pass's fleet, which a hand-passed --item never does.
# A state the wrapper's own read refuses ends the watch here rather than after
# every sleep, since the pass would refuse it too.
REPEAT_FIRST=1
repeat_watch() { # ARGV...
  local self="$SCRIPT_DIR/${BASH_SOURCE[0]##*/}" args line noted="" gone="" pending pass_rc delay
  local box_seen
  check_repo_set
  while :; do
    fleet_merge
    # Once, after the first read, so a state that cannot be read is refused as
    # that and not as a record that could not be written beside it, and before
    # the overseer record, so a refused second start leaves the one the running
    # watch wrote.
    if [[ -n "$REPEAT_FIRST" ]]; then
      REPEAT_FIRST=""
      watch_claim "$@"
      overseer_command_record
    fi
    args=(--interval "$INTERVAL" --max-loops "$MAX_LOOPS" \
          --handoff "$HANDOFF" --state "$STATE_FILE")
    [[ -z "$OVERSEER_HARNESS" ]] || args+=(--harness "$OVERSEER_HARNESS")
    [[ -z "$SINCE" ]] || args+=(--since "$SINCE")
    for line in ${REPOS[@]+"${REPOS[@]}"}; do args+=(--repo "$line"); done
    for line in ${GIVEN_HOSTED[@]+"${GIVEN_HOSTED[@]}"}; do args+=(--hosted "$line"); done
    for line in ${GIVEN_ROOTS[@]+"${GIVEN_ROOTS[@]}"}; do args+=(--root "$line"); done
    for line in ${GIVEN_ITEMS[@]+"${GIVEN_ITEMS[@]}"}; do args+=(--item "$line"); done
    # The caller's own skips, which this wrapper's merge has already taken out
    # of LANES: the loop below walks LANES, so it reaches none of them, and a
    # pass not told of them re-reads their records and watches the very windows
    # the caller took out of this run. The loop adds the windows it finds gone,
    # which the merge cannot have removed, so the two sources never collide.
    for line in ${SKIP_LANES[@]+"${SKIP_LANES[@]}"}; do args+=(--skip-lane "$line"); done
    pending=""
    for line in ${LANES[@]+"${LANES[@]}"}; do
      if lane_window_listed "$line"; then
        # Listed again, so a later death under this name is news again.
        noted="$(grep -vxF -- "$line" <<<"$noted" || :)"
        gone="$(grep -vxF -- "$line" <<<"$gone" || :)"
      elif grep -qxF -- "$line" <<<"$gone"; then
        # The pass re-reads the state, so the record still names this window:
        # skipping it there is the only way it stays out of the pane checks.
        args+=(--skip-lane "$line")
      else
        # An absent window rides every pass, noted once, until a pass that
        # carried it exits 0; later passes skip it while it stays gone.
        grep -qxF -- "$line" <<<"$noted" \
          || { noted+=$'\n'"$line"; ow_message window-absent "lane=$line" >&2; }
        pending+=$'\n'"$line"
      fi
    done
    for line in ${GIVEN_LANES[@]+"${GIVEN_LANES[@]}"}; do args+=("$line"); done
    # LAST, after every lane window: `--` ends this parser, so anything appended
    # after the overseer's flags would reach the harness instead of the watch.
    [[ ${#OVERSEER_FLAGS[@]} -eq 0 ]] || args+=(-- "${OVERSEER_FLAGS[@]}")
    # The pass and the delay are waited on in the background (tick_sleep), so
    # a TERM on this loop reaches its trap at once and the trap stops the pass.
    pass_rc=0
    # Before the pass, so a note landing while it runs, after its own read,
    # moves the mailbox off this and cuts the delay below short. A note the
    # pass did read cuts it short too, and the next pass reads the mailbox
    # once more; its full mail pass keeps the time the mail-pass row sets.
    box_seen="$(overseer_box_size)"
    OVERSEE_WATCH_FLEET_STATE_DIR="$FLEET_STATE_DIR" \
      OVERSEE_WATCH_REPEAT_OWNER="$$" \
      OVERSEE_WATCH_SESSION="$WATCH_SESSION" \
      "$self" "${args[@]}" &
    REPEAT_CHILD_PID=$!
    wait "$REPEAT_CHILD_PID" || pass_rc=$?
    REPEAT_CHILD_PID=""
    # The overseer this watch served is gone and a successor holds its window,
    # running a watch of its own. Two watches on one fleet read one overseer
    # mailbox through one cursor, each taking notes the other then never
    # reports, so this one ends here.
    if [[ "$pass_rc" -eq 3 ]]; then
      ow_message overseer-succeeded "pane=${TMUX_PANE:-none}" >&2
      exit 0
    fi
    # Notice-only recovery and an exhausted retry leave a manual replacement
    # to start one new watch. The old watch stops before both can read the same
    # overseer mailbox.
    [[ "$pass_rc" -ne 4 ]] || exit 0
    # A pass exits 0 only after its check_lanes ran, which printed window-gone
    # for every absent window it carried; any other exit may have stopped first.
    [[ "$pass_rc" -ne 0 ]] || gone+="$pending"
    # Named for a test's sleep stub, which tells this delay from a pass's own
    # sleeps by the variable and never by reading the process table. A delay
    # that cannot be slept ends the watch with its cause named, never silently.
    # Capped at the mail interval: the runs between two passes read no mail,
    # and the long-pass start row, not this delay, spaces the GitHub reads. A
    # pass that exited 2 waits the whole delay, so a global failure is no hot
    # loop; a lane failure already reported exits 2 no more.
    delay="$REPEAT"
    [[ "$pass_rc" -eq 2 || "$MAIL_INTERVAL" -ge "$delay" ]] || delay="$MAIL_INTERVAL"
    OVERSEE_WATCH_SLEEP=repeat sleep "$delay" &
    REPEAT_CHILD_PID=$!
    if [[ "$MAIL_INTERVAL" -eq 0 ]] || box_wait "$REPEAT_CHILD_PID" "$box_seen"; then
      wait "$REPEAT_CHILD_PID" || die sleep-failed "" "secs=$delay"
    fi
    REPEAT_CHILD_PID=""
  done
}
if [[ -n "$REPEAT" ]]; then
  [[ "$REPEAT" =~ ^[0-9]+$ ]] || die repeat-invalid "" "value=$REPEAT"
  [[ -n "$STATE_FILE" ]] || die state-required "" "option=--repeat"
fi
# This invocation owns the current overseer command. A live manual replacement
# must publish its command before any pass can consume the old session's line.
# Repeat mode publishes it in repeat_watch, once its own claim has stood.
[[ "$REPEAT_CHILD" -eq 1 || -n "$REPEAT" ]] || overseer_command_record
[[ -z "$REPEAT" ]] || repeat_watch "$@"
# The run's first read, before the notes and helper checks below judge the set
# it starts with; every loop reads it again. A repeat-mode pass takes that
# baseline quietly, because the wrapper that launched it has just named the
# same set and a second line for it says nothing. A standalone run has no
# wrapper to have named anything, so its first read names the fleet it starts
# with, the one read that would otherwise go by with the set unstated.
FIRST_READ_QUIET=""
[[ "$REPEAT_CHILD" -ne 1 ]] || FIRST_READ_QUIET=quiet
[[ -z "$STATE_FILE" ]] || fleet_merge "$FIRST_READ_QUIET"

TRIAGE_ENABLED=0
# LINEAR_TEAM decides whether this fleet has a team to triage at all: empty,
# however it was spelled, is a repo that tracks work elsewhere, so triage is
# skipped, named once, and the watch runs on --since for the merged check.
# With a team, triage fails CLOSED: ../references/oversee-events.md § Event kinds
# owes a verdict to every emitted team item, so a broken install that silently
# dropped triage would drop every unseen item with it, and each missing
# dependency names its remedy. The tracker CLI is read by triage under
# --since and by the heartbeat's owed items under --state, so one gate asks
# for it wherever a team and either reader stand.
if [[ -n "${LINEAR_TEAM:-}" && ( -n "$SINCE" || -n "$STATE_FILE" ) ]]; then
  [[ -x "$TRACKER" ]] \
    || die helper-missing "" "path=$TRACKER" "setting=OVERSEE_WATCH_TRACKER"
fi
if [[ -n "$SINCE" ]]; then
  if [[ -n "${LINEAR_TEAM:-}" ]]; then
    [[ -x "$WORKFLOW_STATE" ]] \
      || die helper-missing "" "path=$WORKFLOW_STATE" "setting=OVERSEE_WATCH_WORKFLOW_STATE"
    TRIAGE_ENABLED=1
  else
    ow_message triage-disabled "setting=LINEAR_TEAM" "value=${LINEAR_TEAM:-}" >&2
  fi
fi
outside_contribution_init
security_alerts_init

check_item_set

# The item a lane window watches, as LANE_ITEM, with hosted_root set for it.
# open-terminal names a window for its item, except a GitHub item's: window
# gh-N, item issue-N. The literal name is tried first, so a tracker whose own
# identifiers read gh-N keeps them.
hosted_lane_item() { # LANE
  LANE_ITEM="${1#*:}"
  hosted_root "$LANE_ITEM"
  [[ -z "$HOSTED_ROOT" && "$LANE_ITEM" == gh-* && "${LANE_ITEM#gh-}" =~ ^[0-9]+$ ]] || return 0
  LANE_ITEM="issue-${LANE_ITEM#gh-}"
  hosted_root "$LANE_ITEM"
}

# The hosted items whose worktree this pass's mail read found gone, one per line.
HOSTED_GONE_ITEMS=""

# The directory an item's workflow state is read from, as ITEM_STATE_DIR, and
# the lane root `handoff-standing --worktree` reads beside it, as ITEM_WORKTREE,
# empty where none is known. A local lane's root is its --root entry. A hosted
# lane's state is in its clone (workflow-state joins a relative state directory
# to the common root) and in its root's own tmp, each fetched into a scratch
# directory the same reader then reads; a file the host does not have leaves it
# empty, as a missing local file does, and the clone's fetch fails first. The
# clone is the one the last mail pass learned; ITEM_HOSTED_STATE is its file.
item_state_dir() { # ITEM
  local clone rc=0
  ITEM_STATE_DIR="$WORKFLOW_STATE_DIR"
  hosted_root "$1"
  if [[ -z "$HOSTED_ROOT" ]]; then
    local_root "$1"
    ITEM_WORKTREE="$LOCAL_ROOT"
    return 0
  fi
  if ! clone="$(lane_row_get clone-root "$MAIL_SEEN" "$1")" || [[ -z "$clone" ]]; then
    lane_failure_set handoff-read-failed "" "item=$1" "clone=unknown"
    return 1
  fi
  ITEM_STATE_DIR="$WORK_DIR/hosted-state/$1"
  ITEM_WORKTREE="$ITEM_STATE_DIR/lane"
  if ! mkdir -p -- "$ITEM_WORKTREE/tmp"; then
    lane_failure_set handoff-read-failed "" "item=$1" "path=$ITEM_WORKTREE/tmp"
    return 1
  fi
  hosted_state_fetch "$1" "$clone" "$STATE_DIR_SETTING" "$ITEM_STATE_DIR" || return 1
  ITEM_HOSTED_STATE="$LANE_HOSTED_STATE_PATH"
  hosted_state_fetch "$1" "$HOSTED_ROOT" tmp "$ITEM_WORKTREE/tmp"
}
# Run the one lane close-out verb where a hosted item's lane-exited is reported,
# once per pane, after its merge. Exit 3 is a checkout with user-owned changes:
# the user settles it, so it is reported and never retried or forced. Any other
# exit returns 1 with its message on stderr: the caller commits the rows it
# already settled, other lanes' closes among them, before the pass exits 2.
#
# A TERM part way through, how a repeat loop stops its pass, is noted in
# CLOSE_TERMED and the close runs to its end: its outcome is reported, and the
# caller commits the lane's row and ends the long pass. A close ended midway
# would lose a failure the row is reset to retry. The close is waited on in the
# background, for tick_sleep's reason, and again after a TERM returns the wait
# early. pass_stop spares its tree, read from CLOSE_PID_FILE.
CLOSE_TERMED=""
CLOSE_RESULT=failed
close_hosted_lane() { # ITEM [--if-terminal]
  local out line path="" rc=0 close_pid
  CLOSE_RESULT=failed
  trap 'CLOSE_TERMED=1' TERM
  "$LANE_CLOSE" --state-dir "$FLEET_STATE_DIR" "$@" > "$WORK_DIR/lane-close.out" 2>&1 &
  close_pid=$!
  printf '%s\n' "$close_pid" > "$CLOSE_PID_FILE"
  while :; do
    rc=0
    wait "$close_pid" || rc=$?
    [[ -n "$CLOSE_TERMED" && "$rc" -gt 128 ]] && kill -0 "$close_pid" 2>/dev/null || break
  done
  rm -f -- "$CLOSE_PID_FILE"
  trap - TERM
  out="$(cat -- "$WORK_DIR/lane-close.out")"
  case "$rc" in
    0)
      CLOSE_RESULT=closed
      echo "EVENT lane-closed $1"
      # A host that no longer held the item ran no archive pass, so lane-close
      # gives no archive verdict and its closed=absent line stands in its place.
      if line="$(grep '^kept=' <<<"$out")" || line="$(grep -xF "closed=absent item=$1" <<<"$out")"; then
        printf '%s\n' "$line"
      else
        echo "kept=none"
      fi ;;
    3)
      CLOSE_RESULT=refused
      # The provider's close-refused line names the refused checkout.
      while IFS= read -r line; do
        [[ "$line" == *"close-refused path="* ]] || continue
        path="${line#*close-refused path=}"
        break
      done <<<"$out"
      echo "EVENT lane-close-refused $1"
      printf 'path=%s\n' "${path:-unknown}"
      [[ -z "$out" ]] || printf '%s\n' "$out" >&2 ;;
    4)
      # A provider can also return 4. Only the close verb's own keyed line
      # says the item reopened after the probe.
      if [[ "${2:-}" == --if-terminal ]] && grep -qxF "lane-close: item-open item=$1" <<<"$out"; then
        CLOSE_RESULT=open
        return 0
      fi
      ow_message lane-close-failed "item=$1" "exit=$rc" >&2
      [[ -z "$out" ]] || printf '%s\n' "$out" >&2
      return 1 ;;
    *)
      ow_message lane-close-failed "item=$1" "exit=$rc" >&2
      [[ -z "$out" ]] || printf '%s\n' "$out" >&2
      return 1 ;;
  esac
}

close_finished_hosted_lane() { # LANE ROW KEY; updates check_lanes' asking_state and close_failed
  hosted_lane_item "$1"
  # A worktree still standing belongs to a lane inside merge close-out,
  # or one the overseer resumes. Only its removed worktree admits close.
  if [[ -n "$HOSTED_ROOT" && -n "$(lane_row_get merged "$asking_state" "$LANE_ITEM")" ]] \
     && grep -qxF -- "$LANE_ITEM" <<<"$HOSTED_GONE_ITEMS"; then
    # Commit before the irreversible close so a stopped pass cannot repeat it.
    lane_row_commit "$asking_state"
    if ! close_hosted_lane "$LANE_ITEM"; then
      asking_state="$(lane_row_set "$2" "$asking_state" "$1" "$3")"
      close_failed=1
    fi
    [[ -z "$CLOSE_TERMED" ]] || { lane_row_commit "$asking_state"; exit 143; }
  fi
}

# Stopped and parked records have no pane or mailbox to watch. Read the close
# verb's terminal judge, including a retained PR wait and Done-when boxes, on every
# fleet pass, and keep only provider refusals:
# user-owned changes need an overseer's action, not another provider call.
check_terminal_lanes() {
  [[ -n "$STATE_FILE" ]] || return 0
  local records record item terminal key prior refused rc merged merge_key cycle_pr recorded_merge merged_repo rows="${PW_SEEN[0]}" refreshed=false
  local items=()
  records="$(jq -cS '(.lanes // [])[] | objects | select(.status == "parked" or .status == "stopped")' <<<"$FLEET_STATE")" \
    || die state-invalid "" "path=$STATE_FILE"
  while IFS= read -r record; do
    [[ -n "$record" ]] || continue
    item="$(jq -er '.item | strings | select(length > 0)' <<<"$record")" \
      || die state-invalid "" "path=$STATE_FILE" "field=item"
    items+=("$item")
    rc=0
    terminal="$("$LANE_CLOSE" --state-dir "$FLEET_STATE_DIR" --terminal-state "$item" 2>"$WORK_DIR/terminal.err")" || rc=$?
    if [[ "$rc" -ne 0 ]]; then
      ow_message lane-close-failed "item=$item" "exit=$rc" >&2
      cat -- "$WORK_DIR/terminal.err" >&2
      PASS_FAILED=1
      continue
    fi
    case "$terminal" in
      open) rows="$(lane_row_clear terminal-close "$rows" "$item")"; continue ;;
      completed|canceled) ;;
      *) die state-invalid "$terminal" "item=$item" "field=terminal-state" ;;
    esac
    key="$terminal|$record"
    prior="$(lane_row_get terminal-close "$rows" "$item")" \
      || die state-read-failed "" "item=$item" "row=terminal-close"
    refused=false
    [[ "$prior" != "$key" ]] || refused=true
    # The tracker can become terminal at merge while the sandbox is stopped.
    # Preserve the merge record before close removes its lane-side state.
    merged="$(lane_row_get merged "$rows" "$item")" \
      || die state-read-failed "" "item=$item" "row=merged"
    cycle_pr="$(jq -r '.cycle.pr // empty' <<<"$record")" \
      || die state-invalid "" "path=$STATE_FILE" "field=cycle"
    recorded_merge="$(jq -r '(.parked // .pending_pr) | if .pr != null then "\(.repo | ascii_downcase)#\(.pr)" else "" end' <<<"$record")" \
      || die state-invalid "" "path=$STATE_FILE" "field=parked"
    merged_repo="$(jq -r '(.repo // "") | ascii_downcase' <<<"$record")" \
      || die state-invalid "" "path=$STATE_FILE" "field=repo"
    for merge_key in $merged; do
      if [[ -n "$recorded_merge" ]]; then
        [[ "$merge_key" == "$recorded_merge" ]] || continue
      elif [[ -n "$merged_repo" && "${merge_key%#*}" != "$merged_repo" ]]; then
        continue
      fi
      [[ "${merge_key##*#}" != "$cycle_pr" ]] || break
      rc=0
      "$SCRIPT_DIR/oversee-cycle" --state-dir "$FLEET_STATE_DIR" record \
        --pr "${merge_key##*#}" --repo "${merge_key%#*}" "$item" || rc=$?
      if [[ "$rc" -ne 0 ]]; then
        ow_message lane-close-failed "item=$item" "step=cycle" "exit=$rc" >&2
      fi
      # The recorder adds cycle to this same record. Keep that write in the
      # refusal key so it does not cause a second provider call on restart.
      record="$(jq -cS --arg item "$item" '.lanes[] | select(.item == $item)' "$STATE_FILE")" \
        || die state-read-failed "" "path=$STATE_FILE" "item=$item"
      key="$terminal|$record"
      refreshed=true
      break
    done
    # A provider refusal suppresses only close. Merge discovery and recorder
    # recovery still run, and their cycle write keeps the refusal on restart.
    if [[ "$refused" == true ]]; then
      rows="$(lane_row_set terminal-close "$rows" "$item" "$key")"
      continue
    fi
    if close_hosted_lane "$item" --if-terminal; then
      if [[ "$CLOSE_RESULT" == refused ]]; then rows="$(lane_row_set terminal-close "$rows" "$item" "$key")"; fi
      # A close may have rewritten the fleet. Read it before pane and merge
      # checks, so they cannot report a closed record as still parked.
      if [[ "$CLOSE_RESULT" != open ]]; then refreshed=true; PASS_EVENT=1; fi
    else
      PASS_FAILED=1
    fi
    lane_row_commit "$rows"
    [[ -z "$CLOSE_TERMED" ]] || exit 143
  done <<<"$records"
  rows="$(lane_row_prune terminal-close "$rows" ${items[@]+"${items[@]}"})"
  lane_row_commit "$rows"
  [[ "$refreshed" == false ]] || fleet_merge quiet
}

command -v gh >/dev/null 2>&1 || die command-missing "" "command=gh"
command -v jq >/dev/null 2>&1 || die command-missing "" "command=jq"
command -v cksum >/dev/null 2>&1 || die command-missing "" "command=cksum"

WORK_DIR="$(mktemp -d)"
# Where the long pass the main loop forks spools its lines and names the
# lane-close it runs, named here for the EXIT and TERM traps below.
LONG_PID=""
LONG_OUT="$WORK_DIR/long.out"
LONG_ERR="$WORK_DIR/long.err"
LONG_STATUS="$WORK_DIR/long.status"
LONG_DONE="$WORK_DIR/long.done"
CLOSE_PID_FILE="$WORK_DIR/close.pid"
# Waits for the long pass and prints what it said. The EXIT trap's half of
# long_collect, so it prints and never exits.
long_drain() {
  local rc=0
  [[ -n "$LONG_PID" ]] || return 0
  wait "$LONG_PID" || rc=$?
  LONG_PID=""
  cat -- "$LONG_OUT"
  cat -- "$LONG_ERR" >&2
  return "$rc"
}
# The answers an ended long pass left, read into this process's globals; 1
# where it left none.
long_status_load() {
  [[ -f "$LONG_STATUS" ]] || return 1
  # shellcheck source=/dev/null
  source "$LONG_STATUS"
}
# The status a succession leaves the run with, as SUCCESSION, or empty: 3 when
# a successor holds the window, 4 when a repeat pass stops on a notice-only or
# spent recovery. repeat_watch reads either as "do not start another watch".
SUCCESSION=""
succession_status() {
  SUCCESSION=""
  if [[ "$OVERSEER_SUCCEEDED" -ne 0 ]]; then SUCCESSION=3
  elif [[ "$OVERSEER_STOP" -ne 0 && "$REPEAT_CHILD" -eq 1 ]]; then SUCCESSION=4; fi
}
# A long pass in flight at exit, on a die in a mail pass among other ways, is
# waited for and its lines printed: its baselines may have advanced past the
# events it found. A succession it completed keeps its status, 3 or 4, so
# repeat mode stops rather than start a second watch beside the successor's.
on_exit() {
  local rc=$?
  if [[ -n "$LONG_PID" ]]; then
    long_drain || :
    if long_status_load; then
      succession_status
      [[ -z "$SUCCESSION" ]] || rc="$SUCCESSION"
    fi
  fi
  rm -rf "$WORK_DIR"
  exit "$rc"
}
trap on_exit EXIT
# TERM, the stop every start takes, ends a long pass in flight and its whole
# tree, `timeout`'s process group among it, parent first so nothing new starts
# under it, rather than on_exit waiting it out beside the next watch; its spool
# is still printed. An ended one is not signalled. Its lane-close's tree is
# spared, read second so a child the close starts between reads is in it
# (close_hosted_lane).
tree_pids() { # PID
  ps -A -o pid= -o ppid= 2>/dev/null | awk -v root="$1" '{ kids[$2] = kids[$2] " " $1 }
    END { q[n = 1] = root; for (i = 1; i <= n; i++) { print q[i]
      m = split(kids[q[i]], k, " "); for (j = 1; j <= m; j++) q[++n] = k[j] } }'
}
TICK_SLEEP_PID=""
pass_stop() {
  local pid tree spared=" "
  [[ -z "$TICK_SLEEP_PID" ]] || kill -TERM "$TICK_SLEEP_PID" 2>/dev/null || :
  if [[ -n "$LONG_PID" && ! -e "$LONG_DONE" ]]; then
    tree="$(tree_pids "$LONG_PID")"
    [[ ! -s "$CLOSE_PID_FILE" ]] || spared+="$(tree_pids "$(cat -- "$CLOSE_PID_FILE")" | tr '\n' ' ')"
    for pid in $tree; do
      [[ "$spared" != *" $pid "* ]] || continue
      kill -TERM "$pid" 2>/dev/null || :
    done
  fi
  exit 143
}
trap pass_stop TERM

# Auth ladder (../references/gates.md § Waiter auth ladder): a stale env token yields to the
# keyring; when neither works, the env token is dropped so the project's
# GH_BOT_TOKEN can be selected — the last candidate. Never proceed
# unauthenticated: an unauthenticated `gh pr list` would report an empty
# fleet, not a failure.
#
# Asked once per run, and only when GitHub is first needed: resolving a
# repository no --repo names, a long pass, or the heartbeat's open-PR list. A
# run that ends on mail news before a long pass comes due makes no GitHub call.
GH_READY=0
github_ready() {
  [[ "$GH_READY" -eq 0 ]] || return 0
  orch_sanitize_gh_env
  if ! orch_github_auth_status; then
    unset GH_TOKEN GITHUB_TOKEN
    { orch_load_env_bot_token "$PROJECT_ROOT" && orch_github_auth_status; } \
      || die auth-failed "" "service=github"
  fi
  GH_READY=1
}

if [[ ${#REPOS[@]} -eq 0 ]]; then
  github_ready
  # The shared resolver, so a watch launched with GH_REPO naming another
  # repository reduces that one rather than the checkout it was started in.
  # Exit 2 prints the value it rejected, which is no more usable as a `--repo`
  # argument than nothing resolved at all, so both refuse here.
  resolve_status=0
  resolved="$(orch_resolve_gh_repo "$PROJECT_ROOT")" || resolve_status=$?
  [[ "$resolve_status" -eq 0 && -n "$resolved" ]] || die repo-unresolved "" "option=--repo"
  REPOS=("$resolved")
fi
# Settled once, HERE — below the default resolution, the one point every path's
# REPOS has reached its final value, so a repo `gh repo view` reported in its
# registered casing is canonicalized too.
check_repo_set
if [[ -x "$PR_WATCH" ]]; then
  :
else
  ow_message reducer-missing "path=$PR_WATCH" >&2
  PR_WATCH=""
fi
# Handoff fails CLOSED like triage: a lane that handed off and exited is
# otherwise a lane-exited the overseer relaunches from nothing. Asked again
# after every re-read of the state, because a fleet that started with no item
# can gain its first one between two loops of this run.
require_item_helpers() {
  [[ -n "$ITEM_BRANCHES" ]] || return 0
  [[ -x "$WORKFLOW_STATE" ]] \
    || die helper-missing "" "path=$WORKFLOW_STATE" "setting=OVERSEE_WATCH_WORKFLOW_STATE"
}
if [[ -z "$ITEM_BRANCHES" ]]; then
  ow_message items-omitted "count=0" "skipped=merged,handoff" >&2
fi
require_item_helpers
# The mail pass fails closed too, items or not: it is the only channel a lane
# has to reach the overseer on a surface with no pane, and the one the owner's
# notes arrive on, so a missing reader would leave them unread with nothing said.
[[ -x "$LANE_MAIL" ]] \
  || die helper-missing "" "path=$LANE_MAIL" "setting=OVERSEE_WATCH_LANE_MAIL"
# The account read is the only way capacity reaches the overseer between
# events, so a missing reader stops the watch rather than leave every account
# change unsaid.
[[ -x "$LANES_CLI" ]] \
  || die helper-missing "" "path=$LANES_CLI" "setting=OVERSEE_WATCH_LANES"
# The report judgement reads the fleet state, so it is required where one is.
[[ -z "$STATE_FILE" || -x "$REPORT_CLI" ]] \
  || die helper-missing "" "path=$REPORT_CLI" "setting=OVERSEE_WATCH_REPORT"
# Inside tmux the pane checks are how an item's lane is watched, so a run
# naming items and no window is told which checks it is not running, as the
# two notes above say for the reducer and the merged check. Outside tmux there
# is no pane to read and nothing to note.
if tmux_server_named && [[ -n "$ITEM_BRANCHES" && ${#LANES[@]} -eq 0 ]]; then
  ow_message lanes-omitted "count=0" "active=pr-watch,merged,triage,handoff" >&2
fi

pw_init_state
MAIL_STATE_FILE="$(pw_state_file "${REPOS[0]}").mail"
[[ ! -f "$MAIL_STATE_FILE" ]] || MAIL_SEEN="$(cat -- "$MAIL_STATE_FILE")" \
  || die state-read-failed "" "path=$MAIL_STATE_FILE"

# Every --repo: a consumer-repo PR merges where the item's work went, under the
# same branch name, and a fork's PR on that name is rejected per repo. Reported
# once per PR: the item's `merged` row holds every `<repo>#<number>` already
# delivered, so a merged item still in --item on a re-run is not news again,
# while a further PR on the branch, in any repo, is. The rows are committed
# once, after the lines are out.
# A parked item with work left needs its lane to finish post-merge work,
# including a Done item with an unchecked box. Hand only
# the pull request its park judged to the overseer's relaunch. A terminal
# item with no work left needs no relaunch: check_terminal_lanes records its cycle and closes
# it after this check commits the merge row. The heartbeat repeats the hand
# while that item's record still reads parked over that merge.
# GitHub's search ceiling for one gh pr list; the key search refuses a page
# that reaches it, since the item's own pull request may be past it.
MERGED_SEARCH_PAGE=1000
# One merged-PR reader owns lookup and lane_merged evaluation. Verification
# uses its mergedAt only for the release trigger's publication floor.
MERGED_ITEM_ROWS=""
merged_item_read() { # ITEM REPO PR [SINCE_EPOCH] [SINCE_UTC]
  local item="$1" repo="$2" pr="$3" since="${4:-null}" floor="${5:-}"
  local branch list named search rows errf="$WORK_DIR/merged.err"
  local fields=number,headRefName,headRepositoryOwner,mergedAt,title,body
  branch="$(printf '%s' "$item" | tr '[:upper:]' '[:lower:]')"
  list="$(gh pr list --repo "$repo" --head "$branch" --state merged --limit 10 --json "$fields" 2>"$errf")" \
    || die pr-list-failed "$(cat "$errf")" "repo=$repo" "state=merged" "branch=$branch"
  # A cloud session's branch names no item, so its pull request is found
  # by the key in its title or body; lane_own judges what this returns.
  # GitHub text search cannot ask for the key's place in a title scope or
  # after Closes, so mentions come back too, bounded by --since.
  search="\"$item\" in:title,body${floor:+ merged:>=$floor}"
  named="$(gh pr list --repo "$repo" --search "$search" --state merged --limit "$MERGED_SEARCH_PAGE" --json "$fields" 2>"$errf")" \
    || die pr-list-failed "$(cat "$errf")" "repo=$repo" "state=merged" "search=$item"
  rows="$(jq length <<<"$named" 2>"$errf")" || die pr-list-invalid "$(cat "$errf")" "repo=$repo" "search=$item"
  [[ "$rows" -lt "$MERGED_SEARCH_PAGE" ]] || die merged-search-truncated "" "repo=$repo" "item=$item" "limit=$MERGED_SEARCH_PAGE"
  if ! MERGED_ITEM_ROWS="$(jq -cs --arg item "$item" --arg owner "${repo%%/*}" --argjson pr "$pr" --argjson since "$since" \
    "$LANE_MERGED_JQ"' add // [] | reduce .[] as $row ([]; if any(.[]; .number == $row.number) then . else . + [$row] end)
    | lane_merged($item; $owner; $pr; $since)' \
    <<<"$list$named" 2>"$errf")"; then
    die pr-list-invalid "$(cat "$errf")" "repo=$repo" "branch=$branch"
  fi
}

check_merged() {
  [[ -n "$ITEM_BRANCHES" ]] || return 0
  local errf="$WORK_DIR/merged.err" item branch repo pr hit hits prior keys fresh key line state="${PW_SEEN[0]}"
  for item in "${MERGED_ITEMS[@]}"; do
    branch="$(printf '%s' "$item" | tr '[:upper:]' '[:lower:]')"
    PARKED_KEY=""
    item_parked "$item" || true
    hits=""
    for repo in "${REPOS[@]}"; do
      pr=null
      [[ "${PARKED_KEY%#*}" != "$repo" ]] || pr="${PARKED_KEY##*#}"
      merged_item_read "$item" "$repo" "$pr" "$SINCE_EPOCH" "$SINCE"
      if ! hit="$(jq -r --arg item "$item" --arg repo "$repo" '.[] | "\(.number) \($item | ascii_downcase) \($repo)"' <<<"$MERGED_ITEM_ROWS" 2>"$errf")"; then
        die pr-list-invalid "$(cat "$errf")" "repo=$repo" "branch=$branch"
      fi
      [[ -z "$hit" ]] || hits+="$hit"$'\n'
    done
    if [[ -z "$hits" ]]; then
      state="$(lane_row_clear merged "$state" "$item")"
      continue
    fi
    prior="$(lane_row_get merged "$state" "$item")"
    keys="" fresh=""
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      key="${line##* }#${line%% *}"
      keys="${keys:+$keys }$key"
      grep -qxF -- "$key" <<<"${prior// /$'\n'}" && continue
      fresh="${fresh:+$fresh }$key"
      echo "EVENT merged $line"
      PASS_EVENT=1
    done <<<"$hits"
    state="$(lane_row_set merged "$state" "$item" "$keys")"
    item_parked "$item" && [[ -n "$fresh" ]] || continue
    # A parked item's fresh merges that are not its own are named, so a park
    # left standing over a merge has a line saying which merge it was not.
    if [[ " $fresh " != *" $PARKED_KEY "* ]]; then
      ow_message parked-merge-unmatched "item=$item" "recorded=$PARKED_KEY" "seen=${fresh// /,}" >&2
      continue
    fi
    parked_merged_line "$item" "$PARKED_KEY"
  done
  state="$(lane_row_prune merged "$state" "${MERGED_ITEMS[@]}")"
  lane_row_commit "$state"
}

# The parked-merged line, one spelling for the merged check's fresh merge and
# the heartbeat's repeat.
parked_merged_line() { # ITEM KEY
  local terminal rc=0
  terminal="$("$LANE_CLOSE" --state-dir "$FLEET_STATE_DIR" --terminal-state "$1" 2>"$WORK_DIR/terminal.err")" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    cat -- "$WORK_DIR/terminal.err" >&2
    die lane-close-failed "" "item=$1" "exit=$rc"
  fi
  case "$terminal" in
    completed|canceled) return 0 ;;
    open) echo "EVENT parked-merged $1 pr=${2##*#} repo=${2%#*}" ;;
    *) die state-invalid "$terminal" "item=$1" "field=terminal-state" ;;
  esac
}

# The hand is level-triggered from the record: every record still reading
# parked whose recorded `<repo>#<number>` is in its item's merged row of STATE,
# the committed baseline the merged check writes, is handed on again. Nothing
# here ends the repeat; the relaunch rewriting the record stopped does, so a
# relaunch refused, or an overseer that compacted or handed off after the
# first hand, still has the merge named at the next heartbeat. Errexit is off
# under the caller's `||`, so the row read returns its own failure.
parked_merged_owed() { # STATE
  local i row
  for i in ${PARKED_ITEMS[@]+"${!PARKED_ITEMS[@]}"}; do
    row="$(lane_row_get merged "$1" "${PARKED_ITEMS[$i]}")" || return 1
    [[ " $row " == *" ${PARKED_KEYS[$i]} "* ]] || continue
    parked_merged_line "${PARKED_ITEMS[$i]}" "${PARKED_KEYS[$i]}"
  done
}

check_triage() {
  [[ "$TRIAGE_ENABLED" -eq 1 ]] || return 0
  local errf="$WORK_DIR/triage.err" now age days out ids verdicts pr_keys triage_keys="" seen id new_ids="" next rc=0
  verdicts="$("$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} get oversee '.triaged // [] | map(select(.verdict == "kept" or .verdict == "canceled") | .issue) | .[]' 2>"$errf")" || rc=$?
  [[ "$rc" -eq 0 ]] \
    || die triage-state-failed "$(cat "$errf")" "exit=$rc"
  verdicts="$(awk 'NF && !seen[$0]++' <<<"$verdicts")"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] \
      || die triage-item-invalid "" "item=$id"
    [[ -z "$triage_keys" ]] || triage_keys+=$'\n'
    triage_keys+="triage"$'\t'"$id"
  done <<<"$verdicts"
  pr_keys="$(awk -F'\t' '$1 != "triage" { print }' <<<"${PW_SEEN[0]}")"
  if [[ -n "$pr_keys" && -n "$triage_keys" ]]; then
    next="$pr_keys"$'\n'"$triage_keys"
  else
    next="$pr_keys$triage_keys"
  fi
  if [[ "$next" != "${PW_SEEN[0]}" ]]; then
    pw_stage_state "$(pw_state_file "${REPOS[0]}")" "$next"
    pw_commit_state "$(pw_state_file "${REPOS[0]}")"
    PW_SEEN[0]="$next"
  fi
  now="$(date -u +%s)" || die time-failed "" "clock=UTC"
  age=$((now - SINCE_EPOCH))
  [[ "$age" -ge 0 ]] || age=0
  # Linear's live list accepts whole-day windows. Round up, then apply the
  # exact ISO floor below so the wider server query cannot mint an old event.
  days=$((age / 86400 + 1))
  out="$("$TRACKER" issues list --team "$LINEAR_TEAM" --created-since "${days}d" --max --format=safe 2>"$errf")" || rc=$?
  [[ "$rc" -eq 0 ]] \
    || die tracker-list-failed "$(cat "$errf")" "team=$LINEAR_TEAM" "exit=$rc"
  ids="$(jq -r --argjson since "$SINCE_EPOCH" '
    def created_epoch: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
    if type != "array" then error("tracker-type expected=array actual=\(type)") else . end
    | [ .[]
      | if ((.created_at? | type) == "string" and (.created_at | length) > 0)
        then . else error("tracker-field field=created_at value=\(.created_at | tojson)") end
      | select((.created_at | created_epoch) >= $since)
      | if ((.id? | type) == "string" and (.id | test("^[A-Za-z0-9._-]+$")))
        then .id else error("tracker-field field=id value=\(.id | tojson)") end ]
    | unique[]
  ' <<<"$out" 2>"$errf")" \
    || die tracker-list-invalid "$(cat "$errf")" "team=$LINEAR_TEAM"
  seen="$(awk -F'\t' '$1 == "triage" && NF == 2 { print $2 }' <<<"${PW_SEEN[0]}")"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    grep -qxF -- "$id" <<<"$seen" || new_ids+="$id"$'\n'
  done <<<"$ids"
  [[ -n "$new_ids" ]] || return 0
  new_ids="${new_ids%$'\n'}"
  while IFS= read -r id; do
    echo "EVENT triage $id"
  done <<<"$new_ids"
  PASS_EVENT=1
}

# A lane told to hand off records `.handoff` in its item's state and exits.
# The record is the carrier, read from workflow state and never a pane, so the
# check runs on every surface. Whether one stands is `workflow-state
# handoff-standing`'s answer, read in the places it names, the lane's root
# passed as the worktree as the lane's own turn-end hook passes it, so the
# watch cannot report a lane as handed off that the hook still holds.
# It is reported once per record: the row keyed by the record's checksum is
# what stops a re-run between the event and the
# relaunch from reporting it again, and a record the relaunched lane stamped
# `.resumed_at` on is spent. Ordered after lane-exited and before
# usage-limit: the lane's exit is the older news, and a spent account is not
# what a handed-off lane is waiting on. Every item's record is reported in the
# pass that finds it, and the rows are committed once, after the lines are out.
check_handoff() {
  [[ ${#ITEMS[@]} -gt 0 ]] || return 0
  local item rec key prior file errf="$WORK_DIR/handoff.err" state="${PW_SEEN[0]}"
  for item in "${ITEMS[@]}"; do
    grep -qxF -- "$item" <<<"$PASS_FAILED_ITEMS" && continue
    ! item_in "$item" ${FILELESS[@]+"${FILELESS[@]}"} || continue
    if ! item_state_dir "$item"; then
      lane_failure_report "$item" "$state"
      state="$LANE_FAILURE_STATE"
      lane_row_commit "$state"
      continue
    fi
    # lib/lane-state.sh reads the verdict. A state this pass could not read,
    # an install without the verb included, is reported rather than passed
    # off as "no handoff".
    lane_handoff_standing . "$errf" "$WORKFLOW_STATE" --state-dir "$ITEM_STATE_DIR" handoff-standing "$item" \
      ${ITEM_WORKTREE:+--worktree "$ITEM_WORKTREE"}
    case "$LANE_HANDOFF_STATE" in
      none)
        state="$(lane_row_clear handoff "$state" "$item")"
        state="$(lane_row_clear lane-failed "$state" "$item")"
        continue ;;
      stands) ;;
      *)
        # The file the verdict named, a hosted scratch copy as the host's file.
        file="${LANE_HANDOFF_FILE:-$ITEM_STATE_DIR}"
        [[ -z "$HOSTED_ROOT" ]] || case "$file" in
          "$ITEM_WORKTREE"/*) file="$HOSTED_ROOT${file#"$ITEM_WORKTREE"}" ;;
          *) file="$ITEM_HOSTED_STATE" ;;
        esac
        lane_failure_set handoff-read-failed "$(cat "$errf")" "item=$item" "path=$file"
        lane_failure_report "$item" "$state"
        state="$LANE_FAILURE_STATE"
        lane_row_commit "$state"
        continue ;;
    esac
    rec="$LANE_HANDOFF_RECORD"
    state="$(lane_row_clear lane-failed "$state" "$item")"
    key="$(printf '%s' "$rec" | cksum | awk '{ print $1 }')"
    prior="$(lane_row_get handoff "$state" "$item")"
    state="$(lane_row_set handoff "$state" "$item" "$key")"
    [[ "$key" != "$prior" ]] || continue
    echo "EVENT handoff $item"
    printf '%s\n' "$rec"
    PASS_EVENT=1
  done
  state="$(lane_row_prune handoff "$state" "${ITEMS[@]}")"
  lane_row_commit "$state"
}

# Key by the preparation's start so a relaunch is reported afresh.
check_prepare() {
  local item outcome since log reason key age rows="${PW_SEEN[0]}" items=()
  while IFS=$'\x1f' read -r item outcome since log reason; do
    [[ -n "$item" ]] || continue
    items+=("$item")
    age=$((PASS_NOW - since))
    case "$outcome" in
      pending) [[ "$age" -gt "$PREPARE_SECS" ]] || continue; key="$since|stuck" ;;
      ready|failed) key="$since|$outcome" ;;
    esac
    [[ "$key" != "$(lane_row_get lane-prepare "$rows" "$item")" ]] || continue
    rows="$(lane_row_set lane-prepare "$rows" "$item" "$key")"
    case "$outcome" in
      pending) echo "EVENT lane-prepare-stuck $item age=${age}s log=$log" ;;
      ready) echo "EVENT lane-ready $item" ;;
      failed) echo "EVENT lane-prepare-failed $item reason=$reason log=$log" ;;
    esac
    PASS_EVENT=1
  done <<<"$PREPARE_ROWS"
  rows="$(lane_row_prune lane-prepare "$rows" ${items[@]+"${items[@]}"})"
  lane_row_commit "$rows"
  wall_relaunch_outcomes
}

# One completed-run list per repository proves the failure pair. A failed
# read cannot clear a standing pair or end the other fleet checks. GitHub can
# answer with a stale page. The row records the newest completed run read; a
# page older than it judges nothing, and a pair with no record or one that
# would open an incident counts only when its newer run is the newest
# completed run in the unfiltered list. When it is not, the row records the
# newer of that list's newest run and the pair's, unjudged, so a page reaching
# it is still judged. REFRESH_RUN alone orders and matches runs: a re-run keeps
# its id and createdAt and takes the next attempt. A row in the earlier
# layout, <passes>|<cause>, reads as a standing incident with no record.
REFRESH_RUN='def run: [.createdAt, .databaseId, .attempt];
  def valid: (.databaseId | type) == "number" and (.attempt | type) == "number" and
    (.createdAt | type) == "string" and (.createdAt | test("^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"));'
REFRESH_ROW='^(\["[0-9TZ:-]{20}",([0-9]+),[0-9]+\])\|(unjudged|[0-9]+\|.+)?$'
REFRESH_ROW_UNRECORDED='^[0-9]+\|.+$'
workflow_absent() { # REPO WORKFLOW ERROR_FILE
  local workflows workflow_pattern="${2//./\\.}"
  # gh rewrites every workflow-endpoint 404, including access failures.
  # Only a complete successful workflow list can prove absence.
  grep -q "^HTTP 404: workflow $workflow_pattern not found on the default branch (" "$3" \
    && workflows="$(gh api --paginate "repos/$1/actions/workflows" \
      --jq '.workflows[].path' 2>"$3")" \
    && ! grep -qxF ".github/workflows/$2" <<<"$workflows"
}

check_main_push() {
  local repo runs run conclusion jobs log cause failures key prior changed rc
  local rows="${PW_SEEN[0]}" errf="$WORK_DIR/main-push.err"
  for repo in "${REPOS[@]}"; do
    rc=0
    runs="$(gh run list --repo "$repo" --workflow skill-tests.yml --branch main --event push \
      --status completed --limit 1 --json databaseId,conclusion 2>"$errf")" || rc=$?
    if (( rc == 0 )); then
      runs="$(jq -er '
        if type == "array" and length <= 1 and all(.[];
          (.databaseId | type) == "number" and (.conclusion | type) == "string") then
          if length == 0 then "none|" else "\(.[0].databaseId)|\(.[0].conclusion)" end
        else error("invalid completed main-push runs") end' <<<"$runs" 2>"$errf")" || rc=$?
    fi
    if (( rc != 0 )); then
      if workflow_absent "$repo" skill-tests.yml "$errf"; then
        rows="$(lane_row_clear main-push-failing "$rows" "$repo")" \
          || die state-read-failed "" "repo=$repo" "row=main-push-failing"
        continue
      fi
      ow_message main-push-unread "repo=$repo" "read=runs" "exit=$rc" >&2
      continue
    fi
    IFS='|' read -r run conclusion <<<"$runs"
    if [[ "$conclusion" != failure && "$conclusion" != timed_out ]]; then
      rows="$(lane_row_clear main-push-failing "$rows" "$repo")" \
        || die state-read-failed "" "repo=$repo" "row=main-push-failing"
      continue
    fi
    rc=0
    jobs="$(gh run view "$run" --repo "$repo" --json jobs 2>"$errf")" || rc=$?
    if (( rc == 0 )); then
      jobs="$(jq -ec '
        if (.jobs | type) == "array" and all(.jobs[];
          (.name | type) == "string" and (.conclusion | type) == "string") then
          [.jobs[] | select(.conclusion == "failure" or .conclusion == "timed_out") | .name] | unique
        else error("invalid main-push jobs") end' <<<"$jobs" 2>"$errf")" || rc=$?
    fi
    if (( rc != 0 )); then
      ow_message main-push-unread "repo=$repo" "read=jobs" "run=$run" "exit=$rc" >&2
      continue
    fi
    rc=0
    log="$(gh run view "$run" --repo "$repo" --log-failed 2>"$errf")" || rc=$?
    cause=unread failures=null
    if (( rc == 0 )); then
      # Only producer summaries identify suites. Raw diagnostics describe
      # the first cause but can change while the same suites still fail.
      log="$(awk '{ sub(/^[^\t]*\t[^\t]*\t[^ ]* /, ""); sub(/\r$/, "") }
        /^suite=.* fail=[1-9][0-9]*($| )/ || /^FAILED: / || /^FAIL[ :]/ || /^run-all.sh: (suite-timeout|run-deadline) / {
          gsub("\t", " "); print
        }' <<<"$log")" || rc=$?
      if (( rc == 0 )); then
        [[ -z "$log" ]] || cause="${log%%$'\n'*}"
        failures="$(jq -Rsc 'split("\n") | map(
          if startswith("suite=") then split(" ")[0]
          elif startswith("FAILED: ") then ltrimstr("FAILED: ")
          else empty end) | unique' <<<"$log")" || rc=$?
      fi
    fi
    if (( rc != 0 )); then
      ow_message main-push-unread "repo=$repo" "read=log" "run=$run" "exit=$rc" >&2
    fi
    prior="$(lane_row_get main-push-failing "$rows" "$repo")" \
      || die state-read-failed "" "repo=$repo" "row=main-push-failing"
    # Missing logs cannot change known failures. Recovery fills missing
    # evidence quietly; later reads still compare it, including rerun attempts.
    key="$(jq -cn --argjson jobs "$jobs" --argjson failures "$failures" --argjson prior "${prior:-null}" '
      [$jobs, (if $failures == null and $prior[0] == $jobs then $prior[1] else $failures end)]')" \
      || die state-read-failed "" "repo=$repo" "row=main-push-failing"
    changed="$(jq -nr --argjson key "$key" --argjson prior "${prior:-null}" '
      $prior == null or $key[0] != $prior[0] or ($prior[1] != null and $key[1] != $prior[1])')" \
      || die state-read-failed "" "repo=$repo" "row=main-push-failing"
    if [[ "$changed" == true ]]; then
      printf 'EVENT main-push-failing %s workflow=skill-tests.yml run=%s jobs=%s cause=%s\n' "$repo" "$run" "$jobs" "$cause"
      PASS_EVENT=1
    fi
    rows="$(lane_row_set main-push-failing "$rows" "$repo" "$key")" \
      || die state-read-failed "" "repo=$repo" "row=main-push-failing"
  done
  lane_row_commit "$rows"
}

check_refresh() {
  local repo runs order newest run since recent log cause prior rec rec_id standing passes rc report
  local rows="${PW_SEEN[0]}" errf="$WORK_DIR/refresh.err"
  for repo in "${REPOS[@]}"; do
    rc=0
    runs="$(gh run list --repo "$repo" --workflow kendex-refresh.yml --status completed --limit 2 \
      --json databaseId,attempt,conclusion,createdAt 2>"$errf")" || rc=$?
    if (( rc != 0 )); then
      if workflow_absent "$repo" kendex-refresh.yml "$errf"; then
        rows="$(lane_row_clear refresh-failing "$rows" "$repo")" \
          || die state-read-failed "" "repo=$repo" "row=refresh-failing"
        continue
      fi
      ow_message refresh-unread "repo=$repo" "read=runs" "exit=$rc" >&2
      continue
    fi
    if ! prior="$(lane_row_get refresh-failing "$rows" "$repo")"; then
      die state-read-failed "" "repo=$repo" "row=refresh-failing"
    fi
    rec=null rec_id='' standing=''
    if [[ "$prior" =~ $REFRESH_ROW ]]; then
      rec="${BASH_REMATCH[1]}" rec_id="${BASH_REMATCH[2]}" standing="${BASH_REMATCH[3]}"
    elif [[ "$prior" =~ $REFRESH_ROW_UNRECORDED ]]; then
      standing="$prior"
    elif [[ -n "$prior" ]]; then
      die state-read-failed "" "repo=$repo" "row=refresh-failing" "layout=unknown"
    fi
    # order is the page's newest run against the record: newer, same, older
    # (an empty page included), or unrecorded; unjudged is same on an unjudged
    # record. since is the older run's createdAt when both runs failed.
    rc=0
    runs="$(jq -er --argjson rec "$rec" "$REFRESH_RUN"'
      if type == "array" and length <= 2 and all(.[]; valid and (.conclusion | type) == "string") then
        (if $rec == null then "unrecorded"
         elif length == 0 then "older"
         elif (.[0] | run) > $rec then "newer"
         elif (.[0] | run) == $rec then "same"
         else "older" end) as $order
        | [$order, (.[0] // {} | .databaseId // "", (run | tojson)),
           (if length == 2 and all(.[]; .conclusion == "failure") then .[1].createdAt else "" end)]
        | map(tostring) | join("|")
      else error("invalid completed refresh runs") end' <<<"$runs" 2>"$errf")" || rc=$?
    if (( rc != 0 )); then
      ow_message refresh-unread "repo=$repo" "read=runs" "exit=$rc" >&2
      continue
    fi
    IFS='|' read -r order newest run since <<<"$runs"
    if [[ "$standing" == unjudged ]]; then
      standing=''
      [[ "$order" != same ]] || order=unjudged
    fi
    case "$order" in
      older)
        ow_message refresh-stale "repo=$repo" "newest=$rec_id" "read=${newest:-none}" >&2
        continue ;;
      unrecorded)
        if [[ -z "$newest" ]]; then
          rows="$(lane_row_clear refresh-failing "$rows" "$repo")" \
            || die state-read-failed "" "repo=$repo" "row=refresh-failing"
          continue
        fi ;;
      newer | same | unjudged) ;;
      *) die refresh-order-unknown "" "repo=$repo" "order=$order" ;;
    esac
    if [[ -z "$since" ]]; then
      rows="$(lane_row_set refresh-failing "$rows" "$repo" "$run|")" \
        || die state-read-failed "" "repo=$repo" "row=refresh-failing"
      continue
    fi
    # A pair whose newer run is the one already judged is no news.
    [[ "$order" != same || -n "$standing" ]] || continue
    if [[ "$order" == unrecorded || -z "$standing" ]]; then
      # gh's default page leaves room for queued and running runs above it.
      rc=0
      recent="$(gh run list --repo "$repo" --workflow kendex-refresh.yml --limit 20 \
        --json databaseId,attempt,createdAt,status 2>"$errf")" || rc=$?
      if (( rc == 0 )); then
        recent="$(jq -er --argjson run "$run" "$REFRESH_RUN"'
          if type == "array" and all(.[]; valid and (.status | type) == "string") then
            map(select(.status == "completed"))[0]
            | if . == null then "none|\($run | tojson)" elif run == $run then "same|"
              else "\(.databaseId)|\([run, $run] | max | tojson)" end
          else error("invalid refresh runs") end' <<<"$recent" 2>"$errf")" || rc=$?
      fi
      if (( rc != 0 )); then
        ow_message refresh-unread "repo=$repo" "read=all-runs" "exit=$rc" >&2
        continue
      fi
      if [[ "${recent%%|*}" != same ]]; then
        ow_message refresh-stale "repo=$repo" "newest=${recent%%|*}" "read=$newest" >&2
        rows="$(lane_row_set refresh-failing "$rows" "$repo" "${recent#*|}|${standing:-unjudged}")" \
          || die state-read-failed "" "repo=$repo" "row=refresh-failing"
        continue
      fi
    fi
    cause=unread
    rc=0
    log="$(gh run view "$newest" --repo "$repo" --log-failed 2>"$errf")" || rc=$?
    if (( rc != 0 )); then
      ow_message refresh-unread "repo=$repo" "read=log" "run=$newest" "exit=$rc" >&2
    else
      # gh prefixes each failed-step log line with job, step and timestamp.
      # The cause is the last line of the highest rank: a kendex failed: row,
      # a review-gate validator's FAIL check= row, kendex's Error: line,
      # refresh-consumer's refresh-error=, a hook's kendex-hook-.
      cause="$(awk '{ sub(/^[^\t]*\t[^\t]*\t[^ ]* /, ""); rank = 0; text = $0 }
        /^failed: / { rank = 5 }
        !rank && /^FAIL check=/ { rank = 4 }
        !rank && /^Error: / { rank = 3 }
        !rank && /^refresh-error=/ { rank = 2 }
        !rank && match($0, /kendex-hook-/) { rank = 1; text = substr($0, RSTART) }
        rank && rank >= best { best = rank; cause = text }
        END { gsub("\t", " ", cause); sub(/\r$/, "", cause); print cause }' <<<"$log")" \
        || rc=$?
      if (( rc != 0 )); then
        ow_message refresh-unread "repo=$repo" "read=log" "run=$newest" "exit=$rc" >&2
      fi
      [[ -n "$cause" ]] || cause=unread
    fi
    passes=0
    if [[ -n "$standing" && "${standing#*|}" == "$cause" ]]; then
      passes=$(( ${standing%%|*} + 1 ))
      (( passes < MARK_REPEAT )) || passes=0
    fi
    if (( passes == 0 )); then
      report=initial
      [[ -z "$standing" ]] || report=repeat
      printf 'EVENT refresh-failing %s runs=2 last=%s since=%s report=%s cause=%s\n' "$repo" "$newest" "$since" "$report" "$cause"
      PASS_EVENT=1
    fi
    rows="$(lane_row_set refresh-failing "$rows" "$repo" "$run|$passes|$cause")" \
      || die state-read-failed "" "repo=$repo" "row=refresh-failing"
  done
  lane_row_commit "$rows"
}

# A running lane record whose status file, tmp/lane-status-<item>.md under its
# mail_root, is still missing START_STALL_SECS after the record went running,
# its running_at, on every harness: a lane that never started its workflow
# writes none. A background preparation before that stamp is the host's time,
# not the lane's. Reported once, then again every MARK_REPEAT passes while it
# stands, the rhythm overseer-mark keeps. The row is keyed by that stamp, so a
# relaunch, which renews it, starts a fresh window, and the row turns `seen`
# once the file has stood: a lane whose
# merge-pr close-out removed its worktree, file and all, never started late. A
# local root that is no directory is that removal too, and so is a hosted item
# this run's mail pass found with its worktree gone. A hosted file is read
# through lane-host, and a read that failed settles nothing: the row stands
# and the failure is noted. A lane whose kind declares files=none, a cloud
# session, writes no file this watch can read: its start is the draft pull
# request its session words have it open on the item branch at once, after an
# empty first commit, so no open pull request still means never started. A
# pull request create the session token is refused reads the same way.
check_start_stall() {
  local entry item running age prior passes path rc since prior_running prior_head rows="${PW_SEEN[0]}" items=()
  for entry in ${LAUNCHES[@]+"${LAUNCHES[@]}"}; do
    item="${entry%%=*}"
    running="${entry#*=}"
    items+=("$item")
    if ! prior="$(lane_row_get start-stalled "$rows" "$item")"; then
      die state-read-failed "" "item=$item" "row=start-stalled"
    fi
    [[ "$prior" != "$running|seen" ]] || continue
    rc=0
    hosted_root "$item"
    if item_in "$item" ${FILELESS[@]+"${FILELESS[@]}"}; then
      item_open_pr "$item" || rc=$?
    elif [[ -n "$HOSTED_ROOT" ]]; then
      ! grep -qxF -- "$item" <<<"$HOSTED_GONE_ITEMS" || continue
      ORCH_LANE_HOST="$HOSTED_HOST" lane_host_fetch "$SCRIPT_DIR/lane-host" "$item" "$HOSTED_ROOT/tmp/lane-status-$item.md" \
        "$WORK_DIR/status-probe" "$WORK_DIR/host.err" || rc=$?
    else
      local_root "$item"
      [[ -d "$LOCAL_ROOT" ]] || continue
      path="$LOCAL_ROOT/tmp/lane-status-$item.md"
      [[ -e "$path" ]] || rc=1
    fi
    case "$rc" in
      0) rows="$(lane_row_set start-stalled "$rows" "$item" "$running|seen")"; continue ;;
      1) ;;
      *) ow_message start-stall-unread "item=$item" "exit=$rc" >&2; continue ;;
    esac
    since="$running"
    IFS='|' read -r prior_running passes prior_head since <<<"$prior"
    if item_in "$item" ${FILELESS[@]+"${FILELESS[@]}"}; then
      # A push can answer a directive even when the session's token cannot
      # open its pull request. First observing a branch also leaves its push
      # time unknown, so only an unchanged observation can authorize closing.
      if [[ "$prior_running" != "$running" || "$prior_head" != "$OPEN_PR_BRANCH_HEAD" || -z "$since" ]]; then
        since="$PASS_NOW"
        [[ -n "$OPEN_PR_BRANCH_HEAD" || -n "$prior_head" ]] || since="$running"
      fi
    else
      since="$running"
    fi
    age=$((PASS_NOW - running))
    if (( age < START_STALL_SECS )); then
      if item_in "$item" ${FILELESS[@]+"${FILELESS[@]}"}; then
        rows="$(lane_row_set start-stalled "$rows" "$item" "$running||$OPEN_PR_BRANCH_HEAD|$since")"
      else rows="$(lane_row_clear start-stalled "$rows" "$item")"; fi
      continue
    fi
    if item_in "$item" ${FILELESS[@]+"${FILELESS[@]}"} && cloud_stall_close "$item" "$since"; then
      lane_row_commit "$rows"
      [[ -z "$CLOSE_TERMED" ]] || exit 143
      continue
    fi
    if [[ "$prior_running" == "$running" && -n "$passes" ]]; then
      passes=$(( passes + 1 ))
      (( passes < MARK_REPEAT )) || passes=0
    else passes=0; fi
    if (( passes == 0 )); then
      echo "EVENT start-stalled $item age=$age"
      PASS_EVENT=1
    fi
    if item_in "$item" ${FILELESS[@]+"${FILELESS[@]}"}; then
      rows="$(lane_row_set start-stalled "$rows" "$item" "$running|$passes|$OPEN_PR_BRANCH_HEAD|$since")"
    else rows="$(lane_row_set start-stalled "$rows" "$item" "$running|$passes")"; fi
  done
  rows="$(lane_row_prune start-stalled "$rows" ${items[@]+"${items[@]}"})"
  lane_row_commit "$rows"
}

# Close due owner asks through lane-mail's shared closure rule. Its default
# supplies a recommendation only without an owner answer. The following peek
# reports answers and closes separately. A resolved-already refusal means
# another close won the mailbox lock; every other refusal fails this pass.
resolve_due_owner_asks() {
  local due id rc=0
  due="$("$LANE_MAIL" pending --item overseer --to owner --due 2>"$WORK_DIR/due.err")" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    ow_message ask-due-unread "exit=$rc" >&2
    cat -- "$WORK_DIR/due.err" >&2
    PASS_FAILED=1
    return 0
  fi
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    rc=0
    "$LANE_MAIL" resolve --item overseer --id "$id" --default >/dev/null 2>"$WORK_DIR/resolve.err" || rc=$?
    [[ "$rc" -ne 0 ]] || continue
    [[ "$(head -n 1 "$WORK_DIR/resolve.err")" != "lane-mail: resolved-already="* ]] || continue
    ow_message ask-resolve-failed "id=$id" "exit=$rc" >&2
    cat -- "$WORK_DIR/resolve.err" >&2
    PASS_FAILED=1
  done <<<"$(jq -r '.id // empty' <<<"$due")"
}

# One lane-mail read for the mail pass, its output in MAIL_OUT. A read that
# failed is set as the lane's failure and returns 1, for the caller to report.
MAIL_OUT=""
MAIL_HOST_READS=()
MAIL_HOST_READ_DIR=""
mail_host_read_dir() { # HOST
  local entry
  MAIL_HOST_READ_DIR=""
  for entry in ${MAIL_HOST_READS[@]+"${MAIL_HOST_READS[@]}"}; do
    [[ "${entry%%$'\x1f'*}" != "$1" ]] || { MAIL_HOST_READ_DIR="${entry#*$'\x1f'}"; return 0; }
  done
  return 1
}
mail_host_reads() { # ITEMS...
  local item host clone directory rc entries=() hosts=()
  MAIL_HOST_READS=()
  for item in "$@"; do
    hosted_root "$item"
    [[ -n "$HOSTED_ROOT" ]] || continue
    item_in "$HOSTED_HOST" ${hosts[@]+"${hosts[@]}"} || hosts+=("$HOSTED_HOST")
  done
  for host in ${hosts[@]+"${hosts[@]}"}; do
    entries=()
    for item in "$@"; do
      hosted_root "$item"
      [[ -n "$HOSTED_ROOT" && "$HOSTED_HOST" == "$host" ]] || continue
      clone="$(lane_row_get clone-root "$MAIL_SEEN" "$item")" || die state-read-failed "" "item=$item" "row=clone-root"
      entries+=("$item" "$HOSTED_ROOT" "$clone")
    done
    directory="$WORK_DIR/mail-host-${#MAIL_HOST_READS[@]}"
    mkdir -p -- "$directory" || die mail-read-failed "" "host=$host"
    rm -f -- "${directory:?}/failed" "${directory:?}/index"
    python3 "$SCRIPT_DIR/lib/lane-host-read.py" request "${entries[@]}" >"$directory/request" \
      || die mail-read-failed "" "host=$host" "read=request"
    rc=0
    ORCH_LANE_HOST="$host" "$SCRIPT_DIR/lane-host" read-many <"$directory/request" >"$directory/reply" 2>"$directory/error" || rc=$?
    if [[ "$rc" -eq 0 ]]; then
      python3 "$SCRIPT_DIR/lib/lane-host-read.py" unpack "$directory" 2>"$directory/error" || rc=$?
    fi
    if [[ "$rc" -ne 0 ]]; then
      # Exit 2 on the whole call is a refused batch, never a missing file.
      [[ "$rc" -eq "$LANE_HOST_BUSY_EXIT" ]] || rc=1
      printf '%s\n' "$rc" >"$directory/failed"
    fi
    MAIL_HOST_READS+=("$host"$'\x1f'"$directory")
  done
}
mail_read() { # ITEM LANE_MAIL_ARGS...
  local item="$1" rc=0 host_env=()
  shift
  if [[ "$item" != overseer && -n "$HOSTED_HOST" ]]; then
    mail_host_read_dir "$HOSTED_HOST" || die mail-read-failed "" "host=$HOSTED_HOST" "read=snapshot"
    host_env=("ORCH_LANE_HOST=$HOSTED_HOST" "LANE_HOST_READ_DIR=$MAIL_HOST_READ_DIR")
  fi
  MAIL_OUT="$(env ${host_env[@]+"${host_env[@]}"} "$LANE_MAIL" "$@" 2>"$WORK_DIR/mail.err")" || rc=$?
  [[ "$rc" -ne 0 ]] || return 0
  [[ "$rc" -ne "$LANE_HOST_BUSY_EXIT" ]] || { lane_failure_set lane-host-busy "" "item=$item"; return 1; }
  lane_failure_set mail-read-failed "$(cat "$WORK_DIR/mail.err")" "item=$item" "exit=$rc"
  return 1
}

# Every --item's lane mailbox, from disk or through `lane-host`, so a lane with
# no pane, on another host or in an unseen session still reaches the overseer.
# Each item's row holds the to-overseer.jsonl lines drained and the file's
# first id, so a committed message is not reported again; `drain` drops an
# answered ask itself, so a restarted overseer re-reports only what it owes.
# `--receipts` reads the lane's to-lane.cursor, which every lane read path
# moves: its receipt for each directive passed. The overseer's own mailbox is
# read last by `inbox --peek` and acknowledged only once its notes are
# printed, so a stopped pass leaves them unread rather than taken and unsaid.
# With `overseer`, that mailbox is read alone, and the lists a long pass takes
# from the last full read stand.
check_mail() { # [overseer]
  local item stored prior seen header count first line fields id kind options text rest root cursor from re by class
  local envelopes receipts replaced hold lane_read to_first read_at unread_at unread_passes repeat standing reported at
  local mail_items host_flag args state="$MAIL_SEEN"
  mail_items=()
  if [[ "${1:-}" != overseer ]]; then
    HOSTED_GONE_ITEMS=""
    # This pass's failures alone, as HOSTED_GONE_ITEMS is this pass's: a long
    # pass forked after it skips only the lanes whose read failed just now.
    PASS_FAILED_ITEMS=""
    for item in ${ITEMS[@]+"${ITEMS[@]}"}; do
      item_in "$item" ${MAILLESS[@]+"${MAILLESS[@]}"} || mail_items+=("$item")
    done
  fi
  mail_host_reads ${mail_items[@]+"${mail_items[@]}"}
  mail_items+=(overseer)
  for item in "${mail_items[@]}"; do
    root=""
    host_flag=()
    cursor="$item"
    if [[ "$item" != overseer ]]; then
      hosted_root "$item"
      root="$HOSTED_ROOT"
      host_flag=(--host)
      # A local lane with a recorded root is read there, with no --host: only a
      # hosted read needs one, and lane-mail's ownership gate is on send.
      if [[ -z "$root" ]]; then local_root "$item"; root="$LOCAL_ROOT"; host_flag=(); fi
    fi
    if [[ -n "$HOSTED_ROOT" && "$item" != overseer ]]; then
      mail_host_read_dir "$HOSTED_HOST" || die mail-read-failed "" "host=$HOSTED_HOST" "read=snapshot"
      if ! LANE_HOST_READ_DIR="$MAIL_HOST_READ_DIR" hosted_clone "$item" "$state"; then
        lane_failure_report "$item" "$state"
        mail_row_commit "$LANE_FAILURE_STATE"
        state="$MAIL_SEEN"
        continue
      fi
      state="$(lane_row_set clone-root "$state" "$item" "$HOSTED_CLONE")"
      # With the worktree removed, the lane's closing notice lands in the
      # clone's mailbox: another file, so another cursor.
      if [[ "$HOSTED_GONE" -eq 1 ]]; then
        HOSTED_GONE_ITEMS+="$item"$'\n'
        root="$HOSTED_CLONE"; cursor="$item@clone"
      fi
    fi
    args=(--item "$item")
    [[ -z "$root" ]] || args+=(--root "$root" ${host_flag[@]+"${host_flag[@]}"})
    replaced=0
    hold=none
    count=0
    prior=0
    if [[ "$item" == overseer ]]; then
      resolve_due_owner_asks
      if ! mail_read "$item" inbox "${args[@]}" --peek; then
        lane_failure_report "$item" "$state"
        mail_row_commit "$LANE_FAILURE_STATE"
        state="$MAIL_SEEN"
        continue
      fi
      [[ "${MAIL_OUT%%$'\n'*}" =~ ^count=([0-9]+)\ first= ]] \
        || die mail-read-invalid "" "item=$item" "value=count"
      count="${BASH_REMATCH[1]}"
      envelopes="$(tail -n +2 <<<"$MAIL_OUT")"
    else
      if ! stored="$(lane_row_get lane-mail "$state" "$cursor")"; then
        die state-read-failed "" "item=$item" "row=lane-mail"
      fi
      # `<count> <first>`: the lines drained, and the id the mailbox opened with
      # when they were, empty where it opened with none.
      read -r prior seen <<<"$stored"
      [[ "$prior" =~ ^[0-9]+$ ]] || { prior=0; seen=""; }
      while :; do
        if ! mail_read "$item" drain "${args[@]}" --after "$prior" --receipts; then
          lane_failure_report "$item" "$state"
          mail_row_commit "$LANE_FAILURE_STATE"
          state="$MAIL_SEEN"
          continue 2
        fi
        header="${MAIL_OUT%%$'\n'*}"
        [[ "$header" =~ ^count=([0-9]+)\ first=([A-Za-z0-9._-]*)$ ]] \
          || die mail-read-invalid "" "item=$item" "value=${header:-<empty>}"
        count="${BASH_REMATCH[1]}"
        first="${BASH_REMATCH[2]}"
        # A mailbox opening with another envelope than the one recorded is a
        # replacement, a relaunched lane's fresh one, which the saved cursor
        # would suppress for good; with no first id recorded, one holding fewer
        # lines than were drained is. Read it whole, once: a second mismatch
        # would not end. A read finding no line is no replacement: an
        # append-only mailbox never empties, so it is a read that missed.
        [[ "$replaced" -eq 0 && "$prior" -gt 0 && "$count" -gt 0 ]] || break
        if [[ -n "$seen" ]]; then
          [[ "$first" != "$seen" ]] || break
        else
          [[ "$count" -lt "$prior" ]] || break
        fi
        replaced=1
        prior=0
      done
      # The drain's envelopes, then its receipts section: the lane's
      # to-lane.cursor and the directives it holds.
      envelopes="$(awk 'NR == 1 { next } /^receipts / { exit } { print }' <<<"$MAIL_OUT")"
      receipts="$(awk 'found { print } /^receipts / { found = 1; print }' <<<"$MAIL_OUT")"
      header="${receipts%%$'\n'*}"
      [[ "$header" =~ ^receipts\ cursor=([0-9]+|missed)\ count=[0-9]+\ first=([A-Za-z0-9._-]*)$ ]] \
        || die mail-read-invalid "" "item=$item" "value=${header:-<empty>}"
      lane_read="${BASH_REMATCH[1]}"
      to_first="${BASH_REMATCH[2]}"
      # `<read> <unread>[:<passes>] <first>`: the cursor directive-read was
      # last reported up to, the last line reported directive-unread with the
      # passes since unread lines were last reported, and the id to-lane.jsonl
      # opened with. A lane with no row yet is taken as having read up to its
      # cursor, so a first pass does not replay every directive it ever read.
      # Only a mailbox opening with another envelope is a replacement, and
      # starts both counts over. A cursor lane-mail found `missed` holds the
      # item, one lower than the one reported its directive lines: a lane
      # relaunched onto an empty mailbox reads 0 there until a directive lands.
      if ! stored="$(lane_row_get directive "$state" "$cursor")"; then
        die state-read-failed "" "item=$item" "row=directive"
      fi
      read -r read_at unread_at seen <<<"$stored"
      unread_passes=0
      if [[ "$unread_at" == *:* ]]; then
        unread_passes="${unread_at#*:}"; unread_at="${unread_at%%:*}"
      fi
      if [[ "$lane_read" == missed ]]; then
        hold=item
      elif ! [[ "$read_at" =~ ^[0-9]+$ && "$unread_at" =~ ^[0-9]+$ && "$unread_passes" =~ ^[0-9]+$ ]]; then
        read_at="$lane_read"; unread_at=0; unread_passes=0
      elif [[ -n "$to_first" && -n "$seen" && "$to_first" != "$seen" ]]; then
        read_at=0; unread_at=0; unread_passes=0
      elif [[ "$lane_read" -lt "$read_at" ]]; then
        hold=directives
      fi
    fi
    # The drain drops answered asks by the to-lane.jsonl it read, so one that
    # missed would report an answered ask as a fresh question.
    if [[ "$hold" == item ]]; then
      state="$(lane_row_clear lane-failed "$state" "$item")"
      mail_row_commit "$state"
      continue
    fi
    while IFS= read -r line; do
      [[ -n "$line" ]] || continue
      if ! fields="$(jq -r "$MAILBOX_CLASS_JQ"' [.id // "", .kind // "", ((.options // []) | join(", ")), .from // "", .re // "", .by // "", overseer_mail_class] | @tsv' <<<"$line")"; then
        die mail-read-invalid "" "item=$item" "value=envelope"
      fi
      id="${fields%%$'\t'*}"
      rest="${fields#*$'\t'}"
      kind="${rest%%$'\t'*}"
      rest="${rest#*$'\t'}"
      options="${rest%%$'\t'*}"
      rest="${rest#*$'\t'}"
      from="${rest%%$'\t'*}"
      rest="${rest#*$'\t'}"
      re="${rest%%$'\t'*}"
      rest="${rest#*$'\t'}"
      by="${rest%%$'\t'*}"
      class="${rest#*$'\t'}"
      case "$item:$kind" in
        # The overseer's own mailbox, each line reported under the class
        # lib/mailbox-append.sh defines, which lane-mail judges a reply's --ref
        # by too. An answer or close names its ask, the one the overseer
        # is waiting on. A peer line carries its kind, because only an ask is
        # owed a reply and an answer to a directive would name an id in no
        # outbox; `re=` rides an answer, without which two replies from one
        # peer are told apart by their wording alone. A stray answer is
        # nobody's, so it is skipped rather than read back as a note.
        overseer:*)
          case "$class" in
            resolution) echo "EVENT owner-ask-resolved $re by=$by id=$id" ;;
            close) echo "EVENT owner-ask-closed $re by=$by" ;;
            owner-note) echo "EVENT owner-note $id" ;;
            peer) echo "EVENT peer-note ${from#overseer:} $id kind=$kind${re:+ re=$re}" ;;
            stray) continue ;;
            *) die mail-read-invalid "" "item=$item" "value=class=$class" ;;
          esac
          ;;
        *:ask) echo "EVENT lane-question $item $id" ;;
        # Only the lane writes this file, and it writes asks and notices; any
        # other kind is a line to show rather than a line to drop silently.
        *) echo "EVENT lane-notice $item $id" ;;
      esac
      if ! text="$(jq -r '.text // ""' <<<"$line")"; then
        die mail-read-invalid "" "item=$item" "value=text"
      fi
      # Every payload line is indented two spaces, so a message line spelling
      # `EVENT ...` never reads as a record: only the watch's own lines start
      # at the first column.
      [[ -z "$text" ]] || sed 's/^/  /' <<<"$text"
      # An ask's choices are the other half of the question; without this line
      # the overseer is asked to pick from a list it was never shown.
      [[ -z "$options" ]] || printf '  options: %s\n' "$options"
      PASS_EVENT=1
    done <<<"$envelopes"
    if [[ "$item" == overseer ]]; then
      if mail_read "$item" inbox "${args[@]}" --ack "$count"; then
        state="$(lane_row_clear lane-failed "$state" "$item")"
      else
        lane_failure_report "$item" "$state"
        state="$LANE_FAILURE_STATE"
      fi
      mail_row_commit "$state"
      continue
    fi
    # A read shorter than what was drained moves no position: lowering it
    # would report the lines between again once the file reads whole. Never
    # pruned, as pane-keyed rows are: an item out of --item for one run would
    # otherwise drain from zero and report every message that lane ever sent.
    [[ "$replaced" -eq 0 && "$count" -lt "$prior" ]] \
      || state="$(lane_row_set lane-mail "$state" "$cursor" "$count $first")"
    if [[ "$hold" == none ]]; then
      # A directive reported unread and still unread is reported again every
      # MARK_REPEAT full mail passes, the rhythm start-stalled keeps on long
      # passes; one mailbox's standing lines share the count, which any unread
      # line it reports starts over.
      unread_passes=$((unread_passes + 1))
      repeat=0
      (( unread_passes < MARK_REPEAT )) || repeat=1
      standing=0
      reported=0
      while read -r line id at; do
        [[ -n "$line" ]] || continue
        if [[ "$line" -le "$lane_read" ]]; then
          [[ "$line" -gt "$read_at" ]] || continue
          echo "EVENT directive-read $item $id"
          PASS_EVENT=1
        elif [[ -n "$at" ]] && (( PASS_NOW - at >= UNREAD_SECS )) \
          && [[ "$line" -gt "$unread_at" || "$repeat" -eq 1 ]]; then
          echo "EVENT directive-unread $item $id age=$((PASS_NOW - at))"
          [[ "$line" -le "$unread_at" ]] || unread_at="$line"
          reported=1
          PASS_EVENT=1
        elif [[ "$line" -le "$unread_at" ]]; then
          standing=1
        fi
      done <<<"$(tail -n +2 <<<"$receipts")"
      (( standing == 1 && reported == 0 )) || unread_passes=0
      state="$(lane_row_set directive "$state" "$cursor" "$lane_read $unread_at:$unread_passes ${to_first:-$seen}")"
    fi
    # Committed here, per item and after its lines are out: a later mailbox
    # can fail without discarding this read, and a row left uncommitted would
    # re-report this item's messages on the re-run that follows.
    state="$(lane_row_clear lane-failed "$state" "$item")"
    mail_row_commit "$state"
  done
}

# Every payload the watch prints off a pane goes through here: blank lines are
# dropped and at most WATCH_TAIL_LINES survive — the LAST ones, because a
# dialog, a limit banner and a lane's closing report are all drawn at the
# bottom of what the pane holds. `|| true`: an all-blank block is a grep miss,
# and under pipefail that would abort the script mid-event.
bounded_tail() { # BLOCK
  grep -v '^[[:space:]]*$' <<<"$1" | tail -n "$WATCH_TAIL_LINES" || true
}

# Lines kept ABOVE the banner in a usage-limit block. A lane quoting another
# lane's wall marks the quotation in a sentence written as often above the
# banner as beside it ("gh-9 is parked; its screen showed:"), and that
# sentence is the whole difference between a wall to act on and one to leave
# alone. Clamped below the cap by banner_payload, which keeps the banner in
# the block whatever the cap is set to.
WATCH_BANNER_LEAD=3

# The payload a walled lane's event carries: a WINDOW around the banner,
# never a one-sided run. BANNER is lane_limit_banner's answer over SLICE, so
# where the banner is has ONE owner and this looks for none of its own.
#
# The judge matches a banner anywhere in the slice, so a block capped from the
# bottom can trim it back out, and one opening on the banner drops the sentence
# above that says whose words it is, leaving the handling nothing to read. The
# window carries WATCH_BANNER_LEAD lines above the banner and the rest of the
# cap below, slides to whichever end of the slice it meets, and always holds
# the banner.
#
# Exit 1 is the judge and this disagreeing: an empty banner, or one this
# slice does not carry. Neither is a payload, and the caller refuses.
banner_payload() { # SLICE BANNER
  local first lines n at lead start end rc
  first="${2%%$'\n'*}"
  [[ -n "$first" ]] || return 1
  # Blanks go first, so the window counts the lines the overseer will read.
  rc=0; lines="$(grep -v '^[[:space:]]*$' <<<"$1")" || rc=$?
  [[ "$rc" -le 1 ]] || return "$rc"
  [[ -n "$lines" ]] || return 1
  # -xF: whole line, no pattern. The banner came out of this slice, so
  # re-spelling it as a regex here would be a second judge of where it is.
  rc=0; at="$(grep -nxF -- "$first" <<<"$lines")" || rc=$?
  [[ "$rc" -le 1 ]] || return "$rc"
  [[ -n "$at" ]] || return 1
  at="${at%%:*}"
  n="$(grep -c '' <<<"$lines")"
  # At most one line short of the cap, so the banner is never the line the
  # lead pushes out: a cap of 1 is the banner alone.
  lead="$WATCH_BANNER_LEAD"
  [[ "$lead" -lt "$WATCH_TAIL_LINES" ]] || lead=$((WATCH_TAIL_LINES - 1))
  start=$((at - lead))
  [[ "$start" -ge 1 ]] || start=1
  end=$((start + WATCH_TAIL_LINES - 1))
  # Run into the bottom and the window slides UP, spending the rest of the cap
  # on lines above the banner rather than emitting a short block.
  if [[ "$end" -gt "$n" ]]; then
    end="$n"
    start=$((end - WATCH_TAIL_LINES + 1))
    [[ "$start" -ge 1 ]] || start=1
  fi
  sed -n "${start},${end}p" <<<"$lines"
}

# A shell left in a worktree that has been removed draws these two lines on
# every prompt — the hook chain cannot run and nothing can resolve the cwd —
# so a lane that finished by deleting its own tree ends with a screen of them.
# They sit at the BOTTOM of the slice, where an unfiltered cap would keep them
# and drop the closing report, which is the one thing a lane-exited payload
# carries. That shell has the terminal back only once the harness under it is
# gone, so lane-exited is the only kind whose payload can hold them and the
# only one filtered. Anchored to the shapes that shell emits, so a report line
# merely QUOTING either is not touched: exited_noise supplies the two emitted
# shapes and exited_quotes_missing_path the quoted ones.
WATCH_NOISE_RE='^Hook failed:|^bash: cd: .*: No such file or directory'

# bounded_tail for the lane-exited payload, a lane's own closing report, with
# that prompt noise dropped first. A slice that is nothing but the noise
# prints one marker line instead of an empty block: an event with nothing
# under it would otherwise read as a lane that said nothing at all.
report_tail() { # BLOCK
  local lines kept count rc
  # Exit 1 is a grep miss, which is an answer: an all-blank block, or one the
  # filter emptied. Anything above it is the scan failing, which is no answer
  # at all — returned, so errexit stops the run rather than letting a failed
  # scan read as a lane with nothing to say.
  rc=0; lines="$(grep -v '^[[:space:]]*$' <<<"$1")" || rc=$?
  [[ "$rc" -le 1 ]] || return "$rc"
  [[ -n "$lines" ]] || return 0
  rc=0; kept="$(grep -Ev -- "$WATCH_NOISE_RE" <<<"$lines")" || rc=$?
  [[ "$rc" -le 1 ]] || return "$rc"
  if [[ -n "$kept" ]]; then
    tail -n "$WATCH_TAIL_LINES" <<<"$kept"
    return 0
  fi
  count="$(grep -c '' <<<"$lines")"
  printf 'payload-noise-only lines=%s\n' "$count"
}

# Said once per run, not per pass: the answer does not change under the watch.
# EXIT is the probe's status where another process ran it, as the overseer's
# `inspect` does; this run's own probe left it in LANE_PROBE_RC otherwise.
LANE_PROBE_NOTED=0
note_probe_unusable() { # LANE [EXIT]
  [[ "$LANE_PROBE_NOTED" -eq 0 ]] || return 0
  LANE_PROBE_NOTED=1
  ow_message child-probe-failed "lane=$1" "exit=${2:-$LANE_PROBE_RC}" >&2
}

# Drop KIND rows naming a lane this run does not watch. A row answers only for
# a lane under the watch; left to accumulate, one is a sighting nothing has
# looked at since, waiting for a window name to come back.
lane_row_prune() {
  local kind="$1" state="$2"
  shift 2
  # The lane list crosses in the environment, never through -v: it holds one
  # lane per line, and BWK awk — the awk macOS ships — refuses a -v value
  # carrying a newline outright ("awk: newline in string"), so every prune died
  # there and no lane event was ever emitted. ENVIRON takes the value whole.
  ow_lanes="$(printf '%s\n' "$@")" awk -F'\t' -v kind="$kind" '
    BEGIN { n = split(ENVIRON["ow_lanes"], a, "\n"); for (i = 1; i <= n; i++) watched[a[i]] = 1 }
    NF && !($1 == kind && !($2 in watched))
  ' <<<"$state"
}

# LANE_OBS columns are watch-list position, ready/gone, pane pid, current
# command, and server-plus-pane occurrence key. Capture bytes live in the file
# for that position. Position, not a filename slug, keeps arbitrary tmux window
# names from sharing one snapshot and classifying each other's screens.
LANE_OBS=""
LANE_TURNS=()
# wall_pause LANE SEEN_AT — the wall this watch first saw on LANE's pane at
# SEEN_AT, epoch, and sees no longer this pass, kept as {from, to, cause} in
# the `pauses` of the last lane record whose window LANE names, in the fleet
# state lane-close is handed: oversee-cycle reads a lane's walled time from
# there and nowhere else. The pass that sees the banner gone, replaced or its
# window gone is the wall's end, so the pause runs to that pass. A window no
# record names keeps nothing. A write that fails is said and the pass goes on,
# since the wall's history is not what the overseer acts on.
wall_pause() { # LANE SEEN_AT
  local errf="$WORK_DIR/wall-pause.err"
  [[ "$2" =~ ^[0-9]+$ && "$2" -lt "$PASS_NOW" ]] || return 0
  "$WORKFLOW_STATE" --state-dir "$FLEET_STATE_DIR" update oversee \
    --arg window "$1" --argjson from "$2" --argjson to "$PASS_NOW" \
    '([(.lanes // []) | to_entries[] | select(.value.window == $window) | .key] | last) as $i
     | if $i == null then . else .lanes[$i].pauses += [{from: ($from | todate), to: ($to | todate), cause: "walled"}] end' \
    >/dev/null 2>"$errf" || { ow_message wall-unrecorded "lane=$1" >&2; cat -- "$errf" >&2; }
}

lane_field() { awk -F'\t' -v i="$2" -v field="$3" '$1 == i { print $field }' <<<"$1"; }
lane_obs_state() { lane_field "$1" "$2" 2; }
lane_pane_file() { printf '%s/pane.%s' "$WORK_DIR" "$1"; }

# A Pi lane's rows (lib/session-rows.sh § session_rows_lane_verdict), read
# from its mailbox on this disk or through lane-host for a hosted lane: the
# verdict into LANE_ROWS[I] and the last row into the file lane_rows_file
# names, the verdict empty for a lane of any other harness, whose pane is
# judged. A read that failed is `unreadable`, never a lane with no row, and is
# noted on stderr.
LANE_ROWS=()
lane_rows_file() { printf '%s/rows.%s' "$WORK_DIR" "$1"; }
lane_rows_read() { # I LANE
  local entry item="" src rc=0
  LANE_ROWS[$1]=""
  for entry in ${PI_LANES[@]+"${PI_LANES[@]}"}; do
    [[ "${entry%%=*}" != "$2" ]] || item="${entry#*=}"
  done
  [[ -n "$item" ]] || return 0
  : >"$(lane_rows_file "$1")" || die pane-publish-failed "" "lane=$2"
  hosted_root "$item"
  if [[ -n "$HOSTED_ROOT" ]]; then
    src="$WORK_DIR/rows-src.$1"
    ORCH_LANE_HOST="$HOSTED_HOST" lane_host_fetch "$SCRIPT_DIR/lane-host" "$item" "$HOSTED_ROOT/tmp/lane-mail/$item/$SESSION_ROWS_LANE" \
      "$src" "$WORK_DIR/host.err" || rc=$?
  else
    local_root "$item"
    src="$LOCAL_ROOT/tmp/lane-mail/$item/$SESSION_ROWS_LANE"
    [[ -n "$LOCAL_ROOT" ]] || rc=2
  fi
  if [[ "$rc" -gt 1 ]] || ! session_rows_lane_verdict "$src"; then
    LANE_ROWS[$1]=unreadable
    ow_message lane-rows-unread "lane=$2" "item=$item" "exit=$rc" >&2
    return 0
  fi
  LANE_ROWS[$1]="$SESSION_ROWS_VERDICT"
  printf '%s\n' "$SESSION_ROW" >"$(lane_rows_file "$1")" || die pane-publish-failed "" "lane=$2"
}

# The text a lane's limit banner is looked for in, into LANE_BANNER_TEXT: a Pi
# lane's last row's own message, the error its turn ended on, and any other
# lane's pane below its last turn. One answer for the stamp observe_lanes
# writes and the event check_lanes prints, so the two read one wall.
LANE_BANNER_TEXT=""
lane_banner_text() { # I LANE PANE
  if [[ -n "${LANE_ROWS[$1]:-}" ]]; then
    LANE_BANNER_TEXT="$(jq -r '.message // ""' <"$(lane_rows_file "$1")")" || die limit-scan-failed "" "lane=$2"
  else
    LANE_BANNER_TEXT="$(pane_below_last_turn "$3")"
  fi
}

# Build one immutable lane snapshot for the pass. The final capture path is
# the success marker; a failed redirect leaves only a removed scratch file.
observe_lanes() {
  LANE_OBS=""
  LANE_TURNS=()
  LANE_ROWS=()
  # No early return for an empty fleet: the rows of the last lanes to leave
  # still end their walls and are pruned below.
  local lane kind target pane below key prefix prior obs pid cmd capture errf i=0 state="${PW_SEEN[0]}"
  local banner banner_rc reset_key seen_at seen_pane seen_reported seen_key
  for lane in ${LANES[@]+"${LANES[@]}"}; do
    i=$((i + 1))
    capture="$(lane_pane_file "$i")"
    rm -f "$capture" "$capture.$$.tmp"
    if ! lane_window_listed "$lane"; then
      LANE_OBS+="$i"$'\t'"gone"$'\t\t\t\n'
      state="$(lane_row_clear lane-asking "$state" "$lane")"
      if ! prior="$(lane_row_get usage-limit "$state" "$lane")"; then
        die state-read-failed "" "lane=$lane" "row=usage-limit"
      fi
      [[ -z "$prior" ]] || wall_pause "$lane" "${prior%%|*}"
      state="$(lane_row_clear usage-limit "$state" "$lane")"
      state="$(lane_row_clear model-capacity "$state" "$lane")"
      state="$(lane_row_clear lane-exited "$state" "$lane")"
      state="$(lane_row_clear lane-idle "$state" "$lane")"
      continue
    fi
    errf="$WORK_DIR/lane-probe.$i.err"
    target="$(lane_target "$lane")"
    obs="$(tmux display-message -p -t "$target" '#{pane_pid} #{pane_current_command}' 2>"$errf")" \
      || die pane-command-failed "$(cat "$errf")" "lane=$lane"
    [[ "$obs" =~ ^[0-9]+[[:blank:]]+[^[:space:]] ]] \
      || die pane-command-invalid "" "lane=$lane" "value=${obs:-<empty>}"
    key="$(tmux display-message -p -t "$target" '#{pid} #{pane_id}' 2>"$errf")" \
      || die pane-identity-failed "$(cat "$errf")" "lane=$lane"
    [[ "$key" =~ ^[0-9]+[[:blank:]]+%[^[:space:]]+$ ]] \
      || die pane-identity-invalid "" "lane=$lane" "value=${key:-<empty>}"
    # -J joins what tmux wrapped, as open-terminal already reads a pane:
    # without it a narrow window puts `resets ...` on a line of its own, which
    # is not a banner line, and the reset disappears with the pane's width.
    if ! tmux capture-pane -t "$target" -pJ >"$capture.$$.tmp" 2>"$errf"; then
      rm -f "$capture.$$.tmp"
      die pane-capture-failed "$(cat "$errf")" "lane=$lane"
    fi
    mv "$capture.$$.tmp" "$capture" || die pane-publish-failed "" "lane=$lane"
    pid="${obs%%[[:blank:]]*}"
    cmd="${obs#*[[:blank:]]}"
    LANE_OBS+="$i"$'\t'"ready"$'\t'"$pid"$'\t'"$cmd"$'\t'"$key"$'\n'
    lane_rows_read "$i" "$lane"
    pane="$(cat -- "$capture")"
    below="$(pane_below_last_turn "$pane")"
    prior="$(lane_row_get lane-asking "$state" "$lane")"
    prefix="${key}|$(pane_turn_identity "$pane")|"
    LANE_TURNS[$i]="${prefix}model-capacity"
    if ! grep -Eq -- "$LANE_ASKING_RE" <<<"$below" \
       || [[ -n "$prior" && "$prior" != "$prefix"* ]]; then
      state="$(lane_row_clear lane-asking "$state" "$lane")"
    fi
    # When this pass first sees a wall, stamp it: the row is what later lets a
    # dayless clause name a day. Stamped HERE, on every lane, rather than
    # where the event is emitted, because that path leaves on the first walled
    # lane and a second one would never be observed at all. Whether the banner
    # is a banner the lane has no turn in flight behind is lane_limit_banner's
    # one question, and both consumers ask it — which is as far as a screen
    # can settle it, so the event carries the slice the banner sits in and the
    # overseer confirms the account off that. A stamp answers for ONE wall on
    # ONE pane, so it carries the pane identity beside the wall and goes when
    # either changes. A banner naming no reset the grammar reads is stamped
    # too, with an empty reset key: the row is also where check_lanes records
    # that the wall was reported, and a wall with no row is one reported on
    # every run.
    lane_banner_text "$i" "$lane" "$pane"
    banner_rc=0
    banner="$(lane_limit_banner "$LANE_BANNER_TEXT")" || banner_rc=$?
    [[ "$banner_rc" -ne 2 ]] || die limit-scan-failed "" "lane=$lane"
    reset_key="$(usage_reset_key "$banner")"
    prior="$(lane_row_get usage-limit "$state" "$lane")"
    if [[ -n "$banner" ]]; then
      seen_at=""; seen_pane=""; seen_key=""
      [[ -z "$prior" ]] || IFS='|' read -r seen_at seen_pane seen_reported seen_key <<<"$prior"
      if [[ "$seen_pane" != "$key" || "$seen_key" != "$reset_key" ]]; then
        [[ -z "$prior" ]] || wall_pause "$lane" "$seen_at"
        state="$(lane_row_set usage-limit "$state" "$lane" "$PASS_NOW|$key||$reset_key")"
      fi
    else
      [[ -z "$prior" ]] || wall_pause "$lane" "${prior%%|*}"
      state="$(lane_row_clear usage-limit "$state" "$lane")"
    fi
  done
  # A wall on a window that left the fleet ends with it.
  while IFS=$'\t' read -r kind lane prior; do
    [[ "$kind" == usage-limit ]] && ! window_listed "$lane" || continue
    wall_pause "$lane" "${prior%%|*}"
  done <<<"$state"
  state="$(lane_row_prune usage-limit "$state" ${LANES[@]+"${LANES[@]}"})"
  state="$(lane_row_prune model-capacity "$state" ${LANES[@]+"${LANES[@]}"})"
  state="$(lane_row_prune lane-exited "$state" ${LANES[@]+"${LANES[@]}"})"
  state="$(lane_row_prune lane-idle "$state" ${LANES[@]+"${LANES[@]}"})"
  lane_row_commit "$state"
}

# ---------------------------------------------------------------------------
# The overseer's own pane.
#
# Every check above answers about a LANE. Nothing answered about the session
# reading them: an overseer whose harness ended left its lanes working, this
# watch printing into a log with no reader, and the fleet unattended until a
# person happened to look at the window. The pane is the one place a watch can
# see that from, and it already has it — $TMUX_PANE is the overseer's own pane,
# inherited from the shell the overseer started this watch in.
#
# The judge is lib/lane-state.sh's, the same one every lane goes through, so a
# dead overseer and a dead lane are read by one set of rungs.
# ---------------------------------------------------------------------------

# Set once a successor holds the window of the overseer this pass recovered,
# dead or walled: the pass then ends at exit 3 without running the checks
# below it, so the mail the successor is meant to drain is not drained here
# first.
OVERSEER_SUCCEEDED=0
# Initial launch plus one later retry. This internal ceiling prevents a pane
# read dead or walled from launching successors forever when the host cannot
# start one.
OVERSEER_RELAUNCH_ATTEMPTS=2
# Repeat mode stops on notice-only recovery, an exhausted retry, or a
# recovery the fleet has no account for. A direct single pass keeps its
# documented status 0 for those outcomes.
OVERSEER_STOP=0
# The launch line for this pass, as the fleet state holds it or as this pass
# recorded it.
OVERSEER_LINE=""
# Notes are per run, and a repeat-mode pass IS a run, so each reason is said
# once per pass rather than once per lane read — the same bound
# note_probe_unusable keeps.
OVERSEER_NOTED=""
overseer_note() { # REASON FIELD=VALUE...
  grep -qxF -- "$1" <<<"$OVERSEER_NOTED" && return 0
  OVERSEER_NOTED+=$'\n'"$1"
  ow_message "$@" >&2
}

# The two channels a pass's overseer notice reaches: the fleet log through
# lib/overseer-launch.sh § ol_fleet_log, and the overseer mailbox as a directive.
overseer_publish() { # NOTICE RECORD ERR_FILE
  local notice="$1" record="$2" errf="$3"
  ol_fleet_log "$notice" "$record" "$errf" "$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} \
    || overseer_note overseer-notice-failed "channel=fleet-log"
  "$LANE_MAIL" send --item overseer --directive --file "$notice" >/dev/null 2>"$errf" \
    || overseer_note overseer-notice-failed "channel=lane-mail"
}

# The notice every channel carries, written once into WORK_DIR: the fleet log
# reads it as the text of its record and the overseer mailbox as the body of an
# owner note, so the two cannot describe the case differently.
#
# KIND is `dead` or `walled`, the two cases check_overseer recovers from, and
# it decides three words and nothing else: the notice's own key, the reading
# that was taken, and how a relaunch describes where the successor's account
# came from. Every other plan reads the same for both, because the reason no
# successor opens is the same reason. RECORD is the fleet state's overseer
# record key, `<server> <pane>` or empty for none, and MINE 1 where that
# record names this session (overseer_record_read), which the key alone does
# not say: an earlier server handed the same pid and pane id left the same
# one. The no-line plan names which of the three shapes left it with no line.
overseer_deliver() { # KIND PANE WINDOW SUCCESSION PLAN RECORD MINE
  local kind="$1" notice="$WORK_DIR/overseer-$1.txt" record="$WORK_DIR/overseer-$1.json"
  local errf="$WORK_DIR/overseer-deliver.err" now plan_text reading relaunch_text
  now="$(from_epoch "$PASS_NOW" '%Y-%m-%dT%H:%M:%SZ')" || now=""
  if [[ "$kind" == walled ]]; then
    reading=walled
    relaunch_text='A successor is being launched into that window on an account the lane pick judged, never on the spent one.'
  else
    reading=exited
    [[ "$OV_SOURCE" != context ]] || reading='wedged at its context window'
    relaunch_text='A successor is being launched into that window from the recorded launch line.'
  fi
  case "$5" in
    relaunch) plan_text="$relaunch_text" ;;
    off) plan_text='ORCH_OVERSEER_SUCCESSION is off, so no successor is launched; start one by hand.' ;;
    no-line)
      if [[ -z "$6" ]]; then
        plan_text='The fleet state holds no overseer record, so no successor is launched; start one by hand.'
      elif [[ "$7" == 1 ]]; then
        plan_text='The fleet state record for this pane holds no launch line, so no successor is launched; start one by hand.'
      else
        plan_text="The fleet state record names another session, tmux server ${6%% *} pane ${6#* }, whose launch line is not replayed as this pane's, so no successor is launched; start one by hand."
      fi ;;
    no-launcher) plan_text='oversee-succeed is not installed, so no successor is launched; start one by hand.' ;;
    # Defensive: the four plans above are the whole set check_overseer calls
    # this with, for either case. A fifth would otherwise be described as one
    # of them, so it names itself rather than send a reason that is not the
    # one.
    *) plan_text="No successor is launched; the watch reported plan $5, which it has no wording for. Start one by hand." ;;
  esac
  printf 'overseer-%s: the overseer session in tmux window %s (pane %s) read %s on %s consecutive watch passes at %s, source=%s. %s\n' \
    "$kind" "$3" "$2" "$reading" "$DEAD_PASSES" "${now:-an unreadable clock}" "$OV_SOURCE" "$plan_text" > "$notice" \
    || { overseer_note overseer-notice-failed "channel=file"; return 0; }
  overseer_publish "$notice" "$record" "$errf"
}

# Exit 3 from the launcher is `lanes pick`'s own "no lane clears the bound",
# relayed by oversee-succeed: no account in the fleet has room for a
# successor. One notice on the two channels the recovery already uses, the row
# marked reported, and the repeat stops — the same ending notice-only recovery
# takes, because the bounded retry would walk the same accounts and refuse
# again.
#
# The account and the time it frees up are the account judgement's own fields,
# read off the one `--check-marks` line this pass already took and that
# confirmed the wall. Not derived from the banner: `lanes context` measured
# the headroom that confirmed it and names the bucket's own reset, so the
# figure the fleet waits on and the figure that established the wall are one
# reading. Either can be absent where that judgement named neither.
overseer_recovery_blocked() { # ROW ROWS IDENTITY PANE WINDOW
  local row="$1" rows="$2" identity="$3" pane="$4" window="$5"
  local notice="$WORK_DIR/overseer-blocked.txt" record="$WORK_DIR/overseer-blocked.json"
  local errf="$WORK_DIR/overseer-blocked.err"
  lane_row_commit "$(lane_row_set "$row" "$rows" "$identity" reported)"
  OVERSEER_STOP=1
  local account="" resets=""
  [[ "$OVERSEER_MARK_READ" -ne 1 ]] || { account="$OVERSEER_MARK_ACCOUNT"; resets="$OVERSEER_MARK_RESETS"; }
  local remedy="Start a fresh overseer by hand once an account qualifies."
  if [[ "$OV_SOURCE" == auth || ( "$OV_SOURCE" == rows && "$SESSION_ROWS_WALL_KIND" == auth ) ]]; then
    account="" resets=""
    remedy="The login failed and has no usage reset. Sign in to an account, then start a fresh overseer by hand."
  elif [[ -n "$account" && -n "$resets" ]]; then
    remedy="Account $account has a measured binding bucket reset at $resets. Start a fresh overseer by hand once an account has room."
  fi
  printf 'overseer-recovery-blocked: no account qualifies for a successor to the overseer in tmux window %s (pane %s). %s The repeat stops.\n' \
    "$window" "$pane" "$remedy" > "$notice" \
    || { overseer_note overseer-notice-failed "channel=file"; return 0; }
  overseer_publish "$notice" "$record" "$errf"
  ow_message overseer-recovery-blocked "pane=$pane" \
    "account=${account:-unknown}" "resets=${resets:-none}" >&2
}

overseer_relaunch_failed() { # ROW ROWS IDENTITY PANE WINDOW ATTEMPT STEP
  local row="$1" rows="$2" identity="$3" pane="$4" window="$5" attempt="$6" step="$7"
  local retry=exhausted notice="$WORK_DIR/overseer-relaunch-failed.txt"
  local record="$WORK_DIR/overseer-relaunch-failed.json" errf="$WORK_DIR/overseer-relaunch-failed.err"
  if (( attempt < OVERSEER_RELAUNCH_ATTEMPTS )); then
    retry=pending
    rows="$(lane_row_set "$row" "$rows" "$identity" "pending:$attempt")"
  else
    rows="$(lane_row_set "$row" "$rows" "$identity" reported)"
    OVERSEER_STOP=1
  fi
  lane_row_commit "$rows"
  printf 'overseer-relaunch-failed: successor launch for tmux window %s (pane %s) failed on attempt %s; retry=%s; step=%s.\n' \
    "$window" "$pane" "$attempt" "$retry" "$step" > "$notice" \
    || { overseer_note overseer-notice-failed "channel=file"; return 0; }
  overseer_publish "$notice" "$record" "$errf"
  ow_message overseer-relaunch-failed "pane=$pane" "attempt=$attempt" "retry=$retry" "step=$step" >&2
}

# The overseer's own marks, judged by `oversee-succeed --check-marks`. ONE
# reading per pass, parsed once here, and the answer's fields left in globals
# for the two arms that read them: overseer_mark_check reports a crossing off
# it, and the walled arm asks it whether this pane's own ACCOUNT is the thing
# that ran out. The judgement is not remade in either: that script decides
# where both marks sit, which account row is this session's and what a reading
# that could not be taken means, and a second copy here would let the watch
# wake an overseer the succession would then tell to keep running.
#
# Memoised FOR ONE PASS: both arms can ask inside it (a wall the account
# refutes falls through to the live arm), and the judgement reads every
# account the fleet can launch on, so two readings would pay twice and could
# disagree. overseer_marks_reset clears it where a judgement begins: the top
# of every long pass, and overseer_down before a mail pass judges a wall. A
# memo that outlived the pass would answer every later pass of the run with
# the first one's reading.
#
# OVERSEER_MARK_KEY is the answer's own key, `mark-reached`, `mark-unmeasured`
# or `below-mark` for the `account-below-mark` line; the KIND, VALUE,
# MARK, ACCOUNT and RESETS globals are its fields, empty where the line
# carries none. Exit 1 means no judgement was made at all, the note already
# said once, and nothing may be concluded from any of them.
OVERSEER_MARK_KEY=""
OVERSEER_MARK_KIND=""
OVERSEER_MARK_VALUE=""
OVERSEER_MARK_MARK=""
OVERSEER_MARK_SUCCESSION=on
OVERSEER_MARK_ACCOUNT=""
OVERSEER_MARK_RESETS=""
OVERSEER_MARK_READ=0
OVERSEER_MARK_RC=1
overseer_marks_reset() {
  OVERSEER_MARK_READ=0
  OVERSEER_MARK_RC=1
}

# bounded_account_read REASON ERR_FILE COMMAND... — one account reader of a
# pass: COMMAND runs under READ_CEILING with the usage age LANES_MAX_AGE names,
# its stdout lands in BOUNDED_OUT and its stderr in ERR_FILE, which the caller
# weighs. A failure or an overrun is noted once under REASON, naming the reader
# and its exit or the seconds it was given, and returns that status; with
# REASON empty nothing is noted, for a reader whose non-zero exit is an answer.
# Stock macOS ships no `timeout`, and without it the read runs unbounded: the
# pass then delays every other event it carries, which is the outcome this
# ceiling exists to bound and not one it can prevent there. The ceiling sends
# TERM alone, never KILL, which `lanes` relies on to finish a token renewal it
# has already posted.
BOUNDED_OUT=""
bounded_account_read() {
  local reason="$1" errf="$2" rc=0 BOUND_BY=()
  shift 2
  BOUNDED_OUT=""
  ! command -v timeout >/dev/null 2>&1 || BOUND_BY=(timeout "$READ_CEILING")
  BOUNDED_OUT="$(ORCH_LANES_USAGE_MAX_AGE="$LANES_MAX_AGE" ${BOUND_BY[@]+"${BOUND_BY[@]}"} "$@" 2>"$errf")" || rc=$?
  (( rc != 0 )) || return 0
  # An empty REASON is a caller weighing every status itself.
  [[ -n "$reason" ]] || return "$rc"
  if [[ "$rc" -eq 124 ]]; then
    overseer_note "$reason" "path=$1" "seconds=$READ_CEILING"
  else
    overseer_note "$reason" "path=$1" "exit=$rc"
  fi
  return "$rc"
}

overseer_marks_judge() {
  local line first field
  local errf="$WORK_DIR/overseer-mark.err"
  local judge_args=(--check-marks)
  [[ "$OVERSEER_MARK_READ" -eq 0 ]] || return "$OVERSEER_MARK_RC"
  OVERSEER_MARK_READ=1
  # Every field belongs to THIS reading. Cleared before the line is parsed,
  # never after it: an answer omitting `account` or `resets` would otherwise
  # leave an earlier pass's values standing, and overseer_recovery_blocked
  # would name an account this judgement did not.
  OVERSEER_MARK_KEY=""
  OVERSEER_MARK_KIND=""
  OVERSEER_MARK_VALUE=""
  OVERSEER_MARK_MARK=""
  OVERSEER_MARK_SUCCESSION=on
  OVERSEER_MARK_ACCOUNT=""
  OVERSEER_MARK_RESETS=""
  if [[ ! -x "$SUCCEED" ]]; then
    overseer_note overseer-mark-unjudged "path=$SUCCEED" "setting=OVERSEE_WATCH_SUCCEED"
    return 1
  fi
  # `lanes context` inside that judgement waits on a credentials lock and a
  # usage endpoint per account, and on a cache miss on the host-wide usage
  # refresh lock and a 429 retry's sleep and second request, which together can
  # outlast the pass interval.
  [[ -z "$OVERSEER_HARNESS" ]] || judge_args+=(--harness "$OVERSEER_HARNESS")
  if ! bounded_account_read overseer-mark-unjudged "$errf" "$SUCCEED" "${judge_args[@]}"; then
    [[ ! -s "$errf" ]] || cat -- "$errf" >&2
    return 1
  fi
  line="$BOUNDED_OUT"
  first="${line%%$'\n'*}"
  case "$first" in
    'oversee-succeed: mark-reached '*) OVERSEER_MARK_KEY=mark-reached ;;
    'oversee-succeed: mark-unmeasured '*) OVERSEER_MARK_KEY=mark-unmeasured ;;
    'oversee-succeed: account-below-mark '*) OVERSEER_MARK_KEY=below-mark ;;
    # A line this watch has no name for settles nothing, exactly as a run that
    # failed does: it is not a mark, and it is not evidence that one lifted.
    *) overseer_note overseer-mark-unjudged "path=$SUCCEED" "line=$first"; return 1 ;;
  esac
  for field in $first; do
    case "$field" in
      kind=*) OVERSEER_MARK_KIND="${field#kind=}" ;;
      value=*) OVERSEER_MARK_VALUE="${field#value=}" ;;
      mark=*) OVERSEER_MARK_MARK="${field#mark=}" ;;
      succession=*) OVERSEER_MARK_SUCCESSION="${field#succession=}" ;;
      account=*) OVERSEER_MARK_ACCOUNT="${field#account=}" ;;
      resets=*) OVERSEER_MARK_RESETS="${field#resets=}" ;;
    esac
  done
  OVERSEER_MARK_RC=0
  return 0
}

# Whether the screen's `walled` reading is the OVERSEER'S OWN account and not
# one it reported about a lane. The overseer's pane is the one pane in a fleet
# that routinely carries another lane's limit banner: this watch relays
# banner_payload into the overseer's transcript under every usage-limit event,
# and the overseer writes its own prose about that wall under it. The `walled`
# rung is a grep for the banner text below the last turn, so over this pane it
# cannot tell the two apart — and acting on it closes a window whose harness is
# alive.
#
# So the screen never decides alone: the wall is confirmed only by the
# judge's own `mark-reached kind=headroom`, by the account mark
# `oversee-succeed --help` owns, so no figure is compared here. Every other
# answer, a failed judgement included, leaves the pane read as the working
# overseer it looks like.
overseer_wall_confirmed() { # PANE
  overseer_marks_judge || { overseer_note overseer-wall-unjudged "pane=$1"; return 1; }
  [[ "$OVERSEER_MARK_KEY" == mark-reached && "$OVERSEER_MARK_KIND" == headroom ]] && return 0
  overseer_note overseer-wall-unconfirmed "pane=$1" "answer=$OVERSEER_MARK_KEY" \
    "kind=${OVERSEER_MARK_KIND:-none}"
  return 1
}

# The crossing reported off that one reading.
#
# Sets OVERSEER_MARK_ROWS to the baseline the caller commits. A standing mark is
# one row keyed by `<server> <pane>`, holding the kind and the passes since it
# was last reported: the first crossing is reported, then every MARK_REPEAT
# passes while it stands. Only a below-mark line clears that row. A judgement
# that could not be made, and one whose reading that script reports as
# unmeasured, both leave the row exactly as it was — an unread mark is never
# evidence that the mark lifted.
OVERSEER_MARK_ROWS=""
overseer_mark_check() { # ROWS IDENTITY PANE
  local rows="$1" identity="$2" pane="$3" prior passes preference
  local kind value mark succession
  # One overseer at a time, so a pane that was the overseer and is not any more
  # — a succession, a fleet restarted in another window — leaves no row behind
  # for a pane id tmux will hand out again.
  rows="$(lane_row_prune overseer-mark "$rows" "$identity")"
  OVERSEER_MARK_ROWS="$rows"
  overseer_marks_judge || return 0
  # A reading that could not be taken is that script's own `mark-unmeasured`,
  # and it settles nothing here: the row stands, so a standing mark keeps its
  # place in the repeat count instead of coming back as a fresh crossing on the
  # next pass that could measure.
  if [[ "$OVERSEER_MARK_KEY" == mark-unmeasured ]]; then
    overseer_note overseer-mark-unjudged "path=$SUCCEED" "kind=${OVERSEER_MARK_KIND:-none}"
    return 0
  fi
  # A below-mark line is the one answer that clears the row: both readings were
  # taken and neither fired, so the overseer has room again or has already
  # handed over into a pane this key no longer names.
  if [[ "$OVERSEER_MARK_KEY" != mark-reached ]]; then
    OVERSEER_MARK_ROWS="$(lane_row_clear overseer-mark "$rows" "$identity")"
    return 0
  fi
  kind="$OVERSEER_MARK_KIND"; value="$OVERSEER_MARK_VALUE"
  mark="$OVERSEER_MARK_MARK"; succession="$OVERSEER_MARK_SUCCESSION"
  # A mark-reached line missing one of its three fields is a judgement this
  # watch cannot report, and reporting it half-formed would send the overseer
  # to a succession over a figure nothing named. The row stands, as it does for
  # a reading that failed outright.
  if [[ -z "$kind" || -z "$value" || -z "$mark" ]]; then
    overseer_note overseer-mark-unjudged "path=$SUCCEED" "kind=${kind:-none}"
    return 0
  fi
  # A row read that failed settles nothing either, for the reason the arm above
  # gives: it is not a mark, and it is not evidence that one lifted.
  if ! prior="$(lane_row_get overseer-mark "$rows" "$identity")"; then
    overseer_note overseer-mark-unjudged "path=$SUCCEED" "row=overseer-mark"
    return 0
  fi
  passes=0
  if [[ "$prior" == "$kind|"* ]]; then
    passes=$(( ${prior#*|} + 1 ))
    (( passes < MARK_REPEAT )) || passes=0
  fi
  if (( passes == 0 )); then
    echo "EVENT overseer-mark $pane kind=$kind value=$value mark=$mark succession=$succession"
    if [[ "$succession" == off ]]; then
      echo "ORCH_OVERSEER_SUCCESSION is off, so no successor opens: rewrite the overseer handoff file and ask the user to start a fresh overseer session."
    else
      preference="$(ol_preference)"
      echo "Run $SUCCEED -- [FLAGS] at the next safe point, with ORCH_OVERSEER_PREFERENCE=${preference:-empty} choosing the successor lane."
    fi
    PASS_EVENT=1
  fi
  OVERSEER_MARK_ROWS="$(lane_row_set overseer-mark "$rows" "$identity" "$kind|$passes")"
}

# The overseer's context record, context.json in the overseer mailbox, as its
# lane-mail-check hook last wrote it at a turn end or a tool call
# (lib/lane-context.sh § lane_context_record), where it is THIS session's:
# into LANE_CTX_* (lane_context_record_fields), with OVERSEER_CTX_FILE the
# record and OVERSEER_CTX_ROWS the pane's rows file. A record another session
# wrote, a predecessor's until this one's first reading, says nothing of this
# one: one naming another pane, a harness other than the one the fleet record
# names for this pane (check_overseer's OVERSEER_RECORD_HARNESS), or a session
# other than the one the pane's latest SessionStart row names, a Copilot
# overseer's included, whose session-start-row hook writes that row too.
# Returns 0 where the record is this session's, 1 otherwise: no record,
# another session's, or one or its rows that cannot be read, which is noted
# and settles nothing. Reads the state overseer_pane_read left.
OVERSEER_CTX_FILE=""
OVERSEER_CTX_ROWS=""
overseer_context_own() { # PANE IDENTITY
  local pane="$1" identity="$2" record started
  OVERSEER_CTX_FILE="$(lane_context_overseer_box "$PROJECT_ROOT")/$LANE_CONTEXT_RECORD"
  OVERSEER_CTX_ROWS="$(session_rows_overseer_file "$PROJECT_ROOT" "${identity%% *}" "$pane")"
  [[ -e "$OVERSEER_CTX_FILE" ]] || return 1
  if ! record="$(cat -- "$OVERSEER_CTX_FILE" 2>/dev/null)" || ! lane_context_record_fields "$record"; then
    overseer_note overseer-context-unread "path=$OVERSEER_CTX_FILE"
    return 1
  fi
  [[ "$LANE_CTX_PANE_KEY" == "$identity" ]] || return 1
  [[ -z "$OVERSEER_RECORD_HARNESS" || "$LANE_CTX_HARNESS" == "$OVERSEER_RECORD_HARNESS" ]] || return 1
  if ! session_rows_last "$OVERSEER_CTX_ROWS" SessionStart || ! started="$(jq -r '.session_id // ""' <<<"${SESSION_ROW:-null}")"; then
    overseer_note overseer-context-unread "path=$OVERSEER_CTX_ROWS"
    return 1
  fi
  [[ -z "$started" || -z "$LANE_CTX_SESSION" || "$started" == "$LANE_CTX_SESSION" ]] || return 1
}

# The epoch of the last Stop row in OVERSEER_CTX_ROWS into OVERSEER_CTX_STOP,
# 0 for none, and the record's own `at` into OVERSEER_CTX_AT: the two
# instants the stale and the wedged judgements compare, since the hook writes
# a Stop row at every overseer turn end (lib/session-rows.sh) and the record
# beside it. Returns 1 where either cannot be read, noted.
OVERSEER_CTX_AT=0
OVERSEER_CTX_STOP=0
overseer_context_times() {
  if ! OVERSEER_CTX_AT="$(to_epoch "$LANE_CTX_AT")"; then
    overseer_note overseer-context-unread "path=$OVERSEER_CTX_FILE" "at=${LANE_CTX_AT:-none}"
    return 1
  fi
  if ! session_rows_last "$OVERSEER_CTX_ROWS" Stop \
     || ! OVERSEER_CTX_STOP="$(jq -r '.at // 0' <<<"${SESSION_ROW:-null}")"; then
    overseer_note overseer-context-unread "path=$OVERSEER_CTX_ROWS"
    return 1
  fi
}

# That record, judged each long pass a working overseer is read, so a record
# that stopped advancing, or advances with no reading, reaches someone instead
# of passing for a context mark that is watching (who judges that mark:
# ../references/oversee-events.md § Judgement rules).
#
# A gap, the reason the hook took no reading, is `overseer-context-unmeasured`
# on the first long pass it stands, told to the overseer; still standing on
# the next, it goes to the owner instead, through overseer_gap_alert, on each
# pass until the owner's notice is sent, and after that neither is said again
# while that gap stands: a gap the overseer did not
# close is one it is not acting on, and repeating the event to it is what
# left a fleet unwatched. The `overseer-context-gap` row carries that count
# under this pane's key, `<gap>|told` then `<gap>|alerted`, in
# OVERSEER_MARK_ROWS, which the caller commits; a reading clears it, and a
# different gap starts it again.
#
# `overseer-context-stale` where the record's `at` is more than
# OVERSEER_CONTEXT_STALE_SECS old and a Stop row came after it: the hook ran
# and the record did not follow; a session with no Stop row after the record
# gets no stale judgement. It goes out on every long pass it stands.
OVERSEER_CONTEXT_STALE_SECS=3600
overseer_context_check() { # PANE IDENTITY
  local pane="$1" identity="$2" age at row_at
  overseer_context_own "$pane" "$identity" || return 0
  if [[ -n "$LANE_CTX_GAP" ]]; then
    overseer_context_gap "$pane" "$identity" "$LANE_CTX_GAP"
    return 0
  fi
  OVERSEER_MARK_ROWS="$(lane_row_clear overseer-context-gap "$OVERSEER_MARK_ROWS" "$identity")"
  overseer_context_times || return 0
  at="$OVERSEER_CTX_AT" row_at="$OVERSEER_CTX_STOP"
  age=$((PASS_NOW - at))
  (( age > OVERSEER_CONTEXT_STALE_SECS )) || return 0
  (( row_at > at )) || return 0
  echo "EVENT overseer-context-stale $pane age=$age"
  PASS_EVENT=1
}

# One standing gap's turn: the event on its first pass, the owner's alert on
# its second, nothing after. An alert the owner did not get leaves the row
# at `told`, so the next pass sends it again. GAP is the record's word.
overseer_context_gap() { # PANE IDENTITY GAP
  local pane="$1" identity="$2" gap="$3" prior
  prior="$(lane_row_get overseer-context-gap "$OVERSEER_MARK_ROWS" "$identity")"
  case "$prior" in
    "$gap|alerted") ;;
    "$gap|told")
      overseer_gap_alert "$pane" "$gap" || return 0
      OVERSEER_MARK_ROWS="$(lane_row_set overseer-context-gap "$OVERSEER_MARK_ROWS" "$identity" "$gap|alerted")" ;;
    *)
      echo "EVENT overseer-context-unmeasured $pane gap=$gap"
      PASS_EVENT=1
      OVERSEER_MARK_ROWS="$(lane_row_set overseer-context-gap "$OVERSEER_MARK_ROWS" "$identity" "$gap|told")" ;;
  esac
}

# The owner's alert for a gap that stood two long passes: one notice to the
# owner through the overseer mailbox (`lane-mail notice --to owner`, which the
# owner relay carries out), then one `close` row in the fleet log, so a
# successor reads it too. Returns 0 once the owner's notice is sent, with the
# stderr line saying so, and also once lane-mail refuses it as
# `owner-notice-repeated`: a gap reopened within the day writes the same
# words, which the owner already holds. Returns 1 where it is not sent, noted,
# with no fleet-log row, so the retry the caller makes writes one row and not
# one per failed pass. A fleet-log row that fails is noted and the alert still
# stands as sent.
overseer_gap_alert() { # PANE GAP
  local notice="$WORK_DIR/overseer-context-gap.txt" record="$WORK_DIR/overseer-context-gap.json"
  local errf="$WORK_DIR/overseer-context-gap.err" refusal
  printf 'overseer-context-unmeasured: the overseer in pane %s has recorded no context reading on two consecutive watch passes, gap=%s, so nothing judges its context mark and it can run into its context window with no handoff. The remedy for this gap is under overseer-context-unmeasured in the orch skill'"'"'s references/overseer-session-events.md.\n' \
    "$1" "$2" > "$notice" || { overseer_note overseer-notice-failed "channel=file"; return 1; }
  if ! "$LANE_MAIL" notice --item overseer --to owner --file "$notice" >/dev/null 2>"$errf"; then
    IFS= read -r refusal <"$errf" || refusal=""
    case "$refusal" in
      "lane-mail: owner-notice-repeated="*) ;;
      *) overseer_note overseer-notice-failed "channel=owner"; return 1 ;;
    esac
  fi
  ol_fleet_log "$notice" "$record" "$errf" "$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} \
    || overseer_note overseer-notice-failed "channel=fleet-log"
  ow_message overseer-context-alerted "pane=$1" "gap=$2" >&2
}

# Whether the overseer's harness is up and can take no turn because its
# context fills its window: its own context record is a reading that fills
# its window, by lib/lane-context.sh § lane_context_window_full, which says
# for which harnesses a recorded window is the hard limit (claude, codex and
# pi, never copilot, whose window is its compaction point), with no Stop row
# after it, so no turn has ended since the reading. A harness in that state
# keeps its process and writes no row but a failed turn's, which a death
# judgement reading the process and the rows never sees, and the fleet runs
# unattended until someone finds the pane. A StopFailure row naming a
# prompt-too-long error is the harness's own word for the same state and is
# read in overseer_pane_read (session_rows_verdict's `wedged`); this reads
# the record. A reading the judge cannot take is noted and settles nothing.
# Returns 0 for a wedge.
overseer_context_wedged() { # PANE IDENTITY
  local rc=0
  overseer_context_own "$1" "$2" || return 1
  [[ -z "$LANE_CTX_GAP" ]] || return 1
  lane_context_window_full "$LANE_CTX_TOKENS" "$LANE_CTX_WINDOW" "$LANE_CTX_HARNESS" || rc=$?
  case "$rc" in
    0) ;;
    1) return 1 ;;
    *)
      overseer_note overseer-context-unread "path=$OVERSEER_CTX_FILE" "harness=${LANE_CTX_HARNESS:-none}"
      return 1 ;;
  esac
  overseer_context_times || return 1
  (( OVERSEER_CTX_STOP <= OVERSEER_CTX_AT ))
}

# The overseer's own session as one reading: OV_WINDOW, OV_IDENTITY (`<server>
# <pane>`, the key its rows are kept under), OV_START (its server's start,
# which the record is judged against), OV_STATE, the word the shared
# judge would give it, and OV_SOURCE, what settled that word. The long pass
# reads it before its checks and the mail pass before it takes any mail, so
# both read one session the one way. A pane that cannot be read is noted once
# and returns 1: its state settles nothing.
#
# An exit status `overseer-run` wrote into the record, over a pane whose
# process is a bare shell with nothing but shells under it, settles it first, as
# `exited`, OV_SOURCE `record`. The harness's own rows settle it next
# (lib/session-rows.sh), OV_SOURCE `rows`: a SessionEnd for any reason but
# `clear` or `resume` is `exited` only over a pane whose process is a bare
# shell with nothing but shells under it, and live over a running process; a usage-limit
# StopFailure is `walled` whatever the screen shows, and overseer_judge holds
# it to the account judgement; a StopFailure naming a prompt-too-long error
# is `exited`, OV_SOURCE `context`, the harness up and its window full
# (session_rows_verdict's `wedged`). A session its rows call live is still `exited` when
# the pane's process is a bare shell with nothing but shells under it, which a harness
# killed before its SessionEnd hook ran leaves, OV_SOURCE `process`: a process
# fact, read as lib/lane-state.sh's own rung reads it, never the screen.
#
# THE NAMED FALLBACK: where the rows cannot judge, because the record names no
# rows file for this pane, the file holds no row yet, its last row names a
# harness the verdict skips or is a Pi row that is neither a SessionEnd nor a
# StopFailure with a `message` (session_rows_verdict), or it cannot be read,
# the pane's `inspect` state, lib/lane-state.sh's rungs over its capture,
# stands, OV_SOURCE `pane`, and the pass says so once under overseer-fallback
# with the cause. OV_SCREEN holds that capture, else empty.
OV_WINDOW=""
OV_IDENTITY=""
OV_START=""
OV_SCREEN=""
OV_STATE=""
OV_SOURCE=""
overseer_pane_read() { # PANE
  local pane="$1" server rows cause exit_status bare=0
  local errf="$WORK_DIR/overseer.err"
  OV_SCREEN=""
  # The session is read through the runtime's `inspect` alone
  # (lib/overseer-launch.sh § ol_session_inspect), the one read its launchers
  # take of it: its window, its server and the process fact every rung below
  # rests on, `exited` being a bare shell with nothing but shells under it.
  if ! DEP_ERR="$errf" ol_session_inspect "$pane"; then
    overseer_note overseer-unreadable "pane=$pane" "field=inspect"
    return 1
  fi
  [[ "$OL_INSPECT_STATE" != gone ]] \
    || { overseer_note overseer-unreadable "pane=$pane" "field=session" "state=gone"; return 1; }
  [[ "$OL_INSPECT_SERVER" =~ ^[0-9]+$ && "$OL_INSPECT_WINDOW" =~ ^@[0-9]+$ ]] \
    || { overseer_note overseer-unreadable "pane=$pane" "field=identity" "value=${OL_INSPECT_LINE:-<empty>}"; return 1; }
  OV_WINDOW="$OL_INSPECT_WINDOW"
  server="$OL_INSPECT_SERVER"
  OV_IDENTITY="$server $pane"
  # Unread, the start would read this pane's own record as another session's,
  # and a death judged on it is reported with no line to relaunch.
  OV_START="$(ol_session_start "$server" "$pane")" \
    || { overseer_note overseer-unreadable "pane=$pane" "field=server-start"; return 1; }
  [[ "$OL_INSPECT_STATE" != exited ]] || bare=1
  # Login failure is this harness's wall even with a last successful row or
  # room on its account. The shared judge supplies the failure classification.
  if [[ "$OL_INSPECT_STATE" == walled ]] \
    && [[ "$OL_INSPECT_WALL_KIND" == auth ]]; then
    OV_STATE=walled OV_SOURCE=auth OV_SCREEN="$OL_DETAIL"
    return 0
  fi
  [[ ",$OL_INSPECT_CAUSE," != *,process-probe,* ]] || note_probe_unusable "$pane" "$OL_INSPECT_PROBE"
  # The rows file and the exit status the record holds for THIS pane on THIS
  # server, by `ol_names`, and neither for a record naming another session:
  # that one's, an earlier server's handed the same pid and pane among them,
  # are not this pane's. An exit status is `overseer-run`'s, written once the
  # launch line returned (lib/overseer-launch.sh § ol_record_exit), and it
  # settles the session, `source=record`, only over the state that return
  # leaves: a bare shell with nothing but shells under it. A harness the person started
  # again in the same pane is a child of that shell, and the status is an
  # earlier session's.
  cause=unrecorded exit_status=""
  if ! rows="$("$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} get oversee \
    "$OL_JQ_DEFS if .overseer | ol_names(\"$server\"; \"$OV_START\"; \"$pane\")
     then \"\\(.overseer.exit.status // \"\")\\t\\(.overseer.session_rows // \"\")\" else \"\" end" 2>"$errf")"; then
    cause=state-unreadable rows=""
  fi
  if [[ "$rows" == *$'\t'* ]]; then exit_status="${rows%%$'\t'*}" rows="${rows#*$'\t'}"; fi
  if [[ -n "$exit_status" ]] && (( bare )); then OV_STATE=exited; OV_SOURCE=record; return 0; fi
  if [[ -n "$rows" ]]; then
    cause=unreadable
    if session_rows_verdict "$rows"; then cause="$SESSION_ROWS_VERDICT"; fi
  fi
  # A SessionEnd settles the session only over the bare shell its harness's
  # exit leaves, the fact the recorded-exit rung reads: over a live harness it
  # says nothing about the session running now.
  [[ "$cause" != ended ]] || (( bare )) || cause=live
  case "$cause" in
    ended) OV_STATE=exited; OV_SOURCE=rows; return 0 ;;
    walled) OV_STATE=walled; OV_SOURCE=rows; return 0 ;;
    # A harness whose every turn fails on its prompt's length takes no turn
    # again: it reads no mail, answers no event and cannot hand itself over,
    # the unattended fleet a death leaves, with its process still up. Only a
    # relaunch ends it, so it is read as the death it is in effect.
    wedged)
      OV_STATE=exited; OV_SOURCE=context
      (( ! bare )) || OV_SOURCE=process
      return 0 ;;
    live)
      OV_STATE=working; OV_SOURCE=rows
      (( ! bare )) || { OV_STATE=exited; OV_SOURCE=process; }
      return 0 ;;
    none | unsupported | unrecorded | unreadable | state-unreadable) ;;
  esac
  overseer_note overseer-fallback "pane=$pane" "cause=$cause"
  OV_SOURCE=pane
  # The state `inspect` judged off the screen is lib/lane-state.sh's word for
  # the pane; its sixth argument is empty for the reason check_lanes gives:
  # this watch's vantage point is the pane, and a screen the pane rungs cannot
  # settle is `unjudged`, never `exited`.
  [[ ",$OL_INSPECT_CAUSE," != *,limit-scan,* ]] \
    || { overseer_note overseer-unreadable "pane=$pane" "scan=usage-limit"; return 1; }
  OV_STATE="$OL_INSPECT_STATE"
  OV_SCREEN="$OL_DETAIL"
}

# The overseer's verdict from the reading overseer_pane_read left, as
# OV_VERDICT: the one answer the long pass acts on and the mail pass gates on.
# `exited` is the harness gone; `walled` is the account spent under a harness
# still running, which takes no turn, so it answers no lane, reads no mail and
# cannot hand itself over — the same unattended fleet a death leaves, reached
# by the other road. A wall the rows record is the harness's own word about its
# own session, and nothing but a finished turn writes the row that lifts it,
# so the first turn after the reset would read walled for its whole length:
# the account judgement refutes it, and it stands unless that judgement
# measures the account below its mark, room. A wall read off the screen, the
# fallback, is not enough on its own: overseer_wall_confirmed says why, and
# asks the same judgement to confirm it; one it refutes, or one no judgement
# could be made on, is `live`, as is every other reading: nothing here holds
# an overseer that may be working.
OV_VERDICT=live
overseer_judge() { # PANE
  OV_VERDICT=live
  case "$OV_STATE" in
    exited) OV_VERDICT=exited ;;
    walled)
      if [[ "$OV_SOURCE" == auth || ( "$OV_SOURCE" == rows && "$SESSION_ROWS_WALL_KIND" == auth ) ]]; then
        OV_VERDICT=walled
      elif [[ "$OV_SOURCE" == rows ]]; then
        if ! overseer_marks_judge || [[ "$OVERSEER_MARK_KEY" != below-mark ]]; then OV_VERDICT=walled
        else overseer_note overseer-wall-lifted "pane=$1"; fi
      elif overseer_wall_confirmed "$1"; then OV_VERDICT=walled; fi ;;
    *) ;;
  esac
}

check_overseer() {
  local pane="${TMUX_PANE:-}" window screen prior count succession plan
  local record record_mine record_field identity rows attempt completed passes=""
  local ov_case row other succeed_rc below banner banner_rc
  local errf="$WORK_DIR/overseer.err"
  # Off tmux there is no overseer pane to read, and with no workflow-state
  # there is nowhere to record one: either way an overseer that dies is
  # reported by nothing, which is said rather than left silent.
  [[ -n "${TMUX:-}" && -n "$pane" ]] \
    || { overseer_note overseer-unwatched "var=TMUX_PANE"; return 0; }
  [[ -x "$WORKFLOW_STATE" ]] \
    || { overseer_note overseer-unwatched "path=$WORKFLOW_STATE" "setting=OVERSEE_WATCH_WORKFLOW_STATE"; return 0; }

  overseer_pane_read "$pane" || return 0
  window="$OV_WINDOW"
  identity="$OV_IDENTITY"
  screen="$OV_SCREEN"
  # The watch invocation recorded this current session's command before its
  # first pass. Once the pane is dead, that last live-owned record is the only
  # source that still knows its account, model and permission flags. A
  # succession's pending successor command comes first where one stands: it
  # is the launch the fleet last chose, written before its window opened
  # (lib/overseer-launch.sh § ol_record_pending), and this relaunch replays a
  # choice rather than judging the dead session.
  #
  # Only where the record names THIS pane on THIS server, by the same
  # `ol_names` the watch start applies before it keeps a record's launch
  # identity: a start whose record failed left the record as it stood, and a
  # record naming another pane is another session's line, with that
  # session's account and permission words, which a death here must not
  # replay. The reader is lib/watch-overseer-record.sh's, the one the start
  # names its `held=` line with, and it answers the record's own key too, so
  # a death no line is replayed for can say which record stood in the way.
  overseer_record_read "${identity%% *}" "$OV_START" "$pane" 2>"$errf" \
    || { overseer_note overseer-unwatched "state=oversee"; return 0; }
  OVERSEER_LINE="$OVERSEER_RECORD_LINE"
  record="$OVERSEER_RECORD_KEY"
  record_mine="$OVERSEER_RECORD_MINE"

  overseer_judge "$pane"
  # An account mark reached at value 0 is a wall whether or
  # not the harness has met it yet: its next turn fails, and a walled session
  # hands nothing over, so the succession runs from here, `source=account`.
  # The judgement is the pass's one memoised reading, which the live arm's
  # mark check reads too.
  if [[ "$OV_VERDICT" == live ]] && overseer_marks_judge \
     && [[ "$OVERSEER_MARK_KEY" == mark-reached && "$OVERSEER_MARK_KIND" == headroom \
           && "$OVERSEER_MARK_VALUE" == 0 ]]; then
    OV_VERDICT=walled OV_SOURCE=account
  fi
  # A harness whose recorded context fills its window takes no turn again, and
  # nothing but a relaunch ends that: read as dead, `source=context`, on the
  # same count of passes a death takes, so one reading caught between a turn's
  # reading and its failure never relaunches a session.
  if [[ "$OV_VERDICT" == live ]] && overseer_context_wedged "$pane" "$identity"; then
    OV_VERDICT=exited OV_SOURCE=context
  fi
  ov_case=""
  case "$OV_VERDICT" in
    exited) ov_case=dead ;;
    walled) ov_case=walled ;;
    live) ;;
  esac
  # One row per case, keyed by server plus pane: `<count>` while readings
  # accumulate, `pending:N` after a failed launch, and `reported` after
  # notice-only or the bounded recovery attempts are spent.
  rows="$(lane_row_prune overseer-dead "${PW_SEEN[0]}" "$identity")"
  rows="$(lane_row_prune overseer-walled "$rows" "$identity")"
  rows="$(lane_row_prune overseer-context-gap "$rows" "$identity")"
  if [[ -z "$ov_case" ]]; then
    rows="$(lane_row_clear overseer-dead "$rows" "$identity")"
    rows="$(lane_row_clear overseer-walled "$rows" "$identity")"
    # A working overseer is the only one with marks to judge: neither a dead
    # nor a walled one runs a turn, so its context and its account settle
    # nothing and its case is the event the branch below carries.
    overseer_mark_check "$rows" "$identity" "$pane"
    overseer_context_check "$pane" "$identity"
    lane_row_commit "$OVERSEER_MARK_ROWS"
    return 0
  fi
  case "$ov_case" in
    dead) row=overseer-dead; other=overseer-walled ;;
    *) row=overseer-walled; other=overseer-dead ;;
  esac
  # The other case's row goes with it: a pane that read walled and then exited
  # is one session recovered from one case, and a count carried across the two
  # would fire a death on a threshold a wall ran up.
  rows="$(lane_row_clear "$other" "$rows" "$identity")"
  # A standing mark belongs to the session that reached it, and that session is
  # the one just read dead or walled. `overseer_mark_check` is the only place a
  # mark row is cleared and this path never runs it, so without this the row is
  # committed back on every such pass: a replacement in this same pane would
  # then read the old session's repeat count and wait out its remainder before
  # its own first crossing is reported.
  rows="$(lane_row_clear overseer-mark "$rows" "$identity")"
  rows="$(lane_row_clear overseer-context-gap "$rows" "$identity")"
  if ! prior="$(lane_row_get "$row" "$rows" "$identity")"; then
    die state-read-failed "" "pane=$pane" "row=$row"
  fi
  if [[ "$prior" == reported ]]; then
    OVERSEER_STOP=1
    lane_row_commit "$rows"
    return 1
  fi
  if [[ "$prior" =~ ^pending:([0-9]+)$ ]]; then
    completed="${BASH_REMATCH[1]}"
    attempt=$((completed + 1))
    (( attempt <= OVERSEER_RELAUNCH_ATTEMPTS )) \
      || { lane_row_commit "$(lane_row_set "$row" "$rows" "$identity" reported)"; return 1; }
  else
    [[ -z "$prior" || "$prior" =~ ^[0-9]+$ ]] \
      || die state-read-failed "" "pane=$pane" "row=$row" "value=$prior"
    count=1
    [[ -z "$prior" ]] || count=$((prior + 1))
    # A wall the harness's own row or the account's zero states needs no
    # second reading: it is not a screen caught between frames, and each pass
    # it waits is a pass the fleet runs unattended.
    passes="$DEAD_PASSES"
    [[ "$ov_case" != walled || "$OV_SOURCE" == pane ]] || passes=1
    if (( count < passes )); then
      lane_row_commit "$(lane_row_set "$row" "$rows" "$identity" "$count")"
      return 1
    fi
    attempt=1
  fi
  succession=on
  [[ "${ORCH_OVERSEER_SUCCESSION:-on}" != off ]] || succession=off
  plan=relaunch
  if [[ "$succession" == off ]]; then plan=off
  elif [[ ! -x "$SUCCEED" ]]; then plan=no-launcher
  # The recorded line is the dead case's whole choice of successor. The walled
  # case picks its own lane and builds its own line, so a fleet state with none
  # recorded does not stop it.
  elif [[ "$ov_case" == dead && -z "$OVERSEER_LINE" ]]; then plan=no-line
  fi
  # The record a no-line death was judged against, on the event and in the
  # notice: the fleet state holding no record, this pane's record holding no
  # line, and another session's record standing where this pane's should be
  # are three different remedies, and a reader of the death line alone, with
  # no start-time notice beside it, could not tell them apart.
  record_field=""
  if [[ "$plan" == no-line ]]; then
    if [[ -z "$record" ]]; then record_field=" record=none"
    else record_field=" record=${record%% *}:${record#* }"
    fi
  fi
  if [[ "$prior" != pending:* ]]; then
    if [[ "$plan" == relaunch ]]; then
      lane_row_commit "$(lane_row_set "$row" "$rows" "$identity" pending:0)"
    else
      lane_row_commit "$(lane_row_set "$row" "$rows" "$identity" reported)"
    fi
    echo "EVENT $row $pane window=$window passes=${passes:-$DEAD_PASSES} succession=$succession source=$OV_SOURCE$record_field"
    # The wall's own words under the line, as every lane usage-limit event
    # carries them. A rows wall carries the harness's own message, the limit
    # and its reset, or `message=unrecorded` where its row holds none. A screen wall carries the banner with the screen on both
    # sides of it, asked of the same judge over the same slice the `walled`
    # rung read, so the two cannot disagree; a disagreement stops the pass
    # under the reasons check_lanes gives them.
    if [[ "$ov_case" == walled && "$OV_SOURCE" == rows ]]; then
      jq -r '.message // "message=unrecorded"' <<<"$SESSION_ROW" || die limit-banner-missing "" "pane=$pane"
    elif [[ "$ov_case" == walled && "$OV_SOURCE" == account ]]; then
      echo "account=${OVERSEER_MARK_ACCOUNT:-unknown} headroom=0 resets=${OVERSEER_MARK_RESETS:-none}"
    elif [[ "$ov_case" == walled ]]; then
      below="$(pane_below_last_turn "$screen")"
      banner_rc=0
      banner="$(lane_limit_banner "$below")" || banner_rc=$?
      [[ "$banner_rc" -ne 2 ]] || die limit-scan-failed "" "pane=$pane"
      [[ -n "$banner" ]] || die limit-banner-missing "" "pane=$pane"
      banner_payload "$below" "$banner" || die limit-banner-missing "" "pane=$pane"
    fi
    PASS_EVENT=1
    overseer_deliver "$ov_case" "$pane" "$window" "$succession" "$plan" "$record" "$record_mine"
  fi
  if [[ "$plan" != relaunch ]]; then
    OVERSEER_STOP=1
    [[ "$prior" != pending:* ]] \
      || overseer_relaunch_failed "$row" "$rows" "$identity" "$pane" "$window" "$attempt" "plan-$plan"
    return 1
  fi

  # Its stdout joins its stderr: this watch's stdout is the event protocol, and
  # oversee-succeed's own keyed lines are the detail under the event, not
  # records of their own. The walled recovery's stdout carries the command it
  # built as well, so the pass output says which line it sent.
  succeed_rc=0
  if [[ "$ov_case" == walled ]]; then
    overseer_launch_args
    "$SUCCEED" --walled-pane "$pane" "${OVERSEER_LAUNCH_ARGS[@]}" >&2 || succeed_rc=$?
  else
    printf '%s\n' "$OVERSEER_LINE" > "$WORK_DIR/overseer-line" \
      || { overseer_relaunch_failed "$row" "$rows" "$identity" "$pane" "$window" "$attempt" line-file; return 1; }
    "$SUCCEED" --dead-pane "$pane" --handoff "$HANDOFF" --line-file "$WORK_DIR/overseer-line" >&2 || succeed_rc=$?
  fi
  # Exit 3 is that script's own "no account qualifies", which a retry cannot
  # improve on; every other non-zero status is this launch failing and takes
  # the bounded retry. The dead path picks no lane, so it never answers 3.
  case "$succeed_rc" in
    0) OVERSEER_SUCCEEDED=1 ;;
    3) overseer_recovery_blocked "$row" "$rows" "$identity" "$pane" "$window" ;;
    *) overseer_relaunch_failed "$row" "$rows" "$identity" "$pane" "$window" "$attempt" launcher ;;
  esac
  return 1
}

# COPILOT_SESSION_NOTE for a lane's line (lib/lane-context.sh).
lane_note() { # LANE
  local r
  r="$(lane_running_record "$FLEET_STATE" "$1" copilot)" && lane_context_copilot_note "$r" "$PASS_NOW" ||
    die state-invalid "" "option=--state" "path=$STATE_FILE"
}

# The usage-limit route (../references/oversee-events.md § Event kinds,
# usage-limit) for a lane first read walled this pass. The lane's running record
# names its item, harness and model, and `lanes pick` judges an account for that
# model with the spent one excluded. Under ORCH_WALL_RELAUNCH=auto a qualifying
# account takes the lane: open-terminal replaces its window and the
# record's own relaunch runs detached, since it waits on a harness screen for
# minutes. Returns 0 once that relaunch started and lane-relaunched is
# printed; 1 leaves the usage-limit event to the caller, with WALL_PICK the
# pick's answer line, empty where no pick ran.
WALL_PICK=""
wall_relaunch_marker() { printf '%s/wall-relaunch.%s' "$PW_STATE_DIR" "${1//[^A-Za-z0-9._-]/_}"; }
# Whether LANE's window is gone because a relaunch wall_route started is still
# opening it: the marker stands with no exit beside it, inside the bound a
# background launch has to prepare in. A relaunch that ended, or outran that
# bound, leaves the gone window to window-gone.
wall_relaunch_pending() { # LANE
  local marker started
  marker="$(wall_relaunch_marker "$1")"
  [[ -f "$marker" && ! -f "$marker.exit" ]] || return 1
  started="$(jq -er '.since' "$marker")" || return 1
  [[ $((PASS_NOW - started)) -lt "$PREPARE_SECS" ]]
}

# A completed launch can leave a healthy window with a failed record write.
# Preparation reporting therefore reads every detached outcome, independent
# of the pane observation. The marker ends after its outcome was reported.
wall_relaunch_outcomes() {
  local marker fields item since log rc key rows="${PW_SEEN[0]}"
  for marker in "$PW_STATE_DIR"/wall-relaunch.*; do
    [[ -f "$marker" ]] || continue
    case "$marker" in *.exit) continue ;; esac
    fields="$(jq -er '[.item, (.since | tostring), .log] | join("\u001f")' "$marker")" \
      || die state-read-failed "" "path=$marker"
    IFS=$'\x1f' read -r item since log <<<"$fields"
    if [[ -f "$marker.exit" ]]; then
      rc="$(cat -- "$marker.exit")" || die state-read-failed "" "path=$marker.exit"
      if [[ "$rc" != 0 ]]; then
        echo "EVENT lane-prepare-failed $item reason=relaunch-failed exit=$rc log=$log"
        PASS_EVENT=1
      fi
      rm -f -- "$marker" "$marker.exit" || die state-write-failed "" "path=$marker"
      rows="$(lane_row_clear wall-relaunch "$rows" "$item")"
    elif (( PASS_NOW - since >= PREPARE_SECS )); then
      key="$since|stuck"
      if [[ "$key" != "$(lane_row_get wall-relaunch "$rows" "$item")" ]]; then
        echo "EVENT lane-prepare-stuck $item age=$((PASS_NOW - since))s log=$log reason=relaunch-pending"
        PASS_EVENT=1
        rows="$(lane_row_set wall-relaunch "$rows" "$item" "$key")"
      fi
    fi
  done
  lane_row_commit "$rows"
}
wall_route() { # LANE OBS_STATE SPENT PANE_KEY
  local lane="$1" spent="$3" errf="$WORK_DIR/wall-pick.err" rc=0
  local record fields item harness model host account to out log marker
  WALL_PICK=""
  # The judge's walled reading alone is a wall: a working lane quoting a limit
  # is never pre-empted.
  [[ "$2" == walled ]] || { ow_message wall-relaunch-refused "lane=$lane" reason=lane-working >&2; return 1; }
  record="$(jq -c --arg w "$lane" "$LANE_RUNNING_JQ"'[.lanes[]? | select(running and .window == $w)] | last // {}' \
    <<<"${FLEET_STATE:-null}")" || die state-invalid "" "option=--state" "path=$STATE_FILE"
  fields="$(jq -r '[.item, .harness, .model, (.host // "local"), .account] | map(. // "" | tostring) | join("\u001f")' \
    <<<"$record")" || die state-invalid "" "option=--state" "path=$STATE_FILE"
  IFS=$'\x1f' read -r item harness model host account <<<"$fields"
  [[ -n "$item" && -n "$harness" && -n "$model" ]] \
    || { ow_message wall-relaunch-refused "lane=$lane" reason=record-unnamed >&2; return 1; }
  spent="${spent:-$account}"
  [[ -n "$spent" ]] || { ow_message wall-relaunch-refused "lane=$lane" reason=account-unknown >&2; return 1; }
  bounded_account_read "" "$errf" env ORCH_LANE_HOST="$host" "$LANES_CLI" \
    pick --harness "$harness" --model "$model" --exclude-lane "$spent" --json || rc=$?
  if [[ "$rc" -eq 0 ]] && to="$(jq -er '.config_dir | strings' <<<"$BOUNDED_OUT" 2>/dev/null)"; then
    WALL_PICK="pick lane=$to"
  elif [[ "$rc" -eq 3 ]]; then
    WALL_PICK="pick none"
    return 1
  else
    WALL_PICK="pick unjudged exit=$rc"
    [[ ! -s "$errf" ]] || cat -- "$errf" >&2
    return 1
  fi
  [[ "$WALL_RELAUNCH" == auto ]] || return 1
  # The spent account is never relaunched onto before its reset.
  [[ "$(lane_claims_canon "$to")" != "$(lane_claims_canon "$spent")" ]] \
    || { ow_message wall-relaunch-refused "lane=$lane" reason=spent-account "account=$to" >&2; return 1; }
  if ! lane_recovery_args "$record" "$to" "$FLEET_STATE_DIR" "$OPEN_TERMINAL"; then
    ow_message wall-relaunch-refused "lane=$lane" reason=context-unavailable "cause=$LANE_RECOVERY_CAUSE" >&2
    return 1
  fi
  if [[ "$host" != local ]]; then
    out="$(ORCH_LANE_HOST="$host" "$SCRIPT_DIR/lane-host" stop --item "$item" --harness "$harness" 2>"$errf")" || rc=$?
    if [[ "$rc" -ne 0 ]] || ! grep -qE "^stopped item=$item processes=[0-9]+$" <<<"$out"; then
      ow_message wall-relaunch-refused "lane=$lane" reason=stop-failed "exit=$rc" >&2
      cat -- "$errf" >&2
      return 1
    fi
  fi
  marker="$(wall_relaunch_marker "$lane")"
  log="$FLEET_STATE_DIR/wall-relaunch-$item.log"
  rm -f -- "$marker.exit"
  if ! jq -cn --arg item "$item" --argjson since "$PASS_NOW" --arg log "$log" \
    '{item: $item, since: $since, log: $log}' > "$marker"; then
    ow_message wall-relaunch-refused "lane=$lane" reason=marker-unwritten "path=$marker" >&2
    return 1
  fi
  # The exit status lands beside the marker, which ends wall_relaunch_pending.
  lane_run_detached "$log" "$log" "$BASH" -c \
    'exit_file="$1"; launch_cwd="$2"; export ORCH_TMUX_SESSION="$3"; shift 3; rc=0; (cd -- "$launch_cwd" && "$@") || rc=$?; printf "%s\n" "$rc" > "$exit_file"' \
    wall-relaunch "$marker.exit" "$LANE_RECOVERY_CWD" "$LANE_RECOVERY_SESSION" "${LANE_RECOVERY_ARGS[@]}"
  echo "EVENT lane-relaunched $item lane=$to from=$spent"
  printf 'log=%s\n' "$log"
}

check_lanes() {
  # No lane to watch still leaves the items: a handoff is read from state.
  [[ ${#LANES[@]} -gt 0 ]] || { check_handoff; return 0; }
  local lane pane below cmd pid state window i states="" claims="" claimed pane_key
  local seen seen_at seen_pane seen_reported seen_key reset_at reset_utc reset_note event reported_event quiet
  local asking_state fingerprint prior turn_identity capacity capacity_key screen_key close_failed=0
  local banner banner_rc turn hosted_item hosted_harness wall_kind
  # One liveness read and one pane capture per lane per pass: a lane's kind is
  # decided from a single observation, never from two screens taken apart. The
  # pid leads the format so a command carrying a space cannot shift the split.
  # The kind itself is lib/lane-state.sh's, the one judge `open-terminal
  # --wake` also asks, so the two read one pane by one set of rungs instead of
  # inventing a classification each. Every loop below reads its verdict out of
  # `states` and classifies nothing of its own.
  #
  # A running record naming the hosted harness permits one provider read.
  # The eighth argument is observe_lanes' Pi rows verdict.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    window=gone; pid=""; cmd=""; pane=""
    if [[ "$(lane_obs_state "$LANE_OBS" "$i")" == ready ]]; then
      window=listed
      pid="$(lane_field "$LANE_OBS" "$i" 3)"
      cmd="$(lane_field "$LANE_OBS" "$i" 4)"
      pane="$(cat -- "$(lane_pane_file "$i")")"
    fi
    # The judge exits 2 on exactly one condition, a banner scan that failed,
    # and observe_lanes already ran that scan over this slice of this capture
    # file and died `limit-scan-failed` on it. So this refuses it under the
    # same reason, and in an ordinary pass it is unreachable: the status is
    # checked because a verdict nothing looked at is how a lane gets read as
    # having no news.
    hosted_lane_item "$lane"
    hosted_item=""; hosted_harness=""
    if item_in "$LANE_ITEM" ${STATUS_VERB[@]+"${STATUS_VERB[@]}"}; then
      hosted_harness="$(jq -r --arg item "$LANE_ITEM" "$LANE_RUNNING_JQ"'
        [.lanes[]? | select(running and .item == $item)][0].harness // ""' <<<"${FLEET_STATE:-null}")" \
        || die state-invalid "" "item=$LANE_ITEM"
      [[ -z "$hosted_harness" ]] || hosted_item="$LANE_ITEM"
    fi
    ORCH_LANE_HOST="$HOSTED_HOST" lane_state state "$window" "$cmd" "$pid" "$pane" "" "" "${LANE_ROWS[$i]:-}" "$hosted_item" "$hosted_harness" \
      || die limit-scan-failed "" "lane=$lane"
    # Provider failures stay unjudged; local probe failures still permit pane judgment.
    [[ -n "$hosted_item" || "$LANE_PROBE_RC" -le 1 ]] || note_probe_unusable "$lane"
    states+="$i"$'\t'"$state"$'\t'"$LANE_EXIT_SOURCE"$'\t'"$LANE_WALL_KIND"$'\n'
    if [[ "$state" == gone ]] && ! wall_relaunch_pending "$lane"; then
      echo "EVENT window-gone $lane"
      PASS_EVENT=1
    fi
  done
  # A lane window outlives its harness: open-terminal runs claude/codex inside
  # a shell, so a session that hit its limit, crashed, or quit leaves the
  # shell in the foreground — a window that exists, a pane that matches no
  # question prompt, and a slot held until someone looks. A bare shell with
  # nothing but shells under it IS that lane, finished; its closing lines
  # carry why. A provider-confirmed exit is news in this pass. A local shell
  # takes two consecutive passes: a live harness can hold such a shell in the
  # foreground for one poll, and relaunching a working lane costs more than
  # one interval. The first pass is a `lane-exited` row keyed by the
  # pane, so the second can be the next run's first; that second pass marks
  # the row reported, so a later run over the same pane stays silent, and a
  # replacement pane starts over and is news again.
  asking_state="${PW_SEEN[0]}"
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_obs_state "$states" "$i")" != exited ]]; then
      asking_state="$(lane_row_clear lane-exited "$asking_state" "$lane")"
      continue
    fi
    if ! pane_key="$(lane_field "$LANE_OBS" "$i" 5)"; then
      die state-read-failed "" "lane=$lane" "field=pane-key"
    fi
    if ! prior="$(lane_row_get lane-exited "$asking_state" "$lane")"; then
      die state-read-failed "" "lane=$lane" "row=lane-exited"
    fi
    if [[ "$prior" == "$pane_key|reported" ]]; then continue; fi
    if [[ "$prior" == "$pane_key" || "$(lane_field "$states" "$i" 3)" == provider ]]; then
      asking_state="$(lane_row_set lane-exited "$asking_state" "$lane" "$pane_key|reported")"
      echo "EVENT lane-exited $lane"
      pane="$(cat -- "$(lane_pane_file "$i")")"
      # What the lane said before it stopped, which is the whole handling of
      # this event. Only below its last user turn: an exited lane's screen
      # keeps every turn that fits, and the ones above the last are a
      # transcript the overseer is not being asked to read. The slice is
      # assigned rather than substituted into the call, so a failing awk
      # aborts the run instead of printing an empty payload.
      below="$(pane_below_last_turn "$pane")"
      report_tail "$below"
      PASS_EVENT=1
      asking_state="$(lane_row_clear lane-asking "$asking_state" "$lane")"
      close_finished_hosted_lane "$lane" lane-exited "$pane_key"
    else
      asking_state="$(lane_row_set lane-exited "$asking_state" "$lane" "$pane_key")"
    fi
  done
  lane_row_commit "$asking_state"
  check_handoff
  # check_handoff commits its rows through PW_SEEN; a copy taken before it
  # would write them back out on the next commit below.
  asking_state="${PW_SEEN[0]}"
  # The harness is still running and the account is spent: every lane on that
  # account dies with it, so the config dir is the actionable part and a live
  # claim is where it is recorded. A walled lane is neither asking nor idle: a
  # limit banner can sit above a stale prompt, and the account is the news, so
  # the two loops below skip it. One pass: a banner is terminal for that
  # account window, not a screen a poll can catch mid-draw. Only below the last
  # user turn: a banner the lane has since worked past is the screen
  # remembering a spent window that has since reset.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_obs_state "$states" "$i")" != walled ]]; then continue; fi
    pane="$(cat -- "$(lane_pane_file "$i")")"
    pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
    # The banner states when the wall lifts, and that decides which event
    # this is. A reset already behind us means the lane is parked against a
    # window that has since reopened — the harness will not notice on its
    # own — so it is bumped, not waited on. The wall's day comes from the
    # row observe_lanes stamped, never from the banner: with no row, or with
    # a reset `date` would not resolve, the plain event goes out with no
    # time on it and the lane is parked. `resets=` is keyed rather than
    # positional because the config dir before it is optional.
    if ! seen="$(lane_row_get usage-limit "$asking_state" "$lane")"; then
      die state-read-failed "" "lane=$lane" "row=usage-limit"
    fi
    seen_at=""; seen_pane=""; seen_reported=""; seen_key=""
    [[ -z "$seen" ]] || IFS='|' read -r seen_at seen_pane seen_reported seen_key <<<"$seen"
    wall_kind="$(lane_field "$states" "$i" 4)" || die state-read-failed "" "lane=$lane" "field=wall-kind"
    reset_at=""
    [[ -z "$seen_key" ]] || reset_at="$(usage_reset_epoch "$seen_key" "$seen_at")"
    [[ "$wall_kind" != auth ]] || reset_at=""
    event=usage-limit
    reset_note=""
    reset_utc=""
    [[ -z "$reset_at" ]] || reset_utc="$(from_epoch "$reset_at" '%Y-%m-%dT%H:%M:%SZ' || true)"
    if [[ -n "$reset_utc" ]]; then
      reset_note=" resets=$reset_utc"
      [[ "$reset_at" -gt "$PASS_NOW" ]] || event=usage-limit-passed
    fi
    # The wall was reported on an earlier pass and nothing about it has
    # changed: the row is observe_lanes's stamp for this pane and this
    # wall, and the reported column names the event it went out as. The
    # lane stays walled above; a reset going by turns the event into
    # usage-limit-passed, which is news once more. Such a pass only
    # records the wall (lib/account-wall.sh).
    # A retry can replace a no-reset usage wall with a failed login in the
    # same pane. Its report identity must differ without moving the reset's day.
    reported_event="$event"
    [[ "$wall_kind" != auth ]] || reported_event="$event:auth"
    quiet=""
    if [[ "$seen_reported" == "$reported_event" || ( "$event" == usage-limit && "$seen_reported" == lane-relaunched ) ]]; then
      quiet=1
    fi
    # The detail is a nicety; a claim store this process cannot read must
    # not take down the event that carries the payload.
    claims="$(lane_claims_read "$(lane_claims_dir "$PROJECT_ROOT")" || true)"
    # Claims are kept for every live tmux server, and a window NAME is
    # unique only within a session: the account is resolved on the pane
    # actually captured here — `<server pid> <pane id>`, the same key the
    # claim's liveness uses — so no other lane can answer for it.
    # An unreadable claim store is already tolerated above; a resolver that
    # fails on a readable one is not the same thing, and the event goes out
    # without an account rather than with another lane's.
    claimed="$(lane_claims_config_dir "$claims" "${pane_key%% *}" "${pane_key##* }")" || claimed=""
    if [[ -z "$claimed" && -z "$quiet" && -n "$claims" ]]; then
      ow_message claim-missing "lane=$lane" >&2
    fi
    # A window around the banner, never the banner alone (banner_payload): the
    # handling (../references/oversee-events.md § Event kinds) confirms the
    # account spoke rather than a lane quoting a limit phrase. Asked of the same
    # judge over the same slice that classified the lane, and asked BEFORE
    # the event line, so a disagreement stops the pass instead of printing
    # half an event. The `walled` rung read this judge over this slice, so an
    # empty answer is the two disagreeing and is never a payload to print.
    # The anchor lookup below cannot miss once the answer is non-empty, since
    # the banner is lines of this slice; its refusal is the assertion of that,
    # and it is the one that can land under an event line already out.
    lane_banner_text "$i" "$lane" "$pane"
    below="$LANE_BANNER_TEXT"
    banner_rc=0
    banner="$(lane_limit_banner "$below")" || banner_rc=$?
    [[ "$banner_rc" -ne 2 ]] || die limit-scan-failed "" "lane=$lane"
    [[ -n "$banner" ]] || die limit-banner-missing "" "lane=$lane"
    account_wall_record "$PROJECT_ROOT" "$claimed" "$reset_at" "$PASS_NOW" "$banner" "${LANE_ROWS[$i]:+row}" || true
    [[ -z "$quiet" ]] || continue
    WALL_PICK=""
    if [[ "$event" == usage-limit ]] && wall_route "$lane" "$(lane_obs_state "$states" "$i")" "$claimed" "$pane_key"; then
      PASS_EVENT=1
      asking_state="$(lane_row_set usage-limit "$asking_state" "$lane" "${seen_at:-$PASS_NOW}|${seen_pane:-$pane_key}|lane-relaunched|$seen_key")"
      continue
    fi
    [[ "$wall_kind" == auth ]] || wall_kind=""
    echo "EVENT $event $lane${claimed:+ $claimed}$reset_note${wall_kind:+ wall_kind=$wall_kind}"
    [[ -z "$WALL_PICK" ]] || printf '%s\n' "$WALL_PICK"
    banner_payload "$below" "$banner" || die limit-banner-missing "" "lane=$lane"
    PASS_EVENT=1
    asking_state="$(lane_row_set usage-limit "$asking_state" "$lane" "${seen_at:-$PASS_NOW}|${seen_pane:-$pane_key}|$reported_event|$seen_key")"
  done
  # A pane keeps its last screen, so neither a stale prompt under a bare shell
  # nor a dialog answered passes ago is a live question. A current prompt is
  # keyed by its pane slice across watch invocations: emit it once, clear the
  # key when it disappears, and emit again only when the prompt or its Copilot
  # note changes.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    # A lane that is up and not asking drops its row; one that is walled,
    # exited or unjudged keeps it. A wall can sit above a standing question,
    # and the row is what stops the question being re-reported once the wall
    # lifts; gone and exited clear it on their own paths.
    case "$(lane_obs_state "$states" "$i")" in
      asking) ;;
      working|idle)
        asking_state="$(lane_row_clear lane-asking "$asking_state" "$lane")"
        continue ;;
      *) continue ;;
    esac
    pane="$(cat -- "$(lane_pane_file "$i")")"
    below="$(pane_below_last_turn "$pane")"
    pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
    turn_identity="$(pane_turn_identity "$pane")"
    # The note is keyed: a Copilot record that turns to a stop cause under an
    # unchanged prompt is news.
    lane_note "$lane"
    fingerprint="${pane_key}|${turn_identity}|${COPILOT_SESSION_NOTE}|$(printf '%s' "$below" | cksum)"
    if ! prior="$(lane_row_get lane-asking "$asking_state" "$lane")"; then
      die state-read-failed "" "lane=$lane" "row=lane-asking"
    fi
    asking_state="$(lane_row_set lane-asking "$asking_state" "$lane" "$fingerprint")"
    if [[ "$fingerprint" == "$prior" ]]; then continue; fi
    echo "EVENT lane-asking $lane${COPILOT_SESSION_NOTE:+ $COPILOT_SESSION_NOTE}"
    # The dialog to answer, the bottom of the slice the question was found
    # in: the cap trims the turn above it, not the rows.
    bounded_tail "$below"
    PASS_EVENT=1
  done
  # The harness is up at its input prompt with nothing in flight. Codex is
  # reported on the first pass after a submitted turn in a local lane: an agent return cannot
  # start its next turn, and that return changes the screen while the lane
  # remains parked. Hosted lanes and other idle screens take two consecutive passes, because the screen
  # between a finished tool call and the next one reads the same; the first is
  # a `lane-idle` row, as for lane-exited above. The second pass reports it and
  # marks the row, so a lane left at the same screen is reported once, however
  # many runs look at it; a turn taken or a changed Copilot note starts the
  # count over. A lane that is walled, asking, working or exited drops its row.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    capacity=0
    if [[ "$(lane_obs_state "$states" "$i")" == idle ]]; then
      pane="$(cat -- "$(lane_pane_file "$i")")"
      below="$(pane_below_last_turn "$pane")"
      # Which idle this is, not whether it is idle: the judge already settled
      # that. Codex parks the same way on a capacity refusal as on a finished
      # turn, and only the refusal line tells the two apart. A Pi lane's turn
      # is its last row, never its screen, which here is the payload alone.
      turn="$below"
      if [[ -n "${LANE_ROWS[$i]:-}" ]]; then
        turn="$(cat -- "$(lane_rows_file "$i")")"
      elif grep -Eq -- "$CODEX_MARKER_RE" <<<"$below" && grep -qF -- "$MODEL_CAPACITY" <<<"$below"; then
        capacity=1
      fi
    else
      asking_state="$(lane_row_clear lane-idle "$asking_state" "$lane")"
      asking_state="$(lane_row_clear model-capacity "$asking_state" "$lane")"
      continue
    fi
    pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
    if [[ "$capacity" -eq 1 ]]; then
      # Capacity uses a turn-bound row. An earlier idle report cannot consume
      # the first stop after a continuation.
      capacity_key="${LANE_TURNS[$i]}"
      if ! prior="$(lane_row_get model-capacity "$asking_state" "$lane")"; then
        die state-read-failed "" "lane=$lane" "row=model-capacity"
      fi
      asking_state="$(lane_row_clear lane-idle "$asking_state" "$lane")"
      if [[ "$prior" == "$capacity_key" ]]; then continue; fi
      asking_state="$(lane_row_set model-capacity "$asking_state" "$lane" "$capacity_key")"
      # No payload: the handling is one continuation line pasted back into the
      # pane, and the key says everything it needs. The refusal line itself is
      # what the judge already matched.
      echo "EVENT model-capacity $lane"
      PASS_EVENT=1
      continue
    fi
    asking_state="$(lane_row_clear model-capacity "$asking_state" "$lane")"
    # The whole slice below the last turn is the key: any change to what the
    # lane shows is a different idle screen and news again. A repaint of an
    # older frame does not reach here, since a scrolled view carries `Jump to
    # bottom` and pane_working reads that frame as working. A Pi lane's key is
    # its last row, so each turn end it writes is news once.
    lane_note "$lane"
    screen_key="${pane_key}|${COPILOT_SESSION_NOTE}|$(printf '%s' "$turn" | cksum)"
    if ! prior="$(lane_row_get lane-idle "$asking_state" "$lane")"; then
      die state-read-failed "" "lane=$lane" "row=lane-idle"
    fi
    if [[ "$prior" == "$screen_key|reported" ]]; then continue; fi
    hosted_lane_item "$lane"
    if [[ "$prior" == "$screen_key" ]] || { [[ -z "$HOSTED_ROOT" ]] && grep -Eq -- "$CODEX_MARKER_RE" <<<"$below" && [[ -n "$(pane_turn_slice "$pane" before)" ]]; }; then
      asking_state="$(lane_row_set lane-idle "$asking_state" "$lane" "$screen_key|reported")"
      # The lane's closing report, which decides whether it is free for
      # another launch. Below the last turn is the round that just ended,
      # and the cap keeps its last lines. Unfiltered: the dead-worktree
      # prompt noise is drawn by a shell that has the terminal back, and a
      # lane whose shell is drawing prompts reads exited, not idle.
      echo "EVENT idle-after-return $lane${COPILOT_SESSION_NOTE:+ $COPILOT_SESSION_NOTE}"
      bounded_tail "$below"
      PASS_EVENT=1
      close_finished_hosted_lane "$lane" lane-idle "$screen_key"
    else
      asking_state="$(lane_row_set lane-idle "$asking_state" "$lane" "$screen_key")"
    fi
  done
  # Committed after every asking and idle line is out: a row written ahead of
  # its event would make a crash between the two lose the question for good.
  lane_row_commit "$asking_state"
  # A failed close ends the pass only here, once every lane check above has
  # reported what it found.
  [[ "$close_failed" -eq 0 ]] || exit 2
}

# One `lanes list` per pass, read by the account events below and the
# heartbeat's roster alike, so those two never describe an account
# differently. The overseer's own mark judgement is a separate read. Each row is `<row key> TAB <row
# value> TAB <fields>`, the key and value laid out with the rows above and
# <fields> the text both the event and the roster print. `verdict` is
# `lanes`'s own wall judgement against ORCH_LANE_MAX_PCT, so the threshold and
# its default are read in one place. A read that failed or overran its ceiling
# leaves ACCOUNT_ROSTER_RC non-zero, which the heartbeat reports rather than
# printing no accounts.
ACCOUNT_ROSTER=""
ACCOUNT_ROSTER_JSON=""
ACCOUNT_ROSTER_RC=1
account_roster_read() {
  local errf="$WORK_DIR/accounts.err" rc=0 out
  ACCOUNT_ROSTER=""
  ACCOUNT_ROSTER_JSON=""
  ACCOUNT_ROSTER_RC=1
  bounded_account_read account-unread "$errf" "$LANES_CLI" list --json || rc=$?
  # `lanes` writes its own keyed notices on a listing it still answered, a
  # provider it could not ask among them; those qualify this roster and pass
  # through with it.
  [[ ! -s "$errf" ]] || cat -- "$errf" >&2
  (( rc == 0 )) || return 1
  # The listing is read as one JSON array or not at all: an empty answer at
  # exit 0 is a listing that failed to render, never a fleet with no accounts.
  # A record missing the fields a row is keyed and judged on is not an account
  # this watch can compare, and refusing the read is what keeps it from
  # reading as an unchanged one. `lanes` gives every reset one whole-second
  # UTC spelling, which to_epoch reads on both date arms.
  out="$(jq -rn 'input
    | if type != "array" then error("listing is not an array") else .[] end
    | (.status // error("status missing")) as $status
    | (.verdict // error("verdict missing")) as $verdict
    | (.binding_resets_at // "-") as $resets
    | ["\(.harness)|\(.measured_through)|\(.config_dir)",
       "\($status)|\($verdict)|\($resets)",
       "\(.alias) config_dir=\(.config_dir) harness=\(.harness) through=\(.measured_through) status=\($status) verdict=\($verdict) headroom_pct=\(.headroom_pct // "-") binding_bucket=\(.binding_bucket // "-") binding_resets_at=\($resets)"]
    | @tsv' <<<"$BOUNDED_OUT" 2>"$errf")" || {
    overseer_note account-unread "path=$LANES_CLI" "parse=failed"
    [[ ! -s "$errf" ]] || cat -- "$errf" >&2
    return 1
  }
  ACCOUNT_ROSTER="$out"
  ACCOUNT_ROSTER_JSON="$BOUNDED_OUT"
  ACCOUNT_ROSTER_RC=0
}

# An account row changes when its status, its verdict against
# ORCH_LANE_MAX_PCT, or its binding bucket's reset changes. The first sighting
# of an account is its baseline and says nothing. A reset is news only once
# the reset the baseline holds has passed AND the reading has moved off it: a
# cached figure still naming the old reset is the same wall until the account
# is measured again, and the event is what carries the fresh headroom. A reset
# time that moved while still ahead is a different bucket binding, not a reset.
# An account the listing stops naming keeps its row, so one a provider drops
# for a pass is compared against its last reading when it comes back.
#
# A reading that measured nothing (`verdict=unmeasured`) under the status word
# the account's last unmeasured reading had is no news and leaves the row on
# the reading before it, so the next measured reading is compared with the
# last one measured. A hosted provider holding a credential while a lane runs
# on it reads unmeasured on alternate passes; were each alternation news,
# --max-loops quiet passes, and so the heartbeat, would never come.
# `status=expired` is exempt: only the operator renews a dead login, so each
# expiry after a measured reading is news.
check_accounts() {
  local key value fields prior state="${PW_SEEN[0]}" change row
  local was_status was_verdict was_resets was_unmeasured status verdict resets reset_epoch unmeasured
  [[ "$ACCOUNT_ROSTER_RC" -eq 0 ]] || return 0
  while IFS=$'\t' read -r key value fields; do
    [[ -n "$key" ]] || continue
    if ! prior="$(lane_row_get account "$state" "$key")"; then
      die state-read-failed "" "account=$key" "row=account"
    fi
    IFS='|' read -r was_status was_verdict was_resets was_unmeasured <<<"$prior"
    IFS='|' read -r status verdict resets <<<"$value"
    unmeasured="${was_unmeasured:--}"
    if [[ "$verdict" == unmeasured ]]; then
      [[ "$status" == expired || "$status" != "$unmeasured" ]] || continue
      unmeasured="$status"
    fi
    row="$value|$unmeasured"
    [[ "$prior" != "$row" ]] || continue
    state="$(lane_row_set account "$state" "$key" "$row")"
    [[ -n "$prior" ]] || continue
    change=""
    [[ "$was_status" == "$status" ]] || change+=",status"
    [[ "$was_verdict" == "$verdict" ]] || change+=",headroom"
    if [[ "$was_resets" != - && "$was_resets" != "$resets" ]]; then
      if reset_epoch="$(to_epoch "$was_resets")"; then
        [[ "$reset_epoch" -gt "$PASS_NOW" ]] || change+=",reset"
      else
        overseer_note account-reset-unparsed "account=$key" "binding_resets_at=$was_resets"
      fi
    fi
    [[ -n "$change" ]] || continue
    echo "EVENT account $fields change=${change#,} was=$was_status/$was_verdict"
    PASS_EVENT=1
  done <<<"$ACCOUNT_ROSTER"
  lane_row_commit "$state"
}

# The status report's cadence, judged by oversee-report alone. No row is kept:
# the report file the overseer writes is what ends the event, so an overseer
# that has not written one is told again on the next long pass.
check_report() {
  [[ -n "$STATE_FILE" ]] || return 0
  local errf="$WORK_DIR/report.err" out rc=0 repo repo_args=()
  for repo in "${REPOS[@]}"; do repo_args+=(--repo "$repo"); done
  out="$("$REPORT_CLI" due --state "$STATE_FILE" "${repo_args[@]}" 2>"$errf")" || rc=$?
  if [[ "$rc" -ne 0 ]]; then
    ow_message report-unjudged "exit=$rc" "path=$REPORT_CLI" >&2
    cat -- "$errf" >&2
    PASS_FAILED=1
    return 0
  fi
  [[ -n "$out" ]] || return 0
  if [[ "$out" == *$'\n'* || "$out" != "report-due reason="* ]]; then
    ow_message report-unjudged "exit=0" "path=$REPORT_CLI" >&2
    printf '%s\n' "$out" >&2
    PASS_FAILED=1
    return 0
  fi
  echo "EVENT $out"
  PASS_EVENT=1
}

# The work the fleet owes and its launch queue lacks, one `owed` line per item,
# as OWED_LINES. The tracker is the membership and launch_queue only the
# order: with LINEAR_TEAM, every team item In Progress, In Review or
# Verifying, one live read. Verifying is handled before development filtering; with none, every open pull request in the item repository, the first
# --repo, whose head is a GitHub item's branch, issue-N, read whole by a
# listing of its own. A listing that reaches OWED_PR_LIMIT refuses rather than
# pass a short set as the whole one. An item is owed nothing while its record
# is in flight (running, preparing or parked, LANE_RUNNING_JQ's `in_flight`):
# the merged check carries a parked lane's pull request, and
# parked_merged_owed names the record again at each heartbeat once it
# merged. The queue and the records are the turn's own fleet_merge read,
# FLEET_STATE, so the heartbeat judges the fleet the pass carried and reads no
# file again.
#
# The verdict, in this order: `merged` where the record carries the `cycle`
# oversee-cycle writes at a merge, which a later launch keeps, so the tracker
# holding the item says either the close-out never moved it or the item went
# back to work; `queue` where the record names no harness, since its launch
# picks one. Every other verdict reads the accounts of the record's own host,
# its `host` or `local` where it names none, as ORCH_LANE_HOST, since a
# relaunch stays on that host and open-terminal judges it there: `unjudged`
# where that host's `lanes list` failed; `queue` where it lists no account of
# the harness; otherwise `lanes pick` for the record's harness and model
# decides, the launcher's own judge: room is `queue`, a wall is `dated` until
# the earliest reset that judgement names for its walled accounts, and
# anything else is `unjudged`. One
# listing is read per host and one pick asked per host, harness and model.
# Without --state there is no queue to compare.
OWED_PR_LIMIT=1000
OWED_LINES=""
VERIFYING_LINES=""
# The heartbeat's own caches: one listing per host, one verdict per host,
# harness and model, and the answers owed_accounts and owed_wall hand back.
OWED_ACCOUNTS=""
OWED_ANSWERS=""
OWED_LISTING=""
OWED_VERDICT=""
owed_read() {
  OWED_LINES=""
  VERIFYING_LINES=""
  [[ -n "$STATE_FILE" ]] || return 0
  local errf="$WORK_DIR/owed.err" out items rows rc=0 n
  local id state priority lane host harness model delivery key verdict line asked answer
  OWED_ACCOUNTS=""
  OWED_ANSWERS=""
  if [[ -n "${LINEAR_TEAM:-}" ]]; then
    out="$("$TRACKER" issues list --team "$LINEAR_TEAM" --state "In Progress,In Review,Verifying" --max --format=safe 2>"$errf")" || rc=$?
    [[ "$rc" -eq 0 ]] \
      || die tracker-list-failed "$(cat "$errf")" "team=$LINEAR_TEAM" "exit=$rc"
    # Linear's priority 0 is No priority, which ranks after Low: it prints `-`.
    items="$(jq -c '
      if type != "array" then error("tracker-type expected=array actual=\(type)") else . end
      | map(
          if ((.id? | type) == "string" and (.id | test("^[A-Za-z0-9._-]+$"))) then .
          else error("tracker-field field=id value=\(.id | tojson)") end
          | {id, description: (.description // ""), blocked_by_open: (.blocked_by_open // []), priority: (if .priority == null or .priority == 0 then "-" else .priority end),
             state: ({"In Progress": "in-progress", "In Review": "in-review", "Verifying": "verifying"}[.state? | strings]
               // error("tracker-field field=state value=\(.state | tojson)"))})' <<<"$out" 2>"$errf")" \
      || die tracker-list-invalid "$(cat "$errf")" "team=$LINEAR_TEAM"
  else
    out="$(gh pr list --repo "${REPOS[0]}" --state open --limit "$OWED_PR_LIMIT" --json number,headRefName,title \
      --jq '.[] | "\(.number)\t\(.headRefName)\t\(.title)"' 2>"$errf")" \
      || die pr-list-failed "$(cat "$errf")" "repo=${REPOS[0]}" "state=open"
    n="$(grep -c . <<<"$out" || true)"
    [[ "$n" -lt "$OWED_PR_LIMIT" ]] || die owed-list-truncated "" "repo=${REPOS[0]}" "limit=$OWED_PR_LIMIT"
    items="$(awk -F'\t' '$2 ~ /^issue-[0-9]+$/ { print $2 }' <<<"$out" \
      | jq -Rnc '[inputs | {id: ., state: "open-pr", priority: "-"}]' 2>"$errf")" \
      || die pr-list-invalid "$(cat "$errf")" "repo=${REPOS[0]}"
  fi
  if [[ -n "${LINEAR_TEAM:-}" ]]; then
    verifying_read "$items"
    items="$(jq -c 'map(select(.state != "verifying"))' <<<"$items")" \
      || die tracker-list-invalid "" "team=$LINEAR_TEAM"
  fi
  # One row per owed item on the unit separator, since a model id is the
  # launcher's to spell: id, state, priority, lane, then the host, harness and
  # model a wall is judged for and the delivery identifier, `-` where none.
  rows="$(jq -r --argjson items "$items" "$LANE_RUNNING_JQ"'
    def token($field): if type == "string" and test("^[A-Za-z0-9._-]+$") then .
      else error("lane-field field=\($field) value=\(tojson)") end;
    if type != "object" then error("state-type expected=object actual=\(type)") else . end
    | (.launch_queue // []) as $queue
    | if ($queue | type) != "array" or any($queue[]; type != "string")
      then error("state-field field=launch_queue value=\($queue | tojson)") else . end
    | (.lanes // []) as $lanes
    | $items | unique_by(.id)[]
    | . as $item
    | select(any($queue[]; . == $item.id) | not)
    | ([$lanes[] | objects | select(.item == $item.id)] | last) as $rec
    | select($rec == null or ($rec | in_flight | not))
    | [$item.id, $item.state, ($item.priority | tostring),
       (if $rec == null then "none" else ($rec.status | token("status")) end),
       ($rec.host // null | if . == null or . == "" then "local" elif type == "string" then . else error("lane-field field=host value=\(tojson)") end),
       ($rec.harness // null | if . == null then "-" else token("harness") end),
       ($rec.model // null | if . == null or . == "" then "-" elif type == "string" then . else error("lane-field field=model value=\(tojson)") end),
       (if $rec.cycle == null then "-"
        else ($rec.cycle | if has("pr") and (has("commit") | not) and (.pr | type) == "number" then "pr=\(.pr)"
          elif has("commit") and (has("pr") | not) and (.commit | type) == "string" and (.commit | test("^[0-9a-f]+$")) then "commit=\(.commit)"
          else error("lane-field field=cycle value=\($rec.cycle | tojson)") end) end)]
    | join("\u001f")' <<<"$FLEET_STATE" 2>"$errf")" \
    || die state-invalid "$(cat "$errf")" "option=--state" "path=$STATE_FILE"
  while IFS=$'\037' read -r id state priority lane host harness model delivery; do
    [[ -n "$id" ]] || continue
    line="owed $id state=$state priority=$priority lane=$lane"
    if [[ "$delivery" != - ]]; then
      verdict="verdict=merged $delivery"
    elif [[ "$harness" == - ]]; then
      verdict="verdict=queue"
    else
      key="$host"$'\037'"$harness"$'\037'"$model"
      verdict=""
      while IFS=$'\t' read -r asked answer; do
        [[ "$asked" != "$key" ]] || { verdict="$answer"; break; }
      done <<<"$OWED_ANSWERS"
      if [[ -z "$verdict" ]]; then
        owed_wall "$host" "$harness" "$model"
        verdict="$OWED_VERDICT"
        OWED_ANSWERS+="$key"$'\t'"$verdict"$'\n'
      fi
    fi
    OWED_LINES+="$line $verdict"$'\n'
  done <<<"$rows"
  OWED_LINES="${OWED_LINES%$'\n'}"
}

# One host's `lanes list --json`, read once a heartbeat under that host as
# ORCH_LANE_HOST and kept in OWED_ACCOUNTS as `<host> TAB <listing>` lines,
# `-` for a listing that failed, which is named on stderr once. A listing
# `lanes` still answered can carry its own keyed notices, a provider it could
# not ask among them; those qualify the verdicts judged on it and pass through.
owed_accounts() { # HOST
  local host="$1" errf="$WORK_DIR/owed-list.err" rc=0 asked answer
  OWED_LISTING=""
  while IFS=$'\t' read -r asked answer; do
    [[ "$asked" != "$host" ]] || { OWED_LISTING="$answer"; return 0; }
  done <<<"$OWED_ACCOUNTS"
  # Both reads use this pass's settings and usage age. Reusing a successful
  # own-host roster removes a duplicate read without changing owed picks.
  if [[ "$ACCOUNT_ROSTER_RC" -eq 0 && "$host" == "${ORCH_LANE_HOST:-local}" ]]; then
    OWED_LISTING="$ACCOUNT_ROSTER_JSON"
    return 0
  fi
  bounded_account_read "" "$errf" env ORCH_LANE_HOST="$host" "$LANES_CLI" list --json || rc=$?
  if [[ "$rc" -eq 0 ]] && jq -e 'type == "array"' <<<"$BOUNDED_OUT" >/dev/null 2>&1; then
    [[ ! -s "$errf" ]] || cat -- "$errf" >&2
    OWED_LISTING="$(jq -c . <<<"$BOUNDED_OUT")" || die owed-roster-invalid "" "host=$host"
  else
    ow_message owed-accounts-unread "host=$host" "exit=$rc" >&2
    cat -- "$errf" >&2
    OWED_LISTING=-
  fi
  OWED_ACCOUNTS+="$host"$'\t'"$OWED_LISTING"$'\n'
}

# Verification uses the same inventory as owed work, before queue and active
# lane filtering. Deadlines remain per box in the issue description.
verifying_read() { # SAFE_ITEMS
  local lib="$SKILLS_DIR/linear/scripts/lib/issue-validation.sh"
  local rows row id desc parsed lines due prior boxes blocked merged releases release_rows release tag glob repo box resolved
  local state="${PW_SEEN[0]}" errf="$WORK_DIR/verifying.err" release_limit="$MERGED_SEARCH_PAGE"
  rows="$(jq -c '.[] | select(.state == "verifying")' <<<"$1")" \
    || die tracker-list-invalid "" "team=$LINEAR_TEAM"
  # Rebuild due rows from the complete read. Ticks and blockers clear the
  # edge key, so closing a blocking fix asks for the same reading again.
  state="$(awk -F'\t' '$1 != "verifying-deadline" { print }' <<<"$state")"
  if [[ -z "$rows" ]]; then
    lane_row_commit "$state"
    return 0
  fi
  [[ -r "$lib" ]] || die missing-linear "" "path=$lib"
  # shellcheck source=../../../linear/scripts/lib/issue-validation.sh
  source "$lib"
  while IFS= read -r row; do
    [[ -n "$row" ]] || continue
    id="$(jq -r '.id' <<<"$row")" || die tracker-list-invalid "" "team=$LINEAR_TEAM"
    desc="$(jq -r '.description + "."' <<<"$row")" || die tracker-list-invalid "" "team=$LINEAR_TEAM"
    parsed="$(done_when_parse "${desc%.}" '[]')" || die verifying-invalid "" "issue=$id"
    jq -e '(.errors | length) == 0 and all(.boxes[]; .checked or .post_merge)' <<<"$parsed" >/dev/null \
      || die verifying-invalid "$parsed" "issue=$id"
    blocked="$(jq -c '(.blocked_by_open | length) > 0' <<<"$row")" || die verifying-invalid "" "issue=$id"
    boxes="$(jq -c '[.boxes[] | select(.post_merge and (.checked | not))]' <<<"$parsed")" || die verifying-invalid "" "issue=$id"
    # GitHub supplies the release publication clock. A failed read refuses the
    # pass; it cannot establish that the release trigger is still waiting.
    if [[ "$blocked" == false ]] && jq -e 'any(.[]; .trigger_kind == "release")' <<<"$boxes" >/dev/null; then
      merged=null
      for repo in "${REPOS[@]}"; do
        merged_item_read "$id" "$repo" null
        merged="$(jq -c --argjson previous "$merged" '([$previous] + map(.at)) | max' <<<"$MERGED_ITEM_ROWS")" || die verifying-invalid "" "issue=$id"
      done
      [[ "$merged" != null ]] || die verifying-merge-unread "" "issue=$id"
      release_rows="$(jq -c '.[] | select(.trigger_kind == "release")' <<<"$boxes")" || die verifying-invalid "" "issue=$id"
      while IFS= read -r box; do
        repo="$(jq -r .release_repo <<<"$box")" || die verifying-invalid "" "issue=$id"
        glob="$(jq -r .release_glob <<<"$box")" || die verifying-invalid "" "issue=$id"
        releases="$(gh release list --repo "$repo" --limit "$release_limit" --json tagName,publishedAt,isDraft 2>"$errf")" \
          || die verifying-release-unread "$(cat "$errf")" "issue=$id" "repo=$repo"
        releases="$(jq -c --argjson merged "$merged" --argjson limit "$MERGED_SEARCH_PAGE" '
          if type != "array" or length >= $limit then error("release-list-incomplete") else . end
          | map(if (.isDraft | type) != "boolean" then error("release-fields") else . end
              | select(.isDraft == false) | .publishedAt as $stamp
              | if (.tagName | type) != "string" or (try ($stamp | fromdateiso8601 | todateiso8601 == $stamp) catch false) != true
                then error("release-fields") else . end)
          | map(. + {at: (.publishedAt | fromdateiso8601)} | select(.at > $merged)) | sort_by(.at)[]' <<<"$releases" 2>"$errf")" \
          || die verifying-release-unread "$(cat "$errf")" "issue=$id" "repo=$repo"
        resolved=null
        while IFS= read -r release; do
          [[ -n "$release" ]] || continue
          tag="$(jq -r .tagName <<<"$release")" || die verifying-invalid "" "issue=$id"
          # The tracker supplies a tag glob, not a literal tag.
          # shellcheck disable=SC2053
          [[ "$tag" == $glob ]] || continue
          resolved="$(jq -c '.publishedAt | fromdateiso8601' <<<"$release")" || die verifying-invalid "" "issue=$id"
          break
        done <<<"$releases"
        boxes="$(jq -c --argjson box "$box" --argjson fired "$resolved" '
          map(if .number == $box.number then .trigger_epoch = $fired
              | .deadline_epoch = (if $fired == null then null else $fired + (.deadline_hours * 3600) end)
              | if .deadline_epoch == null then . else .deadline = (.deadline_epoch | todateiso8601) end
              else . end)' <<<"$boxes")" || die verifying-invalid "" "issue=$id"
      done <<<"$release_rows"
    fi
    boxes="$(jq -c --argjson now "$PASS_NOW" --argjson blocked "$blocked" '
      map(.status = (if $blocked then "blocked"
          elif .trigger_kind != "merge" and (.trigger_epoch == null or .trigger_epoch > $now) then "waiting"
          elif .deadline_epoch <= $now then "overdue" else "due" end))' <<<"$boxes")" || die verifying-invalid "" "issue=$id"
    lines="$(jq -r --arg id "$id" '.[]
      | "verifying \($id) box=\(.number) trigger=\(.trigger | tojson) status=\(.status) deadline=\(.deadline) reading=\(.reading | tojson) where=\(.where | tojson) why=\(.why | tojson)"' <<<"$boxes")" \
      || die verifying-invalid "" "issue=$id"
    [[ -n "$lines" ]] || lines="verifying $id boxes=0"
    VERIFYING_LINES+="$lines"$'\n'
    due="$(jq -r '.[] | select(.status == "due" or .status == "overdue")
      | "box=\(.number) trigger=\(.trigger | tojson) status=\(.status) deadline=\(.deadline)"' <<<"$boxes")" || die verifying-invalid "" "issue=$id"
    [[ -n "$due" ]] || continue
    prior="$(lane_row_get verifying-deadline "${PW_SEEN[0]}" "$id")" \
      || die state-read-failed "" "row=verifying-deadline" "issue=$id"
    state="$(lane_row_set verifying-deadline "$state" "$id" "${due//$'\n'/|}")"
    [[ "$prior" != "${due//$'\n'/|}" ]] || continue
    while IFS= read -r row; do
      echo "EVENT verifying-deadline $id $row"
    done <<<"$due"
    PASS_EVENT=1
  done <<<"$rows"
  VERIFYING_LINES="${VERIFYING_LINES%$'\n'}"
  lane_row_commit "$state"
}

# The wall verdict of one host, harness and model, as OWED_VERDICT. `lanes
# pick` judges it under that host exactly as a launch there is judged. Exit 0
# is room; exit 3 with walled accounts is a wall, dated by the refusal's own
# walled_resets_at: the same judgement, on the launch's model and on the
# reading the provider's copy runs under, names each walled account's deciding
# window and its reset, `until=-` where none states one. Exit 3 with none
# walled is every account unmeasured, and any other exit a judgement that
# failed, named on stderr: both are `unjudged`.
owed_wall() { # HOST HARNESS MODEL
  local host="$1" harness="$2" model="$3" errf="$WORK_DIR/owed-pick.err" rc=0 walled until
  local args=(pick --harness "$harness" --json)
  OWED_VERDICT="verdict=unjudged harness=$harness"
  owed_accounts "$host"
  [[ "$OWED_LISTING" != - ]] || return 0
  if ! jq -e --arg h "$harness" 'any(.[]; .harness == $h)' <<<"$OWED_LISTING" >/dev/null 2>"$errf"; then
    [[ ! -s "$errf" ]] || die owed-roster-invalid "$(cat "$errf")" "host=$host"
    OWED_VERDICT="verdict=queue"
    return 0
  fi
  [[ "$model" == - ]] || args+=(--model "$model")
  bounded_account_read "" "$errf" env ORCH_LANE_HOST="$host" "$LANES_CLI" "${args[@]}" || rc=$?
  case "$rc" in
    0) OWED_VERDICT="verdict=queue" ;;
    3)
      if ! walled="$(jq -r '.walled | if type == "number" then . else error("walled missing") end' <<<"$BOUNDED_OUT" 2>/dev/null)"; then
        ow_message owed-wall-unjudged "host=$host" "harness=$harness" "model=$model" "exit=3" >&2
        cat -- "$errf" >&2
      elif [[ "$walled" -gt 0 ]]; then
        until="$(jq -r '.walled_resets_at | if . == null then "-" elif type == "string" then . else error("walled_resets_at") end' \
          <<<"$BOUNDED_OUT" 2>"$errf")" || die owed-roster-invalid "$(cat "$errf")" "host=$host"
        OWED_VERDICT="verdict=dated harness=$harness until=$until"
      fi ;;
    *)
      ow_message owed-wall-unjudged "host=$host" "harness=$harness" "model=$model" "exit=$rc" >&2
      cat -- "$errf" >&2 ;;
  esac
}

# Every --repo's open PRs, each line prefixed with its repo as the reducer's
# are, and all of them read before the event line goes out: a repo that
# cannot be listed is a failed pass, not a heartbeat missing a repo; a
# Dependabot pull request's line is security_mark_open's. The
# account roster follows, as the last long pass read it, then the owed items,
# read before the event line for the same reason. A parked record still
# standing over its merged pull request is handed on again ahead of it.
heartbeat() {
  local errf="$WORK_DIR/open.err" repo open open_all="" failing baseline="" file hands
  github_ready
  # The standing lane failures, each reported once and quiet since: a quiet
  # run still names every channel that stays broken. The long pass's are in
  # the baseline it committed, read here since this process never holds it.
  file="$(pw_state_file "${REPOS[0]}")"
  [[ ! -f "$file" ]] || baseline="$(cat -- "$file")" || die state-read-failed "" "path=$file"
  for repo in "${REPOS[@]}"; do
    if ! open="$(gh pr list --repo "$repo" --state open --limit 50 --json number,headRefName,title,author \
      --jq "$SECURITY_OPEN_JQ" 2>"$errf")"; then
      die pr-list-failed "$(cat "$errf")" "repo=$repo" "state=open"
    fi
    [[ -n "$open" ]] || continue
    open="$(security_mark_open "$baseline" "$repo" "$open")" || die state-read-failed "" "path=$file" "row=bot-fix"
    open_all+="$(pw_prefix "$repo" "$open")"$'\n'
  done
  hands="$(parked_merged_owed "$baseline")" || die state-read-failed "" "path=$file" "row=merged"
  # The current fleet's alone: a row clears on the item's next good read,
  # and an item that left the fleet is read no more.
  if ! failing="$(ow_items="$(printf '%s\n' overseer ${ITEMS[@]+"${ITEMS[@]}"})" awk -F'\t' '
      BEGIN { n = split(ENVIRON["ow_items"], a, "\n"); for (i = 1; i <= n; i++) watched[a[i]] = 1 }
      NF == 3 && $1 == "lane-failed" && ($2 in watched) { print "  failing " $2 " " $3 }' \
    <<<"$MAIL_SEEN"$'\n'"$baseline")"; then
    die state-read-failed "" "path=$MAIL_STATE_FILE" "row=lane-failed"
  fi
  [[ -z "$hands" ]] || printf '%s\n' "$hands"
  echo "EVENT heartbeat loops=$MAX_LOOPS interval=${INTERVAL}s since=${SINCE:-none}"
  [[ -z "$failing" ]] || printf '%s\n' "$failing"
  [[ -z "$open_all" ]] || printf '%s' "$open_all"
  if [[ "$ACCOUNT_ROSTER_RC" -ne 0 ]]; then
    echo "account-roster unread"
  else
    echo "account-roster accounts=$(grep -c . <<<"$ACCOUNT_ROSTER" || true)"
    [[ -z "$ACCOUNT_ROSTER" ]] || awk -F'\t' '{ print "account " $3 }' <<<"$ACCOUNT_ROSTER"
  fi
  [[ -z "$VERIFYING_LINES" ]] || printf '%s\n' "$VERIFYING_LINES"
  [[ -z "$OWED_LINES" ]] || printf '%s\n' "$OWED_LINES"
  pr_watch_context
  exit 0
}

# The long pass: the overseer's own pane, one lane snapshot, pr-watch, merged
# items, triage, outside contributions, refresh failures, security alerts,
# lane preparation,
# the lane checks and the accounts, in a forked process. Mail passes go on while it runs, so it
# spools its stdout and stderr and this process prints them whole once it
# ends, staying the one writer of the event protocol. The fork has its own
# copy of every global: the ones the loop below needs back
# are LONG_RETURNS, written to LONG_STATUS, and a global a long-pass check
# sets for this process belongs there. The baselines it committed are what the
# next long pass reads, never this process's copy of them.
LONG_PASSES=0
LONG_RETURNS=(LONG_EVENT LONG_FAILED OVERSEER_SUCCEEDED OVERSEER_STOP PW_PASSES PW_RC PW_EVENT
  PW_OUT PW_ERR LANE_PROBE_NOTED OVERSEER_NOTED ACCOUNT_ROSTER ACCOUNT_ROSTER_RC OWED_LINES VERIFYING_LINES)
long_pass() {
  local i state_file
  PASS_EVENT=0
  PASS_FAILED=0
  for i in "${!REPOS[@]}"; do
    state_file="$(pw_state_file "${REPOS[$i]}")"
    PW_SEEN[$i]=""
    [[ ! -f "$state_file" ]] || PW_SEEN[$i]="$(cat -- "$state_file")" \
      || die state-read-failed "" "path=$state_file"
  done
  overseer_marks_reset
  # No event consumer advances its baseline after this pass observes the
  # overseer exited or walled. A later live pass or the successor receives
  # that work.
  if check_overseer; then
    check_merged
    check_terminal_lanes
    observe_lanes
    check_pr_watch
    check_triage
    check_outside_contribution
    check_refresh
    check_main_push
    check_security_alerts
    check_prepare
    check_start_stall
    account_roster_read || true
    check_lane_stall
    check_lane_long
    check_lanes
    check_accounts
    owed_read
    check_report
  fi
  # Under names of their own, so sourcing them cannot overwrite the news this
  # process's mail passes found.
  LONG_EVENT="$PASS_EVENT"
  LONG_FAILED="$PASS_FAILED"
  local name
  for name in "${LONG_RETURNS[@]}"; do printf '%s=%q\n' "$name" "${!name}"; done >"$LONG_STATUS"
}
# The fork gets a scratch directory and temp-file tag of its own: both passes
# run at once, and one shared would have each read the other's tool errors and
# a die in one discard the other's staged baselines. The start is committed
# last before the fork, on a fresh clock: the turn's trails the mail pass and
# the credential check, and a run dying on that check leaves the pass due.
long_start() {
  github_ready
  rm -f -- "$LONG_STATUS" "$LONG_DONE"
  mkdir -p -- "$WORK_DIR/long" || die state-directory-create-failed "" "path=$WORK_DIR/long"
  local started
  started="$(date -u +%s)" || die time-failed "" "clock=UTC"
  mail_row_commit "$(lane_row_set long-pass "$MAIL_SEEN" fleet "$started")"
  LONG_DUE=$((started + INTERVAL))
  ( WORK_DIR="$WORK_DIR/long"; PW_TMP_TAG="$$-long"; trap 'touch "$LONG_DONE"' EXIT; long_pass ) \
    >"$LONG_OUT" 2>"$LONG_ERR" &
  LONG_PID=$!
}
# Takes an ended long pass in: its lines out, its answers back; `wait` blocks
# until it ends. A pass that died has said why on its own stderr, and this
# process exits with its status, as it did when the checks ran here.
long_collect() { # [wait]
  local rc=0
  [[ -n "$LONG_PID" ]] || return 0
  [[ "${1:-}" == wait || -e "$LONG_DONE" ]] || return 0
  long_drain || rc=$?
  [[ "$rc" -eq 0 ]] || exit "$rc"
  long_status_load || die long-pass-unfinished "" "path=$LONG_STATUS"
  LONG_PASSES=$((LONG_PASSES + 1))
  [[ "$LONG_EVENT" -eq 0 ]] || PASS_EVENT=1
  [[ "$LONG_FAILED" -eq 0 ]] || PASS_FAILED=1
  MAIL_OWED=1
}

# Whether a long pass starts now: none in flight, fewer than --max-loops run,
# and --interval gone by since the start long_start kept, in this run or an
# earlier one. A run with news ends at run_end before a later turn reaches
# here, so a long pass due on the turn the news came is the last one. With
# every repository named by --repo, GitHub calls follow the interval, except
# while the credential check fails: no pass starts, and each run probes auth
# again, once per --repeat.
LONG_DUE=0
long_due() {
  local last
  [[ -z "$LONG_PID" && "$LONG_PASSES" -lt "$MAX_LOOPS" ]] || return 1
  if ! last="$(lane_row_get long-pass "$MAIL_SEEN" fleet)"; then
    die state-read-failed "" "path=$MAIL_STATE_FILE" "row=long-pass"
  fi
  LONG_DUE="$PASS_NOW"
  [[ ! "$last" =~ ^[0-9]+$ ]] || LONG_DUE=$((last + INTERVAL))
  [[ "$PASS_NOW" -ge "$LONG_DUE" ]]
}

# Whether the overseer's pane reads down now, before every mail pass: no
# mailbox is read then, so that mail waits for a successor or a live overseer. Down is the verdict
# overseer_judge gives the long pass, on this pass's own pane reading. A
# walled screen's account judgement is reused while the banner stays the one
# it judged and --interval has not gone by, so a banner that stands costs one
# judgement an interval, as it does the long pass; a new banner, or an older
# answer, is judged afresh with the memo cleared first. Off tmux, or with a
# pane that cannot be read, nothing is judged and the mail is read, as the
# long pass reads on, except while a long pass is in flight.
OV_WALL_BANNER=""
OV_WALL_AT=""
OV_WALL_VERDICT=live
overseer_down() {
  local pane="${TMUX_PANE:-}" banner=""
  [[ -n "${TMUX:-}" && -n "$pane" ]] || return 1
  # A pane that cannot be read while a long pass is in flight may be one that
  # pass's succession has just closed: the mail waits for that pass to end,
  # which a successor leaves at exit 3 before any mailbox is read.
  if ! overseer_pane_read "$pane"; then
    [[ -n "$LONG_PID" ]]
    return
  fi
  # Both walls ask the account judgement, so both are memoised: a screen wall
  # on its banner, a rows wall on its row.
  if [[ "$OV_STATE" == walled ]]; then
    if [[ "$OV_SOURCE" == rows ]]; then banner="$SESSION_ROW"
    else banner="$(lane_limit_banner "$(pane_below_last_turn "$OV_SCREEN")")" || banner=""; fi
    if [[ -n "$OV_WALL_AT" && "$banner" == "$OV_WALL_BANNER" && $((PASS_NOW - OV_WALL_AT)) -lt "$INTERVAL" ]]; then
      [[ "$OV_WALL_VERDICT" == walled ]]
      return
    fi
    overseer_marks_reset
  fi
  overseer_judge "$pane"
  if [[ "$OV_STATE" == walled ]]; then
    OV_WALL_BANNER="$banner"
    OV_WALL_AT="$PASS_NOW"
    OV_WALL_VERDICT="$OV_VERDICT"
  fi
  [[ "$OV_VERDICT" != live ]]
}

# A tick's sleep, waited on in the background: bash holds a trap until a
# FOREGROUND child returns, and a TERM must reach pass_stop at once.
tick_sleep() { # SECS
  sleep "$1" &
  TICK_SLEEP_PID=$!
  wait "$TICK_SLEEP_PID"
  TICK_SLEEP_PID=""
}
# Until the next mail pass or long pass is due, or the overseer mailbox moves
# off BOX_SEEN. A long pass in flight and the mailbox are checked each second, so
# a long pass's block goes out within a second of its end and a note within a
# second of landing. With no mail interval the mail pass runs once a turn: a
# long pass in flight is waited for, and with none the turn waits for the next
# one to come due.
tick_wait() {
  local now next
  while :; do
    if [[ -n "$LONG_PID" && "$MAIL_INTERVAL" -eq 0 ]]; then
      long_collect wait
      return 0
    fi
    if [[ -n "$LONG_PID" ]]; then
      long_collect
      [[ -n "$LONG_PID" ]] || return 0
    fi
    now="$(date -u +%s)" || die time-failed "" "clock=UTC"
    next="$MAIL_DUE"
    [[ "$MAIL_INTERVAL" -gt 0 ]] || next="$LONG_DUE"
    [[ -n "$LONG_PID" || "$LONG_DUE" -ge "$next" ]] || next="$LONG_DUE"
    [[ "$next" -gt "$now" ]] || return 0
    if [[ "$MAIL_INTERVAL" -eq 0 ]]; then
      tick_sleep "$((next - now))"
      return 0
    fi
    tick_sleep 1
    [[ "$(overseer_box_size)" == "$BOX_SEEN" ]] || return 0
  done
}

# One mail read: every mailbox or, with `overseer`, the overseer's alone. The
# overseer mailbox's size is taken first, so a note landing during the read
# moves it again and wakes the next wait.
mail_turn() { # [overseer]
  BOX_SEEN="$(overseer_box_size)"
  overseer_down || check_mail "$@"
}

# One clock per turn. The stamp a lane's wall is observed on and the
# comparison that decides whether it has lifted are the same reading, so a
# slow pass cannot put them on either side of the reset. A turn that cannot
# read it classifies nothing, here or in triage, so it stops rather than
# carrying an unstamped sighting forward: there is no state below in which a
# row exists without the clock that earned it.
PASS_NOW=""
# Set by any check that printed an event this run, mail or long. Every check
# runs on either way; the run ends once, with the pr-watch context closing the
# block, when no long pass is left in flight.
PASS_EVENT=0
PASS_FAILED=0
PASS_FAILED_ITEMS=""
# The full mail pass is due an interval after the last one started, in this
# run or an earlier one: a run started early on a note to the overseer reads
# that mailbox alone first, and holds the lane mailboxes to their interval.
if ! MAIL_DUE="$(lane_row_get mail-pass "$MAIL_SEEN" fleet)"; then
  die state-read-failed "" "path=$MAIL_STATE_FILE" "row=mail-pass"
fi
if [[ "$MAIL_DUE" =~ ^[0-9]+$ ]]; then MAIL_DUE=$((MAIL_DUE + MAIL_INTERVAL)); else MAIL_DUE=0; fi
# Empty until the first read, so a run's first turn reads the overseer mailbox
# whether or not the full mail pass is due.
BOX_SEEN=""
# Set once this process has read every mailbox. A long pass forked before then
# would take its removed worktrees and failed reads from no read at all, so the
# turn that starts one reads every mailbox first, due or not.
MAIL_FULL=0
# The run's end, asked at the foot of every turn and again once the wait after
# it has taken a long pass in, so a run whose news is out never reads the mail
# or the fleet once more first. Nothing ends while a long pass is in flight.
# The heartbeat reads the mail once more when a long pass ended after the last
# mail pass: an overseer pane that pass read live again has mail waiting that
# the heartbeat's run would otherwise leave to the next.
MAIL_OWED=0
run_end() {
  succession_status
  [[ -z "$SUCCESSION" ]] || exit "$SUCCESSION"
  [[ -z "$LONG_PID" ]] || return 0
  if [[ "$PASS_EVENT" -eq 0 && "$PASS_FAILED" -eq 0 && "$LONG_PASSES" -ge "$MAX_LOOPS" && "$MAIL_OWED" -eq 1 ]]; then
    MAIL_OWED=0
    # A turn of its own: the turn's reading predates the long pass it follows.
    PASS_NOW="$(date -u +%s)" || die time-failed "" "clock=UTC"
    mail_turn
  fi
  if [[ "$PASS_FAILED" -eq 1 ]]; then
    pr_watch_context
    exit 2
  fi
  if [[ "$PASS_EVENT" -eq 1 ]]; then
    [[ -z "$VERIFYING_LINES" ]] || printf '%s\n' "$VERIFYING_LINES"
    pr_watch_context
    exit 0
  fi
  [[ "$LONG_PASSES" -lt "$MAX_LOOPS" ]] || heartbeat
}
while :; do
  # The fleet before the checks that read it, every turn and not only the
  # first: a lane launched, relaunched or closed while this run loops quietly
  # is otherwise outside every mail, banner and pane read until an older lane
  # produces an event and the run returns.
  [[ -z "$STATE_FILE" ]] || { fleet_merge; require_item_helpers; }
  PASS_NOW="$(date -u +%s)" || die time-failed "" "clock=UTC"
  # Mail first, so a long pass forked below starts from the clone roots and
  # removed worktrees this turn has just learned.
  long_now=0
  ! long_due || long_now=1
  if [[ "$PASS_NOW" -ge "$MAIL_DUE" || ( "$long_now" -eq 1 && "$MAIL_FULL" -eq 0 ) ]]; then
    MAIL_DUE=$((PASS_NOW + MAIL_INTERVAL))
    MAIL_OWED=0
    MAIL_FULL=1
    [[ "$MAIL_INTERVAL" -eq 0 ]] || mail_row_commit "$(lane_row_set mail-pass "$MAIL_SEEN" fleet "$PASS_NOW")"
    mail_turn
  elif [[ "$(overseer_box_size)" != "$BOX_SEEN" ]]; then
    mail_turn overseer
  fi
  [[ "$long_now" -eq 0 ]] || long_start
  long_collect
  run_end
  tick_wait
  run_end
done
