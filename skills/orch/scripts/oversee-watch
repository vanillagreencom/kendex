#!/usr/bin/env bash
# oversee-watch blocks until the fleet needs the overseer, reports one wake,
# and exits. The workflow handles every EVENT line and re-runs it.
#
# Pass order: one lane snapshot, pr-watch, merged items, team triage, lane
# classification, heartbeat. Every event carries the
# latest pr-watch context. Live tracker and pane reads remain authoritative;
# persisted state holds only edge keys. Usage, event details, configuration,
# and failure contracts live in usage().

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

usage() {
  cat <<'USAGE'
Usage: oversee-watch [--interval SECS] [--max-loops N] [--since ISO8601]
                     [--item ISSUE_ID]... [--repo OWNER/REPO]...
                     [LANE_WINDOW...]

Blocks until the fleet needs the overseer, then prints one event or one line per
merged and triage item. Re-run after handling it with the live fleet in scope.

Events, checked in this order every pass:
  EVENT pr-watch rc=N        new review-gate attention; reducer output follows
  EVENT merged <PR> <branch> an --item PR merged at or after --since
  EVENT triage <item>        an item created at or after --since that is absent
                             from the first repository's persisted baseline
  EVENT window-gone <lane>   the tmux window no longer exists
  EVENT lane-exited <lane>   `pgrep -P` reports no child under a bare shell on
                             two passes; pane tail follows. An unusable probe
                             is not an answer and keeps the lane watched
  EVENT usage-limit <lane> [<config-dir>] [resets=<utc>]
                             a live harness with no turn in flight shows a
                             limit banner below the last user turn on its screen;
                             pane tail follows.
                             `resets=` carries the reset time the banner
                             states; the wall is still standing. It is absent
                             when the banner states no reset in a shape the
                             harnesses draw OR names a time zone this host
                             cannot resolve. A clause naming a clock and no
                             day is pinned to the first occurrence after the
                             pass this watch first saw the banner on
  EVENT usage-limit-passed <lane> [<config-dir>] resets=<utc>
                             the same banner, naming a reset this watch has
                             itself seen standing and which has since gone by:
                             the screen is remembering a spent window that has
                             reopened. Bump the lane, never park it. A wall it
                             has not seen standing is never this
  EVENT lane-asking <lane>   a question or selection prompt differs from the
                             last one emitted for this lane; pane tail follows
  EVENT idle-after-return <lane>
                             the live harness sits idle on two passes; pane
                             tail follows
  EVENT heartbeat            --max-loops passes with no event; open PRs follow

The latest pr-watch attention lines follow every event when any exist. Triage
reads the live tracker list and rebuilds only acknowledged triage keys in the
first repository's OVERSEE_WATCH_STATE_DIR baseline from kept or canceled
verdicts. Lane prompts use pane and turn.

Options:
  --interval SECS     seconds between passes (default 240)
  --max-loops N       passes before a heartbeat (default 25)
  --since ISO8601     UTC created/merged-at floor, with a Z suffix. Pass the
                      fleet's fixed start time on every run, never "now";
                      LINEAR_TEAM below arms the triage check
  --item ISSUE_ID     live item; repeatable. No values skips merged with a note
  --repo OWNER/REPO   repository; repeatable and case-normalized. The reducer
                      covers all; merged and heartbeat read the first
  LANE_WINDOW...      tmux window names to watch; requires $TMUX

Exit codes:
  0  an EVENT line was printed
  2  usage or global failure: auth, repository, PR, tracker,
     watch-state, or tmux-lane read failed. A state write can fail after its
     event was printed. Pr-watch commits repository baselines in order, so
     earlier repository baselines may already have advanced when a later
     rename fails. Only baselines that did not advance repeat their events

When pr-watch.sh is installed, oversee-watch runs it with --heal on every pass.
Gate-stale dispatches PR_WATCH_WRITER_WORKFLOW, so its credential requires
actions:write. When pr-watch.sh is absent, the step is skipped with one stderr note.

Environment:
  LINEAR_TEAM                 team the triage check reads under --since, from
                              kendex.settings.toml [env] unless the environment
                              sets it. Empty or absent skips triage, said once;
                              with a team a missing tracker CLI or
                              workflow-state exits 2 rather than dropping it
  ORCH_STATE_DIR              workflow-state directory; relative paths join
                              the project root; absolute paths stay unchanged
  OVERSEE_WATCH_PR_WATCH      path to pr-watch.sh
  OVERSEE_WATCH_TRACKER       path to the Linear CLI
  OVERSEE_WATCH_WORKFLOW_STATE path to workflow-state
  PR_WATCH_WRITER_WORKFLOW    workflow dispatched by pr-watch --heal
  OVERSEE_WATCH_STATE_DIR     one baseline file per repository — reducer,
                              triage, lane-asking and usage-limit rows — plus
                              claims/
USAGE
}
die() { echo "oversee-watch: $*" >&2; exit 2; }
need_val() { [[ $# -ge 2 && -n "${2:-}" ]] || die "$1 requires a value"; }

# The one parser. It answers a help request and a bad option itself, so the dry
# run below decides those before any configuration is read, off these arms and
# no second copy of the option arities.
parse_argv() {
  # Every default this parser owns is set HERE, never above the loader: the
  # settings [env] table assigns any name and .env.local is sourced as shell, so
  # a default above the load is whatever the checkout left there for every
  # option the caller did not pass. Settings reach the script through their own
  # OVERSEE_WATCH_* names, resolved after the load.
  # REPOS, ITEMS and LANES are the sharpest case: the loop APPENDS to them.
  INTERVAL=240
  MAX_LOOPS=25
  SINCE=""
  REPOS=()
  ITEMS=()
  LANES=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --interval) need_val "$@"; INTERVAL="$2"; shift 2 ;;
      --interval=*) INTERVAL="${1#--interval=}"; need_val --interval "$INTERVAL"; shift ;;
      --max-loops) need_val "$@"; MAX_LOOPS="$2"; shift 2 ;;
      --max-loops=*) MAX_LOOPS="${1#--max-loops=}"; need_val --max-loops "$MAX_LOOPS"; shift ;;
      --since) need_val "$@"; SINCE="$2"; shift 2 ;;
      --since=*) SINCE="${1#--since=}"; need_val --since "$SINCE"; shift ;;
      --item) need_val "$@"; ITEMS+=("$2"); shift 2 ;;
      --item=*) need_val --item "${1#--item=}"; ITEMS+=("${1#--item=}"); shift ;;
      --repo) need_val "$@"; REPOS+=("$2"); shift 2 ;;
      --repo=*) need_val --repo "${1#--repo=}"; REPOS+=("${1#--repo=}"); shift ;;
      # The bare word too: `help` is an answered form on the sibling orch CLIs,
      # and here it would otherwise be read as a lane window name.
      --help | -h | help) usage; exit 0 ;;
      -*) usage >&2; die "unknown option '$1'" ;;
      *) LANES+=("$1"); shift ;;
    esac
  done
}

# `.env.local` is sourced as shell, so help is answered before the loader runs:
# the dry run is the real parser in a subshell, so nothing it assigns survives
# to be clobbered, and 9 is the only status meaning it reached the end.
parse_rc=0
( parse_argv "$@"; exit 9 ) || parse_rc=$?
[[ "$parse_rc" -eq 9 ]] || exit "$parse_rc"
unset parse_rc

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export PROJECT_ROOT
SKILLS_DIR="$PROJECT_ROOT/.agents/skills"
export SKILLS_DIR
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$PROJECT_ROOT"
# shellcheck source=lib/gh-auth.sh
source "$SCRIPT_DIR/lib/gh-auth.sh"
# shellcheck source=lib/lane-claims.sh
source "$SCRIPT_DIR/lib/lane-claims.sh"
# shellcheck source=lib/pr-watch-pass.sh
source "$SCRIPT_DIR/lib/pr-watch-pass.sh"
PR_WATCH="${OVERSEE_WATCH_PR_WATCH:-$SKILLS_DIR/review-gate/scripts/pr-watch.sh}"
TRACKER="${OVERSEE_WATCH_TRACKER:-$SKILLS_DIR/linear/scripts/linear.sh}"
WORKFLOW_STATE="${OVERSEE_WATCH_WORKFLOW_STATE:-$SCRIPT_DIR/workflow-state}"
WORKFLOW_STATE_DIR="${ORCH_STATE_DIR:-$PROJECT_ROOT/tmp}"
case "$WORKFLOW_STATE_DIR" in
  /*) ;;
  *) WORKFLOW_STATE_DIR="$PROJECT_ROOT/$WORKFLOW_STATE_DIR" ;;
esac
WORKFLOW_STATE_ARGS=(--state-dir "$WORKFLOW_STATE_DIR")
PW_STATE_DIR="${OVERSEE_WATCH_STATE_DIR:-$PROJECT_ROOT/tmp/oversee-watch}"

# One state-file class, and only one: the per-repo reducer baseline. Triage
# keys and lane-asking fingerprints are rows in the first repository's file,
# never a file of their own. This makes the directory exist before any of them
# is read. The live pane capture remains authoritative.
watch_state_init() {
  mkdir -p "$PW_STATE_DIR" \
    || die "could not create the oversee-watch state directory $PW_STATE_DIR (set OVERSEE_WATCH_STATE_DIR)"
  [[ -w "$PW_STATE_DIR" ]] \
    || die "the oversee-watch state directory $PW_STATE_DIR is not writable (set OVERSEE_WATCH_STATE_DIR)"
}

# Lane-asking rows in the first repository's baseline, beside the reducer's
# `<pr>\t<kind>` and triage's `triage\t<id>`:
#   lane-asking<TAB><lane><TAB><fingerprint>
# Each helper takes the whole baseline blob and returns the answer or the
# rewritten blob, so a pass mutates a local and commits once.
# One per-lane row per KIND in the watch state: `lane-asking` holds the prompt
# fingerprint a lane was last reported on, `usage-limit` the pass clock this
# watch first saw a lane's limit banner on and the wall it named. Same three
# columns, same file, one set of readers.
lane_row_get() {
  awk -F'\t' -v kind="$1" -v lane="$3" '$1 == kind && NF == 3 && $2 == lane { print $3 }' <<<"$2"
}

lane_row_clear() {
  awk -F'\t' -v kind="$1" -v lane="$3" 'NF && !($1 == kind && NF == 3 && $2 == lane)' <<<"$2"
}

lane_row_set() {
  local rest
  rest="$(lane_row_clear "$1" "$2" "$3")"
  [[ -z "$rest" ]] || printf '%s\n' "$rest"
  printf '%s\t%s\t%s\n' "$1" "$3" "$4"
}

# The same two-phase flush triage uses, on the same file: nothing is written
# when the pass changed nothing, and the event has already printed.
lane_row_commit() {
  [[ "$1" != "${PW_SEEN[0]}" ]] || return 0
  pw_stage_state "$(pw_state_file "${REPOS[0]}")" "$1"
  pw_commit_state "$(pw_state_file "${REPOS[0]}")"
  PW_SEEN[0]="$1"
}

# Every pane predicate lives here, one line each, matched with `grep -E`
# against pane_below_last_turn's slice — never the whole capture.
# A dialog waiting on an answer: the selected numbered row, drawn with each
# harness's marker, and Claude Code's question and key hints.
LANE_ASKING_RE='(❯|›) [0-9]+\. |Do you want to|Enter to select|Esc to cancel'
# The account is spent. Claude Code opens the banner with "You've hit your
# <bucket> limit" / "You've reached your…" and points at /usage-credits; Codex
# prints "Usage limit reached" and its out-of-credits wording. `.` stands in
# for the apostrophe: ASCII in the binaries, typographic once rendered.
USAGE_LIMIT_RE='You.(ve|re) (hit|reached) your [a-z ]*limit|[Uu]sage limit reached|hit usage limits|out of (usage )?credits|/usage-credits'
# The reset clause the same banner line states. Two triggers, both measured:
# Claude Code's `resets` and Codex's ` Try again at `. A clock with no meridiem
# reads as a 24-hour one, following the sibling parser this repository already
# has for the question,
# pi-extensions/pi-agents-tmux/extensions/subagent/rate-limit-reset.ts. Three
# tails, tried in this order. Each names where its shape comes from, and a
# shape with no provenance here has no arm in the grammar:
#   dated    `resets Sep 6, 4pm`, `resets Oct 7, 2027, 11:32am` — measured in
#            Claude Code 2.1.258, whose `Td()` formats through `Intl` in en-US
#            past 24 hours out, lowercases the meridiem and drops the space
#            before it, and prints the year only when it is not the current
#            one. Codex 0.152.1 draws the same tail with an ordinal day and no
#            comma before the clock (`Try again at Sep 6th, 2026 4:30 PM`): its
#            binary carries ` Try again at `, `%b %-d`, the `stndrdth` ordinal
#            table and `, %Y %-I:%M %p` at adjacent offsets. Both are covered.
#   weekday  `resets Thursday 4am` — the weekly-limit copy this repository
#            records as the CLI's own at
#            pi-extensions/pi-claude-bridge/tests/unit-usage-limit.mjs.
#   clock    `resets 9:50am (America/Los_Angeles)` — Claude Code inside 24
#            hours, same formatter, with the IANA zone in parentheses when the
#            banner asks for one. The meridiem is optional so `resets 21:00`
#            reads too: NO harness is measured to draw a 24-hour clock here
#            (`Td()` hardcodes `hour12` in both branches and the `timeFormat`
#            setting reaches only the message-timestamp and UI-clock
#            formatters), and the shape is accepted on the sibling parser's
#            grammar alone.
# Deliberately outside: a duration (Claude's `resets in 5m` for a fast-mode
# cooldown), a weekday with no clock, and a bare number carrying neither
# minutes nor a meridiem. Each leaves the event without a time rather than
# with a guessed one.
USAGE_RESET_LEAD='([Rr]esets|[Tt]ry again at)[[:space:]]+'
USAGE_RESET_CLOCK='([0-9]{1,2})(:([0-9]{2}))?(:[0-9]{2})?[[:space:]]?([AaPp][Mm])?'
USAGE_RESET_DATED_RE="${USAGE_RESET_LEAD}([A-Z][a-z][a-z])[a-z]*[[:space:]]+([0-9]{1,2})[a-z]*,[[:space:]]+(([0-9]{4}),?[[:space:]]+)?${USAGE_RESET_CLOCK}"
USAGE_RESET_WEEKDAY_RE="${USAGE_RESET_LEAD}([A-Z][a-z]+day)[[:space:]]+${USAGE_RESET_CLOCK}"
USAGE_RESET_CLOCK_RE="${USAGE_RESET_LEAD}${USAGE_RESET_CLOCK}"
USAGE_RESET_ANY_RE="${USAGE_RESET_DATED_RE}|${USAGE_RESET_WEEKDAY_RE}|${USAGE_RESET_CLOCK_RE}"
# The zone the banner names, always an IANA path. Trusted only once the host
# resolves it: TZ falls back to UTC for a name it does not know, silently and
# with a zero status, so an unchecked one turns a standing wall into a lifted
# one on a seven-hour error.
USAGE_RESET_ZONE_RE='\(([A-Za-z]+(/[A-Za-z0-9_+-]+)+)\)'
ZONEINFO_DIR="${TZDIR:-/usr/share/zoneinfo}"
# Month and weekday names are matched here rather than through `date`, whose
# `%b`/`%a` follow LC_TIME while its parser reads English only: a host with a
# non-English LC_TIME would round-trip every label into nothing. Every format
# this file hands `date` is numeric for the same reason.
USAGE_RESET_MONTHS='Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'
USAGE_RESET_WEEKDAYS='Monday Tuesday Wednesday Thursday Friday Saturday Sunday'
# A turn in flight: the interrupt hint (both harnesses), the hint shown while
# a foreground shell runs, or the streaming token counter of the status line.
WORKING_RE='to interrupt|to run in background|↓ [0-9][0-9.]*[kKmM]? tokens'
# The marker each harness draws at column 0 for a submitted user message
# echoed into the transcript AND for the composer the lane sits at: Claude
# Code `❯`, Codex `›`. Spelled as an alternation of literals and NEVER as a
# bracket expression: a bracket expression holding a multibyte character is a
# set of its BYTES on every awk without multibyte support — mawk, one-true-awk
# under LC_ALL=C, gawk under LC_ALL=C — where `[❯›]` matches any line opening
# with an E2-lead character, which is most of a transcript.
PANE_MARKER_RE='^❯|^›'
# The live input a lane is sitting at, as opposed to a turn it already took:
# one signature per harness, both measured off a running session.
#   Claude Code draws its composer as the marker then U+00A0, draft or not,
#   and indents its dialog rows, so only the composer reaches column 0.
#   Codex draws its composer, its placeholder, its draft AND its selected
#   dialog row all as the marker, a blank and text — the same shape as a turn —
#   and always draws one of them below the transcript. So every Codex screen
#   ends in a live-input marker line, and its marker alone is the signature.
# The last marker line is the live input when it carries either signature;
# pane_below_last_turn holds the rest of the rule.
# Byte escapes, never `\u`: bash leaves a `\u` escape unexpanded in the C
# locale, and an awk that does not expand one either then matches nothing.
# gawk does expand it, so no test on a gawk runner can catch that spelling.
CLAUDE_COMPOSER_RE=$'^\xe2\x9d\xaf\xc2\xa0'
CODEX_MARKER_RE='^›'

parse_argv "$@"

[[ "$INTERVAL" =~ ^[0-9]+$ ]] || die "--interval must be a non-negative integer (got '$INTERVAL')"
[[ "$MAX_LOOPS" =~ ^[0-9]+$ && "$MAX_LOOPS" -ge 1 ]] || die "--max-loops must be a positive integer (got '$MAX_LOOPS')"
if [[ ${#LANES[@]} -gt 0 && -z "${TMUX:-}" ]]; then
  die "lane windows given (${LANES[*]}) but not inside tmux; drop the lanes or run from the tmux session that owns them"
fi

# `date` under an explicit zone. An empty ZONE leaves TZ alone, which is the
# runner's own zone — the zone a harness banner naming none was drawn in, since
# it was drawn on this host.
tz_date() {
  local zone="$1"
  shift
  if [[ -n "$zone" ]]; then TZ="$zone" date "$@"; else date "$@"; fi
}

# A timestamp → epoch, GNU date first, then BSD/macOS. FMT is the BSD arm's
# input format, which GNU does not need, and ZONE the zone the stamp is written
# in. Both default to the ISO8601 UTC form, which is what every caller but the
# reset-banner parser hands it; UTC is load-bearing there, so a `--since` floor
# is not shifted by the runner's local zone.
to_epoch() {
  local stamp="$1" fmt="${2:-%Y-%m-%dT%H:%M:%SZ}" zone="${3-UTC}"
  tz_date "$zone" -d "$stamp" +%s 2>/dev/null \
    || tz_date "$zone" -j -f "$fmt" "$stamp" +%s 2>/dev/null
}

# The other direction on the same ladder: GNU spells an epoch input `-d @`,
# BSD `-r`.
from_epoch() {
  local epoch="$1" fmt="$2" zone="${3-UTC}"
  tz_date "$zone" -d "@$epoch" +"$fmt" 2>/dev/null \
    || tz_date "$zone" -r "$epoch" +"$fmt" 2>/dev/null
}

# No floor by default: the floor must not move between runs, and a run has no
# way to know when the previous one stopped looking.
SINCE_EPOCH=0
if [[ -n "$SINCE" ]]; then
  [[ "$SINCE" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$ ]] \
    || die "--since '$SINCE' must be a UTC timestamp ending in Z (YYYY-MM-DDTHH:MM:SSZ)"
  SINCE_EPOCH="$(to_epoch "$SINCE")" || die "--since '$SINCE' is not an ISO8601 timestamp (UTC, Z suffix)"
fi

TRIAGE_ENABLED=0
# LINEAR_TEAM decides whether this fleet has a team to triage at all: empty,
# however it was spelled, is a repo that tracks work elsewhere, so triage is
# skipped, named once, and the watch runs on --since for the merged check.
# With a team, triage fails CLOSED: oversee.md § 4 owes a verdict to every
# emitted team item, so a broken install that silently dropped triage would
# drop every new item with it, and each missing dependency names its remedy.
if [[ -n "$SINCE" ]]; then
  if [[ -n "${LINEAR_TEAM:-}" ]]; then
    [[ -x "$TRACKER" ]] \
      || die "tracker CLI not found at $TRACKER; triage needs it (set OVERSEE_WATCH_TRACKER)"
    [[ -x "$WORKFLOW_STATE" ]] \
      || die "workflow-state CLI not found at $WORKFLOW_STATE; triage needs it (set OVERSEE_WATCH_WORKFLOW_STATE)"
    TRIAGE_ENABLED=1
  else
    echo "oversee-watch: LINEAR_TEAM is unset or empty; skipping the team triage check (pr-watch/merged/window/lane-asking checks still run)" >&2
  fi
fi

# The item's head branch is its id lowercased (worktree create's branch name);
# one branch per line, for the jq membership test.
ITEM_BRANCHES=""
for item in ${ITEMS[@]+"${ITEMS[@]}"}; do
  [[ "$item" =~ ^[A-Za-z0-9._-]+$ ]] || die "--item '$item' is not an issue id (issue-N or PROJ-123)"
  ITEM_BRANCHES+="$(printf '%s' "$item" | tr '[:upper:]' '[:lower:]')"$'\n'
done

command -v gh >/dev/null 2>&1 || die "gh CLI not found on PATH"
command -v jq >/dev/null 2>&1 || die "jq not found on PATH"
command -v cksum >/dev/null 2>&1 || die "cksum not found on PATH"

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT

# Auth ladder (gates.md § Waiter auth ladder): a stale env token yields to the
# keyring; when neither works, the env token is dropped so the project's
# GH_BOT_TOKEN can be selected — the last candidate. Never proceed
# unauthenticated: an unauthenticated `gh pr list` would report an empty
# fleet, not a failure.
orch_sanitize_gh_env
if ! orch_github_auth_status; then
  unset GH_TOKEN GITHUB_TOKEN
  { orch_load_env_bot_token "$PROJECT_ROOT" && orch_github_auth_status; } \
    || die "no working GitHub auth path (tried env GH_TOKEN/GITHUB_TOKEN, gh keyring, project GH_BOT_TOKEN). Run: gh auth login"
fi

if [[ ${#REPOS[@]} -eq 0 ]]; then
  resolved="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)"
  [[ -n "$resolved" ]] || die "could not resolve the repository (gh repo view failed); pass --repo OWNER/REPO"
  REPOS=("$resolved")
fi
# One canonical spelling per repository, settled once, HERE — below the default
# resolution, the one point every path's REPOS has reached its final value, so
# a repo `gh repo view` reported in its registered casing is canonicalized too.
# GitHub reads a repo path case-insensitively, so lowercasing each entry leaves
# the duplicate check, the owner the merged check matches on, the reducer's
# state-file name, the repo it prefixes its lines with and the GH_REPO it
# exports all naming one string. A repeat would reduce that repository twice
# into one state file and report it twice in the context, so it is a usage
# error, named as the caller spelled it.
repos_seen=""
for repo_i in "${!REPOS[@]}"; do
  repo_raw="${REPOS[$repo_i]}"
  REPOS[$repo_i]="$(printf '%s' "$repo_raw" | tr '[:upper:]' '[:lower:]')"
  if grep -qxF -- "${REPOS[$repo_i]}" <<<"$repos_seen"; then
    die "--repo '$repo_raw' given twice; name each repository once"
  fi
  repos_seen+="${REPOS[$repo_i]}"$'\n'
done
# The reducer covers every --repo; the merged check and the heartbeat's open-PR
# list are per-item and per-fleet queries against the first, the repo the
# overseer's own items live in.
REPO="${REPOS[0]}"
REPO_OWNER="${REPO%%/*}"

if [[ -x "$PR_WATCH" ]]; then
  :
else
  echo "oversee-watch: pr-watch.sh not found at $PR_WATCH; skipping the review-gate reducer (merged/triage/window/lane-asking checks still run)" >&2
  PR_WATCH=""
fi
if [[ -z "$ITEM_BRANCHES" ]]; then
  echo "oversee-watch: no --item given; skipping the merged check (pr-watch/triage/window/lane-asking checks still run)" >&2
fi
if [[ ${#REPOS[@]} -gt 1 ]]; then
  # Only the checks this run actually performs: the two notes above may have
  # just reported the reducer or the merged check skipped.
  if [[ -n "$ITEM_BRANCHES" ]]; then
    repo_note="the merged check and the heartbeat's open-PR list read $REPO only"
  else
    repo_note="the heartbeat's open-PR list reads $REPO only"
  fi
  [[ -z "$PR_WATCH" ]] || repo_note="the reducer covers ${REPOS[*]}; $repo_note"
  echo "oversee-watch: $repo_note" >&2
fi

watch_state_init
pw_init_state

check_merged() {
  [[ -n "$ITEM_BRANCHES" ]] || return 0
  local errf="$WORK_DIR/merged.err" branch list hit hits=""
  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    list="$(gh pr list --repo "$REPO" --head "$branch" --state merged --limit 10 --json number,headRefName,headRepositoryOwner,mergedAt 2>"$errf")" \
      || die "gh pr list --state merged failed for $REPO (--head $branch): $(cat "$errf")"
    # Reject a fork's PR on the same branch name.
    hit="$(jq -r --arg branch "$branch" --arg owner "$REPO_OWNER" --argjson since "$SINCE_EPOCH" '
      [ .[]
        | select(.headRefName | ascii_downcase == $branch)
        | select(((.headRepositoryOwner.login // "") | ascii_downcase) == $owner)
        | select(.mergedAt != null)
        | select((.mergedAt | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) >= $since)
        | "EVENT merged \(.number) \(.headRefName)" ]
      | .[]' <<<"$list" 2>"$errf")" \
      || die "could not parse gh pr list output for $REPO ($branch): $(cat "$errf")"
    [[ -z "$hit" ]] || hits+="$hit"$'\n'
  done <<<"$ITEM_BRANCHES"
  hits="${hits%$'\n'}"
  [[ -n "$hits" ]] || return 0
  printf '%s\n' "$hits"
  pr_watch_context
  exit 0
}

check_triage() {
  [[ "$TRIAGE_ENABLED" -eq 1 ]] || return 0
  local errf="$WORK_DIR/triage.err" now age days out ids verdicts pr_keys triage_keys="" seen id new_ids="" next rc=0
  verdicts="$("$WORKFLOW_STATE" ${WORKFLOW_STATE_ARGS[@]+"${WORKFLOW_STATE_ARGS[@]}"} get oversee '.triaged // [] | map(select(.verdict == "kept" or .verdict == "canceled") | .issue) | .[]' 2>"$errf")" || rc=$?
  [[ "$rc" -eq 0 ]] \
    || die "could not read the fleet triage verdict log (rc=$rc): $(cat "$errf")"
  verdicts="$(awk 'NF && !seen[$0]++' <<<"$verdicts")"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    [[ "$id" =~ ^[A-Za-z0-9._-]+$ ]] \
      || die "fleet triage verdict log returned an invalid issue id: '$id'"
    [[ -z "$triage_keys" ]] || triage_keys+=$'\n'
    triage_keys+="triage"$'\t'"$id"
  done <<<"$verdicts"
  pr_keys="$(awk -F'\t' '$1 != "triage" { print }' <<<"${PW_SEEN[0]}")"
  if [[ -n "$pr_keys" && -n "$triage_keys" ]]; then
    next="$pr_keys"$'\n'"$triage_keys"
  else
    next="$pr_keys$triage_keys"
  fi
  if [[ "$next" != "${PW_SEEN[0]}" ]]; then
    pw_stage_state "$(pw_state_file "${REPOS[0]}")" "$next"
    pw_commit_state "$(pw_state_file "${REPOS[0]}")"
    PW_SEEN[0]="$next"
  fi
  now="$(date -u +%s)" || die "could not read the current UTC time for triage"
  age=$((now - SINCE_EPOCH))
  [[ "$age" -ge 0 ]] || age=0
  # Linear's live list accepts whole-day windows. Round up, then apply the
  # exact ISO floor below so the wider server query cannot mint an old event.
  days=$((age / 86400 + 1))
  out="$("$TRACKER" issues list --team "$LINEAR_TEAM" --created-since "${days}d" --max --format=safe 2>"$errf")" || rc=$?
  [[ "$rc" -eq 0 ]] \
    || die "tracker list failed for team $LINEAR_TEAM (rc=$rc): $(cat "$errf")"
  ids="$(jq -r --argjson since "$SINCE_EPOCH" '
    def created_epoch: sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601;
    if type != "array" then error("tracker output is not an array") else . end
    | [ .[]
      | if ((.created_at? | type) == "string" and (.created_at | length) > 0)
        then . else error("tracker item has no created_at") end
      | select((.created_at | created_epoch) >= $since)
      | if ((.id? | type) == "string" and (.id | test("^[A-Za-z0-9._-]+$")))
        then .id else error("tracker item has no valid id") end ]
    | unique[]
  ' <<<"$out" 2>"$errf")" \
    || die "could not parse tracker list output for team $LINEAR_TEAM: $(cat "$errf")"
  seen="$(awk -F'\t' '$1 == "triage" && NF == 2 { print $2 }' <<<"${PW_SEEN[0]}")"
  while IFS= read -r id; do
    [[ -n "$id" ]] || continue
    grep -qxF -- "$id" <<<"$seen" || new_ids+="$id"$'\n'
  done <<<"$ids"
  [[ -n "$new_ids" ]] || return 0
  new_ids="${new_ids%$'\n'}"
  while IFS= read -r id; do
    echo "EVENT triage $id"
  done <<<"$new_ids"
  pr_watch_context
  exit 0
}

# The last 40 non-empty pane lines. `|| true`: an all-blank pane is a grep
# miss, and under pipefail that would abort the script mid-event.
pane_tail() { grep -v '^[[:space:]]*$' <<<"$1" | tail -40 || true; }

# A login shell reports itself as `-bash`; strip the dash before matching.
is_bare_shell() {
  case "${1#-}" in
    bash|zsh|fish|sh|dash) return 0 ;;
  esac
  return 1
}

# Does the pane's process have a child? A foreground shell does not mean the
# lane is over: a lane started by typing the wrapper at an interactive prompt
# (`hclaude --resume <id>`, the normal way to resume) keeps that shell as the
# pane process and the harness as its child, so the pane reads `fish` for the
# lane's whole life. Only a shell with nothing under it is finished.
#
# Returns 0 for a child and 1 for none — pgrep's own two answers — and 2 for
# anything else, which is not an answer at all: pgrep documents 2 for a syntax
# error and 3 for a fatal one, and a pgrep missing from PATH leaves 127. The
# raw status is kept in LANE_PROBE_RC so the note can name what happened.
# `ps --ppid` is procps-only and BSD ps rejects it with status 1, the same
# status it uses for no match, which read every pane as childless. One probe
# per bare-shell lane per pass; no walking of the tree below.
LANE_PROBE_RC=0
pane_has_child() {
  LANE_PROBE_RC=0
  pgrep -P "$1" >/dev/null 2>&1 || LANE_PROBE_RC=$?
  [[ "$LANE_PROBE_RC" -le 1 ]] || return 2
  return "$LANE_PROBE_RC"
}

# Said once per run, not per pass: the answer does not change under the watch.
LANE_PROBE_NOTED=0
note_probe_unusable() {
  [[ "$LANE_PROBE_NOTED" -eq 0 ]] || return 0
  LANE_PROBE_NOTED=1
  echo "oversee-watch: could not list the children of the pane behind '$1' (pgrep -P exited $LANE_PROBE_RC); shell panes stay watched rather than reported exited" >&2
}

# The pane lines strictly below the last user turn — the whole pane when the
# screen holds none. A banner the lane has since taken another turn past is
# scrollback, not the account's state now: after a reset the old banner stays
# on the visible screen, and reporting it every pass buries the live lanes.
#
# The boundary is the last marker line, unless that line is the live input the
# lane is sitting at — in which case it is the marker line before it.
#
# A marker line that is the LAST line of the capture counts as live input
# whatever it looks like. Nothing sits after it, so the wider window costs
# nothing there, and the fallback is what keeps an unrecognized composer from
# becoming the boundary itself: that would empty the slice and turn
# usage-limit into a silent no-op for the lane. Unrecognized fails toward a
# stale banner, never toward silence.
pane_turn_slice() {
  awk -v mode="$2" -v marker="$PANE_MARKER_RE" -v composer="$CLAUDE_COMPOSER_RE" -v codex="$CODEX_MARKER_RE" '
    { line[NR] = $0; if ($0 ~ marker) { prev = last; last = NR } }
    END {
      live = (last > 0 && (last == NR || line[last] ~ composer || line[last] ~ codex))
      turn = live ? prev : last
      first = mode == "before" ? 1 : turn + 1
      final = mode == "before" ? turn : NR
      for (i = first; i <= final; i++) print line[i]
    }
  ' <<<"$1"
}

pane_below_last_turn() { pane_turn_slice "$1" below; }
pane_turn_identity() { pane_turn_slice "$1" before | cksum; }

# One-based index of WORD in LIST, empty when it is absent.
word_index() {
  awk -v want="$2" '{ for (i = 1; i <= NF; i++) if ($i == want) { print i; exit } }' <<<"$1"
}

# The wall the banner LINES name, as a key: the tail that matched, the clock,
# the date or weekday it carries, and the zone. Empty when no line states a
# reset in a shape the grammar reads, or when it names a zone this host cannot
# resolve. Nothing here reads a clock, so a pass can compare the key it sees
# now against the one it stored without the answer moving under it.
usage_reset_key() {
  local line rc=0 hour min meridiem mon day year weekday zone
  line="$(grep -Em1 -- "$USAGE_RESET_ANY_RE" <<<"$1")" || rc=$?
  [[ "$rc" -le 1 ]] \
    || die "could not search a limit banner for its reset clause (grep exited $rc)"
  [[ -n "$line" ]] || return 0
  mon=""; day=""; year=""; weekday=""
  # Longest tail first: a dated clause also matches the bare-clock tail from
  # its own clock onwards, and a weekday one would lose its day.
  if [[ "$line" =~ $USAGE_RESET_DATED_RE ]]; then
    mon="${BASH_REMATCH[2]}"; day="${BASH_REMATCH[3]}"; year="${BASH_REMATCH[5]}"
    hour="${BASH_REMATCH[6]}"; min="${BASH_REMATCH[8]}"; meridiem="${BASH_REMATCH[10]}"
  elif [[ "$line" =~ $USAGE_RESET_WEEKDAY_RE ]]; then
    weekday="${BASH_REMATCH[2]}"
    hour="${BASH_REMATCH[3]}"; min="${BASH_REMATCH[5]}"; meridiem="${BASH_REMATCH[7]}"
  elif [[ "$line" =~ $USAGE_RESET_CLOCK_RE ]]; then
    hour="${BASH_REMATCH[2]}"; min="${BASH_REMATCH[4]}"; meridiem="${BASH_REMATCH[6]}"
  else
    return 0
  fi
  # A run of digits carrying neither minutes nor a meridiem is a number that
  # follows the word, not a clock: `resets 2026-09-03` would otherwise put the
  # `20` of the year on the event as an hour. Every shape above carries one or
  # the other, so nothing attested is lost.
  [[ -n "$min" || -n "$meridiem" ]] || return 0
  # 12-hour to 24-hour; a clock with no meridiem is already a 24-hour one, as
  # it is for the sibling parser. Nothing range-checks the result: every clock
  # is handed to `date` on resolution, which rejects an impossible one, and a
  # rejected candidate leaves the event without a time — the same answer a
  # range check would give, from the one implementation that has to agree with
  # itself.
  hour=$((10#$hour)); min=$((10#${min:-0}))
  case "$meridiem" in
    [Pp]*) [[ "$hour" -eq 12 ]] || hour=$((hour + 12)) ;;
    [Aa]*) [[ "$hour" -ne 12 ]] || hour=0 ;;
  esac
  # Read AFTER every field above: the match overwrites BASH_REMATCH. A zone the
  # host cannot resolve leaves no key at all, so no wall is stamped and no time
  # is computed in the UTC that TZ would silently fall back to.
  zone=""
  if [[ "$line" =~ $USAGE_RESET_ZONE_RE ]]; then
    zone="${BASH_REMATCH[1]}"
    [[ -r "$ZONEINFO_DIR/$zone" ]] || return 0
  fi
  # One field layout for every tail — kind, month, day, year, clock, zone —
  # so one `read` splits any key and an unused column is simply empty.
  if [[ -n "$mon" ]]; then
    mon="$(word_index "$USAGE_RESET_MONTHS" "$mon")"
    [[ -n "$mon" ]] || return 0
    printf 'dated|%s|%s|%s|%02d:%02d|%s\n' "$mon" "$((10#$day))" "$year" "$hour" "$min" "$zone"
  elif [[ -n "$weekday" ]]; then
    weekday="$(word_index "$USAGE_RESET_WEEKDAYS" "$weekday")"
    [[ -n "$weekday" ]] || return 0
    printf 'dow|%s|||%02d:%02d|%s\n' "$weekday" "$hour" "$min" "$zone"
  else
    printf 'clock||||%02d:%02d|%s\n' "$hour" "$min" "$zone"
  fi
}

# KEY resolved to an epoch, empty when `date` rejects the clock it carries.
#
# A dated clause names its own day and resolves outright; SINCE supplies only
# the year a banner omits, which it omits only when that year is the current
# one. Every other clause names a time of day and no day, and is pinned to its
# first occurrence STRICTLY AFTER SINCE — the pass on which this watch first
# saw the banner. The day is then OBSERVED rather than inferred, which is what
# makes a reset behind us a fact rather than the likelier of two readings: a
# banner first seen at 16:00 saying `resets 21:00` is tonight's, and the same
# banner still there tomorrow is still tonight's, spent.
#
# Days are enumerated calendrically off local NOON, never by adding 86400 to an
# epoch: a DST shift moves local midnight, so a day added that way can skip the
# next calendar day altogether or repeat the current one.
usage_reset_epoch() {
  local key="$1" since="$2" kind mon day year stamp zone dow anchor cand d last
  IFS='|' read -r kind mon day year stamp zone <<<"$key"
  if [[ "$kind" == dated ]]; then
    [[ -n "$year" ]] || year="$(from_epoch "$since" '%Y' "$zone")" || return 0
    to_epoch "$(printf '%s-%02d-%02d %s' "$year" "$mon" "$day" "$stamp")" \
      '%Y-%m-%d %H:%M' "$zone" || return 0
    return 0
  fi
  # A weekday clause may sit a whole week out; a bare clock is today or
  # tomorrow, measured from the pass that first saw it.
  dow=""
  last=1
  if [[ "$kind" == dow ]]; then
    dow="$mon"
    last=7
  fi
  anchor="$(to_epoch "$(from_epoch "$since" '%Y-%m-%d' "$zone") 12:00" '%Y-%m-%d %H:%M' "$zone")" \
    || return 0
  for ((d = 0; d <= last; d++)); do
    if [[ -n "$dow" && "$(from_epoch "$((anchor + d * 86400))" '%u' "$zone")" != "$dow" ]]; then
      continue
    fi
    cand="$(to_epoch "$(from_epoch "$((anchor + d * 86400))" '%Y-%m-%d' "$zone") $stamp" \
      '%Y-%m-%d %H:%M' "$zone")" || continue
    [[ "$cand" -gt "$since" ]] || continue
    printf '%s\n' "$cand"
    return 0
  done
}

# Watch-list positions whose harness read as exited on the previous pass.
LANE_SHELL_SEEN=""
# Watch-list positions that sat at an idle harness prompt on the previous pass.
LANE_IDLE_SEEN=""

# LANE_OBS columns are watch-list position, ready/gone, pane pid, current
# command, and server-plus-pane occurrence key. Capture bytes live in the file
# for that position. Position, not a filename slug, keeps arbitrary tmux window
# names from sharing one snapshot and classifying each other's screens.
LANE_OBS=""
lane_field() { awk -F'\t' -v i="$2" -v field="$3" '$1 == i { print $field }' <<<"$1"; }
lane_state() { lane_field "$1" "$2" 2; }
lane_pane_file() { printf '%s/pane.%s' "$WORK_DIR" "$1"; }

# Build one immutable lane snapshot for the pass. The final capture path is
# the success marker; a failed redirect leaves only a removed scratch file.
observe_lanes() {
  LANE_OBS=""
  [[ ${#LANES[@]} -gt 0 ]] || return 0
  local existing lane pane below key prefix prior obs pid cmd capture errf i=0 state="${PW_SEEN[0]}"
  local reset_key banner banner_rc
  existing="$(tmux list-windows -F '#W' 2>&1)" || die "tmux list-windows failed: $existing"
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    capture="$(lane_pane_file "$i")"
    rm -f "$capture" "$capture.$$.tmp"
    if ! grep -qxF -- "$lane" <<<"$existing"; then
      LANE_OBS+="$i"$'\t'"gone"$'\t\t\t\n'
      state="$(lane_row_clear lane-asking "$state" "$lane")"
      continue
    fi
    errf="$WORK_DIR/lane-probe.$i.err"
    obs="$(tmux display-message -p -t "$lane" '#{pane_pid} #{pane_current_command}' 2>"$errf")" \
      || die "pane command probe failed for '$lane': $(cat "$errf")"
    [[ "$obs" =~ ^[0-9]+[[:blank:]]+[^[:space:]] ]] \
      || die "pane command probe returned a malformed result for '$lane': ${obs:-<empty>}"
    key="$(tmux display-message -p -t "$lane" '#{pid} #{pane_id}' 2>"$errf")" \
      || die "pane identity probe failed for '$lane': $(cat "$errf")"
    [[ "$key" =~ ^[0-9]+[[:blank:]]+%[^[:space:]]+$ ]] \
      || die "pane identity probe returned a malformed result for '$lane': ${key:-<empty>}"
    if ! tmux capture-pane -t "$lane" -p >"$capture.$$.tmp" 2>"$errf"; then
      rm -f "$capture.$$.tmp"
      die "pane capture failed for '$lane': $(cat "$errf")"
    fi
    mv "$capture.$$.tmp" "$capture" || die "could not publish the pane capture behind '$lane'"
    pid="${obs%%[[:blank:]]*}"
    cmd="${obs#*[[:blank:]]}"
    LANE_OBS+="$i"$'\t'"ready"$'\t'"$pid"$'\t'"$cmd"$'\t'"$key"$'\n'
    pane="$(cat -- "$capture")"
    below="$(pane_below_last_turn "$pane")"
    prior="$(lane_row_get lane-asking "$state" "$lane")"
    prefix="${key}|$(pane_turn_identity "$pane")|"
    if ! grep -Eq -- "$LANE_ASKING_RE" <<<"$below" \
       || [[ -n "$prior" && "$prior" != "$prefix"* ]]; then
      state="$(lane_row_clear lane-asking "$state" "$lane")"
    fi
    # When this pass first sees a wall, stamp it: the row is what later lets a
    # dayless clause name a day. Stamped HERE, on every lane, rather than
    # where the event is emitted, because that path leaves on the first walled
    # lane and a second one would never be observed at all. The row is the
    # sighting and nothing more; whether the banner is the account speaking is
    # the emit path's one question, asked there once for both events. A stamp
    # belongs to ONE wall, so it goes when the banner goes and when the banner
    # starts naming a different reset.
    banner=""
    banner_rc=0
    banner="$(grep -E -- "$USAGE_LIMIT_RE" <<<"$below")" || banner_rc=$?
    [[ "$banner_rc" -le 1 ]] \
      || die "could not search the pane behind '$lane' for a limit banner (grep exited $banner_rc)"
    reset_key="$(usage_reset_key "$banner")"
    if [[ -n "$reset_key" && "$(lane_row_get usage-limit "$state" "$lane")" != *" $reset_key" ]]; then
      state="$(lane_row_set usage-limit "$state" "$lane" "$PASS_NOW $reset_key")"
    elif [[ -z "$reset_key" ]]; then
      state="$(lane_row_clear usage-limit "$state" "$lane")"
    fi
  done
  lane_row_commit "$state"
}

check_lanes() {
  [[ ${#LANES[@]} -gt 0 ]] || return 0
  local lane pane below cmd pid state probe i states="" shell_now="" idle_now="" asking_now="" claims="" claimed pane_key
  local seen reset_at reset_utc reset_note event
  local asking_state="${PW_SEEN[0]}" next_state fingerprint prior turn_identity
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_state "$LANE_OBS" "$i")" != ready ]]; then
      echo "EVENT window-gone $lane"
      pr_watch_context
      exit 0
    fi
  done
  # One liveness read and one pane capture per lane per pass: a lane's kind is
  # decided from a single observation, never from two screens taken apart. The
  # pid leads the format so a command carrying a space cannot shift the split.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    pid="$(lane_field "$LANE_OBS" "$i" 3)"
    cmd="$(lane_field "$LANE_OBS" "$i" 4)"
    state=live
    if is_bare_shell "$cmd"; then
      probe=0; pane_has_child "$pid" || probe=$?
      # 2 is a probe that could not run, never an answer: a lane the watch
      # cannot judge stays watched, since a wrong lane-exited retires a
      # working lane while a missed one costs a pass.
      case "$probe" in
        1) state=exited ;;
        2) note_probe_unusable "$lane" ;;
      esac
    fi
    states+="$i"$'\t'"$state"$'\n'
  done
  # A lane window outlives its harness: open-terminal runs claude/codex inside
  # a shell, so a session that hit its limit, crashed, or quit leaves the
  # shell in the foreground — a window that exists, a pane that matches no
  # question prompt, and a slot held until someone looks. A bare shell with
  # nothing running under it IS that lane, finished; the pane tail carries
  # why. Two consecutive passes: a live harness can hold a childless shell in
  # the foreground for one poll, and relaunching a working lane costs more
  # than one interval.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_state "$states" "$i")" == exited ]]; then
      shell_now+="$i"$'\n'
      if grep -qxF -- "$i" <<<"$LANE_SHELL_SEEN"; then
        echo "EVENT lane-exited $lane"
        pane="$(cat -- "$(lane_pane_file "$i")")"
        [[ -z "$pane" ]] || pane_tail "$pane"
        next_state="$(lane_row_clear lane-asking "$asking_state" "$lane")"
        lane_row_commit "$next_state"
        pr_watch_context
        exit 0
      fi
    fi
  done
  LANE_SHELL_SEEN="$shell_now"
  # The harness is still running and the account is spent: every lane on that
  # account dies with it, so the config dir is the actionable part and a live
  # claim is where it is recorded. Before `lane-asking` — a limit banner can sit
  # above a stale prompt, and the account is the news. One pass: a banner is
  # terminal for that account window, not a screen a poll can catch mid-draw.
  # Only below the last user turn: a banner the lane has since worked past is
  # the screen remembering a spent window that has since reset.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_state "$states" "$i")" == exited ]]; then continue; fi
    pane="$(cat -- "$(lane_pane_file "$i")")"
    below="$(pane_below_last_turn "$pane")"
    # ONE predicate for both usage-limit events, on the path they share: a
    # turn in flight is not the account speaking, and limit-shaped text a lane
    # prints while working would otherwise be nudged or moved. Their
    # false-positive class is identical, so the check cannot live on one of
    # them.
    if grep -Eq -- "$USAGE_LIMIT_RE" <<<"$below" && ! grep -Eq -- "$WORKING_RE" <<<"$below"; then
      # The detail is a nicety; a claim store this process cannot read must
      # not take down the event that carries the pane tail.
      claims="$(lane_claims_read "$(lane_claims_dir "$PROJECT_ROOT")" || true)"
      # Claims are kept for every live tmux server, and a window NAME is
      # unique only within a session: the account is resolved on the pane
      # actually captured here — `<server pid> <pane id>`, the same key the
      # claim's liveness uses — so no other lane can answer for it.
      pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
      claimed="$(lane_claims_config_dir "$claims" "${pane_key%% *}" "${pane_key##* }")"
      if [[ -z "$claimed" && -n "$claims" ]]; then
        echo "oversee-watch: no live lane claim for the pane behind '$lane'; the usage-limit event names no account" >&2
      fi
      # The banner states when the wall lifts, and that decides which event
      # this is. A reset already behind us means the lane is parked against a
      # window that has since reopened — the harness will not notice on its
      # own — so it is bumped, not waited on. The wall's day comes from the
      # row observe_lanes stamped, never from the banner: with no row, or with
      # a reset `date` would not resolve, the plain event goes out with no
      # time on it and the lane is parked. `resets=` is keyed rather than
      # positional because the config dir before it is optional.
      seen="$(lane_row_get usage-limit "$asking_state" "$lane")"
      reset_at=""
      [[ -z "$PASS_NOW" || -z "$seen" ]] || reset_at="$(usage_reset_epoch "${seen#* }" "${seen%% *}")"
      event=usage-limit
      reset_note=""
      reset_utc=""
      [[ -z "$reset_at" ]] || reset_utc="$(from_epoch "$reset_at" '%Y-%m-%dT%H:%M:%SZ' || true)"
      if [[ -n "$reset_utc" ]]; then
        reset_note=" resets=$reset_utc"
        [[ "$reset_at" -gt "$PASS_NOW" ]] || event=usage-limit-passed
      fi
      echo "EVENT $event $lane${claimed:+ $claimed}$reset_note"
      [[ -z "$pane" ]] || pane_tail "$pane"
      pr_watch_context
      exit 0
    fi
  done
  # A pane keeps its last screen, so neither a stale prompt under a bare shell
  # nor a dialog answered passes ago is a live question. A current prompt is
  # keyed by its pane slice across watch invocations: emit it once, clear the
  # key when it disappears, and emit again only when the prompt changes.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_state "$states" "$i")" == exited ]]; then continue; fi
    pane="$(cat -- "$(lane_pane_file "$i")")"
    below="$(pane_below_last_turn "$pane")"
    if grep -Eq -- "$LANE_ASKING_RE" <<<"$below"; then
      asking_now+="$i"$'\n'
      pane_key="$(lane_field "$LANE_OBS" "$i" 5)"
      turn_identity="$(pane_turn_identity "$pane")"
      fingerprint="${pane_key}|${turn_identity}|$(printf '%s' "$below" | cksum)"
      prior="$(lane_row_get lane-asking "$asking_state" "$lane")"
      asking_state="$(lane_row_set lane-asking "$asking_state" "$lane" "$fingerprint")"
      if [[ "$fingerprint" == "$prior" ]]; then continue; fi
      echo "EVENT lane-asking $lane"
      pane_tail "$pane"
      lane_row_commit "$asking_state"
      pr_watch_context
      exit 0
    else
      asking_state="$(lane_row_clear lane-asking "$asking_state" "$lane")"
    fi
  done
  lane_row_commit "$asking_state"
  # The round is over and nobody is driving: the harness is up, at its input
  # prompt, with nothing in flight. Two consecutive passes, because the screen
  # between a finished tool call and the next one reads the same.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_state "$states" "$i")" == exited ]]; then continue; fi
    if grep -qxF -- "$i" <<<"$asking_now"; then continue; fi
    pane="$(cat -- "$(lane_pane_file "$i")")"
    if grep -Eq -- "$WORKING_RE" <<<"$(pane_below_last_turn "$pane")"; then continue; fi
    if ! grep -Eq -- "$PANE_MARKER_RE" <<<"$(pane_below_last_turn "$pane")"; then continue; fi
    idle_now+="$i"$'\n'
    if grep -qxF -- "$i" <<<"$LANE_IDLE_SEEN"; then
      echo "EVENT idle-after-return $lane"
      pane_tail "$pane"
      pr_watch_context
      exit 0
    fi
  done
  LANE_IDLE_SEEN="$idle_now"
}

heartbeat() {
  local errf="$WORK_DIR/open.err" open
  open="$(gh pr list --repo "$REPO" --state open --limit 50 --json number,headRefName,title \
    --jq '.[] | "\(.number)\t\(.headRefName)\t\(.title)"' 2>"$errf")" \
    || die "gh pr list --state open failed for $REPO: $(cat "$errf")"
  echo "EVENT heartbeat loops=$MAX_LOOPS interval=${INTERVAL}s since=${SINCE:-none}"
  [[ -z "$open" ]] || printf '%s\n' "$open"
  pr_watch_context
  exit 0
}

loop=0
# One clock per pass. The stamp a lane's wall is observed on and the comparison
# that decides whether it has lifted are the same reading, so a slow pass
# cannot put them on either side of the reset.
PASS_NOW=""
while :; do
  loop=$((loop + 1))
  PASS_NOW="$(date -u +%s || true)"
  observe_lanes
  check_pr_watch
  check_merged
  check_triage
  check_lanes
  [[ "$loop" -lt "$MAX_LOOPS" ]] || heartbeat
  sleep "$INTERVAL"
done
