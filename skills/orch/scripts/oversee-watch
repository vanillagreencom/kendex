#!/usr/bin/env bash
# oversee-watch — block until the fleet needs the overseer, then report ONE
# event and exit. The overseer handles the event and re-runs this command.
#
# Each pass, in order:
#   1. pr-watch   the review-gate reducer over every open PR (when installed;
#                 absent → one stderr note at start, step skipped). An event
#                 when a `<pr> <kind>` line is NEW against the previous pass —
#                 and on pass 1, against the baseline this fleet's previous
#                 run persisted (one state file per repo + --since under
#                 $OVERSEE_WATCH_STATE_DIR), so attention that arrives between
#                 two runs is still an event. No state file (the fleet's first
#                 run) → attention present at start is a baseline (noted once
#                 on stderr), never a preempting event, so a PR that sits at
#                 threads-open for an hour cannot starve the lane checks.
#                 The latest reducer output is appended to every event.
#   2. merged     an --item's PR (head branch = the item id, lowercased, in
#                 this repo — never a fork's same-named branch; one --head
#                 query per item — no listing window to miss) merged at or
#                 after --since
#   3. window-gone a listed tmux lane window no longer exists
#   4. lane-exited a listed lane's window is alive but its pane holds a bare
#                 shell that `pgrep -P` reports NO child under, on two
#                 consecutive passes — the harness under it exited (session
#                 limit, crash, quit) and the slot is free. A lane resumed by
#                 typing the wrapper at an interactive prompt keeps the shell
#                 as the pane process and the harness as its child, so the
#                 child is what tells them apart. A probe that cannot run at
#                 all is not an answer: that lane stays watched, noted once on
#                 stderr
#   5. usage-limit a listed lane whose harness has not exited shows the
#                 account's limit banner on its screen — one pass, and the
#                 claimed config dir when a live lane claim names the window
#   6. question   a question/selection prompt
#   7. idle-after-return a listed lane whose harness has not exited sits at its
#                 composer with no work in flight on two consecutive passes
#   8. heartbeat  after --max-loops passes with no event
# Every pane check reads only the lines below the last user turn, 5-7 and any
# added later: above it is scrollback the lane has already worked past.
#
# Output on the first event: `EVENT <kind> ...` on stdout — one line, except
# `merged`, which prints one `EVENT merged` line per merged item so the
# overseer advances every finished lane in one wake — followed by supporting
# lines (the pane tail, or the open PR list for a heartbeat), then the latest
# pr-watch attention lines when there are any.
# Silence on stdout never means "fine": every exit path prints an EVENT line
# or a stderr error.
#
# Usage: oversee-watch [--interval SECS] [--max-loops N] [--since ISO8601]
#                      [--item ISSUE_ID]... [--repo OWNER/REPO] [LANE_WINDOW...]
#
# Exit codes:
#   0  an EVENT line was printed
#   2  usage error, or a global failure (gh not authenticated, repo
#      unresolvable, PR listing failed, pr-watch failed with no per-PR lines,
#      the pr-watch state directory or file unusable, lanes given outside tmux)
#
# Environment:
#   OVERSEE_WATCH_PR_WATCH   path to the pr-watch reducer (default:
#                            $PROJECT_ROOT/.agents/skills/review-gate/scripts/pr-watch.sh)
#   OVERSEE_WATCH_STATE_DIR  directory holding the persisted pr-watch baseline,
#                            one file per fleet, rewritten after every pass,
#                            and open-terminal's lane claims under claims/
#                            (default: $PROJECT_ROOT/tmp/oversee-watch); a
#                            directory that cannot be created or written is a
#                            hard failure, never a silent fallback
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
SKILLS_DIR="$PROJECT_ROOT/.agents/skills"
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$PROJECT_ROOT"
# shellcheck source=lib/gh-auth.sh
source "$SCRIPT_DIR/lib/gh-auth.sh"
# shellcheck source=lib/lane-claims.sh
source "$SCRIPT_DIR/lib/lane-claims.sh"
# shellcheck source=lib/merge-queue-events.sh
source "$SCRIPT_DIR/lib/merge-queue-events.sh"
PR_WATCH="${OVERSEE_WATCH_PR_WATCH:-$SKILLS_DIR/review-gate/scripts/pr-watch.sh}"
PW_STATE_DIR="${OVERSEE_WATCH_STATE_DIR:-$PROJECT_ROOT/tmp/oversee-watch}"

# Every pane predicate lives here, one line each, matched with `grep -E`
# against pane_below_last_turn's slice — never the whole capture.
# A dialog waiting on an answer: the selected numbered row, drawn with each
# harness's marker, and Claude Code's question and key hints.
QUESTION_RE='(❯|›) [0-9]+\. |Do you want to|Enter to select|Esc to cancel'
# The account is spent. Claude Code opens the banner with "You've hit your
# <bucket> limit" / "You've reached your…" and points at /usage-credits; Codex
# prints "Usage limit reached" and its out-of-credits wording. `.` stands in
# for the apostrophe: ASCII in the binaries, typographic once rendered.
USAGE_LIMIT_RE='You.(ve|re) (hit|reached) your [a-z ]*limit|[Uu]sage limit reached|hit usage limits|out of (usage )?credits|/usage-credits'
# A turn in flight: the interrupt hint (both harnesses), the hint shown while
# a foreground shell runs, or the streaming token counter of the status line.
WORKING_RE='to interrupt|to run in background|↓ [0-9][0-9.]*[kKmM]? tokens'
# The marker each harness draws at column 0 for a submitted user message
# echoed into the transcript AND for the composer the lane sits at: Claude
# Code `❯`, Codex `›`. Spelled as an alternation of literals and NEVER as a
# bracket expression: a bracket expression holding a multibyte character is a
# set of its BYTES on every awk without multibyte support — mawk, one-true-awk
# under LC_ALL=C, gawk under LC_ALL=C — where `[❯›]` matches any line opening
# with an E2-lead character, which is most of a transcript.
PANE_MARKER_RE='^❯|^›'
# The live input a lane is sitting at, as opposed to a turn it already took:
# one signature per harness, both measured off a running session.
#   Claude Code draws its composer as the marker then U+00A0, draft or not,
#   and indents its dialog rows, so only the composer reaches column 0.
#   Codex draws its composer, its placeholder, its draft AND its selected
#   dialog row all as the marker, a blank and text — the same shape as a turn —
#   and always draws one of them below the transcript. So every Codex screen
#   ends in a live-input marker line, and its marker alone is the signature.
# The last marker line is the live input when it carries either signature;
# pane_below_last_turn holds the rest of the rule.
# Byte escapes, never `\u`: bash leaves a `\u` escape unexpanded in the C
# locale, and an awk that does not expand one either then matches nothing.
# gawk does expand it, so no test on a gawk runner can catch that spelling.
CLAUDE_COMPOSER_RE=$'^\xe2\x9d\xaf\xc2\xa0'
CODEX_MARKER_RE='^›'

INTERVAL=240
MAX_LOOPS=25
SINCE=""
REPO=""
ITEMS=()
LANES=()

usage() {
  cat <<'USAGE'
Usage: oversee-watch [--interval SECS] [--max-loops N] [--since ISO8601]
                     [--item ISSUE_ID]... [--repo OWNER/REPO] [LANE_WINDOW...]

Blocks until the fleet needs the overseer, prints one event — an `EVENT
<kind> ...` line, or for `merged` one `EVENT merged` line per merged item —
plus supporting lines, and exits 0. Re-run it after handling the event, with
the lanes still live: drop a merged item and a dead lane's window, keep
--since as the fleet's start.

Events, checked in this order every pass:
  EVENT pr-watch rc=N        the review-gate reducer reported a `<pr> <kind>`
                             attention line that is NEW against the previous
                             pass — on pass 1, against the baseline this
                             fleet's previous run persisted, so attention that
                             arrived between two runs is an event (its output
                             follows). On the fleet's first run, attention
                             already present is a baseline (one stderr note),
                             so it can never preempt the checks below;
                             skipped with a stderr note when pr-watch.sh is
                             not installed
  EVENT merged <PR> <branch> an --item's PR merged at or after --since (one
                             line per PR; the item's head branch is its id,
                             lowercased, in this repo — a fork's PR on the
                             same branch name is not the item's)
  EVENT merge-verdict <item> <watch-id>  wake its lane to consume the lifecycle
  EVENT window-gone <lane>   a listed tmux window no longer exists
  EVENT lane-exited <lane>   the window is alive but the pane's current
                             command is a bare shell (bash/zsh/fish/sh/dash,
                             login spellings too) AND `pgrep -P` reports no
                             child of its `#{pane_pid}`, on two consecutive
                             passes: the harness under it exited — session
                             limit, crash, quit — and the lane's slot is free
                             (last 40 non-empty pane lines follow, carrying
                             why). A lane resumed by typing the wrapper at a
                             shell prompt keeps that shell as the pane
                             process, so a bare shell WITH a child is a live
                             lane. A pgrep that cannot run is not an answer:
                             the lane stays watched, noted once on stderr
  EVENT usage-limit <lane> [<config-dir>]
                             the harness has not exited and the pane shows the
                             account's limit banner
                             (`You've hit your … limit`, `/usage-credits`,
                             `Usage limit reached`, out of credits) below the
                             last user turn on its screen: the account is
                             spent and every lane on it follows. One pass — a
                             banner is terminal for that account window — and
                             only below that turn, so a banner the lane has
                             since worked past is old news. The config dir is
                             appended when a live lane claim names this window
                             (last 40 non-empty pane lines follow)
  EVENT question <lane>      a question/selection prompt below the last user
                             turn (last 40 non-empty pane lines follow)
  EVENT idle-after-return <lane>
                             the harness has not exited and its pane sits at
                             the composer (Claude Code `❯` or Codex `›` at
                             column 0) with no work in flight (no interrupt
                             hint, no background-shell hint, no streaming token
                             counter) on two consecutive passes: the round is
                             over and the lane is waiting on the overseer
                             (last 40 non-empty pane lines follow)
  EVENT heartbeat            --max-loops passes with no event (open PR list
                             follows: number, head branch, title)

Every event is followed by the latest pr-watch attention lines when there are
any (`pr-watch rc=N` header), so the overseer sees the reducer's state on
each wake even when it is not the event.

Options:
  --interval SECS     seconds between passes (default 240)
  --max-loops N       passes before a heartbeat (default 25)
  --since ISO8601     merged-at floor for `merged`, UTC with a `Z` suffix,
                      e.g. 2026-08-15T12:00:00Z (default: none). Pass the
                      fleet's start time on every run — the same value each
                      time, never "now" — so a merge landing between two runs
                      is still reported by the next one
  --item ISSUE_ID     a live item (issue-N or PROJ-123); repeatable. `merged`
                      fires only for these items' PRs; none given → the
                      merged check is skipped with a stderr note
  --repo OWNER/REPO   repository (default: gh repo view)
  LANE_WINDOW...      tmux window names to watch; requires $TMUX

Exit codes:
  0  an EVENT line was printed
  2  usage error, or a global failure: gh not authenticated, repo
     unresolvable, PR listing failed, pr-watch failed with no per-PR lines,
     the pr-watch state directory or file unusable, lanes given outside tmux

Environment:
  OVERSEE_WATCH_PR_WATCH   path to pr-watch.sh (default: the review-gate
                           skill's install under .agents/skills)
  OVERSEE_WATCH_STATE_DIR  directory holding the persisted pr-watch baseline,
                           one file per fleet (repo + --since), rewritten
                           after every pass, and open-terminal's lane claims
                           under claims/ (default: PROJECT_ROOT/tmp/
                           oversee-watch); a directory that cannot be created
                           or written exits 2
USAGE
}

die() { echo "oversee-watch: $*" >&2; exit 2; }
need_val() { [[ $# -ge 2 && -n "${2:-}" ]] || die "$1 requires a value"; }

while [[ $# -gt 0 ]]; do
  case "$1" in
    --interval) need_val "$@"; INTERVAL="$2"; shift 2 ;;
    --interval=*) INTERVAL="${1#--interval=}"; shift ;;
    --max-loops) need_val "$@"; MAX_LOOPS="$2"; shift 2 ;;
    --max-loops=*) MAX_LOOPS="${1#--max-loops=}"; shift ;;
    --since) need_val "$@"; SINCE="$2"; shift 2 ;;
    --since=*) SINCE="${1#--since=}"; shift ;;
    --item) need_val "$@"; ITEMS+=("$2"); shift 2 ;;
    --item=*) ITEMS+=("${1#--item=}"); shift ;;
    --repo) need_val "$@"; REPO="$2"; shift 2 ;;
    --repo=*) REPO="${1#--repo=}"; shift ;;
    --help|-h) usage; exit 0 ;;
    -*) usage >&2; die "unknown option '$1'" ;;
    *) LANES+=("$1"); shift ;;
  esac
done

[[ "$INTERVAL" =~ ^[0-9]+$ ]] || die "--interval must be a non-negative integer (got '$INTERVAL')"
[[ "$MAX_LOOPS" =~ ^[0-9]+$ && "$MAX_LOOPS" -ge 1 ]] || die "--max-loops must be a positive integer (got '$MAX_LOOPS')"
if [[ ${#LANES[@]} -gt 0 && -z "${TMUX:-}" ]]; then
  die "lane windows given (${LANES[*]}) but not inside tmux; drop the lanes or run from the tmux session that owns them"
fi

# ISO8601 (UTC, Z suffix) → epoch, GNU date first, then BSD/macOS. -u is
# load-bearing so the timestamp is not shifted by the local zone.
to_epoch() {
  date -u -d "$1" +%s 2>/dev/null || date -u -j -f "%Y-%m-%dT%H:%M:%SZ" "$1" +%s 2>/dev/null
}

# No floor by default: the floor must not move between runs, and a run has no
# way to know when the previous one stopped looking.
SINCE_EPOCH=0
if [[ -n "$SINCE" ]]; then
  SINCE_EPOCH="$(to_epoch "$SINCE")" || die "--since '$SINCE' is not an ISO8601 timestamp (UTC, Z suffix)"
fi

# The item's head branch is its id lowercased (worktree create's branch name);
# one branch per line, for the jq membership test.
ITEM_BRANCHES=""
for item in ${ITEMS[@]+"${ITEMS[@]}"}; do
  [[ "$item" =~ ^[A-Za-z0-9._-]+$ ]] || die "--item '$item' is not an issue id (issue-N or PROJ-123)"
  ITEM_BRANCHES+="$(printf '%s' "$item" | tr '[:upper:]' '[:lower:]')"$'\n'
done

command -v gh >/dev/null 2>&1 || die "gh CLI not found on PATH"
command -v jq >/dev/null 2>&1 || die "jq not found on PATH"

WORK_DIR="$(mktemp -d)"
trap 'rm -rf "$WORK_DIR"' EXIT

# Auth ladder (gates.md § Waiter auth ladder): a stale env token yields to the
# keyring; when neither works, the env token is dropped so the project's
# GH_BOT_TOKEN can be selected — the last candidate. Never proceed
# unauthenticated: an unauthenticated `gh pr list` would report an empty
# fleet, not a failure.
orch_sanitize_gh_env
if ! orch_github_auth_status; then
  unset GH_TOKEN GITHUB_TOKEN
  { orch_load_env_bot_token "$PROJECT_ROOT" && orch_github_auth_status; } \
    || die "no working GitHub auth path (tried env GH_TOKEN/GITHUB_TOKEN, gh keyring, project GH_BOT_TOKEN). Run: gh auth login"
fi

if [[ -z "$REPO" ]]; then
  REPO="$(gh repo view --json nameWithOwner --jq .nameWithOwner 2>/dev/null || true)"
  [[ -n "$REPO" ]] || die "could not resolve the repository (gh repo view failed); pass --repo OWNER/REPO"
fi
# GitHub logins are case-insensitive and --repo's casing is the caller's.
REPO_OWNER="$(printf '%s' "${REPO%%/*}" | tr '[:upper:]' '[:lower:]')"

if [[ -x "$PR_WATCH" ]]; then
  :
else
  echo "oversee-watch: pr-watch.sh not found at $PR_WATCH; skipping the review-gate reducer (merged/window/question checks still run)" >&2
  PR_WATCH=""
fi
if [[ -z "$ITEM_BRANCHES" ]]; then
  echo "oversee-watch: no --item given; skipping the merged check (pr-watch/window/question checks still run)" >&2
fi

# The latest pr-watch result, appended to every event's output.
PW_RC=0
PW_OUT=""
PW_ERR=""
# `<pr>\t<kind>` keys present on the previous pass (the rising-edge baseline).
PW_SEEN=""
PW_PASSES=0
PW_STATE_FILE=""
PW_HAD_STATE=0

# The overseer exits this watch on every event and re-runs it, so the baseline
# outlives the process: one file per fleet, keyed on the repo and the --since
# value every run of that fleet passes. Loaded as pass 1's baseline, rewritten
# after every pass.
pw_slug() { printf '%s' "$1" | tr -c 'A-Za-z0-9._-' '_'; }

pw_save_state() {
  [[ -n "$PW_STATE_FILE" ]] || return 0
  local tmp="$PW_STATE_FILE.$$.tmp"
  { printf '%s' "$1" > "$tmp" && mv -f "$tmp" "$PW_STATE_FILE"; } \
    || die "could not write the pr-watch state file $PW_STATE_FILE (set OVERSEE_WATCH_STATE_DIR)"
}

if [[ -n "$PR_WATCH" ]]; then
  mkdir -p "$PW_STATE_DIR" \
    || die "could not create the pr-watch state directory $PW_STATE_DIR (set OVERSEE_WATCH_STATE_DIR)"
  [[ -w "$PW_STATE_DIR" ]] \
    || die "the pr-watch state directory $PW_STATE_DIR is not writable (set OVERSEE_WATCH_STATE_DIR)"
  PW_STATE_FILE="$PW_STATE_DIR/$(pw_slug "$REPO")__$(pw_slug "${SINCE:-none}")"
  if [[ -f "$PW_STATE_FILE" ]]; then
    PW_SEEN="$(cat "$PW_STATE_FILE" 2>/dev/null)" \
      || die "cannot read the pr-watch state file: $PW_STATE_FILE (set OVERSEE_WATCH_STATE_DIR)"
    PW_HAD_STATE=1
  fi
fi

pr_watch_context() {
  [[ "$PW_RC" -ne 0 ]] || return 0
  echo "pr-watch rc=$PW_RC"
  [[ -z "$PW_OUT" ]] || printf '%s\n' "$PW_OUT"
  [[ -z "$PW_ERR" ]] || printf '%s\n' "$PW_ERR"
}

# Every step exits on its first event; the loop body only reaches `sleep`
# when nothing needs the overseer.
check_pr_watch() {
  [[ -n "$PR_WATCH" ]] || return 0
  local errf="$WORK_DIR/pr-watch.err" keys new_keys="" key
  PW_RC=0
  PW_OUT="$(GH_REPO="$REPO" "$PR_WATCH" 2>"$errf")" || PW_RC=$?
  PW_ERR="$(cat "$errf")"
  PW_PASSES=$((PW_PASSES + 1))
  if [[ "$PW_RC" -eq 0 ]]; then
    PW_SEEN=""
    pw_save_state ""
    return 0
  fi
  # Non-zero with no per-PR lines is pr-watch's GLOBAL failure shape
  # (pr-watch.sh --help): it reports on stderr only, and nothing here can be
  # trusted.
  [[ -n "$PW_OUT" ]] || die "pr-watch failed (rc=$PW_RC) with no per-PR lines: ${PW_ERR:-<no stderr>}"
  keys="$(awk -F'\t' 'NF >= 3 { print $1 "\t" $3 }' <<<"$PW_OUT")"
  while IFS= read -r key; do
    [[ -n "$key" ]] || continue
    grep -qxF -- "$key" <<<"$PW_SEEN" || new_keys+="$key"$'\n'
  done <<<"$keys"
  # Rising edge against the previous pass only: a line that clears and later
  # recurs is news again. Pass 1 compares against the persisted baseline.
  PW_SEEN="$keys"
  pw_save_state "$keys"
  [[ -n "$new_keys" ]] || return 0
  if [[ "$PW_PASSES" -eq 1 && "$PW_HAD_STATE" -eq 0 ]]; then
    echo "oversee-watch: pr-watch attention present at start (rc=$PW_RC, $(grep -c . <<<"$new_keys") line(s)) — the fleet's baseline, reported with the next event; only NEW lines become events" >&2
    return 0
  fi
  echo "EVENT pr-watch rc=$PW_RC"
  printf '%s\n' "$PW_OUT"
  [[ -z "$PW_ERR" ]] || printf '%s\n' "$PW_ERR"
  exit 0
}

check_merged() {
  [[ -n "$ITEM_BRANCHES" ]] || return 0
  local errf="$WORK_DIR/merged.err" branch list hit hits=""
  while IFS= read -r branch; do
    [[ -n "$branch" ]] || continue
    list="$(gh pr list --repo "$REPO" --head "$branch" --state merged --limit 10 --json number,headRefName,headRepositoryOwner,mergedAt 2>"$errf")" \
      || die "gh pr list --state merged failed for $REPO (--head $branch): $(cat "$errf")"
    # Reject a fork's PR on the same branch name.
    hit="$(jq -r --arg branch "$branch" --arg owner "$REPO_OWNER" --argjson since "$SINCE_EPOCH" '
      [ .[]
        | select(.headRefName | ascii_downcase == $branch)
        | select(((.headRepositoryOwner.login // "") | ascii_downcase) == $owner)
        | select(.mergedAt != null)
        | select((.mergedAt | sub("\\.[0-9]+Z$"; "Z") | fromdateiso8601) >= $since)
        | "EVENT merged \(.number) \(.headRefName)" ]
      | .[]' <<<"$list" 2>"$errf")" \
      || die "could not parse gh pr list output for $REPO ($branch): $(cat "$errf")"
    [[ -z "$hit" ]] || hits+="$hit"$'\n'
  done <<<"$ITEM_BRANCHES"
  hits="${hits%$'\n'}"
  [[ -n "$hits" ]] || return 0
  printf '%s\n' "$hits"
  pr_watch_context
  exit 0
}

# The last 40 non-empty pane lines. `|| true`: an all-blank pane is a grep
# miss, and under pipefail that would abort the script mid-event.
pane_tail() { grep -v '^[[:space:]]*$' <<<"$1" | tail -40 || true; }

# A login shell reports itself as `-bash`; strip the dash before matching.
is_bare_shell() {
  case "${1#-}" in
    bash|zsh|fish|sh|dash) return 0 ;;
  esac
  return 1
}

# Does the pane's process have a child? A foreground shell does not mean the
# lane is over: a lane started by typing the wrapper at an interactive prompt
# (`hclaude --resume <id>`, the normal way to resume) keeps that shell as the
# pane process and the harness as its child, so the pane reads `fish` for the
# lane's whole life. Only a shell with nothing under it is finished.
#
# Returns 0 for a child and 1 for none — pgrep's own two answers — and 2 for
# anything else, which is not an answer at all: pgrep documents 2 for a syntax
# error and 3 for a fatal one, and a pgrep missing from PATH leaves 127. The
# raw status is kept in LANE_PROBE_RC so the note can name what happened.
# `ps --ppid` is procps-only and BSD ps rejects it with status 1, the same
# status it uses for no match, which read every pane as childless. One probe
# per bare-shell lane per pass; no walking of the tree below.
LANE_PROBE_RC=0
pane_has_child() {
  LANE_PROBE_RC=0
  pgrep -P "$1" >/dev/null 2>&1 || LANE_PROBE_RC=$?
  [[ "$LANE_PROBE_RC" -le 1 ]] || return 2
  return "$LANE_PROBE_RC"
}

# Said once per run, not per pass: the answer does not change under the watch.
LANE_PROBE_NOTED=0
note_probe_unusable() {
  [[ "$LANE_PROBE_NOTED" -eq 0 ]] || return 0
  LANE_PROBE_NOTED=1
  echo "oversee-watch: could not list the children of the pane behind '$1' (pgrep -P exited $LANE_PROBE_RC); shell panes stay watched rather than reported exited" >&2
}

# The pane lines strictly below the last user turn — the whole pane when the
# screen holds none. A banner the lane has since taken another turn past is
# scrollback, not the account's state now: after a reset the old banner stays
# on the visible screen, and reporting it every pass buries the live lanes.
#
# The boundary is the last marker line, unless that line is the live input the
# lane is sitting at — in which case it is the marker line before it.
#
# A marker line that is the LAST line of the capture counts as live input
# whatever it looks like. Nothing sits after it, so the wider window costs
# nothing there, and the fallback is what keeps an unrecognized composer from
# becoming the boundary itself: that would empty the slice and turn
# usage-limit into a silent no-op for the lane. Unrecognized fails toward a
# stale banner, never toward silence.
pane_below_last_turn() {
  awk -v marker="$PANE_MARKER_RE" -v composer="$CLAUDE_COMPOSER_RE" -v codex="$CODEX_MARKER_RE" '
    { line[NR] = $0; if ($0 ~ marker) { prev = last; last = NR } }
    END {
      live = (last > 0 && (last == NR || line[last] ~ composer || line[last] ~ codex))
      turn = live ? prev : last
      for (i = turn + 1; i <= NR; i++) print line[i]
    }
  ' <<<"$1"
}

# Watch-list positions whose harness read as exited on the previous pass.
LANE_SHELL_SEEN=""
# Watch-list positions that sat at an idle harness prompt on the previous pass.
LANE_IDLE_SEEN=""

# The pass's snapshot of one lane: whether its harness has exited, and the
# file holding its pane capture. Every check reads the same observation, keyed
# on the lane's position in the watch list — a tmux window name can carry any
# character, and two names that differ only outside a filename-safe set would
# otherwise share one snapshot and classify each other's screens.
lane_state() { awk -F'\t' -v i="$2" '$1 == i { print $2 }' <<<"$1"; }
lane_pane_file() { printf '%s/pane.%s' "$WORK_DIR" "$1"; }

check_lanes() {
  [[ ${#LANES[@]} -gt 0 ]] || return 0
  local existing lane pane obs cmd pid state probe i states="" shell_now="" idle_now="" claims="" claimed pane_key
  existing="$(tmux list-windows -F '#W' 2>&1)" || die "tmux list-windows failed: $existing"
  for lane in "${LANES[@]}"; do
    if ! grep -qxF -- "$lane" <<<"$existing"; then
      echo "EVENT window-gone $lane"
      pr_watch_context
      exit 0
    fi
  done
  # One liveness read and one pane capture per lane per pass: a lane's kind is
  # decided from a single observation, never from two screens taken apart. The
  # pid leads the format so a command carrying a space cannot shift the split.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if ! obs="$(tmux display-message -p -t "$lane" '#{pane_pid} #{pane_current_command}' 2>/dev/null)" \
       || [[ ! "$obs" =~ ^[0-9]+[[:blank:]]+[^[:space:]] ]]; then
      echo "EVENT window-gone $lane"
      pr_watch_context
      exit 0
    fi
    if ! tmux capture-pane -t "$lane" -p >"$(lane_pane_file "$i")" 2>/dev/null; then
      echo "EVENT window-gone $lane"
      pr_watch_context
      exit 0
    fi
    pid="${obs%%[[:blank:]]*}"
    cmd="${obs#*[[:blank:]]}"
    state=live
    if is_bare_shell "$cmd"; then
      probe=0; pane_has_child "$pid" || probe=$?
      # 2 is a probe that could not run, never an answer: a lane the watch
      # cannot judge stays watched, since a wrong lane-exited retires a
      # working lane while a missed one costs a pass.
      case "$probe" in
        1) state=exited ;;
        2) note_probe_unusable "$lane" ;;
      esac
    fi
    states+="$i"$'\t'"$state"$'\n'
  done
  # A lane window outlives its harness: open-terminal runs claude/codex inside
  # a shell, so a session that hit its limit, crashed, or quit leaves the
  # shell in the foreground — a window that exists, a pane that matches no
  # question prompt, and a slot held until someone looks. A bare shell with
  # nothing running under it IS that lane, finished; the pane tail carries
  # why. Two consecutive passes: a live harness can hold a childless shell in
  # the foreground for one poll, and relaunching a working lane costs more
  # than one interval.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_state "$states" "$i")" == exited ]]; then
      shell_now+="$i"$'\n'
      if grep -qxF -- "$i" <<<"$LANE_SHELL_SEEN"; then
        echo "EVENT lane-exited $lane"
        pane="$(cat -- "$(lane_pane_file "$i")")"
        [[ -z "$pane" ]] || pane_tail "$pane"
        pr_watch_context
        exit 0
      fi
    fi
  done
  LANE_SHELL_SEEN="$shell_now"
  # The harness is still running and the account is spent: every lane on that
  # account dies with it, so the config dir is the actionable part and a live
  # claim is where it is recorded. Before `question` — a limit banner can sit
  # above a stale prompt, and the account is the news. One pass: a banner is
  # terminal for that account window, not a screen a poll can catch mid-draw.
  # Only below the last user turn: a banner the lane has since worked past is
  # the screen remembering a spent window that has since reset.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_state "$states" "$i")" == exited ]]; then continue; fi
    pane="$(cat -- "$(lane_pane_file "$i")")"
    if grep -Eq -- "$USAGE_LIMIT_RE" <<<"$(pane_below_last_turn "$pane")"; then
      # The detail is a nicety; a claim store this process cannot read must
      # not take down the event that carries the pane tail.
      claims="$(lane_claims_read "$(lane_claims_dir "$PROJECT_ROOT")" || true)"
      # Claims are kept for every live tmux server, and a window NAME is
      # unique only within a session: the account is resolved on the pane
      # actually captured here — `<server pid> <pane id>`, the same key the
      # claim's liveness uses — so no other lane can answer for it.
      pane_key="$(tmux display-message -p -t "$lane" '#{pid} #{pane_id}' 2>/dev/null || true)"
      claimed="$(lane_claims_config_dir "$claims" "${pane_key%% *}" "${pane_key##* }")"
      if [[ -z "$claimed" && -n "$claims" ]]; then
        echo "oversee-watch: no live lane claim for the pane behind '$lane'; the usage-limit event names no account" >&2
      fi
      echo "EVENT usage-limit $lane${claimed:+ $claimed}"
      [[ -z "$pane" ]] || pane_tail "$pane"
      pr_watch_context
      exit 0
    fi
  done
  # A pane keeps its last screen, so neither a stale prompt under a bare shell
  # nor a dialog answered passes ago is a live question, and reporting either
  # starves the events below it: lane-exited's second pass, idle-after-return.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_state "$states" "$i")" == exited ]]; then continue; fi
    pane="$(cat -- "$(lane_pane_file "$i")")"
    if grep -Eq -- "$QUESTION_RE" <<<"$(pane_below_last_turn "$pane")"; then
      echo "EVENT question $lane"
      pane_tail "$pane"
      pr_watch_context
      exit 0
    fi
  done
  # The round is over and nobody is driving: the harness is up, at its input
  # prompt, with nothing in flight. Two consecutive passes, because the screen
  # between a finished tool call and the next one reads the same.
  i=0
  for lane in "${LANES[@]}"; do
    i=$((i + 1))
    if [[ "$(lane_state "$states" "$i")" == exited ]]; then continue; fi
    pane="$(cat -- "$(lane_pane_file "$i")")"
    if grep -Eq -- "$WORKING_RE" <<<"$(pane_below_last_turn "$pane")"; then continue; fi
    if ! grep -Eq -- "$PANE_MARKER_RE" <<<"$(pane_below_last_turn "$pane")"; then continue; fi
    idle_now+="$i"$'\n'
    if grep -qxF -- "$i" <<<"$LANE_IDLE_SEEN"; then
      echo "EVENT idle-after-return $lane"
      pane_tail "$pane"
      pr_watch_context
      exit 0
    fi
  done
  LANE_IDLE_SEEN="$idle_now"
}

heartbeat() {
  local errf="$WORK_DIR/open.err" open
  open="$(gh pr list --repo "$REPO" --state open --limit 50 --json number,headRefName,title \
    --jq '.[] | "\(.number)\t\(.headRefName)\t\(.title)"' 2>"$errf")" \
    || die "gh pr list --state open failed for $REPO: $(cat "$errf")"
  echo "EVENT heartbeat loops=$MAX_LOOPS interval=${INTERVAL}s since=${SINCE:-none}"
  [[ -z "$open" ]] || printf '%s\n' "$open"
  pr_watch_context
  exit 0
}

loop=0
while :; do
  loop=$((loop + 1))
  check_pr_watch
  check_merge_lifecycle
  check_merged
  check_lanes
  [[ "$loop" -lt "$MAX_LOOPS" ]] || heartbeat
  sleep "$INTERVAL"
done
