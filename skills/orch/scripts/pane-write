#!/usr/bin/env bash
# The overseer's one way to type into a pane: the command line over
# lib/pane-write.sh, which holds every rule and every refusal.
# Bash 3.2-safe: tools/bash32-lint scans this directory.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
source "$SCRIPT_DIR/lib/lane-state.sh"
source "$SCRIPT_DIR/lib/pane-write.sh"

usage() {
  cat <<'EOF'
Usage: pane-write (--window WINDOW | --pane PANE) --expect PROCESS
                  (--file PATH | --key KEY)

Type into one tmux pane, only after proving it is the pane meant and that it
runs the process meant. Nothing is typed on a refusal.

  --window WINDOW  the lane record's window, bare or SESSION:WINDOW, resolved
                   the way lanes state and lane-close resolve it
  --pane PANE      a pane id (%N) the caller proved, such as the one
                   tmux new-window -P printed for a window it opened
  --expect PROCESS the process the pane must run: the lane's harness (claude,
                   codex), ssh for a lane whose record carries host, or shell
                   for a window just opened. The pane's foreground command, or
                   the pane process or a process below it, must carry the name
  --file PATH      paste the file's bytes as one bracketed paste, then Enter
  --key KEY        press one key: Enter, Up, Down, C-c or a digit 0-9

Copy mode is cancelled before every keystroke.

Exit 0 wrote. Exit 1 refused, and nothing was typed. Exit 2 is a tmux write
that failed after the checks passed, so part of the input may have landed.
A refusal prints `pane-write: KEY FIELD=VALUE...` and a `fix=` line on stderr:

  pane-unresolved   the target is empty, or --pane is not a pane id
  pane-self         the target is the pane this command runs in ($TMUX_PANE)
  pane-missing      no pane on this server carries the target
  pane-ambiguous    two or more panes carry the window name
  pane-read-failed  tmux or the process table did not answer
  process-mismatch  the pane does not run PROCESS; running= names what it runs
  expect-missing    --expect is empty
  key-invalid       --key names a key outside the list above
  file-unreadable   --file is not a readable regular file
  argument-invalid  an option is unknown, repeated or missing its value
  write-failed      a tmux step failed; step= names it (exit 2)
EOF
}

refuse_args() { # FIELD=VALUE
  pane_write_message argument-invalid "$1" >&2
  exit 1
}

kind="" target="" expect="" action="" value="" expect_set=false
while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --window|--pane)
      [[ -z "$kind" ]] || refuse_args "option=$1"
      [[ $# -ge 2 ]] || refuse_args "option=$1"
      kind="${1#--}"; target="$2"; shift 2 ;;
    --expect)
      [[ "$expect_set" == false && $# -ge 2 ]] || refuse_args "option=$1"
      expect="$2"; expect_set=true; shift 2 ;;
    --file|--key)
      [[ -z "$action" && $# -ge 2 ]] || refuse_args "option=$1"
      action="${1#--}"; value="$2"; shift 2 ;;
    *) refuse_args "option=$1" ;;
  esac
done
[[ -n "$kind" ]] || refuse_args option=--window
[[ "$expect_set" == true ]] || refuse_args option=--expect
[[ -n "$action" ]] || refuse_args option=--file

rc=0
pane_write "$kind" "$target" "$expect" "$action" "$value" || rc=$?
exit "$rc"
