#!/usr/bin/env bash
# Run the repository's post-merge steps from its base checkout.
set -euo pipefail
mode=full
case "${1:-}" in
  -h|--help)
    printf '%s\n' 'usage: post-merge [--command-only|--refresh-only] [BASE_CHECKOUT]' 'Run in the base checkout; stop at the first failed step. All modes retain checkout changes for their declared owner.' \
      '--command-only  synchronize and run the configured command with its checkpoint; leave refresh and verification to the declared workflow owner.' \
      '--refresh-only  refresh without synchronization, the configured command or verification; for an authorized owner outside the hosted control host.' \
      'Skip refresh and verification when the base checkout holds the adopted refresh caller.'
    exit 0 ;;
  --command-only) mode=command-only; shift ;;
  --refresh-only) mode=refresh-only; shift ;;
esac
status() { printf 'post-merge: %s=%s\n' "$1" "$2"; }
step() {
  local name="$1" rc=0; shift
  "$@" || rc=$?
  status "$name" "$rc"; return "$rc"
}
SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)" || exit 1
[[ $# -le 1 ]] || { status arguments "$#"; exit 2; }
cd -- "${1:-.}" || { status checkout 1; exit 1; }
if [[ "$mode" != refresh-only ]]; then
  step sync-base "$SCRIPT_DIR/sync-base" . || exit $?
  ORCH_POST_MERGE_BEFORE="$(git rev-parse refs/kendex/post-merge-base)" || { status sync-base 1; exit 1; }
  ORCH_POST_MERGE_AFTER="$(git rev-parse HEAD)" || { status sync-base 1; exit 1; }
  export ORCH_POST_MERGE_BEFORE ORCH_POST_MERGE_AFTER
  COMMAND="$("$SCRIPT_DIR/orch-env" ORCH_POST_MERGE_CMD '')" || { status command 1; exit 1; }
  if [[ -n "$COMMAND" ]]; then
    step command bash -c "$COMMAND" || exit $?
  else
    status command skipped
  fi
  git update-ref refs/kendex/post-merge-base "$ORCH_POST_MERGE_AFTER" || { status checkpoint 1; exit 1; }
fi
[[ "$mode" != command-only ]] || exit 0
# review-gate references/adoption.md Caller adoption contract gives this caller every refresh output.
refresh_caller=.github/workflows/kendex-refresh.yml
if [[ -f "$refresh_caller" ]]; then
  status refresh "skipped cause=workflow-owned path=$refresh_caller"
  [[ "$mode" != full ]] || status verify skipped
  exit 0
fi
if [[ -f kendex.toml ]]; then
  # Refresh owns no cleanup permission. Keep checkout changes for their owner.
  rc=0
  step refresh kendex refresh --scope project --yes --leave || rc=$?
  [[ $rc -ne 0 || "$mode" != full ]] || step verify kendex verify --scope project || rc=$?
  if changes="$(git status --porcelain --untracked-files=all)"; then
    if [[ -n "$changes" ]]; then
      status changes kept
      printf '%s\n' "$changes"
    else
      status changes none
    fi
  else
    status changes unreadable
    [[ $rc -ne 0 ]] || rc=1
  fi
  [[ $rc -eq 0 ]] || exit $rc
else
  status refresh skipped
  [[ "$mode" != full ]] || status verify skipped
fi
