#!/usr/bin/env bash
# Resolve the consumer's publication order through orch-env.
#
# Usage: pr-order [WORKTREE]
# WORKTREE defaults to the current directory.
#
# stdout, exit 0: pr-order=review-first|open-first|push-first
# An explicit setting wins without a visibility read. When unset, private
# repositories use open-first; public and internal use review-first.
# review-first: validate, review, then publish.
# open-first: validate, publish, then review.
# push-first: publish a draft, then run internal review while CI may be pending.
# Submit verifies required CI on the published head before merge.
# Review completes before merge in every order.
#
# Exit 2 prints pr-order-error: cause=CAUSE on stderr and no order:
# worktree-missing, setting-unreadable, setting-unknown, repo-unresolved,
# visibility-unreadable, visibility-unknown.
# Callers keep review-first on a failed read.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
usage() { sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'; }
die() {
  printf 'pr-order-error: cause=%s %s\n' "$1" "$2" >&2
  exit 2
}
case "${1:-}" in
  -h|--help) usage; exit 0 ;;
esac
worktree="${1:-.}"
[[ -d "$worktree" ]] || die worktree-missing "path=$worktree"
cd -- "$worktree"
order="$("$SCRIPT_DIR/orch-env" ORCH_PR_ORDER "")" \
  || die setting-unreadable setting=ORCH_PR_ORDER
case "$order" in
  review-first|open-first|push-first) ;;
  '')
    # An unset setting must not change a consumer's publication order.
    # shellcheck source=lib/gh-repo.sh
    source "$SCRIPT_DIR/lib/gh-repo.sh"
    repo="$(orch_resolve_gh_repo "$PWD")" || die repo-unresolved "repo=${repo:-none}"
    visibility="$(gh repo view "$repo" --json visibility --jq .visibility 2>/dev/null)" \
      || die visibility-unreadable "repo=$repo"
    visibility="$(printf '%s' "$visibility" | tr '[:upper:]' '[:lower:]')"
    case "$visibility" in
      private) order=open-first ;;
      public|internal) order=review-first ;;
      *) die visibility-unknown "repo=$repo visibility=${visibility:-none}" ;;
    esac
    ;;
  *) die setting-unknown "value=${order:-empty}" ;;
esac
printf 'pr-order=%s\n' "$order"
