#!/usr/bin/env bash
# Usage: reconcile-work-items
#
# reconcile-work-items — report tracker state the workflows wrote once and
# never re-read. READ-ONLY: prints findings, mutates nothing; the caller
# decides what to fix.
#
# Checks over every issue of the project's LINEAR_TEAM, or of every team
# the Linear API key reaches where none is set, read live through the linear
# skill (`issues list --max [--team]`, archived and trashed issues excluded):
#   container-parked  a parent in a non-terminal state whose non-canceled
#                     children are all Done — the close that only merge-pr § 5
#                     performs never ran
#   merged-in-review  an In Review item whose branch-named PRs are all merged
#                     (at least one), at any age — no later step moves it
#   started-stale     an In Progress / In Review item untouched for longer
#                     than the threshold whose branch-named PR is merged (or
#                     unverifiable) — the item outlived its work
#   done-unchecked    a Done item whose description still carries unchecked
#                     `- [ ]` acceptance criteria — a partial-scope PR's
#                     `Closes` magic word closed it
#   verifying-overdue a Verifying post-merge box whose UTC deadline has passed
#   verifying-empty   a Verifying issue with no open post-merge box
#   verifying-invalid a Verifying description missing required box metadata or
#                     still holding open branch-provable work
#
# Exit codes: 0 nothing to reconcile; 1 findings; 2 config/collection error.
#
# RECONCILE_STALE_HOURS   started-stale threshold (default 24)
# RECONCILE_GH_CLI        PR-probe command (default gh); absent/failing gh
#                         degrades that item to "PR state unverified", never
#                         to silence
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

print_usage() {
  sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'
}

# `.env.local` is sourced as shell, so a help request must be answered before
# the loader runs. This command takes no option and no operand, so every
# argument position is a help request or nothing at all.
for _arg in "$@"; do
  case "$_arg" in
  --help | -h | help)
    print_usage
    exit 0
    ;;
  esac
done
unset _arg

message() {
  local key="$1"
  shift
  printf 'reconcile-work-items: %s' "$key"
  printf ' %s' "$@"
  printf '\n'
  case "$key" in
    not-repository) printf 'The command must run inside a Git repository.\n' ;;
    invalid-threshold) printf 'The stale threshold must be a non-negative integer.\n' ;;
    missing-command) printf 'Install the required command.\n' ;;
    missing-linear) printf 'The linear skill must be installed beside this one.\n' ;;
    collection-failed) printf 'The live issue read failed; nothing was scanned.\n' ;;
    invalid-inventory) printf 'The issue read must hold issue rows with identifier, state, and a timestamp on started rows.\n' ;;
    temporary-directory) printf 'The scratch directory could not be created.\n' ;;
    scan-failed) printf 'The issue scan failed.\n' ;;
    clock-failed) printf 'The current time could not be read.\n' ;;
    invalid-timestamp) printf 'The started issue timestamp could not be parsed.\n' ;;
    container-parked) printf 'All non-canceled children are Done. Close the parent or state why it remains open.\n' ;;
    merged-in-review) printf 'Every linked pull request has merged. Complete it with `issues complete --post-merge-at <mergedAt>`, which moves it to Done or Verifying.\n' ;;
    started-stale) printf 'The started issue has passed the stale threshold. If its pull request merged, complete the item. Otherwise finish its lifecycle or restate its scope.\n' ;;
    done-unchecked) printf 'The Done issue still has unchecked acceptance criteria. Record evidence and tick proven boxes. Keep post-merge checks on this item in Verifying.\n' ;;
    verifying-invalid) printf 'The Verifying checklist has invalid metadata or an open branch-provable box. Correct the item with evidence.\n' ;;
    verifying-empty) printf 'The Verifying item has no open post-merge box. Complete the item.\n' ;;
    verifying-overdue) printf 'The post-merge box has passed its deadline. Read its evidence and complete it, or record failure and return the item to In Progress.\n' ;;
    findings) printf 'The tracker state differs from the work.\n' ;;
    clean) printf 'Every issue state matches its work.\n' ;;
  esac
}

config_error() {
  message "$@" >&2
  exit 2
}

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || config_error not-repository "path=$PWD"
export REPO_ROOT
# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$REPO_ROOT"

STALE_HOURS="${RECONCILE_STALE_HOURS:-24}"
case "$STALE_HOURS" in
  "" | *[!0-9]* | 0*[0-9]) config_error invalid-threshold "value=$STALE_HOURS" ;;
esac
GH_CLI="${RECONCILE_GH_CLI:-gh}"

command -v jq >/dev/null 2>&1 || config_error missing-command command=jq

LINEAR="$SCRIPT_DIR/../../linear/scripts/linear.sh"
[ -x "$LINEAR" ] || config_error missing-linear "path=$LINEAR"
CHECKLIST_LIB="$SCRIPT_DIR/../../linear/scripts/lib/issue-validation.sh"
[ -r "$CHECKLIST_LIB" ] || config_error missing-linear "path=$CHECKLIST_LIB"
# shellcheck source=../../../linear/scripts/lib/issue-validation.sh
source "$CHECKLIST_LIB"
TMPD="$(mktemp -d)" || config_error temporary-directory command=mktemp
trap 'rm -rf -- "${TMPD:?}"' EXIT
# A failed or partial read refuses: the linear skill reads every page or
# fails, and a scan of part of the tracker would report it clean.
ISSUES="$TMPD/issues.json"
"$LINEAR" issues list --max ${LINEAR_TEAM:+--team "$LINEAR_TEAM"} --format=raw >"$TMPD/raw.json" || config_error collection-failed source=linear
jq -e '.issues.nodes | arrays' "$TMPD/raw.json" >"$ISSUES" 2>/dev/null || config_error invalid-inventory source=linear
# Structural validation up front: an array of rows missing the fields the
# scans key on would otherwise be skipped silently and report clean.
jq -e 'type == "array" and all(.[];
    type == "object"
    and (.identifier | type == "string")
    and (.state | type == "object")
    and (.state.name | type == "string")
    and (.state.type | type == "string")
    and (.state.type != "started" or ((.updatedAt | type == "string") and (.updatedAt | test("\\S")))))' "$ISSUES" >/dev/null 2>&1 \
  || config_error invalid-inventory source=linear

findings=0
note() { findings=$((findings + 1)); message "$@"; }

# --- container-parked --------------------------------------------------------
# Non-terminal parents whose non-canceled children (by parent identifier) are
# all completed. Trashed/archived rows never count as children or parents.

jq -r '
  map(select((.trashed // false) == false and .archivedAt == null)) as $live
  | ($live | map(select(.parent.identifier != null))) as $children
  | ($children | group_by(.parent.identifier)) as $broods
  | $broods[]
  | .[0].parent.identifier as $pid
  | (map(select(.state.type != "canceled"))) as $countable
  | select(($countable | length) > 0 and ($countable | all(.state.type == "completed")))
  | ($live[] | select(.identifier == $pid)) as $parent
  | select($parent.state.type != "completed" and $parent.state.type != "canceled")
  # A "(one PR)" root is a single-PR bundle, not a container: its children go
  # Done while the root stays open until ITS PR merges, so an open root with
  # Done children is that contract working, not a parked container.
  | select($parent.title | test("\\(one PR\\)"; "i") | not)
  | [$parent.identifier, $parent.title, $parent.state.name] | @tsv
' "$ISSUES" >"$TMPD/containers" || config_error scan-failed scan=container
while IFS=$'\t' read -r pid ptitle pstate; do
  [ -n "$pid" ] || continue
  note container-parked "issue=$pid" "state=$pstate" "title=$ptitle"
done <"$TMPD/containers"

# --- merged-in-review, started-stale -----------------------------------------
# probe_prs BRANCH prints "OPEN MERGED CLOSED-UNMERGED LATEST-MERGED-AT" for
# this repository's PRs from BRANCH; it fails when the probe cannot answer, and
# the caller then reports the PR state unverified rather than nothing.
probe_prs() {
  command -v "${GH_CLI%% *}" >/dev/null 2>&1 || return 1
  # This repo's branch only — a fork's same-named branch is someone else's
  # PR and must not vouch for this item. The probe answers for THIS checkout:
  # an inherited GH_REPO / GITHUB_REPOSITORY redirect would let another
  # repository's same-named branch vouch for this item.
  local listed
  listed="$(env -u GH_REPO -u GITHUB_REPOSITORY $GH_CLI pr list --state all --head "$1" --json state,mergedAt,isCrossRepository 2>/dev/null)" || return 1
  jq -er '[.[] | select(.isCrossRepository | not)]
    | [(map(select(.state == "OPEN")) | length),
       (map(select(.state == "MERGED")) | length),
       (map(select(.state != "OPEN" and .state != "MERGED")) | length),
       (map(select(.state == "MERGED") | .mergedAt) | max // "none")]
    | map(tostring) | join(" ")' <<<"$listed" 2>/dev/null
}

now_epoch="$(date -u +%s)" || config_error clock-failed command=date
jq -r '
  .[] | select((.trashed // false) == false and .archivedAt == null)
  | select(.state.type == "started" and .state.name != "Verifying")
  | [.identifier, .title, .state.name, .updatedAt] | @tsv
' "$ISSUES" >"$TMPD/started" || config_error scan-failed scan=started
while IFS=$'\t' read -r iid ititle istate iupdated; do
  [ -n "$iid" ] || continue
  updated_epoch="$(date -u -d "$iupdated" +%s 2>/dev/null)" || updated_epoch=""
  if [ -z "$updated_epoch" ]; then
    # BSD date has no -d; parse the ISO stamp with -j -f (fractional part
    # and zone dropped — whole-second precision is plenty for an hours
    # threshold).
    trimmed="${iupdated%%.*}"
    trimmed="${trimmed%Z}"
    updated_epoch="$(date -j -u -f "%Y-%m-%dT%H:%M:%S" "$trimmed" +%s 2>/dev/null)" || updated_epoch=""
  fi
  # A timestamp neither form can read must never silently shrink the check.
  [ -n "$updated_epoch" ] || config_error invalid-timestamp "issue=$iid" "updated-at=$iupdated"
  age_hours=$(((now_epoch - updated_epoch) / 3600))
  [ "$istate" = "In Review" ] || [ "$age_hours" -ge "$STALE_HOURS" ] || continue
  branch="$(printf '%s' "$iid" | tr '[:upper:]' '[:lower:]')"
  prs="$(probe_prs "$branch")" || prs=""
  if [ -n "$prs" ]; then
    read -r open merged unmerged merged_at <<<"$prs"
    # Age plays no part here: the merge already happened and no later sweep
    # step or lane moves an In Review item on its own.
    if [ "$istate" = "In Review" ] && [ "$merged" -gt 0 ] && [ "$open" -eq 0 ] && [ "$unmerged" -eq 0 ]; then
      note merged-in-review "issue=$iid" "state=$istate" "merged-at=$merged_at" "title=$ititle"
      continue
    fi
  fi
  [ "$age_hours" -ge "$STALE_HOURS" ] || continue
  pr_state="unverified"
  if [ -n "$prs" ]; then
    if [ "$open" -gt 0 ]; then
      continue # a live PR is a live item, whatever the clock says
    elif [ "$merged" -gt 0 ]; then
      pr_state="merged"
    else
      pr_state="absent"
    fi
  fi
  note started-stale "issue=$iid" "state=$istate" "age-hours=$age_hours" "pr=$pr_state" "title=$ititle"
done <"$TMPD/started"

# --- verifying ---------------------------------------------------------------
jq -c '.[] | select((.trashed // false) == false and .archivedAt == null and .state.name == "Verifying")' \
  "$ISSUES" >"$TMPD/verifying" || config_error scan-failed scan=verifying
while IFS= read -r row; do
  [ -n "$row" ] || continue
  iid="$(jq -r '.identifier' <<<"$row")" || config_error scan-failed scan=verifying
  description="$(jq -r '(.description // "") + "."' <<<"$row")" || config_error scan-failed scan=verifying
  checklist="$(done_when_parse "${description%.}" '[]')" || config_error scan-failed scan=verifying
  if ! jq -e '(.errors | length) == 0 and all(.boxes[]; .checked or .post_merge)' <<<"$checklist" >/dev/null; then
    note verifying-invalid "issue=$iid"
    continue
  fi
  open_count="$(jq '[.boxes[] | select(.post_merge and (.checked | not))] | length' <<<"$checklist")" \
    || config_error scan-failed scan=verifying
  if [ "$open_count" -eq 0 ]; then
    note verifying-empty "issue=$iid"
    continue
  fi
  overdue="$(jq -r --argjson now "$now_epoch" '.boxes[]
    | select(.post_merge and (.checked | not) and .deadline_epoch <= $now)
    | "box=\(.number) deadline=\(.deadline)"' <<<"$checklist")" || config_error scan-failed scan=verifying
  while IFS= read -r box; do
    [ -n "$box" ] || continue
    note verifying-overdue "issue=$iid" "$box"
  done <<<"$overdue"
done <"$TMPD/verifying"

# --- done-unchecked ----------------------------------------------------------
jq -r '
  .[] | select((.trashed // false) == false and .archivedAt == null)
  | select(.state.type == "completed")
  | select((.description // "") | test("- \\[ \\]"))
  | [.identifier, .title] | @tsv
' "$ISSUES" >"$TMPD/done" || config_error scan-failed scan=done
while IFS=$'\t' read -r iid ititle; do
  [ -n "$iid" ] || continue
  note done-unchecked "issue=$iid" "title=$ititle"
done <"$TMPD/done"

if [ "$findings" -gt 0 ]; then
  message findings "count=$findings"
  exit 1
fi
message clean count=0
