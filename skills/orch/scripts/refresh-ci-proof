#!/usr/bin/env bash
# Read classifier evidence through GitHub's check-run and job APIs.
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)"
refuse() {
  printf 'refresh-ci-proof: cause=%s\n' "$1" >&2
  exit 1
}

# refresh-consumer can PATCH its Engine declaration while retaining the head.
# Both API reads use this one normalized approval record.
parse_target() {
  local target cause
  target="$(jq -ec '
    def commit_sha: type == "string" and test("^[0-9a-f]{40}$");
    if (.head.sha | commit_sha) and (.base.sha | commit_sha) and
      (.base.ref | type == "string" and length > 0)
    then
      (if (.body | type) == "string" then
        [.body | gsub("\r"; "") | scan("(?m)^Engine version: `?kendex ([^ `\n]+)") | .[0] | rtrimstr(".")]
      else [] end) as $engines |
      if ($engines | length) == 1 and $engines[0] != "" then
        {head:.head.sha, base_sha:.base.sha, base_ref:.base.ref, engine:$engines[0]}
      else {cause:"engine-mismatch"} end
    else {cause:"ci-proof-missing"} end
  ' <<<"$1")" || refuse ci-proof-missing
  cause="$(jq -r '.cause // ""' <<<"$target")" || refuse ci-proof-missing
  [[ -z $cause ]] || refuse "$cause"
  printf '%s\n' "$target"
}

if [[ ${1:-} == --help ]]; then
  cat <<'EOF'
Usage: refresh-ci-proof PR_NUMBER HEAD_SHA --repo OWNER/REPO
       refresh-ci-proof --merged BASE_SHA HEAD_SHA --repo OWNER/REPO

--merged reads measured classification for the exact first-parent range.
It supports kendex's skill-tests.yml merge-group producer. The workflow and
local action.yml/classify/proof must equal their trusted first-parent files.
Both run repositories, the check, job, run and logged range must match.
It executes no classifier or proof. Missing evidence refuses ci-proof-missing;
unsupported or changed producer code refuses origin-untrusted; an unmeasured
or unsupported class refuses class-unmeasured. Success is a JSON object with
class, measured, cause and evidence. It does not attest the classifier checkout
revision, which the current producer record does not contain.

Read the latest trusted GitHub Actions check named Classify the diff on HEAD_SHA.
HEAD_SHA is a full lowercase commit SHA. The check and its job must have
completed successfully on that head. Its pull_request run must come from
an unchanged consumer workflow, excluding HARNESS_CI_REFRESH_CALLER.
Its run must link this PR and head. The log's base-rev/head-rev must match
the current PR range resolved by harness-ci's harness-only. A PR range uses
the merge base, not the current base tip. Repeated range records must agree.
Fetch both commits through github's Git auth helper without moving checkout
refs or files. Read the job log's measured render
class and compare its render-verifier version with Engine version in both
reads of the refresh pull request body. The declaration must stay valid and
unchanged. Read every changed path. The only permitted
workflow path is HARNESS_CI_REFRESH_CALLER from the installed harness-ci.
Renames also check the old path. This command reads GitHub and writes no
approval. Run it from the trusted consumer checkout with gh authenticated.
Raw job logs require gh 2.97.0 or later. Log control bytes stay in the parser.

Success (exit 0):
  refresh-ci-proof: head=SHA class=render measured=true version=VERSION job=ID

Refusal (exit 1), consumed by references/copilot-head-notices.md:
  refresh-ci-proof: cause=ci-proof-missing
    Evidence is absent, unreadable, incomplete, pending, failed or for another PR or range.
  refresh-ci-proof: cause=class-not-render
    The completed log does not prove a measured render.
  refresh-ci-proof: cause=engine-mismatch
    The body or verifier version is absent, ambiguous or different.
  refresh-ci-proof: cause=workflow-changed
    Another workflow path changed.
EOF
  exit 0
fi

mode=refresh
if [[ ${1:-} == --merged ]]; then
  [[ $# == 5 && $2 =~ ^[0-9a-f]{40}$ && $3 =~ ^[0-9a-f]{40}$ && $4 == --repo && $5 =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || refuse ci-proof-missing
  mode=merged base=$2 head=$3 repo=$5
  range_base=$base range_head=$head
  parent="$(env -i PATH="$PATH" git rev-parse --verify "$head^1^{commit}")" || refuse ci-proof-missing
  [[ $parent == "$base" ]] || refuse ci-proof-missing
  # Only kendex's established default-branch producer is supported. Candidate
  # action code can forge logs even when the workflow itself is unchanged.
  origin_ok=true
  [[ $(printf '%s' "$repo" | tr '[:upper:]' '[:lower:]') == vanillagreencom/kendex ]] || origin_ok=false
  for producer in .github/workflows/skill-tests.yml .github/actions/change-class/action.yml .github/actions/change-class/classify .github/actions/change-class/proof; do
    old="$(env -i PATH="$PATH" git ls-tree "$base" -- "$producer")" || refuse origin-untrusted
    current="$(env -i PATH="$PATH" git ls-tree "$head" -- "$producer")" || refuse origin-untrusted
    [[ $old == 100644\ blob\ * || $old == 100755\ blob\ * ]] || origin_ok=false
    [[ -n $old && $old == "$current" ]] || origin_ok=false
  done
  [[ $origin_ok == true ]] || refuse origin-untrusted
else
  [[ $# == 4 && $1 =~ ^[1-9][0-9]*$ && $2 =~ ^[0-9a-f]{40}$ && $3 == --repo && $4 =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || refuse ci-proof-missing
  pr=$1 head=$2 repo=$4
library="$SCRIPT_DIR/../../harness-ci/scripts/lib/change-class.sh"
[[ -r $library ]] || refuse ci-proof-missing
# harness-ci is optional: only this render route needs its caller contract.
# shellcheck source=../../harness-ci/scripts/lib/change-class.sh
source "$library" || refuse ci-proof-missing
[[ -n ${HARNESS_CI_REFRESH_CALLER:-} ]] || refuse ci-proof-missing
range_owner="$SCRIPT_DIR/../../harness-ci/scripts/harness-only"
[[ -r $range_owner ]] || refuse ci-proof-missing
git_auth="$SCRIPT_DIR/../../github/scripts/git-https-auth"
[[ -x $git_auth ]] || refuse ci-proof-missing

metadata="$(gh api "repos/$repo/pulls/$pr")" || refuse ci-proof-missing
target="$(parse_target "$metadata")" || exit 1
jq -e --arg head "$head" '.head == $head' >/dev/null <<<"$target" || refuse ci-proof-missing
jq -e '
  (.changed_files | type) == "number" and .changed_files >= 0
' >/dev/null <<<"$metadata" || refuse ci-proof-missing
base="$(jq -er '.base_sha' <<<"$target")" || refuse ci-proof-missing
# Refresh publication adds a remote head that the trusted base checkout may
# not hold yet. Fetch objects only; keep its refs, files and FETCH_HEAD intact.
"$git_auth" fetch --quiet --no-tags --no-write-fetch-head --no-recurse-submodules origin "$base" "$head" >/dev/null 2>&1 || refuse ci-proof-missing
for revision in "$base" "$head"; do
  env -i PATH="$PATH" git cat-file -e "${revision}^{commit}" 2>/dev/null || refuse ci-proof-missing
done
# harness-only owns event range semantics. Its ownership verdict is not used:
# only consumer CI can establish render proof with the consumer's engine.
range="$(env -i PATH="$PATH" "$BASH" "$range_owner" --event pull_request --base "$base" --head "$head" 2>&1)" || refuse ci-proof-missing
range_base="$(sed -nE 's/^base-rev: ([0-9a-f]{40})$/\1/p' <<<"$range")" || refuse ci-proof-missing
range_head="$(sed -nE 's/^head-rev: ([0-9a-f]{40})$/\1/p' <<<"$range")" || refuse ci-proof-missing
[[ $range_base =~ ^[0-9a-f]{40}$ && $range_head == "$head" ]] || refuse ci-proof-missing
files="$(gh api "repos/$repo/pulls/$pr/files?per_page=100" --paginate --slurp)" || refuse ci-proof-missing
# GitHub caps this endpoint. Compare with the PR count before trusting an empty search.
jq -e --argjson metadata "$metadata" '
  type == "array" and length > 0 and all(.[]; type == "array") and
  (add | length) == $metadata.changed_files and
  all(.[][]; (.filename | type) == "string" and
    ((.previous_filename // "") | type) == "string")
' >/dev/null <<<"$files" || refuse ci-proof-missing
jq -e --arg caller "$HARNESS_CI_REFRESH_CALLER" '
  all(.[][] | (.filename, (.previous_filename // ""));
    (startswith(".github/workflows/") | not) or . == $caller)
' >/dev/null <<<"$files" || refuse workflow-changed

fi

checks="$(gh api "repos/$repo/commits/$head/check-runs?check_name=Classify%20the%20diff&filter=latest&per_page=100" --paginate --slurp)" || refuse ci-proof-missing
candidates="$(jq -ec '
  if type == "array" and length > 0 and all(.[]; (.check_runs | type) == "array") and
    ([.[] | .check_runs[]] | length) == .[0].total_count
  then [.[] | .check_runs[] | select(.name == "Classify the diff" and .app.slug == "github-actions")]
  else error("unreadable checks") end |
  if all(.[]; (.id | type == "number" and . > 0 and floor == .)) then .
  else error("unreadable job identity") end
' <<<"$checks")" || refuse ci-proof-missing
trusted='[]'
rows="$(jq -c '.[]' <<<"$candidates")" || refuse ci-proof-missing
while IFS= read -r candidate; do
  [[ -n $candidate ]] || continue
  job="$(jq -er '.id' <<<"$candidate")" || refuse ci-proof-missing
  job_metadata="$(gh api "repos/$repo/actions/jobs/$job")" || refuse ci-proof-missing
  run="$(jq -er --argjson job "$job" '
    select(.id == $job and .name == "Classify the diff") |
    .run_id | select(type == "number" and . > 0 and floor == .)
  ' <<<"$job_metadata")" || refuse ci-proof-missing
  run_metadata="$(gh api "repos/$repo/actions/runs/$run")" || refuse ci-proof-missing
  jq -e --argjson run "$run" '
    .id == $run and (.path | type) == "string" and (.event | type) == "string" and
    (.head_sha | type) == "string" and (.repository.full_name | type) == "string"
  ' >/dev/null <<<"$run_metadata" || refuse ci-proof-missing
  # required_contexts proves ruleset-required source definitions, not these
  # local CI jobs. The unchanged consumer workflow is trusted here; the
  # mutable refresh caller cannot supply its own ownership proof.
  if [[ $mode == merged ]]; then
    qualifies=false
    if jq -e --arg repo "$repo" --argjson job "$job" '
      (.check_run_url | ascii_downcase) == ("https://api.github.com/repos/" + ($repo | ascii_downcase) + "/check-runs/" + ($job | tostring))
    ' >/dev/null <<<"$job_metadata" && jq -e --arg merge "$head" --arg repository "$repo" '
      .event == "merge_group" and .head_sha == $merge and
      .conclusion == "success" and .status == "completed" and
      (.repository.full_name | ascii_downcase) == ($repository | ascii_downcase) and
      (.head_repository.full_name | ascii_downcase) == ($repository | ascii_downcase) and
      .path == ".github/workflows/skill-tests.yml"
    ' >/dev/null <<<"$run_metadata"; then qualifies=true; fi
  elif jq -e --arg head "$head" --arg repo "$repo" --arg caller "$HARNESS_CI_REFRESH_CALLER" '
    .head_sha == $head and .event == "pull_request" and
    (.repository.full_name | ascii_downcase) == ($repo | ascii_downcase) and
    (.path | split("@")[0] | startswith(".github/workflows/") and . != $caller)
  ' >/dev/null <<<"$run_metadata"; then
    qualifies=true
  else
    qualifies=false
  fi
  if [[ $qualifies == true ]]; then
    trusted="$(jq -cn --argjson trusted "$trusted" --argjson check "$candidate" --argjson job "$job_metadata" --argjson run "$run_metadata" '
      $trusted + [{check:$check, job:$job, run:$run}]
    ')" || refuse ci-proof-missing
  fi
done <<<"$rows"
selected="$(jq -ec --arg head "$head" '
  max_by(.check.id) | select(.check.head_sha == $head and .check.status == "completed" and .check.conclusion == "success")
' <<<"$trusted")" || refuse ci-proof-missing
# GitHub's PR links can follow live retargets. They identify the PR, while
# only the classifier's emitted revisions identify its execution range.
if [[ $mode == refresh ]]; then
jq -e --argjson pr "$pr" --arg head "$head" '
  (.run.pull_requests | type) == "array" and
  any(.run.pull_requests[]; .number == $pr and .head.sha == $head)
' >/dev/null <<<"$selected" || refuse ci-proof-missing
fi
job="$(jq -er '.job.id' <<<"$selected")" || refuse ci-proof-missing
job_metadata="$(jq -ec '.job' <<<"$selected")" || refuse ci-proof-missing
jq -e --arg head "$head" --argjson job "$job" '
  .id == $job and .head_sha == $head and .name == "Classify the diff" and
  .status == "completed" and .conclusion == "success"
' >/dev/null <<<"$job_metadata" || refuse ci-proof-missing
log="$(gh api "repos/$repo/actions/jobs/$job/logs" --allow-escape-sequences)" || refuse ci-proof-missing
# Actions logs prefix each line with a timestamp. Ignore echoed shell commands.
proof="$(awk '
  { sub(/\r$/, ""); sub(/^[0-9][0-9][0-9][0-9]-[^ ]+ /, "") }
  /^class: / { class = $0; classes++ }
  /^render-verifier: / { verifier = $0; verifiers++ }
  # render-reach and change-class repeat the range in the same Actions job.
  /^base-rev: / { if (bases++ && base != $0) base_conflict = 1; base = $0 }
  /^head-rev: / { if (heads++ && head != $0) head_conflict = 1; head = $0 }
  END {
    if (classes == 1) print class; if (verifiers == 1) print verifier
    if (bases && !base_conflict) print base; if (heads && !head_conflict) print head
  }
' <<<"$log")" || refuse ci-proof-missing
if [[ $mode == refresh ]]; then
[[ $proof =~ (^|$'\n')class:\ class=render\ measured=true($|\ ) ]] || refuse class-not-render
version="$(sed -nE 's/^render-verifier: verifier=[^ ]+ version=([^ ]+)$/\1/p' <<<"$proof")" || refuse engine-mismatch
engine="$(jq -er '.engine' <<<"$target")" || refuse engine-mismatch
[[ -n $version && $version == "$engine" ]] || refuse engine-mismatch
fi
proof_base="$(sed -nE 's/^base-rev: ([0-9a-f]{40})$/\1/p' <<<"$proof")" || refuse ci-proof-missing
proof_head="$(sed -nE 's/^head-rev: ([0-9a-f]{40})$/\1/p' <<<"$proof")" || refuse ci-proof-missing
[[ $proof_base == "$range_base" && $proof_head == "$range_head" ]] || refuse ci-proof-missing

if [[ $mode == merged ]]; then
  class_line="$(sed -n '/^class: /p' <<<"$proof")" || refuse class-unmeasured
  [[ $class_line =~ ^class:\ class=(render|trivial|micro|small|standard)\ measured=true\ cause=([abcdefghijklmnopqrstuvwxyz0123456789-]+)($|\ ) ]] || refuse class-unmeasured
  class=${BASH_REMATCH[1]} cause=${BASH_REMATCH[2]}
  jq -cn --arg class "$class" --arg cause "$cause" --arg evidence "${class_line#* cause=}" \
    '{class:$class, measured:true, cause:$cause, evidence:$evidence}'
  exit 0
fi

# A push, retarget or Engine declaration update invalidates the proof.
live="$(gh api "repos/$repo/pulls/$pr")" || refuse ci-proof-missing
live_target="$(parse_target "$live")" || exit 1
jq -e --argjson initial "$target" '
  .head == $initial.head and .base_sha == $initial.base_sha and
  .base_ref == $initial.base_ref
' >/dev/null <<<"$live_target" || refuse ci-proof-missing
live_engine="$(jq -er '.engine' <<<"$live_target")" || refuse engine-mismatch
[[ $live_engine == "$engine" ]] || refuse engine-mismatch
printf 'refresh-ci-proof: head=%s class=render measured=true version=%s job=%s\n' "$head" "$version" "$job"
