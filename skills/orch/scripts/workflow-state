#!/usr/bin/env bash
# Workflow state file management for multi-agent orch
# Usage: workflow-state <command> <issue_id> [args...]

set -euo pipefail

PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
export PROJECT_ROOT
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export SCRIPT_DIR

# The state file for a key. Every caller passes the key the state was
# initialized under — GitHub-issue orchestration normalizes to `issue-N` before
# it reaches any subcommand — so the key names its file exactly.
get_state_file() {
    local issue_id="$1"
    echo "${STATE_DIR}/${STATE_PREFIX}-${issue_id}.json"
}

ensure_state_exists() {
    local state_file="$1"
    if [[ ! -f "$state_file" ]]; then
        echo "Error: State file not found: $state_file" >&2
        echo "Run 'workflow-state init <issue_id>' first" >&2
        exit 1
    fi
}

# Atomic update: flock + write to temp, validate, move
# Uses flock to serialize concurrent writes and prevent state corruption.
# Any remaining arguments are passed to jq ahead of the filter, which is how
# `update --arg`/`--argjson` hand values in out of band.
atomic_update() {
    local state_file="$1"
    local jq_expr="$2"
    shift 2
    local -a jq_args=("$@")
    local lock_file="${state_file}.lock"
    local tmp_file="${state_file}.tmp"

    (
        flock -w 10 200 || { echo "Error: could not acquire lock on $lock_file" >&2; exit 1; }

        if ! jq ${jq_args[@]+"${jq_args[@]}"} "$jq_expr" "$state_file" > "$tmp_file" 2>&1; then
            echo "Error: jq expression failed: $jq_expr" >&2
            rm -f "$tmp_file"
            exit 1
        fi

        # Validate output is valid JSON
        if ! jq empty "$tmp_file" 2>/dev/null; then
            echo "Error: jq produced invalid JSON" >&2
            rm -f "$tmp_file"
            exit 1
        fi

        mv "$tmp_file" "$state_file"
    ) 200>"$lock_file"
}

cmd_init() {
    local issue_id="$1"
    shift

    local agent="" worktree="" branch="" qa_labels="[]" sub_issues="[]"

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --agent) agent="$2"; shift 2 ;;
            --worktree) worktree="$2"; shift 2 ;;
            --branch) branch="$2"; shift 2 ;;
            --qa-labels) qa_labels="$2"; shift 2 ;;
            --sub-issues) sub_issues="$2"; shift 2 ;;
            *) echo "Unknown option: $1" >&2; exit 1 ;;
        esac
    done

    mkdir -p "$STATE_DIR"
    local state_file
    state_file=$(get_state_file "$issue_id")

    jq -n \
        --arg issue_id "$issue_id" \
        --arg agent "$agent" \
        --arg worktree "$worktree" \
        --arg branch "$branch" \
        --argjson sub_issues "$sub_issues" \
        --argjson qa_labels "$qa_labels" \
        '{
        issue_id: $issue_id,
        sub_issues: $sub_issues,
        agent: $agent,
        worktree: $worktree,
        branch: $branch,
        qa_labels: $qa_labels,
        child_sessions: {},
        review_agents: [],
        review_agent_ids: {},
        review_agent_runtime_types: {},
        pre_delegate_sha: null,
        skip_qa: false,
        cycles: 0,
        rereview_cycles: 0,
        json_paths: [],
        fixed_items: [],
        escalated_items: [],
        audit_issues_created: [],
        pr: {
          baseline_lines: null
        },
        pr_review_baseline: null,
        pr_comment_review: {
          iterations: 0,
          fixes: [],
          issues_created: [],
          skipped: []
        },
        post_pr_budgets: {
          review_wait: null,
          ci_fix: null
        },
        post_pr_stop: null
      }' > "$state_file"
    echo "$state_file"
}

cmd_get() {
    local issue_id="$1"
    local jq_path="${2:-.}"

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    jq -r "$jq_path" "$state_file"
}

# `update <id> [--arg NAME VALUE]... [--argjson NAME JSON]...
#             [--slurpfile NAME FILE]... <jq_expr>`
# Bindings reach jq as its own --arg/--argjson, so a VALUE carrying quotes,
# apostrophes, backslashes, or newlines is a literal string to the filter.
# Text this script did not author belongs in a binding: interpolated into the
# expression it becomes a jq parse error and an unwritten state.
#
# --slurpfile is jq's own file option and binds an ARRAY of the file's values,
# so a one-value artifact reads as $NAME[0]. Only the path crosses argv, which
# is the point: Linux caps a single argument at MAX_ARG_STRLEN (128 KB), well
# under ARG_MAX, so passing a document as an --argjson value makes jq fail to
# launch once the artifact grows past it. Callers under a harness that rejects
# `$(...)` and multi-command blocks (orch references/codex-runtime) cannot put
# artifact text into a shell word at all, so the file is the only channel.
cmd_update() {
    local issue_id="$1"
    shift

    local jq_expr="" have_expr=0
    local -a jq_args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --arg|--argjson)
                [[ $# -ge 3 ]] || { echo "Error: $1 needs a NAME and a VALUE" >&2; return 1; }
                # Count the parsed values, never their truthiness: `jq -e .`
                # takes its status from the OUTPUT, so it rejects the perfectly
                # valid scalars false and null. Slurping also rejects a stream
                # of several values, which is not one binding.
                if [[ "$1" == "--argjson" ]] && ! jq -s -e 'length == 1' >/dev/null 2>&1 <<<"$3"; then
                    echo "Error: --argjson $2 is not exactly one JSON value" >&2; return 1
                fi
                jq_args+=("$1" "$2" "$3"); shift 3 ;;
            --slurpfile)
                [[ $# -ge 3 ]] || { echo "Error: --slurpfile needs a NAME and a FILE" >&2; return 1; }
                [[ -f "$3" ]] || { echo "Error: --slurpfile $2: no such file: $3" >&2; return 1; }
                if ! jq -s -e 'length == 1' >/dev/null 2>&1 < "$3"; then
                    echo "Error: --slurpfile $2 is not exactly one JSON value: $3" >&2; return 1
                fi
                jq_args+=(--slurpfile "$2" "$3"); shift 3 ;;
            *)
                [[ "$have_expr" -eq 0 ]] || { echo "Error: update takes exactly one jq expression" >&2; return 1; }
                jq_expr="$1"; have_expr=1; shift ;;
        esac
    done
    [[ "$have_expr" -eq 1 ]] || { echo "Error: update needs a jq expression" >&2; return 1; }

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    atomic_update "$state_file" "$jq_expr" ${jq_args[@]+"${jq_args[@]}"}
}

# Atomic read-modify-write-report: the expression must evaluate to
# {state: <new full state>, report: <any>}. The write of .state and the
# capture of .report happen under the same lock, so the printed report is
# the evidence of exactly the transition this call performed — a follow-up
# `get` could instead observe another writer's interleaved change.
cmd_update_report() {
    local issue_id="$1"
    local jq_expr="$2"
    shift 2
    local -a jq_args=("$@")

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    local lock_file="${state_file}.lock"
    local tmp_file="${state_file}.tmp"

    # The report prints from INSIDE the locked section — no shared report
    # file exists to race on, so concurrent calls for the same issue each
    # return exactly their own transition's evidence.
    (
        flock -w 10 200 || { echo "Error: could not acquire lock on $lock_file" >&2; exit 1; }

        local combined
        if ! combined=$(jq -c ${jq_args[@]+"${jq_args[@]}"} "$jq_expr" "$state_file" 2>&1); then
            echo "Error: jq expression failed: $jq_expr" >&2
            exit 1
        fi
        # Exactly ONE {state, report} object: a stream of several would write
        # multiple top-level documents into the state file.
        if ! jq -e -s 'length == 1 and (.[0].state | type == "object") and (.[0] | has("report"))' >/dev/null 2>&1 <<<"$combined"; then
            echo "Error: update-report expression must produce exactly one {state: <object>, report: <any>}" >&2
            exit 1
        fi
        jq -c '.state' <<<"$combined" > "$tmp_file"
        mv "$tmp_file" "$state_file"
        jq -c '.report' <<<"$combined"
    ) 200>"$lock_file"
}

cmd_post_pr_stop() {
    local action="${1:-}" issue_id="${2:-}"
    [[ -n "$action" && -n "$issue_id" ]] || { echo "Error: post-pr-stop needs an action and issue_id" >&2; return 2; }
    case "$action" in
        record|record-if-empty)
            [[ $# -eq 6 ]] || { echo "Error: post-pr-stop $action needs issue_id, name, gate, remaining, and comment-file" >&2; return 2; }
            local name="$3" gate="$4" remaining="$5" comment_file="$6" mode="replace"
            [[ "$action" == "record-if-empty" ]] && mode="if-empty"
            local report result tmp_comment
            report=$(cmd_update_report "$issue_id" '
              (.post_pr_stop // null) as $current |
              if $mode == "if-empty" and $current != null then
                {state: ., report: {result: "kept", stop: $current}}
              else
                {state: (.post_pr_stop = {name: $name, gate: $gate, remaining: [$remaining]}),
                 report: {result: "recorded", stop: {name: $name, gate: $gate, remaining: [$remaining]}}}
              end' --arg mode "$mode" --arg name "$name" --arg gate "$gate" --arg remaining "$remaining") || return 1
            result=$(jq -r '.result' <<<"$report")
            if [[ "$result" == "recorded" ]]; then
                tmp_comment="${comment_file}.tmp"
                printf '## Orchestration stopped\n\n- Stop: `%s`\n- Gate: `%s`\n- Remaining: %s\n' "$name" "$gate" "$remaining" > "$tmp_comment"
                mv "$tmp_comment" "$comment_file"
            fi
            printf '%s\n' "$result"
            ;;
        *) echo "Error: unknown post-pr-stop action: $action" >&2; return 2 ;;
    esac
}

cmd_head_budget() {
    local action="${1:-}" issue_id="${2:-}" kind="${3:-}"
    [[ -n "$action" && -n "$issue_id" && -n "$kind" ]] || { echo "Error: head-budget needs an action, issue_id, and kind" >&2; return 2; }
    # review-wait resets on a changed head; ci-fix must not, which is what the
    # flag exists for. Every ci-fix cycle pushes its fix, so the next take
    # always sees a new head, and resetting there would give each retry a fresh
    # count with CI_FIX_MAX_CYCLES bounding nothing. A passing CI run clears it.
    local field setting head_keyed
    case "$kind" in
        review-wait) field=review_wait; setting=REVIEW_MAX_EXTERNAL_ROUNDS; head_keyed=true ;;
        ci-fix) field=ci_fix; setting=CI_FIX_MAX_CYCLES; head_keyed=false ;;
        *) echo "Error: unknown head budget: $kind" >&2; return 2 ;;
    esac
    case "$action" in
        take)
            [[ $# -eq 4 ]] || { echo "Error: head-budget take needs issue_id, kind, and head" >&2; return 2; }
            local head="$4" limit report
            limit=$(cap_limit "$setting") || return 1
            report=$(cmd_update_report "$issue_id" '
              (.post_pr_budgets[$field] // null) as $saved |
              (if $head_keyed and (($saved.head // "") != $head) then 0 else ($saved.attempts // 0) end) as $used |
              if $used >= $limit then
                {state: ., report: {verdict: "at-cap", attempts: $used, limit: $limit}}
              else
                {state: (.post_pr_budgets[$field] = {head: $head, attempts: ($used + 1)}),
                 report: {verdict: "continue", attempts: ($used + 1), limit: $limit}}
              end' --arg field "$field" --arg head "$head" --argjson limit "$limit" --argjson head_keyed "$head_keyed") || return 1
            jq -r '"\(.verdict) \(.attempts)/\(.limit)"' <<<"$report"
            ;;
        *) echo "Error: unknown head-budget action: $action" >&2; return 2 ;;
    esac
}

cmd_append() {
    local issue_id="$1"
    local field="$2"
    local value="$3"

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    # Handle nested fields (e.g., pr_comment_review.fixes)
    if [[ "$value" == "{"* ]] || [[ "$value" == "["* ]]; then
        # JSON object or array - use as-is
        atomic_update "$state_file" ".${field} += [${value}]"
    else
        # String value - use --arg for safe quoting (handles embedded quotes)
        local tmp_file="${state_file}.tmp"
        local lock_file="${state_file}.lock"
        (
            flock -w 10 200 || { echo "Error: could not acquire lock" >&2; exit 1; }
            jq --arg v "$value" ".${field} += [\$v]" "$state_file" > "$tmp_file" 2>&1 || { rm -f "$tmp_file"; exit 1; }
            jq empty "$tmp_file" 2>/dev/null || { echo "Error: invalid JSON" >&2; rm -f "$tmp_file"; exit 1; }
            mv "$tmp_file" "$state_file"
        ) 200>"$lock_file"
    fi
}

# Append one JSON value read from a FILE to an array field. The value never
# crosses argv, so text nobody here authored — a finding's root cause, a
# location, a reviewer's own words — reaches the state whatever quoting it
# carries. The field's array is created when absent.
cmd_append_file() {
    local issue_id="$1"
    local field="$2"
    local file="$3"

    [[ -n "$field" ]] || { echo "Error: append-file needs a field" >&2; return 1; }
    [[ -f "$file" ]] || { echo "Error: append-file: no such file: $file" >&2; return 1; }
    if ! jq -s -e 'length == 1' >/dev/null 2>&1 < "$file"; then
        echo "Error: append-file: $file is not exactly one JSON value" >&2; return 1
    fi

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    atomic_update "$state_file" ".${field} = ((.${field} // []) + [\$entry[0]])" \
        --slurpfile entry "$file"
}

# The round caps, spelled once: setting name, the workflow-state field its
# count is read from (empty when the caller keeps its own count), and its
# default. `cap`, the rereview_panel guard below, every refusal's roster and
# the help text derive from this table, so a cap added or renamed here needs no
# second edit kept in step, and `cap_limit` is the one place a cap resolves.
cap_table() {
    printf 'REVIEW_MAX_CYCLES\trereview_cycles\t4\n'
    printf 'REVIEW_MAX_EXTERNAL_ROUNDS\tpr_comment_review.iterations\t4\n'
    printf 'CI_FIX_MAX_CYCLES\t\t6\n'
}

# One cap's "<field><tab><default>", or the one refusal naming every known cap.
cap_row() {
    cap_table | awk -F'\t' -v want="$1" '$1 == want { print $2 "\t" $3; found = 1 } END { exit found ? 0 : 1 }' && return 0
    echo "Error: unknown round cap: $1 (known: $(cap_table | awk -F'\t' '{ printf "%s%s", sep, $1; sep = ", " }'))" >&2
    return 2
}

cap_limit() {
    local row
    row=$(cap_row "$1") || return 2
    "$SCRIPT_DIR/orch-env" "$1" "${row##*$'\t'}"
}

# The workflows' reader for the table above: a cap is read through this command
# instead of pairing an orch-env call with a private default and comparison.
#
#   cap SETTING                 -> the resolved cap number
#   cap SETTING --issue ID      -> "<below|at-cap> <count>/<cap>", count from state
#   cap SETTING --count N       -> "<below|at-cap> <N>/<cap>"
#
# `at-cap` is count >= cap: the count is entries already taken, so a count
# equal to the cap has spent the whole budget.
cmd_cap() {
    local setting="${1:-}"
    shift || true
    local issue_id="" count="" have_count=0

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --issue) [[ $# -ge 2 ]] || { echo "Error: --issue needs an ID" >&2; return 2; }
                     issue_id="$2"; shift 2 ;;
            --count) [[ $# -ge 2 ]] || { echo "Error: --count needs a number" >&2; return 2; }
                     count="$2"; have_count=1; shift 2 ;;
            *) echo "Error: cap: unknown argument: $1" >&2; return 2 ;;
        esac
    done

    local row field limit
    row=$(cap_row "$setting") || return 2
    field="${row%%$'\t'*}"
    limit=$(cap_limit "$setting") || return 2

    if [[ "$have_count" -eq 0 && -z "$issue_id" ]]; then
        printf '%s\n' "$limit"
        return 0
    fi
    if [[ "$have_count" -eq 1 && -n "$issue_id" ]]; then
        echo "Error: cap takes --issue or --count, not both" >&2; return 2
    fi

    if [[ "$have_count" -eq 0 ]]; then
        [[ -n "$field" ]] || { echo "Error: cap: $setting is not measured against workflow state; pass --count" >&2; return 2; }
        local state_file
        state_file=$(get_state_file "$issue_id")
        ensure_state_exists "$state_file"
        count=$(jq -r "(.${field} // 0) | tostring" "$state_file") || return 1
    fi
    [[ "$count" =~ ^[0-9]+$ ]] || { echo "Error: cap: count is not a whole number: $count" >&2; return 2; }

    if (( count >= limit )); then
        printf 'at-cap %s/%s\n' "$count" "$limit"
    else
        printf 'below %s/%s\n' "$count" "$limit"
    fi
}

cmd_increment() {
    local issue_id="$1"
    local field="$2"

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    atomic_update "$state_file" ".${field} += 1"
}

cmd_set() {
    local issue_id="$1"
    local field="$2"
    local value="$3"

    local state_file
    state_file=$(get_state_file "$issue_id")
    ensure_state_exists "$state_file"

    # review-pr § 4 writes `rereview_panel` to re-enter § 2: that write IS the re-review cycle, so it raises `rereview_cycles` under the same lock it is gated on, and refuses once that count reaches REVIEW_MAX_CYCLES, so the setting is the number of entries allowed. The count is entries already taken, so the comparison is >=, not >.
    # Nothing else spends that budget: `cycles` is the general fix-round tally, and § 7's QA re-check and § 2 verification pass write `qa_recheck_panel` and `verification_panel`, fields this branch never matches.
    if [[ "$field" == "rereview_panel" && "$value" == "{"* ]]; then
        local cap report
        cap=$(cap_limit REVIEW_MAX_CYCLES) || { echo "workflow-state: could not resolve REVIEW_MAX_CYCLES; rereview_panel not set" >&2; return 1; }
        report=$(cmd_update_report "$issue_id" "(.rereview_cycles // 0) as \$n | if \$n >= $cap then {state: ., report: {refused: true, entered: \$n}} else {state: (.rereview_panel = $value | .rereview_cycles = \$n + 1), report: {refused: false}} end") || return 1
        if [[ "$(jq -r '.refused' <<<"$report")" == "true" ]]; then
            echo "workflow-state: rereview_cycles is at the cap ($(jq -r '.entered' <<<"$report") >= REVIEW_MAX_CYCLES=$cap, entries already taken): the fix loop is over — no further re-review cycle and no further fix round; follow review-pr § 4 At The Cap, \"Capped items are escalated, never dropped\" — one update per still-outstanding blocker and category==fix suggestion records it in escalated_items (outcome \"blocked\") and drops its superseded fixed_items entry in the same write — then go to review-pr § 5 (verdict pass) and report them" >&2
            return 1
        fi
        return 0
    fi

    if [[ "$value" == "{"* ]] || [[ "$value" == "["* ]] || [[ "$value" == "null" ]] || [[ "$value" == "true" ]] || [[ "$value" == "false" ]] || [[ "$value" =~ ^[0-9]+$ ]]; then
        # JSON object, array, null, boolean, or number - use as-is
        atomic_update "$state_file" ".${field} = ${value}"
    else
        # String value - use --arg for safe quoting (handles embedded quotes)
        local tmp_file="${state_file}.tmp"
        local lock_file="${state_file}.lock"
        (
            flock -w 10 200 || { echo "Error: could not acquire lock" >&2; exit 1; }
            jq --arg v "$value" ".${field} = \$v" "$state_file" > "$tmp_file" 2>&1 || { rm -f "$tmp_file"; exit 1; }
            jq empty "$tmp_file" 2>/dev/null || { echo "Error: invalid JSON" >&2; rm -f "$tmp_file"; exit 1; }
            mv "$tmp_file" "$state_file"
        ) 200>"$lock_file"
    fi
}

cmd_set_git_head() {
    local issue_id="$1"
    local field="$2"
    local worktree="${3:-.}"
    local value

    value="$(git -C "$worktree" rev-parse HEAD)"
    cmd_set "$issue_id" "$field" "$value"
}

cmd_set_now() {
    local issue_id="$1"
    local field="$2"
    local value

    value="$(date +%s)"
    cmd_set "$issue_id" "$field" "$value"
}

# Generate a unique per-delegation round token, store it at <field>, and print
# it. The token binds a dev completion artifact to exactly the delegation that
# produced it (kendex#776): the writer names its file dev-return-<issue>-<RID>.json
# and embeds "round_id": RID, and dev-artifact-check resolves that exact path and
# rejects any receipt whose internal round_id differs. This deterministic identity
# replaces the earlier mtime>=dev_delegated_at freshness heuristic, which proved
# only WHEN bytes were written, not WHICH delegation wrote them.
#
# The token is a nanosecond-resolution timestamp (`date +%s%N`) plus a random
# suffix, so even rapid same-second (indeed same-millisecond) re-stamps get
# distinct tokens — unlike a concatenated `$RANDOM$RANDOM`, which is not injective
# (e.g. "1"+"20" == "12"+"0"). Both components stay within the path-safe grammar.
cmd_new_round_id() {
    local issue_id="$1"
    local field="$2"
    local value

    value="$(date +%s%N)-$RANDOM"
    cmd_set "$issue_id" "$field" "$value"
    echo "$value"
}

cmd_path() {
    local issue_id="$1"
    get_state_file "$issue_id"
}

cmd_exists() {
    local json=false

    if [[ "${1:-}" == "--json" ]]; then
        json=true
        shift
    fi

    local issue_id="${1:-}"
    if [[ -z "$issue_id" ]]; then
        echo "Error: exists requires an issue_id" >&2
        exit 2
    fi

    local state_file
    state_file=$(get_state_file "$issue_id")

    if [[ "$json" == true ]]; then
        local exists=false
        [[ -f "$state_file" ]] && exists=true
        jq -n \
          --arg issue_id "$issue_id" \
          --arg path "$state_file" \
          --argjson exists "$exists" \
          '{issue_id: $issue_id, path: $path, exists: $exists}'
        return 0
    fi

    [[ -f "$state_file" ]]
}

cmd_help() {
    cat << 'EOF'
Usage: workflow-state [--state-dir <path>] <command> <issue_id> [args...]

Global options (before the subcommand):
  --state-dir <path>            Override state directory for all subcommands.
                                Takes precedence over ORCH_STATE_DIR. Prefer this
                                flag over the ORCH_STATE_DIR=… env prefix from
                                worktree sessions: a plain flag is classifier-safe
                                under Codex approval=never.

Commands:
  init <issue_id> [options]     Create new state file
    --agent <name>              Primary agent
    --worktree <path>           Worktree path
    --branch <name>             Branch name
    --qa-labels <json_array>    QA labels (default: [])
    --sub-issues <json_array>   Sub-issue IDs (default: [])

  get <issue_id> [jq_path]      Read value (default: entire state)
  update <issue_id> [--arg NAME VALUE]... [--argjson NAME JSON]...
         [--slurpfile NAME FILE]... <jq_expr>
                                Run arbitrary jq expression. --arg binds VALUE
                                to $NAME as a literal string, --argjson binds
                                parsed JSON, --slurpfile binds FILE's values as
                                an array (a one-value file reads as $NAME[0])
                                and is passed to jq, so only the path crosses
                                argv — a document sent as an --argjson value
                                exceeds the 128 KB single-argument cap and jq
                                never launches. Text you did not author (a
                                finding's location or description, any artifact
                                field) goes in a binding and is read as $NAME —
                                interpolated instead, one apostrophe or quote
                                makes jq fail and nothing is written. Under a
                                harness that rejects $(...) and multi-command
                                blocks, --slurpfile is the only way to bind
                                artifact text: name the path, not the contents
  update-report <issue_id> <jq_expr>
                                Atomic read-modify-write-report: the jq expr
                                runs against the current state under the same
                                lock as update and must produce
                                {state: <new full state>, report: <any>} —
                                .state is written back, .report printed
                                compactly. Use when a caller needs a decision
                                and its evidence from the SAME locked step
                                (a separate get after update can interleave
                                with another writer)
  post-pr-stop record <issue_id> <name> <gate> <remaining> <comment-file>
  post-pr-stop record-if-empty <issue_id> <name> <gate> <remaining> <comment-file>
                                Atomically record or preserve the stop and
                                render its Markdown comment
  head-budget take <issue_id> <review-wait|ci-fix> <head>
                                Atomically spend an automatic retry budget.
                                review-wait restarts its count on a changed
                                head; ci-fix counts across heads, since every
                                cycle pushes one. A continuing action clears it
  append <issue_id> <field> <value>   Append to array field
  append-file <issue_id> <field> <file>
                                Append the one JSON value in <file> to the
                                array at <field>, creating it when absent. The
                                value never crosses argv, so text you did not
                                author reaches the state whatever quoting it
                                carries
  cap <setting> [--issue <id> | --count <n>]
                                Round caps. Bare: print the resolved cap.
                                With --issue: read the state field the setting
                                is measured against; with --count: use <n>.
                                Either prints "<below|at-cap> <count>/<cap>",
                                at-cap being count >= cap. Settings:
EOF
    cap_table | awk -F'\t' \
        '{ printf "%34s%s (%s, %s)\n", "", $1, ($2 == "" ? "--count only" : $2), $3 }'
    cat << 'EOF'
  increment <issue_id> <field>  Increment numeric field
  set <issue_id> <field> <value>  Set field value ({/[ prefix, null/true/false,
                                or all digits parse as JSON; anything else is
                                stored as a raw string — pass strings bare,
                                never pre-quoted '"..."')
  set-git-head <issue_id> <field> [worktree]  Set field to current HEAD SHA
  set-now <issue_id> <field>     Set field to current epoch seconds
  new-round-id <issue_id> <field>  Generate a unique per-delegation round token,
                                store it at <field>, and print it (binds a dev
                                completion artifact to its delegation — kendex#776)
  path <issue_id>               Print state file path
  exists [--json] <issue_id>    Exit 0 if exists, 1 if not; --json prints status and exits 0

Keys:
  GitHub-issue orchestration stores state under the normalized key issue-<N>.
  Every command resolves <issue_id> to that exact key — pass init the same
  spelling every later command will use.

Examples:
  workflow-state init PROJ-123 --agent rust --worktree /tmp/wt
  workflow-state exists --json PROJ-123
  workflow-state get PROJ-123 .cycles
  workflow-state increment PROJ-123 cycles
  workflow-state increment PROJ-123 pr_comment_review.iterations
  workflow-state append PROJ-123 json_paths "review.json"
  workflow-state append PROJ-123 fixed_items '{"description":"Fix","commit":"abc"}'
  workflow-state set PROJ-123 pr_review.mode review
  workflow-state set PROJ-123 pr_review_baseline '{"last_threads":["PRRT_kwDOABC123"]}'
  workflow-state set-git-head PROJ-123 pre_delegate_sha /tmp/wt
  workflow-state set-now PROJ-123 review_delegated_at
  workflow-state new-round-id PROJ-123 dev_round_id
  workflow-state update PROJ-123 '.fixed_items | map(select(.source == "qa-review"))'
  workflow-state --state-dir /path/to/tmp append PROJ-123 fixed_items '{"description":"Fix"}'

Environment:
  ORCH_STATE_DIR    Override state directory (default: tmp). Fallback for
                    --state-dir; the flag wins when both are set.

Dependencies:
  jq               JSON processing
  flock             File locking (util-linux)
EOF
}

# The one parser for the global options that may precede the subcommand, and
# for the help forms. --state-dir <path> (or --state-dir=<path>) overrides the
# state directory for EVERY subcommand and takes precedence over
# ORCH_STATE_DIR (which stays supported as a fallback). Prefer this flag from
# worktree sessions: a plain flag is classifier-safe under Codex
# approval=never, whereas an `ORCH_STATE_DIR=… workflow-state …`
# env-assignment prefix is rejected as a flagged command shape.
#
# An EMPTY value is rejected, not read as absent: `--state-dir "$VAR"` with VAR
# unset must name the mistake, not write orch state where nobody asked.
parse_global_opts() {
    STATE_DIR_FLAG=""
    GLOBAL_OPTS=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --state-dir)
                if [[ $# -lt 2 || -z "$2" ]]; then
                    echo "Error: --state-dir requires a path argument" >&2
                    exit 2
                fi
                STATE_DIR_FLAG="$2"
                GLOBAL_OPTS=$((GLOBAL_OPTS + 2))
                shift 2
                ;;
            --state-dir=*)
                STATE_DIR_FLAG="${1#--state-dir=}"
                if [[ -z "$STATE_DIR_FLAG" ]]; then
                    echo "Error: --state-dir requires a path argument" >&2
                    exit 2
                fi
                GLOBAL_OPTS=$((GLOBAL_OPTS + 1))
                shift
                ;;
            *)
                break
                ;;
        esac
    done

    case "${1:-help}" in
        help|--help|-h) cmd_help; exit 0 ;;
    esac
}

# `.env.local` is sourced as shell, so help is answered before the loader runs:
# the dry run is the real parser in a subshell, so no value parsed from the
# command line exists for the loader's generic [env] handling to clobber, and
# 9 is the only status meaning it reached the end.
parse_rc=0
( parse_global_opts "$@"; exit 9 ) || parse_rc=$?
[[ "$parse_rc" -eq 9 ]] || exit "$parse_rc"
unset parse_rc

# shellcheck source=lib/kendex-env.sh
source "$SCRIPT_DIR/lib/kendex-env.sh"
kendex_load_project_env "$PROJECT_ROOT"

# Parsed only now, so the flag the caller passed outranks every project file.
parse_global_opts "$@"
shift "$GLOBAL_OPTS"
STATE_DIR="${STATE_DIR_FLAG:-${ORCH_STATE_DIR:-tmp}}"
# Not configurable at all, and so resolved here rather than above the loader,
# which would let a settings [env] key rename the state file: the file name is
# the identity every caller and doc reference resolves, so renaming it would
# hide the state from readers that compose the path themselves.
STATE_PREFIX="workflow-state"

# Main dispatch. The help case above answered an absent or empty subcommand,
# so $1 is set and non-empty here.
case "$1" in
    init)      shift; cmd_init "$@" ;;
    get)       shift; cmd_get "$@" ;;
    update)    shift; cmd_update "$@" ;;
    update-report) shift; cmd_update_report "$@" ;;
    post-pr-stop) shift; cmd_post_pr_stop "$@" ;;
    head-budget) shift; cmd_head_budget "$@" ;;
    append)    shift; cmd_append "$@" ;;
    append-file) shift; cmd_append_file "$@" ;;
    cap)       shift; cmd_cap "$@" ;;
    increment) shift; cmd_increment "$@" ;;
    set)       shift; cmd_set "$@" ;;
    set-git-head) shift; cmd_set_git_head "$@" ;;
    set-now)   shift; cmd_set_now "$@" ;;
    new-round-id) shift; cmd_new_round_id "$@" ;;
    path)      shift; cmd_path "$@" ;;
    exists)    shift; cmd_exists "$@" ;;
    *) echo "Unknown command: $1" >&2; cmd_help >&2; exit 1 ;;
esac
