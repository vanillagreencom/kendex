#!/usr/bin/env bash
# worktree-claim verifies that an issue owns a worktree session lease. It
# claims an unleased tree and refreshes an existing lease for the same issue.
#
# Usage:
#   worktree-claim --worktree PATH --issue ID [--state-dir DIR]
#
# Stdout is the issue ID, one line. Exit 75 means another owner or a native
# lock holds the worktree. Other failures exit 1.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GUARD="${WORKTREE_SESSION_GUARD:-$SCRIPT_DIR/../../worktree/scripts/worktree-session-guard}"
EXIT_OWNED=75

usage() {
	awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
}

fail() {
	printf 'worktree-claim: %s\n' "$1" >&2
	exit 1
}

refuse() {
	printf 'worktree-claim: %s\n' "$1" >&2
	exit "$EXIT_OWNED"
}

worktree=''
issue=''
while [[ $# -gt 0 ]]; do
	case "$1" in
	--worktree) [[ $# -ge 2 ]] || fail '--worktree requires a path'; worktree="$2"; shift 2 ;;
	--issue) [[ $# -ge 2 ]] || fail '--issue requires an issue id'; issue="$2"; shift 2 ;;
	--state-dir) [[ $# -ge 2 ]] || fail '--state-dir requires a path'; shift 2 ;;
	-h | --help) usage; exit 0 ;;
	*) fail "unknown option: $1" ;;
	esac
done

[[ -n "$worktree" ]] || fail '--worktree is required'
[[ -n "$issue" ]] || fail '--issue is required'
[[ -x "$GUARD" ]] || fail "worktree-session-guard is not executable at $GUARD"
worktree_abs="$(cd -P -- "$worktree" 2>/dev/null && pwd -P)" || fail "not a directory: $worktree"

rc=0
(cd "$worktree_abs" && "$GUARD" status "$worktree_abs" --owner "$issue" >/dev/null) || rc=$?
case "$rc" in
0) action=refresh ;;
3) action=claim ;;
4) refuse "$worktree_abs is locked outside the session guard" ;;
75) refuse "$worktree_abs is claimed by another owner, not $issue" ;;
*) fail "worktree-session-guard status failed on $worktree_abs (exit $rc)" ;;
esac

rc=0
(cd "$worktree_abs" && "$GUARD" "$action" "$worktree_abs" --owner "$issue" >/dev/null) || rc=$?
case "$rc" in
0) printf '%s\n' "$issue" ;;
75) refuse "$worktree_abs was taken by another holder while refreshing it" ;;
*) fail "worktree-session-guard $action failed on $worktree_abs (exit $rc)" ;;
esac
