#!/usr/bin/env bash
# worktree-claim — possession gate for an issue worktree, over the worktree
# skill's session guard.
#
# The guard's lease is keyed to the owner string, which is the issue id, so two
# sessions working the same issue match each other's lease and an owner
# comparison alone cannot refuse a sibling writer. The lease's per-claim
# generation token can. This binds a caller to the token it took possession
# under and refuses, exit 75, once any other holder — a different issue's
# lease, a lock taken outside the guard, a sibling's re-claim, or a lease
# released underneath the expectation — would make the caller a second writer.
#
# Usage:
#   worktree-claim --worktree PATH --issue ID [--state-dir DIR]
#       Take possession and print the lease generation token. A token already
#       recorded at `.worktree_gen` in ID's workflow state is verified and
#       refreshed rather than minted over; a token minted here is recorded
#       there. With no state file the call always mints, so nothing is bound
#       across rounds.
#
#   worktree-claim --worktree PATH --issue ID --expect-gen TOKEN
#       Verify TOKEN and refresh the heartbeat. Never mints, never writes
#       workflow state. This is the form a delegated agent runs against the
#       token its delegation carried.
#
# Stdout is the effective token, one line. The guard's own diagnostics reach
# stderr unfiltered, so a refusal names the holder.
#
# Exit codes:
#   0   possession held by ISSUE under the printed token
#   1   usage or precondition failure, including a guard that cannot run
#  75   refused; another holder owns the worktree

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GUARD="${WORKTREE_SESSION_GUARD:-$SCRIPT_DIR/../../worktree/scripts/worktree-session-guard}"
WORKFLOW_STATE="$SCRIPT_DIR/workflow-state"

EXIT_USAGE=1
EXIT_OWNED=75

# worktree-session-guard status exit codes.
GUARD_NO_LEASE=3
GUARD_UNMANAGED=4

GEN_GRAMMAR='^[0-9]+-[0-9a-f]+$'

usage() {
	sed -n '2,32p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
}

fail() {
	printf 'worktree-claim: %s\n' "$1" >&2
	exit "$EXIT_USAGE"
}

refuse() {
	printf 'worktree-claim: %s\n' "$1" >&2
	exit "$EXIT_OWNED"
}

worktree=''
issue=''
expect_gen=''
state_dir=''

while [[ $# -gt 0 ]]; do
	case "$1" in
	--worktree)
		[[ $# -ge 2 ]] || fail "--worktree requires a path"
		worktree="$2"
		shift 2
		;;
	--issue)
		[[ $# -ge 2 ]] || fail "--issue requires an issue id"
		issue="$2"
		shift 2
		;;
	--expect-gen)
		[[ $# -ge 2 ]] || fail "--expect-gen requires a lease generation token"
		expect_gen="$2"
		shift 2
		;;
	--state-dir)
		[[ $# -ge 2 ]] || fail "--state-dir requires a path"
		state_dir="$2"
		shift 2
		;;
	-h | --help)
		usage
		exit 0
		;;
	*) fail "unknown option: $1" ;;
	esac
done

[[ -n "$worktree" ]] || fail "--worktree is required"
[[ -n "$issue" ]] || fail "--issue is required"
[[ -z "$expect_gen" || "$expect_gen" =~ $GEN_GRAMMAR ]] \
	|| fail "--expect-gen takes a lease generation token, got: $expect_gen"

# A guard that cannot run leaves possession unproven, which is the one outcome
# this gate exists to prevent — so it is a hard failure, never a pass-through.
[[ -x "$GUARD" ]] \
	|| fail "worktree-session-guard is not executable at $GUARD; possession cannot be verified"

worktree_abs="$(cd -P -- "$worktree" 2>/dev/null && pwd -P)" \
	|| fail "not a directory: $worktree"

# `claim` and `refresh` reject --repo, so the guard derives the repository from
# the working directory; run every guard call from inside the target worktree.
guard_run() {
	(cd "$worktree_abs" && "$GUARD" "$@" >/dev/null)
}

STATUS_JSON=''
STATUS_RC=0
guard_status() {
	STATUS_RC=0
	STATUS_JSON="$(cd "$worktree_abs" && "$GUARD" status "$worktree_abs" --owner "$issue")" \
		|| STATUS_RC=$?
}

status_generation() {
	printf '%s\n' "$STATUS_JSON" | jq -r '.generation // empty'
}

# Map a status exit code onto this gate's contract. Every state that is not
# "a guard lease owned by ISSUE" refuses, so a caller branching on 75 covers
# foreign owners, foreign locks, and a released lease alike.
require_owned_status() {
	local context="$1"
	case "$STATUS_RC" in
	0) return 0 ;;
	"$GUARD_NO_LEASE")
		refuse "$worktree_abs carries no session lease ($context); take possession before working here"
		;;
	"$GUARD_UNMANAGED")
		refuse "$worktree_abs is locked outside the session guard ($context); resolve that lock before working here"
		;;
	"$EXIT_OWNED")
		refuse "$worktree_abs is claimed by another owner, not $issue ($context)"
		;;
	*)
		fail "worktree-session-guard status failed on $worktree_abs (exit $STATUS_RC)"
		;;
	esac
}

require_generation() {
	local expected="$1" context="$2" recorded
	recorded="$(status_generation)"
	[[ "$recorded" == "$expected" ]] || refuse \
		"$worktree_abs was re-claimed since it was checked (expected gen=$expected, lease records gen=${recorded:-none}); another session holds it ($context)"
}

# Verify TOKEN, refresh the heartbeat, then verify again. The second read is
# what makes the refresh safe to report: a sibling that claimed between the
# first read and the refresh keeps its own generation across that refresh, so
# only re-reading proves the token this call returns is the one on the lease.
verify_and_refresh() {
	local expected="$1"

	guard_status
	require_owned_status "before refresh"
	require_generation "$expected" "before refresh"

	local rc=0
	guard_run refresh "$worktree_abs" --owner "$issue" || rc=$?
	case "$rc" in
	0) ;;
	"$EXIT_OWNED") refuse "$worktree_abs was taken by another holder while refreshing it" ;;
	*) fail "worktree-session-guard refresh failed on $worktree_abs (exit $rc)" ;;
	esac

	guard_status
	require_owned_status "after refresh"
	require_generation "$expected" "after refresh"

	printf '%s\n' "$expected"
}

take_possession() {
	local rc=0 minted
	guard_run claim "$worktree_abs" --owner "$issue" || rc=$?
	case "$rc" in
	0) ;;
	"$EXIT_OWNED") refuse "$worktree_abs is held by another owner or by a lock outside the guard, not $issue" ;;
	*) fail "worktree-session-guard claim failed on $worktree_abs (exit $rc)" ;;
	esac

	guard_status
	require_owned_status "after claim"
	minted="$(status_generation)"
	[[ "$minted" =~ $GEN_GRAMMAR ]] \
		|| fail "the session guard recorded no usable lease generation on $worktree_abs"
	printf '%s\n' "$minted"
}

if [[ -n "$expect_gen" ]]; then
	verify_and_refresh "$expect_gen"
	exit 0
fi

state_flags=()
[[ -z "$state_dir" ]] || state_flags=(--state-dir "$state_dir")

# workflow-state resolves a relative state dir against the working directory,
# so both the path read and the write below run from the worktree — the same
# tmp/ that holds the round's artifacts.
state_file="$(cd "$worktree_abs" && "$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} path "$issue")" \
	|| fail "could not resolve the workflow state path for $issue"
[[ "$state_file" == /* ]] || state_file="$worktree_abs/$state_file"

stored_gen=''
if [[ -f "$state_file" ]]; then
	stored_gen="$(cd "$worktree_abs" \
		&& "$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} get "$issue" '.worktree_gen // empty')" \
		|| fail "could not read .worktree_gen from $state_file"
fi

if [[ "$stored_gen" =~ $GEN_GRAMMAR ]]; then
	verify_and_refresh "$stored_gen"
	exit 0
fi

minted="$(take_possession)"
if [[ -f "$state_file" ]]; then
	(cd "$worktree_abs" \
		&& "$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} set "$issue" worktree_gen "$minted") >/dev/null \
		|| fail "could not record .worktree_gen in $state_file"
fi
printf '%s\n' "$minted"
