#!/usr/bin/env bash
# worktree-push — push an issue worktree and reconcile rebased commit SHAs in
# workflow state, in one call.
#
# `worktree push` auto-rebases onto the updated base and prints one
# 'rebase-map: <old-sha> <new-sha>' line per rewritten commit, with the
# literal word `dropped` in place of the new SHA when the replayed patch was
# already upstream. Those printed lines are replayed to the caller and never
# parsed here: the push records the same map as a hop in the worktree's
# `kendex-rebase-map`, and that file is what this reconciles from, because a
# map read out of the transcript would be read out of a temporary capture this
# process removes on exit. Every SHA recorded in workflow state before that
# rebase
# — `fixed_items[].commit`, `pr_comment_review.fixes[].commit` — is stale the
# moment the map prints, and publishing a stale SHA is forbidden. This
# wrapper closes that gap at push time instead of leaving the remap to the
# calling agent:
#
#   - merges every mapping into `.rebase_map` (old -> new, `dropped` stored
#     literally);
#   - rewrites each recorded fix commit whose SHA is a prefix of a mapped old
#     SHA: to the new SHA truncated to the recorded length, or to the marked
#     form `dropped:<recorded-sha>` when the mapping is `dropped` — the
#     commit does not exist on the branch, so publishers must omit it or
#     cite the upstream equivalent, never print it as a live SHA;
#   - prints `sha-reconcile: map_entries=N fixed_items=N pr_fixes=N`.
#     submit-pr routes this summary and the exit code before publishing SHAs.
#
# A completed guarded restack (`worktree create --reuse`, `create --restack`,
# `restack continue|skip`) rewrites the same commits in an earlier process, and
# records its map the same way: a `rebase-hop:` line opening that rewrite's
# hop, then one `rebase-map:` line per rewritten commit. Each rewrite appends
# its own hop, so a worktree restacked twice before one push holds two.
#
# This wrapper consumes that file twice, once before it runs the push and once
# after, since the push writes its own hop during the run. Both consumes use
# the same grammar and the same reconciliation, printing one
# `restack-reconcile: map_entries=N fixed_items=N pr_fixes=N` line per hop
# standing before the push and a `sha-reconcile:` line for the push's own.
# Every hop is a separate
# reconciliation because each one compares a record against the value it held
# when that reconciliation began: a record the first hop moved from X to Y is
# at Y when the second hop's Y-to-Z arrives, and the push's own hop then takes
# it further. Read as one merged map the hops would all be compared against X,
# leaving the record on Y — a commit the later restack rewrote away, so on no
# branch. The file is deleted only once every hop is in workflow state.
# Anything that stops a hop refuses before the push, where nothing new has gone
# stale, and keeps the whole file, naming in `hops_applied` how many hops
# reached workflow state before the refusal; `--check-live-round` consumes
# nothing and deletes nothing.
#
# The same file carries one more line: `rebase-unmapped: <head>`, which a push
# or a restack writes BEFORE it rewrites that head and clears once the rewrite
# is mapped or unwound. It stands wherever a rewrite happened that no map
# describes, whether the tool refused or a kill left it no chance to. No
# mapping repairs that, so this refuses on the line before it applies any hop
# and publishes nothing. An operator reconciles the recorded SHAs against the
# worktree reflog and removes the file, which is also what clears it for
# `worktree push`.
#
# A fix round in flight is refused rather than reconciled: its record pins the
# commit the delegated agent is working from, and the rebase this command runs
# would move every commit out from under it, leaving the round's receipt to
# name a `.commit` that does not exist on the branch. The round in flight is the ACTIVE
# one — the record whose token equals workflow state `dev_round_id`. Two things
# end that: the round's dev-return receipt landing, or a fresh `dev_round_id`
# whose token names no stamped record. A prior round's leftover record does
# not block, and neither does a worktree with no state file.
#
# `--check-live-round` runs that question alone and exits on its answer,
# pushing nothing. It exists for merge-pr's restack cycle, which rebases
# without reaching this script's push, so that path asks the owner of the
# predicate instead of restating its arms in prose.
#
# The rebase happens BEFORE the network push, so a rejected push can still
# have rewritten the branch: the map is applied to workflow state whatever the
# push's exit code. A state write that fails leaves the rebase-map lines in
# the replayed transcript as the only copy, and says so on stderr.
#
# Artifact-sourced SHAs (for example a perf QA `benchmark_commit`) are not in
# workflow state; publishers resolve those through `.rebase_map`, following
# the chain until no key matches.
#
# Usage:
#   worktree-push --worktree PATH --issue ID [--state-dir DIR] [push flags...]
#   worktree-push --check-live-round --worktree PATH --issue ID [--state-dir DIR]
#
# Every argument outside this wrapper's own namespace (--worktree, --issue,
# --state-dir, --check-live-round, --help) is forwarded verbatim to
# `worktree push`, which rejects
# a flag it does not know. The push flag vocabulary lives there alone; see
# `worktree push --help`, which is where a mistyped flag is caught. The state
# resolution above the push is what stands between a wrong argument and a wrong
# write, refusing a state that records another issue or another worktree.
# State directory resolution is defined by `workflow-state --help`.
#
# Exit codes:
#   push failed  -> the push's own exit code, always — any printed map is
#                   applied to workflow state where possible, and a map that
#                   cannot even be parsed is reported on stderr without
#                   changing the exit code, with the transcript (its
#                   rebase-map lines included) replayed first as the
#                   surviving copy. A pre-push hook's refusal is this case:
#                   any rebase the refused run made already ran and its map
#                   was applied where possible, so fixing what the hook named
#                   and re-running publishes the branch without redoing that
#                   rebase and with no hand-run git command. A default branch
#                   that advanced since is rebased onto again under the same
#                   authorization.
#   push ok      -> 0 when no rebase-map printed, or every mapping was
#                   recorded and applied
#   1 (pushed)   -> the push landed but reconciliation did not (no state file,
#                   unparseable map line, jq/update failure). The recorded SHAs
#                   are NOT reconciled, and the keyed line carries `push-exit`
#                   to say the push had already run. The map is not lost with
#                   the run: the whole map file is kept, so repairing what the
#                   diagnostic names and re-running consumes it before that
#                   run's own push. A map file this cannot parse at all is the
#                   one case needing hand repair, and it names the file.
#   1 (no push)  -> the run refused before the push: a usage error, a state
#                   that would not resolve, a state that does not match the
#                   arguments, or a live fix round in the worktree.
#                   Nothing was pushed and nothing was rebased, no
#                   map was printed, and no recorded SHA went stale. Correct
#                   the arguments or the state named on stderr and re-run —
#                   that IS the repair here; there is nothing to hand-apply.
#                   A restack hop the run could not apply refuses here too:
#                   the restack's own rewrite already made the recorded SHAs
#                   stale, so the whole file named on stderr is kept, earlier
#                   hops included, because it holds the mappings that repair
#                   them. A hop already recorded before the failing one is
#                   recorded, and applying that hop's lines again is a no-op:
#                   its old SHAs no longer match what the record holds.
#   --check-live-round only:
#                   0 no round in flight, the branch may be rebased; 3 a fix
#                   round is live; 1 the question could not be answered (an
#                   unreadable state, a usage error), which is not permission.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKTREE_BIN="${ORCH_WORKTREE_BIN:-$SCRIPT_DIR/../../worktree/scripts/worktree}"
WORKFLOW_STATE="$SCRIPT_DIR/workflow-state"

SHA_GRAMMAR='^[0-9a-f]{40}$'
ISSUE_GRAMMAR='^[A-Za-z0-9][A-Za-z0-9._-]*$'
# The line one restack's hop opens with in the map file, the same literal the
# worktree script writes there — the wire format between the two scripts, like
# the `rebase-map: ` prefix itself.
RESTACK_HOP_MARK='rebase-hop:'
# The line a push auto-rebase leaves in the same file when it rewrote the
# branch without a derivable map. It names the pre-rebase head and stands until
# an operator clears the file, so it is the same literal the worktree script
# writes there.
RESTACK_UNMAPPED_MARK='rebase-unmapped:'

# The leading comment block is the contract, printed by shape rather than by
# line number so --help cannot drift as that block grows.
usage() {
	awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
}

# Each diagnostic starts with a stable reason and its relevant values.
# Explanation text lives here; callers select the reason and supply values.
message() {
	local reason="$1"
	shift
	printf 'worktree-push: %s' "$reason"
	printf ' %s' "$@"
	printf '\n'
	case "$reason" in
	missing-value) printf 'The option requires a value.\n' ;;
	required) printf 'The required option is missing.\n' ;;
	invalid-issue) printf 'The issue ID must be safe for a state file path.\n' ;;
	check-argument) printf 'The live-round check cannot forward push arguments.\n' ;;
	not-executable) printf 'The worktree script is not executable.\n' ;;
	missing-command) printf 'Install the command to reconcile rebased SHAs.\n' ;;
	not-directory) printf 'The worktree directory does not resolve.\n' ;;
	not-worktree) printf 'The directory is not a Git worktree.\n' ;;
	restack-map-path) printf 'The worktree-private rebase-map file could not be resolved. No push ran.\n' ;;
	rebase-unmapped) printf 'An earlier rebase rewrote this branch from the head named above without a derivable commit map, so recorded SHAs are unreconciled in a way no mapping repairs and none may be published. Nothing was reconciled and the whole file was kept. Reconcile every recorded SHA against the worktree reflog, then remove the file.\n' ;;
	restack-map-grammar) printf 'The restack rebase-map file is not a hop record this can apply: each hop opens with its own boundary line and holds at least one mapping. hops_applied is how many complete hops before it reached workflow state, and the whole file was kept. Apply the rebase-map lines after those hops with workflow-state update, then remove the file.\n' ;;
	restack-map-nostate) printf 'No workflow state records this issue, so it holds no SHA a restack could have made stale and nothing can hold the map. Init the record and re-run, or remove the map file.\n' ;;
	restack-map-write) printf 'A restack hop was not recorded. hops_applied is how many hops before it reached workflow state, and the whole file was kept. Repair workflow state, then apply the rebase-map lines after those hops with workflow-state update before publishing recorded SHAs.\n' ;;
	restack-map-clear) printf 'The reconciled restack rebase-map file could not be removed, so a later run would read it again. Remove it, then re-run.\n' ;;
	state-resolve) printf 'Workflow state could not be resolved. No push ran.\n' ;;
	state-answer) printf 'The workflow-state existence result is invalid. No push ran.\n' ;;
	state-read) printf 'Workflow state could not be read. No push ran.\n' ;;
	issue-mismatch) printf 'Workflow state belongs to another issue. No push ran.\n' ;;
	state-worktree) printf 'The worktree recorded in workflow state does not resolve.\n' ;;
	worktree-mismatch) printf 'Workflow state belongs to another worktree. No push ran.\n' ;;
	round-read) printf 'The active dev round could not be read. No push ran.\n' ;;
	live-round) printf 'The active fix round has no dev-return receipt. Land its receipt or stamp a fresh dev_round_id before rebasing.\n' ;;
	temp-file) printf 'The push output could not be captured. No push ran.\n' ;;
	map-sha) printf 'A rebase-map SHA is invalid. The mappings that map carries are not reconciled.\n' ;;
	map-build) printf 'The rebase map could not be assembled. The mappings it carries are not reconciled.\n' ;;
	esac
}

fail() {
	message "$@" >&2
	exit 1
}

# Check mode distinguishes a live round from an unreadable state.
refuse_live_round() {
	message live-round "round=$1" "worktree=$worktree_abs" >&2
	if [[ "$check_live_round" == true ]]; then
		exit 3
	fi
	exit 1
}

worktree=''
issue=''
state_dir=''
check_live_round=false
push_args=()

while [[ $# -gt 0 ]]; do
	case "$1" in
	--worktree)
		[[ $# -ge 2 ]] || fail missing-value option=--worktree
		worktree="$2"
		shift 2
		;;
	--worktree=*)
		worktree="${1#--worktree=}"
		shift
		;;
	--issue)
		[[ $# -ge 2 ]] || fail missing-value option=--issue
		issue="$2"
		shift 2
		;;
	--issue=*)
		issue="${1#--issue=}"
		shift
		;;
	--state-dir)
		[[ $# -ge 2 ]] || fail missing-value option=--state-dir
		state_dir="$2"
		shift 2
		;;
	--state-dir=*)
		state_dir="${1#--state-dir=}"
		shift
		;;
	--check-live-round)
		check_live_round=true
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	# Everything outside this wrapper's own namespace is `worktree push`'s to
	# accept or reject; push fails closed on a flag it does not know, so
	# pass-through here keeps one copy of that vocabulary.
	*)
		push_args+=("$1")
		shift
		;;
	esac
done

[[ -n "$worktree" ]] || fail required option=--worktree
[[ -n "$issue" ]] || fail required option=--issue
[[ "$issue" =~ $ISSUE_GRAMMAR && "$issue" != *..* ]] || fail invalid-issue "issue=$issue"
# Check mode never reaches the push, so nothing forwards push_args and a
# mistyped flag would simply vanish: --sate-dir=... would leave the check
# reading a different workflow state and answering about the wrong one. An
# argument the check cannot honour leaves its answer unfounded, and an
# unfounded answer is not permission to rebase.
if [[ "$check_live_round" == true ]] && (( ${#push_args[@]} > 0 )); then
	fail check-argument "argument=${push_args[0]}"
fi
[[ -x "$WORKTREE_BIN" ]] || fail not-executable "path=$WORKTREE_BIN"
command -v jq >/dev/null 2>&1 || fail missing-command command=jq

worktree_abs="$(cd -P -- "$worktree" 2>/dev/null && pwd -P)" \
	|| fail not-directory "path=$worktree"
git -C "$worktree_abs" rev-parse --absolute-git-dir >/dev/null 2>&1 \
	|| fail not-worktree "path=$worktree_abs"

state_flags=()
[[ -z "$state_dir" ]] || state_flags=(--state-dir "$state_dir")

# Assemble one JSON object from `rebase-map: <old> <new|dropped>` lines into
# MAP_JSON. One grammar and one assembler serve both maps: the one a completed
# restack left in the worktree and the one this run's own push prints. A
# refusal leaves its message arguments in MAP_FAIL_ARGS for the caller to
# report, because a refusal before the push and one after it differ in what
# they must say.
MAP_JSON='{}'
MAP_FAIL_ARGS=()
parse_map_lines() {
	local lines="$1" old='' new=''
	MAP_JSON='{}'
	MAP_FAIL_ARGS=()
	[[ -n "$lines" ]] || return 0
	while IFS=' ' read -r _ old new; do
		if [[ ! "$old" =~ $SHA_GRAMMAR ]]; then
			MAP_FAIL_ARGS=(map-sha field=old "sha=$old")
			return 1
		fi
		if [[ "$new" != "dropped" && ! "$new" =~ $SHA_GRAMMAR ]]; then
			MAP_FAIL_ARGS=(map-sha field=new "sha=$new")
			return 1
		fi
		MAP_JSON="$(jq -c --arg o "$old" --arg n "$new" '. + {($o): $n}' <<<"$MAP_JSON")" || {
			MAP_FAIL_ARGS=(map-build)
			return 1
		}
	done <<<"$lines"
}

# Apply one map (a JSON object of before->after) to workflow state atomically and
# print the caller's summary line under its own key. The map travels by
# environment variable so the jq program stays a plain single-quoted literal. A
# recorded short SHA matches when it is a prefix of a mapped old SHA;
# comparisons always run against the entry's original value so one map's
# mappings cannot chain through each other — which is why a restack hop and a
# push hop are applied as two sequential calls rather than one merged map.
reconcile_map() {
	local key="$1" map_json="$2" report
	report="$(WTP_MAP="$map_json" "$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} update-report "$issue" '
		def remap($map): . as $sha
		  | reduce ($map | to_entries[]) as $e ($sha;
		      if ($e.key | startswith($sha))
		      then (if $e.value == "dropped" then "dropped:" + $sha else $e.value[0:($sha | length)] end)
		      else . end);
		($ENV.WTP_MAP | fromjson) as $map
		| . as $s
		| ($s.fixed_items // []) as $fi
		| ($s.pr_comment_review.fixes // []) as $pf
		| ($fi | map(if (.commit? // "") != "" then .commit |= remap($map) else . end)) as $fi2
		| ($pf | map(if (.commit? // "") != "" then .commit |= remap($map) else . end)) as $pf2
		| {
		    state: ($s
		      | .rebase_map = ((.rebase_map // {}) + $map)
		      | .fixed_items = $fi2
		      | .pr_comment_review = ((.pr_comment_review // {}) | .fixes = $pf2)),
		    report: {
		      map_entries: ($map | length),
		      fixed_items: ([range(0; ($fi | length)) | select($fi[.] != $fi2[.])] | length),
		      pr_fixes: ([range(0; ($pf | length)) | select($pf[.] != $pf2[.])] | length)
		    }
		  }')" || return 1

	printf '%s: map_entries=%s fixed_items=%s pr_fixes=%s\n' \
		"$key" \
		"$(jq -r '.map_entries' <<<"$report")" \
		"$(jq -r '.fixed_items' <<<"$report")" \
		"$(jq -r '.pr_fixes' <<<"$report")"
}

# A state resolved from the wrong arguments would rewrite another record's
# commits and report success while the intended state stayed stale, so the
# selected state must agree with the arguments before anything runs. Nothing
# below stands in: nothing refuses one session calling twice with a swapped
# --issue, --worktree or --state-dir. An empty recorded worktree cannot be
# verified and is taken as-is. `exists --json` answers {path, exists}. Only a
# definite yes or no may reach the push: the rebase it is about to run has no
# reconciliation target otherwise.
state_exists_rc=0
state_info="$("$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} exists --json "$issue")" || state_exists_rc=$?
if [[ "$state_exists_rc" -ne 0 ]]; then
	fail state-resolve "issue=$issue" "exit=$state_exists_rc"
fi
state_file="$(jq -r '.path // ""' <<<"$state_info")"
state_present="$(jq -r '.exists' <<<"$state_info")"
[[ -n "$state_file" && ( "$state_present" == "true" || "$state_present" == "false" ) ]] \
	|| fail state-answer "issue=$issue" "answer=$state_info"
if [[ "$state_present" == "true" ]]; then
	state_issue="$("$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} get "$issue" '.issue_id // ""')" \
		|| fail state-read "issue=$issue"
	if [[ "$state_issue" != "$issue" ]]; then
		fail issue-mismatch "issue=$issue" "recorded=$state_issue"
	fi
	state_wt="$("$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} get "$issue" '.worktree // ""')" \
		|| fail state-read "issue=$issue"
	if [[ -n "$state_wt" ]]; then
		state_wt_abs="$(cd -P -- "$state_wt" 2>/dev/null && pwd -P)" \
			|| fail state-worktree "issue=$issue" "path=$state_wt"
		[[ "$state_wt_abs" == "$worktree_abs" ]] \
			|| fail worktree-mismatch "issue=$issue" "recorded=$state_wt_abs" "worktree=$worktree_abs"
	fi
fi
# Refuse before the push, where nothing is rebased and nothing needs repair.
# The two state reads above answer the first two arms already: an `exists` that
# fails, and an answer that is neither yes nor no, both leave the question
# unanswered, and an unanswered question is not permission to rebase. What is
# left is the active round itself. With no state file there is no active round
# to read, and a record from a prior round does not block.
if [[ "$state_present" == "true" ]]; then
	active_round="$("$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} get "$issue" '.dev_round_id // ""')" \
		|| fail round-read "issue=$issue"
	if [[ -n "$active_round" ]] \
		&& [[ -e "$worktree_abs/tmp/dev-round-$issue-$active_round.json" ]] \
		&& [[ ! -e "$worktree_abs/tmp/dev-return-$issue-$active_round.json" ]]; then
		refuse_live_round "$active_round"
	fi
fi
# The question is answered and the answer is no. In check mode that is the
# whole run: nothing is pushed, nothing is rebased. Check mode consumes no
# restack map and deletes no file: it answers one question and changes nothing.
[[ "$check_live_round" != true ]] || exit 0

# Every rewrite this repository makes leaves its map in the worktree's own git
# dir, as one hop per rewrite; the worktree script asks git for this same path.
# A restack's hops are already there when this runs, and the push below writes
# its own during the run, so the file is consumed twice: once before the push
# and once after it. Each hop is its own reconcile_map call, because each call
# compares a record against the value it held when that call began: a record
# the first restack moved X -> Y is at Y when the second hop's Y -> Z arrives,
# and the push's own hop then takes it further. A file read as one merged map
# would compare every entry against X and strand the record on Y, a commit no
# branch has. The file is deleted only once every hop it held is in workflow
# state, and any failure keeps the whole file.
if ! restack_map_file="$(git -C "$worktree_abs" rev-parse --git-path kendex-rebase-map 2>/dev/null)" \
	|| [[ -z "$restack_map_file" ]]; then
	fail restack-map-path "worktree=$worktree_abs"
fi
[[ "$restack_map_file" == /* ]] || restack_map_file="$worktree_abs/$restack_map_file"

restack_hop_lines=''
restack_hop_open=false
restack_hops=0
restack_summary_key=restack-reconcile
restack_pushed=false

# A refusal before the push means nothing was pushed and the arguments or the
# state are the repair; one after it means the push landed and its own exit
# code has to survive. Same refusals and same values either way, plus the
# push's exit code on the later ones, which is what tells the two apart on the
# keyed line as well as in this command's own exit status.
consume_fail() {
	if [[ "$restack_pushed" == true ]]; then
		fail_post_push "$@" "push-exit=$push_rc"
	fi
	fail "$@"
}

# Reconcile the hop that just ended, if one was open. Called at each boundary
# and once more at end of file, so the last hop is not left unapplied.
reconcile_restack_hop() {
	[[ "$restack_hop_open" == true ]] || return 0
	[[ -n "$restack_hop_lines" ]] || consume_fail restack-map-grammar "file=$restack_map_file" "hops_applied=$restack_hops"
	parse_map_lines "$restack_hop_lines" \
		|| consume_fail "${MAP_FAIL_ARGS[@]}" "file=$restack_map_file" "hops_applied=$restack_hops"
	reconcile_map "$restack_summary_key" "$MAP_JSON" \
		|| consume_fail restack-map-write "issue=$issue" "state=$state_file" "file=$restack_map_file" "hops_applied=$restack_hops"
	restack_hops=$((restack_hops + 1))
	restack_hop_lines=''
}

# Apply every hop the file holds, in order, then delete it. Reports each hop
# under the caller's summary key: the hops standing before the push are other
# rewrites' and the one written during it is this push's own.
consume_rebase_map_file() {
	restack_summary_key="$1"
	restack_hop_lines=''
	restack_hop_open=false
	restack_hops=0
	[[ -e "$restack_map_file" ]] || return 0
	# A rewrite with no derivable map is recorded in this file too, and it is
	# read before any hop is applied: no mapping repairs that rewrite, so
	# nothing here may be reconciled or published while it stands, and the hops
	# stay in the file for the operator reading it.
	restack_unmapped=''
	while IFS= read -r restack_line || [[ -n "$restack_line" ]]; do
		case "$restack_line" in
		"$RESTACK_UNMAPPED_MARK "*) restack_unmapped="${restack_line#"$RESTACK_UNMAPPED_MARK" }" ;;
		esac
	done <"$restack_map_file"
	[[ -z "$restack_unmapped" ]] \
		|| consume_fail rebase-unmapped "head=$restack_unmapped" "file=$restack_map_file"
	# The record names SHAs recorded against a state file. With no record there
	# is nothing the hops could move, and nothing this run can hold them in.
	[[ "$state_present" == "true" ]] \
		|| consume_fail restack-map-nostate "issue=$issue" "state=$state_file" "file=$restack_map_file"
	while IFS= read -r restack_line || [[ -n "$restack_line" ]]; do
		case "$restack_line" in
		"$RESTACK_HOP_MARK")
			reconcile_restack_hop
			restack_hop_open=true
			;;
		'rebase-map: '*)
			# A mapping outside a hop has no order, so the file is not a record
			# this can apply rather than one hop it may guess at.
			[[ "$restack_hop_open" == true ]] || consume_fail restack-map-grammar "file=$restack_map_file" "hops_applied=$restack_hops"
			restack_hop_lines="${restack_hop_lines:+$restack_hop_lines$'\n'}$restack_line"
			;;
		*) consume_fail restack-map-grammar "file=$restack_map_file" "hops_applied=$restack_hops" ;;
		esac
	done <"$restack_map_file"
	reconcile_restack_hop
	[[ "$restack_hops" -gt 0 ]] || consume_fail restack-map-grammar "file=$restack_map_file" "hops_applied=$restack_hops"
	rm -f -- "$restack_map_file" || consume_fail restack-map-clear "file=$restack_map_file"
}

consume_rebase_map_file restack-reconcile

push_out="$(mktemp)" || fail temp-file command=mktemp
trap 'rm -f "$push_out"' EXIT

# Push stderr streams through live; stdout is captured and replayed below,
# where the reason it is captured rather than passed through is written down.
push_rc=0
"$WORKTREE_BIN" push "$worktree_abs" ${push_args[@]+"${push_args[@]}"} >"$push_out" || push_rc=$?

# A failure after the push keeps the push's own exit code: exit 1 must mean
# "the push landed but reconciliation did not", never dress a failed push as
# a landed one. It replays nothing: every caller runs after the replay below,
# so the transcript is already on the caller's terminal, and printing it again
# would print each of the push's records twice.
fail_post_push() {
	message "$@" >&2
	if [[ "$push_rc" -ne 0 ]]; then
		exit "$push_rc"
	fi
	exit 1
}

# The transcript is replayed, never parsed: the push's own map reaches this
# process as a hop in the worktree's map file, consumed below. A map read from
# here instead would be read out of a temporary capture this process removes on
# exit, which is no record at all.
cat "$push_out" || true

restack_pushed=true
consume_rebase_map_file sha-reconcile
exit "$push_rc"
