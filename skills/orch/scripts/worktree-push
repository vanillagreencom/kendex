#!/usr/bin/env bash
# worktree-push — push an issue worktree and reconcile rebased commit SHAs in
# workflow state, in one call.
#
# `worktree push` auto-rebases onto the updated base and prints one
# 'rebase-map: <old-sha> <new-sha>' line per rewritten commit, with the
# literal word `dropped` in place of the new SHA when the replayed patch was
# already upstream. Every SHA recorded in workflow state before that rebase
# — `fixed_items[].commit`, `pr_comment_review.fixes[].commit` — is stale the
# moment the map prints, and publishing a stale SHA is forbidden. This
# wrapper closes that gap at push time instead of leaving the remap to the
# calling agent:
#
#   - merges every mapping into `.rebase_map` (old -> new, `dropped` stored
#     literally);
#   - rewrites each recorded fix commit whose SHA is a prefix of a mapped old
#     SHA: to the new SHA truncated to the recorded length, or to the marked
#     form `dropped:<recorded-sha>` when the mapping is `dropped` — the
#     commit no longer exists on the branch, so publishers must omit it or
#     cite the upstream equivalent, never print it as a live SHA;
#   - remaps the active, live fix-round base_sha in the external authorization and
#     worktree recovery copy together, refusing divergent copies, ambiguous
#     same-subject mappings, or a dropped base whose exact replacement snapshot
#     is unknown;
#   - prints one `sha-reconcile:` summary line naming what changed.
#
# The rebase happens BEFORE the network push, so a rejected push can still
# have rewritten the branch. The parsed map is persisted to a sidecar file in
# the worktree's own git dir
# (<git-dir>/worktree-push-pending-map-<canonical-key>.json, the git dir
# being .git/worktrees/<name>/ for a linked worktree) before the state write
# and deleted only after the write lands; every run consumes a pending
# sidecar before pushing, so a retry re-applies a map an earlier run could
# not record. The git dir is never tracked content, so nothing a branch
# ships can plant or redirect the sidecar.
#
# Artifact-sourced SHAs (for example a perf QA `benchmark_commit`) are not in
# workflow state; publishers resolve those through `.rebase_map`, following
# the chain until no key matches.
#
# Usage:
#   worktree-push --worktree PATH --issue ID [--state-dir DIR] [push flags...]
#
# Every argument outside this wrapper's own namespace (--worktree, --issue,
# --state-dir, --help) is forwarded verbatim to `worktree push`, which rejects
# a flag it does not know. The push flag vocabulary lives there alone; see
# `worktree push --help`, which is where a mistyped flag is caught. What
# stands between a wrong argument and a wrong write is the state resolution
# above the sidecar: a state file recording another issue or another worktree
# is refused, an ambiguous one is refused, and a reconcile that fails keeps
# the sidecar for the retry.
# The state file resolves exactly like any other workflow-state call:
# --state-dir, then $ORCH_STATE_DIR, then tmp/ under the caller's working
# directory.
#
# Exit codes:
#   push failed  -> the push's own exit code, always — any printed map is
#                   applied to workflow state where possible, left in the
#                   sidecar when that write fails, and a map that cannot
#                   even be parsed is reported on stderr without changing
#                   the exit code, with the transcript (its rebase-map
#                   lines included) replayed first as the surviving copy.
#                   A sidecar that cannot be written still gets its map
#                   applied to workflow state directly
#   push ok      -> 0 when no rebase-map printed, or every mapping was
#                   recorded and applied
#   1            -> the push landed (or never ran: usage error, pending
#                   sidecar, or ambiguous/mismatched state before the push) but
#                   reconciliation did not (no state file, unparseable map
#                   line, jq/update failure). The recorded SHAs are NOT
#                   reconciled — repair state, then re-run to consume the
#                   sidecar, before publishing any of them.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
WORKTREE_BIN="${ORCH_WORKTREE_BIN:-$SCRIPT_DIR/../../worktree/scripts/worktree}"
WORKFLOW_STATE="$SCRIPT_DIR/workflow-state"

SHA_GRAMMAR='^[0-9a-f]{40}$'
ISSUE_GRAMMAR='^[A-Za-z0-9][A-Za-z0-9._-]*$'

# The leading comment block is the contract, printed by shape rather than by
# line number so --help cannot drift as that block grows.
usage() {
	awk 'NR == 1 { next } /^#/ { sub(/^# ?/, ""); print; next } { exit }' "${BASH_SOURCE[0]}"
}

fail() {
	printf 'worktree-push: %s\n' "$1" >&2
	exit 1
}

worktree=''
issue=''
state_dir=''
push_args=()

while [[ $# -gt 0 ]]; do
	case "$1" in
	--worktree)
		[[ $# -ge 2 ]] || fail "--worktree requires a path"
		worktree="$2"
		shift 2
		;;
	--worktree=*)
		worktree="${1#--worktree=}"
		shift
		;;
	--issue)
		[[ $# -ge 2 ]] || fail "--issue requires an issue id"
		issue="$2"
		shift 2
		;;
	--issue=*)
		issue="${1#--issue=}"
		shift
		;;
	--state-dir)
		[[ $# -ge 2 ]] || fail "--state-dir requires a path"
		state_dir="$2"
		shift 2
		;;
	--state-dir=*)
		state_dir="${1#--state-dir=}"
		shift
		;;
	-h | --help)
		usage
		exit 0
		;;
	# Everything outside this wrapper's own namespace is `worktree push`'s to
	# accept or reject; push fails closed on a flag it does not know, so
	# pass-through here keeps one copy of that vocabulary (KEN-570).
	*)
		push_args+=("$1")
		shift
		;;
	esac
done

[[ -n "$worktree" ]] || fail "--worktree is required"
[[ -n "$issue" ]] || fail "--issue is required"
[[ "$issue" =~ $ISSUE_GRAMMAR && "$issue" != *..* ]] || fail "invalid issue id: $issue"
[[ -x "$WORKTREE_BIN" ]] || fail "worktree script is not executable at $WORKTREE_BIN"
command -v jq >/dev/null 2>&1 || fail "jq is required to reconcile rebased SHAs"

worktree_abs="$(cd -P -- "$worktree" 2>/dev/null && pwd -P)" \
	|| fail "not a directory: $worktree"
git_dir="$(git -C "$worktree_abs" rev-parse --absolute-git-dir 2>/dev/null)" \
	|| fail "not a git worktree: $worktree_abs"
git_common_dir="$(git -C "$worktree_abs" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" \
	|| fail "could not resolve the git common directory for $worktree_abs"

state_flags=()
[[ -z "$state_dir" ]] || state_flags=(--state-dir "$state_dir")

authorization_mapping_is_unambiguous() {
	local base_sha="$1" map_json="$2" base_subject old_sha old_subject old_shas has_drop
	has_drop="$(jq -er 'any(.[]; . == "dropped") | tostring' <<<"$map_json")" || {
		printf 'worktree-push: could not determine the rebase-map pairing mode\n' >&2
		return 1
	}
	[[ "$has_drop" == "true" ]] || return 0
	base_subject="$(git -C "$worktree_abs" show -s --format=%s "$base_sha^{commit}" 2>/dev/null)" || {
		printf 'worktree-push: could not read authorization base commit %s while checking its rebase mapping\n' "$base_sha" >&2
		return 1
	}
	old_shas="$(jq -er 'keys[]' <<<"$map_json")" || {
		printf 'worktree-push: could not enumerate the rebase map while checking authorization base %s\n' "$base_sha" >&2
		return 1
	}
	while IFS= read -r old_sha; do
		[[ "$old_sha" != "$base_sha" ]] || continue
		old_subject="$(git -C "$worktree_abs" show -s --format=%s "$old_sha^{commit}" 2>/dev/null)" || {
			printf 'worktree-push: could not read mapped commit %s while checking authorization base %s\n' "$old_sha" "$base_sha" >&2
			return 1
		}
		if [[ "$old_subject" == "$base_subject" ]]; then
			printf 'worktree-push: ambiguous authorization base %s: mapped commit %s has the same subject\n' "$base_sha" "$old_sha" >&2
			return 1
		fi
	done <<<"$old_shas"
}

reconcile_round_authorizations() {
	local map_json="$1" active_round_id="$2" auth_dir auth round_id recovery base_sha new_sha live
	local auth_tmp recovery_tmp auth_backup recovery_backup
	[[ -n "$active_round_id" ]] || return 0
	[[ "$active_round_id" =~ ^[A-Za-z0-9._-]+$ && "$active_round_id" != *..* ]] || {
		printf 'worktree-push: workflow state has invalid dev_round_id: %s\n' "$active_round_id" >&2
		return 1
	}
	auth_dir="$git_common_dir/kendex/dev-round-authorizations"
	[[ -d "$auth_dir" ]] || return 0
	auth="$auth_dir/$state_key-$active_round_id.json"
	if [[ -e "$auth" || -L "$auth" ]]; then
		[[ -f "$auth" && ! -L "$auth" ]] || {
			printf 'worktree-push: round authorization is not a regular file: %s\n' "$auth" >&2
			return 1
		}
		live="$(jq -er 'if has("live") then select((.live | type) == "boolean") | (.live | tostring) else "true" end' "$auth")" || {
			printf 'worktree-push: authorization has no usable liveness state: %s\n' "$auth" >&2
			return 1
		}
		[[ "$live" == "true" ]] || return 0
		base_sha="$(jq -er 'select((.base_sha? | type) == "string" and .base_sha != "") | .base_sha' "$auth")" || {
			printf 'worktree-push: authorization has no usable base_sha: %s\n' "$auth" >&2
			return 1
	}
	new_sha="$(jq -r --arg base "$base_sha" '.[$base] // empty' <<<"$map_json")" || return 1
		[[ -n "$new_sha" ]] || return 0
		authorization_mapping_is_unambiguous "$base_sha" "$map_json" || return 1
		round_id="$(jq -r '.round_id // ""' "$auth")" || return 1
		[[ "$round_id" == "$active_round_id" ]] || {
			printf 'worktree-push: authorization round %s does not match active dev round %s\n' "$round_id" "$active_round_id" >&2
			return 1
		}
		recovery="$worktree_abs/tmp/dev-round-$state_key-$round_id.json"
		[[ -f "$recovery" && ! -L "$recovery" ]] || {
			printf 'worktree-push: recovery copy missing or not regular for %s: %s\n' "$auth" "$recovery" >&2
			return 1
		}
		jq -e --slurpfile recovery "$recovery" --arg issue "$state_key" \
			--arg round "$round_id" --arg worktree "$worktree_abs" '
			.schema_version == 1 and .issue == $issue and .round_id == $round
			and .worktree == $worktree and ($recovery | length) == 1
			and $recovery[0].schema_version == 2
			and $recovery[0].issue == .issue and $recovery[0].round_id == .round_id
			and $recovery[0].base_sha == .base_sha and $recovery[0].adds == .adds
			and $recovery[0].items == .items
		' "$auth" >/dev/null 2>&1 || {
			printf 'worktree-push: authorization and recovery copy diverge for round %s\n' "$round_id" >&2
			return 1
		}
		[[ "$new_sha" != "dropped" ]] || {
			printf 'worktree-push: round %s base %s was dropped; no exact replacement snapshot is known\n' "$round_id" "$base_sha" >&2
			return 1
		}
		auth_tmp="$(mktemp "$auth_dir/.round-auth-remap.XXXXXX")" || return 1
		recovery_tmp="$(mktemp "$worktree_abs/tmp/.round-recovery-remap.XXXXXX")" || {
			rm -f "$auth_tmp"
			return 1
		}
		jq --arg base "$new_sha" '.base_sha = $base' "$auth" >"$auth_tmp" \
			&& jq --arg base "$new_sha" '.base_sha = $base' "$recovery" >"$recovery_tmp" || {
			rm -f "$auth_tmp" "$recovery_tmp"
			return 1
		}
		auth_backup="$(mktemp "$auth_dir/.round-auth-backup.XXXXXX")" || {
			rm -f "$auth_tmp" "$recovery_tmp"
			return 1
		}
		recovery_backup="$(mktemp "$worktree_abs/tmp/.round-recovery-backup.XXXXXX")" || {
			rm -f "$auth_tmp" "$recovery_tmp" "$auth_backup"
			return 1
		}
		rm -f "$auth_backup" "$recovery_backup"
		ln "$auth" "$auth_backup" && ln "$recovery" "$recovery_backup" || {
			rm -f "$auth_tmp" "$recovery_tmp" "$auth_backup" "$recovery_backup"
			return 1
		}
		if ! mv -f "$auth_tmp" "$auth"; then
			rm -f "$recovery_tmp" "$auth_backup" "$recovery_backup"
			return 1
		fi
		if ! mv -f "$recovery_tmp" "$recovery"; then
			if ! mv -f "$auth_backup" "$auth"; then
				printf 'worktree-push: failed to restore authorization after recovery-copy remap failed: %s\n' "$auth" >&2
			fi
			rm -f "$recovery_tmp" "$recovery_backup"
			return 1
		fi
		rm -f "$auth_backup" "$recovery_backup"
	fi
}

# Apply one map (a JSON object of old->new) to workflow state atomically and
# print the sha-reconcile summary. The map travels by environment variable so
# the jq program stays a plain single-quoted literal. A recorded short SHA
# matches when it is a prefix of a mapped old SHA; comparisons always run
# against the entry's original value so one push's mappings cannot chain
# through each other.
reconcile_map() {
	local map_json="$1" report round_id
	round_id="$("$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} get "$issue" '.dev_round_id // ""')" || return 1
	reconcile_round_authorizations "$map_json" "$round_id" || return 1
	report="$(WTP_MAP="$map_json" "$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} update-report "$issue" '
		def remap($map): . as $sha
		  | reduce ($map | to_entries[]) as $e ($sha;
		      if ($e.key | startswith($sha))
		      then (if $e.value == "dropped" then "dropped:" + $sha else $e.value[0:($sha | length)] end)
		      else . end);
		($ENV.WTP_MAP | fromjson) as $map
		| . as $s
		| ($s.fixed_items // []) as $fi
		| ($s.pr_comment_review.fixes // []) as $pf
		| ($fi | map(if (.commit? // "") != "" then .commit |= remap($map) else . end)) as $fi2
		| ($pf | map(if (.commit? // "") != "" then .commit |= remap($map) else . end)) as $pf2
		| {
		    state: ($s
		      | .rebase_map = ((.rebase_map // {}) + $map)
		      | .fixed_items = $fi2
		      | .pr_comment_review = ((.pr_comment_review // {}) | .fixes = $pf2)),
		    report: {
		      map_entries: ($map | length),
		      fixed_items: ([range(0; ($fi | length)) | select($fi[.] != $fi2[.])] | length),
		      pr_fixes: ([range(0; ($pf | length)) | select($pf[.] != $pf2[.])] | length)
		    }
		  }')" || return 1

	printf 'sha-reconcile: rebase_map +%s, fixed_items %s rewritten, pr_comment_review.fixes %s rewritten\n' \
		"$(jq -r '.map_entries' <<<"$report")" \
		"$(jq -r '.fixed_items' <<<"$report")" \
		"$(jq -r '.pr_fixes' <<<"$report")"
}

# A workflow state resolved from the wrong arguments would rewrite another
# record's commits and report success while the intended state stays stale,
# so the selected state must agree with the arguments before anything runs.
# The bare-numeric alias (issue N stored under issue-N) is the one accepted
# spelling difference; an empty recorded worktree cannot be verified and is
# accepted as-is. `exists --json` answers {path, exists} and errors (exit 2)
# when BOTH the bare-numeric and issue-N files exist and the target is
# ambiguous. Only a definite yes or no may reach the push: an ambiguous or
# unreadable state cannot be the reconciliation target of the rebase the
# push is about to perform.
state_exists_rc=0
state_info="$("$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} exists --json "$issue")" || state_exists_rc=$?
if [[ "$state_exists_rc" -ne 0 ]]; then
	fail "could not resolve the workflow state for '$issue' (exists exit $state_exists_rc; the error above names the conflicting files); refusing to push a rebase whose reconciliation target is ambiguous"
fi
state_file="$(jq -r '.path // ""' <<<"$state_info")"
state_present="$(jq -r '.exists' <<<"$state_info")"
[[ -n "$state_file" && ( "$state_present" == "true" || "$state_present" == "false" ) ]] \
	|| fail "unexpected exists --json answer for '$issue': $state_info"
if [[ "$state_present" == "true" ]]; then
	state_issue="$("$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} get "$issue" '.issue_id // ""')" \
		|| fail "could not read the workflow state for $issue"
	if [[ "$state_issue" != "$issue" ]] \
		&& ! [[ "$issue" =~ ^[0-9]+$ && "$state_issue" == "issue-$issue" ]]; then
		fail "workflow state for '$issue' records issue_id '$state_issue'; refusing to rewrite another issue's record"
	fi
	state_wt="$("$WORKFLOW_STATE" ${state_flags[@]+"${state_flags[@]}"} get "$issue" '.worktree // ""')" \
		|| fail "could not read the workflow state for $issue"
	if [[ -n "$state_wt" ]]; then
		state_wt_abs="$(cd -P -- "$state_wt" 2>/dev/null && pwd -P)" \
			|| fail "workflow state for $issue records worktree '$state_wt', which does not resolve; refusing to reconcile against it"
		[[ "$state_wt_abs" == "$worktree_abs" ]] \
			|| fail "workflow state for $issue records worktree '$state_wt_abs', not '$worktree_abs'; refusing to rewrite another worktree's record"
	fi
fi

# The sidecar is recovery state, so it lives in the worktree's own git dir —
# never tracked content, so nothing a branch ships can plant or redirect it —
# under ONE canonical key per issue, used for write and lookup alike so every
# accepted spelling hits the same file: the key of the resolved state file
# when one exists, and the normalized issue-N key when none does (a missing
# state resolves to the raw spelling, but GitHub-issue orchestration inits
# state under issue-N, so a bare-numeric push that strands a map and an
# issue-N retry that must consume it have to agree on one name).
state_key="$(basename -- "$state_file")"
state_key="${state_key#workflow-state-}"
state_key="${state_key%.json}"
if [[ "$state_present" != "true" && "$issue" =~ ^[0-9]+$ ]]; then
	state_key="issue-$issue"
fi
sidecar="$git_dir/worktree-push-pending-map-$state_key.json"

# A sidecar left by an earlier run is a rebase that already happened; its map
# must land before this run pushes (and possibly rebases again). Only this
# tool writes in the git dir, so the content is trusted; a damaged file still
# fails closed — reconcile_map's fromjson errors and the map is kept.
#
# It reconciles HERE, above the push, and not below it (KEN-907): once this
# run has pushed it has already rebased, so a reconcile that fails down there
# would exit with this run's own map persisted nowhere, and the retry does
# not rebase again to reprint it.
if [[ -f "$sidecar" ]]; then
	pending_map="$(cat -- "$sidecar")" || fail "could not read the pending rebase map at $sidecar"
	reconcile_map "$pending_map" \
		|| fail "a pending rebase map from an earlier push could not be applied to $issue's workflow state; recorded SHAs are NOT reconciled (map kept at $sidecar)"
	rm -f -- "$sidecar"
fi

push_out="$(mktemp)" || fail "could not create a temporary file for the push output"
trap 'rm -f "$push_out"' EXIT

# Push stderr streams through live; stdout is captured, then replayed after
# the rebase map is safely parsed and persisted — see below.
push_rc=0
"$WORKTREE_BIN" push "$worktree_abs" ${push_args[@]+"${push_args[@]}"} >"$push_out" || push_rc=$?

# A failure after the push keeps the push's own exit code: exit 1 must mean
# "the push landed but reconciliation did not", never dress a failed push as
# a landed one. The transcript replays first: on these paths no sidecar
# exists, so the rebase-map lines in the transcript are the only surviving
# copy of a map the completed rebase cannot regenerate (|| true keeps the
# dying-stdout case from suppressing the diagnostic).
fail_post_push() {
	cat "$push_out" || true
	printf 'worktree-push: %s\n' "$1" >&2
	if [[ "$push_rc" -ne 0 ]]; then
		exit "$push_rc"
	fi
	exit 1
}

map_lines=''
grep_rc=0
map_lines="$(grep '^rebase-map: ' "$push_out")" || grep_rc=$?
[[ "$grep_rc" -le 1 ]] \
	|| fail_post_push "could not scan the push output for rebase-map lines (grep exit $grep_rc, push exit $push_rc); recorded SHAs are NOT reconciled"

map_json='{}'
if [[ -n "$map_lines" ]]; then
	while IFS=' ' read -r _ old new; do
		[[ "$old" =~ $SHA_GRAMMAR ]] \
			|| fail_post_push "unparseable rebase-map line (old SHA '$old', push exit $push_rc); recorded SHAs are NOT reconciled"
		[[ "$new" == "dropped" || "$new" =~ $SHA_GRAMMAR ]] \
			|| fail_post_push "unparseable rebase-map line (new SHA '$new', push exit $push_rc); recorded SHAs are NOT reconciled"
		map_json="$(jq -c --arg o "$old" --arg n "$new" '. + {($o): $n}' <<<"$map_json")" \
			|| fail_post_push "could not assemble the rebase map (push exit $push_rc); recorded SHAs are NOT reconciled"
	done <<<"$map_lines"
fi

# The rebase is local reality even when the network push failed, so the map
# is persisted BEFORE the transcript replay and applied regardless of the
# push's exit code; the sidecar survives a failed state write (or a dying
# stdout) for the retry to consume. The state write is independent of the
# sidecar, so a sidecar that cannot be written still gets its map applied —
# a sidecar failure alone costs only the retry convenience; only both failing
# together loses the reconciliation, with the transcript's map lines as the
# surviving copy.
reconciled_without_sidecar=false
if [[ "$map_json" != '{}' ]]; then
	# Staged via mktemp and renamed into place, so a torn write never leaves
	# a plausible half-map at the sidecar name.
	sidecar_err=''
	stage=''
	if ! stage=$(mktemp -- "$sidecar.XXXXXX"); then
		sidecar_err="could not create a staging file for the rebase-map sidecar in $git_dir"
	elif ! printf '%s\n' "$map_json" >"$stage"; then
		rm -f -- "$stage"
		sidecar_err="could not write the rebase-map sidecar staging file at $stage"
	elif ! mv -- "$stage" "$sidecar"; then
		rm -f -- "$stage"
		sidecar_err="could not move the rebase-map sidecar into place at $sidecar"
	fi
	if [[ -n "$sidecar_err" ]]; then
		if reconcile_map "$map_json"; then
			reconciled_without_sidecar=true
			printf 'worktree-push: %s; the map was still applied to workflow state\n' "$sidecar_err" >&2
		else
			fail_post_push "$sidecar_err AND the map could not be applied to workflow state; recorded SHAs are NOT reconciled — the rebase-map lines in the transcript above are the only copy"
		fi
	fi
fi

# The replay is informational; a broken stdout must not abort the run before
# the map reaches workflow state (the sidecar already has it either way).
cat "$push_out" || true

if [[ "$map_json" == '{}' ]]; then
	exit "$push_rc"
fi

if [[ "$reconciled_without_sidecar" == true ]]; then
	exit "$push_rc"
fi

if reconcile_map "$map_json"; then
	rm -f -- "$sidecar"
	exit "$push_rc"
fi

printf 'worktree-push: the rebase map was NOT recorded for %s; recorded SHAs are NOT reconciled (map kept at %s — repair workflow state and re-run)\n' \
	"$issue" "$sidecar" >&2
if [[ "$push_rc" -ne 0 ]]; then
	exit "$push_rc"
fi
exit 1
