#!/bin/bash
# The stub harness the one-job suite launches in place of a model. Its `#!`
# line names bash directly rather than `env`, so the kernel records this
# script's own name, the basename of the program ORCH_HARNESS_BINARIES
# configures, for the pane's foreground process; the runtime's judge reads
# the pane idle only when that process is the harness's (decision 60). It
# ignores every launch flag, draws Claude Code's composer marker, then
# executes the lane's workflow commands deterministically:
# skills/orch/workflows/start-worktree.md § 1 and its section 2.1,
# skills/orch/workflows/dev-start.md § 2 and its section 3 with the dev
# result written in place of the dev agent
# (skills/dev/workflows/dev-implement.md § 5 and its sections 7 and 10),
# skills/orch/workflows/small.md § 2 and its section 3 with
# skills/orch/workflows/review-pr.md § 1 through its section 3.1 and the
# review JSON written in place of the reviewer,
# skills/orch/workflows/submit-pr.md § 2.1, the verification of decision 46
# and skills/orch/workflows/start-worktree.md § 5.4; or
# skills/orch/workflows/micro.md § 1 through its section 3 for a micro item.
# Every step runs the real script; nothing here fakes a script's output. The
# runtime operations the driver owns (decision 50) run through
# scripts/orch-runtime: state init, begin-round, record-validation-admission,
# accept-result and record-verification.
#
# The opening instruction, the last word of argv, is the brief the suite
# wrote: one key=value line per fact the lane needs (item, tier, tracker,
# repo, number, worktree, main, fixture_lib). Progress goes to
# <worktree>/tmp/lane-status, one `step=<name>` line per step and a final
# `lane-done` or `lane-failed step=<name>`; command output goes to
# <worktree>/tmp/lane.log. After the job the stub idles on stdin until the
# window is closed, as a harness waits at its composer.

printf '\xe2\x9d\xaf\xc2\xa0\n'
printf '  ? for shortcuts\n'

eval "brief=\${$#}"
ITEM="" TIER="" TRACKER="" GH_REPO_SLUG="" NUMBER="" WT="" MAIN="" FIXTURE_LIB=""
while IFS='=' read -r key value; do
  case "$key" in
    item) ITEM="$value" ;;
    tier) TIER="$value" ;;
    tracker) TRACKER="$value" ;;
    repo) GH_REPO_SLUG="$value" ;;
    number) NUMBER="$value" ;;
    worktree) WT="$value" ;;
    main) MAIN="$value" ;;
    fixture_lib) FIXTURE_LIB="$value" ;;
  esac
done <<EOF
$brief
EOF

idle() {
  while IFS= read -r _line; do :; done
  exit 0
}
[ -n "$WT" ] && [ -d "$WT" ] || { printf 'stub-harness: brief-worktree-missing\n' >&2; idle; }
mkdir -p "$WT/tmp"
STATUS="$WT/tmp/lane-status"
LOG="$WT/tmp/lane.log"
: > "$STATUS"
: > "$LOG"
exec >>"$LOG" 2>&1

step() { printf 'step=%s\n' "$1" >> "$STATUS"; printf '\n== %s\n' "$1"; }
fail() {
  printf 'lane-failed step=%s\n' "$1" >> "$STATUS"
  printf 'lane-failed step=%s\n' "$1"
  idle
}
# The runtime's reply: `ok` must be true, and the report is printed.
op() { # TARGET REQUEST_JSON
  local request reply
  request="$WT/tmp/op-request.json"
  printf '%s\n' "$2" > "$request"
  reply="$("$ORCH/orch-runtime" op "$1" "$ITEM" --request "$request")" || return 1
  jq -e '.ok == true' <<<"$reply" >/dev/null || return 1
  jq -c '.result.report' <<<"$reply"
}

printf 'lane-env: PATH=%s gh=%s\n' "$PATH" "$(command -v gh || echo none)"
cd "$WT" || fail cd
ORCH=.agents/skills/orch/scripts
WORKTREE=.agents/skills/worktree/scripts
MAILBOX=.agents/skills/mailbox/scripts
BRANCH="$(git branch --show-current)" || fail branch

# --- skills/orch/workflows/start-worktree.md § 1 / skills/orch/workflows/micro.md § 1: open the session ---
step identity
if [ "$TRACKER" = github ]; then
  id="$("$ORCH/git-context" issue-from-branch .)" || fail issue-from-branch
  [ "$id" = "$ITEM" ] || fail issue-from-branch-value
fi
standing="$("$ORCH/workflow-state" handoff-standing "$ITEM")" || fail handoff-standing
case "$standing" in
  "workflow-state: handoff-standing=none "*) ;;
  *) fail handoff-standing-value ;;
esac
step claim
"$WORKTREE/worktree-session-guard" claim "$WT" --owner "$ITEM" --adopt || fail claim
step init
"$ORCH/workflow-state" exists --json "$ITEM" || fail exists
"$ORCH/orch-runtime" state init --item "$ITEM" --worktree "$WT" --branch "$BRANCH" || fail init
if [ "$TIER" = micro ]; then
  "$ORCH/workflow-state" set "$ITEM" tier micro || fail tier
else
  "$ORCH/workflow-state" set "$ITEM" tier standard || fail tier-standard
  "$ORCH/workflow-state" set "$ITEM" tier "$TIER" || fail tier
fi
step base-freshness
"$ORCH/base-freshness" "$WT" || fail base-freshness

if [ "$TIER" = micro ]; then
  # --- skills/orch/workflows/micro.md § 2: the commit chain, the edit, the commit by name ---
  step hooks-armed
  hooks="$(git rev-parse --git-path hooks)" || fail hooks-path
  [ -x "$hooks/pre-commit" ] || fail hooks-unarmed
  step edit
  sed 's/hello\\n/hello, world\\n/' lib.sh > lib.sh.new && mv -- lib.sh.new lib.sh || fail edit
  sed 's/= hello \]/= "hello, world" ]/' tests/greet.test.sh > tests/greet.test.sh.new \
    && mv -- tests/greet.test.sh.new tests/greet.test.sh || fail edit-test
  porcelain="$(git status --porcelain)" || fail porcelain
  [ -n "$porcelain" ] || fail edit-empty
  git add lib.sh tests/greet.test.sh || fail add
  git commit -qm "fix($ITEM): greet the world" || fail commit
else
  # --- skills/orch/workflows/start-worktree.md § 2.1: publication order ---
  step pr-order
  order="$(env -u GH_REPO -u GITHUB_REPOSITORY "$ORCH/pr-order" "$WT")" || fail pr-order
  [ "$order" = "pr-order=review-first" ] || fail pr-order-value
  "$ORCH/workflow-state" set "$ITEM" pr_order review-first || fail pr-order-set

  # --- skills/orch/workflows/dev-start.md § 1 and its section 2: labels, stamps, delegation record ---
  step dev-round
  if [ "$TRACKER" = github ]; then
    labels="$(gh issue view "$NUMBER" --json labels --jq '.labels[].name')" || fail labels
    [ -z "$labels" ] || fail labels-value
  fi
  "$ORCH/workflow-state" set-git-head "$ITEM" pre_delegate_sha "$WT" || fail pre-delegate-sha
  begun="$(op --item '{"op": "begin-round", "kind": "dev"}')" || fail begin-round
  RID="$(jq -er '.round_id' <<<"$begun")" || fail begin-round-id
  "$ORCH/round-prune" "$ITEM" || fail round-prune
  "$ORCH/workflow-state" set-now "$ITEM" dev_delegated_at || fail dev-delegated-at
  "$ORCH/workflow-state" get "$ITEM" '.near_ceiling // []' || fail near-ceiling-read
  "$ORCH/workflow-state" update "$ITEM" \
    '.child_sessions["dev"] = {"status": "active", "agent_id": "stub-dev", "runtime_agent_type": "stub", "agent_type_fallback": null}' \
    || fail child-session

  # --- skills/dev/workflows/dev-implement.md § 5 and its sections 7 and 10: the dev result ---
  # A small-class change: a second function past the micro production
  # ceiling, so review-depth selects package review, and its test.
  step dev-result
  cat >> lib.sh <<'SH'

# farewell NAME prints the parting line for NAME, formal for a title.
farewell() {
  local name="$1" line
  case "$name" in
    "")
      line="goodbye"
      ;;
    Dr.*|Prof.*)
      line="good day, $name"
      ;;
    *)
      line="goodbye, $name"
      ;;
  esac
  printf '%s\n' "$line"
}

# salute NAME greets then takes leave, the two lines a visit makes.
salute() {
  greet
  farewell "$1"
}

# visitors COUNT prints COUNT salutes for the names on stdin.
visitors() {
  local count="$1" name read_count=0
  while IFS= read -r name; do
    salute "$name"
    read_count=$((read_count + 1))
    [ "$read_count" -lt "$count" ] || break
  done
}
SH
  cat > tests/farewell.test.sh <<'SH'
#!/usr/bin/env bash
set -euo pipefail
. "$(dirname -- "$0")/../lib.sh"
[ "$(farewell "")" = goodbye ]
[ "$(farewell Ada)" = "goodbye, Ada" ]
[ "$(farewell "Dr. Ada")" = "good day, Dr. Ada" ]
[ "$(printf 'Ada\nBob\n' | visitors 1 | wc -l | tr -d ' ')" = 2 ]
SH
  git add -A || fail add
  step validate
  # skills/dev/workflows/dev-implement.md § 5: the configured validation through dev-validate-run,
  # whose detached run prints its run directory first and blocks until the
  # verdict. The admission is recorded against that directory as soon as the
  # runner names it, before any result is read (decision 51).
  "$ORCH/dev-validate-run" --worktree "$WT" --poll 1 > tmp/validate.out 2> tmp/validate.err &
  validate_pid=$!
  tries=0
  RUN_DIR=""
  while [ -z "$RUN_DIR" ]; do
    RUN_DIR="$(sed -n 's/^state=started run-dir=\([^ ]*\).*/\1/p' tmp/validate.out 2>/dev/null)"
    [ -n "$RUN_DIR" ] && break
    tries=$((tries + 1))
    [ "$tries" -lt 1200 ] || fail validate-start
    kill -0 "$validate_pid" 2>/dev/null || fail validate-exited
    sleep 0.05
  done
  step admission
  admitted="$(op --item "$(jq -cn --arg r "$RID" --arg d "$RUN_DIR" '{op: "record-validation-admission", round_id: $r, run_dir: $d}')")" \
    || fail admission
  jq -e '.admitted_now == true' <<<"$admitted" >/dev/null || fail admission-repeat
  wait "$validate_pid" || fail validate-run
  done_line="$(sed -n 's/^state=done .*validate=\([^ ]*\).*/\1/p' tmp/validate.out)" || fail validate-read
  [ "$done_line" = pass ] || fail validate-verdict
  step commit
  git commit -qm "feat($ITEM): add farewell and salute" || fail commit
  SHA="$(git rev-parse HEAD)" || fail head
  step receipt
  printf '## Completion Summary\n\nAdded farewell, salute and visitors with their test.\n' > "tmp/completion-summary-$ITEM.md"
  receipt="$("$ORCH/dev-return-write" --worktree "$WT" --kind implement --issue "$ITEM" --round-id "$RID" \
    --branch "$BRANCH" --commit "$SHA" --validate pass --validate-run-dir "$RUN_DIR" --no-labels \
    --near-ceiling-base origin/main --summary-file "tmp/completion-summary-$ITEM.md" --no-summary)" || fail receipt
  [ -f "$receipt" ] || fail receipt-path

  # --- skills/orch/workflows/dev-start.md § 3: accept the round ---
  step accept
  round="$("$ORCH/workflow-state" get "$ITEM" '.dev_round_id // empty')" || fail round-read
  [ "$round" = "$RID" ] || fail round-value
  check="$("$ORCH/dev-artifact-check" --worktree "$WT" --issue "$ITEM" --round-id "$RID")" || fail artifact-check
  [ "$(jq -r '.verdict' <<<"$check")" = accept ] || fail artifact-verdict
  pre="$("$ORCH/workflow-state" get "$ITEM" '.pre_delegate_sha // empty')" || fail pre-read
  [ "$pre" != "$SHA" ] || fail head-unchanged
  [ -z "$(git status --porcelain)" ] || fail dirty
  [ "$(jq -r '.commit' "$receipt")" = "$SHA" ] || fail receipt-commit
  accepted="$(op --item "$(jq -cn --arg r "$RID" --arg d "$RUN_DIR" '{op: "accept-result", round_id: $r, run_dir: $d}')")" \
    || fail accept-result
  jq -e '.closed_now == true and .kind == "validate"' <<<"$accepted" >/dev/null || fail accept-result-value
  "$ORCH/workflow-state" update "$ITEM" '.qa_labels = [] | .sub_issues = []' || fail qa-state

  # --- skills/orch/workflows/small.md § 2: the branch against its class ---
  step tier-check
  base="$("$ORCH/resolve-base-branch" "$WT")" || fail base-branch
  tier_line="$("$ORCH/item-tier" --floor small --base "origin/$base" --head HEAD --repo "$WT")" || fail item-tier
  case "$tier_line" in tier=small*) ;; *) fail item-tier-value ;; esac

  # --- skills/orch/workflows/small.md § 3, then skills/orch/workflows/review-pr.md § 1 through its section 3.1 ---
  step review-depth
  [ -z "$(git status --porcelain)" ] || fail review-dirty
  floor="$("$ORCH/workflow-state" get "$ITEM" '.review_floor // "micro"')" || fail review-floor
  depth_line="$("$MAIN/.agents/skills/reviewer/scripts/review-depth" --base "origin/$base" --head HEAD --repo "$WT" --floor "$floor")" \
    || fail review-depth
  depth="${depth_line#*review_depth=}"
  depth="${depth%% *}"
  printf 'review-depth: %s\n' "$depth_line"
  [ "$depth" != none ] || fail review-depth-none
  step review-panel
  if [ "$TRACKER" = github ]; then
    gh issue view "$NUMBER" --repo "$GH_REPO_SLUG" --json body --jq .body > tmp/done-when.md || fail done-when
  fi
  "$ORCH/workflow-state" set "$ITEM" first_panel \
    '{"agents": ["reviewer-correctness"], "reason": "domains touched: lib.sh", "external": false}' || fail first-panel
  review_begun="$(op --item '{"op": "begin-round", "kind": "review"}')" || fail begin-review
  RRID="$(jq -er '.round_id' <<<"$review_begun")" || fail begin-review-id
  "$ORCH/workflow-state" set-now "$ITEM" review_delegated_at || fail review-delegated-at
  "$ORCH/workflow-state" update "$ITEM" \
    '.review_agents = ["reviewer-correctness"] | .review_agent_ids = {} | .review_agent_runtime_types = {}' || fail review-agents
  artifact="$("$ORCH/review-artifact-check" --path "$WT" reviewer-correctness)" || fail review-path
  # The reviewer's artifact, written in place of the reviewer: a pass over
  # the reviewed head with a clean tree, in the shape the content gates read.
  jq -cn --arg head "$SHA" \
    '{agent: "reviewer-correctness", verdict: "pass", blockers: [], suggestions: [], head: $head, dirty_paths: []}' \
    > "$artifact.tmp" && mv -- "$artifact.tmp" "$artifact" || fail review-write
  step review-accept
  delegated_at="$("$ORCH/workflow-state" get "$ITEM" .review_delegated_at)" || fail review-delegated-read
  verdict_json="$("$ORCH/review-artifact-check" "$WT" reviewer-correctness "$delegated_at" --issue "$ITEM")" || fail review-check
  jq -e '.ok == true and .reason == "valid"' <<<"$verdict_json" >/dev/null || fail review-check-value
  "$ORCH/workflow-state" append "$ITEM" json_paths "$artifact" || fail json-paths
  review_accepted="$(op --item "$(jq -cn --arg r "$RRID" '{op: "accept-result", round_id: $r}')")" || fail accept-review
  jq -e '.kind == "review"' <<<"$review_accepted" >/dev/null || fail accept-review-value
  tier_line="$("$ORCH/item-tier" --floor small --base "origin/$base" --head HEAD --repo "$WT")" || fail item-tier-review
  case "$tier_line" in tier=small*) ;; *) fail item-tier-review-value ;; esac
fi

# --- skills/orch/workflows/submit-pr.md § 2.1: base publication ---
step delivery-setting
delivery="$("$ORCH/orch-env" ORCH_DELIVERY pr)" || fail orch-env
[ "$delivery" = push-base ] || fail delivery-value
if [ "$TRACKER" = github ]; then
  gh issue view "$NUMBER" --repo "$GH_REPO_SLUG" --json body > tmp/post-merge-read.json || fail post-merge-read
  body="$(jq -r '.body' tmp/post-merge-read.json)" || fail post-merge-body
  case "$body" in *"Post-merge:"*) fail post-merge-box ;; esac
fi
step review-gate
BASE_REVIEW_STATE="$("$ORCH/workflow-state" get "$ITEM" '{tier: (.tier // "standard"), json_paths: (.json_paths // [])}')" || fail gate-read
jq -e --arg lifecycle managed --arg verdict pass \
  '.tier == "micro" or (if $lifecycle == "managed" then $verdict == "pass" else (.json_paths | length) > 0 end)' \
  <<<"$BASE_REVIEW_STATE" >/dev/null || fail gate-unaccepted
step prepare
BOUND_HEAD="$(git rev-parse --verify HEAD)" || fail bound-head
prepared="$("$ORCH/worktree-push" --prepare-base --worktree "$WT" --issue "$ITEM")" || fail prepare
receipt_line="$(sed -n 's/^prepared-base: //p' <<<"$prepared")"
PREPARED_BASE="${receipt_line#* before=}"
PREPARED_BASE="${PREPARED_BASE%% *}"
PREPARED_HEAD="${receipt_line##* commit=}"
[ -n "$PREPARED_BASE" ] && [ -n "$PREPARED_HEAD" ] || fail prepare-receipt
printf 'bound-head=%s\n' "$BOUND_HEAD"
step publish
published="$("$ORCH/worktree-push" --publish-base "$PREPARED_BASE" "$PREPARED_HEAD" --worktree "$WT" --issue "$ITEM")" || fail publish
delivery_line="$(sed -n 's/^delivery: mode=push-base //p' <<<"$published")"
PUSHED="${delivery_line#* commit=}"
PUSHED="${PUSHED%% *}"
PUSHED_BASE="${delivery_line#base=}"
PUSHED_BASE="${PUSHED_BASE%% *}"
[ -n "$PUSHED" ] && [ -n "$PUSHED_BASE" ] || fail delivery-receipt

# --- decision 46: verify the published base, record the verdict -------------
step verification
# shellcheck source=../lib/one-job-fixture.sh
. "$FIXTURE_LIB" || fail fixture-lib
one_job_gh_learns_head "$PUSHED" || fail gh-learns-head
ci="$("$ORCH/ci-wait" "${NUMBER:-1}" 1 20 --required-only --json --item "$ITEM")" || fail ci-wait
printf '%s\n' "$ci" > tmp/ci-wait.json
[ "$(jq -r '.status' <<<"$ci")" = complete ] || fail ci-status
ci_verdict="$(jq -r '.verdict' <<<"$ci")"
ci_reason="$(jq -r '.reason // ""' <<<"$ci")"
recorded="$(op --item "$(jq -cn --arg head "$PUSHED" --arg v "$ci_verdict" --arg reason "$ci_reason" \
  '{op: "record-verification", head: $head, verdict: $v, reason: $reason, source: "ci-wait --required-only"}')")" \
  || fail record-verification
printf '%s\n' "$recorded" > tmp/verification-report.json

# --- skills/orch/workflows/submit-pr.md § 2.1: completion and the notice ---
step report
if [ "$TRACKER" = github ]; then
  gh issue close "$NUMBER" --repo "$GH_REPO_SLUG" --reason completed || fail issue-close
fi
printf 'Pushed %s to %s.\n' "$PUSHED" "$PUSHED_BASE" > "tmp/delivery-$ITEM.md"
"$MAILBOX/lane-mail" notice --item "$ITEM" --file "$WT/tmp/delivery-$ITEM.md" || fail notice
if [ "$TIER" != micro ]; then
  # skills/orch/workflows/start-worktree.md § 5.4
  "$ORCH/workflow-state" update "$ITEM" \
    '.child_sessions = ((.child_sessions // {}) | with_entries(.value.status = "closed"))' || fail retire
fi
printf 'lane-done\n' >> "$STATUS"
idle
