#!/bin/bash
# A lane-close part way through its work. Like the shipped
# `scripts/lane-close` it sets no TERM trap (its one trap is EXIT), so a TERM
# that reaches it ends it where it stands. It logs its start to CLOSE_LOG,
# takes CLOSE_SECS (default 4), and logs its end: the row it would commit.
# R-U5h2's probe fake.
set -u
printf 'close: started pid=%s pgid=%s\n' "$$" "$(ps -o pgid= -p $$ | tr -d ' ')" >> "$CLOSE_LOG"
sleep "${CLOSE_SECS:-4}"
printf 'close: done\n' >> "$CLOSE_LOG"
