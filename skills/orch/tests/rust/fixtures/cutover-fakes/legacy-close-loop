#!/bin/bash
# The retired repeat loop as commit 11 ran it while its pass is part way
# through a lane-close (`744fd5727:skills/orch/scripts/oversee-watch`): the
# loop's claim and `repeat_stop` (`:1062-1070`: release the record, TERM the
# pass, wait for it, exit), the pass's `pass_stop` (`:1686-1696`: during a
# close only the long pass is signalled) and `on_exit` (`:1659-1671`: a long
# pass in flight is waited for), the long pass's `close_hosted_lane`
# (`:1425-1434`: TERM noted, the close waited to its end). The pass is commit
# 11's own code, as a pass already running at install time is; one pass, then
# the loop exits. The log names each step. R-U5h2's probe fake.
# Usage: legacy-close-loop STATE LOG CLOSE, with WATCH_PID_LIB naming
# lib/watch-pid.sh; installed as .../oversee-watch so its command line names
# oversee-watch.
set -u
STATE_FILE="$1" LEGACY_LOG="$2" CLOSE="$3"
# shellcheck source=/dev/null
source "$WATCH_PID_LIB"
watch_pid_write "$STATE_FILE" none hand "$0" || exit 9
REPEAT_CHILD_PID=""
repeat_stop() {
  trap '' TERM INT
  watch_pid_release "$STATE_FILE"
  if [[ -n "$REPEAT_CHILD_PID" ]]; then
    kill -TERM "$REPEAT_CHILD_PID" 2>/dev/null || true
    wait "$REPEAT_CHILD_PID" 2>/dev/null || true
  fi
  printf 'legacy: repeat_stop %s\n' "$1" >> "$LEGACY_LOG"
  exit "$1"
}
trap 'watch_pid_release "$STATE_FILE"' EXIT
trap 'repeat_stop 143' TERM
printf 'legacy: claimed pid=%s pgid=%s\n' "$$" "$(ps -o pgid= -p $$ | tr -d ' ')" >> "$LEGACY_LOG"
# The pass's work directory, made here and handed in.
WORK_DIR="$(mktemp -d)" || exit 9
bash -c '
LOG="$1" CLOSE="$2" WORK_DIR="$3"
LONG_PID="" LONG_DONE="$WORK_DIR/long.done" CLOSE_ACTIVE_FILE="$WORK_DIR/close.active"
on_exit() {
  local rc=$?
  if [[ -n "$LONG_PID" ]]; then wait "$LONG_PID" || :; fi
  printf "pass: exit rc=%s\n" "$rc" >> "$LOG"
  rm -rf "$WORK_DIR"
  exit "$rc"
}
trap on_exit EXIT
tree_pids() {
  ps -A -o pid= -o ppid= 2>/dev/null | awk -v root="$1" "{ kids[\$2] = kids[\$2] \" \" \$1 }
    END { q[n = 1] = root; for (i = 1; i <= n; i++) { print q[i]
      m = split(kids[q[i]], k, \" \"); for (j = 1; j <= m; j++) q[++n] = k[j] } }"
}
pass_stop() {
  local pid tree closing=""
  if [[ -n "$LONG_PID" && ! -e "$LONG_DONE" ]]; then
    tree="$(tree_pids "$LONG_PID")"
    [[ ! -e "$CLOSE_ACTIVE_FILE" ]] || closing=1
    for pid in $tree; do
      [[ -z "$closing" || "$pid" == "$LONG_PID" ]] || continue
      kill -TERM "$pid" 2>/dev/null || :
    done
  fi
  printf "pass: pass_stop closing=%s\n" "$closing" >> "$LOG"
  exit 143
}
trap pass_stop TERM
(
  trap "touch \"$LONG_DONE\"" EXIT
  CLOSE_TERMED=""
  : > "$CLOSE_ACTIVE_FILE"
  trap "CLOSE_TERMED=1" TERM
  "$CLOSE" &
  close_pid=$!
  while :; do
    rc=0
    wait "$close_pid" || rc=$?
    [[ -n "$CLOSE_TERMED" && "$rc" -gt 128 ]] && kill -0 "$close_pid" 2>/dev/null || break
  done
  rm -f -- "$CLOSE_ACTIVE_FILE"
  printf "long: close rc=%s termed=%s\n" "$rc" "$CLOSE_TERMED" >> "$LOG"
) &
LONG_PID=$!
wait "$LONG_PID"
LONG_PID=""
' pass "$LEGACY_LOG" "$CLOSE" "$WORK_DIR" &
REPEAT_CHILD_PID=$!
rc=0
wait "$REPEAT_CHILD_PID" || rc=$?
REPEAT_CHILD_PID=""
printf 'legacy: pass rc=%s\n' "$rc" >> "$LEGACY_LOG"
exit 0
