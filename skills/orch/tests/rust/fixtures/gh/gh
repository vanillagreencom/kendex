#!/usr/bin/env bash
# The fake gh for the verify-head rows. It answers `gh api PATH` from the
# JSON map at $GH_FAKE_REPLIES, {PATH: {exit?, body?, text?}}: `body` is
# printed as JSON, `text` as raw bytes (an answer that is not JSON), `exit`
# is the status, 0 when absent. A path with no entry is a failed request,
# as gh exits 1 on an HTTP error. The GraphQL form
# `gh api graphql -f query=… -f ids[]=…` answers from the map's `graphql`
# entry: when its `body` holds `nodes`, a map from node id to node, the
# reply is `{data: {nodes: […]}}` in the order asked, null for an id the map
# lacks, as GitHub answers `nodes(ids:)`; an asked id its `errored` list
# names is null with a `NOT_FOUND` error at the node's path `["nodes", i]`
# in `errors`, GraphQL's shape for a field it could not resolve
# (specification § 6.4.4); a GraphQL `body` carrying `errors` is printed
# with exit 1 and `gh: ` then the errors' messages, one per line, on
# stderr, as gh exits nonzero on every such reply and writes that
# (v2.103.3 `pkg/cmd/api/api.go:492-557`, `:722`); a planted `exit` with an
# error-free `body` is a call that failed for a cause its output does not
# carry; any other `body`, `text` or `exit` is printed as for a path.
# Every call appends its arguments to $GH_FAKE_LOG, so a row can assert
# what was read and what was not. With the two names unset, the map and
# the log are `gh.json` and `gh.log` beside the path this was invoked as
# (the watch_reads rows symlink the fixture into their world as `gh`), and
# each call's GH_TOKEN (`unset` where absent) is appended to `gh.env`
# there, so a row proves which reads carried the installation token. The
# GraphQL form also takes `--paginate` and the `owner=`/`name=` fields the
# alert link read passes, answering from `graphql owner=O name=N` where the
# map has it, else `graphql`. `gh repo view --json nameWithOwner -q
# .nameWithOwner`, the admission's read of a checkout's repository, answers
# from the map's `repo view` entry; with none it fails as gh does in a
# checkout whose remotes name no GitHub host (exit 1). `gh pr view N --repo
# R --json F`, the verify-pr rows' read of a pull request, answers from the
# map's `pr view N` entry; with none it fails as gh does for a number the
# repository lacks (exit 1, the GraphQL message on stderr). The review
# gate's calls: `gh pr ready N --repo R` answers from `pr ready N` and, as
# the act GitHub makes, rewrites the map's `pr view N` and `pulls/N`
# entries to a ready pull request; `gh api PATH --method POST -f F`
# answers from `POST PATH`; the GraphQL form with `-F number=N` (the
# thread walk, its `cursor=` field empty on the first page) answers from
# `graphql number=N cursor=C`, its body printed as it stands.
set -u
here="$(dirname "${BASH_SOURCE[0]}")"
if [ -z "${GH_FAKE_LOG:-}" ]; then
  GH_FAKE_LOG="$here/gh.log"
  printf 'GH_TOKEN=%s %s\n' "${GH_TOKEN-unset}" "$*" >> "$here/gh.env"
fi
: "${GH_FAKE_REPLIES:=$here/gh.json}"
printf '%s\n' "$*" >> "$GH_FAKE_LOG"
if [ "${1:-}" = repo ] && [ "${2:-}" = view ]; then
  reply=$(jq -c '."repo view" // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  if [ -z "$reply" ]; then
    echo "none of the git remotes configured for this repository point to a known GitHub host. To tell gh about a new GitHub host, please use \`gh auth login\`" >&2
    exit 1
  fi
elif [ "${1:-}" = pr ] && [ "${2:-}" = view ]; then
  reply=$(jq -c --arg k "pr view ${3:-}" '.[$k] // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  if [ -z "$reply" ]; then
    echo "GraphQL: Could not resolve to a PullRequest with the number of ${3:-}. (repository.pullRequest)" >&2
    exit 1
  fi
elif [ "${1:-}" = pr ] && [ "${2:-}" = ready ]; then
  reply=$(jq -c --arg k "pr ready ${3:-}" '.[$k] // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  if [ -z "$reply" ]; then
    echo "GraphQL: Could not resolve to a PullRequest with the number of ${3:-}. (repository.pullRequest)" >&2
    exit 1
  fi
  if [ "$(jq -r '.exit // 0' <<<"$reply")" = 0 ]; then
    ready=$(jq -c --arg n "${3:-}" 'with_entries(
      if .key == ("pr view " + $n) then .value.body.isDraft = false
      elif (.key | endswith("/pulls/" + $n)) then .value.body.draft = false
      else . end)' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
    printf '%s\n' "$ready" > "$GH_FAKE_REPLIES"
  fi
elif [ "${1:-}" != api ]; then
  echo "gh-fake: unexpected-call args=[$*]" >&2
  exit 64
elif [ "${2:-}" = graphql ]; then
  ids='[]' owner="" name="" number="" cursor=""
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --paginate) ;;
      -f|-F) shift; case "$1" in ids\[\]=*) ids=$(jq -c --arg id "${1#ids[]=}" '. + [$id]' <<<"$ids") ;; owner=*) owner="${1#owner=}" ;; name=*) name="${1#name=}" ;; number=*) number="${1#number=}" ;; cursor=*) cursor="${1#cursor=}" ;; query=*) ;; *) echo "gh-fake: unexpected-field field=[$1]" >&2; exit 64 ;; esac ;;
      *) echo "gh-fake: unexpected-call args=[$*]" >&2; exit 64 ;;
    esac
    shift
  done
  if [ -n "$number" ]; then
    reply=$(jq -c --arg k "graphql number=$number cursor=$cursor" '.[$k] // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  else
  reply=$(jq -c --argjson ids "$ids" --arg keyed "graphql owner=$owner name=$name" '
    (.[$keyed] // .graphql) // empty
    | if (.body | type) == "object" and (.body | has("nodes")) then
        .body.nodes as $nodes | (.body.errored // []) as $errored
        | [$ids | to_entries[] | select(.value | IN($errored[]))
           | {type: "NOT_FOUND", path: ["nodes", .key], message: "Could not resolve to a node with the global id of \u0027\(.value)\u0027"}] as $errors
        | .body = ({data: {nodes: [$ids[] | $nodes[.] // null]}} + (if ($errors | length) > 0 then {errors: $errors} else {} end))
      else . end
    | if (.body | type) == "object" and ((.body.errors // []) | length) > 0
      then .exit = 1 | .stderr = ("gh: " + ([.body.errors[] | .message // ""] | join("\n")))
      else . end' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  fi
elif [ "$#" -ge 4 ] && [ "${3:-}" = --method ] && [ "${4:-}" = POST ]; then
  reply=$(jq -c --arg k "POST $2" '.[$k] // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
elif [ "$#" -ne 2 ]; then
  echo "gh-fake: unexpected-call args=[$*]" >&2
  exit 64
else
  reply=$(jq -c --arg p "$2" '.[$p] // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
fi
if [ -z "$reply" ]; then
  echo "gh: HTTP 404: Not Found (https://api.github.com/${2:-graphql})" >&2
  echo '{"message":"Not Found"}'
  exit 1
fi
jq -r '.stderr // empty' <<<"$reply" >&2
if jq -e 'has("text")' <<<"$reply" >/dev/null; then
  jq -rj '.text' <<<"$reply"
else
  jq -c '.body' <<<"$reply"
fi
exit "$(jq -r '.exit // 0' <<<"$reply")"
