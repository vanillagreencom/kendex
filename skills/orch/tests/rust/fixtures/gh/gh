#!/usr/bin/env bash
# The fake gh for the verify-head rows. It answers `gh api PATH` from the
# JSON map at $GH_FAKE_REPLIES, {PATH: {exit?, body?, text?}}: `body` is
# printed as JSON, `text` as raw bytes (an answer that is not JSON), `exit`
# is the status, 0 when absent. A path with no entry is a failed request,
# as gh exits 1 on an HTTP error. The GraphQL form
# `gh api graphql -f query=… -f ids[]=…` answers from the map's `graphql`
# entry: when its `body` holds `nodes`, a map from node id to node, the
# reply is `{data: {nodes: […]}}` in the order asked, null for an id the map
# lacks, as GitHub answers `nodes(ids:)`; an asked id its `errored` list
# names is null with a `NOT_FOUND` error at the node's path `["nodes", i]`
# in `errors`, GraphQL's shape for a field it could not resolve
# (specification § 6.4.4); a GraphQL `body` carrying `errors` is printed
# with exit 1 and `gh: ` then the errors' messages, one per line, on
# stderr, as gh exits nonzero on every such reply and writes that
# (v2.103.3 `pkg/cmd/api/api.go:492-557`, `:722`); a planted `exit` with an
# error-free `body` is a call that failed for a cause its output does not
# carry; any other `body`, `text` or `exit` is printed as for a path.
# Every call appends its arguments to $GH_FAKE_LOG, so a row can assert
# what was read and what was not. With the two names unset, the map and
# the log are `gh.json` and `gh.log` beside the path this was invoked as
# (the watch_reads rows symlink the fixture into their world as `gh`), and
# each call's GH_TOKEN (`unset` where absent) is appended to `gh.env`
# there, so a row proves which reads carried the installation token. The
# GraphQL form also takes `--paginate` and the `owner=`/`name=` fields the
# alert link read passes, answering from `graphql owner=O name=N` where the
# map has it, else `graphql`, page by page as gh pages it (v2.103.3
# `pkg/cmd/api/api.go:134-138`, `:432-466`): the entry's `pages` maps an
# `endCursor` value to the page answered for it, `""` the first, and a
# `body` entry is the first page; each page is projected and printed, and
# the next is the one planted for the projected page's `pageInfo.endCursor`
# while its `hasNextPage` is true, bound as gh binds `$endCursor`, so a
# query that selects no `pageInfo` reads its first page alone. The runtime
# pages one collection per query, so a page holding several `pageInfo`
# objects refuses; a page carrying `errors` ends the call as a failed
# GraphQL reply does, and a cursor with no page planted refuses. `gh repo view --json nameWithOwner -q
# .nameWithOwner`, the admission's read of a checkout's repository, answers
# from the map's `repo view` entry; with none it fails as gh does in a
# checkout whose remotes name no GitHub host (exit 1); `gh repo view O/R
# --json visibility --jq .visibility`, the publication order's read, answers
# from `repo view O/R` (its `text`, gh's one word and newline), with none
# failing as gh does for a repository it cannot see. `gh pr view N --repo
# R --json F`, the verify-pr rows' read of a pull request, answers from the
# map's `pr view N` entry; with none it fails as gh does for a number the
# repository lacks (exit 1, the GraphQL message on stderr). The review
# gate's calls: `gh pr ready N --repo R` answers from `pr ready N`; on a
# zero exit it prints its success line on stderr and nothing on stdout,
# as gh v2.103.3 `pkg/cmd/pr/ready` writes it; the entry's `signal` kills
# the call, after the mark reached GitHub where its `landed` is true, else
# before. `gh api PATH --method POST
# -f F` answers from `POST PATH`; an entry's `signal` kills the call by
# that signal, a call that ended with no exit status. What an act left on
# GitHub outlives the map a row rewrites between calls: it is kept in
# `<map>.acts.json` beside the map and laid over every later answer, a
# ready mark making `pr view N` and `pulls/N` read ready (and `pr view N`
# read the `head` its entry carries: a push that landed with the mark), a request a zero
# exit on `pulls/N/requested_reviewers` made (or a failed call whose entry
# says `landed`, an answer lost after GitHub took it) adding GitHub's
# record of it,
# a `review_requested` event naming `Copilot`, to `issues/N/timeline`.
# The GraphQL form
# with `-F number=N` (the thread walk, its `cursor=` field empty on the
# first page; `pr-timeline`'s read, whose `gate=` field it takes) answers from `graphql number=N cursor=C`, its body printed
# as the `nodes` form prints one: exit 1 and the `gh: ` line where it
# carries `errors`. GitHub and gh answer only the fields asked for: every
# GraphQL reply's `data` is projected onto its query's selection
# (`select.jq` beside this file), and a `pr view` body onto its `--json`
# list.
# The map's `sign-in` entry, where present, is GitHub judging the call's
# credential before anything else: GH_TOKEN, else GITHUB_TOKEN, an empty
# value read as unset (as gh 2.103.3 reads it); with neither, the stored
# login its `stored` names (`valid` or `expired`; absent, there is none).
# A token its `expired` list names, or an expired stored login, is
# answered as GitHub answers it whatever was asked, with gh's measured
# words: the body on stdout, `gh: Bad credentials (HTTP 401)` on stderr,
# exit 1; no credential at all is gh's exit 4. `auth status` answers 0
# for a working credential and 1 otherwise; `api user` prints the login.
set -u
here="$(dirname "${BASH_SOURCE[0]}")"
if [ -z "${GH_FAKE_LOG:-}" ]; then
  GH_FAKE_LOG="$here/gh.log"
  printf 'GH_TOKEN=%s %s\n' "${GH_TOKEN-unset}" "$*" >> "$here/gh.env"
fi
: "${GH_FAKE_REPLIES:=$here/gh.json}"
printf '%s\n' "$*" >> "$GH_FAKE_LOG"
sign_in=$(jq -c '."sign-in" // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
if [ -n "$sign_in" ]; then
  token="${GH_TOKEN:-${GITHUB_TOKEN:-}}"
  if [ -n "$token" ]; then
    login=$(jq -r --arg t "$token" 'if ((.expired // []) | index($t)) != null then "expired" else "valid" end' <<<"$sign_in")
  else
    login=$(jq -r '.stored // "none"' <<<"$sign_in")
  fi
  if [ "${1:-}" = auth ] && [ "${2:-}" = status ]; then
    [ "$login" = valid ] || exit 1
    exit 0
  fi
  case "$login" in
    none)
      echo 'gh: To use GitHub CLI in automation, set the GH_TOKEN environment variable.' >&2
      exit 4 ;;
    expired)
      echo '{"message":"Bad credentials","documentation_url":"https://docs.github.com/rest","status":"401"}'
      echo 'gh: Bad credentials (HTTP 401)' >&2
      exit 1 ;;
  esac
  if [ "${1:-}" = api ] && [ "${2:-}" = user ]; then
    echo fixture
    exit 0
  fi
fi
acts="${GH_FAKE_REPLIES%.json}.acts.json"
overlay="" number="" query="" fields=""
real="$(readlink -f "${BASH_SOURCE[0]}")"
# act FILTER [ARGS...]: record what an act left on GitHub.
act() {
  local filter="$1" was='{}' now
  shift
  [ ! -f "$acts" ] || was=$(cat -- "$acts") || { echo "gh-fake: acts-unreadable" >&2; exit 65; }
  now=$(jq -c "$@" "$filter" <<<"$was") || { echo "gh-fake: acts-unreadable" >&2; exit 65; }
  printf '%s\n' "$now" > "$acts"
}
if [ "${1:-}" = repo ] && [ "${2:-}" = view ] && [ -n "${3:-}" ] && [ "${3#-}" = "${3:-}" ]; then
  reply=$(jq -c --arg k "repo view $3" '.[$k] // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  if [ -z "$reply" ]; then
    echo "GraphQL: Could not resolve to a Repository with the name '$3'. (repository)" >&2
    exit 1
  fi
elif [ "${1:-}" = repo ] && [ "${2:-}" = view ]; then
  reply=$(jq -c '."repo view" // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  if [ -z "$reply" ]; then
    echo "none of the git remotes configured for this repository point to a known GitHub host. To tell gh about a new GitHub host, please use \`gh auth login\`" >&2
    exit 1
  fi
elif [ "${1:-}" = pr ] && [ "${2:-}" = view ]; then
  overlay=view number="${3:-}"
  previous=""
  for arg in "$@"; do
    [ "$previous" != --json ] || fields="$arg"
    previous="$arg"
  done
  reply=$(jq -c --arg k "pr view ${3:-}" '.[$k] // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  if [ -z "$reply" ]; then
    echo "GraphQL: Could not resolve to a PullRequest with the number of ${3:-}. (repository.pullRequest)" >&2
    exit 1
  fi
elif [ "${1:-}" = pr ] && [ "${2:-}" = list ]; then
  # The container close's lookup of a child's merged pull request, answered
  # from the map's `pr list` entry; with none it fails as a request does.
  reply=$(jq -c '."pr list" // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  if [ -z "$reply" ]; then
    echo "gh-fake: no pr list answer" >&2
    exit 1
  fi
elif [ "${1:-}" = pr ] && [ "${2:-}" = ready ]; then
  reply=$(jq -c --arg k "pr ready ${3:-}" '.[$k] // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  if [ -z "$reply" ]; then
    echo "GraphQL: Could not resolve to a PullRequest with the number of ${3:-}. (repository.pullRequest)" >&2
    exit 1
  fi
  if [ "$(jq -r '.exit // 0' <<<"$reply")" = 0 ]; then
    signal=$(jq -r '.signal // empty' <<<"$reply")
    [ -z "$signal" ] || [ "$(jq -r '.landed // false' <<<"$reply")" = true ] || kill -s "$signal" "$$"
    act '.ready = ((.ready // []) + [$n] | unique)' --arg n "${3:-}"
    act '.heads += (if $head == "" then {} else {($n): $head} end)' --arg n "${3:-}" --arg head "$(jq -r '.head // empty' <<<"$reply")"
    [ -z "$signal" ] || kill -s "$signal" "$$"
    printf '✓ Pull request #%s is marked as "ready for review"\n' "${3:-}" >&2
    exit 0
  fi
elif [ "${1:-}" != api ]; then
  echo "gh-fake: unexpected-call args=[$*]" >&2
  exit 64
elif [ "${2:-}" = graphql ]; then
  ids='[]' owner="" name="" number="" cursor="" bindings='[]' paginate=false
  shift 2
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --paginate) paginate=true ;;
      -f|-F)
        flag="${1#-}"
        shift
        case "$1" in query=*) ;; *) bindings=$(jq -c --arg n "${1%%=*}" --arg f "$flag" --arg t "${1#*=}" '. + [[$n, $f, $t]]' <<<"$bindings") ;; esac
        case "$1" in ids\[\]=*) ids=$(jq -c --arg id "${1#ids[]=}" '. + [$id]' <<<"$ids") ;; owner=*) owner="${1#owner=}" ;; name=*) name="${1#name=}" ;; number=*) number="${1#number=}" ;; cursor=*) cursor="${1#cursor=}" ;; query=*) query="${1#query=}" ;; gate=*) ;; *) echo "gh-fake: unexpected-field field=[$1]" >&2; exit 64 ;; esac ;;
      *) echo "gh-fake: unexpected-call args=[$*]" >&2; exit 64 ;;
    esac
    shift
  done
  if [ "$paginate" = true ] && [ -z "$number" ]; then
    entry=$(jq -c --arg keyed "graphql owner=$owner name=$name" '(.[$keyed] // .graphql) // empty | if has("body") then {pages: {"": .body}} else . end' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
    if [ -n "$entry" ] && jq -e 'has("pages")' <<<"$entry" >/dev/null; then
      page_cursor=""
      while :; do
        page=$(jq -c --arg c "$page_cursor" '.pages | if has($c) then {body: .[$c]} else empty end' <<<"$entry") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
        [ -n "$page" ] || { echo "gh-fake: no page planted for cursor [$page_cursor]" >&2; exit 64; }
        page_bindings="$bindings"
        [ -z "$page_cursor" ] || page_bindings=$(jq -c --arg t "$page_cursor" '. + [["endCursor", "f", $t]]' <<<"$bindings")
        page=$(jq -c --arg q "$query" --argjson bindings "$page_bindings" -f "$(dirname "$real")/select.jq" <<<"$page") || { echo "gh-fake: selection-unsupported" >&2; exit 64; }
        jq -c '.body' <<<"$page"
        if jq -e '(.body.errors // []) | length > 0' <<<"$page" >/dev/null; then
          jq -r '"gh: " + ([.body.errors[] | .message // ""] | join("\n"))' <<<"$page" >&2
          exit 1
        fi
        jq -e '[.body | .. | objects | select(has("pageInfo"))] | length <= 1' <<<"$page" >/dev/null || { echo "gh-fake: paginate-unsupported pageInfo=several" >&2; exit 64; }
        page_cursor=$(jq -r 'first(.body | .. | objects | select(has("pageInfo")) | .pageInfo) // {} | if .hasNextPage == true then .endCursor // "" else "" end' <<<"$page") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
        [ -n "$page_cursor" ] || exit 0
      done
    fi
    reply="$entry"
  elif [ -n "$number" ]; then
    reply=$(jq -c --arg k "graphql number=$number cursor=$cursor" '.[$k] // empty | if (.body | type) == "object" and ((.body.errors // []) | length) > 0 then .exit = 1 | .stderr = ("gh: " + ([.body.errors[] | .message // ""] | join("\n"))) else . end' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  else
  reply=$(jq -c --argjson ids "$ids" --arg keyed "graphql owner=$owner name=$name" '
    (.[$keyed] // .graphql) // empty
    | if (.body | type) == "object" and (.body | has("nodes")) then
        .body.nodes as $nodes | (.body.errored // []) as $errored
        | [$ids | to_entries[] | select(.value | IN($errored[]))
           | {type: "NOT_FOUND", path: ["nodes", .key], message: "Could not resolve to a node with the global id of \u0027\(.value)\u0027"}] as $errors
        | .body = ({data: {nodes: [$ids[] | $nodes[.] // null]}} + (if ($errors | length) > 0 then {errors: $errors} else {} end))
      else . end
    | if (.body | type) == "object" and ((.body.errors // []) | length) > 0
      then .exit = 1 | .stderr = ("gh: " + ([.body.errors[] | .message // ""] | join("\n")))
      else . end' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  fi
elif [ "$#" -ge 4 ] && [ "${3:-}" = --method ] && [ "${4:-}" = POST ]; then
  reply=$(jq -c --arg k "POST $2" '.[$k] // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
  signal=$(jq -r '.signal // empty' <<<"${reply:-null}")
  [ -z "$signal" ] || kill -s "$signal" "$$"
  case "$2" in
    repos/*/pulls/*/requested_reviewers)
      if [ -n "$reply" ] && { [ "$(jq -r '.exit // 0' <<<"$reply")" = 0 ] || [ "$(jq -r '.landed // false' <<<"$reply")" = true ]; }; then
        number="${2#*/pulls/}"
        act '.events[$n] = ((.events[$n] // []) + [{event: "review_requested", id: (900 + (.events[$n] // [] | length)), created_at: $at, requested_reviewer: {login: "Copilot"}}])' \
          --arg n "${number%/requested_reviewers}" --arg at "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
      fi
      ;;
  esac
elif [ "$#" -ne 2 ]; then
  echo "gh-fake: unexpected-call args=[$*]" >&2
  exit 64
else
  case "$2" in
    repos/*/pulls/*)
      number="${2#*/pulls/}"
      case "$number" in */*|*\?*) ;; *) overlay=pull ;; esac
      ;;
    repos/*/issues/*/timeline*)
      number="${2#*/issues/}"
      number="${number%%/*}"
      overlay=timeline
      ;;
  esac
  reply=$(jq -c --arg p "$2" '.[$p] // empty' -- "$GH_FAKE_REPLIES") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
fi
if [ -n "$overlay" ] && [ -n "$reply" ] && [ -f "$acts" ]; then
  reply=$(jq -c --slurpfile acts "$acts" --arg kind "$overlay" --arg n "$number" '
    $acts[0] as $a
    | if $kind == "view" and (.exit // 0) == 0 and (($a.heads // {})[$n] // "") != "" then .body.headRefOid = $a.heads[$n] else . end
    | if (.exit // 0) != 0 then .
      elif $kind == "view" and (($a.ready // []) | index($n)) then .body.isDraft = false
      elif $kind == "pull" and (($a.ready // []) | index($n)) then .body.draft = false
      elif $kind == "timeline" and (.body | type) == "array" then .body += ($a.events[$n] // [])
      else . end' <<<"$reply") || { echo "gh-fake: acts-unreadable" >&2; exit 65; }
fi
if [ -z "$reply" ]; then
  echo "gh: HTTP 404: Not Found (https://api.github.com/${2:-graphql})" >&2
  echo '{"message":"Not Found"}'
  exit 1
fi
if [ -n "$query" ]; then
  reply=$(jq -c --arg q "$query" --argjson bindings "$bindings" -f "$(dirname "$real")/select.jq" <<<"$reply") || { echo "gh-fake: selection-unsupported" >&2; exit 64; }
elif [ -n "$fields" ]; then
  reply=$(jq -c --arg f "$fields" 'if (.body | type) == "object" then .body |= with_entries(select(.key as $k | $f | split(",") | index($k))) else . end' <<<"$reply") || { echo "gh-fake: replies-unreadable" >&2; exit 65; }
fi
jq -r '.stderr // empty' <<<"$reply" >&2
if jq -e 'has("text")' <<<"$reply" >/dev/null; then
  jq -rj '.text' <<<"$reply"
else
  jq -c '.body' <<<"$reply"
fi
exit "$(jq -r '.exit // 0' <<<"$reply")"
