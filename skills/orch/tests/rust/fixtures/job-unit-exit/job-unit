#!/bin/bash
# The real job-unit launcher's setsid route run on a job that exits before it
# claims anything: `launch NAME RECORD -- ARGV...` sources the orch package's
# own `lib/job-unit.sh` ($JOB_UNIT_REAL) on a PATH with no systemd-run, so the
# launcher forks the child under setsid and reads its identity from the
# kernel table itself (decision 120), with ARGV replaced by a sleep of
# $JOB_UNIT_EXIT_AFTER seconds (default 0.5): a real child the launcher
# recorded that dies before claiming the intent. Every call is appended to
# $JOB_UNIT_LOG when set.
[ -z "${JOB_UNIT_LOG:-}" ] || printf '%s\n' "$*" >> "$JOB_UNIT_LOG"
[ "${1:-}" = launch ] || { echo "job-unit-exit: verb=$1" >&2; exit 2; }
farm="$(mktemp -d)" || exit 2
for name in bash setsid sleep mv tr cat ps awk; do
  ln -s "$(command -v "$name")" "$farm/$name"
done
export PATH="$farm"
# shellcheck source=/dev/null
. "${JOB_UNIT_REAL:?}"
rc=0
job_unit_main launch "$2" "$3" -- sleep "${JOB_UNIT_EXIT_AFTER:-0.5}" || rc=$?
rm -rf -- "${farm:?}"
exit "$rc"
