#!/usr/bin/env bash
# The fake `lane-close` for the hosted close rows (`tests/rust/watch_observe.rs`,
# `watch_core.rs`). Every call appends its argv to `lane-close.log` beside
# the path this was invoked as (the rows link the fixture into their world
# as `lane-close`), so a row counts the closes the watch asked. It answers
# from `lane-close.json` beside, `{exit?, stdout?, stderr?}`: the planted
# status (0 when absent) and lines, a `kept=` or `closed=absent item=ITEM`
# line on stdout for a close, `close-refused path=PATH` with exit 3 for a
# refusal, a `{"code":"RATELIMITED","quota":{...}}` line on stderr with a
# non-zero status for the tracker's quota refusal. With LANE_CLOSE_KILL_PARENT
# set it ends its parent, the runtime that asked, with KILL after logging and
# before answering: the crash between the ask and its answer. A planted
# `signal` ends this close by that signal after logging, an end with no
# status: the answer the runner reads when its bound kills a close. Bash 3.2.
set -u
here="$(dirname "${BASH_SOURCE[0]}")"
printf '%s\n' "$*" >> "$here/lane-close.log"
if [ -n "${LANE_CLOSE_KILL_PARENT:-}" ]; then
  kill -KILL -- "$PPID"
  exit 137
fi
reply="$(jq -c '.' -- "$here/lane-close.json" 2>/dev/null)" || reply='{}'
signal="$(jq -r '.signal // empty' <<<"$reply")"
[ -z "$signal" ] || kill -"$signal" $$
jq -rj '.stderr // empty' <<<"$reply" >&2
jq -rj '.stdout // empty' <<<"$reply"
exit "$(jq -r '.exit // 0' <<<"$reply")"
