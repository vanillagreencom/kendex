#!/usr/bin/env bash
# The planted provider for the hosted lane rows. Every call appends
# `ORCH_LANE_HOST=<host> <argv>` to `lane-host.log` beside the path this
# was invoked as, the host being the name of that link (a row links the
# fixture into its world under each host it names), so a row proves which
# host each read ran under and in what
# order the calls came. It answers from the JSON map `lane-host.json`
# beside, keyed by the argv joined with one space (`capabilities`, `cat
# --item KEN-1 /w/tmp/lane-status-KEN-1.md`, `touch --item KEN-1`, `status
# --item KEN-1 --harness claude`, `stop --item KEN-1 --harness claude`,
# `list`), or by `<host> <argv>` where two hosts of one fleet answer
# differently, or by either with `#N` appended for the Nth call of that
# argv where a row answers a repeated read differently (a marker absent,
# then present once the launch put it): `{exit?, stdout?, stderr?,
# signal?, kill_ancestor?}`, `stdout` the exact bytes printed, the status 0
# when absent, `signal` a signal this call ends itself by after its output,
# so a row reads a call with no answer, and `kill_ancestor` N the process N
# levels above this one, ended by SIGKILL before any output (1 is the
# program that asked it). A key the map
# lacks is exit 64 with `lane-host-fixture: unplanned argv=[...]` on stderr,
# so a row that forgot an answer reads an unreadable call, never a missing
# file. A `put` keeps the bytes it was handed in `lane-host.put.N` beside,
# N its line of the log. Bash 3.2.
set -u
here="$(dirname "${BASH_SOURCE[0]}")"
host="$(basename -- "$0")"
line="ORCH_LANE_HOST=$host $*"
prior=0
[ ! -f "$here/lane-host.log" ] || prior="$(grep -cxF -- "$line" "$here/lane-host.log")" || prior=0
printf '%s\n' "$line" >> "$here/lane-host.log"
if [ "${1:-}" = put ]; then
  cat > "$here/lane-host.put.$(grep -c '' "$here/lane-host.log")"
fi
key="$*"
nth="#$((prior + 1))"
reply="$(jq -c --arg k "$key" --arg h "$host $key" --arg n "$nth" '.[$h + $n] // .[$k + $n] // .[$h] // .[$k] // empty' -- "$here/lane-host.json" 2>/dev/null)" || reply=""
if [ -z "$reply" ]; then
  printf 'lane-host-fixture: unplanned argv=[%s]\n' "$key" >&2
  exit 64
fi
ancestor="$(jq -r '.kill_ancestor // empty' <<<"$reply")"
if [ -n "$ancestor" ]; then
  target=$$
  while [ "$ancestor" -gt 0 ]; do
    target="$(ps -o ppid= -p "$target" | tr -d ' ')"
    ancestor=$((ancestor - 1))
  done
  kill -KILL "$target"
fi
jq -rj '.stderr // empty' <<<"$reply" >&2
jq -rj '.stdout // empty' <<<"$reply"
signal="$(jq -r '.signal // empty' <<<"$reply")"
[ -z "$signal" ] || kill -s "$signal" "$$"
exit "$(jq -r '.exit // 0' <<<"$reply")"
