#!/usr/bin/env bash
# The fake `lanes` for the watch_report rows, after the legacy suites'
# `lanes-stub.sh`: `list --json` prints `lanes.json` beside the path this
# was invoked as (the rows symlink the fixture into their world as
# `lanes`); `pick --harness H --json [--native-model M]` answers from
# `pick-<host>-H-M.json` there, else `pick-H-M.json`, `{exit?, body?}`,
# `-` the model word with none, `unset` the host with no ORCH_LANE_HOST;
# a pick with no file is exit 1 with a keyed line, as the real program
# refuses a harness it judges no launch of. Every call appends
# `ORCH_LANE_HOST=<value|unset> <argv>` to `lanes.log` there, so a row
# proves which host each read named. `lanes.rc` beside, when present, is
# the listing's exit status, `lanes.text` its raw answer in place of the
# JSON file.
set -u
here="$(dirname "${BASH_SOURCE[0]}")"
host="${ORCH_LANE_HOST-unset}"
printf 'ORCH_LANE_HOST=%s %s\n' "$host" "$*" >> "$here/lanes.log"
if [ "${1:-}" = pick ]; then
  harness="" model=-
  while [ "$#" -gt 0 ]; do
    case "$1" in
      --harness) harness="$2"; shift ;;
      --native-model) model="$2"; shift ;;
    esac
    shift
  done
  base="$here/pick-$host-$harness-$model.json"
  [ -f "$base" ] || base="$here/pick-$harness-$model.json"
  if [ ! -f "$base" ]; then
    printf 'lanes: invalid-pick-harness option=--harness\n' >&2
    exit 1
  fi
  jq -c '.body // {}' -- "$base"
  exit "$(jq -r '.exit // 0' -- "$base")"
fi
rc=0
[ ! -f "$here/lanes.rc" ] || rc="$(cat "$here/lanes.rc")"
if [ "$rc" -ne 0 ]; then
  printf 'lanes: stub-refused rc=%s\n' "$rc" >&2
  exit "$rc"
fi
if [ -f "$here/lanes.text" ]; then
  cat "$here/lanes.text"
elif [ -f "$here/lanes.json" ]; then
  cat "$here/lanes.json"
else
  printf '[]\n'
fi
