#!/usr/bin/env python3
"""The curl the real linear.sh runs under `linear` beside it.

It accepts the `ListIssues` pages of the report's three window reads:
`issues list --created-since S --select full`, `--completed-since S --select
triage` and `--canceled-since S --select triage`, each with `--max
--format=safe`. A page is accepted when its filter is that read's
`{"<field>": {"gte": S}}` alone, `includeArchived` false, the selection's
page size (75 full, 250 triage) and the cursor of the read's page before it.
It reads the request as the package sends it, a curl config on stdin whose
`data = ` line is the payload, and answers the pages planted in
`linear-created.json` in the working directory, `{"since": S, "reads":
{"createdAt"|"completedAt"|"canceledAt": [[node]]}, "code": N}`, as Linear
answers them, with `___HTTP_CODE___<code>` as `curl -s -w` prints it; a
`code` other than 200 is served in place of every page. Every request is
appended to `linear-created.log`, `{"handled": bool, "payload": ...}` per
line; any other request is refused with exit 2, as a curl that reached no
server.
"""
import json
import sys
from pathlib import Path

SIZES = {'createdAt': 75, 'completedAt': 250, 'canceledAt': 250}

root = Path.cwd()
config = sys.stdin.read()
line = next(line for line in config.splitlines() if line.startswith('data = '))
payload = json.loads(json.loads(line[len('data = '):]))
world = json.loads((root / 'linear-created.json').read_text())
variables = payload.get('variables') or {}
after = variables.get('after')
fields = list((variables.get('filter') or {}).keys())
read = fields[0] if len(fields) == 1 and fields[0] in SIZES else None
pages = world['reads'].get(read, []) if read else []
cursors = [None] + ['%s-page-%d' % (read, n) for n in range(2, len(pages) + 1)]
handled = (
    read is not None
    and payload.get('query', '').lstrip().startswith('query ListIssues(')
    and after in cursors
    and variables == {
        'filter': {read: {'gte': world['since']}},
        'includeArchived': False,
        'first': SIZES[read],
        'after': after,
    }
)
with open(root / 'linear-created.log', 'a') as log:
    log.write(json.dumps({'handled': handled, 'payload': payload}) + '\n')
if not handled:
    print('unhandled request: ' + json.dumps(payload), file=sys.stderr)
    sys.exit(2)
code = world.get('code', 200)
if code != 200:
    print(json.dumps({'errors': [{'message': 'upstream unavailable'}]}), end='___HTTP_CODE___%d' % code)
    sys.exit(0)
page = cursors.index(after)
last = page == len(pages) - 1
data = {'issues': {
    'pageInfo': {'hasNextPage': not last, 'endCursor': None if last else cursors[page + 1]},
    'nodes': pages[page],
}}
print(json.dumps({'data': data}), end='___HTTP_CODE___200')
