#!/bin/bash
# The ssh client as the hosted launch rows run it: `ssh -t TARGET LINE`
# runs LINE on this machine through bash, the host's shell, with this
# directory first on the search path so the harness the line names by its
# bare name is the stub beside this file. The target is logged beside the
# fixture (`ssh.log`) and never dialled.
set -u
here="$(dirname "${BASH_SOURCE[0]}")"
printf '%s\n' "$*" >> "$here/ssh.log"
while [ $# -gt 0 ]; do
  case "$1" in
    -t) shift ;;
    *) break ;;
  esac
done
target="$1"
shift
export PATH="$here:$PATH"
export SSH_FIXTURE_TARGET="$target"
exec bash -c "$*"
