#!/bin/bash
# A stub that draws Claude Code's composer marker and reads its stdin
# without recording a user turn anywhere: a harness that lost the pasted
# brief. A succession to it must never publish (decision 61). Named `claude`
# and run by bash directly so the kernel records the harness's process name
# for it.
printf '\xe2\x9d\xaf\xc2\xa0\n'
while IFS= read -r _line; do :; done
