#!/bin/bash
# The Pi stub for the orch-runtime launch rows, named `pi` so the kernel
# records Pi's process name for it: it writes the command it was launched as
# into `launch-record.json` in its working directory (its argv and the account
# variables of its environment) and then stands, drawing no composer, so a
# succession that opened it abandons it as `successor-not-ready` once the
# record is written and the row reads the record. It launches no model.
argv="" first=1
for arg in "$@"; do
  [ "$first" = 1 ] || argv="$argv,"
  first=0
  argv="$argv\"$(printf '%s' "$arg" | sed 's/\\/\\\\/g; s/"/\\"/g' | awk 'NR > 1 { printf "%s", "\\n" } { printf "%s", $0 }')\""
done
printf '{"program":"%s","argv":[%s],"env":{"CLAUDE_CONFIG_DIR":"%s","PI_CODING_AGENT_DIR":"%s","CODEX_HOME":"%s","COPILOT_HOME":"%s"}}\n' \
  "$0" "$argv" "${CLAUDE_CONFIG_DIR-}" "${PI_CODING_AGENT_DIR-}" "${CODEX_HOME-}" "${COPILOT_HOME-}" > launch-record.json
printf 'pi starting, no composer\n'
while IFS= read -r _line; do :; done
