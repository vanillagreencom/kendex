#!/bin/bash
# A stub harness for the relaunch rows, named `claude`: on `--resume ID` it
# requires the session file that id names for this directory under its config
# dir, CLAUDE_CONFIG_DIR or else the implicit default under HOME, as Claude
# Code does, and exits 3 without one, so a resume of a session the
# destination home never held fails as the real harness would.
# Otherwise it behaves as stub-confirm: draws the composer, takes
# `--session-id`, records each line it reads as a user turn, with whether
# CLAUDE_CONFIG_DIR was set and the HOME it ran under.
session="stub-$$"
resume=""
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id) session="${2:-$session}"; shift ;;
    --resume) resume="${2:-}"; shift ;;
  esac
  shift
done
slug="${PWD//[\/.]/-}"
store="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
config_dir_set=false
[ -z "${CLAUDE_CONFIG_DIR+x}" ] || config_dir_set=true
if [ -n "$resume" ]; then
  if [ ! -f "$store/projects/$slug/$resume.jsonl" ]; then
    printf 'No conversation found with session ID: %s\n' "$resume" >&2
    exit 3
  fi
  session="$resume"
fi
printf '\xe2\x9d\xaf\xc2\xa0\n'
printf '  ? for shortcuts\n'
mkdir -p "$store/projects/$slug"
rows="$store/projects/$slug/$session.jsonl"
[ -n "$resume" ] || printf '{"type":"permission-mode","permissionMode":"bypassPermissions","sessionId":"%s"}\n' "$session" > "$rows"
home_seen="${HOME//\\/\\\\}"
home_seen="${home_seen//\"/\\\"}"
while IFS= read -r line; do
  escaped="${line//\\/\\\\}"
  escaped="${escaped//\"/\\\"}"
  printf '{"parentUuid":null,"isSidechain":false,"type":"user","message":{"role":"user","content":"%s"},"uuid":"%s-%s","timestamp":"%s","sessionId":"%s","cwd":"%s","configDirSet":%s,"home":"%s"}\n' \
    "$escaped" "$session" "$RANDOM" "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" "$session" "$PWD" "$config_dir_set" "$home_seen" >> "$rows"
done
