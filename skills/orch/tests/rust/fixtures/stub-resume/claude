#!/bin/bash
# A stub harness for the relaunch rows, named `claude`: on `--resume ID` it
# requires the session file that id names under CLAUDE_CONFIG_DIR for this
# directory, as Claude Code does, and exits 3 without one, so a resume of a
# session the destination account never held fails as the real harness would.
# Otherwise it behaves as stub-confirm: draws the composer, takes
# `--session-id`, records each line it reads as a user turn.
session="stub-$$"
resume=""
while [ $# -gt 0 ]; do
  case "$1" in
    --session-id) session="${2:-$session}"; shift ;;
    --resume) resume="${2:-}"; shift ;;
  esac
  shift
done
slug="${PWD//[\/.]/-}"
if [ -n "$resume" ]; then
  if [ ! -f "${CLAUDE_CONFIG_DIR:-/nonexistent}/projects/$slug/$resume.jsonl" ]; then
    printf 'No conversation found with session ID: %s\n' "$resume" >&2
    exit 3
  fi
  session="$resume"
fi
printf '\xe2\x9d\xaf\xc2\xa0\n'
printf '  ? for shortcuts\n'
rows=""
if [ -n "${CLAUDE_CONFIG_DIR:-}" ]; then
  mkdir -p "$CLAUDE_CONFIG_DIR/projects/$slug"
  rows="$CLAUDE_CONFIG_DIR/projects/$slug/$session.jsonl"
  [ -n "$resume" ] || printf '{"type":"permission-mode","permissionMode":"bypassPermissions","sessionId":"%s"}\n' "$session" > "$rows"
fi
while IFS= read -r line; do
  [ -n "$rows" ] || continue
  escaped="${line//\\/\\\\}"
  escaped="${escaped//\"/\\\"}"
  printf '{"parentUuid":null,"isSidechain":false,"type":"user","message":{"role":"user","content":"%s"},"uuid":"%s-%s","timestamp":"%s","sessionId":"%s","cwd":"%s"}\n' \
    "$escaped" "$session" "$RANDOM" "$(date -u +%Y-%m-%dT%H:%M:%S.000Z)" "$session" "$PWD" >> "$rows"
done
