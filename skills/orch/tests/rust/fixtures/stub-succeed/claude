#!/bin/bash
# A stub predecessor for the controller tests, named `claude` so the kernel
# records the harness's own process name for it. It draws Claude Code's
# composer marker so the judge reads the pane idle, then reads lines as a
# harness reads turns: a line `RUN <command>` runs that command in the
# foreground, as the overseer's shell tool runs `oversee-succeed` from its
# own pane, so the `orch-runtime op` under test is a child of this process
# in this pane. Every other line is ignored. It launches no model; it stands
# until its stdin closes, which a kill-server or a window kill does.
printf '\xe2\x9d\xaf\xc2\xa0\n'
printf '  ? for shortcuts\n'
while IFS= read -r line; do
  case "$line" in
    "RUN "*) eval "${line#RUN }" ;;
  esac
done
