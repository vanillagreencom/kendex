#!/bin/bash
set -euo pipefail
# The manager's Linger answer: `yes` unless VALIDATE_LINGER names another,
# and `unread` a call that fails with its words on stderr.
case "${VALIDATE_LINGER:-yes}" in
  unread) echo 'linger read refused' >&2; exit 1 ;;
  *) printf '%s\n' "${VALIDATE_LINGER:-yes}" ;;
esac
