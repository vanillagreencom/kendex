[env]

# The status checks this repository's own required-checks ruleset requires,
# separated by semicolons: each job name exactly as the ruleset lists it.
# The organization owner's check of the repository compares the branch's
# required checks to this list. Never list "Review gate": the approval rule
# replaces it. The package ships no value; until 2.0 the check reports its
# row advisory while this key is absent or empty, unless the branch still
# requires "Review gate", which fails the row whatever this key holds; from
# 2.0 an absent or empty key fails the row.
REVIEW_GATE_STANDARD_CONTEXTS = ""

# The bypass actors the organization standard admits on a ruleset that holds
# the merge queue rule alone, separated by semicolons. Each is written
# TYPE:ID:MODE, as GitHub names the actor: its type (Integration for an
# app), its id, and its bypass mode (always, pull_request or exempt). Empty
# admits none, so the check reports any bypass actor on that ruleset.
REVIEW_GATE_STANDARD_QUEUE_BYPASS = ""

# The same, for a ruleset that holds the required status checks rule alone.
# Every other ruleset admits no bypass actor but the landing app below.
REVIEW_GATE_STANDARD_CHECKS_BYPASS = ""

# The landing app, TYPE:ID:MODE as above, for example
# Integration:5726115:always: it pushes an update its own refresh run proved
# to the default branch with no pull request. The queue and checks rulesets
# admit it, and so does a ruleset that holds the pull request rule alone, or
# with the required workflows rule, where it is that ruleset's one bypass
# actor. A ruleset with any other rule, deletion and force-push protection
# included, never admits it. Empty admits none.
REVIEW_GATE_STANDARD_LAND_BYPASS = ""

# Extra kendex projects for automatic refresh, separated by semicolons.
# Paths are relative to the checkout and must contain kendex.toml.
# Example: packaging/jarvis-home;another/project. Empty refreshes the root.
KENDEX_REFRESH_PROJECTS = ""
