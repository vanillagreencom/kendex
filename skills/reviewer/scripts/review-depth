#!/usr/bin/env bash
# Package review depth for a pull-request range. Native approval stays with GitHub.
set -euo pipefail

usage() {
  cat <<'USAGE'
Usage: review-depth --base REF [--head REF] [--repo DIR] [--floor CLASS]

Reads the range through orch's change_class_read and harness-ci's change-class.
No argument replaces the measured class. Run the trusted base checkout's copy.

The measured class selects package review depth:
  render, trivial, micro: none
  small:                  bot
  standard:               full

--floor CLASS (micro, small or standard) is a class the run already holds,
as item-tier --floor gives it: the class above the one a run escaped from.
Depth follows the wider of the measured class and the floor, ranked by orch's
change_class_rank. The floor only raises: it never lowers the measured class,
and a failed or unmeasured classifier keeps its exit. stderr names the floor
when it decided the depth.

stdout is one record:
  change_class=CLASS review_depth=none|bot|full native_approval=unchanged

change_class is always the measured class.

none skips package review; bot requires automatic review; full selects the
normal specialist review. Orch owns the panel, execution and round counters.
Every class keeps GitHub's native approval and thread requirements.
This command reads no approval state and grants no approval exemption.

Exit 0: measured depth. Exit 2: arguments, dependency or classifier failure.
Exit 3: unmeasured class. Nonzero exits print no depth record.
USAGE
}

fail() {
  printf 'review-depth: cause=%s value=%q\n' "$1" "$2" >&2
  exit 2
}

case "${1:-}" in -h|--help) usage; exit 0 ;; esac

BASE="" HEAD=HEAD REPO=. FLOOR=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --base|--head|--repo|--floor)
      [ "$#" -ge 2 ] && [ -n "$2" ] || fail arguments "$1"
      case "$1" in
        --base) BASE="$2" ;;
        --head) HEAD="$2" ;;
        --repo) REPO="$2" ;;
        --floor) FLOOR="$2" ;;
      esac
      shift 2 ;;
    *) fail arguments "$1" ;;
  esac
done
[ -n "$BASE" ] || fail arguments --base

SCRIPT_DIR="$(cd -- "$(dirname -- "$0")" && pwd -P)" || exit 2
READER="$SCRIPT_DIR/../../orch/scripts/lib/change-class.sh"
[ -r "$READER" ] || fail reader-absent "$READER"
# shellcheck source=../../orch/scripts/lib/change-class.sh
. "$READER" || exit 2
[ -z "$FLOOR" ] || change_class_floor "$FLOOR" || fail arguments "--floor=$FLOOR"
CLASS_ERR="$(mktemp "${TMPDIR:-/tmp}/review-depth.XXXXXX")" || fail scratch "${TMPDIR:-/tmp}"
trap 'rm -f -- "${CLASS_ERR:?}"' EXIT

if ! change_class_read "$BASE" "$HEAD" "$REPO" "$CLASS_ERR"; then
  cat -- "$CLASS_ERR" >&2
  fail "$CHANGE_CLASS_CAUSE" "$REPO"
fi
cat -- "$CLASS_ERR" >&2
case "$CHANGE_CLASS_MEASURED" in
  true) ;;
  false)
    printf 'review-depth: cause=classifier-unmeasured value=%q\n' "$CHANGE_CLASS" >&2
    exit 3 ;;
  *) fail classifier-unreadable "$CHANGE_CLASS_MEASURED" ;;
esac
depth_of() { # CLASS; sets DEPTH
  case "$1" in
    render|trivial|micro) DEPTH=none ;;
    small) DEPTH=bot ;;
    standard) DEPTH=full ;;
  esac
}
change_class_rank "$CHANGE_CLASS" || fail classifier-unreadable "$CHANGE_CLASS"
MEASURED_RANK="$CHANGE_CLASS_RANK"
depth_of "$CHANGE_CLASS"
if [ -n "$FLOOR" ]; then
  MEASURED_DEPTH="$DEPTH"
  change_class_rank "$FLOOR"
  if [ "$CHANGE_CLASS_RANK" -gt "$MEASURED_RANK" ]; then
    depth_of "$FLOOR"
    [ "$DEPTH" = "$MEASURED_DEPTH" ] ||
      printf 'review-depth: floor=%s change_class=%s\n' "$FLOOR" "$CHANGE_CLASS" >&2
  fi
fi
printf 'change_class=%s review_depth=%s native_approval=unchanged\n' "$CHANGE_CLASS" "$DEPTH"
