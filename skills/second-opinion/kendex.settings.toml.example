[env]

# Which outside models review a change, and how each one is run.

# The reviewers to try, best first, separated by spaces or commas. The
# claude and codex names have built-in commands; any other name needs one
# below. A review goes to the first name that is installed and is not the
# model running this session.
SECOND_OPINION_MODELS = "claude codex"

# How many separate opinions one review collects. 2 or more sends the same
# change to that many different models.
SECOND_OPINION_COUNT = "1"

# The model running this session, so a review never asks it to judge its own
# work. It is needed only where that cannot be detected. Set it in the
# session itself: a value in this file describes no single session and is
# refused.
# SECOND_OPINION_CURRENT_MODEL = "claude"

# The command that runs the claude reviewer.
SECOND_OPINION_CLAUDE_CMD = "claude -p --no-session-persistence --model opus --effort max --allowedTools Bash(read-only:true),Read,Glob,Grep"

# The command that runs the codex reviewer.
SECOND_OPINION_CODEX_CMD = "codex exec -m gpt-6-astra -s read-only -c model_reasoning_effort=xhigh --ephemeral"

# How to add another reviewer: name it in the list above, give it a command,
# and say which model that command reaches.
# SECOND_OPINION_PI_DEEPSEEK_CMD = "pi -p --model deepseek/deepseek-v4-pro"
# SECOND_OPINION_PI_DEEPSEEK_MODEL = "deepseek"

# Seconds to wait for a reviewer to answer before giving up on it.
SECOND_OPINION_TIMEOUT = "1080"

# Where review records are written when no output file is named. A folder
# created here is set to stay out of git; one that already exists is left
# alone, so keep it out of git yourself.
SECOND_OPINION_ARTIFACT_DIR = "tmp/second-opinion"

# This project's own instruction files, added to the review prompt so the
# reviewer judges against this project's rules. Paths separated by spaces.
# Empty sends the change with no project rules attached.
SECOND_OPINION_REVIEW_INSTRUCTIONS = "AGENTS.md review-bots.md .github/instructions/*.instructions.md .github/copilot-instructions.md"

# Always review with this one reviewer instead of working down the list. A
# reviewer running this session's own model is refused.
# SECOND_OPINION_TARGET = "claude"
