[env]

# Which outside models review a change, and how each one is run.

# The reviewers to try, best first, separated by spaces or commas. The
# claude, codex, pi-copilot and pi-copilot-gpt names have built-in commands;
# any other name needs one below. A review goes to the first name that is installed and is not the
# model running this session. This is also the execution fallback order: a
# nonzero exit, timeout or recognized quota/rate-limit refusal tries the next
# name. A refusal on stderr counts only when stdout holds no usable review
# answer. Each attempt reports its name, cause and seconds.
SECOND_OPINION_MODELS = "pi-copilot claude pi-copilot-gpt codex"

# The most opinions one review collects. 2 or more sends the same change to
# that many different models. With fewer eligible models, the review runs on
# those it has and reports reduced coverage.
SECOND_OPINION_COUNT = "1"

# The model running this session, so a review never asks it to judge its own
# work. It is needed only where that cannot be detected. Set it in the
# session itself: a value in this file describes no single session and is
# refused.
# SECOND_OPINION_CURRENT_MODEL = "claude"

# The command that runs the claude reviewer.
SECOND_OPINION_CLAUDE_CMD = "claude -p --output-format json --no-session-persistence --model claude-opus-5-5 --effort high --restricted --permission-mode dontAsk --tools Bash,Read,Glob,Grep --allowedTools Bash(read-only:true),Read,Glob,Grep --setting-sources="

# The command that runs the codex reviewer.
SECOND_OPINION_CODEX_CMD = "codex exec -m gpt-6.1-sol -s read-only -c model_reasoning_effort=xhigh --disable hooks --ephemeral"

# A copilot entry has no built-in command: Copilot CLI documents no read-only
# headless mode, so name a command you have checked cannot write. Its model
# is the identity; unset, copilot is skipped.
# SECOND_OPINION_COPILOT_CMD = "..."
# SECOND_OPINION_COPILOT_MODEL = "gpt-5.5"

# How to add another reviewer: name it in the list above, give it a command,
# and say which model that command reaches.
# SECOND_OPINION_PI_DEEPSEEK_CMD = "pi -p --model deepseek/deepseek-v4-pro"
# SECOND_OPINION_PI_DEEPSEEK_MODEL = "deepseek"

# A reviewer can be checked for room on the account it spends before it is
# asked. The check exits 0 when there is room and prints the account's
# NAME=value env prefix, which the reviewer then runs under; any other exit
# skips the reviewer for the next one. The orch skill's lanes pick is that
# check. pi-copilot and pi-copilot-gpt, Pi on the Copilot pool running Claude
# Opus and GPT, come with their command, model, room check and inline diff
# built in (`second-opinion --help` prints them); their check runs lanes pick
# from this project's .agents/skills/orch, so where orch is not installed
# there, or the check refuses, the entry is skipped for the next one. Setting
# an entry's _CMD replaces all four with that entry's own settings; setting
# its _ROOM_CMD empty drops the check. Each target remains subject to
# session-model exclusion.
# The Copilot check reads ORCH_LANE_COPILOT_POOL from the settings in the
# lane's own tree; a hosted lane states it in .env.local until its provider
# forwards it, and one without it records the check's refusal. Each check pins
# ORCH_LANE_HOST=local through env, since the command runs without a shell: the
# reviewer runs on this machine's login, which a lane-host provider's reading
# of the account does not judge. claude and codex have no check unless one
# is set:
# SECOND_OPINION_CLAUDE_ROOM_CMD = "env ORCH_LANE_HOST=local .agents/skills/orch/scripts/lanes pick --harness claude --model claude-opus-5-5"
# SECOND_OPINION_CODEX_ROOM_CMD = "env ORCH_LANE_HOST=local .agents/skills/orch/scripts/lanes pick --harness codex --model gpt-6.1-sol --binding-floor"

# A reviewer that cannot run git, such as Pi on read-only file tools, is sent
# the change itself: set to 1, its review prompt carries the diff, up to the cap
# `second-opinion --help` names.
# SECOND_OPINION_PI_DEEPSEEK_INLINE_DIFF = "1"

# Seconds to wait for a reviewer to answer before giving up on it.
SECOND_OPINION_TIMEOUT = "1080"

# Where review records are written when no output file is named. A folder
# created here is set to stay out of git; one that already exists is left
# alone, so keep it out of git yourself.
SECOND_OPINION_ARTIFACT_DIR = "tmp/second-opinion"

# This project's own instruction files, added to the review prompt so the
# reviewer judges against this project's rules. Path patterns separated by
# spaces; one matching no file is reported and the review still runs. Empty
# sends the change with no project rules attached.
SECOND_OPINION_REVIEW_INSTRUCTIONS = "AGENTS.md review-bots.md .github/instructions/code-review.md .github/instructions/*.instructions.md .github/copilot-instructions.md"

# Always review with this one reviewer instead of working down the list. A
# reviewer running this session's own model is refused.
# SECOND_OPINION_TARGET = "claude"
