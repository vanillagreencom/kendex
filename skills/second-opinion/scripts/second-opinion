#!/usr/bin/env bash
# Cross-model second opinion — detect current harness, call the opposite CLI.
#
# Usage:
#   second-opinion review  [--range <ref..ref>] [--cwd <path>] [--output <path>]
#   second-opinion challenge --prompt <file>    [--cwd <path>]
#   second-opinion audit     --prompt <file>    [--cwd <path>] [--output <path>]
#   second-opinion quick     --prompt <file>    [--cwd <path>]
#   second-opinion detect
#
# Environment:
#   SECOND_OPINION_TARGET        Force a single target CLI (disables multi-lane review)
#   SECOND_OPINION_TIMEOUT       Timeout in seconds (default: 300)
#   SECOND_OPINION_CLAUDE_CMD    Full claude command
#   SECOND_OPINION_CODEX_CMD     Full codex command
#   SECOND_OPINION_<NAME>_CMD    Full command for any custom review target
#   SECOND_OPINION_REVIEW_TARGETS       Review lanes (default: "codex claude")
#   SECOND_OPINION_REVIEW_INSTRUCTIONS  Repo instruction-file globs for review

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Resolve project root for .env sourcing (works in worktrees and main repos)
PROJECT_ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null)"

# Save caller-set env vars before .env sourcing can overwrite them
_CALLER_TARGET="${SECOND_OPINION_TARGET:-}"
_CALLER_TIMEOUT="${SECOND_OPINION_TIMEOUT:-}"
_CALLER_CLAUDE_CMD="${SECOND_OPINION_CLAUDE_CMD:-}"
_CALLER_CODEX_CMD="${SECOND_OPINION_CODEX_CMD:-}"
# Set-ness (not emptiness) is preserved for the review vars: an explicitly
# EMPTY caller value is meaningful ("" disables the instruction block / lane
# list) and must survive the .env reload rather than fall back to project
# config.
_CALLER_REVIEW_TARGETS="${SECOND_OPINION_REVIEW_TARGETS-}"
_CALLER_REVIEW_TARGETS_SET="${SECOND_OPINION_REVIEW_TARGETS+x}"
_CALLER_REVIEW_INSTRUCTIONS="${SECOND_OPINION_REVIEW_INSTRUCTIONS-}"
_CALLER_REVIEW_INSTRUCTIONS_SET="${SECOND_OPINION_REVIEW_INSTRUCTIONS+x}"

# Source project config/secrets. .env.local overrides public settings.
# shellcheck source=lib/vstack-env.sh
source "$SCRIPT_DIR/lib/vstack-env.sh"
vstack_load_project_env "$PROJECT_ROOT"

# Restore caller-set env vars — inline overrides beat .env files
[[ -n "$_CALLER_TARGET" ]] && SECOND_OPINION_TARGET="$_CALLER_TARGET"
[[ -n "$_CALLER_TIMEOUT" ]] && SECOND_OPINION_TIMEOUT="$_CALLER_TIMEOUT"
[[ -n "$_CALLER_CLAUDE_CMD" ]] && SECOND_OPINION_CLAUDE_CMD="$_CALLER_CLAUDE_CMD"
[[ -n "$_CALLER_CODEX_CMD" ]] && SECOND_OPINION_CODEX_CMD="$_CALLER_CODEX_CMD"
[[ -n "$_CALLER_REVIEW_TARGETS_SET" ]] && SECOND_OPINION_REVIEW_TARGETS="$_CALLER_REVIEW_TARGETS"
[[ -n "$_CALLER_REVIEW_INSTRUCTIONS_SET" ]] && SECOND_OPINION_REVIEW_INSTRUCTIONS="$_CALLER_REVIEW_INSTRUCTIONS"

# Dependency check
command -v jq >/dev/null 2>&1 || { echo "Error: jq is required but not found" >&2; exit 1; }

# Portability: macOS lacks timeout, try gtimeout fallback
if ! command -v timeout >/dev/null 2>&1; then
  if command -v gtimeout >/dev/null 2>&1; then
    timeout() { gtimeout "$@"; }
  else
    # No timeout available — run without time limit
    timeout() { shift; "$@"; }
  fi
fi

# --- Defaults -----------------------------------------------------------------

MODE=""
PROMPT_FILE=""
INLINE_PROMPT=""
OUTPUT_PATH=""
TARGET=""
TIMEOUT="${SECOND_OPINION_TIMEOUT:-300}"
CWD="."
RANGE=""

# Distinct exit codes (vstack#652) so callers can tell "there was nothing to
# review" and "the model reported it performed no review" apart from generic
# failures (1). A response missing the required qa_metadata object (vstack#672)
# or still structurally incomplete after the one-shot retry (vstack#678) is
# rejected the same way. None of these paths writes the --output artifact.
#
# EXIT_CLI_FAILED (vstack#809): the external CLI failed to produce ANY review at
# all — it exited non-zero (quota/auth/network), timed out, or returned nothing
# usable on a zero exit. That yields no external verdict, so like exits 3/4 it
# must never be a silent exit-0 success; it joins the no-verdict class. It is
# kept DISTINCT from EXIT_NO_REVIEW (4) on purpose: 4 is a response-level defect
# (the model answered, but the answer is unusable), whereas 5 is a lane-level
# failure (the model never answered) — an operator retries a down lane but reads
# a code-4 as a real signal about the review. Only review/audit modes (the ones
# with the no-verdict contract) use it; challenge/quick keep the generic 1.
EXIT_NO_SCOPE=3
EXIT_NO_REVIEW=4
EXIT_CLI_FAILED=5

# The containing directory of a path, without `dirname`. --output is caller
# input and may legitimately begin with '-', which dirname parses as options —
# and the `--` end-of-options marker is not available here, because BSD dirname
# can reject it on the macOS Bash 3.2 support target. Parameter expansion has
# neither problem. Mirrors dirname for the cases that reach it: no slash yields
# ".", a root-level path yields "/".
path_dir() {
  local path="$1" dir="${1%/*}"
  if [[ "$dir" == "$path" ]]; then
    printf '%s' "."
  elif [[ -z "$dir" ]]; then
    printf '%s' "/"
  else
    printf '%s' "$dir"
  fi
}

# --- Help ---------------------------------------------------------------------

show_help() {
  cat <<'HELP'
Cross-model second opinion via external AI CLI.

Usage:
  second-opinion review    [--range <ref..ref>] [--cwd <path>] [--output <path>]
  second-opinion challenge [--prompt <file> | "text"]  [--cwd <path>]
  second-opinion audit     [--prompt <file> | "text"]  [--cwd <path>] [--output <path>]
  second-opinion quick     [--prompt <file> | "text"]  [--cwd <path>]
  second-opinion detect

Modes:
  review     Code review of pending changes — outputs review-finding JSON
  challenge  Adversarial analysis — accepts prompt, returns text critique
  audit      Deep code examination — accepts prompt, returns review-finding JSON
  quick      Question to alternate model — accepts prompt, returns text
  detect     Print auto-detected target CLI name and exit

Options:
  --prompt <file>   Prompt file (or pass text as positional arg, or pipe stdin)
  --output <path>   Write result to file (default: stdout)
  --target <name>   Override target: claude | codex
  --range <ref>     Git diff range for review (default: origin/BASE...HEAD)
  --cwd <path>      Working directory for external CLI (default: .)
  --timeout <secs>  CLI timeout (default: 300, env: SECOND_OPINION_TIMEOUT)
  -h, --help        Show this help

Multi-lane review: with no --target and no SECOND_OPINION_TARGET, review mode
runs EVERY available lane in SECOND_OPINION_REVIEW_TARGETS on the same derived
scope and writes one union artifact — findings deduplicated by normalized
location, per-lane provenance in each finding's `sources` and in
qa_metadata.lanes. Lane artifacts are kept beside it as <output>.<target>.json.
A failed lane is recorded in the artifact (qa_metadata.coverage="degraded");
when every lane fails there is no artifact and the run exits 4/5.

Environment (set in vstack.settings.toml [env] or .env.local):
  SECOND_OPINION_TARGET      Force a single target CLI (disables multi-lane review)
  SECOND_OPINION_TIMEOUT     Timeout in seconds (default: 300)
  SECOND_OPINION_CLAUDE_CMD  Full claude command (default below)
  SECOND_OPINION_CODEX_CMD   Full codex command (default below)
  SECOND_OPINION_<NAME>_CMD  Full command for any custom target (name uppercased,
                             hyphens become underscores)
  SECOND_OPINION_REVIEW_TARGETS
                             Review lanes, space/comma separated (default:
                             "codex claude"); every available lane runs
  SECOND_OPINION_REVIEW_INSTRUCTIONS
                             Repo instruction-file globs appended to the review
                             prompt, resolved inside --cwd (default:
                             "AGENTS.md review-bots.md
                             .github/instructions/*.instructions.md
                             .github/copilot-instructions.md"; set empty to disable)

Default commands:
  claude: claude -p --no-session-persistence --model opus --effort max
            --allowedTools Bash(read-only:true),Read,Glob,Grep
  codex:  codex exec -m gpt-5.6-sol -s read-only -c model_reasoning_effort=xhigh
            --ephemeral

Exit codes:
  0  success
  1  config failure (bad target, missing jq), or an unrecoverable non-JSON
     response that survived the one-shot retry (review/audit)
  3  review: derived diff scope is empty or invalid — nothing to review
  4  review/audit: model self-reported no review was performed
     (qa_metadata.review_performed=false) or omitted the required qa_metadata
     object entirely (response kept as <output>.noreview.json); or the response
     was still structurally incomplete after the one-shot retry — missing
     verdict or the blockers/suggestions/questions arrays (response kept as
     <output>.incomplete.json)
  5  review/audit: the external CLI failed to produce any review — it exited
     non-zero (quota/auth/network), timed out, or returned an empty response on
     a zero exit. No external verdict; whatever partial output existed is kept
     as <output>.failed.json and the CLI's own error text is echoed on stderr
HELP
}

# --- Argument parsing ---------------------------------------------------------

while [[ $# -gt 0 ]]; do
  case "$1" in
    review|challenge|audit|quick|detect)
      MODE="$1"; shift ;;
    --prompt)    [[ $# -ge 2 ]] || { echo "Error: --prompt requires a value" >&2; exit 1; }; PROMPT_FILE="$2"; shift 2 ;;
    --prompt=*)  PROMPT_FILE="${1#--prompt=}"; shift ;;
    --output)    [[ $# -ge 2 ]] || { echo "Error: --output requires a value" >&2; exit 1; }; OUTPUT_PATH="$2"; shift 2 ;;
    --output=*)  OUTPUT_PATH="${1#--output=}"; shift ;;
    --target|--provider)  [[ $# -ge 2 ]] || { echo "Error: $1 requires a value" >&2; exit 1; }; TARGET="$2"; shift 2 ;;
    --target=*)  TARGET="${1#--target=}"; shift ;;
    --provider=*) TARGET="${1#--provider=}"; shift ;;
    --range)     [[ $# -ge 2 ]] || { echo "Error: --range requires a value" >&2; exit 1; }; RANGE="$2"; shift 2 ;;
    --range=*)   RANGE="${1#--range=}"; shift ;;
    --cwd)       [[ $# -ge 2 ]] || { echo "Error: --cwd requires a value" >&2; exit 1; }; CWD="$2"; shift 2 ;;
    --cwd=*)     CWD="${1#--cwd=}"; shift ;;
    --timeout)   [[ $# -ge 2 ]] || { echo "Error: --timeout requires a value" >&2; exit 1; }; TIMEOUT="$2"; shift 2 ;;
    --timeout=*) TIMEOUT="${1#--timeout=}"; shift ;;
    -h|--help)   show_help; exit 0 ;;
    --*)
      echo "Error: unknown flag: $1" >&2; exit 1 ;;
    *)
      # Non-flag arg after mode → treat as inline prompt text
      if [[ -n "$MODE" && -z "$PROMPT_FILE" ]]; then
        INLINE_PROMPT="$1"; shift
      else
        echo "Error: unknown argument: $1" >&2; exit 1
      fi
      ;;
  esac
done

[[ -n "$MODE" ]] || { echo "Error: mode required (review|challenge|audit|quick|detect)" >&2; exit 1; }
[[ "$TIMEOUT" =~ ^[0-9]+$ ]] || { echo "Error: --timeout must be a positive integer" >&2; exit 1; }

# --- Harness detection --------------------------------------------------------

detect_current_harness() {
  # Claude Code sets these env vars
  if [[ -n "${CLAUDE_CODE:-}" ]] || [[ -n "${CLAUDE_PROJECT_DIR:-}" ]]; then
    echo "claude"
    return
  fi
  # Codex sandbox detection
  if [[ -n "${CODEX_SANDBOX:-}" ]]; then
    echo "codex"
    return
  fi
  # Pi coding agent
  if [[ -n "${PI_CODING_AGENT_DIR:-}" ]]; then
    echo "pi"
    return
  fi
  # OpenCode uses GPT models, so treat as codex for cross-model pairing
  if [[ -n "${OPENCODE:-}" ]]; then
    echo "codex"
    return
  fi
  # Process-tree fallback: walk ancestors (Bash tool PPID is the shell, not the harness)
  local pid=$$
  local ancestor_cmd
  while pid=$(ps -o ppid= -p "$pid" 2>/dev/null | tr -d ' ') && [[ -n "$pid" && "$pid" != "0" && "$pid" != "1" ]]; do
    ancestor_cmd=$(ps -o comm= -p "$pid" 2>/dev/null || echo "")
    case "$ancestor_cmd" in
      claude*) echo "claude"; return ;;
      codex*)  echo "codex"; return ;;
      pi|pi-*) echo "pi"; return ;;
      opencode*) echo "codex"; return ;;
    esac
  done
  echo "unknown"
}

resolve_target() {
  # Explicit flag
  if [[ -n "$TARGET" ]]; then echo "$TARGET"; return; fi
  # Env var override
  if [[ -n "${SECOND_OPINION_TARGET:-}" ]]; then echo "$SECOND_OPINION_TARGET"; return; fi

  # Auto-detect: call the opposite of current harness
  local current
  current=$(detect_current_harness)
  case "$current" in
    claude) echo "codex" ;;
    codex)  echo "claude" ;;
    pi)     echo "claude" ;;
    *)
      # Unknown harness (OpenCode, Cursor, etc.) — prefer claude since
      # non-Claude harnesses typically use GPT models already
      if command -v claude >/dev/null 2>&1; then echo "claude"
      elif command -v codex >/dev/null 2>&1; then echo "codex"
      else echo ""; fi
      ;;
  esac
}

# --- Pluggable target commands ------------------------------------------------
# VST-124: a review target is a NAME plus a full command line. claude and codex
# carry built-in default commands; any other name resolves ONLY through its
# SECOND_OPINION_<NAME>_CMD variable, so a third local model CLI is a settings
# entry, not new code.

DEFAULT_CLAUDE_CMD="claude -p --no-session-persistence --model opus --effort max --allowedTools Bash(read-only:true),Read,Glob,Grep"
DEFAULT_CODEX_CMD="codex exec -m gpt-5.6-sol -s read-only -c model_reasoning_effort=xhigh --ephemeral"

# Env var that configures a target's full command: name uppercased, hyphens as
# underscores (Bash 3.2: no ${var^^}).
target_cmd_var() {
  printf 'SECOND_OPINION_%s_CMD' "$(printf '%s' "$1" | tr '[:lower:]-' '[:upper:]_')"
}

# Full command line for a target: its env override, else the built-in default.
# Empty output = unconfigured target.
target_cmd() {
  local target="$1" var
  var="$(target_cmd_var "$target")"
  if [[ -n "${!var:-}" ]]; then
    printf '%s' "${!var}"
    return
  fi
  case "$target" in
    claude) printf '%s' "$DEFAULT_CLAUDE_CMD" ;;
    codex)  printf '%s' "$DEFAULT_CODEX_CMD" ;;
  esac
}

# A target is available when it has a configured command whose executable (the
# command's first word) resolves — the first word is what actually gets exec'd,
# and an env override may point it away from the target's own name.
target_available() {
  local cmd
  cmd="$(target_cmd "$1")"
  [[ -n "$cmd" ]] || return 1
  # shellcheck disable=SC2086
  set -- $cmd
  command -v "$1" >/dev/null 2>&1
}

# --- Review lane resolution ---------------------------------------------------
# GH-bot parity (VST-124): different models have different blind spots, so a
# review with no forced target fans out to EVERY available lane listed in
# SECOND_OPINION_REVIEW_TARGETS and unions the findings. --target and
# SECOND_OPINION_TARGET still force a single lane.

REVIEW_LANES=()
resolve_review_lanes() {
  local raw="${SECOND_OPINION_REVIEW_TARGETS-codex claude}"
  raw="${raw//,/ }"
  local t seen existing
  # Same name shape the single-lane path enforces — an arbitrary token would
  # otherwise reach indirect variable expansion and per-lane file paths. A
  # duplicate name would launch concurrent children racing on the same lane
  # artifact/stderr paths and duplicate the lane's provenance, so each
  # available target joins at most once. Skips are loud.
  set -f
  for t in $raw; do
    set +f
    if [[ ! "$t" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]; then
      echo "→ skipping invalid review target name: $t" >&2
      continue
    fi
    seen=""
    for existing in ${REVIEW_LANES[@]+"${REVIEW_LANES[@]}"}; do
      [[ "$existing" == "$t" ]] && seen=1 && break
    done
    if [[ -n "$seen" ]]; then
      echo "→ skipping duplicate review target: $t" >&2
      continue
    fi
    target_available "$t" && REVIEW_LANES+=("$t")
  done
  set +f
  return 0
}

TARGET_CLI=""
MULTI_LANE=false
if [[ "$MODE" == "review" && -z "$TARGET" && -z "${SECOND_OPINION_TARGET:-}" ]]; then
  resolve_review_lanes
  if [[ ${#REVIEW_LANES[@]} -ge 2 ]]; then
    MULTI_LANE=true
  elif [[ ${#REVIEW_LANES[@]} -eq 1 ]]; then
    TARGET_CLI="${REVIEW_LANES[0]}"
  else
    # No configured lane is available — fall through to the legacy resolver so
    # the error message stays the familiar "CLI not found" shape.
    TARGET_CLI=$(resolve_target)
  fi
else
  TARGET_CLI=$(resolve_target)
fi

# Handle detect mode
if [[ "$MODE" == "detect" ]]; then
  if [[ -n "$TARGET_CLI" ]] && target_available "$TARGET_CLI"; then
    echo "$TARGET_CLI"
    exit 0
  else
    echo "none"
    exit 1
  fi
fi

# Validate target (multi-lane already filtered to available lanes)
if ! $MULTI_LANE; then
  if [[ -z "$TARGET_CLI" ]]; then
    echo '{"error": "No external CLI found. Install claude or codex CLI."}' >&2
    exit 1
  fi
  if [[ ! "$TARGET_CLI" =~ ^[A-Za-z][A-Za-z0-9_-]*$ ]]; then
    echo "{\"error\": \"Invalid target name: $TARGET_CLI\"}" >&2
    exit 1
  fi
  if ! target_available "$TARGET_CLI"; then
    echo "{\"error\": \"CLI not found: $TARGET_CLI. Install it, set SECOND_OPINION_TARGET, or configure $(target_cmd_var "$TARGET_CLI").\"}" >&2
    exit 1
  fi
fi

# Validate CWD
[[ -d "$CWD" ]] || { echo "Error: --cwd directory not found: $CWD" >&2; exit 1; }

if $MULTI_LANE; then
  echo "→ second-opinion: targets=$(IFS=+; echo "${REVIEW_LANES[*]}") mode=$MODE (multi-lane) cwd=$CWD timeout=${TIMEOUT}s" >&2
else
  echo "→ second-opinion: target=$TARGET_CLI mode=$MODE cwd=$CWD timeout=${TIMEOUT}s" >&2
fi

# --- Review scope derivation (review mode) ------------------------------------
# vstack#652: the external model must never be asked to guess its own scope. A
# no-scope session can answer with a schema-valid `verdict: "pass"` while
# admitting it reviewed nothing. Derive branch + diff range + changed-file list
# from the worktree BEFORE invoking the CLI, embed them in the prompt, and fail
# loudly when the range yields no diff — an empty-scope review is an error, not
# a pass.

REVIEW_BRANCH=""
REVIEW_RANGE=""
REVIEW_CHANGED_FILES=""
REVIEW_DIFFSTAT=""
REVIEW_HEAD_SHA=""

derive_review_scope() {
  local cwd="$1"
  local range="$2"

  if [[ -z "$range" ]]; then
    local base_branch
    base_branch=${WORKTREE_DEFAULT_BRANCH:-$(git -C "$cwd" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's@^refs/remotes/origin/@@' || true)}
    [[ -n "$base_branch" ]] || base_branch=main
    range="origin/${base_branch}...HEAD"
  fi

  # Pin the scope to an immutable commit at derivation time: a symbolic HEAD
  # endpoint re-resolves per invocation, so a commit landing mid-review would
  # let lanes inspect different diffs and the artifact claim a head the model
  # never reviewed. reviewed_head is stamped from the RANGE'S endpoint (the
  # commit actually reviewed) — never from a post-review rev-parse, and never
  # from worktree HEAD when an explicit historical range was requested.
  local head_now
  head_now=$(git -C "$cwd" rev-parse HEAD 2>/dev/null || echo "")
  if [[ -n "$head_now" && "$range" == *HEAD* ]]; then
    range="${range//HEAD/$head_now}"
  fi
  local endpoint="${range##*..}"
  [[ -n "$endpoint" ]] || endpoint="$head_now"
  REVIEW_HEAD_SHA=$(git -C "$cwd" rev-parse "$endpoint" 2>/dev/null || echo "")
  REVIEW_RANGE="$range"

  REVIEW_BRANCH=$(git -C "$cwd" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "")

  local git_err diff_files
  git_err=$(mktemp)
  # shellcheck disable=SC2086
  # core.quotePath=false keeps non-ASCII path bytes literal — the default
  # C-quoting ("services/\303\251/…") would break the nested-AGENTS ancestor
  # walk and misname files in the prompt's changed-file list.
  # shellcheck disable=SC2086
  if ! diff_files=$(git -C "$cwd" -c core.quotePath=false diff --name-only $range 2>"$git_err"); then
    jq -n --arg range "$range" --arg cwd "$cwd" --arg detail "$(head -5 "$git_err")" \
      '{error: "Cannot derive review scope: git diff failed for range \($range)", cwd: $cwd, detail: $detail}' >&2
    rm -f "$git_err"
    exit "$EXIT_NO_SCOPE"
  fi
  rm -f "$git_err"

  if [[ -z "$diff_files" ]]; then
    jq -n --arg range "$range" --arg cwd "$cwd" --arg branch "$REVIEW_BRANCH" \
      '{error: "No review scope: git diff \($range) is empty — nothing to review", cwd: $cwd, branch: $branch}' >&2
    exit "$EXIT_NO_SCOPE"
  fi

  REVIEW_CHANGED_FILES="$diff_files"
  # shellcheck disable=SC2086
  REVIEW_DIFFSTAT=$(git -C "$cwd" diff --shortstat $range 2>/dev/null || echo "")
}

# --- Repo instruction collection (review mode) --------------------------------
# VST-124: GitHub review bots read the repo's own instruction files
# (.github/instructions/*, copilot-instructions, review-bots.md) and enforce
# them; the local review must see the same rules or repo-rule findings are
# structurally impossible. Globs resolve inside the reviewed repo ($CWD). A
# set-but-empty SECOND_OPINION_REVIEW_INSTRUCTIONS disables the block; unset
# uses the defaults. Each file is capped so one oversized instruction file
# cannot drown the diff in the prompt.

REVIEW_INSTRUCTIONS_DEFAULT="AGENTS.md review-bots.md .github/instructions/*.instructions.md .github/copilot-instructions.md"
REVIEW_INSTRUCTIONS_FILE_CAP=65536

# Emit one instruction file (containment-checked, deduped, capped). Relies on
# the caller's dynamically-scoped `matched`, `phys_root`, and CWD. Symlinked
# files and paths whose parent directory physically resolves outside the
# reviewed repo are skipped loudly, never followed.
emit_instruction_file() {
  local f="$1" phys_dir size
  [[ -n "$f" && -f "$CWD/$f" ]] || return 0
  if [[ ! -r "$CWD/$f" ]]; then
    # Skip loudly, never abort: under set -e an unguarded read failure here
    # (permissions, TOCTOU disappearance) would kill the whole review.
    echo "→ skipping unreadable instruction file: $f" >&2
    return 0
  fi
  if [[ -L "$CWD/$f" ]]; then
    echo "→ skipping symlinked instruction file (must be a regular file inside the repo): $f" >&2
    return 0
  fi
  phys_dir="$(cd "$CWD/$(dirname "$f")" 2>/dev/null && pwd -P)" || return 0
  if [[ "$phys_dir" != "$phys_root" && "$phys_dir" != "$phys_root"/* ]]; then
    echo "→ skipping instruction file outside the reviewed repo: $f -> $phys_dir" >&2
    return 0
  fi
  case "$matched" in *$'\n'"$f"$'\n'*) return 0 ;; esac
  matched="${matched}${f}"$'\n'
  printf -- '--- %s ---\n' "$f"
  head -c "$REVIEW_INSTRUCTIONS_FILE_CAP" "$CWD/$f" 2>/dev/null || true
  # Size from metadata (GNU/BSD stat), no second read of the bytes.
  size=$(stat -c%s "$CWD/$f" 2>/dev/null || stat -f%z "$CWD/$f" 2>/dev/null || echo 0)
  if [[ "$size" -gt "$REVIEW_INSTRUCTIONS_FILE_CAP" ]]; then
    printf '\n[truncated at %s bytes]\n' "$REVIEW_INSTRUCTIONS_FILE_CAP"
  else
    printf '\n'
  fi
}

collect_review_instructions() {
  local patterns="${SECOND_OPINION_REVIEW_INSTRUCTIONS-$REVIEW_INSTRUCTIONS_DEFAULT}"
  patterns="${patterns//,/ }"
  local pattern f matched=$'\n'
  # Split the pattern list with pathname expansion OFF: an unquoted $patterns
  # word-split would glob-expand each pattern against the script's own cwd —
  # the wrong repo — consuming patterns that happen to match there. Only
  # compgen -G below, inside $CWD, may expand them.
  set -f
  # shellcheck disable=SC2206
  local -a pattern_list=($patterns)
  set +f
  # Containment root: the reviewed repo's PHYSICAL path (see
  # emit_instruction_file for the checks each match must pass).
  local phys_root
  phys_root="$(cd "$CWD" && pwd -P)" || return 0
  for pattern in ${pattern_list[@]+"${pattern_list[@]}"}; do
    # compgen -G expands the glob without leaking non-matches (a bare unmatched
    # pattern would otherwise pass through as a literal word). One path per
    # line, so spaces in names survive; newline-in-name is not supported.
    while IFS= read -r f; do
      emit_instruction_file "$f"
    done < <(cd "$CWD" && compgen -G "$pattern" 2>/dev/null || true)
  done

  # Scoped instructions: when the pattern list carries the literal AGENTS.md
  # entry, nested AGENTS.md files GOVERNING THE CHANGED PATHS apply too — a
  # monorepo's services/api/AGENTS.md rules the api diff even though the
  # root-level glob never sees it (GitHub bots apply nested agent files the
  # same way). Walk each changed file's ancestor directories; dedupe and
  # containment come from emit_instruction_file.
  local want_agents="" p
  for p in ${pattern_list[@]+"${pattern_list[@]}"}; do
    [[ "$p" == "AGENTS.md" ]] && want_agents=1
  done
  if [[ -n "$want_agents" && -n "${REVIEW_CHANGED_FILES:-}" ]]; then
    # Path-byte fidelity: the walk consumes the newline-separated changed-file
    # list (core.quotePath=false keeps non-ASCII literal). Control characters
    # in a pathname stay C-quoted regardless of that setting, so such a path
    # fails the -f check downstream and its AGENTS.md is OMITTED — fail-closed,
    # same documented posture as newline-in-name on the glob side. Not worth
    # a -z/NUL rebuild of the scope pipeline for hostile filenames in a repo
    # the reviewer chose to review.
    local changed_file dir chain_i
    while IFS= read -r changed_file; do
      [[ -n "$changed_file" ]] || continue
      # Emit parents BEFORE children (root → leaf): agent-file convention is
      # that deeper files override shallower ones, and prompt recency weights
      # later content — so the more-specific file must appear last. Collect
      # the ancestor chain walking up, then emit it in reverse.
      local -a agents_chain=()
      dir="$(dirname "$changed_file")"
      while [[ "$dir" != "." && "$dir" != "/" ]]; do
        agents_chain+=("$dir/AGENTS.md")
        dir="$(dirname "$dir")"
      done
      for ((chain_i = ${#agents_chain[@]} - 1; chain_i >= 0; chain_i--)); do
        emit_instruction_file "${agents_chain[$chain_i]}"
      done
    done <<< "$REVIEW_CHANGED_FILES"
  fi
}

# --- Prompt construction (review mode) ----------------------------------------

build_review_prompt() {
  local diff_cmd="git diff $REVIEW_RANGE"

  # Read the schema from the sibling schemas/ directory
  local schema_file="$SCRIPT_DIR/../schemas/review-finding-prompt.md"
  local schema
  if [[ -f "$schema_file" ]]; then
    # Replace placeholder tokens with runtime values
    schema=$(sed "s/external-TARGET/external-${TARGET_CLI}/g; s/ISO_8601/$(date -u +%Y-%m-%dT%H:%M:%SZ)/g" "$schema_file")
  else
    echo "Error: schema file not found: $schema_file" >&2
    exit 1
  fi

  local instructions
  instructions="$(collect_review_instructions)"

  cat <<PROMPT
You are a code reviewer providing a cross-model second opinion, standing in for a holistic GitHub review bot. Find real problems in the code changes.

Review scope (derived from the worktree by the calling wrapper — this is authoritative; do not ask for scope):
- Branch: ${REVIEW_BRANCH:-unknown}
- Diff range: $REVIEW_RANGE
- Diffstat: ${REVIEW_DIFFSTAT:-n/a}
- Changed files:
$REVIEW_CHANGED_FILES

Run this command to see the changes:
  $diff_cmd

Then read changed files that need more context to understand the diff.

Review the diff through ALL of these lenses — every lens is in scope and none may be skipped:
- Correctness: bugs, logic errors, race conditions and concurrency issues, resource leaks, error-handling gaps (silent failures, swallowed errors), API contract violations, performance problems in hot paths.
- Security and fail-open behavior: injection, auth bypass, data exposure; error paths that silently skip, weaken, or default-pass a check instead of failing loudly.
- Adversarial inputs: hostile or edge-case inputs — empty or oversized values, filenames containing newlines or glob characters, encoding tricks — that bypass validation, filters, or glob patterns.
- Portability: Bash 3.2 compatibility (macOS system bash — no associative arrays, no \${var^^}), GNU vs BSD tool differences, platform-specific assumptions.
- Repo-rule adherence: violations of the repository instruction files included below, when present.
- Docs-vs-code drift: documentation, comments, help text, or examples that this diff makes stale or contradicts.
- Test adequacy: changed behavior with no covering test, tests that can no longer fail, missing edge-case coverage for the classes above.

Skip only pure style/formatting preferences and minor naming opinions.
PROMPT

  if [[ -n "$instructions" ]]; then
    cat <<PROMPT

Repository review instructions — these files define this repo's own review rules; report violations under the repo-rule adherence lens:

$instructions
PROMPT
  fi

  printf '\n%s\n' "$schema"
}

# --- Read prompt (challenge/audit/quick modes) --------------------------------

read_prompt() {
  if [[ -n "$PROMPT_FILE" ]]; then
    [[ -f "$PROMPT_FILE" ]] || { echo "Error: prompt file not found: $PROMPT_FILE" >&2; exit 1; }
    cat "$PROMPT_FILE"
  elif [[ -n "$INLINE_PROMPT" ]]; then
    printf '%s\n' "$INLINE_PROMPT"
  elif [[ ! -t 0 ]]; then
    cat
  else
    echo "Error: $MODE mode requires --prompt <file>, inline text, or piped stdin" >&2
    exit 1
  fi
}

# --- Multi-lane review orchestration ------------------------------------------
# VST-124: with no forced target, review mode runs every available lane on the
# SAME derived scope (in parallel — GH bots run concurrently too) and unions
# their findings, deduplicated by normalized location (file + backticked
# symbol; the schema forbids line numbers). Each lane is a recursive
# single-target invocation of this script, so every lane keeps the full
# single-lane contract: scope embedding, one-shot retry, no-review/incomplete
# gates, and its own sidecar family under <output>.<target>.json*.
#
# Failure semantics: one failed lane must not fail the run (a quota-capped lane
# would block every review) but must never narrow coverage silently either —
# the failed lane and its exit code are recorded in qa_metadata.lanes and
# coverage becomes "degraded". When EVERY lane fails there is no external
# verdict, so the run joins the no-verdict class: exit 4 when at least one lane
# answered unusably (its own exit 4), else exit 5.
if $MULTI_LANE; then
  # Derive scope once, up front: exits 3 before any lane spawns when the diff
  # is empty, and pins the SAME resolved range for every lane.
  derive_review_scope "$CWD" "$RANGE"

  # Lane scratch has one owner and one rule (VST-221): LANE_TMP_DIR is the only
  # directory this run creates, and it holds nothing but the per-lane stderr
  # captures — so removing it, by the cleanup below at exit or by an outsider
  # mid-run, can only ever cost a log replay. A lane's REVIEW is never in it:
  # with --output it is the durable sibling <output>.<lane>.json, without one it
  # is a plain temp file this parent creates and removes, on the same footing as
  # every other mktemp file here. And the parent holds each lane's review in
  # memory from the moment that lane is reaped, so nothing it still needs is on
  # disk after the reap either.
  LANE_TMP_DIR=$(mktemp -d)
  LANE_TMP_FILES=()
  LANE_PIDS=()
  # On any exit — including INT/TERM — kill still-running lane children before
  # cleanup: an interrupted parent must not leave external model CLIs running
  # (and billing) in the background, writing orphaned sidecars.
  cleanup_lanes() {
    local pid art
    for pid in ${LANE_PIDS[@]+"${LANE_PIDS[@]}"}; do
      kill "$pid" 2>/dev/null || true
    done
    if [[ ${#LANE_PIDS[@]} -gt 0 ]]; then
      wait ${LANE_PIDS[@]+"${LANE_PIDS[@]}"} 2>/dev/null || true
    fi
    # Never let cleanup decide the run's exit status: rm still fails on an
    # entry it cannot unlink (something under a directory the run cannot write,
    # a foreign-owned file in a sticky /tmp), and inside this EXIT trap that
    # failure would both override a delivered two-lane union with a non-zero
    # status and skip everything below it. Every command in this trap is
    # guarded for that reason.
    rm -rf "$LANE_TMP_DIR" || true
    # Stdout-mode lane artifacts plus each child's own sidecar family
    # (<art>.noreview.json, <art>.raw.txt, …): the mktemp name makes the glob
    # unambiguous, and a glob that matches nothing is a no-op for rm -f.
    for art in ${LANE_TMP_FILES[@]+"${LANE_TMP_FILES[@]}"}; do
      rm -f "$art" "$art".* || true
    done
  }
  trap 'cleanup_lanes' EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM

  # This run promises "no artifact when every lane fails" — a union artifact
  # left by a PREVIOUS run at the same path would read as a fresh pass to a
  # caller that continues past the advisory failure. Clear it before lanes
  # spawn.
  # --output is caller input and may begin with '-', which every one of these
  # utilities would parse as options: `--` marks the end of options, and
  # path_dir stands in for dirname, which cannot take that marker portably.
  if [[ -n "$OUTPUT_PATH" ]]; then
    mkdir -p -- "$(path_dir "$OUTPUT_PATH")"
    rm -f -- "$OUTPUT_PATH"
  fi

  SELF="$SCRIPT_DIR/$(basename -- "${BASH_SOURCE[0]}")"
  LANE_OUTS=()
  LANE_ERRS=()
  # Lane children write their sidecar families (.raw.txt, .retry.txt,
  # .noreview.json, .failed.json) beside the artifact path they are handed,
  # with plain `printf > path`, so they carry the ambient umask — and in stdout
  # mode that path is in the TMPDIR root, where 0644 leaves the model's raw
  # review of the reviewed repository readable by every local user for the life
  # of the run. Spawn the children owner-only; restored before the union write
  # so the caller's own --output artifact keeps the caller's umask.
  LANE_UMASK_PREV=$(umask)
  umask 077
  for lane in "${REVIEW_LANES[@]}"; do
    if [[ -n "$OUTPUT_PATH" ]]; then
      lane_out="${OUTPUT_PATH}.${lane}.json"
      # Same policy as the stale union artifact above, applied to this lane's
      # family: a previous run's lane artifact is misleading whether or not
      # this run overwrites it, and the umask only governs files the child
      # CREATES — writing through a surviving inode keeps that inode's old
      # mode, so a family left at 0644 would stay world-readable through every
      # later run. Unremovable here means the artifact family cannot be
      # guaranteed clean, which is worth failing on before any model spend.
      #
      # Every suffix the recursive writer can produce, enumerated rather than
      # globbed: this path is the CALLER's, so `"$lane_out".*` would also take
      # anything else of theirs that happens to sit under this prefix. (The
      # same glob in cleanup_lanes is safe because it runs on a random mktemp
      # name that cannot collide with a caller's file.) Keep in step with
      # preserve_cli_failure_and_fail, preserve_raw_and_fail and
      # preserve_no_review_and_fail, the only writers of these sidecars.
      rm -f -- "$lane_out" \
        "$lane_out.raw.txt" "$lane_out.retry.txt" "$lane_out.failed.json" \
        "$lane_out.noreview.json" "$lane_out.incomplete.json"
    else
      lane_out=$(mktemp)
      LANE_TMP_FILES+=("$lane_out")
    fi
    lane_err="$LANE_TMP_DIR/lane-${lane}.stderr"
    # The capture exists only so the lane's log can be replayed, so it must
    # never be able to stop the lane from running. A redirection named on the
    # launch itself is performed by the forked child BEFORE the command runs:
    # if the scratch directory has gone by then — the same actor this whole
    # change is about, and every lane after the first is exposed for as long as
    # the fan-out takes — the child dies without ever reviewing, and scratch
    # loss costs a VERDICT rather than a log.
    #
    # So the lane opens the capture itself, in its own process, with a fallback
    # that cannot fail, and hands the result to the review as an already-open
    # descriptor: duplicating an open fd cannot fail no matter what happens to
    # the directory afterwards. fd 4 parks the real stderr for the duration of
    # the attempt so bash's own open error does not reach the operator
    # unattributed; the loss is reported in the same shape as the other capture
    # losses instead.
    (
      exec 4>&2 2>/dev/null
      if exec 3>"$lane_err"; then
        exec 2>&4 4>&-
      else
        exec 3>/dev/null 2>&4 4>&-
        echo "→ lane stderr capture could not be opened — log replay lost: $lane" >&2
      fi
      exec "$SELF" review --target "$lane" --range "$REVIEW_RANGE" --cwd "$CWD" \
        --timeout "$TIMEOUT" --output "$lane_out" >/dev/null 2>&3 3>&-
    ) &
    LANE_PIDS+=($!)
    LANE_OUTS+=("$lane_out")
    LANE_ERRS+=("$lane_err")
  done
  umask "$LANE_UMASK_PREV"

  # Gate every lane artifact on the shape the union merge actually consumes.
  # A zero exit and a parse are not enough: the merge adds `{source: …}` to
  # each finding, iterates questions, lowercases locations and concatenates
  # summaries, so a top-level-complete artifact carrying `blockers: ["bad"]`
  # parses fine and then aborts the merge under `set -e` — no union at all,
  # even though the other lane returned a perfectly good review. Rejecting it
  # here keeps that lane's failure local (exit 4, coverage degraded) and lets
  # the healthy lanes publish. Slurped, so a stream of several JSON values is
  # refused too rather than smuggling extra lanes into the merge.
  LANE_WRAP_JQ='
    def bad(m): error("invalid review artifact: " + m);
    def check(k):
      if (.[k] | type) != "array" then bad(k + " is not an array")
      elif any(.[k][]; type != "object") then bad(k + " holds a non-object entry")
      elif any(.[k][]; .location != null and (.location | type) != "string")
        then bad(k + " holds a non-string location")
      else . end;
    if length == 0 then bad("artifact holds no JSON value at all")
    elif length > 1 then bad("artifact holds " + (length | tostring) + " JSON values, expected one")
    else .[0] end
    | if type != "object" then bad("artifact is not a JSON object")
      elif (.questions | type) != "array" then bad("questions is not an array")
      elif .summary != null and (.summary | type) != "string" then bad("summary is not a string")
      else check("blockers") | check("suggestions") end
    | {target: $target, review: .}'

  LANES_FAILED_JSON="[]"
  LANE_WRAPS=()
  ANY_LANE_EXIT4=false
  for i in "${!LANE_PIDS[@]}"; do
    lane="${REVIEW_LANES[$i]}"
    lane_rc=0
    wait "${LANE_PIDS[$i]}" || lane_rc=$?
    # Replay the lane's stderr with a lane prefix so parallel logs stay
    # attributable in sequential order. The stderr capture is scratch: when it
    # is gone (VST-221 — the reviewed repo's own agent CLI, a sandbox, or a tmp
    # reaper can clear scratch while lanes run) the log is lost and nothing
    # else is. Branch on the read ITSELF rather than a prior -r test: a capture
    # removed between the test and the read would otherwise emit the bare
    # "can't read" error this branch exists to replace. The one message covers
    # removal before and during the read, states the observed condition instead
    # of an inferred cause, and never colours the lane's own verdict.
    #
    # Redirection order below is load-bearing: fd1 must be duplicated from the
    # REAL stderr BEFORE fd2 is silenced. Written the other way round
    # (2>/dev/null first) `>&2` dupes fd1 from the already-silenced fd2 and the
    # whole replay — an operator's only view of a lane's cause text, and how
    # exit 5 is diagnosed — goes to /dev/null on the success path, where no
    # verdict assertion would ever notice. The `jq … 2>&1 >/dev/null` capture
    # further down wants the opposite order and is correct as written.
    if ! sed "s/^/[${lane}] /" "${LANE_ERRS[$i]}" >&2 2>/dev/null; then
      echo "→ lane stderr replay unavailable (scratch capture unreadable): $lane" >&2
    fi
    lane_ok=false
    # Read the artifact ONCE, into memory (VST-221). Everything downstream —
    # the wrap, and the cause reported when the wrap is refused — works on
    # those same bytes, so a test-then-read pair can no longer straddle the
    # mid-run clearing this fix is about, and the reported cause is always the
    # one that actually rejected the lane rather than whatever a later re-read
    # happens to find (an artifact removed a moment after being rejected as
    # malformed would otherwise be explained as "No such file or directory").
    # Which failure class a lane lands in is decided by what it WROTE, so the
    # test is the artifact's size on disk. A shell string cannot stand in for
    # that: command substitution cannot hold NUL bytes, so an artifact holding
    # only a NUL would read back as the empty string and be called
    # never-answered even though the lane did produce a byte — and the contract
    # is that the line between the classes is whether any bytes exist at all.
    # Testing before reading cannot revive the older hazard: an artifact that
    # vanishes between the two lands in answered-unusably, because the gate
    # then has nothing to parse, and never in never-answered.
    lane_raw=""
    if [[ $lane_rc -eq 0 && -s "${LANE_OUTS[$i]}" ]]; then
      # Read through a redirection, not a path operand: the lane artifact's
      # name carries the caller's --output value, which may begin with '-' and
      # would otherwise be parsed as options — the lane would then look like it
      # exited 0 having produced nothing. A redirection has no such parsing,
      # and needs no `--` marker to be portable. The sentinel keeps the gate's
      # input faithful to the file, which command substitution would otherwise
      # shorten by every trailing newline.
      #
      # NUL is translated rather than read, because a shell string is the one
      # thing that cannot carry it: bash drops NUL bytes from a command
      # substitution, so an artifact jq refuses on disk — valid JSON with a NUL
      # appended, say — would reach the gate as the clean prefix and be counted
      # a healthy lane, coverage reading "full" over bytes no reader would
      # accept. 0x01 stands in for it because jq refuses every control
      # character below 0x20 in exactly the positions it refuses NUL, bare or
      # inside a string, so the gate's verdict is the verdict it would reach on
      # the file itself. The group's stderr goes nowhere because the only
      # writer to it is tr, already silenced.
      #
      # A failed read is poisoned with that same byte rather than checked: the
      # sentinel makes `printf X` the last command, so the substitution's own
      # status is always 0 and tr's is unrecoverable from it. Without the
      # poison a read that died partway — the file unlinked under it, or an I/O
      # error — would hand the gate a prefix that can parse clean on its own,
      # and an artifact nobody managed to read would be merged as a healthy
      # lane. Appending the byte makes the truncation something jq refuses, so
      # a read that did not finish can only ever land in answered-unusably.
      { lane_raw=$(tr '\000' '\001' 2>/dev/null < "${LANE_OUTS[$i]}" || printf '\001'; printf X); } 2>/dev/null
      lane_raw="${lane_raw%X}"
      # A zero exit and readable content are not proof of a usable artifact —
      # it must survive LANE_WRAP_JQ, or one bad lane takes the whole merge
      # down with it. The wrapped review is held IN MEMORY from here on: the
      # union merge must not depend on a scratch file surviving between this
      # reap and the final write, or losing scratch would report healthy lanes
      # as unusable and drop a verdict both models actually delivered.
      #
      # The wrap must also be NON-EMPTY: jq exits 0 printing nothing for input
      # that holds no JSON value at all, which would push an empty element into
      # the merge — a lane counted as healthy that contributes no findings,
      # dropping a real blocker while coverage still reads "full".
      if lane_wrap=$(printf '%s\n' "$lane_raw" | jq -c -s --arg target "$lane" "$LANE_WRAP_JQ" 2>/dev/null) \
         && [[ -n "$lane_wrap" ]]; then
        LANE_WRAPS+=("$lane_wrap")
        lane_ok=true
      else
        # Say WHY it is unusable — jq's own message names a truncated artifact,
        # a malformed one, or the shape the merge could not have consumed. In
        # stdout mode the artifact is gone at exit, so this line is the only
        # evidence left. `2>&1 >/dev/null` is the opposite order from the sed
        # replay above on purpose: here fd2 must reach the pipe before fd1 is
        # discarded.
        lane_reason=$(printf '%s\n' "$lane_raw" | jq -s --arg target "$lane" "$LANE_WRAP_JQ" 2>&1 >/dev/null | head -1) || true
        [[ -n "$lane_reason" ]] || lane_reason="no JSON value in artifact"
        echo "→ lane produced an unusable artifact: $lane ($lane_reason)" >&2
        lane_rc="$EXIT_NO_REVIEW"
      fi
    elif [[ $lane_rc -eq 0 ]]; then
      # Clean exit, nothing usable on disk: the lane never delivered an answer.
      # That is the lane-level class (5), not the response-level one (4) — and
      # it must never be reported as the child's bare "exit 0", which reads as
      # a lane that both succeeded and failed.
      echo "→ lane exited 0 without a usable artifact: $lane" >&2
      lane_rc="$EXIT_CLI_FAILED"
    fi
    if ! $lane_ok; then
      # Exit-code contract: 4 = the lane ANSWERED but unusably. A lane's own
      # exit 1 after the availability check is a response-level defect too
      # (invalid JSON even after the retry exits 1) — only never-answered
      # classes (5, 124) leave ANY_LANE_EXIT4 unset.
      [[ $lane_rc -eq "$EXIT_NO_REVIEW" || $lane_rc -eq 1 ]] && ANY_LANE_EXIT4=true
      echo "→ lane failed: $lane (exit $lane_rc)" >&2
      LANES_FAILED_JSON=$(jq -n --argjson prev "$LANES_FAILED_JSON" \
        --arg target "$lane" --argjson code "$lane_rc" \
        '$prev + [{target: $target, status: "failed", exit_code: $code}]')
    fi
  done

  if [[ ${#LANE_WRAPS[@]} -eq 0 ]]; then
    jq -n --argjson lanes "$LANES_FAILED_JSON" \
      '{error: "every review lane failed — no external verdict", lanes: $lanes}' >&2
    if $ANY_LANE_EXIT4; then exit "$EXIT_NO_REVIEW"; else exit "$EXIT_CLI_FAILED"; fi
  fi

  # Union merge. Dedupe key: normalized location (lowercased, backticks and
  # whitespace runs collapsed) PLUS the finding's occurrence index among
  # same-location findings within its own lane — so one lane reporting two
  # distinct bugs at a location keeps both (they get #0/#1), while the same
  # bug reported by two lanes (each lane's #0) still merges. A finding with an
  # empty location never deduplicates (its key is made unique by input
  # position). Duplicates collapse to the first of each group with all
  # contributing lanes listed in `sources`; a suggestion is dropped only when
  # a blocker holds its exact key (the stricter class wins for the same slot).
  # reviewed_head is the scope-derivation pin, for per-push budget accounting.
  STAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  REVIEWED_HEAD="$REVIEW_HEAD_SHA"
  MERGED=$(printf '%s\n' "${LANE_WRAPS[@]}" | jq -s --argjson failed "$LANES_FAILED_JSON" --arg ts "$STAMP" --arg head "$REVIEWED_HEAD" '
    def norm: ((.location // "") | ascii_downcase | gsub("`"; "") | gsub("\\s+"; " ") | ltrimstr(" ") | rtrimstr(" "));
    def with_occ: reduce .[] as $f ({seen: {}, out: []};
      ($f | norm) as $n
      | (.seen[$n] // 0) as $c
      | {seen: (.seen + {($n): ($c + 1)}), out: (.out + [$f + {_occ: $c}])})
      | .out;
    def keyed: to_entries | map(.value + {_k: ((.value | norm) as $l
      | if $l == "" then "__nokey_" + (.key | tostring)
        else $l + "#" + ((.value._occ // 0) | tostring) end)});
    def collapse: group_by(._k) | map(.[0] + {sources: (map(.source) | unique)});
    . as $lanes
    | ($lanes | map(.target)) as $targets
    | ([ $lanes[] | .target as $t | (.review.blockers    | map(. + {source: $t}) | with_occ)[] ] | keyed) as $abk
    | ([ $lanes[] | .target as $t | (.review.suggestions | map(. + {source: $t}) | with_occ)[] ] | keyed) as $ask
    | ($abk | collapse) as $bk
    | ($bk | map(._k)) as $bkeys
    | ($ask | map(select(._k as $k | ($bkeys | index($k)) == null)) | collapse) as $sk
    | ($bk | map(del(._k, ._occ, .source)) | to_entries | map(.value + {id: (.key + 1)})) as $blockers
    | ($sk | map(del(._k, ._occ, .source)) | to_entries | map(.value + {id: (.key + 1)})) as $suggestions
    | {
        agent: ("external-union(" + ($targets | join("+")) + ")"),
        timestamp: $ts,
        verdict: (if ($blockers | length) > 0 then "action_required" else "pass" end),
        summary: ("Union of " + ($lanes | length | tostring) + " lane reviews ("
                  + ($targets | join(", ")) + "): "
                  + ($lanes | map(.target + ": " + (.review.summary // "")) | join(" | "))),
        blockers: $blockers,
        suggestions: $suggestions,
        questions: ([ $lanes[] | .review.questions[] ] | unique),
        qa_metadata: ({
          union: true,
          coverage: (if ($failed | length) > 0 then "degraded" else "full" end),
          lanes: (($lanes | map({target: .target, status: "ok",
                                 agent: (.review.agent // ("external-" + .target)),
                                 verdict: .review.verdict,
                                 blockers: (.review.blockers | length),
                                 suggestions: (.review.suggestions | length)}))
                  + $failed),
          dedupe: {blockers_in: ($abk | length), blockers_out: ($blockers | length),
                   suggestions_in: ($ask | length), suggestions_out: ($suggestions | length)}
        } + (if $head == "" then {} else {reviewed_head: $head} end))
      }
  ')

  if [[ -n "$OUTPUT_PATH" ]]; then
    printf '%s\n' "$MERGED" > "$OUTPUT_PATH"
    # Count what the artifact CARRIES, not what went into the merge: a count
    # taken from the input array describes the artifact without being bound to
    # it, and the two can disagree without either being wrong on its own terms.
    # A re-query that fails says so, with jq's message: the merge just produced
    # this JSON, so a shape it cannot read back is an internal inconsistency,
    # and a bare "?" would hide the only evidence of it.
    if union_lanes=$(printf '%s\n' "$MERGED" | jq '[.qa_metadata.lanes[] | select(.status == "ok")] | length' 2>&1); then
      echo "→ Written: $OUTPUT_PATH (union of $union_lanes lanes)" >&2
    else
      echo "→ Written: $OUTPUT_PATH (lane count unavailable: $union_lanes)" >&2
    fi
    echo "$OUTPUT_PATH"
  else
    printf '%s\n' "$MERGED"
  fi
  exit 0
fi

# --- Build final prompt -------------------------------------------------------

PROMPT=""
case "$MODE" in
  review)
    # Derive scope at top level (not in the $() subshell) so its exit
    # EXIT_NO_SCOPE aborts the run instead of being captured.
    derive_review_scope "$CWD" "$RANGE"
    PROMPT=$(build_review_prompt)
    ;;
  challenge) PROMPT=$(read_prompt) ;;
  audit)     PROMPT=$(read_prompt) ;;
  quick)     PROMPT=$(read_prompt) ;;
esac

# Guard: empty prompt (stdin was closed with no data)
if [[ -z "$PROMPT" ]]; then
  echo "Error: empty prompt — provide --prompt <file> or pipe content via stdin" >&2
  exit 1
fi

# Write prompt to temp file — use printf to avoid echo interpreting leading dashes
PROMPT_TMP=$(mktemp)
trap 'rm -f "$PROMPT_TMP"' EXIT
printf '%s\n' "$PROMPT" > "$PROMPT_TMP"

STDERR_TMP=$(mktemp)
# RETRY_PROMPT_TMP is created only when extraction fails and a retry runs; keep
# it in the cleanup trap. Sidecar files written by preserve_raw_response and
# preserve_raw_and_fail are deliberately NOT tracked here — they are the durable
# record of a lost or reformatted response.
RETRY_PROMPT_TMP=""
trap 'rm -f "$PROMPT_TMP" "$STDERR_TMP" "$RETRY_PROMPT_TMP"' EXIT

# --- Invoke external CLI ------------------------------------------------------

RESULT=""
EXIT_CODE=0

# Invoke the resolved target CLI with a prompt file on stdin. The command line
# comes from target_cmd (env override or built-in default). Echoes the CLI's
# stdout on our stdout and returns its exit code (124 on timeout). Reused for
# the retry on JSON-extraction failure, so it stays side-effect-free beyond
# writing the CLI's stderr to STDERR_TMP.
run_target_cli() {
  local prompt_file="$1"
  local rc=0 cmd
  cmd="$(target_cmd "$TARGET_CLI")"
  if [[ -z "$cmd" ]]; then
    echo "{\"error\": \"Unknown target: $TARGET_CLI — set $(target_cmd_var "$TARGET_CLI")\"}" >&2
    return 2
  fi
  echo "→ cmd: timeout ${TIMEOUT}s $cmd" >&2
  # shellcheck disable=SC2086
  (cd "$CWD" && timeout "$TIMEOUT" $cmd < "$prompt_file" 2>"$STDERR_TMP") || rc=$?
  return "$rc"
}

# vstack#809: a failed external-CLI invocation on the primary call — non-zero
# exit (quota/auth/network), timeout, or a zero exit that returned nothing
# usable — produces no external verdict, exactly like the no-scope/no-review
# gates. Left as a bare exit-0 it fails invisibly precisely when the lane is
# down, so it must join the no-verdict class: preserve whatever partial output
# exists as <output>.failed.json (mirroring the .noreview/.incomplete sidecars),
# emit an error JSON on stderr that carries the sidecar path AND the CLI's own
# error text (so an operator sees "usage limit", not a bare code), then exit
# EXIT_CLI_FAILED. Only review/audit modes carry the no-verdict contract, so
# only they call this; challenge/quick keep the generic exit 1. Independent of
# TARGET_CLI — both lanes route through run_target_cli and STDERR_TMP.
preserve_cli_failure_and_fail() {
  local reason="$1"          # human-readable cause (e.g. "exited with code 2")
  local partial="${2:-}"     # captured stdout, may be empty
  local sidecar cause="" cause_source=""

  # The CLI's own stderr is the authoritative cause (e.g. the quota message).
  # Some CLIs report the failure on stdout with an empty stderr — the Claude
  # quota-limit message is the concrete case — which left the cause block empty
  # and made a capped lane read as broken. Fall back to the tail of captured
  # stdout so the reason surfaces whichever stream carried it.
  if [[ -s "$STDERR_TMP" ]]; then
    cause=$(head -20 "$STDERR_TMP")
    cause_source="${TARGET_CLI} stderr"
  elif [[ -n "$partial" ]]; then
    cause=$(printf '%s\n' "$partial" | tail -20)
    cause_source="${TARGET_CLI} stdout"
  fi

  if [[ -n "$OUTPUT_PATH" ]]; then
    mkdir -p -- "$(path_dir "$OUTPUT_PATH")"
    sidecar="${OUTPUT_PATH}.failed.json"
  else
    sidecar=$(mktemp)
  fi
  jq -n --arg target "$TARGET_CLI" --arg reason "$reason" \
        --arg cause "$cause" --arg cause_source "$cause_source" --arg stdout "$partial" \
    '{error: "external CLI failed before producing a review", target: $target, reason: $reason, cause: $cause, cause_source: $cause_source, partial_stdout: $stdout}' \
    > "$sidecar"

  jq -n --arg target "$TARGET_CLI" --arg reason "$reason" --arg sidecar "$sidecar" \
    '{error: "\($target) \($reason) — refusing to write a review artifact", response: $sidecar}' >&2
  echo "→ external CLI failed: $TARGET_CLI $reason" >&2
  if [[ -n "$cause" ]]; then
    echo "--- cause (${cause_source}) ---" >&2
    printf '%s\n' "$cause" >&2
  fi
  echo "→ failed invocation preserved: $sidecar" >&2
  exit "$EXIT_CLI_FAILED"
}

# review/audit carry the no-verdict contract (exits 3/4/5); challenge/quick do not.
REVIEW_LIKE=false
[[ "$MODE" == "review" || "$MODE" == "audit" ]] && REVIEW_LIKE=true

RESULT=$(run_target_cli "$PROMPT_TMP") || EXIT_CODE=$?

if [[ $EXIT_CODE -eq 124 ]]; then
  $REVIEW_LIKE && preserve_cli_failure_and_fail "timed out after ${TIMEOUT}s" "$RESULT"
  echo "{\"error\": \"Timeout after ${TIMEOUT}s\", \"target\": \"$TARGET_CLI\"}" >&2
  exit 1
elif [[ $EXIT_CODE -ne 0 ]]; then
  $REVIEW_LIKE && preserve_cli_failure_and_fail "exited with code $EXIT_CODE" "$RESULT"
  echo "{\"error\": \"$TARGET_CLI exited with code $EXIT_CODE\", \"target\": \"$TARGET_CLI\"}" >&2
  if [[ -s "$STDERR_TMP" ]]; then
    echo "--- stderr ---" >&2
    head -20 "$STDERR_TMP" >&2
  fi
  exit 1
fi

echo "→ Response received (${#RESULT} bytes)" >&2

if [[ ${#RESULT} -eq 0 ]]; then
  $REVIEW_LIKE && preserve_cli_failure_and_fail "returned an empty response on a zero exit — check CLI auth and configuration" ""
  echo "{\"error\": \"$TARGET_CLI returned empty response — check CLI auth and configuration\", \"target\": \"$TARGET_CLI\"}" >&2
  if [[ -s "$STDERR_TMP" ]]; then
    echo "--- stderr ---" >&2
    head -20 "$STDERR_TMP" >&2
  fi
  exit 1
fi

# --- Extract JSON (review/audit modes) ----------------------------------------

extract_json() {
  local input="$1"

  # Whole output is valid JSON
  if printf '%s' "$input" | jq -e . >/dev/null 2>&1; then
    printf '%s' "$input" | jq .
    return 0
  fi

  # Extract from first ```json ... ``` code fence (stop at first closing fence)
  local fenced
  fenced=$(printf '%s' "$input" | sed -n '/^```json/{n; :a; /^```$/q; p; n; ba}')
  if [[ -n "$fenced" ]] && printf '%s' "$fenced" | jq -e . >/dev/null 2>&1; then
    printf '%s' "$fenced" | jq .
    return 0
  fi

  # Extract from first ``` ... ``` fence (no language tag)
  fenced=$(printf '%s' "$input" | sed -n '/^```$/{n; :a; /^```$/q; p; n; ba}')
  if [[ -n "$fenced" ]] && printf '%s' "$fenced" | jq -e . >/dev/null 2>&1; then
    printf '%s' "$fenced" | jq .
    return 0
  fi

  # Last resort: extract from first { to last } (trim trailing prose)
  local from_brace
  from_brace=$(printf '%s' "$input" | sed -n '/^{/,$ p')
  if [[ -n "$from_brace" ]]; then
    # Single-line JSON (common): try first line alone
    local first_line
    first_line=$(printf '%s\n' "$from_brace" | head -1)
    if printf '%s' "$first_line" | jq -e . >/dev/null 2>&1; then
      printf '%s' "$first_line" | jq .
      return 0
    fi
    # Multiline JSON: truncate at last line starting with }
    local last_brace_line trimmed
    last_brace_line=$(printf '%s\n' "$from_brace" | grep -n '^}' | tail -1 | cut -d: -f1)
    if [[ -n "$last_brace_line" ]]; then
      trimmed=$(printf '%s\n' "$from_brace" | head -n "$last_brace_line")
      if printf '%s' "$trimmed" | jq -e . >/dev/null 2>&1; then
        printf '%s' "$trimmed" | jq .
        return 0
      fi
    fi
  fi

  return 1
}

# --- Retry + raw-preservation helpers (review/audit) --------------------------

# Build the follow-up prompt for the one-shot retry: the FULL original request,
# the raw first response, and the canonical JSON schema with an instruction to
# serialize now. The retry runs in a fresh session (--no-session-persistence /
# --ephemeral), so it must carry the complete original prompt — scope block
# included — or the model has nothing to review and can only produce a
# context-free verdict (vstack#672). The schema file is the shared source of
# the JSON structure for both review and audit, so re-reading it here works
# regardless of which mode produced the first response. The optional second
# arg names the defect in the first response (default: no parseable JSON) so
# an incomplete-schema retry (vstack#678) tells the model exactly what was
# missing instead of claiming the JSON did not parse.
build_retry_prompt() {
  local raw="$1"
  local problem="${2:-did not contain a parseable JSON object}"
  local schema_file="$SCRIPT_DIR/../schemas/review-finding-prompt.md"
  local schema=""
  if [[ -f "$schema_file" ]]; then
    schema=$(sed "s/external-TARGET/external-${TARGET_CLI}/g; s/ISO_8601/$(date -u +%Y-%m-%dT%H:%M:%SZ)/g" "$schema_file")
  fi
  cat <<RETRY
Your previous response to the request below ${problem}. This is a single fresh session with no prior turns and no session history — there is no earlier message and nothing was "delivered above" or "previously". Complete the request below and output the COMPLETE JSON object in THIS response. If your previous response already contains your findings, serialize them without changing them; otherwise perform the request now using the scope it specifies. Output ONLY the JSON object — no prose before or after.

--- Original request ---
${PROMPT}
--- End of original request ---

--- Your previous response ---
${raw}
--- End of your previous response ---

Emit exactly this JSON structure:
${schema}
RETRY
}

# vstack#940: persist the raw first response the moment a retry is attempted —
# BEFORE the retry outcome is known. A successful reformat retry replaces
# RESULT wholesale, so without this sidecar the only record of what the model
# actually said is discarded exactly when the retry "succeeds", making a
# dropped/softened/merged finding unauditable. Sets RAW_PRESERVED_PATH;
# preserve_raw_and_fail reuses it so the both-failed path never duplicates the
# content.
RAW_PRESERVED_PATH=""
preserve_raw_response() {
  local raw="$1"
  if [[ -n "$OUTPUT_PATH" ]]; then
    mkdir -p -- "$(path_dir "$OUTPUT_PATH")"
    RAW_PRESERVED_PATH="${OUTPUT_PATH}.raw.txt"
  else
    RAW_PRESERVED_PATH=$(mktemp)
  fi
  printf '%s\n' "$raw" > "$RAW_PRESERVED_PATH"
}

# Persist the raw (and optional retry) response so a lost review is auditable,
# emit an error JSON that carries the sidecar path(s), then exit 1.
preserve_raw_and_fail() {
  local raw="$1"
  local retry="${2:-}"
  local raw_path retry_path=""

  # The raw first response was already written when the retry was attempted
  # (vstack#940) — reuse that sidecar instead of writing it a second time.
  if [[ -n "$RAW_PRESERVED_PATH" ]]; then
    raw_path="$RAW_PRESERVED_PATH"
  elif [[ -n "$OUTPUT_PATH" ]]; then
    mkdir -p -- "$(path_dir "$OUTPUT_PATH")"
    raw_path="${OUTPUT_PATH}.raw.txt"
    printf '%s\n' "$raw" > "$raw_path"
  else
    raw_path=$(mktemp)
    printf '%s\n' "$raw" > "$raw_path"
  fi
  if [[ -n "$retry" ]]; then
    if [[ -n "$OUTPUT_PATH" ]]; then
      retry_path="${OUTPUT_PATH}.retry.txt"
    else
      retry_path=$(mktemp)
    fi
    printf '%s\n' "$retry" > "$retry_path"
  fi

  if [[ -n "$retry_path" ]]; then
    jq -n --arg target "$TARGET_CLI" --argjson len "${#raw}" \
      --arg rawpath "$raw_path" --arg retrypath "$retry_path" \
      '{error: "Failed to extract JSON from \($target) response after retry", raw_length: $len, raw_response: $rawpath, retry_response: $retrypath}' >&2
    echo "→ retry response preserved: $retry_path" >&2
  else
    jq -n --arg target "$TARGET_CLI" --argjson len "${#raw}" --arg rawpath "$raw_path" \
      '{error: "Failed to extract JSON from \($target) response after retry", raw_length: $len, raw_response: $rawpath}' >&2
  fi
  echo "→ raw response preserved: $raw_path" >&2
  echo "--- First 30 lines of raw response ---" >&2
  printf '%s\n' "$raw" | head -30 >&2
  exit 1
}

# --- No-review self-report gate (review/audit) --------------------------------
# vstack#652: a schema-valid response whose qa_metadata admits no review
# happened (review_performed=false or a no-scope/no-review reason) must never
# become the --output artifact, regardless of its verdict.

response_reports_no_review() {
  printf '%s' "$1" | jq -e '
    (.qa_metadata? // {}) as $qa
    | (($qa | type) == "object")
      and (($qa.review_performed == false)
           or ((($qa.reason // "") | tostring)
               | test("no[ _-]?(scope|review)|not[ _-]?reviewed"; "i")))
  ' >/dev/null 2>&1
}

# vstack#672: the schema REQUIRES a qa_metadata object ({} for a performed
# review), so a response with no qa_metadata key cannot attest that any review
# happened — non-conforming, structurally detected, no prose parsing. Catches
# in particular a retried response that dropped the field along with the rest
# of its context. (orch review-artifact-check stays tolerant of absent
# qa_metadata for internal reviewers; this gate is producer-side only.)
response_missing_qa_metadata() {
  ! printf '%s' "$1" | jq -e '(.qa_metadata? | type) == "object"' >/dev/null 2>&1
}

# vstack#678: extraction can yield truncated-but-valid JSON — verdict and
# summary survive while the finding arrays are silently dropped, so the
# artifact looks reviewable but the actual blockers/suggestions are lost. The
# schema requires verdict plus all three arrays (empty [] is fine), so anything
# less is structurally incomplete: an incomplete FIRST response goes through
# the one-shot retry (full original context, vstack#672); a still-incomplete
# retried response is rejected. qa_metadata is deliberately NOT part of this
# predicate — its absence rejects without a retry (vstack#672 contract).
response_incomplete_schema() {
  ! printf '%s' "$1" | jq -e '
    ((.verdict? | type) == "string")
    and ((.blockers? | type) == "array")
    and ((.suggestions? | type) == "array")
    and ((.questions? | type) == "array")
  ' >/dev/null 2>&1
}

# Persist the rejected response as a sidecar (durable record), emit an error
# JSON carrying its path, and exit EXIT_NO_REVIEW. OUTPUT_PATH itself is never
# written, so no pass artifact can exist for a review that did not verifiably
# happen. The optional second arg overrides the error message (default: the
# qa_metadata self-report); the optional third arg overrides the sidecar
# suffix (default "noreview" — "incomplete" for the vstack#678 schema gate).
preserve_no_review_and_fail() {
  local json="$1"
  local errmsg="${2:-}"
  local suffix="${3:-noreview}"
  local sidecar reason

  if [[ -z "$errmsg" ]]; then
    reason=$(printf '%s' "$json" | jq -r '.qa_metadata.reason? // "review_performed=false"' 2>/dev/null) || reason="review_performed=false"
    errmsg="self-reported that no review was performed ($reason)"
  fi

  if [[ -n "$OUTPUT_PATH" ]]; then
    mkdir -p -- "$(path_dir "$OUTPUT_PATH")"
    sidecar="${OUTPUT_PATH}.${suffix}.json"
  else
    sidecar=$(mktemp)
  fi
  printf '%s\n' "$json" > "$sidecar"

  jq -n --arg target "$TARGET_CLI" --arg errmsg "$errmsg" --arg sidecar "$sidecar" \
    '{error: "\($target) \($errmsg) — refusing to write a review artifact", response: $sidecar}' >&2
  echo "→ rejected response preserved: $sidecar" >&2
  exit "$EXIT_NO_REVIEW"
}

if [[ "$MODE" == "review" || "$MODE" == "audit" ]]; then
  # Two retryable defects in the first response share the one-shot retry: no
  # parseable JSON at all (vstack#509 — prose claiming the JSON was "already
  # delivered above", impossible with --no-session-persistence / --ephemeral),
  # and parseable-but-truncated JSON that lost the required finding arrays
  # (vstack#678). The retry resends the full original request (vstack#672), so
  # a truncated extraction gets one chance to re-serialize completely instead
  # of being written as a findings-less artifact.
  RETRY_WHY=""
  RETRY_PROBLEM=""
  # Byte counts of the raw responses, recorded into the artifact's qa_metadata
  # (vstack#940) so a reformat that shrank the review is visible in the
  # artifact itself. Measured on the untouched CLI output, before extraction.
  RAW_RESPONSE_BYTES=${#RESULT}
  RETRY_RESPONSE_BYTES=""
  if JSON=$(extract_json "$RESULT"); then
    if response_incomplete_schema "$JSON"; then
      RETRY_WHY="first response JSON is structurally incomplete"
      RETRY_PROBLEM="contained a JSON object that is missing required schema fields — verdict and the blockers, suggestions, and questions arrays are all mandatory (use [] for an empty array)"
    else
      RESULT="$JSON"
    fi
  else
    RETRY_WHY="extract_json failed on first response"
  fi

  if [[ -n "$RETRY_WHY" ]]; then
    echo "→ $RETRY_WHY; retrying once with captured response" >&2
    # Persist the raw first response now, before the retry outcome is known
    # (vstack#940) — a successful reformat must not erase the original.
    preserve_raw_response "$RESULT"
    RETRY_PROMPT_TMP=$(mktemp)
    if [[ -n "$RETRY_PROBLEM" ]]; then
      build_retry_prompt "$RESULT" "$RETRY_PROBLEM" > "$RETRY_PROMPT_TMP"
    else
      build_retry_prompt "$RESULT" > "$RETRY_PROMPT_TMP"
    fi

    RETRY_RESULT=""
    RETRY_EXIT=0
    RETRY_RESULT=$(run_target_cli "$RETRY_PROMPT_TMP") || RETRY_EXIT=$?
    RETRY_RESPONSE_BYTES=${#RETRY_RESULT}

    if [[ $RETRY_EXIT -eq 124 ]]; then
      echo "→ retry timed out after ${TIMEOUT}s" >&2
      preserve_raw_and_fail "$RESULT" "$RETRY_RESULT"
    elif [[ $RETRY_EXIT -ne 0 ]]; then
      echo "→ retry exited with code $RETRY_EXIT" >&2
      preserve_raw_and_fail "$RESULT" "$RETRY_RESULT"
    elif [[ ${#RETRY_RESULT} -eq 0 ]]; then
      echo "→ retry returned an empty response" >&2
      preserve_raw_and_fail "$RESULT" "$RETRY_RESULT"
    elif JSON=$(extract_json "$RETRY_RESULT"); then
      # Same completeness discipline on the retried response: a retry that is
      # still missing the required arrays must not become the artifact either
      # (vstack#678) — preserve it and fail with the distinct no-review code.
      if response_incomplete_schema "$JSON"; then
        echo "→ retry response JSON is still structurally incomplete" >&2
        preserve_no_review_and_fail "$JSON" \
          "returned structurally incomplete JSON after retry — verdict and the blockers/suggestions/questions arrays are required (incomplete_schema)" \
          incomplete
      fi
      echo "→ retry recovered valid JSON (${#JSON} bytes)" >&2
      echo "→ raw first response preserved: $RAW_PRESERVED_PATH" >&2
      RESULT="$JSON"
    else
      echo "→ retry response still not parseable" >&2
      preserve_raw_and_fail "$RESULT" "$RETRY_RESULT"
    fi
  fi

  # Reject a self-reported no-review before the artifact can be written — a
  # "pass" from a model that admits it reviewed nothing is a false pass. These
  # gates run on whichever response became RESULT: first or retried.
  if response_reports_no_review "$RESULT"; then
    preserve_no_review_and_fail "$RESULT"
  fi
  if response_missing_qa_metadata "$RESULT"; then
    preserve_no_review_and_fail "$RESULT" \
      "returned non-conforming JSON with no qa_metadata object (missing_qa_metadata)"
  fi

  # Stamp the authoritative timestamp ourselves. The reviewing model serializes
  # a `timestamp` field, but a model-supplied value is unverifiable — it can emit
  # a stale or fabricated time (vstack#629). Overwrite it with the wrapper's own
  # UTC wall clock so the artifact's content timestamp is trustworthy and matches
  # its filesystem mtime. The schema keeps ISO_8601 as a hint; this is the
  # authoritative value. RESULT is already jq-validated JSON here, so the rewrite
  # succeeds; if jq unexpectedly fails, keep the extracted JSON unchanged.
  # Also record the raw response byte counts in qa_metadata (vstack#940) —
  # retry_response_bytes only when a retry actually ran — so a reformat that
  # shrank the review is visible in the artifact, next to the .raw.txt sidecar.
  # reviewed_head (review mode, VST-124): record the head commit the review
  # covered so callers can budget review passes per pushed head instead of per
  # submission — a new head is a new round.
  STAMP="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  REVIEWED_HEAD=""
  if [[ "$MODE" == "review" ]]; then
    # Pinned at scope derivation, before the CLI ran — never re-sampled from a
    # mutable HEAD after the review finished.
    REVIEWED_HEAD="$REVIEW_HEAD_SHA"
  fi
  if STAMPED=$(printf '%s' "$RESULT" | jq --arg ts "$STAMP" --arg head "$REVIEWED_HEAD" \
      --argjson raw_bytes "$RAW_RESPONSE_BYTES" \
      --argjson retry_bytes "${RETRY_RESPONSE_BYTES:-null}" \
      '.timestamp = $ts
       | (if $head == "" then . else .qa_metadata.reviewed_head = $head end)
       | .qa_metadata.raw_response_bytes = $raw_bytes
       | if $retry_bytes == null then .
         else .qa_metadata.retry_response_bytes = $retry_bytes end' 2>/dev/null); then
    RESULT="$STAMPED"
  fi
fi

# --- Output -------------------------------------------------------------------

if [[ -n "$OUTPUT_PATH" ]]; then
  mkdir -p -- "$(path_dir "$OUTPUT_PATH")"
  printf '%s\n' "$RESULT" > "$OUTPUT_PATH"
  echo "→ Written: $OUTPUT_PATH" >&2
  echo "$OUTPUT_PATH"
else
  printf '%s\n' "$RESULT"
fi
