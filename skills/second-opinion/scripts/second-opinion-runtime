#!/usr/bin/env bash
set -euo pipefail

RUNTIME_SELF="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)/${BASH_SOURCE[0]##*/}"

die() { echo "second-opinion-runtime: $1" >&2; exit 1; }

runtime_dir_valid() {
  local dir="$1" token="$2" recorded
  [[ -d "$dir" && ! -L "$dir" ]] || return 1
  [[ -f "$dir/token" && ! -L "$dir/token" ]] || return 1
  recorded=$(cat < "$dir/token") || return 1
  [[ "$recorded" == "$token" ]]
}

validate_runtime_dir() {
  local dir="$1" token="$2"
  runtime_dir_valid "$dir" "$token" \
    || die "runtime directory or token is missing, unsafe, or changed: $dir"
}

second_opinion_runtime_setup() {
  TIMEOUT_CMD="$(command -v timeout || command -v gtimeout || true)"
  [[ -n "$TIMEOUT_CMD" ]] \
    || echo "Warning: no timeout or gtimeout on PATH — external CLI calls will run without a time limit" >&2
}

run_with_timeout() {
  local duration="$1" stderr_file="$2"
  shift 2
  if [[ -z "$TIMEOUT_CMD" ]]; then
    echo "→ cmd: direct-tree $*" >&2
    "$RUNTIME_SELF" tree 25 "$stderr_file" "$@"
    return
  fi
  echo "→ cmd: $TIMEOUT_CMD --foreground -k 30 ${duration}s $RUNTIME_SELF tree 25 $stderr_file $*" >&2
  "$TIMEOUT_CMD" --foreground -k 30 "$duration" "$RUNTIME_SELF" tree 25 "$stderr_file" "$@"
}

process_group_alive() { kill -0 -- "-$1" 2>/dev/null; }

stop_process_group() {
  local leader="$1" grace="$2" end now
  process_group_alive "$leader" || return 0
  kill -TERM -- "-$leader" 2>/dev/null || true
  end=$(($(date +%s) + grace))
  while process_group_alive "$leader"; do
    now=$(date +%s)
    if [[ $now -ge $end ]]; then
      kill -KILL -- "-$leader" 2>/dev/null || true
      break
    fi
    sleep 0.1
  done
}

tree() {
  local grace="$1" stderr_file="$2"
  shift 2
  [[ "$grace" =~ ^[1-9][0-9]*$ ]] || die "grace must be positive"
  [[ $# -gt 0 ]] || die "tree command is missing"

  local tree_pid="" tree_rc=0 tree_reaped=false cancel_rc="" gate=""
  request_cancel() {
    cancel_rc="$1"
    [[ -z "$tree_pid" ]] || stop_process_group "$tree_pid" "$grace"
  }
  stop_and_reap_tree() {
    [[ -z "$tree_pid" ]] || stop_process_group "$tree_pid" "$grace"
    if [[ -n "$tree_pid" ]] && ! $tree_reaped; then
      wait "$tree_pid" 2>/dev/null || tree_rc=$?
      tree_reaped=true
    fi
  }
  cleanup_tree() {
    stop_and_reap_tree
    [[ -z "$gate" ]] || rm -rf -- "$gate" || true
  }
  trap cleanup_tree EXIT
  trap 'request_cancel 143' TERM HUP
  trap 'request_cancel 130' INT

  gate=$(mktemp -d) || die "cannot create CLI startup gate"
  set -m
  (while [[ ! -e "$gate/release" ]]; do sleep 0.01; done; exec "$@") 2>"$stderr_file" &
  tree_pid=$!
  set +m
  if [[ -n "$cancel_rc" ]]; then
    stop_and_reap_tree
    exit "$cancel_rc"
  fi
  (umask 077 && set -C && : > "$gate/release") || {
    stop_and_reap_tree
    die "cannot release CLI process"
  }
  if [[ -n "$cancel_rc" ]]; then
    stop_and_reap_tree
    exit "$cancel_rc"
  fi
  wait "$tree_pid" || tree_rc=$?
  tree_reaped=true
  stop_and_reap_tree
  [[ -z "$cancel_rc" ]] || exit "$cancel_rc"
  exit "$tree_rc"
}

create_runtime_dir() {
  local dir=""
  artifact_home
  if [[ -n "$ARTIFACT_HOME" ]]; then
    dir=$(mktemp -d "$ARTIFACT_HOME/runtime.XXXXXX" 2>/dev/null) || {
      artifact_home_unusable
      dir=""
    }
  fi
  [[ -n "$dir" ]] || dir=$(mktemp -d 2>/dev/null) || die "cannot create runtime directory"
  chmod 700 "$dir" || die "cannot secure runtime directory: $dir"
  printf '%s\n' "$dir"
}

supervise() {
  local script="$1" artifact="$2" runtime_dir="$3" deadline="$4"
  local owned="$5" token="$6" grace="$7"
  shift 7
  [[ "$deadline" =~ ^[1-9][0-9]*$ ]] || die "deadline must be a positive epoch"
  [[ "$owned" == true || "$owned" == false ]] || die "owned must be true or false"
  [[ "$grace" =~ ^[1-9][0-9]*$ ]] || die "grace must be positive"
  validate_runtime_dir "$runtime_dir" "$token"

  local worker_pid="" worker_rc=0 worker_wait_rc=0 worker_reaped=false
  local cancel_rc="" cancel_message="" deadline_completion_race=false
  local gate="" watchdog_pid=""
  local status_file="$runtime_dir/worker.status" stop_at=$((deadline - grace))
  request_cancel() {
    if [[ "$1" -eq 124 && -f "$status_file" && ! -L "$status_file" ]]; then
      deadline_completion_race=true
      return
    fi
    if runtime_dir_valid "$runtime_dir" "$token"; then
      cancel_rc="$1"
      [[ "$1" -ne 124 ]] \
        || cancel_message="Error: detached run reached its supervisor deadline $deadline"
    else
      cancel_rc=1
      cancel_message="Error: detached runtime directory or token changed after release"
    fi
    [[ -z "$worker_pid" ]] || kill -TERM -- "-$worker_pid" 2>/dev/null || true
  }
  stop_watchdog() {
    if [[ -n "$watchdog_pid" ]]; then
      kill "$watchdog_pid" 2>/dev/null || true
      wait "$watchdog_pid" 2>/dev/null || true
      watchdog_pid=""
    fi
  }
  stop_and_reap_worker() {
    [[ -z "$worker_pid" ]] || stop_process_group "$worker_pid" "$grace"
    if [[ -n "$worker_pid" ]] && ! $worker_reaped; then
      wait "$worker_pid" 2>/dev/null || true
      worker_reaped=true
    fi
  }
  cleanup_supervisor() {
    stop_watchdog
    stop_and_reap_worker
    [[ -z "$gate" ]] || rm -rf -- "$gate" || true
  }
  publish_completion() {
    printf '__SECOND_OPINION_EXIT_%s__=%s\n' "$token" "$1" >&2
  }
  finish_supervisor() {
    local status="$1" message="$2"
    [[ -z "$message" ]] || echo "$message" >&2
    stop_and_reap_worker
    publish_completion "$status"
    exit "$status"
  }
  trap cleanup_supervisor EXIT
  trap 'request_cancel 143' TERM HUP
  trap 'request_cancel 130' INT
  trap 'request_cancel 124' ALRM

  gate=$(mktemp -d "$runtime_dir/gate.XXXXXX") || die "cannot create worker startup gate"
  set -m
  (
    while [[ ! -e "$gate/release" ]]; do sleep 0.01; done
    unset SECOND_OPINION_RUNTIME_DIR SECOND_OPINION_RUN_TOKEN
    worker_args=("$@" --detached-worker "--output=$artifact")
    $owned && worker_args+=(--scratch-output)
    set +e
    "$script" "${worker_args[@]}"
    rc=$?
    status_tmp="$status_file.$$"
    (umask 077 && set -C && printf '%s\n' "$rc" > "$status_tmp") || exit 1
    mv -f -- "$status_tmp" "$status_file" || exit 1
    exit "$rc"
  ) &
  worker_pid=$!
  set +m
  [[ -z "$cancel_rc" ]] || finish_supervisor "$cancel_rc" ""
  (umask 077 && set -C && : > "$gate/release") || {
    stop_and_reap_worker
    die "cannot release detached worker"
  }
  (
    delay=$((stop_at - $(date +%s)))
    [[ $delay -le 0 ]] || sleep "$delay"
    kill -ALRM "$$" 2>/dev/null || true
  ) &
  watchdog_pid=$!

  wait "$worker_pid" || worker_wait_rc=$?
  stop_watchdog
  if [[ -n "$cancel_rc" ]]; then
    worker_reaped=false
  else
    if $deadline_completion_race; then
      worker_wait_rc=0
      wait "$worker_pid" || worker_wait_rc=$?
    fi
    worker_reaped=true
  fi
  [[ -z "$cancel_rc" ]] || finish_supervisor "$cancel_rc" "$cancel_message"
  runtime_dir_valid "$runtime_dir" "$token" \
    || finish_supervisor 1 "Error: detached runtime directory or token changed after release"
  [[ -f "$status_file" && ! -L "$status_file" ]] \
    || finish_supervisor 1 "Error: detached worker exited without a completion status"
  worker_rc=$(cat < "$status_file") \
    || finish_supervisor 1 "Error: cannot read detached worker status"
  [[ "$worker_rc" =~ ^[0-9]+$ && $worker_rc -le 255 ]] \
    || finish_supervisor 1 "Error: detached worker status is malformed"
  [[ "$worker_rc" -eq "$worker_wait_rc" ]] \
    || finish_supervisor 1 "Error: detached worker status does not match its exit status"
  finish_supervisor "$worker_rc" ""
}

launch() {
  local script="$1" artifact="$2" runtime_dir="$3" budget="$4" owned="$5" grace="$6"
  shift 6
  [[ "$budget" =~ ^[1-9][0-9]*$ ]] || die "budget must be positive"
  [[ "$grace" =~ ^[1-9][0-9]*$ ]] || die "grace must be positive"
  local deadline token log="$runtime_dir/worker.log"
  token="$(date +%s).$$.$RANDOM"
  (umask 077 && set -C && printf '%s\n' "$token" > "$runtime_dir/token") \
    || die "cannot create runtime token: $runtime_dir/token"
  set -C
  exec 9>"$log" || die "cannot create worker log: $log"
  set +C
  exec 8<&0
  deadline=$(($(date +%s) + budget))
  "$RUNTIME_SELF" supervise "$script" "$artifact" "$runtime_dir" "$deadline" \
    "$owned" "$token" "$grace" "$@" <&8 >&9 2>&1 &
  exec 8<&- 9>&-
  printf 'artifact: %s\n' "$artifact"
  printf 'deadline: %s\n' "$deadline"
  printf 'wait:'
  printf ' %q' "$RUNTIME_SELF" wait "$artifact" "$runtime_dir" "$deadline" "$token"
  printf '\n'
}

second_opinion_detach_if_needed() {
  local artifact="$OUTPUT_PATH" owned=false attempts=1 budget runtime_dir
  if $DETACHED_WORKER || [[ "$MODE" == "detect" ]] \
      || { ! $FOREGROUND_CAP && ! $FOREGROUND_CAP_IN_CALLER_ENV; }; then return; fi
  [[ -x "$RUNTIME_SELF" ]] || die "runtime is missing: $RUNTIME_SELF"
  if [[ -z "$artifact" ]]; then
    artifact_file detached
    artifact="$ARTIFACT_PATH"
    owned=true
  elif [[ "$artifact" != /* ]]; then artifact="$(pwd)/$artifact"; fi
  [[ -n "$artifact" ]] || die "no writable artifact path for detached run"
  runtime_dir=$(create_runtime_dir)
  [[ "$MODE" == "review" || "$MODE" == "audit" ]] && attempts=2
  budget=$((attempts * (10#$TIMEOUT + 30) + 60))
  exec "$RUNTIME_SELF" launch "$SCRIPT_DIR/second-opinion" "$artifact" "$runtime_dir" \
    "$budget" "$owned" 30 "${ORIGINAL_ARGS[@]}"
}

completion_line() {
  local log="$1" prefix="$2" line="" match matches grep_rc=0
  matches=$(grep -F "$prefix" "$log") || grep_rc=$?
  [[ $grep_rc -le 1 ]] || return 2
  while IFS= read -r match; do line="$match"; done <<< "$matches"
  printf '%s' "$line"
}

wait_for_run() {
  local artifact="$1" runtime_dir="$2" deadline="$3" token="$4" log="$2/worker.log"
  [[ "$deadline" =~ ^[1-9][0-9]*$ ]] || die "deadline must be a positive epoch"
  [[ "$token" =~ ^[A-Za-z0-9._-]+$ ]] || die "token is malformed"
  validate_runtime_dir "$runtime_dir" "$token"
  local prefix="__SECOND_OPINION_EXIT_${token}__=" line status now grep_rc
  while :; do
    grep_rc=0
    line=$(completion_line "$log" "$prefix") || grep_rc=$?
    [[ $grep_rc -ne 2 ]] || die "cannot read worker log: $log"
    if [[ -n "$line" ]]; then
      status="${line#"$prefix"}"
      [[ "$status" =~ ^[0-9]+$ && $status -le 255 ]] || die "worker status is malformed"
      grep_rc=0
      grep -vF "$prefix" "$log" >&2 || grep_rc=$?
      [[ $grep_rc -le 1 ]] || die "cannot replay worker log: $log"
      rm -rf -- "$runtime_dir" || die "cannot remove runtime directory: $runtime_dir"
      if [[ $status -eq 0 && ! -s "$artifact" ]]; then
        echo "Error: detached run exited 0 without writing its artifact: $artifact" >&2
        exit 1
      fi
      [[ $status -eq 0 ]] && printf '%s\n' "$artifact"
      exit "$status"
    fi
    now=$(date +%s)
    if [[ $now -ge $deadline ]]; then
      grep_rc=0
      line=$(completion_line "$log" "$prefix") || grep_rc=$?
      [[ $grep_rc -ne 2 ]] || die "cannot read worker log: $log"
      [[ -z "$line" ]] || continue
      cat < "$log" >&2 || die "cannot replay worker log: $log"
      echo "Error: detached supervisor did not publish completion by deadline $deadline" >&2
      exit 124
    fi
    sleep 1
  done
}

if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  action="${1:-}"
  [[ -n "$action" ]] || die "action required"
  shift
  case "$action" in
    tree) [[ $# -ge 3 ]] || die "tree arguments are incomplete"; tree "$@" ;;
    supervise) [[ $# -ge 8 ]] || die "supervise arguments are incomplete"; supervise "$@" ;;
    launch) [[ $# -ge 7 ]] || die "launch arguments are incomplete"; launch "$@" ;;
    wait) [[ $# -eq 4 ]] || die "wait arguments are incomplete"; wait_for_run "$@" ;;
    *) die "unknown action: $action" ;;
  esac
fi
