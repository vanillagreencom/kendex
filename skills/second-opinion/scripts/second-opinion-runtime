#!/usr/bin/env bash
set -euo pipefail
RUNTIME_SELF="$(cd -- "$(dirname "${BASH_SOURCE[0]}")" && pwd)/${BASH_SOURCE[0]##*/}"
die() { echo "second-opinion-runtime: $1" >&2; exit 1; }
runtime_dir_valid() { [[ -d "$1" && ! -L "$1" ]]; }
validate_runtime_dir() {
  runtime_dir_valid "$1" || die "runtime directory is missing, unsafe, or changed: $1"
}
# THE PROBE IS THE GROUP, NOT ITS LEADER. A leader can exit while its children
# run on — that is the ordinary shape of a CLI that forks — so probing the
# leader answers "the first process finished", never "the tree is gone". Asking
# `kill -0` about the negative pid asks about the whole group, which is what
# both callers below actually need: a survivor holding a captured pipe open is
# the failure they exist to prevent.
process_group_alive() { kill -0 -- "-$1" 2>/dev/null; }
stop_process_group() {
  local leader="$1" grace="$2" end now
  process_group_alive "$leader" || return 0
  if ! kill -TERM -- "-$leader" 2>/dev/null; then
    process_group_alive "$leader" || return 0
    echo "second-opinion-runtime: could not send TERM to process group $leader" >&2
    return 1
  fi
  end=$(($(date +%s) + grace))
  while process_group_alive "$leader"; do
    now=$(date +%s)
    if [[ $now -ge $end ]]; then
      if ! kill -KILL -- "-$leader" 2>/dev/null; then
        process_group_alive "$leader" || return 0
        echo "second-opinion-runtime: could not send KILL to process group $leader" >&2
        return 1
      fi
      end=$((now + 5))
      while process_group_alive "$leader"; do
        now=$(date +%s)
        if [[ $now -ge $end ]]; then
          echo "second-opinion-runtime: process group $leader is still alive after KILL" >&2
          return 1
        fi
        sleep 0.1
      done
      if kill -0 "$leader" 2>/dev/null; then
        echo "second-opinion-runtime: process $leader is still alive after its group stopped" >&2
        return 1
      fi
      wait "$leader" 2>/dev/null || true
      return 0
    fi
    sleep 0.1
  done
}
second_opinion_runtime_setup() {
  TIMEOUT_CMD="$(command -v timeout || command -v gtimeout || true)"
  [[ -n "$TIMEOUT_CMD" ]] \
    || echo "Warning: no timeout or gtimeout on PATH — external CLI calls will run without a time limit" >&2
}
# NEITHER `timeout` MODE OWNS A PROCESS TREE ON ITS OWN, and the two failures
# are opposite, so one flag cannot be the answer:
#
#   --foreground  leaves the CLI in THIS process group, so a signal aimed at
#                 second-opinion reaches it — but on expiry timeout signals
#                 only its direct child. The CLI's own children survive, and a
#                 survivor holding the captured pipe open hangs the caller's
#                 `RESULT=$(...)` for as long as it lives, long past the 124.
#   default       kills the tree on expiry, but moves timeout into a private
#                 process group the caller's own signal can no longer reach,
#                 so the lane outlives the session that started it.
#
# Both properties are required, so the wrapper below supplies the half timeout
# does not: it stays in the caller's group and gives the CLI a group of its own.
run_with_timeout() {
  local duration="$1" stderr_file="$2"
  shift 2
  if [[ -z "$TIMEOUT_CMD" ]]; then
    echo "→ cmd: direct $RUNTIME_SELF group-run $stderr_file $*" >&2
    "$RUNTIME_SELF" group-run "$stderr_file" "$@"
    return
  fi
  echo "→ cmd: $TIMEOUT_CMD --foreground -k 30 ${duration}s $RUNTIME_SELF group-run $stderr_file $*" >&2
  "$TIMEOUT_CMD" --foreground -k 30 "$duration" "$RUNTIME_SELF" group-run "$stderr_file" "$@"
}
# Run one CLI as its own process-group leader and tear that group down on every
# exit path — normal return, the TERM `timeout` sends on expiry, or a signal
# aimed at second-opinion. This is the whole of the mechanism: no gate, no
# channel, no watchdog.
group_run() {
  local stderr_file="$1"
  shift
  [[ $# -gt 0 ]] || die "group command is missing"
  local cli_pid="" rc=0 cancel_rc=""
  stop_cli() { [[ -z "$cli_pid" ]] || stop_process_group "$cli_pid" 25; }
  # OWN THE CHILD BEFORE A HANDLER MAY EXIT. Between the fork below and the
  # assignment that follows it there is no pid to act on, and a handler that
  # exited there would leave a live process group behind with nothing left to
  # stop it. So the handler RECORDS the cancellation in that window and the
  # check after the assignment honours it; only once the pid is owned does the
  # handler go back to exiting directly.
  request_cancel() { cancel_rc="$1"; }
  trap 'request_cancel 143' TERM HUP
  trap 'request_cancel 130' INT
  trap stop_cli EXIT
  # Job control is on only across the fork: that is what makes the CLI a
  # process-group leader, and turning it straight back off keeps bash from
  # printing job notices onto the CLI's own output. Stdin is handed over
  # explicitly — an async command in a job-control shell does not inherit the
  # /dev/null a plain background job would get, and the prompt arrives there.
  exec 8<&0
  set -m
  "$@" <&8 2>"$stderr_file" &
  cli_pid=$!
  set +m
  exec 8<&-
  trap 'stop_cli; exit 143' TERM HUP
  trap 'stop_cli; exit 130' INT
  [[ -z "$cancel_rc" ]] || { stop_cli; exit "$cancel_rc"; }
  wait "$cli_pid" || rc=$?
  stop_cli
  exit "$rc"
}
create_runtime_dir() {
  local dir=""
  artifact_home
  if [[ -n "$ARTIFACT_HOME" ]]; then
    dir=$(mktemp -d "$ARTIFACT_HOME/runtime.XXXXXX" 2>/dev/null) || {
      artifact_home_unusable
      dir=""
    }
  fi
  [[ -n "$dir" ]] || dir=$(mktemp -d 2>/dev/null) || die "cannot create runtime directory"
  chmod 700 "$dir" || die "cannot secure runtime directory: $dir"
  printf '%s\n' "$dir"
}
# Detach the run and print the three protocol lines its consumers read:
# `artifact:`, `deadline:` (absolute epoch seconds) and a `wait:` command.
# Nothing watches the worker afterwards — it carries its own per-CLI timeout,
# and `wait` below owns the run's deadline.
launch() {
  local script="$1" artifact="$2" runtime_dir="$3" budget="$4" owned="$5"
  local wait_slice="$6"
  shift 6
  [[ "$budget" =~ ^[1-9][0-9]*$ ]] || die "budget must be positive"
  [[ "$owned" == true || "$owned" == false ]] || die "owned must be true or false"
  [[ "$wait_slice" =~ ^[1-9][0-9]*$ && $wait_slice -lt 600 ]] \
    || die "wait slice must be positive and below 600 seconds"
  # worker_pid is initialised, not merely declared: the cleanup below
  # reads it, and it is armed before it is assigned. Under `set -u` a
  # declared-but-unassigned local is still unbound, so a signal arriving in that
  # first instant would fault the handler instead of running it.
  local deadline worker_pid="" cancel_rc="" log="$runtime_dir/worker.log"
  local status_file="$runtime_dir/worker.status" launch_umask
  local worker_args launch_model="${SECOND_OPINION_LAUNCH_MODEL:-}"
  # THE WINDOW BETWEEN THE FORK AND THE PROTOCOL. Once the worker exists it can
  # only be recovered through what launch prints and stopped through what it
  # records, so until all of that is published the worker is unreachable — a
  # cancelled or failed launch there strands a run nobody can wait on or stop.
  # Armed before the fork, cleared after the last protocol line.
  #
  # It reads locals of this frame, so it must never run after launch RETURNS.
  # That is why the traps are cleared at the end rather than gated on a flag:
  # every path that reaches it — a signal, or `die` on a failed publish — is
  # still inside the frame, where a flag would be readable but pointless.
  cleanup_launch() {
    if [[ -n "$worker_pid" ]] && ! stop_process_group "$worker_pid" 30; then
      echo "second-opinion-runtime: launch cleanup failed; runtime state preserved: $runtime_dir" >&2
      return 1
    fi
    ! runtime_dir_valid "$runtime_dir" || rm -rf -- "${runtime_dir:?}" || true
  }
  # Deferred across the fork window for the same reason as group_run: until
  # worker_pid is assigned there is no group to stop, and a handler exiting
  # there would strand the very run this cleanup exists to reclaim.
  request_cancel() { cancel_rc="$1"; }
  trap 'request_cancel 143' TERM HUP
  trap 'request_cancel 130' INT
  trap cleanup_launch EXIT
  unset SECOND_OPINION_LAUNCH_MODEL
  # Both files are created here or not at all. The worker never inherits the
  # status fd, so text it or an external CLI prints cannot publish completion.
  launch_umask=$(umask)
  umask 077
  set -C
  : > "$log" || die "cannot create worker log: $log"
  exec 9>"$status_file" || die "cannot create worker status: $status_file"
  set +C
  umask "$launch_umask"
  deadline=$(($(date +%s) + budget))
  worker_args=("$@" --detached-worker "--output=$artifact")
  $owned && worker_args+=(--scratch-output)
  # The worker leads its own process group — job control across the fork, and
  # nothing else. That is what lets the deadline tear the whole run down later,
  # and it needs no setsid, which stock macOS does not ship. nohup keeps a
  # hangup off it and the closed stdio lets the caller exit.
  #
  # The wrapper publishes through fd 9 after the worker returns. The worker
  # gets that descriptor closed and never receives the status path.
  set -m
  SECOND_OPINION_CURRENT_MODEL="$launch_model" \
    nohup bash -c '
      rc=0
      "$@" 9>&- || rc=$?
      printf "%s\n" "$rc" >&9
      exit "$rc"
    ' second-opinion-worker "$script" "${worker_args[@]}" \
    < /dev/null > "$log" 2>&1 &
  worker_pid=$!
  set +m
  exec 9>&-
  trap 'cleanup_launch; exit 143' TERM HUP
  trap 'cleanup_launch; exit 130' INT
  [[ -z "$cancel_rc" ]] || { cleanup_launch; exit "$cancel_rc"; }
  (umask 077 && set -C && printf '%s\n' "$worker_pid" > "$runtime_dir/pid") \
    || die "cannot record detached worker pid: $runtime_dir/pid"
  printf 'artifact: %s\n' "$artifact"
  printf 'deadline: %s\n' "$deadline"
  printf 'wait:'
  printf ' %q' "$RUNTIME_SELF" wait "$artifact" "$runtime_dir" "$deadline" "$wait_slice"
  printf '\n'
  # The run is now recoverable and stoppable by its consumer; the launcher's
  # ownership of it ends here, and so does the window the traps guard.
  trap - EXIT TERM HUP INT
}
second_opinion_detach_if_needed() {
  local artifact="$OUTPUT_PATH" owned=false attempts=1 budget runtime_dir
  if $DETACHED_WORKER || [[ "$MODE" == "detect" ]] \
      || { ! $FOREGROUND_CAP && ! $FOREGROUND_CAP_IN_CALLER_ENV; }; then return; fi
  [[ -x "$RUNTIME_SELF" ]] || die "runtime is missing: $RUNTIME_SELF"
  if [[ -z "$artifact" ]]; then
    artifact_file detached
    artifact="$ARTIFACT_PATH"
    owned=true
  elif [[ "$artifact" != /* ]]; then artifact="$(pwd)/$artifact"; fi
  [[ -n "$artifact" ]] || die "no writable artifact path for detached run"
  [[ "$artifact" != *$'\r'* && "$artifact" != *$'\n'* ]] || die "artifact path contains CR or LF"
  runtime_dir=$(create_runtime_dir)
  [[ "$MODE" == "review" || "$MODE" == "audit" ]] && attempts=2
  budget=$((attempts * (10#$TIMEOUT + 30) + 60))
  export SECOND_OPINION_LAUNCH_MODEL="$CURRENT_MODEL"
  exec "$RUNTIME_SELF" launch "$SCRIPT_DIR/second-opinion" "$artifact" "$runtime_dir" \
    "$budget" "$owned" 300 "${ORIGINAL_ARGS[@]}"
}
completion_status() {
  cat "$1" || return 2
}
wait_for_run() {
  local artifact="$1" runtime_dir="$2" deadline="$3"
  local wait_slice="$4" log="$2/worker.log" pid_file="$2/pid"
  local status_file="$2/worker.status"
  [[ "$deadline" =~ ^[1-9][0-9]*$ ]] || die "deadline must be a positive epoch"
  [[ "$wait_slice" =~ ^[1-9][0-9]*$ && $wait_slice -lt 600 ]] \
    || die "wait slice must be positive and below 600 seconds"
  validate_runtime_dir "$runtime_dir"
  [[ -f "$status_file" && ! -L "$status_file" ]] \
    || die "detached worker status is missing or unsafe: $status_file"
  local status now status_rc attempt_deadline worker_pid
  [[ -f "$pid_file" && ! -L "$pid_file" ]] \
    || die "detached worker pid is missing or unsafe: $pid_file"
  worker_pid=$(cat < "$pid_file") || die "cannot read detached worker pid: $pid_file"
  [[ "$worker_pid" =~ ^[1-9][0-9]*$ ]] || die "detached worker pid is malformed"
  replay_log() {
    local replay_rc=0
    cat "$log" >&2 || replay_rc=$?
    [[ $replay_rc -eq 0 ]] || die "cannot replay worker log: $log"
  }
  now=$(date +%s)
  attempt_deadline=$((now + wait_slice))
  [[ $attempt_deadline -le $deadline ]] || attempt_deadline=$deadline
  while :; do
    # The wrapper alone writes worker.status. Read it before liveness so a
    # completed run wins the small window before its process disappears.
    status_rc=0
    status=$(completion_status "$status_file") || status_rc=$?
    [[ $status_rc -ne 2 ]] || die "cannot read worker status: $status_file"
    if [[ -n "$status" ]]; then
      [[ "$status" =~ ^[0-9]+$ && $status -le 255 ]] || die "worker status is malformed"
      replay_log
      rm -rf -- "$runtime_dir" || die "cannot remove runtime directory: $runtime_dir"
      if [[ $status -eq 0 && ! -s "$artifact" ]]; then
        echo "Error: detached run exited 0 without writing its artifact: $artifact" >&2
        exit 1
      fi
      [[ $status -eq 0 ]] && printf '%s\n' "$artifact"
      exit "$status"
    fi
    now=$(date +%s)
    if [[ $now -ge $deadline ]]; then
      if ! stop_process_group "$worker_pid" 30; then
        echo "second-opinion: deadline cleanup failed; runtime state preserved: $runtime_dir" >&2
        exit 75
      fi
      status_rc=0
      status=$(completion_status "$status_file") || status_rc=$?
      [[ $status_rc -ne 2 ]] || die "cannot read worker status: $status_file"
      [[ -z "$status" ]] || continue
      replay_log
      rm -rf -- "$runtime_dir" || die "cannot remove runtime directory: $runtime_dir"
      echo "Error: detached run reached its deadline $deadline" >&2
      exit 124
    fi
    if ! process_group_alive "$worker_pid"; then
      status_rc=0
      status=$(completion_status "$status_file") || status_rc=$?
      [[ $status_rc -ne 2 ]] || die "cannot read worker status: $status_file"
      [[ -z "$status" ]] || continue
      echo "second-opinion: the detached worker is gone and published no status; relaunch the original second-opinion command" >&2
      exit 1
    fi
    if [[ $now -ge $attempt_deadline ]]; then
      status_rc=0
      status=$(completion_status "$status_file") || status_rc=$?
      [[ $status_rc -ne 2 ]] || die "cannot read worker status: $status_file"
      [[ -z "$status" ]] || continue
      echo "second-opinion: still running; rerun the same wait command" >&2
      exit 75
    fi
    sleep 1
  done
}
if [[ "${BASH_SOURCE[0]}" == "$0" ]]; then
  action="${1:-}"
  [[ -n "$action" ]] || die "action required"
  shift
  case "$action" in
    group-run) [[ $# -ge 2 ]] || die "group arguments are incomplete"; group_run "$@" ;;
    launch) [[ $# -ge 7 ]] || die "launch arguments are incomplete"; launch "$@" ;;
    wait) [[ $# -eq 4 ]] || die "wait arguments are incomplete"; wait_for_run "$@" ;;
    *) die "unknown action: $action" ;;
  esac
fi
