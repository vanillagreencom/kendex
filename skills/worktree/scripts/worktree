#!/bin/bash
# Portable git worktree manager
# Usage: worktree create|restack|list|remove|cleanup|path|exists|check|push|fix-links|repair-links|codex-setup|codex-branch|codex-cleanup|claude-setup|claude-cleanup [ID] [options]
#   create options:
#     --base BRANCH   Checkout an existing remote branch into the worktree;
#                     the default branch instead starts a new issue branch
#                     from it (it can never be checked out twice)
#     --from REF      Create a new branch starting from REF (branch, tag, or commit)
#     --pr NUMBER     Look up the branch from a PR number (implies --base)
#     --reuse         Explicitly reuse and update an existing issue worktree
#     --recover-local Recreate a missing worktree for the exact local-only
#                     issue branch without rebasing or rewriting its commits
#     --restack       When reusing an existing worktree and the rebase onto
#                     origin/<default> conflicts, stop in the conflict state
#                     for resolution instead of aborting the rebase
#     --replay        With --reuse/--restack: run the same restack as an
#                     ordered cherry-pick replay with no rebase porcelain,
#                     for execution policies that reject `git rebase`
#   restack actions:
#     continue        Continue an exact tool-created, paused restack
#     skip            Skip the current commit in that paused restack
#     abort           Abort that paused restack and clear pending authorization
#   cleanup options:
#     --stale         Also collect worktrees whose session guard lease is past
#                     the TTL (an abandoned session)
#     --ttl-minutes N Staleness horizon for --stale (default: 720)
#
# Session guard: `create` never claims a lease — see the "Session guard
# lifecycle" block below for why, and the orchestrating workflow for who does.
#
# Layout: main checkout (repo) + external worktree parent dir
#   default: <parent-of-checkout>/.worktrees/<checkout-name>/{id}
# Config: reads .env, vstack.settings.toml, then .env.local for optional settings (see below)
#
# vstack.settings.toml [env] and .env/.env.local config vars:
#   WORKTREE_BASE_DIR        - parent directory for worktrees (relative to main checkout or absolute;
#                              default: ../.worktrees/<checkout-name>, an external per-repo sibling dir)
#   WORKTREE_DEFAULT_BRANCH  - default branch name (auto-detected if unset, fallback: main)
#   WORKTREE_SYMLINKS        - space-separated paths to symlink from main into worktrees
#   WORKTREE_RELATIVE_SYMLINKS - space-separated path=target symlinks created inside worktrees
#   WORKTREE_COPIES          - space-separated paths to copy from main into worktrees
#   WORKTREE_MKDIRS          - space-separated paths to mkdir -p inside each worktree (e.g. tmp scratch dirs)
#   BOT_NAME                 - git user.name for worktree commits
#   BOT_EMAIL                - git user.email for worktree commits
#   BOT_SIGNING_KEY          - SSH signing key path
#   BOT_REMOTE_NAME          - remote name for push (default: origin)
#   BOT_REMOTE_URL           - URL for bot remote (added on create if set)

set -euo pipefail

readonly ACTIVE_WORK_EXIT=75

canonical_existing_dir() {
  local path="$1"
  [[ -d "$path" ]] || return 1
  (cd "$path" && pwd -P)
}

# Canonical (physical) path equality: both sides resolve through pwd -P, so a
# path reached via a compatibility symlink and its physical form compare
# equal. False when either side is not an existing directory.
same_canonical_dir() {
  local a="" b=""
  a="$(canonical_existing_dir "$1" 2>/dev/null)" || return 1
  b="$(canonical_existing_dir "$2" 2>/dev/null)" || return 1
  [[ "$a" == "$b" ]]
}

# Resolve PROJECT_ROOT via git (works at any depth, inside worktrees too)
PROJECT_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)"
if [[ -z "$PROJECT_ROOT" ]]; then
  echo "Error: Not inside a git repository" >&2
  exit 1
fi

# If inside a worktree, resolve to the main repo root
_git_common_dir=$(git -C "$PROJECT_ROOT" rev-parse --git-common-dir 2>/dev/null)
if [[ "$_git_common_dir" != ".git" && -n "$_git_common_dir" ]]; then
  PROJECT_ROOT="$(cd "$PROJECT_ROOT" && cd "$(dirname "$_git_common_dir")" && pwd)"
fi
# Physical form so registry, base-dir, and guard comparisons all share one
# canonical anchor even when the script is invoked through a symlinked path.
PROJECT_ROOT="$(canonical_existing_dir "$PROJECT_ROOT")"

git_common_dir_path() {
  local checkout="$1" common_dir=""
  common_dir="$(git -C "$checkout" rev-parse --git-common-dir 2>/dev/null)" || return 1
  if [[ "$common_dir" == /* ]]; then
    canonical_existing_dir "$common_dir"
  else
    canonical_existing_dir "$checkout/$common_dir"
  fi
}

PROJECT_COMMON_GIT_DIR="$(git_common_dir_path "$PROJECT_ROOT")"
if [[ -z "$PROJECT_COMMON_GIT_DIR" ]]; then
  echo "Error: Could not resolve the repository common Git directory" >&2
  exit 1
fi

# Load project config and secrets. .env.local still wins for compatibility.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=lib/vstack-env.sh
# A rebase replaces a symlinked harness dir with a REAL directory holding only
# the tracked subset, so the untracked skills under it — including this script's
# own lib — silently vanish (#856). Sourcing a missing lib exits 127 with
# Bash's own message, which names neither the cause nor the recovery; that is
# how the live incident presented. Fail loudly instead.
#
# The remediation must say "from the main checkout": in the observed incident
# this script's own copy inside the worktree was among the missing files, so
# pointing the operator at a worktree-local binary sends them to something that
# is not there.
if [[ ! -f "$SCRIPT_DIR/lib/vstack-env.sh" ]]; then
  {
    echo "Error: worktree support library is missing: $SCRIPT_DIR/lib/vstack-env.sh"
    echo "  This is the signature of a materialized harness directory: a rebase replaced"
    echo "  the symlink with a real directory containing only the tracked files, dropping"
    echo "  everything installed by vstack."
    echo "  Recover by running fix-links FROM THE MAIN CHECKOUT (this copy is incomplete):"
    echo "    cd <main checkout> && .agents/skills/worktree/scripts/worktree fix-links '$PWD'"
  } >&2
  exit 1
fi
source "$SCRIPT_DIR/lib/vstack-env.sh"
vstack_load_project_env "$PROJECT_ROOT"

GITHUB_AUTH_LIB="$SCRIPT_DIR/../../github/scripts/lib/gh-auth.sh"
if [[ -f "$GITHUB_AUTH_LIB" ]]; then
  # shellcheck source=../../github/scripts/lib/gh-auth.sh
  source "$GITHUB_AUTH_LIB"
fi

git_with_github_https_auth() {
  if declare -F vstack_github_git >/dev/null 2>&1; then
    vstack_github_git "$@"
  else
    git "$@"
  fi
}

restack_state_get() {
  local wt="$1" key="$2"
  git -C "$wt" config --worktree --get "vstack-restack.$key" 2>/dev/null || true
}

clear_restack_push_authorization() {
  local wt="$1" key=""
  for key in remote branch expectedRemoteOid originalHead baseOid authorizedHead pending stateToken mode; do
    git -C "$wt" config --worktree --unset-all "vstack-restack.$key" >/dev/null 2>&1 || true
  done
}

record_pending_restack_authorization() {
  local wt="$1" remote="$2" branch="$3" expected_oid="$4"
  local original_head="$5" base_oid="$6"
  local previous_remote="" previous_branch="" previous_expected="" previous_authorized="" state_token=""

  # Per-worktree config makes the authorization durable across a paused rebase
  # while tying it to this exact checkout. Partial writes fail closed because
  # authorization is valid only when every field and authorizedHead agree.
  git -C "$PROJECT_ROOT" config extensions.worktreeConfig true
  previous_remote="$(restack_state_get "$wt" remote)"
  previous_branch="$(restack_state_get "$wt" branch)"
  previous_expected="$(restack_state_get "$wt" expectedRemoteOid)"
  previous_authorized="$(restack_state_get "$wt" authorizedHead)"
  if [[ "$previous_remote" != "$remote" || "$previous_branch" != "$branch" || "$previous_expected" != "$expected_oid" ]] || \
     [[ -z "$previous_authorized" ]] || \
     ! git -C "$wt" merge-base --is-ancestor "$previous_authorized" "$original_head"; then
    previous_authorized=""
  fi
  clear_restack_push_authorization "$wt"
  git -C "$wt" config --worktree vstack-restack.remote "$remote"
  git -C "$wt" config --worktree vstack-restack.branch "$branch"
  git -C "$wt" config --worktree vstack-restack.expectedRemoteOid "$expected_oid"
  git -C "$wt" config --worktree vstack-restack.originalHead "$original_head"
  git -C "$wt" config --worktree vstack-restack.baseOid "$base_oid"
  git -C "$wt" config --worktree vstack-restack.pending true
  state_token="$(git -C "$wt" hash-object --stdin <<<"$remote:$branch:$expected_oid:$original_head:$base_oid:$$:$RANDOM")"
  git -C "$wt" config --worktree vstack-restack.stateToken "$state_token"
  if [[ -n "$previous_authorized" ]]; then
    git -C "$wt" config --worktree vstack-restack.authorizedHead "$previous_authorized"
  fi
}

cancel_pending_restack_authorization() {
  local wt="$1" authorized_head=""
  authorized_head="$(restack_state_get "$wt" authorizedHead)"
  if [[ -z "$authorized_head" ]]; then
    clear_restack_push_authorization "$wt"
    return
  fi
  git -C "$wt" config --worktree --unset-all vstack-restack.originalHead >/dev/null 2>&1 || true
  git -C "$wt" config --worktree --unset-all vstack-restack.baseOid >/dev/null 2>&1 || true
  git -C "$wt" config --worktree --unset-all vstack-restack.pending >/dev/null 2>&1 || true
  git -C "$wt" config --worktree --unset-all vstack-restack.stateToken >/dev/null 2>&1 || true
  git -C "$wt" config --worktree --unset-all vstack-restack.mode >/dev/null 2>&1 || true
}

restack_original_head_authorized() {
  local wt="$1" expected_oid="$2" original_head="$3" pending="$4"
  local authorized_head=""

  if [[ -z "$expected_oid" ]]; then
    [[ "$pending" == true ]]
    return
  fi
  if git -C "$wt" merge-base --is-ancestor "$expected_oid" "$original_head"; then
    return 0
  fi
  authorized_head="$(restack_state_get "$wt" authorizedHead)"
  [[ -n "$authorized_head" ]] || return 1
  git -C "$wt" cat-file -e "${authorized_head}^{commit}" 2>/dev/null || return 1
  git -C "$wt" merge-base --is-ancestor "$authorized_head" "$original_head"
}

restack_push_authorization_matches() {
  local wt="$1" remote="$2" branch="$3" expected_oid="$4"
  local stored_remote="" stored_branch="" stored_expected="" authorized_head=""

  stored_remote="$(restack_state_get "$wt" remote)"
  stored_branch="$(restack_state_get "$wt" branch)"
  stored_expected="$(restack_state_get "$wt" expectedRemoteOid)"
  authorized_head="$(restack_state_get "$wt" authorizedHead)"

  [[ -n "$authorized_head" ]] || return 1
  [[ "$stored_remote" == "$remote" && "$stored_branch" == "$branch" ]] || return 1
  [[ "$stored_expected" == "$expected_oid" ]] || return 1
  git -C "$wt" cat-file -e "${authorized_head}^{commit}" 2>/dev/null || return 1
  git -C "$wt" merge-base --is-ancestor "$authorized_head" HEAD
}

finalize_pending_restack_authorization() {
  local wt="$1" remote="$2" branch="$3" live_expected_oid="$4"
  local stored_remote="" stored_branch="" stored_expected="" original_head="" base_oid=""
  local current_head="" pending=""

  stored_expected="$(restack_state_get "$wt" expectedRemoteOid)"
  pending="$(restack_state_get "$wt" pending)"
  if [[ -z "$stored_expected" && "$pending" != true ]]; then
    return 0
  fi
  stored_remote="$(restack_state_get "$wt" remote)"
  stored_branch="$(restack_state_get "$wt" branch)"
  original_head="$(restack_state_get "$wt" originalHead)"
  base_oid="$(restack_state_get "$wt" baseOid)"
  if [[ -z "$original_head" && -z "$base_oid" ]]; then
    if [[ "$pending" == true ]]; then
      clear_restack_push_authorization "$wt"
      echo "Error: Pending restack authorization is incomplete; refusing to authorize a rewritten push." >&2
      return 1
    fi
    return 0
  fi

  if [[ "$stored_remote" != "$remote" || "$stored_branch" != "$branch" || "$stored_expected" != "$live_expected_oid" ]]; then
    clear_restack_push_authorization "$wt"
    echo "Error: Remote '$remote/$branch' changed while the supported restack was in progress; refusing to authorize a rewritten push." >&2
    echo "Fetch and rebase/merge '$remote/$branch' before retrying." >&2
    return 1
  fi
  if rebase_in_progress "$wt"; then
    echo "Error: Rebase is still in progress for $wt; finish or abort it before completing worktree setup." >&2
    return 1
  fi
  if [[ -z "$original_head" || -z "$base_oid" ]] || \
     ! restack_original_head_authorized "$wt" "$stored_expected" "$original_head" "$pending" || \
     ! git -C "$wt" merge-base --is-ancestor "$base_oid" HEAD; then
    clear_restack_push_authorization "$wt"
    echo "Error: Could not verify that '$branch' was rewritten by the supported restack; refusing force-push authorization." >&2
    return 1
  fi

  current_head="$(git -C "$wt" rev-parse HEAD)"
  if [[ -n "$stored_expected" ]]; then
    git -C "$wt" config --worktree vstack-restack.authorizedHead "$current_head"
  else
    clear_restack_push_authorization "$wt"
    return 0
  fi
  git -C "$wt" config --worktree --unset-all vstack-restack.originalHead >/dev/null 2>&1 || true
  git -C "$wt" config --worktree --unset-all vstack-restack.baseOid >/dev/null 2>&1 || true
  git -C "$wt" config --worktree --unset-all vstack-restack.pending >/dev/null 2>&1 || true
  git -C "$wt" config --worktree --unset-all vstack-restack.stateToken >/dev/null 2>&1 || true
  git -C "$wt" config --worktree --unset-all vstack-restack.mode >/dev/null 2>&1 || true
}

prepare_restack_authorization() {
  local wt="$1" remote="$2" branch="$3" expected_oid="$4" base_oid="$5"
  local original_head=""

  original_head="$(git -C "$wt" rev-parse HEAD)"
  if [[ -n "$expected_oid" ]] && \
     ! git -C "$wt" merge-base --is-ancestor "$expected_oid" "$original_head" && \
     ! restack_push_authorization_matches "$wt" "$remote" "$branch" "$expected_oid"; then
    clear_restack_push_authorization "$wt"
    echo "Error: Remote '$remote/$branch' points at $expected_oid, which is not contained in local branch '$branch'." >&2
    echo "Fetch and rebase/merge '$remote/$branch' before using create --reuse/--restack." >&2
    return 1
  fi

  record_pending_restack_authorization "$wt" "$remote" "$branch" "$expected_oid" "$original_head" "$base_oid"
}

remote_ref_lease_arg() {
  local wt="$1" remote="$2" branch="$3"
  local remote_head_ref="refs/heads/$branch"
  local remote_tracking_ref="refs/remotes/$remote/$branch"
  local expected_oid=""
  local fetch_err=""
  local fetch_status=0

  expected_oid="$(git -C "$wt" show-ref --verify --hash "$remote_tracking_ref" 2>/dev/null || true)"

  if [[ -z "$expected_oid" && "$remote" != "origin" ]]; then
    fetch_err="$(mktemp "${TMPDIR:-/tmp}/worktree-lease-fetch.XXXXXX")"
    if git_with_github_https_auth -C "$wt" fetch "$remote" "+${remote_head_ref}:${remote_tracking_ref}" >/dev/null 2>"$fetch_err"; then
      expected_oid="$(git -C "$wt" show-ref --verify --hash "$remote_tracking_ref" 2>/dev/null || true)"
    else
      fetch_status=$?
      if grep -qiE "couldn't find remote ref|could not find remote ref|remote ref does not exist|remote branch .* not found" "$fetch_err"; then
        rm -f "$fetch_err"
        printf '%s\n' "--force-with-lease=${remote_head_ref}:"
        return 0
      fi

      echo "Error: Could not fetch remote branch '$branch' from remote '$remote' for force-with-lease." >&2
      sed 's/^/  /' "$fetch_err" >&2
      rm -f "$fetch_err"
      return "$fetch_status"
    fi
    rm -f "$fetch_err"
  fi

  if [[ -z "$expected_oid" ]]; then
    # Empty expectation means the remote branch must not already exist. This
    # keeps first pushes safe and prevents overwriting an existing branch that
    # the local checkout has never observed.
    printf '%s\n' "--force-with-lease=${remote_head_ref}:"
    return 0
  fi

  if ! git -C "$wt" merge-base --is-ancestor "$expected_oid" HEAD && \
     ! restack_push_authorization_matches "$wt" "$remote" "$branch" "$expected_oid"; then
    echo "Error: Remote '$remote/$branch' points at $expected_oid, which is not contained in local branch '$branch'." >&2
    echo "Fetch and rebase/merge '$remote/$branch' before using worktree push." >&2
    return 1
  fi

  printf '%s\n' "--force-with-lease=${remote_head_ref}:${expected_oid}"
}

# After a push auto-rebase rewrote the branch, print one machine-readable
# "rebase-map: <old-sha> <new-sha>" line per rewritten commit on stdout so
# callers (orch submit-pr) can remap commit SHAs recorded before the rebase
# (vstack#728). A replayed commit that vanished (its patch was already
# upstream) maps to "rebase-map: <old-sha> dropped". Inputs are the pre- and
# post-rebase outputs of `git log --reverse --format='%H %s'
# origin/<default>..HEAD`. Commits pair by position when the counts match
# (rebase preserves order); on a count mismatch they pair by subject,
# consuming each post-rebase line at most once. Bash 3.2: consumed indices
# are tracked in a space-delimited string, no associative arrays.
emit_rebase_map() {
  local pre_list="$1" post_list="$2"
  if [[ -z "$pre_list" || "$pre_list" == "$post_list" ]]; then
    return 0
  fi
  local pre_count=0 post_count=0
  pre_count="$(printf '%s\n' "$pre_list" | grep -c '^')"
  if [[ -n "$post_list" ]]; then
    post_count="$(printf '%s\n' "$post_list" | grep -c '^')"
  fi
  echo "→ auto-rebase rewrote $pre_count branch commit(s); rebase-map lines follow (vstack#728)" >&2
  local i=1 j=1 old_line="" old_sha="" old_subject="" new_line="" new_sha="" used_idx=""
  while [[ "$i" -le "$pre_count" ]]; do
    old_line="$(printf '%s\n' "$pre_list" | sed -n "${i}p")"
    old_sha="${old_line%% *}"
    old_subject="${old_line#* }"
    new_sha=""
    if [[ "$pre_count" -eq "$post_count" ]]; then
      new_line="$(printf '%s\n' "$post_list" | sed -n "${i}p")"
      new_sha="${new_line%% *}"
    else
      j=1
      while [[ "$j" -le "$post_count" ]]; do
        case " $used_idx " in
          *" $j "*) j=$((j + 1)); continue ;;
        esac
        new_line="$(printf '%s\n' "$post_list" | sed -n "${j}p")"
        if [[ "${new_line#* }" == "$old_subject" ]]; then
          new_sha="${new_line%% *}"
          used_idx="$used_idx $j"
          break
        fi
        j=$((j + 1))
      done
    fi
    if [[ -z "$new_sha" ]]; then
      echo "rebase-map: $old_sha dropped"
    elif [[ "$new_sha" != "$old_sha" ]]; then
      echo "rebase-map: $old_sha $new_sha"
    fi
    i=$((i + 1))
  done
}

strip_trailing_slashes() {
  local path="$1"
  while [[ "$path" != "/" && "$path" == */ ]]; do
    path="${path%/}"
  done
  printf '%s\n' "$path"
}

validate_issue_id() {
  local issue="$1"
  if [[ ! "$issue" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ || "$issue" == *..* ]]; then
    echo "Error: invalid issue ID '$issue'. Use letters, numbers, '.', '_', or '-' only; start with a letter/number and do not include '..'." >&2
    return 1
  fi
}

normalize_worktree_config_path() {
  local var="$1" path="$2"
  path="$(strip_trailing_slashes "$path")"
  if [[ -z "$path" || "$path" == "." || "$path" == /* || "$path" == *\\* || "$path" == *'*'* || "$path" == *\?* || "$path" == *'['* || "$path" == *']'* || "$path" == */../* || "$path" == ../* || "$path" == */.. || "$path" == ".." || "$path" == */./* || "$path" == ./* || "$path" == */. ]]; then
    echo "Error: invalid $var entry '$2'. Use a worktree-relative path without '.', '..', absolute, backslash, or glob metacharacter components." >&2
    return 1
  fi
  printf '%s\n' "$path"
}

split_worktree_config_words() {
  local value="$1"
  local IFS=$' \t\n'
  WORKTREE_CONFIG_WORDS=()
  [[ -n "$value" ]] || return 0
  read -r -a WORKTREE_CONFIG_WORDS <<<"$value"
}

path_is_under_path() {
  local parent="$1" child="$2"
  [[ "$child" == "$parent/"* ]]
}

validate_relative_symlink_target() {
  local spec="$1" target="$2"
  if [[ -z "$target" || "$target" == /* ]]; then
    echo "Error: invalid WORKTREE_RELATIVE_SYMLINKS entry '$spec'. Target must be a non-empty relative path." >&2
    return 1
  fi
}

validate_worktree_setup_config() {
  local path="" spec="" normalized="" target="" i j
  local all_paths=()
  local all_sources=()
  local symlink_paths=()
  local symlink_sources=()

  split_worktree_config_words "${WORKTREE_MKDIRS:-}"
  for path in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    normalized="$(normalize_worktree_config_path WORKTREE_MKDIRS "$path")" || return 1
    all_paths+=("$normalized")
    all_sources+=("WORKTREE_MKDIRS")
  done
  split_worktree_config_words "${WORKTREE_SYMLINKS:-}"
  for path in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    normalized="$(normalize_worktree_config_path WORKTREE_SYMLINKS "$path")" || return 1
    all_paths+=("$normalized")
    all_sources+=("WORKTREE_SYMLINKS")
    symlink_paths+=("$normalized")
    symlink_sources+=("WORKTREE_SYMLINKS")
  done
  split_worktree_config_words "${WORKTREE_COPIES:-}"
  for path in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    normalized="$(normalize_worktree_config_path WORKTREE_COPIES "$path")" || return 1
    all_paths+=("$normalized")
    all_sources+=("WORKTREE_COPIES")
  done
  split_worktree_config_words "${WORKTREE_RELATIVE_SYMLINKS:-}"
  for spec in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    if [[ "$spec" != *=* ]]; then
      echo "Error: invalid WORKTREE_RELATIVE_SYMLINKS entry '$spec' (expected path=target)" >&2
      return 1
    fi
    path="${spec%%=*}"
    target="${spec#*=}"
    normalized="$(normalize_worktree_config_path WORKTREE_RELATIVE_SYMLINKS "$path")" || return 1
    validate_relative_symlink_target "$spec" "$target" || return 1
    all_paths+=("$normalized")
    all_sources+=("WORKTREE_RELATIVE_SYMLINKS")
    symlink_paths+=("$normalized")
    symlink_sources+=("WORKTREE_RELATIVE_SYMLINKS")
  done

  for ((i = 0; i < ${#symlink_paths[@]}; i++)); do
    for ((j = 0; j < ${#all_paths[@]}; j++)); do
      if [[ "${symlink_paths[$i]}" == "${all_paths[$j]}" ]]; then
        if [[ "${symlink_sources[$i]}" != "${all_sources[$j]}" ]]; then
          echo "Error: configured worktree path '${all_paths[$j]}' is both a symlink target (${symlink_sources[$i]}) and a ${all_sources[$j]} entry; refusing setup to avoid following the symlink target." >&2
          return 1
        fi
        continue
      fi
      if path_is_under_path "${symlink_paths[$i]}" "${all_paths[$j]}"; then
        echo "Error: configured worktree path '${all_paths[$j]}' is inside symlink path '${symlink_paths[$i]}'; refusing setup to avoid following the symlink target." >&2
        return 1
      fi
    done
  done
}

worktree_symlink_prefix() {
  local wt="$1" path="$2" include_leaf="${3:-false}"
  local parts=() prefix="$wt" limit i
  IFS='/' read -r -a parts <<<"$path"
  limit="${#parts[@]}"
  if [[ "$include_leaf" != true ]]; then
    limit=$((limit - 1))
  fi
  for ((i = 0; i < limit; i++)); do
    prefix="$prefix/${parts[$i]}"
    if [[ -L "$prefix" ]]; then
      printf '%s\n' "$prefix"
      return 0
    fi
  done
  return 1
}

ensure_worktree_path_safe() {
  local wt="$1" path="$2" include_leaf="${3:-false}" link_path=""
  link_path="$(worktree_symlink_prefix "$wt" "$path" "$include_leaf" 2>/dev/null || true)"
  if [[ -n "$link_path" ]]; then
    echo "Error: refusing to write '$path' in $wt because '$link_path' is a symlink." >&2
    return 1
  fi
}

mkdir_inside_worktree() {
  local wt="$1" path="$2"
  ensure_worktree_path_safe "$wt" "$path" true || return 1
  mkdir -p "$wt/$path"
}

resolve_worktree_base_dir() {
  local raw="${WORKTREE_BASE_DIR:-}"
  local path
  if [[ -z "$raw" ]]; then
    # Default: an external per-repo dir beside the checkout. Worktrees (and
    # their build outputs) must not live under the repo root — an editor
    # recursively watching the repo would ingest every worktree's build
    # artifacts and can exhaust the per-user inotify budget. A shared sibling
    # like ../trees would collide across repos (two repos' issue-1 would
    # resolve to the same path), so the repo name disambiguates.
    path="$(dirname "$PROJECT_ROOT")/.worktrees/$(basename "$PROJECT_ROOT")"
  else
    if [[ "$raw" == "~" ]]; then
      raw="${HOME:?WORKTREE_BASE_DIR uses ~ but HOME is not set}"
    elif [[ "$raw" == "~/"* ]]; then
      # ${raw:2}, not ${raw#~/}: an unquoted ~ in a strip pattern is itself
      # tilde-expanded to $HOME, so the prefix would never match.
      raw="${HOME:?WORKTREE_BASE_DIR uses ~ but HOME is not set}/${raw:2}"
    fi

    raw="$(strip_trailing_slashes "$raw")"

    if [[ "$raw" == /* ]]; then
      path="$raw"
    else
      path="$PROJECT_ROOT/$raw"
    fi
  fi

  [[ "$path" == "/" ]] && { printf '/\n'; return; }

  local parent name
  parent="$(dirname "$path")"
  name="$(basename "$path")"
  if [[ -d "$parent" ]]; then
    printf '%s/%s\n' "$(cd "$parent" && pwd -P)" "$name"
  else
    printf '%s\n' "$path"
  fi
}

# Layout: project/main (repo) + configured parent dir (worktrees)
TREES_DIR="$(resolve_worktree_base_dir)"

# Detect default branch (configurable, auto-detected, fallback: main)
detect_default_branch() {
  if [[ -n "${WORKTREE_DEFAULT_BRANCH:-}" ]]; then
    echo "$WORKTREE_DEFAULT_BRANCH"
    return
  fi
  local detected
  detected=$(git -C "$PROJECT_ROOT" symbolic-ref refs/remotes/origin/HEAD 2>/dev/null | sed 's|refs/remotes/origin/||')
  echo "${detected:-main}"
}
DEFAULT_BRANCH="$(detect_default_branch)"

# Refresh one remote for ownership discovery. New-work claims must never treat
# an outage or stale remote-tracking refs as proof that a branch is unowned.
fetch_ownership_remote() {
  local remote="$1" output=""
  if output="$(git_with_github_https_auth -C "$PROJECT_ROOT" fetch --prune "$remote" 2>&1)"; then
    return 0
  fi
  echo "Error: Could not refresh remote '$remote' for authoritative worktree ownership discovery." >&2
  [[ -n "$output" ]] && sed 's/^/  /' <<<"$output" >&2
  return 1
}

# Discovered ls-remote --heads output per remote. Bash 3.2 (macOS system
# bash) has no associative arrays, so the map is a pair of parallel indexed
# arrays scanned linearly; it stays tiny (one entry per reachable remote).
OWNERSHIP_REMOTE_HEAD_NAMES=()
OWNERSHIP_REMOTE_HEAD_REFS=()

ownership_heads_for_remote() {
  local remote="$1" i
  for ((i = 0; i < ${#OWNERSHIP_REMOTE_HEAD_NAMES[@]}; i++)); do
    if [[ "${OWNERSHIP_REMOTE_HEAD_NAMES[$i]}" == "$remote" ]]; then
      printf '%s\n' "${OWNERSHIP_REMOTE_HEAD_REFS[$i]}"
      return 0
    fi
  done
  return 1
}

discover_ownership_remote_heads() {
  local strict_secondary="${1:-false}"
  local remotes=()
  local remote="" output="" have_origin=false i
  while IFS= read -r remote; do
    [[ -n "$remote" ]] || continue
    remotes+=("$remote")
    if [[ "$remote" == "origin" ]]; then
      have_origin=true
    fi
  done < <(git -C "$PROJECT_ROOT" remote)
  if [[ "$have_origin" != true ]]; then
    echo "Error: Remote 'origin' is required for authoritative worktree ownership discovery." >&2
    return 1
  fi

  OWNERSHIP_REMOTE_HEAD_NAMES=()
  OWNERSHIP_REMOTE_HEAD_REFS=()
  for ((i = 0; i < ${#remotes[@]}; i++)); do
    remote="${remotes[$i]}"
    if ! output="$(git_with_github_https_auth -C "$PROJECT_ROOT" ls-remote --heads "$remote" 2>&1)"; then
      if [[ "$remote" == "origin" ]]; then
        echo "Error: Could not query remote 'origin' for authoritative worktree ownership discovery." >&2
        [[ -n "$output" ]] && sed 's/^/  /' <<<"$output" >&2
        return 1
      fi
      if [[ "$strict_secondary" == true ]]; then
        echo "Error: Could not query remote '$remote'; local-only branch recovery requires every configured remote to be authoritative." >&2
        [[ -n "$output" ]] && sed 's/^/  /' <<<"$output" >&2
        return 1
      fi
      # An unreachable secondary remote cannot receive another session's
      # pushes, so skipping it cannot hide active ownership; only origin is
      # authoritative for new-work claims.
      echo "warning: skipping unreachable remote '$remote' for ownership discovery" >&2
      continue
    fi
    OWNERSHIP_REMOTE_HEAD_NAMES+=("$remote")
    OWNERSHIP_REMOTE_HEAD_REFS+=("$output")
  done
}

# Explicit owner reuse still requires a fresh origin before rebasing.
fetch_origin() {
  fetch_ownership_remote origin
}

# Recovery must refresh only the default branch's remote-tracking ref. An
# ordinary `git fetch --prune origin` honors configured fetch refspecs, which
# may target refs/heads/* in mirror-style repositories and delete or rewrite
# the local-only branch we are trying to preserve. The explicit refspec
# bypasses remote.origin.fetch; no-prune/no-tags constrain all other refs.
fetch_recovery_default_branch() {
  local output=""
  if output="$(git_with_github_https_auth -C "$PROJECT_ROOT" fetch --no-tags --no-prune --no-recurse-submodules origin "+refs/heads/$DEFAULT_BRANCH:refs/remotes/origin/$DEFAULT_BRANCH" 2>&1)"; then
    return 0
  fi
  echo "Error: Could not safely refresh origin/$DEFAULT_BRANCH for local-only branch recovery." >&2
  [[ -n "$output" ]] && sed 's/^/  /' <<<"$output" >&2
  return 1
}

worktree_path() {
  validate_issue_id "$1" || return 1
  echo "$TREES_DIR/$(echo "$1" | tr '[:upper:]' '[:lower:]')"
}

issue_branch_name() {
  echo "$1" | tr '[:upper:]' '[:lower:]'
}

current_checkout_path_for_issue() {
  local issue="$1"
  local expected_branch current_root current_branch
  expected_branch="$(issue_branch_name "$issue")"
  current_root="$(git rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n "$current_root" ]] || return 1
  current_branch="$(git -C "$current_root" branch --show-current 2>/dev/null || true)"
  [[ -n "$current_branch" && "$current_branch" == "$expected_branch" ]] || return 1
  printf '%s\n' "$current_root"
}

# Idempotently append a worktree-relative path to the COMMON git-dir's
# info/exclude so git treats the symlink we lay down as ignored content.
# Required because .gitignore patterns with a trailing slash (e.g. `.agents/`)
# match only real directories, not symlinks pointing at directories — without
# the exclude entry, `git status` lists the symlink as untracked and
# `worktree remove` refuses without --force. Git does NOT consult the
# per-worktree git-dir's info/exclude; only the common dir's is read
# (https://git-scm.com/docs/gitignore#_pattern_format), so we must write
# there.
#
# That shared file is the problem this function has to work around (#878). The
# entry is meant for a SYMLINK in a worktree, but it lands in a file every
# checkout of the repo reads — including main, where the same path is a REAL
# directory. A bare `harness` entry therefore marks that whole directory ignored
# in main, and `git add harness/tracked-file` starts refusing with "The
# following paths are ignored by one of your .gitignore files" while `git
# status` still lists the file as modified. It outlives the worktree, too.
#
# The fix uses the very asymmetry documented above: a TRAILING-SLASH pattern
# matches a real directory but NOT a symlink pointing at one. So when the path
# has tracked content, follow the bare entry with `!<path>/`, which re-includes
# the real directory in main while leaving the worktree's symlink ignored. Order
# matters — gitignore takes the LAST matching pattern — so the negation is
# always rewritten after the bare entry.
#
# The negation is added ONLY when the path actually holds tracked files.
# Runtime-only paths (the common case — vstack's own `.agents` mirror is hidden
# in main by this entry alone, with no .gitignore rule behind it) must keep the
# plain blanket entry, or main fills with untracked noise. The condition is
# re-evaluated on every call, so a path that gains or loses tracked content
# self-heals in both directions.
#
# Other tools write to this file too (Claude Code adds its own `**/.claude/*`
# entries), so only our own exact lines are ever added or removed.
exclude_from_worktree_index() {
  local wt="$1" path="$2" has_tracked="${3:-false}"
  [[ -z "$path" ]] && return 0
  local common_dir info_exclude negation tmp
  common_dir="$(git -C "$wt" rev-parse --git-common-dir 2>/dev/null)" || return 0
  info_exclude="$common_dir/info/exclude"
  negation="!$path/"
  mkdir -p "$(dirname "$info_exclude")"

  # Drop any existing negation first: when it is still wanted it gets appended
  # below, which also guarantees it sits AFTER the bare entry.
  if [[ -f "$info_exclude" ]] && grep -qxF "$negation" "$info_exclude" 2>/dev/null; then
    tmp="$info_exclude.wt-tmp.$$"
    if grep -vxF "$negation" "$info_exclude" > "$tmp" 2>/dev/null; then
      mv "$tmp" "$info_exclude"
    else
      rm -f "$tmp" 2>/dev/null
    fi
  fi

  grep -qxF "$path" "$info_exclude" 2>/dev/null || echo "$path" >> "$info_exclude"
  [[ "$has_tracked" == true ]] && echo "$negation" >> "$info_exclude"
  return 0
}

# Replace "$2" with a symlink to "$1" without ever leaving "$2" absent.
#
# The naive `rm` + `ln` pair has an observable window between the two calls in
# which the destination exists in neither state, so a crash, a signal, or a
# concurrent reader lands on a missing path (#857). Building the link under a
# temp name in the same directory and renaming it over the destination closes
# that window: rename(2) is atomic and replaces the old entry in place.
#
# The destination must NOT be followed when it is a symlink to a directory —
# which is the normal steady state here, since these links point at dirs like
# `.agents`. A plain `mv` would deposit the temp link *inside* the target. GNU
# spells "treat the destination as a plain name" as `mv -T`, BSD/macOS spells
# it `mv -h`, and neither accepts the other's flag; try both so this works on
# the Bash 3.2 / BSD-userland macOS boxes the skill supports.
#
# Returns non-zero WITHOUT touching the destination when neither flag is
# available, so callers keep the historical rm+ln behaviour as a fallback.
atomic_symlink_swap() {
  local src="$1" dst="$2" tmp
  tmp="$dst.wt-tmp.$$"
  rm -f "$tmp" 2>/dev/null
  ln -s "$src" "$tmp" 2>/dev/null || return 1
  if mv -T "$tmp" "$dst" 2>/dev/null || mv -h "$tmp" "$dst" 2>/dev/null; then
    return 0
  fi
  rm -f "$tmp" 2>/dev/null
  return 1
}

# Sets $CIE_EXACT and $CIE_DESCENDANTS (non-empty = true) for whether $rel is
# tracked as an exact leaf entry (file, symlink, or gitlink), or has tracked
# descendants beneath it, in $repo's index.
#
# NUL-delimited throughout (#875): git's default `ls-files` output quotes
# names containing quotes, backslashes, tabs, or non-ASCII bytes (e.g. prints
# `"a\"b"` for a file literally named `a"b`), so comparing that display form
# against the raw filesystem name with `grep -Fx` silently mismatches those
# names — misclassifying a tracked leaf as untracked and symlinking over it.
# `-z` output is never quoted, so the NUL-split entries can be compared
# byte-for-byte against $rel.
classify_index_entry() {
  local repo="$1" rel="$2" hit=""
  CIE_EXACT=""
  CIE_DESCENDANTS=""
  while IFS= read -r -d '' hit; do
    if [[ "$hit" == "$rel" ]]; then
      CIE_EXACT=1
    else
      CIE_DESCENDANTS=1
    fi
  done < <(git -C "$repo" ls-files -z -- ":(literal)$rel" 2>/dev/null)
}

# Provision a WORKTREE_SYMLINKS directory entry that shadows tracked paths by
# linking its UNTRACKED children individually (VST-37). Linking the parent
# wholesale forced the tracked files underneath it assume-unchanged, so git
# could no longer WRITE them in the worktree: checkout/merge/cherry-pick
# touching the tracked subtree failed while `git status` looked clean, and a PR
# updating that subtree could not be taken in any worktree. Instead the entry
# stays a REAL directory, tracked paths stay real files git owns, and each
# untracked child gets the ordinary symlink treatment — recursing into children
# that mix tracked and untracked content. Same result as hand-enumerating the
# untracked subpaths in WORKTREE_SYMLINKS, with nothing to maintain per
# consumer (a newly installed skill is linked on the next create/repair).
link_untracked_children() {
  local path="$1" wt="$2" depth="${3:-0}"
  local src="$PROJECT_ROOT/$path"
  local dst="$wt/$path"
  local child="" name="" rel="" f="" unresolved="" restore_failed=false
  local -a shadowed=()

  # Symlinked sources make the tracked/untracked walk cyclic; eight levels is
  # far beyond any real layout, so deeper nesting is reported, not resolved.
  if [[ "$depth" -ge 8 ]]; then
    echo "Warning: WORKTREE_SYMLINKS entry '$path' nests tracked content deeper than 8 levels; its children were not linked." >&2
    return 1
  fi

  # A parent link from an earlier run (or an older skill version) hides the
  # tracked files and holds their assume-unchanged bits: undo both, then
  # restore only the tracked files that are MISSING — a blanket checkout of
  # the pathspec would also revert files the branch legitimately modified.
  # NUL-delimited throughout (#846): a line-oriented list, or piping it through
  # xargs, breaks on filenames with spaces, tabs, or quotes, silently leaving
  # their assume-unchanged bit set. `xargs -r` is also GNU-only and unavailable
  # on the BSD userland this script supports.
  while IFS= read -r -d '' f; do
    shadowed[${#shadowed[@]}]="$f"
  done < <(git -C "$wt" ls-files -z -- "$path/" 2>/dev/null)
  if [[ -L "$dst" ]] && ! rm -f "$dst" 2>/dev/null; then
    echo "Warning: could not replace the '$path' symlink in $wt with a real directory; its tracked files stay shadowed." >&2
    return 1
  fi
  if ! mkdir -p "$dst" 2>/dev/null; then
    echo "Warning: could not create '$path' in $wt; tracked files under it may be missing." >&2
    return 1
  fi
  if [[ ${#shadowed[@]} -gt 0 ]]; then
    # Failures here are not swallowed (#850): a locked index or unwritable
    # destination must surface as a blocked repair, not a silent success —
    # callers (repair_worktree_links, the auto-repair hooks) key their own
    # success reporting off this function's return value.
    if ! git -C "$wt" update-index --no-assume-unchanged -- "${shadowed[@]}" 2>/dev/null; then
      echo "Warning: could not clear the assume-unchanged bit on tracked file(s) under '$path' in $wt; they may still be hidden from git writes." >&2
      restore_failed=true
    fi
    for f in "${shadowed[@]}"; do
      [[ ! -e "$wt/$f" && ! -L "$wt/$f" ]] || continue
      if ! git -C "$wt" checkout -- "$f" 2>/dev/null; then
        echo "Warning: could not restore tracked file '$f' under '$path' in $wt from the index; it may be missing." >&2
        restore_failed=true
      fi
    done
  fi

  # A failed tracked-restore leaves this entry's git-owned state unknown;
  # proceeding to (re)link children around it would layer new writes on a
  # worktree the heal could not bring to a known-good base. Leave the entry
  # exactly as found (the warnings above name what failed) and re-signal —
  # repair-links is the retry.
  if [[ "$restore_failed" == true ]]; then
    echo "Warning: skipping child linking under '$path' in $wt until the tracked restore above succeeds; re-run repair-links." >&2
    return 1
  fi

  local exact="" descendants=""
  for child in "$src"/* "$src"/.[!.]* "$src"/..?*; do
    [[ -e "$child" || -L "$child" ]] || continue
    name="${child##*/}"
    rel="$path/$name"
    # Decide from the INDEX, not the filesystem type of $child: [[ -d ]]
    # follows symlinks, so a tracked symlink whose target happens to be a
    # directory would otherwise be misread as a mixed tracked directory and
    # recursed into, and the recursive call would then replace that tracked
    # symlink with a real one (#856). An exact index entry for $rel — file,
    # symlink, or gitlink alike — is always a leaf git owns outright; only the
    # absence of an exact entry alongside tracked descendants means $rel is a
    # real tracked directory worth recursing into.
    #
    # Ask BOTH indexes (#964 above does the same for the top-level shape
    # decision): a worktree branch that predates the commit which started
    # tracking $rel on main sees nothing in its own index, and would otherwise
    # be classified as untracked and get a symlink laid down right where the
    # eventual merge needs to write a real tracked entry, obstructing it.
    classify_index_entry "$wt" "$rel"
    exact="$CIE_EXACT"; descendants="$CIE_DESCENDANTS"
    classify_index_entry "$PROJECT_ROOT" "$rel"
    [[ -n "$CIE_EXACT" ]] && exact=1
    [[ -n "$CIE_DESCENDANTS" ]] && descendants=1
    if [[ -z "$exact" && -z "$descendants" ]]; then
      # Nothing tracked here: ordinary symlink treatment, own exclude entry.
      # Quarantine-checked (#1317): this child may have materialized as a real
      # file or directory holding untracked user data since the last repair,
      # and symlink_into_worktree itself has no quarantine of its own — it
      # would rm -rf/overwrite that data on the direct call this replaces.
      quarantine_and_relink_path "$wt" "$rel" || unresolved="$unresolved  - $rel (linking failed or blocked — see warning above)"$'\n'
    elif [[ -n "$exact" ]]; then
      # A tracked leaf (in this branch, or on main and not yet merged here):
      # leave it to git — a symlink here would collide with either the
      # checkout's own copy or the merge that will introduce one.
      :
    else
      local nest_reason="nested link failure"
      [[ $((depth + 1)) -ge 8 ]] && nest_reason="nested past the 8-level depth limit"
      link_untracked_children "$rel" "$wt" $((depth + 1)) || unresolved="$unresolved  - $rel ($nest_reason — see warning above)"$'\n'
    fi
  done

  # restore_failed returned early above; only unresolved children reach here.
  if [[ -n "$unresolved" ]]; then
    {
      echo "Warning: WORKTREE_SYMLINKS entry '$path' shadows tracked paths and these children could not be resolved:"
      printf '%s' "$unresolved"
      echo "  Tracked paths were left to git; narrow the entry to the untracked subpaths to silence this."
    } >&2
    return 1
  fi
  return 0
}

symlink_into_worktree() {
  local path="$1" wt="$2"
  local src="$PROJECT_ROOT/$path"
  local dst="$wt/$path"

  # Every worktree-local symlink we create should be invisible to git status
  # in this worktree, regardless of whether the source dir has tracked files.
  ensure_worktree_path_safe "$wt" "$path" false || return 1
  if [[ -f "$src" && -e "$dst" && ! -L "$dst" && ! -f "$dst" ]]; then
    echo "Error: refusing to replace non-file worktree path '$path' with a file symlink." >&2
    return 1
  fi
  # Whether this path holds tracked content decides the SHAPE of the exclude
  # entry (#878): a path with tracked files needs the `!<path>/` negation so the
  # real directory in the main checkout stays stageable. Covers both the file
  # entry and the directory's contents, so it is computed once here rather than
  # separately in each branch below.
  #
  # Ask BOTH indexes. The damage this guards against lands in the main checkout,
  # so main is the authority — a worktree branch that predates the commit which
  # started tracking the path would otherwise report "untracked" and leave main
  # broken. Either index seeing tracked content is enough: the negation only
  # re-includes a REAL directory, so it is inert in a worktree where the path is
  # a symlink.
  local tracked_here=false
  if [[ -n "$(git -C "$wt" ls-files -- "$path" "$path/" 2>/dev/null || true)" ]] ||
     [[ -n "$(git -C "$PROJECT_ROOT" ls-files -- "$path" "$path/" 2>/dev/null || true)" ]]; then
    tracked_here=true
  fi
  exclude_from_worktree_index "$wt" "$path" "$tracked_here"

  if [[ -f "$src" ]]; then
    # File symlink — if the path is tracked in the worktree (common before a
    # project stops committing harness config files), mark it assume-unchanged
    # so replacing it with a symlink does not leave a noisy typechange.
    if git -C "$wt" ls-files --error-unmatch "$path" >/dev/null 2>&1; then
      git -C "$wt" update-index --assume-unchanged "$path" 2>/dev/null || true
    fi
    mkdir -p "$(dirname "$dst")"
    if [[ -e "$dst" && ! -L "$dst" && ! -f "$dst" ]]; then
      echo "Error: refusing to replace non-file worktree path '$path' with a file symlink." >&2
      return 1
    fi
    # File/symlink destinations can be replaced by rename with no window at all.
    atomic_symlink_swap "$src" "$dst" || { rm -f "$dst"; ln -s "$src" "$dst"; }
  elif [[ -d "$src" ]]; then
    # Directory entry. When this worktree tracks files under it, linking the
    # parent would shadow them (assume-unchanged left git unable to WRITE them:
    # cherry-pick/checkout/merge failed while `git status` looked clean, and
    # tracked files under a symlinked dir are the generator of link clobbering
    # — a rebase that must write them replaces the symlink with a real
    # directory). Act on the detection instead (VST-37): keep the entry a real
    # directory and link only its untracked children.
    # Ask BOTH indexes (#899 above does the same for the exclude-entry shape):
    # a worktree branch that predates the commit which started tracking this
    # path sees nothing in its own index, but main tracking it is still enough
    # reason to reserve the real-directory shape now, before the merge that
    # brings the tracked content into this branch lands. Restoring files below
    # still reads only the worktree's own index — main's content isn't checked
    # out here yet.
    local shadowed=false
    if [[ -n "$(git -C "$wt" ls-files -- ":(literal)$path/" 2>/dev/null)" ]] ||
       [[ -n "$(git -C "$PROJECT_ROOT" ls-files -- ":(literal)$path/" 2>/dev/null || true)" ]]; then
      shadowed=true
    fi
    if [[ "$shadowed" == true ]]; then
      link_untracked_children "$path" "$wt"
      return $?
    fi

    mkdir -p "$(dirname "$dst")"
    # A REAL directory here (rebase replaces symlinks with real directories when
    # tracked files exist underneath) cannot be replaced by rename, so it still
    # has to be removed first and that window is unavoidable. Everything else —
    # including the normal case, a symlink to a directory — goes through the
    # atomic swap. Where the removal is needed, the replacement link is already
    # built, so the gap is a single rename rather than an rm plus a symlink.
    if [[ -d "$dst" && ! -L "$dst" ]]; then
      rm -rf "$dst" 2>/dev/null
    fi
    atomic_symlink_swap "$src" "$dst" || { rm -rf "$dst" 2>/dev/null; ln -sfn "$src" "$dst"; }
  fi
}

# Apply all symlinks and copies to a worktree
# Detect a materialized harness directory at USE time (#856).
#
# A rebase replaces a configured symlink with a real directory holding only the
# tracked files underneath it, dropping every vstack-installed path there. The
# worktree then looks clean to git — `git status` reports nothing, so
# `git checkout --` is a no-op — and the damage only surfaces later as scripts
# failing exit 127 on files they used to be able to source.
#
# This is deliberately a WARNING, not a failure: the command the operator asked
# for may not touch the affected paths, and a hard error would be a regression
# for them. It runs at the points where materialization has just become likely
# (post-rebase). Since #1032 the stock post-checkout/post-merge/post-rewrite
# hooks also auto-repair (see install_worktree_autorepair_hooks); this warning
# stays as the backstop for repos where the hooks could not be installed.
# `core.hooksPath` remains the wrong mechanism either way: it replaces the
# hooks directory wholesale and would disable the consumer's own hooks.
# Recurse through a tracked-content WORKTREE_SYMLINKS entry the same way
# link_untracked_children does, printing (one per line) any untracked child
# that should be a symlink but is a real path instead. warn_if_links_
# materialized's parent-only check (#979) treats "real directory with tracked
# content underneath" as proof the whole entry is healthy, but a rebase or
# checkout can materialize just an untracked CHILD several levels down while
# leaving the tracked files at the top untouched — that damage needs the same
# per-child walk to surface.
collect_materialized_child_links() {
  local path="$1" wt="$2" depth="${3:-0}"
  local src="$PROJECT_ROOT/$path" child="" name="" rel="" exact="" descendants="" capped=""
  # Depth-capped like link_untracked_children (#846), but this function
  # reports rather than repairs: silently returning "no damage found" here
  # (as opposed to link_untracked_children's warning + nonzero return) gave
  # warn_if_links_materialized a false-negative "healthy" verdict for a
  # subtree nested past the cap, even when a materialized child sits there.
  # Emit a line the caller folds into its own warning instead.
  if [[ "$depth" -ge 8 ]]; then
    printf '%s (nests deeper than 8 levels — not inspected)\n' "$path"
    return 1
  fi
  for child in "$src"/* "$src"/.[!.]* "$src"/..?*; do
    [[ -e "$child" || -L "$child" ]] || continue
    name="${child##*/}"
    rel="$path/$name"
    # See link_untracked_children (#856, #964) for why this must be a
    # literal-equal filter checked against BOTH indexes: a bare directory
    # pathspec also matches every tracked descendant, and a child tracked
    # only on main (branch predates it) must classify the same way here as it
    # does when links are created/repaired, or this diagnostic disagrees with
    # what the repair path actually considers healthy.
    classify_index_entry "$wt" "$rel"
    exact="$CIE_EXACT"; descendants="$CIE_DESCENDANTS"
    classify_index_entry "$PROJECT_ROOT" "$rel"
    [[ -n "$CIE_EXACT" ]] && exact=1
    [[ -n "$CIE_DESCENDANTS" ]] && descendants=1
    if [[ -z "$exact" && -z "$descendants" ]]; then
      [[ -e "$wt/$rel" && ! -L "$wt/$rel" ]] && printf '%s\n' "$rel"
    elif [[ -z "$exact" ]]; then
      # `|| capped=1`: a depth-capped deeper subtree must not abort this
      # loop under set -e — siblings still get inspected; the cap outcome
      # is re-signaled once at the end.
      collect_materialized_child_links "$rel" "$wt" $((depth + 1)) || capped=1
    fi
  done
  [[ -z "$capped" ]]
}

warn_if_links_materialized() {
  local wt="$1" path="" materialized="" rel="" child_damage=""
  [[ -n "$wt" && -d "$wt" ]] || return 0
  validate_worktree_setup_config >/dev/null 2>&1 || return 0

  split_worktree_config_words "${WORKTREE_SYMLINKS:-}"
  for path in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    path="$(normalize_worktree_config_path WORKTREE_SYMLINKS "$path" 2>/dev/null)" || continue
    # Only a path that SHOULD be a link and exists as a non-link is damage.
    [[ -e "$PROJECT_ROOT/$path" ]] || continue
    if [[ -e "$wt/$path" && ! -L "$wt/$path" ]]; then
      # An entry with tracked content underneath is a real directory BY DESIGN
      # (VST-37): per-child links live inside it, not a parent link — but its
      # untracked children still need to be actual links (#979).
      if [[ -d "$wt/$path" && -n "$(git -C "$wt" ls-files -- "$path/" 2>/dev/null)" ]]; then
        # `|| true`: the collector returns nonzero when a depth-capped
        # subtree could not be fully inspected — that is a REPORTING
        # outcome folded into the warning below, and under set -e an
        # unguarded substitution would abort the whole command (push) over
        # a warning-grade condition.
        child_damage="$(collect_materialized_child_links "$path" "$wt")" || true
        if [[ -n "$child_damage" ]]; then
          while IFS= read -r rel; do
            [[ -n "$rel" ]] || continue
            materialized="$materialized  - $rel"$'\n'
          done <<<"$child_damage"
        fi
        continue
      fi
      materialized="$materialized  - $path"$'\n'
    fi
  done

  [[ -n "$materialized" ]] || return 0
  {
    echo "Warning: harness paths in this worktree are real directories, not symlinks:"
    printf '%s' "$materialized"
    echo "  A rebase materialized them, so vstack-installed files under those paths are gone."
    echo "  git status will look clean — it tracks only the files that survived."
    echo "  Restore them by running fix-links FROM THE MAIN CHECKOUT, because this"
    echo "  worktree's own copy of the script may be among the missing files:"
    echo "    cd '$PROJECT_ROOT' && .agents/skills/worktree/scripts/worktree fix-links '$wt'"
  } >&2
  return 0
}

# ─── Git-hook auto-repair (#1032) ────────────────────────────────────────────
#
# The clobber that materializes a configured symlink happens at git-operation
# time — rebase, merge, branch checkout — from any harness or a plain human
# shell, so the use-time warning above only catches the flows this script sees.
# The universal interception point is git itself: worktrees resolve hooks to
# the MAIN checkout's hooks directory (`git rev-parse --git-path hooks` from a
# worktree yields main's hooks dir), so one installation covers every worktree
# and every harness.
#
# `core.hooksPath` is deliberately NOT used — it replaces the hooks directory
# wholesale and would disable a consumer's own hooks. Instead the three stock
# hooks that follow the destructive operations (post-checkout, post-merge,
# post-rewrite) are created, or appended-to when they already exist, with one
# marked delegating line; the actual logic lives in a helper file this script
# owns outright and rewrites on every install.

readonly WORKTREE_AUTOREPAIR_HELPER="vstack-worktree-autorepair"
readonly WORKTREE_AUTOREPAIR_HOOKS="post-checkout post-merge post-rewrite"

# The helper is POSIX sh and self-contained: it resolves the main checkout
# from the common git dir, no-ops there, and otherwise delegates to this
# script's repair-links from the main checkout (the worktree's own copy may be
# among the clobbered files). stdin is redirected away because post-rewrite
# feeds the rewritten-commit list on stdin and the repair must not consume it
# from any hook content composed after ours. It never fails the git operation.
write_worktree_autorepair_helper() {
  local helper="$1" tmp=""
  # The name is vstack-namespaced, but the non-destructive contract holds
  # even against a collision: never write through a symlink, never replace a
  # non-regular file, and never overwrite content missing our marker. Our
  # own helper is rewritten on every install, via atomic rename.
  if [[ -L "$helper" ]] || [[ -e "$helper" && ! -f "$helper" ]]; then
    echo "Warning: $helper exists and is not a regular file; refusing to replace it." >&2
    return 1
  fi
  if [[ -f "$helper" ]] && ! grep -q "vstack worktree auto-repair" "$helper" 2>/dev/null; then
    echo "Warning: $helper exists but was not written by the worktree skill; refusing to overwrite it." >&2
    return 1
  fi
  tmp="$helper.tmp.$$"
  cat >"$tmp" <<'HELPER' || { rm -f "$tmp"; return 1; }
#!/bin/sh
# vstack worktree auto-repair (#1032). Managed by the worktree skill and
# rewritten on every install — do not edit. Re-asserts configured
# WORKTREE_SYMLINKS entries in a linked worktree after a git operation that
# can re-materialize them as real directories. Never fails the git operation.
common="$(git rev-parse --git-common-dir 2>/dev/null)" || exit 0
[ -n "$common" ] || exit 0
case "$common" in /*) ;; *) common="$PWD/$common" ;; esac
main="$(dirname "$common")"
top="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
[ -n "$top" ] || exit 0
main_phys="$(cd "$main" 2>/dev/null && pwd -P)" || exit 0
top_phys="$(cd "$top" 2>/dev/null && pwd -P)" || exit 0
# The main checkout's configured paths are real directories by design.
[ "$top_phys" = "$main_phys" ] && exit 0
for script in "$main_phys/.agents/skills/worktree/scripts/worktree" \
              "$main_phys/skills/worktree/scripts/worktree"; do
  if [ -x "$script" ]; then
    "$script" repair-links "$top_phys" </dev/null || :
    break
  fi
done
exit 0
HELPER
  chmod +x "$tmp" 2>/dev/null && mv -f "$tmp" "$helper" || {
    rm -f "$tmp"
    return 1
  }
}

# Install (or refresh) the shared auto-repair hooks in the common hooks dir.
# Best-effort by design: every failure is a warning and exit 0, because a repo
# where the hooks cannot be written must still get a fully provisioned
# worktree — it just keeps only the use-time materialization warning.
install_worktree_autorepair_hooks() {
  local hooks_dir="" hook="" hook_path="" custom_hooks=""
  # The delegating line must be exit-status transparent when appended to an
  # existing hook: post-checkout's exit status becomes git's, so a consumer
  # hook whose final command deliberately returns nonzero must keep doing so.
  # $? is captured first and re-asserted last (in a subshell, so hook content
  # a later tool appends after this line still runs).
  local call_line='vstack_wt_rc=$?; vstack_wt_hooks_dir="$(git rev-parse --git-path hooks 2>/dev/null)" && [ -x "$vstack_wt_hooks_dir/vstack-worktree-autorepair" ] && "$vstack_wt_hooks_dir/vstack-worktree-autorepair" "$@" || :; ( exit "$vstack_wt_rc" )  # vstack-worktree-autorepair'

  custom_hooks="$(git -C "$PROJECT_ROOT" config --get core.hooksPath 2>/dev/null || true)"
  if [[ -n "$custom_hooks" ]]; then
    echo "Warning: core.hooksPath is set ('$custom_hooks'); the worktree auto-repair git hooks were NOT installed." >&2
    echo "  Have your post-checkout/post-merge/post-rewrite hooks run: $0 repair-links" >&2
    return 0
  fi

  hooks_dir="$PROJECT_COMMON_GIT_DIR/hooks"
  if ! mkdir -p "$hooks_dir" 2>/dev/null; then
    echo "Warning: could not create $hooks_dir; the worktree auto-repair git hooks were NOT installed." >&2
    return 0
  fi
  if ! write_worktree_autorepair_helper "$hooks_dir/$WORKTREE_AUTOREPAIR_HELPER"; then
    echo "Warning: could not write $hooks_dir/$WORKTREE_AUTOREPAIR_HELPER; the worktree auto-repair git hooks were NOT installed." >&2
    return 0
  fi

  for hook in $WORKTREE_AUTOREPAIR_HOOKS; do
    hook_path="$hooks_dir/$hook"
    # A symlinked hook points at a shared or externally managed target —
    # writing through it (live) or materializing its target (dangling, which
    # passes `! -e`) would modify content this install does not own.
    if [[ -L "$hook_path" ]]; then
      echo "Warning: $hook_path is a symlink; not modifying its target." >&2
      echo "  Have it run: $0 repair-links" >&2
      continue
    fi
    if [[ ! -e "$hook_path" ]]; then
      printf '#!/bin/sh\n%s\n' "$call_line" >"$hook_path" 2>/dev/null || {
        echo "Warning: could not write $hook_path; auto-repair will not run on $hook." >&2
        continue
      }
      chmod +x "$hook_path" 2>/dev/null || true
      continue
    fi
    # Compose with existing hook content, never overwrite it. The marker makes
    # the append idempotent across create/fix-links runs.
    if grep -qF "$WORKTREE_AUTOREPAIR_HELPER" "$hook_path" 2>/dev/null; then
      continue
    fi
    if [[ ! -x "$hook_path" ]]; then
      echo "Warning: $hook_path exists but is not executable (a disabled hook); not appending the auto-repair line to it." >&2
      continue
    fi
    if ! head -n 1 "$hook_path" | grep -qE '^#!.*(sh|bash|dash|ksh|zsh)([[:space:]]|$)'; then
      echo "Warning: $hook_path is not a shell script; not appending the auto-repair line." >&2
      echo "  Have it run: $0 repair-links" >&2
      continue
    fi
    # Guarantee our line starts on its own line even when the existing hook
    # has no trailing newline.
    if [[ -s "$hook_path" && -n "$(tail -c 1 "$hook_path" 2>/dev/null)" ]]; then
      printf '\n' >>"$hook_path"
    fi
    printf '%s\n' "$call_line" >>"$hook_path"
  done
  return 0
}

# Entries inside a quarantined (moved-aside) materialized path that forbid an
# automatic re-link. The tracked skeleton (e.g. a lone .cache/.gitkeep) is
# exactly what a git operation re-materializes, so a copy holding ONLY tracked
# files at their index content is safe to discard; anything beyond it is not:
#   - any entry git does not track, of ANY type — FIFOs, sockets, devices and
#     empty untracked directories included (untracked OR ignored data — a
#     worktree-local cache is ignored data);
#   - a tracked name whose content, kind, or exec bit differs from the index
#     (assume-unchanged hides such edits from git status, so only a direct
#     compare sees them);
#   - anything that could not be scanned or read — fail closed, never "empty".
# Names print relative to the configured path; any output means blocked.
worktree_quarantine_unsafe_entries() {
  local wt="$1" path="$2" qdir="$3" rc=0 raw="" empties="" disk="" tracked=""
  local name="" meta="" mode="" oid="" actual=""

  if [[ ! -d "$qdir" || -L "$qdir" ]]; then
    # The materialized path is a single non-directory entry: safe only when
    # git tracks $path itself as a regular file with identical content.
    if [[ "$(git -C "$wt" ls-files -- "$path" 2>/dev/null)" != "$path" ]]; then
      printf '%s (untracked)\n' "$path"
      return 0
    fi
    worktree_tracked_entry_mismatch "$wt" "$path" "$path" "$qdir"
    return 0
  fi

  raw="$(find "$qdir" ! -type d 2>/dev/null)" || rc=$?
  if [[ "$rc" -eq 0 ]]; then
    empties="$(find "$qdir" -mindepth 1 -type d -empty 2>/dev/null)" || rc=$?
  fi
  if [[ "$rc" -ne 0 ]]; then
    printf '[scan failed: could not enumerate entries under %s (exit %s)]\n' "$path" "$rc"
    return 0
  fi
  # An empty untracked directory is never part of the skeleton — git creates
  # directories only to hold tracked files. No regex: paths are stripped with
  # literal parameter expansion (a path may contain sed metacharacters, and a
  # broken sed expression would fail OPEN as an empty listing).
  if [[ -n "$empties" ]]; then
    while IFS= read -r name; do
      [[ -n "$name" ]] || continue
      printf '%s/%s (empty untracked directory)\n' "$path" "${name#"$qdir"/}"
    done <<<"$empties"
  fi
  disk="$(while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    printf '%s\n' "${name#"$qdir"/}"
  done <<<"$raw" | LC_ALL=C sort)" || {
    printf '[scan failed: could not sort the inventory]\n'
    return 0
  }
  # A filename containing a newline shreds a line-delimited inventory into
  # fragments (or, for a pure-newline name, into nothing once command
  # substitution strips trailing newlines). Cross-check the reconstructed
  # entry count against a NUL-delimited pass — any mismatch blocks rather
  # than risking a deletion decision on a listing that cannot represent the
  # names it saw.
  local n_disk=0 n_nul=0
  n_disk="$(printf '%s' "$disk" | grep -c . || true)"
  n_nul="$(find "$qdir" ! -type d -print0 2>/dev/null | tr -cd '\0' | wc -c | tr -d '[:space:]')" || n_nul=-1
  if [[ "$n_disk" != "$n_nul" ]]; then
    printf '[scan mismatch: %s entries by NUL count vs %s reconstructed line entries — a name this listing cannot represent]\n' "$n_nul" "$n_disk"
    return 0
  fi
  # A failed tracked-listing sort collapses to an empty set, which reads as
  # "everything is untracked" — fail-closed on its own. The comm calls are
  # NOT: a failed comm yields empty output in both directions, which reads
  # as "nothing extra and nothing to verify" — so their exit status must be
  # checked explicitly.
  tracked="$(git -C "$wt" ls-files -- "$path/" 2>/dev/null | while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    printf '%s\n' "${name#"$path"/}"
  done | LC_ALL=C sort)" || tracked=""
  local untracked="" present_tracked="" cmp_rc=0
  untracked="$(LC_ALL=C comm -23 <(printf '%s\n' "$disk") <(printf '%s\n' "$tracked") 2>/dev/null)" || cmp_rc=$?
  if [[ "$cmp_rc" -eq 0 ]]; then
    present_tracked="$(LC_ALL=C comm -12 <(printf '%s\n' "$disk") <(printf '%s\n' "$tracked") 2>/dev/null)" || cmp_rc=$?
  fi
  if [[ "$cmp_rc" -ne 0 ]]; then
    printf '[scan failed: name-set comparison failed (exit %s)]\n' "$cmp_rc"
    return 0
  fi
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    printf '%s/%s\n' "$path" "$name"
  done <<<"$untracked"
  # Tracked names present in the copy must match the index exactly.
  while IFS= read -r name; do
    [[ -n "$name" ]] || continue
    worktree_tracked_entry_mismatch "$wt" "$path/$name" "$path/$name" "$qdir/$name"
  done <<<"$present_tracked"
}

# Print a blocking line iff the on-disk entry differs from the index record
# for the tracked pathspec (content oid, symlink target, kind, or exec bit).
worktree_tracked_entry_mismatch() {
  local wt="$1" spec="$2" label="$3" file="$4" meta="" mode="" oid="" actual=""
  meta="$(git -C "$wt" ls-files -s -- "$spec" 2>/dev/null | head -n 1)"
  mode="${meta%% *}"
  oid="$(printf '%s\n' "$meta" | awk '{print $2}')"
  if [[ -z "$mode" || -z "$oid" ]]; then
    printf '%s (index record unreadable)\n' "$label"
    return 0
  fi
  case "$mode" in
    120000)
      if [[ ! -L "$file" ]]; then
        printf '%s (symlink differs from index)\n' "$label"
        return 0
      fi
      # Sentinel-preserved comparison: bare command substitution strips ALL
      # trailing newlines from both sides, so targets differing only by
      # trailing newline bytes would compare equal and the difference would
      # be discarded. readlink appends exactly one newline of its own;
      # cat-file emits the blob verbatim.
      local disk_target="" index_target=""
      disk_target="$(readlink "$file" 2>/dev/null; printf x)"
      disk_target="${disk_target%x}"
      disk_target="${disk_target%$'\n'}"
      index_target="$(git -C "$wt" cat-file blob "$oid" 2>/dev/null; printf x)"
      index_target="${index_target%x}"
      if [[ "$disk_target" != "$index_target" ]]; then
        printf '%s (symlink differs from index)\n' "$label"
      fi
      ;;
    100644 | 100755)
      if [[ ! -f "$file" || -L "$file" ]]; then
        printf '%s (not the regular file the index records)\n' "$label"
        return 0
      fi
      actual="$(git -C "$wt" hash-object -- "$file" 2>/dev/null)" || actual=""
      if [[ -z "$actual" ]]; then
        printf '%s (unreadable)\n' "$label"
      elif [[ "$actual" != "$oid" ]]; then
        printf '%s (local edits vs index)\n' "$label"
      elif [[ "$mode" == 100755 && ! -x "$file" ]] || [[ "$mode" == 100644 && -x "$file" ]]; then
        printf '%s (exec bit differs from index)\n' "$label"
      fi
      ;;
    *)
      printf '%s (unsupported index mode %s)\n' "$label" "$mode"
      ;;
  esac
}

# Re-link a single WORKTREE_SYMLINKS-managed path, refusing to destroy any
# materialized data that git does not track or that differs from its index
# record. Shared by repair_worktree_links (top-level configured entries) and
# link_untracked_children (untracked children inside a shadowed/tracked-
# content parent, #1317): a materialized CHILD is exactly where a hook racing
# a cache sync, or a rebase, could otherwise silently drop untracked user data
# via symlink_into_worktree's unconditional rm -rf/mv — that function has no
# quarantine of its own, by design, so every call site that might see
# materialized data must quarantine-check before calling it.
#
# The materialized path is atomically renamed aside BEFORE inspection: a
# writer racing the scan by path lands in a freshly-created directory (or
# fails with ENOENT), never in the tree being judged, and a blocked copy is
# renamed back intact. A writer holding an already-open fd into the old tree
# can still lose post-scan writes — that residual window is unclosable
# without never deleting at all; the by-path race (the incident class: a
# cache sync creating files while the hook runs) is what the rename closes.
#
# Sets QUARANTINE_RELINK_CHANGED=true when this call actually restored the
# link, so callers can distinguish "already healthy" from "just repaired" for
# their own summary reporting. Returns 0 when the path is correctly linked
# (or already was); 1 when blocked, with a warning already printed to stderr
# explaining why and how to repair manually.
QUARANTINE_RELINK_CHANGED=false
quarantine_and_relink_path() {
  local wt="$1" path="$2" src="$PROJECT_ROOT/$2" dst="$wt/$2" qdir="" extras="" extra_count=0
  QUARANTINE_RELINK_CHANGED=false

  if [[ -L "$dst" ]]; then
    # Healthy steady state; also covers a link re-pointed at a moved main.
    [[ "$(readlink "$dst" 2>/dev/null || true)" == "$src" ]] && return 0
  elif [[ -e "$dst" ]]; then
    qdir="$dst.vstack-repair.$$"
    if ! mv "$dst" "$qdir" 2>/dev/null; then
      echo "Warning: '$path' in $wt is materialized but could not be moved aside for inspection; leaving it untouched. Repair manually: cd '$PROJECT_ROOT' && $0 fix-links '$wt'" >&2
      return 1
    fi
    extras="$(worktree_quarantine_unsafe_entries "$wt" "$path" "$qdir")"
    if [[ -n "$extras" ]]; then
      if ! mv "$qdir" "$dst" 2>/dev/null; then
        echo "CRITICAL: '$path' data is preserved at '$qdir' but could not be moved back to '$dst' — restore it manually before anything else." >&2
      fi
      extra_count="$(printf '%s\n' "$extras" | grep -c .)"
      {
        echo "Warning: '$path' in $wt should be a symlink to '$src' but is a real path holding $extra_count entr(y/ies) git does not track or that differ from the index:"
        printf '%s\n' "$extras" | head -n 10 | sed 's/^/  - /'
        if [[ "$extra_count" -gt 10 ]]; then
          echo "  ... and $((extra_count - 10)) more"
        fi
        echo "  Auto-repair refuses to destroy untracked data. Move it into '$src' (or delete it),"
        echo "  then restore the link from the main checkout:"
        echo "    cd '$PROJECT_ROOT' && $0 fix-links '$wt'"
      } >&2
      return 1
    fi
    # An active by-path writer may have recreated the path while the old
    # tree was inspected; linking now would delete that fresh data inside
    # symlink_into_worktree. Leave the newcomer for the next hook firing.
    # The quarantined copy is proven index-identical, so discarding it
    # loses nothing git cannot restore.
    if [[ -e "$dst" || -L "$dst" ]]; then
      rm -rf "$qdir"
      echo "Warning: '$path' in $wt reappeared while its materialized copy was being inspected (an active writer?); leaving the new path alone. The next git operation will re-attempt the repair." >&2
      return 1
    fi
    # The quarantined copy is deleted only after the link is in place —
    # a failed relink restores it instead of leaving the path absent.
    if symlink_into_worktree "$path" "$wt"; then
      rm -rf "$qdir"
      QUARANTINE_RELINK_CHANGED=true
      return 0
    fi
    if [[ ! -e "$dst" && ! -L "$dst" ]] && mv "$qdir" "$dst" 2>/dev/null; then
      echo "Warning: relinking '$path' in $wt failed; the materialized copy was restored. Repair manually: cd '$PROJECT_ROOT' && $0 fix-links '$wt'" >&2
    else
      echo "CRITICAL: relinking '$path' in $wt failed and the copy could not be restored — its content is preserved at '$qdir'." >&2
    fi
    return 1
  fi
  if symlink_into_worktree "$path" "$wt"; then
    QUARANTINE_RELINK_CHANGED=true
    return 0
  fi
  return 1
}

# Re-assert configured WORKTREE_SYMLINKS in one worktree. Cheap on the healthy
# path (one readlink per entry); repair is quarantine_and_relink_path above.
repair_worktree_links() {
  local wt="$1" path="" src="" dst="" repaired="" blocked=false
  validate_worktree_setup_config || return 1

  split_worktree_config_words "${WORKTREE_SYMLINKS:-}"
  for path in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    path="$(normalize_worktree_config_path WORKTREE_SYMLINKS "$path" 2>/dev/null)" || continue
    src="$PROJECT_ROOT/$path"
    dst="$wt/$path"
    [[ -e "$src" ]] || continue
    # An entry with tracked content underneath never becomes a parent link
    # (VST-37): its healthy state is a real directory holding per-child links,
    # and symlink_into_worktree heals that state idempotently (clears stale
    # assume-unchanged bits, restores missing tracked files, re-links
    # untracked children — through the same quarantine as any other child,
    # since link_untracked_children calls quarantine_and_relink_path too).
    #
    # Ask BOTH indexes (#964): checking only $wt here means a branch that
    # predates a path becoming tracked on main takes the quarantine branch
    # below instead. If $dst is already a healthy symlink from an earlier run,
    # quarantine_and_relink_path returns success on sight without ever
    # re-deciding the shape, so the entry never converts to the per-child
    # layout main's tracked content now requires.
    if [[ -d "$src" ]] &&
       { [[ -n "$(git -C "$wt" ls-files -- "$path/" 2>/dev/null)" ]] ||
         [[ -n "$(git -C "$PROJECT_ROOT" ls-files -- "$path/" 2>/dev/null || true)" ]]; }; then
      symlink_into_worktree "$path" "$wt" || blocked=true
      continue
    fi
    if quarantine_and_relink_path "$wt" "$path"; then
      [[ "$QUARANTINE_RELINK_CHANGED" == true ]] && repaired="$repaired $path"
    else
      blocked=true
    fi
  done

  if [[ -n "$repaired" ]]; then
    echo "worktree auto-repair: restored symlink(s) in $wt:$repaired" >&2
  fi
  [[ "$blocked" != true ]]
}

# Undo symlink shadowing so git can check out through the configured paths
# (#873, #874).
#
# Since VST-37 `symlink_into_worktree` no longer links a directory entry with
# tracked content underneath (it links the untracked children instead), but a
# worktree provisioned by an older version can still hold the legacy state:
# the configured directory replaced by a symlink and the tracked files under
# it marked --assume-unchanged. Git then refuses any checkout that would
# rewrite those paths — "Your local changes to the following files would be
# overwritten by checkout", ending in "could not detach HEAD" — so `git
# rebase` in the create --reuse/--restack path dies before it starts.
# `git status --porcelain` is empty throughout, because assume-unchanged is
# exactly what hides them, which is what makes the failure so confusing.
#
# Restoring the index's own content as real files removes the conflict without
# touching any user work: what we discard is a symlink the tool itself laid
# down, and the tracked content it hid is recreated from the index verbatim.
# Callers re-apply setup afterwards, which re-links and re-marks the paths.
#
# No-op unless a configured entry actually shadows tracked files, so the
# ordinary runtime-only symlink case is left completely alone.
unshadow_tracked_symlink_paths() {
  local wt="$1" path="" f="" checkout_err=""
  local -a shadowed=() tracked=()
  [[ -n "$wt" && -d "$wt" ]] || return 0
  validate_worktree_setup_config >/dev/null 2>&1 || return 0

  split_worktree_config_words "${WORKTREE_SYMLINKS:-}"
  for path in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    path="$(normalize_worktree_config_path WORKTREE_SYMLINKS "$path" 2>/dev/null)" || continue
    # NUL-delimited (#844): a line-oriented list piped through xargs breaks on
    # filenames with spaces, tabs, or quotes, silently leaving their
    # assume-unchanged bit set; `xargs -r` is also GNU-only.
    tracked=()
    while IFS= read -r -d '' f; do
      tracked[${#tracked[@]}]="$f"
    done < <(git -C "$wt" ls-files -z -- "$path" "$path/" 2>/dev/null)
    [[ ${#tracked[@]} -gt 0 ]] || continue

    # Clear the bit first: while it is set, git will not write these paths even
    # once the link is gone.
    git -C "$wt" update-index --no-assume-unchanged -- "${tracked[@]}" 2>/dev/null || true

    # Only a symlink needs removing. A real directory here means a previous
    # rebase already materialized it (#856); its tracked content is genuine and
    # a checkout can write straight through it.
    if [[ -L "$wt/$path" ]] && ! rm -f "$wt/$path" 2>/dev/null; then
      echo "Error: Could not remove the '$path' symlink in $wt to restore the tracked files it shadows." >&2
      return 1
    fi
    shadowed[${#shadowed[@]}]="$path"
  done

  [[ ${#shadowed[@]} -gt 0 ]] || return 0

  if ! checkout_err="$(git -C "$wt" checkout -- ${shadowed[@]+"${shadowed[@]}"} 2>&1)"; then
    echo "Error: Could not restore the tracked files shadowed by WORKTREE_SYMLINKS in $wt:" >&2
    sed 's/^/  /' <<<"$checkout_err" >&2
    echo "Re-link the worktree, then retry:" >&2
    echo "  cd '$PROJECT_ROOT' && $0 fix-links '$wt'" >&2
    return 1
  fi
  return 0
}

# Re-apply setup after a reuse/restack attempt that un-shadowed the configured
# paths and then failed. Without this the worktree is left holding real tracked
# directories where the harness links belong, which is a valid git state but a
# broken harness.
restore_unshadowed_worktree_setup() {
  local wt="$1"
  setup_app_worktree "$wt" && return 0
  echo "Warning: Worktree setup could not be reapplied after the failed rebase; harness links may be missing." >&2
  echo "  Restore them from the main checkout: cd '$PROJECT_ROOT' && $0 fix-links '$wt'" >&2
  return 0
}

setup_worktree_links() {
  local wt="$1"
  validate_worktree_setup_config || return 1

  # Project-configured mkdirs (run first so subsequent symlinks/copies can
  # land inside them if needed). Idempotent; ignores empty entries.
  split_worktree_config_words "${WORKTREE_MKDIRS:-}"
  for path in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    path="$(normalize_worktree_config_path WORKTREE_MKDIRS "$path")" || return 1
    mkdir_inside_worktree "$wt" "$path" || return 1
    exclude_from_worktree_index "$wt" "$path"
  done

  # Project-configured symlinks
  split_worktree_config_words "${WORKTREE_SYMLINKS:-}"
  for path in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    path="$(normalize_worktree_config_path WORKTREE_SYMLINKS "$path")" || return 1
    if [[ -e "$PROJECT_ROOT/$path" ]]; then
      symlink_into_worktree "$path" "$wt" || return 1
    fi
  done

  # Project-configured copies
  split_worktree_config_words "${WORKTREE_COPIES:-}"
  for path in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    path="$(normalize_worktree_config_path WORKTREE_COPIES "$path")" || return 1
    if [[ -f "$PROJECT_ROOT/$path" ]]; then
      ensure_worktree_path_safe "$wt" "$path" true || return 1
      exclude_from_worktree_index "$wt" "$path"
      mkdir -p "$(dirname "$wt/$path")"
      cp "$PROJECT_ROOT/$path" "$wt/$path"
    fi
  done

  # Project-configured symlinks whose targets should resolve from inside the
  # worktree, not from the main checkout. Useful for harness pointers like
  # .claude/CLAUDE.md -> ../AGENTS.md.
  split_worktree_config_words "${WORKTREE_RELATIVE_SYMLINKS:-}"
  for spec in ${WORKTREE_CONFIG_WORDS[@]+"${WORKTREE_CONFIG_WORDS[@]}"}; do
    if [[ "$spec" != *=* ]]; then
      echo "Warning: Ignoring invalid WORKTREE_RELATIVE_SYMLINKS entry '$spec' (expected path=target)" >&2
      continue
    fi
    local path="${spec%%=*}"
    local target="${spec#*=}"
    path="$(normalize_worktree_config_path WORKTREE_RELATIVE_SYMLINKS "$path")" || return 1
    validate_relative_symlink_target "$spec" "$target" || return 1
    ensure_worktree_path_safe "$wt" "$path" false || return 1
    if [[ -e "$wt/$path" && ! -L "$wt/$path" && ! -f "$wt/$path" ]]; then
      echo "Error: refusing to replace non-file worktree path '$path' with a relative symlink." >&2
      return 1
    fi
    mkdir -p "$(dirname "$wt/$path")"
    if [[ -L "$wt/$path" || -f "$wt/$path" ]]; then
      rm -f "$wt/$path"
    fi
    ln -s "$target" "$wt/$path"
    exclude_from_worktree_index "$wt" "$path"
  done
}

configure_worktree_git() {
  local wt="$1"

  # Required before writing per-worktree git config. Safe to repeat.
  git -C "$PROJECT_ROOT" config extensions.worktreeConfig true 2>/dev/null || true

  # Add bot remote for agent pushes (if configured).
  if [[ -n "${BOT_REMOTE_NAME:-}" && -n "${BOT_REMOTE_URL:-}" ]]; then
    git -C "$wt" remote add "$BOT_REMOTE_NAME" "$BOT_REMOTE_URL" 2>/dev/null || true
  fi

  # Set agent git identity (if configured).
  if [[ -n "${BOT_NAME:-}" ]]; then
    git -C "$wt" config --worktree user.name "$BOT_NAME"
    git -C "$wt" config --worktree user.email "${BOT_EMAIL:-}"
    if [[ -n "${BOT_SIGNING_KEY:-}" ]]; then
      git -C "$wt" config --worktree gpg.format ssh
      git -C "$wt" config --worktree user.signingkey "$BOT_SIGNING_KEY"
      git -C "$wt" config --worktree commit.gpgsign true
    fi
  fi
}

install_worktree_dependencies() {
  local wt="$1"

  [[ -f "$wt/package.json" ]] || return 0
  # npm is wrong for a workspace that pins another package manager: it
  # resolves a different tree and writes a stray package-lock.json into the
  # fresh checkout (dirty from birth, and `git add -A` would commit an npm
  # lockfile into a pnpm monorepo). Explicit npm evidence — its own lockfile
  # or an npm packageManager pin — wins over an incidental foreign lockfile;
  # otherwise another manager's lockfile or pin means that repo provisions
  # its own dependencies, so skip.
  # The TOP-LEVEL packageManager field only — a nested look-alike (e.g.
  # config.packageManager) is not a pin. Structural readers in preference
  # order: node (present wherever a package.json matters), then jq; a
  # machine with neither reads no pin, and the only cost of that miss is an
  # automatic install skipped — never a wrong-tree install.
  local pkg_manager=""
  if command -v node >/dev/null 2>&1; then
    pkg_manager="$(node -e 'const m=require(process.argv[1]).packageManager;process.stdout.write(typeof m==="string"?m:"")' "$wt/package.json" 2>/dev/null)" || pkg_manager=""
  elif command -v jq >/dev/null 2>&1; then
    pkg_manager="$(jq -r '.packageManager // ""' "$wt/package.json" 2>/dev/null)" || pkg_manager=""
  fi
  # Precedence: an explicit pin outranks lockfiles either way (a migration
  # leaves stale ones behind); with no pin, npm evidence beats an incidental
  # foreign lockfile.
  case "$pkg_manager" in
    pnpm@*|yarn@*|bun@*) return 0 ;;
    npm@*) ;;
    *)
      if [[ ! -f "$wt/package-lock.json" && ! -f "$wt/npm-shrinkwrap.json" ]] &&
        [[ -f "$wt/pnpm-lock.yaml" || -f "$wt/yarn.lock" || -f "$wt/bun.lockb" || -f "$wt/bun.lock" ]]; then
        return 0
      fi
      ;;
  esac
  if command -v npm >/dev/null 2>&1; then
    # Every std fd detached: a caller capturing $(create) — stdout, or
    # combined 2>&1 — gets EOF at once; any inherited pipe fd would make the
    # capture wait out the whole install. Never invisible even so: a failed
    # install leaves its full log at a stable per-worktree path.
    (
      cd "$wt" || exit 0
      # A user-private 0700 dir (never a symlink another local user planted)
      # holds the logs; path-keyed names so same-named worktrees of
      # different repos never share one. Unusable dir → install still runs,
      # just unlogged.
      log_dir="${TMPDIR:-/tmp}/worktree-npm-install-$(id -u)"
      mkdir -m 700 -p -- "$log_dir" 2>/dev/null || log_dir=""
      if [ -n "$log_dir" ] && [ ! -L "$log_dir" ] && [ -O "$log_dir" ]; then
        log="$log_dir/$(basename "$wt")-$(printf '%s' "$wt" | cksum | cut -d' ' -f1).log"
        if npm install --no-audit --no-fund >"$log" 2>&1; then
          rm -f -- "$log"
        fi
      else
        npm install --no-audit --no-fund >/dev/null 2>&1
      fi
    ) </dev/null >/dev/null 2>&1 &
  fi
}

# Provisioning applied to a worktree that some OTHER tool created — Codex
# Desktop Environments, or Claude Code's WorktreeCreate hook. Nothing here is
# app-specific; it is the same setup `create` applies once git has made the
# worktree, which is why both entry points share it.
setup_app_worktree() {
  local wt="$1"

  setup_worktree_links "$wt" || return 1
  configure_worktree_git "$wt" || return 1
  install_worktree_dependencies "$wt" || return 1
  # Best-effort by contract (#1032): a repo where the hooks cannot be written
  # still gets a fully provisioned worktree.
  install_worktree_autorepair_hooks
}

is_git_worktree_path() {
  local wt="$1"
  [[ -f "$wt/.git" || -d "$wt/.git" ]]
}

registered_worktree_path() {
  local target="$1" target_real="" line="" registered="" registered_real=""
  target_real="$(canonical_existing_dir "$target" 2>/dev/null)" || return 1

  while IFS= read -r -d '' line; do
    [[ "$line" == worktree\ * ]] || continue
    registered="${line#worktree }"
    registered_real="$(canonical_existing_dir "$registered" 2>/dev/null || true)"
    if [[ -n "$registered_real" && "$registered_real" == "$target_real" ]]; then
      printf '%s\n' "$registered_real"
      return 0
    fi
  done < <(git -C "$PROJECT_ROOT" worktree list --porcelain -z)
  return 1
}

is_registered_project_worktree() {
  local target="$1" registered="" common_dir=""
  registered="$(registered_worktree_path "$target")" || return 1
  common_dir="$(git_common_dir_path "$registered" 2>/dev/null)" || return 1
  [[ "$common_dir" == "$PROJECT_COMMON_GIT_DIR" ]]
}

require_registered_project_worktree() {
  local target="$1" action="$2"
  if ! is_git_worktree_path "$target"; then
    echo "Error: Not a git worktree: $target" >&2
    return 1
  fi
  if ! is_registered_project_worktree "$target"; then
    echo "Error: $target is not a registered worktree of $PROJECT_ROOT; refusing to $action." >&2
    return 1
  fi
}

require_non_main_project_worktree() {
  local target="$1" action="$2"
  require_registered_project_worktree "$target" "$action" || return 1
  if same_canonical_dir "$target" "$PROJECT_ROOT"; then
    echo "Error: $target is the main checkout for $PROJECT_ROOT; refusing to $action." >&2
    return 1
  fi
}

worktree_for_branch() {
  local branch="$1" line="" current_path=""
  while IFS= read -r -d '' line; do
    case "$line" in
      worktree\ *) current_path="${line#worktree }" ;;
      "branch refs/heads/$branch")
        # A stanza without a worktree path is not ownership proof; success
        # must always carry a usable path for command-substitution callers.
        if [[ -n "$current_path" ]]; then
          # Report the physical path when it resolves; git may have recorded
          # an older lexical (symlinked) spelling. A stale registration whose
          # directory is gone is reported as recorded.
          canonical_existing_dir "$current_path" 2>/dev/null || printf '%s\n' "$current_path"
          return 0
        fi
        ;;
      '') current_path="" ;;
    esac
  done < <(git -C "$PROJECT_ROOT" worktree list --porcelain -z)
  return 1
}

# Resolve an issue ID to its worktree path. Prefers the configured
# WORKTREE_BASE_DIR target; when nothing exists there, falls back to the
# worktree registered for the issue branch so trees created under an older
# base-dir convention keep working unmoved (no auto-migration). The main
# checkout is never a fallback target.
worktree_path_for_issue() {
  local issue="$1" configured="" registered=""
  validate_issue_id "$issue" || return 1
  configured="$(worktree_path "$issue")"
  if [[ -e "$configured" || -L "$configured" ]]; then
    printf '%s\n' "$configured"
    return 0
  fi
  registered="$(worktree_for_branch "$(issue_branch_name "$issue")" 2>/dev/null || true)"
  if [[ -n "$registered" ]] && ! same_canonical_dir "$registered" "$PROJECT_ROOT"; then
    printf '%s\n' "$registered"
    return 0
  fi
  printf '%s\n' "$configured"
}

rebase_in_progress() {
  local wt="$1" state path
  for state in rebase-merge rebase-apply; do
    path="$(git -C "$wt" rev-parse --git-path "$state" 2>/dev/null)" || continue
    [[ "$path" == /* ]] || path="$wt/$path"
    if [[ -d "$path" ]]; then
      return 0
    fi
  done
  return 1
}

restack_rebase_state_dir() {
  local wt="$1" state="" path=""
  for state in rebase-merge rebase-apply; do
    path="$(git -C "$wt" rev-parse --git-path "$state" 2>/dev/null)" || continue
    [[ "$path" == /* ]] || path="$wt/$path"
    if [[ -d "$path" ]]; then
      printf '%s\n' "$path"
      return 0
    fi
  done
  return 1
}

# The replay engine's paused state is Git's cherry-pick sequencer, which lives
# in the worktree-private git dir and records the detach point in its `head`
# file — the same role rebase-merge/onto plays for the rebase engine.
restack_replay_state_dir() {
  local wt="$1" path=""
  path="$(git -C "$wt" rev-parse --git-path sequencer 2>/dev/null)" || return 1
  [[ "$path" == /* ]] || path="$wt/$path"
  [[ -d "$path" ]] || return 1
  printf '%s\n' "$path"
}

replay_in_progress() {
  local wt="$1" path=""
  restack_replay_state_dir "$wt" >/dev/null 2>&1 && return 0
  path="$(git -C "$wt" rev-parse --git-path CHERRY_PICK_HEAD 2>/dev/null)" || return 1
  [[ "$path" == /* ]] || path="$wt/$path"
  [[ -f "$path" ]]
}

restack_paused_state_dir() {
  local wt="$1"
  if [[ "$(restack_state_get "$wt" mode)" == replay ]]; then
    restack_replay_state_dir "$wt"
  else
    restack_rebase_state_dir "$wt"
  fi
}

restack_engine_in_progress() {
  local wt="$1"
  if [[ "$(restack_state_get "$wt" mode)" == replay ]]; then
    replay_in_progress "$wt"
  else
    rebase_in_progress "$wt"
  fi
}

mark_pending_restack_state() {
  local wt="$1" state_dir="" state_token=""
  state_dir="$(restack_paused_state_dir "$wt")" || return 1
  state_token="$(restack_state_get "$wt" stateToken)"
  [[ -n "$state_token" ]] || return 1
  printf '%s\n' "$state_token" >"$state_dir/vstack-restack-token"
}

# Complete a finished replay: the branch ref moves only after the whole replay
# succeeded, then the worktree reattaches to it. This is the replay engine's
# only branch mutation, shared by the clean create path and restack
# continue/skip completion.
finish_replay_branch_move() {
  local wt="$1" branch="$2" base_oid="$3"
  if ! git -C "$wt" merge-base --is-ancestor "$base_oid" HEAD; then
    echo "Error: Replayed tip in $wt does not contain the recorded base $base_oid; refusing to move '$branch'." >&2
    return 1
  fi
  if ! git -C "$wt" branch -f "$branch" HEAD >/dev/null 2>&1 || \
     ! git -C "$wt" checkout "$branch" >/dev/null 2>&1 || \
     [[ "$(git -C "$wt" branch --show-current 2>/dev/null || true)" != "$branch" ]]; then
    echo "Error: Could not move '$branch' to the replayed tip and reattach $wt; inspect the worktree." >&2
    return 1
  fi
}

restack_state_refusal() {
  local wt="$1" reason="$2"
  echo "Error: Restack state for $wt is $reason; refusing to run a rebase control command." >&2
  echo "Only an exact paused state created by 'worktree create <ID> --restack' can be continued, skipped, or aborted." >&2
}

validate_pending_restack_state() {
  local wt="$1" state_dir="" stored_remote="" stored_branch="" stored_expected=""
  local original_head="" base_oid="" pending="" state_token="" marker_token=""
  local head_name="" rebase_original="" rebase_onto="" mode="" replay_head=""

  if ! is_registered_project_worktree "$wt"; then
    restack_state_refusal "$wt" "not a registered worktree of this repository"
    return 1
  fi
  mode="$(restack_state_get "$wt" mode)"
  state_dir="$(restack_paused_state_dir "$wt" 2>/dev/null || true)"
  if [[ -z "$state_dir" ]]; then
    restack_state_refusal "$wt" "missing a paused rebase"
    return 1
  fi

  stored_remote="$(restack_state_get "$wt" remote)"
  stored_branch="$(restack_state_get "$wt" branch)"
  stored_expected="$(restack_state_get "$wt" expectedRemoteOid)"
  original_head="$(restack_state_get "$wt" originalHead)"
  base_oid="$(restack_state_get "$wt" baseOid)"
  pending="$(restack_state_get "$wt" pending)"
  state_token="$(restack_state_get "$wt" stateToken)"
  if [[ -z "$stored_remote" || -z "$stored_branch" || -z "$original_head" || -z "$base_oid" ]]; then
    restack_state_refusal "$wt" "missing its tool-created authorization"
    return 1
  fi
  # Published restacks created before vstack#591 have the same exact fields but
  # no pending marker. Unpublished restacks require the new marker because an
  # empty expectedRemoteOid cannot otherwise be distinguished from no state.
  if [[ -z "$stored_expected" && "$pending" != true ]]; then
    restack_state_refusal "$wt" "missing its tool-created pending marker"
    return 1
  fi
  if [[ -n "$state_token" ]]; then
    marker_token="$(head -n 1 "$state_dir/vstack-restack-token" 2>/dev/null || true)"
    if [[ "$marker_token" != "$state_token" ]]; then
      restack_state_refusal "$wt" "missing its matching tool-created state token"
      return 1
    fi
  elif [[ "$pending" == true ]]; then
    restack_state_refusal "$wt" "missing its tool-created state token"
    return 1
  fi
  if ! git -C "$wt" remote get-url "$stored_remote" >/dev/null 2>&1; then
    restack_state_refusal "$wt" "bound to a missing remote '$stored_remote'"
    return 1
  fi
  if [[ "$mode" == replay ]]; then
    # Replay analog of the rebase metadata cross-check: the sequencer's head
    # is the detach point (the recorded base), HEAD is still detached, and the
    # branch ref has not moved off the recorded original head — the replay
    # moves it only after the whole range succeeds.
    if [[ ! -f "$state_dir/head" ]]; then
      restack_state_refusal "$wt" "missing required Git sequencer metadata"
      return 1
    fi
    replay_head="$(head -n 1 "$state_dir/head" 2>/dev/null || true)"
    if [[ "$replay_head" != "$base_oid" ]] || \
       [[ -n "$(git -C "$wt" branch --show-current 2>/dev/null || true)" ]] || \
       [[ "$(git -C "$wt" rev-parse "refs/heads/$stored_branch" 2>/dev/null || true)" != "$original_head" ]]; then
      restack_state_refusal "$wt" "not the replay recorded by the worktree tool"
      return 1
    fi
  else
    if [[ ! -f "$state_dir/head-name" || ! -f "$state_dir/orig-head" || ! -f "$state_dir/onto" ]]; then
      restack_state_refusal "$wt" "missing required Git rebase metadata"
      return 1
    fi

    head_name="$(head -n 1 "$state_dir/head-name" 2>/dev/null || true)"
    rebase_original="$(head -n 1 "$state_dir/orig-head" 2>/dev/null || true)"
    rebase_onto="$(head -n 1 "$state_dir/onto" 2>/dev/null || true)"
    if [[ "$head_name" != "refs/heads/$stored_branch" || "$rebase_original" != "$original_head" || "$rebase_onto" != "$base_oid" ]]; then
      restack_state_refusal "$wt" "not the rebase recorded by the worktree tool"
      return 1
    fi
  fi
  if ! git -C "$wt" cat-file -e "${original_head}^{commit}" 2>/dev/null || \
     ! git -C "$wt" cat-file -e "${base_oid}^{commit}" 2>/dev/null || \
     ! git -C "$wt" merge-base --is-ancestor "$base_oid" HEAD; then
    restack_state_refusal "$wt" "stale or no longer based on its recorded commits"
    return 1
  fi
  if [[ -n "$stored_expected" ]] && ! git -C "$wt" cat-file -e "${stored_expected}^{commit}" 2>/dev/null; then
    restack_state_refusal "$wt" "bound to an unavailable remote commit"
    return 1
  fi
  if ! restack_original_head_authorized "$wt" "$stored_expected" "$original_head" "$pending"; then
    restack_state_refusal "$wt" "not authorized by its recorded remote branch state"
    return 1
  fi
}

RESTACK_LIVE_EXPECTED_OID=""
validate_pending_restack_remote() {
  local wt="$1" stored_remote="" stored_branch="" stored_expected="" live_expected=""
  stored_remote="$(restack_state_get "$wt" remote)"
  stored_branch="$(restack_state_get "$wt" branch)"
  stored_expected="$(restack_state_get "$wt" expectedRemoteOid)"

  discover_ownership_remote_heads || return 1
  if ! ownership_heads_for_remote "$stored_remote" >/dev/null 2>&1; then
    echo "Error: Could not verify the recorded restack remote '$stored_remote'; refusing to continue or skip." >&2
    return 1
  fi
  live_expected="$(remote_branch_oid_discovered "$stored_remote" "$stored_branch" 2>/dev/null || true)"
  if [[ "$live_expected" != "$stored_expected" ]]; then
    echo "Error: Remote '$stored_remote/$stored_branch' changed while the supported restack was paused; refusing to continue or skip." >&2
    echo "Abort the guarded restack before reconciling the moved remote." >&2
    return 1
  fi
  RESTACK_LIVE_EXPECTED_OID="$live_expected"
}

resolve_restack_worktree() {
  local arg="$1"
  if [[ -z "$arg" ]]; then
    printf '%s\n' "$PWD"
  elif [[ "$arg" == */* ]]; then
    printf '%s\n' "$arg"
  else
    worktree_path_for_issue "$arg"
  fi
}

report_paused_restack() {
  local wt="$1" branch="$2" output="$3" conflict_files=""
  [[ -n "$output" ]] && sed 's/^/  git: /' <<<"$output" >&2
  conflict_files="$(git -C "$wt" diff --name-only --diff-filter=U 2>/dev/null || true)"
  if [[ -n "$conflict_files" ]]; then
    echo "Restack stopped on conflicts:" >&2
    sed 's/^/  /' <<<"$conflict_files" >&2
    echo "Resolve and stage each file, then run: $0 restack continue \"$wt\"" >&2
  else
    echo "The current replayed commit may be empty; inspect it, then run: $0 restack skip \"$wt\"" >&2
  fi
  echo "To restore the pre-restack branch: $0 restack abort \"$wt\"" >&2
  echo "Recorded branch: $branch" >&2
}

open_pr_for_branch() {
  local branch="$1"
  local result="" output=""
  [[ -n "$branch" ]] || return 0
  if ! command -v gh >/dev/null 2>&1; then
    echo "Error: gh is required for authoritative pull-request ownership discovery." >&2
    return 1
  fi

  if ! output="$(gh pr list --state open --head "$branch" --limit 1 --json number,url --jq '.[0] | select(.) | "\(.number)\t\(.url)"' 2>&1)"; then
    echo "Error: Could not query open pull requests for branch '$branch'; refusing to assume it is unowned." >&2
    [[ -n "$output" ]] && sed 's/^/  /' <<<"$output" >&2
    return 1
  fi
  result="$output"
  printf '%s\n' "$result"
}

resolve_pr_branch() {
  local pr="$1" output=""
  if ! command -v gh >/dev/null 2>&1; then
    echo "Error: gh is required to resolve PR #$pr" >&2
    return 1
  fi
  if ! output="$(gh pr view "$pr" --json headRefName -q .headRefName 2>&1)"; then
    echo "Error: Could not find branch for PR #$pr" >&2
    [[ -n "$output" ]] && sed 's/^/  /' <<<"$output" >&2
    return 1
  fi
  if [[ -z "$output" ]]; then
    echo "Error: Could not find branch for PR #$pr" >&2
    return 1
  fi
  printf '%s\n' "$output"
}

CANDIDATE_BRANCHES=()
# Open-PR details per candidate branch; parallel indexed arrays for Bash 3.2
# (see OWNERSHIP_REMOTE_HEAD_NAMES).
CANDIDATE_OPEN_PR_BRANCHES=()
CANDIDATE_OPEN_PR_DETAILS=()

candidate_open_pr_details() {
  local branch="$1" i
  for ((i = 0; i < ${#CANDIDATE_OPEN_PR_BRANCHES[@]}; i++)); do
    if [[ "${CANDIDATE_OPEN_PR_BRANCHES[$i]}" == "$branch" ]]; then
      printf '%s\n' "${CANDIDATE_OPEN_PR_DETAILS[$i]}"
      return 0
    fi
  done
  return 1
}

add_candidate_branch() {
  local branch="$1" i
  [[ -n "$branch" ]] || return 0
  # Indexed loop: expanding an empty array with "${arr[@]}" is an unbound
  # variable under Bash 3.2 with set -u.
  for ((i = 0; i < ${#CANDIDATE_BRANCHES[@]}; i++)); do
    [[ "${CANDIDATE_BRANCHES[$i]}" == "$branch" ]] && return 0
  done
  CANDIDATE_BRANCHES+=("$branch")
}

build_candidate_branches() {
  local issue="$1" requested_branch="$2" issue_lower=""
  issue_lower="$(issue_branch_name "$issue")"
  CANDIDATE_BRANCHES=()
  # The default branch always exists and is checked out in the main checkout;
  # that is expected repository state, never evidence that issue work exists,
  # so a requested branch naming it must not become an ownership candidate
  # (#1034). Only the unqualified spelling is filtered: requested_branch is a
  # literal local branch name at every caller, and a local branch actually
  # named "origin/<default>" must keep its ownership checks. The remote-
  # qualified --base spelling is normalized separately in the create flow.
  if [[ "${requested_branch:-}" == "$DEFAULT_BRANCH" ]]; then
    requested_branch=""
  fi
  add_candidate_branch "${requested_branch:-$issue_lower}"
  add_candidate_branch "$issue_lower"
  if [[ -n "${BOT_NAME:-}" ]]; then
    add_candidate_branch "$BOT_NAME/$issue_lower"
  fi
}

discover_candidate_ownership() {
  local strict_secondary="${1:-false}"
  discover_ownership_remote_heads "$strict_secondary" || return 1
  CANDIDATE_OPEN_PR_BRANCHES=()
  CANDIDATE_OPEN_PR_DETAILS=()

  local branch pr_details
  for branch in "${CANDIDATE_BRANCHES[@]}"; do
    if ! pr_details="$(open_pr_for_branch "$branch")"; then
      return 1
    fi
    CANDIDATE_OPEN_PR_BRANCHES+=("$branch")
    CANDIDATE_OPEN_PR_DETAILS+=("$pr_details")
  done
}

remote_ref_for_branch() {
  local branch="$1" oid="" ref="" i
  for ((i = 0; i < ${#OWNERSHIP_REMOTE_HEAD_NAMES[@]}; i++)); do
    while read -r oid ref; do
      if [[ -n "$oid" && "$ref" == "refs/heads/$branch" ]]; then
        printf '%s/%s\n' "${OWNERSHIP_REMOTE_HEAD_NAMES[$i]}" "$branch"
        return 0
      fi
    done <<<"${OWNERSHIP_REMOTE_HEAD_REFS[$i]}"
  done
  return 1
}

remote_branch_discovered() {
  local remote="$1" branch="$2" heads="" oid="" ref=""
  heads="$(ownership_heads_for_remote "$remote" || true)"
  while read -r oid ref; do
    [[ -n "$oid" && "$ref" == "refs/heads/$branch" ]] && return 0
  done <<<"$heads"
  return 1
}

remote_branch_oid_discovered() {
  local remote="$1" branch="$2" heads="" oid="" ref=""
  heads="$(ownership_heads_for_remote "$remote" || true)"
  while read -r oid ref; do
    if [[ -n "$oid" && "$ref" == "refs/heads/$branch" ]]; then
      printf '%s\n' "$oid"
      return 0
    fi
  done <<<"$heads"
  return 1
}

scan_candidate_ownership() {
  local issue="$1" branch="" existing_wt="" remote_ref="" pr_details="" pr_number=""
  for branch in "${CANDIDATE_BRANCHES[@]}"; do
    existing_wt="$(worktree_for_branch "$branch" 2>/dev/null || true)"
    # The main checkout is never issue work, so it must never be rendered as
    # a reusable worktree. It still blocks this id — git cannot check the
    # branch out a second time — but the remedy is to move that work off the
    # main checkout, not --reuse and not --recover-local (which would refuse
    # for the same reason) (#1034).
    if [[ -n "$existing_wt" ]] && same_canonical_dir "$existing_wt" "$PROJECT_ROOT"; then
      echo "Active work already exists for '$issue'; refusing to create a duplicate worktree." >&2
      echo "  Branch: $branch" >&2
      echo "  Signal: checked out in the main checkout ($PROJECT_ROOT)" >&2
      echo "No worktree was created and no local branch was rebased or modified." >&2
      echo "The main checkout is never issue work and the branch cannot be checked out twice." >&2
      echo "Move that work off the main checkout (or pick another issue id), then retry." >&2
      return "$ACTIVE_WORK_EXIT"
    fi
    if [[ -n "$existing_wt" ]]; then
      refuse_existing_worktree "$issue" "$existing_wt"
      return "$ACTIVE_WORK_EXIT"
    fi
    pr_details="$(candidate_open_pr_details "$branch" || true)"
    if [[ -n "$pr_details" ]]; then
      pr_number="${pr_details%%$'\t'*}"
      refuse_existing_branch "$issue" "$branch" "open pull request" "#$pr_number"
      return "$ACTIVE_WORK_EXIT"
    fi
    if git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
      refuse_existing_branch "$issue" "$branch" "existing local branch"
      return "$ACTIVE_WORK_EXIT"
    fi
    remote_ref="$(remote_ref_for_branch "$branch" 2>/dev/null || true)"
    if [[ -n "$remote_ref" ]]; then
      refuse_existing_branch "$issue" "$branch" "existing remote branch" "$remote_ref"
      return "$ACTIVE_WORK_EXIT"
    fi
  done
  return 0
}

refuse_local_branch_recovery() {
  local issue="$1" branch="$2" reason="$3" details="${4:-}"
  echo "Cannot recover local branch '$branch' for '$issue'." >&2
  echo "  Reason: $reason${details:+ ($details)}" >&2
  echo "No worktree was created and the local branch was not modified." >&2
  return "$ACTIVE_WORK_EXIT"
}

# Validate the deliberately narrow recovery case from vstack#780: the exact
# normalized issue branch survived locally, but its worktree was removed
# before the branch was ever published. This is separate from new-work claim
# discovery because that local ref is the one ownership signal recovery is
# expected to consume. Every other ownership signal remains a refusal.
validate_local_branch_recovery() {
  local issue="$1" target="$2" expected_head="${3:-}" require_fresh_base="${4:-true}"
  local branch="" existing_wt="" remote_ref=""
  local pr_details="" upstream="" candidate="" candidate_wt="" current_head="" object_type=""
  branch="$(issue_branch_name "$issue")"

  if [[ "$branch" == "$DEFAULT_BRANCH" ]]; then
    refuse_local_branch_recovery "$issue" "$branch" "the issue branch resolves to the default branch"
    return "$ACTIVE_WORK_EXIT"
  fi
  if ! git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$branch"; then
    echo "Error: --recover-local requires the exact local branch '$branch'." >&2
    echo "No worktree was created." >&2
    return 1
  fi
  object_type="$(git -C "$PROJECT_ROOT" cat-file -t "refs/heads/$branch" 2>/dev/null || true)"
  if [[ "$object_type" != commit ]]; then
    refuse_local_branch_recovery "$issue" "$branch" "the local ref does not name a commit"
    return "$ACTIVE_WORK_EXIT"
  fi
  current_head="$(git -C "$PROJECT_ROOT" rev-parse "refs/heads/$branch")"
  if [[ -n "$expected_head" && "$current_head" != "$expected_head" ]]; then
    refuse_local_branch_recovery "$issue" "$branch" "the local branch tip changed during recovery" "expected $expected_head, found $current_head"
    return "$ACTIVE_WORK_EXIT"
  fi

  existing_wt="$(worktree_for_branch "$branch" 2>/dev/null || true)"
  if [[ -n "$existing_wt" ]]; then
    if [[ -d "$existing_wt" ]] && is_registered_project_worktree "$existing_wt"; then
      refuse_existing_worktree "$issue" "$existing_wt"
      return "$ACTIVE_WORK_EXIT"
    fi
    refuse_local_branch_recovery "$issue" "$branch" "an incomplete or stale worktree registration still owns the branch" "$existing_wt"
    return "$ACTIVE_WORK_EXIT"
  fi

  guard_new_target_path "$issue" "$target" || return "$ACTIVE_WORK_EXIT"

  remote_ref="$(remote_ref_for_branch "$branch" 2>/dev/null || true)"
  if [[ -n "$remote_ref" ]]; then
    refuse_local_branch_recovery "$issue" "$branch" "a remote branch already exists" "$remote_ref"
    return "$ACTIVE_WORK_EXIT"
  fi
  pr_details="$(candidate_open_pr_details "$branch" || true)"
  if [[ -n "$pr_details" ]]; then
    refuse_local_branch_recovery "$issue" "$branch" "an open pull request already exists" "${pr_details%%$'\t'*}"
    return "$ACTIVE_WORK_EXIT"
  fi
  upstream="$(git -C "$PROJECT_ROOT" for-each-ref --format='%(upstream)' "refs/heads/$branch")"
  if [[ -n "$upstream" ]]; then
    refuse_local_branch_recovery "$issue" "$branch" "the branch has configured upstream history" "$upstream"
    return "$ACTIVE_WORK_EXIT"
  fi

  # BOT_NAME/<issue> is another session-owner spelling used by create. Its
  # presence alongside the exact issue branch makes ownership ambiguous.
  for candidate in "${CANDIDATE_BRANCHES[@]}"; do
    [[ "$candidate" == "$branch" ]] && continue
    candidate_wt="$(worktree_for_branch "$candidate" 2>/dev/null || true)"
    if [[ -n "$candidate_wt" ]]; then
      refuse_local_branch_recovery "$issue" "$branch" "another candidate branch has a worktree" "$candidate at $candidate_wt"
      return "$ACTIVE_WORK_EXIT"
    fi
    if git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$candidate"; then
      refuse_local_branch_recovery "$issue" "$branch" "another local candidate branch exists" "$candidate"
      return "$ACTIVE_WORK_EXIT"
    fi
    remote_ref="$(remote_ref_for_branch "$candidate" 2>/dev/null || true)"
    if [[ -n "$remote_ref" ]]; then
      refuse_local_branch_recovery "$issue" "$branch" "another remote candidate branch exists" "$remote_ref"
      return "$ACTIVE_WORK_EXIT"
    fi
    pr_details="$(candidate_open_pr_details "$candidate" || true)"
    if [[ -n "$pr_details" ]]; then
      refuse_local_branch_recovery "$issue" "$branch" "another candidate branch has an open pull request" "$candidate"
      return "$ACTIVE_WORK_EXIT"
    fi
  done

  if [[ "$require_fresh_base" == true ]] && \
     ! git -C "$PROJECT_ROOT" merge-base "origin/$DEFAULT_BRANCH" "$branch" >/dev/null 2>&1; then
    refuse_local_branch_recovery "$issue" "$branch" "the branch does not share history with origin/$DEFAULT_BRANCH"
    return "$ACTIVE_WORK_EXIT"
  fi
}

acquire_issue_claim_lock() {
  local issue="$1" normalized_issue="" claim_key="" lock_path=""
  if ! command -v flock >/dev/null 2>&1; then
    echo "Error: flock is required to serialize worktree claims." >&2
    return 1
  fi
  normalized_issue="$(issue_branch_name "$issue")"
  claim_key="$(printf '%s' "$normalized_issue" | git hash-object --stdin)"
  lock_path="$PROJECT_COMMON_GIT_DIR/vstack-worktree-claim-$claim_key.lock"
  # Fixed descriptor: Bash 3.2 (macOS system bash) lacks the automatic
  # file-descriptor allocation redirection added in Bash 4.1.
  exec 9>"$lock_path"
  ISSUE_CLAIM_LOCK_HELD=true
  flock -x 9
}

release_issue_claim_lock() {
  if [[ "${ISSUE_CLAIM_LOCK_HELD:-false}" == true ]]; then
    flock -u 9 2>/dev/null || true
    exec 9>&-
    ISSUE_CLAIM_LOCK_HELD=false
  fi
}

worktree_lock_reason() {
  local wt="$1"
  local lock_path="" reason=""
  lock_path="$(git -C "$wt" rev-parse --git-path locked 2>/dev/null || true)"
  [[ -n "$lock_path" ]] || return 1
  [[ "$lock_path" == /* ]] || lock_path="$wt/$lock_path"
  [[ -f "$lock_path" ]] || return 1
  reason="$(head -n 1 "$lock_path" 2>/dev/null || true)"
  printf '%s\n' "${reason:-locked}"
}

# ─── Session guard lifecycle ─────────────────────────────────────────────────
#
# `worktree-session-guard` wraps git's native worktree lock with owner/TTL lease
# semantics. Claiming is deliberately NOT automatic — `create` never takes a
# lease.
#
# The reason is that a lease means "a live session is working here", and only
# something that knows a session's lifetime can say that truthfully. If `create`
# claimed, every worktree would stay claimed for life (nothing but an explicit
# `remove` releases), so a lease-aware `cleanup` would collect nothing without
# `--stale` — trading a silent-destruction bug for a silent-accumulation one.
# Claiming therefore stays with the caller that knows when work starts and ends
# — the orchestrating workflow.
#
# What IS automatic is the destructive side, where live worktrees were being
# collected under working sessions:
#
#   cleanup           never collects a worktree under a guard lease; `--stale`
#                     collects leases past the TTL
#   remove            releases only the caller's OWN lease, so a claiming
#                     session can still tear down its own tree
#   create --reuse    refuses a foreign lease by name, refreshes its own
#
SESSION_GUARD="$SCRIPT_DIR/worktree-session-guard"
readonly SESSION_GUARD_DEFAULT_TTL_MINUTES=720

# An unavailable guard must be loud: every lifecycle integration would
# otherwise silently no-op, and cleanup collecting live worktrees again is
# the incident the guard exists to prevent, reintroduced by an install gap
# (#912). Warned once per invocation, not once per worktree. The guard itself
# no longer requires flock — it falls back to a mkdir mutex — so "the script
# is not executable" is the remaining way to lose the guard silently; a guard
# that cannot take its lock fails its own commands loudly.
SESSION_GUARD_WARNED=false
session_guard_available() {
  [[ -x "$SESSION_GUARD" ]] && return 0
  if [[ "$SESSION_GUARD_WARNED" != true ]]; then
    SESSION_GUARD_WARNED=true
    echo "Warning: worktree-session-guard is not executable at $SESSION_GUARD; session leases were NOT checked or released, so worktrees are unguarded." >&2
  fi
  return 1
}

# The session's environment identity, mirroring the guard's own default owner
# resolution. $USER is a login, not a session: two sessions on one machine
# share it. This ladder is the fallback identity; issue-addressed commands
# derive their primary identity from the issue ID via issue_session_owner.
session_guard_owner() {
  printf '%s' "${VSTACK_SESSION_OWNER:-${HT_SESSION_OWNER:-${USER:-}}}"
}

# Owner identity carried by an issue-addressed command (`remove <ID>`,
# `create <ID> --reuse`). The documented claim the orchestrating workflow makes
# is `claim [WORKTREE_PATH] --owner [ISSUE_ID]`, so on a default install — where no
# session-owner env var is set — the issue ID IS the identity the lease
# carries, and deriving it from the command's own argument is what makes claim
# and release agree without any session env plumbing (#907). Prints nothing
# when the ID cannot be a lease owner: the guard caps owners at 64 characters
# (the issue-ID charset is already a subset of the owner charset), and an
# unusable owner would turn every probe into a usage failure.
issue_session_owner() {
  local issue="${1:-}"
  [[ -n "$issue" && ${#issue} -le 64 && "$issue" =~ ^[A-Za-z0-9._:@+-]+$ ]] || return 0
  printf '%s' "$issue"
}

# Read-only ownership probe. Sets SESSION_GUARD_PROBE_ERR to the guard's own
# stderr so a caller can quote it verbatim (it names the owning session).
# Returns the guard's status exit code: 0 ours, 3 no lock, 4 locked outside the
# guard, 75 someone else's.
#
# `--repo` is passed deliberately: `status`/`release` accept it, so the probe
# does not depend on the caller's cwd. `claim`/`refresh` REJECT it — see
# refresh_own_session_lease.
probe_session_lease() {
  local wt="$1" owner="$2" rc=0
  SESSION_GUARD_PROBE_ERR=""
  SESSION_GUARD_PROBE_ERR="$("$SESSION_GUARD" status "$wt" --owner "$owner" --repo "$PROJECT_ROOT" 2>&1 >/dev/null)" || rc=$?
  return "$rc"
}

# A single field of the guard's status JSON. Guard-written values only: pid is
# numeric and host comes from a sanitized charset, so neither can contain the
# quote or backslash a general JSON parser would have to handle.
session_lease_field() {
  local json="$1" key="$2" rest
  rest="${json#*\"$key\":\"}"
  [[ "$rest" != "$json" ]] || return 1
  printf '%s' "${rest%%\"*}"
}

# The spelling this host is recorded under in a lease — the guard's own
# sanitize_host, mirrored so the comparison cannot fail on the sanitization.
session_guard_host() {
  local host="${HOSTNAME:-}"
  [[ -n "$host" ]] || host="$(uname -n 2>/dev/null || true)"
  [[ -n "$host" ]] || host="unknown-host"
  printf '%s' "${host//[^A-Za-z0-9._:@+-]/-}"
}

# This session's leader pid — the identity the guard records in a lease (its
# session_leader_pid, mirrored). Falls back through the procps `sid` spelling
# to $$; validation is strict rather than digit-stripping, because BSD ps
# prints `sess` as a hex pointer that stripping would mangle into a
# plausible-looking pid.
session_leader_pid() {
  local sid
  sid="$(ps -o sess= -p $$ 2>/dev/null | tr -d '[:space:]' || true)"
  if ! [[ "$sid" =~ ^[1-9][0-9]*$ ]]; then
    sid="$(ps -o sid= -p $$ 2>/dev/null | tr -d '[:space:]' || true)"
  fi
  [[ "$sid" =~ ^[1-9][0-9]*$ ]] || sid=$$
  printf '%s' "$sid"
}

# The guard's mkdir_lock_holder_gone, mirrored: ps(1) sees other users'
# processes where `kill -0` gets EPERM and would call a live pid dead; with no
# usable pid, or no ps at all, the pid is presumed alive.
recorded_pid_gone() {
  local pid="$1"
  [[ "$pid" =~ ^[1-9][0-9]*$ ]] || return 1
  command -v ps >/dev/null 2>&1 || return 1
  ! ps -o pid= -p "$pid" >/dev/null 2>&1
}

# Whether PID is this process or one of its ancestors, walked up the PPID
# chain via ps (portable where /proc is not). Bounded so a cyclic or lying ps
# can never spin; past the bound the pid is treated as unrelated.
pid_is_self_or_ancestor() {
  local pid="$1" cur=$$ parent hops=0
  while [[ "$hops" -lt 64 ]]; do
    [[ "$cur" == "$pid" ]] && return 0
    parent="$(ps -o ppid= -p "$cur" 2>/dev/null || true)"
    parent="${parent//[^0-9]/}"
    [[ -n "$parent" && "$parent" != "0" && "$parent" != "$cur" ]] || return 1
    cur="$parent"
    hops=$((hops + 1))
  done
  return 1
}

# An issue-derived identity proves the same ISSUE, not the same SESSION: any
# session that names the issue passes the ownership probe (#907), so on that
# identity alone `remove <ID>` would release a sibling session's live lease
# and tear down the worktree it is still working in. The lease's recorded pid
# — the claiming session's leader — decides: this session's own leader, a
# provably dead pid, or an ancestor of this process proceeds; alive and
# unrelated on this host refuses. A pid recorded on another host cannot be
# probed from here, so it proceeds as before, exactly like a lease that
# records no usable pid.
issue_release_permits_removal() {
  local wt="$1" owner="$2" status rc=0 err_file pid host
  # The lease GENERATION this verdict was reached on, for the caller's
  # compare-and-release; empty when the lease records none, which the caller
  # refuses to release optimistically. The generation, not the pid: a pid is
  # reused by the OS, so a claim taken by a new session after the recorded one
  # exited can carry the same number and pass a pid compare.
  LEASE_VERIFIED_GEN=""
  if ! err_file="$(mktemp "${TMPDIR:-/tmp}/worktree-lease-status.XXXXXX")"; then
    echo "Error: could not create a scratch file to verify the session lease of $wt; refusing to remove it." >&2
    return 1
  fi
  status="$("$SESSION_GUARD" status "$wt" --owner "$owner" --repo "$PROJECT_ROOT" 2>"$err_file")" || rc=$?
  # The identity probe just succeeded, so an unreadable lease HERE is abnormal
  # — and permitting on it would release on exactly the evidence gap this
  # gate exists to close.
  if [[ "$rc" -ne 0 ]]; then
    echo "Error: could not re-read the session guard state of $wt (exit $rc); refusing to remove it." >&2
    sed 's/^/  /' "$err_file" >&2
    rm -f "$err_file"
    return 1
  fi
  rm -f "$err_file"
  pid="$(session_lease_field "$status" pid || true)"
  host="$(session_lease_field "$status" host || true)"
  # Captured before the permit-by-default exits below, so every path that
  # permits a removal still binds the release to the lease it was read from.
  LEASE_VERIFIED_GEN="$(session_lease_field "$status" generation || true)"
  # pid 1 is init, never a claiming session; a lease recording it is corrupt,
  # and the ancestor walk would call it everyone's ancestor.
  [[ "$pid" =~ ^[1-9][0-9]*$ && "$pid" != "1" ]] || return 0
  [[ "$host" == "$(session_guard_host)" ]] || return 0
  # Equal-session short-circuit: covers a reparented (orphaned) shell of the
  # claiming session that the PPID walk below can no longer reach.
  [[ "$pid" == "$(session_leader_pid)" ]] && return 0
  if command -v ps >/dev/null 2>&1; then
    recorded_pid_gone "$pid" && return 0
    pid_is_self_or_ancestor "$pid" && return 0
    echo "Error: $wt is claimed by a live session (owner=$owner pid=$pid); refusing to remove it." >&2
    echo "  Matching the issue ID does not prove the lease is this session's, and its claiming session is still running on this host." >&2
  else
    # Without ps the pid can be proved neither dead nor related; it is
    # presumed alive (the guard's own conservatism), but the refusal must not
    # claim more than was verified.
    echo "Error: $wt is claimed under owner=$owner by session pid=$pid, whose liveness cannot be verified on this host (no ps(1)); refusing to remove it." >&2
  fi
  echo "  If that session is truly finished: $0 remove \"$owner\" --force" >&2
  echo "  Or release its lease directly: $SESSION_GUARD release \"$wt\" --owner \"$owner\"" >&2
  return 1
}

# Release this session's OWN lease on a worktree it is about to remove. Without
# this a session that claimed its worktree cannot tear it down — the lease is a
# native git lock, so `refuse_locked_worktree` and git itself both refuse. It
# must therefore run BEFORE that precheck, and after the ownership guard so a
# foreign repository's lease is never touched.
#
# Ownership is proved by probe, once per identity the caller can claim: the
# issue ID the command was addressed with first (the identity the orchestrating
# workflow claims with), then the session env ladder. Only an owner-matching
# guard lease is released. A foreign lease, a lock taken outside the guard,
# and an unreadable state are all left exactly as they are and fall through to
# the precheck, which names the owner and the way out.
release_own_session_lease() {
  local wt="$1" issue_owner="${2:-}" force="${3:-false}" env_owner owner="" candidate rc
  session_guard_available || return 0
  env_owner="$(session_guard_owner)"
  if [[ "$env_owner" == "$issue_owner" ]]; then
    env_owner=""
  fi
  for candidate in "$issue_owner" "$env_owner"; do
    [[ -n "$candidate" ]] || continue
    rc=0
    probe_session_lease "$wt" "$candidate" || rc=$?
    # 0 alone means "a guard lease exists AND this identity owns it"; 75 is an
    # identity mismatch the next candidate may still resolve. Anything else
    # (no lease, foreign lock, unreadable) holds for every identity alike.
    case "$rc" in
      0) owner="$candidate"; break ;;
      75) continue ;;
      *) return 0 ;;
    esac
  done
  [[ -n "$owner" ]] || return 0
  # An issue-shaped identity asserts only which ISSUE was named, so it takes
  # the liveness gate — including when the session env happens to carry that
  # same issue ID, because two sessions on one issue export the same value and
  # the string match proves nothing the argument did not. Only an env-ladder
  # identity DISTINCT from the issue is the session naming itself. `remove
  # --force` skips exactly this refusal, nothing else.
  local expect_gen_args=()
  if [[ "$owner" == "$issue_owner" && "$force" != true ]]; then
    issue_release_permits_removal "$wt" "$owner" || return 1
    # Bind the release to the lease that verdict was reached on: a sibling that
    # claims between the two guard calls mints a new generation, and the
    # release refuses rather than unlocking a live claim (see --expect-gen).
    # A lease recording no generation cannot be bound, so it is refused rather
    # than released blind — the owning session records one on its next
    # claim/refresh; a dead legacy lease takes `remove --force`.
    if [[ -z "$LEASE_VERIFIED_GEN" ]]; then
      echo "Error: the session lease on $wt records no generation token; refusing an unbound release." >&2
      echo "  Retry after the owning session's next refresh records one, or use: remove --force" >&2
      return 1
    fi
    expect_gen_args=(--expect-gen "$LEASE_VERIFIED_GEN")
  fi
  if ! "$SESSION_GUARD" release "$wt" --owner "$owner" --repo "$PROJECT_ROOT" \
    "${expect_gen_args[@]+"${expect_gen_args[@]}"}" >/dev/null; then
    echo "Error: could not release this session's guard lease on $wt; refusing to remove it." >&2
    echo "  Release it, then retry: $SESSION_GUARD release \"$wt\" --owner \"$owner\"" >&2
    return 1
  fi
  echo "Released session guard lease (owner=$owner): $wt" >&2
  return 0
}

# `--reuse`/`--restack` re-enter an existing worktree, which is the
# second-implementer gap of #571 for the session-lifetime case. A foreign lease
# is refused by name; our own is refreshed so a long reuse cycle cannot age past
# the TTL and be swept while it is still working.
reuse_respects_session_lease() {
  local wt="$1" issue_owner="${2:-}" env_owner owner="" candidate rc=0
  session_guard_available || return 0
  env_owner="$(session_guard_owner)"
  if [[ "$env_owner" == "$issue_owner" ]]; then
    env_owner=""
  fi
  # Same identity order as release_own_session_lease: the issue ID the command
  # was addressed with (the identity the orchestrating workflow claims with),
  # then the session env ladder. A 75 only means "not this identity's lease" — the next
  # candidate may still own it; every other state holds for all identities.
  for candidate in "$issue_owner" "$env_owner"; do
    [[ -n "$candidate" ]] || continue
    rc=0
    probe_session_lease "$wt" "$candidate" || rc=$?
    case "$rc" in
      3) return 0 ;;  # no lock at all
      4) return 0 ;;  # locked outside the guard — refuse_locked_worktree's business
      0) owner="$candidate"; break ;;
      75) continue ;;
      *)
        echo "Error: could not read the session guard state of $wt (exit $rc); refusing to reuse it." >&2
        [[ -n "$SESSION_GUARD_PROBE_ERR" ]] && printf '%s\n' "$SESSION_GUARD_PROBE_ERR" | sed 's/^/  /' >&2
        return 1
        ;;
    esac
  done
  if [[ -z "$owner" ]]; then
    # No identity at all (no issue-usable ID and an empty env ladder) means
    # nothing was probed; proceed as before rather than refusing on silence.
    [[ "$rc" -eq 75 ]] || return 0
    echo "Error: $wt is claimed by another session; refusing to reuse it." >&2
    [[ -n "$SESSION_GUARD_PROBE_ERR" ]] && printf '%s\n' "$SESSION_GUARD_PROBE_ERR" | sed 's/^/  /' >&2
    echo "Coordinate with the owning session instead of reusing its worktree." >&2
    return 1
  fi
  # A reuse is a REPLACEMENT session for the issue, not a heartbeat of the
  # session that claimed the lease: `claim`'s same-owner branch mints a new
  # generation, so a concurrent remove that decided against the previous
  # session's lease refuses instead of unlocking this one. (`claim`, like
  # `refresh`, REJECTS `--repo` — it applies only to release/status/list/
  # sweep; a best-effort wrapper would swallow that failure, so do not add
  # it.)
  if ! "$SESSION_GUARD" claim "$wt" --owner "$owner" >/dev/null; then
    echo "Error: could not take over the session guard lease on $wt." >&2
    return 1
  fi
  return 0
}

# `cleanup` is the untargeted sweeper, so it is the operation that destroyed
# live worktrees in the incident this guard exists for. It never removes a
# claimed worktree — not even one claimed by THIS session, since our own lease
# still means work is in progress there.
cleanup_lease_permits_removal() {
  local wt="$1" issue_owner="${2:-}" rc=0
  local -a owner_args=()
  session_guard_available || return 0
  # The probe carries the issue identity derived from the worktree's branch
  # when one is derivable (#907). It changes nothing here — 0 and 75 land in
  # the same arm, because our own lease still means work is in progress — but
  # keeps every lifecycle probe naming the best-known identity rather than
  # whatever the environment happens to hold.
  if [[ -n "$issue_owner" ]]; then
    owner_args=(--owner "$issue_owner")
  fi
  "$SESSION_GUARD" status "$wt" ${owner_args[@]+"${owner_args[@]}"} --repo "$PROJECT_ROOT" >/dev/null 2>&1 || rc=$?
  case "$rc" in
    3) return 0 ;;     # no lock at all
    0 | 75) ;;         # a guard lease is present — ours (0) or another's (75)
    4)
      echo "Skipped (locked outside the session guard): $wt" >&2
      return 1
      ;;
    *)
      echo "Skipped (session guard state could not be read, exit $rc): $wt" >&2
      return 1
      ;;
  esac
  if [[ "$CLEANUP_STALE" != true ]]; then
    echo "Skipped (a session holds a guard lease): $wt" >&2
    echo "  Let that session release it, or pass --stale to collect leases past the ${CLEANUP_TTL_MINUTES}m TTL." >&2
    return 1
  fi
  if "$SESSION_GUARD" release "$wt" --stale --ttl-minutes "$CLEANUP_TTL_MINUTES" --repo "$PROJECT_ROOT" >/dev/null 2>&1; then
    echo "Released stale session guard lease: $wt" >&2
    return 0
  fi
  echo "Skipped (guard lease is not past the ${CLEANUP_TTL_MINUTES}m TTL): $wt" >&2
  return 1
}

# Refuse to act on a worktree that carries a native `git worktree lock`.
# `git worktree remove --force` does NOT override a lock (git wants `-f -f`),
# so a locked worktree is unremovable. This is a DIAGNOSTIC precheck, not the
# safety mechanism: git's refusal is authoritative and race-free, but it names
# neither the owning session nor the way out. Sessions record `owner=<id>` in
# the lock reason, so surface that plus the unlock path (#800). Callers must
# still leave the tree intact until git itself succeeds.
refuse_locked_worktree() {
  local wt="$1" action="$2"
  local lock_reason=""
  lock_reason="$(worktree_lock_reason "$wt" || true)"
  [[ -n "$lock_reason" ]] || return 0

  echo "Error: $wt is a locked worktree; refusing to $action." >&2
  echo "  Worktree: $wt" >&2
  echo "  Lock reason: $lock_reason" >&2
  echo "Nothing in the worktree was modified." >&2
  echo "A lock usually means a live session owns this worktree; confirm it is finished first." >&2
  echo "To release the lock and retry:" >&2
  echo "  git -C \"$PROJECT_ROOT\" worktree unlock \"$wt\"" >&2
  return 1
}

refuse_existing_worktree() {
  local issue="$1" wt="$2"
  local branch="" dirty="clean" upstream="" counts="" behind="0" ahead="0"
  local lock_reason="" pr_details="" pr_number="" pr_url="" pr_lookup_failed=false

  # Defence in depth: callers must treat the main checkout as no ownership
  # before reaching this renderer ("The main checkout is never a fallback
  # target"). Never present it as reusable issue work or advertise --reuse
  # into it (#1034).
  if same_canonical_dir "$wt" "$PROJECT_ROOT"; then
    echo "Error: An ownership scan for '$issue' resolved the main checkout ($PROJECT_ROOT)." >&2
    echo "The main checkout is never issue work; refusing without a reuse remedy." >&2
    echo "No worktree was created and nothing was modified." >&2
    return "$ACTIVE_WORK_EXIT"
  fi

  branch="$(git -C "$wt" branch --show-current 2>/dev/null || true)"
  if [[ -n "$(git -C "$wt" status --porcelain 2>/dev/null || true)" ]]; then
    dirty="dirty"
  fi

  if [[ -n "$branch" ]]; then
    upstream="$(git -C "$wt" rev-parse --abbrev-ref --symbolic-full-name '@{upstream}' 2>/dev/null || true)"
    if [[ -z "$upstream" ]] && git -C "$wt" rev-parse --verify "origin/$branch" >/dev/null 2>&1; then
      upstream="origin/$branch"
    fi
    if [[ -n "$upstream" ]]; then
      counts="$(git -C "$wt" rev-list --left-right --count "$upstream...HEAD" 2>/dev/null || true)"
      if [[ -n "$counts" ]]; then
        read -r behind ahead <<<"$counts"
      fi
    fi
    if ! pr_details="$(open_pr_for_branch "$branch")"; then
      pr_lookup_failed=true
      pr_details=""
    fi
  fi
  lock_reason="$(worktree_lock_reason "$wt" || true)"

  echo "Active work already exists for '$issue'; refusing implicit reuse." >&2
  echo "  Worktree: $wt" >&2
  echo "  Branch: ${branch:-detached}" >&2
  echo "  Working tree: $dirty" >&2
  if [[ -n "$upstream" ]]; then
    echo "  Upstream: $upstream (ahead $ahead, behind $behind)" >&2
  elif [[ -n "$branch" ]]; then
    echo "  Upstream: none (branch is unpublished or not tracking a remote)" >&2
  fi
  if [[ -n "$pr_details" ]]; then
    pr_number="${pr_details%%$'\t'*}"
    pr_url="${pr_details#*$'\t'}"
    echo "  Open PR: #$pr_number $pr_url" >&2
  elif [[ "$pr_lookup_failed" == true ]]; then
    echo "  Open PR: lookup unavailable (local worktree ownership is already sufficient)" >&2
  fi
  if [[ -n "$lock_reason" ]]; then
    echo "  Worktree lock: ${lock_reason:-locked}" >&2
  fi
  echo "No local branch was rebased or modified." >&2
  echo "Inspect or monitor the existing work instead of spawning another implementer." >&2
  echo "If this session owns the worktree, opt in explicitly:" >&2
  echo "  $0 create $issue --reuse" >&2
  echo "Use --restack instead only when intentionally resolving a rebase conflict." >&2
  return "$ACTIVE_WORK_EXIT"
}

refuse_existing_branch() {
  local issue="$1" branch="$2" signal="$3" details="${4:-}"

  echo "Active work already exists for '$issue'; refusing to create a duplicate worktree." >&2
  echo "  Branch: $branch" >&2
  echo "  Signal: $signal${details:+ ($details)}" >&2
  echo "No worktree was created and no local branch was rebased or modified." >&2
  echo "Inspect or monitor the existing work instead of spawning another implementer." >&2
  if [[ "$signal" == "open pull request" ]]; then
    echo "To inspect that PR in a worktree intentionally, pass --pr <number>." >&2
  elif [[ "$signal" == "existing local branch" && "$branch" == "$(issue_branch_name "$issue")" ]]; then
    echo "If this is an unpublished issue branch whose worktree was lost, recover it explicitly:" >&2
    echo "  $0 create $issue --recover-local" >&2
    echo "Recovery revalidates that the branch is local-only and unambiguously owned before recreating it." >&2
  else
    echo "To check out that branch intentionally, pass --base $branch." >&2
  fi
  return "$ACTIVE_WORK_EXIT"
}

refuse_incomplete_worktree() {
  local issue="$1" wt="$2"
  echo "Active or incomplete worktree path already exists for '$issue': $wt" >&2
  echo "The exact path is not a registered worktree of $PROJECT_ROOT." >&2
  echo "Refusing to delete, replace, or reuse it automatically. Inspect it, then remove it explicitly if abandoned." >&2
  return "$ACTIVE_WORK_EXIT"
}

guard_new_target_path() {
  local issue="$1" wt="$2"
  [[ -e "$wt" || -L "$wt" ]] || return 0
  if is_registered_project_worktree "$wt"; then
    refuse_existing_worktree "$issue" "$wt"
    return "$ACTIVE_WORK_EXIT"
  fi
  refuse_incomplete_worktree "$issue" "$wt"
  return "$ACTIVE_WORK_EXIT"
}

case "${1:-}" in
  restack)
    ACTION="${2:-}"
    ARG="${3:-}"
    if [[ $# -gt 3 ]]; then
      echo "Usage: $0 restack continue|skip|abort [ID|/path]" >&2
      exit 1
    fi
    case "$ACTION" in
      continue|skip|abort) ;;
      *)
        echo "Usage: $0 restack continue|skip|abort [ID|/path]" >&2
        exit 1
        ;;
    esac

    WT_PATH="$(resolve_restack_worktree "$ARG")"
    validate_pending_restack_state "$WT_PATH" || exit 1
    RESTACK_BRANCH="$(restack_state_get "$WT_PATH" branch)"
    acquire_issue_claim_lock "$RESTACK_BRANCH" || exit 1
    # The first validation gives a useful error without taking a lock. Repeat
    # under the branch claim lock immediately before controlling the rebase.
    validate_pending_restack_state "$WT_PATH" || exit 1
    RESTACK_MODE="$(restack_state_get "$WT_PATH" mode)"

    if [[ "$ACTION" == abort ]]; then
      RESTACK_ORIGINAL_HEAD="$(restack_state_get "$WT_PATH" originalHead)"
      if [[ "$RESTACK_MODE" == replay ]]; then
        # The replay never moved the branch ref, so aborting the cherry-pick
        # restores the detach point and reattaching restores everything.
        if ! REBASE_OUTPUT="$(git -C "$WT_PATH" cherry-pick --abort 2>&1)"; then
          [[ -n "$REBASE_OUTPUT" ]] && sed 's/^/  git: /' <<<"$REBASE_OUTPUT" >&2
          echo "Error: Guarded restack abort failed; the pending state and authorization were preserved." >&2
          exit 1
        fi
        if replay_in_progress "$WT_PATH" || \
           ! git -C "$WT_PATH" checkout "$RESTACK_BRANCH" >/dev/null 2>&1 || \
           [[ "$(git -C "$WT_PATH" rev-parse HEAD)" != "$RESTACK_ORIGINAL_HEAD" ]] || \
           [[ "$(git -C "$WT_PATH" branch --show-current 2>/dev/null || true)" != "$RESTACK_BRANCH" ]]; then
          echo "Error: Guarded restack abort did not restore the recorded branch and original HEAD; refusing to clear its state." >&2
          exit 1
        fi
      else
        if ! REBASE_OUTPUT="$(git -C "$WT_PATH" rebase --abort 2>&1)"; then
          [[ -n "$REBASE_OUTPUT" ]] && sed 's/^/  git: /' <<<"$REBASE_OUTPUT" >&2
          echo "Error: Guarded restack abort failed; the pending state and authorization were preserved." >&2
          exit 1
        fi
        if rebase_in_progress "$WT_PATH" || \
           [[ "$(git -C "$WT_PATH" rev-parse HEAD)" != "$RESTACK_ORIGINAL_HEAD" ]] || \
           [[ "$(git -C "$WT_PATH" branch --show-current 2>/dev/null || true)" != "$RESTACK_BRANCH" ]]; then
          echo "Error: Guarded restack abort did not restore the recorded branch and original HEAD; refusing to clear its state." >&2
          exit 1
        fi
      fi
      cancel_pending_restack_authorization "$WT_PATH"
      release_issue_claim_lock
      if ! setup_app_worktree "$WT_PATH"; then
        echo "Warning: Restack was aborted successfully, but worktree setup could not be reapplied. Fix the WORKTREE_* configuration, then run: $0 fix-links '$WT_PATH'" >&2
      fi
      echo "Aborted guarded restack and restored $RESTACK_BRANCH: $WT_PATH"
      exit 0
    fi

    validate_worktree_setup_config || exit 1
    validate_pending_restack_remote "$WT_PATH" || exit 1
    RESTACK_BASE_OID="$(restack_state_get "$WT_PATH" baseOid)"
    REBASE_OUTPUT=""
    REBASE_STATUS=0
    if [[ "$RESTACK_MODE" == replay ]]; then
      if [[ "$ACTION" == continue ]]; then
        if REBASE_OUTPUT="$(GIT_EDITOR=true git -C "$WT_PATH" cherry-pick --continue 2>&1)"; then
          :
        else
          REBASE_STATUS=$?
        fi
      else
        if REBASE_OUTPUT="$(git -C "$WT_PATH" cherry-pick --skip 2>&1)"; then
          :
        else
          REBASE_STATUS=$?
        fi
      fi
    elif [[ "$ACTION" == continue ]]; then
      if REBASE_OUTPUT="$(GIT_EDITOR=true git -C "$WT_PATH" rebase --continue 2>&1)"; then
        :
      else
        REBASE_STATUS=$?
      fi
    else
      if REBASE_OUTPUT="$(git -C "$WT_PATH" rebase --skip 2>&1)"; then
        :
      else
        REBASE_STATUS=$?
      fi
    fi

    if restack_engine_in_progress "$WT_PATH"; then
      if ! validate_pending_restack_state "$WT_PATH"; then
        echo "Error: Git changed the paused rebase outside the recorded restack boundary; refusing further control." >&2
        exit 1
      fi
      report_paused_restack "$WT_PATH" "$RESTACK_BRANCH" "$REBASE_OUTPUT"
      exit 1
    fi
    if [[ "$REBASE_STATUS" -ne 0 ]]; then
      clear_restack_push_authorization "$WT_PATH"
      [[ -n "$REBASE_OUTPUT" ]] && sed 's/^/  git: /' <<<"$REBASE_OUTPUT" >&2
      echo "Error: Git ended the rebase with status $REBASE_STATUS; no rewritten push was authorized." >&2
      exit 1
    fi
    if [[ "$RESTACK_MODE" == replay ]]; then
      # A completed pick sequence is not yet a completed restack: the branch
      # ref moves only now, after the whole replay succeeded.
      if ! finish_replay_branch_move "$WT_PATH" "$RESTACK_BRANCH" "$RESTACK_BASE_OID"; then
        clear_restack_push_authorization "$WT_PATH"
        echo "No rewritten push was authorized." >&2
        exit 1
      fi
    elif [[ "$(git -C "$WT_PATH" branch --show-current 2>/dev/null || true)" != "$RESTACK_BRANCH" ]]; then
      clear_restack_push_authorization "$WT_PATH"
      echo "Error: Git did not restore the recorded branch '$RESTACK_BRANCH'; no rewritten push was authorized." >&2
      exit 1
    fi

    if ! validate_pending_restack_remote "$WT_PATH"; then
      clear_restack_push_authorization "$WT_PATH"
      echo "No rewritten push was authorized." >&2
      exit 1
    fi
    RESTACK_REMOTE="$(restack_state_get "$WT_PATH" remote)"
    finalize_pending_restack_authorization "$WT_PATH" "$RESTACK_REMOTE" "$RESTACK_BRANCH" "$RESTACK_LIVE_EXPECTED_OID" || exit 1
    release_issue_claim_lock
    setup_app_worktree "$WT_PATH"
    echo "Completed guarded restack for $RESTACK_BRANCH: $WT_PATH"
    ;;

  create)
    if [[ "${2:-}" == "--help" || "${2:-}" == "-h" ]]; then
      echo "Usage: $0 create <ID> [BRANCH] [options]"
      echo ""
      echo "Create a worktree for an issue ID (resolved under the configured worktree base"
      echo "dir; default: ../.worktrees/<repo> beside the main checkout), optionally with an"
      echo "explicit branch-name positional."
      echo ""
      echo "Options:"
      echo "  --base BRANCH   Checkout an existing remote branch into the worktree;"
      echo "                  the default branch instead starts a new issue branch from it"
      echo "  --from REF      Create a new branch starting from REF (branch, tag, or commit)"
      echo "  --pr NUMBER     Look up the branch from a PR number (implies --base)"
      echo "  --reuse         Explicitly reuse and update an existing issue worktree"
      echo "  --recover-local Recreate a missing worktree for the exact local-only issue"
      echo "                  branch; preserves commits and does not rebase"
      echo "  --restack       When reusing, stop in the conflict state for resolution"
      echo "                  instead of aborting the rebase"
      echo "  --replay        With --reuse/--restack: run the same restack as an ordered"
      echo "                  cherry-pick replay with no rebase porcelain, for execution"
      echo "                  policies that reject 'git rebase'"
      exit 0
    fi
    ISSUE="${2:?Error: create requires an issue ID}"
    # Reject an option-looking issue ID before it becomes the ISSUE and a
    # trees/<id> path. Otherwise `create --typo` would compute trees/--typo and
    # proceed to attempt creation instead of failing clearly (#621).
    if [[ "$ISSUE" == -* ]]; then
      echo "Error: unknown option '$ISSUE' for create" >&2
      echo "Run: $0 create --help" >&2
      exit 1
    fi
    shift 2
    BASE=""
    BRANCH=""
    FROM=""
    PR=""
    REUSE=false
    RESTACK=false
    REPLAY=false
    RECOVER_LOCAL=false
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --base) BASE="$2"; shift 2 ;;
        --from) FROM="$2"; shift 2 ;;
        --pr) PR="$2"; shift 2 ;;
        --reuse) REUSE=true; shift ;;
        --recover-local) RECOVER_LOCAL=true; shift ;;
        --restack) RESTACK=true; shift ;;
        --replay) REPLAY=true; shift ;;
        # An unknown --flag must fail rather than be silently captured as a
        # branch name. A legitimate positional branch name (not leading with
        # '-') still falls through to the permissive arm below (#621).
        -*)
          echo "Error: unknown option '$1' for create" >&2
          echo "Run: $0 create --help" >&2
          exit 1
          ;;
        *) BRANCH="$1"; shift ;;
      esac
    done
    if [[ "$RECOVER_LOCAL" == true ]] && \
       [[ -n "$BASE" || -n "$FROM" || -n "$PR" || -n "$BRANCH" || "$REUSE" == true || "$RESTACK" == true || "$REPLAY" == true ]]; then
      echo "Error: --recover-local cannot be combined with a branch name, --base, --from, --pr, --reuse, --restack, or --replay." >&2
      exit 1
    fi
    if [[ "$REPLAY" == true && "$REUSE" != true && "$RESTACK" != true ]]; then
      echo "Error: --replay selects the restack engine for --reuse/--restack; combine it with one of them." >&2
      exit 1
    fi
    # A positional branch name equal to the default branch can never become
    # new issue work: `git worktree add -b` would always refuse the existing
    # branch. Fail loudly instead of dying inside the suppressed add (#1034).
    if [[ -n "$BRANCH" && "$BRANCH" == "$DEFAULT_BRANCH" ]]; then
      echo "Error: '$BRANCH' is the default branch and cannot be claimed as an issue work branch." >&2
      echo "To base new work on it, run: $0 create $ISSUE --base $DEFAULT_BRANCH" >&2
      exit 1
    fi
    # --base names a fork point when it is the default branch. "Checkout an
    # existing branch" semantics can never apply to it — it is always checked
    # out in the main checkout — and it is not issue-ownership evidence, so
    # base a fresh issue branch on it exactly like --from (#1034).
    if [[ -z "$FROM" && -z "$PR" ]]; then
      case "$BASE" in
        "$DEFAULT_BRANCH" | "origin/$DEFAULT_BRANCH")
          FROM="$DEFAULT_BRANCH"
          BASE=""
          ;;
      esac
    fi

    if [[ "$RECOVER_LOCAL" == true ]]; then
      # Recovery always recreates at the currently configured path. It never
      # silently revives or migrates a legacy/stale registration elsewhere.
      WT_PATH="$(worktree_path "$ISSUE")"
      validate_worktree_setup_config || exit 1
      build_candidate_branches "$ISSUE" ""
      RECOVERY_BRANCH="$(issue_branch_name "$ISSUE")"
      if ! git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$RECOVERY_BRANCH"; then
        echo "Error: --recover-local requires the exact local branch '$RECOVERY_BRANCH'." >&2
        echo "No worktree was created." >&2
        exit 1
      fi
      if [[ "$(git -C "$PROJECT_ROOT" cat-file -t "refs/heads/$RECOVERY_BRANCH" 2>/dev/null || true)" != commit ]]; then
        refuse_local_branch_recovery "$ISSUE" "$RECOVERY_BRANCH" "the local ref does not name a commit" || exit $?
      fi
      # This snapshot precedes every fetch-capable operation. All later
      # validation and the created checkout must retain this exact tip.
      RECOVERY_HEAD="$(git -C "$PROJECT_ROOT" rev-parse "refs/heads/$RECOVERY_BRANCH")"

      # Read-only ownership discovery before taking the claim lock gives fast,
      # useful refusals. Repeat all checks under the same lock used by create,
      # immediately before the only branch/worktree mutation.
      discover_candidate_ownership true || exit 1
      validate_local_branch_recovery "$ISSUE" "$WT_PATH" "$RECOVERY_HEAD" false || exit $?
      acquire_issue_claim_lock "$ISSUE" || exit 1
      fetch_recovery_default_branch || exit 1
      discover_candidate_ownership true || exit 1
      validate_local_branch_recovery "$ISSUE" "$WT_PATH" "$RECOVERY_HEAD" true || exit $?

      mkdir -p "$TREES_DIR"
      if ! git -C "$PROJECT_ROOT" worktree add "$WT_PATH" "$RECOVERY_BRANCH" >/dev/null 2>&1; then
        echo "Error: Git could not recreate the worktree for local branch '$RECOVERY_BRANCH'." >&2
        echo "The branch remains unchanged at $RECOVERY_HEAD." >&2
        exit 1
      fi
      if [[ "$(git -C "$WT_PATH" branch --show-current 2>/dev/null || true)" != "$RECOVERY_BRANCH" ]] || \
         [[ "$(git -C "$WT_PATH" rev-parse HEAD 2>/dev/null || true)" != "$RECOVERY_HEAD" ]]; then
        echo "Error: Recreated worktree did not preserve the exact branch identity and tip $RECOVERY_HEAD." >&2
        echo "The worktree was left in place for inspection: $WT_PATH" >&2
        exit 1
      fi
      release_issue_claim_lock
      if ! setup_app_worktree "$WT_PATH"; then
        echo "Error: Local branch '$RECOVERY_BRANCH' was recovered with its commits intact, but configured worktree setup failed." >&2
        echo "Fix the WORKTREE_* configuration, then run: $0 fix-links '$WT_PATH'" >&2
        exit 1
      fi
      echo "$WT_PATH"
      exit 0
    fi
    # Prefer the configured target; fall back to the registered worktree for
    # the issue branch so trees created under an older base-dir convention are
    # still recognized as active work and reusable in place.
    WT_PATH="$(worktree_path_for_issue "$ISSUE")"
    validate_worktree_setup_config || exit 1

    # 1. Existing work is an ownership signal. Bare create is only for claiming
    # new work; reuse must be explicit so discovery cannot rewrite another
    # session's branch (#571). Exit 75 distinguishes active work from a broken
    # repository or invalid arguments.
    if [[ -d "$WT_PATH" ]] && is_registered_project_worktree "$WT_PATH"; then
      if [[ "$REUSE" != true && "$RESTACK" != true ]]; then
        refuse_existing_worktree "$ISSUE" "$WT_PATH" || exit "$ACTIVE_WORK_EXIT"
      fi

      # A guard lease is the session-lifetime half of that same ownership
      # signal: refuse another session's tree by name, refresh our own so a
      # long reuse cycle cannot age past the TTL (#877). Before any mutation.
      reuse_respects_session_lease "$WT_PATH" "$(issue_session_owner "$ISSUE")" \
        || exit "$ACTIVE_WORK_EXIT"

      # Network/ref discovery must succeed before the claim lock or any setup
      # mutation. Repeat it under the per-issue lock immediately before reuse.
      discover_ownership_remote_heads || exit 1
      acquire_issue_claim_lock "$ISSUE" || exit 1
      if ! is_registered_project_worktree "$WT_PATH"; then
        refuse_incomplete_worktree "$ISSUE" "$WT_PATH" || exit "$ACTIVE_WORK_EXIT"
      fi
      fetch_origin || exit 1
      CURRENT_BRANCH=$(git -C "$WT_PATH" branch --show-current 2>/dev/null)
      if [[ -n "$CURRENT_BRANCH" ]]; then
        REUSE_REMOTE="${BOT_REMOTE_NAME:-origin}"
        if ! git -C "$WT_PATH" remote get-url "$REUSE_REMOTE" >/dev/null 2>&1; then
          REUSE_REMOTE="origin"
        fi
        REUSE_EXPECTED_OID="$(remote_branch_oid_discovered "$REUSE_REMOTE" "$CURRENT_BRANCH" 2>/dev/null || true)"
        finalize_pending_restack_authorization "$WT_PATH" "$REUSE_REMOTE" "$CURRENT_BRANCH" "$REUSE_EXPECTED_OID" || exit 1
        if git -C "$WT_PATH" merge-base --is-ancestor "origin/$DEFAULT_BRANCH" HEAD; then
          : # origin/$DEFAULT_BRANCH already contained — nothing to rebase
        else
          REUSE_BASE_OID="$(git -C "$WT_PATH" rev-parse "origin/$DEFAULT_BRANCH")"
          if [[ "$REPLAY" == true ]]; then
            # The rebase engine lets git itself refuse a dirty tree; the
            # replay must refuse before detaching. Merge commits cannot be
            # represented by an ordered cherry-pick, so they are refused up
            # front rather than mid-replay. No mutation before either check.
            if [[ -n "$(git -C "$WT_PATH" status --porcelain 2>/dev/null || true)" ]]; then
              echo "Error: $WT_PATH has uncommitted changes; refusing to replay over them." >&2
              echo "Commit or discard them, then retry." >&2
              exit 1
            fi
            if [[ "$(git -C "$WT_PATH" rev-list --merges --count "$REUSE_BASE_OID..HEAD" 2>/dev/null || echo 1)" -ne 0 ]]; then
              echo "Error: The replay range origin/$DEFAULT_BRANCH..$CURRENT_BRANCH in $WT_PATH contains merge commits, which an ordered cherry-pick replay cannot represent." >&2
              echo "Use the rebase engine ($0 create $ISSUE --reuse) or reconcile the merge manually." >&2
              exit 1
            fi
          fi
          # Configured symlinks that shadow tracked files make git refuse to
          # detach HEAD, so the rebase below cannot even start (#873, #874).
          # Undo the shadowing first; every terminal path re-applies setup.
          if ! unshadow_tracked_symlink_paths "$WT_PATH"; then
            restore_unshadowed_worktree_setup "$WT_PATH"
            exit 1
          fi
          prepare_restack_authorization "$WT_PATH" "$REUSE_REMOTE" "$CURRENT_BRANCH" "$REUSE_EXPECTED_OID" "$REUSE_BASE_OID" || exit 1
          if [[ "$REPLAY" == true ]]; then
            # Replay engine: detach at the base, cherry-pick the unique range
            # in order, and let finish_replay_branch_move move the branch ref
            # only after the whole replay succeeds. Same authorization
            # lifecycle as the rebase engine, no rebase porcelain.
            git -C "$WT_PATH" config --worktree vstack-restack.mode replay
            REPLAY_ORIGINAL_HEAD="$(restack_state_get "$WT_PATH" originalHead)"
            if ! REPLAY_OUTPUT="$(git -C "$WT_PATH" checkout --detach "$REUSE_BASE_OID" 2>&1)"; then
              cancel_pending_restack_authorization "$WT_PATH"
              restore_unshadowed_worktree_setup "$WT_PATH"
              echo "Error: Could not detach at origin/$DEFAULT_BRANCH to start the replay in $WT_PATH:" >&2
              sed 's/^/  /' <<<"$REPLAY_OUTPUT" >&2
              exit 1
            fi
            REPLAY_STATUS=0
            REPLAY_OUTPUT=""
            if [[ "$(git -C "$WT_PATH" rev-list --count "$REUSE_BASE_OID..$REPLAY_ORIGINAL_HEAD")" -eq 0 ]]; then
              : # branch is behind the new base; the replayed result is the base itself
            elif REPLAY_OUTPUT="$(git -C "$WT_PATH" cherry-pick "$REUSE_BASE_OID..$REPLAY_ORIGINAL_HEAD" 2>&1)"; then
              :
            else
              REPLAY_STATUS=$?
            fi
            if [[ "$REPLAY_STATUS" -ne 0 ]]; then
              CONFLICT_FILES="$(git -C "$WT_PATH" diff --name-only --diff-filter=U 2>/dev/null || true)"
              if ! replay_in_progress "$WT_PATH"; then
                # Replay never started — reattach and surface git's message.
                git -C "$WT_PATH" checkout "$CURRENT_BRANCH" >/dev/null 2>&1 || true
                cancel_pending_restack_authorization "$WT_PATH"
                restore_unshadowed_worktree_setup "$WT_PATH"
                echo "Error: Cherry-pick replay onto origin/$DEFAULT_BRANCH failed for $WT_PATH before it could start:" >&2
                sed 's/^/  /' <<<"$REPLAY_OUTPUT" >&2
                exit 1
              fi
              if ! mark_pending_restack_state "$WT_PATH"; then
                MARKER_ABORT_OK=true
                git -C "$WT_PATH" cherry-pick --abort >/dev/null 2>&1 || MARKER_ABORT_OK=false
                git -C "$WT_PATH" checkout "$CURRENT_BRANCH" >/dev/null 2>&1 || MARKER_ABORT_OK=false
                if [[ "$MARKER_ABORT_OK" == true ]] && ! replay_in_progress "$WT_PATH"; then
                  cancel_pending_restack_authorization "$WT_PATH"
                  restore_unshadowed_worktree_setup "$WT_PATH"
                fi
                echo "Error: Could not bind the paused replay to its tool-created restack token; refusing guarded recovery." >&2
                exit 1
              fi
              if [[ "$RESTACK" == true ]]; then
                echo "Error: Cherry-pick replay onto origin/$DEFAULT_BRANCH stopped on conflicts in $WT_PATH." >&2
                if [[ -n "$CONFLICT_FILES" ]]; then
                  echo "Conflicting files:" >&2
                  sed 's/^/  /' <<<"$CONFLICT_FILES" >&2
                fi
                echo "The replay is paused in the worktree so the conflicts can be resolved:" >&2
                echo "  1. Edit each conflicting file to remove the conflict markers." >&2
                echo "  2. git -C \"$WT_PATH\" add <file>    (each resolved file)" >&2
                echo "  3. $0 restack continue \"$WT_PATH\"    (repeat if it stops again)" >&2
                echo "     If the resolved commit is empty: $0 restack skip \"$WT_PATH\"" >&2
                echo "To back out instead: $0 restack abort \"$WT_PATH\"" >&2
                exit 1
              fi
              ABORT_OK=true
              git -C "$WT_PATH" cherry-pick --abort >/dev/null 2>&1 || ABORT_OK=false
              if [[ "$ABORT_OK" == true ]]; then
                git -C "$WT_PATH" checkout "$CURRENT_BRANCH" >/dev/null 2>&1 || ABORT_OK=false
              fi
              if [[ "$ABORT_OK" == true ]] && ! replay_in_progress "$WT_PATH"; then
                cancel_pending_restack_authorization "$WT_PATH"
                restore_unshadowed_worktree_setup "$WT_PATH"
              fi
              echo "Error: Cherry-pick replay onto origin/$DEFAULT_BRANCH failed for $WT_PATH (conflicts)." >&2
              if [[ -n "$CONFLICT_FILES" ]]; then
                echo "Conflicting files:" >&2
                sed 's/^/  /' <<<"$CONFLICT_FILES" >&2
              fi
              if [[ "$ABORT_OK" == true ]] && ! replay_in_progress "$WT_PATH"; then
                echo "The replay was aborted; the worktree is back on its pre-replay state with no conflicts left to resolve." >&2
              else
                echo "Automatic abort of the failed replay did NOT complete; the worktree may still hold cherry-pick state." >&2
                echo "Retry through the guarded tool path: $0 restack abort \"$WT_PATH\"" >&2
              fi
              echo "Recovery options:" >&2
              echo "  1. Redo the replay and stop in the conflict state to resolve it:" >&2
              echo "       $0 create $ISSUE --restack --replay" >&2
              echo "  2. Discard local divergence and recreate fresh from origin/$DEFAULT_BRANCH:" >&2
              echo "       $0 remove $ISSUE && $0 create $ISSUE" >&2
              exit 1
            fi
            if ! finish_replay_branch_move "$WT_PATH" "$CURRENT_BRANCH" "$REUSE_BASE_OID"; then
              clear_restack_push_authorization "$WT_PATH"
              echo "No rewritten push was authorized." >&2
              exit 1
            fi
            finalize_pending_restack_authorization "$WT_PATH" "$REUSE_REMOTE" "$CURRENT_BRANCH" "$REUSE_EXPECTED_OID" || exit 1
          elif REBASE_OUTPUT="$(git -C "$WT_PATH" rebase "origin/$DEFAULT_BRANCH" 2>&1)"; then
            finalize_pending_restack_authorization "$WT_PATH" "$REUSE_REMOTE" "$CURRENT_BRANCH" "$REUSE_EXPECTED_OID" || exit 1
          else
            # Capture conflict details before any abort erases the rebase state.
            CONFLICT_FILES="$(git -C "$WT_PATH" diff --name-only --diff-filter=U 2>/dev/null || true)"
            if ! rebase_in_progress "$WT_PATH"; then
              # Rebase never started (e.g. uncommitted changes) — nothing to
              # abort or resolve; surface git's own message.
              cancel_pending_restack_authorization "$WT_PATH"
              restore_unshadowed_worktree_setup "$WT_PATH"
              echo "Error: Rebase onto origin/$DEFAULT_BRANCH failed for $WT_PATH before it could start:" >&2
              sed 's/^/  /' <<<"$REBASE_OUTPUT" >&2
              exit 1
            fi
            if ! mark_pending_restack_state "$WT_PATH"; then
              MARKER_ABORT_OK=true
              git -C "$WT_PATH" rebase --abort >/dev/null 2>&1 || MARKER_ABORT_OK=false
              if [[ "$MARKER_ABORT_OK" == true ]] && ! rebase_in_progress "$WT_PATH"; then
                cancel_pending_restack_authorization "$WT_PATH"
                restore_unshadowed_worktree_setup "$WT_PATH"
              fi
              echo "Error: Could not bind the paused rebase to its tool-created restack token; refusing guarded recovery." >&2
              exit 1
            fi
            if [[ "$RESTACK" == true ]]; then
              echo "Error: Rebase onto origin/$DEFAULT_BRANCH stopped on conflicts in $WT_PATH." >&2
              if [[ -n "$CONFLICT_FILES" ]]; then
                echo "Conflicting files:" >&2
                sed 's/^/  /' <<<"$CONFLICT_FILES" >&2
              fi
              echo "The rebase is paused in the worktree so the conflicts can be resolved:" >&2
              echo "  1. Edit each conflicting file to remove the conflict markers." >&2
              echo "  2. git -C \"$WT_PATH\" add <file>    (each resolved file)" >&2
              echo "  3. $0 restack continue \"$WT_PATH\"    (repeat if it stops again)" >&2
              echo "     If the resolved commit is empty: $0 restack skip \"$WT_PATH\"" >&2
              echo "To back out instead: $0 restack abort \"$WT_PATH\"" >&2
              exit 1
            fi
            ABORT_OK=true
            git -C "$WT_PATH" rebase --abort >/dev/null 2>&1 || ABORT_OK=false
            if [[ "$ABORT_OK" == true ]] && ! rebase_in_progress "$WT_PATH"; then
              cancel_pending_restack_authorization "$WT_PATH"
              restore_unshadowed_worktree_setup "$WT_PATH"
            fi
            echo "Error: Rebase onto origin/$DEFAULT_BRANCH failed for $WT_PATH (conflicts)." >&2
            if [[ -n "$CONFLICT_FILES" ]]; then
              echo "Conflicting files:" >&2
              sed 's/^/  /' <<<"$CONFLICT_FILES" >&2
            fi
            if [[ "$ABORT_OK" == true ]] && ! rebase_in_progress "$WT_PATH"; then
              echo "The rebase was aborted; the worktree is back on its pre-rebase state with no conflicts left to resolve." >&2
            else
              echo "Automatic abort of the failed rebase did NOT complete; the worktree may still hold rebase state." >&2
              echo "Retry through the guarded tool path: $0 restack abort \"$WT_PATH\"" >&2
            fi
            echo "Recovery options:" >&2
            echo "  1. Redo the rebase and stop in the conflict state to resolve it:" >&2
            echo "       $0 create $ISSUE --restack" >&2
            echo "  2. Discard local divergence and recreate fresh from origin/$DEFAULT_BRANCH:" >&2
            echo "       $0 remove $ISSUE && $0 create $ISSUE" >&2
            exit 1
          fi
        fi
      fi
      # Refresh setup (rebase may have replaced symlinks with tracked content)
      release_issue_claim_lock
      setup_app_worktree "$WT_PATH"
      echo "$WT_PATH"
      exit 0
    fi

    # A directory is reusable only when its exact canonical path is registered
    # to this repository's common Git directory. Never let `git -C` discover a
    # parent checkout and mistake an incomplete in-repository target for main.
    if [[ -e "$WT_PATH" || -L "$WT_PATH" ]]; then
      refuse_incomplete_worktree "$ISSUE" "$WT_PATH" || exit "$ACTIVE_WORK_EXIT"
    fi

    if [[ "$REUSE" == true || "$RESTACK" == true ]]; then
      echo "Error: --reuse/--restack requires an existing worktree at $WT_PATH" >&2
      exit 1
    fi

    # 2. --from still creates a new issue branch, so it uses the same complete
    # candidate ownership scan as bare create. Discovery runs once before any
    # lock/config/directory mutation, then again while the claim lock is held.
    if [[ -n "$FROM" ]]; then
      build_candidate_branches "$ISSUE" "$BRANCH"
      discover_candidate_ownership || exit 1
      scan_candidate_ownership "$ISSUE" || exit "$ACTIVE_WORK_EXIT"
      acquire_issue_claim_lock "$ISSUE" || exit 1
      guard_new_target_path "$ISSUE" "$WT_PATH" || exit "$ACTIVE_WORK_EXIT"
      fetch_origin || exit 1
      discover_candidate_ownership || exit 1
      scan_candidate_ownership "$ISSUE" || exit "$ACTIVE_WORK_EXIT"

      BRANCH="${BRANCH:-$(issue_branch_name "$ISSUE")}"
      # Resolve: try origin/$FROM first (remote branch), then $FROM directly (local branch/tag/commit)
      if git -C "$PROJECT_ROOT" rev-parse --verify "origin/$FROM" &>/dev/null; then
        START_POINT="origin/$FROM"
      elif git -C "$PROJECT_ROOT" rev-parse --verify "$FROM" &>/dev/null; then
        START_POINT="$FROM"
      else
        echo "Error: Cannot resolve ref '$FROM'" >&2
        exit 1
      fi
      mkdir -p "$TREES_DIR"
      git -C "$PROJECT_ROOT" worktree add --no-track -b "$BRANCH" "$WT_PATH" "$START_POINT" >/dev/null 2>&1
      release_issue_claim_lock
      setup_app_worktree "$WT_PATH"
      echo "$WT_PATH"
      exit 0
    fi

    # 3. Explicit --pr/--base remain inspection modes rather than new-work
    # claims. Their authoritative branch/ref lookup still must succeed before
    # mutation, and the issue lock serializes their final check plus add.
    if [[ -n "$PR" ]]; then
      BASE="$(resolve_pr_branch "$PR")" || exit 1
    fi

    if [[ -n "$BASE" ]]; then
      discover_ownership_remote_heads || exit 1
      if ! remote_branch_discovered origin "$BASE"; then
        echo "Error: Cannot resolve remote branch 'origin/$BASE'" >&2
        exit 1
      fi
      EXISTING_WT="$(worktree_for_branch "$BASE" 2>/dev/null || true)"
      if [[ -n "$EXISTING_WT" ]]; then
        # A base branch checked out in the main checkout is not issue work,
        # and git cannot check a branch out twice anyway. Refuse plainly
        # without ever recommending --reuse into the main checkout (#1034).
        if same_canonical_dir "$EXISTING_WT" "$PROJECT_ROOT"; then
          echo "Error: Branch '$BASE' is checked out in the main checkout ($PROJECT_ROOT); it cannot be checked out into a second worktree." >&2
          exit 1
        fi
        refuse_existing_worktree "$ISSUE" "$EXISTING_WT" || exit "$ACTIVE_WORK_EXIT"
      fi

      acquire_issue_claim_lock "$ISSUE" || exit 1
      guard_new_target_path "$ISSUE" "$WT_PATH" || exit "$ACTIVE_WORK_EXIT"
      if [[ -n "$PR" ]]; then
        BASE="$(resolve_pr_branch "$PR")" || exit 1
      fi
      fetch_origin || exit 1
      discover_ownership_remote_heads || exit 1
      if ! remote_branch_discovered origin "$BASE"; then
        echo "Error: Cannot resolve remote branch 'origin/$BASE'" >&2
        exit 1
      fi
      EXISTING_WT="$(worktree_for_branch "$BASE" 2>/dev/null || true)"
      if [[ -n "$EXISTING_WT" ]]; then
        # Same main-checkout guard as the pre-lock check above (#1034).
        if same_canonical_dir "$EXISTING_WT" "$PROJECT_ROOT"; then
          echo "Error: Branch '$BASE' is checked out in the main checkout ($PROJECT_ROOT); it cannot be checked out into a second worktree." >&2
          exit 1
        fi
        refuse_existing_worktree "$ISSUE" "$EXISTING_WT" || exit "$ACTIVE_WORK_EXIT"
      fi

      mkdir -p "$TREES_DIR"
      git -C "$PROJECT_ROOT" worktree add --track -b "$BASE" "$WT_PATH" "origin/$BASE" >/dev/null 2>&1 || \
        git -C "$PROJECT_ROOT" worktree add "$WT_PATH" "$BASE" >/dev/null 2>&1
    else
      build_candidate_branches "$ISSUE" "$BRANCH"
      discover_candidate_ownership || exit 1
      scan_candidate_ownership "$ISSUE" || exit "$ACTIVE_WORK_EXIT"
      acquire_issue_claim_lock "$ISSUE" || exit 1
      guard_new_target_path "$ISSUE" "$WT_PATH" || exit "$ACTIVE_WORK_EXIT"
      fetch_origin || exit 1
      discover_candidate_ownership || exit 1
      scan_candidate_ownership "$ISSUE" || exit "$ACTIVE_WORK_EXIT"

      BRANCH="${BRANCH:-$(issue_branch_name "$ISSUE")}"
      mkdir -p "$TREES_DIR"
      git -C "$PROJECT_ROOT" worktree add --no-track -b "$BRANCH" "$WT_PATH" "origin/$DEFAULT_BRANCH" >/dev/null 2>&1
    fi

    release_issue_claim_lock

    # Set upstream tracking if remote branch exists
    CREATED_BRANCH=$(git -C "$WT_PATH" branch --show-current 2>/dev/null)
    if [[ -n "$CREATED_BRANCH" ]]; then
      _REMOTE="${BOT_REMOTE_NAME:-origin}"
      if git -C "$WT_PATH" rev-parse --verify "$_REMOTE/$CREATED_BRANCH" &>/dev/null; then
        git -C "$WT_PATH" branch --set-upstream-to="$_REMOTE/$CREATED_BRANCH" "$CREATED_BRANCH" >/dev/null 2>&1 || true
        git -C "$WT_PATH" merge --ff-only "$_REMOTE/$CREATED_BRANCH" >/dev/null 2>&1 || true
      fi
    fi

    setup_app_worktree "$WT_PATH"
    echo "$WT_PATH"
    ;;

  list)
    git -C "$PROJECT_ROOT" worktree list
    ;;

  remove)
    REMOVE_FORCE=false
    ARG=""
    shift || true
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --help|-h)
          echo "Usage: $0 remove [ID|/path] [--force]"
          echo ""
          echo "Remove a worktree and delete its local branch when it is safely merged."
          echo "Accepts an issue ID (resolved under the configured worktree base dir, falling"
          echo "back to the worktree registered for the issue branch) or a direct path."
          echo ""
          echo "Options:"
          echo "  --force   Release an issue-keyed session lease even while the session that"
          echo "            claimed it is still running. Skips only that refusal; every other"
          echo "            safeguard is unchanged."
          exit 0
          ;;
        --force) REMOVE_FORCE=true; shift ;;
        # Reject stray option-looking arguments before they are treated as an
        # identifier and turned into a trees/<id> path. Otherwise any typo'd
        # flag would compute trees/<flag> and falsely report a removal, risking
        # deletion of an oddly-named path/ref (#619).
        -*)
          echo "Error: unknown option '$1' for remove" >&2
          echo "Run: $0 remove --help" >&2
          exit 1
          ;;
        *)
          if [[ -n "$ARG" ]]; then
            echo "Error: remove takes a single issue ID or path (got '$ARG' and '$1')" >&2
            exit 1
          fi
          ARG="$1"
          shift
          ;;
      esac
    done
    if [[ -z "$ARG" ]]; then
      echo "Error: remove requires an issue ID or path" >&2
      exit 1
    fi
    # Accept either issue ID or direct path. An issue-addressed removal also
    # carries the issue ID as an owner identity for the lease release (#907);
    # a path-addressed one has only the session env ladder.
    REMOVE_ISSUE_OWNER=""
    if [[ "$ARG" == */* ]]; then
      WT_PATH="$ARG"
    else
      WT_PATH="$(worktree_path_for_issue "$ARG")"
      REMOVE_ISSUE_OWNER="$(issue_session_owner "$ARG")"
    fi
    # Auto-relocate if cwd is inside the worktree being removed. Both sides
    # are physical (pwd -P); the boundary-aware match avoids treating a
    # sibling like .../issue-10 as inside .../issue-1.
    WT_REAL="$(cd "$WT_PATH" 2>/dev/null && pwd -P)" || WT_REAL=""
    CWD_REAL="$(pwd -P)"
    CWD_INSIDE_WT=false
    if [[ -n "$WT_REAL" ]] && [[ "$CWD_REAL" == "$WT_REAL" || "$CWD_REAL" == "$WT_REAL"/* ]]; then
      CWD_INSIDE_WT=true
      cd "$PROJECT_ROOT"
      echo "Relocated cwd to $PROJECT_ROOT" >&2
    fi
    BRANCH=""
    if [[ -d "$WT_PATH" ]]; then
      # Only a worktree registered to this repository (compared canonically,
      # so a legacy symlinked spelling still matches its physical form) may
      # be mutated. A foreign repo's worktree reachable through a shared or
      # symlinked base dir must not have its symlinks stripped or its
      # registration touched.
      if ! require_non_main_project_worktree "$WT_PATH" "remove it"; then
        exit 1
      fi
      # A session that claimed this worktree must be able to tear it down, and
      # its lease IS a native git lock — so the release has to come before the
      # lock precheck below, not after it (#877). Only our own lease is
      # released; a foreign one falls through and the precheck names its owner.
      if ! release_own_session_lease "$WT_PATH" "$REMOVE_ISSUE_OWNER" "$REMOVE_FORCE"; then
        exit 1
      fi
      # Diagnostic precheck: a locked worktree cannot be removed, and git's own
      # refusal names neither the owning session nor the unlock command (#800).
      # Runs after the ownership guard so a foreign or main checkout is rejected
      # on identity, never on another repo's lock state.
      if ! refuse_locked_worktree "$WT_PATH" "remove it"; then
        exit 1
      fi
      BRANCH=$(git -C "$WT_PATH" branch --show-current 2>/dev/null)
      # Let git remove the INTACT tree — it deletes the worktree contents itself,
      # so there is nothing to pre-strip. Stripping the configured symlinks first
      # left a live session's worktree without .agents/.claude/.env.local
      # whenever git then refused the removal (#800), and no precheck can close
      # that window: a lock acquired between the check and the strip lands right
      # back in the original failure mode. Because nothing is mutated before git
      # runs, a refusal issued BEFORE deletion begins — raced lock included —
      # leaves the tree whole. Git's deletion is not transactional, so a failure
      # partway through can still leave it partially removed; that is git's own
      # window, not one this script widens. Same ordering `cleanup` adopted in
      # #784, for the same reason.
      REMOVE_OUTPUT=""
      if ! REMOVE_OUTPUT="$(git -C "$PROJECT_ROOT" worktree remove --force "$WT_PATH" 2>&1)"; then
        echo "Error: Git could not remove the worktree; preserving it for manual recovery: $WT_PATH" >&2
        [[ -n "$REMOVE_OUTPUT" ]] && printf '%s\n' "$REMOVE_OUTPUT" | sed 's/^/  git: /' >&2
        echo "  Branch: ${BRANCH:-unknown} (not deleted)" >&2
        echo "Nothing was removed before Git ran, so a refusal made before deletion started (a lock, for example) leaves the worktree exactly as it was." >&2
        echo "Git's deletion is not atomic: if it failed partway through, the worktree may be partially removed — inspect its contents before retrying, and restore links with: $0 fix-links \"$WT_PATH\"" >&2
        exit 1
      fi
      # Safety net: remove directory if git left it behind
      [[ -d "$WT_PATH" ]] && rm -rf "$WT_PATH"
    fi
    git -C "$PROJECT_ROOT" worktree prune
    # Only delete local branch if merged (branch -d checks this). If the
    # worktree was removed but branch deletion is unsafe, report exactly what
    # remains instead of letting set -e exit silently after partial cleanup.
    BRANCH_DELETE_FAILED=false
    if [[ -n "$BRANCH" ]] && git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH"; then
      DELETE_OUTPUT=""
      if ! DELETE_OUTPUT=$(git -C "$PROJECT_ROOT" branch -d "$BRANCH" 2>&1); then
        BRANCH_DELETE_FAILED=true
        echo "Error: Removed worktree but could not delete local branch '$BRANCH'." >&2
        echo "  Remaining branch: $BRANCH" >&2
        echo "  Worktree path removed/pruned: $WT_PATH" >&2
        echo "  Safe delete refused by: git branch -d $BRANCH" >&2
        if [[ -n "$DELETE_OUTPUT" ]]; then
          printf '%s\n' "$DELETE_OUTPUT" | sed 's/^/  git: /' >&2
        fi
        echo "  After verifying it is safe, delete manually with: git -C \"$PROJECT_ROOT\" branch -D \"$BRANCH\"" >&2
      fi
    fi
    echo "Removed: $WT_PATH"
    if [[ "$CWD_INSIDE_WT" == true ]]; then
      echo "" >&2
      echo "Warning: Session cwd was inside deleted worktree. Start a new session from:" >&2
      echo "  $PROJECT_ROOT" >&2
    fi
    if [[ "$BRANCH_DELETE_FAILED" == true ]]; then
      exit 1
    fi
    ;;

  cleanup)
    CLEANUP_STALE=false
    CLEANUP_TTL_MINUTES="$SESSION_GUARD_DEFAULT_TTL_MINUTES"
    shift || true
    while [[ $# -gt 0 ]]; do
      case "$1" in
        --help|-h)
          echo "Usage: $0 cleanup [--stale] [--ttl-minutes N]"
          echo ""
          echo "Remove worktrees whose branch is already merged into origin/$DEFAULT_BRANCH."
          echo "A worktree held by a session guard lease is never collected, nor is a"
          echo "zero-commit worktree — a branch with no commits of its own is pending"
          echo "work, not merged work. Every skip is reported — a quiet cleanup means"
          echo "nothing was held back."
          echo ""
          echo "Options:"
          echo "  --stale             Also collect worktrees whose guard lease is past the TTL"
          echo "                      (an abandoned session). Releases the lease, then removes."
          echo "  --ttl-minutes N     Staleness horizon for --stale (default: $SESSION_GUARD_DEFAULT_TTL_MINUTES)"
          exit 0
          ;;
        --stale) CLEANUP_STALE=true; shift ;;
        --ttl-minutes)
          if [[ $# -lt 2 ]]; then
            echo "Error: --ttl-minutes requires a value" >&2
            exit 1
          fi
          if ! [[ "$2" =~ ^[0-9]{1,10}$ ]]; then
            echo "Error: --ttl-minutes must be a non-negative integer of at most 10 digits" >&2
            exit 1
          fi
          CLEANUP_TTL_MINUTES="$2"
          shift 2
          ;;
        *)
          echo "Error: unknown option '$1' for cleanup" >&2
          echo "Run: $0 cleanup --help" >&2
          exit 1
          ;;
      esac
    done
    git_with_github_https_auth -C "$PROJECT_ROOT" fetch --prune origin
    CLEANUP_FAILED=false
    CLEANUP_MERGE_TARGET="origin/$DEFAULT_BRANCH"
    if ! git -C "$PROJECT_ROOT" rev-parse --verify "$CLEANUP_MERGE_TARGET" >/dev/null 2>&1; then
      CLEANUP_MERGE_TARGET="$DEFAULT_BRANCH"
    fi
    # The target's first-parent chain, for telling merged work from a fresh
    # worktree. Ancestry alone cannot: a zero-commit branch is contained in
    # the target the moment `create` makes it, so cleanup collected brand-new
    # worktrees in the create→claim window (#923). Work merged by ancestry
    # reaches the target through a merge commit's side parent, so its tip is
    # NOT on this chain; a tip that IS on it has no commits of its own —
    # pending work, not merged work.
    CLEANUP_MAINLINE="$(git -C "$PROJECT_ROOT" rev-list --first-parent "$CLEANUP_MERGE_TARGET" 2>/dev/null || true)"
    # Collect candidates first: NUL-delimited porcelain parsing survives paths
    # with spaces, and the main checkout is excluded by canonical comparison —
    # git may report it under an older lexical (symlinked) spelling that a
    # textual match against $PROJECT_ROOT would miss.
    CLEANUP_TREES=()
    while IFS= read -r -d '' CLEANUP_LINE; do
      [[ "$CLEANUP_LINE" == worktree\ * ]] || continue
      CLEANUP_WT="${CLEANUP_LINE#worktree }"
      same_canonical_dir "$CLEANUP_WT" "$PROJECT_ROOT" && continue
      CLEANUP_TREES+=("$CLEANUP_WT")
    done < <(git -C "$PROJECT_ROOT" worktree list --porcelain -z)
    for wt in ${CLEANUP_TREES[@]+"${CLEANUP_TREES[@]}"}; do
      BRANCH=$(git -C "$wt" branch --show-current 2>/dev/null)
      if [[ -n "$BRANCH" ]] && \
         git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$BRANCH" && \
         git -C "$PROJECT_ROOT" merge-base --is-ancestor "$BRANCH" "$CLEANUP_MERGE_TARGET"; then
        # This runs BEFORE the lease probe: --stale must not release the lease
        # of a worktree the skip is about to keep.
        CLEANUP_TIP="$(git -C "$PROJECT_ROOT" rev-parse --verify --quiet "refs/heads/$BRANCH" || true)"
        if [[ -z "$CLEANUP_TIP" ]] || grep -qxF "$CLEANUP_TIP" <<<"$CLEANUP_MAINLINE"; then
          echo "Skipped (branch '$BRANCH' has no commits of its own — pending work, not merged): $wt" >&2
          echo "  Zero-commit worktrees are never collected; drop it explicitly with: $0 remove \"$wt\"" >&2
          continue
        fi
        # A merged branch does NOT mean an idle tree: uncommitted work in it is
        # exactly what gets lost. Ask the lease, not the branch.
        if ! cleanup_lease_permits_removal "$wt" "$(issue_session_owner "$BRANCH")"; then
          continue
        fi
        CLEANUP_REMOVE_OUTPUT=""
        if ! CLEANUP_REMOVE_OUTPUT="$(git -C "$PROJECT_ROOT" worktree remove --force "$wt" 2>&1)"; then
          CLEANUP_FAILED=true
          echo "Error: Git could not remove merged worktree; preserving it for manual recovery: $wt" >&2
          [[ -n "$CLEANUP_REMOVE_OUTPUT" ]] && printf '%s\n' "$CLEANUP_REMOVE_OUTPUT" | sed 's/^/  git: /' >&2
          continue
        fi
        if [[ -e "$wt" || -L "$wt" ]]; then
          CLEANUP_FAILED=true
          echo "Error: Git reported successful worktree removal but the path remains; preserving it for manual recovery: $wt" >&2
          continue
        fi
        if ! git -C "$PROJECT_ROOT" branch -D "$BRANCH" >/dev/null 2>&1; then
          CLEANUP_FAILED=true
          echo "Error: Removed merged worktree but could not delete local branch '$BRANCH'." >&2
          echo "  Remaining branch: $BRANCH" >&2
          echo "  Worktree path removed/pruned: $wt" >&2
          continue
        fi
        echo "Cleaned: $wt"
      fi
    done
    if [[ "$CLEANUP_FAILED" == true ]]; then
      exit 1
    fi
    ;;

  path)
    worktree_path_for_issue "${2:?Error: path requires an issue ID}"
    ;;

  exists)
    WT_PATH="$(worktree_path_for_issue "${2:?Error: exists requires an issue ID}")"
    [[ -d "$WT_PATH" ]] && echo "true" || echo "false"
    ;;

  check)
    UNCOMMITTED="false"
    UNPUSHED="false"
    UNPUSHED_LIST=""
    if ! git -C "$PROJECT_ROOT" diff --quiet HEAD 2>/dev/null || ! git -C "$PROJECT_ROOT" diff --cached --quiet HEAD 2>/dev/null; then
      UNCOMMITTED="true"
    fi
    UNPUSHED_COMMITS=$(git -C "$PROJECT_ROOT" log "origin/$DEFAULT_BRANCH..$DEFAULT_BRANCH" --oneline 2>/dev/null)
    if [[ -n "$UNPUSHED_COMMITS" ]]; then
      UNPUSHED="true"
      UNPUSHED_LIST=$(echo "$UNPUSHED_COMMITS" | jq -R -s -c 'split("\n") | map(select(. != ""))')
    fi
    echo "{\"uncommitted\": $UNCOMMITTED, \"unpushed\": $UNPUSHED, \"unpushed_commits\": ${UNPUSHED_LIST:-[]}}"
    ;;

  push)
    if [[ "${2:-}" == "--help" || "${2:-}" == "-h" ]]; then
      echo "Usage: $0 push [ID|/path] [--set-upstream|-u] [--no-rebase]"
      echo ""
      echo "Push worktree branch to remote. Auto-rebases onto origin/$DEFAULT_BRANCH first."
      echo "Auto-rebased and supported create --reuse/--restack pushes use --force-with-lease pinned to the pre-rewrite target branch OID."
      echo "When the auto-rebase rewrites branch commits, prints one 'rebase-map: <old-sha> <new-sha>' line per rewritten commit on stdout ('dropped' when the replayed commit vanished) so callers can remap recorded SHAs (vstack#728)."
      echo "Uses BOT_REMOTE_NAME from project config if set, otherwise falls back to origin."
      echo ""
      echo "Options:"
      echo "  -u, --set-upstream    Set upstream tracking branch"
      echo "  --no-rebase           Skip auto-rebase"
      exit 0
    fi
    ARG="${2:-}"
    SET_UPSTREAM=""
    AUTO_REBASE=true
    shift 2 || shift || true
    while [[ $# -gt 0 ]]; do
      case "$1" in
        -u|--set-upstream) SET_UPSTREAM="-u"; shift ;;
        --no-rebase) AUTO_REBASE=false; shift ;;
        *) shift ;;
      esac
    done

    if [[ -z "$ARG" ]]; then
      WT_PATH="$PWD"
    elif [[ "$ARG" == */* ]]; then
      WT_PATH="$ARG"
    elif WT_PATH="$(current_checkout_path_for_issue "$ARG")"; then
      :
    else
      WT_PATH="$(worktree_path_for_issue "$ARG")"
    fi

    if ! require_registered_project_worktree "$WT_PATH" "push it"; then
      exit 1
    fi
    # Push is the usual first command after a MANUAL rebase — the case the
    # script never sees, and so the case nothing repairs. `create --reuse` and
    # the restack controls re-run setup themselves, so they self-heal and do
    # not need the warning; this one does.
    warn_if_links_materialized "$WT_PATH"
    if [[ "$AUTO_REBASE" == true ]]; then
      validate_worktree_setup_config || exit 1
    fi

    REMOTE="${BOT_REMOTE_NAME:-origin}"
    if ! git -C "$WT_PATH" remote get-url "$REMOTE" >/dev/null 2>&1; then
      echo "Warning: Remote '$REMOTE' not found, falling back to origin" >&2
      REMOTE="origin"
    fi

    CURRENT_BRANCH=$(git -C "$WT_PATH" branch --show-current 2>/dev/null)
    PUSH_LEASE=()
    if [[ "$AUTO_REBASE" == true && -n "$CURRENT_BRANCH" && "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]]; then
      if LEASE_ARG="$(remote_ref_lease_arg "$WT_PATH" "$REMOTE" "$CURRENT_BRANCH")"; then
        PUSH_LEASE=("$LEASE_ARG")
      else
        exit 1
      fi
    fi

    if [[ "$AUTO_REBASE" == true ]]; then
      git_with_github_https_auth -C "$PROJECT_ROOT" fetch origin "+refs/heads/$DEFAULT_BRANCH:refs/remotes/origin/$DEFAULT_BRANCH" >/dev/null 2>&1 || true
      if [[ -n "$CURRENT_BRANCH" && "$CURRENT_BRANCH" != "$DEFAULT_BRANCH" ]]; then
        if git -C "$WT_PATH" merge-base --is-ancestor "origin/$DEFAULT_BRANCH" HEAD; then
          echo "→ origin/$DEFAULT_BRANCH already contained in $CURRENT_BRANCH; skipping rebase" >&2
        else
          # Snapshot the branch-only commits before/after the rebase so a
          # rewrite is reported as an old→new commit map (vstack#728).
          PRE_REBASE_COMMITS="$(git -C "$WT_PATH" log --reverse --format='%H %s' "origin/$DEFAULT_BRANCH..HEAD")"
          if ! git -C "$WT_PATH" rebase "origin/$DEFAULT_BRANCH" >/dev/null 2>&1; then
            git -C "$WT_PATH" rebase --abort >/dev/null 2>&1 || true
            echo "Error: Rebase onto origin/$DEFAULT_BRANCH failed (conflicts). Push with --no-rebase or resolve manually." >&2
            exit 1
          fi
          # Rebase can replace symlinks with tracked content — restore them
          setup_worktree_links "$WT_PATH"
          POST_REBASE_COMMITS="$(git -C "$WT_PATH" log --reverse --format='%H %s' "origin/$DEFAULT_BRANCH..HEAD")"
          emit_rebase_map "$PRE_REBASE_COMMITS" "$POST_REBASE_COMMITS"
        fi
      fi
    fi

    CURRENT_BRANCH=$(git -C "$WT_PATH" branch --show-current 2>/dev/null)
    if [[ -z "$SET_UPSTREAM" && -n "$CURRENT_BRANCH" ]]; then
      UPSTREAM=$(git -C "$WT_PATH" config "branch.${CURRENT_BRANCH}.remote" 2>/dev/null || true)
      [[ -z "$UPSTREAM" ]] && SET_UPSTREAM="-u"
    fi

    if [[ -n "$SET_UPSTREAM" ]]; then
      # ${arr[@]+...} guard: empty-array expansion is an unbound variable
      # under Bash 3.2 with set -u.
      if ! git_with_github_https_auth -C "$WT_PATH" push "$SET_UPSTREAM" ${PUSH_LEASE[@]+"${PUSH_LEASE[@]}"} "$REMOTE" "HEAD:refs/heads/${CURRENT_BRANCH}"; then
        if [[ ${#PUSH_LEASE[@]} -gt 0 ]]; then
          echo "Error: Push rejected. Remote '$REMOTE/$CURRENT_BRANCH' may have changed since the force-with-lease expectation; fetch and rebase/merge before retrying." >&2
        fi
        exit 1
      fi
    else
      if ! git_with_github_https_auth -C "$WT_PATH" push ${PUSH_LEASE[@]+"${PUSH_LEASE[@]}"} "$REMOTE" HEAD; then
        if [[ ${#PUSH_LEASE[@]} -gt 0 ]]; then
          echo "Error: Push rejected. Remote '$REMOTE/$CURRENT_BRANCH' may have changed since the force-with-lease expectation; fetch and rebase/merge before retrying." >&2
        fi
        exit 1
      fi
    fi
    clear_restack_push_authorization "$WT_PATH"
    ;;

  fix-links)
    # Restore symlinks in a worktree (run after manual rebase/merge that clobbers them)
    ARG="${2:-}"
    if [[ -z "$ARG" ]]; then
      WT_PATH="$PWD"
    elif [[ "$ARG" == */* ]]; then
      WT_PATH="$ARG"
    else
      WT_PATH="$(worktree_path_for_issue "$ARG")"
    fi
    if ! require_non_main_project_worktree "$WT_PATH" "restore links in it"; then
      exit 1
    fi
    setup_worktree_links "$WT_PATH"
    # Re-assert the shared auto-repair hooks too (#1032): a fix-links run is
    # the natural refresh point after upgrading the skill or the config.
    install_worktree_autorepair_hooks
    echo "Restored symlinks in $WT_PATH"
    ;;

  repair-links)
    # Hook-driven sibling of fix-links (#1032): re-assert configured
    # WORKTREE_SYMLINKS after a git operation, refusing to destroy any data
    # git does not track that a materialized path has accumulated. Exits 0
    # quietly for the main checkout or an unregistered path because its
    # callers are shared git hooks that fire for every checkout of the repo.
    ARG="${2:-}"
    if [[ -z "$ARG" ]]; then
      WT_PATH="$PWD"
    elif [[ "$ARG" == */* ]]; then
      WT_PATH="$ARG"
    else
      WT_PATH="$(worktree_path_for_issue "$ARG")"
    fi
    if ! is_git_worktree_path "$WT_PATH" || \
       ! is_registered_project_worktree "$WT_PATH" || \
       same_canonical_dir "$WT_PATH" "$PROJECT_ROOT"; then
      exit 0
    fi
    repair_worktree_links "$WT_PATH"
    ;;

  codex-setup)
    # Codex Desktop owns worktree creation. This command applies the same
    # project-local setup that `create` applies after git has already created
    # the worktree: env/config symlinks, configured copies/dirs, optional bot
    # git config, optional bot remote, and lightweight dependency bootstrap.
    ARG="${2:-}"
    if [[ -z "$ARG" ]]; then
      WT_PATH="$PWD"
    elif [[ "$ARG" == */* ]]; then
      WT_PATH="$ARG"
    else
      WT_PATH="$(worktree_path_for_issue "$ARG")"
    fi
    if ! require_non_main_project_worktree "$WT_PATH" "configure it"; then
      exit 1
    fi
    setup_app_worktree "$WT_PATH"
    echo "Configured Codex worktree: $WT_PATH"
    ;;

  codex-branch)
    # Codex Desktop may create an app-managed branch name. Normalize the
    # current worktree to the issue branch expected by orch before
    # running `orch start <ISSUE>`.
    ISSUE="${2:?Error: codex-branch requires an issue ID or branch name}"
    ARG="${3:-}"
    if [[ -z "$ARG" ]]; then
      WT_PATH="$PWD"
    elif [[ "$ARG" == */* ]]; then
      WT_PATH="$ARG"
    else
      WT_PATH="$(worktree_path_for_issue "$ARG")"
    fi
    if ! require_non_main_project_worktree "$WT_PATH" "normalize its branch"; then
      exit 1
    fi
    validate_worktree_setup_config || exit 1

    TARGET_BRANCH="$(issue_branch_name "$ISSUE")"
    CURRENT_BRANCH="$(git -C "$WT_PATH" branch --show-current 2>/dev/null || true)"
    if [[ "$CURRENT_BRANCH" == "$TARGET_BRANCH" ]]; then
      echo "Codex worktree already on $TARGET_BRANCH: $WT_PATH"
      exit 0
    fi

    # Preserve Codex Desktop's historical best-effort normalization behavior;
    # fail-closed ownership discovery is specific to `create` claims.
    git_with_github_https_auth -C "$PROJECT_ROOT" fetch origin >/dev/null 2>&1 || true
    _REMOTE="${BOT_REMOTE_NAME:-origin}"
    if git -C "$PROJECT_ROOT" show-ref --verify --quiet "refs/heads/$TARGET_BRANCH"; then
      git -C "$WT_PATH" switch "$TARGET_BRANCH" >/dev/null 2>&1 || {
        echo "Error: Branch '$TARGET_BRANCH' already exists and cannot be checked out in $WT_PATH" >&2
        exit 1
      }
    elif git -C "$PROJECT_ROOT" rev-parse --verify "$_REMOTE/$TARGET_BRANCH" >/dev/null 2>&1; then
      git -C "$WT_PATH" switch -c "$TARGET_BRANCH" --track "$_REMOTE/$TARGET_BRANCH" >/dev/null 2>&1
    elif [[ -n "$CURRENT_BRANCH" ]]; then
      git -C "$WT_PATH" branch -m "$TARGET_BRANCH"
    else
      git -C "$WT_PATH" switch -c "$TARGET_BRANCH" >/dev/null 2>&1
    fi

    if git -C "$WT_PATH" rev-parse --verify "$_REMOTE/$TARGET_BRANCH" >/dev/null 2>&1; then
      git -C "$WT_PATH" branch --set-upstream-to="$_REMOTE/$TARGET_BRANCH" "$TARGET_BRANCH" >/dev/null 2>&1 || true
    fi
    setup_app_worktree "$WT_PATH"
    echo "Codex worktree branch ready: $TARGET_BRANCH ($WT_PATH)"
    ;;

  codex-cleanup)
    # Codex Desktop owns worktree/branch deletion. This hook is intentionally
    # non-destructive and does not remove symlinks: if the app fails to delete
    # the worktree immediately after cleanup, mutating tracked symlink paths can
    # leave the worktree dirty. Project-level teardown (containers, caches)
    # belongs in the Codex environment cleanup script after this command.
    ARG="${2:-}"
    if [[ -z "$ARG" ]]; then
      WT_PATH="$PWD"
    elif [[ "$ARG" == */* ]]; then
      WT_PATH="$ARG"
    else
      WT_PATH="$(worktree_path_for_issue "$ARG")"
    fi
    echo "Codex cleanup hook complete; app owns worktree deletion: $WT_PATH"
    ;;

  claude-setup)
    # Claude Code owns worktree creation for `--worktree` sessions, subagents
    # with `isolation: worktree`, and desktop parallel sessions — all of which
    # run a bare `git worktree add` and so produce a worktree with no `.agents`,
    # no `.claude/*` links and no `.env.local`. Wire this from a consumer repo's
    # `.claude/settings.json` WorktreeCreate hook; because that hook lives in
    # PROJECT-level settings it applies to every Claude config-dir variant on
    # the machine (CLAUDE_CONFIG_DIR only moves user-level config).
    #
    # Same provisioning as codex-setup — see setup_app_worktree.
    ARG="${2:-}"
    if [[ -z "$ARG" ]]; then
      WT_PATH="$PWD"
    elif [[ "$ARG" == */* ]]; then
      WT_PATH="$ARG"
    else
      WT_PATH="$(worktree_path_for_issue "$ARG")"
    fi
    if ! require_non_main_project_worktree "$WT_PATH" "configure it"; then
      exit 1
    fi
    setup_app_worktree "$WT_PATH"
    echo "Configured Claude worktree: $WT_PATH"
    ;;

  claude-cleanup)
    # Claude Code owns worktree/branch deletion. Non-destructive for the same
    # reason as codex-cleanup: mutating tracked symlink paths before the app has
    # actually removed the worktree can leave it dirty.
    ARG="${2:-}"
    if [[ -z "$ARG" ]]; then
      WT_PATH="$PWD"
    elif [[ "$ARG" == */* ]]; then
      WT_PATH="$ARG"
    else
      WT_PATH="$(worktree_path_for_issue "$ARG")"
    fi
    echo "Claude cleanup hook complete; app owns worktree deletion: $WT_PATH"
    ;;

  *)
    echo "Usage: $0 create|restack|list|remove|cleanup [--stale]|path|exists|check|push|fix-links|repair-links|codex-setup|codex-branch|codex-cleanup|claude-setup|claude-cleanup [ID|/path] [options]" >&2
    exit 1
    ;;
esac
