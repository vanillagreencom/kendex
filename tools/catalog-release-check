#!/usr/bin/env python3
"""Check and render a catalog with the installed release, without changing it.

Usage: catalog-release-check BINARY CATALOG [--allow-advisories] [--prior PRIOR]
The fresh leg installs CATALOG into a new project. With --prior, the upgrade
leg installs PRIOR with every package it ships declared, then refreshes that
project to CATALOG through the same declared source, as a consumer's refresh
does after a catalog merge. A PRIOR the engine's own catalog check refuses
skips the upgrade leg.
Report protocol: catalog-release: version=JSON leg=NAME feature=JSON then
catalog-release: remedy=KEY on failure, catalog-release: version=JSON
result=pass legs=NAMES on success, and catalog-release: upgrade=skip
cause=prior-uninstallable feature=JSON before a pass on the fresh leg alone.
The feature value is the engine's diagnostic, not a second feature classifier.
Core owns declared-hook delivery and catalog validation rules.
"""

import json
import os
from pathlib import Path
import subprocess
import sys
import tempfile

REFRESH = ["refresh", "--scope", "project", "--yes", "--leave"]
VERIFY = ["verify", "--scope", "project"]
# Each leg's remedy: a stable key, then what to do. A third-party catalog can
# neither release kendex nor read its app-deploy skill, so the upgrade remedy
# is stated in full here.
REMEDIES = {
    "fresh": ("release-engine", "Release an engine that supports this catalog before merging it. See the kendex app-deploy skill § Catalog compatibility."),
    "upgrade": ("keep-package", "The refresh from the base commit's catalog failed above. Where a package that catalog shipped is gone or renamed here, every existing install that declares it fails the same way: keep the package, a stub is enough, until a released kendex retires it."),
}


def arguments(argv):
    usage = "catalog-release: cause=arguments\nExpected BINARY CATALOG [--allow-advisories] [--prior PRIOR]."
    if len(argv) < 2:
        raise SystemExit(usage)
    binary, catalog, options = argv[0], argv[1], argv[2:]
    strict = ["--strict"]
    prior = None
    while options:
        if options[0] == "--allow-advisories" and strict:
            strict, options = [], options[1:]
        elif options[0] == "--prior" and prior is None and len(options) > 1:
            prior, options = options[1], options[2:]
        else:
            raise SystemExit(usage)
    return binary, catalog, strict, prior


def install(source):
    return ["add", str(source), "--all", "--all-harnesses",
            "--copy", "--yes", "--throwaway", "--leave"]


def leg(binary, place, ceilings):
    """A runner for one leg: its own home and project under place."""
    home = place / "home"
    project = place / "project"
    home.mkdir(parents=True)
    (project / ".agents").mkdir(parents=True)
    # No credentials or live kendex settings reach the child.
    environment = {
        "PATH": os.environ["PATH"],
        "HOME": str(home),
        "XDG_CONFIG_HOME": str(home / ".config"),
        "XDG_DATA_HOME": str(home / ".local/share"),
        "XDG_CACHE_HOME": str(home / ".cache"),
        "KENDEX_REAL_HOME": "1",
        "KENDEX_UI": "plain",
        "GIT_CEILING_DIRECTORIES": ceilings,
    }

    def run(command, check=False):
        return subprocess.run(
            [binary, *command], env=environment, cwd=project,
            capture_output=True, text=True, check=check,
        )
    return run


def settle(run, commands, diagnostics):
    """Run each command in order; the diagnostics so far once one fails."""
    for command in commands:
        rendered = run(command)
        diagnostics.append("\n".join(filter(None, (
            rendered.stderr.strip(), rendered.stdout.strip(),
        ))))
        if rendered.returncode != 0:
            return "\n".join(diagnostics)
    return None


def main():
    binary, catalog, strict, prior = arguments(sys.argv[1:])
    binary = str(Path(binary).resolve(strict=True))
    catalog = Path(catalog).resolve(strict=True)
    prior = None if prior is None else Path(prior).resolve(strict=True)
    # All writes, including project registration, belong to this one scratch
    # lifetime.
    with tempfile.TemporaryDirectory(dir=os.environ.get("RUNNER_TEMP")) as scratch:
        root = Path(scratch)
        # An archived catalog and the render project must not inherit an
        # enclosing checkout's ignored tmp/ directory. A catalog's own
        # repository remains discoverable, including its ignore rules; git
        # resolves the upgrade leg's source link to the catalog it names.
        ceilings = os.pathsep.join((str(catalog.parent), str(root)))
        fresh = leg(binary, root / "fresh", ceilings)
        version = fresh(["--version"], check=True).stdout.strip().removeprefix("kendex ")

        def failed(name, diagnostic):
            key, remedy = REMEDIES[name]
            print(f"catalog-release: version={json.dumps(version)} leg={name} feature={json.dumps(diagnostic)}")
            print(f"catalog-release: remedy={key}\n{remedy}")
            return 1

        diagnostic = settle(fresh, [
            ["check", "--catalog", str(catalog), *strict],
            install(catalog), REFRESH, VERIFY,
        ], [])
        if diagnostic is not None:
            return failed("fresh", diagnostic)
        legs = ["fresh"]
        if prior is not None:
            upgrade = leg(binary, root / "upgrade", ceilings)
            # The engine's catalog check answers whether it accepts the base.
            # A base it refuses is no install this leg can model, and failing
            # on one would hold back the change that repairs it.
            refused = settle(upgrade, [["check", "--catalog", str(prior)]], [])
            if refused is not None:
                print(f"catalog-release: upgrade=skip cause=prior-uninstallable feature={json.dumps(refused)}")
            else:
                # The manifest records the source by this path, so the refresh
                # reaches the candidate through the one declaration, as a
                # consumer's subscription does across a catalog merge.
                source = root / "upgrade" / "catalog"
                source.symlink_to(prior, target_is_directory=True)
                diagnostics = []
                diagnostic = settle(upgrade, [install(source)], diagnostics)
                if diagnostic is None:
                    source.unlink()
                    source.symlink_to(catalog, target_is_directory=True)
                    diagnostic = settle(upgrade, [REFRESH, VERIFY], diagnostics)
                if diagnostic is not None:
                    return failed("upgrade", diagnostic)
                legs.append("upgrade")
        print(f"catalog-release: version={json.dumps(version)} result=pass legs={','.join(legs)}")
        return 0


if __name__ == "__main__":
    sys.exit(main())
