#!/usr/bin/env bash
# Folds the changelog fragments into the collated record's [Unreleased]
# section and deletes them. One entry is one file, so no two branches ever
# write the same record line; this is the step that turns the files back into
# sections, and only the release commit runs it.
#
# It judges nothing, and it decides nothing about the changelog either.
# Which tracked paths are fragments, which section each belongs to, whether
# one is well formed — its shape, its length, a symlink or binary content
# where changelog text should be — which file is the collated record, and
# where that record's [Unreleased] section begins and ends are all the
# growth-guards changelog-entries lane's answers, the last of them from the
# grammar that lane judges by. This run asks for them and folds in exactly
# what it is told. One grammar, invoked here and at every commit, rather than
# two spellings that can drift — a second search for the heading is what puts
# entries under a fenced example of it.
#
# The fragments are the ones git carries, not whatever is on disk: the judge
# reads the index, and an untracked stray nobody wrote cannot stop a release.
# Their content, and the record's, are read from the working tree, so any path
# the judgement covers that the index and the disk disagree about stops the
# write — that is what makes the judge's verdict a verdict over the bytes
# about to be published. Which paths those are is the judge's answer too,
# never a list spelled a second time here.
#
# Every path moves as NUL-terminated bytes from the judge's records to the
# fold and the delete, so a fragment whose name carries a newline is folded in
# and removed like any other — and every path that reaches a message goes
# through gg_shown on the way, because a guarantee dropped at the reporting
# step is a name that forges a diagnostic line or reaches a terminal as
# control codes.
#
# Exit codes follow the guard family: 0 clean, 1 a fragment the judge
# refuses, 2 could not run. The record is replaced whole or not at all.
set -euo pipefail

# The heading each section name is written under, in the order they are
# emitted. A rendering table, not a rule: the judge is what says which
# section a fragment belongs to, and what the section names are.
SECTIONS="added:Added changed:Changed deprecated:Deprecated removed:Removed fixed:Fixed security:Security"

JUDGE=.agents/skills/growth-guards/scripts/changelog-entries
GG_LIB=.agents/skills/growth-guards/scripts/lib
TAB="$(printf '\t')"

if [ "$#" -gt 0 ]; then
  echo "changelog-collate: usage: changelog-collate" >&2
  exit 2
fi

die() { # an environment the run cannot work in
  echo "changelog-collate: $1" >&2
  exit 2
}
note() { echo "changelog-collate: $1"; }

ROOT="$(git rev-parse --show-toplevel)" || die "not inside a git work tree — the collation could not run"
# printf %q, not gg_shown: this runs before the library that defines it can be
# read, and the root is still somebody's path bytes going into a message.
cd "$ROOT" || die "could not enter $(printf '%q' "$ROOT") — the collation could not run"

# The record's section boundaries come from the grammar the judge compares
# against HEAD with, so the two cannot disagree about where [Unreleased] is.
GG_CHECK=changelog-collate
for lib in common.sh changelog-grammar.sh; do
  [ -r "$GG_LIB/$lib" ] || die "$GG_LIB/$lib is missing — the changelog grammar could not be read; reinstall the growth-guards skill"
done
# shellcheck source=../.agents/skills/growth-guards/scripts/lib/common.sh
source "$GG_LIB/common.sh" || die "could not load $GG_LIB/common.sh"
# shellcheck source=../.agents/skills/growth-guards/scripts/lib/changelog-grammar.sh
source "$GG_LIB/changelog-grammar.sh" || die "could not load $GG_LIB/changelog-grammar.sh"

TMP="$(mktemp -d)" || die "could not create a work directory — the collation could not run"
OUT=""
cleanup() {
  rm -rf "$TMP"
  if [ -n "$OUT" ]; then rm -f -- "$OUT"; fi
  return 0
}
trap cleanup EXIT

# The judge, first: it refuses, and on a clean verdict it names every
# fragment, the section it belongs to, and the record. Nothing is folded in
# while it refuses anything, and its verdict is this run's.
[ -x "$JUDGE" ] || die "$JUDGE is missing or not executable — the fragment judge could not run; reinstall the growth-guards skill"
judge_status=0
"$JUDGE" --list >"$TMP/list" || judge_status=$?
case "$judge_status" in
  0) : ;;
  1) exit 1 ;;
  *) die "$JUDGE could not run (exit $judge_status) — nothing was written" ;;
esac

# TYPE<TAB>...  per NUL-terminated record, in the judge's own order — which is
# index order, so each section's fragments arrive in the filename order the
# release notes have always read.
: >"$TMP/frags"
: >"$TMP/dirs"
for pair in $SECTIONS; do : >"$TMP/sel.${pair%%:*}"; done
count=0
RECORD=""
start=0
end=0
: >"$TMP/secline"
guarded=()
while IFS= read -r -d '' rec; do
  kind=${rec%%$'\t'*}
  rest=${rec#*$'\t'}
  case "$kind" in
    record)
      RECORD="$rest"
      guarded+=(":(literal)$rest")
      continue
      ;;
    # The record's accepted shape, decided by the judge that just accepted it.
    # Line numbers into the file the guard below holds equal to the index.
    record-unreleased)
      start="$rest"
      continue
      ;;
    record-end)
      end="$rest"
      continue
      ;;
    record-section)
      printf '%s\t%s\n' "${rest%%"$TAB"*}" "${rest#*"$TAB"}" >>"$TMP/secline"
      continue
      ;;
    fragment) : ;;
    *) die "$JUDGE emitted a record this collation does not understand: $(gg_shown "$kind")" ;;
  esac
  sec=${rest%%$'\t'*}
  path=${rest#*$'\t'}
  # Not a second grammar: the judge decides the section, and this is the
  # rendering table refusing a name it has no heading for. gg_is_section, not
  # a containment test over the table: this name came off a PATH, which may
  # carry the space the table is joined by.
  if ! gg_is_section "$sec"; then
    die "$JUDGE named section $(gg_shown "$sec") for $(gg_shown "$path"), which has no heading here — the collation could not run"
  fi
  [ -f "$path" ] || die "$(gg_shown "$path") is in the index but not a file on disk — the collation could not run"
  printf '%s\0' "$path" >>"$TMP/sel.$sec"
  printf '%s\0' "$path" >>"$TMP/frags"
  # The directory each fragment sits in, so an emptied one can go with it
  # without this run spelling the fragment tree a second time.
  printf '%s\0' "${path%/*}" >>"$TMP/dirs"
  guarded+=(":(literal)$path")
  count=$((count + 1))
done <"$TMP/list"

if [ "$count" -eq 0 ]; then
  note "no fragments — nothing to collate"
  exit 0
fi

# One record path, for the guard, the split and the replacement alike. The
# judge names it or the scope is off, and a collation with nowhere to fold
# into refuses rather than writing some other file.
[ -n "$RECORD" ] \
  || die "the changelog-entries record scope is off (GROWTH_GUARDS_CHANGELOG_RECORD is empty), so there is no collated record to fold these fragments into"

# git carries the record, or the staleness guard below cannot see it: `git
# diff` says nothing about an untracked file, so the collation would rewrite
# a record no judge ever measured and then delete the tracked fragments that
# went into it. A record staged for the first time satisfies this; one that
# was never added does not.
tracked=0
git ls-files --error-unmatch -- ":(literal)$RECORD" >/dev/null 2>&1 || tracked=$?
case "$tracked" in
  0) : ;;
  1) die "$(gg_shown "$RECORD") is not tracked, so nothing measured it and nothing would notice it change — stage it first" ;;
  *) die "could not ask git whether $(gg_shown "$RECORD") is tracked (git ls-files exit $tracked) — the collation could not run" ;;
esac

# The write folds in each file on disk and then deletes it, and it replaces
# the record with what it read there — so an unstaged edit to any of them
# would be published without the judge ever having measured it. The paths
# checked are the ones the judge just named, so the guard and the thing it
# guards cannot drift apart.
git diff --name-only -z -- "${guarded[@]}" >"$TMP/dirty" ||
  die "could not compare the changelog against the index — the collation could not run"
if [ -s "$TMP/dirty" ]; then
  # One line per path, each rendered: a name carrying a newline would
  # otherwise forge lines in this very diagnostic, and an ESC would reach the
  # terminal that prints it.
  shown=""
  while IFS= read -r -d '' dirty_path; do
    shown="$shown  $(gg_shown "$dirty_path")"$'\n'
  done <"$TMP/dirty"
  die "the changelog differs between git and the working tree; the collation publishes the files on disk and the judge measures the ones git carries — stage or restore these first:
${shown%$'\n'}"
fi

# awk normalizes a fragment that ends without a newline, which would
# otherwise glue two entries into one line.
for pair in $SECTIONS; do
  low=${pair%%:*}
  : >"$TMP/frag.$low"
  : >"$TMP/sec.$low"
  while IFS= read -r -d '' f; do
    awk 1 "$f" >>"$TMP/frag.$low" || die "could not read $(gg_shown "$f") — the collation could not run"
  done <"$TMP/sel.$low"
done

[ -f "$RECORD" ] || die "$(gg_shown "$RECORD") is missing — the collation could not run"
: >"$TMP/pre"
: >"$TMP/lead"
: >"$TMP/post"

# Where the section begins, which level-3 headings it holds and where it ends
# came off the judge's stream above, as line numbers. It is the judge that
# says a record has a section, has one of them, and names only headings this
# family can write under — so a record refused there never reaches here, and
# there is no second opinion to drift from the first. What is left is to
# split the file at numbers somebody else decided.
[ "$start" -gt 0 ] \
  || die "$JUDGE accepted $(gg_shown "$RECORD") without saying where its [Unreleased] section begins — the collation could not run"

# Split at those numbers: the part above the heading, that section's lead and
# per-section bodies, and the released versions below it. A body keeps one
# blank line between its entries and none at its edges, so a section the file
# spells under two headings comes out as one list.
rc=0
awk -v tmp="$TMP" -v start="$start" -v end="$end" -v table="$TMP/secline" '
  BEGIN {
    while ((getline l < table) > 0) {
      split(l, p, "\t")
      secline[p[1] + 0] = p[2]
    }
    close(table)
    out = tmp "/lead"
    insec = 0
  }
  NR <= start { print > (tmp "/pre"); next }
  end > 0 && NR >= end { print > (tmp "/post"); next }
  NR in secline {
    out = tmp "/sec." secline[NR]
    insec = 1
    started = 0
    held = 0
    next
  }
  insec {
    if ($0 ~ /[^[:space:]]/) {
      if (held) print "" > out
      held = 0
      print > out
      started = 1
    } else if (started) {
      held = 1
    }
    next
  }
  { print > out }
' "$RECORD" || rc=$?
[ "$rc" -eq 0 ] || die "$(gg_shown "$RECORD") could not be split (awk exit $rc) — the collation could not run"

trim() { # FILE — its content, edge blank lines dropped, interior runs capped at one
  awk '
    /[^[:space:]]/ {
      if (held) print ""
      held = 0
      print
      started = 1
      next
    }
    started { held = 1 }
  ' "$1"
}

# Every part carries its own failure out. The caller runs this as the left
# operand of ||, where the shell suppresses errexit and would otherwise pass
# off the last command's status as the whole file's.
assemble() {
  cat "$TMP/pre" || return 1
  trim "$TMP/lead" || return 1
  for pair in $SECTIONS; do
    low=${pair%%:*}
    name=${pair#*:}
    if [ -s "$TMP/sec.$low" ] || [ -s "$TMP/frag.$low" ]; then
      printf '\n### %s\n\n' "$name" || return 1
      cat "$TMP/sec.$low" || return 1
      cat "$TMP/frag.$low" || return 1
    fi
  done
  if [ -s "$TMP/post" ]; then
    printf '\n' || return 1
  fi
  cat "$TMP/post" || return 1
}

OUT="$(mktemp -- "$RECORD.XXXXXX")" || die "could not create the replacement file — the collation could not run"
cp -p -- "$RECORD" "$OUT" || die "could not take $(gg_shown "$RECORD")'s mode — the collation could not run"
assemble >"$OUT" || die "could not write the collated changelog — $(gg_shown "$RECORD") is untouched"
mv -- "$OUT" "$RECORD" || die "could not replace $(gg_shown "$RECORD") — the collation could not run"
OUT=""

# Past the move, every fragment is in the record. Deleting stops for none of
# them: one left behind folds in a second time on the next run, so the refusal
# has to name every survivor, not the first.
survivors=""
while IFS= read -r -d '' f; do
  rm -f -- "$f" || survivors="$survivors  $(gg_shown "$f")"$'\n'
done <"$TMP/frags"
if [ -n "$survivors" ]; then
  die "$(gg_shown "$RECORD") is collated, but these fragments survived and would fold in a second time — delete them by hand:
${survivors%$'\n'}"
fi
# A directory the collation emptied goes with it — the ones the folded
# fragments came out of, not a tree named a second time here. Not-empty and
# not-found are both ordinary, and neither leaves anything to act on.
while IFS= read -r -d '' d; do
  rmdir -- "$d" 2>/dev/null || true
done <"$TMP/dirs"

if [ "$count" -eq 1 ]; then noun=entry; else noun=entries; fi
note "folded $count $noun into $(gg_shown "$RECORD")'s [Unreleased] section"
