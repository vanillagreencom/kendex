#!/usr/bin/env bash
# Folds the changelog.d fragments into CHANGELOG.md's [Unreleased] section
# and deletes them. One entry is one file, so no two branches ever write the
# same CHANGELOG line; this is the step that turns the files back into
# sections, and only the release commit runs it.
#
# It judges nothing, and it does not decide what a fragment is either. Which
# tracked paths are fragments, which section each belongs to, and whether one
# is well formed — its shape, its length, a symlink or binary content where
# changelog text should be — are all the growth-guards changelog-entries
# lane's answers. This run asks that lane for its list and folds in exactly
# what it names. One grammar, invoked here and at every commit, rather than
# two spellings that can drift.
#
# The fragments are the ones git carries, not whatever is on disk: the judge
# reads the index, and an untracked stray nobody wrote cannot stop a release.
# Their content, and the record's, are read from the working tree, so a
# changelog.d or a CHANGELOG.md that the index and the disk disagree about
# stops the write — that is what makes the judge's verdict a verdict over the
# bytes about to be published.
#
# Exit codes follow the guard family: 0 clean, 1 a fragment the judge
# refuses, 2 could not run. CHANGELOG.md is replaced whole or not at all.
set -euo pipefail

# The heading each section name is written under, in the order they are
# emitted. A rendering table, not a rule: the judge is what says which
# section a fragment belongs to, and what the section names are.
SECTIONS="added:Added changed:Changed deprecated:Deprecated removed:Removed fixed:Fixed security:Security"

JUDGE=.agents/skills/growth-guards/scripts/changelog-entries

if [ "$#" -gt 0 ]; then
  echo "changelog-collate: usage: changelog-collate" >&2
  exit 2
fi

die() { # an environment the run cannot work in
  echo "changelog-collate: $1" >&2
  exit 2
}
note() { echo "changelog-collate: $1"; }

ROOT="$(git rev-parse --show-toplevel)" || die "not inside a git work tree — the collation could not run"
cd "$ROOT" || die "could not enter $ROOT — the collation could not run"

TMP="$(mktemp -d)" || die "could not create a work directory — the collation could not run"
OUT=""
cleanup() {
  rm -rf "$TMP"
  if [ -n "$OUT" ]; then rm -f -- "$OUT"; fi
  return 0
}
trap cleanup EXIT

# The write folds in the file on disk and then deletes it, and it replaces
# CHANGELOG.md with what it read there — so an unstaged edit to either would
# be published without the judge ever having measured it. Both trees are
# settled before the judge is asked anything.
dirty="$(git diff --name-only -- changelog.d CHANGELOG.md)" ||
  die "could not compare the changelog against the index — the collation could not run"
if [ -n "$dirty" ]; then
  die "the changelog differs between git and the working tree; the collation publishes the files on disk and the judge measures the ones git carries — stage or restore these first:
$(printf '%s\n' "$dirty" | sed 's/^/  /')"
fi

# The judge, before anything is written: it refuses, and on a clean verdict
# it names every fragment and the section it belongs to. Nothing is folded in
# while it refuses anything, and its verdict is this run's.
[ -x "$JUDGE" ] || die "$JUDGE is missing or not executable — the fragment judge could not run; reinstall the growth-guards skill"
judge_status=0
"$JUDGE" --list >"$TMP/list" || judge_status=$?
case "$judge_status" in
  0) : ;;
  1) exit 1 ;;
  *) die "$JUDGE could not run (exit $judge_status) — nothing was written" ;;
esac

# SECTION<TAB>PATH per NUL-terminated record, in the judge's own order.
: >"$TMP/frags"
for pair in $SECTIONS; do : >"$TMP/sel.${pair%%:*}"; done
while IFS= read -r -d '' rec; do
  sec=${rec%%$'\t'*}
  path=${rec#*$'\t'}
  # Not a second grammar: the judge decides the section, and this is the
  # rendering table refusing a name it has no heading for.
  case " $SECTIONS " in
    *" $sec:"*) : ;;
    *) die "$JUDGE named section '$sec' for $path, which has no heading here — the collation could not run" ;;
  esac
  [ -f "$path" ] || die "$path is in the index but not a file on disk — the collation could not run"
  printf '%s\n' "$path" >>"$TMP/sel.$sec"
  printf '%s\n' "$path" >>"$TMP/frags"
done <"$TMP/list"

LC_ALL=C sort -o "$TMP/frags" "$TMP/frags" || die "could not order the fragment list — the collation could not run"
count=$(wc -l <"$TMP/frags") || die "could not count the fragments — the collation could not run"
count=$((count))
if [ "$count" -eq 0 ]; then
  note "no fragments — nothing to collate"
  exit 0
fi

# awk normalizes a fragment that ends without a newline, which would
# otherwise glue two entries into one line. Filename order within a section,
# as the release notes have always read.
for pair in $SECTIONS; do
  low=${pair%%:*}
  : >"$TMP/frag.$low"
  : >"$TMP/sec.$low"
  LC_ALL=C sort -o "$TMP/sel.$low" "$TMP/sel.$low" ||
    die "could not order the $low fragments — the collation could not run"
  while IFS= read -r f; do
    awk 1 "$f" >>"$TMP/frag.$low" || die "could not read $f — the collation could not run"
  done <"$TMP/sel.$low"
done

[ -f CHANGELOG.md ] || die "CHANGELOG.md is missing — the collation could not run"
: >"$TMP/pre"
: >"$TMP/lead"
: >"$TMP/post"

# Split CHANGELOG.md into the part above [Unreleased], that section's lead
# and per-section bodies, and the released versions below it. A body keeps one
# blank line between its entries and none at its edges, so a section the file
# spells under two headings comes out as one list.
rc=0
awk -v tmp="$TMP" -v known="added changed deprecated removed fixed security" '
  BEGIN {
    n = split(known, k, " ")
    for (i = 1; i <= n; i++) is[k[i]] = 1
    out = tmp "/pre"
    state = 0
  }
  state == 0 && /^## \[Unreleased\]/ { print > out; state = 1; out = tmp "/lead"; insec = 0; next }
  state == 1 && /^## / { state = 2; out = tmp "/post"; insec = 0 }
  state == 1 && /^###[[:space:]]/ {
    sec = $0
    sub(/^###[[:space:]]+/, "", sec)
    sub(/[[:space:]]+$/, "", sec)
    low = tolower(sec)
    if (!(low in is)) {
      print sec > "/dev/stderr"
      exit 3
    }
    out = tmp "/sec." low
    insec = 1
    started = 0
    held = 0
    next
  }
  insec {
    if ($0 ~ /[^[:space:]]/) {
      if (held) print "" > out
      held = 0
      print > out
      started = 1
    } else if (started) {
      held = 1
    }
    next
  }
  { print > out }
  END { if (state == 0) exit 4 }
' CHANGELOG.md 2>"$TMP/err" || rc=$?
case "$rc" in
  0) : ;;
  3) die "CHANGELOG.md names '$(cat "$TMP/err")' under [Unreleased], which is not a Keep a Changelog section — the collation could not run" ;;
  4) die "CHANGELOG.md has no '## [Unreleased]' heading — the collation could not run" ;;
  *) die "CHANGELOG.md could not be read — the collation could not run" ;;
esac

trim() { # FILE — its content, edge blank lines dropped, interior runs capped at one
  awk '
    /[^[:space:]]/ {
      if (held) print ""
      held = 0
      print
      started = 1
      next
    }
    started { held = 1 }
  ' "$1"
}

# Every part carries its own failure out. The caller runs this as the left
# operand of ||, where the shell suppresses errexit and would otherwise pass
# off the last command's status as the whole file's.
assemble() {
  cat "$TMP/pre" || return 1
  trim "$TMP/lead" || return 1
  for pair in $SECTIONS; do
    low=${pair%%:*}
    name=${pair#*:}
    if [ -s "$TMP/sec.$low" ] || [ -s "$TMP/frag.$low" ]; then
      printf '\n### %s\n\n' "$name" || return 1
      cat "$TMP/sec.$low" || return 1
      cat "$TMP/frag.$low" || return 1
    fi
  done
  if [ -s "$TMP/post" ]; then
    printf '\n' || return 1
  fi
  cat "$TMP/post" || return 1
}

OUT="$(mktemp ./CHANGELOG.md.XXXXXX)" || die "could not create the replacement file — the collation could not run"
cp -p CHANGELOG.md "$OUT" || die "could not take CHANGELOG.md's mode — the collation could not run"
assemble >"$OUT" || die "could not write the collated changelog — CHANGELOG.md is untouched"
mv -- "$OUT" CHANGELOG.md || die "could not replace CHANGELOG.md — the collation could not run"
OUT=""

# Past the move, every fragment is in CHANGELOG.md. Deleting stops for none of
# them: one left behind folds in a second time on the next run, so the refusal
# has to name every survivor, not the first.
survivors=""
while IFS= read -r f; do
  rm -f -- "$f" || survivors="$survivors  $f"$'\n'
done <"$TMP/frags"
if [ -n "$survivors" ]; then
  die "CHANGELOG.md is collated, but these fragments survived and would fold in a second time — delete them by hand:
${survivors%$'\n'}"
fi
# A section directory the collation emptied goes with it. Not-empty and
# not-found are both ordinary here, and neither leaves anything to act on.
for pair in $SECTIONS; do
  rmdir "changelog.d/${pair%%:*}" 2>/dev/null || true
done

if [ "$count" -eq 1 ]; then noun=entry; else noun=entries; fi
note "folded $count $noun into CHANGELOG.md's [Unreleased] section"
