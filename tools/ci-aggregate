#!/usr/bin/env bash
# ci-aggregate — hold a required context open over the lanes a change class
# stood down.
#
# `skills/harness-ci/scripts/aggregate-needs` authorizes a skip through one
# waiver and the set of jobs it covers, or through `--lane`, which reads each
# job's verdict from the classifier job's `lane_<name>` outputs. This
# repository's selection is one `jobs` list, not `lane_<name>` outputs, so
# the aggregate of `.github/workflows/skill-tests.yml` takes the waiver route
# with its own set: the LANES jobs of `tools/ci-job-set --lanes` the list
# leaves out. This script builds that set and runs the helper.
#
# Usage:
#   ci-aggregate --results JSON --classifier JOB --jobs JSON
#
# RESULTS is `toJSON(needs)`. JOBS is the classifier's `jobs` output, the
# JSON list of the jobs it selected. Each LANES row whose class cell is not
# `-` is a job CI holds: a listed one must have succeeded, and an unlisted
# one is authorized to skip unless its class cell is `on`, a job every merge
# group runs. GitHub reads CI's `needs:` before any job runs, so a held job absent
# from RESULTS exits 1 with `ci-aggregate: needed-result=absent job=<name>`:
# no output can add the edge, and toJSON(needs) omits a job the needs list
# does not name even while it runs.
#
# An EMPTY JOBS is the classifying job having published nothing, which is
# that job having failed. It authorizes no skip, so the run reaches
# `aggregate-needs` with the waiver off and is rejected there, naming the
# dead classifier rather than a parse failure here.
#
# Argument refusals start `ci-aggregate: cause=<name>` and exit 2: a JOBS
# that is not a JSON list of strings, an unreadable table and a helper this script cannot find among them. The
# helper's status rejections pass through unchanged.
set -euo pipefail

die() { # CAUSE MESSAGE
  printf 'ci-aggregate: cause=%s\n' "$1" >&2
  printf 'ci-aggregate: %s\n' "$2" >&2
  exit 2
}

helper_rel="$(dirname "$0")/../skills/harness-ci/scripts"
helper_dir="$(cd "$helper_rel" 2>/dev/null && pwd)" ||
  die "helper-unreadable dir=$helper_rel" \
    "the harness-ci scripts directory beside this repository is unreadable"
HELPER="$helper_dir/aggregate-needs"
[ -x "$HELPER" ] || die "helper-missing path=$HELPER" \
  "aggregate-needs is absent or not executable"

results=""
classifier=""
jobs=""
jobs_given=false

need_value() { # FLAG REMAINING NEXT
  [ "$2" -ge 2 ] || die "missing-value option=$1" "$1 needs a value"
  case "$3" in
    -?*) die "flag-used-as-value option=$1 value=$3" \
      "$1 needs a value, got the flag '$3'" ;;
  esac
}

while [ "$#" -gt 0 ]; do
  case "$1" in
    --results) need_value "$1" "$#" "${2:-}"; results="$2"; shift 2 ;;
    --classifier) need_value "$1" "$#" "${2:-}"; classifier="$2"; shift 2 ;;
    # An empty list is the dead classifier's, so it is a value here.
    --jobs) [ "$#" -ge 2 ] || die "missing-value option=$1" "$1 needs a value"
      jobs="$2"; jobs_given=true; shift 2 ;;
    *) die "unknown-option option=$1" "unknown argument '$1'" ;;
  esac
done

[ -n "$results" ] || die "missing-option option=--results" "--results is required"
[ -n "$classifier" ] || die "missing-option option=--classifier" \
  "--classifier is required"
[ "$jobs_given" = true ] || die "missing-option option=--jobs" "--jobs is required"

lanes="$("$(dirname "$0")/ci-job-set" --lanes)" ||
  die "lanes-unread" "tools/ci-job-set --lanes printed no table"
# `JOB CELL` for every job CI holds.
held="$(printf '%s\n' "$lanes" | awk -F '|' 'NF == 6 && $3 != "-" { print $1, $3 }')" && [ -n "$held" ] ||
  die "lanes-unread" "tools/ci-job-set --lanes held no job"

if [ -n "$jobs" ]; then
  jq -e 'type == "array" and all(.[]; type == "string")' >/dev/null 2>&1 <<<"$jobs" ||
    die "jobs-unreadable value=$jobs" "--jobs is a JSON list of job names"
fi

authorized=""
declared=""
while read -r job cell; do
  declared="$declared --skippable $job"
  [ -n "$jobs" ] && [ "$cell" != on ] || continue
  jq -e --arg job "$job" 'index($job) != null' >/dev/null <<<"$jobs" ||
    authorized="$authorized --skippable $job"
done <<<"$held"

# The helper needs a --skippable to parse even where no lane may skip. With
# the waiver off that list authorizes nothing, so naming every lane there is
# the same refusal as naming none, and it keeps the flag satisfied.
waiver=true
if [ -z "$authorized" ]; then
  waiver=false
  authorized="$declared"
fi

printf 'ci-aggregate: waiver=%s authorized=%s\n' "$waiver" \
  "$(printf '%s' "$authorized" | sed 's/ --skippable//g; s/^ //')" >&2

# shellcheck disable=SC2086 # a job name carries no whitespace
accepted="$("$HELPER" --results "$results" --classifier "$classifier" \
  --waiver "$waiver" $authorized)" || exit "$?"

missing="$(jq -r --arg held "$held" '
  . as $results | $held | split("\n")[] | split(" ")[0] | select(. != "") |
  select(. as $job | $results | has($job) | not) |
  "ci-aggregate: needed-result=absent job=\(.)"
' <<<"$results")" || exit "$?"
if [ -n "$missing" ]; then
  printf '%s\n' "$missing" >&2
  exit 1
fi
printf '%s\n' "$accepted"
