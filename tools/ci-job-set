#!/usr/bin/env bash
# ci-job-set — which lanes of .github/workflows/skill-tests.yml a change class
# runs.
#
# The class comes from the change-class composite action and is never decided
# here; this script maps it, and the changed paths behind it, onto one
# `<lane>=true|false` line per gated lane, plus one `shards=` line naming the
# shell shards the diff selects as a JSON list and one `queue_macos_shards=`
# line naming those the merge queue runs on macOS. Every lane condition in
# that workflow reads one of those lines, the Linux shard matrix `shards` and
# the queue's macOS matrix `queue_macos_shards` on a classified group, so the
# selection is made once instead of re-derived in each `if:`.
#
# Usage: tools/ci-job-set [--event-parity]
#
#   --event-parity  also derive the selection at every other event and refuse
#                   `event-parity` where one differs. The `changes` job of
#                   skill-tests.yml passes it, so the check runs once per
#                   workflow run over the real changed paths; a call without
#                   it derives the one event, at half the cost, for the
#                   suites that call this script many times.
#
# Environment:
#   CHANGE_CLASS   render|trivial|micro|small|standard
#   DOCS_ONLY      true|false, the shipped `harness-only --mode docs` verdict
#                  for the same diff
#   CHANGED_PATHS  the changed paths, one per line
#   EVENT          pull_request|merge_group, the event the selection is for.
#                  Both select the same lanes and shards for the same
#                  class, docs verdict and paths, which --event-parity
#                  checks
#   PROOF_RECORD   the change-class action's `proof_record` output: the
#                  record of the passing run that already tested this tree,
#                  or empty where none did. Its `event`, `change_class`,
#                  `docs_only` and `changed_path` lines are this script's
#                  own inputs as that run had them, so what that run ran is
#                  this selection over them, and a lane it ran stands down
#                  on a pull request. Groups ignore this tree proof.
#                  A record whose lines this selection refuses stands
#                  nothing down and says why on a `proof=ignored` line.
#   MACOS_PROOF_RECORD  the change-class action's accepted macOS record.
#                  The action owns record eligibility. Only this
#                  proof can stand macOS lanes down on a merge group.
#                  Tree proof never stands group Linux or Windows lanes down.
#   MACOS_RECORD_DIR   the action's record_dir, where a pull request appends
#                  its actual macOS lane bits and selected macOS shards.
#                  The workflow uploads the patch artifact after selection.
#   GITHUB_OUTPUT  the step output file the selection is appended to
#
# THE INVARIANT, stated once, with no list of what any lane reads:
#
#   - On every measured class (`micro`, `small`, `standard`) two Linux lanes
#     always run: cargo_linux and bot_instructions.
#   - The shell shards run per package. A package is a skill
#     (`skills/<name>/`, its render under `.agents/skills/<name>/` included),
#     `tools/`, `hooks/` (its renders under `.claude/hooks/`, `.codex/hooks/`
#     and `.pi/kendex/hooks/` included), or a Pi package under
#     `pi-extensions/`. A changed package selects the shards whose steps run
#     its suites. A changed skill also selects the shards that run the
#     tools/ and hooks/ suites, which read skills' scripts, some by glob.
#   - Who reads a change is searched for, not listed. Every tracked file a
#     shard runs, as consumers() maps it to a package, is searched for each
#     changed skill's name and for the path of each changed file outside
#     skills/, save a root file of prose. A suite that names one selects its
#     own shard. A skill's script that names a skill, or a skill declaring
#     it under `dependencies.required` in its SKILL.md, carries the change
#     on: that skill counts as changed and is searched for in turn, until no
#     search finds a new one. A reference the search cannot see, a path a
#     script assembles at run time, is outside this rule, save the two
#     want_package states: pi-hooks runs hooks by name, so hooks/ also
#     selects `node`, and harness-smoke reads hooks/*.sh by glob, so
#     hooks/ also selects `guards-tools-tail`.
#   - A changed file citing a shard by name in backticks selects
#     `guards-tools-tail`, whose orch-shard-partition suite holds every
#     citation to the roster.
#   - `guards-scans` runs where a path under skills/, hooks/ or tools/
#     changed, the trees its scans read. `rest`, `review-gate` and `orch-rest`
#     also run where a build input changed, because their consumer rows use
#     kendex-cli built from the checkout. A diff that reaches no package selects no shard, and
#     shell_shards is false exactly where the list is empty.
#   - The platform selections (the macOS shell bit, cargo_macos,
#     cargo_windows) are false on a diff whose every path is prose,
#     whose content no platform reads differently, and true on any other
#     diff; a `standard` diff that is not documentation alone selects them
#     whatever its paths. The macOS shell bit is also false where every
#     selected shard belongs to LINUX_ONLY_SHARDS. These are selected
#     values; .github/workflows/skill-tests.yml owns job execution policy.
#   - The event selects nothing: a pull request and a merge group receive
#     the same lane, shard and runner selections for the same class, docs
#     verdict and paths. With --event-parity the
#     script derives the selection at both events and refuses
#     `event-parity` where they differ.
#   - Tree proof stands down the selections its record covers on a pull
#     request. A merge group accepts only matching macOS patch proof and
#     never stands Linux or Windows lanes down. Tree coverage is re-derived
#     from its record. Patch coverage reads the PR's recorded selection,
#     because base changes can change what the current checkout selects.
#     A shell runner stands down where the record covers its current shards.
#     A lane or shard outside that record keeps its current selection.
#     bot_instructions is never covered: its changelog step judges the
#     range from this event's base, and a record names no base.
#     queue_macos_shards reads the macOS bit after matching patch proof
#     on merge groups, and the selected macOS bit on pull requests.
#   - The compile lanes (cargo_lint, cargo_windows_check) run no test, so
#     they run only where a build input changed: a path other than prose
#     under a tools/rust-reads `build` or `include` row.
#   - ui is the lane that narrows to a tree: every ui step runs a
#     ui/package.json script, and nothing under ui/ imports or configures a
#     path outside ui/.
#   - A diff to what defines the lanes, a path under .github/workflows/ or
#     .github/actions/ or tools/ci-job-set, tools/ci-aggregate,
#     tools/rust-reads or tools/lib/skill-requirements.awk, runs every
#     lane, so a change to a lane or to its selection runs on the pull
#     request that makes it. Any path under .github/ selects every shard.
#   - A `render` or `trivial` diff runs bot_instructions alone, the one
#     seconds-long verify job, whose steps its lane entry below lists. The
#     classifier proved a `render` diff by re-rendering it, and a `trivial`
#     one is inside the docs path set and its line ceiling, or a plan of any
#     size.
#   - The exception: a `trivial` diff changing a path a tools/rust-reads
#     include or manifest row names, or a path under a directory it names,
#     takes the measured row its paths select, so the cargo lane runs on a
#     docs file the Rust source reads. tools/rust-reads reads the Rust source
#     of the checkout this script runs in, and its header states the reads it
#     does not follow.
#
# The lanes:
#
#   shell_shards        true where the remaining `shards=` and `shell_os=`
#                       lists are non-empty. shell_os names the unproven
#                       runners. .github/workflows/skill-tests.yml owns the
#                       jobs and events that consume these values.
#   bot_instructions    on both events, the check of the rendered review-bot
#                       instruction files and the root AGENTS.md region they
#                       own, and changelog-entries --base over the range from
#                       the event's base: fragments and package versions. On
#                       a pull request also the document byte ceilings, the
#                       index-wide work-marker scan and the secrets scan of
#                       the commits it adds.
#   cargo_linux         the workspace tests on Linux.
#   cargo_macos         the workspace tests on the platform the app ships on.
#   cargo_lint          clippy, fmt and doc over the workspace.
#   cargo_windows       the Windows test run.
#   cargo_windows_check the Windows compile check of the core and CLI targets.
#   ui                  the vitest, tsc and biome lane.
#   queue_macos_shards  the selected members of QUEUE_MACOS_SHARDS, as a JSON
#                       list in roster order, and empty where the macOS
#                       shell bit is false or group patch proof covers it.
#                       Pull requests and groups run these on macOS.
#
# DOCS_ONLY is read and validated on every class, and it changes one thing: a
# `standard` diff whose every path the docs verdict accepts (docs/,
# changelog.d/, root Markdown) takes the row its paths select, with the
# platform lanes standing down on prose, rather than running them whatever
# its paths.
#
# Every refusal starts `ci-job-set: cause=<name>` and exits 2. A class this
# table does not name is one of those: the step goes red, every lane's status
# function runs it, and the required contexts refuse the skip, which is the
# loud way to learn a sixth class shipped. A read set tools/rust-reads could
# not derive is another.
set -euo pipefail

TOOLS_DIR="$(cd "$(dirname "$0")" && pwd)"

# A selection is one `name=value` word per lane: the two shell runner bits,
# LEGS, then one per gated job, JOBS, then `shards=`. The
# emitted lines are shell_shards and shell_os in place of the legs, then the
# jobs, the shards and queue_macos_shards.
LEGS="linux macos"
JOBS="ui bot_instructions cargo_linux cargo_macos cargo_lint cargo_windows cargo_windows_check"
LANES="shell_shards shell_os $JOBS"
# The events a selection is made for; each selects the same lanes.
EVENTS="pull_request merge_group"
# The shell shards, in the order of the skill-tests.yml matrix list.
SHARDS="review-gate orch-terminal orch-oversee orch-oversee-watch orch-oversee-succeed orch-state orch-rest guards-scans guards-commit guards-hooks guards-tools guards-tools-tail linear linear-controls worktree rest slack node pi-claude-bridge"
# The shards the main-push matrix never runs on macOS, nothing in them running
# under its Bash 3.2: node and pi-claude-bridge hold no bash, and
# linear-controls runs the linear suites, which need Bash 4. They are its
# `exclude:` rows, which tools/tests/orch-shard-partition.test.sh holds to
# this list. The selector uses them for its macOS runner arithmetic.
LINUX_ONLY_SHARDS="node pi-claude-bridge linear-controls"
# The shards a merge group may run on macOS; every other macOS-capable shard
# runs on main pushes only. skill-tests.yml's skill-suites-macos-queue job
# falls back to this list, in this order, on an unclassified group.
QUEUE_MACOS_SHARDS="orch-terminal orch-oversee-succeed guards-tools slack"

die() { # CAUSE MESSAGE
  printf 'ci-job-set: cause=%s\n' "$1" >&2
  printf 'ci-job-set: %s\n' "$2" >&2
  exit 2
}

# A mistyped mode would drop the parity check the workflow relies on.
parity=false
case "$#:${1-}" in
  0:) ;;
  1:--event-parity) parity=true ;;
  *) die "unknown-argument value=$*" "the one argument is --event-parity" ;;
esac

[ -n "${CHANGE_CLASS:-}" ] || die missing-class "CHANGE_CLASS is required"
[ -n "${GITHUB_OUTPUT:-}" ] || die missing-output-file \
  "GITHUB_OUTPUT is unset, so no lane could read the selection"

# Present-but-empty is a state of its own, and not the same as absent.
paths="${CHANGED_PATHS-__unset__}"
[ "$paths" != __unset__ ] || die missing-paths "CHANGED_PATHS is required"

# The value SELECTION holds for NAME. A selection naming no value for a lane
# ends the step, before any lane has read a selection with it missing.
sel_get() { # SELECTION NAME
  local rest=" $1 "
  case "$rest" in
    *" $2="*) ;;
    *) die "lane-unselected lane=$2" "the row declares no value for this lane" ;;
  esac
  rest="${rest#*" $2="}"
  printf '%s' "${rest%% *}"
}

# A row names every lane and each shard list or ends the step, before any lane
# has read a selection with one of them missing from it.
emit() { # LANE=VALUE ... shards=JSON queue_macos_shards=JSON
  local lane given=" $* "
  for lane in $LANES shards queue_macos_shards; do
    case "$given" in
      *" $lane="*) ;;
      *) die "lane-unselected lane=$lane" "the row declares no value for this lane" ;;
    esac
  done
  printf '%s\n' "$@" >>"$GITHUB_OUTPUT"
  printf '%s\n' "$@" >&2
}

# `grep -c` exits 1 when nothing matched, which errexit would read as a broken
# command; the count is the answer either way.
any() { # REGEX — is some changed path inside it?
  local hits
  hits="$(printf '%s\n' "$paths" | grep -Ec -- "$1")" || hits=0
  [ "$hits" -gt 0 ]
}
any_outside() { # REGEX — is some changed path NOT inside it?
  local hits
  hits="$(printf '%s\n' "$paths" | grep -Evc -- "$1")" || hits=0
  [ "$hits" -gt 0 ]
}

# Prose, the one input the platform and compile lanes stand down on.
PROSE='\.(md|markdown)$'
# What defines the lanes: the workflows and actions that run them, and the
# scripts that select them.
LANE_SOURCES='^(\.github/(workflows|actions)/|tools/(ci-job-set|ci-aggregate|rust-reads)$|tools/lib/skill-requirements\.awk$)'
# A shard cited by name in prose: a name in backticks, then `shard`.
SHARD_CITATION='`[a-z0-9][a-z0-9-]*` shards?'
# What selects every shell shard: the lane sources and the rest of .github/.
ALL_SHARDS="^\\.github/|$LANE_SOURCES"

# Which changed paths tools/rust-reads rows name, as two lines: named=1 where
# an include or manifest row other than `.` names one, build=1 where a path
# other than prose sits under a build or include row. Each match is printed
# on stderr.
reads() {
  local rows
  rows="$("$TOOLS_DIR/rust-reads" .)" ||
    die "rust-reads-failed" "tools/rust-reads could not derive the paths the Rust source reads"
  PROSE="$PROSE" PATHS="$paths" awk -F '\t' '
    { kind[NR] = $1; read[NR] = $2 }
    END {
      n = split(ENVIRON["PATHS"], changed, "\n")
      for (p = 1; p <= n; p++) {
        path = changed[p]
        for (r = 1; r <= NR; r++) {
          if (path == "" || read[r] == "." || (path != read[r] && index(path, read[r] "/") != 1)) continue
          if (kind[r] != "build") named = 1
          if (kind[r] != "manifest" && path !~ ENVIRON["PROSE"]) build = 1
          printf "ci-job-set: rust-read=%s kind=%s path=%s\n", read[r], kind[r], path > "/dev/stderr"
        }
      }
      printf "named=%d\nbuild=%d\n", named, build
    }
  ' <<<"$rows"
}

# `SKILL<tab>NAME` for each name a skill's SKILL.md declares under
# `dependencies.required`, and `?<tab>FILE` for a dependencies block the
# reader cannot take, read from the checkout this script runs in by
# lib/skill-requirements.awk, whose header states the grammar.
requirements() {
  local f
  set --
  for f in skills/*/SKILL.md; do
    [ ! -f "$f" ] || set -- "$@" "$f"
  done
  [ "$#" -gt 0 ] || return 0
  awk -f "$TOOLS_DIR/lib/skill-requirements.awk" "$@"
}

# Who reads a path: `<package> <how>` for each tracked file naming one of the
# paths on stdin. The package is the one a shard runs the file in:
# `skills/<name>` for its scripts/ and tests/, `tools`, `hooks`, and
# `pi-extensions/pi-claude-bridge` or `pi-extensions` for a Pi package; a
# tracked file anywhere else is no shard's and is not read. <how> is `suite`
# for a file under a tests/ directory or a Pi package, which reads the path
# when its own shard runs, and `script` for any other, whose behaviour now
# depends on it. A path is named where it stands whole: no path character
# touches either end, save a `/` before it or a path ending in one, so
# `install.sh` is not read out of `atomic-install.sh`. A skill is also named as
# `skills/<name>` or `../<name>/`. Exit 2 where the search failed.
consumers() {
  local path paths="" exact candidates files status=0
  set --
  while IFS= read -r path; do
    [ -n "$path" ] || continue
    set -- "$@" -e "$path"
    paths="$paths$path
"
  done
  [ "$#" -gt 0 ] || return 0
  # git grep's fixed-string pass narrows every tracked file present in the
  # working tree to the few holding a path at all, at one speed on every
  # platform; the bounded match then reads those few alone, since BSD grep
  # runs a long -E alternation over many files far slower than GNU grep.
  candidates="$(git -c core.quotePath=false grep -l -I -F "$@")" || status=$?
  case "$status" in
    0) ;;
    1) return 0 ;;
    *) return 2 ;;
  esac
  candidates="$(printf '%s\n' "$candidates" | awk -v mode=path "$PACKAGE_AWK")" || return 2
  [ -n "$candidates" ] || return 0
  exact="$(printf '%s' "$paths" | awk '{
    end = /\/$/ ? "" : "([^A-Za-z0-9_.-]|$)"
    gsub(/[][\\.*^$+?(){}|]/, "\\\\&")
    print "(^|[^A-Za-z0-9_.-])" $0 end
  }')" || return 2
  local IFS='
'
  set -f
  set --
  for path in $exact; do
    set -- "$@" -e "$path"
  done
  # shellcheck disable=SC2086 # one file per line
  set -- "$@" -- $candidates
  set +f
  files="$(grep -lE "$@")" || status=$?
  [ "$status" -le 1 ] || return 2
  [ -n "$files" ] || return 0
  printf '%s\n' "$files" | awk -v mode=package "$PACKAGE_AWK" | sort -u
}
# The one mapping from a tracked file to the package a shard runs it in, as
# consumers() above states it. mode=path prints each file that has one,
# mode=package its `<package> <how>`.
PACKAGE_AWK='
  /^skills\/[^\/]+\/(scripts|tests)\// { split($0, part, "/"); package = "skills/" part[2] }
  /^refresh\// { package = "refresh" }
  /^tools\// { package = "tools" }
  /^hooks\// { package = "hooks" }
  /^pi-extensions\// { package = "pi-extensions" }
  /^pi-extensions\/pi-claude-bridge\// { package = "pi-extensions/pi-claude-bridge" }
  package == "" { next }
  mode == "path" { print; package = ""; next }
  { print package " " (($0 ~ /\/tests\// || package ~ /^pi-extensions/) ? "suite" : "script"); package = "" }
'

# The shards the changed paths select, gathered into `want` as a
# space-bounded set.
want=" "
want_shard() { # SHARD...
  local shard
  for shard in "$@"; do
    case " $SHARDS " in
      *" $shard "*) ;;
      *) die "shard-undeclared shard=$shard" "a package names a shard the roster does not declare" ;;
    esac
    case "$want" in *" $shard "*) ;; *) want="$want$shard " ;; esac
  done
}
# The shards whose skill-tests.yml steps run a package's suites. `rest` runs
# every skill's suites no other step claims, so a skill named here by no arm
# is its. tools/tests/orch-shard-partition.test.sh holds this table to those
# steps, suite by suite.
want_package() { # PACKAGE
  case "$1" in
    skills/orch) want_shard orch-terminal orch-oversee orch-oversee-watch orch-oversee-succeed orch-state orch-rest ;;
    skills/review-gate | refresh) want_shard review-gate ;;
    skills/commit-guards) want_shard guards-commit guards-hooks ;;
    skills/linear) want_shard linear linear-controls ;;
    skills/bot-instructions | skills/preflight) want_shard linear ;;
    skills/worktree) want_shard worktree ;;
    skills/slack) want_shard slack ;;
    skills/deep-research) want_shard node ;;
    skills/*) want_shard rest ;;
    tools) want_shard guards-tools guards-tools-tail ;;
    # pi-hooks' suite runs real hooks by a path it builds from each hook's
    # name, and tools/tests/harness-smoke.test.sh reads every hooks/*.sh by
    # glob; no search for the path can find either.
    hooks) want_shard guards-hooks guards-tools-tail node ;;
    pi-extensions/pi-claude-bridge) want_shard node pi-claude-bridge ;;
    pi-extensions) want_shard node ;;
  esac
}

# A skill whose behaviour the diff changes: its own shards, every skill
# declaring it under dependencies.required, and its name queued for the
# search, whose scripts reach on in turn.
reached=" "
pending=""
reqs=""
reqs_read=false
reach_skill() { # NAME
  local skill required
  case "$reached" in *" $1 "*) return 0 ;; esac
  reached="$reached$1 "
  want_package "skills/$1"
  pending="$pending
skills/$1
../$1/"
  if [ "$reqs_read" = false ]; then
    reqs="$(requirements)" ||
      die "requirements-failed" "the dependencies.required lists of skills/*/SKILL.md could not be read"
    while IFS="$(printf '\t')" read -r skill required; do
      [ -n "$skill" ] || continue
      [ "$skill" != "?" ] || die "requirements-unreadable path=$required" \
        "dependencies: holds a line this reader cannot take"
      [ -d "skills/$required" ] || die "requirements-unreadable path=skills/$skill/SKILL.md" \
        "dependencies.required names $required, which is no skill under skills/"
    done <<<"$reqs"
    reqs_read=true
  fi
  while IFS="$(printf '\t')" read -r skill required; do
    [ "$required" != "$1" ] || reach_skill "$skill"
  done <<<"$reqs"
}

# The `shards=` value for a measured row: the JSON list, in roster order.
select_shards() { # BUILD(true|false)
  local build="$1" path skill batch found package list="" shard cited
  set --
  while IFS= read -r path; do
    case "$path" in
      skills/*/* | .agents/skills/*/*)
        skill="${path#.agents/}"
        skill="${skill#skills/}"
        reach_skill "${skill%%/*}"
        # tools/ and hooks/ suites read every skill's scripts, some by glob.
        # hooks/ is named by its shard alone: the package's `node` is there
        # for pi-hooks, which runs hooks by name.
        want_package tools
        want_shard guards-hooks
        ;;
      refresh/*) want_package refresh ;;
      tools/*) want_package tools ;;
      hooks/* | .claude/hooks/* | .codex/hooks/* | .pi/kendex/hooks/*) want_package hooks ;;
      pi-extensions/pi-claude-bridge/*) want_package pi-extensions/pi-claude-bridge ;;
      pi-extensions/*) want_package pi-extensions ;;
    esac
    case "$path" in skills/* | hooks/* | tools/* | refresh/*) want_shard guards-scans ;; esac
    # A file outside every skill is searched for by its own path, save a
    # root file of prose: a bare AGENTS.md or README.md is every fixture's.
    case "$path" in
      skills/* | .agents/skills/*) ;;
      */*) pending="$pending
$path" ;;
      *.md | *.markdown) ;;
      *) pending="$pending
$path" ;;
    esac
    [ ! -f "$path" ] || set -- "$@" "$path"
  done <<<"$paths"
  # A changed file citing a shard by name, in the form
  # tools/tests/orch-shard-partition.test.sh holds to the roster, runs that
  # suite.
  if [ "$#" -gt 0 ]; then
    cited=0
    grep -qE -- "$SHARD_CITATION" "$@" || cited=$?
    case "$cited" in
      0) want_shard guards-tools-tail ;;
      1) ;;
      *) die "citation-read-failed" "the changed files could not be read for shard citations" ;;
    esac
  fi
  # Until no search finds a skill it has not searched for.
  while [ -n "$pending" ]; do
    batch="$pending"
    pending=""
    found="$(consumers <<<"$batch")" ||
      die "consumers-failed" "the scripts and suites naming a changed path could not be searched"
    # A suite that reads a path runs; a skill's script that reads one
    # carries the change on to that skill's readers. The chain ends at
    # tools/, hooks/ and pi-extensions/: a change to one of those is
    # searched for by its own path, above.
    while read -r package how; do
      case "$package:$how" in
        skills/*:script) reach_skill "${package#skills/}" ;;
        skills/*:suite | refresh:* | tools:* | hooks:* | pi-extensions*:*) want_package "$package" ;;
        :) ;;
      esac
    done <<<"$found"
  done
  # `rest`, `review-gate` and `orch-rest` build kendex-cli for their real
  # consumer rows, so a build input runs all three.
  [ "$build" = false ] || { want_shard rest; want_shard review-gate; want_shard orch-rest; }
  # shellcheck disable=SC2086 # the roster is a word list
  ! any "$ALL_SHARDS" || want_shard $SHARDS
  for shard in $SHARDS; do
    case "$want" in *" $shard "*) list="$list,\"$shard\"" ;; esac
  done
  printf '[%s]' "${list#,}"
}

# Whether one shard of the JSON list SHARDS is one the matrix runs on macOS.
macos_shard() { # SHARDS
  local shard
  for shard in $SHARDS; do
    case "$1" in *"\"$shard\""*) ;; *) continue ;; esac
    case " $LINUX_ONLY_SHARDS " in *" $shard "*) ;; *) return 0 ;; esac
  done
  return 1
}

# One selection, printed as a word list: the lanes and shards CLASS, DOCS
# and PATHS select at EVENT. Every rule on those four inputs is here, the
# refusals included. Run it in a subshell: the readers above take the paths
# from `paths`, which it sets, and the shard search starts empty each time.
select_row() { # CLASS DOCS PATHS EVENT
  local class="$1" docs="$2" event="$4" row read_lines="" platform uitree build shards shell macos known=false each
  paths="$3"
  want=" " reached=" " pending=""
  case "$docs" in
    true | false) ;;
    *) die "invalid-docs-only value=$docs" "DOCS_ONLY is true or false" ;;
  esac
  for each in $EVENTS; do
    [ "$each" != "$event" ] || known=true
  done
  [ "$known" = true ] || die "unsupported-event event=$event" "EVENT is one of: $EVENTS"
  row="$class"
  case "$class" in
    render) ;;
    trivial)
      read_lines="$(reads)" || exit 2
      case "$read_lines" in *named=1*) row=trivial-read ;; esac
      ;;
    micro | small | standard)
      # A measured class is reached only after the classifier read a changed
      # path, and so is a docs verdict of true, so an empty list here is a
      # state no classifier emits. Reading it as "nothing matches" would
      # stand the narrowing lanes down on no evidence.
      [ -n "$paths" ] || die "class-without-paths class=$class" \
        "a measured class arrived with no changed path"
      read_lines="$(reads)" || exit 2
      ;;
    *)
      die "unknown-class class=$class" \
        "no lane selection is declared for this class"
      ;;
  esac
  case "$row" in
    render | trivial)
      printf '%s' "linux=false macos=false ui=false bot_instructions=true cargo_linux=false cargo_macos=false cargo_lint=false cargo_windows=false cargo_windows_check=false shards=[]"
      ;;
    micro | small | standard | trivial-read)
      platform=false
      any_outside "$PROSE" && platform=true
      [ "$class:$docs" != standard:false ] || platform=true
      uitree=false
      any '^ui/' && uitree=true
      build=false
      case "$read_lines" in *build=1*) build=true ;; esac
      shards="$(select_shards "$build")" || exit 2
      if any "$LANE_SOURCES"; then
        platform=true
        uitree=true
        build=true
      fi
      shell=true
      [ "$shards" != "[]" ] || shell=false
      macos=$platform
      # The runner arithmetic uses the main-push macOS matrix's exclusions.
      macos_shard "$shards" || macos=false
      printf '%s' "linux=$shell macos=$macos ui=$uitree bot_instructions=true cargo_linux=true cargo_macos=$platform cargo_lint=$build cargo_windows=$platform cargo_windows_check=$build shards=$shards"
      ;;
  esac
}

# The proving run's selection, where a record arrived: select_row over its
# lines, which refuses a record its rules refuse as it would the diff's own.
# A refused record stands nothing down and says why.
was=""
record="${PROOF_RECORD:-}"
# A queue group must re-test every integrated-tree lane.
[ "$EVENT" != merge_group ] || record=""
if [ -n "$record" ]; then
  record_line() { printf '%s\n' "$record" | sed -n "s/^$1=//p"; }
  r_event="$(record_line event)"
  r_class="$(record_line change_class)"
  r_docs="$(record_line docs_only)"
  r_paths="$(record_line changed_path)"
  record_err="$(mktemp)" || die mktemp-failed "no temporary file could hold the record's selection"
  trap 'rm -f -- "$record_err"' EXIT
  status=0
  was="$(select_row "$r_class" "$r_docs" "$r_paths" "$r_event" 2>"$record_err")" || status=$?
  if [ "$status" -eq 0 ]; then
    printf 'ci-job-set: proof=read event=%s class=%s docs_only=%s %s\n' \
      "$r_event" "$r_class" "$r_docs" "$was" >&2
  else
    # The first refusal line; `sed -n 1p` reads to the end, so its writer
    # is never cut off.
    cause="$(sed -n 's/^ci-job-set: cause=//p' "$record_err" | sed -n 1p)" || cause=""
    printf 'ci-job-set: proof=ignored cause=%s\n' "${cause:-status=$status}" >&2
    was=""
  fi
fi

# The action accepts the macOS record; this selector decides its coverage.
# A failed coverage read leaves every macOS lane selected.
patch_record="${MACOS_PROOF_RECORD:-}"
patch_was=""
if [ "$EVENT" = merge_group ] && [ -n "$patch_record" ]; then
  patch_line() { printf '%s\n' "$patch_record" | sed -n "s/^$1=//p"; }
  if ! r_macos="$(patch_line macos_selected)" || ! r_cargo="$(patch_line cargo_macos_selected)" ||
    ! r_shards="$(patch_line macos_shards)"; then
    printf 'ci-job-set: proof=ignored cause=macos-coverage-read-failed\n' >&2
  else
    case "$r_macos:$r_cargo" in
      true:true | true:false | false:true | false:false)
        if r_shards="$(jq -cse 'select(length == 1) | .[0] | select(type == "array" and all(.[]; type == "string"))' <<<"$r_shards")"; then
          patch_was="linux=false macos=$r_macos ui=false bot_instructions=false cargo_linux=false cargo_macos=$r_cargo cargo_lint=false cargo_windows=false cargo_windows_check=false shards=$r_shards"
        fi ;;
    esac
    if [ -z "$patch_was" ]; then
      printf 'ci-job-set: proof=ignored cause=macos-coverage-refused\n' >&2
    fi
  fi
fi

now="$(select_row "$CHANGE_CLASS" "$DOCS_ONLY" "$paths" "$EVENT")" || exit 2

# Event parity: pull requests and merge groups receive equal lane, shard and
# runner selections for the same class, docs verdict and paths. A rule that
# reads the event breaks that and is refused before any proof stands a lane
# down. .github/workflows/skill-tests.yml owns runner and event placement.
# Each other event costs a whole selection again, so only --event-parity
# pays it.
if [ "$parity" = true ]; then
  for event in $EVENTS; do
    [ "$event" != "$EVENT" ] || continue
    other="$(select_row "$CHANGE_CLASS" "$DOCS_ONLY" "$paths" "$event")" || exit 2
    [ "$other" = "$now" ] || die "event-parity event=$event" \
      "$EVENT selects '$now' and $event selects '$other' for the same class, docs verdict and paths"
  done
fi

[ -z "$patch_was" ] || was="$patch_was"

# A proof clears the lane selections its source row covers. Shell runner
# bits also require that source row to include every current shard.
now_shards="$(sel_get "$now" shards)"
was_shards=""
[ -z "$was" ] || was_shards="$(sel_get "$was" shards)"
covered=false
if [ -n "$was" ]; then
  covered=true
  coverage_shards="$SHARDS"
  [ -z "$patch_was" ] || coverage_shards="$QUEUE_MACOS_SHARDS"
  for shard in $coverage_shards; do
    case "$now_shards" in *"\"$shard\""*) ;; *) continue ;; esac
    case "$was_shards" in *"\"$shard\""*) ;; *) covered=false ;; esac
  done
fi
legs=""
jobs=""
for lane in $LEGS $JOBS; do
  value="$(sel_get "$now" "$lane")"
  ran=false
  [ -z "$was" ] || ran="$(sel_get "$was" "$lane")"
  case "$lane" in linux | macos) [ "$covered" = true ] || ran=false ;; esac
  if [ "$EVENT" = merge_group ]; then
    case "$lane" in macos | cargo_macos) ;; *) ran=false ;; esac
  fi
  # The changelog step's verdict reads the base, which the record lacks.
  case "$lane" in bot_instructions) ran=false ;; esac
  if [ "$value:$ran" = true:true ]; then
    value=false
    printf 'ci-job-set: proof=reused lane=%s\n' "$lane" >&2
  fi
  # The remaining runner bits become shell_os; shell_shards is true only
  # where this list is non-empty.
  case "$lane:$value" in
    linux:true) legs="${legs:+$legs,}\"ubuntu-latest\"" ;;
    macos:true) legs="${legs:+$legs,}\"macos-latest\"" ;;
    linux:* | macos:*) ;;
    *) jobs="$jobs $lane=$value" ;;
  esac
done
shell=false
[ -z "$legs" ] || shell=true

# The PR and queue macOS legs; matching patch proof can clear only the group.
queue=""
if [ "$(sel_get "$now" macos)" = true ]; then
  for shard in $QUEUE_MACOS_SHARDS; do
    case "$now_shards" in *"\"$shard\""*) queue="${queue:+$queue,}\"$shard\"" ;; esac
  done
fi

if [ "$EVENT" = merge_group ] && [ -n "$patch_was" ]; then
  case "$legs" in *macos-latest*) ;; *) queue="" ;; esac
fi

# shellcheck disable=SC2086 # one `lane=value` word per job
emit "shell_shards=$shell" "shell_os=[$legs]" $jobs "shards=$now_shards" "queue_macos_shards=[$queue]"

# Only the PR's executed selection can attest coverage. The proving run
# must succeed before the reader accepts the artifact this record enters.
if [ "$EVENT" = pull_request ] && [ -n "${MACOS_RECORD_DIR:-}" ]; then
  selected_macos=false
  [ -z "$queue" ] || selected_macos=true
  printf 'macos_selected=%s\ncargo_macos_selected=%s\nmacos_shards=[%s]\n' \
    "$selected_macos" "$(sel_get "$jobs" cargo_macos)" "$queue" >>"$MACOS_RECORD_DIR/record" ||
    die "macos-record-unwritable path=$MACOS_RECORD_DIR/record" "the actual macOS selection could not be recorded"
fi
