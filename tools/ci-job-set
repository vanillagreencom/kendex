#!/usr/bin/env bash
# ci-job-set — which lanes of .github/workflows/skill-tests.yml a change class
# runs.
#
# The class comes from the change-class composite action and is never decided
# here; this script maps it, and the changed paths behind it, onto one
# `<lane>=true|false` line per gated lane, plus one `shards=` line naming the
# shell shards the diff selects as a JSON list, one `queue_macos_shards=`
# line naming the selected macOS-capable shards and one `skipped_suites=`
# line, the JSON list of suites the narrowed row skips. Every lane condition in
# that workflow reads one of those lines, the Linux shard matrix `shards` and
# the queue's macOS matrix `queue_macos_shards` on a classified group, so the
# selection is made once instead of re-derived in each `if:`. Where
# CI_SELECTION names a file, a class selection also writes its
# `skipped_suites` and `rust_targets` there as one JSON object, which the
# merge group publishes for the push at its head.
#
# On a push to main the shard, skip and target lines name what that main run
# still owes; see THE PUSH ROUTE below.
#
# Usage: tools/ci-job-set [--event-parity]
#        tools/ci-job-set --suite-list CANDIDATE...
#
#   --event-parity  also derive the selection at every other event and refuse
#                   `event-parity` where one differs. The `changes` job of
#                   skill-tests.yml passes it, so the check runs once per
#                   workflow run over the real changed paths; a call without
#                   it derives the one event, at half the cost, for the
#                   suites that call this script many times. A push or a
#                   schedule has no class selection to compare, so their
#                   routes ignore it.
#
# Environment:
#   CHANGE_CLASS   render|trivial|micro|small|standard
#   DOCS_ONLY      true|false, the shipped `harness-only --mode docs` verdict
#                  for the same diff
#   CHANGED_PATHS  the changed paths, one per line
#   EVENT          pull_request|merge_group|push, the event the selection is
#                  for. The first two select the same lanes and shards for
#                  the same class, docs verdict and paths, which
#                  --event-parity checks. The workflow classifies on
#                  merge_group alone; tools/guard --full asks at
#                  pull_request. `push` takes the push route and `schedule`
#                  the night route, which read none of the three variables
#                  above.
#   GITHUB_OUTPUT  the step output file the selection is appended to
#   CI_SELECTION   the file a class selection writes its skips and targets
#                  to, where set
#
# THE PUSH ROUTE, for EVENT=push, which the workflow runs on main alone. A
# main push carries the head its merge group proved, and its shell shards run
# the same steps with the same filters, so the push owes only what no
# same-head merge-group run proved. It reads this workflow's merge-group runs
# for GITHUB_SHA, each run's latest jobs and the selection each run published
# as the SELECTION_ARTIFACT artifact through `gh api`, as GITHUB_REPOSITORY
# and GH_TOKEN allow. Each run and job is checked for the event, head and run
# it claims, because GitHub ignores a query filter it does not recognise.
# Per runner, a suite is proved where no run's selection left it out and, for
# every shard whose steps run it there (the projection the class route
# selects by), at least one job named `Skill suites shard (<shard>,
# <runner>)` exists across those runs and every such job completed with
# success. A shard of LISTLESS_SHARDS is proved whole by its jobs alike. A
# skill runtime Rust target is proved where every run's selection listed it
# and the `orch-rest` Linux jobs, whose step runs the targets, succeeded. The
# push emits `skipped_suites=` and `skipped_suites_macos=`, the suites proved
# on each runner; `shards=` and `queue_macos_shards=`, each roster's shards
# that run an unproved suite or are an unproved listless shard, `orch-rest`
# among them where a target is owed; `rust_targets=`, every target less the
# proved ones, `<package>/*` where none of a package's is proved; and
# `shell_shards=` and `shell_os=` as emit() derives them, and no other lane.
# A failed, pending or absent job proves nothing. A read that fails, finds
# no run or cannot read a run's selection proves nothing either: the step
# warns, emits the whole rosters, no skip and every target, and exits 0,
# since a red step on main would report a push failure for an API outage
# while the whole roster is the safe answer. Its one diagnostic line starts
# `ci-job-set: main-proof=read|none|unread`.
#
# THE NIGHT ROUTE, for EVENT=schedule, the nightly run on main, runs again no
# leg a run at the same head already ran green. It reads the push route's
# merge-group proof and, beside it, this workflow's push runs for GITHUB_SHA
# and their latest jobs: a suite is also proved on a runner where every push
# leg that runs it there succeeded, since a push leg runs every suite its
# group left unproved, and a listless shard where its push legs did. It
# emits `queue_macos_shards=`, the macOS shards that still run a suite,
# `skipped_suites_macos=`, `skipped_suites=[]`, `shards=[]` and
# `rust_targets=[]`, since the night runs no Linux shell leg, and four
# cargo lanes: `cargo_linux` and `cargo_windows_check`, compile legs, false
# where every job CARGO_LINUX_JOBS or CARGO_WINDOWS_CHECK_JOBS names across
# the push and group runs succeeded; `cargo_macos` and `cargo_windows`,
# whose test steps a push skips, false where every such job of the group
# runs did. A read that fails or finds neither run runs the whole night:
# the macOS-capable roster and every cargo lane. Its diagnostic line starts
# `ci-job-set: night-proof=`. A manual dispatch runs no changes job and so
# the whole night.
#
# THE INVARIANT, stated once, with no list of what any lane reads:
#
#   - On every measured class (`micro`, `small`, `standard`) two Linux lanes
#     always run: cargo_linux and bot_instructions.
#   - The suites and Rust targets a measured diff runs are its reach, the one
#     reach local validation selects by: `tools/guard --suite-reach` over the
#     changed paths, whose mapped_suites header states which suites and
#     skill runtime targets can depend on each path. The shards are the
#     reach's projection: each reached suite selects the shards whose steps
#     run it (want_package; orch's suites the shard run-all.sh --shard-of
#     gives on either runner), a reached Pi-package tree its package's
#     shards, and a reached Rust target `orch-rest`, whose Linux leg runs
#     them. `skipped_suites=` lists every other shell suite, so each shard
#     step runs only the reach's candidates. `rust_targets=` lists the
#     targets. A reach that cannot be read runs every shard, suite and
#     target.
#   - Beside the reach, four reads its text scan cannot see select a shard
#     whole: a changed hook selects `node`, whose pi-hooks suite runs hooks by
#     name, and harness-smoke, which reads hooks/*.sh by glob; a changed file
#     citing a shard by name in backticks selects orch-shard-partition, which
#     holds every citation to the roster; `.bun-version` selects `node`; and
#     a build input selects the CHECKOUT_KENDEX_SHARDS whole, whose consumer
#     rows run kendex-cli built from the checkout.
#   - `guards-scans` runs where a path under skills/, hooks/, refresh/ or
#     tools/ changed, the trees its scans read. A diff that reaches no suite
#     and no target selects no shard.
#   - The platform selections (the macOS shell bit, cargo_macos,
#     cargo_windows) are false on a diff whose every path is prose,
#     whose content no platform reads differently, and true on any other
#     diff; a `standard` diff that is not documentation alone selects them
#     whatever its paths. The macOS shell bit is also false where every
#     selected shard belongs to LINUX_ONLY_SHARDS. These are selected
#     values; .github/workflows/skill-tests.yml owns job execution policy.
#   - The event selects nothing: a pull request and a merge group receive
#     the same lane, shard and runner selections for the same class, docs
#     verdict and paths. With --event-parity the
#     script derives the selection at both events and refuses
#     `event-parity` where they differ. A push selects no class row; the
#     push route above answers it.
#   - The compile lanes (cargo_lint, cargo_windows_check) run no test, so
#     they run only where a build input changed: a path other than prose
#     under a tools/rust-reads `build` or `include` row.
#   - ui is the lane that narrows to a tree: every ui step runs a
#     ui/package.json script, and nothing under ui/ imports or configures a
#     path outside ui/.
#   - A diff to what defines the lanes, a path under .github/workflows/ or
#     .github/actions/ or tools/ci-job-set, tools/ci-aggregate, tools/guard,
#     tools/rust-reads or the macOS contracts, runs every lane, so a change
#     to a lane or to its selection runs every lane in the merge group that
#     lands it. Any path under .github/ and either runner (RUNNERS) selects
#     every shard whole.
#   - A `render` or `trivial` diff runs bot_instructions, the one
#     seconds-long verify job, whose steps its lane entry below lists. The
#     classifier proved a `render` diff by re-rendering it, and a `trivial`
#     one is inside the docs path set and its line ceiling, or a plan of any
#     size.
#   - catalog and smoke take the union of the explicit catalog inputs and
#     the CLI smoke compiled inputs rust-reads derives. A compiled include counts even
#     when it is prose; a run-time manifest read alone does not.
#   - The exception: a `trivial` diff changing a path a tools/rust-reads
#     include or manifest row names, or a path under a directory it names,
#     takes the measured row its paths select, so the cargo lane runs on a
#     docs file the Rust source reads. tools/rust-reads reads the Rust source
#     of the checkout this script runs in, and its header states the reads it
#     does not follow.
#
# The lanes:
#
#   shell_shards        the shell bit and, in shell_os, its runner list, both
#                       derived by emit() from `shards=` and
#                       `queue_macos_shards=`.
#                       .github/workflows/skill-tests.yml owns the jobs and
#                       events that consume these values.
#   bot_instructions    the check of the rendered review-bot instruction
#                       files and the root AGENTS.md region they own,
#                       changelog-entries --base over the range from the
#                       event's base (fragments and package versions), the
#                       document byte ceilings, the index-wide work-marker
#                       scan and the secrets scan of the commits the group
#                       and its pull request add.
#   cargo_linux         the workspace tests on Linux.
#   cargo_macos         the workspace tests on the platform the app ships on.
#   cargo_lint          clippy, fmt and doc over the workspace.
#   cargo_windows       the Windows test run.
#   cargo_windows_check the Windows compile check of the core and CLI targets.
#   ui                  the vitest, tsc and biome lane.
#   catalog             the released engine's strict check and catalog render.
#   smoke               the rendered sample trees read by real harness CLIs.
#   skipped_suites      the JSON list of shell suites outside the reach, `[]`
#                       where every shard runs whole; each shell suite step
#                       leaves the listed suites out of its own. On a push,
#                       the suites the same-head group proved on Linux.
#   skipped_suites_macos
#                       a push's and a schedule's alone: the suites proved
#                       on macOS at the head, which their macOS legs leave
#                       out in place of skipped_suites.
#   rust_targets        the JSON list of skill runtime Rust targets the
#                       reach holds, each `<package>/<target>` (`lib` or a
#                       [[test]] name), run by one step of the orch-rest Linux
#                       leg; every target of every skill runtime where a
#                       lane source changed or the reach could not be read.
#                       On a push, the targets the same-head group left
#                       unproved.
#   queue_macos_shards  the selected shards less LINUX_ONLY_SHARDS, as a JSON
#                       list in roster order, and empty where the macOS
#                       shell bit is false. Merge groups run these on macOS,
#                       a main push the macOS shards its group left
#                       unproved, and the nightly run those no run at its
#                       head proved.
#
# DOCS_ONLY is read and validated on every class, and it changes one thing: a
# `standard` diff whose every path the docs verdict accepts (docs/,
# changelog.d/, root Markdown) takes the row its paths select, with the
# platform lanes standing down on prose, rather than running them whatever
# its paths.
#
# Every refusal starts `ci-job-set: cause=<name>` and exits 2. A class this
# table does not name is one of those: the step goes red, every lane's status
# function runs it, and the required contexts refuse the skip, which is the
# loud way to learn a sixth class shipped. A read set tools/rust-reads could
# not derive is another. An unread reach is no refusal: it runs everything.
set -euo pipefail

# --suite-list CANDIDATE... prints, one per line in argument order, the
# candidate suite paths a shard step runs: each one SKIPPED_SUITES, the
# changes job's `skipped_suites`, does not name whole, so a same-named suite
# of another tree is never left out with it. An unset or empty list keeps
# every candidate, and a list of any other shape is refused. It is the one
# keep-or-skip test: each shard step of skill-tests.yml hands it its
# candidates and runs what it prints, and a step it leaves with none runs no
# suite. A pooled step turns the kept paths into base-name selectors, which
# can run a same-named suite of another battery beside a kept one but never
# drop one.
if [ "${1-}" = --suite-list ]; then
  shift
  skipped="${SKIPPED_SUITES-}"
  case "$skipped" in
    "" | '[]')
      [ "$#" -eq 0 ] || printf '%s\n' "$@"
      exit 0
      ;;
    '["'*'"]')
      grep -Eqx '\[("[^",[:space:]]+")(,"[^",[:space:]]+")*\]' <<<"$skipped" || {
        printf 'ci-job-set: cause=suite-skips-unreadable\n' >&2
        exit 2
      }
      ;;
    *)
      printf 'ci-job-set: cause=suite-skips-unreadable\n' >&2
      exit 2
      ;;
  esac
  listed=" $(printf '%s' "$skipped" | sed 's/[][]//g; s/"//g; s/,/ /g') "
  for candidate in "$@"; do
    case "$listed" in
      *" $candidate "*) ;;
      *) printf '%s\n' "$candidate" ;;
    esac
  done
  exit 0
fi

# --suite-kendex OS PATH [ORCH_SHARD] reports checkout or none for one suite.
# The shared suite runner supplies orch's owning shard from shard_of.
# --suite-shards PATH prints the shards that run one suite's package, on one
# line, space-separated, and an empty line where no shard runs it. tools/guard's
# scoped selection reads it to keep seeding the suites CI does not run.
suite_path="" suite_os="" suite_shard="" suite_query=""
if [ "${1-}" = --suite-kendex ]; then
  [ "$#" -ge 3 ] && [ "$#" -le 4 ] || exit 2
  suite_os=$2 suite_path=$3 suite_shard=${4-} suite_query=kendex
  case "$suite_os" in Linux | macOS) ;; *) exit 2 ;; esac
  shift "$#"
elif [ "${1-}" = --suite-shards ]; then
  [ "$#" -eq 2 ] && [ -n "$2" ] || exit 2
  suite_path=$2 suite_query=shards
  shift "$#"
fi

TOOLS_DIR="$(cd "$(dirname "$0")" && pwd)"

# select_row prints a class selection as one `name=value` word per lane: the
# macOS shell bit, `macos`, then one per gated job, JOBS, then `shards=`.
# emit() writes the step output derived from it.
JOBS="ui bot_instructions cargo_linux cargo_macos cargo_lint cargo_windows cargo_windows_check catalog smoke"
# The events a selection is made for; each selects the same lanes.
EVENTS="pull_request merge_group"
# The shell shards, in the order of the skill-tests.yml matrix list.
SHARDS="review-gate refresh orch-oversee orch-dev orch-state orch-rest guards-scans guards-commit guards-commit-tail guards-hooks guards-hooks-tail guards-tools guards-tools-tail linear linear-controls worktree worktree-restack rest jarvis slack mailbox node pi-claude-bridge"
# The shards whose Linux legs build kendex-cli from the checkout, for the
# consumer rows that run the real binary: the build rule and --suite-kendex
# read this one list, and tools/tests/orch-shard-partition.test.sh holds the
# workflow's `kendex from this checkout` condition to it.
CHECKOUT_KENDEX_SHARDS="refresh orch-rest rest jarvis"
# The shards that run orch's suites, each one run-all.sh's shard_of names.
ORCH_SHARDS="orch-oversee orch-dev orch-state orch-rest"
# The native eligibility owner declares the macOS shards that are empty,
# unsupported, or whose families another macOS job retains.
# The ownership proof compares those declarations with actual suite coverage
# and the workflow matrix. Linux keeps the complete SHARDS roster.
LINUX_ONLY_SHARDS="$("$TOOLS_DIR/macos-test-contracts" --linux-only-shards)" || exit 2
# The macOS-capable roster, in roster order: every reader of macOS
# eligibility reads this list.
MACOS_SHARDS=""
for shard in $SHARDS; do
  case " $LINUX_ONLY_SHARDS " in *" $shard "*) ;; *) MACOS_SHARDS="${MACOS_SHARDS:+$MACOS_SHARDS }$shard" ;; esac
done

die() { # CAUSE MESSAGE
  printf 'ci-job-set: cause=%s\n' "$1" >&2
  printf 'ci-job-set: %s\n' "$2" >&2
  exit 2
}

# A mistyped mode would drop the parity check the workflow relies on.
parity=false
case "$#:${1-}" in
  0:) ;;
  1:--event-parity) parity=true ;;
  *) die "unknown-argument value=$*" "the one argument is --event-parity" ;;
esac

[ -n "$suite_path" ] || [ -n "${GITHUB_OUTPUT:-}" ] || die missing-output-file \
  "GITHUB_OUTPUT is unset, so no lane could read the selection"

# The one writer of a selection. SHARDS and QUEUE are the Linux shard list
# and the macOS shard list, JSON in roster order; shell_os names each runner
# whose list is non-empty and shell_shards is true where it names one, so a
# merge group and a main push read alike. The JOB=VALUE words of a class row
# follow, and RUST, the `rust_targets=` value, comes last. SKIPPED_MACOS is
# the push route's alone: a class row passes it empty and every leg reads
# SKIPPED.
emit() { # SHARDS QUEUE SKIPPED SKIPPED_MACOS RUST [JOB=VALUE ...]
  local shards="$1" queue="$2" skipped="$3" skipped_macos="$4" rust="$5" legs="" shell=false
  shift 5
  [ "$shards" = "[]" ] || legs='"ubuntu-latest"'
  [ "$queue" = "[]" ] || legs="${legs:+$legs,}\"macos-latest\""
  [ -z "$legs" ] || shell=true
  set -- "shell_shards=$shell" "shell_os=[$legs]" "$@" "shards=$shards" "queue_macos_shards=$queue" "skipped_suites=$skipped"
  [ -z "$skipped_macos" ] || set -- "$@" "skipped_suites_macos=$skipped_macos"
  set -- "$@" "rust_targets=$rust"
  printf '%s\n' "$@" >>"$GITHUB_OUTPUT"
  printf '%s\n' "$@" >&2
}

# The push route, as the header states it. A read that fails proves nothing,
# so it emits the whole rosters, no skip and every target.
PROOF_WORKFLOW=.github/workflows/skill-tests.yml
# The artifact a merge group's changes job publishes CI_SELECTION under.
SELECTION_ARTIFACT=ci-selection
# The shards whose steps hand --suite-list no candidate, so a green leg
# proves the shard whole and the skip lists never narrow it.
LISTLESS_SHARDS="guards-scans node pi-claude-bridge"

# Every universe suite with each shard whose steps run it on each runner, one
# `<runner>\t<shard>\t<suite>` line per pair: orch's by run-all.sh
# --shard-of per RUNNER_OS, every other by want_package as --suite-shards
# reads it, a macOS line only for a macOS-capable shard. It is the class
# route's projection, so a suite a group kept had every one of these shards
# selected. Status 1 is a suite list that could not be read or a run-all.sh
# that could not place orch's suites.
suite_map() {
  local suites suite orch os runner placed package shard
  suites="$(universe)" || return 1
  orch="$(printf '%s\n' "$suites" | awk '/^skills\/orch\/tests\//')" || return 1
  for os in Linux macOS; do
    runner=ubuntu-latest
    [ "$os" = Linux ] || runner=macos-latest
    [ -n "$orch" ] || continue
    placed="$(printf '%s\n' "$orch" | RUNNER_OS=$os bash skills/orch/tests/run-all.sh --shard-of 2>/dev/null)" || return 1
    printf '%s\n' "$placed" | awk -v runner="$runner" 'NF == 2 { print runner "\t" $1 "\t" $2 }'
  done
  while IFS= read -r suite; do
    case "$suite" in "" | skills/orch/tests/*) continue ;; esac
    case "$suite" in
      skills/*) package="${suite#skills/}"; package="skills/${package%%/*}" ;;
      *) package="${suite%%/*}" ;;
    esac
    want=" "
    suite_path=$suite
    want_package "$package"
    for shard in $want; do
      printf 'ubuntu-latest\t%s\t%s\n' "$shard" "$suite"
      case " $MACOS_SHARDS " in *" $shard "*) printf 'macos-latest\t%s\t%s\n' "$shard" "$suite" ;; esac
    done
  done <<<"$suites"
  suite_path=""
}

# Every Rust target of every skill runtime, one `<package>/<target>` per
# line: `lib` and each [[test]] name of skills/<package>/runtime/Cargo.toml,
# the names tools/guard's reach gives targets.
runtime_targets() {
  local manifest package
  for manifest in skills/*/runtime/Cargo.toml; do
    [ -f "$manifest" ] || continue
    package="${manifest#skills/}"
    package="${package%%/*}"
    printf '%s/lib\n' "$package"
    awk -v package="$package" '
      /^\[/ { section = $0; next }
      section == "[[test]]" && /^name *=/ { name = $0; sub(/^[^"]*"/, "", name); sub(/".*/, "", name); print package "/" name }
    ' "$manifest" || return 1
  done
}

# The cargo jobs whose legs a schedule runs, by the job names
# skill-tests.yml gives them: the compile legs a push or a group ran green
# prove, the test legs only a group's.
CARGO_LINUX_JOBS='^Cargo [^ ]+ \(Linux\)$'
CARGO_WINDOWS_CHECK_JOBS='^Windows cargo \(core and CLI targets compile\)$'
CARGO_MACOS_JOBS='^macOS cargo '
CARGO_WINDOWS_JOBS='^Windows cargo \(workspace tests\)$'

# The proof route for EVENT, push or schedule, as the header states it. A
# read that fails proves nothing, so it emits the whole of what the event
# runs.
main_proof() { # EVENT
  local event=$1 sha="$GITHUB_SHA" api="repos/$GITHUB_REPOSITORY/actions" state=read cause="" mark=main-proof
  local runs ids="" pushes="" push_ids="" id page jobs="" push_jobs="" sels="" listing artifact sel work owed
  local linux macos skipped skipped_macos rust linux_n macos_n targets_n cargo_linux cargo_macos cargo_windows cargo_windows_check
  [ "$event" = push ] || mark=night-proof
  if ! runs="$(gh api --paginate "$api/workflows/${PROOF_WORKFLOW##*/}/runs?event=merge_group&head_sha=$sha&per_page=100")"; then
    state=unread cause=runs-read-failed
  elif ! ids="$(jq -rs --arg sha "$sha" --arg path "$PROOF_WORKFLOW" '
      [.[].workflow_runs[] | select(.event == "merge_group" and .head_sha == $sha and .path == $path) | .id]
      | unique | .[]' <<<"$runs")"; then
    state=unread cause=runs-unparseable ids=""
  elif [ "$event" = schedule ]; then
    if ! pushes="$(gh api --paginate "$api/workflows/${PROOF_WORKFLOW##*/}/runs?event=push&head_sha=$sha&per_page=100")"; then
      state=unread cause=push-runs-read-failed
    elif ! push_ids="$(jq -rs --arg sha "$sha" --arg path "$PROOF_WORKFLOW" '
        [.[].workflow_runs[] | select(.event == "push" and .head_sha == $sha and .path == $path) | .id]
        | unique | .[]' <<<"$pushes")"; then
      state=unread cause=push-runs-unparseable push_ids=""
    fi
  fi
  if [ "$state" = read ] && [ -z "$ids$push_ids" ]; then
    state=none cause=no-merge-group-run
    [ "$event" = push ] || cause=no-same-head-run
  fi
  work="$(mktemp -d)" || die proof-scratch "mktemp could not make the proof's scratch directory"
  # Each run's latest jobs, each checked for the head and run it claims.
  run_jobs() { # RUN
    page="$(gh api --paginate "$api/runs/$1/jobs?filter=latest&per_page=100")" || { cause="jobs-read-failed run=$1"; return 1; }
    page="$(jq -cs --arg sha "$sha" --argjson id "$1" '
        [.[].jobs[] | select(.head_sha == $sha and .run_id == $id) | {name, status, conclusion}]' <<<"$page")" ||
      { cause="jobs-unparseable run=$1"; return 1; }
  }
  for id in $ids; do
    run_jobs "$id" || { state=unread; break; }
    jobs="$jobs$page"
    # The run's newest unexpired selection: a rerun of its changes job
    # overwrites it, and a run that published none proves nothing.
    if ! listing="$(gh api --paginate "$api/runs/$id/artifacts?name=$SELECTION_ARTIFACT&per_page=100")" ||
      ! artifact="$(jq -rs --argjson id "$id" --arg name "$SELECTION_ARTIFACT" '
          [.[].artifacts[] | select(.name == $name and .expired == false and .workflow_run.id == $id)]
          | max_by(.created_at) | .id // empty' <<<"$listing")" ||
      [ -z "$artifact" ] ||
      ! gh api "$api/artifacts/$artifact/zip" >"$work/selection.zip" ||
      ! sel="$(unzip -p "$work/selection.zip" | jq -ce '
          select((.skipped_suites | type) == "array" and all(.skipped_suites[]; type == "string")
            and (.rust_targets | type) == "array" and all(.rust_targets[]; type == "string"))
          | {skipped_suites, rust_targets}')"; then
      state=unread cause="selection-unread run=$id"
      break
    fi
    sels="$sels$sel"
  done
  if [ "$state" = read ]; then
    for id in $push_ids; do
      run_jobs "$id" || { state=unread; break; }
      push_jobs="$push_jobs$page"
    done
  fi
  linux_n=0 macos_n=0 targets_n=0
  if [ "$state" != read ]; then
    rm -rf -- "$work"
    # shellcheck disable=SC2086 # the rosters are word lists
    linux="[$(printf '"%s",' $SHARDS)]" macos="[$(printf '"%s",' $MACOS_SHARDS)]"
    if [ "$event" = push ]; then
      emit "${linux/,]/]}" "${macos/,]/]}" '[]' '[]' "$(all_targets)"
    else
      emit '[]' "${macos/,]/]}" '[]' '[]' '[]' cargo_linux=true cargo_macos=true cargo_windows=true cargo_windows_check=true
    fi
  else
    jq -cs 'add // []' <<<"$jobs" >"$work/jobs.json" &&
      jq -cs 'add // []' <<<"$push_jobs" >"$work/push-jobs.json" &&
      jq -cs '.' <<<"$sels" >"$work/selections.json" &&
      suite_map | jq -Rcs 'split("\n") | map(select(length > 0) | split("\t"))' >"$work/map.json" &&
      runtime_targets | jq -Rcs 'split("\n") | map(select(length > 0))' >"$work/targets.json" ||
      die main-proof-unevaluated "the proof's inputs could not be gathered"
    # Per runner the proved suites and the shards that still run one, the
    # targets left unproved, the cargo lanes left unproved, and the counts:
    # `<linux> <macos> <skipped> <skipped macos> <rust> <n> <n> <n>
    # <cargo_linux> <cargo_macos> <cargo_windows> <cargo_windows_check>`.
    owed="$(jq -rn --slurpfile jobs "$work/jobs.json" --slurpfile pushjobs "$work/push-jobs.json" \
      --slurpfile sels "$work/selections.json" --slurpfile map "$work/map.json" --slurpfile targets "$work/targets.json" \
      --arg linux "$SHARDS" --arg macos "$MACOS_SHARDS" --arg listless "$LISTLESS_SHARDS" \
      --arg cl "$CARGO_LINUX_JOBS" --arg cm "$CARGO_MACOS_JOBS" --arg cw "$CARGO_WINDOWS_JOBS" --arg cwc "$CARGO_WINDOWS_CHECK_JOBS" '
      $jobs[0] as $jobs | $pushjobs[0] as $pushjobs | $sels[0] as $sels | $map[0] as $map | $targets[0] as $targets
      | ($listless | split(" ")) as $whole
      | ($sels | length > 0) as $read
      | ([$sels[].skipped_suites[]] | map({(.): true}) | add // {}) as $left
      | def all_green: length > 0 and all(.[]; .status == "completed" and .conclusion == "success");
        def green($pool; $shard; $os):
          [$pool[] | select(.name == "Skill suites shard (\($shard), \($os))")] | all_green;
        def proved($os):
          [$map[] | select(.[0] == $os)] | group_by(.[2])
          | map(select(($read and ($left[.[0][2]] | not) and all(.[]; green($jobs; .[1]; $os)))
              or all(.[]; green($pushjobs; .[1]; $os))) | .[0][2]);
        def owed($os; $roster; $proved):
          ($proved | map({(.): true}) | add // {}) as $done
          | ([$map[] | select(.[0] == $os and ($done[.[2]] | not)) | .[1]] | unique) as $need
          | [$roster | split(" ")[] | select(. as $shard
              | if any($whole[]; . == $shard) then ((green($jobs; $shard; $os) or green($pushjobs; $shard; $os)) | not)
                else any($need[]; . == $shard) end)];
        def expand: . as $list
          | [$targets[] | select(. as $t
              | any($list[]; . as $e | $e == $t or (($e | endswith("/*")) and ($t | startswith($e | rtrimstr("*"))))))];
        def lane_owed($pool; $pattern): [$pool[] | select(.name | test($pattern))] | all_green | not;
      (if $read and green($jobs; "orch-rest"; "ubuntu-latest")
        then [$sels[] | .rust_targets | expand] as $sets
          | [$targets[] | select(. as $t | all($sets[]; any(.[]; . == $t)))]
        else [] end) as $done
      | ($targets - $done) as $open
      | [$targets | map(split("/")[0]) | unique[] as $package
          | [$targets[] | select(startswith($package + "/"))] as $all
          | [$open[] | select(startswith($package + "/"))] as $mine
          | if ($mine | length) == 0 then empty
            elif ($mine | length) == ($all | length) then "\($package)/*"
            else $mine[] end] as $rust
      | proved("ubuntu-latest") as $pl | proved("macos-latest") as $pm
      | owed("ubuntu-latest"; $linux; $pl) as $ol
      | [$linux | split(" ")[] | select(. as $shard | any($ol[]; . == $shard) or ($shard == "orch-rest" and ($rust | length) > 0))] as $ol
      | owed("macos-latest"; $macos; $pm) as $om
      | "\($ol | tojson) \($om | tojson) \($pl | tojson) \($pm | tojson) \($rust | tojson) \($pl | length) \($pm | length) \($done | length) \(lane_owed($jobs + $pushjobs; $cl)) \(lane_owed($jobs; $cm)) \(lane_owed($jobs; $cw)) \(lane_owed($jobs + $pushjobs; $cwc))"')" ||
      die main-proof-unevaluated "jq could not subtract the proved suites and targets"
    rm -rf -- "$work"
    read -r linux macos skipped skipped_macos rust linux_n macos_n targets_n cargo_linux cargo_macos cargo_windows cargo_windows_check <<<"$owed"
    if [ "$event" = push ]; then
      emit "$linux" "$macos" "$skipped" "$skipped_macos" "$rust"
    else
      linux_n=0 targets_n=0
      emit '[]' "$macos" '[]' "$skipped_macos" '[]' cargo_linux="$cargo_linux" cargo_macos="$cargo_macos" \
        cargo_windows="$cargo_windows" cargo_windows_check="$cargo_windows_check"
    fi
  fi
  ids="$(printf '%s' "$ids $push_ids" | tr -s ' \n' ',,')"
  ids="${ids#,}"
  ids="${ids%,}"
  printf 'ci-job-set: %s=%s runs=%s proved-linux=%d proved-macos=%d proved-targets=%d%s\n' \
    "$mark" "$state" "${ids:-none}" "$linux_n" "$macos_n" "$targets_n" "${cause:+ cause=$cause}" >&2
  [ -z "$cause" ] || printf '::warning title=%s runs its whole roster::ci-job-set: %s=%s cause=%s\n' \
    "$event run" "$mark" "$state" "$cause"
}

# The proof routes read no class and no paths.
proof_route=false
[ -n "$suite_path" ] || case "${EVENT:-}" in push | schedule) proof_route=true ;; esac
[ -n "$suite_path" ] || [ "$proof_route" = true ] || [ -n "${CHANGE_CLASS:-}" ] || die missing-class "CHANGE_CLASS is required"

# Present-but-empty is a state of its own, and not the same as absent.
paths="${CHANGED_PATHS-__unset__}"
[ -n "$suite_path" ] || [ "$proof_route" = true ] || [ "$paths" != __unset__ ] || die missing-paths "CHANGED_PATHS is required"

# The value SELECTION holds for NAME. A selection naming no value for a lane
# ends the step, before any lane has read a selection with it missing.
sel_get() { # SELECTION NAME
  local rest=" $1 "
  case "$rest" in
    *" $2="*) ;;
    *) die "lane-unselected lane=$2" "the row declares no value for this lane" ;;
  esac
  rest="${rest#*" $2="}"
  printf '%s' "${rest%% *}"
}

# `grep -c` exits 1 when nothing matched, which errexit would read as a broken
# command; the count is the answer either way.
any() { # REGEX — is some changed path inside it?
  local hits
  hits="$(printf '%s\n' "$paths" | grep -Ec -- "$1")" || hits=0
  [ "$hits" -gt 0 ]
}
any_outside() { # REGEX — is some changed path NOT inside it?
  local hits
  hits="$(printf '%s\n' "$paths" | grep -Evc -- "$1")" || hits=0
  [ "$hits" -gt 0 ]
}

# Prose, the one input the platform and compile lanes stand down on.
PROSE='\.(md|markdown)$'
# What defines the lanes: the workflows and actions that run them, and the
# scripts that select them, tools/guard's reach among them.
LANE_SOURCES='^(\.github/(workflows|actions)/|tools/(ci-job-set|ci-aggregate|guard|rust-reads|macos-test-contracts|macos-test-contracts\.json)$)'
# The runners every shell shard runs its battery through.
RUNNERS='^(skills/orch/tests/run-all\.sh|tools/tests/run-all\.sh)$'
# kendex.toml uses the explicit default layout in source/config.rs and
# source/layout.rs. The release check also reads Git ignore rules. Smoke
# builds its own catalog in cli_smoke.rs; its compiled inputs come from
# rust-reads below. Both jobs use this union, including catalog prose.
CATALOG_INPUTS='^((agents|skills|hooks|commands|mcp|output-styles|pi-extensions|plugins|\.claude-plugin)/|kendex\.toml$|\.git(ignore|attributes|modules)$|tools/catalog-release-check$)'
# A shard cited by name in prose: a name in backticks, then `shard`.
SHARD_CITATION='`[a-z0-9][a-z0-9-]*` shards?'
# What selects every shell shard whole: the lane sources, the rest of
# .github/ and the runners.
ALL_SHARDS="^\\.github/|$LANE_SOURCES|$RUNNERS"

# Which changed paths tools/rust-reads rows name: named=1 where
# an include or manifest row other than `.` names one, build=1 where a path
# other than prose sits under a workspace build or include row, compiled=1
# where a CLI-smoke scoped row names a compiled input. Each match is printed
# on stderr.
reads() {
  local rows
  rows="$("$TOOLS_DIR/rust-reads" --cli-smoke .)" ||
    die "rust-reads-failed" "tools/rust-reads could not derive the paths the Rust source reads"
  PROSE="$PROSE" PATHS="$paths" awk -F '\t' '
    { kind[NR] = $1; read[NR] = $2 }
    END {
      n = split(ENVIRON["PATHS"], changed, "\n")
      for (p = 1; p <= n; p++) {
        path = changed[p]
        for (r = 1; r <= NR; r++) {
          if (path == "" || read[r] == "." || (path != read[r] && index(path, read[r] "/") != 1)) continue
          if (kind[r] == "include" || kind[r] == "manifest") named = 1
          if ((kind[r] == "include" || kind[r] == "build") && path !~ ENVIRON["PROSE"]) build = 1
          if (kind[r] == "cli-include" || (kind[r] == "cli-build" && path !~ ENVIRON["PROSE"])) compiled = 1
          printf "ci-job-set: rust-read=%s kind=%s path=%s\n", read[r], kind[r], path > "/dev/stderr"
        }
      }
      printf "named=%d\nbuild=%d\ncompiled=%d\n", named, build, compiled
    }
  ' <<<"$rows"
}

# The one mapping from a tracked file to the package a shard runs it in:
# `skills/<name>` for its scripts/ and tests/, `refresh`, `tools`, `hooks`,
# and `pi-extensions/pi-claude-bridge` or `pi-extensions` for a Pi package;
# a skill's tests/rust/ file is no shell suite's. mode=path prints each file
# that has one, mode=package its `<package> <how>`, <how> `suite` under a
# tests/ directory or in a Pi package and `script` elsewhere.
PACKAGE_AWK='
  /^skills\/[^\/]+\/(scripts|tests)\// { split($0, part, "/"); package = "skills/" part[2] }
  /^refresh\// { package = "refresh" }
  /^tools\// { package = "tools" }
  /^hooks\// { package = "hooks" }
  /^pi-extensions\// { package = "pi-extensions" }
  /^pi-extensions\/pi-claude-bridge\// { package = "pi-extensions/pi-claude-bridge" }
  /^skills\/[^\/]+\/tests\/rust\// { package = "" }
  package == "" { next }
  mode == "path" { print; package = ""; next }
  { print package " " (($0 ~ /\/tests\// || package ~ /^pi-extensions/) ? "suite" : "script"); package = "" }
'

# The shards the changed paths select, gathered into `want` as a
# space-bounded set.
want=" "
want_shard() { # SHARD...
  local shard
  for shard in "$@"; do
    case " $SHARDS " in
      *" $shard "*) ;;
      *) die "shard-undeclared shard=$shard" "a package names a shard the roster does not declare" ;;
    esac
    case "$want" in *" $shard "*) ;; *) want="$want$shard " ;; esac
  done
}
# The shards whose skill-tests.yml steps run a package's suites. `rest` runs
# every skill's suites no other step claims, so a skill named here by no arm
# is its. tools/tests/orch-shard-partition.test.sh holds this table to those
# steps, suite by suite.
want_package() { # PACKAGE
  local suite
  case "$1" in
    skills/orch)
      # shellcheck disable=SC2086 # the list is a word list
      if [ -n "$suite_shard" ]; then want_shard "$suite_shard"
      else want_shard $ORCH_SHARDS; fi ;;
    skills/github) want_shard rest ;;
    skills/review-gate | refresh)
      if [ -n "$suite_path" ]; then want_shard "${1#skills/}"
      else want_shard review-gate refresh; fi ;;
    skills/commit-guards) want_shard guards-commit guards-commit-tail guards-hooks guards-hooks-tail ;;
    skills/linear) want_shard linear linear-controls ;;
    skills/bot-instructions | skills/preflight) want_shard linear ;;
    skills/worktree) want_shard worktree worktree-restack ;;
    # macOS runs no `jarvis` leg: `rest` keeps the family there, less the
    # session and succession suites `guards-hooks` and `guards-tools` run.
    skills/jarvis) want_shard jarvis rest guards-hooks guards-tools ;;
    skills/slack) want_shard slack ;;
    skills/mailbox) want_shard mailbox ;;
    skills/deep-research)
      want_shard node
      for suite in ${suite_path:-skills/deep-research/tests/*.sh}; do
        case "$suite" in *.sh) ;; *) continue ;; esac
        [ ! -f "$suite" ] || { want_shard rest; break; }
      done ;;
    skills/*) want_shard rest ;;
    tools) want_shard guards-tools guards-tools-tail ;;
    hooks) want_shard guards-hooks guards-hooks-tail ;;
    pi-extensions/pi-claude-bridge) want_shard node pi-claude-bridge ;;
    pi-extensions) want_shard node ;;
  esac
}

if [ -n "$suite_path" ]; then
  package=""
  package="$(printf '%s\n' "$suite_path" | awk -v mode=package "$PACKAGE_AWK")" ||
    die suite-package-unread "the suite path could not be mapped to its package"
  [ -z "$package" ] || want_package "${package% *}"
  if [ "$suite_query" = shards ]; then
    want=${want# }
    printf '%s\n' "${want% }"
    exit 0
  fi
  kendex=none
  if [ "$suite_os" = Linux ]; then
    for shard in $want; do
      case " $CHECKOUT_KENDEX_SHARDS " in *" $shard "*) kendex=checkout ;; esac
    done
  fi
  printf '%s\n' "$kendex"
  exit 0
fi

# The reach, read once for every event's selection: tools/guard
# --suite-reach over the changed paths. REACH_SUITES holds its suites and
# Pi-package trees, one per line, and REACH_TARGETS its Rust targets as a
# JSON list. REACH_READ stays false where the query failed: the selection
# then runs every shard, suite and target. The query's notes that a tree ran
# whole, and its findings, are forwarded on stderr.
REACH_READ=false
REACH_SUITES=""
REACH_TARGETS='[]'
reach_read() {
  local out err status=0 list="" target
  err="$(mktemp)" || { printf 'ci-job-set: reach=unread cause=mktemp\n' >&2; return 0; }
  out="$(printf '%s\n' "$paths" | "$TOOLS_DIR/guard" --suite-reach 2>"$err")" || status=$?
  sed -n 's/^\(guard: .*\|guard-note: suites=all .*\)$/ci-job-set: reach-note: \1/p' "$err" >&2 || true
  rm -f -- "$err"
  if [ "$status" -ne 0 ]; then
    printf 'ci-job-set: reach=unread status=%s\n' "$status" >&2
    return 0
  fi
  REACH_SUITES="$(printf '%s\n' "$out" | sed '/^target /d; /^$/d')"
  while IFS= read -r target; do
    [ -z "$target" ] || list="$list,\"$target\""
  done <<<"$(printf '%s\n' "$out" | sed -n 's/^target //p')"
  REACH_TARGETS="[${list#,}]"
  REACH_READ=true
}

# Every target of every skill runtime, as the workflow's Rust step reads a
# whole manifest: `<package>/*`.
all_targets() {
  local manifest list="" package
  for manifest in skills/*/runtime/Cargo.toml; do
    [ -f "$manifest" ] || continue
    package="${manifest#skills/}"
    list="$list,\"${package%%/*}/*\""
  done
  printf '[%s]' "${list#,}"
}

# Every shell suite a shard step can hand --suite-list, one per line.
universe() {
  local listed
  listed="$(git -c core.quotePath=false ls-files -- ':(glob)skills/*/tests/*.sh' ':(glob)skills/*/tests/*.test.mjs' \
    ':(glob)tools/tests/*.sh' ':(glob)hooks/tests/*.sh' ':(glob)refresh/tests/*.sh')" ||
    die universe-unread "git could not list the shell suites a shard step runs"
  printf '%s\n' "$listed" | awk 'NF && !/\/run-all\.sh$/'
}

# Each suite on stdin into `want` by the shards whose steps run it: orch's
# by the shard run-all.sh --shard-of gives it on either runner, every orch
# shard where that cannot answer; any other suite, and a Pi-package tree
# spelled DIR/, by its package's want_package shards.
project() {
  local suite package orch="" os shard
  while IFS= read -r suite; do
    [ -n "$suite" ] || continue
    case "$suite" in
      skills/orch/tests/*) orch="$orch$suite
"; continue ;;
    esac
    package="$(printf '%s\n' "$suite" | awk -v mode=package "$PACKAGE_AWK")" ||
      die suite-package-unread "the suite path $suite could not be mapped to its package"
    [ -z "$package" ] || want_package "${package% *}"
  done
  [ -n "$orch" ] || return 0
  for os in Linux macOS; do
    if ! shard="$(printf '%s' "$orch" | RUNNER_OS=$os bash skills/orch/tests/run-all.sh --shard-of 2>/dev/null | cut -d' ' -f1 | sort -u)"; then
      printf 'ci-job-set: orch-shards=unread os=%s\n' "$os" >&2
      # shellcheck disable=SC2086 # the list is a word list
      want_shard $ORCH_SHARDS
      return 0
    fi
    # shellcheck disable=SC2086 # one shard per word
    [ -z "$shard" ] || want_shard $shard
  done
}

# A measured row's `shards=` value, the JSON list in roster order, then its
# `skipped_suites=` value: every universe suite outside the kept set, save
# those a shard selected whole runs. The two lists are separated by a blank.
select_shards() { # BUILD(true|false)
  local build="$1" path list="" shard cited kept="$REACH_SUITES" whole="" suite need="" orch_map="" orch package suite_shards os skipped suites
  want=" "
  set --
  while IFS= read -r path; do
    case "$path" in
      .bun-version) whole="$whole node" ;;
      hooks/tests/* | *.md) ;;
      hooks/* | .claude/hooks/* | .codex/hooks/* | .pi/kendex/hooks/*)
        whole="$whole node"
        kept="$kept
tools/tests/harness-smoke.test.sh" ;;
    esac
    case "$path" in skills/* | hooks/* | tools/* | refresh/*) whole="$whole guards-scans" ;; esac
    [ ! -f "$path" ] || set -- "$@" "$path"
  done <<<"$paths"
  # A changed file citing a shard by name, in the form
  # tools/tests/orch-shard-partition.test.sh holds to the roster, runs that
  # suite.
  if [ "$#" -gt 0 ]; then
    cited=0
    grep -qE -- "$SHARD_CITATION" "$@" || cited=$?
    case "$cited" in
      0) kept="$kept
tools/tests/orch-shard-partition.test.sh" ;;
      1) ;;
      *) die "citation-read-failed" "the changed files could not be read for shard citations" ;;
    esac
  fi
  [ "$build" = false ] || whole="$whole $CHECKOUT_KENDEX_SHARDS"
  if [ "$REACH_READ" = false ] || any "$ALL_SHARDS"; then
    whole=" $SHARDS"
  fi
  project <<<"$kept"
  [ "$REACH_TARGETS" = '[]' ] || want_shard orch-rest
  # shellcheck disable=SC2086 # the lists are word lists
  want_shard $whole
  for shard in $SHARDS; do
    case "$want" in *" $shard "*) list="$list,\"$shard\"" ;; esac
  done
  if [ "$whole" = " $SHARDS" ]; then
    printf '[%s] []' "${list#,}"
    return 0
  fi
  suites="$(universe)"
  # The whole shards whose steps hand --suite-list candidates, and orch's
  # suites by shard where one is orch's.
  for shard in $whole; do
    case " $LISTLESS_SHARDS " in *" $shard "*) ;; *) need="$need $shard" ;; esac
  done
  case " $need " in
    *" orch-"*)
      orch="$(printf '%s\n' "$suites" | awk '/^skills\/orch\/tests\//')"
      for os in Linux macOS; do
        orch_map="$orch_map$(printf '%s\n' "$orch" | RUNNER_OS=$os bash skills/orch/tests/run-all.sh --shard-of 2>/dev/null)
" || need=" $SHARDS"
      done ;;
  esac
  skipped=""
  while IFS= read -r suite; do
    [ -n "$suite" ] || continue
    case $'\n'"$kept"$'\n' in *$'\n'"$suite"$'\n'*) continue ;; esac
    if [ -n "$need" ]; then
      case "$suite" in
        skills/orch/tests/*)
          suite_shards=" $(printf '%s' "$orch_map" | awk -v suite="$suite" '$2 == suite { printf "%s ", $1 }')" ;;
        *)
          case "$suite" in
            skills/*) package="${suite#skills/}"; package="skills/${package%%/*}" ;;
            *) package="${suite%%/*}" ;;
          esac
          want=" "
          want_package "$package"
          suite_shards=$want ;;
      esac
      for shard in $need; do
        case "$suite_shards" in *" $shard "*) continue 2 ;; esac
      done
    fi
    skipped="$skipped,\"$suite\""
  done <<<"$suites"
  printf '[%s] [%s]' "${list#,}" "${skipped#,}"
}

# Whether one shard of the JSON list SHARDS is one the matrix runs on macOS.
macos_shard() { # SHARDS
  local shard
  for shard in $MACOS_SHARDS; do
    case "$1" in *"\"$shard\""*) return 0 ;; esac
  done
  return 1
}

# One selection, printed as a word list: the lanes and shards CLASS, DOCS
# and PATHS select at EVENT. Every rule on those four inputs is here, the
# refusals included. Run it in a subshell: the readers above take the paths
# from `paths`, which it sets, and the shard projection starts empty each
# time. The reach it projects is read once, before any selection.
select_row() { # CLASS DOCS PATHS EVENT
  local class="$1" docs="$2" event="$4" row read_lines="" platform uitree build shards skipped macos catalog=false known=false each rust
  paths="$3"
  want=" "
  case "$docs" in
    true | false) ;;
    *) die "invalid-docs-only value=$docs" "DOCS_ONLY is true or false" ;;
  esac
  for each in $EVENTS; do
    [ "$each" != "$event" ] || known=true
  done
  [ "$known" = true ] || die "unsupported-event event=$event" "EVENT is one of: $EVENTS push schedule"
  row="$class"
  case "$class" in
    render) ;;
    trivial)
      read_lines="$(reads)" || exit 2
      case "$read_lines" in *named=1*) row=trivial-read ;; esac
      ;;
    micro | small | standard)
      # A measured class is reached only after the classifier read a changed
      # path, and so is a docs verdict of true, so an empty list here is a
      # state no classifier emits. Reading it as "nothing matches" would
      # stand the narrowing lanes down on no evidence.
      [ -n "$paths" ] || die "class-without-paths class=$class" \
        "a measured class arrived with no changed path"
      read_lines="$(reads)" || exit 2
      ;;
    *)
      die "unknown-class class=$class" \
        "no lane selection is declared for this class"
      ;;
  esac
  any "$CATALOG_INPUTS|$LANE_SOURCES" && catalog=true
  case "$read_lines" in *compiled=1*) catalog=true ;; esac
  case "$row" in
    render | trivial)
      printf '%s' "macos=false ui=false bot_instructions=true cargo_linux=false cargo_macos=false cargo_lint=false cargo_windows=false cargo_windows_check=false catalog=$catalog smoke=$catalog shards=[] skipped_suites=[] rust_targets=[]"
      ;;
    micro | small | standard | trivial-read)
      platform=false
      any_outside "$PROSE" && platform=true
      [ "$class:$docs" != standard:false ] || platform=true
      uitree=false
      any '^ui/' && uitree=true
      build=false
      case "$read_lines" in *build=1*) build=true ;; esac
      shards="$(select_shards "$build")" || exit 2
      skipped="${shards#* }"
      shards="${shards%% *}"
      if any "$LANE_SOURCES"; then
        platform=true
        uitree=true
        build=true
      fi
      macos=$platform
      # The runner arithmetic uses the nightly macOS matrix's exclusions.
      macos_shard "$shards" || macos=false
      # The Rust targets are the reach's; a lane source or an unread reach
      # runs every target.
      rust=$REACH_TARGETS
      if [ "$REACH_READ" = false ] || any "$LANE_SOURCES"; then
        rust="$(all_targets)"
      fi
      printf '%s' "macos=$macos ui=$uitree bot_instructions=true cargo_linux=true cargo_macos=$platform cargo_lint=$build cargo_windows=$platform cargo_windows_check=$build catalog=$catalog smoke=$catalog shards=$shards skipped_suites=$skipped rust_targets=$rust"
      ;;
  esac
}

if [ "$proof_route" = true ]; then
  main_proof "$EVENT"
  exit 0
fi

# The reach, read once for every event's selection, and for a class whose
# row can run a shard: render and trivial run none.
case "$CHANGE_CLASS:$paths" in
  micro:?* | small:?* | standard:?* | trivial:?*) reach_read ;;
esac
now="$(select_row "$CHANGE_CLASS" "$DOCS_ONLY" "$paths" "${EVENT:-}")" || exit 2

# Event parity: pull requests and merge groups receive equal lane, shard and
# runner selections for the same class, docs verdict and paths. A rule that
# reads the event breaks that and is refused. .github/workflows/skill-tests.yml
# owns runner and event placement.
# Each other event costs a whole selection again, so only --event-parity
# pays it.
if [ "$parity" = true ]; then
  for event in $EVENTS; do
    [ "$event" != "$EVENT" ] || continue
    other="$(select_row "$CHANGE_CLASS" "$DOCS_ONLY" "$paths" "$event")" || exit 2
    [ "$other" = "$now" ] || die "event-parity event=$event" \
      "$EVENT selects '$now' and $event selects '$other' for the same class, docs verdict and paths"
  done
fi

now_shards="$(sel_get "$now" shards)"
# A plain assignment, so a row that omits the bit ends the step here: read
# inside a test, the refusal would end only the substitution.
macos_on="$(sel_get "$now" macos)"
jobs=""
for lane in $JOBS; do
  value="$(sel_get "$now" "$lane")"
  jobs="$jobs $lane=$value"
done

# The merge group's macOS legs.
queue=""
if [ "$macos_on" = true ]; then
  for shard in $MACOS_SHARDS; do
    case "$now_shards" in *"\"$shard\""*) queue="${queue:+$queue,}\"$shard\"" ;; esac
  done
fi

# shellcheck disable=SC2086 # one `lane=value` word per job
skipped="$(sel_get "$now" skipped_suites)"
rust="$(sel_get "$now" rust_targets)"
emit "$now_shards" "[$queue]" "$skipped" '' "$rust" $jobs
# The group's selection, which the push at its head reads.
[ -z "${CI_SELECTION:-}" ] ||
  printf '{"skipped_suites":%s,"rust_targets":%s}\n' "$skipped" "$rust" >"$CI_SELECTION" ||
  die selection-unwritten "the selection could not be written to CI_SELECTION"
