#!/usr/bin/env bash
# ci-job-set — which lanes of .github/workflows/skill-tests.yml a change class
# runs.
#
# The class comes from the change-class composite action and is never decided
# here; this script maps it, and the changed paths behind it, onto one
# `<lane>=true|false` line per gated lane, plus one `shards=` line naming the
# shell shards the diff selects as a JSON list, one `queue_macos_shards=`
# line naming the selected macOS-capable shards and one `skipped_suites=`
# line, the JSON list of suites the narrowed row skips. Every lane condition in
# that workflow reads one of those lines, the Linux shard matrix `shards` and
# the queue's macOS matrix `queue_macos_shards` on a classified group, so the
# selection is made once instead of re-derived in each `if:`. Where
# CI_SELECTION names a file, a class selection also writes its
# `skipped_suites` and `rust_targets` there as one JSON object, which the
# merge group publishes for the push at its head.
#
# On a push to main the shard, skip and target lines name what that main run
# still owes; see THE PUSH ROUTE below.
#
# Usage: tools/ci-job-set [--event-parity] [--runtime-publish]
#        tools/ci-job-set --suite-list CANDIDATE...
#        tools/ci-job-set --all-rust-targets
#
#   --event-parity  also derive the selection at every other event and refuse
#                   `event-parity` where one differs. The `changes` job of
#                   skill-tests.yml passes it, so the check runs once per
#                   workflow run over the real changed paths; a call without
#                   it derives the one event, at half the cost, for the
#                   suites that call this script many times. A push or a
#                   schedule has no class selection to compare, so their
#                   routes ignore it.
#   --runtime-publish
#                   on a class selection, also publish runtime_publish and
#                   add the leg that uploads it, so the merge group that
#                   proves a head publishes its runtime builds before main
#                   moves. The `changes` job passes it; the suites and
#                   tools/guard, which ask for many selections over
#                   fixtures and have no GitHub to read, do not. A push
#                   computes runtime_publish whatever, and a schedule
#                   ignores it.
#
# Environment:
#   CHANGE_CLASS   render|trivial|micro|small|standard
#   DOCS_ONLY      true|false, the shipped `harness-only --mode docs` verdict
#                  for the same diff
#   CHANGED_PATHS  the changed paths, one per line
#   EVENT          pull_request|merge_group|push|schedule, the event the selection is
#                  for. The first two select the same lanes and shards for
#                  the same class, docs verdict and paths, which
#                  --event-parity checks. The workflow classifies on
#                  merge_group alone; tools/guard --full asks at
#                  pull_request. `push` takes the push route and `schedule`
#                  the night route, which read none of the three variables
#                  above.
#   GITHUB_OUTPUT  the step output file the selection is appended to
#   CI_SELECTION   the file a class selection writes its skips and targets
#                  to, where set
#   PUSH_BEFORE, PUSH_AFTER  the actual main push endpoints
#   MAIN_ONLY_SUITES  workflow-owned dedicated declarations as JSON
#   GITHUB_SHA, GITHUB_REPOSITORY, GITHUB_RUN_ID  the proof lookup identity;
#                  --runtime-publish reads GITHUB_REPOSITORY alone
#
# THE PUSH ROUTE, for EVENT=push on main: read PUSH_BEFORE/PUSH_AFTER,
# then select the range since the latest successful main push of this workflow.
# Pending pushes may be replaced, so the event before head alone cannot
# bound catch-up work. An absent, unread or non-ancestor successful head
# selects every suite, shard and target and cache compilation. An unread
# event range refuses selection, leaving the workflow full fallback.
#
# tools/guard --suite-reach owns the selected suites and Rust targets.
# Per runner, subtract only suites the same-head merge groups selections
# kept and whose every owning shard job completed successfully. Each group
# must select a Rust target and every orch-rest Linux job must succeed to
# prove that target. A failed, pending, absent or unread proof subtracts
# nothing. The workflow's main-only suite owes its dedicated job, since no
# group leg runs it. A proved native replacement stays owed on macOS wherever
# its original does. Lists of suites outside the reach and suites proved by
# the group become skipped_suites and skipped_suites_macos. main_suites
# selects the dedicated declaration and cache_compile selects build inputs.
# runtime_publish names the package runtime builds the head has no published
# artifact for, and adds the leg that publishes them; no proof subtracts it.
# The merge group at the head published them already: its publishing leg is
# a required `CI` leg, so a failed staging or upload ejects the group. This
# owes one only for a commit that reached main without a merge group, such
# as an owner repair under D029, an artifact that expired after the group
# read it, or a listing or run record this push could not read.
# main-proof=read|none|unread reports proof availability on stderr.
#
# THE NIGHT ROUTE, for EVENT=schedule: nightly=false only where the latest
# successful scheduled main run of this workflow has GITHUB_SHA. Otherwise
# nightly=true selects the full night. An unread history retains the night.
# A manual dispatch runs the full night without a selection.
#
# CI projects the shell and skill runtime reach from tools/guard, and the
# workspace Cargo selection from tools/rust-reads. Change class is a review
# input. An incomplete read retains the roster it governs.
#
# The lanes:
#
#   shell_shards        the shell bit and, in shell_os, its runner list, both
#                       derived by emit() from `shards=` and
#                       `queue_macos_shards=`.
#                       .github/workflows/skill-tests.yml owns the jobs and
#                       events that consume these values.
#   bot_instructions    the check of the rendered review-bot instruction
#                       files and the root AGENTS.md region they own,
#                       changelog-entries --base over the range from the
#                       event's base (fragments and package versions), the
#                       document byte ceilings, the index-wide work-marker
#                       scan and the secrets scan of the commits the group
#                       and its pull request add.
#   cargo_linux         the workspace tests on Linux.
#   cargo_macos         the workspace tests on the platform the app ships on.
#   cargo_lint          clippy, fmt and doc over the workspace.
#   cargo_windows       the Windows test run.
#   cargo_windows_check the Windows compile check of the core and CLI targets.
#   ui                  the vitest, tsc and biome lane.
#   catalog             the released engine's strict check and catalog render.
#   smoke               the rendered sample trees read by real harness CLIs.
#   skipped_suites      the JSON list of shell suites outside the reach, `[]`
#                       where every shard runs whole; each shell suite step
#                       leaves the listed suites out of its own. On a push,
#                       also the selected suites the same-head group proved
#                       on Linux.
#   skipped_suites_macos
#                       a push's alone: suites outside its reach and suites
#                       proved on macOS at the head, which its macOS legs
#                       leave out in place of skipped_suites.
#   rust_targets        the JSON list of skill runtime Rust targets the
#                       reach holds, each `<package>/<target>` (`lib` or a
#                       [[test]] name), which the orch-rest leg's runtime
#                       selection reads for its lockfile check and its Rust
#                       targets step; every target of every skill runtime
#                       where a lane source changed or the reach could not
#                       be read.
#                       On a push, the selected targets the group left
#                       unproved.
#   queue_macos_shards  the selected shards less LINUX_ONLY_SHARDS, as a JSON
#                       list in roster order, and empty where the macOS
#                       shell bit is false. Merge groups run these on macOS,
#                       a main push the selected macOS shards its group left
#                       unproved. A selected night uses its fixed full matrix.
#   runtime_publish     a push's, and a class selection's under
#                       --runtime-publish: the JSON list of `{name, key}` for
#                       each package runtime whose build at the head has no
#                       unexpired `<name>-<key>` artifact from a run that
#                       PUBLISHED_RUN admits, the key skills/agent-runtime's
#                       lib/key.sh gives. A listing or run record that cannot
#                       be read proves no publication. Where the list is not
#                       empty, the `shards=` list holds PUBLISH_SHARD, whose
#                       Linux leg builds the runtimes and publishes each
#                       listed build.
#
# Every refusal starts `ci-job-set: cause=<name>` and exits 2. A class this
# table does not name is one of those: the step goes red, every lane's status
# function runs it, and the required contexts refuse the skip, which is the
# loud way to learn a sixth class shipped. An unread reach is no refusal:
# the governed lanes run whole.
set -euo pipefail

# --suite-list CANDIDATE... prints, one per line in argument order, the
# candidate suite paths a shard step runs: each one SKIPPED_SUITES, the
# changes job's `skipped_suites`, does not name whole, so a same-named suite
# of another tree is never left out with it. An unset or empty list keeps
# every candidate, and a list of any other shape is refused. It is the one
# keep-or-skip test: each shard step of skill-tests.yml hands it its
# candidates and runs what it prints, and a step it leaves with none runs no
# suite. A pooled step turns the kept paths into base-name selectors, which
# can run a same-named suite of another battery beside a kept one but never
# drop one.
if [ "${1-}" = --suite-list ]; then
  shift
  skipped="${SKIPPED_SUITES-}"
  case "$skipped" in
    "" | '[]')
      [ "$#" -eq 0 ] || printf '%s\n' "$@"
      exit 0
      ;;
    '["'*'"]')
      grep -Eqx '\[("[^",[:space:]]+")(,"[^",[:space:]]+")*\]' <<<"$skipped" || {
        printf 'ci-job-set: cause=suite-skips-unreadable\n' >&2
        exit 2
      }
      ;;
    *)
      printf 'ci-job-set: cause=suite-skips-unreadable\n' >&2
      exit 2
      ;;
  esac
  listed=" $(printf '%s' "$skipped" | sed 's/[][]//g; s/"//g; s/,/ /g') "
  for candidate in "$@"; do
    case "$listed" in
      *" $candidate "*) ;;
      *) printf '%s\n' "$candidate" ;;
    esac
  done
  exit 0
fi

# A full runtime roster comes from tracked declarations, even where a
# manifest or its checkout directory cannot be opened. Standalone use in
# an unversioned checkout can enumerate the directory only to completion.
runtime_manifests() {
  local files="${COMMITTED_FILES:-}"
  [ "${CHECKOUT_READ:-false}" = false ] || files="$TRACKED_FILES"
  if [ -z "$files" ]; then
    if files="$(git -c core.quotePath=false ls-tree -r --name-only HEAD 2>/dev/null)"; then
      :
    elif [ -d skills ]; then
      files="$(find skills -name Cargo.toml -print)" || return 1
    fi
  fi
  awk '/^skills\/[^\/]+\/runtime\/Cargo\.toml$/' <<<"$files"
}

# Every target of every skill runtime, as the workflow reads a whole
# manifest: `<package>/*`.
all_targets() {
  local manifests
  manifests="$(runtime_manifests)" || return 1
  awk -F / 'NF { printf "%s\"%s/*\"", (n++ ? "," : "["), $2 } END { print (n ? "]" : "[]") }' <<<"$manifests"
}

# --all-rust-targets prints that list on one line. The orch-rest leg's
# runtime selection reads it where the changes job published no
# rust_targets: a night, a manual dispatch or a failed changes job.
if [ "${1-}" = --all-rust-targets ]; then
  [ "$#" -eq 1 ] || exit 2
  all_targets || { printf 'ci-job-set: cause=runtime-inventory-unread\n' >&2; exit 2; }
  exit 0
fi

# --suite-kendex OS PATH [ORCH_SHARD] reports checkout or none for one suite.
# The shared suite runner supplies orch's owning shard from shard_of.
# --suite-shards PATH prints the shards that run one suite's package, on one
# line, space-separated, and an empty line where no shard runs it. tools/guard's
# scoped selection reads it to keep seeding the suites CI does not run.
suite_path="" suite_os="" suite_shard="" suite_query=""
if [ "${1-}" = --suite-kendex ]; then
  [ "$#" -ge 3 ] && [ "$#" -le 4 ] || exit 2
  suite_os=$2 suite_path=$3 suite_shard=${4-} suite_query=kendex
  case "$suite_os" in Linux | macOS) ;; *) exit 2 ;; esac
  shift "$#"
elif [ "${1-}" = --suite-shards ]; then
  [ "$#" -eq 2 ] && [ -n "$2" ] || exit 2
  suite_path=$2 suite_query=shards
  shift "$#"
fi

TOOLS_DIR="$(cd "$(dirname "$0")" && pwd)"

# select_row prints a class selection as one `name=value` word per lane: the
# macOS shell bit, `macos`, then one per gated job, JOBS, then `shards=`.
# emit() writes the step output derived from it.
JOBS="ui bot_instructions cargo_linux cargo_macos cargo_lint cargo_windows cargo_windows_check catalog smoke"
# The events a selection is made for; each selects the same lanes.
EVENTS="pull_request merge_group"
# The workflow fallback and scheduled matrices are GitHub's entry points
# when reach has no verdict, so their shard names exist independently.
SHARDS="review-gate refresh orch-state orch-rest guards-scans guards-commit guards-commit-tail guards-hooks guards-hooks-tail guards-tools guards-tools-tail linear linear-controls worktree worktree-restack rest jarvis slack mailbox node pi-claude-bridge"
# The shell reach cannot distinguish the checkout binary from the released
# one used by the other legs. The partition proof checks workflow parity.
CHECKOUT_KENDEX_SHARDS="refresh orch-rest rest jarvis"
# Both runner-owned orch shards stay owed when shard_of cannot be read.
ORCH_SHARDS="orch-state orch-rest"
# The native eligibility owner declares the macOS shards that are empty,
# unsupported, or whose families another macOS job retains.
# The ownership proof compares those declarations with actual suite coverage
# and the workflow matrix. Linux keeps the complete SHARDS roster.
LINUX_ONLY_SHARDS="$("$TOOLS_DIR/macos-test-contracts" --linux-only-shards)" || exit 2
# The macOS-capable roster, in roster order: every reader of macOS
# eligibility reads this list.
MACOS_SHARDS=""
for shard in $SHARDS; do
  case " $LINUX_ONLY_SHARDS " in *" $shard "*) ;; *) MACOS_SHARDS="${MACOS_SHARDS:+$MACOS_SHARDS }$shard" ;; esac
done

die() { # CAUSE MESSAGE
  printf 'ci-job-set: cause=%s\n' "$1" >&2
  printf 'ci-job-set: %s\n' "$2" >&2
  exit 2
}

# A mistyped mode would drop the parity check or the publication the
# workflow relies on.
parity=false publish=false
for arg in "$@"; do
  case "$arg" in
    --event-parity) parity=true ;;
    --runtime-publish) publish=true ;;
    *) die "unknown-argument value=$*" "the arguments are --event-parity and --runtime-publish" ;;
  esac
done

[ -n "$suite_path" ] || [ -n "${GITHUB_OUTPUT:-}" ] || die missing-output-file \
  "GITHUB_OUTPUT is unset, so no lane could read the selection"

# The one writer of a selection. SHARDS and QUEUE are the Linux shard list
# and the macOS shard list, JSON in roster order; shell_os names each runner
# whose list is non-empty and shell_shards is true where it names one, so a
# merge group and a main push read alike. The JOB=VALUE words of a class row
# follow, and RUST, the `rust_targets=` value, comes last. SKIPPED_MACOS is
# the push route's alone: a class row passes it empty and every leg reads
# SKIPPED.
emit() { # SHARDS QUEUE SKIPPED SKIPPED_MACOS RUST [JOB=VALUE ...]
  local shards="$1" queue="$2" skipped="$3" skipped_macos="$4" rust="$5" legs="" shell=false
  shift 5
  [ "$shards" = "[]" ] || legs='"ubuntu-latest"'
  [ "$queue" = "[]" ] || legs="${legs:+$legs,}\"macos-latest\""
  [ -z "$legs" ] || shell=true
  set -- "shell_shards=$shell" "shell_os=[$legs]" "$@" "shards=$shards" "queue_macos_shards=$queue" "skipped_suites=$skipped"
  [ -z "$skipped_macos" ] || set -- "$@" "skipped_suites_macos=$skipped_macos"
  set -- "$@" "rust_targets=$rust"
  printf '%s\n' "$@" >>"$GITHUB_OUTPUT"
  printf '%s\n' "$@" >&2
}

# The push route, as the header states it. A read that fails proves nothing,
# so it emits the whole rosters, no skip and every target.
PROOF_WORKFLOW=.github/workflows/skill-tests.yml
# The artifact a merge group's changes job publishes CI_SELECTION under.
SELECTION_ARTIFACT=ci-selection
# Shell reach does not enumerate scan and Node step outputs, so a successful
# job in these shards is the main push's proof of the whole shard.
LISTLESS_SHARDS="guards-scans node pi-claude-bridge"
# The package runtimes runtime_publish names for a merge group or a push to
# publish, `<binary name>:<source tree>`, as
# skills/orch/scripts/setup builds them. skill-tests.yml uploads each name
# in a step of its own, so a runtime added here adds its step there.
RUNTIMES="agent-runtime:skills/agent-runtime/runtime orch-runtime:skills/orch/runtime"
# The one leg that publishes: both orch shards build the same keys, and two
# uploads of one name in a run collide.
PUBLISH_SHARD="orch-state"

# The one test of a workflow run record whose artifacts count as main's
# publication, with $path the workflow's path: a run of this workflow on this
# repository's main, a push or a merge group on one of main's queue branches,
# `gh-readonly-queue/main/pr-<number>-<sha>` as merge-group run 41306604685
# records it. A pull-request run whose head branch is named main or starts
# with that prefix passes the branch and repository legs and runs code no
# review accepted, and a fork's pull-request run can upload an artifact of
# any name. The artifact's own workflow_run carries no event or path, so the
# run record decides.
PUBLISHED_RUN='((.event == "push" and .head_branch == "main")
    or (.event == "merge_group" and (.head_branch | startswith("gh-readonly-queue/main/"))))
  and .head_repository.id == .repository.id and .path == $path'

# The runtime_publish value the header states. A key that cannot be computed
# stops the selection: the leg's build computes the same key and would fail
# too. A listing or run record that cannot be read proves nothing published.
# Lists that authorize a skip must account for every advertised row. A
# successful API call with a short or repeated page is still unread.
api_list() { # URL FIELD
  gh api --paginate "$1" | jq -ces --arg key "$2" '
    select(length > 0 and all(.[]; (.[$key] | type) == "array"))
    | [.[][$key][]] as $rows
    | select(($rows | length) < 1000 and all(.[]; .total_count == ($rows | length)))
    | select(all($rows[]; (.id | type) == "number") and ($rows | unique_by(.id) | length) == ($rows | length))
    | $rows
  '
}

runtime_publish() {
  local entry name key listing runs run record status published owed=""
  for entry in $RUNTIMES; do
    name="${entry%%:*}"
    key="$(refuse() { printf 'ci-job-set: %s\n' "$*" >&2; exit 1; }
      . skills/agent-runtime/scripts/lib/key.sh && agent_runtime_key "${entry#*:}")" ||
      die "runtime-key-unread name=$name" "the build key of ${entry#*:} could not be computed"
    published=false
    if listing="$(api_list "repos/$GITHUB_REPOSITORY/actions/artifacts?name=$name-$key&per_page=100" artifacts)" &&
      runs="$(jq -r --arg name "$name-$key" '[.[] | select(.name == $name and .expired == false)
        | .workflow_run.id | numbers] | unique | reverse | .[]' <<<"$listing")"; then
      for run in $runs; do
        status=0
        if record="$(gh api "repos/$GITHUB_REPOSITORY/actions/runs/$run")"; then
          jq -es --arg path "$PROOF_WORKFLOW" --argjson id "$run" \
            "length == 1 and (.[0] | .id == \$id and ($PUBLISHED_RUN))" <<<"$record" >/dev/null 2>&1 || status=$?
        else
          status=2
        fi
        # jq -e exits 1 on a false test and above 1 on input it cannot read.
        case "$status" in
          0) published=true; break ;;
          1) ;;
          *) printf 'ci-job-set: runtime-run-unread name=%s key=%s run=%s\n' "$name" "$key" "$run" >&2 ;;
        esac
      done
    else
      printf 'ci-job-set: runtime-artifacts-unread name=%s key=%s\n' "$name" "$key" >&2
    fi
    [ "$published" = true ] || owed="$owed,{\"name\":\"$name\",\"key\":\"$key\"}"
  done
  printf '[%s]' "${owed#,}"
}

# The Linux shard list LIST, with PUBLISH_SHARD in its roster place where a
# runtime build is owed.
with_publisher() { # LIST
  [ "$RUNTIME_PUBLISH" != '[]' ] || { printf '%s' "$1"; return 0; }
  jq -c --arg add "$PUBLISH_SHARD" --arg roster "$SHARDS" '
    . as $list | [$roster | split(" ")[] | select(. as $s | $s == $add or ($list | index($s)))]' <<<"$1"
}

# Every universe suite with each shard whose steps run it on each runner, one
# `<runner>\t<shard>\t<suite>` line per pair: orch's by run-all.sh
# --shard-of per RUNNER_OS, every other by want_package as --suite-shards
# reads it, a macOS line only for a macOS-capable shard. It is the class
# route's projection, so a suite a group kept had every one of these shards
# selected. Status 1 is a suite list that could not be read or a run-all.sh
# that could not place orch's suites.
suite_map() {
  local suites suite orch os runner placed package shard
  suites="$(universe)" || return 1
  orch="$(printf '%s\n' "$suites" | awk '/^skills\/orch\/tests\//')" || return 1
  for os in Linux macOS; do
    runner=ubuntu-latest
    [ "$os" = Linux ] || runner=macos-latest
    [ -n "$orch" ] || continue
    placed="$(orch_placement "$os" "$orch")" || return 1
    printf '%s\n' "$placed" | awk -v runner="$runner" 'NF == 2 { print runner "\t" $1 "\t" $2 }' || return 1
  done
  while IFS= read -r suite; do
    case "$suite" in "" | skills/orch/tests/*) continue ;; esac
    case "$suite" in
      skills/*) package="${suite#skills/}"; package="skills/${package%%/*}" ;;
      *) package="${suite%%/*}" ;;
    esac
    want=" "
    suite_path=$suite
    want_package "$package"
    for shard in $want; do
      printf 'ubuntu-latest\t%s\t%s\n' "$shard" "$suite"
      case " $MACOS_SHARDS " in *" $shard "*) printf 'macos-latest\t%s\t%s\n' "$shard" "$suite" ;; esac
    done
  done <<<"$suites"
  suite_path=""
}

# Every Rust target of every skill runtime, one `<package>/<target>` per
# line: `lib` and each [[test]] name of skills/<package>/runtime/Cargo.toml,
# the names tools/guard's reach gives targets.
runtime_targets() {
  local manifests manifest package
  manifests="$(runtime_manifests)" || return 1
  while IFS= read -r manifest; do
    [ -n "$manifest" ] || continue
    package="${manifest#skills/}"
    package="${package%%/*}"
    printf '%s/lib\n' "$package"
    awk -v package="$package" '
      /^\[/ { section = $0; next }
      section == "[[test]]" && /^name *=/ { name = $0; sub(/^[^"]*"/, "", name); sub(/".*/, "", name); print package "/" name }
    ' "$manifest" || return 1
  done <<<"$manifests"
}

# A failed proof read subtracts nothing from the selected work.
main_proof() {
  local sha="$GITHUB_SHA" api="repos/$GITHUB_REPOSITORY/actions" state=read cause="" mark=main-proof
  local runs ids="" id page jobs="" sels="" listing artifact sel work owed replacements
  local linux macos skipped skipped_macos rust linux_n macos_n targets_n
  if [ "$SUITE_INPUTS_READ" = false ]; then
    state=unread cause=checkout-inventory-unread
  elif ! runs="$(api_list "$api/workflows/${PROOF_WORKFLOW##*/}/runs?event=merge_group&head_sha=$sha&per_page=100" workflow_runs)"; then
    state=unread cause=runs-read-failed
  elif ! ids="$(jq -r --arg sha "$sha" --arg path "$PROOF_WORKFLOW" '
      [.[] | select(.event == "merge_group" and .head_sha == $sha and .path == $path) | .id]
      | unique | .[]' <<<"$runs")"; then
    state=unread cause=runs-unparseable ids=""
  fi
  if [ "$state" = read ] && [ -z "$ids" ]; then
    state=none cause=no-merge-group-run
  fi
  work="$(mktemp -d)" || die proof-scratch "mktemp could not make the proof's scratch directory"
  # Each run's latest jobs, each checked for the head and run it claims.
  run_jobs() { # RUN
    page="$(api_list "$api/runs/$1/jobs?filter=latest&per_page=100" jobs)" || { cause="jobs-read-failed run=$1"; return 1; }
    page="$(jq -c --arg sha "$sha" --argjson id "$1" '
        [.[] | select(.head_sha == $sha and .run_id == $id) | {name, status, conclusion}]' <<<"$page")" ||
      { cause="jobs-unparseable run=$1"; return 1; }
  }
  for id in $ids; do
    run_jobs "$id" || { state=unread; break; }
    jobs="$jobs$page"
    # The run's newest unexpired selection: a rerun of its changes job
    # overwrites it, and a run that published none proves nothing.
    if ! listing="$(api_list "$api/runs/$id/artifacts?name=$SELECTION_ARTIFACT&per_page=100" artifacts)" ||
      ! artifact="$(jq -r --argjson id "$id" --arg name "$SELECTION_ARTIFACT" '
          [.[] | select(.name == $name and .expired == false and .workflow_run.id == $id)]
          | max_by(.created_at) | .id // empty' <<<"$listing")" ||
      [ -z "$artifact" ] ||
      ! gh api "$api/artifacts/$artifact/zip" >"$work/selection.zip" ||
      ! sel="$(unzip -p "$work/selection.zip" | jq -ces '
          select(length == 1) | .[0]
          | select((.skipped_suites | type) == "array" and all(.skipped_suites[]; type == "string")
            and (.rust_targets | type) == "array" and all(.rust_targets[]; type == "string"))
          | {skipped_suites, rust_targets}')"; then
      state=unread cause="selection-unread run=$id"
      break
    fi
    sels="$sels$sel"
  done
  linux_n=0 macos_n=0 targets_n=0
  if [ "$state" = read ] && ! {
     jq -cs 'add // []' <<<"$jobs" >"$work/jobs.json" &&
      jq -cs '.' <<<"$sels" >"$work/selections.json" &&
      suite_map | jq -Rcs 'split("\n") | map(select(length > 0) | split("\t"))' >"$work/map.json" &&
      runtime_targets | jq -Rcs 'split("\n") | map(select(length > 0))' >"$work/targets.json" &&
      replacements="$(native_replacements)"
  }; then
    state=unread cause=proof-inputs-unread
  fi
  if [ "$state" = read ]; then
    # Per runner the proved suites and the shards that still run one, the
    # targets left unproved and the counts, as whitespace-separated JSON.
    if owed="$(jq -rn --slurpfile jobs "$work/jobs.json" \
      --slurpfile sels "$work/selections.json" --slurpfile map "$work/map.json" --slurpfile targets "$work/targets.json" \
      --argjson selected_linux "$main_linux" --argjson selected_macos "$main_macos" \
      --argjson selected_skip "$main_skipped" --argjson selected_targets "$main_targets" \
      --argjson main_only "$MAIN_ONLY_SUITES" --argjson replacements "$replacements" \
      --arg listless "$LISTLESS_SHARDS" '
      $jobs[0] as $jobs | $sels[0] as $sels
      # No group leg runs a declared main-only suite, so no group proves
      # it, and the push runs it in its dedicated job, never on a shard leg
      # it would owe. A shell one matches by base name, as MAIN_ONLY_FILTERS
      # drops it.
      | [$main_only[].suite + ".sh"] as $main_only
      | [$map[0][] | select(.[2] as $s | ($selected_skip | index($s) | not)
          and ($main_only | index($s | split("/") | last) | not))] as $map
      | $targets[0] as $universe_targets
      | [$universe_targets[] | select(. as $t | any($selected_targets[]; . as $e | $e == $t or
          (($e | endswith("/*")) and ($t | startswith($e | rtrimstr("*"))))))] as $targets
      | ($listless | split(" ")) as $whole
      | ($sels | length > 0) as $read
      | ([$sels[].skipped_suites[]] | map({(.): true}) | add // {}) as $left
      | def all_green: length > 0 and all(.[]; .status == "completed" and .conclusion == "success");
        def green($pool; $shard; $os):
          [$pool[] | select(.name == "Skill suites shard (\($shard), \($os))")] | all_green;
        def proved($os):
          [$map[] | select(.[0] == $os)] | group_by(.[2])
          | map(select($read and ($left[.[0][2]] | not) and all(.[]; green($jobs; .[1]; $os))) | .[0][2]);
        def owed($os; $roster; $proved):
          ($proved | map({(.): true}) | add // {}) as $done
          | ([$map[] | select(.[0] == $os and ($done[.[2]] | not)) | .[1]] | unique) as $need
          | [$roster | split(" ")[] | select(. as $shard
              | if any($whole[]; . == $shard) then (green($jobs; $shard; $os) | not)
                else any($need[]; . == $shard) end)];
        def expand: . as $list
          | [$targets[] | select(. as $t
              | any($list[]; . as $e | $e == $t or (($e | endswith("/*")) and ($t | startswith($e | rtrimstr("*"))))))];
      (if $read and green($jobs; "orch-rest"; "ubuntu-latest")
        then [$sels[] | .rust_targets | expand] as $sets
          | [$targets[] | select(. as $t | all($sets[]; any(.[]; . == $t)))]
        else [] end) as $done
      | ($targets - $done) as $open
      | [$targets | map(split("/")[0]) | unique[] as $package
          | [$universe_targets[] | select(startswith($package + "/"))] as $all
          | [$open[] | select(startswith($package + "/"))] as $mine
          | if ($mine | length) == 0 then empty
            elif ($mine | length) == ($all | length) then "\($package)/*"
            else $mine[] end] as $rust
      | proved("ubuntu-latest") as $pl | proved("macos-latest") as $pm
      # macOS refuses an original whose replacement is skipped, so a proved
      # replacement is owed again wherever its original still runs.
      | ($pm | map({(.): true}) | add // {}) as $done_macos
      | ($pm - [$map[] | select(.[0] == "macos-latest" and ($done_macos[.[2]] | not)) | $replacements[.[2]] // empty]) as $pm
      | ($selected_linux | join(" ")) as $linux | ($selected_macos | join(" ")) as $macos
      | owed("ubuntu-latest"; $linux; $pl) as $ol
      | [$linux | split(" ")[] | select(. as $shard | any($ol[]; . == $shard) or ($shard == "orch-rest" and ($rust | length) > 0))] as $ol
      | owed("macos-latest"; $macos; $pm) as $om
      | "\($ol | tojson) \($om | tojson) \(($pl + $selected_skip | unique) | tojson) \(($pm + $selected_skip | unique) | tojson) \($rust | tojson) \($pl | length) \($pm | length) \($done | length)"')" &&
      read -r linux macos skipped skipped_macos rust linux_n macos_n targets_n <<<"$owed" && [ -n "$targets_n" ]; then
      linux="$(with_publisher "$linux")" || die publisher-unadded "jq could not add the publishing leg"
      emit "$linux" "$macos" "$skipped" "$skipped_macos" "$rust" "main_suites=$main_suites" \
        "cache_compile=$main_build" "runtime_publish=$RUNTIME_PUBLISH"
    else
      state=unread cause=proof-subtraction-unread
    fi
  fi
  rm -rf -- "$work"
  if [ "$state" != read ]; then
    main_linux="$(with_publisher "$main_linux")" || die publisher-unadded "jq could not add the publishing leg"
    emit "$main_linux" "$main_macos" "$main_skipped" "$main_skipped" "$main_targets" "main_suites=$main_suites" \
      "cache_compile=$main_build" "runtime_publish=$RUNTIME_PUBLISH"
  fi
  ids="$(printf '%s' "$ids" | tr '\n' ',')"
  ids="${ids#,}"
  ids="${ids%,}"
  printf 'ci-job-set: %s=%s runs=%s proved-linux=%d proved-macos=%d proved-targets=%d%s\n' \
    "$mark" "$state" "${ids:-none}" "$linux_n" "$macos_n" "$targets_n" "${cause:+ cause=$cause}" >&2
  [ -z "$cause" ] || printf '::warning title=%s runs its selected roster::ci-job-set: %s=%s cause=%s\n' \
    'main push' "$mark" "$state" "$cause"
}

# The proof routes read no class and no paths.
proof_route=false
[ -n "$suite_path" ] || case "${EVENT:-}" in push | schedule) proof_route=true ;; esac
[ -n "$suite_path" ] || [ "$proof_route" = true ] || [ -n "${CHANGE_CLASS:-}" ] || die missing-class "CHANGE_CLASS is required"

# Present-but-empty is a state of its own, and not the same as absent.
paths="${CHANGED_PATHS-__unset__}"
[ -n "$suite_path" ] || [ "$proof_route" = true ] || [ "$paths" != __unset__ ] || die missing-paths "CHANGED_PATHS is required"

# The value SELECTION holds for NAME. A selection naming no value for a lane
# ends the step, before any lane has read a selection with it missing.
sel_get() { # SELECTION NAME
  local rest=" $1 "
  case "$rest" in
    *" $2="*) ;;
    *) die "lane-unselected lane=$2" "the row declares no value for this lane" ;;
  esac
  rest="${rest#*" $2="}"
  printf '%s' "${rest%% *}"
}

any() { # REGEX — is some changed path inside it?
  local path
  while IFS= read -r path; do
    [[ ! $path =~ $1 ]] || return 0
  done <<<"$paths"
  return 1
}
any_outside() { # REGEX — is some changed path NOT inside it?
  local path
  while IFS= read -r path; do
    [[ $path =~ $1 ]] || return 0
  done <<<"$paths"
  return 1
}

# Directory build rows include prose that only an explicit read can reach.
# Native duplicate execution stands down on portable text changes.
PROSE='\.(md|markdown)$'
# The selection's own inputs force full coverage: a changed selector cannot
# supply independent proof that the checks it omitted were safe to skip.
LANE_SOURCES='^(\.github/(workflows|actions)/|tools/(ci-job-set|ci-aggregate|guard|rust-reads|macos-test-contracts|macos-test-contracts\.json)$)'
# Battery dispatch is by suite name, which the file reach cannot trace.
RUNNERS='^(skills/orch/tests/run-all\.sh|tools/tests/run-all\.sh)$'
# The repository's catalog layout. The release check also reads Git setup
# and its driver, using a downloaded engine outside the source reach.
CATALOG_SOURCE='^((agents|skills|hooks|commands|mcp|output-styles|pi-extensions|plugins|\.claude-plugin)/|kendex\.toml$|\.gitmodules$)'
CATALOG_INPUTS="$CATALOG_SOURCE|^(\.git(ignore|attributes)$|tools/catalog-release-check$)"
# What selects every shell shard whole: the lane sources, the rest of
# .github/ and the runners.
ALL_SHARDS="^\\.github/|$LANE_SOURCES|$RUNNERS"
UI_INPUTS='^ui/'

# The committed tree witnesses the inputs the index must cover. A missing
# index can report an empty list successfully, and a shorter list cannot
# authorize skips. An unborn repository has only its staged inventory.
COMMITTED_FILES="" TRACKED_FILES=""
CHECKOUT_READ=false
checkout_inventory() {
  local index unlisted refs
  if ! COMMITTED_FILES="$(git -c core.quotePath=false ls-tree -r --full-tree --name-only HEAD 2>/dev/null)"; then
    refs="$(git rev-list --all --count)" || return 1
    [ "$refs" = 0 ] && git symbolic-ref -q HEAD >/dev/null || return 1
  fi
  index="$(git rev-parse --git-path index)" || return 1
  [ -s "$index" ] && [ -r "$index" ] || return 1
  TRACKED_FILES="$(git -c core.quotePath=false ls-files --cached -- | LC_ALL=C sort -u)" || return 1
  [ -n "$TRACKED_FILES" ] || return 1
  case $'\n'"$TRACKED_FILES" in *$'\n'\"*) return 1 ;; esac
  unlisted="$(printf '%s\n' "$COMMITTED_FILES" | LC_ALL=C sort -u |
    LC_ALL=C comm -23 - <(printf '%s\n' "$TRACKED_FILES"))" || return 1
  [ -z "$COMMITTED_FILES" ] || [ -z "$unlisted" ] || return 1
  CHECKOUT_READ=true
}

tracked_file() { # PATH
  [[ $'\n'$TRACKED_FILES$'\n' == *$'\n'"$1"$'\n'* ]]
}

# Check inputs from the declared inventory before the reach discovers
# consumers. A checkout glob alone cannot distinguish absent from unread.
suite_inputs_readable() {
  local file dir dirs=$'\n'
  while IFS= read -r file; do
    case "$file" in skills/* | hooks/* | refresh/* | tools/* | pi-extensions/*) ;; *) continue ;; esac
    if [ ! -f "$file" ] || [ ! -r "$file" ]; then
      printf 'ci-job-set: checkout-input=unread path=%s\n' "$file" >&2
      return 1
    fi
    dir=$file
    while [[ $dir == */* ]]; do
      dir=${dir%/*}
      [[ $dirs != *$'\n'"$dir"$'\n'* ]] || break
      if [ ! -r "$dir" ] || [ ! -x "$dir" ]; then
        printf 'ci-job-set: checkout-input=unread path=%s\n' "$dir" >&2
        return 1
      fi
      dirs+="$dir"$'\n'
    done
  done <<<"$TRACKED_FILES"
}

# Job-owned inputs include the Windows package roots, the Linux Bun pin and
# direct tools/ commands in run steps. Checkout setup shares the shell
# build step's condition, whose shard roster the partition suite checks.
cargo_job_reads() {
  if [ ! -f "$PROOF_WORKFLOW" ] || [ ! -r "$PROOF_WORKFLOW" ]; then
    if tracked_file "$PROOF_WORKFLOW" || [ -e "$PROOF_WORKFLOW" ]; then
      printf 'ci-job-set: checkout-input=unread path=%s\n' "$PROOF_WORKFLOW" >&2
      return 1
    fi
    return 0
  fi
  awk '
    /^  [a-z][a-z0-9-]*:/ { job=$1; condition=""; block=0; bun=0 }
    /^      - / { condition=""; block=0 }
    /^        if: / { condition=substr($0, 13) }
    job == "cargo-check-windows:" { windows_job=1 }
    job == "cargo-check-windows:" && /^        run: cargo check / {
      for (i=1; i<NF; i++)
        if (($i == "-p" || $i == "--package") && $(i+1) ~ /^[a-zA-Z0-9_-]+$/) {
          print "windows", $(i+1)
          windows_read=1
        }
    }
    job == "cargo-linux:" && /^      - / {
      bun = /\/setup-bun@/
      crate = ""
    }
    bun && /^        if: matrix\.crate == / {
      crate = $NF
      gsub(/\047/, "", crate)
    }
    bun && /^          bun-version-file: / { print "setup", $2, crate }
    /^        run: / {
      block=($2 ~ /^[|>][-+]?$/)
      if (!block) command=substr($0, 14)
    }
    block && /^          [^ ]/ { command=substr($0, 11) }
    command != "" {
      if (job == "skill-suites-shard:" && command ~ /^cargo build -p kendex-cli([[:space:]]|$)/)
        checkout_condition[condition]=1
      if (match(command, /^(\.\/)?tools\/[a-zA-Z0-9_.\/-]+([[:space:]]|$)/)) {
        script=substr(command, RSTART, RLENGTH)
        sub(/^\.\//, "", script)
        sub(/[[:space:]]$/, "", script)
        if (job == "cargo-linux:") print "linux-job", script
        if (job == "cargo-lint:") print "lint-job", script
        if (job == "smoke:") print "smoke-job", script
        if (job == "skill-suites-shard:") shell_script[script, condition]=1
      }
      command=""
    }
    END {
      if (windows_job && !windows_read) print "windows", "*"
      for (entry in shell_script) {
        split(entry, pair, SUBSEP)
        if (pair[2] in checkout_condition) print "checkout-job", pair[1]
      }
    }
  ' "$PROOF_WORKFLOW"
}

# Project source reads onto compiler, smoke and Linux test inputs. An opaque
# checkout read retains its executable but cannot place a changed path.
reads() {
  local rows job_reads not_rendered=""
  rows="$("$TOOLS_DIR/rust-reads" --cli-smoke --ci-targets .)" ||
    return 1
  awk -F '\t' '
    $1 == "complete" && NF == 2 && $2 == NR - 1 { complete=NR; next }
    $1 == "package-root" { packages++ }
    $1 == "target-root" { targets++ }
    END { exit !(complete && complete == NR && packages && targets) }
  ' <<<"$rows" || return 1
  job_reads="$(cargo_job_reads)" ||
    return 1
  if [[ $rows == *$'\ntarget-catalog\t'* ]]; then
    # Use SealedSource's own fixed top-level render exclusions. A changed
    # or unreadable declaration authorizes no narrowed Cargo matrix.
    not_rendered="$(awk '
      /^pub const NOT_RENDERED: / {
        count++
        if (!match($0, /\[&str; [0-9]+\]/)) exit 1
        size=substr($0, RSTART, RLENGTH)
        sub(/^.*; /, "", size); sub(/\]$/, "", size)
        sub(/^.* = \[/, "")
        if (!sub(/\];$/, "") || $0 !~ /^"[[:alnum:]_.-]+"(, "[[:alnum:]_.-]+")*$/) exit 1
        gsub(/"|,/, "")
        if (NF != size) exit 1
        print
      }
      END { if (count != 1) exit 1 }
    ' crates/core/src/source_read.rs)" || return 1
  fi
  PROSE="$PROSE" CI_PACKAGES="$ALL_SHARDS|$UI_INPUTS" PLACED="$REACH_PLACED" \
    EXCLUDED="$REACH_EXCLUDED" CARGO_JOB_READS="$job_reads" PATHS="$paths" \
    CATALOG_SOURCE="$CATALOG_SOURCE" NOT_RENDERED="$not_rendered" awk -F '\t' '
    BEGIN {
      n = split(ENVIRON["CARGO_JOB_READS"], inputs, "\n")
      for (i = 1; i <= n; i++) {
        split(inputs[i], input, " ")
        if (input[1] == "windows") windows_packages[input[2]] = 1
        else if (input[1] == "setup") setup[input[2], input[3]] = 1
        else job_script[input[1], input[2]] = 1
      }
      n = split(ENVIRON["PLACED"], paths, "\n")
      for (i = 1; i <= n; i++) placed[paths[i]] = 1
      n = split(ENVIRON["EXCLUDED"], paths, "\n")
      for (i = 1; i <= n; i++) excluded[paths[i]] = 1
      n = split(ENVIRON["NOT_RENDERED"], entries, " ")
      for (i = 1; i <= n; i++) not_rendered[entries[i]] = 1
    }
    $1 == "complete" { next }
    { kind[NR] = $1; read[NR] = $2; crate[NR] = $3; selector[NR] = $4; name[NR] = $5 }
    function select_target(r) {
      selected[crate[r] " --" selector[r] (selector[r] == "lib" ? "" : " " name[r])] = 1
    }
    function catalog_source(path,   segments) {
      if (path !~ ENVIRON["CATALOG_SOURCE"]) return 0
      return !(split(path, segments, "/") >= 3 && segments[1] == "skills" && segments[3] in not_rendered)
    }
    END {
      n = split(ENVIRON["PATHS"], changed, "\n")
      for (p = 1; p <= n; p++) {
        path = changed[p]
        if (path == "") continue
        mapped = path in placed || path ~ ENVIRON["CI_PACKAGES"]
        if (("linux-job", path) in job_script) linux_full = mapped = 1
        if (("lint-job", path) in job_script) lint = mapped = 1
        if (("smoke-job", path) in job_script) smoke = mapped = 1
        if (("checkout-job", path) in job_script) checkout = mapped = 1
        for (r = 1; r <= NR; r++) {
          if (kind[r] == "target-root") {
            if ((path, crate[r]) in setup || (path, "") in setup) { select_target(r); mapped = 1 }
            if (path == read[r]) mapped = 1
            continue
          }
          if (kind[r] == "package-root") {
            if (read[r] == "." || index(path, read[r] "/") == 1) mapped = 1
            continue
          }
          if (kind[r] == "target-catalog") {
            if (catalog_source(path)) { select_target(r); mapped = 1 }
            continue
          }
          if (read[r] == ".") {
            if (kind[r] != "target") continue
          } else if (path != read[r] && index(path, read[r] "/") != 1) continue
          if (kind[r] == "build" && path !~ ENVIRON["PROSE"]) build = 1
          if (kind[r] == "include") included = 1
          if (kind[r] == "package-include" && (crate[r] in windows_packages || "*" in windows_packages)) windows = 1
          if (kind[r] == "checkout-include") checkout = 1
          if (kind[r] == "cli-include" || (kind[r] == "cli-build" && path !~ ENVIRON["PROSE"])) compiled = 1
          if (kind[r] == "target") select_target(r)
          if (read[r] != "." && (kind[r] != "build" || path !~ ENVIRON["PROSE"])) mapped = 1
          printf "ci-job-set: rust-read=%s kind=%s path=%s\n", read[r], kind[r], path > "/dev/stderr"
        }
        if (!mapped) {
          unplaced = 1
          if (!(path in excluded)) suites_unplaced = 1
          printf "ci-job-set: cargo-test-input=unplaced path=%s\n", path > "/dev/stderr"
        }
      }
      printf "build=%d\nincluded=%d\ncompiled=%d\nwindows=%d\ncheckout=%d\n", build, included, compiled, windows, checkout
      printf "linux-full=%d\nworkflow-lint=%d\nworkflow-smoke=%d\n", linux_full, lint, smoke
      printf "unplaced=%d\nsuites-unplaced=%d\n", unplaced, suites_unplaced
      for (test in selected) print "target " test
    }
  ' <<<"$rows"
}

# The one mapping from a tracked file to the package a shard runs it in:
# `skills/<name>` for its scripts/ and tests/, `refresh`, `tools`, `hooks`,
# and `pi-extensions/pi-claude-bridge` or `pi-extensions` for a Pi package;
# a skill's tests/rust/ file is no shell suite's. mode=path prints each file
# that has one, mode=package its `<package> <how>`, <how> `suite` under a
# tests/ directory or in a Pi package and `script` elsewhere.
PACKAGE_AWK='
  /^skills\/[^\/]+\/(scripts|tests)\// { split($0, part, "/"); package = "skills/" part[2] }
  /^refresh\// { package = "refresh" }
  /^tools\// { package = "tools" }
  /^hooks\// { package = "hooks" }
  /^pi-extensions\// { package = "pi-extensions" }
  /^pi-extensions\/pi-claude-bridge\// { package = "pi-extensions/pi-claude-bridge" }
  /^skills\/[^\/]+\/tests\/rust\// { package = "" }
  package == "" { next }
  mode == "path" { print; package = ""; next }
  { print package " " (($0 ~ /\/tests\// || package ~ /^pi-extensions/) ? "suite" : "script"); package = "" }
'

# The shards the changed paths select, gathered into `want` as a
# space-bounded set.
want=" "
want_shard() { # SHARD...
  local shard
  for shard in "$@"; do
    case " $SHARDS " in
      *" $shard "*) ;;
      *) die "shard-undeclared shard=$shard" "a package names a shard the roster does not declare" ;;
    esac
    case "$want" in *" $shard "*) ;; *) want="$want$shard " ;; esac
  done
}
# The shards whose skill-tests.yml steps run a package's suites. `rest` runs
# every skill's suites no other step claims, so a skill named here by no arm
# is its. tools/tests/orch-shard-partition.test.sh holds this table to those
# steps, suite by suite.
want_package() { # PACKAGE
  local suite
  case "$1" in
    skills/orch)
      # shellcheck disable=SC2086 # the list is a word list
      if [ -n "$suite_shard" ]; then want_shard "$suite_shard"
      else want_shard $ORCH_SHARDS; fi ;;
    skills/github) want_shard rest ;;
    skills/review-gate | refresh)
      if [ -n "$suite_path" ]; then want_shard "${1#skills/}"
      else want_shard review-gate refresh; fi ;;
    skills/commit-guards) want_shard guards-commit guards-commit-tail guards-hooks guards-hooks-tail ;;
    skills/linear) want_shard linear linear-controls ;;
    skills/bot-instructions | skills/preflight) want_shard linear ;;
    skills/worktree) want_shard worktree worktree-restack ;;
    # macOS runs no `jarvis` leg: `rest` keeps the family there, less the
    # session and succession suites `guards-hooks` and `guards-tools` run and
    # the controls and watch-loop suites `orch-state` runs.
    skills/jarvis) want_shard jarvis rest guards-hooks guards-tools orch-state ;;
    skills/slack) want_shard slack ;;
    skills/mailbox) want_shard mailbox ;;
    skills/deep-research)
      want_shard node
      for suite in ${suite_path:-skills/deep-research/tests/*.sh}; do
        case "$suite" in *.sh) ;; *) continue ;; esac
        [ ! -f "$suite" ] || { want_shard rest; break; }
      done ;;
    skills/*) want_shard rest ;;
    tools) want_shard guards-tools guards-tools-tail ;;
    hooks) want_shard guards-hooks guards-hooks-tail ;;
    pi-extensions/pi-claude-bridge) want_shard node pi-claude-bridge ;;
    pi-extensions) want_shard node ;;
  esac
}

if [ -n "$suite_path" ]; then
  package=""
  package="$(printf '%s\n' "$suite_path" | awk -v mode=package "$PACKAGE_AWK")" ||
    die suite-package-unread "the suite path could not be mapped to its package"
  [ -z "$package" ] || want_package "${package% *}"
  if [ "$suite_query" = shards ]; then
    want=${want# }
    printf '%s\n' "${want% }"
    exit 0
  fi
  kendex=none
  if [ "$suite_os" = Linux ]; then
    for shard in $want; do
      case " $CHECKOUT_KENDEX_SHARDS " in *" $shard "*) kendex=checkout ;; esac
    done
  fi
  printf '%s\n' "$kendex"
  exit 0
fi

# The reach, read once for every event's selection: tools/guard
# --suite-reach over the changed paths. REACH_SUITES holds its suites and
# Pi-package trees, one per line, and REACH_TARGETS its Rust targets as a
# JSON list. REACH_PLACED records which paths it can place in a package.
# REACH_READ stays false where the query failed: the selection
# then runs every shard, suite and target. The query's notes that a tree ran
# whole, and its findings, are forwarded on stderr as reach-note lines, and
# its progress lines as they are, each as it arrives.
REACH_READ=false
REACH_SUITES=""
REACH_TARGETS='[]'
REACH_PLACED=""
REACH_EXCLUDED=""
CARGO_READ=false
read_lines=""
SUITE_INPUTS_READ=false
FULL_RUNTIME_TARGETS='[]'
LINEAR_CONTROLS_SUITE=skills/linear/tests/must-fail-controls.sh
LINEAR_CONTROLS_NEEDED=false
reach_notes() {
  local line
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      'guard-note: placed-path='*) printf 'placed %s\n' "${line#guard-note: placed-path=}" ;;
      'guard-note: excluded-path='*) printf 'excluded %s\n' "${line#guard-note: excluded-path=}" ;;
      'guard-note: reach-complete='*) printf 'complete %s\n' "${line#guard-note: reach-complete=}" ;;
      'guard: '* | 'guard-note: suites=all '*) printf 'ci-job-set: reach-note: %s\n' "$line" >&2 ;;
      'guard-progress: '*) printf '%s\n' "$line" >&2 ;;
    esac
  done
}
reach_read() {
  local out status=0 list="" target targets placed excluded suites
  # The query's answer reaches the substitution on fd 3; its stderr streams
  # through reach_notes.
  out="$( { printf '%s\n' "$paths" | "$TOOLS_DIR/guard" --suite-reach 2>&1 >&3 3>&- | reach_notes 3>&-; } 3>&1)" ||
    status=$?
  if [ "$status" -ne 0 ] || ! PATHS="$paths" awk '
    BEGIN {
      n = split(ENVIRON["PATHS"], paths, "\n")
      for (i = 1; i <= n; i++) if (paths[i] != "" && !seen[paths[i]]++) count++
    }
    $1 == "complete" { completions++; inputs=$2; rows=$3; next }
    $1 == "placed" || $1 == "excluded" { next }
    NF { read++ }
    END { exit !(completions == 1 && inputs + 0 == count && rows + 0 == read) }
  ' <<<"$out"; then
    printf 'ci-job-set: reach=unread status=%s\n' "$status" >&2
    return 1
  fi
  placed="$(sed -n 's/^placed //p' <<<"$out")" &&
    excluded="$(sed -n 's/^excluded //p' <<<"$out")" &&
    suites="$(sed -E '/^(placed|excluded|complete|target) /d; /^$/d' <<<"$out")" &&
    targets="$(sed -n 's/^target //p' <<<"$out")" || return 1
  while IFS= read -r target; do
    [ -z "$target" ] || list="$list,\"$target\""
  done <<<"$targets"
  REACH_PLACED=$placed
  REACH_EXCLUDED=$excluded
  REACH_SUITES=$suites
  REACH_TARGETS="[${list#,}]"
  REACH_READ=true
}

# The Linear battery mutates the literal file operand of each control helper.
# Read those operands from the tracked declarations. Unrecognized operands
# or an unread roster provide no proof that the battery can be skipped.
linear_controls_needed() {
  local control controls=()
  while IFS= read -r control; do
    case "$control" in
      skills/linear/tests/controls/*.control.sh)
        [ -s "$control" ] || return 1
        controls+=("$control") ;;
    esac
  done <<<"$TRACKED_FILES"
  [ "${#controls[@]}" -gt 0 ] || return 1
  PATHS="$paths" awk '
    BEGIN {
      n = split(ENVIRON["PATHS"], paths, "\n")
      for (i = 1; i <= n; i++) {
        changed[paths[i]] = 1
        if (paths[i] ~ /^skills\/linear\/tests\/controls\/[^/]+\.control\.sh$/) needed = 1
      }
    }
    FNR == 1 { if (NR > 1 && !mutations) unread = 1; mutations = 0 }
    $1 ~ /^control_(replace|append|write)$/ {
      if ($2 !~ /^[[:alnum:]_-]+(\/[[:alnum:]_.-]+)+$/ || $2 ~ /(^|\/)\.\.?($|\/)/) unread = 1
      if (("skills/linear/" $2) in changed) needed = 1
      mutations++
    }
    END { if (unread || !mutations) exit 1; print (needed ? "true" : "false") }
  ' "${controls[@]}"
}

# Both event projections take their skip evidence here. A producer that
# refused or stopped before completing its read authorizes no skips in its
# roster. An unplaced path also keeps suites unless their owner excludes it.
read_selection() {
  [ "$CHECKOUT_READ" = true ] || return 0
  if [ "$SUITE_INPUTS_READ" = true ]; then
    reach_read || printf 'ci-job-set: reach=unproved coverage=full\n' >&2
    if any '^skills/linear/' && tracked_file "$LINEAR_CONTROLS_SUITE"; then
      if ! LINEAR_CONTROLS_NEEDED="$(linear_controls_needed)"; then
        printf 'ci-job-set: linear-control-inputs=unread coverage=full\n' >&2
        REACH_READ=false
      fi
    fi
  fi
  if read_lines="$(reads)"; then
    CARGO_READ=true
    if [[ $read_lines == *suites-unplaced=1* ]]; then REACH_READ=false; fi
  else
    printf 'ci-job-set: cargo-inputs=unread coverage=full\n' >&2
    read_lines=""
    REACH_READ=false
  fi
}

# Every shell suite a shard step can hand --suite-list, one per line.
universe() {
  [ "$SUITE_INPUTS_READ" = true ] || return 1
  awk '/^skills\/[^\/]+\/tests\/[^\/]+\.(sh|test\.mjs)$/ ||
    /^(tools|hooks|refresh)\/tests\/[^\/]+\.sh$/ { if ($0 !~ /\/run-all\.sh$/) print }' <<<"$TRACKED_FILES"
}

# The runner owes exactly one valid placement for each requested suite.
orch_placement() { # OS SUITES
  local placed
  placed="$(RUNNER_OS=$1 bash skills/orch/tests/run-all.sh --shard-of <<<"$2")" || return 1
  EXPECTED="$2" awk -v shards=" $SHARDS " '
    BEGIN {
      n = split(ENVIRON["EXPECTED"], paths, "\n")
      for (i = 1; i <= n; i++) if (paths[i] != "") owed[paths[i]]=1
    }
    NF != 2 || !($2 in owed) || !index(shards, " " $1 " ") { exit 1 }
    { delete owed[$2]; print }
    END { for (path in owed) exit 1 }
  ' <<<"$placed"
}

# Each suite on stdin into `want` by the shards whose steps run it: orch's
# by the shard run-all.sh --shard-of gives it on either runner, every orch
# shard where that cannot answer; any other suite, and a Pi-package tree
# spelled DIR/, by its package's want_package shards.
project() {
  local suite package packages orch="" other="" os shard
  while IFS= read -r suite; do
    [ -n "$suite" ] || continue
    case "$suite" in
      skills/orch/tests/*) orch="$orch$suite
" ;;
      *) other="$other$suite
" ;;
    esac
  done
  # One mapping over every other suite: PACKAGE_AWK prints a line for each
  # suite that has a package, in order.
  packages="$(printf '%s' "$other" | awk -v mode=package "$PACKAGE_AWK")" ||
    die suite-package-unread "the reached suites could not be mapped to their packages"
  while read -r package _; do
    [ -z "$package" ] || want_package "$package"
  done <<<"$packages"
  [ -n "$orch" ] || return 0
  for os in Linux macOS; do
    if ! shard="$(orch_placement "$os" "$orch" | cut -d' ' -f1 | sort -u)"; then
      printf 'ci-job-set: orch-shards=unread os=%s\n' "$os" >&2
      return 1
    fi
    # shellcheck disable=SC2086 # one shard per word
    [ -z "$shard" ] || want_shard $shard
  done
}

# tools/macos-test-contracts.json's native_replacements, each original suite
# to the suite macOS runs in its place, as one JSON object.
native_replacements() {
  jq -ces 'select(length == 1) | .[0].native_replacements
    | select(type == "object" and all(.[]; type == "string" and length > 0))' "$TOOLS_DIR/macos-test-contracts.json" ||
    die "replacements-unread" "tools/macos-test-contracts.json's native_replacements could not be read"
}

# Each native replacement for a suite KEPT names, one per line: macOS runs
# the replacement in the original's place and refuses an original whose
# replacement is skipped.
kept_replacements() { # KEPT
  local pairs original replacement
  pairs="$(native_replacements)" || return 1
  pairs="$(jq -r 'to_entries[] | "\(.key) \(.value)"' <<<"$pairs")" || return 1
  while IFS=' ' read -r original replacement; do
    [ -n "$original" ] || continue
    case $'\n'"$1"$'\n' in *$'\n'"$original"$'\n'*) printf '%s\n' "$replacement" ;; esac
  done <<<"$pairs"
}

# A reach's `shards=` value, the JSON list in roster order, then its
# `skipped_suites=` value: every universe suite outside the kept set, save
# those a shard selected whole runs. The two lists are separated by a blank.
select_shards() { # BUILD(true|false)
  local build="$1" path list="" shard kept="$REACH_SUITES" whole="" suite need="" orch_map="" orch package suite_shards os skipped suites replacements
  want=" "
  if [ "$LINEAR_CONTROLS_NEEDED" = true ]; then
    kept="$kept
$LINEAR_CONTROLS_SUITE"
  fi
  while IFS= read -r path; do
    case "$path" in
      # Deployment inventory, toolchain pin and hook dispatch are dynamic
      # inputs of the Node and executable-bit/portability scans.
      .bun-version) whole="$whole node" ;;
      hooks/tests/* | *.md) ;;
      hooks/* | .claude/hooks/* | .codex/hooks/* | .pi/kendex/hooks/*)
        whole="$whole node"
        kept="$kept
tools/tests/harness-smoke.test.sh" ;;
    esac
    case "$path" in skills/* | hooks/* | tools/* | refresh/*) whole="$whole guards-scans" ;; esac
  done <<<"$paths"
  [ "$build" = false ] || whole="$whole $CHECKOUT_KENDEX_SHARDS"
  if [ "$REACH_READ" = false ] || any "$ALL_SHARDS"; then
    whole=" $SHARDS"
  fi
  replacements="$(kept_replacements "$kept")" || return 1
  [ -z "$replacements" ] || kept="$kept
$replacements"
  project <<<"$kept" || return 1
  [ "$REACH_TARGETS" = '[]' ] || want_shard orch-rest
  # shellcheck disable=SC2086 # the lists are word lists
  want_shard $whole
  for shard in $SHARDS; do
    case "$want" in *" $shard "*) list="$list,\"$shard\"" ;; esac
  done
  if [ "$whole" = " $SHARDS" ]; then
    printf '[%s] []' "${list#,}"
    return 0
  fi
  suites="$(universe)" || return 1
  # The whole shards whose steps hand --suite-list candidates, and orch's
  # suites by shard where one is orch's.
  for shard in $whole; do
    case " $LISTLESS_SHARDS " in *" $shard "*) ;; *) need="$need $shard" ;; esac
  done
  case " $need " in
    *" orch-"*)
      orch="$(printf '%s\n' "$suites" | awk '/^skills\/orch\/tests\//')" || return 1
      for os in Linux macOS; do
        [ -n "$orch" ] || continue
        orch_map="$orch_map$(orch_placement "$os" "$orch")
" || return 1
      done ;;
  esac
  skipped=""
  while IFS= read -r suite; do
    [ -n "$suite" ] || continue
    case $'\n'"$kept"$'\n' in *$'\n'"$suite"$'\n'*) continue ;; esac
    if [ -n "$need" ]; then
      case "$suite" in
        skills/orch/tests/*)
          suite_shards=" $(printf '%s' "$orch_map" | awk -v suite="$suite" '$2 == suite { printf "%s ", $1 }')" || return 1 ;;
        *)
          case "$suite" in
            skills/*) package="${suite#skills/}"; package="skills/${package%%/*}" ;;
            *) package="${suite%%/*}" ;;
          esac
          want=" "
          want_package "$package"
          suite_shards=$want ;;
      esac
      for shard in $need; do
        case "$suite_shards" in *" $shard "*) continue 2 ;; esac
      done
    fi
    skipped="$skipped,\"$suite\""
  done <<<"$suites"
  printf '[%s] [%s]' "${list#,}" "${skipped#,}"
}

choose_shards() { # CHECKOUT — set SHELL_SHARDS, SHELL_SKIPPED and SHELL_FULL
  local row status=0
  SHELL_FULL=true
  SHELL_SHARDS="[\"${SHARDS// /\",\"}\"]"
  SHELL_SKIPPED='[]'
  if [ "$REACH_READ" = true ]; then
    row="$(select_shards "$1")" || status=$?
    case "$status" in
      0) SHELL_FULL=false; SHELL_SHARDS="${row%% *}"; SHELL_SKIPPED="${row#* }"; return 0 ;;
      1) ;;
      *) return "$status" ;;
    esac
  fi
  return 0
}

# Whether one shard of the JSON list SHARDS is one the matrix runs on macOS.
macos_shard() { # SHARDS
  local shard
  for shard in $MACOS_SHARDS; do
    case "$1" in *"\"$shard\""*) return 0 ;; esac
  done
  return 1
}

# One selection, printed as a word list: the lanes and shards CLASS, DOCS
# and PATHS select at EVENT. Every rule on those four inputs is here, the
# refusals included. Run it in a subshell: the readers above take the paths
# from `paths`, which it sets, and the shard projection starts empty each
# time. The reach it projects is read once, before any selection.
select_row() { # CLASS DOCS PATHS EVENT
  local class="$1" docs="$2" event="$4" platform=false uitree=false build=false
  local shards skipped macos=false catalog=false smoke=false linux=false rust matrix="" each known=false
  local checkout=false windows=false
  paths="$3"
  case "$docs" in
    true | false) ;;
    *) die "invalid-docs-only value=$docs" "DOCS_ONLY is true or false" ;;
  esac
  for each in $EVENTS; do
    [ "$each" != "$event" ] || known=true
  done
  [ "$known" = true ] || die "unsupported-event event=$event" "EVENT is one of: $EVENTS push schedule"
  case "$class" in
    render | trivial) ;;
    micro | small | standard)
      [ -n "$paths" ] || die "class-without-paths class=$class" \
        "a measured class arrived with no changed path"
      ;;
    *) die "unknown-class class=$class" "no lane selection is declared for this class" ;;
  esac

  if [ -z "$paths" ]; then
    printf '%s' "macos=false ui=false bot_instructions=true cargo_linux=false cargo_macos=false cargo_lint=false cargo_windows=false cargo_windows_check=false catalog=false smoke=false shards=[] skipped_suites=[] rust_targets=[] cargo_linux_matrix=null"
    return
  fi
  any "$CATALOG_INPUTS|$LANE_SOURCES" && catalog=true
  any "$UI_INPUTS" && uitree=true
  case "$read_lines" in *compiled=1*) catalog=true smoke=true ;; esac
  case "$read_lines" in *workflow-smoke=1*) smoke=true ;; esac
  case "$read_lines" in *included=1* | *build=1* | *workflow-lint=1*) build=true ;; esac
  case "$read_lines" in *checkout=1* | *build=1*) checkout=true ;; esac
  case "$read_lines" in *windows=1* | *build=1*) windows=true ;; esac
  choose_shards "$checkout" || exit 2
  shards=$SHELL_SHARDS
  skipped=$SHELL_SKIPPED
  any_outside "$PROSE" && macos_shard "$shards" && macos=true
  [ "$SHELL_FULL" = false ] || macos=true
  rust=$FULL_RUNTIME_TARGETS
  if [ "$REACH_READ" = true ] && ! any "$LANE_SOURCES"; then
    rust=$REACH_TARGETS
  fi

  # A shared build input affects the workspace. Cargo source reads narrow
  # the test matrix only when every changed path could be placed.
  if any "$LANE_SOURCES"; then
    uitree=true
    build=true
    windows=true
    macos=true
    smoke=true
    linux=true
    platform=true
  elif [ "$CARGO_READ" = false ]; then
    build=true
    catalog=true
    smoke=true
    windows=true
    linux=true
    platform=true
  elif [[ $read_lines == *build=1* ]]; then
    linux=true
    platform=true
  else
    matrix="$(jq -Rcs '
      split("\n") | map(select(startswith("target ")) | split(" ")[1:]) | group_by(.[0])
      | {include: map(sort | {crate: .[0][0], targets: map(.[1:]) | flatten})}
    ' <<<"$read_lines")" || die cargo-matrix-unread "jq could not group workspace targets"
    if [ "$matrix" != '{"include":[]}' ]; then
      linux=true
      any_outside "$PROSE" && platform=true
    fi
    if [[ $read_lines == *unplaced=1* || $read_lines == *linux-full=1* ]]; then
      linux=true
      matrix=""
    fi
  fi
  printf '%s' "macos=$macos ui=$uitree bot_instructions=true cargo_linux=$linux cargo_macos=$platform cargo_lint=$build cargo_windows=$platform cargo_windows_check=$windows catalog=$catalog smoke=$smoke shards=$shards skipped_suites=$skipped rust_targets=$rust cargo_linux_matrix=${matrix:-null}"
}

if [ "${EVENT:-}" = schedule ]; then
  nightly=true
  if runs="$(api_list "repos/$GITHUB_REPOSITORY/actions/workflows/${PROOF_WORKFLOW##*/}/runs?event=schedule&branch=main&status=success&per_page=100" workflow_runs)"; then
    if previous="$(jq -er --arg path "$PROOF_WORKFLOW" --arg id "${GITHUB_RUN_ID:-}" '
      [.[] | select(.event == "schedule" and .head_branch == "main" and .path == $path
        and .status == "completed" and .conclusion == "success" and (.id | tostring) != $id)]
      | sort_by(.created_at) | last | .head_sha | select(type == "string" and length > 0)' <<<"$runs")"; then
      [ "$previous" != "$GITHUB_SHA" ] || nightly=false
    fi
  fi
  printf 'nightly=%s\n' "$nightly" >>"$GITHUB_OUTPUT"
  exit 0
fi

if [ "${EVENT:-}" = push ] || [ -n "$paths" ]; then
  if checkout_inventory && suite_inputs_readable; then
    SUITE_INPUTS_READ=true
  else
    printf 'ci-job-set: suite-inventory=unproved coverage=full\n' >&2
  fi
  FULL_RUNTIME_TARGETS="$(all_targets)" || die runtime-inventory-unread "the full skill-runtime roster could not be read"
fi

if [ "${EVENT:-}" = push ]; then
  [[ ${PUSH_BEFORE:-} =~ ^[0-9a-f]{40}$ && ${PUSH_AFTER:-} =~ ^[0-9a-f]{40}$ ]] ||
    die push-range-unread "the push event endpoints are missing or invalid"
  git cat-file -e "$PUSH_BEFORE^{commit}" && git cat-file -e "$PUSH_AFTER^{commit}" ||
    die push-range-unread "the push event endpoints could not be read"
  # A queued push can replace an unstarted push. Only a successful main run
  # bounds all work the newest head must catch up; the event's before alone
  # cannot prove that its preceding head was tested.
  range_read=false
  if paths="$(git diff --name-only --no-renames "$PUSH_BEFORE" "$PUSH_AFTER" --)" &&
    runs="$(api_list "repos/$GITHUB_REPOSITORY/actions/workflows/${PROOF_WORKFLOW##*/}/runs?event=push&branch=main&status=success&per_page=100" workflow_runs)"; then
    if previous="$(jq -er --arg path "$PROOF_WORKFLOW" --arg id "${GITHUB_RUN_ID:-}" '
      [.[] | select(.event == "push" and .head_branch == "main" and .path == $path
        and .status == "completed" and .conclusion == "success" and (.id | tostring) != $id)]
      | sort_by(.created_at) | last | .head_sha | select(type == "string" and test("^[0-9a-f]{40}$"))' <<<"$runs")" &&
      git merge-base --is-ancestor "$previous" "$PUSH_AFTER" &&
      paths="$(git diff --name-only --no-renames "$previous" "$PUSH_AFTER" --)"; then
      range_read=true
    fi
  fi
  main_build=true
  main_checkout=true
  REACH_READ=false
  if [ "$range_read" = true ]; then
    read_selection
    main_build=false
    main_checkout=false
    case "$read_lines" in *included=1* | *build=1*) main_build=true ;; esac
    case "$read_lines" in *checkout=1* | *build=1*) main_checkout=true ;; esac
    if [ "$CARGO_READ" = false ]; then main_build=true; main_checkout=true; fi
    if any "$LANE_SOURCES"; then
      main_build=true
      main_checkout=true
    fi
  else
    printf 'ci-job-set: main-range=unread coverage=full\n' >&2
  fi
  choose_shards "$main_checkout"
  main_linux=$SHELL_SHARDS
  main_skipped=$SHELL_SKIPPED
  main_targets=$FULL_RUNTIME_TARGETS
  if [ "$REACH_READ" = true ] && ! any "$LANE_SOURCES"; then main_targets=$REACH_TARGETS; fi
  main_macos="$(jq -c --arg roster "$MACOS_SHARDS" '[.[] | select(. as $s | $roster | split(" ") | index($s))]' <<<"$main_linux")" || exit 2
  main_suites="$(jq -ce --argjson selected "$main_linux" '
    if type != "array" or length == 0 then error("missing main declarations") else
      [.[] | select(.shard as $s | $selected | index($s))] end' <<<"${MAIN_ONLY_SUITES:-}")" ||
    die main-suites-unread "the workflow main-only declarations could not be read"
  RUNTIME_PUBLISH="$(runtime_publish)" || exit 2
  main_proof
  exit 0
fi

# The class route says on stderr which step it starts, so the CI step that
# waits on it shows what it is doing: `ci-job-set: progress=<step>
# at=<n>/<steps> elapsed=<s>s`, with ` event=<event>` for a selection. The
# reach's own guard-progress lines come between.
reach_steps=0
[ -z "$paths" ] || reach_steps=1
progress_steps=$((reach_steps + 2))
if [ "$parity" = true ]; then
  for event in $EVENTS; do
    [ "$event" = "${EVENT:-}" ] || progress_steps=$((progress_steps + 1))
  done
fi
progress_step=0
progress() { # STEP [DETAIL]
  progress_step=$((progress_step + 1))
  printf 'ci-job-set: progress=%s at=%s/%s elapsed=%ss%s\n' "$1" "$progress_step" "$progress_steps" "$SECONDS" \
    "${2:+ $2}" >&2
}

# Read each dependency set once, before comparing the event projections.
if [ "$reach_steps" -eq 1 ]; then
  progress reach
  read_selection
fi
progress select "event=${EVENT:-}"
now="$(select_row "$CHANGE_CLASS" "$DOCS_ONLY" "$paths" "${EVENT:-}")" || exit 2

# Event parity: pull requests and merge groups receive equal lane, shard and
# runner selections for the same class, docs verdict and paths. A rule that
# reads the event breaks that and is refused. .github/workflows/skill-tests.yml
# owns runner and event placement.
# Each other event costs a whole selection again, so only --event-parity
# pays it.
if [ "$parity" = true ]; then
  for event in $EVENTS; do
    [ "$event" != "$EVENT" ] || continue
    progress select "event=$event"
    other="$(select_row "$CHANGE_CLASS" "$DOCS_ONLY" "$paths" "$event")" || exit 2
    [ "$other" = "$now" ] || die "event-parity event=$event" \
      "$EVENT selects '$now' and $event selects '$other' for the same class, docs verdict and paths"
  done
fi

progress emit
now_shards="$(sel_get "$now" shards)"
# A plain assignment, so a row that omits the bit ends the step here: read
# inside a test, the refusal would end only the substitution.
macos_on="$(sel_get "$now" macos)"
jobs=""
for lane in $JOBS; do
  value="$(sel_get "$now" "$lane")"
  jobs="$jobs $lane=$value"
done

# The merge group's macOS legs.
queue=""
if [ "$macos_on" = true ]; then
  for shard in $MACOS_SHARDS; do
    case "$now_shards" in *"\"$shard\""*) queue="${queue:+$queue,}\"$shard\"" ;; esac
  done
fi

# The runtime builds this head owes, and the Linux leg that publishes them,
# added after the macOS list so no macOS leg is added with it.
publish_line=""
if [ "$publish" = true ]; then
  RUNTIME_PUBLISH="$(runtime_publish)" || exit 2
  now_shards="$(with_publisher "$now_shards")" || die publisher-unadded "jq could not add the publishing leg"
  publish_line="runtime_publish=$RUNTIME_PUBLISH"
fi

skipped="$(sel_get "$now" skipped_suites)"
rust="$(sel_get "$now" rust_targets)"
matrix="$(sel_get "$now" cargo_linux_matrix)"
# shellcheck disable=SC2086 # one `lane=value` word per job
emit "$now_shards" "[$queue]" "$skipped" '' "$rust" $jobs "cargo_linux_matrix=$matrix" ${publish_line:+"$publish_line"}
# The group's selection, which the push at its head reads.
[ -z "${CI_SELECTION:-}" ] ||
  printf '{"skipped_suites":%s,"rust_targets":%s}\n' "$skipped" "$rust" >"$CI_SELECTION" ||
  die selection-unwritten "the selection could not be written to CI_SELECTION"
