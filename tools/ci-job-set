#!/usr/bin/env bash
# ci-job-set — which lanes of .github/workflows/skill-tests.yml a change class
# runs.
#
# The class comes from the change-class composite action and is never decided
# here; this script maps it, and the changed paths behind it, onto one
# `<lane>=true|false` line per gated lane. Every lane condition in that
# workflow reads one of those lines, so the selection is made once instead of
# re-derived in each `if:`.
#
# Environment:
#   CHANGE_CLASS   render|trivial|micro|small|standard
#   DOCS_ONLY      true|false, the shipped `harness-only --mode docs` verdict
#                  for the same diff
#   CHANGED_PATHS  the changed paths, one per line
#   GITHUB_OUTPUT  the step output file the selection is appended to
#
# The lanes, and what each is answerable to:
#
#   shell_shards     the skill, hook and tool suites. Every measured class
#                    runs them, because they read every tree: the shard
#                    partition suite runs `cargo metadata` over the workspace,
#                    the Linux `rest` shard checks the kendex it builds from
#                    crates/, and the guards-scans shard's doc-limits and
#                    todo-ban scan every tracked file, crates/ and ui/
#                    included.
#   macos_legs       the second run of those suites under Bash 3.2 and the BSD
#                    userland. Only an executable file can behave differently
#                    there, so a diff of Markdown alone stands them down and
#                    every other diff runs them.
#   ui               the vitest, tsc and biome lane, which reads ui/ alone.
#   bot_instructions the rendered review-bot instruction files.
#   cargo_linux      the workspace tests on Linux. NOT gated on crate paths:
#                    crates/cli/tests/catalog_render_lint.rs installs this
#                    repository's whole catalog and lints the result, so a
#                    change under skills/ reaches this lane with no crate path
#                    in the diff at all.
#   cargo_macos      the same tests on the platform the app ships on, with
#                    cargo_lint and cargo_windows beside them. None of the
#                    three reads the catalog — the macOS catalog lint is the
#                    platform re-run of a lint the Linux lane already did, and
#                    the Windows legs compile that test out under its
#                    `cfg(unix)` — so all three answer to the workspace alone.
#   cargo_lint       clippy, fmt and doc over the workspace.
#   cargo_windows    the Windows compile and test lanes.
#
# "The workspace" is WORKSPACE below: crates/ and every root file a cargo lane
# reads as configuration, the manifest and lockfile, clippy.toml and the
# rust-toolchain.toml that pins the compiler. A root file that configures a
# cargo lane belongs in that pattern; one left out stands those three lanes
# down on the diff that changes them.
#
# A `render` or `trivial` diff runs none of them: the classifier proved the
# first by re-rendering it, and the second is inside the docs path set and its
# line ceiling. A diff `harness-only --mode docs` accepts, whatever its size
# and so whatever its class, runs only bot_instructions: that lane's check
# reads the root AGENTS.md the docs set admits, and nothing else here reads
# docs/, changelog.d/ or root Markdown.
#
# Every refusal starts `ci-job-set: cause=<name>` and exits 2. A class this
# table does not name is one of those: the step goes red, every lane's status
# function runs it, and the required contexts refuse the skip, which is the
# loud way to learn a sixth class shipped.
set -euo pipefail

# One line per lane, in the order the rows below spell them.
LANES="shell_shards macos_legs ui bot_instructions cargo_linux cargo_macos cargo_lint cargo_windows"

die() { # CAUSE MESSAGE
  printf 'ci-job-set: cause=%s\n' "$1" >&2
  printf 'ci-job-set: %s\n' "$2" >&2
  exit 2
}

[ -n "${CHANGE_CLASS:-}" ] || die missing-class "CHANGE_CLASS is required"
[ -n "${GITHUB_OUTPUT:-}" ] || die missing-output-file \
  "GITHUB_OUTPUT is unset, so no lane could read the selection"

case "${DOCS_ONLY:-}" in
  true | false) ;;
  *) die "invalid-docs-only value=${DOCS_ONLY:-}" "DOCS_ONLY is true or false" ;;
esac

# Present-but-empty is a state of its own, and not the same as absent.
paths="${CHANGED_PATHS-__unset__}"
[ "$paths" != __unset__ ] || die missing-paths "CHANGED_PATHS is required"

# A row names every lane or ends the step, before any lane has read a
# selection with one lane missing from it.
emit() { # LANE=VALUE ...
  local lane given=" $* "
  for lane in $LANES; do
    case "$given" in
      *" $lane="*) ;;
      *) die "lane-unselected lane=$lane" "the row declares no value for this lane" ;;
    esac
  done
  printf '%s\n' "$@" >>"$GITHUB_OUTPUT"
  printf '%s\n' "$@" >&2
}

# `grep -c` exits 1 when nothing matched, which errexit would read as a broken
# command; the count is the answer either way.
any() { # REGEX — is some changed path inside it?
  local hits
  hits="$(printf '%s\n' "$paths" | grep -Ec -- "$1")" || hits=0
  [ "$hits" -gt 0 ]
}
any_outside() { # REGEX — is some changed path NOT inside it?
  local hits
  hits="$(printf '%s\n' "$paths" | grep -Evc -- "$1")" || hits=0
  [ "$hits" -gt 0 ]
}

# The workspace, which is what the three cargo lanes below answer to.
WORKSPACE='^(crates/|Cargo\.toml$|Cargo\.lock$|clippy\.toml$|rust-toolchain\.toml$)'
# Prose. Nothing a shell or a compiler runs differently on another platform.
PROSE='\.(md|markdown)$'

case "$CHANGE_CLASS" in
  render | trivial)
    emit shell_shards=false macos_legs=false ui=false bot_instructions=false \
      cargo_linux=false cargo_macos=false cargo_lint=false cargo_windows=false
    ;;
  micro | small | standard)
    if [ "$DOCS_ONLY" = true ]; then
      emit shell_shards=false macos_legs=false ui=false bot_instructions=true \
        cargo_linux=false cargo_macos=false cargo_lint=false cargo_windows=false
    elif [ "$CHANGE_CLASS" = standard ]; then
      emit shell_shards=true macos_legs=true ui=true bot_instructions=true \
        cargo_linux=true cargo_macos=true cargo_lint=true cargo_windows=true
    else
      # A measured class is reached only after the classifier read a changed
      # path, so an empty list here is a state no classifier emits. Reading it
      # as "nothing matches" would stand every gated lane down on no evidence.
      [ -n "$paths" ] || die "class-without-paths class=$CHANGE_CLASS" \
        "a measured class arrived with no changed path"
      platform=false
      any_outside "$PROSE" && platform=true
      workspace=false
      any "$WORKSPACE" && workspace=true
      uitree=false
      any '^ui/' && uitree=true
      emit shell_shards=true "macos_legs=$platform" "ui=$uitree" \
        bot_instructions=true cargo_linux=true "cargo_macos=$workspace" \
        "cargo_lint=$workspace" "cargo_windows=$workspace"
    fi
    ;;
  *)
    die "unknown-class class=$CHANGE_CLASS" \
      "no lane selection is declared for this class"
    ;;
esac
