#!/usr/bin/env bash
# The repo's own commit-message rules, run after the growth-guards commit-msg
# shim: that shim judges the conventional-commit header, this judges the
# subject's length and the changelog. Only a commit-msg hook sees the subject,
# so neither rule can live in the pre-commit lane.
#
# Which line is the header, and which headers git wrote itself, are the
# package's answers. They are read from its library rather than decided a
# second time here, so the two lanes cannot come to judge different lines.
#
# Exit codes follow the guard family: 0 clean, 1 violation, 2 could not run.
set -uo pipefail

[ $# -ge 1 ] && [ -r "$1" ] || {
  echo "commit-msg: no readable message file — the rules could not run"
  exit 2
}
# Read before moving: git passes .git/COMMIT_EDITMSG relative to where it ran.
MSG="$(cat -- "$1")" || {
  echo "commit-msg: could not read the commit message file: $1 — the rules could not run"
  exit 2
}
ROOT="$(git rev-parse --show-toplevel)" || {
  echo "commit-msg: not inside a git work tree — the rules could not run"
  exit 2
}
cd "$ROOT" || {
  echo "commit-msg: could not enter $ROOT — the rules could not run"
  exit 2
}

HEADER_LIB=.agents/skills/growth-guards/scripts/lib/commit-header.sh
[ -r "$HEADER_LIB" ] || {
  echo "commit-msg: $HEADER_LIB is missing — the header rules could not run; reinstall the growth-guards skill"
  exit 2
}
# shellcheck source=../.agents/skills/growth-guards/scripts/lib/commit-header.sh
source "$HEADER_LIB" || {
  echo "commit-msg: could not load $HEADER_LIB — the header rules could not run"
  exit 2
}
# The library sets errexit, as its siblings in that package do. This script
# aggregates instead: both rules report before the verdict, so the first
# violation must not end the run.
set +e

staged=$(git diff --cached --name-only) || {
  echo "commit-msg: could not read the staged file list — the changelog rule could not run"
  exit 2
}
# Deleting a fragment is not writing one, and the staged list does not say
# which it was. Evidence of an entry comes from the additions and
# modifications alone.
written=$(git diff --cached --name-only --diff-filter=AM) || {
  echo "commit-msg: could not read the staged additions — the changelog rule could not run"
  exit 2
}
gg_commit_header "$MSG"
subject="$GG_COMMIT_HEADER"

fail=0
say() {
  echo "commit-msg: $1"
  fail=1
}

# A subject past 72 characters is a body sentence on the wrong line. The
# headers git writes are exempt because nobody sized them, and which ones
# those are is the package's list.
gg_git_generated_header "$subject" ||
  [ "${#subject}" -le 72 ] ||
  say "subject is ${#subject} characters (max 72) — move the detail into the body"

# Code changes ship with a changelog entry: a changelog.d fragment, or
# CHANGELOG.md itself on the release commit that collates them.
# [no-changelog] is the escape hatch for pure refactors. Which section names
# are real and what a fragment must contain are tools/guard's judgment, run
# in the same commit chain; a path inside some section directory is all this
# lane needs to see.
if echo "$staged" | grep -qE '^(crates|ui)/' &&
  ! echo "$written" | grep -qE '^(CHANGELOG\.md|changelog\.d/[^/]+/[^/]+\.md)$' &&
  ! printf '%s' "$subject" | grep -qF '[no-changelog]'; then
  say "crates/ or ui/ changed without a changelog entry — add changelog.d/<section>/<name>.md or put [no-changelog] in the subject"
fi

exit $fail
