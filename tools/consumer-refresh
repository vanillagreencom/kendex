#!/usr/bin/env python3
"""Collect committed refresh inputs, or replay them without platform credentials.

The gate prints consumer-refresh=pass|baseline-failure|regression per repository.
consumer-snapshot=absent is bootstrap only; it never reports a consumer pass.
The refresh runner owns refresh/adoption/verify. The existing gh fixture owns
API parsing. Git publication goes to a disposable bare repository only.
"""
import argparse
import base64
import gzip
import json
import io
import os
from pathlib import Path, PurePosixPath
import re
import shutil
import subprocess
import sys
import tarfile
import tempfile
import tomllib

ROOT = Path(__file__).resolve().parent.parent
REQUIRED = ("kendex.toml", "kendex.settings.toml", ".kendex-lock.json",
            ".kendex-generated.json", ".github/workflows/kendex-refresh.yml",
            ".agents/skills/review-gate/scripts/refresh-consumer.sh")


def refuse(key, value):
    """Fail with a stable record, including the input the gate cannot judge."""
    raise RuntimeError(f"consumer-refresh-error={key} value={value}")


def command(*args, cwd=None, env=None):
    """Run a checked platform or Git operation; retain its actual diagnostic."""
    return subprocess.check_output(args, cwd=cwd, env=env, stderr=subprocess.PIPE)


def repos(path):
    """Read the measured current-consumer inventory, never an empty fleet."""
    names = path.read_text().splitlines()
    if not names or len(names) != len(set(names)) or any(
            not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", n) for n in names):
        refuse("inventory", path)
    return names


def relative(name):
    """Snapshot paths must stay inside their consumer checkout."""
    path = PurePosixPath(name)
    if not name or path.is_absolute() or ".." in path.parts or ".git" in path.parts:
        refuse("path", name)
    return path


def inputs(files):
    """Derive required committed paths from the consumer's own install inventory."""
    for name in REQUIRED:
        if name not in files:
            refuse("input-missing", name)
    manifest = tomllib.loads(base64.b64decode(files["kendex.toml"]["data"]).decode())
    inventory = json.loads(base64.b64decode(files[".kendex-generated.json"]["data"]))
    if not isinstance(inventory, list):
        refuse("generated-inventory", "not-array")
    wanted = set(REQUIRED)
    # source::inplace_source_root gives project declarations the shared .agents
    # tree. generated_paths excludes its authored files from the render inventory.
    for name, skill in manifest.get("skills", {}).items():
        if skill.get("source") == "in-place":
            entry = f".agents/skills/{name}/SKILL.md"
            relative(entry)
            if entry not in files:
                refuse("input-missing", entry)
            wanted.add(str(PurePosixPath(entry).parent))
    for entry in inventory:
        name = entry if isinstance(entry, str) else entry["path"]
        relative(name)
        wanted.add(name)
        if not any(p == name or p.startswith(name + "/") for p in files):
            refuse("input-missing", name)
    for source in manifest.get("sources", {}).values():
        if "path" in source:
            name = source["path"].removeprefix("./")
            relative(name)
            wanted.add(name)
            if not any(p == name or p.startswith(name + "/") for p in files):
                refuse("input-missing", name)
        elif source.get("repo") not in ("vanillagreencom/kendex",
                "https://github.com/vanillagreencom/kendex.git"):
            # A secret-free replay cannot reconstruct a second private catalog.
            refuse("source-unavailable", source.get("repo"))
    wanted.add(".kendex-local")
    for name in (".gitignore", ".gitattributes", ".kendex/settings.toml"):
        if name in files:
            wanted.add(name)
    return wanted


def collect(args):
    """Read GitHub's committed blobs and environment metadata, never consumer code."""
    result = {"schema": 1, "consumers": {}}
    for name in repos(args.inventory):
        repo = "vanillagreencom/" + name
        try:
            api = lambda endpoint: json.loads(command("gh", "api", endpoint))
            metadata = api("repos/" + repo)
            branch = metadata["default_branch"]
            commit = api(f"repos/{repo}/commits/{branch}")
            tree = api(f"repos/{repo}/git/trees/{commit['sha']}?recursive=1")
            if tree["truncated"]:
                refuse("tree-truncated", repo)
            tree_files = {e["path"]: e for e in tree["tree"] if e["type"] != "tree"}
            files = {}
            # GitHub's archive endpoint transfers the committed bytes in one
            # read. Per-blob HTTP requests would exceed the App token lifetime
            # on the installed skill trees. Inspect members, never extract code.
            archive = tarfile.open(fileobj=io.BytesIO(command(
                "gh", "api", f"repos/{repo}/tarball/{commit['sha']}")), mode="r:gz")
            members = {m.name.partition("/")[2]: m for m in archive.getmembers()}

            def blob(path):
                if path not in tree_files:
                    refuse("input-missing", f"{repo}/{path}")
                entry = tree_files[path]
                if entry["type"] != "blob":
                    refuse("submodule", f"{repo}/{path}")
                if path not in members:
                    refuse("archive-input", f"{repo}/{path}")
                member = members[path]
                if member.issym() and entry["mode"] == "120000":
                    content = member.linkname.encode()
                elif member.isfile() and entry["mode"] in ("100644", "100755"):
                    with archive.extractfile(member) as stream:
                        content = stream.read()
                else:
                    refuse("archive-mode", f"{repo}/{path}")
                return {"mode": entry["mode"], "data": base64.b64encode(content).decode()}

            for path in REQUIRED:
                files[path] = blob(path)
            # Discovery uses the complete committed tree. The gate validates the
            # selected inventory again before replay; neither accepts partial input.
            discovery = dict.fromkeys(tree_files, {"mode": "100644", "data": ""})
            discovery.update(files)
            wanted = inputs(discovery)
            selected = {p for p in tree_files if any(p == w or p.startswith(w + "/") for w in wanted)}
            for path in sorted(selected):
                files[path] = blob(path) if path not in files else files[path]
            # Internal symlink targets are committed input too. Never follow a
            # link on the collector's disk or include a file outside the repo.
            pending = list(files)
            while pending:
                path = pending.pop()
                if files[path]["mode"] == "120000":
                    target = os.path.normpath(str(PurePosixPath(path).parent /
                             base64.b64decode(files[path]["data"]).decode()))
                    relative(target)
                    targets = [p for p in tree_files if p == target or p.startswith(target + "/")]
                    if not targets:
                        refuse("link-target", f"{repo}/{path}")
                    for p in targets:
                        if p not in files:
                            files[p] = blob(p)
                            pending.append(p)
            archive.close()
            platform = {"repository": metadata}
            for key, endpoint in (
                    ("environments", "environments"),
                    ("branch-policies", "environments/kendex/deployment-branch-policies"),
                    ("environment-secrets-kendex", "environments/kendex/secrets")):
                # gh's documented pagination completes every platform collection.
                pages = json.loads(command("gh", "api", "--paginate", "--slurp", f"repos/{repo}/{endpoint}"))
                merged = pages[0]
                for page in pages[1:]:
                    for field, value in page.items():
                        if isinstance(value, list):
                            merged[field].extend(value)
                platform[key] = merged
            result["consumers"][name] = {"commit": commit["sha"], "committed_at": commit["commit"]["committer"]["date"],
                                        "platform": platform, "files": files}
            print(f"consumer-collected={repo} commit={commit['sha']}")
        except Exception as error:
            diagnostic = str(error)
            if isinstance(error, subprocess.CalledProcessError) and error.stderr:
                diagnostic += "\n" + error.stderr.decode(errors="replace")
            raise RuntimeError(f"consumer-refresh-error=collect value={repo}\n{diagnostic}") from error
    # No timestamp or gzip filename churn when all committed inputs are unchanged.
    args.output.write_bytes(gzip.compress(json.dumps(result, sort_keys=True).encode(), mtime=0))


def restore(files, root):
    """Restore only safe committed file modes; links cannot escape the sandbox."""
    links = {name for name, entry in files.items() if entry["mode"] == "120000"}
    for name in files:
        path = relative(name)
        if any(str(parent) in links for parent in path.parents):
            refuse("link-parent", name)
    for name, entry in files.items():
        path = root / relative(name)
        path.parent.mkdir(parents=True, exist_ok=True)
        data = base64.b64decode(entry["data"], validate=False)
        match entry["mode"]:
            case "100644" | "100755":
                path.write_bytes(data)
                path.chmod(int(entry["mode"], 8) & 0o777)
            case "120000":
                target = os.path.normpath(str(PurePosixPath(name).parent / data.decode()))
                relative(target)
                path.symlink_to(data.decode())
            case _:
                refuse("file-mode", entry["mode"])
    for name in files:
        path = root / name
        if not path.resolve().is_relative_to(root) or not path.exists():
            refuse("link-target", name)


def api_replay(arguments):
    """Replace only publication/auth calls; delegate read filters to the shared fixture."""
    repo = os.environ["GH_REPO"]
    joined = " ".join(arguments)
    if joined == f"api repos/{repo} --jq .default_branch":
        metadata = json.loads((Path(os.environ["GH_SHIM_FIXTURES"]) / "repository.json").read_text())
        print(metadata["default_branch"])
    elif joined.startswith("api --paginate ") and "/pulls?" in joined:
        print("")
    elif joined.startswith("api users/"):
        print("1")
    elif joined.startswith("api --method POST ") and "/pulls " in joined:
        print("1")
    elif arguments[:2] in (["auth", "setup-git"], ["pr", "merge"], ["pr", "close"]):
        pass
    else:
        os.execv(os.environ["CONSUMER_GH_FIXTURE"], ["gh", *arguments])


def replay(snapshot, catalog, binary, scratch):
    """Run the committed runner with a local catalog and disposable Git publication."""
    consumer = scratch / "consumer"
    consumer.mkdir()
    restore(snapshot["files"], consumer)
    inputs(snapshot["files"])
    home = scratch / "home"
    home.mkdir()
    env = {"PATH": os.environ["PATH"], "HOME": str(home), "GIT_CONFIG_NOSYSTEM": "1",
           "GIT_CONFIG_GLOBAL": str(home / ".gitconfig"), "GIT_TERMINAL_PROMPT": "0",
           "KENDEX_REAL_HOME": "1", "KENDEX_BACKGROUND_REFRESH": "off", "KENDEX_UI": "plain",
           "KENDEX_GIT_BASE": (scratch / "catalogs").as_uri(),
           "XDG_CONFIG_HOME": str(home / ".config"), "XDG_CACHE_HOME": str(home / ".cache"),
           "XDG_DATA_HOME": str(home / ".local/share")}
    git = lambda *a, cwd=consumer: command("git", *a, cwd=cwd, env=env)
    # A bare receive-pack can start maintenance after push. Keep automatic
    # maintenance in the foreground until the scratch owner's cleanup.
    for key in ("gc.autoDetach", "maintenance.autoDetach"):
        git("config", "--global", key, "false")
    branch = snapshot["platform"]["repository"]["default_branch"]
    git("init", "-q", "-b", branch)
    for key, value in (("user.name", "consumer-refresh"), ("user.email", "refresh@example.invalid"),
                       ("core.hooksPath", "/dev/null"), ("gc.auto", "0"), ("maintenance.auto", "false")):
        git("config", key, value)
    git("add", "-f", ".")
    git("commit", "-qm", "committed consumer inputs")
    remote = scratch / "remote.git"
    git("clone", "--bare", "-q", str(consumer), str(remote))
    git("remote", "add", "origin", str(remote))
    preserved = scratch / "preserved"
    git("worktree", "add", "--detach", str(preserved), "HEAD")
    local_catalog = scratch / "catalogs/vanillagreencom/kendex"
    local_catalog.parent.mkdir(parents=True)
    git("clone", "--bare", "-q", str(catalog), str(local_catalog))
    git("--git-dir", str(local_catalog), "update-ref", "refs/heads/main", "HEAD")
    git("--git-dir", str(local_catalog), "symbolic-ref", "HEAD", "refs/heads/main")
    for url in ("https://github.com/vanillagreencom/kendex.git", "https://github.com/vanillagreencom/kendex"):
        git("config", "--global", "--add", f"url.{local_catalog.as_uri()}.insteadOf", url)
    # Reuse refresh-fixture.sh's data-only transport substitution. Production
    # adoption has no local-history interface; its documented fixture edits only
    # the URL in the disposable preserved adopter, never a decision or a check.
    adopter = preserved / ".agents/skills/review-gate/scripts/adopt-refresh.sh"
    text = adopter.read_text()
    url = "https://github.com/vanillagreencom/kendex.git"
    # Pre-platform adopters (the committed fixtures) use consumer Git history
    # only. Current adopters have one public shipment-history URL to redirect.
    if text.count(url) > 1:
        refuse("adoption-transport", adopter)
    if url in text:
        adopter.write_text(text.replace(url, str(local_catalog)))
    fixture = scratch / "platform"
    fixture.mkdir()
    for name, data in snapshot["platform"].items():
        (fixture / (name + ".json")).write_text(json.dumps(data))
    shim = scratch / "bin"
    shim.mkdir()
    (shim / "kendex").symlink_to(binary)
    (shim / "gh").symlink_to(Path(__file__).resolve())
    env.update(PATH=str(shim) + ":" + env["PATH"], GH_TOKEN="offline-fixture",
               GH_REPO=snapshot["platform"]["repository"]["full_name"], REFRESH_APP_SLUG="offline",
               GH_SHIM_FIXTURES=str(fixture),
               CONSUMER_GH_FIXTURE=str(ROOT / "skills/review-gate/tests/lib/gh-shim.sh"))
    runner = preserved / ".agents/skills/review-gate/scripts/refresh-consumer.sh"
    process = subprocess.run(["bash", str(runner)], cwd=consumer, env=env,
                             stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    output = process.stdout.replace(str(scratch), "<sandbox>")
    return process.returncode, output


def cause(output):
    """Compare the runner's keyed refusals; unknown failures never become success.

    refresh has no JSON failure report. The runner's documented error records
    and the validators' diagnostic records are the available fallback interface.
    Full records include the refused value, not only the adjacent runner status.
    """
    records = tuple(line for line in output.splitlines()
                    if re.match(r"^[a-z][a-z0-9-]*-error=", line))
    # These records carry only a subprocess exit status or a failed read, not
    # the refusal's cause. Equality cannot excuse a different CLI failure.
    if any(line.startswith(("refresh-error=refresh ", "gh-shim-error=")) or
           (line.startswith("refresh-error=read ") and
            line != "refresh-error=read value=class") for line in records):
        return ()
    if "refresh-error=read value=class" in records:
        # change-class owns diagnostic completeness. Retain its full refusal;
        # the runner's read failure alone cannot identify the refused input.
        classes = tuple(line for line in output.splitlines() if line.startswith("class:"))
        if len(classes) != 1 or not classes[0].startswith("class: class=standard measured=false cause="):
            return ()
        return records + classes
    return records


def check(args):
    """Compare independent baseline and candidate replays of the same consumer state."""
    if not os.path.lexists(args.snapshot):
        # lock-record publishes this committed path. Once the baseline carries
        # it, a PR deletion must not reopen fixture-only bootstrap.
        if os.path.lexists(args.baseline / ".github/consumer-snapshots.json.gz"):
            refuse("input-missing", args.snapshot)
        print("consumer-snapshot=absent")
        return
    data = json.loads(gzip.decompress(args.snapshot.read_bytes()))
    names = repos(args.inventory)
    if not isinstance(data, dict) or data.get("schema") != 1 or not isinstance(data.get("consumers"), dict) or set(data["consumers"]) != set(names):
        refuse("snapshot-inventory", args.snapshot)
    binary = args.kendex.resolve(strict=True)
    for name in names:
        inputs(data["consumers"][name]["files"])
    failed = False
    with tempfile.TemporaryDirectory(prefix="consumer-refresh-") as temporary:
        tmp = Path(temporary).resolve()
        for name in names:
            results = []
            for label, catalog in (("baseline", args.baseline), ("candidate", args.catalog)):
                scratch = tmp / name / label
                scratch.mkdir(parents=True)
                results.append(replay(data["consumers"][name], catalog.resolve(), binary, scratch))
            (base_rc, base_out), (rc, out) = results
            if rc == 0:
                verdict = "pass"
            elif base_rc != 0 and cause(out) and cause(out) == cause(base_out):
                verdict = "baseline-failure"
            else:
                verdict = "regression"
                failed = True
            print(f"consumer-refresh={verdict} repository={name} baseline-exit={base_rc} candidate-exit={rc}")
            if rc or base_rc:
                print(f"consumer-log={name}/baseline\n{base_out}")
                print(f"consumer-log={name}/candidate\n{out}")
        if failed:
            refuse("regression", args.snapshot)


def main():
    """Repository collector/gate entry point, also its isolated offline gh adapter."""
    if Path(sys.argv[0]).name == "gh":
        api_replay(sys.argv[1:])
        return
    parser = argparse.ArgumentParser(description=__doc__)
    sub = parser.add_subparsers(dest="verb", required=True)
    collect_parser = sub.add_parser("collect")
    collect_parser.add_argument("--output", type=Path, required=True)
    check_parser = sub.add_parser("check")
    for option in ("snapshot", "baseline", "catalog", "kendex"):
        check_parser.add_argument("--" + option, type=Path, required=True)
    for p in (collect_parser, check_parser):
        p.add_argument("--inventory", type=Path, default=ROOT / ".github/consumer-refresh-repos.txt")
    args = parser.parse_args()
    try:
        match args.verb:
            case "collect": collect(args)
            case "check": check(args)
            case _: raise AssertionError(args.verb)
    except (RuntimeError, OSError, ValueError, KeyError, TypeError, tarfile.TarError,
            subprocess.CalledProcessError) as error:
        print(error if isinstance(error, RuntimeError) else
              f"consumer-refresh-error={args.verb} value={error}", file=sys.stderr)
        if isinstance(error, subprocess.CalledProcessError):
            print(error.stderr.decode(errors="replace"), file=sys.stderr)
        sys.exit(1)


if __name__ == "__main__":
    main()
