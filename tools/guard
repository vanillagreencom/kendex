#!/usr/bin/env bash
# kendex guardrails — deterministic checks, run as the pre-commit hook.
# Checks the working tree, not the staged index — accepted trade-off:
# agents commit whole files; partial staging is out of scope.
set -uo pipefail
cd "$(git rev-parse --show-toplevel)"
fail=0
say() {
  echo "guard: $1"
  fail=1
}

files=$({ git ls-files; git diff --cached --name-only; } | sort -u)

# Over the hard cap, a file is the size-ratchet's to govern once a baseline
# row covers its count: a row already at HEAD, or one this change adds or
# raises under RATCHET_RAISE=1 — merging fragments back into one concept is
# that raise.
frozen() { # PATH LINES
  awk -F'\t' -v p="$1" -v n="$2" '$1 == p && $2 >= n { f = 1 } END { exit !f }' tools/size-ratchet-baseline.tsv 2>/dev/null || return 1
  [ "${RATCHET_RAISE:-}" = "1" ] ||
    git show HEAD:tools/size-ratchet-baseline.tsv 2>/dev/null | awk -F'\t' -v p="$1" '$1 == p { f = 1 } END { exit !f }'
}

while IFS= read -r f; do
  [ -f "$f" ] || continue

  # Size ceiling: no binary/asset bloat (lockfiles exempt).
  case "$f" in
    *.lock | package-lock.json) : ;;
    agents/* | skills/* | hooks/* | pi-extensions/* | skill-templates/*) : ;; # catalog content, not app source
    docs/img/*) : ;; # README screenshots and the tour gif
    *) [ "$(wc -c <"$f")" -gt 204800 ] &&
      say "$f is over 200 KB — assets and binaries don't belong here" ;;
  esac

  # Line caps: split files before they exceed these. Binary assets are
  # governed by the size ceiling above, not by line counts.
  case "$f" in
    *.md | *.lock | *.json | *.svg | *.png | *.ico | *.icns) continue ;;
    agents/* | skills/* | hooks/* | pi-extensions/* | skill-templates/*) continue ;; # catalog content
    docs/img/*) continue ;; # binary images
    ui/src/components/ui/* | ui/src/bindings.ts) continue ;; # generated: shadcn, tauri-specta
    kendex-local.toml) continue ;; # kendex writes it, one table per declared item — the CLI owns its shape, so it cannot be split
    .github/workflows/*) continue ;; # declarative pipelines, one file per workflow by GitHub's contract — a workflow cannot be split without severing its jobs
    *.rs) cap=400 ;;
    *.ts | *.tsx) cap=250 ;;
    *) cap=400 ;;
  esac
  lines=$(wc -l <"$f")
  [ "$lines" -gt "$cap" ] || continue
  frozen "$f" "$lines" && continue
  say "$f is $lines lines (cap $cap) — split at a concept seam the reader never crosses back over; never shatter one concept to duck the count. Fragments merged back into one concept are a raise: RATCHET_RAISE=1 with the file's row in tools/size-ratchet-baseline.tsv"
done <<<"$files"

# Content rules over hand-written source. Usage: scan <grep-ERE> [path-ERE]
scan() {
  local pat=$1 filter=${2:-.} f
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    case "$f" in
      tools/* | ui/src/components/ui/* | ui/src/bindings.ts) continue ;;
      agents/* | skills/* | hooks/* | pi-extensions/* | skill-templates/*) continue ;; # catalog content
      *.md | *.lock | *.json | *.svg) continue ;;
    esac
    [[ "$f" =~ $filter ]] || continue
    grep -nHE "$pat" "$f" || true
  done <<<"$files"
}

# Instruction markdown is directive: no dates, no history, no rationale.
# A rule that needs a paragraph is a missing script, not copy to keep.
prose_files=$(printf '%s\n' "$files" | grep -E '^(AGENTS\.md|agents/.+\.md|skills/.+\.md|docs/.+\.md)$' |
  grep -vE '^skills/iced-rs/references/|^skills/[^/]+/(schemas|templates)/|/(CHANGELOG|README|DEVELOPMENT)\.md$|^docs/decisions/')
prose_hist='20[0-9]{2}-[0-9]{2}-[0-9]{2}|\<(previously|used to|no longer|reverted|an earlier|earlier round|incident|historically|originally|at the time)\>|#[0-9]{3,4}\>'
prose_why='\<(because|so that|rationale)\>'
# grep exit 1 is "no match"; anything higher is an unreadable file, which is a refusal, not a pass.
prose_hits() {
  local out status
  out=$(grep -nEi "$1" "$2")
  status=$?
  [ "$status" -le 1 ] || return 1
  printf '%s' "$out"
}
while IFS= read -r f; do
  [ -f "$f" ] || continue
  hits=$(prose_hits "$prose_hist" "$f") || { say "$f is unreadable — the prose check could not run"; continue; }
  case "$f" in docs/*) : ;; *) more=$(prose_hits "$prose_why" "$f") || { say "$f is unreadable — the prose check could not run"; continue; }
    hits+=$(printf '\n%s' "$(printf '%s' "$more" | grep -vE '["`]rationale["`]')") ;; esac # a quoted key is a schema field, not prose
  hits=$(printf '%s' "$hits" | sed '/^$/d')
  [ -n "$hits" ] && say "$f carries history or rationale — state the rule, delete the story:
$(printf '%s\n' "$hits" | head -5 | sed 's/^/  /')"
done <<<"$prose_files"

# The size-ratchet baseline only tightens. Raising a row is a decision, not
# a remedy: RATCHET_RAISE=1 on the commit says so out loud.
if [ "${RATCHET_RAISE:-}" != "1" ] && git cat-file -e HEAD:tools/size-ratchet-baseline.tsv 2>/dev/null; then
  raised=$({ join -t "$(printf '\t')" <(git show HEAD:tools/size-ratchet-baseline.tsv | sort) <(sort tools/size-ratchet-baseline.tsv) |
    awk -F'\t' '$3 > $2 { print "  " $1 ": " $2 " -> " $3 }';
    comm -13 <(git show HEAD:tools/size-ratchet-baseline.tsv | cut -f1 | sort) <(cut -f1 tools/size-ratchet-baseline.tsv | sort) |
    sed 's/^/  new row: /'; })
  [ -n "$raised" ] && say "size-ratchet baseline rows went up — split at a seam; RATCHET_RAISE=1 only when the new lines are the fix with no seam, or fragments of one concept merged back into one file:
$raised"
fi

# The commit-guard implementation bans the marker shapes below, so it must
# name them — in its patterns, its messages, and its fixtures. Only these
# shape scans skip it; every other rule still applies there.
guard_impl='^crates/core/src/guard/|^crates/cli/src/commands/guard_cmd\.rs|^crates/(core|cli)/tests/guard_'

hits=$(scan 'TODO|FIXME|HACK' | grep -vE "$guard_impl")
[ -n "$hits" ] && {
  echo "$hits" | head -5
  say "unfinished-work markers — finish it now or record it outside code"
}

hits=$(scan '#!\[allow' | grep -vE "$guard_impl")
[ -n "$hits" ] && {
  echo "$hits"
  say "module-wide #![allow] — fix the lint instead of silencing the file"
}

hits=$(scan 'allow\((dead_code|unused)' | grep -vE "$guard_impl")
[ -n "$hits" ] && {
  echo "$hits"
  say "allow(dead_code/unused) — delete the code instead of keeping it warm"
}

# Every module that reads a catalog's own bytes is listed, so a raw read of a
# catalog path is caught wherever it is added. source/browse/safety.rs is not
# here on purpose: its one fs read is of kendex's own cache record under the
# store, never a catalog path, and adding it would flag that legitimate read.
# The plain Homebrew name must resolve to the cask (the app): brew checks
# formulas first, so a formula claiming `kendex` silently flips the default
# install back to CLI-only.
hits=$(scan 'class Kendex < Formula' '^packaging/homebrew/')
[ -n "$hits" ] && {
  echo "$hits"
  say "a Homebrew formula claims the plain kendex name — the cask owns it; name the formula KendexCli"
}

hits=$(scan 'std::fs::read|crate::fs::read' '^crates/core/src/(source\.rs|check_catalog\.rs|library\.rs|source/(about|browse|bundles|catalog|config|discover|index|meta|plugin_registry)\.rs|source/browse/preview\.rs|render/skill\.rs|engine/(desired|ops))|^crates/app/src/editor\.rs')
[ -n "$hits" ] && {
  echo "$hits" | head -5
  say "raw filesystem read over catalog paths — go through source_read::SealedSource"
}

hits=$(scan '@tauri-apps/' '^ui/src/')
[ -n "$hits" ] && {
  echo "$hits"
  say "UI reaches Tauri directly — only generated ui/src/bindings.ts may import @tauri-apps"
}

hits=$(scan '#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?\b|rgba?\(|hsla?\(' '^ui/src/.*\.tsx?$')
[ -n "$hits" ] && {
  echo "$hits" | head -5
  say "raw color literal in UI code — use theme tokens; color lives in the stylesheet"
}

# One hardened constructor builds every external process (invariant 13);
# a per-call-site discipline misses call sites. crates/app is out of scope:
# it has two sanctioned raw spawns, neither a hardened tool invocation —
# one Command re-execs this app, replacing the process rather than
# launching a tool, and one launches the user's own GUI editor detached,
# outliving kendex with no output to capture and no timeout that would
# make sense. Integration tests under crates/*/tests run our own binary
# and are likewise not tool launches.
hits=$(scan 'Command::new' '^crates/(core|cli)/src/' | grep -v '^crates/core/src/process/')
[ -n "$hits" ] && {
  echo "$hits" | head -5
  say "raw Command::new — external processes go through process::Hardened"
}

# A command that hands the binary a fixture home must say on the spot that
# the home it gave is the one it means: without that, a debug build sandboxes
# itself and the command drives the dev home instead of the fixture. Checked
# per call site — one compliant builder must not vouch for the rest of a file
# that holds several.
hits=$(grep -rlE '\.env\("HOME"' crates/*/tests 2>/dev/null | while IFS= read -r f; do
  awk -v file="$f" '
    pending && /^[[:space:]]*(\/\/|$)/ { next }
    pending { if ($0 !~ /KENDEX_REAL_HOME/) print file ":" pending; pending = 0 }
    /\.env\("HOME"/ { pending = NR }
    END { if (pending) print file ":" pending }
  ' "$f"
done)
[ -n "$hits" ] && {
  echo "$hits" | head -5
  say 'fixture HOME without KENDEX_REAL_HOME on the next line — that command would run in the dev sandbox'
}

# Structural invariants.
[ "$(readlink .claude/CLAUDE.md 2>/dev/null)" = "../AGENTS.md" ] ||
  say ".claude/CLAUDE.md must be a symlink to ../AGENTS.md"

if [ -f Cargo.toml ] && cargo tree -p kendex-core -e normal 2>/dev/null | grep -qE '\btauri v'; then
  say "crates/core must not depend on tauri"
fi

# Compiler-backed checks, once code exists.
if [ -f Cargo.toml ]; then
  for m in crates/*/Cargo.toml; do
    [ -f "$m" ] || continue
    grep -A1 '^\[lints\]' "$m" | grep -q 'workspace *= *true' ||
      say "$m: missing [lints] workspace = true — workspace lints are not inherited"
  done
  cargo fmt --check || say "cargo fmt --check failed"
  cargo clippy --workspace --quiet -- -D warnings || say "clippy failed"
  cargo doc --no-deps --document-private-items --workspace --quiet || say "cargo doc failed"
  cargo test --workspace --quiet || say "tests failed"
fi
if [ -f ui/package.json ]; then
  (cd ui && npx --no-install tsc --noEmit) || say "tsc failed"
  (cd ui && npx --no-install biome check src) || say "biome failed"
  (cd ui && npx --no-install vitest run --silent) || say "vitest failed"
fi

exit $fail
