#!/usr/bin/env bash
# kendex guardrails — the repo-specific rules, run as the last lane of the
# growth-guards pre-commit chain (GROWTH_GUARDS_PRE_COMMIT_LOCAL). Every rule
# a shipped package already judges is that package's: size-ratchet caps file
# size and gates its own baseline rows, byte-ceiling caps bytes,
# changelog-entries judges the changelog (fragments and the collated record
# alike), todo-ban catches work markers, suppression-ban catches blanket
# allows, conflict-markers catches merge markers, prose keeps history out of
# the markdown agents load. What is here is what none of them ships.
# Checks the working tree, not the staged index — accepted trade-off:
# agents commit whole files; partial staging is out of scope.
set -uo pipefail
# Resolved before the cd below: the sibling tools this script runs live
# beside it, not necessarily in the repository it judges.
TOOLS_DIR="$(cd "$(dirname "$0")" && pwd)" || exit 1
cd "$(git rev-parse --show-toplevel)"
fail=0
say() {
  echo "guard: $1"
  fail=1
}

# The hit lines below are a tracked file's own bytes, and a source file may
# carry an ESC or another C0 control as legitimate content. Printed raw they
# reach a terminal as control codes rather than as the line that broke a rule,
# so every hit goes through here: one line each, every C0 control except tab
# and DEL replaced. The growth-guards library spells this gg_scrubbed; this
# script does not load it, and the rule is small enough to carry itself.
show() { # HITS — the same lines, safe to print
  printf '%s\n' "$1" | LC_ALL=C awk '{ gsub(/[\001-\010\013-\037\177]/, "?"); print }'
}

files=$({ git ls-files; git diff --cached --name-only; } | sort -u)

# Content rules over hand-written source. Every caller names the tree it
# means, so the only blanket skips left are the generated files inside those
# trees. Usage: scan <grep-ERE> <path-ERE>
scan() {
  local pat=$1 filter=$2 f
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    case "$f" in
      ui/src/components/ui/* | ui/src/bindings.ts) continue ;; # generated: shadcn, tauri-specta
    esac
    [[ "$f" =~ $filter ]] || continue
    grep -nHE "$pat" "$f" || true
  done <<<"$files"
}

# Paths where a raw filesystem read would be a read of catalog content, so
# one added there is caught. The alternation below is what the rule covers
# and the whole of it — chosen, not exhaustive, and not every module that
# reads a catalog: author/import does and is not here, and neither is every
# file under source/. Widening it is a judgement each time, because a module
# whose fs reads are of kendex's own store rather than of a catalog would be
# flagged for a legitimate read.
# The plain Homebrew name must resolve to the cask (the app): brew checks
# formulas first, so a formula claiming `kendex` silently flips the default
# install back to CLI-only.
hits=$(scan 'class Kendex < Formula' '^packaging/homebrew/')
[ -n "$hits" ] && {
  show "$hits"
  say "a Homebrew formula claims the plain kendex name — the cask owns it; name the formula KendexCli"
}

hits=$(scan 'std::fs::read|crate::fs::read' '^crates/core/src/(source\.rs|check_catalog\.rs|library\.rs|source/(about|browse|bundles|catalog|config|discover|index|layout|meta|plugin_registry|slot)\.rs|source/browse/preview\.rs|render/skill\.rs|engine/(desired|ops))|^crates/app/src/editor\.rs')
[ -n "$hits" ] && {
  show "$hits" | head -5
  say "raw filesystem read over catalog paths — go through source_read::SealedSource"
}

hits=$(scan '@tauri-apps/' '^ui/src/')
[ -n "$hits" ] && {
  show "$hits"
  say "UI reaches Tauri directly — only generated ui/src/bindings.ts may import @tauri-apps"
}

hits=$(scan '#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?\b|rgba?\(|hsla?\(' '^ui/src/.*\.tsx?$')
[ -n "$hits" ] && {
  show "$hits" | head -5
  say "raw color literal in UI code — use theme tokens; color lives in the stylesheet"
}

# One hardened constructor builds every external process (invariant 13);
# a per-call-site discipline misses call sites. crates/app is out of scope:
# it has two sanctioned raw spawns, neither a hardened tool invocation —
# one Command re-execs this app, replacing the process rather than
# launching a tool, and one launches the user's own GUI editor detached,
# outliving kendex with no output to capture and no timeout that would
# make sense. Integration tests under crates/*/tests run our own binary
# and are likewise not tool launches.
hits=$(scan 'Command::new' '^crates/(core|cli)/src/' | grep -v '^crates/core/src/process/')
[ -n "$hits" ] && {
  show "$hits" | head -5
  say "raw Command::new — external processes go through process::Hardened"
}

# A command that hands the binary a fixture home must say on the spot that
# the home it gave is the one it means: without that, a debug build sandboxes
# itself and the command drives the dev home instead of the fixture. Checked
# per call site — one compliant builder must not vouch for the rest of a file
# that holds several.
hits=$(grep -rlE '\.env\("HOME"' crates/*/tests 2>/dev/null | while IFS= read -r f; do
  awk -v file="$f" '
    pending && /^[[:space:]]*(\/\/|$)/ { next }
    pending { if ($0 !~ /KENDEX_REAL_HOME/) print file ":" pending; pending = 0 }
    /\.env\("HOME"/ { pending = NR }
    END { if (pending) print file ":" pending }
  ' "$f"
done)
[ -n "$hits" ] && {
  show "$hits" | head -5
  say 'fixture HOME without KENDEX_REAL_HOME on the next line — that command would run in the dev sandbox'
}

# What the diff-scoped rules below diff against: HEAD, or on an unborn
# branch the index against nothing, so the first commit is judged too.
if git cat-file -e 'HEAD^{commit}' 2>/dev/null; then
  diff_against=(HEAD)
else
  diff_against=(--cached)
fi

# New integration-test temp roots take their canonical spelling immediately
# through the shared rooted() helper. Older fixtures stay out of this
# diff-scoped rule.
temp_fixture_diff=$(git diff --no-color --unified=100000 --no-ext-diff --text "${diff_against[@]}" -- 'crates/*/tests/*.rs') ||
  say "test fixture changes could not be read"
if ! temp_fixture_hits=$(awk '
  function flush() {
    if (pending != "") print file ":" pending_line ": " pending_text
    pending = ""
  }
  /^diff --git / {
    flush()
    for (name in guarded) delete guarded[name]
    file = $4
    sub(/^b\//, "", file)
    next
  }
  /^@@ / {
    flush()
    spec = $3
    sub(/^\+/, "", spec)
    split(spec, at, ",")
    new_line = at[1] - 1
    next
  }
  /^--- / || /^\+\+\+ / { next }
  /^[ +]/ {
    prefix = substr($0, 1, 1)
    line = substr($0, 2)
    new_line++
    if (pending != "") {
      if (line ~ /^[[:space:]]*$/ || line ~ /^[[:space:]]*\/\//) next
      rooted = "^[[:space:]]*let[[:space:]]+[A-Za-z][A-Za-z0-9_]*([[:space:]]*:[^=]+)?[[:space:]]*=[[:space:]]*&?[[:space:]]*rooted[[:space:]]*\\([[:space:]]*&[[:space:]]*" pending "[[:space:]]*\\)"
      if (line !~ rooted) {
        print file ":" pending_line ": " pending_text
      } else {
        guarded[pending] = 1
      }
      pending = ""
    }
    if (prefix == "+") {
      for (name in guarded) {
        raw = "(^|[^A-Za-z0-9_])" name "[[:space:]]*\\.(path|as_ref|into_path|keep)[[:space:]]*\\("
        if (line ~ raw) print file ":" new_line ": " line
      }
    }
    if (prefix == "+" && line ~ /^[[:space:]]*let[[:space:]]+(mut[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*([[:space:]]*:[^=]+)?[[:space:]]*=[[:space:]]*(tempfile::tempdir\(\)|(tempfile::)?TempDir::new\(\))/) {
      declaration = line
      sub(/^[[:space:]]*let[[:space:]]+/, "", declaration)
      sub(/^mut[[:space:]]+/, "", declaration)
      sub(/([[:space:]]*:[^=]+)?[[:space:]]*=.*/, "", declaration)
      pending = declaration
      pending_line = new_line
      pending_text = line
    }
    next
  }
  /^-/ { next }
  { flush() }
  END { flush() }
' <<<"$temp_fixture_diff"); then
  say "temporary fixture declarations could not be checked"
fi
[ -n "$temp_fixture_hits" ] && {
  show "$temp_fixture_hits" | head -5
  say 'temporary fixture bypasses rooted(): import crates/test_util.rs and bind the canonical root on the next source line'
}

# Bash 3.2 portability over the skill tree. The roster and the pattern set
# are the lint's own; exit 1 is a construct, exit 2 a scan that could not
# run, and neither is a pass. One line on purpose: the must-fail control in
# tools/tests/guard.test.sh removes this lane by deleting it.
"$TOOLS_DIR/bash32-lint" || say "tools/bash32-lint refused the tree — a Bash 4+ construct, or a scan that could not run"

# A render source lands its renders in the same change: skills/<x>/<p>
# renders to .agents/skills/<x>/<p>, and an agent definition to one file per
# harness. Presence, not byte equality — a render can carry an injected block
# the source has no copy of, so bytes cannot be compared. Rendered is judged
# at the tree: a skill with anything tracked under .agents/skills/<x> renders
# every file, so a new source there owes a new render, and an agent owes a
# file to each harness directory that tracks any. A skill with no tracked
# render has nothing to land, and a render-only change is the sync direction
# and passes. A deletion is in the changed set too, so the render must also
# still exist wherever its source does. Path quoting is off on both reads:
# a quoted path matches neither the case arms nor its own render.
render_changed=$(git -c core.quotePath=false diff --name-only --no-renames "${diff_against[@]}") ||
  { render_changed=""; say "the changed-file set for the render rule could not be read"; }
render_tracked=$(git -c core.quotePath=false ls-files -- .agents/skills .claude/agents .codex/agents .pi/agents) ||
  { render_tracked=""; say "the tracked render set could not be read"; }
render_hits=""
NL='
'
renders_under() { # DIR — anything is tracked under DIR, DIR read literally
  case "$NL$render_tracked$NL" in *"$NL$1/"*) return 0 ;; esac
  return 1
}
require_render() { # SOURCE RENDER — RENDER changes with SOURCE and outlives it
  { grep -Fxq -- "$2" <<<"$render_changed" && { [ ! -e "$1" ] || [ -e "$2" ]; }; } ||
    render_hits="$render_hits$1 -> $2
"
}
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
  skills/*/*)
    x="${f#skills/}"
    x="${x%%/*}"
    renders_under ".agents/skills/$x" && require_render "$f" ".agents/$f"
    ;;
  agents/*.md)
    n="${f#agents/}"
    n="${n%.md}"
    renders_under .claude/agents && require_render "$f" ".claude/agents/$n.md"
    renders_under .codex/agents && require_render "$f" ".codex/agents/$n.toml"
    renders_under .pi/agents && require_render "$f" ".pi/agents/$n.md"
    ;;
  esac
done <<<"$render_changed"
[ -n "$render_hits" ] && {
  show "$render_hits" | head -5
  say "a render source changed without its tracked render — land the render in the same change"
}

# Structural invariants.
[ "$(readlink .claude/CLAUDE.md 2>/dev/null)" = "../AGENTS.md" ] ||
  say ".claude/CLAUDE.md must be a symlink to ../AGENTS.md"

# One reply contract for the review bots, in AGENTS.md § Code Review Rules.
# The orch skill carries a second one on purpose, for working agents, and
# AGENTS.md § Code Review Rules says so in its opening lines.
#
# What is read is the contract bullet WITHIN that section, and neither scope
# holds on its own. The section alone is satisfied by the neighbouring
# do-not-re-raise bullet, which spells `Declined: <reason>` outside the
# contract. The bullet alone is satisfied by a contract moved into some other
# section, while both bot-facing files still send readers to this one. So the
# slice runs from the heading to the next heading at its level or above, and
# the run inside it starts at `- Author replies are` and ends at the next
# bullet or blank line. The exit rule is tested before the start rule, or a
# repeated `## Code Review Rules` heading re-arms the slice instead of ending
# it and a gutted first section passes on the later copy's forms. Each form is
# matched literally inside the run, so a rewrap of the bullet cannot red this
# and the loss of any one form is its own diagnosis. `#<n>` is not a fourth
# form: it is the other spelling of the id inside `Tracked:`, and the merge
# gate accepts either, so a contract written with only the KEN- spelling is
# whole.
#
# An absent file, a file with no such section, and a section with no such
# bullet are each their own diagnosis rather than three missing substrings.
REPLY_FORMS=('Fixed in <sha>' 'Declined: <reason>' 'Tracked: KEN-<n>')
if [ ! -f AGENTS.md ]; then
  say "AGENTS.md is gone — it holds the one copy of the reply contract the bot-facing files point at"
elif ! grep -q '^## Code Review Rules$' AGENTS.md; then
  say "AGENTS.md has no § Code Review Rules section — that section is where the bot-facing files send readers for the reply contract"
else
  reply_bullet=$(awk '
    inside && /^##? / { exit }
    /^## Code Review Rules$/ { inside = 1; next }
    inside && /^- Author replies are/ { collecting = 1; print; next }
    collecting && (/^- / || /^[[:space:]]*$/) { exit }
    collecting' AGENTS.md)
  if [ -z "$reply_bullet" ]; then
    say "AGENTS.md § Code Review Rules has no '- Author replies are' bullet — that bullet is the one copy of the reply contract the bot-facing files point at"
  else
    for form in "${REPLY_FORMS[@]}"; do
      grep -qF -- "$form" <<<"$reply_bullet" ||
        say "AGENTS.md § Code Review Rules no longer states the reply form '$form' — the bot-facing files point readers there for it"
    done
  fi
fi

# A bot-facing file points at AGENTS.md for the forms rather than carrying
# them. What is pinned is the two things that identify the pointer, the file
# it names and the section, and not the sentence around them: review-bots.md
# names AGENTS.md in an unrelated line near the top without naming the
# section, so a bare name check passes a file whose whole pointer section has
# been deleted, and a pointer aimed at some other file is not a pointer here
# at all. Leaving the wording free stops a reword from reading as a deletion.
# It is required unconditionally of both files rather than "if the section is
# present", because a check conditioned on the thing it protects passes by
# deleting that thing.
#
# The list is these two and not every bot-facing file. `.github/instructions/`
# holds five more, but each is scoped by an applyTo glob and loads only when a
# PR touches that tree, and none of them carries a reply-contract section:
# they say what to raise under one path, not how to answer a finding. A
# pointer whose presence depended on which files a PR happened to touch would
# be worse than none. tools/tests/guard.test.sh pins that exclusion.
REPLY_POINTER='AGENTS\.md.*§ Code Review Rules'
for f in .github/copilot-instructions.md review-bots.md; do
  if [ ! -f "$f" ]; then
    say "$f is gone — a bot-facing file the reply contract is pointed from; move the pointer before deleting it"
  elif ! grep -qE -- "$REPLY_POINTER" "$f"; then
    say "$f no longer points at AGENTS.md § Code Review Rules for the reply contract — delete nothing here without moving the pointer"
  fi
done

if [ -f Cargo.toml ] && cargo tree -p kendex-core -e normal 2>/dev/null | grep -qE '\btauri v'; then
  say "crates/core must not depend on tauri"
fi

# Compiler-backed checks, once code exists.
if [ -f Cargo.toml ]; then
  for m in crates/*/Cargo.toml; do
    [ -f "$m" ] || continue
    grep -A1 '^\[lints\]' "$m" | grep -q 'workspace *= *true' ||
      say "$m: missing [lints] workspace = true — workspace lints are not inherited"
  done
  # Platforms the release builds that this host does not run. The app crate
  # needs each platform's own C toolchain to build at all; core and CLI are
  # portable Rust, so their tests are what a cross check can reach. A third
  # platform is another entry here.
  cross_targets="aarch64-apple-darwin x86_64-pc-windows-msvc"
  if ! installed_targets=$(rustup target list --installed); then
    say "rustup could not list installed targets: the cross-target checks could not run"
  else
    for cross_target in $cross_targets; do
      if ! grep -Fxq "$cross_target" <<<"$installed_targets"; then
        say "Rust target $cross_target is not installed: run rustup target add $cross_target"
      else
        cargo check -p kendex-core -p kendex-cli --all-targets --target "$cross_target" ||
          say "$cross_target core and CLI test targets failed to compile"
      fi
    done
  fi
  cargo fmt --check || say "cargo fmt --check failed"
  cargo clippy --workspace --quiet -- -D warnings || say "clippy failed"
  cargo doc --no-deps --document-private-items --workspace --quiet || say "cargo doc failed"
  cargo test --workspace --quiet || say "tests failed"
fi
if [ -f ui/package.json ]; then
  (cd ui && npx --no-install tsc --noEmit) || say "tsc failed"
  (cd ui && npx --no-install biome check src) || say "biome failed"
  (cd ui && npx --no-install vitest run --silent) || say "vitest failed"
fi

exit $fail
