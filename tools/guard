#!/usr/bin/env bash
# kendex guardrails — the repo-specific rules, run as the last lane of the
# commit-guards pre-commit chain (COMMIT_GUARDS_PRE_COMMIT_LOCAL). Every rule
# a shipped package already judges is that package's: doc-limits caps document
# bytes, byte-ceiling protects against large files,
# changelog-entries judges changelog fragments, todo-ban catches work markers, suppression-ban catches blanket
# allows, conflict-markers catches merge markers, prose keeps history out of
# the markdown agents load, md-format and md-refs hold that markdown to one
# paragraph per line with live references, and the opt-in comments lane
# judges source comments. What is here is what none of them ships.
# Repository scans read the working tree. Bot instructions use the index at
# commit time so their configuration, doctrine and outputs agree.
# Every finding opens with `guard: <key>=<value>` and explains itself below
# that line; say() and finding_text() hold the shape and the text. A notice,
# a check left unrun on purpose or a probe that could not answer, opens with
# `guard-note: <key>=<value>` from note() and leaves the verdict alone.
#
# The compilers, linters and suites this script runs write their own streams
# and this script forwards them: that passthrough is its own contract and is
# not part of any finding. Each finding still opens with its keyed line, and
# the offending lines a rule collected follow that line rather than precede
# it.
set -uo pipefail
# Resolved before the cd below: the sibling tools this script runs live
# beside it, not necessarily in the repository it judges.
TOOLS_DIR="$(cd "$(dirname "$0")" && pwd)" || exit 1

fail=0
# A finding is one stable first line, `guard: <key>=<value>`: the key names
# the condition and the value is what the reader acts on — a path, a count,
# an exit status, or a short enum. The English follows on later lines, and any
# offending lines the rule collected follow that. finding_text below is the
# only place a key's English lives, so a key has one spelling and one
# definition, and no caller carries message text of its own.
say() { # KEY VALUE
  printf 'guard: %s=%s\n' "$1" "$2"
  finding_text "$1" "$2"
  fail=1
}
note() { # KEY VALUE — the same shape for a notice, which is not a finding
  printf 'guard-note: %s=%s\n' "$1" "$2"
  finding_text "$1" "$2"
}
count_lines() { # TEXT — the non-empty lines in TEXT, a scan finding's value
  printf '%s\n' "$1" | awk 'NF { n++ } END { print n + 0 }'
}
finding_text() { # KEY VALUE — the English for one key, and the whole of it
  case "$1" in
    bot-instructions)
      echo "the bot instruction check refused the working tree; its own report above names each file." ;;
    decision-ids)
      echo "decisions check refused; its own records above say why. An error=id-* record names a decision ID two records share: renumber per the decider skill's workflows/create-decision.md. An error=base-unverified record means the base branch could not be fetched or read, and an error=index-row-invalid record names an INDEX row check could not parse; the reason and guidance follow each." ;;
    homebrew-formula)
      echo "a Homebrew formula claims the plain kendex name — the cask owns it; name the formula KendexCli." ;;
    catalog-fs-read)
      echo "raw filesystem read over catalog paths — go through source_read::SealedSource." ;;
    ui-tauri-import)
      echo "the UI reaches Tauri directly — only generated ui/src/bindings.ts may import @tauri-apps." ;;
    ui-color-literal)
      echo "raw color literal in UI code — use theme tokens; color lives in the stylesheet." ;;
    command-safety-unchecked)
      echo "that source's COMMAND_SAFETY_DENY_PATTERN could not be checked." ;;
    command-safety-lines)
      echo "that source does not carry exactly one COMMAND_SAFETY_DENY_PATTERN line." ;;
    command-safety-unreadable)
      echo "that source's COMMAND_SAFETY_DENY_PATTERN could not be read by the settings loader." ;;
    command-safety-empty)
      echo "that source configures an empty COMMAND_SAFETY_DENY_PATTERN." ;;
    command-safety-not-an-ere)
      echo "that source's COMMAND_SAFETY_DENY_PATTERN is not a readable POSIX ERE." ;;
    command-safety-missed)
      echo "that source's policy no longer refuses a command it documents as refused; the command follows." ;;
    command-safety-over)
      echo "that source's policy now refuses a command it documents as allowed; the command follows." ;;
    ci-correlation-copy)
      echo "a caller carries its own scope_current_run or def bucket/def runid — source skills/github/scripts/lib/ci-run-correlation.sh instead." ;;
    raw-command-new)
      echo "raw Command::new — external processes go through process::Hardened." ;;
    fixture-home)
      echo "fixture HOME without KENDEX_REAL_HOME on the next line — that command would run in the dev sandbox." ;;
    test-scan)
      printf 'the per-file scan behind the %s lane could not run, so its files were not judged.\n' "$2" ;;
    binary-home)
      echo "a launch in a test naming the kendex binary carries no fixture home before it runs — give its builder fixture_env() from crates/test_util.rs, or a HOME with KENDEX_REAL_HOME beside it; a release-profile test run otherwise drives the real machine." ;;
    test-roster)
      echo "tools/test-roster refused the tree — a file or directory under a crate's tests/ that no [[test]] root declares compiles nowhere under autotests = false, or the scan could not run; its own first line above names which." ;;
    fixture-diff)
      echo "the crates/*/tests diff the rooted() rule reads could not be produced." ;;
    fixture-scan)
      echo "the temporary fixture declarations could not be checked." ;;
    unrooted-fixture)
      echo "temporary fixture bypasses rooted(): import crates/test_util.rs and bind the canonical root on the next source line." ;;
    bash32-lint)
      echo "tools/bash32-lint refused the tree — a Bash 4+ construct, or a scan that could not run; its own first line above names which." ;;
    bash32-parse)
      echo "tools/bash32-parse refused the tree — a file that does not parse under Bash 3.2, or a pass that could not run; its own first line above names which." ;;
    render-changed-set)
      echo "the changed-file set for the render rule could not be read." ;;
    render-tracked-set)
      echo "the tracked render set could not be read." ;;
    render-committed-set)
      echo "the committed render set could not be read." ;;
    skill-instruction-config)
      echo "the configured skill instruction keys could not be read." ;;
    missing-skill-instructions)
      echo "a managed skill render is missing the instructions block configured for its source; the render paths follow." ;;
    missing-render)
      echo "a render source changed without its tracked render — land the render in the same change; the pairs follow." ;;
    commit-changes)
      echo "product changes could not be classified, so no compile lane could be scheduled." ;;
    tauri-dependency)
      echo "crates/core must not depend on tauri." ;;
    crate-lints)
      echo "that manifest is missing [lints] workspace = true — workspace lints are not inherited." ;;
    cargo-check)
      printf 'cargo check failed for %s.\n' "$2" ;;
    clippy)
      printf 'cargo clippy failed for %s.\n' "$2" ;;
    cargo-fmt)
      echo "cargo fmt --check refused the workspace." ;;
    cargo-space-setting)
      printf 'the %s setting is unset, is not a positive whole number, or could not be read, so the cargo block did not run.\n' "$2" ;;
    cargo-space-free)
      echo "free space on the volume holding $cargo_target is below the exhaustion floor, so the run would fail at its end."
      echo "Run cargo clean, or free space elsewhere on that volume, for example another checkout's target/." ;;
    cargo-space-start)
      echo "free space plus $cargo_target outside its incremental directories is less than one full run needs."
      echo "Free space on that volume outside $cargo_target, for example another checkout's target/, or remove an incremental directory under it." ;;
    cargo-space-unreadable)
      echo "free space on the cargo target volume could not be read at $2; the cargo block continued because an unreadable probe does not establish exhaustion." ;;
    cargo-target-unreadable)
      echo "the size of the cargo target directory could not be read at $2; the cargo block continued because an unreadable probe does not establish exhaustion." ;;
    cargo-space-end)
      echo 'the cargo target volume ended below the exhaustion floor, so validation fails regardless of the cargo exit codes.' ;;
    cargo-space-end-unreadable)
      echo "free space on the cargo target volume could not be read at $2 after the cargo block, so the exhaustion check did not run and validation fails." ;;
    touched-set)
      echo "the touched-file set for the suite lane could not be read at that step." ;;
    missing-tool)
      printf '%s is required to read a Pi package.json for its test script.\n' "$2" ;;
    missing-peers)
      printf '%s has no node_modules; install its peers as its step in .github/workflows/skill-tests.yml does.\n' "$2" ;;
    suite)
      echo "that suite failed; its own output above names the case." ;;
    cross-doc-setting)
      echo "GUARD_FULL_CROSS_DOC is run or ci, and that value is neither or could not be read; the cross-target checks and cargo doc ran as under run." ;;
    compiled-includes)
      echo "the include_str! and include_bytes! paths under crates/ could not be read, so the cross-target checks and cargo doc ran whatever the branch touched." ;;
    cross-doc-skipped)
      case "$2" in
        ci) echo "GUARD_FULL_CROSS_DOC=ci leaves the cross-target checks and cargo doc to CI." ;;
        no-rust-input) echo "the branch touched no crate, no workspace compiler input and no file compiled code includes, so the cross-target checks and cargo doc did not run." ;;
        *) echo "no explanation is defined for this value: tools/guard is broken." ;;
      esac
      ;;
    rustup-targets)
      echo "rustup could not list installed targets, so the cross-target checks could not run." ;;
    missing-target)
      printf 'that Rust target is not installed: run rustup target add %s.\n' "$2" ;;
    cross-check)
      echo "the core and CLI test targets failed to compile for that target." ;;
    cargo-doc)
      echo "cargo doc failed." ;;
    test-binary-signal)
      echo "a test binary died by that signal before any verdict; rebuild that artifact under target/ to rule out a corrupt binary before reading the suite as red. The death line follows." ;;
    cargo-test)
      echo "the workspace test run failed." ;;
    ui-check)
      printf 'npm run --prefix ui %s failed.\n' "$2" ;;
    argument)
      echo "that argument is not one this script takes; usage: tools/guard [--full]." ;;
    validate-class)
      echo "DEV_VALIDATE_CLASS names a class tools/ci-job-set has no lane selection for; its cause is above." ;;
    lane-unknown)
      echo "tools/ci-job-set selects no value for that lane name: tools/guard is broken." ;;
    lane-selection)
      echo "no lane selection was made — tools/ci-job-set's exit status, or paths-unreadable where DEV_VALIDATE_PATHS names no readable file — so every lane ran." ;;
    *)
      echo "no explanation is defined for this key: tools/guard is broken." ;;
  esac
}
refuse() { # KEY VALUE — guard could not run at all
  printf 'guard: %s=%s\n' "$1" "$2" >&2
  finding_text "$1" "$2" >&2
  exit 2
}

cargo_free_kib() { # TARGET_PATH — available KiB on the volume that will hold it
  local path="$1" parent output value
  while [ ! -e "$path" ]; do
    parent=$(dirname "$path") || return 1
    [ "$parent" != "$path" ] || return 1
    path="$parent"
  done
  output=$(df -Pk "$path" 2>/dev/null) || return 1
  value=$(awk 'NR == 2 { print $4 }' <<<"$output") || return 1
  case "$value" in
    "" | *[!0-9]*) return 1 ;;
  esac
  printf '%s\n' "$value"
}

cargo_target_kib() { # TARGET_PATH — KiB it holds outside any incremental directory, 0 when absent
  local path="$1" output
  [ -e "$path" ] || { echo 0; return 0; }
  output=$({ du -sk "$path" && find "$path" -type d -name incremental -prune -exec du -sk {} +; } 2>/dev/null) ||
    return 1
  # The first line is the whole target; each later one is an incremental
  # directory inside it.
  awk '$1 !~ /^[0-9]+$/ { bad = 1 } NR == 1 { kib = $1; next } { kib -= $1 }
    END { if (bad || NR == 0) exit 1; print kib }' <<<"$output"
}

whole_setting() { # NAME VALUE — refuse a space bound that is not a positive whole number
  # A zero bound would turn its floor off.
  case "$2" in
    "" | *[!0-9]*) refuse cargo-space-setting "$1" ;;
    *[!0]*) ;;
    *) refuse cargo-space-setting "$1" ;;
  esac
}

space_stop() { # KEY VALUE — a full run without room ends here, before any later
  # step can compile into the volume: a touched suite may run cargo too.
  say "$1" "$2"
  exit 1
}

FULL=0
case "${1:-}" in
  --full) FULL=1; shift ;;
  --help | -h)
    printf '%s\n' 'usage: tools/guard [--full]' \
      'Default: repository rules and compile checks for staged product changes.' \
      '--full: full Rust and UI validation for development completion and submit,' \
      '        plus the suites of the skill, hook, tool and Pi-package trees the branch touched.' \
      '        DEV_VALIDATE_CLASS, DEV_VALIDATE_DOCS_ONLY and DEV_VALIDATE_PATHS, set by' \
      '        dev-validate-run, stand down the lanes tools/ci-job-set does not select.'
    exit 0
    ;;
esac
[ "$#" -eq 0 ] || refuse argument "$1"
cd "$(git rev-parse --show-toplevel)"

# The lanes --full runs. dev-validate-run hands over what the classifier and
# its docs reader answer over one range: DEV_VALIDATE_CLASS,
# DEV_VALIDATE_DOCS_ONLY and the changed paths in the file DEV_VALIDATE_PATHS
# names, the three inputs CI's changes job gives tools/ci-job-set. An unset
# class is a run outside that runner. A standard class that is not docs-only,
# and an unset one, run every lane; anything else runs the lanes ci-job-set
# selects from those inputs, so completion validation stands a lane down where
# the checks judging the pull request do and nowhere else. A class ci-job-set
# does not know is refused; any other selection failure is a finding, and every
# lane still runs. The commit chain reads no class.
#
# The three are this run's and no one else's: they are read here and removed
# from the environment before any lane starts, so a suite a lane runs, and any
# guard that suite runs in turn, never selects its lanes from this diff.
validate_class="${DEV_VALIDATE_CLASS:-standard}"
validate_docs_only="${DEV_VALIDATE_DOCS_ONLY:-false}"
validate_paths="${DEV_VALIDATE_PATHS:-}"
unset DEV_VALIDATE_CLASS DEV_VALIDATE_DOCS_ONLY DEV_VALIDATE_PATHS
lanes=all
if [ "$FULL" -eq 1 ] && [ "$validate_class:$validate_docs_only" != standard:false ]; then
  if ! selected_paths=$(cat -- "$validate_paths" 2>/dev/null); then
    say lane-selection paths-unreadable
  else
    selection_status=0
    selection=$(CHANGE_CLASS="$validate_class" DOCS_ONLY="$validate_docs_only" \
      CHANGED_PATHS="$selected_paths" GITHUB_OUTPUT=/dev/stdout "$TOOLS_DIR/ci-job-set" 2>&1) ||
      selection_status=$?
    printf '%s\n' "$selection"
    case "$selection_status:$selection" in
      0:*) lanes="$selection" ;;
      *"ci-job-set: cause=unknown-class"*) refuse validate-class "$validate_class" ;;
      *) say lane-selection "$selection_status" ;;
    esac
  fi
fi

# Touched is what the suites lane runs suites for, and what the cross-target
# checks and cargo doc read to learn whether the branch changed any Rust
# input: the branch against origin/main where that ref exists, plus
# everything the working tree and index carry, so a render-only sync counts
# for its source. base_resolved is 0 where no merge base with origin/main was
# found: the touched set then holds the working tree alone, not what the
# branch committed. --no-renames: a move between two trees names its source
# and its destination, so the tree a file left runs its suite too. Each read
# checks its own status; a group's status is its last command's, which would
# let a failed diff pass on a good `git status`. The status read adds what the
# diff against the working tree cannot see: untracked files.
touched=""
base_resolved=0
if [ "$FULL" -eq 1 ]; then
  suites_base=HEAD
  if git rev-parse --verify -q origin/main >/dev/null; then
    if suites_base=$(git merge-base HEAD origin/main); then
      base_resolved=1
    else
      suites_base=HEAD
    fi
  fi
  branch_touched=$(git -c core.quotePath=false diff --no-renames --name-only "$suites_base" --) ||
    { branch_touched=""; say touched-set branch-diff; }
  tree_touched=$(git -c core.quotePath=false status --porcelain --untracked-files=all | cut -c4- | sed 's/^.* -> //') ||
    { tree_touched=""; say touched-set working-tree; }
  touched=$(printf '%s\n%s\n' "$branch_touched" "$tree_touched" | sort -u) ||
    { touched=""; say touched-set merge; }
fi
# A lane name the selection does not carry is this script's own misspelling,
# which would otherwise stand that lane down on every narrow class.
lane_on() { # LANE — tools/ci-job-set's name for it
  [ "$lanes" != all ] || return 0
  ! grep -Fxq -- "$1=true" <<<"$lanes" || return 0
  grep -Fxq -- "$1=false" <<<"$lanes" || refuse lane-unknown "$1"
  return 1
}

# The staged bot-instructions check is a lane of the commit-guards chain that
# runs this script; --full judges the working tree, which the chain does not.
if [ "$FULL" -eq 1 ] && lane_on bot_instructions; then
  "$TOOLS_DIR/../.agents/skills/bot-instructions/scripts/bot-instructions" check || say bot-instructions "$?"
fi
# Decision IDs are judged before merge and not per commit: the check fetches
# the base branch and reads its tip, since a merge base older than another
# branch's merged record cannot show the collision. No CI lane runs it, so no
# change class stands it down.
if [ "$FULL" -eq 1 ]; then
  "$TOOLS_DIR/../.agents/skills/decider/scripts/decisions" check || say decision-ids "$?"
fi

# The hit lines below are a tracked file's own bytes, and a source file may
# carry an ESC or another C0 control as legitimate content. Printed raw they
# reach a terminal as control codes rather than as the line that broke a rule,
# so every hit goes through here: one line each, every C0 control except tab
# and DEL replaced. These scans run before the package collection setup.
show() { # HITS — the same lines, safe to print
  printf '%s\n' "$1" | LC_ALL=C awk '{ gsub(/[\001-\010\013-\037\177]/, "?"); print }'
}

files=$({ git ls-files; git diff --cached --name-only; } | sort -u)

# Content rules over hand-written source. Every caller names the tree it
# means, so the only blanket skips left are the generated files inside those
# trees. Usage: scan <grep-ERE> <path-ERE>
scan() {
  local pat=$1 filter=$2 f
  while IFS= read -r f; do
    [ -f "$f" ] || continue
    case "$f" in
      ui/src/components/ui/* | ui/src/bindings.ts) continue ;; # generated: shadcn, tauri-specta
    esac
    [[ "$f" =~ $filter ]] || continue
    grep -nHE "$pat" "$f" || true
  done <<<"$files"
}

# Paths where a raw filesystem read would be a read of catalog content, so
# each matching read is caught. The alternation below is what the rule covers
# and the whole of it — chosen, not exhaustive, and not every module that
# reads a catalog: author/import does and is not here, and neither is every
# file under source/. Widening it is a judgement each time, because a module
# whose fs reads are of kendex's own store rather than of a catalog would be
# flagged for a legitimate read.
# The plain Homebrew name must resolve to the cask (the app): brew checks
# formulas first, so a formula claiming `kendex` silently flips the default
# install back to CLI-only.
hits=$(scan 'class Kendex < Formula' '^packaging/homebrew/')
[ -n "$hits" ] && {
  say homebrew-formula "$(count_lines "$hits")"
  show "$hits"
}

hits=$(scan 'std::fs::read|crate::fs::read' '^crates/core/src/(source\.rs|check_catalog\.rs|library\.rs|source/(about|browse|bundles|catalog|config|discover|index|layout|meta|plugin_registry|slot)\.rs|source/browse/preview\.rs|render/skill\.rs|engine/(desired|ops))|^crates/app/src/editor\.rs')
[ -n "$hits" ] && {
  say catalog-fs-read "$(count_lines "$hits")"
  show "$hits" | head -5
}

hits=$(scan '@tauri-apps/' '^ui/src/')
[ -n "$hits" ] && {
  say ui-tauri-import "$(count_lines "$hits")"
  show "$hits"
}

hits=$(scan '#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?\b|rgba?\(|hsla?\(' '^ui/src/.*\.tsx?$')
[ -n "$hits" ] && {
  say ui-color-literal "$(count_lines "$hits")"
  show "$hits" | head -5
}

# The two shipped command-safety policies must stay working EREs that refuse
# what their own source says they refuse: kendex.settings.toml's own value and
# the example in docs/authoring/command-safety.md, which a project copies. The
# hook applies whatever policy it is given and cannot judge either, so the
# check belongs here. The pattern is read back through the commit-guards
# settings loader the hook itself uses; this lane adds no second parser.
command_safety_policy() { # SOURCE_FILE — refuse|allow rows on stdin
  local source="$1" rows
  rows=$(cat)
  local verdicts errfile said=0
  # The subshell's stdout is the verdict protocol below, so its stderr needs
  # somewhere else to go: grep's complaint about an unreadable pattern, and
  # the settings parser's own ::error::, would otherwise reach the stream
  # ahead of the keyed line. Held here and replayed under the finding.
  errfile=$(mktemp) || { say command-safety-unchecked "$source"; return; }
  # Every case pattern below carries a balanced `(`: Bash 3.2's parser cannot
  # close a command substitution whose patterns leave a `)` unbalanced, and
  # dies at parse time before this lane runs at all. Newer bash reads the two
  # spellings identically, so nothing here is 3.2-only behaviour.
  #
  # The verdicts are captured, not piped: a piped loop would run `say` in a
  # subshell, leaving the parent's fail at 0 while a finding printed. A
  # producer that dies takes the lane down with its own clause.
  verdicts=$(
    set -euo pipefail
    exec 2>"$errfile"
    guards="$TOOLS_DIR/../.agents/skills/commit-guards/scripts"
    source "$guards/lib/common.sh"
    source "$guards/lib/settings.sh"
    gg_tmpdir
    # A settings file is handed to the loader whole. gg_env_table is the
    # stateful reader the hook itself goes through: it follows table headers,
    # so an assignment outside [env] or one sitting inside a multiline string
    # is not a policy, and it refuses a key assigned twice. Extracting a line
    # first would put a second, weaker parser in front of that judge, and a
    # deleted assignment with a lookalike line elsewhere in the file would
    # read as a policy that is still there.
    #
    # The Markdown example carries its assignment inside prose, so there is no
    # settings file to hand over and the line is extracted into one. That
    # extraction is the whole of what this branch claims: exactly one line in
    # the document spells the assignment.
    case "$source" in
      (*.toml) probe="$PWD/$source" ;;
      (*)
        line=$(awk '/^COMMAND_SAFETY_DENY_PATTERN = / { print; found++ }
          END { exit(found == 1 ? 0 : 1) }' "$source") || { printf 'one-line\n'; exit 0; }
        probe="$GG_TMP/kendex.settings.toml"
        { printf '[env]\n'; printf '%s\n' "$line"; } >"$probe"
        ;;
    esac
    # The loader answers from the process environment first, then .env.local,
    # and only then the file it was given, so either of those could answer for
    # a policy the source does not carry: a weakened source would pass this
    # lane whenever an override still refused the rows. All three layers are
    # closed before the file is named. The key is cleared from the
    # environment; index mode is off, so no relative name is probed against
    # the git index; and the read runs from the run's own empty temporary
    # directory, which holds no .env.local. The file named is absolute and
    # resolves from there unchanged. Child-local throughout: the parent keeps
    # its own environment and its own directory.
    unset COMMAND_SAFETY_DENY_PATTERN
    unset GG_SETTINGS_FROM_INDEX GG_SETTINGS_INDEX_DIR
    export COMMIT_GUARDS_SETTINGS_FILE="$probe"
    builtin cd "$GG_TMP" || { printf 'unreadable\n'; exit 0; }
    pattern=$(gg_setting COMMAND_SAFETY_DENY_PATTERN "") || { printf 'unreadable\n'; exit 0; }
    [ -n "$pattern" ] || { printf 'empty\n'; exit 0; }
    while IFS='|' read -r want command; do
      [ -n "$want" ] || continue
      status=0
      # A here-string, not a pipe: grep -q stops reading at its first match,
      # and a shell writer piped into it takes a SIGPIPE that pipefail turns
      # into a 141 this loop would read as a status the case below refuses.
      grep -qE -- "$pattern" <<<"$command" || status=$?
      case "$status" in
        (0 | 1) ;;
        (*) printf 'not-an-ere\n'; exit 0 ;;
      esac
      case "$want:$status" in
        (refuse:1) printf 'missed|%s\n' "$command" ;;
        (allow:0) printf 'over|%s\n' "$command" ;;
      esac
    done <<<"$rows"
  ) || {
    say command-safety-unchecked "$source"
    command_safety_cause "$errfile"
    return
  }
  while IFS='|' read -r verdict command; do
    [ -n "$verdict" ] || continue
    said=1
    case "$verdict" in
      one-line) say command-safety-lines "$source" ;; # the document branch only
      unreadable) say command-safety-unreadable "$source" ;;
      empty) say command-safety-empty "$source" ;;
      not-an-ere) say command-safety-not-an-ere "$source" ;;
      missed) say command-safety-missed "$source"; printf '  %s\n' "$command" ;;
      over) say command-safety-over "$source"; printf '  %s\n' "$command" ;;
    esac
  done <<<"$verdicts"
  # Anything the run said for itself with no verdict to explain it is an
  # anomaly, not noise: it gets a keyed line of its own rather than reaching
  # the stream unannounced.
  [ "$said" -eq 1 ] || [ ! -s "$errfile" ] || say command-safety-unchecked "$source"
  command_safety_cause "$errfile"
}
command_safety_cause() { # FILE — what the lane's own tools said, replayed
  [ ! -s "$1" ] || cat -- "$1"
  rm -f -- "$1"
}

# The rows are what each source states about itself: the settings comment names
# the capped scopes it refuses and the uncapped ones it leaves alone, and the
# doc names the calls its example blocks and the validation it allows.
command_safety_policy kendex.settings.toml <<'ROWS'
refuse|systemd-run --user --scope -p MemoryMax=64M cargo test -p kendex-core
refuse|systemd-run --user --scope --property=MemoryHigh=512K ./target/debug/review_fixes
allow|systemd-run --user --scope --slice=agents.slice cargo test -p kendex-core
allow|systemd-run --user --scope -p MemoryMax=2G cargo test -p kendex-core
ROWS
command_safety_policy docs/authoring/command-safety.md <<'ROWS'
refuse|qs -c vshell
refuse|qs -p quickshell/vshell
refuse|pkill quickshell
refuse|pkill -f quickshell
refuse|git status && qs -c vshell
allow|scripts/validate qml
allow|git status
allow|qs -c test-fixture
ROWS


# One run scoping: skills/github/scripts/lib/ci-run-correlation.sh holds the
# scope_current_run and the jq taxonomy (def bucket, def runid, def red, def
# required_only) that orch ci-wait and the GitHub commands source. A caller
# carrying its own copy is the drift the library ended; the scan reads the
# spelling those files use.
hits=$(scan '^scope_current_run\(\)|def (bucket|runid|red|required_only)[(:]' '^(skills/orch/scripts/ci-wait|skills/github/scripts/commands/[^/]+\.sh)$')
[ -n "$hits" ] && {
  say ci-correlation-copy "$(count_lines "$hits")"
  show "$hits"
}

# One hardened constructor builds every external process (invariant 13);
# a per-call-site discipline misses call sites. crates/app is out of scope:
# it has two sanctioned raw spawns, neither a hardened tool invocation —
# one Command re-execs this app, replacing the process rather than
# launching a tool, and one launches the user's own GUI editor detached,
# outliving kendex with no output to capture and no timeout that would
# make sense. Integration tests under crates/*/tests run our own binary
# and are likewise not tool launches.
hits=$(scan 'Command::new' '^crates/(core|cli)/src/' | grep -v '^crates/core/src/process/')
[ -n "$hits" ] && {
  say raw-command-new "$(count_lines "$hits")"
  show "$hits" | head -5
}

# The per-file scans over the integration tests: the files a pattern
# selects, each read by one awk program that prints the lines it refuses.
# grep's 1 is no file selected; any other status of grep, and an awk that
# could not run, is the scan's own failure and returns here as one, so the
# lane refuses instead of reporting the files it never read as clean.
# Usage: test_scan <grep-ERE> <awk-program>; the hits on stdout.
test_scan() {
  local pattern=$1 program=$2 files f
  files=$(grep -rlE -- "$pattern" crates/*/tests)
  case $? in 0 | 1) ;; *) return 2 ;; esac
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    awk -v file="$f" "$program" "$f" || return 2
  done <<<"$files"
}

# A command that hands the binary a fixture home must say on the spot that
# the home it gave is the one it means: without that, a debug build sandboxes
# itself and the command drives the dev home instead of the fixture. Checked
# per call site — one compliant builder must not vouch for the rest of a file
# that holds several.
if ! hits=$(test_scan '\.env\("HOME"' '
    pending && /^[[:space:]]*(\/\/|$)/ { next }
    pending { if ($0 !~ /KENDEX_REAL_HOME/) print file ":" pending; pending = 0 }
    /\.env\("HOME"/ { pending = NR }
    END { if (pending) print file ":" pending }
  '); then
  say test-scan fixture-home
fi
[ -n "$hits" ] && {
  say fixture-home "$(count_lines "$hits")"
  show "$hits" | head -5
}

# A test that runs the binary hands it a fixture home at the launch. The
# file is selected by the binary's name, since a launch takes three
# spellings — Command::new on the name, on a binding of it, and through a
# PATH built from its directory — and in such a file every launch of a
# program the lane cannot read, a computed argument or the literal
# "kendex", is taken for the binary: its builder carries fixture_env() or
# a HOME, which the rule above pairs with the opt-out, before the call that
# runs it, a closing brace, the next Command::new of any program or the end
# of the file — so another builder's line is never read as its evidence. A
# comment line is skipped and a trailing comment stripped, so prose naming
# the helper clears nothing, and a string that only names it is not the
# call; a string built to hold the clearing call itself is not told apart
# from the call. The binary reached through PATH is covered by the
# computed launch that put it there.
if ! hits=$(test_scan 'CARGO_BIN_EXE_kendex' '
    function refuse() { print file ":" pending; pending = 0 }
    function clears(l) { return l ~ /\.envs\([[:space:]]*(crate::)?(test_util::)?fixture_env\(|\.env\([[:space:]]*"HOME"/ }
    function launches(l) { return l ~ /\.(output|status|spawn)\(/ }
    /^[[:space:]]*\/\// { next }
    { line = $0; sub(/\/\/.*$/, "", line) }
    line ~ /Command::new\([[:space:]]*([^"[:space:]]|"kendex"|$)/ {
      if (pending) refuse()
      pending = NR
      if (clears(line)) pending = 0
      else if (launches(line)) refuse()
      next
    }
    !pending { next }
    line ~ /Command::new\(/ { refuse(); next }
    clears(line) { pending = 0; next }
    launches(line) || line ~ /^[[:space:]]*}/ { refuse() }
    END { if (pending) refuse() }
  '); then
  say test-scan binary-home
fi
[ -n "$hits" ] && {
  say binary-home "$(count_lines "$hits")"
  show "$hits" | head -5
}

# Every file under a harness crate's tests/ is compiled by some [[test]]
# target. The rule and what it judges are tools/test-roster's, which CI runs
# beside the cargo compile; exit 1 is an orphan, exit 2 a scan that could
# not run, and neither is a pass. One line on purpose: the must-fail control
# in tools/tests/guard.test.sh removes this lane by deleting it.
"$TOOLS_DIR/test-roster" || say test-roster "$?"

# What the diff-scoped rules below diff against: HEAD, or on an unborn
# branch the index against nothing, so the first commit is judged too.
if git cat-file -e 'HEAD^{commit}' 2>/dev/null; then
  diff_against=(HEAD)
  have_head=1
else
  diff_against=(--cached)
  have_head=0
fi

# Integration-test temp roots take their canonical spelling immediately
# through the shared rooted() helper, on the next source line, and that call
# must take the root just declared — the follow-line test is built from the
# declared name, so rooting some other binding does not clear it. Diff-scoped:
# older fixtures predate the helper and are not rewritten to satisfy it.
temp_fixture_diff=$(git diff --no-color --unified=100000 --no-ext-diff --text "${diff_against[@]}" -- 'crates/*/tests/*.rs') ||
  say fixture-diff unreadable
if ! temp_fixture_hits=$(awk '
  function flush() { if (pending) print file ":" pending ": " pending_text; pending = 0 }
  /^diff --git / { flush(); file = $4; sub(/^b\//, "", file); next }
  /^@@ / { flush(); split($3, at, ","); line_no = at[1] + 0 - 1; next }
  /^(---|\+\+\+) / { next }
  !/^[ +]/ { next }
  { line = substr($0, 2); line_no++ }
  pending && line ~ /^[[:space:]]*(\/\/|$)/ { next }
  pending {
    bind = "^[[:space:]]*let[[:space:]]+(mut[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*([[:space:]]*:[^=]+)?[[:space:]]*=[[:space:]]*&?[[:space:]]*rooted[[:space:]]*\\([[:space:]]*&?[[:space:]]*" pending_name "[[:space:]]*\\)"
    if (line !~ bind) print file ":" pending ": " pending_text
    pending = 0
  }
  /^\+[[:space:]]*let[[:space:]]+(mut[[:space:]]+)?[A-Za-z_][A-Za-z0-9_]*([[:space:]]*:[^=]+)?[[:space:]]*=[[:space:]]*(tempfile::)?(tempdir\(\)|TempDir::new\(\))/ {
    pending = line_no; pending_text = line; pending_name = line
    sub(/^[[:space:]]*let[[:space:]]+/, "", pending_name); sub(/^mut[[:space:]]+/, "", pending_name)
    sub(/[^A-Za-z0-9_].*$/, "", pending_name)
  }
  END { flush() }
' <<<"$temp_fixture_diff"); then
  say fixture-scan unreadable
fi
[ -n "$temp_fixture_hits" ] && {
  say unrooted-fixture "$(count_lines "$temp_fixture_hits")"
  show "$temp_fixture_hits" | head -5
}

# Bash 3.2 portability over the skill tree. The roster and the pattern set
# are the lint's own; exit 1 is a construct, exit 2 a scan that could not
# run, and neither is a pass. One line on purpose: the must-fail control in
# tools/tests/guard.test.sh removes this lane by deleting it.
"$TOOLS_DIR/bash32-lint" || say bash32-lint "$?"

# What the scan above reads as text, this one parses with the shell that has
# to accept it. --full and not the commit chain: the pass needs a real Bash
# 3.2 — macOS's own /bin/bash, or the bash:3.2 image under a container
# runtime — and refuses when it can reach neither, so in the chain a machine
# without either could not commit at all. This run is the early one: it
# happens at development completion, before any CI leg. The guards-scans
# shard runs the same lane on both of its legs, which is where this class was
# reported from before the lane existed.
# One line on purpose, like the lane above it: the must-fail control in
# tools/tests/guard-full.test.sh removes this lane by deleting it.
[ "$FULL" -eq 0 ] || ! lane_on shell_shards || "$TOOLS_DIR/bash32-parse" || say bash32-parse "$?"

# A render source lands its renders in the same change: skills/<x>/<p>
# renders to .agents/skills/<x>/<p>, an agent definition to one file per
# harness, and a hook to whichever harness hook directories already carry it.
# Presence, not byte equality — a render can carry an injected block the
# source has no copy of, so bytes cannot be compared. Rendered is judged at
# the tree: a skill with anything tracked under .agents/skills/<x> renders
# every file, so each source there owes a render, and an agent owes a
# file to each harness directory that tracks any. Hooks are judged per file
# instead — the harness hook sets are deliberately not uniform, and
# hooks/tests/* renders nowhere. A source with no tracked render has nothing
# to land, and a render-only change is the sync direction and passes. A
# deletion is in the changed set too, so the render must also still exist
# wherever its source does. Path quoting is off on every read: a quoted path
# matches neither the case arms nor its own render.
#
# The roots live in one place because the arms and the tracked-set query both
# read them: a root named only in an arm is not tracked, so that
# harness's renders would be silently unowed. Agent roots carry the render's
# extension after the colon.
agent_roots=(.claude/agents:md .codex/agents:toml .pi/agents:md)
hook_roots=(.claude/hooks .codex/hooks .pi/kendex/hooks)
render_roots=(.agents/skills "${agent_roots[@]%:*}" "${hook_roots[@]}")
render_changed=$(git -c core.quotePath=false diff --name-only --no-renames "${diff_against[@]}") ||
  { render_changed=""; say render-changed-set unreadable; }
# Tracked is the index UNION what HEAD carries: the index alone drops a render
# staged for deletion, which is the moment the outlives clause below exists to
# judge, and skipping the rule there would accept the drift.
render_tracked=$(git -c core.quotePath=false ls-files -- "${render_roots[@]}") ||
  { render_tracked=""; say render-tracked-set unreadable; }
if [ "$have_head" = 1 ]; then
  render_committed=$(git -c core.quotePath=false ls-tree -r --name-only HEAD -- "${render_roots[@]}") ||
    { render_committed=""; say render-committed-set unreadable; }
  render_tracked="$render_tracked
$render_committed"
fi
render_hits=""
NL='
'
renders_under() { # DIR — anything is tracked under DIR, DIR read literally
  case "$NL$render_tracked$NL" in *"$NL$1/"*) return 0 ;; esac
  return 1
}
render_is_tracked() { # PATH — PATH itself is tracked, PATH read literally
  case "$NL$render_tracked$NL" in *"$NL$1$NL"*) return 0 ;; esac
  return 1
}

# A configured instruction is visible only in the managed render: its source
# deliberately has no copy. Judge the same candidate for configuration,
# source existence, and render bytes: the index at commit time, the worktree
# under --full. One ordered-pair reader owns both instruction block shapes;
# kendex verify owns the rendered bytes inside them.
render_skill_paths=$(printf '%s\n' "$render_tracked" | sort -u) ||
  { render_skill_paths=""; say render-tracked-set unreadable; }
instruction_hits=$(python3 -c '
import sys
sys.path.insert(0, sys.argv[1])
from lib import manifest
from lib.tree import Index, Worktree
tree = Worktree(".") if sys.argv[2] == "1" else Index(".")
keys = manifest.resolve(tree).data.get("skill-instructions", {})
shared = "all" in keys or "*" in keys
def has_block(text, name):
    start = f"<!-- kendex:{name}-instructions:start -->"
    end = f"<!-- kendex:{name}-instructions:end -->"
    return start in text and end in text.split(start, 1)[1]
for render in sys.stdin.read().splitlines():
    if not render.startswith(".agents/skills/") or not render.endswith(("/SKILL.md", "/SKILL.md.disabled")):
        continue
    skill = render.removeprefix(".agents/skills/").removesuffix("/SKILL.md.disabled").removesuffix("/SKILL.md")
    text = tree.read(render)
    if tree.read(f"skills/{skill}/SKILL.md") is None or text is None or skill not in keys and not shared:
        continue
    if not has_block(text, "project") or shared and not has_block(text, "shared"):
        print(render)
' "$TOOLS_DIR/../.agents/skills/bot-instructions/scripts" "$FULL" 2>/dev/null <<<"$render_skill_paths") ||
  { instruction_hits=""; say skill-instruction-config unreadable; }
[ -n "$instruction_hits" ] && {
  say missing-skill-instructions "$(count_lines "$instruction_hits")"
  show "$instruction_hits" | sed -n '1,5p'
}

require_render() { # SOURCE RENDER — RENDER changes with SOURCE and outlives it
  { grep -Fxq -- "$2" <<<"$render_changed" && { [ ! -e "$1" ] || [ -e "$2" ]; }; } ||
    render_hits="$render_hits$1 -> $2
"
}
while IFS= read -r f; do
  [ -n "$f" ] || continue
  case "$f" in
  skills/*/*)
    x="${f#skills/}"
    x="${x%%/*}"
    renders_under ".agents/skills/$x" && require_render "$f" ".agents/$f"
    ;;
  agents/*.md)
    n="${f#agents/}"
    n="${n%.md}"
    for r in "${agent_roots[@]}"; do
      renders_under "${r%:*}" && require_render "$f" "${r%:*}/$n.${r##*:}"
    done
    ;;
  hooks/*)
    n="${f#hooks/}"
    for d in "${hook_roots[@]}"; do
      render_is_tracked "$d/$n" && require_render "$f" "$d/$n"
    done
    ;;
  esac
done <<<"$render_changed"
[ -n "$render_hits" ] && {
  say missing-render "$(count_lines "$render_hits")"
  show "$render_hits" | head -5
}

# The changelog gate owns commit change collection and product-path matching.
# Shared compiler inputs outside those product paths still affect all crates.
workspace_rust_input() { # PATH — the workspace manifest, lock, toolchain pin or cargo configuration
  case "$1" in
    Cargo.toml | Cargo.lock | rust-toolchain.toml | .cargo/*) return 0 ;;
  esac
  return 1
}
rust_all=0
[ "$FULL" -eq 0 ] || ! lane_on cargo_lint || rust_all=1
rust_manifests=()
ui_changed=0
[ "$FULL" -eq 0 ] || ! lane_on ui || ui_changed=1
if [ "$FULL" -eq 0 ]; then
  GG_CHECK=guard
  GUARDS="$TOOLS_DIR/../.agents/skills/commit-guards/scripts"
  source "$GUARDS/lib/common.sh"
  gg_tmpdir
  GUARD_TMP="$GG_TMP"
  set +e
  (
    set -euo pipefail
    source "$GUARDS/lib/settings.sh"
    source "$GUARDS/lib/commit-changes.sh"
    gg_settings_index_mode
    gg_commit_changes
    cat "$GG_TMP/product.z"
    while IFS= read -r -d '' f; do
      if workspace_rust_input "$f"; then printf '%s\0' "$f"; fi
    done <"$GG_TMP/staged.z"
  ) >"$GUARD_TMP/product.z"
  classification_status=$?
  if [ "$classification_status" -ne 0 ]; then
    say commit-changes "$classification_status"
    exit "$fail"
  fi
  while IFS= read -r -d '' f; do
    case "$f" in
      *.md) continue ;;
      crates/*/*) ;;
      crates/*.rs) rust_all=1; continue ;;
    esac
    if workspace_rust_input "$f"; then rust_all=1; continue; fi
    case "$f" in
      crates/*/*.rs | crates/*/Cargo.toml)
        crate="${f#crates/}"
        manifest="crates/${crate%%/*}/Cargo.toml"
        if [ ! -f "$manifest" ]; then rust_all=1; continue; fi
        seen=0
        # Guarded: an empty array is unbound under set -u on Bash 3.2.
        for existing in ${rust_manifests[@]+"${rust_manifests[@]}"}; do
          [ "$existing" != "$manifest" ] || seen=1
        done
        [ "$seen" -eq 1 ] || rust_manifests+=("$manifest")
        ;;
      ui/*) ui_changed=1 ;;
    esac
  done <"$GUARD_TMP/product.z"
fi

cargo_target="${CARGO_TARGET_DIR:-target}"
# The path df, du and find read: a relative target never reaches them as an
# option.
case "$cargo_target" in
  /*) cargo_target_path="$cargo_target" ;;
  *) cargo_target_path="./$cargo_target" ;;
esac
if [ "$FULL" -eq 1 ] && [ -f Cargo.toml ]; then
  # The fresh Linux cargo shards in .github/workflows/skill-tests.yml explain
  # why no later compile can reuse incremental artifacts from this run.
  export CARGO_INCREMENTAL=0
  ORCH_ENV="$TOOLS_DIR/../.agents/skills/orch/scripts/orch-env"
  # An empty default, because orch-env replaces a malformed value with the
  # default it is given and whole_setting would never see it.
  guard_min_free_gb=$("$ORCH_ENV" GUARD_MIN_FREE_GB "") ||
    refuse cargo-space-setting GUARD_MIN_FREE_GB
  whole_setting GUARD_MIN_FREE_GB "$guard_min_free_gb"
  guard_exhausted_free_mb=$("$ORCH_ENV" GUARD_EXHAUSTED_FREE_MB "") ||
    refuse cargo-space-setting GUARD_EXHAUSTED_FREE_MB
  whole_setting GUARD_EXHAUSTED_FREE_MB "$guard_exhausted_free_mb"
  # A start below the exhaustion floor would fail the end probe, so it
  # refuses on the free figure alone, before the target is measured. Room is
  # free space plus the target outside its incremental directories, which a
  # run without incremental compilation never rewrites.
  if ! cargo_free_start_kib=$(cargo_free_kib "$cargo_target_path"); then
    note cargo-space-unreadable "$cargo_target"
  elif [ "$cargo_free_start_kib" -lt "$((10#$guard_exhausted_free_mb * 1024))" ]; then
    space_stop cargo-space-free "free-kib=$cargo_free_start_kib min-free-mib=$guard_exhausted_free_mb"
  elif ! cargo_target_start_kib=$(cargo_target_kib "$cargo_target_path"); then
    note cargo-target-unreadable "$cargo_target"
  elif [ "$((cargo_free_start_kib + cargo_target_start_kib))" -lt "$((10#$guard_min_free_gb * 1024 * 1024))" ]; then
    space_stop cargo-space-start "free-kib=$cargo_free_start_kib target-kib=$cargo_target_start_kib min-gib=$guard_min_free_gb"
  fi
fi

if [ -f Cargo.toml ] && { [ "$rust_all" -eq 1 ] || [ "${#rust_manifests[@]}" -gt 0 ]; }; then
  if cargo tree -p kendex-core -e normal 2>/dev/null | grep -qE '\btauri v'; then
    say tauri-dependency crates/core
  fi
  for m in crates/*/Cargo.toml; do
    [ -f "$m" ] || continue
    grep -A1 '^\[lints\]' "$m" | grep -q 'workspace *= *true' ||
      say crate-lints "$m"
  done
  if [ "$rust_all" -eq 1 ]; then
    cargo check --workspace --all-targets || say cargo-check workspace
    cargo clippy --workspace --all-targets --quiet -- -D warnings || say clippy workspace
  else
    for manifest in ${rust_manifests[@]+"${rust_manifests[@]}"}; do
      cargo check --manifest-path "$manifest" --all-targets || say cargo-check "$manifest"
      cargo clippy --manifest-path "$manifest" --all-targets --quiet -- -D warnings || say clippy "$manifest"
    done
  fi
  # rustfmt exits 0 when writing its diff fails, so the diff goes through a
  # pipe this script reads, never straight to a stream that may be full.
  fmt_out=$(cargo fmt --check 2>&1) || say cargo-fmt workspace
  [ -z "$fmt_out" ] || printf '%s\n' "$fmt_out"
fi

# Completion validation runs the suites CI runs for the trees this branch
# touched, beside the whole-workspace cargo and UI runs below: a skill's own
# tests, hooks/tests for a hook, tools/tests for a tool, and a Pi package's
# declared script (`test:ci` where it declares one, `test` otherwise, the
# rule pi-extensions/package-policy.test.mjs holds CI to).
# An untouched suite is not evidence about this change and is not run here;
# CI runs every suite on the merged tree.
# A Pi package whose suite value-imports Pi has no lockfile for those peers;
# CI installs them in the step before its suite, so a checkout without that
# install names the missing peers beside the failing suite rather than in
# place of it.
pi_suite_failed() { # DIR
  [ -d "$1/node_modules" ] || say missing-peers "$1"
  say suite "$1"
}
if [ "$FULL" -eq 1 ] && lane_on shell_shards; then
  suite_dirs=""
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    case "$f" in
      skills/*/* | .agents/skills/*/*)
        x="${f#.agents/}"
        x="${x#skills/}"
        suite_dirs="$suite_dirs skills/${x%%/*}"
        ;;
      hooks/* | .claude/hooks/* | .codex/hooks/* | .pi/kendex/hooks/*) suite_dirs="$suite_dirs hooks" ;;
      tools/*) suite_dirs="$suite_dirs tools" ;;
      pi-extensions/*/*)
        x="${f#pi-extensions/}"
        suite_dirs="$suite_dirs pi-extensions/${x%%/*}"
        ;;
    esac
  done <<<"$touched"
  for d in $(printf '%s\n' $suite_dirs | sort -u); do
    case "$d" in
      pi-extensions/*)
        [ -f "$d/package.json" ] || continue
        if ! command -v jq >/dev/null 2>&1; then
          say missing-tool jq
          continue
        fi
        if jq -e '.scripts["test:ci"]' "$d/package.json" >/dev/null; then
          (cd "$d" && npm run test:ci) || pi_suite_failed "$d"
        elif jq -e '.scripts.test' "$d/package.json" >/dev/null; then
          (cd "$d" && npm test) || pi_suite_failed "$d"
        fi
        ;;
      *)
        [ -d "$d/tests" ] || continue
        if [ -f "$d/tests/run-all.sh" ]; then
          echo "=== $d/tests/run-all.sh"
          bash "$d/tests/run-all.sh" || say suite "$d/tests/run-all.sh"
          continue
        fi
        for t in "$d"/tests/*.sh "$d"/tests/*.test.mjs; do
          [ -f "$t" ] || continue
          echo "=== $t"
          case "$t" in
            *.mjs) node --test "$t" || say suite "$t" ;;
            *) bash "$t" || say suite "$t" ;;
          esac
        done
        ;;
    esac
  done
fi

# Every repository path an include_str! or include_bytes! literal under
# crates/ names, resolved against the including file's directory: the files
# outside crates/ that compiled code reads at build time. A literal on the
# line after its opening parenthesis, the shape rustfmt gives a long one,
# counts too. A file a test reads at run time is not here; the host test run
# below reads it on every full run.
compiled_includes() {
  find crates -type f -name '*.rs' -exec awk '
    function emit(lit,   path, n, seg, i, k, out) {
      path = FILENAME
      sub(/[^\/]*$/, "", path)
      n = split(path lit, seg, "/")
      k = 0
      for (i = 1; i <= n; i++) {
        if (seg[i] == "" || seg[i] == ".") continue
        if (seg[i] == "..") { if (k == 0) return; k--; continue }
        seg[++k] = seg[i]
      }
      out = seg[1]
      for (i = 2; i <= k; i++) out = out "/" seg[i]
      print out
    }
    function literals(text) {
      while (match(text, /include_(str|bytes)!\([ \t]*"[^"]*"/)) {
        lit = substr(text, RSTART, RLENGTH)
        sub(/^[^"]*"/, "", lit)
        sub(/"$/, "", lit)
        emit(lit)
        text = substr(text, RSTART + RLENGTH)
      }
      return text
    }
    FNR == 1 { pending = 0 }
    {
      line = $0
      if (pending && match(line, /^[ \t]*"[^"]*"/)) {
        lit = substr(line, RSTART, RLENGTH)
        sub(/^[^"]*"/, "", lit)
        sub(/"$/, "", lit)
        emit(lit)
      }
      pending = (literals(line) ~ /include_(str|bytes)!\([ \t]*$/)
    }
  ' {} +
}

if [ "$FULL" -eq 1 ] && [ -f Cargo.toml ]; then
  # The cross-target checks and cargo doc each write a target tree of their
  # own, and CI covers both on the pull requests tools/ci-job-set selects
  # its cargo_lint, cargo_macos and cargo_windows lanes for. Here they are
  # skipped only when the touched set shows the branch changed no Rust
  # input: no crate, no workspace compiler input, no file compiled code
  # includes. A touched set that cannot show that runs them: an empty one,
  # one read without a branch base, or one the include derivation could not
  # be matched against. A failed read of it has already red the run.
  # GUARD_FULL_CROSS_DOC=ci leaves both to CI; run, the default, keeps them.
  cross_doc=$(
    guards="$TOOLS_DIR/../.agents/skills/commit-guards/scripts"
    source "$guards/lib/common.sh" && source "$guards/lib/settings.sh" &&
      gg_setting GUARD_FULL_CROSS_DOC run
  ) || cross_doc=unreadable
  case "$cross_doc" in
    run | ci) ;;
    *) say cross-doc-setting "$cross_doc"; cross_doc=run ;;
  esac
  rust_input=0
  [ -n "$touched" ] || rust_input=1
  [ "$base_resolved" -eq 1 ] || rust_input=1
  while IFS= read -r f; do
    case "$f" in
      crates/*) rust_input=1 ;;
      *) if workspace_rust_input "$f"; then rust_input=1; fi ;;
    esac
  done <<<"$touched"
  if [ "$rust_input" -eq 0 ] && [ "$cross_doc" = run ]; then
    if ! includes=$(compiled_includes); then
      say compiled-includes crates
      rust_input=1
    fi
    while IFS= read -r f; do
      [ -n "$f" ] || continue
      if grep -Fxq -- "$f" <<<"$includes"; then rust_input=1; fi
    done <<<"$touched"
  fi
  if [ "$cross_doc" = ci ]; then
    note cross-doc-skipped ci
  elif [ "$rust_input" -eq 0 ]; then
    note cross-doc-skipped no-rust-input
  else
    # The app needs each platform's C toolchain; core and CLI can
    # cross-check, each target standing in for its platform's CI lane.
    cross_targets=""
    ! lane_on cargo_macos || cross_targets="aarch64-apple-darwin"
    ! lane_on cargo_windows || cross_targets="$cross_targets x86_64-pc-windows-msvc"
    if [ -n "$cross_targets" ]; then
      if ! installed_targets=$(rustup target list --installed); then
        say rustup-targets unreadable
      else
        for cross_target in $cross_targets; do
          if ! grep -Fxq "$cross_target" <<<"$installed_targets"; then
            say missing-target "$cross_target"
          else
            cargo check -p kendex-core -p kendex-cli --all-targets --target "$cross_target" ||
              say cross-check "$cross_target"
          fi
        done
      fi
    fi
    if lane_on cargo_lint; then
      cargo doc --no-deps --document-private-items --workspace --quiet || say cargo-doc workspace
    fi
  fi
fi
if [ "$FULL" -eq 1 ] && [ -f Cargo.toml ] && lane_on cargo_linux; then
  # A test binary that dies by a signal reached no verdict: the runner
  # reports the executable's death, not an assertion. A binary whose code
  # pages come back wrong from disk dies this way, and rebuilding that
  # artifact rules it out where re-running the suite cannot. Reported apart
  # from "tests failed" so a red chain names the artifact. Cargo prints the
  # same death line for a compiler or build script it launched, under
  # "could not compile" instead of "test failed"; only the runner's is one.
  tests_log=$(mktemp)
  if ! cargo test --workspace --quiet 2>&1 | tee "$tests_log"; then
    death=""
    if grep -q "^error: test failed" "$tests_log"; then
      death=$(grep -m1 -o "process didn't exit successfully: .*(signal: [^)]*)" "$tests_log")
    fi
    if [ -n "$death" ]; then
      signal=$(printf '%s' "$death" | sed -n 's/.*(signal: \([0-9][0-9]*\).*/\1/p')
      [ -n "$signal" ] || signal=unknown
      say test-binary-signal "$signal"
      printf '%s\n' "${death#*successfully: }"
    else
      say cargo-test workspace
    fi
  fi
  rm -f "$tests_log"
  if ! cargo_free_end_kib=$(cargo_free_kib "$cargo_target_path"); then
    say cargo-space-end-unreadable "$cargo_target"
  elif [ "$cargo_free_end_kib" -lt "$((10#$guard_exhausted_free_mb * 1024))" ]; then
    say cargo-space-end "free-kib=$cargo_free_end_kib min-mib=$guard_exhausted_free_mb"
  fi
fi
if [ "$ui_changed" -eq 1 ] && [ -f ui/package.json ]; then
  npm run --prefix ui check:types || say ui-check check:types
  npm run --prefix ui check:lint || say ui-check check:lint
  if [ "$FULL" -eq 1 ]; then
    npm run --prefix ui test -- --silent || say ui-check test
  fi
fi

exit $fail
