#!/usr/bin/env bash
# Proves that a package kendex installs actually loads in each supported
# harness, by the harness's own account. `kendex verify` compares disk with
# the lock; every skill suite tests a package in isolation. Neither asks the
# tool that has to read the render, so a render that is well-formed by
# kendex's rules and rejected by its harness passes both. This check installs
# a fixture catalog (one skill, one agent, one SessionStart hook, one
# PreToolUse hook, one command, one stdio MCP server, one Pi extension) into
# a scratch project for every harness, then asks each harness what it loaded
# through the surface that harness exposes, and reads a marker the hooks, the
# MCP server and the Pi extension write when the harness runs them.
#
# It also asks what reaches a lane when the fleet overseer sends it a
# directive, and whether a lane's call to its harness question tool is refused
# with lane mail named as the route, on every harness kendex installs the
# lane-mail-check hook on,
# and whether a lane idle at its prompt is woken for that directive by its own
# mailbox monitor, on the harnesses whose background wake starts a turn.
# Where the harness runs that hook, the lane-mail row runs a one-turn lane
# session that makes two tool calls, sends the directive at the first of them,
# and passes only where the lane read it and its cursor moved. Where the
# harness runs no hooks, the lane's own workflow reads the mailbox at a wait
# point instead, so the row asks that harness's listing for the instruction
# kendex rendered there and reports advisory, never pass.
#
# One row per harness per question, and only for the kinds that harness
# installs: skill and hook everywhere; agent everywhere but Antigravity;
# command on Claude, Codex, OpenCode, Pi and Gemini; mcp on every harness but
# Pi; pi-ext on Pi alone; lane-mail and lane-question everywhere; mail-wake
# on Claude, Codex and Pi. Plugin has no row anywhere —
# `Plugin` has `install: NONE` on all eight harnesses, so kendex renders no
# plugin for one to load — and Antigravity has no agent row for the same
# reason: agy reads agents from its global root alone, so kendex renders no
# project agent for it. A row is `pass`,
# `fail`, `advisory` (the harness runs no hooks; kendex installs text, and
# the row checks the harness lists that text), `unanswerable` (this machine
# or this harness cannot answer, with the reason), or `skipped` (left out by
# --only, or by the frontmatter of the hook a row measures, with its reason).
# Copilot also answers one row per package this checkout ships, under the
# package table below, which adds `differs`, `excluded` and `pending`.
# Silence is never a pass: a run that says nothing about the
# package is a fail, and a run the harness could not complete is
# unanswerable with its last line.
#
# The scratch projects live under tmp/ in this checkout, one git repository
# per harness with the fixture installed for that harness alone, so no harness
# reads them as part of this checkout, no harness answers for another's
# render, and kendex's project-scope writes land nowhere shared. Per-harness gates the check has to
# open, each said on its row: Codex runs project hooks only after persisted
# hook trust, so the exec run carries --dangerously-bypass-hook-trust, and it
# reads a project's `config.toml` only once that project is trusted, so every
# codex run goes through an isolated CODEX_HOME that trusts the scratch
# project and keeps `codex exec`'s own trust write out of the real config;
# a project `.mcp.json` server starts as pending approval on Claude, so its
# mcp row runs under an isolated CLAUDE_CONFIG_DIR that approves it; Copilot
# runs repository hooks only for a folder its settings name in
# `trustedFolders`, so its runs use an isolated COPILOT_HOME that copies the
# login record and trusts the scratch project; Cursor loads a project server
# only after `cursor-agent mcp enable`, which records the approval under
# HOME, so its mcp row runs under an isolated HOME; the hook row on Pi reads
# the pi-hooks carrier's tool_call listener, so it asks the model for one tool
# call. Antigravity reads a project's `.agents/` only for a folder the session
# attaches as a workspace, so every agy run carries `--add-dir` naming the
# scratch project; it has no config-root knob, its root is a fixed `~/.gemini`
# and every run writes conversation state under it, so its runs go through an
# isolated HOME holding a whole copy of `~/.gemini` (a partial copy makes agy
# hang on its login flow).
#
# Exit 0 when every row passed (advisory, skipped, differs and excluded
# included), 1 when any row failed, 2 when the fixture could not be installed
# or `kendex verify` refused it, 3 when nothing failed but a row was
# unanswerable or pending, so a harness that died on the render never reads
# as a clean run. Model turns: seven on claude, three on codex, two on
# antigravity, five on pi, one on gemini, five on copilot, two on cursor when
# logged in.
#
# The report is the row table: one aligned line per row as it is decided, then
# the same rows as a markdown table under `| harness | row | result |
# evidence |`, which is what a reader pastes. Every other line this script
# says for itself opens with `harness-smoke: <key>=<value>` — the key names
# the condition, the value is the path, the count or the short enum the reader
# acts on — and explains itself on the lines under it. message_text is the
# only place a key's English lives. Where a failing command has words of its
# own they are captured and replayed under the keyed line, so the keyed line
# is the first line; each harness's own output goes to its log under LOGS,
# which a row's evidence names.
set -euo pipefail

usage() {
  printf '%s\n' 'usage: tools/harness-smoke [--only h1,h2,...] [--keep] [--dir DIR]' \
    '  --only    run these harnesses (claude codex opencode cursor pi gemini copilot antigravity); the rest print skipped' \
    '  --keep    leave the scratch project and logs in place' \
    '  --dir     parent of the scratch directory this run makes (default: tmp/ in this checkout)'
}

message_text() { # KEY VALUE [EXTRA] — the English for one key, and all of it
  case "$1" in
    argument)
      echo "that argument is not one this script takes."
      usage ;;
    unknown-harness)
      echo "that is not a harness this script installs into." ;;
    missing-tool)
      echo "that command is required and is not on PATH." ;;
    not-in-repo)
      echo "no git repository around that directory, so the scratch parent could not be placed." ;;
    scratch)
      echo "the scratch directory for this run could not be made under that parent." ;;
    kept)
      echo "the scratch project and logs were left in place by --keep." ;;
    add)
      printf 'kendex add did not install for %s; %s says why.\n' "$2" "$3" ;;
    mail-frontmatter)
      echo "that hook could not be read, or its frontmatter gives no event, so the event that hands a lane its mail over is unknown." ;;
    mail-delivery)
      echo "that table gives no lane-mail-check cell for some harness this script installs into, so which harness gets a lane's mail by which mechanism is unknown." ;;
    packages)
      echo "no package of that kind was found there, so the Copilot package table would list none of them: the checkout or this script's reader is broken." ;;
    package-cell)
      echo "hooks/README.md gives no copilot cell for that hook, so whether kendex installs it on Copilot is unknown." ;;
    setup)
      echo "that step of a scratch project could not be taken, so no row could be measured." ;;
    update-pi)
      printf 'kendex update-pi did not install the Pi extension for %s; %s says why.\n' "$2" "$3" ;;
    verify)
      printf 'kendex verify refused the install for %s; %s says why.\n' "$2" "$3" ;;
    verified)
      printf 'kendex verify reads the fixture install for %s in %s as clean.\n' "$2" "$3" ;;
    failed)
      echo "rows where a harness did not load a kendex-installed package." ;;
    unanswerable)
      echo "rows this machine could not answer, with no row failing; each row's evidence gives its reason." ;;
    *)
      echo "no explanation is defined for this key: tools/harness-smoke is broken." ;;
  esac
}
note() { # KEY VALUE [EXTRA] — a verdict this run reached, on stdout
  printf 'harness-smoke: %s=%s\n' "$1" "$2"
  message_text "$@"
}
say() { # KEY VALUE [EXTRA] — a refusal, on stderr
  printf 'harness-smoke: %s=%s\n' "$1" "$2" >&2
  message_text "$@" >&2
}
refuse() { # KEY VALUE [EXTRA] — nothing was measured
  say "$@"
  exit 2
}
refuse_cause() { # KEY VALUE CAUSE — CAUSE is the failing command's own words
  # Captured and replayed under the keyed line rather than left to reach the
  # stream first: the refusal's first line has to be the keyed one, and the
  # command's own words are still what name the cause.
  say "$1" "$2"
  [ -z "$3" ] || printf '%s\n' "$3" >&2
  exit 2
}

HARNESSES="claude codex opencode cursor pi gemini copilot antigravity"
ONLY="$HARNESSES"
KEEP=0
DIR=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --only)
      [ "$#" -ge 2 ] || refuse argument --only
      ONLY=$(printf '%s' "$2" | tr ',' ' ')
      for h in $ONLY; do
        case " $HARNESSES " in *" $h "*) ;; *) refuse unknown-harness "$h" ;; esac
      done
      shift 2 ;;
    --keep) KEEP=1; shift ;;
    --dir)
      [ "$#" -ge 2 ] || refuse argument --dir
      DIR=$2; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) refuse argument "$1" ;;
  esac
done

for tool in kendex git jq node; do
  command -v "$tool" >/dev/null 2>&1 || refuse missing-tool "$tool"
done

# git's own diagnostic is asked for only once this has failed, so the happy
# path runs it once and the refusal path replays what it said.
ROOT=$(git rev-parse --show-toplevel 2>/dev/null) ||
  refuse_cause not-in-repo "$PWD" "$(git rev-parse --show-toplevel 2>&1 >/dev/null)"
# The catalog the lane-mail row installs from is this script's own checkout,
# which is the one whose hook it measures; ROOT is wherever the run stands.
SELF=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd -P)
# The run owns a fresh subtree under the parent it was given, and the
# cleanup below removes that subtree alone: --dir tmp must not empty tmp/.
PARENT=${DIR:-$ROOT/tmp}
scratch_err=""
scratch_err=$(mkdir -p "$PARENT" 2>&1) || refuse_cause scratch "$PARENT" "$scratch_err"
DIR=$(mktemp -d "$PARENT/harness-smoke.XXXXXX" 2>/dev/null) ||
  refuse_cause scratch "$PARENT" "$(mktemp -d "$PARENT/harness-smoke.XXXXXX" 2>&1 >/dev/null)"
DIR=$(cd "$DIR" 2>/dev/null && pwd -P) ||
  refuse_cause scratch "$PARENT" "$(cd "$DIR" 2>&1 >/dev/null || true)"
cleanup() {
  if [ "$KEEP" -eq 1 ]; then
    note kept "$DIR"
  else
    rm -rf -- "${DIR:?}"
  fi
}
trap cleanup EXIT

CATALOG="$DIR/catalog"
LOGS="$DIR/logs"
SERVER="$DIR/mcp-server.mjs"
mkdir -p "$CATALOG/skills/smoke-skill" "$CATALOG/agents" "$CATALOG/hooks" \
  "$CATALOG/commands" "$CATALOG/mcp" "$CATALOG/pi-extensions/smoke-ext/extensions" "$LOGS"

# ---- the fixture catalog ---------------------------------------------------
# Each item answers with a token no harness would emit on its own, and each
# hook appends the event and its own rendered path to the marker, so a row can
# tell the harness's copy of the script from a cross-read of another tool's.
# The MCP server and the Pi extension append their own line to the same
# marker when the harness starts them, which is the second proof on the rows
# whose listing reports a live connection rather than a config reading.
COMMAND_ANSWER=SMOKE-COMMAND-LOADED
COMMAND_BODY="Reply with exactly $COMMAND_ANSWER and nothing else."
cat >"$CATALOG/kendex.toml" <<'EOF'
is_source_catalog = true

[marketplace]
name = "harness-smoke"
description = "Fixture catalog for tools/harness-smoke"
author = "kendex"
license = "MIT"
EOF
cat >"$CATALOG/skills/smoke-skill/SKILL.md" <<'EOF'
---
name: smoke-skill
description: "Harness smoke fixture skill: proves a kendex-rendered skill loads."
---

# Smoke skill

When this skill is invoked, reply with exactly SMOKE-SKILL-LOADED and nothing else.
EOF
cat >"$CATALOG/agents/smoke-agent.md" <<'EOF'
---
name: smoke-agent
description: Harness smoke fixture agent; proves a kendex-rendered agent loads.
---

You are the smoke agent. Reply with exactly SMOKE-AGENT-LOADED and nothing else.
EOF
# The Copilot package table's subagent row: this agent knows the answer only
# from the repository instructions that table's project carries.
cat >"$CATALOG/agents/smoke-rules.md" <<'EOF'
---
name: smoke-rules
description: Harness smoke fixture agent; proves a kendex-rendered agent run as a subagent reads the repository's instructions.
---

Reply with exactly the value your repository instructions give for SMOKE-RULES, or with exactly NO-RULES when they give none, and nothing else.
EOF
cat >"$CATALOG/commands/smoke-command.md" <<EOF
---
description: "Harness smoke fixture command: proves a kendex-rendered command loads."
---

$COMMAND_BODY
EOF
# Both hooks name every harness: Antigravity is reached only by a hook whose
# `harnesses:` line names it (its payload is `toolCall.args`, not
# `tool_input`), and an unnamed hook installs nothing there with a note.
HOOK_HARNESSES='[claude-code, codex, opencode, cursor, pi, gemini, copilot, antigravity]'
hook_body() { # EVENT — the shared body every fixture hook runs
  cat <<EOF
set -euo pipefail
root=\$(git rev-parse --show-toplevel)
printf '%s %s\\n' "$1" "\$0" >>"\$root/smoke-fired"
EOF
  # The lane-mail rows need the overseer's send to land after the lane's first
  # tool call and exactly once. A sentinel the row drops at the project root is
  # claimed by a rename and then run, so a second tool call finds nothing and
  # every other row, which drops none, runs this body unchanged.
  if [ "$1" = PreToolUse ]; then
    cat <<'EOF'
if [ -x "$root/smoke-sentinel" ] && mv -- "$root/smoke-sentinel" "$root/smoke-sent"; then
  "$root/smoke-sent" >>"$root/smoke-sent.log" 2>&1 || :
fi
EOF
  fi
  printf 'exit 0\n'
}
{
  cat <<EOF
#!/usr/bin/env bash
# ---
# name: smoke-session
# event: SessionStart
# description: Harness smoke fixture hook; appends its event and path to smoke-fired at the project root when the harness runs it.
# safety: Writes one file at the project root and nothing else.
# timeout: 10
# harnesses: $HOOK_HARNESSES
# ---
EOF
  hook_body SessionStart
} >"$CATALOG/hooks/smoke-session.sh"
{
  cat <<EOF
#!/usr/bin/env bash
# ---
# name: smoke-tool
# event: PreToolUse
# description: Harness smoke fixture hook; appends its event and path to smoke-fired at the project root before a tool runs.
# safety: Appends to two files at the project root, and where a row planted one, renames smoke-sentinel to smoke-sent and runs it once; never refuses a tool.
# timeout: 10
# harnesses: $HOOK_HARNESSES
# ---
EOF
  hook_body PreToolUse
} >"$CATALOG/hooks/smoke-tool.sh"
chmod +x "$CATALOG/hooks/smoke-session.sh" "$CATALOG/hooks/smoke-tool.sh"

# The server is a real stdio MCP endpoint, so a harness that starts it gets an
# `initialize` and a `tools/list` it accepts rather than a process that dies
# and reads as a broken render. It writes its marker line before anything
# else, so a start that the harness then rejects still leaves the proof.
cat >"$SERVER" <<'EOF'
#!/usr/bin/env node
import { appendFileSync } from 'node:fs';
try { appendFileSync(process.cwd() + '/smoke-fired', `McpStart ${process.cwd()}\n`); } catch {}
let buf = '';
process.stdin.on('data', (chunk) => {
  buf += chunk;
  let cut;
  while ((cut = buf.indexOf('\n')) >= 0) {
    const line = buf.slice(0, cut);
    buf = buf.slice(cut + 1);
    if (!line.trim()) continue;
    let msg;
    try { msg = JSON.parse(line); } catch { continue; }
    if (msg.id === undefined) continue;
    let result = {};
    if (msg.method === 'initialize') {
      result = {
        protocolVersion: msg.params?.protocolVersion || '2025-06-18',
        capabilities: { tools: {} },
        serverInfo: { name: 'smoke-mcp', version: '1.0.0' },
      };
    } else if (msg.method === 'tools/list') {
      result = { tools: [{
        name: 'smoke_mcp_loaded',
        description: 'Returns SMOKE-MCP-LOADED.',
        inputSchema: { type: 'object', properties: {}, additionalProperties: false },
      }] };
    } else if (msg.method === 'tools/call') {
      result = { content: [{ type: 'text', text: 'SMOKE-MCP-LOADED' }] };
    }
    process.stdout.write(JSON.stringify({ jsonrpc: '2.0', id: msg.id, result }) + '\n');
  }
});
process.stdin.on('end', () => process.exit(0));
EOF
printf 'command = "node"\nargs = ["%s"]\n' "$SERVER" >"$CATALOG/mcp/smoke-mcp.toml"

# The Pi extension is an npm package Pi loads on any start. Its package name
# is the name the carrier installs under and the name the install record is
# checked against, so the directory, the package name and the manifest key
# below are one word.
cat >"$CATALOG/pi-extensions/smoke-ext/package.json" <<'EOF'
{
  "name": "smoke-ext",
  "version": "1.0.0",
  "description": "Harness smoke fixture Pi extension; proves a kendex-installed Pi extension loads.",
  "license": "MIT",
  "keywords": ["pi-package", "pi"],
  "pi": { "extensions": ["./extensions/smoke.js"] },
  "files": ["extensions/", "package.json"],
  "author": "kendex",
  "engines": { "node": ">=22.19.0" }
}
EOF
cat >"$CATALOG/pi-extensions/smoke-ext/extensions/smoke.js" <<'EOF'
import { appendFileSync } from "node:fs";
try {
  appendFileSync(process.cwd() + "/smoke-fired", `PiExtension ${process.cwd()}\n`);
} catch {}
export default function activate() {}
EOF

# ---- one scratch project per harness ---------------------------------------
# Every harness gets the fixture installed for it alone. Several tools
# cross-read another tool's directories (Copilot reads .claude/agents and
# .claude/settings.json, Gemini and Codex read .agents/skills), so an
# all-harness install would let one harness answer for another's render.
PROJECT=""
MARKER=""
add_flags() { # HARNESS — the kendex add flags for the kinds it installs
  # `crates/core/src/harness/caps.rs::capabilities` is the source: a harness
  # whose `install` is NONE for a kind has no render to ask about, so the
  # kind is left out here and the harness gets no row for it below.
  printf '%s' '--skill smoke-skill --hook smoke-session,smoke-tool'
  case "$1" in
    claude | codex | opencode | cursor | pi | gemini | copilot) printf ' %s' '--agent smoke-agent' ;;
  esac
  case "$1" in
    claude | codex | opencode | pi | gemini) printf ' %s' '--command smoke-command' ;;
  esac
  case "$1" in
    claude | codex | opencode | cursor | gemini | copilot | antigravity)
      printf ' %s' '--mcp-server smoke-mcp' ;;
  esac
}
refused() { # KEY HARNESS LOG — the fixture install did not finish
  KEEP=1
  refuse "$@"
}
# One effectful step of a scratch project. Its own words are captured and
# replayed under the keyed refusal, so a failure refuses with exit 2 and keeps
# the scratch tree, rather than aborting mid-table under errexit with the
# command's own status — outside the 0/1/2/3 contract, before a row has
# printed, and while KEEP is still 0 so the trap deletes the logs.
setup() { # WHAT CMD... — WHAT names the step on the keyed line
  local what=$1 err=""
  shift
  err=$("$@" 2>&1) && return 0
  KEEP=1
  refuse_cause setup "$what" "$err"
}
scratch_repo() { # DIR — a git repository with one commit and an empty project manifest
  setup 'the scratch project directory' mkdir -p "$1/.agents"
  setup 'the scratch repository' git -C "$1" init -q
  setup "the scratch repository's identity" \
    git -C "$1" config user.email harness-smoke@kendex.invalid
  setup "the scratch repository's identity" \
    git -C "$1" config user.name harness-smoke
  setup "the scratch repository's first commit" \
    git -C "$1" commit -q --allow-empty -m 'scratch project for tools/harness-smoke'
  printf 'schema = 6\n' >"$1/kendex.toml"
}
install_for() { # HARNESS — sets PROJECT and MARKER, exits 2 when kendex cannot install or verify
  PROJECT="$DIR/$1/project"
  MARKER="$PROJECT/smoke-fired"
  scratch_repo "$PROJECT"
  # shellcheck disable=SC2046 # add_flags emits whole flags to be split.
  if ! (cd "$PROJECT" && kendex add "$CATALOG" $(add_flags "$1") --harness "$1" -y) \
    >"$LOGS/$1-kendex-add.log" 2>&1; then
    refused add "$1" "$LOGS/$1-kendex-add.log"
  fi
  if [ "$1" = pi ]; then
    # `kendex add --pi-extension` refuses by design: a Pi extension is
    # declared under [pi-extensions] in the scope's manifest and installed by
    # the update-pi verb, which is the second install verb no other row
    # touches. `catalog` is the source name kendex derived from $CATALOG's
    # basename in the add above.
    printf '\n[pi-extensions.smoke-ext]\nsource = "catalog"\nharnesses = ["pi"]\n' \
      >>"$PROJECT/kendex.toml"
    if ! (cd "$PROJECT" && kendex update-pi) >"$LOGS/$1-kendex-update-pi.log" 2>&1; then
      refused update-pi "$1" "$LOGS/$1-kendex-update-pi.log"
    fi
  fi
  if ! (cd "$PROJECT" && kendex verify --scope project) >"$LOGS/$1-kendex-verify.log" 2>&1; then
    refused verify "$1" "$LOGS/$1-kendex-verify.log"
  fi
  note verified "$1" "$PROJECT"
}

# ---- rows ------------------------------------------------------------------
FAILED=0
UNANSWERED=0
ROWS=""
row() { # HARNESS QUESTION RESULT EVIDENCE
  case "$3" in
    fail) FAILED=$((FAILED + 1)) ;;
    unanswerable | pending) UNANSWERED=$((UNANSWERED + 1)) ;;
  esac
  ROWS="$ROWS$(printf '| %s | %s | %s | %s |' "$1" "$2" "$3" "$4")
"
  printf '%-11s %-9s %-12s %s\n' "$1" "$2" "$3" "$4"
}
have() { command -v "$1" >/dev/null 2>&1; }
TIMEOUT=""
have timeout && TIMEOUT="timeout 300"
# Runs a harness command inside the scratch project with no stdin, both
# streams to LOGS/NAME.log; OUT holds the text and STATUS the exit code.
# Every read of OUT below is a here-string, never a printf pipeline: under
# pipefail a grep that stops early would SIGPIPE the producer and turn a
# present match into an absent one.
OUT=""
STATUS=0
run() { # NAME CMD... — cwd is the scratch project
  local name=$1
  shift
  STATUS=0
  # shellcheck disable=SC2086 # TIMEOUT is empty or the two words `timeout 300`.
  OUT=$(cd "$PROJECT" && $TIMEOUT "$@" </dev/null 2>&1) || STATUS=$?
  printf '%s\n' "$OUT" >"$LOGS/$name.log"
}
last_line() { grep -v '^[[:space:]]*$' <<<"$OUT" | tail -n 1; }
# The redirect is inside the group, so a missing marker takes the shell's own
# diagnostic with it instead of printing it beside the row's real one.
marker_text() { { tr '\n' ';' <"$MARKER"; } 2>/dev/null; }
ESC=$(printf '\033')
clip() { # TEXT — one evidence cell: colour, leading space and pipes gone, at most 160 characters
  printf '%s' "$1" | sed -e "s/$ESC\\[[0-9;]*m//g" -e 's/^[[:space:]]*//' -e 's/|/¦/g' | cut -c1-160
}
# Judges OUT against what a loaded package makes the harness say. EXPECT is
# the harness's yes, REJECT its explicit no; a run that ended non-zero with
# neither is the harness failing to answer, and an answer with neither is a
# fail because silence is not a pass. A model-relayed row anchors EXPECT to
# a whole line, because a model asked for names it does not have tends to
# name the missing thing in its denial. MARKER-LINE, where the row has one,
# is a second and independent proof: the listing says the harness read the
# render, and the line the fixture itself wrote says the harness started it.
judge() { # HARNESS QUESTION EXPECT REJECT COMMAND-TEXT [MARKER-LINE]
  local hit
  if hit=$(grep -oE -m 1 -e "$3" <<<"$OUT") && [ -n "$hit" ]; then
    hit=${hit%%$'\n'*}
    if [ -z "${6:-}" ]; then
      row "$1" "$2" pass "$5 said: $(clip "$hit")"
    elif [ -f "$MARKER" ] && grep -qF -- "$6" "$MARKER"; then
      row "$1" "$2" pass "$5 said: $(clip "$hit"), and the fixture wrote '$6'"
    else
      row "$1" "$2" fail "$5 said: $(clip "$hit"), and the fixture never wrote '$6' (marker: $(marker_text))"
    fi
  elif [ -n "$4" ] && hit=$(grep -E -m 1 -e "$4" <<<"$OUT") && [ -n "$hit" ]; then
    row "$1" "$2" fail "$5 said: $(clip "$hit")"
  elif [ "$STATUS" -ne 0 ]; then
    row "$1" "$2" unanswerable "$5 exited $STATUS: $(clip "$(last_line)")"
  else
    row "$1" "$2" fail "$5 did not say $(clip "$3"); its last line: $(clip "$(last_line)")"
  fi
}
fired() { # HARNESS EVENT RENDER-PATH COMMAND-TEXT — reads the marker
  if [ -f "$MARKER" ] && grep -qF -- "$2 $PROJECT/$3" "$MARKER"; then
    row "$1" hook pass "$4 ran $3 at $2"
  elif [ "$STATUS" -ne 0 ] && ! grep -qiE 'hook' <<<"$OUT"; then
    row "$1" hook unanswerable "$4 exited $STATUS before any hook ran: $(clip "$(last_line)")"
  else
    row "$1" hook fail "$4 did not run $3 at $2 (marker: $(marker_text))"
  fi
}
# Reads one value out of the JSON a harness printed, into JSON_HIT. A harness
# that printed no JSON answered nothing the row can read, so the caller fails
# the row rather than reading an empty extraction as an absent package.
JSON_HIT=""
extract() { # JQ-FILTER [JQ-FLAGS...]
  local filter=$1
  shift
  JSON_HIT=""
  JSON_HIT=$(jq -r "$@" "$filter" <<<"$OUT" 2>/dev/null)
}
located() { # HARNESS QUESTION RENDER-PATH COMMAND-TEXT JQ-FILTER [JQ-FLAGS...] — a listing that carries the item's path
  local harness=$1 question=$2 rendered="$PROJECT/$3" command=$4
  shift 4
  if [ "$STATUS" -ne 0 ]; then
    row "$harness" "$question" unanswerable "$command exited $STATUS: $(clip "$(last_line)")"
  elif ! extract "$@"; then
    row "$harness" "$question" fail "$command printed no JSON the row can read: $(clip "$(last_line)")"
  elif [ "$JSON_HIT" = "$rendered" ]; then
    row "$harness" "$question" pass "$command lists it at $JSON_HIT"
  else
    row "$harness" "$question" fail "$command lists it at '${JSON_HIT:-nothing}'"
  fi
}
holds() { # HARNESS QUESTION RENDER-PATH COMMAND-TEXT MARKER-LINE — a plain-text listing that names the render
  if ! grep -qF -- "$PROJECT/$3" <<<"$OUT"; then
    if [ "$STATUS" -ne 0 ]; then
      row "$1" "$2" unanswerable "$4 exited $STATUS: $(clip "$(last_line)")"
    else
      row "$1" "$2" fail "$4 did not name $3; its last line: $(clip "$(last_line)")"
    fi
  elif [ -f "$MARKER" ] && grep -qF -- "$5" "$MARKER"; then
    row "$1" "$2" pass "$4 names $3, and the fixture wrote '$5'"
  else
    row "$1" "$2" fail "$4 names $3, and the fixture never wrote '$5' (marker: $(marker_text))"
  fi
}
# ---- the lane-mail row -----------------------------------------------------
# A fleet overseer's directive reaches a lane two ways, and kendex's own hook
# delivery decision says which way each harness gets it. That decision is
# rendered per harness into the `lane-mail-check` row of hooks/README.md by
# `crates/core/tests/hooks_readme.rs`, which fails when the committed file
# differs, so the row is where the answer already lives and reading it is
# reading the hook's frontmatter through its owner rather than parsing that
# frontmatter a second time. `enforced` means the hook's event hands the
# directive over at the turn's end, so the row runs a one-turn lane session and
# passes only where the lane read the directive and the mailbox cursor moved.
# `advisory` — OpenCode and Cursor run no hooks — means the lane's workflow
# reads the mailbox at a wait point, so the row asks that harness's own listing
# for the instruction kendex rendered there and reports `advisory`, never
# `pass`. Any other cell is the hook's own reason that harness does not run it,
# and the row carries that reason. Only the event name still comes from the
# hook, which the table does not carry. The row's evidence opens
# `harness=<id> delivery=<arm|wait-point|none>` in the table that already has a
# harness and a row column, and it is each harness's last row because its
# install adds the hook and the orch skill carrying its reader over the fixture.
MAIL_ITEM=SMOKE-1
MAIL_LOWER=$(printf '%s' "$MAIL_ITEM" | tr '[:upper:]' '[:lower:]')
MAIL_ANSWER=SMOKE-MAIL-DELIVERED
MAIL_TASK='Run the shell command true, then run the shell command true a second time, then reply with exactly: ok'
MAIL_HOOK="$SELF/hooks/lane-mail-check.sh"
MAIL_TABLE="$SELF/hooks/README.md"
[ -r "$MAIL_HOOK" ] || refuse mail-frontmatter "$MAIL_HOOK"
MAIL_ARM=""
MAIL_ARM=$(sed -n 's/^# event: \(.*\)$/\1/p' "$MAIL_HOOK") || refuse mail-frontmatter "$MAIL_HOOK"
[ -n "$MAIL_ARM" ] || refuse mail-frontmatter "$MAIL_HOOK"
# The header row names the column each harness owns; the escape the renderer
# writes for a `|` inside a cell is undone here, so the cell reads as the
# reason the hook's description gives.
MAIL_CELL_ERR="$DIR/mail-cell.err"
mail_cell() { # HARNESS [HOOK] — the HOOK's cell, lane-mail-check unless named; awk's own words go to MAIL_CELL_ERR
  awk -v harness="$1" -v hook="${2:-lane-mail-check}" '
    BEGIN { FS = " \\| " }
    $1 == "| Hook" {
      for (i = 2; i <= NF; i++) {
        name = $i
        sub(/ \|$/, "", name)
        if (name == harness) col = i
      }
      next
    }
    col && $1 == "| `" hook "`" {
      cell = $col
      sub(/ \|$/, "", cell)
      gsub(/\\\|/, "|", cell)
      print cell
      exit
    }
  ' "$MAIL_TABLE" 2>"$MAIL_CELL_ERR"
}
# A table this could not read would leave every harness without a mechanism and
# every row skipped, which is a run that says nothing about delivery and passes.
# Every harness resolving here is what lets the calls below read the cell
# without a second refusal path; awk's own words are replayed under the keyed
# line rather than reaching the stream ahead of it.
for mail_harness in $HARNESSES; do
  for mail_hook in lane-mail-check lane-mail-halt; do
    mail_check=""
    mail_check=$(mail_cell "$mail_harness" "$mail_hook") ||
      refuse_cause mail-delivery "$MAIL_TABLE" "$(cat -- "$MAIL_CELL_ERR")"
    [ -n "$mail_check" ] || refuse mail-delivery "$MAIL_TABLE"
  done
done
printf 'Reply with exactly %s and nothing else.\n' "$MAIL_ANSWER" >"$DIR/mail-directive.txt"
MAIL_BOX=""
MAIL_READER=""
MAIL_CURSOR=""
mail_skipped() { # HARNESS CELL — the row for a harness the hook does not run on
  row "$1" lane-mail skipped "harness=$1 skipped=$2"
}
# The cursor the reader owns is the second half of every verdict below: it says
# the mailbox handed the directive over rather than a second read handing it
# over again.
mail_moved() { # — reads to-lane.cursor into MAIL_CURSOR; 1 where it did not advance
  MAIL_CURSOR=$(cat -- "$MAIL_BOX/to-lane.cursor" 2>/dev/null) || MAIL_CURSOR=""
  case "$MAIL_CURSOR" in '' | 0 | *[!0-9]*) return 1 ;; esac
}
# A send that ran detached from the lane, in the fixture hook with a trailing
# `|| :` or beside the session, is told from one that never ran only by what it
# wrote. A sentinel still standing is a hook that never ran it: the lane made no
# tool call.
mail_send_cause() { # LOG — the send's own last line, or where to look for it
  local log=$1 text=""
  if [ -e "$PROJECT/smoke-sentinel" ]; then
    printf 'the lane made no tool call, so the send never ran'
    return 0
  fi
  [ -s "$log" ] || { printf 'the send wrote nothing to %s' "$log"; return 0; }
  text=$(grep -v '^[[:space:]]*$' -- "$log" | tail -n 1) || text=""
  printf 'the send said: %s' "$(clip "$text")"
}
# Both proofs or neither: the lane said the directive reached it, and the cursor
# says the mailbox handed it over. The one verdict both mail rows reach.
mail_proof() { # HARNESS ROW DELIVERY LABEL LOG — OUT holds the lane session
  local moved=1
  mail_moved || moved=0
  if ! grep -qE -e "^$MAIL_ANSWER\$" <<<"$OUT"; then
    if [ "$STATUS" -ne 0 ]; then
      row "$1" "$2" unanswerable "harness=$1 $4 exited $STATUS: $(clip "$(last_line)")"
    else
      row "$1" "$2" fail "harness=$1 delivery=none: $4 never said $MAIL_ANSWER (to-lane.cursor: ${MAIL_CURSOR:-unset}); $(mail_send_cause "$5"); its last line: $(clip "$(last_line)")"
    fi
  elif [ "$moved" -eq 1 ]; then
    row "$1" "$2" pass "harness=$1 delivery=$3: $4 said $MAIL_ANSWER, and to-lane.cursor advanced to $MAIL_CURSOR"
  else
    row "$1" "$2" fail "harness=$1 delivery=none: $4 said $MAIL_ANSWER, and to-lane.cursor did not advance (to-lane.cursor: ${MAIL_CURSOR:-unset})"
  fi
}
# The advisory verdict: the harness's own listing says kendex put the wait point
# where that harness reads it, and the cursor says the mailbox handed the
# directive over. Neither half is the harness running a hook, so the row is
# `advisory` and never `pass`.
mail_advisory() { # HARNESS LISTED COMMAND-TEXT — OUT holds the harness's listing
  local moved=1
  if [ "$STATUS" -ne 0 ]; then
    row "$1" lane-mail unanswerable "harness=$1 $3 exited $STATUS: $(clip "$(last_line)")"
    return
  fi
  if ! grep -qE -e "$2" <<<"$OUT"; then
    row "$1" lane-mail fail "harness=$1 delivery=none: $3 does not list $2; its last line: $(clip "$(last_line)")"
    return
  fi
  run "$1-lane-mail-inbox" "$MAIL_READER" inbox --item "$MAIL_ITEM"
  # The reader owns the cursor, so a read that could not run says nothing about
  # delivery. Judging its empty output would report `fail` and exit 1 for a
  # machine the script's own contract calls unanswerable.
  if [ "$STATUS" -ne 0 ]; then
    row "$1" lane-mail unanswerable "harness=$1 the mailbox read exited $STATUS: $(clip "$(last_line)")"
    return
  fi
  mail_moved || moved=0
  if ! grep -qF -- "$MAIL_ANSWER" <<<"$OUT"; then
    row "$1" lane-mail fail "harness=$1 delivery=none: $3 lists $2, and the mailbox handed no directive over: $(clip "$(last_line)")"
  elif [ "$moved" -eq 1 ]; then
    row "$1" lane-mail advisory "harness=$1 delivery=wait-point: no hook runs on $1; $3 lists $2, and to-lane.cursor advanced to $MAIL_CURSOR"
  else
    row "$1" lane-mail fail "harness=$1 delivery=none: $3 lists $2, and to-lane.cursor did not advance (to-lane.cursor: ${MAIL_CURSOR:-unset})"
  fi
}
mail_row() { # HARNESS LABEL LISTED [CMD...]
  # LABEL is the evidence's command text, and the reason there was no run where
  # CMD is absent. On an `enforced` harness CMD is the one-turn lane session the
  # hook's event fires in and LISTED is empty; on an `advisory` harness CMD is
  # that harness's own listing and LISTED is the pattern that listing has to
  # carry, anchored the way that listing needs.
  local harness=$1 label=$2 listed=$3 cell="" marker_err=""
  shift 3
  cell=$(mail_cell "$harness")
  case "$cell" in
    enforced | advisory) ;;
    *) mail_skipped "$harness" "$cell"; return ;;
  esac
  if [ "$#" -eq 0 ]; then
    row "$harness" lane-mail unanswerable "harness=$harness $label, and $MAIL_TABLE reads $cell"
    return
  fi
  MAIL_BOX="$PROJECT/tmp/lane-mail/$MAIL_ITEM"
  MAIL_READER="$PROJECT/.agents/skills/orch/scripts/lane-mail"
  if ! (cd "$PROJECT" && kendex add "$SELF" --hook lane-mail-check --skill orch --harness "$harness" -y) \
    >"$LOGS/$harness-kendex-add-mail.log" 2>&1; then
    refused add "$harness" "$LOGS/$harness-kendex-add-mail.log"
  fi
  if ! (cd "$PROJECT" && kendex verify --scope project) >"$LOGS/$harness-kendex-verify-mail.log" 2>&1; then
    refused verify "$harness" "$LOGS/$harness-kendex-verify-mail.log"
  fi
  # A mailbox is a lane's only where a launch recorded the lane's root under
  # the common git directory, and the lane is the mailbox its branch names, as
  # `worktree create` names one. With neither the hook passes silently.
  setup "the lane's branch" git -C "$PROJECT" checkout -q -b "$MAIL_LOWER"
  setup "the lane-mail directory" mkdir -p "$PROJECT/.git/lane-mail"
  marker_err=$( { printf '%s' "$PROJECT" >"$PROJECT/.git/lane-mail/$MAIL_LOWER"; } 2>&1 ) || {
    KEEP=1
    refuse_cause setup "the lane's launch marker" "$marker_err"
  }
  if [ "$cell" = advisory ]; then
    run "$harness-lane-mail-send" "$MAIL_READER" send --item "$MAIL_ITEM" --root "$PROJECT" \
      --directive --file "$DIR/mail-directive.txt"
    [ "$STATUS" -eq 0 ] || {
      row "$harness" lane-mail unanswerable "harness=$harness the overseer send exited $STATUS: $(clip "$(last_line)")"
      return
    }
    run "$harness-lane-mail" "$@"
    mail_advisory "$harness" "$listed" "$label"
  else
    # %q on every value: these are executable shell source the hook runs, and
    # a checkout or --dir path holding a quote, a backtick or `$(` would
    # otherwise be re-parsed there rather than read as the path it is.
    printf '#!/usr/bin/env bash\nexec %q send --item %q --root %q --directive --file %q\n' \
      "$MAIL_READER" "$MAIL_ITEM" "$PROJECT" "$DIR/mail-directive.txt" >"$PROJECT/smoke-sentinel"
    chmod +x "$PROJECT/smoke-sentinel"
    run "$harness-lane-mail" "$@"
    mail_proof "$harness" lane-mail "arm ($MAIL_ARM)" "$label" "$PROJECT/smoke-sent.log"
  fi
}
# KEN-1486 shipped the halt: `lane-mail send --halt`, and two thin hooks that
# run lane-mail-check from beside themselves, lane-mail-deliver after a tool
# call and lane-mail-halt before one. A halt row belongs beside this one and
# reads its mechanism from the `lane-mail-halt` row of the same table, which
# carries the same cells as lane-mail-check. It asserts that the lane's next
# tool call is refused on `lane-mail-check: halt=<id>` while the directive
# stands, and passes once the lane's own inbox read acknowledges it. It is not
# here because no arm row can be run on this machine: the accounts these rows
# need are at their usage limits.

# ---- the lane-question row -------------------------------------------------
# A lane asks its overseer only through lane mail, and the lane-mail-halt
# hook refuses the harness question tool in a launched lane under the judge's
# `lane-mail-check: question-tool=<name>`. The row runs on the lane the
# lane-mail row left, whose install already carries the halt hook as the
# judge's companion, and asks the model to call that harness's question tool
# and relay the first line of the refusal. Whether the harness runs the hook
# is the `lane-mail-halt` cell of the same table the lane-mail row reads. A
# harness whose print mode offers the model no question tool cannot answer,
# and says so with QUESTION_NONE; the refusal itself is measured only where a
# call reached the hook.
QUESTION_NONE=NO-QUESTION-TOOL
question_task() { # TOOL — the lane session's prompt
  printf 'Ask me one question with your %s tool: red or blue. If that tool call is refused, reply with exactly the first line of the refusal and nothing else. If you have no %s tool, reply with exactly: %s' \
    "$1" "$1" "$QUESTION_NONE"
}
question_row() { # HARNESS TOOL LABEL [CMD...]
  local harness=$1 tool=$2 label=$3 cell="" hit=""
  shift 3
  cell=$(mail_cell "$harness" lane-mail-halt)
  case "$cell" in
    enforced) ;;
    advisory)
      row "$harness" lane-question skipped "harness=$harness skipped=advisory: no hook runs on $harness, and the launch words skill-rules.md § Coordination lists are the lane's rule there"
      return
      ;;
    *) row "$harness" lane-question skipped "harness=$harness skipped=$cell"; return ;;
  esac
  if [ "$#" -eq 0 ]; then
    row "$harness" lane-question unanswerable "harness=$harness $label, and $MAIL_TABLE reads $cell"
    return
  fi
  if ! (cd "$PROJECT" && kendex add "$SELF" --hook lane-mail-halt --harness "$harness" -y) \
    >"$LOGS/$harness-kendex-add-question.log" 2>&1; then
    refused add "$harness" "$LOGS/$harness-kendex-add-question.log"
  fi
  run "$harness-lane-question" "$@"
  # Both answers are anchored to a whole line: a harness that echoes the
  # prompt prints QUESTION_NONE mid-line before the model has said anything.
  if hit=$(grep -E -m 1 -e "^lane-mail-check: question-tool=$tool\$" <<<"$OUT") && [ -n "$hit" ]; then
    row "$harness" lane-question pass "harness=$harness refusal=question-tool: $label said: $(clip "$hit")"
  elif grep -qE -e "^$QUESTION_NONE\$" <<<"$OUT"; then
    row "$harness" lane-question unanswerable "harness=$harness $label said $QUESTION_NONE: no $tool tool reaches the model in this mode, so no call reached the hook"
  elif [ "$STATUS" -ne 0 ]; then
    row "$harness" lane-question unanswerable "harness=$harness $label exited $STATUS: $(clip "$(last_line)")"
  else
    row "$harness" lane-question fail "harness=$harness refusal=none: $label never said lane-mail-check: question-tool=$tool; its last line: $(clip "$(last_line)")"
  fi
}

# ---- the mail-wake row -----------------------------------------------------
# A lane idle at its prompt runs no hook, so the lane-mail row above never
# reaches it: its own mailbox monitor, `lane-mail watch` under the harness's
# background wake (skills/orch/references/watch-delivery.md § Lane mailbox
# monitor), is what starts its next turn. The row asks the lane to arm that
# monitor and end its turn. A sender beside the session waits for the watch's
# first liveness record, the monitor armed, then WAKE_DELAY seconds more, so
# the directive lands once that turn is over; the directive asks the lane to
# repeat the announcement that woke it, which a lane that polled its inbox by
# itself never sees. A session that answers `armed` and exits is print mode
# ending with the turn, not a monitor that failed, and is unanswerable. Whether
# the monitor armed is read from the sender's log, recorded while the session
# ran, never from to-lane.watch after it: the watch withdraws that record when
# it is stopped. It runs
# before the lane-mail row, whose install adds the hook that would hand the
# directive over at the turn's end instead, and on an item of its own, so
# neither row reads the other's cursor. Codex has no row to run: Codex starts
# no turn for output that arrives after a turn ended, and a Codex lane is
# reached by `open-terminal --wake`.
WAKE_ITEM=SMOKE-2
WAKE_DELAY=30
WAKE_READER="$SELF/skills/orch/scripts/lane-mail"
WAKE_SKIPPED='Codex starts no turn for output that arrives after a turn ended; a Codex lane is reached by open-terminal --wake'
WAKE_ANNOUNCED="lane-mail: mail=$WAKE_ITEM new=1"
WAKE_ARMED='smoke-wake: monitor-armed'
printf 'Reply with exactly two lines and nothing else: %s, then the first line of the monitor event that woke you.\n' \
  "$MAIL_ANSWER" >"$DIR/wake-directive.txt"
wake_task() { # ARM — the lane session's prompt, ARM naming the harness's background wake
  printf '%s on the shell command `%q watch --item %s --root %q`. Then reply with exactly: armed, and end your turn. When the monitor reports mail, run the command its event names, do what the directive it prints says, and then stop the monitor.' \
    "$1" "$WAKE_READER" "$WAKE_ITEM" "$PROJECT"
}
wake_row() { # HARNESS LABEL CMD...
  local harness=$1 label=$2 log="$PROJECT/smoke-wake.log" sender
  shift 2
  MAIL_BOX="$PROJECT/tmp/lane-mail/$WAKE_ITEM"
  setup "the lane's mailbox" mkdir -p "$MAIL_BOX"
  : >"$log"
  (
    cd "$PROJECT" || exit 1
    tries=0
    while [ ! -e "$MAIL_BOX/to-lane.watch" ] && [ "$tries" -lt 240 ]; do
      sleep 1
      tries=$((tries + 1))
    done
    [ -e "$MAIL_BOX/to-lane.watch" ] || exit 0
    printf '%s=%s\n' "$WAKE_ARMED" "$MAIL_BOX/to-lane.watch"
    sleep "$WAKE_DELAY"
    exec "$WAKE_READER" send --item "$WAKE_ITEM" --root "$PROJECT" --directive --file "$DIR/wake-directive.txt"
  ) </dev/null >>"$log" 2>&1 &
  sender=$!
  run "$harness-mail-wake" "$@"
  # The sender outlives a session that ended early; ending it keeps its write
  # out of a scratch tree already removed.
  kill "$sender" 2>/dev/null || :
  wait "$sender" 2>/dev/null || :
  if [ "$STATUS" -eq 0 ] && ! grep -q "^$WAKE_ARMED=" "$log"; then
    row "$harness" mail-wake fail "harness=$harness delivery=none: $label never armed the monitor (no $MAIL_BOX/to-lane.watch while it ran); its last line: $(clip "$(last_line)")"
  elif [ "$STATUS" -eq 0 ] && [ "$(last_line)" = armed ]; then
    row "$harness" mail-wake unanswerable "harness=$harness $label armed the monitor and ended with its turn: print mode starts no turn on the monitor's output"
  elif grep -qE -e "^$MAIL_ANSWER\$" <<<"$OUT" && ! grep -qF -- "$WAKE_ANNOUNCED" <<<"$OUT"; then
    row "$harness" mail-wake fail "harness=$harness delivery=none: $label said $MAIL_ANSWER without the announcement '$WAKE_ANNOUNCED', so no monitor event woke it"
  else
    mail_proof "$harness" mail-wake monitor "$label" "$log"
  fi
}

questions() { # HARNESS — the rows this harness answers, in the order it answers them
  case "$1" in
    claude) printf '%s' 'skill hook agent command mcp mail-wake lane-mail lane-question' ;;
    opencode | gemini) printf '%s' 'skill agent hook command mcp lane-mail lane-question' ;;
    codex) printf '%s' 'skill command agent hook mcp mail-wake lane-mail lane-question' ;;
    pi) printf '%s' 'skill agent command pi-ext hook mail-wake lane-mail lane-question' ;;
    antigravity) printf '%s' 'skill hook mcp lane-mail lane-question' ;;
    *) printf '%s' 'skill agent hook mcp lane-mail lane-question' ;;
  esac
}
every_row() { # HARNESS RESULT EVIDENCE — one row per question this harness answers
  local q cell="" halt_cell=""
  cell=$(mail_cell "$1")
  halt_cell=$(mail_cell "$1" lane-mail-halt)
  for q in $(questions "$1"); do
    # A harness the hook does not run on has its lane-mail and lane-question
    # answers from the table, and Codex its mail-wake answer from its runtime,
    # none of which anything about this machine changes.
    case "$1:$q:$cell:$halt_cell" in
      codex:mail-wake:*) row "$1" "$q" skipped "$WAKE_SKIPPED" ;;
      *:lane-mail:enforced:* | *:lane-mail:advisory:*) row "$1" "$q" "$2" "$3" ;;
      *:lane-mail:*) mail_skipped "$1" "$cell" ;;
      *:lane-question:*:enforced) row "$1" "$q" "$2" "$3" ;;
      *:lane-question:*) question_row "$1" - "$3" ;;
      *) row "$1" "$q" "$2" "$3" ;;
    esac
  done
}
absent() { # HARNESS CLI — every row of a harness whose CLI is not installed
  every_row "$1" unanswerable "$2 is not on PATH"
}
skipped() {
  local q
  for q in $(questions "$1"); do row "$1" "$q" skipped 'not in --only'; done
  [ "$1" != copilot ] || row copilot packages skipped 'not in --only'
}
wants() { case " $ONLY " in *" $1 "*) return 0 ;; esac; return 1; }

# An isolated config dir per harness that gates the project, holding a copy of
# the login record and the one entry that opens the gate. The real config dir
# is read and never written, and nothing here reaches a harness's own state.
copied_home() { # NAME SOURCE-DIR FILE — prints the isolated dir
  local home="$DIR/$1"
  mkdir -p "$home"
  [ -f "$2/$3" ] && cp "$2/$3" "$home/$3"
  printf '%s' "$home"
}

# Claude Code: a slash invocation expands the skill or the command, or answers
# Unknown command; --agent runs the session as that agent or lists what
# exists; the SessionStart registration in .claude/settings.json runs the
# script; `mcp list` reads .mcp.json and starts the server it names.
claude_rows() {
  have claude || { absent claude claude; return; }
  install_for claude
  # Every claude run goes through a CLAUDE_CONFIG_DIR of its own. A project
  # `.mcp.json` server starts as `⏸ Pending approval`, and the approval is
  # recorded per project in the config dir rather than in the render, so the
  # mcp row needs one anyway; using it for the -p runs as well keeps a
  # transcript directory for a dead scratch path out of the real config.
  local home
  home=$(copied_home claude-home "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" .credentials.json)
  jq -n --arg p "$PROJECT" '{hasCompletedOnboarding: true, projects: {($p): {hasTrustDialogAccepted: true, enabledMcpjsonServers: ["smoke-mcp"]}}}' \
    >"$home/.claude.json"
  rm -f -- "$MARKER"
  run claude-skill env CLAUDE_CONFIG_DIR="$home" claude -p '/smoke-skill'
  judge claude skill 'SMOKE-SKILL-LOADED' 'Unknown command' 'claude -p /smoke-skill'
  fired claude SessionStart .claude/hooks/smoke-session.sh 'claude -p'
  run claude-agent env CLAUDE_CONFIG_DIR="$home" claude -p --agent smoke-agent \
    'Reply exactly as your agent instructions say.'
  judge claude agent 'SMOKE-AGENT-LOADED' 'not found' 'claude -p --agent smoke-agent'
  run claude-command env CLAUDE_CONFIG_DIR="$home" claude -p '/smoke-command'
  judge claude command "$COMMAND_ANSWER" 'Unknown command' 'claude -p /smoke-command'
  rm -f -- "$MARKER"
  run claude-mcp env CLAUDE_CONFIG_DIR="$home" claude mcp list
  judge claude mcp 'smoke-mcp: .* Connected' 'smoke-mcp: .*(Pending approval|Failed)' \
    'claude mcp list' "McpStart $PROJECT"
  wake_row claude 'claude -p (arms Monitor, ends its turn)' \
    env CLAUDE_CONFIG_DIR="$home" claude -p "$(wake_task 'Start a Monitor with timeout_ms 120000')"
  mail_row claude 'claude -p (two tool calls, then the turn ends)' '' \
    env CLAUDE_CONFIG_DIR="$home" claude -p "$MAIL_TASK"
  question_row claude AskUserQuestion 'claude -p (one question tool call, model-relayed refusal)' \
    env CLAUDE_CONFIG_DIR="$home" claude -p "$(question_task AskUserQuestion)"
}

# Codex: `debug prompt-input` renders the skills block the model sees, no
# model turn needed, and a Codex command installs as a skill, so both rows
# read that one listing. Agents surface only as spawn_agent roles inside the
# tool schema, so the model relays them; the same exec turn runs SessionStart,
# which Codex gates on hook trust the flag stands in for.
codex_rows() {
  have codex || { absent codex codex; return; }
  install_for codex
  # Every codex run goes through a CODEX_HOME of its own: `codex exec`
  # persists a trust entry for the directory it ran in, which would leave one
  # dead scratch path in the real config per run, and Codex reads a project's
  # `config.toml` only once that project is trusted, which is what the mcp row
  # needs. The same command against the real CODEX_HOME lists the global
  # servers and never smoke-mcp, which is the mcp row's must-fail control.
  local home
  home=$(copied_home codex-home "${CODEX_HOME:-$HOME/.codex}" auth.json)
  printf '[projects."%s"]\ntrust_level = "trusted"\n' "$PROJECT" >"$home/config.toml"
  run codex-skill env CODEX_HOME="$home" codex debug prompt-input
  judge codex skill '- smoke-skill: [^(]*\(file: r[0-9]+/smoke-skill/SKILL.md\)' '' 'codex debug prompt-input'
  judge codex command '- smoke-command: [^(]*\(file: r[0-9]+/smoke-command/SKILL.md\)' '' \
    'codex debug prompt-input (a Codex command installs as a skill)'
  rm -f -- "$MARKER"
  run codex-agent env CODEX_HOME="$home" codex exec --ephemeral --dangerously-bypass-hook-trust \
    'List the custom agent names available to spawn_agent, one per line, nothing else.'
  judge codex agent '^smoke-agent$' '' 'codex exec (model-relayed spawn_agent roles)'
  fired codex SessionStart .codex/hooks/smoke-session.sh 'codex exec --dangerously-bypass-hook-trust'
  # A config reading and not a connection, so there is no marker to pin.
  run codex-mcp env CODEX_HOME="$home" codex mcp list
  judge codex mcp '^smoke-mcp .*enabled' '' 'codex mcp list (CODEX_HOME trusting the scratch project)'
  row codex mail-wake skipped "$WAKE_SKIPPED"
  mail_row codex 'codex exec (two tool calls, then the turn ends)' '' \
    env CODEX_HOME="$home" codex exec --ephemeral --dangerously-bypass-hook-trust "$MAIL_TASK"
  # The feature that offers request_user_input outside plan mode is switched
  # on for this run, the inverse of the launch word that takes it away.
  question_row codex request_user_input 'codex exec (one question tool call, model-relayed refusal)' \
    env CODEX_HOME="$home" codex exec --ephemeral --dangerously-bypass-hook-trust \
    -c features.default_mode_request_user_input=true "$(question_task request_user_input)"
}

# OpenCode: three debug listings and one mcp listing, no model turn. OpenCode
# runs no hooks; kendex installs the hook as an instruction file plus a config
# reference, and the row checks the resolved config carries it — the same
# resolved config that carries the command's template.
opencode_rows() {
  have opencode || { absent opencode opencode; return; }
  install_for opencode
  run opencode-skill opencode debug skill
  located opencode skill .agents/skills/smoke-skill/SKILL.md 'opencode debug skill' \
    '.[] | select(.name == "smoke-skill") | .location'
  run opencode-agent opencode agent list
  judge opencode agent '^smoke-agent \(subagent\)' '' 'opencode agent list'
  run opencode-config opencode debug config
  if [ "$STATUS" -ne 0 ]; then
    row opencode hook unanswerable "opencode debug config exited $STATUS: $(clip "$(last_line)")"
    row opencode command unanswerable "opencode debug config exited $STATUS: $(clip "$(last_line)")"
  else
    if ! extract '.instructions[]?'; then
      row opencode hook fail "opencode debug config printed no JSON the row can read: $(clip "$(last_line)")"
    elif grep -qFx -- '.opencode/instructions/kendex-hook-smoke-session.md' <<<"$JSON_HIT"; then
      row opencode hook advisory 'no hook runs on OpenCode; opencode debug config lists .opencode/instructions/kendex-hook-smoke-session.md'
    else
      row opencode hook fail 'no hook runs on OpenCode, and opencode debug config does not list .opencode/instructions/kendex-hook-smoke-session.md'
    fi
    if ! extract '.command["smoke-command"].template'; then
      row opencode command fail "opencode debug config printed no JSON the row can read: $(clip "$(last_line)")"
    elif [ "$JSON_HIT" = "$COMMAND_BODY" ]; then
      row opencode command pass 'opencode debug config resolves smoke-command to the rendered template'
    else
      row opencode command fail "opencode debug config resolves smoke-command to '${JSON_HIT:-nothing}'"
    fi
  fi
  rm -f -- "$MARKER"
  run opencode-mcp opencode mcp list
  # The other five statuses opencode can print for a server, so a refusal reads
  # as the harness's no rather than as silence. None of them holds `connected`.
  judge opencode mcp 'smoke-mcp.*connected' \
    'smoke-mcp.*(failed|not initialized|disabled|needs )' \
    'opencode mcp list' "McpStart $PROJECT"
  # kendex writes the instruction reference into the `instructions` key of the
  # config opencode resolves, and nowhere else it prints.
  mail_row opencode 'opencode debug config' \
    '[.]opencode/instructions/kendex-hook-lane-mail-check[.]md' \
    opencode debug config
  question_row opencode - 'this script runs no lane session on opencode'
}

# Cursor: no listing surface for rules or skills, so the model is asked to
# name what it was given; the hook is a rule, never run. The mcp row needs no
# login — everything the CLI reads off disk and starts locally answers while
# cursor-agent is logged out — but it does need the project approval that
# `mcp enable` records under HOME, so it runs under a HOME of its own.
cursor_rows() {
  have cursor-agent || { absent cursor cursor-agent; return; }
  install_for cursor
  local listing='List the names of every rule and skill available to you, one per line, nothing else.'
  local logged_in=1 why=''
  run cursor-status cursor-agent status
  if grep -qi 'not logged in' <<<"$OUT"; then
    logged_in=0
    why='cursor-agent is not logged in (cursor-agent status), and rules and skills have no listing besides the model'
    row cursor skill unanswerable "$why"
    row cursor agent unanswerable "$why"
    row cursor hook unanswerable "no hook runs on Cursor; $why"
  else
    run cursor-list cursor-agent -p --trust --output-format text "$listing"
    judge cursor skill '^smoke-skill$' '' 'cursor-agent -p (model-relayed listing)'
    judge cursor agent '^smoke-agent$' '' 'cursor-agent -p (model-relayed listing)'
    if grep -qE '^safety-smoke-session$' <<<"$OUT"; then
      row cursor hook advisory 'no hook runs on Cursor; the model lists the safety-smoke-session rule'
    elif [ "$STATUS" -ne 0 ]; then
      row cursor hook unanswerable "cursor-agent -p exited $STATUS: $(clip "$(last_line)")"
    else
      row cursor hook fail 'no hook runs on Cursor, and the model did not list the safety-smoke-session rule'
    fi
  fi
  local home="$DIR/cursor-home"
  mkdir -p "$home"
  rm -f -- "$MARKER"
  # Before the approval the same listing says `not loaded (needs approval)`,
  # which is this row's must-fail control.
  run cursor-mcp-enable env HOME="$home" cursor-agent mcp enable smoke-mcp
  run cursor-mcp env HOME="$home" cursor-agent mcp list
  judge cursor mcp '^smoke-mcp: ready' '^smoke-mcp: not loaded' \
    'cursor-agent mcp enable, then mcp list' "McpStart $PROJECT"
  # The rule is the only listing Cursor has for what kendex installed, and the
  # model relays it, so the pattern is anchored to a whole line: a model asked
  # for a name it does not have tends to name the missing thing in its denial.
  if [ "$logged_in" -eq 1 ]; then
    mail_row cursor 'cursor-agent -p (model-relayed listing)' '^safety-lane-mail-check$' \
      cursor-agent -p --trust --output-format text "$listing"
  else
    mail_row cursor "$why" ''
  fi
  question_row cursor - 'this script runs no lane session on cursor'
}

# Pi: get_commands over RPC lists every skill as a skill: command and every
# prompt template as a command, each with its rendered path, so one RPC run
# answers both rows and starts the extension that writes its own marker line.
# Pi core has no agent surface: .pi/agents/*.md is read by the pi-agents-tmux
# extension, which lists agents only in its dashboard. The hook row reads the
# pi-hooks carrier's tool_call listener, so it asks for one tool call. Pi reads
# no MCP servers at all, so it gets no mcp row.
pi_rows() {
  have pi || { absent pi pi; return; }
  install_for pi
  rm -f -- "$MARKER"
  STATUS=0
  OUT=$(cd "$PROJECT" && printf '{"id":"1","type":"get_commands"}\n' | $TIMEOUT pi --mode rpc --approve --no-session 2>&1) || STATUS=$?
  printf '%s\n' "$OUT" >"$LOGS/pi-skill.log"
  located pi skill .agents/skills/smoke-skill/SKILL.md 'pi --mode rpc get_commands' \
    'fromjson? | select(.type == "response" and .command == "get_commands") | .data.commands[] | select(.name == "skill:smoke-skill") | .sourceInfo.path' -R
  row pi agent unanswerable 'Pi core has no agent surface; .pi/agents/*.md is read by the pi-agents-tmux extension, which lists agents only in its interactive dashboard'
  located pi command .pi/prompts/smoke-command.md 'pi --mode rpc get_commands' \
    'fromjson? | select(.type == "response" and .command == "get_commands") | .data.commands[] | select(.name == "smoke-command") | .sourceInfo.path' -R
  # The marker is deliberately not cleared here: `pi list` starts no session,
  # so the PiExtension line this row reads is the one the RPC run above left,
  # which is the same claim — any pi start loads the extension.
  run pi-ext pi list
  holds pi pi-ext .pi/packages/smoke-ext 'pi list' "PiExtension $PROJECT"
  rm -f -- "$MARKER"
  run pi-hook pi -p --approve --no-session \
    'Run the shell command true with your bash tool, then reply with exactly: ok'
  fired pi PreToolUse .pi/kendex/hooks/smoke-tool.sh 'pi -p (one tool call)'
  wake_row pi 'pi -p (arms bg_task, ends its turn)' \
    pi -p --approve --no-session "$(wake_task 'Spawn a background task with your bg_task tool, notifyOnOutput true, notifyMode always,')"
  mail_row pi 'pi -p (two tool calls, then the turn ends)' '' \
    pi -p --approve --no-session "$MAIL_TASK"
  question_row pi question 'pi -p (one question tool call, model-relayed refusal)' \
    pi -p --approve --no-session "$(question_task question)"
}

# Gemini CLI: `skills list` names project skills with their location, and
# `mcp list` starts the server it reads from the render. No listing names
# project agents: --debug prints only an AgentRegistry count, which reads the
# same with the agent file removed. The SessionStart registration runs before
# the model is reached, so the hook row stands even where the model call
# fails; --debug makes Gemini name its hook run, which tells a hook that did
# not run from a session that never started.
gemini_rows() {
  have gemini || { absent gemini gemini; return; }
  install_for gemini
  run gemini-skill gemini skills list
  if grep -qE '^smoke-skill \[Enabled\]' <<<"$OUT" \
    && grep -qF -- "$PROJECT/.agents/skills/smoke-skill/SKILL.md" <<<"$OUT"; then
    row gemini skill pass "gemini skills list said smoke-skill [Enabled] at $PROJECT/.agents/skills/smoke-skill/SKILL.md"
  elif grep -qi 'not trusted' <<<"$OUT"; then
    row gemini skill fail "gemini skills list skipped the project: $(clip "$(grep -i -m 1 'not trusted' <<<"$OUT")")"
  elif [ "$STATUS" -ne 0 ]; then
    row gemini skill unanswerable "gemini skills list exited $STATUS: $(clip "$(last_line)")"
  else
    row gemini skill fail 'gemini skills list did not list smoke-skill [Enabled] at the project path'
  fi
  row gemini agent unanswerable 'no gemini listing names project agents; gemini --debug prints only an AgentRegistry count, unchanged with the agent file removed'
  rm -f -- "$MARKER"
  run gemini-hook gemini -p 'Reply with exactly: ok' --skip-trust --debug
  fired gemini SessionStart .gemini/hooks/smoke-session.sh 'gemini -p --skip-trust --debug'
  row gemini command unanswerable 'gemini has no command listing: its four subcommands are mcp, extensions, skills and hooks, and --debug says nothing about .gemini/commands/*.toml. The one model-free enumeration, the availableCommands of an ACP session/new reply, is refused on this account with the migrate-to-Antigravity message that also fails every gemini -p run'
  rm -f -- "$MARKER"
  run gemini-mcp gemini mcp list
  judge gemini mcp '✓ smoke-mcp: .*Connected' 'smoke-mcp: .*Disconnected' 'gemini mcp list' "McpStart $PROJECT"
  mail_row gemini 'this script runs no lane session on gemini' ''
  question_row gemini - 'this script runs no lane session on gemini'
}

# Copilot: `skill list` names repository skills; --agent runs the session as
# the agent or lists what exists; `mcp list` reads .github/mcp.json. Repository
# hooks run only for a folder the settings name in trustedFolders, so the runs
# use an isolated COPILOT_HOME holding a copy of the login record and that one
# trust entry. Copilot CLI reads no command surface of its own, so it gets no
# command row.
copilot_rows() {
  have copilot || { absent copilot copilot; copilot_packages absent; return; }
  install_for copilot
  local home
  home=$(copied_home copilot-home "${COPILOT_HOME:-$HOME/.copilot}" config.json)
  jq -n --arg p "$PROJECT" '{trustedFolders: [$p]}' >"$home/settings.json"
  run copilot-skill env COPILOT_HOME="$home" copilot skill list
  judge copilot skill '^  smoke-skill - .*' '' 'copilot skill list'
  rm -f -- "$MARKER"
  run copilot-agent env COPILOT_HOME="$home" copilot -p 'Reply exactly as your agent instructions say.' --agent smoke-agent --allow-all-tools -s
  judge copilot agent 'SMOKE-AGENT-LOADED' 'No such agent' 'copilot -p --agent smoke-agent'
  fired copilot SessionStart .github/hooks/smoke-session.sh 'copilot -p (COPILOT_HOME trusting the scratch project)'
  # A config reading, not a connection, so there is no marker to pin.
  run copilot-mcp env COPILOT_HOME="$home" copilot mcp list
  judge copilot mcp '^ +smoke-mcp \(local\)' '' 'copilot mcp list'
  mail_row copilot 'this script runs no lane session on copilot' ''
  question_row copilot - 'this script runs no lane session on copilot'
  copilot_packages live "$home"
}

# Antigravity: agy reads a project's `.agents/` only for a folder the session
# attaches, so every run carries --add-dir naming the scratch project; without
# it a run resolves the default project, which lists no folder, and loads no
# skill, hook or server from the render. A slash invocation in print mode
# expands the skill; `-p` swallows the next word, so the prompt is attached to
# it and every other flag comes first. One run with a tool call answers hook
# and mcp together: agy loads the attached folder's hooks.json and starts its
# MCP servers before the model is reached, and --log-file records both, so
# the mcp row stands and a render agy never read reads as a fail even where
# the model call fails. `agy mcp list` reads the user-level file alone and
# cannot name a project server, so the mcp row's proof is the server's own
# marker line. No agent row: kendex renders no project agent for Antigravity.
antigravity_rows() {
  have agy || { absent antigravity agy; return; }
  install_for antigravity
  local home startup
  home="$DIR/agy-home"
  # `~/.gemini` alone is Gemini CLI's root too; the settings directory under
  # it is agy's own, so it is what proves a login worth copying.
  if ! [ -d "$HOME/.gemini/antigravity-cli" ]; then
    every_row antigravity unanswerable 'agy has no ~/.gemini/antigravity-cli to copy: not logged in on this machine'
    return
  fi
  mkdir -p "$home"
  # The source is live state another agy session may be writing, so a copy
  # that fails is three unanswerable rows, never a dead run.
  if ! cp -a "$HOME/.gemini" "$home/.gemini" 2>"$LOGS/agy-home-copy.log"; then
    every_row antigravity unanswerable "copying ~/.gemini into an isolated HOME failed: $(clip "$(tail -n 1 "$LOGS/agy-home-copy.log")")"
    return
  fi
  run agy-skill env HOME="$home" agy --add-dir "$PROJECT" --dangerously-skip-permissions -p=/smoke-skill
  judge antigravity skill '^SMOKE-SKILL-LOADED$' '' 'agy --add-dir -p=/smoke-skill'
  rm -f -- "$MARKER"
  startup="$LOGS/agy-hook-mcp.startup.log"
  run agy-hook-mcp env HOME="$home" agy --add-dir "$PROJECT" --log-file "$startup" --dangerously-skip-permissions \
    -p='Run the shell command true with your terminal tool, then reply with exactly: ok'
  if grep -qF 'loaded 0 named hooks' "$startup" 2>/dev/null; then
    row antigravity hook fail "agy --add-dir loaded 0 named hooks from 0 hooks.json file(s): it never read .agents/hooks.json (marker: $(marker_text))"
  else
    fired antigravity PreToolUse .agents/hooks/smoke-tool.sh 'agy --add-dir -p (one tool call)'
  fi
  if [ -f "$MARKER" ] && grep -qF -- "McpStart $PROJECT" "$MARKER"; then
    row antigravity mcp pass "agy --add-dir started the server on startup, and the fixture wrote 'McpStart $PROJECT'"
  elif grep -qF 'empty component: prompt section "mcp_servers"' "$startup" 2>/dev/null; then
    row antigravity mcp fail "agy --add-dir resolved no MCP server on startup: it never read .agents/mcp_config.json (marker: $(marker_text))"
  elif [ "$STATUS" -ne 0 ]; then
    row antigravity mcp unanswerable "agy --add-dir -p exited $STATUS before starting the server: $(clip "$(last_line)")"
  else
    row antigravity mcp fail "agy --add-dir -p never started the server (marker: $(marker_text))"
  fi
  mail_row antigravity 'this script runs no lane session on antigravity' ''
  question_row antigravity - 'this script runs no lane session on antigravity'
}

# ---- the Copilot package table ---------------------------------------------
# One row per package this checkout ships, asked of Copilot CLI: every hook,
# skill and agent under SELF, each instruction source Copilot merges, the skill
# directory a COPILOT_HOME hides, and what a hook or a skill's helper script
# receives from a Copilot tool call. Beside the results above, a row here reads
# `differs` (it works, and its evidence says how it differs from Claude Code),
# `excluded` (kendex installs no Copilot render of that hook, for the reason
# the copilot cell of hooks/README.md gives), or `pending` (nothing on this
# machine answered it; its evidence names the proof). The skill, instruction
# and skill-directory rows need no model turn and answer wherever copilot is on
# PATH. The agent, hook, helper, duplicate and subagent rows need a login and
# spend four model turns: the agent listing, one session of tool calls, the
# duplicate count and the subagent. `agent:effort` stays pending: nothing here
# reads the effort a subagent runs at.
#
# The package project installs every hook the copilot cell calls enforced,
# every skill and every agent from SELF, plus the fixture's smoke-rules agent
# and smoke-tool hook, and runs its model turns with COPILOT_ALLOW_ALL=true,
# which `copilot help environment` names as the value that trusts the working
# directory and loads its hooks. Every hook it installs reads its payload with
# `cat`, so a `cat` first on the session's PATH records, for a caller under
# .github/hooks, the payload, the directory and the environment names, then
# hands the payload on unchanged. The session's tool calls run a helper that
# records the same two, then one command per hook below that the hook refuses;
# each but `cd /` ends by writing a marker a refused call never writes, and
# each is short-circuited so nothing it names runs when no hook refuses it.
PKG_PROOF='tools/harness-smoke --only copilot on a host where copilot is on PATH and logged in'
PKG_RULES='SMOKE-RULES is SMOKE-RULES-REACHED.'
# shellcheck disable=SC2016 # the model is handed $HARNESS_SMOKE_UNSET as text a hook refuses
PKG_TRIGGERS='block-argv-kill|true || pkill -f harness-smoke-absent
block-unsafe-rm|true || rm -rf $HARNESS_SMOKE_UNSET/harness-smoke-absent
block-repo-copy|true || cp -r /harness-smoke-absent/.git /tmp/harness-smoke-copy
block-bare-cd|cd /'
pkg_list() { # KIND — the names this checkout ships of that kind, one per line
  local f
  case "$1" in
    hook) for f in "$SELF"/hooks/*.sh; do if [ -f "$f" ]; then f=${f##*/}; printf '%s\n' "${f%.sh}"; fi; done ;;
    skill) for f in "$SELF"/skills/*/SKILL.md; do if [ -f "$f" ]; then f=${f%/SKILL.md}; printf '%s\n' "${f##*/}"; fi; done ;;
    agent) for f in "$SELF"/agents/*.md; do if [ -f "$f" ]; then f=${f##*/}; printf '%s\n' "${f%.md}"; fi; done ;;
    mcp) for f in "$SELF"/mcp/*.toml; do if [ -f "$f" ]; then f=${f##*/}; printf '%s\n' "${f%.toml}"; fi; done ;;
  esac
}
# The table lists what these readers find, so a reader that finds nothing would
# print a table that says nothing; each kind but mcp, which this checkout ships
# none of, has to find one member, and every hook has to have a copilot cell.
if wants copilot; then
  for pkg_kind in hook skill agent; do
    [ -n "$(pkg_list "$pkg_kind")" ] || refuse packages "$SELF/${pkg_kind}s"
  done
  for pkg_hook in $(pkg_list hook); do
    pkg_cell=""
    pkg_cell=$(mail_cell copilot "$pkg_hook") ||
      refuse_cause package-cell "$pkg_hook" "$(cat -- "$MAIL_CELL_ERR")"
    [ -n "$pkg_cell" ] || refuse package-cell "$pkg_hook"
  done
fi
pkg_pending() { # ROW REASON
  row copilot "$1" pending "pending: $2; proof: $PKG_PROOF"
}
pkg_trigger() { # HOOK — the command the session runs for that hook, empty for none
  local line
  while IFS= read -r line; do
    [ "${line%%|*}" != "$1" ] || { printf '%s' "${line#*|}"; return 0; }
  done <<<"$PKG_TRIGGERS"
}
# The rows no machine changes: an excluded hook, and the MCP servers this
# checkout does not ship.
pkg_fixed_rows() { # HOOK-ROW-FN — HOOK-ROW-FN answers each hook the cell calls enforced
  local name cell
  for name in $(pkg_list hook); do
    if ! cell=$(mail_cell copilot "$name"); then
      refuse_cause package-cell "$name" "$(cat -- "$MAIL_CELL_ERR")"
    fi
    if [ "$cell" = enforced ]; then "$1" "$name"; else
      row copilot "hook:$name" excluded "kendex installs no Copilot render: $cell (hooks/README.md)"
    fi
  done
}
pkg_mcp_rows() { # PROOF-FN — PROOF-FN answers each MCP server this checkout ships
  local name found=0
  for name in $(pkg_list mcp); do found=1; "$1" "mcp:$name"; done
  [ "$found" -eq 1 ] ||
    row copilot mcp:catalog skipped 'this checkout ships no MCP server; the copilot mcp row above proves Copilot loads a kendex-rendered one'
}
pkg_absent_hook() { pkg_pending "hook:$1" 'copilot is not on PATH'; }
pkg_absent_mcp() { pkg_pending "$1" 'copilot is not on PATH'; }
pkg_live_mcp() { pkg_pending "$1" 'the package project installs no MCP server'; }

# The package project: SELF's packages as the copilot cell allows, the fixture's
# subagent and marker hook, the instruction sources, the helper, the recorder.
PKG=""
PKG_RECORDER=""
pkg_world() { # — sets PKG and PKG_RECORDER, exits 2 when kendex cannot install or verify
  local name enforced="" real_cat records cat_q
  PKG="$DIR/copilot-packages/project"
  PKG_RECORDER="$DIR/copilot-packages/bin"
  scratch_repo "$PKG"
  for name in $(pkg_list hook); do
    [ "$(mail_cell copilot "$name")" != enforced ] || enforced="$enforced,$name"
  done
  if ! (cd "$PKG" && kendex add "$SELF" --skill "$(pkg_list skill | paste -s -d , -)" \
    --agent "$(pkg_list agent | paste -s -d , -)" --hook "${enforced#,}" --harness copilot -y) \
    >"$LOGS/copilot-packages-kendex-add.log" 2>&1; then
    refused add copilot "$LOGS/copilot-packages-kendex-add.log"
  fi
  if ! (cd "$PKG" && kendex add "$CATALOG" --agent smoke-rules --hook smoke-tool --harness copilot -y) \
    >"$LOGS/copilot-packages-kendex-add-fixture.log" 2>&1; then
    refused add copilot "$LOGS/copilot-packages-kendex-add-fixture.log"
  fi
  if ! (cd "$PKG" && kendex verify --scope project) >"$LOGS/copilot-packages-kendex-verify.log" 2>&1; then
    refused verify copilot "$LOGS/copilot-packages-kendex-verify.log"
  fi
  note verified copilot "$PKG"
  # CLAUDE.md is the one-line import kendex writes beside AGENTS.md, which is
  # what the duplicate row asks about.
  setup 'the package instruction directories' mkdir -p "$PKG/sub" "$PKG/.github/instructions" \
    "$PKG/smoke-payloads" "$PKG/smoke-triggers" "$PKG_RECORDER"
  printf '# Harness smoke\n\n%s\n' "$PKG_RULES" >"$PKG/AGENTS.md"
  printf '@AGENTS.md\n' >"$PKG/CLAUDE.md"
  printf 'Harness smoke Copilot instructions.\n' >"$PKG/.github/copilot-instructions.md"
  printf -- '---\napplyTo: "**"\n---\n\nHarness smoke path instructions.\n' \
    >"$PKG/.github/instructions/smoke.instructions.md"
  printf 'Harness smoke nested instructions.\n' >"$PKG/sub/AGENTS.md"
  cat >"$PKG/smoke-helper" <<'EOF'
#!/bin/sh
pwd >"$0.cwd"
env | sed 's/=.*//' | sort >"$0.env"
EOF
  real_cat=$(command -v cat)
  records=$(printf '%q' "$PKG/smoke-payloads")
  cat_q=$(printf '%q' "$real_cat")
  cat >"$PKG_RECORDER/cat" <<EOF
#!/bin/sh
if [ "\$#" -eq 0 ]; then
  caller=\$(ps -o args= -p "\$PPID" 2>/dev/null) || caller=""
  case "\$caller" in
    */.github/hooks/*.sh*)
      hook=\${caller##*/.github/hooks/}
      rec=$records/\${hook%%.sh*}.\$\$
      $cat_q >"\$rec.payload" || exit 1
      pwd >"\$rec.cwd"
      env | sed 's/=.*//' | sort >"\$rec.env"
      exec $cat_q "\$rec.payload"
      ;;
  esac
fi
exec $cat_q "\$@"
EOF
  setup 'the helper and the recorder' chmod +x "$PKG/smoke-helper" "$PKG_RECORDER/cat"
}

# One listing, one row per name: a skill under Project skills, an agent on a
# line of its own in the model's answer.
pkg_listed() { # ROW PATTERN COMMAND-TEXT
  if grep -qE -e "$2" <<<"$OUT"; then
    row copilot "$1" pass "$3 lists it"
  elif [ "$STATUS" -ne 0 ]; then
    row copilot "$1" unanswerable "$3 exited $STATUS: $(clip "$(last_line)")"
  else
    row copilot "$1" fail "$3 does not list it; its last line: $(clip "$(last_line)")"
  fi
}
PKG_ROOT_SOURCES=""
PKG_SUB_SOURCES=""
pkg_sources() { # — the sourcePath of each source the listing in OUT names, one per line
  jq -r '.[].sourcePath' <<<"$OUT" 2>/dev/null
}
pkg_instruction_row() { # ROW SOURCE-PATH
  if grep -qFx -- "$2" <<<"$PKG_ROOT_SOURCES"; then
    row copilot "$1" pass "copilot instruction list --json at the project root lists $2"
  else
    row copilot "$1" fail "copilot instruction list --json at the project root does not list $2 (sources: $(clip "$(printf '%s' "$PKG_ROOT_SOURCES" | paste -s -d , -)"))"
  fi
}
pkg_instruction_rows() {
  local listed=1 q
  run copilot-instructions-root env COPILOT_HOME="$PKG_HOME" copilot instruction list --json
  if [ "$STATUS" -ne 0 ] || ! PKG_ROOT_SOURCES=$(pkg_sources); then
    listed=0
    for q in AGENTS.md CLAUDE.md copilot-instructions.md instructions nested duplicate; do
      row copilot "instruction:$q" unanswerable "copilot instruction list --json exited $STATUS or printed no JSON: $(clip "$(last_line)")"
    done
  fi
  [ "$listed" -eq 1 ] || return 0
  pkg_instruction_row instruction:AGENTS.md AGENTS.md
  pkg_instruction_row instruction:CLAUDE.md CLAUDE.md
  pkg_instruction_row instruction:copilot-instructions.md .github/copilot-instructions.md
  pkg_instruction_row instruction:instructions .github/instructions/smoke.instructions.md
  # A nested AGENTS.md: listed from a session started in sub/, and whether a
  # session started at the root lists it too, which Claude Code's reading of
  # a nested file as its session touches that directory has no counterpart of.
  PROJECT="$PKG/sub" run copilot-instructions-sub env COPILOT_HOME="$PKG_HOME" copilot instruction list --json
  PKG_SUB_SOURCES=$(pkg_sources) || PKG_SUB_SOURCES=""
  if [ "$STATUS" -ne 0 ]; then
    row copilot instruction:nested unanswerable "copilot instruction list --json in sub/ exited $STATUS: $(clip "$(last_line)")"
  elif ! grep -qFx -- sub/AGENTS.md <<<"$PKG_SUB_SOURCES"; then
    row copilot instruction:nested fail "copilot instruction list --json in sub/ does not list sub/AGENTS.md"
  elif grep -qFx -- sub/AGENTS.md <<<"$PKG_ROOT_SOURCES"; then
    row copilot instruction:nested pass "copilot instruction list --json lists sub/AGENTS.md from sub/ and from the project root"
  else
    row copilot instruction:nested differs "copilot instruction list --json lists sub/AGENTS.md for a session started in sub/ and not for one started at the root: a nested AGENTS.md is read for the working directory only"
  fi
}

# The session of tool calls: the helper, then one refused command per hook.
pkg_hook_task() {
  local line hook command n=2
  printf 'Run each of these shell commands with your shell tool, one tool call per command, in this order. Run each exactly once, whether or not it is refused or fails, and run nothing else. Then reply with exactly: ok\n1. %q\n' "$PKG/smoke-helper"
  while IFS= read -r line; do
    hook=${line%%|*}
    command=${line#*|}
    case "$hook" in block-bare-cd) ;; *) command="$command; touch $(printf '%q' "$PKG/smoke-triggers/$hook")" ;; esac
    printf '%s. %s\n' "$n" "$command"
    n=$((n + 1))
  done <<<"$PKG_TRIGGERS"
}
pkg_record() { # HOOK SUFFIX — the first record that hook left with that suffix, empty for none
  local f
  for f in "$PKG/smoke-payloads/$1".*."$2"; do
    if [ -f "$f" ]; then printf '%s' "$f"; return 0; fi
  done
}
# Why no hook left a record: the one verdict every row of this session reaches
# when the recorder holds nothing. Prints `RESULT|EVIDENCE`.
pkg_silent() {
  local f
  for f in "$PKG/smoke-payloads"/*.payload; do
    if [ -f "$f" ]; then printf 'some'; return 0; fi
  done
  if [ -f "$PKG/smoke-fired" ] && grep -q '^PreToolUse ' "$PKG/smoke-fired"; then
    printf 'unanswerable|the fixture hook ran at preToolUse, and no hook read its payload through the recorder: Copilot starts hooks without the launch PATH'
  elif [ "$STATUS" -ne 0 ]; then
    printf 'unanswerable|copilot -p exited %s: %s' "$STATUS" "$(clip "$(last_line)")"
  elif ! [ -f "$PKG/smoke-helper.cwd" ]; then
    printf 'unanswerable|the model ran none of the commands; its last line: %s' "$(clip "$(last_line)")"
  else
    printf 'fail|the model ran its tool calls, and Copilot ran no repository hook, the fixture hook included'
  fi
}
pkg_hook_row() { # HOOK — after the session
  local hook=$1 rec event silent marker="$PKG/smoke-triggers/$1"
  event=$(sed -n 's/^# event: //p' "$SELF/hooks/$hook.sh")
  rec=$(pkg_record "$hook" payload) || rec=""
  if [ -n "$rec" ]; then
    case "$hook" in
      block-bare-cd)
        row copilot "hook:$hook" pass "ran at $event, reading the payload Copilot sent; a refused bare cd leaves nothing a row can read" ;;
      *)
        if [ -z "$(pkg_trigger "$hook")" ]; then
          row copilot "hook:$hook" pass "ran at $event, reading the payload Copilot sent; its refusals need a world this project lacks, and its suite holds them"
        elif [ -e "$marker" ]; then
          row copilot "hook:$hook" fail "ran at $event, and the command it refuses went through: $marker was written"
        else
          row copilot "hook:$hook" pass "ran at $event and stopped the command it refuses: $marker was never written"
        fi ;;
    esac
    return
  fi
  silent=$(pkg_silent) || silent="unanswerable|the recorder's directory could not be read"
  if [ "$silent" = some ]; then
    row copilot "hook:$hook" fail "never ran at $event, while other hooks read their payloads"
  else
    row copilot "hook:$hook" "${silent%%|*}" "${silent#*|}"
  fi
}
pkg_helper_rows() {
  local silent rec keys hook_cwd tool_cwd hook_env tool_env names
  silent=$(pkg_silent) || silent="unanswerable|the recorder's directory could not be read"
  if [ "$silent" != some ] && ! [ -f "$PKG/smoke-helper.cwd" ]; then
    for rec in payload cwd env; do row copilot "helper:$rec" "${silent%%|*}" "${silent#*|}"; done
    return
  fi
  rec=$(pkg_record block-argv-kill payload) || rec=""
  if [ -z "$rec" ]; then
    if [ "$silent" = some ]; then
      row copilot helper:payload fail 'block-argv-kill left no preToolUse payload, while other hooks read theirs'
    else
      row copilot helper:payload "${silent%%|*}" "${silent#*|}"
    fi
  elif keys=$(jq -r 'keys_unsorted | join(",")' <"$rec" 2>/dev/null) &&
    jq -e '(.tool_input.command // .command // (.toolArgs | if type == "string" then fromjson else . end | .command?)) | type == "string"' <"$rec" >/dev/null 2>&1; then
    row copilot helper:payload pass "the preToolUse payload carries the command where the hooks' reader looks; its keys: $(clip "$keys")"
  else
    row copilot helper:payload fail "the preToolUse payload carries no command the hooks' reader reads; it begins: $(clip "$(head -c 160 "$rec")")"
  fi
  hook_cwd=$(cat -- "$(pkg_record block-argv-kill cwd)" 2>/dev/null) || hook_cwd=""
  tool_cwd=$(cat -- "$PKG/smoke-helper.cwd" 2>/dev/null) || tool_cwd=""
  if [ -z "$hook_cwd" ] || [ -z "$tool_cwd" ]; then
    row copilot helper:cwd unanswerable "a record is missing: the hook's directory '${hook_cwd:-none}', the tool call's '${tool_cwd:-none}'"
  elif [ "$hook_cwd" = "$PKG" ] && [ "$tool_cwd" = "$PKG" ]; then
    row copilot helper:cwd pass "a hook and a tool call both run in the project root"
  else
    row copilot helper:cwd differs "the project root is $PKG; a hook runs in $hook_cwd, a tool call in $tool_cwd"
  fi
  hook_env=$(cat -- "$(pkg_record block-argv-kill env)" 2>/dev/null) || hook_env=""
  tool_env=$(cat -- "$PKG/smoke-helper.env" 2>/dev/null) || tool_env=""
  names=$(grep -E '^(COPILOT_|GITHUB_COPILOT|CLAUDE)' <<<"$tool_env" | paste -s -d , -) || names=""
  if [ -z "$hook_env" ] || [ -z "$tool_env" ]; then
    row copilot helper:env unanswerable "a record is missing: the hook's environment ($(printf '%s' "$hook_env" | wc -l | tr -d ' ') names), the tool call's ($(printf '%s' "$tool_env" | wc -l | tr -d ' ') names)"
  elif grep -qFx HARNESS_SMOKE_ENV <<<"$hook_env" && grep -qFx HARNESS_SMOKE_ENV <<<"$tool_env"; then
    row copilot helper:env pass "the launch environment reaches a hook and a tool call; harness names a tool call sees: ${names:-none}"
  else
    row copilot helper:env fail "HARNESS_SMOKE_ENV, set on the launch, is missing from the hook's or the tool call's environment; harness names a tool call sees: ${names:-none}"
  fi
}

# Every COPILOT_HOME hides ~/.agents/skills; COPILOT_SKILLS_DIRS names it back.
pkg_skill_dirs_row() {
  local home="$DIR/copilot-skill-dirs/home" state="$DIR/copilot-skill-dirs/copilot-home" bare with_home with_dirs
  setup 'the skill-directory homes' mkdir -p "$home/.agents/skills/smoke-personal" "$state"
  printf -- '---\nname: smoke-personal\ndescription: Harness smoke fixture personal skill.\n---\n\nReply with exactly SMOKE-PERSONAL-LOADED.\n' \
    >"$home/.agents/skills/smoke-personal/SKILL.md"
  run copilot-skill-dirs-bare env -u COPILOT_HOME HOME="$home" copilot skill list
  bare=$STATUS
  grep -qE '^  smoke-personal - ' <<<"$OUT" || bare=absent
  run copilot-skill-dirs-home env HOME="$home" COPILOT_HOME="$state" copilot skill list
  with_home=$STATUS
  grep -qE '^  smoke-personal - ' <<<"$OUT" || with_home=absent
  run copilot-skill-dirs-dirs env HOME="$home" COPILOT_HOME="$state" \
    COPILOT_SKILLS_DIRS="$home/.agents/skills" copilot skill list
  with_dirs=$STATUS
  grep -qE '^  smoke-personal - ' <<<"$OUT" || with_dirs=absent
  case "$bare:$with_home:$with_dirs" in
    0:0:0) row copilot skill-dirs:COPILOT_HOME pass 'copilot skill list lists ~/.agents/skills with and without COPILOT_HOME' ;;
    0:absent:0) row copilot skill-dirs:COPILOT_HOME differs 'copilot skill list drops ~/.agents/skills once COPILOT_HOME is set, and COPILOT_SKILLS_DIRS=~/.agents/skills brings it back: a launch that sets COPILOT_HOME exports both' ;;
    0:*:absent) row copilot skill-dirs:COPILOT_HOME fail 'copilot skill list under COPILOT_HOME with COPILOT_SKILLS_DIRS=~/.agents/skills does not list it' ;;
    absent:*) row copilot skill-dirs:COPILOT_HOME fail 'copilot skill list with no COPILOT_HOME does not list ~/.agents/skills' ;;
    *) row copilot skill-dirs:COPILOT_HOME unanswerable "copilot skill list exited non-zero (bare:COPILOT_HOME:COPILOT_SKILLS_DIRS = $bare:$with_home:$with_dirs); logs under $LOGS" ;;
  esac
}

PKG_HOME=""
copilot_packages() { # MODE [HOME] — absent: copilot is not on PATH; live: HOME is the isolated COPILOT_HOME
  local name answer
  if [ "$1" = absent ]; then
    pkg_fixed_rows pkg_absent_hook
    for name in $(pkg_list skill); do pkg_pending "skill:$name" 'copilot is not on PATH'; done
    for name in $(pkg_list agent) effort; do pkg_pending "agent:$name" 'copilot is not on PATH'; done
    for name in AGENTS.md CLAUDE.md copilot-instructions.md instructions nested duplicate subagent; do
      pkg_pending "instruction:$name" 'copilot is not on PATH'
    done
    pkg_pending skill-dirs:COPILOT_HOME 'copilot is not on PATH'
    for name in payload cwd env; do pkg_pending "helper:$name" 'copilot is not on PATH'; done
    pkg_mcp_rows pkg_absent_mcp
    return
  fi
  PKG_HOME=$2
  pkg_world
  local PROJECT="$PKG" MARKER="$PKG/smoke-fired"
  local allow="COPILOT_ALLOW_ALL=true"
  run copilot-packages-skills env COPILOT_HOME="$PKG_HOME" copilot skill list
  for name in $(pkg_list skill); do
    pkg_listed "skill:$name" "^  $name - " 'copilot skill list'
  done
  run copilot-packages-agents env COPILOT_HOME="$PKG_HOME" "$allow" copilot -p \
    'List the names of the custom agents your task tool can run, one per line, and nothing else.' --allow-all-tools -s
  for name in $(pkg_list agent); do
    pkg_listed "agent:$name" "^[-*[:space:]]*${name}[[:space:]]*\$" 'copilot -p (model-relayed agent listing)'
  done
  pkg_pending agent:effort 'nothing here reads the effort a subagent runs at'
  rm -f -- "$MARKER"
  run copilot-packages-hooks env PATH="$PKG_RECORDER:$PATH" HARNESS_SMOKE_ENV=1 COPILOT_HOME="$PKG_HOME" "$allow" \
    copilot -p "$(pkg_hook_task)" --allow-all-tools -s
  pkg_fixed_rows pkg_hook_row
  pkg_helper_rows
  pkg_instruction_rows
  run copilot-packages-duplicate env COPILOT_HOME="$PKG_HOME" "$allow" copilot -p \
    "How many times does the exact line '$PKG_RULES' appear across all the instructions you were given? Reply with the number alone." --allow-all-tools -s
  answer=$(last_line)
  case "$STATUS:$answer" in
    0:1) row copilot instruction:duplicate pass "AGENTS.md and CLAUDE.md, which imports it, are both listed, and the model counts the AGENTS.md line once" ;;
    0:2) row copilot instruction:duplicate differs "AGENTS.md and CLAUDE.md, which imports it, are both listed, and the model counts the AGENTS.md line twice: the text reaches the context twice" ;;
    0:*) row copilot instruction:duplicate fail "the model answered '$(clip "$answer")', not a count of 1 or 2" ;;
    *) row copilot instruction:duplicate unanswerable "copilot -p exited $STATUS: $(clip "$answer")" ;;
  esac
  run copilot-packages-subagent env COPILOT_HOME="$PKG_HOME" "$allow" copilot -p \
    'Use your task tool to run the smoke-rules custom agent. Reply with exactly the text it returned and nothing else.' --allow-all-tools -s
  judge copilot instruction:subagent '^SMOKE-RULES-REACHED$' '^NO-RULES$' 'copilot -p (task tool running smoke-rules, model-relayed)'
  pkg_skill_dirs_row
  pkg_mcp_rows pkg_live_mcp
}

printf '%-11s %-9s %-12s %s\n' harness row result evidence
for h in $HARNESSES; do
  if wants "$h"; then "${h}_rows"; else skipped "$h"; fi
done

printf '\n| harness | row | result | evidence |\n|---|---|---|---|\n%s' "$ROWS"
printf '\nlogs: %s\n' "$LOGS"
if [ "$FAILED" -gt 0 ]; then
  say failed "$FAILED"
  KEEP=1
  exit 1
fi
if [ "$UNANSWERED" -gt 0 ]; then
  say unanswerable "$UNANSWERED"
  exit 3
fi
