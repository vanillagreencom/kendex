#!/usr/bin/env bash
# Proves that a package kendex installs actually loads in each supported
# harness, by the harness's own account. `kendex verify` compares disk with
# the lock; every skill suite tests a package in isolation. Neither asks the
# tool that has to read the render, so a render that is well-formed by
# kendex's rules and rejected by its harness passes both. This check installs
# a fixture catalog (one skill, one agent, one SessionStart hook, one
# PreToolUse hook, one command, one stdio MCP server, one Pi extension) into
# a scratch project for every harness, then asks each harness what it loaded
# through the surface that harness exposes, and reads a marker the hooks, the
# MCP server and the Pi extension write when the harness runs them.
#
# One row per harness per question, and only for the kinds that harness
# installs: skill and hook everywhere; agent everywhere but Antigravity;
# command on Claude, Codex, OpenCode, Pi and Gemini; mcp on every harness but
# Pi; pi-ext on Pi alone. Plugin has no row anywhere — `Plugin` has `install:
# NONE` on all eight harnesses, so kendex renders no plugin for one to load —
# and Antigravity has no agent row for the same reason: agy reads agents from
# its global root alone, so kendex renders no project agent for it. A row is `pass`,
# `fail`, `advisory` (the harness runs no hooks; kendex installs text, and
# the row checks the harness lists that text), `unanswerable` (this machine
# or this harness cannot answer, with the reason), or `skipped` (left out by
# --only). Silence is never a pass: a run that says nothing about the
# package is a fail, and a run the harness could not complete is
# unanswerable with its last line.
#
# The scratch projects live under tmp/ in this checkout, one git repository
# per harness with the fixture installed for that harness alone, so no harness
# reads them as part of this checkout, no harness answers for another's
# render, and kendex's project-scope writes land nowhere shared. Per-harness gates the check has to
# open, each said on its row: Codex runs project hooks only after persisted
# hook trust, so the exec run carries --dangerously-bypass-hook-trust, and it
# reads a project's `config.toml` only once that project is trusted, so every
# codex run goes through an isolated CODEX_HOME that trusts the scratch
# project and keeps `codex exec`'s own trust write out of the real config;
# a project `.mcp.json` server starts as pending approval on Claude, so its
# mcp row runs under an isolated CLAUDE_CONFIG_DIR that approves it; Copilot
# runs repository hooks only for a folder its settings name in
# `trustedFolders`, so its runs use an isolated COPILOT_HOME that copies the
# login record and trusts the scratch project; Cursor loads a project server
# only after `cursor-agent mcp enable`, which records the approval under
# HOME, so its mcp row runs under an isolated HOME; Pi's carrier dispatches
# only the tool_call listener, so its hook row asks the model for one tool
# call. Antigravity reads a project's `.agents/` only for a folder the session
# attaches as a workspace, so every agy run carries `--add-dir` naming the
# scratch project; it has no config-root knob, its root is a fixed `~/.gemini`
# and every run writes conversation state under it, so its runs go through an
# isolated HOME holding a whole copy of `~/.gemini` (a partial copy makes agy
# hang on its login flow).
#
# Exit 0 when every row passed (advisory and skipped included), 1 when any
# row failed, 2 when the fixture could not be installed or `kendex verify`
# refused it, 3 when nothing failed but a row was unanswerable, so a harness
# that died on the render never reads as a clean run. Model turns: three on
# claude, two on antigravity, one each on codex, pi, gemini and copilot, one
# on cursor when logged in.
set -euo pipefail

usage() {
  printf '%s\n' 'usage: tools/harness-smoke [--only h1,h2,...] [--keep] [--dir DIR]' \
    '  --only    run these harnesses (claude codex opencode cursor pi gemini copilot antigravity); the rest print skipped' \
    '  --keep    leave the scratch project and logs in place' \
    '  --dir     parent of the scratch directory this run makes (default: tmp/ in this checkout)'
}

HARNESSES="claude codex opencode cursor pi gemini copilot antigravity"
ONLY="$HARNESSES"
KEEP=0
DIR=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --only)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      ONLY=$(printf '%s' "$2" | tr ',' ' ')
      for h in $ONLY; do
        case " $HARNESSES " in *" $h "*) ;; *)
          printf 'harness-smoke: unknown harness: %s\n' "$h" >&2; exit 2 ;;
        esac
      done
      shift 2 ;;
    --keep) KEEP=1; shift ;;
    --dir)
      [ "$#" -ge 2 ] || { usage >&2; exit 2; }
      DIR=$2; shift 2 ;;
    -h | --help) usage; exit 0 ;;
    *) usage >&2; exit 2 ;;
  esac
done

for tool in kendex git jq node; do
  command -v "$tool" >/dev/null 2>&1 || {
    printf 'harness-smoke: %s is required\n' "$tool" >&2
    exit 2
  }
done

ROOT=$(git rev-parse --show-toplevel) || exit 2
# The run owns a fresh subtree under the parent it was given, and the
# cleanup below removes that subtree alone: --dir tmp must not empty tmp/.
PARENT=${DIR:-$ROOT/tmp}
mkdir -p "$PARENT" || exit 2
DIR=$(mktemp -d "$PARENT/harness-smoke.XXXXXX") || exit 2
DIR=$(cd "$DIR" && pwd -P) || exit 2
cleanup() {
  if [ "$KEEP" -eq 1 ]; then
    printf 'harness-smoke: scratch kept at %s\n' "$DIR"
  else
    rm -rf -- "${DIR:?}"
  fi
}
trap cleanup EXIT

CATALOG="$DIR/catalog"
LOGS="$DIR/logs"
SERVER="$DIR/mcp-server.mjs"
mkdir -p "$CATALOG/skills/smoke-skill" "$CATALOG/agents" "$CATALOG/hooks" \
  "$CATALOG/commands" "$CATALOG/mcp" "$CATALOG/pi-extensions/smoke-ext/extensions" "$LOGS"

# ---- the fixture catalog ---------------------------------------------------
# Each item answers with a token no harness would emit on its own, and each
# hook appends the event and its own rendered path to the marker, so a row can
# tell the harness's copy of the script from a cross-read of another tool's.
# The MCP server and the Pi extension append their own line to the same
# marker when the harness starts them, which is the second proof on the rows
# whose listing reports a live connection rather than a config reading.
COMMAND_ANSWER=SMOKE-COMMAND-LOADED
COMMAND_BODY="Reply with exactly $COMMAND_ANSWER and nothing else."
cat >"$CATALOG/kendex.toml" <<'EOF'
is_source_catalog = true

[marketplace]
name = "harness-smoke"
description = "Fixture catalog for tools/harness-smoke"
author = "kendex"
license = "MIT"
EOF
cat >"$CATALOG/skills/smoke-skill/SKILL.md" <<'EOF'
---
name: smoke-skill
description: "Harness smoke fixture skill: proves a kendex-rendered skill loads."
---

# Smoke skill

When this skill is invoked, reply with exactly SMOKE-SKILL-LOADED and nothing else.
EOF
cat >"$CATALOG/agents/smoke-agent.md" <<'EOF'
---
name: smoke-agent
description: Harness smoke fixture agent; proves a kendex-rendered agent loads.
---

You are the smoke agent. Reply with exactly SMOKE-AGENT-LOADED and nothing else.
EOF
cat >"$CATALOG/commands/smoke-command.md" <<EOF
---
description: "Harness smoke fixture command: proves a kendex-rendered command loads."
---

$COMMAND_BODY
EOF
# Both hooks name every harness: Antigravity is reached only by a hook whose
# `harnesses:` line names it (its payload is `toolCall.args`, not
# `tool_input`), and an unnamed hook installs nothing there with a note.
HOOK_HARNESSES='[claude-code, codex, opencode, cursor, pi, gemini, copilot, antigravity]'
hook_body() { # EVENT — the shared body every fixture hook runs
  cat <<EOF
set -euo pipefail
root=\$(git rev-parse --show-toplevel)
printf '%s %s\\n' "$1" "\$0" >>"\$root/smoke-fired"
exit 0
EOF
}
{
  cat <<EOF
#!/usr/bin/env bash
# ---
# name: smoke-session
# event: SessionStart
# description: Harness smoke fixture hook; appends its event and path to smoke-fired at the project root when the harness runs it.
# safety: Writes one file at the project root and nothing else.
# timeout: 10
# harnesses: $HOOK_HARNESSES
# ---
EOF
  hook_body SessionStart
} >"$CATALOG/hooks/smoke-session.sh"
{
  cat <<EOF
#!/usr/bin/env bash
# ---
# name: smoke-tool
# event: PreToolUse
# description: Harness smoke fixture hook; appends its event and path to smoke-fired at the project root before a tool runs.
# safety: Writes one file at the project root and nothing else; never refuses a tool.
# timeout: 10
# harnesses: $HOOK_HARNESSES
# ---
EOF
  hook_body PreToolUse
} >"$CATALOG/hooks/smoke-tool.sh"
chmod +x "$CATALOG/hooks/smoke-session.sh" "$CATALOG/hooks/smoke-tool.sh"

# The server is a real stdio MCP endpoint, so a harness that starts it gets an
# `initialize` and a `tools/list` it accepts rather than a process that dies
# and reads as a broken render. It writes its marker line before anything
# else, so a start that the harness then rejects still leaves the proof.
cat >"$SERVER" <<'EOF'
#!/usr/bin/env node
import { appendFileSync } from 'node:fs';
try { appendFileSync(process.cwd() + '/smoke-fired', `McpStart ${process.cwd()}\n`); } catch {}
let buf = '';
process.stdin.on('data', (chunk) => {
  buf += chunk;
  let cut;
  while ((cut = buf.indexOf('\n')) >= 0) {
    const line = buf.slice(0, cut);
    buf = buf.slice(cut + 1);
    if (!line.trim()) continue;
    let msg;
    try { msg = JSON.parse(line); } catch { continue; }
    if (msg.id === undefined) continue;
    let result = {};
    if (msg.method === 'initialize') {
      result = {
        protocolVersion: msg.params?.protocolVersion || '2025-06-18',
        capabilities: { tools: {} },
        serverInfo: { name: 'smoke-mcp', version: '1.0.0' },
      };
    } else if (msg.method === 'tools/list') {
      result = { tools: [{
        name: 'smoke_mcp_loaded',
        description: 'Returns SMOKE-MCP-LOADED.',
        inputSchema: { type: 'object', properties: {}, additionalProperties: false },
      }] };
    } else if (msg.method === 'tools/call') {
      result = { content: [{ type: 'text', text: 'SMOKE-MCP-LOADED' }] };
    }
    process.stdout.write(JSON.stringify({ jsonrpc: '2.0', id: msg.id, result }) + '\n');
  }
});
process.stdin.on('end', () => process.exit(0));
EOF
printf 'command = "node"\nargs = ["%s"]\n' "$SERVER" >"$CATALOG/mcp/smoke-mcp.toml"

# The Pi extension is an npm package Pi loads on any start. Its package name
# is the name the carrier installs under and the name the install record is
# checked against, so the directory, the package name and the manifest key
# below are one word.
cat >"$CATALOG/pi-extensions/smoke-ext/package.json" <<'EOF'
{
  "name": "smoke-ext",
  "version": "1.0.0",
  "description": "Harness smoke fixture Pi extension; proves a kendex-installed Pi extension loads.",
  "license": "MIT",
  "keywords": ["pi-package", "pi"],
  "pi": { "extensions": ["./extensions/smoke.js"] },
  "files": ["extensions/", "package.json"],
  "author": "kendex",
  "engines": { "node": ">=22.19.0" }
}
EOF
cat >"$CATALOG/pi-extensions/smoke-ext/extensions/smoke.js" <<'EOF'
import { appendFileSync } from "node:fs";
try {
  appendFileSync(process.cwd() + "/smoke-fired", `PiExtension ${process.cwd()}\n`);
} catch {}
export default function activate() {}
EOF

# ---- one scratch project per harness ---------------------------------------
# Every harness gets the fixture installed for it alone. Several tools
# cross-read another tool's directories (Copilot reads .claude/agents and
# .claude/settings.json, Gemini and Codex read .agents/skills), so an
# all-harness install would let one harness answer for another's render.
PROJECT=""
MARKER=""
add_flags() { # HARNESS — the kendex add flags for the kinds it installs
  # `crates/core/src/harness/caps.rs::capabilities` is the source: a harness
  # whose `install` is NONE for a kind has no render to ask about, so the
  # kind is left out here and the harness gets no row for it below.
  printf '%s' '--skill smoke-skill --hook smoke-session,smoke-tool'
  case "$1" in
    claude | codex | opencode | cursor | pi | gemini | copilot) printf ' %s' '--agent smoke-agent' ;;
  esac
  case "$1" in
    claude | codex | opencode | pi | gemini) printf ' %s' '--command smoke-command' ;;
  esac
  case "$1" in
    claude | codex | opencode | cursor | gemini | copilot | antigravity)
      printf ' %s' '--mcp-server smoke-mcp' ;;
  esac
}
refused() { # HARNESS VERB LOG — the fixture install did not finish
  printf 'harness-smoke: %s for %s; %s says why\n' "$2" "$1" "$3" >&2
  KEEP=1
  exit 2
}
install_for() { # HARNESS — sets PROJECT and MARKER, exits 2 when kendex cannot install or verify
  PROJECT="$DIR/$1/project"
  MARKER="$PROJECT/smoke-fired"
  mkdir -p "$PROJECT/.agents"
  git -C "$PROJECT" init -q
  git -C "$PROJECT" config user.email harness-smoke@kendex.invalid
  git -C "$PROJECT" config user.name harness-smoke
  git -C "$PROJECT" commit -q --allow-empty -m 'scratch project for tools/harness-smoke'
  printf 'schema = 6\n' >"$PROJECT/kendex.toml"
  # shellcheck disable=SC2046 # add_flags emits whole flags to be split.
  if ! (cd "$PROJECT" && kendex add "$CATALOG" $(add_flags "$1") --harness "$1" -y) \
    >"$LOGS/$1-kendex-add.log" 2>&1; then
    refused "$1" 'the fixture did not install' "$LOGS/$1-kendex-add.log"
  fi
  if [ "$1" = pi ]; then
    # `kendex add --pi-extension` refuses by design: a Pi extension is
    # declared under [pi-extensions] in the scope's manifest and installed by
    # the update-pi verb, which is the second install verb no other row
    # touches. `catalog` is the source name kendex derived from $CATALOG's
    # basename in the add above.
    printf '\n[pi-extensions.smoke-ext]\nsource = "catalog"\nharnesses = ["pi"]\n' \
      >>"$PROJECT/kendex.toml"
    if ! (cd "$PROJECT" && kendex update-pi) >"$LOGS/$1-kendex-update-pi.log" 2>&1; then
      refused "$1" 'the Pi extension did not install' "$LOGS/$1-kendex-update-pi.log"
    fi
  fi
  if ! (cd "$PROJECT" && kendex verify --scope project) >"$LOGS/$1-kendex-verify.log" 2>&1; then
    refused "$1" 'kendex verify refused the fixture install' "$LOGS/$1-kendex-verify.log"
  fi
  printf 'kendex verify: clean for %s (%s)\n' "$1" "$PROJECT"
}

# ---- rows ------------------------------------------------------------------
FAILED=0
UNANSWERED=0
ROWS=""
row() { # HARNESS QUESTION RESULT EVIDENCE
  case "$3" in fail) FAILED=1 ;; unanswerable) UNANSWERED=1 ;; esac
  ROWS="$ROWS$(printf '| %s | %s | %s | %s |' "$1" "$2" "$3" "$4")
"
  printf '%-11s %-8s %-12s %s\n' "$1" "$2" "$3" "$4"
}
have() { command -v "$1" >/dev/null 2>&1; }
TIMEOUT=""
have timeout && TIMEOUT="timeout 300"
# Runs a harness command inside the scratch project with no stdin, both
# streams to LOGS/NAME.log; OUT holds the text and STATUS the exit code.
# Every read of OUT below is a here-string, never a printf pipeline: under
# pipefail a grep that stops early would SIGPIPE the producer and turn a
# present match into an absent one.
OUT=""
STATUS=0
run() { # NAME CMD... — cwd is the scratch project
  local name=$1
  shift
  STATUS=0
  # shellcheck disable=SC2086 # TIMEOUT is empty or the two words `timeout 300`.
  OUT=$(cd "$PROJECT" && $TIMEOUT "$@" </dev/null 2>&1) || STATUS=$?
  printf '%s\n' "$OUT" >"$LOGS/$name.log"
}
last_line() { grep -v '^[[:space:]]*$' <<<"$OUT" | tail -n 1; }
# The redirect is inside the group, so a missing marker takes the shell's own
# diagnostic with it instead of printing it beside the row's real one.
marker_text() { { tr '\n' ';' <"$MARKER"; } 2>/dev/null; }
ESC=$(printf '\033')
clip() { # TEXT — one evidence cell: colour, leading space and pipes gone, at most 160 characters
  printf '%s' "$1" | sed -e "s/$ESC\\[[0-9;]*m//g" -e 's/^[[:space:]]*//' -e 's/|/¦/g' | cut -c1-160
}
# Judges OUT against what a loaded package makes the harness say. EXPECT is
# the harness's yes, REJECT its explicit no; a run that ended non-zero with
# neither is the harness failing to answer, and an answer with neither is a
# fail because silence is not a pass. A model-relayed row anchors EXPECT to
# a whole line, because a model asked for names it does not have tends to
# name the missing thing in its denial. MARKER-LINE, where the row has one,
# is a second and independent proof: the listing says the harness read the
# render, and the line the fixture itself wrote says the harness started it.
judge() { # HARNESS QUESTION EXPECT REJECT COMMAND-TEXT [MARKER-LINE]
  local hit
  if hit=$(grep -oE -m 1 -e "$3" <<<"$OUT") && [ -n "$hit" ]; then
    hit=${hit%%$'\n'*}
    if [ -z "${6:-}" ]; then
      row "$1" "$2" pass "$5 said: $(clip "$hit")"
    elif [ -f "$MARKER" ] && grep -qF -- "$6" "$MARKER"; then
      row "$1" "$2" pass "$5 said: $(clip "$hit"), and the fixture wrote '$6'"
    else
      row "$1" "$2" fail "$5 said: $(clip "$hit"), and the fixture never wrote '$6' (marker: $(marker_text))"
    fi
  elif [ -n "$4" ] && hit=$(grep -E -m 1 -e "$4" <<<"$OUT") && [ -n "$hit" ]; then
    row "$1" "$2" fail "$5 said: $(clip "$hit")"
  elif [ "$STATUS" -ne 0 ]; then
    row "$1" "$2" unanswerable "$5 exited $STATUS: $(clip "$(last_line)")"
  else
    row "$1" "$2" fail "$5 did not say $(clip "$3"); its last line: $(clip "$(last_line)")"
  fi
}
fired() { # HARNESS EVENT RENDER-PATH COMMAND-TEXT — reads the marker
  if [ -f "$MARKER" ] && grep -qF -- "$2 $PROJECT/$3" "$MARKER"; then
    row "$1" hook pass "$4 ran $3 at $2"
  elif [ "$STATUS" -ne 0 ] && ! grep -qiE 'hook' <<<"$OUT"; then
    row "$1" hook unanswerable "$4 exited $STATUS before any hook ran: $(clip "$(last_line)")"
  else
    row "$1" hook fail "$4 did not run $3 at $2 (marker: $(marker_text))"
  fi
}
# Reads one value out of the JSON a harness printed, into JSON_HIT. A harness
# that printed no JSON answered nothing the row can read, so the caller fails
# the row rather than reading an empty extraction as an absent package.
JSON_HIT=""
extract() { # JQ-FILTER [JQ-FLAGS...]
  local filter=$1
  shift
  JSON_HIT=""
  JSON_HIT=$(jq -r "$@" "$filter" <<<"$OUT" 2>/dev/null)
}
located() { # HARNESS QUESTION RENDER-PATH COMMAND-TEXT JQ-FILTER [JQ-FLAGS...] — a listing that carries the item's path
  local harness=$1 question=$2 rendered="$PROJECT/$3" command=$4
  shift 4
  if [ "$STATUS" -ne 0 ]; then
    row "$harness" "$question" unanswerable "$command exited $STATUS: $(clip "$(last_line)")"
  elif ! extract "$@"; then
    row "$harness" "$question" fail "$command printed no JSON the row can read: $(clip "$(last_line)")"
  elif [ "$JSON_HIT" = "$rendered" ]; then
    row "$harness" "$question" pass "$command lists it at $JSON_HIT"
  else
    row "$harness" "$question" fail "$command lists it at '${JSON_HIT:-nothing}'"
  fi
}
holds() { # HARNESS QUESTION RENDER-PATH COMMAND-TEXT MARKER-LINE — a plain-text listing that names the render
  if ! grep -qF -- "$PROJECT/$3" <<<"$OUT"; then
    if [ "$STATUS" -ne 0 ]; then
      row "$1" "$2" unanswerable "$4 exited $STATUS: $(clip "$(last_line)")"
    else
      row "$1" "$2" fail "$4 did not name $3; its last line: $(clip "$(last_line)")"
    fi
  elif [ -f "$MARKER" ] && grep -qF -- "$5" "$MARKER"; then
    row "$1" "$2" pass "$4 names $3, and the fixture wrote '$5'"
  else
    row "$1" "$2" fail "$4 names $3, and the fixture never wrote '$5' (marker: $(marker_text))"
  fi
}
questions() { # HARNESS — the rows this harness answers, in the order it answers them
  case "$1" in
    claude) printf '%s' 'skill hook agent command mcp' ;;
    opencode | gemini) printf '%s' 'skill agent hook command mcp' ;;
    codex) printf '%s' 'skill command agent hook mcp' ;;
    pi) printf '%s' 'skill agent command pi-ext hook' ;;
    antigravity) printf '%s' 'skill hook mcp' ;;
    *) printf '%s' 'skill agent hook mcp' ;;
  esac
}
absent() { # HARNESS CLI — every row of a harness whose CLI is not installed
  local q
  for q in $(questions "$1"); do row "$1" "$q" unanswerable "$2 is not on PATH"; done
}
skipped() {
  local q
  for q in $(questions "$1"); do row "$1" "$q" skipped 'not in --only'; done
}
wants() { case " $ONLY " in *" $1 "*) return 0 ;; esac; return 1; }

# An isolated config dir per harness that gates the project, holding a copy of
# the login record and the one entry that opens the gate. The real config dir
# is read and never written, and nothing here reaches a harness's own state.
copied_home() { # NAME SOURCE-DIR FILE — prints the isolated dir
  local home="$DIR/$1"
  mkdir -p "$home"
  [ -f "$2/$3" ] && cp "$2/$3" "$home/$3"
  printf '%s' "$home"
}

# Claude Code: a slash invocation expands the skill or the command, or answers
# Unknown command; --agent runs the session as that agent or lists what
# exists; the SessionStart registration in .claude/settings.json runs the
# script; `mcp list` reads .mcp.json and starts the server it names.
claude_rows() {
  have claude || { absent claude claude; return; }
  install_for claude
  # Every claude run goes through a CLAUDE_CONFIG_DIR of its own. A project
  # `.mcp.json` server starts as `⏸ Pending approval`, and the approval is
  # recorded per project in the config dir rather than in the render, so the
  # mcp row needs one anyway; using it for the -p runs as well keeps a
  # transcript directory for a dead scratch path out of the real config.
  local home
  home=$(copied_home claude-home "${CLAUDE_CONFIG_DIR:-$HOME/.claude}" .credentials.json)
  jq -n --arg p "$PROJECT" '{hasCompletedOnboarding: true, projects: {($p): {hasTrustDialogAccepted: true, enabledMcpjsonServers: ["smoke-mcp"]}}}' \
    >"$home/.claude.json"
  rm -f -- "$MARKER"
  run claude-skill env CLAUDE_CONFIG_DIR="$home" claude -p '/smoke-skill'
  judge claude skill 'SMOKE-SKILL-LOADED' 'Unknown command' 'claude -p /smoke-skill'
  fired claude SessionStart .claude/hooks/smoke-session.sh 'claude -p'
  run claude-agent env CLAUDE_CONFIG_DIR="$home" claude -p --agent smoke-agent \
    'Reply exactly as your agent instructions say.'
  judge claude agent 'SMOKE-AGENT-LOADED' 'not found' 'claude -p --agent smoke-agent'
  run claude-command env CLAUDE_CONFIG_DIR="$home" claude -p '/smoke-command'
  judge claude command "$COMMAND_ANSWER" 'Unknown command' 'claude -p /smoke-command'
  rm -f -- "$MARKER"
  run claude-mcp env CLAUDE_CONFIG_DIR="$home" claude mcp list
  judge claude mcp 'smoke-mcp: .* Connected' 'smoke-mcp: .*(Pending approval|Failed)' \
    'claude mcp list' "McpStart $PROJECT"
}

# Codex: `debug prompt-input` renders the skills block the model sees, no
# model turn needed, and a Codex command installs as a skill, so both rows
# read that one listing. Agents surface only as spawn_agent roles inside the
# tool schema, so the model relays them; the same exec turn runs SessionStart,
# which Codex gates on hook trust the flag stands in for.
codex_rows() {
  have codex || { absent codex codex; return; }
  install_for codex
  # Every codex run goes through a CODEX_HOME of its own: `codex exec`
  # persists a trust entry for the directory it ran in, which would leave one
  # dead scratch path in the real config per run, and Codex reads a project's
  # `config.toml` only once that project is trusted, which is what the mcp row
  # needs. The same command against the real CODEX_HOME lists the global
  # servers and never smoke-mcp, which is the mcp row's must-fail control.
  local home
  home=$(copied_home codex-home "${CODEX_HOME:-$HOME/.codex}" auth.json)
  printf '[projects."%s"]\ntrust_level = "trusted"\n' "$PROJECT" >"$home/config.toml"
  run codex-skill env CODEX_HOME="$home" codex debug prompt-input
  judge codex skill '- smoke-skill: [^(]*\(file: r[0-9]+/smoke-skill/SKILL.md\)' '' 'codex debug prompt-input'
  judge codex command '- smoke-command: [^(]*\(file: r[0-9]+/smoke-command/SKILL.md\)' '' \
    'codex debug prompt-input (a Codex command installs as a skill)'
  rm -f -- "$MARKER"
  run codex-agent env CODEX_HOME="$home" codex exec --ephemeral --dangerously-bypass-hook-trust \
    'List the custom agent names available to spawn_agent, one per line, nothing else.'
  judge codex agent '^smoke-agent$' '' 'codex exec (model-relayed spawn_agent roles)'
  fired codex SessionStart .codex/hooks/smoke-session.sh 'codex exec --dangerously-bypass-hook-trust'
  # A config reading and not a connection, so there is no marker to pin.
  run codex-mcp env CODEX_HOME="$home" codex mcp list
  judge codex mcp '^smoke-mcp .*enabled' '' 'codex mcp list (CODEX_HOME trusting the scratch project)'
}

# OpenCode: three debug listings and one mcp listing, no model turn. OpenCode
# runs no hooks; kendex installs the hook as an instruction file plus a config
# reference, and the row checks the resolved config carries it — the same
# resolved config that carries the command's template.
opencode_rows() {
  have opencode || { absent opencode opencode; return; }
  install_for opencode
  run opencode-skill opencode debug skill
  located opencode skill .agents/skills/smoke-skill/SKILL.md 'opencode debug skill' \
    '.[] | select(.name == "smoke-skill") | .location'
  run opencode-agent opencode agent list
  judge opencode agent '^smoke-agent \(subagent\)' '' 'opencode agent list'
  run opencode-config opencode debug config
  if [ "$STATUS" -ne 0 ]; then
    row opencode hook unanswerable "opencode debug config exited $STATUS: $(clip "$(last_line)")"
    row opencode command unanswerable "opencode debug config exited $STATUS: $(clip "$(last_line)")"
  else
    if ! extract '.instructions[]?'; then
      row opencode hook fail "opencode debug config printed no JSON the row can read: $(clip "$(last_line)")"
    elif grep -qFx -- '.opencode/instructions/kendex-hook-smoke-session.md' <<<"$JSON_HIT"; then
      row opencode hook advisory 'no hook runs on OpenCode; opencode debug config lists .opencode/instructions/kendex-hook-smoke-session.md'
    else
      row opencode hook fail 'no hook runs on OpenCode, and opencode debug config does not list .opencode/instructions/kendex-hook-smoke-session.md'
    fi
    if ! extract '.command["smoke-command"].template'; then
      row opencode command fail "opencode debug config printed no JSON the row can read: $(clip "$(last_line)")"
    elif [ "$JSON_HIT" = "$COMMAND_BODY" ]; then
      row opencode command pass 'opencode debug config resolves smoke-command to the rendered template'
    else
      row opencode command fail "opencode debug config resolves smoke-command to '${JSON_HIT:-nothing}'"
    fi
  fi
  rm -f -- "$MARKER"
  run opencode-mcp opencode mcp list
  # The other five statuses opencode can print for a server, so a refusal reads
  # as the harness's no rather than as silence. None of them holds `connected`.
  judge opencode mcp 'smoke-mcp.*connected' \
    'smoke-mcp.*(failed|not initialized|disabled|needs )' \
    'opencode mcp list' "McpStart $PROJECT"
}

# Cursor: no listing surface for rules or skills, so the model is asked to
# name what it was given; the hook is a rule, never run. The mcp row needs no
# login — everything the CLI reads off disk and starts locally answers while
# cursor-agent is logged out — but it does need the project approval that
# `mcp enable` records under HOME, so it runs under a HOME of its own.
cursor_rows() {
  have cursor-agent || { absent cursor cursor-agent; return; }
  install_for cursor
  run cursor-status cursor-agent status
  if grep -qi 'not logged in' <<<"$OUT"; then
    local why='cursor-agent is not logged in (cursor-agent status), and rules and skills have no listing besides the model'
    row cursor skill unanswerable "$why"
    row cursor agent unanswerable "$why"
    row cursor hook unanswerable "no hook runs on Cursor; $why"
  else
    run cursor-list cursor-agent -p --trust --output-format text \
      'List the names of every rule and skill available to you, one per line, nothing else.'
    judge cursor skill '^smoke-skill$' '' 'cursor-agent -p (model-relayed listing)'
    judge cursor agent '^smoke-agent$' '' 'cursor-agent -p (model-relayed listing)'
    if grep -qE '^safety-smoke-session$' <<<"$OUT"; then
      row cursor hook advisory 'no hook runs on Cursor; the model lists the safety-smoke-session rule'
    elif [ "$STATUS" -ne 0 ]; then
      row cursor hook unanswerable "cursor-agent -p exited $STATUS: $(clip "$(last_line)")"
    else
      row cursor hook fail 'no hook runs on Cursor, and the model did not list the safety-smoke-session rule'
    fi
  fi
  local home="$DIR/cursor-home"
  mkdir -p "$home"
  rm -f -- "$MARKER"
  # Before the approval the same listing says `not loaded (needs approval)`,
  # which is this row's must-fail control.
  run cursor-mcp-enable env HOME="$home" cursor-agent mcp enable smoke-mcp
  run cursor-mcp env HOME="$home" cursor-agent mcp list
  judge cursor mcp '^smoke-mcp: ready' '^smoke-mcp: not loaded' \
    'cursor-agent mcp enable, then mcp list' "McpStart $PROJECT"
}

# Pi: get_commands over RPC lists every skill as a skill: command and every
# prompt template as a command, each with its rendered path, so one RPC run
# answers both rows and starts the extension that writes its own marker line.
# Pi core has no agent surface: .pi/agents/*.md is read by the pi-agents-tmux
# extension, which lists agents only in its dashboard. The pi-hooks carrier
# dispatches tool_call alone, so the hook row asks for one tool call; the
# SessionStart registration is written and never dispatched. Pi reads no MCP
# servers at all, so it gets no mcp row.
pi_rows() {
  have pi || { absent pi pi; return; }
  install_for pi
  rm -f -- "$MARKER"
  STATUS=0
  OUT=$(cd "$PROJECT" && printf '{"id":"1","type":"get_commands"}\n' | $TIMEOUT pi --mode rpc --approve --no-session 2>&1) || STATUS=$?
  printf '%s\n' "$OUT" >"$LOGS/pi-skill.log"
  located pi skill .agents/skills/smoke-skill/SKILL.md 'pi --mode rpc get_commands' \
    'fromjson? | select(.type == "response" and .command == "get_commands") | .data.commands[] | select(.name == "skill:smoke-skill") | .sourceInfo.path' -R
  row pi agent unanswerable 'Pi core has no agent surface; .pi/agents/*.md is read by the pi-agents-tmux extension, which lists agents only in its interactive dashboard'
  located pi command .pi/prompts/smoke-command.md 'pi --mode rpc get_commands' \
    'fromjson? | select(.type == "response" and .command == "get_commands") | .data.commands[] | select(.name == "smoke-command") | .sourceInfo.path' -R
  # The marker is deliberately not cleared here: `pi list` starts no session,
  # so the PiExtension line this row reads is the one the RPC run above left,
  # which is the same claim — any pi start loads the extension.
  run pi-ext pi list
  holds pi pi-ext .pi/packages/smoke-ext 'pi list' "PiExtension $PROJECT"
  rm -f -- "$MARKER"
  run pi-hook pi -p --approve --no-session \
    'Run the shell command true with your bash tool, then reply with exactly: ok'
  fired pi PreToolUse .pi/kendex/hooks/smoke-tool.sh 'pi -p (one tool call; SessionStart is registered and never dispatched by the carrier)'
}

# Gemini CLI: `skills list` names project skills with their location, and
# `mcp list` starts the server it reads from the render. No listing names
# project agents: --debug prints only an AgentRegistry count, which reads the
# same with the agent file removed. The SessionStart registration runs before
# the model is reached, so the hook row stands even where the model call
# fails; --debug makes Gemini name its hook run, which tells a hook that did
# not run from a session that never started.
gemini_rows() {
  have gemini || { absent gemini gemini; return; }
  install_for gemini
  run gemini-skill gemini skills list
  if grep -qE '^smoke-skill \[Enabled\]' <<<"$OUT" \
    && grep -qF -- "$PROJECT/.agents/skills/smoke-skill/SKILL.md" <<<"$OUT"; then
    row gemini skill pass "gemini skills list said smoke-skill [Enabled] at $PROJECT/.agents/skills/smoke-skill/SKILL.md"
  elif grep -qi 'not trusted' <<<"$OUT"; then
    row gemini skill fail "gemini skills list skipped the project: $(clip "$(grep -i -m 1 'not trusted' <<<"$OUT")")"
  elif [ "$STATUS" -ne 0 ]; then
    row gemini skill unanswerable "gemini skills list exited $STATUS: $(clip "$(last_line)")"
  else
    row gemini skill fail 'gemini skills list did not list smoke-skill [Enabled] at the project path'
  fi
  row gemini agent unanswerable 'no gemini listing names project agents; gemini --debug prints only an AgentRegistry count, unchanged with the agent file removed'
  rm -f -- "$MARKER"
  run gemini-hook gemini -p 'Reply with exactly: ok' --skip-trust --debug
  fired gemini SessionStart .gemini/hooks/smoke-session.sh 'gemini -p --skip-trust --debug'
  row gemini command unanswerable 'gemini has no command listing: its four subcommands are mcp, extensions, skills and hooks, and --debug says nothing about .gemini/commands/*.toml. The one model-free enumeration, the availableCommands of an ACP session/new reply, is refused on this account with the migrate-to-Antigravity message that also fails every gemini -p run'
  rm -f -- "$MARKER"
  run gemini-mcp gemini mcp list
  judge gemini mcp '✓ smoke-mcp: .*Connected' 'smoke-mcp: .*Disconnected' 'gemini mcp list' "McpStart $PROJECT"
}

# Copilot: `skill list` names repository skills; --agent runs the session as
# the agent or lists what exists; `mcp list` reads .github/mcp.json. Repository
# hooks run only for a folder the settings name in trustedFolders, so the runs
# use an isolated COPILOT_HOME holding a copy of the login record and that one
# trust entry. Copilot CLI reads no command surface of its own, so it gets no
# command row.
copilot_rows() {
  have copilot || { absent copilot copilot; return; }
  install_for copilot
  local home
  home=$(copied_home copilot-home "${COPILOT_HOME:-$HOME/.copilot}" config.json)
  jq -n --arg p "$PROJECT" '{trustedFolders: [$p]}' >"$home/settings.json"
  run copilot-skill env COPILOT_HOME="$home" copilot skill list
  judge copilot skill '^  smoke-skill - .*' '' 'copilot skill list'
  rm -f -- "$MARKER"
  run copilot-agent env COPILOT_HOME="$home" copilot -p 'Reply exactly as your agent instructions say.' --agent smoke-agent --allow-all-tools -s
  judge copilot agent 'SMOKE-AGENT-LOADED' 'No such agent' 'copilot -p --agent smoke-agent'
  fired copilot SessionStart .github/hooks/smoke-session.sh 'copilot -p (COPILOT_HOME trusting the scratch project)'
  # A config reading, not a connection, so there is no marker to pin.
  run copilot-mcp env COPILOT_HOME="$home" copilot mcp list
  judge copilot mcp '^ +smoke-mcp \(local\)' '' 'copilot mcp list'
}

# Antigravity: agy reads a project's `.agents/` only for a folder the session
# attaches, so every run carries --add-dir naming the scratch project; without
# it a run resolves the default project, which lists no folder, and loads no
# skill, hook or server from the render. A slash invocation in print mode
# expands the skill; `-p` swallows the next word, so the prompt is attached to
# it and every other flag comes first. One run with a tool call answers hook
# and mcp together: agy loads the attached folder's hooks.json and starts its
# MCP servers before the model is reached, and --log-file records both, so
# the mcp row stands and a render agy never read reads as a fail even where
# the model call fails. `agy mcp list` reads the user-level file alone and
# cannot name a project server, so the mcp row's proof is the server's own
# marker line. No agent row: kendex renders no project agent for Antigravity.
antigravity_rows() {
  have agy || { absent antigravity agy; return; }
  install_for antigravity
  local home startup q
  home="$DIR/agy-home"
  # `~/.gemini` alone is Gemini CLI's root too; the settings directory under
  # it is agy's own, so it is what proves a login worth copying.
  if ! [ -d "$HOME/.gemini/antigravity-cli" ]; then
    for q in $(questions antigravity); do
      row antigravity "$q" unanswerable 'agy has no ~/.gemini/antigravity-cli to copy: not logged in on this machine'
    done
    return
  fi
  mkdir -p "$home"
  # The source is live state another agy session may be writing, so a copy
  # that fails is three unanswerable rows, never a dead run.
  if ! cp -a "$HOME/.gemini" "$home/.gemini" 2>"$LOGS/agy-home-copy.log"; then
    for q in $(questions antigravity); do
      row antigravity "$q" unanswerable "copying ~/.gemini into an isolated HOME failed: $(clip "$(tail -n 1 "$LOGS/agy-home-copy.log")")"
    done
    return
  fi
  run agy-skill env HOME="$home" agy --add-dir "$PROJECT" --dangerously-skip-permissions -p=/smoke-skill
  judge antigravity skill '^SMOKE-SKILL-LOADED$' '' 'agy --add-dir -p=/smoke-skill'
  rm -f -- "$MARKER"
  startup="$LOGS/agy-hook-mcp.startup.log"
  run agy-hook-mcp env HOME="$home" agy --add-dir "$PROJECT" --log-file "$startup" --dangerously-skip-permissions \
    -p='Run the shell command true with your terminal tool, then reply with exactly: ok'
  if grep -qF 'loaded 0 named hooks' "$startup" 2>/dev/null; then
    row antigravity hook fail "agy --add-dir loaded 0 named hooks from 0 hooks.json file(s): it never read .agents/hooks.json (marker: $(marker_text))"
  else
    fired antigravity PreToolUse .agents/hooks/smoke-tool.sh 'agy --add-dir -p (one tool call)'
  fi
  if [ -f "$MARKER" ] && grep -qF -- "McpStart $PROJECT" "$MARKER"; then
    row antigravity mcp pass "agy --add-dir started the server on startup, and the fixture wrote 'McpStart $PROJECT'"
  elif grep -qF 'empty component: prompt section "mcp_servers"' "$startup" 2>/dev/null; then
    row antigravity mcp fail "agy --add-dir resolved no MCP server on startup: it never read .agents/mcp_config.json (marker: $(marker_text))"
  elif [ "$STATUS" -ne 0 ]; then
    row antigravity mcp unanswerable "agy --add-dir -p exited $STATUS before starting the server: $(clip "$(last_line)")"
  else
    row antigravity mcp fail "agy --add-dir -p never started the server (marker: $(marker_text))"
  fi
}

printf '%-11s %-8s %-12s %s\n' harness row result evidence
for h in $HARNESSES; do
  if wants "$h"; then "${h}_rows"; else skipped "$h"; fi
done

printf '\n| harness | row | result | evidence |\n|---|---|---|---|\n%s' "$ROWS"
printf '\nlogs: %s\n' "$LOGS"
if [ "$FAILED" -eq 1 ]; then
  printf 'harness-smoke: a harness did not load a kendex-installed package\n' >&2
  KEEP=1
  exit 1
fi
if [ "$UNANSWERED" -eq 1 ]; then
  printf 'harness-smoke: no row failed, and a row could not be answered; read its reason\n' >&2
  exit 3
fi
