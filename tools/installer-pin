#!/usr/bin/env bash
# Pin the kendex the review-gate workflow templates install to a release tag,
# and the installer they fetch to the commit that tag names.
#
# Usage: tools/installer-pin <tag>
#        tools/installer-pin --check
#
# <tag>: write `KENDEX_VERSION: <tag>` and `KENDEX_INSTALLER_SHA: <commit>`,
#   the commit the tag names, into every pin site, then check them.
# --check: every pin site names one version, and its KENDEX_INSTALLER_SHA is
#   the commit the tag of that version names. CI runs it on every change to
#   a site, since a site reaches consumers when it merges.
# -h, --help: print this help.
#
# The writer templates fetch install.sh at KENDEX_INSTALLER_SHA and run it before a
# credentialed step, so it must be an immutable commit: a tag can be moved.
# The tag only selects the binary release. One run writes both values from
# one tag, so neither lands without the other.
#
# The pin sites are the writer template, its render under .agents/skills/,
# and this repository's adopted writer workflow. The refresh template resolves
# the latest release at run time and is never a pin site. Each writer site holds
# exactly one line of each variable. A tag resolves in this checkout first, else on origin
# through `git ls-remote`, which is how a shallow CI checkout with no tags
# reads it; nothing is fetched.
#
# A run writes one keyed line, `installer-pin: <key>=<value>`, and a refusal
# follows it with English explanation lines; only the keyed line is stable.
#   option=<arg>      unknown or missing argument (exit 2)
#   tag=<tag>         no tag of that name, in this checkout or on origin (exit 1)
#   remote=origin     the tags on origin could not be listed (exit 1)
#   site=<path>       a pin site is missing, a symlink, could not be read, or
#                     does not hold exactly one line of each variable (exit 1)
#   mismatch=<path>   the site names another version than the first site, or
#                     a SHA that is not its version's commit (exit 1)
#   pinned=<tag>      every site names <tag> and its commit
set -euo pipefail
export LC_ALL=C

root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
usage='usage: tools/installer-pin <tag> | --check'
sites="skills/review-gate/templates/review-gate-writer.yml
.agents/skills/review-gate/templates/review-gate-writer.yml
.github/workflows/review-gate-writer.yml"

say() { # KEY VALUE [LINE...] — the keyed line, then each explanation line
  printf 'installer-pin: %s=%s\n' "$1" "$2"
  shift 2
  for line in "$@"; do printf '%s\n' "$line"; done
}

commit_of() { # TAG — the commit the tag names, in this checkout or on origin
  local listing sha
  if sha="$(git -C "$root" rev-parse --verify --quiet "refs/tags/$1^{commit}")"; then
    printf '%s\n' "$sha"
    return 0
  fi
  listing="$(git -C "$root" ls-remote --tags origin "refs/tags/$1" "refs/tags/$1^{}")" ||
    { say remote origin "the tags on origin could not be listed, so tag $1 could not be resolved" >&2; exit 1; }
  # An annotated tag lists its own object and, peeled, the commit it names.
  sha="$(TAG_REF="refs/tags/$1" awk '
    $2 == ENVIRON["TAG_REF"] "^{}" { peeled = $1 }
    $2 == ENVIRON["TAG_REF"] { plain = $1 }
    END { print (peeled != "" ? peeled : plain) }
  ' <<<"$listing")"
  [ -n "$sha" ] || { say tag "$1" "no tag of that name, in this checkout or on origin" >&2; exit 1; }
  printf '%s\n' "$sha"
}

value() { # SITE VARIABLE — the variable's value on its one line in SITE
  local count
  { [ -f "$root/$1" ] && [ ! -L "$root/$1" ]; } ||
    { say site "$1" "is missing or a symlink; no pin is read or written through one" >&2; exit 1; }
  count="$(grep -c -E -e "^ *$2: " -- "$root/$1")" || [ "$?" -eq 1 ] ||
    { say site "$1" "could not be read" >&2; exit 1; }
  [ "$count" = 1 ] || { say site "$1" "holds $count lines of $2, not 1" >&2; exit 1; }
  sed -n -E -e "s/^ *$2: (.*)$/\\1/p" -- "$root/$1"
}

check() {
  local site version sha want first=""
  while IFS= read -r site; do
    version="$(value "$site" KENDEX_VERSION)" || exit 1
    sha="$(value "$site" KENDEX_INSTALLER_SHA)" || exit 1
    [ -n "$first" ] || first="$version"
    [ "$version" = "$first" ] ||
      { say mismatch "$site" "names $version, the first site names $first" >&2; exit 1; }
    want="$(commit_of "$version")" || exit 1
    [ "$sha" = "$want" ] ||
      { say mismatch "$site" "KENDEX_INSTALLER_SHA is $sha, tag $version names $want" >&2; exit 1; }
  done <<<"$sites"
  say pinned "$first"
}

pin() { # TAG
  local site path sha
  sha="$(commit_of "$1")" || exit 1
  # Every site is read before any is written, so a bad one writes none.
  while IFS= read -r site; do
    value "$site" KENDEX_VERSION >/dev/null
    value "$site" KENDEX_INSTALLER_SHA >/dev/null
  done <<<"$sites"
  while IFS= read -r site; do
    path="$root/$site"
    PIN_VERSION="$1" PIN_SHA="$sha" awk '
      match($0, /^ *KENDEX_VERSION: /) { print substr($0, 1, RLENGTH) ENVIRON["PIN_VERSION"]; next }
      match($0, /^ *KENDEX_INSTALLER_SHA: /) { print substr($0, 1, RLENGTH) ENVIRON["PIN_SHA"]; next }
      { print }
    ' "$path" >"$path.pin"
    cat -- "$path.pin" >"$path"
    rm -- "$path.pin"
  done <<<"$sites"
  check
}

case "${1:-}" in
  -h|--help) sed -n '2,35p' "${BASH_SOURCE[0]}" ;;
  --check) [ "$#" -eq 1 ] || { say option "$2" "$usage" >&2; exit 2; }; check ;;
  ''|-*) say option "${1:-}" "$usage" >&2; exit 2 ;;
  *) [ "$#" -eq 1 ] || { say option "$2" "$usage" >&2; exit 2; }; pin "$1" ;;
esac
