#!/usr/bin/env bash
# Prepare a fleet clone before its worktree is created.
set -euo pipefail

node_version=""
node_version="$(node --version)" || exit $?
npm_version=""
npm_version="$(npm --version)" || exit $?
printf 'lane-setup: versions=node:%s npm:%s\n' "$node_version" "$npm_version"

ui_inputs=""
ui_inputs="$(git rev-parse HEAD:ui/package.json HEAD:ui/package-lock.json)" || exit $?
ui_marker=ui/node_modules/.kendex-lane-setup
installed_ui_inputs=""
if [ -f "$ui_marker" ]; then
  installed_ui_inputs="$(cat -- "$ui_marker")" || exit $?
fi
if [ "$installed_ui_inputs" = "$ui_inputs" ]; then
  printf 'lane-setup: ui=skip\n'
else
  printf 'lane-setup: ui=install\n'
  npm ci --no-audit --no-fund --prefix ui
  printf '%s\n' "$ui_inputs" >"$ui_marker"
fi

targets="aarch64-apple-darwin x86_64-pc-windows-msvc"
installed_targets=""
installed_targets="$(rustup target list --installed)" || exit $?
targets_ready=yes
for target in $targets; do
  if ! grep -Fxq "$target" <<<"$installed_targets"; then
    targets_ready=no
  fi
done

if [ "$targets_ready" = yes ]; then
  printf 'lane-setup: rust-targets=skip\n'
else
  printf 'lane-setup: rust-targets=install\n'
  rustc --version
  rustup target add aarch64-apple-darwin x86_64-pc-windows-msvc
fi

# The lane cargo configuration, written only on a fleet sandbox: one whose
# environment carries a non-empty DAYTONA_SANDBOX_ID, which the Daytona
# daemon and the fleet's login profile both export and a developer machine
# does not. This script runs as a child process at lane create, so an export
# here never reaches a later lane shell; what later cargo runs need is
# persisted in files instead. write_owned replaces each file whole when its
# content changes and refuses one this script did not write.
#
# The cargo file is .cargo/config.toml in the directory holding this clone.
# Cargo reads the config of every ancestor of its working directory, so that
# one file reaches the clone and every worktree created beside it under
# <parent>/.worktrees/; a worktree placed elsewhere by WORKTREE_BASE_DIR does
# not read it. ~/.cargo/config.toml belongs to the lane image, and cargo
# merges the two files.
#
# - incremental off: incremental caches cost gigabytes of sandbox disk, and
#   sccache does not cache an incremental compilation.
# - no target dir: each checkout keeps its own target/, because cargo keys a
#   workspace crate by its path inside the workspace and judges freshness by
#   source mtimes, so a shared target dir lets one checkout run another's
#   build. A CARGO_TARGET_DIR the fleet exports still wins.
# - linker: the image's, when its cargo config already passes -fuse-ld;
#   otherwise mold, else lld, when installed, for Linux targets only.
# - rustc wrapper: sccache, when it is installed and the fleet's shared cache
#   endpoint FLEET_SCCACHE_REDIS_ENDPOINT is non-empty. The endpoint goes to
#   sccache's own config file, which every sccache server reads whoever
#   starts it; a cargo [env] entry would reach only a server a build started.
toml_string() {
  local value=$1
  value=${value//\\/\\\\}
  value=${value//\"/\\\"}
  printf '"%s"' "$value"
}

owned_header='# Written by tools/lane-setup, rewritten on every run: edits here are lost.'

# write_owned KEY PATH CONTENT: replaces a file this script wrote, refuses one
# it did not, and announces KEY=write or KEY=skip.
write_owned() {
  local key=$1 path=$2 content="$owned_header"$'\n'"$3" current=""
  if [ -e "$path" ]; then
    current="$(cat -- "$path")" || exit $?
    if [ "${current%%$'\n'*}" != "$owned_header" ]; then
      printf 'lane-setup: %s=foreign path=%s\n' "$key" "$path"
      printf 'The file exists and tools/lane-setup did not write it; move it aside to let the lane configuration in.\n'
      exit 1
    fi
  fi
  if [ "$current" = "$content" ]; then
    printf 'lane-setup: %s=skip\n' "$key"
    return 0
  fi
  printf 'lane-setup: %s=write path=%s\n' "$key" "$path"
  mkdir -p -- "${path%/*}"
  printf '%s\n' "$content" >"$path.lane-setup"
  mv -- "$path.lane-setup" "$path"
}

write_lane_cargo_config() {
  local lanes_dir="" cargo_config="" sccache_path="" image_config="" linker="" status=0
  lanes_dir="$(cd .. && pwd -P)" || exit $?
  printf 'lane-setup: incremental=off\n'
  cargo_config="[build]
incremental = false"

  if [ -z "${FLEET_SCCACHE_REDIS_ENDPOINT:-}" ]; then
    printf 'lane-setup: rustc-wrapper=none:endpoint-unset\n'
  elif ! sccache_path="$(command -v sccache)"; then
    printf 'lane-setup: rustc-wrapper=none:sccache-absent\n'
  else
    printf 'lane-setup: rustc-wrapper=%s\n' "$sccache_path"
    cargo_config="$cargo_config
rustc-wrapper = $(toml_string "$sccache_path")"
    write_owned sccache-config "${XDG_CONFIG_HOME:-$HOME/.config}/sccache/config" "[cache.redis]
endpoint = $(toml_string "$FLEET_SCCACHE_REDIS_ENDPOINT")"
  fi

  image_config="${CARGO_HOME:-$HOME/.cargo}/config.toml"
  if [ -e "$image_config" ]; then
    grep -q -e '-fuse-ld=' -- "$image_config" || status=$?
    case "$status" in
      0) linker=image ;;
      1) ;;
      *) exit "$status" ;;
    esac
  fi
  if [ -z "$linker" ]; then
    if command -v mold >/dev/null; then
      linker=mold
    elif command -v ld.lld >/dev/null; then
      linker=lld
    else
      linker=none
    fi
  fi
  printf 'lane-setup: linker=%s\n' "$linker"
  case "$linker" in
    mold | lld)
      cargo_config="$cargo_config

[target.'cfg(target_os = \"linux\")']
rustflags = [\"-C\", \"link-arg=-fuse-ld=$linker\"]"
      ;;
    image | none) ;;
    *) printf 'lane-setup: linker=invalid value=%s\n' "$linker"; exit 70 ;;
  esac

  write_owned cargo-config "$lanes_dir/.cargo/config.toml" "$cargo_config"
}

if [ -z "${DAYTONA_SANDBOX_ID:-}" ]; then
  printf 'lane-setup: cargo-config=not-sandbox\n'
else
  write_lane_cargo_config
fi
