#!/usr/bin/env bash
# Record this repository's install record on the default branch after a
# merge, and land it through one rolling pull request.
#
# Usage: tools/lock-record [--repo DIR] [--base BRANCH] [--remote NAME] [--branch NAME]
#
# --repo DIR       the checkout of the default branch to judge (default: the
#                  checkout this script sits in)
# --base BRANCH    the branch the rolling pull request targets (default main)
# --remote NAME    the remote the rolling branch is pushed to (default origin)
# --branch NAME    the rolling branch (default kendex/lock)
# -h, --help       print this help
#
# The kendex on PATH is the judge; .github/workflows/lock-record.yml builds
# it from the checkout, since the kendex code that hashes, renders and
# records is part of what moves the record. The run refreshes the source
# mirrors, then asks `kendex verify` whether the committed record is what
# this tree would write. A current record ends the run. Otherwise the open
# rolling pull request, where one exists, is judged the same way: its
# commit is cherry-picked onto the head with no commit, which applies the
# change it made to the head it was recorded from, as the queue's squash
# merge would, and `kendex verify` asked again; a pass means that pull
# request records this tree, so nothing is pushed and it is armed where it
# was not, and a conflict or a failed verify means it is stale. A
# cherry-pick, unlike a merge, needs no history behind the head: the
# workflow's checkout holds the head alone, and the fetch of the rolling
# branch brings that commit and its parent. A stale record is then
# re-recorded with `kendex refresh`, verified again, committed on the
# rolling branch from the checkout's head, force-pushed, and put up as one
# pull request the merge queue takes; a pull request already open on the
# branch is disarmed and dequeued before the push, as
# skills/orch/workflows/merge-pr-restack.md step 1 does, and armed again
# after it. Nothing here pushes to the default branch: the organization
# ruleset takes every change to it through the merge queue
# (docs/decisions/D003-one-merge-path.md), and the record takes the same
# route (docs/decisions/D007-lock-record-on-main.md). The rule a branch
# follows is skills/AGENTS.md.
#
# `gh` reads its token from GH_TOKEN, git pushes through the credential
# helper `gh auth setup-git` installed for that token, and the commit
# identity is GIT_AUTHOR_* and GIT_COMMITTER_*. The disarm and dequeue
# mutations are the github skill's, .agents/skills/github/scripts/lib/merge-queue.sh.
# The suite is crates/cli/tests/lock_record.rs.
#
# Every notice this script writes opens `lock-record: <key>=<value>`; the
# lines after a keyed line explain it, and what kendex, git and gh print
# passes through as is:
#   option=<arg>                unknown option, or one with no value (exit 2)
#   repo=<dir>                  not a git checkout (exit 2)
#   status=<dir>                git could not read the checkout (exit 2), what the refresh wrote, or apply the rolling commit onto the head, which every run repeats until that pull request is closed or its branch replaced (exit 1)
#   dirty=<n>                   the checkout has n uncommitted paths; nothing was judged (exit 2)
#   source-refresh=<status>     `kendex source refresh` failed (exit 1)
#   current=<sha>               the record matches the tree at that head; nothing was written
#   rolling-read=<status>       the remote could not say whether the rolling branch exists (exit 1)
#   pull-request-list=<branch>  gh could not list the branch's pull requests; nothing pushed (exit 1)
#   pull-request-state=<n>      the open pull request's arming and queue state could not be read; nothing pushed (exit 1)
#   rolling-current=<sha> pull-request=<n>
#                               that pull request's commit, merged onto the head, verifies clean; nothing pushed
#   refresh=<status>            `kendex refresh` failed (exit 1)
#   stale-after-refresh=<sha>   verify still fails after the refresh; the paths it wrote follow (exit 1)
#   refresh-wrote-nothing=<sha> verify failed, and the refresh changed no tracked path (exit 1)
#   disarm=<n>                  auto-merge could not be disabled on it; nothing pushed (exit 1)
#   dequeue=<n>                 it could not be removed from the merge queue; nothing pushed (exit 1)
#   disarmed=<n>                auto-merge was disabled on it ahead of the push
#   dequeued=<n>                it left the merge queue ahead of the push
#   recorded=<sha> paths=<n>    the commit on the rolling branch; its paths follow
#   pushed=<remote>/<branch>    the branch reached the remote
#   pull-request=<n> action=<opened|updated>
#   armed=<n|already>           auto-merge enabled on it for its head, or found enabled on a stand-down
set -euo pipefail

say() { # KEY VALUE [LINE...] — the keyed line, then each explanation line
  printf 'lock-record: %s=%s\n' "$1" "$2"
  shift 2
  for line in "$@"; do printf '%s\n' "$line"; done
}
count_lines() { # TEXT — how many lines it holds, none for the empty string
  if [[ -z "$1" ]]; then printf '0\n'; else printf '%s\n' "$1" | wc -l | tr -d ' '; fi
}

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../.agents/skills/github/scripts/lib/merge-queue.sh
source "$here/../.agents/skills/github/scripts/lib/merge-queue.sh"

repo="$(cd -- "$here/.." && pwd)"
base=main
remote=origin
branch=kendex/lock
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo | --base | --remote | --branch)
      if [[ $# -lt 2 ]]; then
        say option "$1" "$1 needs a value" >&2
        exit 2
      fi
      case "$1" in
        --repo) repo="$2" ;;
        --base) base="$2" ;;
        --remote) remote="$2" ;;
        --branch) branch="$2" ;;
      esac
      shift 2 ;;
    -h | --help) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) say option "$1" "usage: tools/lock-record [--repo DIR] [--base BRANCH] [--remote NAME] [--branch NAME]" >&2; exit 2 ;;
  esac
done

if ! top="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)"; then
  say repo "$repo" "not a git checkout, so there is no head to judge the record against" >&2
  exit 2
fi
repo="$top"

# The record is judged against a commit: an uncommitted path would be judged
# and could be committed as the record's, under a head that does not hold it.
# A clean start is also what lets the rolling judge restore the tree with
# one reset: everything the tree then carries beyond HEAD, the judge wrote.
if ! dirty="$(git -C "$repo" status --porcelain --untracked-files=all)"; then
  say status "$repo" "git status could not read the checkout, so nothing was judged" >&2
  exit 2
fi
if [[ -n "$dirty" ]]; then
  say dirty "$(count_lines "$dirty")" \
    "the checkout at $repo has uncommitted paths, so the tree is not the commit the record would be judged against:" \
    "$dirty" >&2
  exit 2
fi
head="$(git -C "$repo" rev-parse HEAD)"

# The mirrors the record's source commits are held to. `source refresh` and
# `verify` read the project from the working directory; `refresh` names it.
rc=0
(cd -- "$repo" && kendex source refresh) || rc=$?
if [[ $rc -ne 0 ]]; then
  say source-refresh "$rc" "kendex source refresh failed in $repo; its output is above, and the record was not judged" >&2
  exit 1
fi

rc=0
(cd -- "$repo" && kendex verify --scope project) || rc=$?
if [[ $rc -eq 0 ]]; then
  say current "$head" "the committed record is what this tree writes; nothing to record"
  exit 0
fi

# The rolling branch as the remote holds it, when it holds one: exit 2 from
# ls-remote is the one answer that means absent, and any other failure is
# no answer, since a push over a branch nothing could read may eject a
# queued pull request for nothing.
rc=0
git -C "$repo" ls-remote --exit-code --quiet "$remote" "refs/heads/$branch" >/dev/null || rc=$?
case "$rc" in
  0) git -C "$repo" fetch --quiet "$remote" "refs/heads/$branch"; rolling="$(git -C "$repo" rev-parse FETCH_HEAD)" ;;
  2) rolling="" ;;
  *) say rolling-read "$rc" "git ls-remote could not say whether $remote holds $branch; nothing was pushed" >&2; exit 1 ;;
esac

# One pull request per branch, read before anything is judged against it:
# its arming and queue state decide what a stand-down must restore and what
# a push must undo first.
if ! listed="$(cd -- "$repo" && gh pr list --head "$branch" --base "$base" --state open --json number,id --jq '.[0] | select(. != null) | "\(.number) \(.id)"')"; then
  say pull-request-list "$branch" "gh could not list the branch's open pull requests; nothing was pushed" >&2
  exit 1
fi
number="${listed%% *}"
node_id="${listed#* }"
armed=false
queued=false
if [[ -n "$number" ]]; then
  if ! state="$(cd -- "$repo" && gh api graphql -F id="$node_id" -f query='query($id: ID!) { node(id: $id) { ... on PullRequest { isInMergeQueue autoMergeRequest { enabledAt } } } }' --jq '[.data.node.autoMergeRequest != null, .data.node.isInMergeQueue == true] | @tsv')"; then
    say pull-request-state "$number" "gh could not read whether pull request $number is armed or queued; nothing was pushed" >&2
    exit 1
  fi
  armed="${state%%$'\t'*}"
  queued="${state##*$'\t'}"
fi

if [[ -n "$rolling" && -n "$number" ]]; then
  # The open pull request judged by the one judge: its commit applied onto
  # the head, then verified. The reset returns the clean start either way;
  # a commit that conflicts is a stale record the queue could not land
  # either, and one git cannot apply at all (a merge commit on the rolling
  # branch, a lock left in the checkout) is reported, since neither the
  # push nor the stand-down can say what it records.
  rc=0
  git -C "$repo" cherry-pick --no-commit "$rolling" || rc=$?
  case "$rc" in
    0 | 1) ;;
    *)
      say status "$repo" "git could not apply the rolling commit $rolling onto $head, so nothing was pushed; what git printed is above" \
        "every run will refuse here until pull request $number is closed or $branch is replaced with one commit on $base's head; the next run then re-records" >&2
      git -C "$repo" reset -q --hard HEAD
      exit 1 ;;
  esac
  if [[ $rc -eq 0 ]] && (cd -- "$repo" && kendex verify --scope project); then
    git -C "$repo" reset -q --hard HEAD
    say rolling-current "$rolling pull-request=$number" \
      "pull request $number's commit, merged onto $head, is the record this tree writes; the queue merges it, so nothing was pushed"
    if [[ "$armed" == true ]]; then
      say armed already
    else
      (cd -- "$repo" && gh pr merge "$number" --squash --auto --match-head-commit "$rolling")
      say armed "$number"
    fi
    exit 0
  fi
  git -C "$repo" reset -q --hard HEAD
fi

rc=0
kendex refresh --scope project --yes --leave --project-path "$repo" || rc=$?
if [[ $rc -ne 0 ]]; then
  say refresh "$rc" "kendex refresh could not re-record the tree at $head; its output is above" >&2
  exit 1
fi

# What the refresh wrote, staged so the commit carries the new paths too.
if ! git -C "$repo" add -A || ! changed="$(git -C "$repo" diff --cached --name-only --no-renames HEAD)"; then
  say status "$repo" "git could not read what the refresh wrote, so nothing was committed" >&2
  exit 1
fi
rc=0
(cd -- "$repo" && kendex verify --scope project) || rc=$?
if [[ $rc -ne 0 ]]; then
  say stale-after-refresh "$head" \
    "kendex verify still fails after kendex refresh re-recorded the tree, so the refresh does not settle what verify reports; the paths it wrote:" \
    "$changed" >&2
  exit 1
fi
if [[ -z "$changed" ]]; then
  say refresh-wrote-nothing "$head" \
    "kendex verify failed before the refresh and passes after it, yet the refresh changed no tracked path; what verify read moved outside the tree" >&2
  exit 1
fi
count="$(count_lines "$changed")"
short="$(git -C "$repo" rev-parse --short "$head")"

# An armed pull request re-enters the queue the moment its checks pass,
# and a push onto a queued one ejects it: disarm first, then dequeue, then
# push, then arm the pushed head.
if [[ "$armed" == true ]]; then
  if ! reason="$(cd -- "$repo" && kendex_merge_queue_mutation disablePullRequestAutoMerge "$node_id")"; then
    say disarm "$number" "auto-merge could not be disabled on pull request $number, so a push would let it re-enter the queue: $reason" >&2
    exit 1
  fi
  say disarmed "$number"
fi
if [[ "$queued" == true ]]; then
  if ! reason="$(cd -- "$repo" && kendex_merge_queue_mutation dequeuePullRequest "$node_id")"; then
    say dequeue "$number" "pull request $number could not leave the merge queue, so a push would eject it: $reason" >&2
    exit 1
  fi
  say dequeued "$number"
fi

git -C "$repo" checkout -q -B "$branch"
git -C "$repo" commit -q \
  -m "chore(lock): record the install record at $short" \
  -m "kendex refresh, built from $head, wrote these paths on main after the merges up to that head. The record is recorded here and never on a branch: skills/AGENTS.md states the rule, docs/decisions/D007-lock-record-on-main.md the reason."
say recorded "$head paths=$count" "$changed"

git -C "$repo" push --quiet --force "$remote" "refs/heads/$branch:refs/heads/$branch"
say pushed "$remote/$branch"

if [[ -n "$number" ]]; then
  action=updated
else
  url="$(cd -- "$repo" && gh pr create --base "$base" --head "$branch" \
    --title "chore(lock): record the install record at $short" \
    --body "tools/lock-record re-recorded .kendex-lock.json on main after the merges up to $head, with a kendex built from that tree. Paths: $count. The record is recorded here and never on a branch: skills/AGENTS.md.")"
  number="${url##*/}"
  action=opened
fi
say pull-request "$number action=$action"

(cd -- "$repo" && gh pr merge "$number" --squash --auto --match-head-commit "$(git -C "$repo" rev-parse HEAD)")
say armed "$number"
