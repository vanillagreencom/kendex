#!/usr/bin/env bash
# Record this repository's install record on the default branch after a
# merge, and land it: with one push where GitHub's rulesets let the landing
# app's token through, else through one rolling pull request.
#
# Usage: tools/lock-record [--repo DIR] [--base BRANCH] [--remote NAME] [--branch NAME]
#
# --repo DIR       the checkout of the default branch to judge (default: the
#                  checkout this script sits in)
# --base BRANCH    the branch the rolling pull request targets (default: the
#                  repository's default branch, WORKTREE_DEFAULT_BRANCH when
#                  the environment sets it, else GitHub's; no
#                  kendex.settings.toml is read)
# --remote NAME    the remote the rolling branch is pushed to (default origin)
# --branch NAME    the rolling branch (default kendex/lock)
# -h, --help       print this help
#
# The kendex on PATH is the judge; .github/workflows/lock-record.yml builds
# it from the checkout, since the kendex code that hashes, renders and
# records is part of what moves the record. The run refreshes the source
# mirrors, then asks `kendex verify` whether the committed record is what
# this tree would write. A current record ends the run. Otherwise the open
# rolling pull request, where one exists, is judged the same way: its
# commit is cherry-picked onto the head with no commit, which applies the
# change it made to the head it was recorded from, as the queue's merge
# would, and `kendex verify` asked again; a pass means that pull
# request records this tree, so nothing is pushed and it is armed where it
# was not, and a conflict or a failed verify means it is stale. A
# cherry-pick, unlike a merge, needs no history behind the head: the
# workflow's checkout holds the head alone, and the fetch of the rolling
# branch brings that commit and its parent. A stale record is then
# re-recorded with `kendex refresh`, verified again, committed on the
# rolling branch from the checkout's head, force-pushed, and put up as one
# pull request the merge queue takes; a pull request already open on the
# branch is disarmed and dequeued before the push, as
# skills/orch/workflows/merge-pr-restack.md step 1 does, armed again after
# it, and its title and body then rewritten to the head just recorded. The
# arm passes the merge method the base branch allows, read from GitHub like
# the default branch. GitHub shows a force push on the pull request's head a
# moment after the push lands, and refuses an arm whose --match-head-commit
# names a head it does not show yet: every arm, on the stand-down and after
# the push, first reads the pull request's head until it is the revision
# armed, and a head GitHub never shows within those reads leaves the pull
# request unarmed, which the next run arms; the run also prints a warning
# annotation, so under GitHub Actions the unarmed pull request shows on a
# green run.
#
# The record goes to the base with no pull request where KENDEX_LAND_TOKEN
# holds the landing app's token and the base's merge queue holds no entry,
# since a push to a branch whose queue holds an entry makes GitHub rebuild
# every running group. The record is a function of the merged tree, which
# that tree's merge group already proved, so a second group proves nothing
# more. The run commits the record on the head it judged, with [skip ci] in
# its title, and pushes that one commit to the base with the landing token;
# the base's rulesets judge that push, and the run asks nothing about them
# first. Where GitHub takes it, no workflow starts on it and an open rolling
# pull request is closed. No landing token, a merge queue that holds an
# entry or could not be read, and a push GitHub refuses keep the rolling
# pull request.
# A base that moved past the judged head ends the run with nothing landed:
# the push that moved it starts a run of its own. Apart from a landing push
# GitHub takes, nothing here pushes to the default branch: the organization
# ruleset takes every change to it through the merge queue
# (docs/decisions/D003-one-merge-path.md), and the record takes the same
# route (docs/decisions/D007-lock-record-on-main.md). The rule a branch
# follows is skills/AGENTS.md.
#
# `gh` reads its token from GH_TOKEN, git pushes through the credential
# helper `gh auth setup-git` installed for that token, which reads GH_TOKEN
# when git asks, and the landing push sets GH_TOKEN to KENDEX_LAND_TOKEN for
# its own command alone. The commit
# identity is GIT_AUTHOR_* and GIT_COMMITTER_*. The disarm and dequeue
# mutations are the github skill's, .agents/skills/github/scripts/lib/merge-queue.sh,
# and so are the default-branch and merge-method reads, lib/repo-settings.sh.
# The suite is crates/cli/tests/lock_record.rs.
#
# Every notice this script writes opens `lock-record: <key>=<value>`; the
# lines after a keyed line explain it, and what kendex, git and gh print
# passes through as is:
#   option=<arg>                unknown option, or one with no value (exit 2)
#   repo=<dir>                  not a git checkout (exit 2)
#   status=<dir>                git could not read the checkout (exit 2), what the refresh wrote, or apply the rolling commit onto the head, which every run repeats until that pull request is closed or its branch replaced (exit 1)
#   dirty=<n>                   the checkout has n uncommitted paths; nothing was judged (exit 2)
#   source-refresh=<status>     `kendex source refresh` failed (exit 1)
#   current=<sha>               the record matches the tree at that head; nothing was written
#   default-branch=<dir>        the checkout resolves to no GitHub repository, or GitHub did not name that repository's default branch and what it said is above (exit 1)
#   merge-method=<set>          the base allows none of squash, merge and rebase, the set it allows named; nothing pushed (exit 1)
#   merge-method-unreadable=<cause>
#                               the base's merge method could not be read: rules, settings or queue; nothing pushed (exit 1)
#   rolling-read=<status>       the remote could not say whether the rolling branch exists (exit 1)
#   pull-request-list=<branch>  gh could not list the branch's pull requests; nothing pushed (exit 1)
#   pull-request-state=<n>      the open pull request's arming and queue state could not be read; nothing pushed (exit 1)
#   rolling-current=<sha> pull-request=<n>
#                               that pull request's commit, merged onto the head, verifies clean; nothing pushed
#   refresh=<status>            `kendex refresh` failed (exit 1)
#   stale-after-refresh=<sha>   verify still fails after the refresh; the paths it wrote follow (exit 1)
#   refresh-wrote-nothing=<sha> verify failed, and the refresh changed no tracked path (exit 1)
#   disarm=<n>                  auto-merge could not be disabled on it; nothing pushed (exit 1)
#   dequeue=<n>                 it could not be removed from the merge queue; nothing pushed (exit 1)
#   disarmed=<n>                auto-merge was disabled on it ahead of the push
#   dequeued=<n>                it left the merge queue ahead of the push
#   landed=<sha> paths=<n>      the record's commit, pushed to the base with no pull request; its paths follow
#   land-deferred=<sha>         the base moved past that judged head before the push; nothing landed, and the run the newer push started records it
#   land-refused=<status>       GitHub refused the push to the base; the rolling pull request carries the record instead
#   pull-request-closed=<n>     the open rolling pull request the landed record superseded
#   recorded=<sha> paths=<n>    the commit on the rolling branch; its paths follow
#   pushed=<remote>/<branch>    the branch reached the remote
#   pull-request=<n> action=<opened|updated>
#   pull-request-edit=<n> arm=<armed|unarmed>
#                               gh could not rewrite the updated pull request's title and body to the head just recorded; the arm ran first, and arm= says whether it armed or left the pull request unarmed as the unarmed line reports (exit 1)
#   armed=<n|already>           auto-merge enabled on it for its head, or found enabled on a stand-down
#   head-read=<n>               gh could not read the pull request's head after the push or on the stand-down, so it was not armed (exit 1)
#   unarmed=<n> pushed=<sha> head=<sha>
#                               GitHub still showed the other head on the pull request after every read, so it was not armed; the record landed, and the next run arms it;
#                               a `::warning title=lock-record unarmed::` workflow command on stdout names both revisions too
set -euo pipefail

say() { # KEY VALUE [LINE...] — the keyed line, then each explanation line
  printf 'lock-record: %s=%s\n' "$1" "$2"
  shift 2
  for line in "$@"; do printf '%s\n' "$line"; done
}
# Arm pull request NUMBER on REVISION once GitHub shows REVISION as its
# head: an arm matched against a head GitHub has not caught up to is
# refused. The reads stop at five, two seconds apart, so the wait is bounded
# at eight seconds; a failed arm on the matched head ends the run with what
# gh printed. `armed_on` is REVISION once the arm is made, and stays empty
# when the pull request is left unarmed.
armed_on=""
arm() { # NUMBER REVISION
  local number="$1" revision="$2" seen="" reads=1
  while :; do
    if ! seen="$(cd -- "$repo" && gh pr view "$number" --json headRefOid --jq .headRefOid)"; then
      say head-read "$number" "gh could not read pull request $number's head, so it was not armed; the record is on the branch" >&2
      exit 1
    fi
    if [[ "$seen" == "$revision" || $reads -ge 5 ]]; then
      break
    fi
    reads=$((reads + 1))
    sleep 2
  done
  if [[ "$seen" != "$revision" ]]; then
    say unarmed "$number pushed=$revision head=$seen" \
      "GitHub still showed $seen as pull request $number's head after $reads reads, not the pushed $revision, so it was not armed; the record is on the branch, and the next run arms it" >&2
    # The run stays green, and nobody opens a green run's log: the
    # annotation puts the unarmed pull request on the run summary and on
    # the commit's checks.
    printf '::warning title=lock-record unarmed::pull request %s left unarmed: GitHub showed %s, pushed %s\n' "$number" "$seen" "$revision"
    return 0
  fi
  (cd -- "$repo" && gh pr merge "$number" "--$method" --auto --match-head-commit "$revision")
  armed_on="$revision"
  say armed "$number"
}
count_lines() { # TEXT — how many lines it holds, none for the empty string
  if [[ -z "$1" ]]; then printf '0\n'; else printf '%s\n' "$1" | wc -l | tr -d ' '; fi
}

here="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=../.agents/skills/github/scripts/lib/merge-queue.sh
source "$here/../.agents/skills/github/scripts/lib/merge-queue.sh"
# shellcheck source=../.agents/skills/github/scripts/lib/gh-repo.sh
source "$here/../.agents/skills/github/scripts/lib/gh-repo.sh"
# shellcheck source=../.agents/skills/github/scripts/lib/repo-settings.sh
source "$here/../.agents/skills/github/scripts/lib/repo-settings.sh"

repo="$(cd -- "$here/.." && pwd)"
base=""
remote=origin
branch=kendex/lock
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repo | --base | --remote | --branch)
      if [[ $# -lt 2 ]]; then
        say option "$1" "$1 needs a value" >&2
        exit 2
      fi
      case "$1" in
        --repo) repo="$2" ;;
        --base) base="$2" ;;
        --remote) remote="$2" ;;
        --branch) branch="$2" ;;
      esac
      shift 2 ;;
    -h | --help) sed -n '2,/^set -/p' "$0" | sed '$d; s/^# \{0,1\}//'; exit 0 ;;
    *) say option "$1" "usage: tools/lock-record [--repo DIR] [--base BRANCH] [--remote NAME] [--branch NAME]" >&2; exit 2 ;;
  esac
done

if ! top="$(git -C "$repo" rev-parse --show-toplevel 2>/dev/null)"; then
  say repo "$repo" "not a git checkout, so there is no head to judge the record against" >&2
  exit 2
fi
repo="$top"

# The record is judged against a commit: an uncommitted path would be judged
# and could be committed as the record's, under a head that does not hold it.
# A clean start is also what lets the rolling judge restore the tree with
# one reset: everything the tree then carries beyond HEAD, the judge wrote.
if ! dirty="$(git -C "$repo" status --porcelain --untracked-files=all)"; then
  say status "$repo" "git status could not read the checkout, so nothing was judged" >&2
  exit 2
fi
if [[ -n "$dirty" ]]; then
  say dirty "$(count_lines "$dirty")" \
    "the checkout at $repo has uncommitted paths, so the tree is not the commit the record would be judged against:" \
    "$dirty" >&2
  exit 2
fi
head="$(git -C "$repo" rev-parse HEAD)"

# The mirrors the record's source commits are held to. `source refresh` and
# `verify` read the project from the working directory; `refresh` names it.
rc=0
(cd -- "$repo" && kendex source refresh) || rc=$?
if [[ $rc -ne 0 ]]; then
  say source-refresh "$rc" "kendex source refresh failed in $repo; its output is above, and the record was not judged" >&2
  exit 1
fi

rc=0
(cd -- "$repo" && kendex verify --scope project) || rc=$?
if [[ $rc -eq 0 ]]; then
  say current "$head" "the committed record is what this tree writes; nothing to record"
  exit 0
fi

# Where the rolling pull request goes and how the queue merges it, both read
# from GitHub before anything is pushed. The readers answer from the
# checkout, as every gh call here does.
if [[ -z "$base" ]]; then
  rc=0
  base="$(cd -- "$repo" && kendex_github_default_branch "$repo")" || rc=$?
  case "$rc" in
    0) ;;
    3) say default-branch "$repo" "$repo resolves to no GitHub repository to read a default branch from; pass --base, and nothing was pushed" >&2; exit 1 ;;
    *) say default-branch "$repo" "GitHub did not name the default branch of the repository $repo resolves to, for the reason above; pass --base, and nothing was pushed" >&2; exit 1 ;;
  esac
fi
rc=0
method="$(cd -- "$repo" && kendex_github_merge_method '{owner}/{repo}' "$base" squash merge rebase)" || rc=$?
case "$rc" in
  0) ;;
  2) say merge-method "$method" "$base allows none of squash, merge and rebase, so the rolling pull request could not be armed; nothing was pushed" >&2; exit 1 ;;
  *) say merge-method-unreadable "$method" "$base's merge method could not be read from GitHub; nothing was pushed" >&2; exit 1 ;;
esac

# The rolling branch as the remote holds it, when it holds one: exit 2 from
# ls-remote is the one answer that means absent, and any other failure is
# no answer, since a push over a branch nothing could read may eject a
# queued pull request for nothing.
rc=0
git -C "$repo" ls-remote --exit-code --quiet "$remote" "refs/heads/$branch" >/dev/null || rc=$?
case "$rc" in
  0) git -C "$repo" fetch --quiet "$remote" "refs/heads/$branch"; rolling="$(git -C "$repo" rev-parse FETCH_HEAD)" ;;
  2) rolling="" ;;
  *) say rolling-read "$rc" "git ls-remote could not say whether $remote holds $branch; nothing was pushed" >&2; exit 1 ;;
esac

# One pull request per branch, read before anything is judged against it:
# its arming and queue state decide what a stand-down must restore and what
# a push must undo first.
if ! listed="$(cd -- "$repo" && gh pr list --head "$branch" --base "$base" --state open --json number,id --jq '.[0] | select(. != null) | "\(.number) \(.id)"')"; then
  say pull-request-list "$branch" "gh could not list the branch's open pull requests; nothing was pushed" >&2
  exit 1
fi
number="${listed%% *}"
node_id="${listed#* }"
armed=false
queued=false
if [[ -n "$number" ]]; then
  if ! state="$(cd -- "$repo" && gh api graphql -F id="$node_id" -f query='query($id: ID!) { node(id: $id) { ... on PullRequest { isInMergeQueue autoMergeRequest { enabledAt } } } }' --jq '[.data.node.autoMergeRequest != null, .data.node.isInMergeQueue == true] | @tsv')"; then
    say pull-request-state "$number" "gh could not read whether pull request $number is armed or queued; nothing was pushed" >&2
    exit 1
  fi
  armed="${state%%$'\t'*}"
  queued="${state##*$'\t'}"
fi

if [[ -n "$rolling" && -n "$number" ]]; then
  # The open pull request judged by the one judge: its commit applied onto
  # the head, then verified. The reset returns the clean start either way;
  # a commit that conflicts is a stale record the queue could not land
  # either, and one git cannot apply at all (a merge commit on the rolling
  # branch, a lock left in the checkout) is reported, since neither the
  # push nor the stand-down can say what it records.
  rc=0
  git -C "$repo" cherry-pick --no-commit "$rolling" || rc=$?
  case "$rc" in
    0 | 1) ;;
    *)
      say status "$repo" "git could not apply the rolling commit $rolling onto $head, so nothing was pushed; what git printed is above" \
        "every run will refuse here until pull request $number is closed or $branch is replaced with one commit on $base's head; the next run then re-records" >&2
      git -C "$repo" reset -q --hard HEAD
      exit 1 ;;
  esac
  if [[ $rc -eq 0 ]] && (cd -- "$repo" && kendex verify --scope project); then
    git -C "$repo" reset -q --hard HEAD
    say rolling-current "$rolling pull-request=$number" \
      "pull request $number's commit, merged onto $head, is the record this tree writes; the queue merges it, so nothing was pushed"
    if [[ "$armed" == true ]]; then
      say armed already
    else
      arm "$number" "$rolling"
    fi
    exit 0
  fi
  git -C "$repo" reset -q --hard HEAD
fi

rc=0
kendex refresh --scope project --yes --leave --project-path "$repo" || rc=$?
if [[ $rc -ne 0 ]]; then
  say refresh "$rc" "kendex refresh could not re-record the tree at $head; its output is above" >&2
  exit 1
fi

# What the refresh wrote, staged so the commit carries the new paths too.
if ! git -C "$repo" add -A || ! changed="$(git -C "$repo" diff --cached --name-only --no-renames HEAD)"; then
  say status "$repo" "git could not read what the refresh wrote, so nothing was committed" >&2
  exit 1
fi
rc=0
(cd -- "$repo" && kendex verify --scope project) || rc=$?
if [[ $rc -ne 0 ]]; then
  say stale-after-refresh "$head" \
    "kendex verify still fails after kendex refresh re-recorded the tree, so the refresh does not settle what verify reports; the paths it wrote:" \
    "$changed" >&2
  exit 1
fi
if [[ -z "$changed" ]]; then
  say refresh-wrote-nothing "$head" \
    "kendex verify failed before the refresh and passes after it, yet the refresh changed no tracked path; what verify read moved outside the tree" >&2
  exit 1
fi
count="$(count_lines "$changed")"
short="$(git -C "$repo" rev-parse --short "$head")"
title="chore(lock): record the install record at $short"
body="tools/lock-record re-recorded .kendex-lock.json on $base after the merges up to $head, with a kendex built from that tree. Paths: $count. The record is recorded here and never on a branch: skills/AGENTS.md."

# An armed pull request re-enters the queue the moment its checks pass,
# and a push onto a queued one ejects it: disarm first, then dequeue, then
# push, then arm the pushed head.
if [[ "$armed" == true ]]; then
  if ! reason="$(cd -- "$repo" && kendex_merge_queue_mutation disablePullRequestAutoMerge "$node_id")"; then
    say disarm "$number" "auto-merge could not be disabled on pull request $number, so a push would let it re-enter the queue: $reason" >&2
    exit 1
  fi
  say disarmed "$number"
fi
if [[ "$queued" == true ]]; then
  if ! reason="$(cd -- "$repo" && kendex_merge_queue_mutation dequeuePullRequest "$node_id")"; then
    say dequeue "$number" "pull request $number could not leave the merge queue, so a push would eject it: $reason" >&2
    exit 1
  fi
  say dequeued "$number"
fi

# Whether the run tries the base itself: a landing token, and a merge queue
# on the base that holds no entry, read with GH_TOKEN after the dequeue
# above took this run's own pull request out. The base's rulesets then
# decide the push.
may_land() {
  local queued
  [[ -n "${KENDEX_LAND_TOKEN:-}" ]] || return 1
  queued="$(cd -- "$repo" && gh api graphql -F owner='{owner}' -F repo='{repo}' -f branch="$base" \
    -f query='query($owner: String!, $repo: String!, $branch: String!) { repository(owner: $owner, name: $repo) { mergeQueue(branch: $branch) { entries { totalCount } } } }' \
    --jq 'if (.errors // [] | length) != 0 then error("GraphQL errors") else .data.repository | if .mergeQueue == null then 0 else .mergeQueue.entries.totalCount end end')" || return 1
  [[ "$queued" == 0 ]]
}
if may_land; then
  # The commit is made from the index and never checked out, so a refused
  # push leaves the tree as the rolling route below expects it.
  land_err="$(mktemp)"
  trap 'rm -f -- "$land_err"' EXIT
  tree="$(git -C "$repo" write-tree)"
  landed="$(git -C "$repo" commit-tree "$tree" -p "$head" \
    -m "$title [skip ci]" \
    -m "kendex refresh, built from $head, wrote these paths on $base after the merges up to that head. The rulesets on $base let the landing app push it, so the run pushed the record to $base itself, and [skip ci] starts no workflow on it.")"
  rc=0
  GH_TOKEN="$KENDEX_LAND_TOKEN" git -C "$repo" push --quiet "$remote" "$landed:refs/heads/$base" 2>"$land_err" || rc=$?
  cat -- "$land_err" >&2
  if [[ $rc -eq 0 ]]; then
    say landed "$landed paths=$count" "$changed"
    # The pull request was disarmed and dequeued above, and a merge of it
    # would have moved the base past the head this push extends, so GitHub
    # holds it open and unmerged here.
    if [[ -n "$number" ]]; then
      (cd -- "$repo" && gh pr close "$number")
      say pull-request-closed "$number"
    fi
    git -C "$repo" reset -q --hard HEAD
    exit 0
  fi
  # git prints "[rejected]" for a base that moved; GitHub's own refusal
  # prints "[remote rejected]".
  if grep -qF ' ! [rejected]' "$land_err"; then
    say land-deferred "$head" "$base moved past $head before the record could land; the run the newer push started records it"
    git -C "$repo" reset -q --hard HEAD
    exit 0
  fi
  say land-refused "$rc" "GitHub refused the push of the record to $base, as printed above; the rolling pull request carries it instead" >&2
fi

git -C "$repo" checkout -q -B "$branch"
git -C "$repo" commit -q \
  -m "$title" \
  -m "kendex refresh, built from $head, wrote these paths on $base after the merges up to that head. The record is recorded here and never on a branch: skills/AGENTS.md states the rule, docs/decisions/D007-lock-record-on-main.md the reason."
recorded="$(git -C "$repo" rev-parse HEAD)"
say recorded "$head paths=$count" "$changed"

git -C "$repo" push --quiet --force "$remote" "refs/heads/$branch:refs/heads/$branch"
say pushed "$remote/$branch"

if [[ -n "$number" ]]; then
  action=updated
else
  url="$(cd -- "$repo" && gh pr create --base "$base" --head "$branch" --title "$title" --body "$body")"
  number="${url##*/}"
  action=opened
fi
say pull-request "$number action=$action"

arm "$number" "$recorded"

# The title and body follow the arm, so a failed edit leaves the arm's
# outcome as it was with only the description stale.
if [[ "$action" == updated ]] && ! (cd -- "$repo" && gh pr edit "$number" --title "$title" --body "$body"); then
  if [[ -n "$armed_on" ]]; then
    arm_state=armed
    arm_note="it is armed on the record"
  else
    arm_state=unarmed
    arm_note="it was left unarmed, as the unarmed line above reports, and the next run arms it"
  fi
  say pull-request-edit "$number arm=$arm_state" \
    "gh could not rewrite pull request $number's title and body to $head; $arm_note; the next re-record rewrites them" >&2
  exit 1
fi
