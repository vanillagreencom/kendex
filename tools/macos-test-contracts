#!/usr/bin/env python3
"""Native eligibility for the existing Skill Tests runner and shard selector.

--filter reads suite paths on stdin and prints the retained paths in order.
--linux-only-shards prints the shard exclusions consumed by ci-job-set.
The declarations carry no measured durations. KEN-4013 holds the audit evidence.
"""
import argparse
import json
from pathlib import Path
import sys


def refuse(key, value):
    print(f"macos-test-contracts: {key}={value}", file=sys.stderr)
    raise SystemExit(2)


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    mode = parser.add_mutually_exclusive_group(required=True)
    mode.add_argument("--filter", action="store_true")
    mode.add_argument("--linux-only-shards", action="store_true")
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    args = parser.parse_args()
    root = args.root.resolve()
    try:
        declared = json.loads(Path(__file__).with_suffix(".json").read_text())
    except (OSError, ValueError) as error:
        refuse("declaration-unreadable", type(error).__name__)
    contracts = declared["contracts"]
    # REVISIT(D026): reclassify a contract when its native evidence changes.
    classes = {"native", "mixed", "unresolved", "linux-duplicate", "linux-only"}
    for path, classification in contracts.items():
        if classification not in classes:
            refuse("classification-invalid", path)
    if args.linux_only_shards:
        print(" ".join(declared["linux_only_shards"]))
        return
    retained = []
    words = sys.stdin.read().splitlines()
    selected = {(root / word).resolve() for word in words}
    for word in words:
        path = Path(word)
        try:
            relative = str((root / path).resolve().relative_to(root))
        except ValueError:
            refuse("suite-outside-root", word)
        try:
            header = []
            for line in (root / path).read_text().splitlines():
                if line and not line.startswith("#") and not line.isspace():
                    break
                if line.startswith("# bash-runtime:"):
                    header.append(line)
        except (OSError, UnicodeError):
            refuse("suite-unreadable", relative)
        classification = contracts.get(relative, "unresolved")
        if header:
            if relative in contracts:
                refuse("runtime-conflict", relative)
            if header not in (["# bash-runtime: 4"], ["# bash-runtime: 3.2"]):
                refuse("runtime-invalid", relative)
            classification = "linux-only" if header == ["# bash-runtime: 4"] else "native"
        if classification in {"native", "mixed", "unresolved"}:
            replacement = declared["native_replacements"].get(relative)
            if replacement:
                if (contracts.get(replacement) != "native" or not (root / replacement).is_file()
                        or (root / replacement).resolve() not in selected):
                    refuse("replacement-unavailable", relative)
                continue
            retained.append(word)
    for word in retained:
        print(word)


if __name__ == "__main__":
    try:
        main()
    except (KeyError, TypeError, AttributeError) as error:
        refuse("declaration-invalid", type(error).__name__)
