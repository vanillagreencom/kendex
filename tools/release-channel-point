#!/usr/bin/env bash
# Points the pre-release channel at the tag being published: one fixed
# `prerelease` release whose latest.json and feed.json each new candidate
# overwrites, which is the URL `update_channel::feed_url_for` sends a
# candidate to. Uploads dist/latest.json and dist/feed.json, which name their
# downloads by the tag that built them. The release workflow's channel job is
# the only caller; CHANNEL, NEW_VERSION, GITHUB_REPOSITORY and a GH_TOKEN gh
# can use come from it. Exit 0 wrote the channel or left it alone on purpose,
# exit 1 wrote nothing.
#
# One verdict decides the write, and only `write` and `hold` are verdicts.
# Each read leaves either a channel state this run established or the reason
# it could not, and the `case` below is the only path to the upload, so a
# listing that failed, a manifest naming no version and a version nothing can
# order all reach the same stop with the channel as it was. Nothing decides
# the write from inside an `if` condition, where `set -e` does not reach: that
# is how a `jq` that could not compare read as "not ahead" and let a rollback
# through.
set -euo pipefail

state=unknown
why=""
current=""
saved=""
if ! tags=$(gh api "repos/${GITHUB_REPOSITORY}/releases" --paginate --jq '.[].tag_name'); then
  why="this repository's releases could not be listed"
elif ! grep -qxF "$CHANNEL" <<< "$tags"; then
  if gh release create "$CHANNEL" --repo "$GITHUB_REPOSITORY" --prerelease \
       --title "Pre-release channel" \
       --notes "The update manifests of the newest kendex pre-release. Nothing here is a download; each manifest names assets on the release it came from."; then
    state=fresh
  else
    why="the ${CHANNEL} channel does not exist and could not be created"
  fi
elif ! assets=$(gh api "repos/${GITHUB_REPOSITORY}/releases/tags/${CHANNEL}" --jq '.assets[].name'); then
  why="the ${CHANNEL} channel is published but its assets could not be read"
elif ! grep -qxF latest.json <<< "$assets"; then
  state=fresh  # Published carrying nothing: no write has landed here yet.
# Both manifests come down, not only the one the comparison reads: `gh release
# upload --clobber` deletes an asset before uploading its replacement, so
# these are the only copies of what the channel had if that upload then fails.
elif ! gh release download "$CHANNEL" --repo "$GITHUB_REPOSITORY" \
       --dir saved --pattern latest.json --pattern feed.json --clobber; then
  why="the ${CHANNEL} channel carries a manifest that could not be downloaded"
else
  saved=1
  current=$(jq -r '.version // empty' saved/latest.json) || current=""
  if [ -n "$current" ]; then
    state=carrying
  else
    why="the ${CHANNEL} channel's manifest names no version"
  fi
fi

# SemVer precedence is jq's own ordering once each version becomes the key
# SemVer compares by: the numeric core, then a release ranking above the
# pre-releases leading to it, then the pre-release identifiers, where an
# all-digit one ranks below an alphanumeric one and alphanumerics compare as
# text. That last rule is why `sort -V` cannot stand in: it reads rc10 as past
# rc2, where SemVer puts rc10 first. Build metadata is not part of the version
# and comes off first. A string that is not a version has no place in the
# ordering, so `key` refuses it and jq leaves no verdict behind.
verdict=$(jq -rn --arg state "$state" --arg current "$current" \
  --arg new "$NEW_VERSION" '
  def semver: "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)(?:-((?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9]\\d*|\\d*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$";
  def ident: if test("^[0-9]+$") then [0, tonumber] else [1, .] end;
  def key: (if test(semver) then . else error("not a version: \(.)") end
            | split("+")[0]) as $v
    | ($v | index("-")) as $i
    | [($v | split("-")[0] | split(".") | map(tonumber)),
       (if $i == null then 1 else 0 end),
       (if $i == null then [] else ($v[$i + 1:] | split(".") | map(ident)) end)];
  # Only a strictly newer current holds the channel, so re-running the tag it
  # already carries refreshes it. A tag re-run after a later one would
  # otherwise roll every candidate back to it, which on this channel looks
  # exactly like the update path being broken.
  ($new | key) as $want
  | if $state == "fresh" then "write"
    elif $state != "carrying" then "stop"
    elif ($current | key) > $want then "hold"
    else "write" end') || verdict=stop
case "$verdict" in
  write) ;;
  hold)
    echo "::notice::The ${CHANNEL} channel carries ${current}, ahead of ${NEW_VERSION}; leaving it as it is."
    exit 0 ;;
  *)
    [ -n "$why" ] || why="${NEW_VERSION} and the channel's ${current} could not be put in order"
    echo "::error::Nothing was written to the ${CHANNEL} channel: ${why}. Repair the channel, then re-run the tag."
    exit 1 ;;
esac

if ! gh release upload "$CHANNEL" dist/latest.json dist/feed.json \
     --repo "$GITHUB_REPOSITORY" --clobber; then
  # An upload that failed after the delete leaves the channel short a
  # manifest, and a candidate reading a channel with no latest.json sees no
  # update at all, so what came down goes back up. Not an atomic swap: the run
  # fails either way, and the second message is there because a channel nobody
  # repaired needs saying out loud.
  if [ -n "$saved" ] && ! gh release upload "$CHANNEL" saved/*.json \
       --repo "$GITHUB_REPOSITORY" --clobber; then
    echo "::error::Uploading to the ${CHANNEL} channel failed and the manifests it had could not be put back. Candidates see no updates until a tag re-run repairs the channel."
    exit 1
  fi
  echo "::error::Uploading to the ${CHANNEL} channel failed; what it carried is back in place. Re-run the tag."
  exit 1
fi
