#!/usr/bin/env bash
# Move one rolling release channel by replacing its single feed.json pointer.
# Every URL in the pointer names an immutable release, so a reader can see
# the old pointer, the new pointer, or no pointer during replacement. It can
# never combine files from two builds.
#
# The release workflow is the only caller. CHANNEL, NEW_VERSION,
# GITHUB_REPOSITORY and GH_TOKEN come from it. NEW_BUILD is empty for the
# candidate channel and is the GitHub run number for the main channel.
set -euo pipefail

message_text() {
  case "$1" in
    pointer)
      printf 'Nothing was written to %s: this run has no complete feed.json pointer.\n' "$CHANNEL" ;;
    pointer-version)
      printf 'Nothing was written to %s: feed.json names %s instead of %s.\n' "$CHANNEL" "$2" "$NEW_VERSION" ;;
    compare-binary)
      printf 'Nothing was written to %s: the release binary is unavailable at %s.\n' "$CHANNEL" "$2" ;;
    candidate-identity)
      printf 'Nothing was written to %s: the signed candidate identity could not be authenticated.\n' "$CHANNEL" ;;
    candidate-build)
      printf 'Nothing was written to %s: the signed candidate build is %s instead of %s.\n' "$CHANNEL" "$2" "$NEW_BUILD" ;;
    releases)
      printf 'Nothing was written to %s: the releases of %s could not be listed.\n' "$CHANNEL" "$2" ;;
    assets)
      printf 'Nothing was written to %s: its assets could not be read.\n' "$2" ;;
    channel-assets)
      printf 'Nothing was written to %s: a rolling channel can carry only feed.json, but it carries %s.\n' "$CHANNEL" "$2" ;;
    pointer-download)
      printf 'Nothing was written to %s: its feed.json pointer could not be downloaded.\n' "$2" ;;
    current-version)
      printf 'Nothing was written to %s: its feed.json names no version.\n' "$CHANNEL" ;;
    current-identity)
      printf 'Nothing was written to %s: its signed build identity could not be authenticated.\n' "$CHANNEL" ;;
    unordered)
      printf 'Nothing was written to %s: %s and %s could not be ordered.\n' "$CHANNEL" "$2" "$3" ;;
    create)
      printf 'Nothing was written to %s: the channel could not be created.\n' "$2" ;;
    upload | upload-created)
      printf 'The feed.json pointer for %s could not be replaced. Readers can keep the old build or retry while no pointer is present.\n' "$2" ;;
    hold)
      printf '%s stays at %s because candidate %s is not newer.\n' "$CHANNEL" "$2" "$3" ;;
    *)
      printf 'No explanation is defined for this key.\n' ;;
  esac
}

held=""
absent=""
fail() {
  printf 'release-channel-point: %s=%s\n' "$1" "$2"
  printf '::error::%s\n' "$(message_text "$1" "$2" "${3:-}")"
  [ -z "$held" ] || printf '%s\n' "$held"
  [ -z "${4:-}" ] || printf '%s\n' "$4"
  exit 1
}
hold() {
  printf 'release-channel-point: hold=%s\n' "$1"
  printf '::notice::%s\n' "$(message_text hold "$1" "$2")"
  [ -z "$held" ] || printf '%s\n' "$held"
  exit 0
}

pointer=dist/feed.json
compare=dist/kendex-x86_64-unknown-linux-gnu
target=x86_64-unknown-linux-gnu
[ -f "$pointer" ] || fail pointer "$pointer" "" ""
pointer_version=$(jq -r '.version // empty' "$pointer" 2>&1) ||
  fail pointer-version unreadable "" "$pointer_version"
[ "$pointer_version" = "$NEW_VERSION" ] ||
  fail pointer-version "${pointer_version:-absent}" "" ""
[ -f "$compare" ] || fail compare-binary "$compare" "" ""
chmod +x "$compare" || fail compare-binary "$compare" "" ""

if [ -n "${NEW_BUILD:-}" ]; then
  candidate_out=""
  if ! candidate_out=$("./$compare" release-main-build "$pointer" "$target" 2>&1); then
    fail candidate-identity "$NEW_VERSION" "" "$candidate_out"
  fi
  candidate_build=${candidate_out##*$'\n'}
  [ "$candidate_build" = "$NEW_BUILD" ] ||
    fail candidate-build "${candidate_build:-absent}" "" "$candidate_out"
elif ! compare_out=$("./$compare" version-compare "$NEW_VERSION" "$NEW_VERSION" 2>&1); then
  fail unordered "$NEW_VERSION" "$NEW_VERSION" "$compare_out"
fi

state=unknown
current=""
if ! tags=$(gh api "repos/${GITHUB_REPOSITORY}/releases" --paginate --jq '.[].tag_name' 2>&1); then
  fail releases "$GITHUB_REPOSITORY" "" "$tags"
elif ! grep -qxF "$CHANNEL" <<< "$tags"; then
  absent=1
  state=fresh
elif ! assets=$(gh api "repos/${GITHUB_REPOSITORY}/releases/tags/${CHANNEL}" --jq '.assets[].name' 2>&1); then
  fail assets "$CHANNEL" "" "$assets"
elif [ "$assets" != feed.json ]; then
  fail channel-assets "$(paste -sd' ' - <<< "${assets:-empty}")" "" ""
elif ! download_out=$(gh release download "$CHANNEL" --repo "$GITHUB_REPOSITORY" \
     --dir channel --pattern feed.json --clobber 2>&1); then
  fail pointer-download "$CHANNEL" "" "$download_out"
else
  [ -z "$download_out" ] || held="$download_out"
  current=$(jq -r '.version // empty' channel/feed.json 2>&1) ||
    fail current-version unreadable "" "$current"
  [ -n "$current" ] || fail current-version absent "" ""
  state=carrying
fi

if [ "$state" = carrying ]; then
  if [ -n "${NEW_BUILD:-}" ]; then
    current_out=""
    if ! current_out=$("./$compare" release-main-build channel/feed.json "$target" 2>&1); then
      fail current-identity "$current" "" "$current_out"
    fi
    current_build=${current_out##*$'\n'}
    case "$current_build" in "" | *[!0-9]*) fail current-identity "$current" "" "$current_out" ;; esac
    if [ "$NEW_BUILD" -le "$current_build" ]; then
      hold "$current_build" "$NEW_BUILD"
    fi
  else
    ordered=""
    if ! ordered=$("./$compare" version-compare "$current" "$NEW_VERSION" 2>&1); then
      fail unordered "$NEW_VERSION" "$current" "$ordered"
    fi
    [ "$ordered" = older ] || hold "$current" "$NEW_VERSION"
  fi
fi

create_out=""
if [ -n "$absent" ]; then
  title="Pre-release channel"
  notes="The newest kendex pre-release feed. Its downloads stay on the immutable release that built them."
  if [ -n "${NEW_BUILD:-}" ]; then
    title=main
    notes="The current kendex main build feed. Its downloads stay on the immutable release that built them."
  fi
  if ! create_out=$(gh release create "$CHANNEL" --repo "$GITHUB_REPOSITORY" --prerelease \
       --title "$title" --notes "$notes" 2>&1); then
    fail create "$CHANNEL" "" "$create_out"
  fi
fi

upload_out=""
if upload_out=$(gh release upload "$CHANNEL" "$pointer" \
     --repo "$GITHUB_REPOSITORY" --clobber 2>&1); then
  [ -z "$held" ] || printf '%s\n' "$held"
  [ -z "$create_out" ] || printf '%s\n' "$create_out"
  [ -z "$upload_out" ] || printf '%s\n' "$upload_out"
else
  cause="$upload_out"
  [ -z "$create_out" ] || cause="$create_out
$upload_out"
  if [ -n "$absent" ]; then
    fail upload-created "$CHANNEL" "" "$cause"
  fi
  fail upload "$CHANNEL" "" "$cause"
fi
