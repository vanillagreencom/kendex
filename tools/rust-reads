#!/usr/bin/env bash
# The repository paths the Rust source under crates/ names as ones it reads,
# derived from the source rather than listed by hand, and the paths cargo
# reads to build it. Each row says which shape it came from:
#
#   include   an include_str! or include_bytes! literal, resolved against the
#             including file's directory: a file compiled into the binary or
#             the test at build time. A literal on the line after its opening
#             parenthesis, the shape rustfmt gives a long one, counts too.
#   manifest  a chain of string literals joined onto env!("CARGO_MANIFEST_DIR"),
#             resolved against that crate's manifest directory, or onto a
#             checkout_root() call, crates/test_util.rs's helper, resolved
#             against the checkout: a path code or a test reads at run time.
#             The chain is the literal arguments of `.join("...")` calls after
#             it, or for the manifest directory the literal arguments beside
#             it in a `concat!`. A chain that ends with no further argument is
#             a read of the path it reached, and every path under it when
#             that is a directory.
#   module    with --modules, which tests can run a manifest read: the
#             read's path, its owning Cargo.toml, the cargo test argument for
#             one target and a module path in it (Cargo metadata supplies the
#             targets and their root files). The module holds the reading
#             file, or names a module already listed that has pub items, the
#             one way to reach those from outside; tests named under the
#             listed modules are the only ones in that target that can run the
#             read. `.` for the module is the whole target: the reader sits in
#             its root, or in that target code a trait impl or a macro lets run
#             from anywhere. `.` in both columns is the whole crate: the reader
#             is in no library or test target module, the walk from the roots
#             does not reach it, or it is library code with pub items or with
#             a trait impl or macro, which other crates can run. The walk takes
#             `mod x;` declarations that open a line, as rustfmt writes them,
#             and #[path] attributes.
#   build     what cargo reads to build every crate: the crates/ tree, the
#             workspace manifest and lock, the toolchain pin and the cargo,
#             clippy and rustfmt configuration, whether or not the checkout
#             holds each file today, so a diff deleting one still names it.
#   cli-build, cli-include   with --cli-smoke, compiled inputs of kendex-cli
#             and its cli_smoke target. Cargo metadata supplies local package
#             dependencies, target roots and all workspace manifests. The
#             source pass follows literal #[path] modules from those roots.
#             Other test targets and unrelated workspace source are excluded.
#             Source directories retain their inline test code and includes.
#             Local dependencies include all declared features and platforms.
#
# `.` is the row for what this reader does not follow: a chain that reaches
# the repository root, and a chain that goes on with an argument that is not
# a string literal, such as `.join(name)` or `.join(format!(...))`. That
# second chain also prints the directory it reached, since `.join(name)` most
# often names a file in it, but the argument can lead out of it too. Code that
# joins onto a returned path elsewhere is not followed, so a read through a
# variable holding checkout_root() is `.`, and a helper returning the manifest
# directory reads as that crate's directory. A file outside every crate, such
# as crates/test_util/lane.rs, has no owning crate and prints no manifest row.
# A path read by any other route is not here.
#
# A resolved path that climbs out of the checkout names no repository path and
# is not printed.
#
# Usage: tools/rust-reads [--cli-smoke | --modules] [ROOT]
#   ROOT   the checkout to read; the current directory when omitted
# stdout: one `<kind><TAB><path>` row per distinct read, sorted, the path
# relative to ROOT. A manifest row appends `<TAB><owning Cargo.toml>` so
# guard can run the reading crate without a separate path map.
# Exit 0 with the rows, 2 when the source could not be read
# or the arguments are wrong, and a read that did not run is never printed as
# an empty set: a crates/ tree holding no Cargo.toml is one that could not be
# read. A refusal is one stderr line:
#   rust-reads: unreadable=<path>   ROOT, or the crates/ tree, could not be
#                                   read or holds no crate
#   rust-reads: unreadable=cli-smoke   Cargo metadata failed, the CLI smoke
#                                   target is missing, or a literal path
#                                   module could not be read
#   rust-reads: unreadable=modules  Cargo metadata failed
#   rust-reads: usage=<usage>       more than one argument
set -euo pipefail

cli_scope=
modules=
case "${1:-}" in
  --cli-smoke) cli_scope=1; shift ;;
  --modules) modules=1; shift ;;
esac
case $# in
  0) root=. ;;
  1) root=$1 ;;
  *) echo "rust-reads: usage=tools/rust-reads [--cli-smoke | --modules] [ROOT]" >&2; exit 2 ;;
esac
cd -- "$root" 2>/dev/null || { printf 'rust-reads: unreadable=%s\n' "$root" >&2; exit 2; }
[ -d crates ] || { echo 'rust-reads: unreadable=crates' >&2; exit 2; }

# The manifest directories, for the awk pass to find each file's crate by.
if ! manifests=$(find crates -type f -name Cargo.toml) || [ -z "$manifests" ]; then
  echo 'rust-reads: unreadable=crates' >&2
  exit 2
fi

scope=
if [ -n "$cli_scope" ]; then
  # --no-deps reads workspace declarations without fetching registry crates.
  # Keep every member manifest: Cargo reads them to resolve a CLI build too.
  if ! metadata=$(cargo metadata --format-version 1 --no-deps --locked) ||
     ! scope=$(jq -er --arg root "$(pwd -P)/" '
      .packages as $packages
      | def closure($paths):
          ($paths + [$packages[] | select(.manifest_path as $p | $paths | index($p))
            | . as $package | .dependencies[]
            | select(.path != null and (.kind != "dev" or $package.name == "kendex-cli"))
            | .path + "/Cargo.toml"] | unique) as $next
          | if $next == $paths then $next else closure($next) end;
        [$packages[] | select(.name == "kendex-cli")] as $cli
      | if ($cli | length) != 1 or
           ([$cli[0].targets[] | select(.name == "cli_smoke" and (.kind | index("test")))] | length) != 1
        then error("missing CLI smoke target") else . end
      | closure([$cli[0].manifest_path]) as $paths
      | ([$packages[].manifest_path | ["file", .]] +
          [$packages[] | select(.manifest_path as $p | $paths | index($p))
           | . as $package | .targets[]
           | if (.kind | index("lib")) or
                ($package.name == "kendex-cli" and (.kind | index("bin")))
             then ["dir", (.src_path | sub("/[^/]+$"; ""))]
             elif (.kind | index("custom-build")) or
                  ($package.name == "kendex-cli" and .name == "cli_smoke" and (.kind | index("test")))
             then ["file", .src_path] else empty end])[]
      | select(.[1] | startswith($root)) | .[1] |= ltrimstr($root) | @tsv
    ' <<<"$metadata"); then
    echo 'rust-reads: unreadable=cli-smoke' >&2
    exit 2
  fi
fi

# The test-running targets cargo builds from each crate: `<Cargo.toml> <TAB>
# <selector> <TAB> <root file>`, the selector being the cargo test argument
# that runs that target alone.
targets=
if [ -n "$modules" ]; then
  if ! metadata=$(cargo metadata --format-version 1 --no-deps --locked) ||
     ! jq -e '.packages | arrays' <<<"$metadata" >/dev/null ||
     ! targets=$(jq -r --arg root "$(pwd -P)/" '
      .packages[] | .manifest_path as $manifest | .targets[]
      | (if (.kind | index("test")) then "--test=" + .name
         elif any(.kind[]; test("lib$") or . == "proc-macro") then "--lib"
         else empty end) as $selector
      | [$manifest, $selector, .src_path]
      | select(all(.[0], .[2]; startswith($root))) | map(ltrimstr($root)) | @tsv
      ' <<<"$metadata"); then
    echo 'rust-reads: unreadable=modules' >&2
    exit 2
  fi
fi

if ! rows=$(RUST_READS_MANIFESTS="$manifests" RUST_READS_SCOPE="$scope" RUST_READS_MODULES="$modules" RUST_READS_TARGETS="$targets" find crates -type f -name '*.rs' -exec awk '
  BEGIN {
    n = split(ENVIRON["RUST_READS_MANIFESTS"], found, "\n")
    for (i = 1; i <= n; i++) {
      if (found[i] == "") continue
      dir = found[i]
      sub(/\/?Cargo\.toml$/, "", dir)
      crate[dir] = 1
    }
  }
  # The repository path BASE/LIT names, or "" when it climbs out of the
  # checkout; "." is the checkout itself.
  function resolve(base, lit,   n, seg, i, k, out) {
    n = split(base "/" lit, seg, "/")
    k = 0
    for (i = 1; i <= n; i++) {
      if (seg[i] == "" || seg[i] == ".") continue
      if (seg[i] == "..") { if (k == 0) return ""; k--; continue }
      seg[++k] = seg[i]
    }
    if (k == 0) return "."
    out = seg[1]
    for (i = 2; i <= k; i++) out = out "/" seg[i]
    return out
  }
  function emit(kind, path, owner) {
    if (path == "") return
    if (!compiling) {
      if (kind == "manifest") printf "%s\t%s\t%s/Cargo.toml\n", kind, path, owner
      else printf "%s\t%s\n", kind, path
    }
    else if (kind == "include") printf "cli-include\t%s\n", path
  }
  function unquote(tok) {
    sub(/^[^"]*"/, "", tok)
    sub(/"$/, "", tok)
    return tok
  }
  # The manifest directory owning FILE: its nearest ancestor holding a
  # Cargo.toml. None is a crates/ file outside every crate, and "" says so.
  function manifest_dir(file,   dir) {
    dir = file
    while (sub(/\/[^\/]*$/, "", dir)) {
      if (dir in crate) return dir
    }
    return ""
  }
  function scan(file, text,   dir, rest, lit, chain, owner) {
    dir = file
    sub(/\/[^\/]*$/, "", dir)
    rest = text
    while (match(rest, /include_(str|bytes)![ \t\n]*\([ \t\n]*"[^"]*"/)) {
      emit("include", resolve(dir, unquote(substr(rest, RSTART, RLENGTH))))
      rest = substr(rest, RSTART + RLENGTH)
    }
    if (compiling) {
      rest = text
      while (match(rest, /#[ \t\n]*\[[ \t\n]*path[ \t\n]*=[ \t\n]*"[^"]*"/)) {
        visit(resolve(dir, unquote(substr(rest, RSTART, RLENGTH))))
        rest = substr(rest, RSTART + RLENGTH)
      }
    }
    owner = manifest_dir(file)
    if (owner == "") return
    rest = text
    while (match(rest, /env![ \t\n]*\([ \t\n]*"CARGO_MANIFEST_DIR"[ \t\n]*\)/)) {
      rest = substr(rest, RSTART + RLENGTH)
      # The closing parentheses of the Path::new or PathBuf::from around it.
      if (match(rest, /^[ \t\n]*\)+/)) rest = substr(rest, RLENGTH + 1)
      rest = follow(file, owner, owner, rest, 1)
    }
    rest = text
    while (match(rest, /checkout_root[ \t\n]*\([ \t\n]*\)/)) {
      lit = substr(rest, 1, RSTART - 1)
      rest = substr(rest, RSTART + RLENGTH)
      # A definition of the helper reads nothing.
      if (lit !~ /fn[ \t\n]+$/) rest = follow(file, owner, ".", rest, 0)
    }
  }
  # The literal chain REST opens with, joined onto BASE: `.join("...")` calls,
  # and with CONCAT the literals beside it in a concat!. Emits the read for
  # FILE in crate OWNER, and returns the text after the chain.
  function follow(file, owner, base, rest, concat,   lit, chain) {
    chain = ""
    while (1) {
      if (match(rest, /^[ \t\n]*\.join[ \t\n]*\([ \t\n]*"[^"]*"[ \t\n]*\)/)) {
        lit = substr(rest, RSTART, RLENGTH)
        sub(/[ \t\n]*\)$/, "", lit)
        chain = chain "/" unquote(lit)
      } else if (concat && match(rest, /^[ \t\n]*,[ \t\n]*"[^"]*"/)) {
        chain = chain unquote(substr(rest, RSTART, RLENGTH))
      } else {
        break
      }
      rest = substr(rest, RLENGTH + 1)
    }
    read_by(file, owner, resolve(base, chain))
    # An argument the chain could not read may lead anywhere from there.
    if (match(rest, /^[ \t\n]*\.join[ \t\n]*\(/) || (concat && match(rest, /^[ \t\n]*,/))) read_by(file, owner, ".")
    return rest
  }
  # A run-time read of PATH by FILE in crate OWNER: its manifest row, and the
  # reader --modules maps to the tests that can run it.
  function read_by(file, owner, path) {
    emit("manifest", path, owner)
    if (path == "" || compiling) return
    readers[file SUBSEP owner SUBSEP path] = 1
  }
  function visit(file,   line, status, text) {
    if (file == "" || file in visited) return
    visited[file] = 1
    printf "cli-build\t%s\n", file
    if (file !~ /\.rs$/) return
    if (file in source) text = source[file]
    else {
      while ((status = (getline line < file)) > 0) text = text line "\n"
      close(file)
      if (status < 0) { printf "unreadable\t%s\n", file; return }
    }
    scan(file, text)
  }
  FNR == 1 {
    if (NR > 1) { source[prev] = text; scan(prev, text) }
    prev = FILENAME
    text = $0
    next
  }
  { text = text "\n" $0 }
  END {
    if (NR > 0) { source[prev] = text; scan(prev, text) }
    compiling = 1
    n = split(ENVIRON["RUST_READS_SCOPE"], roots, "\n")
    for (i = 1; i <= n; i++) {
      split(roots[i], root, "\t")
      if (root[2] == "") continue
      if (root[1] == "file") visit(root[2])
      else if (root[1] == "dir") {
        printf "cli-build\t%s\n", root[2]
        for (file in source) if (index(file, root[2] "/") == 1) visit(file)
      }
    }
    n = split(ENVIRON["RUST_READS_TARGETS"], roots, "\n")
    for (i = 1; i <= n; i++) {
      if (split(roots[i], root, "\t") == 3) walk(root[3], 1, root[1], root[2], "")
    }
    if (ENVIRON["RUST_READS_MODULES"] != "") modules()
  }
  # FILE as source text, kept in source[]; 0 when it cannot be read.
  function load(file,   line, status, text) {
    if (file in source) return 1
    if (file == "" || file in missing) return 0
    text = ""
    while ((status = (getline line < file)) > 0) text = text line "\n"
    close(file)
    if (status < 0) { missing[file] = 1; return 0 }
    source[file] = text
    return 1
  }
  # The modules a target reaches from FILE at module PATH, by the rustc
  # rules. `mod x;` opens a line, where rustfmt puts every out-of-line
  # module. Its file is x.rs or x/mod.rs in the directory of FILE when FILE
  # owns that directory (OWNS: a target root, a mod.rs or a #[path] file),
  # and in the directory named after FILE otherwise. A #[path] resolves
  # against the directory of the declaring file.
  function walk(file, owns, manifest, selector, path,   key, dir, sub_dir, text, decl, name, next_path) {
    if (!load(file)) return
    key = file SUBSEP manifest SUBSEP selector SUBSEP path
    if (key in walked) return
    walked[key] = ++nw
    w_file[nw] = file
    w_manifest[nw] = manifest
    w_selector[nw] = selector
    w_path[nw] = path
    dir = file
    sub(/\/[^\/]*$/, "", dir)
    sub_dir = dir
    if (!owns) { sub_dir = file; sub(/\.rs$/, "", sub_dir) }
    text = "\n" source[file]
    while (match(text, /\n(#\[[^\n]*\][ \t]*\n)*(pub(\([^)\n]*\))?[ \t]+)?mod[ \t]+[A-Za-z0-9_]+[ \t]*;/)) {
      decl = substr(text, RSTART, RLENGTH)
      text = substr(text, RSTART + RLENGTH)
      name = decl
      sub(/[ \t]*;$/, "", name)
      sub(/.*[ \t]/, "", name)
      next_path = path == "" ? name : path "::" name
      if (match(decl, /#\[[ \t]*path[ \t]*=[ \t]*"[^"]*"/))
        walk(resolve(dir, unquote(substr(decl, RSTART, RLENGTH))), 1, manifest, selector, next_path)
      else if (load(sub_dir "/" name ".rs")) walk(sub_dir "/" name ".rs", 0, manifest, selector, next_path)
      else walk(sub_dir "/" name "/mod.rs", 1, manifest, selector, next_path)
    }
  }
  # Rust privacy confines an item that is not pub to its module and the
  # modules under it. A trait impl runs wherever its type does, and a macro
  # wherever it expands, so neither is confined.
  function open_items(file) {
    if (!(file in has_pub)) has_pub[file] = (" " source[file] " ") ~ /[^A-Za-z0-9_]pub[^A-Za-z0-9_]/
    return has_pub[file]
  }
  function unconfined(file,   text) {
    if (!(file in has_loose)) {
      text = " " source[file] " "
      has_loose[file] = text ~ /[^A-Za-z0-9_]impl[^A-Za-z0-9_][^{;]*[^A-Za-z0-9_]for[^A-Za-z0-9_]/ || text ~ /macro_rules!/
    }
    return has_loose[file]
  }
  # Whether module I names NAME other than in declaring it: the one way a
  # pub item of module NAME is reached from outside it.
  function names(i, name,   text, key) {
    key = w_file[i] SUBSEP name
    if (!(key in has_name)) {
      text = " " source[w_file[i]] " "
      has_name[key] = 0
      if (index(text, name)) {
        gsub("mod[ \t]+" name "[ \t]*;", "", text)
        has_name[key] = text ~ ("[^A-Za-z0-9_]" name "[^A-Za-z0-9_]")
      }
    }
    return has_name[key]
  }
  # Whether the module at PATH in the target of walked module U, or a module
  # under it, has pub items (OPEN) or unconfined code (otherwise).
  function tree(u, path, open,   i, found, key) {
    key = w_manifest[u] SUBSEP w_selector[u] SUBSEP path SUBSEP open
    if (key in trees) return trees[key]
    found = 0
    for (i = 1; i <= nw && !found; i++) {
      if (w_manifest[i] != w_manifest[u] || w_selector[i] != w_selector[u]) continue
      if (path != "" && w_path[i] != path && index(w_path[i], path "::") != 1) continue
      found = open ? open_items(w_file[i]) : unconfined(w_file[i])
    }
    return trees[key] = found
  }
  function inside(path, reach,   p) {
    for (p in reach) if (p == "" || path == p || index(path, p "::") == 1) return 1
    return 0
  }
  # One `module` row per reader and each module of a target that can run its
  # code: the module holding it, and each module naming one of those with pub
  # items, until none is added. A test target is its own crate, so `.`, its
  # whole run, holds every read in it; a pub library item can run from other
  # crates, so `.` in both columns, the whole crate, stands in for it.
  function modules(   key, part, file, owner, path, rows, u, i, p, reach, grew, whole, leaf) {
    for (key in readers) {
      split(key, part, SUBSEP)
      file = part[1]
      owner = part[2] "/Cargo.toml"
      path = part[3]
      rows = ""
      for (u = 1; u <= nw; u++) {
        if (w_file[u] != file || w_manifest[u] != owner) continue
        if (w_selector[u] == "--lib" && (tree(u, w_path[u], 1) || tree(u, w_path[u], 0))) { rows = ""; break }
        split("", reach)
        reach[w_path[u]] = 1
        whole = w_path[u] == ""
        grew = 1
        while (grew && !whole) {
          grew = 0
          for (i = 1; i <= nw && !whole; i++) {
            if (w_manifest[i] != owner || w_selector[i] != w_selector[u] || inside(w_path[i], reach)) continue
            for (p in reach) {
              leaf = p
              sub(/.*::/, "", leaf)
              if (!tree(u, p, 1) || !names(i, leaf)) continue
              reach[w_path[i]] = grew = 1
              whole = w_path[i] == ""
              break
            }
          }
        }
        for (p in reach) if (tree(u, p, 0)) whole = 1
        if (whole) rows = rows sprintf("module\t%s\t%s\t%s\t.\n", path, owner, w_selector[u])
        else for (p in reach) rows = rows sprintf("module\t%s\t%s\t%s\t%s\n", path, owner, w_selector[u], p)
      }
      if (rows == "") rows = sprintf("module\t%s\t%s\t.\t.\n", path, owner)
      printf "%s", rows
    }
  }
' {} +); then
  echo 'rust-reads: unreadable=crates' >&2
  exit 2
fi

if [[ "$rows" == *$'unreadable\t'* ]]; then
  echo 'rust-reads: unreadable=cli-smoke' >&2
  exit 2
fi

build=$(printf 'build\t%s\n' crates Cargo.toml Cargo.lock rust-toolchain rust-toolchain.toml .cargo \
  clippy.toml .clippy.toml rustfmt.toml .rustfmt.toml)
shared=
if [ -n "$cli_scope" ]; then
  shared=$(awk -F '\t' '$2 != "crates" { print "cli-build\t" $2 }' <<<"$build")
fi
printf '%s\n%s\n%s\n' "$build" "$rows" "$shared" | grep . | LC_ALL=C sort -u
