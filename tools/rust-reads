#!/usr/bin/env bash
# The repository paths the Rust source under crates/ names as ones it reads,
# derived from the source rather than listed by hand, and the paths cargo
# reads to build it. Each row says which shape it came from:
#
#   include   an include_str! or include_bytes! literal, resolved against the
#             including file's directory: a file compiled into the binary or
#             the test at build time. A literal on the line after its opening
#             parenthesis, the shape rustfmt gives a long one, counts too.
#   manifest  a chain of string literals joined onto env!("CARGO_MANIFEST_DIR"),
#             resolved against that crate's manifest directory: a path code or
#             a test reads at run time. The chain is the literal arguments of
#             `.join("...")` calls after it, or the literal arguments beside it
#             in a `concat!`. A chain that ends with no further argument is a
#             read of the path it reached, and every path under it when that
#             is a directory.
#   build     what cargo reads to build every crate: the crates/ tree, the
#             workspace manifest and lock, the toolchain pin and the cargo,
#             clippy and rustfmt configuration, whether or not the checkout
#             holds each file today, so a diff deleting one still names it.
#   cli-build, cli-include   with --cli-smoke, compiled inputs of kendex-cli
#             and its cli_smoke target. Cargo metadata supplies local package
#             dependencies, target roots and all workspace manifests. The
#             source pass follows literal #[path] modules from those roots.
#             Other test targets and unrelated workspace source are excluded.
#             Source directories retain their inline test code and includes.
#             Local dependencies include all declared features and platforms.
#   target   with --ci-targets, a test target's repository inputs. Cargo
#            metadata supplies the target roots and packages. The source
#            walk follows out-of-line modules and literal path attributes.
#            Literal reads in shared files use the compiling target's
#            package. A shared root constructor alone is not a file read.
#            It resolves checkout_root() and literal path joins. An
#            unresolved checkout root emits "." for its executable.
#   target-catalog  a checkout used as a catalog source by a test target.
#   target-root    the metadata roster, in target row format, for job setup.
#   package-root   the manifest directory of a package in that roster.
#   complete       with --ci-targets, the number of preceding read rows.
#   package-include  a compile-time include and its owning package.
#   checkout-include  an include reached by the CLI production roots.
#
# The legacy manifest rows use "." for a chain that reaches the checkout
# root or whose next argument is dynamic. They also retain the chain's
# resolved directory. This mode scans CARGO_MANIFEST_DIR expressions only.
# The target mode additionally resolves checkout-relative operands. A
# dynamic suffix retains its resolved directory when the literal prefix is
# known. A root passed through unrecognized code stays unresolved.
#
# A resolved path that climbs out of the checkout names no repository path and
# is not printed.
#
# Usage: tools/rust-reads [--cli-smoke] [--ci-targets] [ROOT]
#   ROOT   the checkout to read; the current directory when omitted
# stdout: one `<kind><TAB><path>` row per distinct read, sorted, the path
# relative to ROOT. A manifest row appends `<TAB><owning Cargo.toml>` so
# guard can run the reading crate without a separate path map.
# A target row appends `<TAB><package><TAB><kind><TAB><name>` for CI.
# Exit 0 with the rows, 2 when the source could not be read
# or the arguments are wrong, and a read that did not run is never printed as
# an empty set: a crates/ tree holding no Cargo.toml is one that could not be
# read. A refusal is one stderr line:
#   rust-reads: unreadable=<path>   ROOT, or the crates/ tree, could not be
#                                   read or holds no crate
#   rust-reads: unreadable=cli-smoke   Cargo metadata failed, the CLI smoke
#                                   target is missing
#   rust-reads: unreadable=<source> reader=cli-smoke  CLI source read failed
#   rust-reads: unreadable=<source> package=<package> target=<kind>/<name>
#                                   Cargo test source read failed
#   rust-reads: usage=<usage>       more than one argument
set -euo pipefail

cli_scope='' targets=''
if [ "${1:-}" = --cli-smoke ]; then cli_scope=1; shift; fi
if [ "${1:-}" = --ci-targets ]; then targets=1; shift; fi
case $# in
  0) root=. ;;
  1) root=$1 ;;
  *) echo "rust-reads: usage=tools/rust-reads [--cli-smoke] [--ci-targets] [ROOT]" >&2; exit 2 ;;
esac
cd -- "$root" 2>/dev/null || { printf 'rust-reads: unreadable=%s\n' "$root" >&2; exit 2; }
[ -d crates ] || { echo 'rust-reads: unreadable=crates' >&2; exit 2; }

# The manifest directories, for the awk pass to find each file's crate by.
if ! manifests=$(find crates -type f -name Cargo.toml) || [ -z "$manifests" ]; then
  echo 'rust-reads: unreadable=crates' >&2
  exit 2
fi

scope='' target_roots='' package_roots=''
if [ -n "$cli_scope$targets" ]; then
  # https://doc.rust-lang.org/cargo/commands/cargo-metadata.html
  metadata_reader=test-targets
  [ -z "$cli_scope" ] || metadata_reader=cli-smoke
  metadata=$(cargo metadata --format-version 1 --no-deps --locked) ||
    { printf 'rust-reads: unreadable=%s\n' "$metadata_reader" >&2; exit 2; }
  metadata=$(jq -ces '
    select(length == 1) | .[0]
    | select((.packages | type) == "array" and (.workspace_members | type) == "array")
    | select((.packages | length) > 0 and ([.packages[].id] | sort) == (.workspace_members | unique))
    | select(all(.packages[]; (.id | type) == "string" and (.name | type) == "string"
        and (.manifest_path | type) == "string" and (.targets | type) == "array" and (.targets | length) > 0
        and all(.targets[]; (.src_path | type) == "string" and (.name | type) == "string"
          and (.kind | type) == "array" and (.kind | length) > 0 and (.test | type) == "boolean")))
  ' <<<"$metadata") || { printf 'rust-reads: unreadable=%s operation=metadata-shape\n' "$metadata_reader" >&2; exit 2; }
fi
if [ -n "$targets" ]; then
  # Workspace metadata can lose a target without losing its package ID.
  # Read each requested manifest's own roster before accepting a subset.
  roster='[.targets[] | [.name, .src_path, (.kind | sort), .test]] | sort'
  requests=$(jq -er ".packages[] | [.manifest_path, ($roster | tojson)] | @tsv" <<<"$metadata") || exit 2
  while IFS=$'\t' read -r manifest expected; do
    if ! package=$(cargo read-manifest --manifest-path "$manifest") ||
      ! actual=$(jq -ces "select(length == 1) | .[0] | $roster" <<<"$package") ||
      [ "$actual" != "$expected" ]; then
      printf 'rust-reads: unreadable=test-targets operation=manifest-roster manifest=%s\n' "$manifest" >&2
      exit 2
    fi
  done <<<"$requests"
  target_roots=$(jq -er --arg root "$(pwd -P)/" '
    .packages[] | .name as $package | .targets[] | select(.test)
    | (if (.kind | index("bin")) then "bin"
      elif (.kind | index("test")) then "test"
      elif (.kind | index("example")) then "example"
      elif (.kind | index("bench")) then "bench"
      elif (.kind | index("custom-build")) then empty
      else "lib" end) as $kind
    | if (.src_path | startswith($root) | not) then error("target outside checkout")
      else [(.src_path | ltrimstr($root)), $package, $kind, .name] | @tsv end
  ' <<<"$metadata") || { echo 'rust-reads: unreadable=test-targets' >&2; exit 2; }
  package_roots=$(jq -er --arg root "$(pwd -P)/" '
    .packages[] | .name as $name | .manifest_path
    | if startswith($root) then ltrimstr($root) | sub("(^|/)Cargo\\.toml$"; "")
      else error("package outside checkout") end
    | [(if . == "" then "." else . end), $name] | @tsv
  ' <<<"$metadata") || { echo 'rust-reads: unreadable=packages' >&2; exit 2; }
fi
if [ -n "$cli_scope" ]; then
  # --no-deps reads workspace declarations without fetching registry crates.
  # Keep every member manifest: Cargo reads them to resolve a CLI build too.
  if ! scope=$(jq -er --arg root "$(pwd -P)/" '
      .packages as $packages
      | def closure($paths; $dev):
          ($paths + [$packages[] | select(.manifest_path as $p | $paths | index($p))
            | . as $package | .dependencies[]
            | select(.path != null and (.kind != "dev" or ($dev and $package.name == "kendex-cli")))
            | .path + "/Cargo.toml"] | unique) as $next
          | if $next == $paths then $next else closure($next; $dev) end;
        [$packages[] | select(.name == "kendex-cli")] as $cli
      | if ($cli | length) != 1 or
           ([$cli[0].targets[] | select(.name == "cli_smoke" and (.kind | index("test")))] | length) != 1
        then error("missing CLI smoke target") else . end
      | closure([$cli[0].manifest_path]; true) as $paths
      | closure([$cli[0].manifest_path]; false) as $checkout
      | ([$packages[].manifest_path | ["file", .]] +
          [$packages[] | select(.manifest_path as $p | $paths | index($p))
           | . as $package | .targets[]
           | ($package.manifest_path as $p | $checkout | index($p)) as $normal
           | if (.kind | index("lib")) or
                ($package.name == "kendex-cli" and (.kind | index("bin")))
             then ["dir", (.src_path | sub("/[^/]+$"; "")), (if $normal != null then .src_path else "" end)]
             elif (.kind | index("custom-build")) or
                  ($package.name == "kendex-cli" and .name == "cli_smoke" and (.kind | index("test")))
             then ["file", .src_path, (if $normal != null and (.kind | index("custom-build") != null) then .src_path else "" end)]
             else empty end])[]
      | select(.[1] | startswith($root)) | .[1] |= ltrimstr($root) | .[2] |= (. // "" | ltrimstr($root)) | @tsv
    ' <<<"$metadata"); then
    echo 'rust-reads: unreadable=cli-smoke' >&2
    exit 2
  fi
fi

if rows=$(find crates -type f -name '*.rs' |
  RUST_READS_MANIFESTS="$manifests" RUST_READS_SCOPE="$scope" RUST_READS_TARGETS="$target_roots" \
    RUST_READS_PACKAGES="$package_roots" awk '
  BEGIN {
    n = split(ENVIRON["RUST_READS_MANIFESTS"], found, "\n")
    for (i = 1; i <= n; i++) {
      if (found[i] == "") continue
      dir = found[i]
      sub(/\/?Cargo\.toml$/, "", dir)
      crate[dir] = 1
    }
    n = split(ENVIRON["RUST_READS_PACKAGES"], found, "\n")
    for (i = 1; i <= n; i++) {
      split(found[i], package, "\t")
      if (package[1] != "") {
        package_by_dir[package[1]] = package[2]
        manifest_by_package[package[2]] = package[1]
        printf "package-root\t%s\t%s\n", package[1], package[2]
      }
    }
  }
  # The repository path BASE/LIT names, or "" when it climbs out of the
  # checkout; "." is the checkout itself.
  function resolve(base, lit,   n, seg, i, k, out) {
    n = split(base "/" lit, seg, "/")
    k = 0
    for (i = 1; i <= n; i++) {
      if (seg[i] == "" || seg[i] == ".") continue
      if (seg[i] == "..") { if (k == 0) return ""; k--; continue }
      seg[++k] = seg[i]
    }
    if (k == 0) return "."
    out = seg[1]
    for (i = 2; i <= k; i++) out = out "/" seg[i]
    return out
  }
  function emit(kind, path, owner) {
    if (path == "") return
    if (target != "") printf "%s\t%s\t%s\n", (kind == "catalog" ? "target-catalog" : "target"), path, target
    else if (!compiling) {
      if (kind == "manifest") printf "%s\t%s\t%s/Cargo.toml\n", kind, path, owner
      else printf "%s\t%s\n", kind, path
    }
    else if (kind == "include") {
      printf "%s\t%s\n", (checkout ? "checkout-include" : "cli-include"), path
    }
  }
  function unquote(tok) {
    sub(/^[^"]*"/, "", tok)
    sub(/"$/, "", tok)
    return tok
  }
  # The manifest directory owning FILE: its nearest ancestor holding a
  # Cargo.toml. None is a crates/ file outside every crate, and "" says so.
  function manifest_dir(file,   dir) {
    dir = file
    while (sub(/\/[^\/]*$/, "", dir)) {
      if (dir in crate) return dir
    }
    return ""
  }
  function scan(file, text,   dir, rest, lit, chain, owner, path, catalog) {
    dir = file
    sub(/\/[^\/]*$/, "", dir)
    owner = manifest_dir(file)
    rest = text
    while (match(rest, /include_(str|bytes)![ \t\n]*\([ \t\n]*"[^"]*"/)) {
      path = resolve(dir, unquote(substr(rest, RSTART, RLENGTH)))
      emit("include", path)
      if (!compiling && path != "" && owner in package_by_dir)
        printf "package-include\t%s\t%s\n", path, package_by_dir[owner]
      rest = substr(rest, RSTART + RLENGTH)
    }
    if (compiling && target == "" && !checkout) {
      rest = text
      while (match(rest, /#[ \t\n]*\[[ \t\n]*path[ \t\n]*=[ \t\n]*"[^"]*"/)) {
        visit(resolve(dir, unquote(substr(rest, RSTART, RLENGTH))))
        rest = substr(rest, RSTART + RLENGTH)
      }
    }
    if (owner == "" && target_manifest == "") return
    rest = text
    while (match(rest, /env![ \t\n]*\([ \t\n]*"CARGO_MANIFEST_DIR"[ \t\n]*\)|checkout_root\(\)/)) {
      # This binding is the local source passed to kendex add catalog in
      # catalog_render_lint. A different root expression remains unrestricted.
      catalog = target == "kendex-cli\ttest\tcatalog_render_lint" && file == "crates/cli/tests/catalog_render_lint.rs" &&
        substr(rest, 1, RSTART - 1) ~ /let catalog = Path::new\($/ &&
        substr(rest, RSTART + RLENGTH) ~ /^\)[ \t\n]*\.join\("\.\.\/\.\."\)[ \t\n]*\.canonicalize\(\)[ \t\n]*\.unwrap\(\);/ &&
        text ~ /test_util::source_path\(&catalog\)/
      lit = substr(rest, RSTART, RLENGTH)
      rest = substr(rest, RSTART + RLENGTH)
      # The closing parentheses of the Path::new or PathBuf::from around it.
      if (match(rest, /^[ \t\n]*\)+/)) rest = substr(rest, RLENGTH + 1)
      chain = lit == "checkout_root()" ? "../.." : ""
      if (chain != "" && target == "") continue
      while (1) {
        if (match(rest, /^[ \t\n]*\.join[ \t\n]*\([ \t\n]*"[^"]*"[ \t\n]*\)/)) {
          lit = substr(rest, RSTART, RLENGTH)
          sub(/[ \t\n]*\)$/, "", lit)
          chain = chain "/" unquote(lit)
        } else if (match(rest, /^[ \t\n]*,[ \t\n]*"[^"]*"/)) {
          chain = chain unquote(substr(rest, RSTART, RLENGTH))
        } else {
          break
        }
        rest = substr(rest, RLENGTH + 1)
      }
      path = resolve(target == "" ? owner : target_manifest, chain)
      if (owner != "" || path != ".") emit(catalog && path == "." ? "catalog" : "manifest", path, owner)
      # An argument the chain could not read may lead anywhere from there.
      if (target == "" && match(rest, /^[ \t\n]*(\.join[ \t\n]*\(|,)/)) emit("manifest", ".", owner)
    }
  }
  function blank(text) {
    gsub(/[^\n]/, " ", text)
    return text
  }
  # Mask comments and literals without moving offsets. Braces inside a Rust
  # string, nested comment or char literal do not close a gated item.
  function structure(text,   code, at, tok, close_at, depth, pattern, span) {
    while (match(text, /\/\/|\/\*|r#*"|["\047]/)) {
      at = RSTART; tok = substr(text, at, RLENGTH)
      code = code substr(text, 1, at - 1)
      text = substr(text, at)
      if (tok == "//") {
        close_at = index(text, "\n")
        span = close_at ? close_at - 1 : length(text)
      } else if (tok == "/*") {
        span = 2; depth = 1
        while (depth && match(substr(text, span + 1), /\/\*|\*\//)) {
          depth += substr(text, span + RSTART, 2) == "/*" ? 1 : -1
          span += RSTART + 1
        }
        if (depth) return ""
      } else if (tok ~ /^r/) {
        pattern = "\"" substr(tok, 2, length(tok) - 2)
        close_at = index(substr(text, length(tok) + 1), pattern)
        if (!close_at) return ""
        span = length(tok) + close_at + length(pattern) - 1
      } else if (tok == "\"") {
        if (!match(text, /^"([^"\\]|\\.)*"/)) return ""
        span = RLENGTH
      } else if (match(text, /^\047([^\047\\\n]|\\(x[[:xdigit:]]{2}|u\{[[:xdigit:]_]+\}|.))\047/)) {
        span = RLENGTH
      } else {
        # A lifetime begins with the same punctuation as a char literal.
        code = code tok; text = substr(text, 2); continue
      }
      code = code blank(substr(text, 1, span))
      text = substr(text, span + 1)
    }
    return code text
  }
  # A positive test cfg (or all(test, ...)) is false for cargo build. Keep
  # other predicates conservatively. Scan the whole item before masking it.
  function production(text,   code, offset, start, end, rest, tok, braces, parens, brackets) {
    if (text !~ /#[ \t]*\[[ \t]*cfg[ \t]*\([ \t]*(test|all)[ \t]*[),\(]/) return text
    code = structure(text)
    while (match(code, /(^|\n)[ \t]*#[ \t]*\[[ \t]*cfg[ \t]*\([ \t]*(test[ \t]*\)|all[ \t]*\([ \t]*test[ \t]*[,\)])[^]\n]*\]/)) {
      start = RSTART; end = RSTART + RLENGTH - 1
      rest = substr(code, end + 1)
      braces = parens = brackets = 0; tok = ""
      while (match(rest, /[][(){};]/)) {
        tok = substr(rest, RSTART, 1)
        end += RSTART
        rest = substr(rest, RSTART + 1)
        if (tok == "(" || tok == ")") parens += tok == "(" ? 1 : -1
        if (tok == "[" || tok == "]") brackets += tok == "[" ? 1 : -1
        if (parens || brackets) continue
        if (tok == "{" || tok == "}") braces += tok == "{" ? 1 : -1
        if (!braces && (tok == ";" || tok == "}")) break
      }
      if (braces || tok != ";" && tok != "}") return text
      text = substr(text, 1, offset + start - 1) blank(substr(text, offset + start, end - start + 1)) substr(text, offset + end + 1)
      code = rest
      offset += end
    }
    return text
  }
  function visit(file, modules,   line, status, closed, text, dir, path, name, attr, count, lines, i) {
    if (file == "" || visited[target, checkout, file]++) return
    if (target == "" && !checkout) printf "cli-build\t%s\n", file
    else if (target != "" && manifest_dir(file) == "") emit("source", file)
    if (file !~ /\.rs$/) return
    if (file in source) text = source[file]
    else {
      while ((status = (getline line < file)) > 0) text = text line "\n"
      closed = close(file)
      if (status < 0 || closed != 0) {
        if (target == "") printf "rust-reads: unreadable=%s reader=cli-smoke\n", file > "/dev/stderr"
        else {
          split(target, reader, "\t")
          printf "rust-reads: unreadable=%s package=%s target=%s/%s\n", file, reader[1], reader[2], reader[3] > "/dev/stderr"
        }
        exit 3
      }
    }
    if (checkout) text = production(text)
    scan(file, text)
    if (target == "" && !checkout) return
    dir = file
    sub(/\/[^\/]*$/, "", dir)
    if (modules == "") modules = dir
    count = split(text, lines, "\n")
    for (i = 1; i <= count; i++) {
      line = lines[i]
      if (match(line, /^[ \t]*#\[[ \t]*path[ \t]*=[ \t]*"[^"]*"/))
        attr = unquote(substr(line, RSTART, RLENGTH))
      if (!match(line, /^[ \t]*(pub(\([^)]*\))?[ \t]+)?mod[ \t]+[[:alnum:]_]+[ \t]*;/))
        continue
      name = substr(line, RSTART, RLENGTH)
      sub(/^.*mod[ \t]+/, "", name)
      sub(/[ \t]*;$/, "", name)
      if (attr != "") {
        path = resolve(dir, attr)
        attr = ""
        visit(path, "")
      } else if (modules "/" name ".rs" in source) {
        visit(modules "/" name ".rs", modules "/" name)
      } else {
        visit(modules "/" name "/mod.rs", modules "/" name)
      }
    }
  }
  {
    file = $0; text = ""
    while ((status = (getline line < file)) > 0) text = text line "\n"
    closed = close(file)
    if (status < 0 || closed != 0) { printf "unreadable\t%s\n", file; failed = 1; exit }
    source[file] = text
    scan(file, text)
  }
  END {
    if (failed) exit 2
    compiling = 1
    n = split(ENVIRON["RUST_READS_SCOPE"], roots, "\n")
    for (i = 1; i <= n; i++) {
      split(roots[i], root, "\t")
      if (root[2] == "") continue
      checkout = 0
      if (root[1] == "file") visit(root[2])
      else if (root[1] == "dir") {
        printf "cli-build\t%s\n", root[2]
        for (file in source) if (index(file, root[2] "/") == 1) visit(file)
      }
      if (root[3] != "" && ENVIRON["RUST_READS_TARGETS"] != "") {
        checkout = 1
        visit(root[3])
      }
    }
    checkout = 0
    n = split(ENVIRON["RUST_READS_TARGETS"], roots, "\n")
    for (i = 1; i <= n; i++) {
      at = index(roots[i], "\t")
      if (!at) continue
      target = substr(roots[i], at + 1)
      split(target, reader, "\t")
      target_manifest = manifest_by_package[reader[1]]
      file = substr(roots[i], 1, at - 1)
      printf "target-root\t%s\t%s\n", file, target
      visit(file, "")
    }
  }
'); then
  :
else
  status=$?
  # Status 3 has already diagnosed the unreadable scoped source.
  [ "$status" -eq 3 ] || echo 'rust-reads: unreadable=crates' >&2
  exit 2
fi

build=$(printf 'build\t%s\n' crates Cargo.toml Cargo.lock rust-toolchain rust-toolchain.toml .cargo \
  clippy.toml .clippy.toml rustfmt.toml .rustfmt.toml)
shared=
if [ -n "$cli_scope" ]; then
  shared=$(awk -F '\t' '$2 != "crates" { print "cli-build\t" $2 }' <<<"$build")
fi
printf '%s\n%s\n%s\n' "$build" "$rows" "$shared" | grep . | LC_ALL=C sort -u |
  awk -v targets="$targets" '{ print } END { if (targets) printf "complete\t%d\n", NR }'
