#!/usr/bin/env bash
# The repository paths the Rust source under crates/ names as ones it reads,
# derived from the source rather than listed by hand, and the paths cargo
# reads to build it. Each row says which shape it came from:
#
#   include   an include_str! or include_bytes! literal, resolved against the
#             including file's directory: a file compiled into the binary or
#             the test at build time. A literal on the line after its opening
#             parenthesis, the shape rustfmt gives a long one, counts too.
#   manifest  a chain of string literals joined onto env!("CARGO_MANIFEST_DIR"),
#             resolved against that crate's manifest directory: a path code or
#             a test reads at run time. The chain is the literal arguments of
#             `.join("...")` calls after it, or the literal arguments beside it
#             in a `concat!`. A chain that ends with no further argument is a
#             read of the path it reached, and every path under it when that
#             is a directory.
#   build     what cargo reads to build every crate: the crates/ tree, the
#             workspace manifest and lock, the toolchain pin and the cargo,
#             clippy and rustfmt configuration, whether or not the checkout
#             holds each file today, so a diff deleting one still names it.
#   cli-build, cli-include   with --cli-smoke, compiled inputs of kendex-cli
#             and its cli_smoke target. Cargo metadata supplies local package
#             dependencies, target roots and all workspace manifests. The
#             source pass follows literal #[path] modules from those roots.
#             Other test targets and unrelated workspace source are excluded.
#             Source directories retain their inline test code and includes.
#             Local dependencies include all declared features and platforms.
#
# `.` is the row for what this reader does not follow: a chain that reaches
# the repository root, and a chain that goes on with an argument that is not
# a string literal, such as `.join(name)` or `.join(format!(...))`. That
# second chain also prints the directory it reached, since `.join(name)` most
# often names a file in it, but the argument can lead out of it too. Code that
# joins onto a returned path elsewhere is not followed, so a helper like
# crates/test_util.rs's checkout_root() and every read through it is absent,
# and a helper returning the manifest directory reads as that crate's
# directory. A path read by any other route is not here.
#
# A resolved path that climbs out of the checkout names no repository path and
# is not printed.
#
# Usage: tools/rust-reads [--cli-smoke] [ROOT]
#   ROOT   the checkout to read; the current directory when omitted
# stdout: one `<kind><TAB><path>` row per distinct read, sorted, the path
# relative to ROOT. A manifest row appends `<TAB><owning Cargo.toml>` so
# guard can run the reading crate without a separate path map.
# Exit 0 with the rows, 2 when the source could not be read
# or the arguments are wrong, and a read that did not run is never printed as
# an empty set: a crates/ tree holding no Cargo.toml is one that could not be
# read. A refusal is one stderr line:
#   rust-reads: unreadable=<path>   ROOT, or the crates/ tree, could not be
#                                   read or holds no crate
#   rust-reads: unreadable=cli-smoke   Cargo metadata failed, the CLI smoke
#                                   target is missing, or a literal path
#                                   module could not be read
#   rust-reads: usage=<usage>       more than one argument
set -euo pipefail

cli_scope=
if [ "${1:-}" = --cli-smoke ]; then cli_scope=1; shift; fi
case $# in
  0) root=. ;;
  1) root=$1 ;;
  *) echo "rust-reads: usage=tools/rust-reads [--cli-smoke] [ROOT]" >&2; exit 2 ;;
esac
cd -- "$root" 2>/dev/null || { printf 'rust-reads: unreadable=%s\n' "$root" >&2; exit 2; }
[ -d crates ] || { echo 'rust-reads: unreadable=crates' >&2; exit 2; }

# The manifest directories, for the awk pass to find each file's crate by.
if ! manifests=$(find crates -type f -name Cargo.toml) || [ -z "$manifests" ]; then
  echo 'rust-reads: unreadable=crates' >&2
  exit 2
fi

scope=
if [ -n "$cli_scope" ]; then
  # --no-deps reads workspace declarations without fetching registry crates.
  # Keep every member manifest: Cargo reads them to resolve a CLI build too.
  if ! metadata=$(cargo metadata --format-version 1 --no-deps --locked) ||
     ! scope=$(jq -er --arg root "$(pwd -P)/" '
      .packages as $packages
      | def closure($paths):
          ($paths + [$packages[] | select(.manifest_path as $p | $paths | index($p))
            | . as $package | .dependencies[]
            | select(.path != null and (.kind != "dev" or $package.name == "kendex-cli"))
            | .path + "/Cargo.toml"] | unique) as $next
          | if $next == $paths then $next else closure($next) end;
        [$packages[] | select(.name == "kendex-cli")] as $cli
      | if ($cli | length) != 1 or
           ([$cli[0].targets[] | select(.name == "cli_smoke" and (.kind | index("test")))] | length) != 1
        then error("missing CLI smoke target") else . end
      | closure([$cli[0].manifest_path]) as $paths
      | ([$packages[].manifest_path | ["file", .]] +
          [$packages[] | select(.manifest_path as $p | $paths | index($p))
           | . as $package | .targets[]
           | if (.kind | index("lib")) or
                ($package.name == "kendex-cli" and (.kind | index("bin")))
             then ["dir", (.src_path | sub("/[^/]+$"; ""))]
             elif (.kind | index("custom-build")) or
                  ($package.name == "kendex-cli" and .name == "cli_smoke" and (.kind | index("test")))
             then ["file", .src_path] else empty end])[]
      | select(.[1] | startswith($root)) | .[1] |= ltrimstr($root) | @tsv
    ' <<<"$metadata"); then
    echo 'rust-reads: unreadable=cli-smoke' >&2
    exit 2
  fi
fi

if ! rows=$(RUST_READS_MANIFESTS="$manifests" RUST_READS_SCOPE="$scope" find crates -type f -name '*.rs' -exec awk '
  BEGIN {
    n = split(ENVIRON["RUST_READS_MANIFESTS"], found, "\n")
    for (i = 1; i <= n; i++) {
      if (found[i] == "") continue
      dir = found[i]
      sub(/\/?Cargo\.toml$/, "", dir)
      crate[dir] = 1
    }
  }
  # The repository path BASE/LIT names, or "" when it climbs out of the
  # checkout; "." is the checkout itself.
  function resolve(base, lit,   n, seg, i, k, out) {
    n = split(base "/" lit, seg, "/")
    k = 0
    for (i = 1; i <= n; i++) {
      if (seg[i] == "" || seg[i] == ".") continue
      if (seg[i] == "..") { if (k == 0) return ""; k--; continue }
      seg[++k] = seg[i]
    }
    if (k == 0) return "."
    out = seg[1]
    for (i = 2; i <= k; i++) out = out "/" seg[i]
    return out
  }
  function emit(kind, path, owner) {
    if (path == "") return
    if (!compiling) {
      if (kind == "manifest") printf "%s\t%s\t%s/Cargo.toml\n", kind, path, owner
      else printf "%s\t%s\n", kind, path
    }
    else if (kind == "include") printf "cli-include\t%s\n", path
  }
  function unquote(tok) {
    sub(/^[^"]*"/, "", tok)
    sub(/"$/, "", tok)
    return tok
  }
  # The manifest directory owning FILE: its nearest ancestor holding a
  # Cargo.toml. None is a crates/ file outside every crate, and "" says so.
  function manifest_dir(file,   dir) {
    dir = file
    while (sub(/\/[^\/]*$/, "", dir)) {
      if (dir in crate) return dir
    }
    return ""
  }
  function scan(file, text,   dir, rest, lit, chain, owner) {
    dir = file
    sub(/\/[^\/]*$/, "", dir)
    rest = text
    while (match(rest, /include_(str|bytes)![ \t\n]*\([ \t\n]*"[^"]*"/)) {
      emit("include", resolve(dir, unquote(substr(rest, RSTART, RLENGTH))))
      rest = substr(rest, RSTART + RLENGTH)
    }
    if (compiling) {
      rest = text
      while (match(rest, /#[ \t\n]*\[[ \t\n]*path[ \t\n]*=[ \t\n]*"[^"]*"/)) {
        visit(resolve(dir, unquote(substr(rest, RSTART, RLENGTH))))
        rest = substr(rest, RSTART + RLENGTH)
      }
    }
    owner = manifest_dir(file)
    if (owner == "") return
    rest = text
    while (match(rest, /env![ \t\n]*\([ \t\n]*"CARGO_MANIFEST_DIR"[ \t\n]*\)/)) {
      rest = substr(rest, RSTART + RLENGTH)
      # The closing parentheses of the Path::new or PathBuf::from around it.
      if (match(rest, /^[ \t\n]*\)+/)) rest = substr(rest, RLENGTH + 1)
      chain = ""
      while (1) {
        if (match(rest, /^[ \t\n]*\.join[ \t\n]*\([ \t\n]*"[^"]*"[ \t\n]*\)/)) {
          lit = substr(rest, RSTART, RLENGTH)
          sub(/[ \t\n]*\)$/, "", lit)
          chain = chain "/" unquote(lit)
        } else if (match(rest, /^[ \t\n]*,[ \t\n]*"[^"]*"/)) {
          chain = chain unquote(substr(rest, RSTART, RLENGTH))
        } else {
          break
        }
        rest = substr(rest, RLENGTH + 1)
      }
      emit("manifest", resolve(owner, chain), owner)
      # An argument the chain could not read may lead anywhere from there.
      if (match(rest, /^[ \t\n]*(\.join[ \t\n]*\(|,)/)) emit("manifest", ".", owner)
    }
  }
  function visit(file,   line, status, text) {
    if (file == "" || file in visited) return
    visited[file] = 1
    printf "cli-build\t%s\n", file
    if (file !~ /\.rs$/) return
    if (file in source) text = source[file]
    else {
      while ((status = (getline line < file)) > 0) text = text line "\n"
      close(file)
      if (status < 0) { printf "unreadable\t%s\n", file; return }
    }
    scan(file, text)
  }
  FNR == 1 {
    if (NR > 1) { source[prev] = text; scan(prev, text) }
    prev = FILENAME
    text = $0
    next
  }
  { text = text "\n" $0 }
  END {
    if (NR > 0) { source[prev] = text; scan(prev, text) }
    compiling = 1
    n = split(ENVIRON["RUST_READS_SCOPE"], roots, "\n")
    for (i = 1; i <= n; i++) {
      split(roots[i], root, "\t")
      if (root[2] == "") continue
      if (root[1] == "file") visit(root[2])
      else if (root[1] == "dir") {
        printf "cli-build\t%s\n", root[2]
        for (file in source) if (index(file, root[2] "/") == 1) visit(file)
      }
    }
  }
' {} +); then
  echo 'rust-reads: unreadable=crates' >&2
  exit 2
fi

if [[ "$rows" == *$'unreadable\t'* ]]; then
  echo 'rust-reads: unreadable=cli-smoke' >&2
  exit 2
fi

build=$(printf 'build\t%s\n' crates Cargo.toml Cargo.lock rust-toolchain rust-toolchain.toml .cargo \
  clippy.toml .clippy.toml rustfmt.toml .rustfmt.toml)
shared=
if [ -n "$cli_scope" ]; then
  shared=$(awk -F '\t' '$2 != "crates" { print "cli-build\t" $2 }' <<<"$build")
fi
printf '%s\n%s\n%s\n' "$build" "$rows" "$shared" | grep . | LC_ALL=C sort -u
