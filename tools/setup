#!/usr/bin/env bash
# Arm the commit guards — run once per clone.
#
# The growth-guards installer owns .git/hooks. Its pre-commit line runs the
# package chain, which ends in tools/guard (GROWTH_GUARDS_PRE_COMMIT_LOCAL).
# The commit-msg chain has no such repo-local lane, so this repo's own rule is
# spliced in directly below the installer's delegate line: appended at the end
# it would sit under whatever else the hook already runs, and a body that
# exits first would leave the changelog rule unreachable. The lane is called,
# never exec'd, and only its refusal ends the hook — the same shape the
# installer's own line has, so a consumer body below still runs.
#
# Whether the shims are armed is the installer's verdict to give, not this
# script's to infer from a file that exists: git may be reading hooks from
# somewhere else entirely.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

INSTALLER=.agents/skills/growth-guards/scripts/install-git-hooks
# Trailing marker on the installer's own delegate line.
SENTINEL="# kendex-guards-hook"
LANE='"$(git rev-parse --show-toplevel)/tools/commit-msg" "$@" || exit $?'

not_armed() {
  echo "setup: the guard shims are not armed (the report above says why). A clone armed by the old tools/setup carries hooks the installer will not rewrite, because it refuses an interpreter it cannot verify: delete .git/hooks/pre-commit AND .git/hooks/commit-msg, then run this again." >&2
  exit 1
}

"$INSTALLER" || not_armed
"$INSTALLER" --check || not_armed

# Splice the repo lane in below the delegate line, dropping any copy already
# in the file so a re-run repairs rather than stacks. The bytes after the
# delegate line are the hook's own, final newline included.
splice_lane() { # HOOK-FILE
  local hook="$1" tmp="" body=""
  local ends_nl=1
  [ -n "$(tail -c 1 -- "$hook")" ] && ends_nl=0
  tmp="$(mktemp -- "$hook.tmp.XXXXXX")"
  awk -v lane="$LANE" -v sentinel="$SENTINEL" '
    $0 == lane { next }
    { print }
    !placed && index($0, sentinel) { print lane; placed = 1 }
    END { exit placed ? 0 : 1 }
  ' "$hook" >"$tmp" || {
    rm -f -- "$tmp"
    echo "setup: $hook carries no growth-guards delegate line, so there is nothing to run this repo's rule after" >&2
    exit 1
  }
  if [ "$ends_nl" -eq 0 ]; then
    body="$(cat -- "$tmp")"
    printf '%s' "$body" >"$tmp"
  fi
  cat -- "$tmp" >"$hook"
  rm -f -- "$tmp"
}

splice_lane "$(git rev-parse --git-common-dir)/hooks/commit-msg"
echo "hooks armed; repo commit-msg lane wired"
