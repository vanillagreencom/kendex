#!/usr/bin/env bash
# What a catalog package ships cites nothing its install lacks.
#
# A package under skills/, hooks/, agents/ or pi-extensions/ installs into a
# repository that holds none of kendex's decision records, and where, of the
# other catalog packages, only those it requires are sure to be installed. A
# relative markdown link into a package the citing one lists as optional, or
# not at all, is dead wherever that package is absent, and the consumer's
# md-refs warns on it at every commit. A decision citation names a record
# the reader cannot open unless the package ships it: the consumer's md-refs
# leaves it unjudged where the consumer tracks no decision directory, or
# where it is linked to a URL or sits in a comment with no § after it, and
# resolves it to an unrelated local record where the consumer has its own
# decision directory. skills/AGENTS.md states the rule; GitHub cannot judge
# it, so kendex's commit lane runs this.
#
# A package is the place a path sits in the catalog: skills/<name>/ and
# pi-extensions/<name>/ directories, one hook script directly under hooks/
# (the markdown beside them documents the directory) and one agent file
# directly under agents/. What it ships: a skill everything its render
# carries, which leaves out the top-level entries named on the command line;
# a Pi package every path kendex's install copies, which leaves out a path
# with any component PI_SKIPPED names, and of which the npm tarball its
# package.json `files` list selects is a subset; a hook or an agent its own
# file.
#
# A decision ID is D and at least three digits bounded by non-alphanumerics,
# the scheme docs/decisions spells. It is read in markdown prose outside
# code spans and front matter, linked or not, by md-refs' block and ID
# readers, and in the comment text of any other shipped file whose comment
# family gg_comment_family knows, which the comments lane's extractor
# separates. Not read: commands/, which is none of the four roots; the
# comments of a file with no family there, .awk and .txt among them; and
# front matter. An ID passes only where the package ships a `<ID>-*.md`
# record. A markdown link is md-refs' link reader's relative destination,
# resolved against the citing file, in a heading as in any other block; it
# passes where it lands in the citing
# package or, from a skill, in a skill that skill's SKILL.md lists under
# dependencies.required as lib/skill-requirements.awk reads it.
#
# Usage: tools/shipped-refs [NAME...]
#   NAME   a top-level skill entry no render carries; tools/guard hands over
#          its not_rendered list
# Exit: 0 nothing breaks the rule, 1 a citation or link does, 2 the tree
# could not be read, never read as a clean tree. Every finding opens with
# `shipped-refs: <key>=<value>`: `decisions=<count>` or `links=<count>`, each
# offending reference below it as path:line and the ID or destination; a
# refusal is `unreadable=<path>` or `manifest=<path>` on stderr.
set -euo pipefail

TOOLS_DIR="$(cd "$(dirname "$0")" && pwd)" || exit 2
GG_LIB="$TOOLS_DIR/../.agents/skills/commit-guards/scripts/lib"
# shellcheck disable=SC2034 # the sourced message helpers name their producer from it
GG_CHECK=shipped-refs
# shellcheck source=../.agents/skills/commit-guards/scripts/lib/common.sh
source "$GG_LIB/common.sh"
# shellcheck source=../.agents/skills/commit-guards/scripts/lib/comment-text.sh
source "$GG_LIB/comment-text.sh"
gg_repo_root_cd
gg_tmpdir

ID_PREFIX=D
ID_WIDTH=3
ROOTS="skills hooks agents pi-extensions"
# The names crates/core/src/pi_ext/files.rs SKIPPED holds, which
# copy_package leaves out at any depth of a Pi package;
# shipped_refs_pi_skipped_is_the_copy_list there holds this copy to it.
PI_SKIPPED="node_modules .git .turbo .next .cache build out coverage .pi .test-output"

explain() { # KEY — the English for one key, and the whole of it
  case "$1" in
    decisions) echo "A shipped file cites a decision record its package does not ship, which no install holds. State the decision's rule in the file instead (skills/AGENTS.md). Each citation follows as path:line and ID." ;;
    links) echo "A shipped markdown file links by relative path outside its own package and the skills its SKILL.md lists under dependencies.required, so an install without that package holds a dead link. Name the file and section in plain text instead (skills/AGENTS.md). Each link follows as path:line and destination." ;;
    manifest) echo "That SKILL.md front matter holds a dependencies: block tools/lib/skill-requirements.awk cannot take, which tools/ci-job-set refuses too: a two-space required: or optional: key holding one inline list of bare names, [a, b]. The links out of its skill could not be judged." ;;
    unreadable) echo "That input could not be read, so its references were not judged; the cause follows." ;;
    *) gg_fail key "$1" "explain() holds no text for this key." ;;
  esac
}
refuse() { # KEY VALUE [CAUSE]
  gg_fail "$1" "$2" "$(explain "$1")${3:+
$3}"
}

# Paths come back as git spells them, one per line, so the stages below can
# be joined on them.
# shellcheck disable=SC2086 # ROOTS is a word list
git -c core.quotePath=false ls-files -- $ROOTS >"$GG_TMP/tracked" 2>"$GG_TMP/err" ||
  refuse unreadable "git ls-files" "$(cat -- "$GG_TMP/err")"

cat >"$GG_TMP/shipped.awk" <<'AWK'
# The package a path sits in by its place in the catalog, or "" for none.
# A bare skills/<name> or pi-extensions/<name> is a package only where the
# judge has seen its files, since by shape alone it could be a document.
function package_of(p,   n, s) {
  if (p in known) return p
  n = split(p, s, "/")
  if ((s[1] == "skills" || s[1] == "pi-extensions") && n >= 3) return s[1] "/" s[2]
  if (s[1] == "hooks" && n == 2 && p !~ /\.md$/) return p
  if (s[1] == "agents" && n == 2 && p ~ /\.md$/) return p
  return ""
}

# A `<ID>-*.md` file name, the record a decision ID names, or "".
function record_id(path,   b, q, n) {
  b = path
  sub(/.*\//, "", b)
  if (index(b, id_prefix) != 1 || b !~ /\.md$/) return ""
  q = length(id_prefix) + 1
  n = 0
  while (substr(b, q + n, 1) ~ /^[0-9]$/) n++
  if (n == 0 || substr(b, q + n, 1) != "-") return ""
  return substr(b, 1, q + n - 1)
}

stage == "classify" {
  p = package_of($0)
  if (p != "") printf "%s\t%s\n", p, $0
  next
}

# md-blocks puts a setext heading's H record on its underline, after T
# records for the lines above it that already carry its text; reading both
# would cite each reference twice. Source lines are read once per file.
function setext_underline(n,   line, rc) {
  if (!source_read) {
    while ((rc = (getline line < src)) > 0) source[++source_lines] = line
    if (rc < 0) { print "cannot read " src > "/dev/stderr"; exit 2 }
    close(src)
    source_read = 1
  }
  line = source[n]
  sub(/^[ \t>]*/, "", line)
  return line ~ /^(=+|-+)[ \t]*$/
}

# Markdown arrives as md-blocks' "kind<TAB>line<TAB>text" records; content
# follows two protocol tabs and can hold more of its own. Code spans are
# names, not citations. Links are read as md-refs reads them, and in
# headings too, which md-refs reads only as anchors: a heading link opens
# the same dead path a paragraph link does. IDs are read with no link
# masked, the HTML-block reading, because a linked decision is still a
# record the install does not hold.
stage == "extract" && carrier == "markdown" {
  first = index($0, "\t")
  if (!first) next
  block_kind = substr($0, 1, first - 1)
  rest = substr($0, first + 1)
  second = index(rest, "\t")
  line_no = substr(rest, 1, second - 1)
  text = substr(rest, second + 1)
  if (block_kind == "H" && setext_underline(line_no)) next
  split_spans(text)
  plain = outside
  if (block_kind != "X") emit_links(outside, text)
  emit_ids(plain, "X")
  next
}

# Comment text arrives as "line<TAB>text"; every ID in it is a citation.
stage == "extract" && carrier == "comment" {
  i = index($0, "\t")
  if (!i) next
  line_no = substr($0, 1, i - 1)
  emit_ids(substr($0, i + 1), "X")
  next
}

# lib/skill-requirements.awk's rows: a skill's required skill, or the
# SKILL.md it could not take, judged only where a link out of that skill
# needs the list.
stage == "judge" && FILENAME == requirements {
  if ($1 == "?") {
    p = $2
    sub(/\/SKILL\.md$/, "", p)
    manifest[p] = $2
  } else required["skills/" $1, "skills/" $2] = 1
  next
}

stage == "judge" && $1 == "S" {
  owner[$3] = $2
  known[$2] = 1
  id = record_id($3)
  if (id != "") ships[$2, id] = 1
  next
}

# A linked ID can sit in the label and the destination of one link: one
# citation per line and ID.
stage == "judge" && $1 == "D" {
  if ((owner[$2], $4) in ships || ($2, $3, $4) in cited) next
  cited[$2, $3, $4] = 1
  printf "decision\t%s:%s\t%s\n", $2, $3, $4
  next
}

stage == "judge" && $1 == "L" {
  src = $2
  path = $4
  sub(/#.*/, "", path)
  sub(/\/$/, "", path)
  if (path == "") next
  target = resolve_from(dir_of(src), path)
  from = owner[src]
  to = ESCAPED ? "" : package_of(target)
  if (to == from) next
  if (to ~ /^skills\// && from ~ /^skills\//) {
    if (from in manifest) { printf "E\t%s\n", manifest[from]; next }
    if ((from, to) in required) next
  }
  printf "link\t%s:%s\t%s\n", src, $3, $4
  next
}

stage == "judge" { next }
AWK

# md-refs.awk refuses a run in a mode it does not know, and its own rules
# never see a record: every stage above ends in `next`.
run_awk() { # STAGE [AWK-ARGS...] — the stage over its input
  local stage=$1
  shift
  LC_ALL=C awk -v mode=refs -v stage="$stage" -v id_prefix="$ID_PREFIX" -v id_width="$ID_WIDTH" \
    -f "$GG_LIB/md-slug.awk" -f "$GG_TMP/shipped.awk" -f "$GG_LIB/md-refs.awk" "$@"
}

run_awk classify "$GG_TMP/tracked" >"$GG_TMP/packages" 2>"$GG_TMP/err" ||
  refuse unreadable "package classification" "$(cat -- "$GG_TMP/err")"

: >"$GG_TMP/shipped"
while IFS="$GG_TAB" read -r pkg path; do
  [ -e "$path" ] || [ -L "$path" ] || continue # deleted from the tree, nothing to read
  rel=${path#"$pkg"/}
  case $pkg in
    skills/*)
      for name in "$@"; do
        [ "${rel%%/*}" != "$name" ] || continue 2
      done
      ;;
    pi-extensions/*)
      IFS=/ read -ra parts <<<"$rel"
      for part in "${parts[@]}"; do
        case " $PI_SKIPPED " in *" $part "*) continue 2 ;; esac
      done
      ;;
  esac
  printf 'S\t%s\t%s\n' "$pkg" "$path" >>"$GG_TMP/shipped"
done <"$GG_TMP/packages"

regular() { # PATH — refuses what is not a plain file to read
  [ -f "$1" ] && [ ! -L "$1" ] || refuse unreadable "$1" "not a regular file"
}

: >"$GG_TMP/refs"
while IFS="$GG_TAB" read -r _ _ path; do
  case $path in *.md) ;; *) continue ;; esac
  regular "$path"
  LC_ALL=C awk -v mode=lines -f "$GG_LIB/md-shapes.awk" -f "$GG_LIB/md-blocks.awk" "./$path" \
    >"$GG_TMP/lines" 2>"$GG_TMP/err" || refuse unreadable "$path" "$(cat -- "$GG_TMP/lines" "$GG_TMP/err")"
  run_awk extract -v carrier=markdown -v src="$path" "$GG_TMP/lines" >>"$GG_TMP/refs" 2>"$GG_TMP/err" ||
    refuse unreadable "$path" "$(cat -- "$GG_TMP/err")"
done <"$GG_TMP/shipped"

# Only a file whose bytes hold an ID-shaped token can cite a decision, so
# one search names the comment carriers worth extracting.
status=0
# shellcheck disable=SC2086 # ROOTS is a word list
LC_ALL=C git -c core.quotePath=false grep -l -E -e "(^|[^A-Za-z0-9])${ID_PREFIX}[0-9]{${ID_WIDTH},}([^A-Za-z0-9]|\$)" -- $ROOTS \
  >"$GG_TMP/candidates" 2>"$GG_TMP/err" || status=$?
[ "$status" -le 1 ] || refuse unreadable "git grep" "$(cat -- "$GG_TMP/err")"
LC_ALL=C awk -F '\t' 'NR == FNR { hit[$0] = 1; next } ($3 in hit) && $3 !~ /\.md$/ { print $3 }' \
  "$GG_TMP/candidates" "$GG_TMP/shipped" >"$GG_TMP/carriers" ||
  refuse unreadable "comment carriers" "awk exited $?"
while IFS= read -r path; do
  regular "$path"
  fam=$(gg_comment_family "$path" "./$path") || exit 2
  [ -n "$fam" ] || continue
  gg_comment_text "$fam" "./$path" "$path" >"$GG_TMP/text" ||
    refuse unreadable "$path" "$GG_COMMENT_ERROR_DETAIL"
  run_awk extract -v carrier=comment -v src="$path" "$GG_TMP/text" >>"$GG_TMP/refs" 2>"$GG_TMP/err" ||
    refuse unreadable "$path" "$(cat -- "$GG_TMP/err")"
done <"$GG_TMP/carriers"

# Each skill's dependencies.required, by the reader tools/ci-job-set runs.
manifests=()
while IFS="$GG_TAB" read -r _ _ path; do
  case $path in skills/*/SKILL.md) ;; *) continue ;; esac
  [ "${path#skills/*/}" = SKILL.md ] || continue
  manifests+=("$path")
done <"$GG_TMP/shipped"
: >"$GG_TMP/requirements"
if [ "${#manifests[@]}" -gt 0 ]; then
  LC_ALL=C awk -f "$TOOLS_DIR/lib/skill-requirements.awk" "${manifests[@]}" >"$GG_TMP/requirements" 2>"$GG_TMP/err" ||
    refuse unreadable "skill requirements" "$(cat -- "$GG_TMP/err")"
fi

run_awk judge -F '\t' -v requirements="$GG_TMP/requirements" \
  "$GG_TMP/shipped" "$GG_TMP/requirements" "$GG_TMP/refs" >"$GG_TMP/verdict" 2>"$GG_TMP/err" ||
  refuse unreadable "reference verdict" "$(cat -- "$GG_TMP/err")"

# One record kind of the verdict, its leading kind field dropped.
records() { # KIND
  LC_ALL=C awk -F '\t' -v kind="$1" '$1 == kind { sub(/^[^\t]*\t/, ""); print }' "$GG_TMP/verdict" ||
    refuse unreadable "reference verdict" "awk exited $?"
}

manifest=$(records E) || exit 2
[ -z "$manifest" ] || refuse manifest "${manifest%%$'\n'*}"

found=0
for kind in decision link; do
  hits=$(records "$kind") || exit 2
  [ -n "$hits" ] || continue
  found=1
  count=$(printf '%s\n' "$hits" | wc -l | tr -d ' ')
  gg_message "${kind}s" "$count" "$(explain "${kind}s")"
  printf '%s\n' "$hits" | sed 's/^/  /'
done
exit "$found"
