#!/usr/bin/env bash
# No file the Rust source reads can take the `trivial` change class alone.
#
# A `trivial` diff runs no cargo lane (tools/ci-job-set), so a file compiled
# code or a test reads that a trivial diff can change is one whose edit or
# rename reaches the binary or a test with nothing compiling it. The files
# read are tools/rust-reads' rows, derived from the source. Whether a diff
# changing one of them alone classifies `trivial` is the shipped classifier's
# answer, skills/harness-ci/scripts/change-class, asked with the narrow-change
# list beside it, skills/orch/references/narrow-change.conf, whose `path`
# lines refuse the class. A `path` line naming the file is what a finding
# asks for. `tools/guard --full` runs it at development completion, and CI's
# guards-scans shard on every pull request that runs the shell shards, which
# is every one changing a file under crates/.
#
# Each row is first put to the classifier's default trivial set, the
# `harness-only --mode docs` verdict, as one diff changing every tracked file
# the row names; that keeps a directory row such as skills/ at one call. Only
# a row that verdict accepts whole is then put to change-class file by file.
# Two things are left unjudged by that, and both are open: a directory row
# mixing documentation with other files, and the root row `.`, which names
# no path. A file is judged once tracked, so a file added under a read
# directory is judged by the commit that adds it.
#
# Every diff is built in a scratch repository whose inventory,
# .kendex-generated.json, is empty, so no probed file reads as generated, and
# the classifier runs without HARNESS_CI_TRIVIAL_PATHS and
# HARNESS_CI_TRIVIAL_MAX_LINES, as the change-class action runs it in CI.
#
# Usage: tools/trivial-reads [ROOT]
#   ROOT   the checkout to judge; the current directory when omitted
# Exit: 0 no read file classifies trivial, 1 one does, 2 the judgement could
# not be made, which is never read as a held tree. Every refusal opens with
# one keyed line:
#   trivial-reads: trivial=<count>      the paths follow, one per line
#   trivial-reads: unjudged=<path>      the classifier gave an unmeasured
#                                       answer; its class line follows
#   trivial-reads: unreadable=<what>    a read or a scratch step failed
set -euo pipefail

TOOLS_DIR="$(cd "$(dirname "$0")" && pwd)" || exit 2

unreadable() { printf 'trivial-reads: unreadable=%s\n' "$1"; exit 2; }

case $# in
  0) root=. ;;
  1) root=$1 ;;
  *) echo "trivial-reads: usage=tools/trivial-reads [ROOT]" >&2; exit 2 ;;
esac
cd -- "$root" 2>/dev/null || unreadable "$root"

rows=$("$TOOLS_DIR/rust-reads" .) || unreadable rust-reads

# The tracked files each row names, read from this checkout before the git
# environment is cleared: inside a commit hook that environment is what
# points at the index being committed.
row_files=""
while IFS="$(printf '\t')" read -r _kind path; do
  [ -n "$path" ] || continue
  [ "$path" != . ] || continue
  files=$(git -c core.quotePath=false ls-files -- "$path" </dev/null) ||
    unreadable "ls-files:$path"
  [ -n "$files" ] || continue
  row_files="$row_files$(printf '%s\n' "$files" | awk -v row="$path" '{ print row "\t" $0 }')
"
done <<<"$rows"
[ -n "$row_files" ] || exit 0
SCRIPTS="$PWD/skills/harness-ci/scripts"
[ -x "$SCRIPTS/change-class" ] && [ -x "$SCRIPTS/harness-only" ] || unreadable skills/harness-ci/scripts

# The scratch repository is a world of its own: the hook's git environment
# would otherwise point every call below at this checkout.
unset GIT_DIR GIT_COMMON_DIR GIT_WORK_TREE GIT_INDEX_FILE
unset HARNESS_CI_TRIVIAL_PATHS HARNESS_CI_TRIVIAL_MAX_LINES
export GIT_AUTHOR_NAME=trivial-reads GIT_AUTHOR_EMAIL=trivial-reads@invalid
export GIT_COMMITTER_NAME=trivial-reads GIT_COMMITTER_EMAIL=trivial-reads@invalid
work=$(mktemp -d) || unreadable scratch
trap 'rm -rf -- "${work:?}"' EXIT
scratch="$work/repo"
sg() { git -C "$scratch" "$@"; }
git init -q -- "$scratch" || unreadable scratch
empty=$(sg hash-object -w --stdin </dev/null) || unreadable scratch
inventory=$(printf '[]\n' | sg hash-object -w --stdin) || unreadable scratch

commit_of() { # FILES PARENT — a commit holding the empty inventory and FILES
  local tree index="$work/probe-index"
  rm -f -- "${index:?}"
  {
    printf '100644 %s 0\t.kendex-generated.json\n' "$inventory"
    printf '%s\n' "$1" | awk -v blob="$empty" 'NF { printf "100644 %s 0\t%s\n", blob, $0 }'
  } | GIT_INDEX_FILE="$index" sg update-index --add --index-info || return 1
  tree=$(GIT_INDEX_FILE="$index" sg write-tree) || return 1
  if [ -n "$2" ]; then
    sg commit-tree --no-gpg-sign "$tree" -p "$2" -m probe
  else
    sg commit-tree --no-gpg-sign "$tree" -m base
  fi
}
base=$(commit_of "" "") || unreadable scratch

trivial=""
paths=$(printf '%s' "$row_files" | cut -f1 | LC_ALL=C sort -u) || unreadable rows
while IFS= read -r path; do
  files=$(printf '%s' "$row_files" | awk -F '\t' -v row="$path" '$1 == row { print $2 }') ||
    unreadable rows
  head=$(commit_of "$files" "$base") || unreadable scratch
  docs=$("$SCRIPTS/harness-only" --mode docs --event pull_request --base "$base" \
    --head "$head" --repo "$scratch" --output /dev/null 2>/dev/null </dev/null) ||
    unreadable harness-only
  case "$docs" in
    docs_only=true) ;;
    docs_only=false) continue ;;
    *) unreadable harness-only ;;
  esac
  while IFS= read -r file; do
    head=$(commit_of "$file" "$base") || unreadable scratch
    class=$("$SCRIPTS/change-class" --event pull_request --base "$base" --head "$head" \
      --repo "$scratch" --output /dev/null 2>"$work/class-stderr" </dev/null) ||
      unreadable change-class
    line=$(grep '^class: ' "$work/class-stderr") || unreadable change-class
    case "$class $line" in
      "change_class=trivial "*) trivial="$trivial$file
" ;;
      *" measured=true"*) ;;
      *) printf 'trivial-reads: unjudged=%s\n%s\n' "$file" "$line"; exit 2 ;;
    esac
  done <<<"$files"
done <<<"$paths"

[ -n "$trivial" ] || exit 0
# A file two rows both name is probed under each.
trivial=$(printf '%s' "$trivial" | LC_ALL=C sort -u) || unreadable rows
printf 'trivial-reads: trivial=%s\n' "$(printf '%s\n' "$trivial" | grep -c '')"
printf '%s\n' "$trivial"
echo "A diff changing one of these alone classifies trivial and runs no cargo lane, yet Rust code under crates/ reads it; add a path line naming it to skills/orch/references/narrow-change.conf."
exit 1
